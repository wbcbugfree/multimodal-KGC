@prefix she: <https://soilwise-he.github.io/soil-health#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

she:Begin a skos:Concept ;
    skos:prefLabel "begin" ;
    she:startsProcess she:PreConfiguration .

she:PreConfiguration a skos:Concept ;
    skos:prefLabel "pre-configuration" ;
    she:proceedsTo she:Input .

she:Input a skos:Concept ;
    skos:prefLabel "input" ;
    she:proceedsTo she:InputSignalAnalysis .

she:InputSignalAnalysis a skos:Concept ;
    skos:prefLabel "input signal analysis" ;
    she:proceedsTo she:InputSignalAnalysisFinished .

she:InputSignalAnalysisFinished a skos:Concept ;
    skos:prefLabel "input signal analysis finished?" ;
    she:hasYesPath she:OutputSignalAnalysis ;
    she:hasNoPath she:Input .

she:OutputSignalAnalysis a skos:Concept ;
    skos:prefLabel "output signal analysis" ;
    she:proceedsTo she:OutputSignalAnalysisFinished .

she:OutputSignalAnalysisFinished a skos:Concept ;
    skos:prefLabel "output signal analysis finished?" ;
    she:hasYesPath she:BackToWork ;
    she:hasNoPath she:Update .

she:Update a skos:Concept ;
    skos:prefLabel "update" ;
    she:loopsTo she:Input .

she:BackToWork a skos:Concept ;
    skos:prefLabel "back to work" ;
    she:loopsTo she:Input .
