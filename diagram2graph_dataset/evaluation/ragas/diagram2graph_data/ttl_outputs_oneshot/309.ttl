@prefix she:  <https://soilwise-he.github.io/soil-health#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

she:Start a skos:Concept ;
    skos:prefLabel "start" ;
    she:precedes she:GetReadyForBath .

she:GetReadyForBath a skos:Concept ;
    skos:prefLabel "get ready for bath" ;
    she:precedes she:RemoveClothes .

she:RemoveClothes a skos:Concept ;
    skos:prefLabel "remove clothes" ;
    she:precedes she:GetIntoBath .

she:GetIntoBath a skos:Concept ;
    skos:prefLabel "get into bath" ;
    she:precedes she:Wash .

she:Wash a skos:Concept ;
    skos:prefLabel "wash" ;
    she:precedes she:GetOutOfBath .

she:GetOutOfBath a skos:Concept ;
    skos:prefLabel "get out of bath" ;
    she:precedes she:SwitchOffTheLight .

she:SwitchOffTheLight a skos:Concept ;
    skos:prefLabel "switch off the light" ;
    she:precedes she:GetDressed .

she:GetDressed a skos:Concept ;
    skos:prefLabel "get dressed" .
