@prefix she:  <https://soilwise-he.github.io/soil-health#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

she:Begin a skos:Concept ;
    skos:prefLabel "begin" ;
    she:follows she:RecordCustomersApplication .

she:RecordCustomersApplication a skos:Concept ;
    skos:prefLabel "1. record customer's application" ;
    she:follows she:InitialProcessing .

she:InitialProcessing a skos:Concept ;
    skos:prefLabel "2. initial processing" ;
    she:follows she:ObtainDocumentsFromCustomer .

she:ObtainDocumentsFromCustomer a skos:Concept ;
    skos:prefLabel "3. obtain documents from customer" ;
    she:follows she:Documentation .

she:Documentation a skos:Concept ;
    skos:prefLabel "4. documentation" ;
    she:follows she:Evaluate .

she:Evaluate a skos:Concept ;
    skos:prefLabel "5. evaluate" ;
    she:follows she:Approval .

she:Approval a skos:Concept ;
    skos:prefLabel "6. approval" ;
    she:follows she:LoanGranted .

she:LoanGranted a skos:Concept ;
    skos:prefLabel "7. loan granted" ;
    she:follows she:Finish .

she:Finish a skos:Concept ;
    skos:prefLabel "finish" .
