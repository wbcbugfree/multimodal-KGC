@prefix she:  <https://soilwise-he.github.io/soil-health#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

she:Begin a skos:Concept ;
    skos:prefLabel "begin" ;
    she:nextStep she:Statements .

she:Statements a skos:Concept ;
    skos:prefLabel "statements" ;
    she:nextStep she:Condition .

she:Condition a skos:Concept ;
    skos:prefLabel "condition" ;
    she:ifTrueLeadsTo she:Statements1 ;
    she:ifFlalseLeadsTo she:Statements2 .

she:Statements1 a skos:Concept ;
    skos:prefLabel "statements 1" ;
    she:loopsBackTo she:Condition .

she:Statements2 a skos:Concept ;
    skos:prefLabel "statements 2" ;
    she:nextStep she:Stop .

she:Stop a skos:Concept ;
    skos:prefLabel "stop" .
