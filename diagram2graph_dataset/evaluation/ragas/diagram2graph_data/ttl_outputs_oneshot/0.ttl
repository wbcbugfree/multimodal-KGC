@prefix she:  <https://soilwise-he.github.io/soil-health#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

she:Start a skos:Concept ;
    skos:prefLabel "start" ;
    she:leadsTo she:CheckNeedsForProject .

she:CheckNeedsForProject a skos:Concept ;
    skos:prefLabel "check needs for project" ;
    she:leadsTo she:IsProjectWellDefined .

she:IsProjectWellDefined a skos:Concept ;
    skos:prefLabel "is project well-defined?" ;
    she:leadsToIfNo she:ReEvaluateNeeds ;
    she:leadsToIfYes she:BuildPrototype .

she:ReEvaluateNeeds a skos:Concept ;
    skos:prefLabel "re-evaluate needs" ;
    she:leadsTo she:BuildPrototype .

she:BuildPrototype a skos:Concept ;
    skos:prefLabel "build prototype" ;
    she:leadsTo she:End .

she:End a skos:Concept ;
    skos:prefLabel "end" .
