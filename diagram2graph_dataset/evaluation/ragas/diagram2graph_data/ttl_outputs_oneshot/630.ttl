@prefix she: <https://soilwise-he.github.io/soil-health#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

she:Start a skos:Concept ;
    skos:prefLabel "start" ;
    she:leadsTo she:ComputeLocalAdminGroupName .

she:ComputeLocalAdminGroupName a skos:Concept ;
    skos:prefLabel "compute local admin group name" ;
    she:leadsTo she:AddOrRemove .

she:AddOrRemove a skos:Concept ;
    skos:prefLabel "add or remove?" ;
    she:ifAdd she:Update ;
    she:ifRemove she:Personalize .

she:Update a skos:Concept ;
    skos:prefLabel "update" ;
    she:leadsTo she:AddUsersToGroup .

she:AddUsersToGroup a skos:Concept ;
    skos:prefLabel "add users to group" ;
    she:leadsTo she:End .

she:Personalize a skos:Concept ;
    skos:prefLabel "personalize" ;
    she:leadsTo she:DisplayCurrentMembers .

she:DisplayCurrentMembers a skos:Concept ;
    skos:prefLabel "display current members" ;
    she:leadsTo she:Check .

she:Check a skos:Concept ;
    skos:prefLabel "check" ;
    she:leadsTo she:End .

she:End a skos:Concept ;
    skos:prefLabel "end" .
