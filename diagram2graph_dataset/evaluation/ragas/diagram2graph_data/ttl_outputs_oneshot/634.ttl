@prefix she: <https://soilwise-he.github.io/soil-health#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

she:Initial a skos:Concept ;
    skos:prefLabel "initial" ;
    she:proceedsTo she:Case1 .

she:Case1 a skos:Concept ;
    skos:prefLabel "case 1" ;
    she:onYes she:Statement1 ;
    she:onNo she:Case2 .

she:Statement1 a skos:Concept ;
    skos:prefLabel "statement 1" ;
    she:proceedsTo she:End .

she:Case2 a skos:Concept ;
    skos:prefLabel "case 2" ;
    she:onYes she:Statement2 ;
    she:onNo she:CaseN .

she:Statement2 a skos:Concept ;
    skos:prefLabel "statement 2" ;
    she:proceedsTo she:End .

she:CaseN a skos:Concept ;
    skos:prefLabel "case n" ;
    she:onYes she:StatementN ;
    she:onNo she:DefaultStatement .

she:StatementN a skos:Concept ;
    skos:prefLabel "statement n" ;
    she:proceedsTo she:End .

she:DefaultStatement a skos:Concept ;
    skos:prefLabel "default statement" ;
    she:proceedsTo she:End .

she:End a skos:Concept ;
    skos:prefLabel "end" .
