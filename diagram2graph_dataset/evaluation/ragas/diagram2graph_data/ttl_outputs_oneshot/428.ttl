@prefix she:  <https://soilwise-he.github.io/soil-health#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

she:Start a skos:Concept ;
    skos:prefLabel "start" ;
    she:leadsTo she:InputABC .

she:InputABC a skos:Concept ;
    skos:prefLabel "input a,b,c" ;
    she:leadsTo she:IsBGtC .

she:IsBGtC a skos:Concept ;
    skos:prefLabel "is b>c?" ;
    she:ifTrue she:PrintB ;
    she:ifFalse she:IsAGtB .

she:IsAGtB a skos:Concept ;
    skos:prefLabel "is a>b?" ;
    she:ifTrue she:IsAGtC ;
    she:ifFalse she:PrintC .

she:IsAGtC a skos:Concept ;
    skos:prefLabel "is a>c?" ;
    she:ifTrue she:PrintA ;
    she:ifFalse she:PrintC .

she:PrintB a skos:Concept ;
    skos:prefLabel "print b" ;
    she:leadsTo she:Stop .

she:PrintC a skos:Concept ;
    skos:prefLabel "print c" ;
    she:leadsTo she:Stop .

she:PrintA a skos:Concept ;
    skos:prefLabel "print a" ;
    she:leadsTo she:Stop .

she:Stop a skos:Concept ;
    skos:prefLabel "stop" .
