@prefix she:  <https://soilwise-he.github.io/soil-health#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

she:Start a skos:Concept ;
    skos:prefLabel "start" ;
    skos:narrower she:DeclareVariables .

she:DeclareVariables a skos:Concept ;
    skos:prefLabel "declare variables a, b, d, x1, x2, rp and ip" ;
    skos:narrower she:CalculateDiscriminant .

she:CalculateDiscriminant a skos:Concept ;
    skos:prefLabel "calculate discriminant, d <- b^2 - 4ac" ;
    skos:narrower she:IsDGreaterThanOrEqualToZero .

she:IsDGreaterThanOrEqualToZero a skos:Concept ;
    skos:prefLabel "is d >= 0?" ;
    she:leadsToIfTrue she:CalculateRealRoots ;
    she:leadsToIfFalse she:CalculateComplexComponents .

she:CalculateRealRoots a skos:Concept ;
    skos:prefLabel "r1 <- (-b + sqrt(d)) / 2a ; r2 <- (-b + sqrt(d)) / 2a" ;
    skos:narrower she:DisplayRoots .

she:CalculateComplexComponents a skos:Concept ;
    skos:prefLabel "ip <- -b/2a ; rp <- sqrt(-d) / 2a" ;
    skos:narrower she:CalculateComplexRoots .

she:CalculateComplexRoots a skos:Concept ;
    skos:prefLabel "x1 <- ip + j*ip ; x2 <- rp - j*ip" ;
    skos:narrower she:DisplayRoots .

she:DisplayRoots a skos:Concept ;
    skos:prefLabel "display r1 and r2" ;
    skos:narrower she:Stop .

she:Stop a skos:Concept ;
    skos:prefLabel "stop" .
