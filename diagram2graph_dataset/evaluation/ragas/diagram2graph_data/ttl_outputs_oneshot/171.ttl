@prefix she:  <https://soilwise-he.github.io/soil-health#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

she:Start a skos:Concept ;
    skos:prefLabel "start" ;
    she:leadsTo she:AreYouHappy .

she:AreYouHappy a skos:Concept ;
    skos:prefLabel "are you happy?" ;
    she:ifYes she:MakeOthersHappy ;
    she:ifNo she:WantToBeHappy .

she:MakeOthersHappy a skos:Concept ;
    skos:prefLabel "make others happy" ;
    she:leadsTo she:Stop .

she:Stop a skos:Concept ;
    skos:prefLabel "stop" .

she:WantToBeHappy a skos:Concept ;
    skos:prefLabel "want to be happy?" ;
    she:ifYes she:AskSomeone ;
    she:ifNo she:AllOver .

she:AskSomeone a skos:Concept ;
    skos:prefLabel "ask someone" ;
    she:leadsTo she:Stop .

she:AllOver a skos:Concept ;
    skos:prefLabel "all over" ;
    she:loopsBackTo she:Start .
