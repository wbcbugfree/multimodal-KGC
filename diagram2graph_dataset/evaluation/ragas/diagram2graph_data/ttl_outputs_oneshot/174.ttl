@prefix she:  <https://soilwise-he.github.io/soil-health#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

she:Begin a skos:Concept ;
    skos:prefLabel "begin" ;
    she:leadsTo she:Input .

she:Input a skos:Concept ;
    skos:prefLabel "input" ;
    she:leadsTo she:Process .

she:Process a skos:Concept ;
    skos:prefLabel "process" ;
    she:leadsToIfYes she:Add ;
    she:leadsToIfNo she:Subtract .

she:Add a skos:Concept ;
    skos:prefLabel "add" ;
    she:leadsTo she:End .

she:Subtract a skos:Concept ;
    skos:prefLabel "subtract" ;
    she:leadsTo she:End .

she:End a skos:Concept ;
    skos:prefLabel "end" .
