@prefix she:  <https://soilwise-he.github.io/soil-health#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

she:Begin a skos:Concept ;
    skos:prefLabel "begin" ;
    she:nextStep she:InitializeVariables .

she:InitializeVariables a skos:Concept ;
    skos:prefLabel "initialize variables" ;
    she:nextStep she:InputNumbers .

she:InputNumbers a skos:Concept ;
    skos:prefLabel "input numbers" ;
    she:nextStep she:AllNumbersBeenEntered .

she:AllNumbersBeenEntered a skos:Concept ;
    skos:prefLabel "all numbers been entered?" ;
    she:ifYes she:CalculateAverage ;
    she:ifNo she:InputLatest .

she:InputLatest a skos:Concept ;
    skos:prefLabel "input latest" ;
    she:nextStep she:CalculateTotal .

she:CalculateTotal a skos:Concept ;
    skos:prefLabel "total = total + latest" ;
    she:loopsTo she:AllNumbersBeenEntered .

she:CalculateAverage a skos:Concept ;
    skos:prefLabel "average = total / numbers" ;
    she:nextStep she:PrintOutput .

she:PrintOutput a skos:Concept ;
    skos:prefLabel "print output" ;
    she:nextStep she:Stop .

she:Stop a skos:Concept ;
    skos:prefLabel "stop" .
