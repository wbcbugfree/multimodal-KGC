@prefix she:  <https://soilwise-he.github.io/soil-health#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

she:Begin a skos:Concept ;
    skos:prefLabel "begin" ;
    she:leadsTo she:InitializeX .

she:InitializeX a skos:Concept ;
    skos:prefLabel "x=1" ;
    she:leadsTo she:CheckConditionX .

she:CheckConditionX a skos:Concept ;
    skos:prefLabel "x>1" ;
    she:evaluatesToYes she:OutputX ;
    she:evaluatesToNo she:End .

she:OutputX a skos:Concept ;
    skos:prefLabel "output x" ;
    she:leadsTo she:IncrementX .

she:IncrementX a skos:Concept ;
    skos:prefLabel "x=x+1" ;
    she:loopsBackTo she:CheckConditionX .

she:End a skos:Concept ;
    skos:prefLabel "end" .
