@prefix she:  <https://soilwise-he.github.io/soil-health#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

she:DoYouHaveTimeToFlee a skos:Concept ;
    skos:prefLabel "do you have time to flee?" ;
    she:ifYes she:RunQuickly ;
    she:ifNo she:AreYouWearingSunGlasses .

she:RunQuickly a skos:Concept ;
    skos:prefLabel "run quickly" ;
    she:leadsTo she:YeahNoNeedToSayHi .

she:AreYouWearingSunGlasses a skos:Concept ;
    skos:prefLabel "are you wearing sun glasses?" ;
    she:ifYes she:DontRun ;
    she:ifNo she:CouldYouPretendToGetACall .

she:DontRun a skos:Concept ;
    skos:prefLabel "don't run" ;
    she:leadsTo she:YeahNoNeedToSayHi .

she:CouldYouPretendToGetACall a skos:Concept ;
    skos:prefLabel "could you pretend to get a call?" ;
    she:ifYes she:NoProblem ;
    she:ifNo she:Finish .

she:NoProblem a skos:Concept ;
    skos:prefLabel "no problem" ;
    she:leadsTo she:YeahNoNeedToSayHi .

she:YeahNoNeedToSayHi a skos:Concept ;
    skos:prefLabel "yeah! no need to say hi." .

she:Finish a skos:Concept ;
    skos:prefLabel "finish" .
