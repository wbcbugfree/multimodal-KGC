@prefix she:  <https://soilwise-he.github.io/soil-health#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

she:Start a skos:Concept ;
    skos:prefLabel "start" ;
    she:leadsTo she:KIsEqualTo0 .

she:KIsEqualTo0 a skos:Concept ;
    skos:prefLabel "k is equal to 0" ;
    she:leadsTo she:Loop .

she:Loop a skos:Concept ;
    skos:prefLabel "loop" ;
    she:leadsTo she:YesOrNo .

she:YesOrNo a skos:Concept ;
    skos:prefLabel "yes or no?" ;
    she:ifYes she:CalculateKAsKPlus1 ;
    she:ifNo she:PrintK .

she:CalculateKAsKPlus1 a skos:Concept ;
    skos:prefLabel "calculate k as k+1" ;
    she:continuesTo she:Loop .

she:PrintK a skos:Concept ;
    skos:prefLabel "print k" ;
    she:leadsTo she:Stop .

she:Stop a skos:Concept ;
    skos:prefLabel "stop" .
