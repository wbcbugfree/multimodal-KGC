@prefix she:  <https://soilwise-he.github.io/soil-health#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

she:Start a skos:Concept ;
    skos:prefLabel "start" ;
    she:leadsTo she:Enter .

she:Enter a skos:Concept ;
    skos:prefLabel "enter" ;
    she:leadsTo she:HomePage .

she:HomePage a skos:Concept ;
    skos:prefLabel "home page" ;
    she:leadsTo she:EnterEmailIdAndPassword .

she:EnterEmailIdAndPassword a skos:Concept ;
    skos:prefLabel "enter email id and password" ;
    she:leadsTo she:IsEmailIdAndPasswordCorrect .

she:IsEmailIdAndPasswordCorrect a skos:Concept ;
    skos:prefLabel "is email id and password correct?" ;
    she:ifNo she:LoginError ;
    she:ifYes she:DisplayAccount .

she:LoginError a skos:Concept ;
    skos:prefLabel "log in error" ;
    she:redirectsTo she:EnterEmailIdAndPassword .

she:DisplayAccount a skos:Concept ;
    skos:prefLabel "display account" ;
    she:leadsTo she:Stop .

she:Stop a skos:Concept ;
    skos:prefLabel "stop" .
