@prefix she: <https://soilwise-he.github.io/soil-health#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

she:ProcessStart a skos:Concept ;
    skos:prefLabel "start" ;
    she:initiates she:CostumerOrder .

she:CostumerOrder a skos:Concept ;
    skos:prefLabel "costumer order" ;
    she:generates she:SalesOrder .

she:SalesOrder a skos:Concept ;
    skos:prefLabel "sales order" ;
    she:requires she:Documentation .

she:Documentation a skos:Concept ;
    skos:prefLabel "documentation" ;
    she:ifNotSatisfiedThen she:SalesOrder ;
    she:ifSatisfiedThen she:PrepareDO .

she:PrepareDO a skos:Concept ;
    skos:prefLabel "prepare do" ;
    she:precedes she:Shipment .

she:Shipment a skos:Concept ;
    skos:prefLabel "shipment" ;
    she:resultsIn she:GoodsDelivered .

she:GoodsDelivered a skos:Concept ;
    skos:prefLabel "goods delivered" ;
    she:completesProcess she:ProcessEnd .

she:ProcessEnd a skos:Concept ;
    skos:prefLabel "end" .
