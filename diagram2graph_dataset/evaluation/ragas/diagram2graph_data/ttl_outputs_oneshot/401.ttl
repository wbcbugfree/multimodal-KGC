@prefix she:  <https://soilwise-he.github.io/soil-health#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

she:Start a skos:Concept ;
    skos:prefLabel "start" ;
    she:leadsTo she:CheckSoftware .

she:CheckSoftware a skos:Concept ;
    skos:prefLabel "check software" ;
    she:ifTrueLeadsTo she:CheckAllTheNeeds ;
    she:ifFalseLeadsTo she:B .

she:B a skos:Concept ;
    skos:prefLabel "b" .

she:CheckAllTheNeeds a skos:Concept ;
    skos:prefLabel "check all the needs" ;
    she:ifTrueLeadsTo she:GoodNeeds ;
    she:ifFalseLeadsTo she:C .

she:GoodNeeds a skos:Concept ;
    skos:prefLabel "good needs" ;
    she:leadsTo she:End .

she:C a skos:Concept ;
    skos:prefLabel "c" .

she:End a skos:Concept ;
    skos:prefLabel "end" .
