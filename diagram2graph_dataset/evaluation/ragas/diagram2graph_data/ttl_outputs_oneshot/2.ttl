@prefix she:  <https://soilwise-he.github.io/soil-health#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

she:Start a skos:Concept ;
    skos:prefLabel "start" ;
    she:leadsTo she:Initialize .

she:Initialize a skos:Concept ;
    skos:prefLabel "initialize" ;
    she:leadsTo she:Decision .

she:Decision a skos:Concept ;
    skos:prefLabel "decision" ;
    she:ifNoLeadsTo she:Process ;
    she:ifYesLeadsTo she:PrintResult .

she:Process a skos:Concept ;
    skos:prefLabel "process" ;
    she:leadsTo she:Delay .

she:Delay a skos:Concept ;
    skos:prefLabel "delay" ;
    she:loopsBackTo she:Initialize .

she:PrintResult a skos:Concept ;
    skos:prefLabel "print result" ;
    she:leadsTo she:End .

she:End a skos:Concept ;
    skos:prefLabel "end" .
