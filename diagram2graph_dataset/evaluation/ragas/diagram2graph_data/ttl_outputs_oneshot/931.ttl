@prefix she: <https://soilwise-he.github.io/soil-health#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

she:Start a skos:Concept ;
    skos:prefLabel "start" ;
    she:leadsTo she:ReadA .

she:ReadA a skos:Concept ;
    skos:prefLabel "read a" ;
    she:leadsTo she:BeforeLunch .

she:BeforeLunch a skos:Concept ;
    skos:prefLabel "before lunch?" ;
    she:onYesLeadsTo she:Accept ;
    she:onNoLeadsTo she:End .

she:Accept a skos:Concept ;
    skos:prefLabel "accept" .

she:End a skos:Concept ;
    skos:prefLabel "end" .
