@prefix she: <https://soilwise-he.github.io/soil-health#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

she:Start a skos:Concept ;
    skos:prefLabel "start" ;
    she:proceedsTo she:InitializeParametersOfParticleSwarm .

she:InitializeParametersOfParticleSwarm a skos:Concept ;
    skos:prefLabel "initialize parameters of particle swarm" ;
    she:proceedsTo she:CalculateTheFitnessFunction .

she:CalculateTheFitnessFunction a skos:Concept ;
    skos:prefLabel "calculate the fitness function" ;
    she:proceedsTo she:CompareWithOthersFitness .

she:CompareWithOthersFitness a skos:Concept ;
    skos:prefLabel "compare with others fitness" ;
    she:proceedsTo she:UpdateTheGlobalBestPositionOfParticleSwarm .

she:UpdateTheGlobalBestPositionOfParticleSwarm a skos:Concept ;
    skos:prefLabel "update the global best position of particle swarm" ;
    she:proceedsTo she:FindOverallPerformance .

she:FindOverallPerformance a skos:Concept ;
    skos:prefLabel "find overall performance" ;
    she:proceedsTo she:DoesItSatisfyTheTerminationConditions .

she:DoesItSatisfyTheTerminationConditions a skos:Concept ;
    skos:prefLabel "does it satisfy the termination conditions?" ;
    she:proceedsToIfNo she:CalculateTheFitnessFunction ;
    she:proceedsToIfYes she:DisplayTheResults .

she:DisplayTheResults a skos:Concept ;
    skos:prefLabel "display the results" ;
    she:proceedsTo she:End .

she:End a skos:Concept ;
    skos:prefLabel "end" .
