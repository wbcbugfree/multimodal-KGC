@prefix she: <https://soilwise-he.github.io/soil-health#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

she:Input a skos:Concept ;
    skos:prefLabel "input" ;
    she:leadsTo she:Filtering .

she:Filtering a skos:Concept ;
    skos:prefLabel "filtering" ;
    she:leadsTo she:ConnectRibs .

she:ConnectRibs a skos:Concept ;
    skos:prefLabel "connect ribs" ;
    she:leadsTo she:Skeleton .

she:Skeleton a skos:Concept ;
    skos:prefLabel "skeleton" ;
    she:leadsTo she:SegmentationUsingLevelSet .

she:SegmentationUsingLevelSet a skos:Concept ;
    skos:prefLabel "segmentation using level set" .
