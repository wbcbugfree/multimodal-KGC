@prefix she:  <https://soilwise-he.github.io/soil-health#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

she:Begin a skos:Concept ;
    skos:prefLabel "begin" ;
    skos:narrower she:TotalPatients .

she:TotalPatients a skos:Concept ;
    skos:prefLabel "total patients" ;
    skos:narrower she:SeriousPatients .

she:SeriousPatients a skos:Concept ;
    skos:prefLabel "serious patients" ;
    skos:narrower she:OperationNeeded,
        she:DoctorNeeded,
        she:NoOperationNeeded .

she:OperationNeeded a skos:Concept ;
    skos:prefLabel "operation needed" ;
    she:assignedTo she:PaccGroup .

she:DoctorNeeded a skos:Concept ;
    skos:prefLabel "doctor needed" ;
    she:leadsToOutcome she:GetWellSoon .

she:NoOperationNeeded a skos:Concept ;
    skos:prefLabel "no operation needed" ;
    she:leadsToOutcome she:GetWellSoon .

she:PaccGroup a skos:Concept ;
    skos:prefLabel "pacc group" .

she:GetWellSoon a skos:Concept ;
    skos:prefLabel "get well soon" .
