@prefix she:  <https://soilwise-he.github.io/soil-health#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

she:Begin a skos:Concept ;
    skos:prefLabel "begin" ;
    she:leadsTo she:AreYouOkay .

she:AreYouOkay a skos:Concept ;
    skos:prefLabel "are you okay" ;
    she:onYesLeadsTo she:DoSomething ;
    she:onNoLeadsTo she:DoSomething .

she:DoSomething a skos:Concept ;
    skos:prefLabel "do something" .
