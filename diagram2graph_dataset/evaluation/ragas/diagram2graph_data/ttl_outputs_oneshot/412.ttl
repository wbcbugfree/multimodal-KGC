@prefix she:  <https://soilwise-he.github.io/soil-health#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

she:Begin a skos:Concept ;
    skos:prefLabel "begin" ;
    skos:narrower she:ReadA .

she:ReadA a skos:Concept ;
    skos:prefLabel "read a" ;
    skos:narrower she:IsAPositiveNumber .

she:IsAPositiveNumber a skos:Concept ;
    skos:prefLabel "a>0" ;
    she:ifTrue she:Positive ;
    she:ifFalse she:Negative .

she:Positive a skos:Concept ;
    skos:prefLabel "positive" ;
    skos:narrower she:Stop .

she:Negative a skos:Concept ;
    skos:prefLabel "negative" ;
    skos:narrower she:Stop .

she:Stop a skos:Concept ;
    skos:prefLabel "stop" .
