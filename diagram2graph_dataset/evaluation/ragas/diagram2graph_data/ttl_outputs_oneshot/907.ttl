@prefix she:  <https://soilwise-he.github.io/soil-health#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

she:Start a skos:Concept ;
    skos:prefLabel "start" ;
    she:nextStep she:Order1 .

she:Order1 a skos:Concept ;
    skos:prefLabel "order 1" ;
    she:nextStep she:Accept ;
    she:generates she:Data .

she:Accept a skos:Concept ;
    skos:prefLabel "accept?" ;
    she:decisionYesPath she:Work .

she:Data a skos:Concept ;
    skos:prefLabel "data" ;
    she:generates she:Document .

she:Document a skos:Concept ;
    skos:prefLabel "document" ;
    she:informsDecision she:Accept .

she:Work a skos:Concept ;
    skos:prefLabel "work" ;
    she:nextStep she:Home .

she:Home a skos:Concept ;
    skos:prefLabel "home" ;
    she:nextStep she:End .

she:End a skos:Concept ;
    skos:prefLabel "end" .
