@prefix she:  <https://soilwise-he.github.io/soil-health#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

she:Start a skos:Concept ;
    skos:prefLabel "start" ;
    she:leadsTo she:WorkOnProblem .

she:WorkOnProblem a skos:Concept ;
    skos:prefLabel "work on problem" ;
    she:leadsTo she:AssessTheirSituationAndThe .

she:AssessTheirSituationAndThe a skos:Concept ;
    skos:prefLabel "assess their situation and the" ;
    she:leadsTo she:PresentSolutions .

she:PresentSolutions a skos:Concept ;
    skos:prefLabel "present solution(s)" ;
    she:leadsTo she:SignUp .

she:SignUp a skos:Concept ;
    skos:prefLabel "sign up" ;
    she:leadsTo she:RetainRelationship .

she:RetainRelationship a skos:Concept ;
    skos:prefLabel "retain relationship" ;
    she:leadsTo she:WorkOnProblem .
