@prefix she:  <https://soilwise-he.github.io/soil-health#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

she:Begin a skos:Concept ;
    skos:prefLabel "begin" ;
    she:initiates she:DoesTheUserHasAnAccount .

she:DoesTheUserHasAnAccount a skos:Concept ;
    skos:prefLabel "does the user has an account?" ;
    she:ifNo she:GoToWebsite ;
    she:ifYes she:UserEnterEmail .

she:GoToWebsite a skos:Concept ;
    skos:prefLabel "go to website" ;
    she:leadsTo she:OpenAnAccountPageOpen .

she:OpenAnAccountPageOpen a skos:Concept ;
    skos:prefLabel "\"open an account\" page open" .

she:UserEnterEmail a skos:Concept ;
    skos:prefLabel "user enter email" ;
    she:precedes she:UserEnterPassword .

she:UserEnterPassword a skos:Concept ;
    skos:prefLabel "user enter password" ;
    she:precedes she:UserClicksOnTheLoginButton .

she:UserClicksOnTheLoginButton a skos:Concept ;
    skos:prefLabel "user clicks on the login button" ;
    she:triggersValidation she:AreTheEmailAndPasswordIsCorrect .

she:AreTheEmailAndPasswordIsCorrect a skos:Concept ;
    skos:prefLabel "are the email and password is correct?" ;
    she:ifNo she:Close ;
    she:ifYes she:ErrorMessageAppears .

she:Close a skos:Concept ;
    skos:prefLabel "close" .

she:ErrorMessageAppears a skos:Concept ;
    skos:prefLabel "error message appears" .
