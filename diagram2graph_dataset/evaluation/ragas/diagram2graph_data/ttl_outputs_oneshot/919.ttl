@prefix she:  <https://soilwise-he.github.io/soil-health#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

she:Start a skos:Concept ;
    skos:prefLabel "start" ;
    she:nextStep she:HaveAnAccount .

she:HaveAnAccount a skos:Concept ;
    skos:prefLabel "have an account" ;
    she:ifNo she:Register ;
    she:ifYes she:Login .

she:Register a skos:Concept ;
    skos:prefLabel "register" ;
    she:nextStep she:Login .

she:Login a skos:Concept ;
    skos:prefLabel "login" ;
    she:nextStep she:BookAFlight .

she:BookAFlight a skos:Concept ;
    skos:prefLabel "book a flight" ;
    she:nextStep she:ConfirmBooking .

she:ConfirmBooking a skos:Concept ;
    skos:prefLabel "confirm booking" ;
    she:ifNo she:BookAFlight ;
    she:ifYes she:Reserve .

she:Reserve a skos:Concept ;
    skos:prefLabel "reserve" ;
    she:nextStep she:End .

she:End a skos:Concept ;
    skos:prefLabel "end" .
