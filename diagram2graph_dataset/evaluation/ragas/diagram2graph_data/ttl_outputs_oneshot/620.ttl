@prefix she:  <https://soilwise-he.github.io/soil-health#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

she:Start a skos:Concept ;
    skos:prefLabel "start" ;
    she:leadsTo she:SubmitRegistrationForm .

she:SubmitRegistrationForm a skos:Concept ;
    skos:prefLabel "submit the registration form" ;
    she:leadsTo she:FormComplete .

she:FormComplete a skos:Concept ;
    skos:prefLabel "form complete?" ;
    she:onNo she:SubmitRegistrationForm ;
    she:onYes she:VerifyDetails .

she:VerifyDetails a skos:Concept ;
    skos:prefLabel "verify details" ;
    she:leadsTo she:AcceptSubmission .

she:AcceptSubmission a skos:Concept ;
    skos:prefLabel "accept submission?" ;
    she:onNo she:ReturnDocument ;
    she:onYes she:WriteAcceptanceLetter .

she:ReturnDocument a skos:Concept ;
    skos:prefLabel "return document" ;
    she:leadsTo she:End .

she:WriteAcceptanceLetter a skos:Concept ;
    skos:prefLabel "write acceptance letter" ;
    she:leadsTo she:Confirmation .

she:Confirmation a skos:Concept ;
    skos:prefLabel "confirmation" ;
    she:leadsTo she:End .

she:End a skos:Concept ;
    skos:prefLabel "end" .
