@prefix she:  <https://soilwise-he.github.io/soil-health#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

she:InputImage a skos:Concept ;
    skos:prefLabel "image" ;
    she:leadsTo she:ThreeDPointCloud .

she:ThreeDPointCloud a skos:Concept ;
    skos:prefLabel "3d point cloud" ;
    she:leadsTo she:Threshold .

she:Threshold a skos:Concept ;
    skos:prefLabel "threshold" ;
    she:leadsTo she:Preprocessing .

she:Preprocessing a skos:Concept ;
    skos:prefLabel "preprocessing" ;
    she:leadsTo she:Information .

she:Information a skos:Concept ;
    skos:prefLabel "information" ;
    she:leadsTo she:GestureRecognition .

she:GestureRecognition a skos:Concept ;
    skos:prefLabel "gesture recognition" ;
    she:leadsTo she:OutputImage .

she:OutputImage a skos:Concept ;
    skos:prefLabel "image" .
