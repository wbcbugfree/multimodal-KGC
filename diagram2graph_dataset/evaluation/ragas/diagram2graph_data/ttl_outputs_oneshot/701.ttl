@prefix she:  <https://soilwise-he.github.io/soil-health#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

she:LogIn a skos:Concept ;
    skos:prefLabel "log in" ;
    she:proceedsTo she:LoggedIn .

she:LoggedIn a skos:Concept ;
    skos:prefLabel "logged in" ;
    she:ifYesProceedsTo she:Home ;
    she:ifNoProceedsTo she:OpenID .

she:OpenID a skos:Concept ;
    skos:prefLabel "openid" ;
    she:proceedsTo she:Home .

she:Home a skos:Concept ;
    skos:prefLabel "home" .
