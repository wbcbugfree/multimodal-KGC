@prefix she:  <https://soilwise-he.github.io/soil-health#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

she:Start a skos:Concept ;
    skos:prefLabel "start" ;
    she:leadsTo she:Greet .

she:Greet a skos:Concept ;
    skos:prefLabel "greet" ;
    she:leadsTo she:EnterId ;
    she:leadsToOnFailure she:AcceptNoCommands .

she:EnterId a skos:Concept ;
    skos:prefLabel "enter id" ;
    she:leadsTo she:InputDriverInformation .

she:InputDriverInformation a skos:Concept ;
    skos:prefLabel "input driver information" ;
    she:leadsTo she:VerifyFingerScan .

she:VerifyFingerScan a skos:Concept ;
    skos:prefLabel "verify finger scan" ;
    she:leadsToOnVerificationFailure she:ScanFingerAgain .

she:ScanFingerAgain a skos:Concept ;
    skos:prefLabel "scan finger again" ;
    she:leadsTo she:FirstAndSecondScanMatch .

she:FirstAndSecondScanMatch a skos:Concept ;
    skos:prefLabel "1st and 2nd scan match?" ;
    she:leadsToOnMatch she:Login ;
    she:leadsToOnNoMatch she:EnterId .

she:Login a skos:Concept ;
    skos:prefLabel "login" ;
    she:leadsTo she:Stop .

she:Stop a skos:Concept ;
    skos:prefLabel "stop" .

she:AcceptNoCommands a skos:Concept ;
    skos:prefLabel "accept no commands" .
