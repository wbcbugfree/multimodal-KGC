@prefix she:  <https://soilwise-he.github.io/soil-health#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

she:StartLoop a skos:Concept ;
    skos:prefLabel "start loop" ;
    she:leadsTo she:Initialize .

she:Initialize a skos:Concept ;
    skos:prefLabel "initialize" ;
    she:evaluatesToTrueLeadsTo she:Process ;
    she:evaluatesToFalseLeadsTo she:EndLoop .

she:Process a skos:Concept ;
    skos:prefLabel "process" ;
    she:leadsTo she:IncrementOrDecrement .

she:IncrementOrDecrement a skos:Concept ;
    skos:prefLabel "increment or decrement" ;
    she:continuesLoopWith she:Initialize .

she:EndLoop a skos:Concept ;
    skos:prefLabel "end loop" .
