@prefix she:  <https://soilwise-he.github.io/soil-health#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

she:Start a skos:Concept ;
    skos:prefLabel "start" ;
    she:leadsTo she:SetUpTheTrainingPattern .

she:SetUpTheTrainingPattern a skos:Concept ;
    skos:prefLabel "set up the training pattern" ;
    she:leadsTo she:SetUpTheStructure .

she:SetUpTheStructure a skos:Concept ;
    skos:prefLabel "set up the structure" ;
    she:leadsTo she:UseTheTrainingPattern .

she:UseTheTrainingPattern a skos:Concept ;
    skos:prefLabel "use the training pattern" ;
    she:leadsTo she:TrainingFinished .

she:TrainingFinished a skos:Concept ;
    skos:prefLabel "training finished ?" ;
    she:ifNo she:UseTheTrainingPattern ;
    she:ifYes she:SaveTheConnectionWeights .

she:SaveTheConnectionWeights a skos:Concept ;
    skos:prefLabel "save the connection weights" ;
    she:leadsTo she:PowerQualityAnalysis .

she:PowerQualityAnalysis a skos:Concept ;
    skos:prefLabel "power quality analysis" ;
    she:leadsTo she:End .

she:End a skos:Concept ;
    skos:prefLabel "end" .
