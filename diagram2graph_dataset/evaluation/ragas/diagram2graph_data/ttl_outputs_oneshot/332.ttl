@prefix she:  <https://soilwise-he.github.io/soil-health#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

she:Start a skos:Concept ;
    skos:prefLabel "start" ;
    she:precedes she:Input .

she:Input a skos:Concept ;
    skos:prefLabel "input" ;
    she:precedes she:FahrenheitToCelsiusConversion .

she:FahrenheitToCelsiusConversion a skos:Concept ;
    skos:prefLabel "c=5/9*(f-32)" ;
    she:precedes she:Display .

she:Display a skos:Concept ;
    skos:prefLabel "display" ;
    she:precedes she:End .

she:End a skos:Concept ;
    skos:prefLabel "end" .
