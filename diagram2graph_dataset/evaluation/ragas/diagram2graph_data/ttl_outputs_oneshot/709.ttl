@prefix she:  <https://soilwise-he.github.io/soil-health#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

she:Begin a skos:Concept ;
    skos:prefLabel "begin" ;
    she:proceedsTo she:RunMainFLASH .

she:RunMainFLASH a skos:Concept ;
    skos:prefLabel "run main flash" ;
    she:proceedsTo she:IsTheMainFLASHApplicationOK .

she:IsTheMainFLASHApplicationOK a skos:Concept ;
    skos:prefLabel "is the main flash application ok?" ;
    she:ifYes she:MainApplication ;
    she:ifNo she:InitializeIAPInterface .

she:MainApplication a skos:Concept ;
    skos:prefLabel "main application" ;
    she:proceedsTo she:InitializeIAPInterface .

she:InitializeIAPInterface a skos:Concept ;
    skos:prefLabel "initialize iap interface" ;
    she:proceedsTo she:IsIAPRequestReceived .

she:IsIAPRequestReceived a skos:Concept ;
    skos:prefLabel "is iap request received?" ;
    she:ifNo she:IsIAPRequestReceived ;
    she:ifYes she:ReprogramMainApplication .

she:ReprogramMainApplication a skos:Concept ;
    skos:prefLabel "reprogram main application" ;
    she:proceedsTo she:RESET .

she:RESET a skos:Concept ;
    skos:prefLabel "reset" .
