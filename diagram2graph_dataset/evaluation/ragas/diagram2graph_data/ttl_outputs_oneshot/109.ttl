@prefix she:  <https://soilwise-he.github.io/soil-health#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

she:StartUp a skos:Concept ;
    skos:prefLabel "start-up" ;
    she:nextStep she:InputVariables .

she:InputVariables a skos:Concept ;
    skos:prefLabel "input variables" ;
    she:nextStep she:Operator .

she:Operator a skos:Concept ;
    skos:prefLabel "operator" ;
    she:nextStep she:MainFunction .

she:MainFunction a skos:Concept ;
    skos:prefLabel "main function" ;
    she:nextStep she:MpuWdt1Setup .

she:MpuWdt1Setup a skos:Concept ;
    skos:prefLabel "mpu wdt1 setup" ;
    she:nextStep she:Configuration .

she:Configuration a skos:Concept ;
    skos:prefLabel "configuration" ;
    she:nextStep she:Finish .

she:Finish a skos:Concept ;
    skos:prefLabel "finish" .
