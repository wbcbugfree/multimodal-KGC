@prefix she: <https://soilwise-he.github.io/soil-health#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

she:Start a skos:Concept ;
    skos:prefLabel "start" ;
    skos:narrower she:EditVideo .

she:EditVideo a skos:Concept ;
    skos:prefLabel "edit video" ;
    skos:narrower she:ShortVideo .

she:ShortVideo a skos:Concept ;
    skos:prefLabel "short video" ;
    she:ifYesLeadsTo she:ClickToUpload .

she:ClickToUpload a skos:Concept ;
    skos:prefLabel "click to upload" ;
    skos:narrower she:VipUser .

she:VipUser a skos:Concept ;
    skos:prefLabel "vip user?" ;
    she:ifNoLeadsTo she:SignUp ;
    she:ifYesLeadsTo she:Login .

she:SignUp a skos:Concept ;
    skos:prefLabel "sign up" ;
    skos:narrower she:VipUser .

she:Login a skos:Concept ;
    skos:prefLabel "login" ;
    skos:narrower she:BrowseToUpload .

she:BrowseToUpload a skos:Concept ;
    skos:prefLabel "browse to upload" ;
    skos:narrower she:Finish .

she:Finish a skos:Concept ;
    skos:prefLabel "finish" .
