@prefix she:  <https://soilwise-he.github.io/soil-health#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

she:Start a skos:Concept ;
    skos:prefLabel "start" ;
    she:leadsTo she:InputNumbers .

she:InputNumbers a skos:Concept ;
    skos:prefLabel "input numbers" ;
    she:leadsTo she:PerformOperationDecision .

she:PerformOperationDecision a skos:Concept ;
    skos:prefLabel "perform operation" ;
    she:ifNoLeadsTo she:InputLatestNumber ;
    she:ifYesLeadsTo she:FindAverage .

she:InputLatestNumber a skos:Concept ;
    skos:prefLabel "input latest" ;
    she:leadsTo she:UpdateTotal .

she:UpdateTotal a skos:Concept ;
    skos:prefLabel "total = total + latest" ;
    she:loopsBackTo she:PerformOperationDecision .

she:FindAverage a skos:Concept ;
    skos:prefLabel "find average" ;
    she:leadsTo she:OutputTotalMessage .

she:OutputTotalMessage a skos:Concept ;
    skos:prefLabel "output \"the total of the numbers was \" + total" ;
    she:leadsTo she:PrintFinalResult .

she:PrintFinalResult a skos:Concept ;
    skos:prefLabel "print result" ;
    she:leadsTo she:Stop .

she:Stop a skos:Concept ;
    skos:prefLabel "stop" .
