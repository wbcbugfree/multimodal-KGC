@prefix she:  <https://soilwise-he.github.io/soil-health#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

she:Start a skos:Concept ;
    skos:prefLabel "start" ;
    she:initiates she:ReadValues .

she:ReadValues a skos:Concept ;
    skos:prefLabel "read values" ;
    she:proceedsTo she:NewTrialsAvailable .

she:NewTrialsAvailable a skos:Concept ;
    skos:prefLabel "new trials available?" ;
    she:ifNoProceedsTo she:ReadValues ;
    she:ifYesProceedsTo she:ReadNewTrial .

she:ReadNewTrial a skos:Concept ;
    skos:prefLabel "read new trial" ;
    she:proceedsTo she:AverageAvailableForCondition .

she:AverageAvailableForCondition a skos:Concept ;
    skos:prefLabel "average available for condition?" ;
    she:ifNoProceedsTo she:Initialize ;
    she:ifYesProceedsTo she:AddDataToCumulativeSum .

she:Initialize a skos:Concept ;
    skos:prefLabel "initialize" ;
    she:proceedsTo she:AddDataToCumulativeSum .

she:AddDataToCumulativeSum a skos:Concept ;
    skos:prefLabel "add data to cumulative sum" ;
    she:proceedsTo she:ComputeTValueAndPlot .

she:ComputeTValueAndPlot a skos:Concept ;
    skos:prefLabel "compute t-value and plot" ;
    she:proceedsTo she:Continue .

she:Continue a skos:Concept ;
    skos:prefLabel "continue?" ;
    she:ifNoProceedsTo she:Stop ;
    she:ifYesProceedsTo she:ReadValues .

she:Stop a skos:Concept ;
    skos:prefLabel "stop" .
