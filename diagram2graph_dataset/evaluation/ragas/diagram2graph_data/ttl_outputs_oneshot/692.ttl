@prefix she: <https://soilwise-he.github.io/soil-health#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

she:Start a skos:Concept ;
    skos:prefLabel "start" ;
    she:leadsTo she:InputData .

she:InputData a skos:Concept ;
    skos:prefLabel "input data" ;
    she:leadsTo she:Process .

she:Process a skos:Concept ;
    skos:prefLabel "process" ;
    she:leadsTo she:LookingForGain .

she:LookingForGain a skos:Concept ;
    skos:prefLabel "looking for gain" ;
    she:leadsTo she:DetermineTheHighestGain .

she:DetermineTheHighestGain a skos:Concept ;
    skos:prefLabel "determine the highest gain" ;
    she:leadsTo she:Update .

she:Update a skos:Concept ;
    skos:prefLabel "update" ;
    she:leadsTo she:Finished .

she:Finished a skos:Concept ;
    skos:prefLabel "finished" ;
    she:ifNoLeadsTo she:LookingForGain ;
    she:ifYesLeadsTo she:End .

she:End a skos:Concept ;
    skos:prefLabel "end" .
