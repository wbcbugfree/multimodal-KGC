@prefix she:  <https://soilwise-he.github.io/soil-health#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

she:DataProcess a skos:Concept ;
    skos:prefLabel "data process" ;
    she:precedes she:DegreeCalculation .

she:DegreeCalculation a skos:Concept ;
    skos:prefLabel "degree calculation" ;
    she:precedes she:AreaCalculation .

she:AreaCalculation a skos:Concept ;
    skos:prefLabel "area calculation" ;
    she:precedes she:SimilarityCalculation .

she:SimilarityCalculation a skos:Concept ;
    skos:prefLabel "similarity calculation" ;
    she:precedes she:CoreCalculation .

she:CoreCalculation a skos:Concept ;
    skos:prefLabel "core calculation" ;
    she:precedes she:DimensionExpansion .

she:DimensionExpansion a skos:Concept ;
    skos:prefLabel "dimension expansion" ;
    she:precedes she:Finish .

she:Finish a skos:Concept ;
    skos:prefLabel "finish" .
