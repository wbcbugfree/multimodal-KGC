@prefix she:  <https://soilwise-he.github.io/soil-health#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

she:Start a skos:Concept ;
    skos:prefLabel "start" ;
    she:leadsTo she:Input .

she:Input a skos:Concept ;
    skos:prefLabel "input" ;
    she:leadsTo she:ConditionCIsLessThanOrEqualTo10 .

she:ConditionCIsLessThanOrEqualTo10 a skos:Concept ;
    skos:prefLabel "c<=10?" ;
    she:ifTrueLeadsTo she:Output ;
    she:ifFalseLeadsTo she:End .

she:Output a skos:Concept ;
    skos:prefLabel "output" ;
    she:leadsTo she:IncrementC .

she:IncrementC a skos:Concept ;
    skos:prefLabel "c = c + 1" ;
    she:loopsTo she:ConditionCIsLessThanOrEqualTo10 .

she:End a skos:Concept ;
    skos:prefLabel "end" .
