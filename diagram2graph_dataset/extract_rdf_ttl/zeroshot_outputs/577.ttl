@prefix d2g:  <http://example.org/diagram2graph#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://example.org/diagram/diagram/node/1> a d2g:Node, d2g:Start ;
    rdfs:label "Begin" ;
    d2g:shape d2g:StartEvent ;
    d2g:follows <http://example.org/diagram/diagram/node/2> .

<http://example.org/diagram/diagram/node/2> a d2g:Node, d2g:Process ;
    rdfs:label "Online Application" ;
    d2g:shape d2g:Task ;
    d2g:follows <http://example.org/diagram/diagram/node/3> .

<http://example.org/diagram/diagram/node/3> a d2g:Node, d2g:Process ;
    rdfs:label "Applicant meets with a loan officer to discuss their needs" ;
    d2g:shape d2g:Task ;
    d2g:follows <http://example.org/diagram/diagram/node/4> .

<http://example.org/diagram/diagram/node/4> a d2g:Node, d2g:Process ;
    rdfs:label "Process Application" ;
    d2g:shape d2g:Task ;
    d2g:follows <http://example.org/diagram/diagram/node/5> .

<http://example.org/diagram/diagram/node/5> a d2g:Node, d2g:Decision ;
    rdfs:label "Application reviewed by the office manager" ;
    d2g:shape d2g:Gateway ;
    d2g:branches <http://example.org/diagram/diagram/node/6>, <http://example.org/diagram/diagram/node/7> .

<http://example.org/diagram/diagram/node/6> a d2g:Node, d2g:Process ;
    rdfs:label "Application Rejected" ;
    d2g:shape d2g:Task ;
    d2g:follows <http://example.org/diagram/diagram/node/8> .

<http://example.org/diagram/diagram/node/7> a d2g:Node, d2g:Process ;
    rdfs:label "Application Approved" ;
    d2g:shape d2g:Task ;
    d2g:follows <http://example.org/diagram/diagram/node/8> .

<http://example.org/diagram/diagram/node/8> a d2g:Node, d2g:Terminator ;
    rdfs:label "END" ;
    d2g:shape d2g:EndEvent .

<http://example.org/diagram/diagram/edge/12> a d2g:Edge, d2g:Solid ;
    d2g:source <http://example.org/diagram/diagram/node/1> ;
    d2g:target <http://example.org/diagram/diagram/node/2> ;
    d2g:relationshipType d2g:Follows .

<http://example.org/diagram/diagram/edge/23> a d2g:Edge, d2g:Solid ;
    d2g:source <http://example.org/diagram/diagram/node/2> ;
    d2g:target <http://example.org/diagram/diagram/node/3> ;
    d2g:relationshipType d2g:Follows .

<http://example.org/diagram/diagram/edge/34> a d2g:Edge, d2g:Solid ;
    d2g:source <http://example.org/diagram/diagram/node/3> ;
    d2g:target <http://example.org/diagram/diagram/node/4> ;
    d2g:relationshipType d2g:Follows .

<http://example.org/diagram/diagram/edge/45> a d2g:Edge, d2g:Solid ;
    d2g:source <http://example.org/diagram/diagram/node/4> ;
    d2g:target <http://example.org/diagram/diagram/node/5> ;
    d2g:relationshipType d2g:Follows .

<http://example.org/diagram/diagram/edge/56> a d2g:Edge, d2g:Solid ;
    d2g:source <http://example.org/diagram/diagram/node/5> ;
    d2g:target <http://example.org/diagram/diagram/node/6> ;
    d2g:relationshipType d2g:Branches ;
    d2g:relationshipValue "N" .

<http://example.org/diagram/diagram/edge/57> a d2g:Edge, d2g:Solid ;
    d2g:source <http://example.org/diagram/diagram/node/5> ;
    d2g:target <http://example.org/diagram/diagram/node/7> ;
    d2g:relationshipType d2g:Branches ;
    d2g:relationshipValue "Y" .

<http://example.org/diagram/diagram/edge/68> a d2g:Edge, d2g:Solid ;
    d2g:source <http://example.org/diagram/diagram/node/6> ;
    d2g:target <http://example.org/diagram/diagram/node/8> ;
    d2g:relationshipType d2g:Follows .

<http://example.org/diagram/diagram/edge/78> a d2g:Edge, d2g:Solid ;
    d2g:source <http://example.org/diagram/diagram/node/7> ;
    d2g:target <http://example.org/diagram/diagram/node/8> ;
    d2g:relationshipType d2g:Follows .
