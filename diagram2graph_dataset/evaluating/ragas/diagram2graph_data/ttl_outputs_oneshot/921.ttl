@prefix she:  <https://soilwise-he.github.io/soil-health#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

she:Start a skos:Concept ;
    skos:prefLabel "start" ;
    she:leadsTo she:EnterAcmeWebsite .

she:EnterAcmeWebsite a skos:Concept ;
    skos:prefLabel "enter www.acme.com" ;
    she:leadsTo she:AcmeHomepage .

she:AcmeHomepage a skos:Concept ;
    skos:prefLabel "acme home page" ;
    she:leadsTo she:EnterEmailAndPassword .

she:EnterEmailAndPassword a skos:Concept ;
    skos:prefLabel "enter email id and password" ;
    she:leadsTo she:IsEmailAndPasswordCorrect .

she:IsEmailAndPasswordCorrect a skos:Concept ;
    skos:prefLabel "is email id and password correct?" ;
    she:ifNo she:LoginError ;
    she:ifYes she:DisplayAccount .

she:LoginError a skos:Concept ;
    skos:prefLabel "log in error" ;
    she:returnsTo she:EnterEmailAndPassword .

she:DisplayAccount a skos:Concept ;
    skos:prefLabel "display account" ;
    she:leadsTo she:Stop .

she:Stop a skos:Concept ;
    skos:prefLabel "stop" .
