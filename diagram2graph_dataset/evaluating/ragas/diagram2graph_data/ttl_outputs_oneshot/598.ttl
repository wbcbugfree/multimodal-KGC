@prefix she:  <https://soilwise-he.github.io/soil-health#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

she:NewMember a skos:Concept ;
    skos:prefLabel "new member" ;
    she:submitsUserNamePasswordTo she:Login .

she:Login a skos:Concept ;
    skos:prefLabel "login" ;
    she:initiates she:Authentication .

she:Authentication a skos:Concept ;
    skos:prefLabel "authentication" ;
    she:redirectsIfNotMemberTo she:PrintInfo ;
    she:proceedsIfExistingMemberTo she:Validation ;
    she:sendsDataTo she:D1 ;
    she:sendsAdpCredentialsTo she:Validation .

she:PrintInfo a skos:Concept ;
    skos:prefLabel "print info" ;
    she:returnsTo she:NewMember .

she:Validation a skos:Concept ;
    skos:prefLabel "validation" ;
    she:outputsAdpCredentialsTo she:D2 .

she:D1 a skos:Concept ;
    skos:prefLabel "d1" .

she:D2 a skos:Concept ;
    skos:prefLabel "d2" .
