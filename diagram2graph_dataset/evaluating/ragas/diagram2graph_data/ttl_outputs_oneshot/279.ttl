@prefix she:  <https://soilwise-he.github.io/soil-health#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

she:Start a skos:Concept ;
    skos:prefLabel "start" ;
    she:leadsTo she:FindChangesInWork .

she:FindChangesInWork a skos:Concept ;
    skos:prefLabel "find changes in work" ;
    she:leadsTo she:Approval .

she:Approval a skos:Concept ;
    skos:prefLabel "approval" ;
    she:ifYes she:Method ;
    she:ifNo she:IgnoreChange .

she:Method a skos:Concept ;
    skos:prefLabel "method" ;
    she:leadsTo she:Agree .

she:Agree a skos:Concept ;
    skos:prefLabel "agree?" ;
    she:ifYes she:Expand ;
    she:ifNo she:Discard .

she:Expand a skos:Concept ;
    skos:prefLabel "expand" ;
    she:leadsTo she:End .

she:Discard a skos:Concept ;
    skos:prefLabel "discard" ;
    she:leadsTo she:End .

she:IgnoreChange a skos:Concept ;
    skos:prefLabel "ignore change" ;
    she:leadsTo she:End .

she:End a skos:Concept ;
    skos:prefLabel "end" .
