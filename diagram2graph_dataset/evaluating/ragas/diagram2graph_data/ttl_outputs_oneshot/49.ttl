@prefix she:  <https://soilwise-he.github.io/soil-health#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

she:Start a skos:Concept ;
    skos:prefLabel "start" ;
    she:leadsTo she:ReadPRN .

she:ReadPRN a skos:Concept ;
    skos:prefLabel "read p,r,n" ;
    she:leadsTo she:CalculateSimpleInterest .

she:CalculateSimpleInterest a skos:Concept ;
    skos:prefLabel "calculate i=(p * r * n) / 100" ;
    she:leadsTo she:PrintOutput .

she:PrintOutput a skos:Concept ;
    skos:prefLabel "print output" ;
    she:leadsTo she:Stop .

she:Stop a skos:Concept ;
    skos:prefLabel "stop" .
