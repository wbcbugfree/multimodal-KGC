@prefix she: <https://soilwise-he.github.io/soil-health#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

she:Start a skos:Concept ;
    skos:prefLabel "start" ;
    she:leadsTo she:Process1 .

she:Process1 a skos:Concept ;
    skos:prefLabel "process_1" ;
    she:leadsTo she:Process2 .

she:Process2 a skos:Concept ;
    skos:prefLabel "process_2" ;
    she:leadsTo she:Process3 .

she:Process3 a skos:Concept ;
    skos:prefLabel "process_3" ;
    she:leadsTo she:Process4 .

she:Process4 a skos:Concept ;
    skos:prefLabel "process_4" ;
    she:leadsTo she:Process5 .

she:Process5 a skos:Concept ;
    skos:prefLabel "process_5" ;
    she:leadsTo she:End .

she:End a skos:Concept ;
    skos:prefLabel "end" .
