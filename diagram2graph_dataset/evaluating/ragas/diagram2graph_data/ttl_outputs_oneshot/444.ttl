@prefix she:  <https://soilwise-he.github.io/soil-health#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

she:Begin a skos:Concept ;
    skos:prefLabel "begin" ;
    she:leadsTo she:ProcessStep1 .

she:ProcessStep1 a skos:Concept ;
    skos:prefLabel "process step 1" ;
    she:leadsTo she:Decision .

she:Decision a skos:Concept ;
    skos:prefLabel "decision?" ;
    she:leadsToIfChoice1 she:ProcessStep2 ;
    she:leadsToIfChoice2 she:ProcessStep1 .

she:ProcessStep2 a skos:Concept ;
    skos:prefLabel "process step 2" ;
    she:leadsTo she:ConnectorA .

she:ConnectorA a skos:Concept ;
    skos:prefLabel "a" .
