@prefix she:  <https://soilwise-he.github.io/soil-health#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

she:Begin a skos:Concept ;
    skos:prefLabel "begin" ;
    she:startsProcess she:EditVideo .

she:EditVideo a skos:Concept ;
    skos:prefLabel "edit video" ;
    she:nextStep she:SmallerThan2GB .

she:SmallerThan2GB a skos:Concept ;
    skos:prefLabel "smaller than 2gb?" ;
    she:onNoCondition she:EditVideo ;
    she:onYesCondition she:ClickToUpload .

she:ClickToUpload a skos:Concept ;
    skos:prefLabel "click to upload" ;
    she:nextStep she:HaveAnAccountAlready .

she:HaveAnAccountAlready a skos:Concept ;
    skos:prefLabel "have an account already?" ;
    she:onNoCondition she:Register ;
    she:onYesCondition she:Login .

she:Register a skos:Concept ;
    skos:prefLabel "register" ;
    she:nextStep she:Login .

she:Login a skos:Concept ;
    skos:prefLabel "login" ;
    she:nextStep she:FindOnComputer .

she:FindOnComputer a skos:Concept ;
    skos:prefLabel "find on computer" ;
    she:nextStep she:AddDescriptionAndTags .

she:AddDescriptionAndTags a skos:Concept ;
    skos:prefLabel "add description and tags" ;
    she:endsProcess she:Stop .

she:Stop a skos:Concept ;
    skos:prefLabel "stop" .
