@prefix she:  <https://soilwise-he.github.io/soil-health#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

she:Start a skos:Concept ;
    skos:prefLabel "start" ;
    she:nextStep she:AcceptInputFromUser .

she:AcceptInputFromUser a skos:Concept ;
    skos:prefLabel "accept input from user" ;
    she:nextStep she:ConditionForLoop .

she:ConditionForLoop a skos:Concept ;
    skos:prefLabel "condition for (i = 1; i <= a; i++)" ;
    she:onTrue she:Process ;
    she:onFalse she:PrintValueOfFactorial .

she:Process a skos:Concept ;
    skos:prefLabel "process" ;
    she:returnsTo she:ConditionForLoop .

she:PrintValueOfFactorial a skos:Concept ;
    skos:prefLabel "print value of factorial" ;
    she:nextStep she:Stop .

she:Stop a skos:Concept ;
    skos:prefLabel "stop" .
