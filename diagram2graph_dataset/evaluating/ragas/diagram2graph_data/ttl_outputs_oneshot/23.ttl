@prefix she: <https://soilwise-he.github.io/soil-health#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

she:Begin a skos:Concept ;
    skos:prefLabel "begin" ;
    she:leadsTo she:ReadParameters .

she:ReadParameters a skos:Concept ;
    skos:prefLabel "read parameters" ;
    she:leadsTo she:PerformOperations .

she:PerformOperations a skos:Concept ;
    skos:prefLabel "perform operations" ;
    she:leadsTo she:UpdateValues .

she:UpdateValues a skos:Concept ;
    skos:prefLabel "update values" ;
    she:leadsTo she:UpdatePositionAndVelocityForAllParticles .

she:UpdatePositionAndVelocityForAllParticles a skos:Concept ;
    skos:prefLabel "update the position and velocity for all the particles" ;
    she:leadsTo she:TerminationConditionSatisfied .

she:TerminationConditionSatisfied a skos:Concept ;
    skos:prefLabel "termination condition satisfied ?" ;
    she:ifNoLeadsTo she:PerformOperations ;
    she:ifYesLeadsTo she:PrintOutput .

she:PrintOutput a skos:Concept ;
    skos:prefLabel "print output" ;
    she:leadsTo she:End .

she:End a skos:Concept ;
    skos:prefLabel "end" .
