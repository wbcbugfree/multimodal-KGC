@prefix she:  <https://soilwise-he.github.io/soil-health#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

she:Start a skos:Concept ;
    skos:prefLabel "start" ;
    she:nextStep she:ReadInputs .

she:ReadInputs a skos:Concept ;
    skos:prefLabel "read inputs" ;
    she:nextStep she:ReadCommandFromBluetoothUnit .

she:ReadCommandFromBluetoothUnit a skos:Concept ;
    skos:prefLabel "read command from bluetooth unit" ;
    she:nextStep she:RunSensors .

she:RunSensors a skos:Concept ;
    skos:prefLabel "run sensors" ;
    she:nextStep she:ReadSensorValues .

she:ReadSensorValues a skos:Concept ;
    skos:prefLabel "read sensor values" ;
    she:nextStep she:SendReadSensorValuesToBluetoothUnit .

she:SendReadSensorValuesToBluetoothUnit a skos:Concept ;
    skos:prefLabel "send read sensor values to bluetooth unit" ;
    she:nextStep she:ReadCommandFromBluetoothUnit .
