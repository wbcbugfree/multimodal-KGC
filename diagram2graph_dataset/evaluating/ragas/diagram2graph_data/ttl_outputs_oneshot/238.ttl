@prefix she: <https://soilwise-he.github.io/soil-health#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

she:Start a skos:Concept ;
    skos:prefLabel "start" ;
    she:leadsTo she:Login .

she:Login a skos:Concept ;
    skos:prefLabel "login" ;
    she:leadsTo she:VerifiedQuestion .

she:VerifiedQuestion a skos:Concept ;
    skos:prefLabel "verified?" ;
    she:hasOutcomeYes she:Dashboard ;
    she:hasOutcomeNo she:Login .

she:Dashboard a skos:Concept ;
    skos:prefLabel "dashboard" ;
    she:leadsTo she:ClickOnTheReportIncidentLink .

she:ClickOnTheReportIncidentLink a skos:Concept ;
    skos:prefLabel "click on the report incident link" ;
    she:leadsTo she:FillTheForm .

she:FillTheForm a skos:Concept ;
    skos:prefLabel "fill the form" ;
    she:leadsTo she:ValidationModule .

she:ValidationModule a skos:Concept ;
    skos:prefLabel "validation module" ;
    she:leadsTo she:NeedQuestion .

she:NeedQuestion a skos:Concept ;
    skos:prefLabel "need?" ;
    she:hasOutcomeYes she:ViewCommentsOnThePost ;
    she:hasOutcomeNo she:UpdateForm .

she:UpdateForm a skos:Concept ;
    skos:prefLabel "update form" ;
    she:leadsTo she:Submit .

she:Submit a skos:Concept ;
    skos:prefLabel "submit" ;
    she:leadsTo she:ValidationModule .

she:ViewCommentsOnThePost a skos:Concept ;
    skos:prefLabel "view comments on the post" ;
    she:leadsTo she:Stop .

she:Stop a skos:Concept ;
    skos:prefLabel "stop" .
