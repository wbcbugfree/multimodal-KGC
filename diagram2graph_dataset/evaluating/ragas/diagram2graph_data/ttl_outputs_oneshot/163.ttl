@prefix she:  <https://soilwise-he.github.io/soil-health#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

she:Begin a skos:Concept ;
    skos:prefLabel "begin" ;
    she:leadsTo she:Work .

she:Work a skos:Concept ;
    skos:prefLabel "work" ;
    she:ifYesLeadsTo she:Add ;
    she:ifNoLeadsTo she:Process .

she:Add a skos:Concept ;
    skos:prefLabel "add" ;
    she:leadsTo she:End .

she:Process a skos:Concept ;
    skos:prefLabel "process" ;
    she:leadsTo she:Update,
                she:End .

she:Update a skos:Concept ;
    skos:prefLabel "update" ;
    she:leadsTo she:Process .

she:End a skos:Concept ;
    skos:prefLabel "end" .
