@prefix she:  <https://soilwise-he.github.io/soil-health#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

she:Begin a skos:Concept ;
    skos:prefLabel "begin" ;
    she:nextStepIs she:InitializeICounter .

she:InitializeICounter a skos:Concept ;
    skos:prefLabel "icounter = 1" ;
    she:nextStepIs she:OutputICounter .

she:OutputICounter a skos:Concept ;
    skos:prefLabel "output: icounter" ;
    she:nextStepIs she:IncrementICounter .

she:IncrementICounter a skos:Concept ;
    skos:prefLabel "increment" ;
    she:nextStepIs she:CheckICounterCondition .

she:CheckICounterCondition a skos:Concept ;
    skos:prefLabel "icounter <= 10" ;
    she:ifTrueNextStepIs she:OutputICounter ;
    she:ifFalseNextStepIs she:End .

she:End a skos:Concept ;
    skos:prefLabel "end" .
