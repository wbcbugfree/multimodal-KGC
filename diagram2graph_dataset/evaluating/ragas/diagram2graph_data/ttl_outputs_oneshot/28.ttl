@prefix she:  <https://soilwise-he.github.io/soil-health#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

she:Start a skos:Concept ;
    skos:prefLabel "start" ;
    she:startsProcess she:CheckTime .

she:CheckTime a skos:Concept ;
    skos:prefLabel "check time" ;
    she:proceedsTo she:Before4Pm .

she:Before4Pm a skos:Concept ;
    skos:prefLabel "before 4 pm?" ;
    she:ifTrueProceedsTo she:Home ;
    she:ifFalseProceedsTo she:Office .

she:Home a skos:Concept ;
    skos:prefLabel "home" ;
    she:proceedsTo she:School .

she:Office a skos:Concept ;
    skos:prefLabel "office" ;
    she:proceedsTo she:Check .

she:Check a skos:Concept ;
    skos:prefLabel "check" ;
    she:proceedsTo she:Before7Pm .

she:Before7Pm a skos:Concept ;
    skos:prefLabel "before 7 pm?" ;
    she:ifTrueProceedsTo she:School ;
    she:ifFalseLoopsBackTo she:Office .

she:School a skos:Concept ;
    skos:prefLabel "school" ;
    she:terminatesProcess she:End .

she:End a skos:Concept ;
    skos:prefLabel "end" .
