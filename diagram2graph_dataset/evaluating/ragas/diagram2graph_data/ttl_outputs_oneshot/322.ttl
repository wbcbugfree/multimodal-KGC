@prefix she:  <https://soilwise-he.github.io/soil-health#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

she:Start a skos:Concept ;
    skos:prefLabel "start" ;
    she:precedes she:Read .

she:Read a skos:Concept ;
    skos:prefLabel "read" ;
    she:precedes she:UpdateValue .

she:UpdateValue a skos:Concept ;
    skos:prefLabel "update value" ;
    she:precedes she:Print .

she:Print a skos:Concept ;
    skos:prefLabel "print" ;
    she:precedes she:ConditionXGreaterThanOrEqualToZero .

she:ConditionXGreaterThanOrEqualToZero a skos:Concept ;
    skos:prefLabel "x>=0" ;
    she:leadsToIfTrue she:UpdateValue ;
    she:leadsToIfFalse she:End .

she:End a skos:Concept ;
    skos:prefLabel "end" .
