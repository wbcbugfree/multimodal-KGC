@prefix she: <https://soilwise-he.github.io/soil-health#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

she:Start a skos:Concept ;
    skos:prefLabel "start" ;
    she:precedes she:Add .

she:Add a skos:Concept ;
    skos:prefLabel "add" ;
    she:precedes she:Sub .

she:Sub a skos:Concept ;
    skos:prefLabel "sub" ;
    she:precedes she:Print,
        she:Update .

she:Print a skos:Concept ;
    skos:prefLabel "print" ;
    she:precedes she:Stop .

she:Update a skos:Concept ;
    skos:prefLabel "update" ;
    she:precedes she:Stop .

she:Stop a skos:Concept ;
    skos:prefLabel "stop" .
