@prefix she:  <https://soilwise-he.github.io/soil-health#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

she:Start a skos:Concept ;
    skos:prefLabel "start" ;
    she:leadsTo she:EntryUsersPersonalId .

she:EntryUsersPersonalId a skos:Concept ;
    skos:prefLabel "entry users personal id" ;
    she:leadsTo she:LoginSuccess .

she:LoginSuccess a skos:Concept ;
    skos:prefLabel "login success" ;
    she:leadsTo she:ReadToNAnswer .

she:ReadToNAnswer a skos:Concept ;
    skos:prefLabel "read to-n answer" ;
    she:leadsTo she:StartLoop .

she:StartLoop a skos:Concept ;
    skos:prefLabel "start loop" ;
    she:loopsBackTo she:LoginSuccess ;
    she:proceedsTo she:InferenceProcess .

she:InferenceProcess a skos:Concept ;
    skos:prefLabel "inference process" ;
    she:leadsTo she:Conclusion .

she:Conclusion a skos:Concept ;
    skos:prefLabel "conclusion" ;
    she:ifYesThen she:PositioningDetectionForMonitoring ;
    she:ifNoThen she:Stop .

she:PositioningDetectionForMonitoring a skos:Concept ;
    skos:prefLabel "positioning detection for monitoring" ;
    she:leadsTo she:Stop .

she:Stop a skos:Concept ;
    skos:prefLabel "stop" .
