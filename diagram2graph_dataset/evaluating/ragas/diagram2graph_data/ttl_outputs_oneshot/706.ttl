@prefix she: <https://soilwise-he.github.io/soil-health#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

she:Start a skos:Concept ;
    skos:prefLabel "start" ;
    she:initiatesProcess she:CountInitialization .

she:CountInitialization a skos:Concept ;
    skos:prefLabel "count = 1" ;
    she:precedes she:CountCondition .

she:CountCondition a skos:Concept ;
    skos:prefLabel "count <= 3" ;
    she:ifTrueProceedsTo she:Input ;
    she:ifFalseProceedsTo she:Stop .

she:Input a skos:Concept ;
    skos:prefLabel "input" ;
    she:precedes she:Calculation .

she:Calculation a skos:Concept ;
    skos:prefLabel "p * n * r / 100" ;
    she:precedes she:Print .

she:Print a skos:Concept ;
    skos:prefLabel "print" ;
    she:precedes she:CountIncrement .

she:CountIncrement a skos:Concept ;
    skos:prefLabel "count = count + 1" ;
    she:returnsTo she:CountCondition .

she:Stop a skos:Concept ;
    skos:prefLabel "stop" .
