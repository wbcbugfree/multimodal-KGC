@prefix d2g: <http://example.org/diagram2graph#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

# === Nodes ===
<http://example.org/diagram/diagram/node/customer_consulting> a d2g:Process, d2g:Node ;
    rdfs:label "Customer Consulting and Quotation" ;
    d2g:shape d2g:Task .

<http://example.org/diagram/diagram/node/deal> a d2g:Decision, d2g:Node ;
    rdfs:label "Deal?" ;
    d2g:shape d2g:Gateway .

<http://example.org/diagram/diagram/node/go_home> a d2g:Process, d2g:Node ;
    rdfs:label "Go home" ;
    d2g:shape d2g:Task .

<http://example.org/diagram/diagram/node/invoice> a d2g:Process, d2g:Node ;
    rdfs:label "Invoice" ;
    d2g:shape d2g:Task .

<http://example.org/diagram/diagram/node/shipping> a d2g:Process, d2g:Node ;
    rdfs:label "Shipping" ;
    d2g:shape d2g:Task .

<http://example.org/diagram/diagram/node/custom_clearance> a d2g:Process, d2g:Node ;
    rdfs:label "Custom Clearance" ;
    d2g:shape d2g:Task .

<http://example.org/diagram/diagram/node/payment_mode> a d2g:Process, d2g:Node ;
    rdfs:label "Payment mode" ;
    d2g:shape d2g:Task .

<http://example.org/diagram/diagram/node/delivery> a d2g:Process, d2g:Node ;
    rdfs:label "Delivery" ;
    d2g:shape d2g:Task .

<http://example.org/diagram/diagram/node/service_payment> a d2g:Process, d2g:Node ;
    rdfs:label "Service Payment" ;
    d2g:shape d2g:Task .

<http://example.org/diagram/diagram/node/pay_foreign_exchange> a d2g:Decision, d2g:Node ;
    rdfs:label "Pay Foreign Exchange?" ;
    d2g:shape d2g:Gateway .

<http://example.org/diagram/diagram/node/payment> a d2g:Process, d2g:Node ;
    rdfs:label "Payment" ;
    d2g:shape d2g:Task .

<http://example.org/diagram/diagram/node/stop> a d2g:Terminator, d2g:Node ;
    rdfs:label "Stop" ;
    d2g:shape d2g:EndEvent .

# === Edges ===
<http://example.org/diagram/diagram/edge/customer_consultingdeal> a d2g:Solid, d2g:Edge ;
    d2g:source <http://example.org/diagram/diagram/node/customer_consulting> ;
    d2g:target <http://example.org/diagram/diagram/node/deal> ;
    d2g:relationshipType d2g:Follows .

<http://example.org/diagram/diagram/node/customer_consulting> d2g:follows <http://example.org/diagram/diagram/node/deal> .

<http://example.org/diagram/diagram/edge/dealinvoice> a d2g:Solid, d2g:Edge ;
    d2g:source <http://example.org/diagram/diagram/node/deal> ;
    d2g:target <http://example.org/diagram/diagram/node/invoice> ;
    d2g:relationshipType d2g:DependsOn ;
    d2g:relationshipValue "Yes" .

<http://example.org/diagram/diagram/node/deal> d2g:depends_on <http://example.org/diagram/diagram/node/invoice> .

<http://example.org/diagram/diagram/edge/dealgo_home> a d2g:Dashed, d2g:Edge ;
    d2g:source <http://example.org/diagram/diagram/node/deal> ;
    d2g:target <http://example.org/diagram/diagram/node/go_home> ;
    d2g:relationshipType d2g:DependsOn ;
    d2g:relationshipValue "No" .

<http://example.org/diagram/diagram/node/deal> d2g:depends_on <http://example.org/diagram/diagram/node/go_home> .

<http://example.org/diagram/diagram/edge/invoiceshipping> a d2g:Solid, d2g:Edge ;
    d2g:source <http://example.org/diagram/diagram/node/invoice> ;
    d2g:target <http://example.org/diagram/diagram/node/shipping> ;
    d2g:relationshipType d2g:Follows .

<http://example.org/diagram/diagram/node/invoice> d2g:follows <http://example.org/diagram/diagram/node/shipping> .

<http://example.org/diagram/diagram/edge/shippingcustom_clearance> a d2g:Solid, d2g:Edge ;
    d2g:source <http://example.org/diagram/diagram/node/shipping> ;
    d2g:target <http://example.org/diagram/diagram/node/custom_clearance> ;
    d2g:relationshipType d2g:Follows .

<http://example.org/diagram/diagram/node/shipping> d2g:follows <http://example.org/diagram/diagram/node/custom_clearance> .

<http://example.org/diagram/diagram/edge/custom_clearancepayment_mode> a d2g:Solid, d2g:Edge ;
    d2g:source <http://example.org/diagram/diagram/node/custom_clearance> ;
    d2g:target <http://example.org/diagram/diagram/node/payment_mode> ;
    d2g:relationshipType d2g:Follows .

<http://example.org/diagram/diagram/node/custom_clearance> d2g:follows <http://example.org/diagram/diagram/node/payment_mode> .

<http://example.org/diagram/diagram/edge/payment_modedelivery> a d2g:Solid, d2g:Edge ;
    d2g:source <http://example.org/diagram/diagram/node/payment_mode> ;
    d2g:target <http://example.org/diagram/diagram/node/delivery> ;
    d2g:relationshipType d2g:Follows .

<http://example.org/diagram/diagram/node/payment_mode> d2g:follows <http://example.org/diagram/diagram/node/delivery> .

<http://example.org/diagram/diagram/edge/deliveryservice_payment> a d2g:Solid, d2g:Edge ;
    d2g:source <http://example.org/diagram/diagram/node/delivery> ;
    d2g:target <http://example.org/diagram/diagram/node/service_payment> ;
    d2g:relationshipType d2g:Follows .

<http://example.org/diagram/diagram/node/delivery> d2g:follows <http://example.org/diagram/diagram/node/service_payment> .

<http://example.org/diagram/diagram/edge/service_paymentpay_foreign_exchange> a d2g:Solid, d2g:Edge ;
    d2g:source <http://example.org/diagram/diagram/node/service_payment> ;
    d2g:target <http://example.org/diagram/diagram/node/pay_foreign_exchange> ;
    d2g:relationshipType d2g:Follows .

<http://example.org/diagram/diagram/node/service_payment> d2g:follows <http://example.org/diagram/diagram/node/pay_foreign_exchange> .

<http://example.org/diagram/diagram/edge/pay_foreign_exchangepayment> a d2g:Solid, d2g:Edge ;
    d2g:source <http://example.org/diagram/diagram/node/pay_foreign_exchange> ;
    d2g:target <http://example.org/diagram/diagram/node/payment> ;
    d2g:relationshipType d2g:DependsOn ;
    d2g:relationshipValue "Yes" .

<http://example.org/diagram/diagram/node/pay_foreign_exchange> d2g:depends_on <http://example.org/diagram/diagram/node/payment> .

<http://example.org/diagram/diagram/edge/pay_foreign_exchangestop> a d2g:Dashed, d2g:Edge ;
    d2g:source <http://example.org/diagram/diagram/node/pay_foreign_exchange> ;
    d2g:target <http://example.org/diagram/diagram/node/stop> ;
    d2g:relationshipType d2g:DependsOn ;
    d2g:relationshipValue "No" .

<http://example.org/diagram/diagram/node/pay_foreign_exchange> d2g:depends_on <http://example.org/diagram/diagram/node/stop> .

<http://example.org/diagram/diagram/edge/paymentstop> a d2g:Solid, d2g:Edge ;
    d2g:source <http://example.org/diagram/diagram/node/payment> ;
    d2g:target <http://example.org/diagram/diagram/node/stop> ;
    d2g:relationshipType d2g:Follows .

<http://example.org/diagram/diagram/node/payment> d2g:follows <http://example.org/diagram/diagram/node/stop> .
