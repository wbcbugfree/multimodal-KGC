@prefix she: <https://soilwise-he.github.io/soil-health#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

she:DynamicAssessmentOfSoilHealth a skos:Concept ;
    skos:prefLabel "dynamic assessment of soil health" ;
    skos:narrower she:IndicatorsFromMonitoring,
                  she:SoilHealthStatus,
                  she:Time .

she:IndicatorsFromMonitoring a skos:Concept ;
    skos:prefLabel "indicators from monitoring" ;
    she:hasThreshold she:ThresholdForUnacceptableDegradation .

she:Time a skos:Concept ;
    skos:prefLabel "time" .

she:ThresholdForUnacceptableDegradation a skos:Concept ;
    skos:prefLabel "threshold for unacceptable degradation" .

she:SoilHealthStatus a skos:Concept ;
    skos:prefLabel "soil health status" ;
    skos:narrower she:Healthy,
                  she:Intermediate,
                  she:Unhealthy .

she:Unhealthy a skos:Concept ;
    skos:prefLabel "unhealthy" ;
    skos:definition "at least one indicator exceeds thresholds for unacceptable degradation (ecosystem services significantly compromised)" ;
    she:reachedBy she:NegativeTrend .

she:Intermediate a skos:Concept ;
    skos:prefLabel "intermediate" ;
    skos:definition "slight soil degradation at warning level (pre-cautionary soil protection)" ;
    skos:note "a) Exceedance of thresholds for intermediate risk (where available); b) Positive indicator trend while thresholds for unacceptable degradation are still exceeded; c) Negative indicator trend without any threshold exceedance; d) Sustainable soil management in place while thresholds are exceeded" ;
    skos:related she:SustainableSoilManagement,
                 she:ThresholdsForIntermediateRisk .

she:Healthy a skos:Concept ;
    skos:prefLabel "healthy" ;
    skos:definition "none of the indicators shows any threshold exceedance" ;
    she:reachedBy she:PositiveTrend .

she:PositiveTrend a skos:Concept ;
    skos:prefLabel "positive trend" ;
    she:improvesStatusTo she:Healthy .

she:NegativeTrend a skos:Concept ;
    skos:prefLabel "negative trend" ;
    she:degradesStatusTo she:Unhealthy .

she:SustainableSoilManagement a skos:Concept ;
    skos:prefLabel "sustainable soil management" .

she:ThresholdsForIntermediateRisk a skos:Concept ;
    skos:prefLabel "thresholds for intermediate risk" .
