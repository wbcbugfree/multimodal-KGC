@prefix she: <https://soilwise-he.github.io/soil-health#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

she:PolicyDocument a skos:Concept ;
    skos:prefLabel "policy document" ;
    skos:narrower she:ZeroPollutionActionPlanForAirSoilAndWater,
                  she:EUSoilStrategy2030 .

she:RelevantPolicyObjectivesOrTargets a skos:Concept ;
    skos:prefLabel "relevant policy objectives or targets" ;
    skos:narrower she:ZeroPollutionAmbition,
                  she:BetterMonitorReportPreventRemedyPollution,
                  she:ProposeNewPollutionLegislation,
                  she:FacilitateRemediationOfSoilPollution,
                  she:HealthySoilEcosystemsBy2050,
                  she:CombatDesertificationAndNoNetLandTake,
                  she:RestoreDegradedEcosystems,
                  she:LandBasedClimateNeutralityBy2035,
                  she:ReduceSoilPollutionImpact,
                  she:ContaminatedSiteManagement .

she:ZeroPollutionActionPlanForAirSoilAndWater a skos:Concept ;
    skos:prefLabel "zero pollution action plan for air, soil and water" ;
    she:hasAbbreviation "EC, 2021c" ;
    she:hasObjective she:ZeroPollutionAmbition,
                     she:BetterMonitorReportPreventRemedyPollution,
                     she:ProposeNewPollutionLegislation,
                     she:FacilitateRemediationOfSoilPollution .

she:EUSoilStrategy2030 a skos:Concept ;
    skos:prefLabel "eu soil strategy 2030" ;
    she:hasAbbreviation "EC, 2021e" ;
    she:hasObjective she:HealthySoilEcosystemsBy2050,
                     she:CombatDesertificationAndNoNetLandTake,
                     she:RestoreDegradedEcosystems,
                     she:LandBasedClimateNeutralityBy2035,
                     she:ReduceSoilPollutionImpact,
                     she:ContaminatedSiteManagement .

she:ZeroPollutionAmbition a skos:Concept ;
    skos:prefLabel "zero pollution ambition for a toxin-free environment" ;
    skos:note "Includes air, water and soil" .

she:BetterMonitorReportPreventRemedyPollution a skos:Concept ;
    skos:prefLabel "better monitor, report, prevent and remedy pollution" ;
    skos:note "Applied to air, water, soil and consumer products to levels no longer harmful to human health and the environment" .

she:ProposeNewPollutionLegislation a skos:Concept ;
    skos:prefLabel "propose new legislation covering significant pollution sources" ;
    skos:note "Targeting sources not yet addressed by other policies, strategies and protocols" .

she:FacilitateRemediationOfSoilPollution a skos:Concept ;
    skos:prefLabel "facilitate remediation of soil pollution" ;
    skos:definition "Via a monitoring framework on the state of pollution and an outlook report with specific assessments of human health and environmental impacts" .

she:HealthySoilEcosystemsBy2050 a skos:Concept ;
    skos:prefLabel "healthy eu soil ecosystems by 2050" ;
    skos:note "Goal for all EU soil ecosystems to be in healthy condition and more resilient" .

she:CombatDesertificationAndNoNetLandTake a skos:Concept ;
    skos:prefLabel "combat desertification and to achieve no net land take" .

she:RestoreDegradedEcosystems a skos:Concept ;
    skos:prefLabel "restore degraded ecosystems including soils" .

she:LandBasedClimateNeutralityBy2035 a skos:Concept ;
    skos:prefLabel "land-based climate neutrality by 2035" .

she:ReduceSoilPollutionImpact a skos:Concept ;
    skos:prefLabel "reducing the impact of soil pollution" ;
    skos:note "Impacts on ecosystems, waters, and human health" .

she:ContaminatedSiteManagement a skos:Concept ;
    skos:prefLabel "management of contaminated sites" ;
    skos:note "To achieve progress in the management of contaminated sites" .

she:NECDirective a skos:Concept ;
    skos:prefLabel "nec directive" ;
    skos:note "Involves ecosystem monitoring under Article 9 and Annex V" .

she:GothenburgProtocol a skos:Concept ;
    skos:prefLabel "gothenburg protocol" ;
    skos:note "Relates to thresholds based on the Working Group on Effects" .

she:EuropeanGreenDeal a skos:Concept ;
    skos:prefLabel "european green deal" ;
    skos:narrower she:BiodiversityStrategy2030,
                  she:FarmToForkStrategy,
                  she:ZeroPollutionActionPlanForAirSoilAndWater .

she:BiodiversityStrategy2030 a skos:Concept ;
    skos:prefLabel "biodiversity strategy 2030" .

she:FarmToForkStrategy a skos:Concept ;
    skos:prefLabel "farm to fork strategy" .

she:CircularEconomyActionPlan a skos:Concept ;
    skos:prefLabel "circular economy action plan for a clean and competitive europe" ;
    she:hasAbbreviation "EC, 2020l" .

she:ACleanPlanetForAll a skos:Concept ;
    skos:prefLabel "a clean planet for all" ;
    she:hasAbbreviation "EC, 2018" .

she:LowGreenhouseGasEmissionDevelopmentStrategy a skos:Concept ;
    skos:prefLabel "long-term low greenhouse gas emission development strategy" ;
    she:hasAbbreviation "EC, 2020k" .
