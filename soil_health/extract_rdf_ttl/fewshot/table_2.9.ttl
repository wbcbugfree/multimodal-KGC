@prefix she: <https://soilwise-he.github.io/soil-health#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

she:AggregationOfSOCThresholdsForSoilGroups a skos:Concept ;
    skos:prefLabel "aggregation of soc thresholds for soil groups" ;
    skos:narrower she:SoilGroup,
                  she:ClayFineSilt,
                  she:KorschensEtAl1998,
                  she:BMLFUW2017MinimumSOCThreshold,
                  she:SOCClayRatio .

she:SoilGroup a skos:Concept ;
    skos:prefLabel "soil group" ;
    skos:narrower she:LightSoil,
                  she:MediumSoil,
                  she:HeavySoil .

she:ClayFineSilt a skos:Concept ;
    skos:prefLabel "clay/fine silt (%)" .

she:KorschensEtAl1998 a skos:Concept ;
    skos:prefLabel "körschens et al. (1998)" ;
    skos:narrower she:SandySoils,
                  she:LoamySoils .

she:SandySoils a skos:Concept ;
    skos:prefLabel "sandy soils" .

she:LoamySoils a skos:Concept ;
    skos:prefLabel "loamy soils" .

she:BMLFUW2017MinimumSOCThreshold a skos:Concept ;
    skos:prefLabel "bmlfuw (2017) minimum soc threshold" .

she:SOCClayRatio a skos:Concept ;
    skos:prefLabel "soc/clay ratio" ;
    skos:narrower she:SOCClayRatio1_8,
                  she:SOCClayRatio1_10,
                  she:SOCClayRatio1_13 .

she:SOCClayRatio1_8 a skos:Concept ;
    skos:prefLabel "1/8" ;
    skos:note "optimum for good structural quality" .

she:SOCClayRatio1_10 a skos:Concept ;
    skos:prefLabel "1/10" ;
    skos:note "minimum desired soc level for farmers" .

she:SOCClayRatio1_13 a skos:Concept ;
    skos:prefLabel "1/13" ;
    skos:note "structural soil quality is unacceptable" .

she:LightSoil a skos:Concept ;
    skos:prefLabel "light (<15% clay)" ;
    skos:broader she:SoilGroup ;
    skos:narrower she:ClayRange4_7,
                  she:ClayRange8_14 ;
    she:hasBmlfuwMinimumSOCThreshold "1.2" ;
    she:hasSOCClayRatio1_8Threshold "<1.9" ;
    she:hasSOCClayRatio1_10Threshold "<1.5" ;
    she:hasSOCClayRatio1_13Threshold "<1.2" .

she:ClayRange4_7 a skos:Concept ;
    skos:prefLabel "4-7" ;
    skos:broader she:ClayFineSilt ;
    she:hasKorschensSandyThreshold "<0.6" .

she:ClayRange8_14 a skos:Concept ;
    skos:prefLabel "8-14" ;
    skos:broader she:ClayFineSilt ;
    she:hasKorschensSandyThreshold "0.6-0.9" ;
    she:hasKorschensLoamyThreshold "0.8-0.9" .

she:MediumSoil a skos:Concept ;
    skos:prefLabel "medium (15-25% clay)" ;
    skos:broader she:SoilGroup ;
    skos:narrower she:ClayRange15_22,
                  she:ClayRange23_25 ;
    she:hasBmlfuwMinimumSOCThreshold "1.5" ;
    she:hasSOCClayRatio1_8Threshold "1.9-3.1" ;
    she:hasSOCClayRatio1_10Threshold "1.5-2.5" ;
    she:hasSOCClayRatio1_13Threshold "1.2-1.9" .

she:ClayRange15_22 a skos:Concept ;
    skos:prefLabel "15-22" ;
    skos:broader she:ClayFineSilt ;
    she:hasKorschensSandyThreshold "0.9-1.2" ;
    she:hasKorschensLoamyThreshold "1.0-1.3" .

she:ClayRange23_25 a skos:Concept ;
    skos:prefLabel "23-25" ;
    skos:broader she:ClayFineSilt ;
    she:hasKorschensSandyThreshold "1.3-1.6" ;
    she:hasKorschensLoamyThreshold "1.3-1.5" .

she:HeavySoil a skos:Concept ;
    skos:prefLabel "heavy (>25% clay)" ;
    skos:broader she:SoilGroup ;
    skos:narrower she:ClayRange25_32,
                  she:ClayRangeGreaterThan32 ;
    she:hasBmlfuwMinimumSOCThreshold "1.7" ;
    she:hasSOCClayRatio1_8Threshold ">3.1" ;
    she:hasSOCClayRatio1_10Threshold ">2.5" ;
    she:hasSOCClayRatio1_13Threshold ">1.9" .

she:ClayRange25_32 a skos:Concept ;
    skos:prefLabel "25-32" ;
    skos:broader she:ClayFineSilt ;
    she:hasKorschensLoamyThreshold "1.5-1.7" .

she:ClayRangeGreaterThan32 a skos:Concept ;
    skos:prefLabel ">32" ;
    skos:broader she:ClayFineSilt ;
    she:hasKorschensLoamyThreshold "1.7-2.0" .
