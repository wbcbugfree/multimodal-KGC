@prefix she: <https://soilwise-he.github.io/soil-health#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

she:SocThresholdsForCropland a skos:Concept ;
    skos:prefLabel "soc thresholds for cropland" ;
    skos:definition "SOC thresholds for cropland (% soil mass) derived from a farmer questionnaire" ;
    skos:note "SOC values have been recalculated from original SOM values by applying the conversion factor of 1.724." ;
    skos:narrower she:Climate,
        she:Representativity,
        she:Texture,
        she:Threshold1,
        she:Threshold2 .

she:Climate a skos:Concept ;
    skos:prefLabel "climate" ;
    skos:note "Climate regions according to Metzger et al. (2005)" ;
    skos:narrower she:Atlantic,
        she:Boreal,
        she:Continental,
        she:Mediterranean .

she:Representativity a skos:Concept ;
    skos:prefLabel "representativity" .

she:Texture a skos:Concept ;
    skos:prefLabel "texture" ;
    skos:narrower she:Coarse,
        she:CoarserSoils,
        she:FinerSoils,
        she:Medium,
        she:MediumFine .

she:Threshold1 a skos:Concept ;
    skos:prefLabel "threshold 1" .

she:Threshold2 a skos:Concept ;
    skos:prefLabel "threshold 2" .

she:Atlantic a skos:Concept ;
    skos:prefLabel "atlantic" ;
    she:hasRepresentativity "n=358 (Belgium, Germany)" ;
    she:hasThresholdData [
        she:hasTexture she:Coarse ;
        she:hasThreshold1 "1.2" ;
        she:hasThreshold2 "2.0"
    ] , [
        she:hasTexture she:Medium ;
        she:hasThreshold1 "1.0" ;
        she:hasThreshold2 "1.5"
    ] , [
        she:hasTexture she:MediumFine ;
        she:hasThreshold1 "1.6" ;
        skos:note "particular high uncertainty due to low number of observations"
    ] .

she:Continental a skos:Concept ;
    skos:prefLabel "continental" ;
    she:hasRepresentativity "n=167 (Austria, Germany)" ;
    she:hasThresholdData [
        she:hasTexture she:Coarse ;
        she:hasThreshold1 "1.0" ;
        she:hasThreshold2 "1.2"
    ] , [
        she:hasTexture she:Medium ;
        she:hasThreshold1 "1.3" ;
        she:hasThreshold2 "1.9" ;
        skos:note "particular high uncertainty due to low number of observations"
    ] , [
        she:hasTexture she:MediumFine ;
        she:hasThreshold1 "1.2" ;
        she:hasThreshold2 "1.4" ;
        skos:note "particular high uncertainty due to low number of observations"
    ] .

she:Mediterranean a skos:Concept ;
    skos:prefLabel "mediterranean" ;
    she:hasRepresentativity "n=110 (Italy, Spain)" ;
    she:hasThresholdData [
        she:hasTexture she:Medium ;
        she:hasThreshold1 "0.6" ;
        she:hasThreshold2 "1.2"
    ] , [
        she:hasTexture she:MediumFine ;
        she:hasThreshold1 "0.8" ;
        she:hasThreshold2 "0.8" ;
        skos:note "particular high uncertainty due to low number of observations"
    ] .

she:Boreal a skos:Concept ;
    skos:prefLabel "boreal" ;
    skos:note "No farm has been included for the Boreal region: for this region, thresholds have been derived from literature (Soinne et al., 2016)" ;
    she:hasThresholdData [
        she:hasTexture she:FinerSoils ;
        she:hasSocThreshold "4%" ;
        she:hasSomThreshold "8%" ;
        skos:note "clay > 30%"
    ] , [
        she:hasTexture she:CoarserSoils ;
        she:hasSocThreshold "2%" ;
        she:hasSomThreshold "4%" ;
        skos:note "based on expert judgement"
    ] .

she:Coarse a skos:Concept ;
    skos:prefLabel "coarse" .

she:Medium a skos:Concept ;
    skos:prefLabel "medium" .

she:MediumFine a skos:Concept ;
    skos:prefLabel "medium fine" .

she:FinerSoils a skos:Concept ;
    skos:prefLabel "finer soils" .

she:CoarserSoils a skos:Concept ;
    skos:prefLabel "coarser soils" .

she:SoilOrganicCarbon a skos:Concept ;
    skos:prefLabel "soil organic carbon" ;
    she:hasAbbreviation "SOC" .

she:SoilOrganicMatter a skos:Concept ;
    skos:prefLabel "soil organic matter" ;
    she:hasAbbreviation "SOM" .
