@prefix she: <https://soilwise-he.github.io/soil-health#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

she:DegradationType a skos:Concept ;
    skos:prefLabel "degradation type" ;
    skos:narrower she:SoilPhysicalDegradation,
                  she:SoilChemicalDegradation,
                  she:SoilBiologicalDegradation .

she:ImpactOfThreats a skos:Concept ;
    skos:prefLabel "impact of threats" ;
    skos:note "The soil threats listed are a combination of those mentioned in the EU soil thematic strategy and the Recare project according to Stolte et al. (2016)." ;
    skos:narrower she:SubsoilCompaction,
                  she:SoilErosion,
                  she:Landslides,
                  she:Sealing,
                  she:AccumulationOfContaminantsAndNutrientsInSoil,
                  she:Salinisation,
                  she:Acidification,
                  she:ReducedHumusFormationAndReducedMetabolismOfContaminants,
                  she:DeclineInSoilOrganicMatterAndOrCarbon .

she:AffectedSoilServices a skos:Concept ;
    skos:prefLabel "affected soil services" ;
    skos:note "According to Adhikari and Hartemink (2016)." ;
    skos:narrower she:GrowthOfCrops,
                  she:WoodAndFibreProduction,
                  she:WaterStorage,
                  she:SubstanceFiltering,
                  she:StorageOfGeologicalMaterial,
                  she:CarbonStorage,
                  she:HabitatForPlantsInsectsMicrobesEtc,
                  she:SupportForBuildingsOrTransportNetwork .

she:SoilPhysicalDegradation a skos:Concept ;
    skos:prefLabel "soil physical degradation" ;
    she:hasThreat she:SubsoilCompaction,
                  she:SoilErosion,
                  she:Landslides,
                  she:Sealing ;
    she:affectsService she:GrowthOfCrops,
                       she:WoodAndFibreProduction,
                       she:WaterStorage,
                       she:SubstanceFiltering,
                       she:StorageOfGeologicalMaterial,
                       she:CarbonStorage,
                       she:HabitatForPlantsInsectsMicrobesEtc,
                       she:SupportForBuildingsOrTransportNetwork .

she:SoilChemicalDegradation a skos:Concept ;
    skos:prefLabel "soil chemical degradation" ;
    she:hasThreat she:AccumulationOfContaminantsAndNutrientsInSoil,
                  she:Salinisation,
                  she:Acidification ;
    she:affectsService she:GrowthOfCrops,
                       she:WoodAndFibreProduction,
                       she:WaterStorage,
                       she:SubstanceFiltering,
                       she:CarbonStorage,
                       she:HabitatForPlantsInsectsMicrobesEtc .

she:SoilBiologicalDegradation a skos:Concept ;
    skos:prefLabel "soil biological degradation" ;
    she:hasThreat she:AccumulationOfContaminantsAndNutrientsInSoil,
                  she:ReducedHumusFormationAndReducedMetabolismOfContaminants,
                  she:DeclineInSoilOrganicMatterAndOrCarbon ;
    she:affectsService she:HabitatForPlantsInsectsMicrobesEtc,
                       she:WaterStorage,
                       she:SubstanceFiltering,
                       she:CarbonStorage .

she:SubsoilCompaction a skos:Concept ;
    skos:prefLabel "subsoil compaction" .

she:SoilErosion a skos:Concept ;
    skos:prefLabel "soil erosion" .

she:Landslides a skos:Concept ;
    skos:prefLabel "landslides" .

she:Sealing a skos:Concept ;
    skos:prefLabel "sealing" .

she:AccumulationOfContaminantsAndNutrientsInSoil a skos:Concept ;
    skos:prefLabel "accumulation of contaminants and nutrients in soil" .

she:Salinisation a skos:Concept ;
    skos:prefLabel "salinisation" .

she:Acidification a skos:Concept ;
    skos:prefLabel "acidification" .

she:ReducedHumusFormationAndReducedMetabolismOfContaminants a skos:Concept ;
    skos:prefLabel "reduced humus formation and reduced metabolism of contaminants" .

she:DeclineInSoilOrganicMatterAndOrCarbon a skos:Concept ;
    skos:prefLabel "decline in soil organic matter and/or carbon" .

she:GrowthOfCrops a skos:Concept ;
    skos:prefLabel "growth of crops" .

she:WoodAndFibreProduction a skos:Concept ;
    skos:prefLabel "wood and fibre production" .

she:WaterStorage a skos:Concept ;
    skos:prefLabel "water storage" .

she:SubstanceFiltering a skos:Concept ;
    skos:prefLabel "substance filtering" .

she:StorageOfGeologicalMaterial a skos:Concept ;
    skos:prefLabel "storage of geological material" .

she:CarbonStorage a skos:Concept ;
    skos:prefLabel "carbon storage" .

she:HabitatForPlantsInsectsMicrobesEtc a skos:Concept ;
    skos:prefLabel "habitat for plants, insects, microbes, etc." .

she:SupportForBuildingsOrTransportNetwork a skos:Concept ;
    skos:prefLabel "support for buildings or transport network" .
