@prefix she: <https://soilwise-he.github.io/soil-health#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

she:SOCClayRatioIndex a skos:Concept ;
    skos:prefLabel "soc/clay ratio as an index of good soil structure" ;
    skos:narrower she:SOCClayRatio, she:SoilStructure .

she:SOCClayRatio a skos:Concept ;
    skos:prefLabel "soc/clay ratio" ;
    skos:narrower she:FieldLevelOptimum, 
                  she:MinimumDesiredSOCLevelGoal, 
                  she:UnacceptableStructuralSoilQuality .

she:FieldLevelOptimum a skos:Concept ;
    skos:prefLabel "field-level optimum for good structural quality" ;
    skos:note "soc enriched relative to the clay content" ;
    she:hasRatioValue ">0.125 (1/8)" ;
    she:indicates she:AcceptableOrGoodSoilStructure .

she:MinimumDesiredSOCLevelGoal a skos:Concept ;
    skos:prefLabel "goal for farmers as minimum desired soc level" ;
    she:hasRatioValue "0.1 (1/10) (1/8-1/13)" ;
    she:indicates she:AcceptableOrGoodSoilStructure .

she:UnacceptableStructuralSoilQuality a skos:Concept ;
    skos:prefLabel "structural soil quality is likely to be unacceptable" ;
    skos:note "soc depleted relative to the clay content" ;
    she:hasRatioValue "<0.07 (1/13)" ;
    she:indicates she:DegradedSoilStructure .

she:SoilStructure a skos:Concept ;
    skos:prefLabel "soil structure" ;
    skos:note "vess, visual evaluation of soil structure; the score ranges from 1 (good structure) to 5 (poor structure)." ;
    skos:narrower she:AcceptableOrGoodSoilStructure, she:DegradedSoilStructure .

she:AcceptableOrGoodSoilStructure a skos:Concept ;
    skos:prefLabel "acceptable or good soil structure" ;
    she:hasRatioThreshold ">1/10" ;
    she:hasVESSScore "<3" .

she:DegradedSoilStructure a skos:Concept ;
    skos:prefLabel "degraded soil structure" ;
    she:hasRatioThreshold "< 1/10" ;
    she:hasVESSScore ">3" .

she:VESS a skos:Concept ;
    skos:prefLabel "visual evaluation of soil structure" ;
    she:hasAbbreviation "VESS" .
