@prefix she: <https://soilwise-he.github.io/soil-health#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

she:OlsenPRelationshipWithRelativeYield a skos:Concept ;
    skos:prefLabel "the relationship between soil olsen-p contents and relative yield of wheat in long-term experiments in china" ;
    skos:note "source: chen, x. et al., unpublished data." ;
    skos:narrower she:OlsenP,
        she:RelativeYield ;
    skos:related she:Wheat .

she:Wheat a skos:Concept ;
    skos:prefLabel "wheat" .

she:OlsenP a skos:Concept ;
    skos:prefLabel "olsen-p" ;
    she:hasUnit "mg/kg" ;
    she:hasSymbol "P" ;
    skos:related she:Phosphorus .

she:RelativeYield a skos:Concept ;
    skos:prefLabel "relative yield (percentage)" ;
    she:hasUnit "percentage" .

she:Phosphorus a skos:Concept ;
    skos:prefLabel "phosphorus" ;
    she:hasSymbol "P" .

she:Nitrogen a skos:Concept ;
    skos:prefLabel "nitrogen" ;
    she:hasSymbol "N" .

she:Potassium a skos:Concept ;
    skos:prefLabel "potassium" ;
    she:hasSymbol "K" .

she:Sulphur a skos:Concept ;
    skos:prefLabel "sulphur" ;
    she:hasSymbol "S" .

she:AnimalManure a skos:Concept ;
    skos:prefLabel "animal manure" ;
    she:hasAbbreviation "M" .

she:Treatments a skos:Concept ;
    skos:prefLabel "treatments" ;
    skos:narrower she:CK,
        she:NK,
        she:NPK,
        she:NPKM,
        she:NPKM1_5,
        she:NPKS .

she:CK a skos:Concept ;
    skos:prefLabel "ck" ;
    skos:definition "control plot without nutrient additions" ;
    she:hasAbbreviation "CK" .

she:NK a skos:Concept ;
    skos:prefLabel "nk" ;
    she:hasAbbreviation "NK" ;
    she:hasComponent she:Nitrogen,
        she:Potassium .

she:NPK a skos:Concept ;
    skos:prefLabel "npk" ;
    she:hasAbbreviation "NPK" ;
    she:hasComponent she:Nitrogen,
        she:Phosphorus,
        she:Potassium .

she:NPKM a skos:Concept ;
    skos:prefLabel "npkm" ;
    she:hasAbbreviation "NPKM" ;
    she:hasComponent she:Nitrogen,
        she:Phosphorus,
        she:Potassium,
        she:AnimalManure .

she:NPKM1_5 a skos:Concept ;
    skos:prefLabel "1.5npkm" ;
    skos:definition "50% higher addition of n, p, k and manure than in the standard treatment" ;
    she:hasAbbreviation "1.5NPKM" ;
    she:hasComponent she:Nitrogen,
        she:Phosphorus,
        she:Potassium,
        she:AnimalManure .

she:NPKS a skos:Concept ;
    skos:prefLabel "npks" ;
    she:hasAbbreviation "NPKS" ;
    she:hasComponent she:Nitrogen,
        she:Phosphorus,
        she:Potassium,
        she:Sulphur .

she:Regression a skos:Concept ;
    skos:prefLabel "regression" ;
    skos:related she:OlsenP,
        she:RelativeYield .

she:CriticalPLevelAt90PercentRelativeYield a skos:Concept ;
    skos:prefLabel "critical p level at 90% relative yield" ;
    skos:note "indicated by a red dashed line intersecting the regression at 90% relative yield and approximately 18 mg/kg olsen-p." ;
    she:hasThresholdValue "90" ;
    she:hasUnit "percentage" ;
    she:relatesTo she:Phosphorus .
