        [ she:hasRegion she:Poland ; she:hasValue "25" ] ,
        [ she:hasRegion she:Spain ; she:hasValue "100" ] .

she:BenzoAAnthracene a skos:Concept ;
    skos:prefLabel "benzo(a)anthracene" ;
    she:hasIndustrialScreeningValue [ she:hasRegion she:BelgiumFlanders ; she:hasValue "30" ] ,
        [ she:hasRegion she:BelgiumBrussels ; she:hasValue "30" ] ,
        [ she:hasRegion she:BelgiumWallonia ; she:hasValue "10" ] ,
