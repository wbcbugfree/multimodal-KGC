@prefix she: <https://soilwise-he.github.io/soil-health#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

she:IndustrialSoilUse a skos:Concept ;
    skos:prefLabel "industrial soil use" .

she:OrganicContaminant a skos:Concept ;
    skos:prefLabel "organic contaminant" ;
    skos:narrower she:OneOneOneTrichloroethane,
        she:Anthracene,
        she:AtrazineP,
        she:Benzene,
        she:BenzoAAnthracene,
        she:BenzoAPyrene,
        she:BenzoGHIPerylene,
        she:CresolsSum,
        she:Dichloromethane,
        she:Ethylbenzene,
        she:Hexachlorobenzene,
        she:MethylTButylEther,
        she:Naphthalene,
        she:PAHsTotal,
        she:PCB,
        she:Phenol,
        she:Tetrachloromethane,
        she:Toluene,
        she:Trichloroethylene,
        she:Xylene .

she:CountryRegion a skos:Concept ;
    skos:prefLabel "country/region" ;
    skos:narrower she:BelgiumBrussels,
        she:BelgiumFlanders,
        she:BelgiumWallonia,
        she:Finland,
        she:Italy,
        she:Poland,
        she:Spain .

she:BelgiumBrussels a skos:Concept ;
    skos:prefLabel "belgium (brussels)" ;
    she:hasAbbreviation "B" .

she:BelgiumFlanders a skos:Concept ;
    skos:prefLabel "belgium (flanders)" ;
    she:hasAbbreviation "F" .

she:BelgiumWallonia a skos:Concept ;
    skos:prefLabel "belgium (wallonia)" ;
    she:hasAbbreviation "W" .

she:Finland a skos:Concept ;
    skos:prefLabel "finland" ;
    skos:note "Upper guideline values are presented." .

she:Italy a skos:Concept ;
    skos:prefLabel "italy" .

she:Poland a skos:Concept ;
    skos:prefLabel "poland" .

she:Spain a skos:Concept ;
    skos:prefLabel "spain" .

she:Benzene a skos:Concept ;
    skos:prefLabel "benzene" ;
    she:hasIndustrialScreeningValue [ she:hasRegion she:BelgiumFlanders ; she:hasValue "1" ] ,
        [ she:hasRegion she:BelgiumBrussels ; she:hasValue "1" ] ,
        [ she:hasRegion she:BelgiumWallonia ; she:hasValue "0.6" ] ,
        [ she:hasRegion she:Finland ; she:hasValue "1" ] ,
        [ she:hasRegion she:Italy ; she:hasValue "2" ] ,
        [ she:hasRegion she:Poland ; she:hasValue "76.5" ] ,
        [ she:hasRegion she:Spain ; she:hasValue "10" ] .

she:Ethylbenzene a skos:Concept ;
    skos:prefLabel "ethylbenzene" ;
    she:hasIndustrialScreeningValue [ she:hasRegion she:BelgiumFlanders ; she:hasValue "70" ] ,
        [ she:hasRegion she:BelgiumBrussels ; she:hasValue "70" ] ,
        [ she:hasRegion she:BelgiumWallonia ; she:hasValue "76" ] ,
        [ she:hasRegion she:Finland ; she:hasValue "50" ] ,
        [ she:hasRegion she:Italy ; she:hasValue "50" ] ,
        [ she:hasRegion she:Poland ; she:hasValue "130" ] ,
        [ she:hasRegion she:Spain ; she:hasValue "100" ] .

she:Toluene a skos:Concept ;
    skos:prefLabel "toluene" ;
    she:hasIndustrialScreeningValue [ she:hasRegion she:BelgiumFlanders ; she:hasValue "200" ] ,
        [ she:hasRegion she:BelgiumBrussels ; she:hasValue "200" ] ,
        [ she:hasRegion she:BelgiumWallonia ; she:hasValue "85" ] ,
        [ she:hasRegion she:Finland ; she:hasValue "25" ] ,
        [ she:hasRegion she:Italy ; she:hasValue "50" ] ,
        [ she:hasRegion she:Poland ; she:hasValue "117.5" ] ,
        [ she:hasRegion she:Spain ; she:hasValue "100" ] .

she:Xylene a skos:Concept ;
    skos:prefLabel "xylene" ;
    she:hasIndustrialScreeningValue [ she:hasRegion she:BelgiumFlanders ; she:hasValue "190" ] ,
        [ she:hasRegion she:BelgiumBrussels ; she:hasValue "190" ] ,
        [ she:hasRegion she:BelgiumWallonia ; she:hasValue "20" ] ,
        [ she:hasRegion she:Finland ; she:hasValue "50" ] ,
        [ she:hasRegion she:Italy ; she:hasValue "50" ] ,
        [ she:hasRegion she:Poland ; she:hasValue "77.5" ] ,
        [ she:hasRegion she:Spain ; she:hasValue "100" ] .

she:Naphthalene a skos:Concept ;
    skos:prefLabel "naphthalene" ;
    she:hasIndustrialScreeningValue [ she:hasRegion she:BelgiumFlanders ; she:hasValue "160" ] ,
        [ she:hasRegion she:BelgiumBrussels ; she:hasValue "160" ] ,
