        [ she:hasRegion she:BelgiumBrussels ; she:hasValue "4,690" ] ,
        [ she:hasRegion she:BelgiumWallonia ; she:hasValue "100" ] ,
        [ she:hasRegion she:Italy ; she:hasValue "10" ] ,
        [ she:hasRegion she:Poland ; she:hasValue "52.5" ] .

she:PAHsTotal a skos:Concept ;
