@prefix she: <https://soilwise-he.github.io/soil-health#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

she:OverviewOfSOCThresholds a skos:Concept ;
    skos:narrower she:BenchmarkValues,
        she:FarmersPerspectiveOnDeficientSOC,
        she:OptimalSOCContentForSoilFunctioning,
        she:ReciprocalSOCSequestrationPotential,
        she:ReferenceValuesSiteSpecific,
        she:SoilVulnerabilityIndexBasedOnSOCClayRatio,
        she:ThresholdsFromLongTermFieldExperiments ;
    skos:prefLabel "overview of soc thresholds" .

she:BenchmarkSites a skos:Concept ;
    skos:definition "reflect environmental and management conditions that are representative of a large area (van lynden et al., 2004). each site represents a very specific set of local conditions that are distinct from other environments. benchmark sites are particularly important to validate simulation models of indicators." ;
    skos:prefLabel "benchmark sites" .

she:BenchmarkValues a skos:Concept ;
    skos:definition "requires extensive monitoring evaluations and large data sets to sufficiently define site-specific value ranges" ;
    skos:narrower she:ModelledSOCSteadyStateForGrassland,
        she:NearNaturalForestSoils,
        she:PercentilesAsUpperAndLowerBenchmarks,
        she:TwentyFifthPercentileOfSOCValuesForPermanentGrassland ;
    skos:prefLabel "benchmark values" ;
    she:isDerivedFrom she:BenchmarkSites .

she:FarmersPerspectiveOnDeficientSOC a skos:Concept ;
    skos:definition "degraded soc levels according to farmers' perceptions (values for europe)" ;
    skos:prefLabel "farmers' perspective on deficient soc" .

she:ModelledSOCSteadyStateForGrassland a skos:Concept ;
    skos:definition "80% of steady state as target soc value" ;
    skos:prefLabel "modelled soc steady state (25 years) for grassland (sparling et al., 2003)" .

she:NearNaturalForestSoils a skos:Concept ;
    skos:definition "problematic, because humus dynamics in cropland soils (low c input, high c turnover) are different from forest soils, leading to a lower level c equilibrium at cropland sites" ;
    skos:prefLabel "near-natural forest soils (arshad and martin, 2002)" .

she:OptimalSOCContentForSoilFunctioning a skos:Concept ;
    skos:definition "reference values for central european cropland soil and climatic conditions are available. needs to be validated for clay-rich soils and climate regions outside central europe. values are site specific and ensure sufficient yield while not limiting natural soil functions. if the inert stable soc fraction is known, körschens et al. (1998) suggest that optimal soc is c_inert + 0.62%(c_inert); a separate pedotransfer function is suggested to identify the inert fraction based on the clay content (körschens and schulz (1999); validity range by körschens (1999): 400-800mm precipitation and 6-10°c average annual temperature). note that c_inert as defined by körschens et al. (1998), residual c at fallow trials, differs from c_inert commonly used in soil modelling (e.g. black carbon; skjemstad et al., 2004)" ;
    skos:prefLabel "optimal soc content for soil functioning (based on the role of soc in soil functional pedotransfer function, combined with data from long-term field experiments) (wessolek et al., 2008)" .

she:PercentilesAsUpperAndLowerBenchmarks a skos:Concept ;
    skos:definition "example: drexler et al. (2022)" ;
    skos:prefLabel "12.5th - 87.5th percentiles as upper and lower benchmarks" .

she:ReciprocalSOCSequestrationPotential a skos:Concept ;
    skos:definition "optimum soc content for the co₂ mitigation function of soils; target values represent soc equilibrium under long-term sustainable soil management" ;
    skos:prefLabel "reciprocal soc sequestration potential" .

she:ReferenceValuesSiteSpecific a skos:Concept ;
    skos:definition "can be derived from existing monitoring systems for different land uses (e.g. as baseline); 50% of the standard deviation of the mean are 'low', indicating deficiency" ;
    skos:prefLabel "reference values, site-specific, typical soc or som values under current management (arshad and martin, 2002)" .

she:SoilVulnerabilityIndexBasedOnSOCClayRatio a skos:Concept ;
    skos:definition "optimum soc content, defined as 10% of the observed clay content (piloted in switzerland, england and wales)" ;
    skos:prefLabel "soil vulnerability index based on the soc/clay ratio" .

she:ThresholdsFromLongTermFieldExperiments a skos:Concept ;
    skos:definition "minimum soc levels for sustainable crop production (values for central europe); values are conceptually comparable to optimal values (see section 2.3.2)" ;
    skos:prefLabel "thresholds from long-term field experiments" .

she:TwentyFifthPercentileOfSOCValuesForPermanentGrassland a skos:Concept ;
    skos:definition "pragmatic, but selection of quartile thresholds requires validation" ;
    skos:prefLabel "25th percentile of soc values for permanent grassland (sparling et al., 2003)" .

