@prefix she: <https://soilwise-he.github.io/soil-health#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

she:SOCThresholdsOverview a skos:Concept ;
    skos:prefLabel "overview of soc thresholds" ;
    skos:narrower she:ReferenceValuesSiteSpecific,
                  she:BenchmarkValues,
                  she:NearNaturalForestSoils,
                  she:Percentile25SOCPermanentGrassland,
                  she:ModelledSOCSteadyStateGrassland,
                  she:Percentiles12_5And87_5Benchmarks,
                  she:OptimalSOCContentForSoilFunctioning,
                  she:SoilVulnerabilityIndexSOCClayRatio,
                  she:ReciprocalSOCSequestrationPotential,
                  she:ThresholdsFromLongTermFieldExperiments,
                  she:FarmersPerspectiveOnDeficientSOC .

she:SoilOrganicCarbon a skos:Concept ;
    skos:prefLabel "soil organic carbon" ;
    she:hasAbbreviation "SOC" .

she:SoilOrganicMatter a skos:Concept ;
    skos:prefLabel "soil organic matter" ;
    she:hasAbbreviation "SOM" .

she:ReferenceValuesSiteSpecific a skos:Concept ;
    skos:prefLabel "reference values, site-specific" ;
    she:inSection "2.3.2" ;
    skos:definition "Typical SOC or SOM values under current management." ;
    she:hasComment "Can be derived from existing monitoring systems; 50% of the standard deviation of the mean are 'low', indicating deficiency." ;
    skos:related she:SoilOrganicCarbon, she:SoilOrganicMatter .

she:BenchmarkValues a skos:Concept ;
    skos:prefLabel "benchmark values" ;
    she:inSection "2.3.2" ;
    she:hasComment "Requires extensive monitoring evaluations and large data sets to sufficiently define site-specific value ranges." ;
    skos:note "Benchmark sites reflect environmental and management conditions that are representative of a large area. They are important to validate simulation models of indicators." .

she:NearNaturalForestSoils a skos:Concept ;
    skos:prefLabel "near-natural forest soils" ;
    she:inSection "2.3.2" ;
    she:hasComment "Problematic, because humus dynamics in cropland soils (low C input, high C turnover) are different from forest soils, leading to a lower level C equilibrium at cropland sites." .

she:Percentile25SOCPermanentGrassland a skos:Concept ;
    skos:prefLabel "25th percentile of soc values for permanent grassland" ;
    she:inSection "2.3.2" ;
    she:hasComment "Pragmatic, but selection of quartile thresholds requires validation." ;
    skos:related she:SoilOrganicCarbon .

she:ModelledSOCSteadyStateGrassland a skos:Concept ;
    skos:prefLabel "modelled soc steady state (25 years) for grassland" ;
    she:inSection "2.3.2" ;
    she:hasComment "80% of steady state as target SOC value." ;
    skos:related she:SoilOrganicCarbon .

she:Percentiles12_5And87_5Benchmarks a skos:Concept ;
    skos:prefLabel "12.5th - 87.5th percentiles as upper and lower benchmarks" ;
    she:inSection "2.3.2" ;
    she:hasComment "Example: Drexler et al. (2022)." .

she:OptimalSOCContentForSoilFunctioning a skos:Concept ;
    skos:prefLabel "optimal soc content for soil functioning" ;
    she:inSection "2.3.2" ;
    skos:definition "Based on the role of SOC in soil functional pedotransfer function, combined with data from long-term field experiments." ;
    she:hasComment "Reference values for central European cropland soil and climatic conditions are available. Values are site specific and ensure sufficient yield while not limiting natural soil functions." ;
    skos:note "Formula suggested by Körschens et al. (1998): optimal SOC = Cinert + 0.62%(Cinert). Valid range: 400-800mm precipitation and 6-10°C average annual temperature." ;
    skos:related she:SoilOrganicCarbon .

she:SoilVulnerabilityIndexSOCClayRatio a skos:Concept ;
    skos:prefLabel "soil vulnerability index based on the soc/clay ratio" ;
    she:inSection "2.3.3" ;
    she:hasComment "Optimum SOC content, defined as 10% of the observed clay content (piloted in Switzerland, England and Wales)." ;
    skos:related she:SoilOrganicCarbon, she:ClayContent .

she:ReciprocalSOCSequestrationPotential a skos:Concept ;
    skos:prefLabel "reciprocal soc sequestration potential" ;
    she:inSection "2.3.4" ;
    she:hasComment "Optimum SOC content for the CO2 mitigation function of soils; target values represent SOC equilibrium under long-term sustainable soil management." ;
    skos:related she:SoilOrganicCarbon, she:CO2Mitigation .

she:ThresholdsFromLongTermFieldExperiments a skos:Concept ;
    skos:prefLabel "thresholds from long-term field experiments" ;
    she:inSection "2.3.5" ;
    she:hasComment "Minimum SOC levels for sustainable crop production (values for central Europe); values are conceptually comparable to optimal values." ;
    skos:related she:SoilOrganicCarbon .

she:FarmersPerspectiveOnDeficientSOC a skos:Concept ;
    skos:prefLabel "farmers' perspective on deficient soc" ;
    she:inSection "2.3.6" ;
    she:hasComment "Degraded SOC levels according to farmers' perceptions (values for Europe)." ;
    skos:related she:SoilOrganicCarbon .

she:ClayContent a skos:Concept ;
    skos:prefLabel "clay content" .

she:CO2Mitigation a skos:Concept ;
    skos:prefLabel "co2 mitigation" ;
    she:hasSymbol "CO2" .
