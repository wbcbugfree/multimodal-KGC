@prefix she: <https://soilwise-he.github.io/soil-health#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

she:SoilBiodiversityPotentialScoring a skos:Concept ;
    skos:prefLabel "thresholds for environmental variables that may have a strong effect on soil biodiversity" ;
    skos:note "Classes of parameters for scoring soil biodiversity potential" ;
    skos:narrower she:Ph,
                  she:SoilTexturalClass,
                  she:OrganicMatter,
                  she:PotentialEvapotranspiration,
                  she:AnnualAverageTemperature,
                  she:SoilBiomassProductivity,
                  she:LandUseLandCover ;
    skos:definition "Compiled from Aksoy et al. (2017)." .

she:Ph a skos:Concept ;
    skos:prefLabel "ph" ;
    she:hasScoringParameterClass "<4", "4-5.2", "5.2-8.2", ">8.2" .

she:SoilTexturalClass a skos:Concept ;
    skos:prefLabel "soil textural class" ;
    she:hasScoringParameterClass "coarse", "medium", "medium-fine", "fine" .

she:OrganicMatter a skos:Concept ;
    skos:prefLabel "organic matter (%)" ;
    she:hasScoringParameterClass "<1", "1-2", "2-4", ">4" .

she:PotentialEvapotranspiration a skos:Concept ;
    skos:prefLabel "potential evapotranspiration (mm)" ;
    she:hasScoringParameterClass "<-500", "-500 to 500", ">500" .

she:AnnualAverageTemperature a skos:Concept ;
    skos:prefLabel "annual average temperature (°c)" ;
    she:hasScoringParameterClass "<5", "5-20", ">20" .

she:SoilBiomassProductivity a skos:Concept ;
    skos:prefLabel "soil biomass productivity" ;
    she:hasScoringParameterClass "poor", "average", "good" .

she:LandUseLandCover a skos:Concept ;
    skos:prefLabel "land use/land cover" ;
    she:hasScoringParameterClass "artificial", "arable", "permanent crops", "others" .
