@prefix she: <https://soilwise-he.github.io/soil-health#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

she:MeanSOCThresholdsMatrix a skos:Concept ;
    skos:prefLabel "matrix of mean soc minimum and maximum thresholds for cropland soils (% soil mass)" ;
    skos:note "Source: Compiled from Wessolek et al. (2008)." ;
    she:appliesTo she:CroplandSoils ;
    she:hasUnit she:PercentSoilMass ;
    skos:narrower she:SoilTextureClass, 
                  she:ClimaticWaterBalanceSummer, 
                  she:SOC .

she:CroplandSoils a skos:Concept ;
    skos:prefLabel "cropland soils" .

she:PercentSoilMass a skos:Concept ;
    skos:prefLabel "% soil mass" .

she:SOC a skos:Concept ;
    skos:prefLabel "soc" ;
    she:hasAbbreviation "SOC" ;
    skos:altLabel "soil organic carbon" .

she:SoilTextureClass a skos:Concept ;
    skos:prefLabel "soil texture class" ;
    skos:narrower she:Sand, 
                  she:Silt, 
                  she:LoamAndClay .

she:ClimaticWaterBalanceSummer a skos:Concept ;
    skos:prefLabel "climatic water balance (mm) summer" ;
    skos:narrower she:LessThanMinus100, 
                  she:Minus100To0, 
                  she:MoreThan0 .

she:Min a skos:Concept ;
    skos:prefLabel "min." .

she:Max a skos:Concept ;
    skos:prefLabel "max." .

she:Sand a skos:Concept ;
    skos:prefLabel "sand" ;
    skos:broader she:SoilTextureClass ;
    she:hasSOCThreshold [
        she:climaticWaterBalance she:LessThanMinus100 ;
        she:minThreshold "0.5" ;
        she:maxThreshold "1.23"
    ] ;
    she:hasSOCThreshold [
        she:climaticWaterBalance she:Minus100To0 ;
        she:minThreshold "0.9" ;
        she:maxThreshold "1.73"
    ] ;
    she:hasSOCThreshold [
        she:climaticWaterBalance she:MoreThan0 ;
        she:minThreshold "1.2" ;
        she:maxThreshold "2.23"
    ] .

she:Silt a skos:Concept ;
    skos:prefLabel "silt" ;
    skos:broader she:SoilTextureClass ;
    she:hasSOCThreshold [
        she:climaticWaterBalance she:LessThanMinus100 ;
        she:minThreshold "1.5" ;
        she:maxThreshold "2.53"
    ] ;
    she:hasSOCThreshold [
        she:climaticWaterBalance she:Minus100To0 ;
        she:minThreshold "1.0" ;
        she:maxThreshold "2.07"
    ] ;
    she:hasSOCThreshold [
        she:climaticWaterBalance she:MoreThan0 ;
        she:minThreshold "0.8" ;
        she:maxThreshold "1.59"
    ] .

she:LoamAndClay a skos:Concept ;
    skos:prefLabel "loam and clay" ;
    skos:broader she:SoilTextureClass ;
    she:hasSOCThreshold [
        she:climaticWaterBalance she:LessThanMinus100 ;
        she:minThreshold "0.6" ;
        she:maxThreshold "1.47"
    ] ;
    she:hasSOCThreshold [
        she:climaticWaterBalance she:Minus100To0 ;
        she:minThreshold "0.9" ;
        she:maxThreshold "1.92"
    ] ;
    she:hasSOCThreshold [
        she:climaticWaterBalance she:MoreThan0 ;
        she:minThreshold "1.9" ;
        she:maxThreshold "3.23"
    ] .

she:LessThanMinus100 a skos:Concept ;
    skos:prefLabel "less than -100" ;
    skos:broader she:ClimaticWaterBalanceSummer .

she:Minus100To0 a skos:Concept ;
    skos:prefLabel "-100 to 0" ;
    skos:broader she:ClimaticWaterBalanceSummer .

she:MoreThan0 a skos:Concept ;
    skos:prefLabel "more than 0" ;
    skos:broader she:ClimaticWaterBalanceSummer .
