@prefix she: <https://soilwise-he.github.io/soil-health#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

she:AgriEnvironmentalPolicy a skos:Concept ;
    skos:prefLabel "agri-environmental policy" ;
    skos:narrower she:CommonAgriculturalPolicy,
                  she:EUAgriEnvironmentalIndicators,
                  she:EUResourceEfficiencyScoreboard,
                  she:EUSustainableDevelopmentGoalsIndicatorSet .

she:CommonAgriculturalPolicy a skos:Concept ;
    skos:prefLabel "eu: common agricultural policy" ;
    she:hasAbbreviation "CAP 2014-2020" ;
    she:hasIndicator she:CAPContextIndicator42 .

she:EUResourceEfficiencyScoreboard a skos:Concept ;
    skos:prefLabel "eu: resource efficiency scoreboard" ;
    she:hasIndicator she:EstimatedSoilErosionByWaterSevere .

she:EUSustainableDevelopmentGoalsIndicatorSet a skos:Concept ;
    skos:prefLabel "eu: sustainable development goals indicator set" ;
    she:hasIndicator she:EstimatedSoilErosionByWaterSevere .

she:EUAgriEnvironmentalIndicators a skos:Concept ;
    skos:prefLabel "eu: agri-environmental indicators" ;
    she:hasAbbreviation "AEIs" ;
    she:hasIndicator she:AEI21 .

she:Indicator a skos:Concept ;
    skos:prefLabel "indicator" ;
    skos:narrower she:AEI21,
                  she:CAPContextIndicator42,
                  she:EstimatedSoilErosionByWaterSevere .

she:CAPContextIndicator42 a skos:Concept ;
    skos:prefLabel "cap context indicator 42: soil erosion" ;
    skos:narrower she:EstimatedAgriculturalAreaAffectedBySoilErosion,
                  she:EstimatedRateOfSoilLossByWaterErosion .

she:EstimatedRateOfSoilLossByWaterErosion a skos:Concept ;
    skos:prefLabel "estimated rate of soil loss by water erosion" ;
    she:hasUnit "t/ha/year" .

she:EstimatedAgriculturalAreaAffectedBySoilErosion a skos:Concept ;
    skos:prefLabel "estimated agricultural area affected by a certain rate of soil erosion by water" ;
    she:hasUnit "ha" .

she:EstimatedSoilErosionByWaterSevere a skos:Concept ;
    skos:prefLabel "estimated soil erosion by water: area affected by severe erosion rate" ;
    skos:note ">10t/ha/year" .

she:AEI21 a skos:Concept ;
    skos:prefLabel "aei 21: soil erosion" ;
    skos:note "mean estimated rate of soil loss by water erosion (t/ha/year) at various administrative levels (Member State, NUTS1, NUTS2, NUTS3)" ;
    she:hasUnit "t/ha/year" .

she:NUTS a skos:Concept ;
    skos:definition "nomenclature of territorial units for statistics" ;
    skos:prefLabel "nuts" .
