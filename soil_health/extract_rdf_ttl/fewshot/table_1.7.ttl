@prefix she: <https://soilwise-he.github.io/soil-health#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

she:BiodiversityStrategyTo2030 a skos:Concept ;
    skos:prefLabel "biodiversity strategy to 2030 (ec, 2020e)" ;
    she:hasTarget she:AgriculturalAreaUnderHighDiversityLandscapeFeatures,
        she:AgriculturalLandOrganicallyFarmedBy2030,
        she:LegallyProtectMinimum30PercentEULandArea,
        she:ReduceRiskAndUseOfChemicalPesticidesBy50Percent .

she:EighthEnvironmentActionProgramme a skos:Concept ;
    skos:prefLabel "eighth environment action programme 2030 (ec, 2020b)" ;
    she:hasObjective she:ProtectPreserveRestoreBiodiversityAndEnhanceNaturalCapital,
        she:UmbrellaProgrammeAgainstBiodiversityLossAndEcosystemServicesDegradation .

she:FarmToForkStrategy a skos:Concept ;
    skos:prefLabel "farm to fork strategy (ec, 2020f)" ;
    she:hasTarget she:AgriculturalLandOrganicallyFarmedBy2030,
        she:ReduceOverallUseAndRiskOfChemicalPesticidesBy50PercentAndMoreHazardousPesticidesBy50PercentBy2030,
        she:ReduceUseOfFertilisersBy2030ByAtLeast20Percent .

she:LULUCFRegulation a skos:Concept ;
    skos:prefLabel "lulucf regulation ((eu) 2018/841)" ;
    she:hasObjective she:BindingCommitmentsToCompensateCO2EmissionsFromLandUseSector,
        she:EnsureLULUCFSectorContributionToEmissionReductionTarget .

she:NationalEmissionCeilingsDirective a skos:Concept ;
    skos:prefLabel "national emission ceilings directive ((eu) 2016/2284) (a)" ;
    she:hasObjective she:AchieveNationalEmissionReductionTargetsForAnthropogenicEmissions,
        she:AssessImpactsOfAirPollutantsToSensitiveReceivingEnvironments,
        she:ReduceAirPollutionAndItsImpactsOnEcosystemsAndBiodiversity,
        she:ReduceEcosystemAreaSubjectToEutrophicationBy35PercentBy2030 .

she:RegulationOnCAPFinancingManagementMonitoring a skos:Concept ;
    skos:prefLabel "regulation (eu) no 1306/2013 on the financing, management and monitoring of the cap 2021-2027" ;
    she:hasObjective she:GAECsAsConditionalStandardsForSoilQuality,
        she:PromotePracticesBeneficialToClimateAndEnvironment .

she:RoadmapForAResourceEfficientEurope a skos:Concept ;
    skos:prefLabel "roadmap for a resource efficient europe (ec, 2011)" ;
    she:hasTarget she:AchieveNoNetLandTakeBy2050,
        she:IncreaseSoilOrganicMatterBetween2011And2050,
        she:RemedialWorkOnContaminatedSitesWellUnderWayBy2020,
        she:SoilErosionReducedBy2050 .

she:WaterFrameworkDirective a skos:Concept ;
    skos:prefLabel "water framework directive (2000/60/ec)" ;
    she:hasObjective she:EstablishProgrammesOfMeasuresToReduceNitrogenInputs,
        she:ProduceRiverBasinManagementPlans .

she:AchieveNationalEmissionReductionTargetsForAnthropogenicEmissions a skos:Concept ;
    skos:prefLabel "to achieve national emission reduction targets for anthropogenic emissions" .

she:AchieveNoNetLandTakeBy2050 a skos:Concept ;
    skos:prefLabel "achieve no net land take by 2050" .

she:AgriculturalAreaUnderHighDiversityLandscapeFeatures a skos:Concept ;
    skos:prefLabel "at least 10% of the agricultural area is under high-diversity landscape features" .

she:AssessImpactsOfAirPollutantsToSensitiveReceivingEnvironments a skos:Concept ;
    skos:prefLabel "member states to assess the impacts of air pollutants to sensitive receiving environments (natural and semi-natural habitats and forest ecosystems)" .

she:BindingCommitmentsToCompensateCO2EmissionsFromLandUseSector a skos:Concept ;
    skos:prefLabel "member states have binding commitments to compensate co2 emissions from the land use sector; land management practices that increase soil organic carbon stocks are accountable compensation measures" .

she:EnsureLULUCFSectorContributionToEmissionReductionTarget a skos:Concept ;
    skos:prefLabel "to ensure the contribution of the lulucf sector to the achievement of the eu's emission reduction target of at least 40% and to the long-term goal of the paris agreement in the period 2021-2030" .

she:EstablishProgrammesOfMeasuresToReduceNitrogenInputs a skos:Concept ;
    skos:prefLabel "member states to establish programmes of measures and implement 'basic' measures, including adapted agricultural production schemes to reduce nitrogen inputs to agricultural soils and as a consequence connected water bodies" .

she:GAECsAsConditionalStandardsForSoilQuality a skos:Concept ;
    skos:prefLabel "gaecs as conditional standards remain valid in the future cap, including gaecs in support of soil quality: gaec 6 'tillage management'; gaec 7 'no bare soil'; gaec 8: 'crop rotation'" .

she:IncreaseSoilOrganicMatterBetween2011And2050 a skos:Concept ;
    skos:prefLabel "increase in soil organic matter between 2011 and 2050" .

she:LegallyProtectMinimum30PercentEULandArea a skos:Concept ;
    skos:prefLabel "legally protect a minimum of 30% of the eu's land area" .

she:ProduceRiverBasinManagementPlans a skos:Concept ;
    skos:prefLabel "member states to produce river basin management plans, requiring the identification of point sources and their impacts" .

she:PromotePracticesBeneficialToClimateAndEnvironment a skos:Concept ;
    skos:prefLabel "cap post-2020 continues to promote practices beneficial to the climate and the environment; introduces eco-schemes for additional measures. impact indicators indicate the increase in soil carbon, reduction in soil erosion and nutrient (n) loss; a result indicator covers practices targeted to improve soils" .

she:ProtectPreserveRestoreBiodiversityAndEnhanceNaturalCapital a skos:Concept ;
    skos:prefLabel "protecting, preserving and restoring biodiversity and enhancing natural capital, notably air, water, soil, and forest, freshwater, wetland and marine ecosystems" .

she:ReduceAirPollutionAndItsImpactsOnEcosystemsAndBiodiversity a skos:Concept ;
    skos:prefLabel "air pollution and its impacts on ecosystems and biodiversity are further reduced with the long-term aim of not exceeding critical loads and levels (based on seventh environment action programme)" .

she:ReduceEcosystemAreaSubjectToEutrophicationBy35PercentBy2030 a skos:Concept ;
    skos:prefLabel "to reduce the ecosystem area subject to eutrophication by 35% by 2030, compared with 2005 (clean air programme for europe (ec, 2013))" .

she:ReduceOverallUseAndRiskOfChemicalPesticidesBy50PercentAndMoreHazardousPesticidesBy50PercentBy2030 a skos:Concept ;
    skos:prefLabel "to reduce the overall use and risk of chemical pesticides by 50% and the use of more hazardous pesticides by 50% by 2030" .

she:ReduceRiskAndUseOfChemicalPesticidesBy50Percent a skos:Concept ;
    skos:prefLabel "the risk and use of chemical pesticides is reduced by 50%" .

she:ReduceUseOfFertilisersBy2030ByAtLeast20Percent a skos:Concept ;
    skos:prefLabel "to reduce the use of fertilisers by 2030 by at least 20%" .

she:RemedialWorkOnContaminatedSitesWellUnderWayBy2020 a skos:Concept ;
    skos:prefLabel "by 2020 remedial work on contaminated sites well under way" .

she:SoilErosionReducedBy2050 a skos:Concept ;
    skos:prefLabel "soil erosion is reduced by 2050" .

she:UmbrellaProgrammeAgainstBiodiversityLossAndEcosystemServicesDegradation a skos:Concept ;
    skos:prefLabel "umbrella programme (b) against biodiversity loss and ecosystem services degradation, climate change and its impacts, and unsustainable use of resources, pollution, and associated risks to human health" .

she:AgriculturalLandOrganicallyFarmedBy2030 a skos:Concept ;
    skos:prefLabel "at least 25% of the eu's agricultural land must be organically farmed by 2030" .

