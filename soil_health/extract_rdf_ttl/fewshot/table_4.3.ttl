@prefix she: <https://soilwise-he.github.io/soil-health#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

she:SummarisedCriticalPHValues a skos:Concept ;
    skos:narrower she:Crop,
        she:PHAt95PercentYield ;
    skos:prefLabel "summarised critical ph values for wheat, maize and rice derived from short-term manipulation experiments (ste) and long-term observations (lte)" .

she:CombinedSTEAndLTE a skos:Concept ;
    skos:prefLabel "ste+lte" .

she:Crop a skos:Concept ;
    skos:narrower she:Maize,
        she:Rice,
        she:Wheat ;
    skos:prefLabel "crop" .

she:LongTermObservations a skos:Concept ;
    skos:prefLabel "lte" .

she:Maize a skos:Concept ;
    skos:prefLabel "maize" ;
    she:hasPHValueForLTE "5.1" ;
    she:hasPHValueForSTE "4.6" ;
    she:hasPHValueForSTEAndLTE "4.8" .

she:PHAt95PercentYield a skos:Concept ;
    skos:narrower she:CombinedSTEAndLTE,
        she:LongTermObservations,
        she:ShortTermManipulationExperiments ;
    skos:prefLabel "ph at 95% yield" .

she:Rice a skos:Concept ;
    skos:prefLabel "rice" ;
    she:hasPHValueForLTE "5.0" ;
    she:hasPHValueForSTE "4.7" ;
    she:hasPHValueForSTEAndLTE "4.7" .

she:ShortTermManipulationExperiments a skos:Concept ;
    skos:prefLabel "ste" .

she:Wheat a skos:Concept ;
    skos:prefLabel "wheat" ;
    she:hasPHValueForLTE "5.9" ;
    she:hasPHValueForSTE "4.5" ;
    she:hasPHValueForSTEAndLTE "5.3" .

