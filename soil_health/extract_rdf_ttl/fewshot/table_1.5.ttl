@prefix she: <https://soilwise-he.github.io/soil-health#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

she:ProposedMaesSoilIndicators a skos:Concept ;
    skos:prefLabel "proposed maes soil indicators" ;
    skos:narrower she:SoilPressures,
        she:SoilState,
        she:SoilBiodiversity .

she:SoilEcosystem a skos:Concept ;
    skos:prefLabel "soil ecosystem" ;
    skos:narrower she:Urban,
        she:Cropland,
        she:Grassland,
        she:WoodlandAndForest,
        she:HeathlandAndShrub,
        she:Wetland,
        she:SparselyVegetatedLand .

she:Urban a skos:Concept ;
    skos:prefLabel "urban" ;
    a skos:Concept .

she:Cropland a skos:Concept ;
    skos:prefLabel "cropland" ;
    a skos:Concept .

she:Grassland a skos:Concept ;
    skos:prefLabel "grassland" ;
    a skos:Concept .

she:WoodlandAndForest a skos:Concept ;
    skos:prefLabel "woodland and forest" ;
    a skos:Concept .

she:HeathlandAndShrub a skos:Concept ;
    skos:prefLabel "heathland and shrub" ;
    a skos:Concept .

she:Wetland a skos:Concept ;
    skos:prefLabel "wetland" ;
    a skos:Concept .

she:SparselyVegetatedLand a skos:Concept ;
    skos:prefLabel "sparsely vegetated land" ;
    a skos:Concept .

she:SoilPressures a skos:Concept ;
    skos:prefLabel "soil pressures" ;
    skos:narrower she:IntensiveManagement,
        she:LossOfOrganicMatter,
        she:GrossNutrientBalance,
        she:Landslides,
        she:Acidification,
        she:ClimateChange,
        she:Salinity,
        she:Compaction,
        she:Imperviousness,
        she:SoilErosion,
        she:SoilSealing,
        she:SoilContamination,
        she:LandUseChange .

she:IntensiveManagement a skos:Concept ;
    skos:prefLabel "intensive management" ;
    skos:note "e.h. tillage" ;
    she:appliesTo she:Cropland, she:Grassland, she:WoodlandAndForest, she:HeathlandAndShrub .

she:LossOfOrganicMatter a skos:Concept ;
    skos:prefLabel "loss of organic matter" ;
    she:hasUnit "% per year" ;
    she:appliesTo she:Cropland .

she:GrossNutrientBalance a skos:Concept ;
    skos:prefLabel "gross nutrient balance" ;
    she:appliesTo she:Cropland .

she:Landslides a skos:Concept ;
    skos:prefLabel "landslides" ;
    skos:note "number" ;
    she:appliesTo she:WoodlandAndForest, she:HeathlandAndShrub .

she:Acidification a skos:Concept ;
    skos:prefLabel "acidification" ;
    she:hasUnit "kmol H+ ha-1" ;
    she:appliesTo she:WoodlandAndForest, she:HeathlandAndShrub .

she:ClimateChange a skos:Concept ;
    skos:prefLabel "climate change" ;
    she:appliesTo she:Wetland .

she:Salinity a skos:Concept ;
    skos:prefLabel "salinity" ;
    she:appliesTo she:Cropland, she:Grassland, she:WoodlandAndForest, she:HeathlandAndShrub, she:Wetland .

she:Compaction a skos:Concept ;
    skos:prefLabel "compaction" ;
    she:hasUnit "kg/m3" ;
    she:appliesTo she:Urban, she:Cropland, she:Grassland .

she:Imperviousness a skos:Concept ;
    skos:prefLabel "imperviousness" ;
    she:hasUnit "%" ;
    she:appliesTo she:Urban .

she:SoilErosion a skos:Concept ;
    skos:prefLabel "soil erosion" ;
    she:hasUnit "kg/ha/year" ;
    she:appliesTo she:Cropland, she:Grassland, she:WoodlandAndForest, she:HeathlandAndShrub, she:SparselyVegetatedLand .

she:SoilSealing a skos:Concept ;
    skos:prefLabel "soil sealing" ;
    she:hasUnit "% area" ;
    she:appliesTo she:Urban, she:Cropland, she:Grassland, she:WoodlandAndForest, she:HeathlandAndShrub, she:Wetland, she:SparselyVegetatedLand .

she:SoilContamination a skos:Concept ;
    skos:prefLabel "soil contamination" ;
    skos:note "from point or diffuse sources, nutrient deposition" ;
    she:appliesTo she:Urban, she:Cropland, she:Grassland, she:WoodlandAndForest, she:HeathlandAndShrub, she:Wetland, she:SparselyVegetatedLand .

she:LandUseChange a skos:Concept ;
    skos:prefLabel "land use change" ;
    skos:note "i.e. land use intensification" ;
    she:appliesTo she:Urban, she:Cropland, she:Grassland, she:WoodlandAndForest, she:HeathlandAndShrub, she:Wetland, she:SparselyVegetatedLand .

she:SoilState a skos:Concept ;
    skos:prefLabel "soil state" ;
    skos:narrower she:VegetationCoverage,
        she:SoilErosionSusceptibility,
        she:SoilProductivity,
        she:AvailableWaterCapacity,
        she:SoilNutrientAvailability,
        she:SoilMoisture,
        she:BulkDensity,
        she:SoilCarbonStock .

she:VegetationCoverage a skos:Concept ;
    skos:prefLabel "vegetation coverage" ;
    she:appliesTo she:Urban, she:Cropland, she:Grassland, she:WoodlandAndForest, she:HeathlandAndShrub, she:Wetland .

she:SoilErosionSusceptibility a skos:Concept ;
    skos:prefLabel "soil erosion susceptibility" ;
    she:appliesTo she:Cropland, she:Grassland .

she:SoilProductivity a skos:Concept ;
    skos:prefLabel "soil productivity" ;
    she:appliesTo she:Cropland, she:Grassland .

she:AvailableWaterCapacity a skos:Concept ;
    skos:prefLabel "available water capacity" ;
    she:appliesTo she:Cropland, she:Grassland, she:WoodlandAndForest, she:HeathlandAndShrub, she:SparselyVegetatedLand .

she:SoilNutrientAvailability a skos:Concept ;
    skos:prefLabel "soil nutrient availability" ;
    she:appliesTo she:Cropland, she:Grassland, she:WoodlandAndForest, she:HeathlandAndShrub, she:SparselyVegetatedLand .

she:SoilMoisture a skos:Concept ;
    skos:prefLabel "soil moisture" ;
    she:appliesTo she:Wetland .

she:BulkDensity a skos:Concept ;
    skos:prefLabel "bulk density" ;
    she:appliesTo she:Wetland .

she:SoilCarbonStock a skos:Concept ;
    skos:prefLabel "soil carbon stock" ;
    she:hasUnit "%" ;
    she:appliesTo she:Urban, she:Cropland, she:Grassland, she:WoodlandAndForest, she:HeathlandAndShrub, she:Wetland, she:SparselyVegetatedLand .

she:SoilBiodiversity a skos:Concept ;
    skos:prefLabel "soil biodiversity" ;
    skos:narrower she:EarthwormsDiversityAbundance,
        she:MicrobialBiodiversity,
        she:SoilPhAndCarbon,
        she:SoilBiodiversityPotential .

she:EarthwormsDiversityAbundance a skos:Concept ;
    skos:prefLabel "earthworms diversity/abundance" ;
    she:appliesTo she:Urban, she:Cropland, she:Grassland, she:WoodlandAndForest, she:HeathlandAndShrub .

she:MicrobialBiodiversity a skos:Concept ;
    skos:prefLabel "microbial biodiversity" ;
    skos:note "fungi and bacteria" ;
    she:appliesTo she:Urban, she:Cropland, she:Grassland, she:WoodlandAndForest, she:HeathlandAndShrub, she:Wetland, she:SparselyVegetatedLand .

she:SoilPhAndCarbon a skos:Concept ;
    skos:prefLabel "soil ph and carbon" ;
    she:appliesTo she:Urban, she:Cropland, she:Grassland, she:WoodlandAndForest, she:HeathlandAndShrub, she:Wetland, she:SparselyVegetatedLand .

she:SoilBiodiversityPotential a skos:Concept ;
    skos:prefLabel "soil biodiversity potential" ;
    she:appliesTo she:Urban, she:Cropland, she:Grassland, she:WoodlandAndForest, she:HeathlandAndShrub, she:Wetland, she:SparselyVegetatedLand .
