@prefix she: <https://soilwise-he.github.io/soil-health#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

she:NRetentionLeachingRiskVersusCNRatioTable a skos:Concept ;
    skos:prefLabel "n retention and related n leaching risk versus c/n ratio in the organic layer of forest soils" ;
    skos:narrower she:Indication,
                  she:CNRatioInOrganicLayers ;
    she:appliesTo she:ForestSoils,
                  she:OrganicLayer .

she:Indication a skos:Concept ;
    skos:prefLabel "indication" ;
    skos:narrower she:HighNRetentionAndThusLowNLeachingPotential,
                  she:ModerateToHighNRetentionAndThusLowToModerateNLeachingPotential,
                  she:LowToModerateNRetentionAndThusModerateToHighNLeachingPotential,
                  she:LowNRetentionAndThusHighNLeachingPotential .

she:CNRatioInOrganicLayers a skos:Concept ;
    skos:prefLabel "c/n ratio in organic layers" ;
    she:hasAbbreviation "C/N ratio" ;
    skos:narrower she:CNRatioGreaterThan30,
                  she:CNRatio25To30,
                  she:CNRatio20To25,
                  she:CNRatioLessThan20 .

she:ForestSoils a skos:Concept ;
    skos:prefLabel "forest soils" .

she:OrganicLayer a skos:Concept ;
    skos:prefLabel "organic layer" .

she:Nitrogen a skos:Concept ;
    skos:prefLabel "nitrogen" ;
    she:hasSymbol "N" .

she:Carbon a skos:Concept ;
    skos:prefLabel "carbon" ;
    she:hasSymbol "C" .

she:CNRatioGreaterThan30 a skos:Concept ;
    skos:prefLabel ">30" ;
    she:indicates she:HighNRetentionAndThusLowNLeachingPotential .

she:CNRatio25To30 a skos:Concept ;
    skos:prefLabel "25-30" ;
    she:indicates she:ModerateToHighNRetentionAndThusLowToModerateNLeachingPotential .

she:CNRatio20To25 a skos:Concept ;
    skos:prefLabel "20-25" ;
    she:indicates she:LowToModerateNRetentionAndThusModerateToHighNLeachingPotential .

she:CNRatioLessThan20 a skos:Concept ;
    skos:prefLabel "<20" ;
    she:indicates she:LowNRetentionAndThusHighNLeachingPotential .

she:HighNRetentionAndThusLowNLeachingPotential a skos:Concept ;
    skos:prefLabel "high n retention and thus low n leaching potential" ;
    skos:related she:HighNRetention,
                 she:LowNLeachingPotential .

she:ModerateToHighNRetentionAndThusLowToModerateNLeachingPotential a skos:Concept ;
    skos:prefLabel "moderate to high n retention and thus low to moderate n leaching potential" ;
    skos:related she:ModerateToHighNRetention,
                 she:LowToModerateNLeachingPotential .

she:LowToModerateNRetentionAndThusModerateToHighNLeachingPotential a skos:Concept ;
    skos:prefLabel "low to moderate n retention and thus moderate to high n leaching potential" ;
    skos:related she:LowToModerateNRetention,
                 she:ModerateToHighNLeachingPotential .

she:LowNRetentionAndThusHighNLeachingPotential a skos:Concept ;
    skos:prefLabel "low n retention and thus high n leaching potential" ;
    skos:related she:LowNRetention,
                 she:HighNLeachingPotential .

she:HighNRetention a skos:Concept ;
    skos:prefLabel "high n retention" ;
    skos:related she:Nitrogen .

she:LowNRetention a skos:Concept ;
    skos:prefLabel "low n retention" ;
    skos:related she:Nitrogen .

she:LowToModerateNRetention a skos:Concept ;
    skos:prefLabel "low to moderate n retention" ;
    skos:related she:Nitrogen .

she:ModerateToHighNRetention a skos:Concept ;
    skos:prefLabel "moderate to high n retention" ;
    skos:related she:Nitrogen .

she:HighNLeachingPotential a skos:Concept ;
    skos:prefLabel "high n leaching potential" ;
    skos:related she:Nitrogen .

she:LowNLeachingPotential a skos:Concept ;
    skos:prefLabel "low n leaching potential" ;
    skos:related she:Nitrogen .

she:LowToModerateNLeachingPotential a skos:Concept ;
    skos:prefLabel "low to moderate n leaching potential" ;
    skos:related she:Nitrogen .

she:ModerateToHighNLeachingPotential a skos:Concept ;
    skos:prefLabel "moderate to high n leaching potential" ;
    skos:related she:Nitrogen .
