@prefix she: <https://soilwise-he.github.io/soil-health#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

she:PrincipleOfSoilPStatusAndEnvironmentalRisk a skos:Concept ;
    skos:prefLabel "principle of soil p status and environmental risk" ;
    skos:narrower she:Approach,
        she:PRecommendation,
        she:SoilPHeader .

she:Approach a skos:Concept ;
    skos:prefLabel "approach" ;
    skos:narrower she:BuildingUp,
        she:Maintenance,
        she:Mining .

she:PRecommendation a skos:Concept ;
    skos:prefLabel "p recommendation" ;
    skos:narrower she:InputEqualsOutput,
        she:InputGreaterThanOutput,
        she:InputLessThanOutput,
        she:InputMuchGreaterThanOutput,
        she:NoFertiliser .

she:SoilPHeader a skos:Concept ;
    skos:prefLabel "soil p" ;
    skos:narrower she:High,
        she:Low,
        she:Medium,
        she:VeryHigh,
        she:VeryLow .

she:Mining a skos:Concept ;
    skos:prefLabel "mining" ;
    she:recommends she:InputLessThanOutput,
        she:NoFertiliser .

she:Maintenance a skos:Concept ;
    skos:prefLabel "maintenance" ;
    she:recommends she:InputEqualsOutput .

she:BuildingUp a skos:Concept ;
    skos:prefLabel "building up" ;
    she:recommends she:InputGreaterThanOutput,
        she:InputMuchGreaterThanOutput .

she:NoFertiliser a skos:Concept ;
    skos:prefLabel "no fertiliser" ;
    she:associatedWithSoilP she:VeryHigh .

she:InputLessThanOutput a skos:Concept ;
    skos:prefLabel "input < output" ;
    she:associatedWithSoilP she:High .

she:InputEqualsOutput a skos:Concept ;
    skos:prefLabel "input = output" ;
    she:associatedWithSoilP she:Medium .

she:InputGreaterThanOutput a skos:Concept ;
    skos:prefLabel "input > output" ;
    she:associatedWithSoilP she:Low .

she:InputMuchGreaterThanOutput a skos:Concept ;
    skos:prefLabel "input >> output" ;
    she:associatedWithSoilP she:VeryLow .

she:VeryHigh a skos:Concept ;
    skos:prefLabel "very high" ;
    she:locatedIn she:EnvironmentalRiskZone ;
    she:leadsTo she:OptimumLevelForCropProduction .

she:High a skos:Concept ;
    skos:prefLabel "high" ;
    she:locatedIn she:EnvironmentalRiskZone ;
    she:leadsTo she:OptimumLevelForCropProduction .

she:Medium a skos:Concept ;
    skos:prefLabel "medium" ;
    she:locatedIn she:OptimumLevelForCropProduction .

she:Low a skos:Concept ;
    skos:prefLabel "low" ;
    she:locatedIn she:CropProductionRiskZone ;
    she:leadsTo she:OptimumLevelForCropProduction .

she:VeryLow a skos:Concept ;
    skos:prefLabel "very low" ;
    she:locatedIn she:CropProductionRiskZone ;
    she:leadsTo she:OptimumLevelForCropProduction .

she:EnvironmentalRiskZone a skos:Concept ;
    skos:prefLabel "environmental risk zone" ;
    she:associatedWith she:SoilP .

she:CropProductionRiskZone a skos:Concept ;
    skos:prefLabel "crop production risk zone" ;
    she:associatedWith she:SoilP .

she:OptimumLevelForCropProduction a skos:Concept ;
    skos:prefLabel "optimum level for crop production" ;
    she:attainedOver she:Time .

she:SoilP a skos:Concept ;
    skos:prefLabel "soil p" ;
    she:hasSymbol "P" ;
    she:measuredAgainst she:Time .

she:Time a skos:Concept ;
    skos:prefLabel "time" .
