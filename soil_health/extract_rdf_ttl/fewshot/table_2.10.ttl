@prefix she: <https://soilwise-he.github.io/soil-health#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

she:SomThresholdsDefinition a skos:Concept ;
    skos:prefLabel "definition of som thresholds derived from a farmer questionnaire" ;
    skos:narrower she:Threshold1,
                  she:Threshold2 ;
    she:derivedFrom she:FarmerQuestionnaire .

she:Threshold1 a skos:Concept ;
    skos:prefLabel "threshold 1" ;
    skos:definition "Lower end of SOM value range (10th percentile) at which farmers judge their current SOM content sufficient" ;
    skos:note "Below this threshold value, no farmers are expected to be satisfied with their SOM content" ;
    she:concernsCroplandArea "1.1% of the European cropland area" ;
    she:hasSpecificConcernRegion "northern France" .

she:Threshold2 a skos:Concept ;
    skos:prefLabel "threshold 2" ;
    skos:definition "Upper end of the range of values (90th percentile) at which farmers perceive a high or very high deficiency of SOM content" ;
    skos:note "Above this threshold, no farmers are expected to be dissatisfied with their SOM content" ;
    she:concernsCroplandArea "14.3% of the cropland area" ;
    she:hasSpecificConcernRegion "central/eastern Europe",
                                 "southern Europe" .

she:Som a skos:Concept ;
    skos:prefLabel "som" ;
    she:hasAbbreviation "SOM" ;
    she:hasThreshold she:Threshold1,
                     she:Threshold2 .

she:Soc a skos:Concept ;
    skos:prefLabel "soc" ;
    she:hasAbbreviation "SOC" ;
    skos:note "SOC data used for area estimates" .

she:FarmerQuestionnaire a skos:Concept ;
    skos:prefLabel "farmer questionnaire" .
