@prefix she: <https://soilwise-he.github.io/soil-health#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

she:EFSA a skos:Concept ;
    skos:definition "european food safety authority" ;
    skos:prefLabel "efsa" .

she:FAO a skos:Concept ;
    skos:definition "food and agriculture organization of the united nations" ;
    skos:prefLabel "fao" .

she:HC50 a skos:Concept ;
    skos:prefLabel "hc50" .

she:NOEC a skos:Concept ;
    skos:definition "no effect concentration" ;
    skos:prefLabel "noec" .

she:OverviewOfRelevantCompartmentsRelatedToSoilServicesToBeProtectedAndRelevantAssessmentCriteria a skos:Concept ;
    skos:narrower she:AssessmentCriteria,
        she:LevelOfRegulation,
        she:ProtectionTarget,
        she:RelevantCompartment ;
    skos:prefLabel "overview of relevant compartments related to soil services to be protected and relevant assessment criteria" .

she:PAF a skos:Concept ;
    skos:definition "potentially affected fraction of species and ecological processes." ;
    skos:prefLabel "paf" .

she:TDI a skos:Concept ;
    skos:prefLabel "tdi" .

she:AdjacentGroundwaterAndSurfaceWaterSystems a skos:Concept ;
    skos:prefLabel "adjacent groundwater and surface water systems" ;
    she:isProtectedFor she:EcosystemHealth,
        she:HumanHealth .

she:ArableCroppingSystems a skos:Concept ;
    skos:prefLabel "arable cropping systems" ;
    she:isProtectedFor she:AnimalHealth,
        she:EcosystemHealth,
        she:HumanHealth .

she:AssessmentCriteria a skos:Concept ;
    skos:narrower she:DrinkingWaterAndSurfaceWaterStandards,
        she:FoodQualityStandardsInPlantAndAnimalProductsBasedOnHumanTDIs,
        she:NoEffectConcentrationsBasedOnPAFDerivedForSoilOrSoilSolution,
        she:NoEffectConcentrationsBasedOnPAFInSoilTerrestrialEcosystemsOrWaterAquaticEcosystems,
        she:NoEffectConcentrationsBasedOnPAFInWater,
        she:TDIBasedOnToxicologicalLimitValues,
        she:TDIOrExcessLifetimeCancerRiskBasedOnIntakeOfPlantProductsUrbanAgricultureOrIntakeOfSoilDust ;
    skos:prefLabel "assessment criteria" .

she:LevelOfRegulation a skos:Concept ;
    skos:narrower she:NationalEU,
        she:NationalEUEFSA,
        she:NationalEUFAO_WHO,
        she:RecommendedLevels ;
    skos:prefLabel "level of regulation" .

she:NaturalAreas a skos:Concept ;
    skos:prefLabel "natural areas" ;
    she:isProtectedFor she:EcosystemHealth .

she:NoteA a skos:Concept ;
    skos:definition "note that the criterion used depends on the desired level of protection. for natural systems, no effect concentration (noec) levels are commonly based on the 5th percentile of noec concentrations of all organisms. for other soil functions this can be less strict, e.g. in the case of industrial land, an hc50 is applied as criterion for acceptance, equivalent to a level at which 50% of all species will be affected." ;
    skos:prefLabel "note a" .

she:ProtectionTarget a skos:Concept ;
    skos:narrower she:AnimalHealth,
        she:EcosystemHealth,
        she:HumanHealth,
        she:HumanHealthAndOrEcosystemHealth ;
    skos:prefLabel "protection target" .

she:RelevantCompartment a skos:Concept ;
    skos:narrower she:AdjacentGroundwaterAndSurfaceWaterSystems,
        she:ArableCroppingSystems,
        she:NaturalAreas,
        she:UrbanSoils ;
    skos:prefLabel "relevant compartment" .

she:UrbanSoils a skos:Concept ;
    skos:prefLabel "urban soils" ;
    she:isProtectedFor she:HumanHealthAndOrEcosystemHealth .

she:AnimalHealth a skos:Concept ;
    skos:prefLabel "animal health" ;
    she:isAssessedBy she:TDIBasedOnToxicologicalLimitValues .

she:DrinkingWaterAndSurfaceWaterStandards a skos:Concept ;
    skos:prefLabel "drinking water and surface water standards" ;
    she:isRegulatedAt she:NationalEU .

she:FoodQualityStandardsInPlantAndAnimalProductsBasedOnHumanTDIs a skos:Concept ;
    skos:prefLabel "food quality standards in plant and animal products based on human tdis" ;
    she:isRegulatedAt she:NationalEUFAO_WHO .

she:HumanHealthAndOrEcosystemHealth a skos:Concept ;
    skos:prefLabel "human health and/or ecosystem health" ;
    she:isAssessedBy she:TDIOrExcessLifetimeCancerRiskBasedOnIntakeOfPlantProductsUrbanAgricultureOrIntakeOfSoilDust .

she:NationalEUEFSA a skos:Concept ;
    skos:prefLabel "national, eu (efsa)" .

she:NationalEUFAO_WHO a skos:Concept ;
    skos:prefLabel "national, eu, fao, who" .

she:NoEffectConcentrationsBasedOnPAFDerivedForSoilOrSoilSolution a skos:Concept ;
    skos:prefLabel "no effect concentrations (a) based on paf (b) derived for soil or soil solution" ;
    she:hasReferenceToNote she:NoteA,
        she:NoteB ;
    she:isRegulatedAt she:EUFAO_WHO .

she:NoEffectConcentrationsBasedOnPAFInSoilTerrestrialEcosystemsOrWaterAquaticEcosystems a skos:Concept ;
    skos:prefLabel "no effect concentrations based on paf in soil (terrestrial ecosystems) or water (aquatic ecosystems)" ;
    she:hasReferenceToNote she:NoteB ;
    she:isRegulatedAt she:NationalEU .

she:NoEffectConcentrationsBasedOnPAFInWater a skos:Concept ;
    skos:prefLabel "no effect concentrations based on paf in water" ;
    she:hasReferenceToNote she:NoteB ;
    she:isRegulatedAt she:NationalEU .

she:RecommendedLevels a skos:Concept ;
    skos:prefLabel "recommended levels" .

she:TDIBasedOnToxicologicalLimitValues a skos:Concept ;
    skos:prefLabel "tdi based on toxicological limit values" ;
    she:isRegulatedAt she:RecommendedLevels .

she:TDIOrExcessLifetimeCancerRiskBasedOnIntakeOfPlantProductsUrbanAgricultureOrIntakeOfSoilDust a skos:Concept ;
    skos:prefLabel "tdi or excess lifetime cancer risk based on intake of plant products (urban agriculture) or intake of soil/dust. for ecosystem health, effect levels are applied" ;
    she:isRegulatedAt she:NationalEUEFSA .

she:HumanHealth a skos:Concept ;
    skos:prefLabel "human health" ;
    she:isAssessedBy she:DrinkingWaterAndSurfaceWaterStandards,
        she:FoodQualityStandardsInPlantAndAnimalProductsBasedOnHumanTDIs .

she:NoteB a skos:Concept ;
    skos:definition "potentially affected fraction of species and ecological processes." ;
    skos:prefLabel "note b" .

she:EcosystemHealth a skos:Concept ;
    skos:prefLabel "ecosystem health" ;
    she:isAssessedBy she:NoEffectConcentrationsBasedOnPAFDerivedForSoilOrSoilSolution,
        she:NoEffectConcentrationsBasedOnPAFInSoilTerrestrialEcosystemsOrWaterAquaticEcosystems,
        she:NoEffectConcentrationsBasedOnPAFInWater .

she:NationalEU a skos:Concept ;
    skos:prefLabel "national, eu" .

