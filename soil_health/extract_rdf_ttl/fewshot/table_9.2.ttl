@prefix she: <https://soilwise-he.github.io/soil-health#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

she:IndicatorsUsedToAssessSoilSealingAndLandTake a skos:Concept ;
    skos:narrower she:CcCoRatio,
        she:Imperviousness,
        she:LandRecycling,
        she:LandTake,
        she:RatioOfSoilSealingToLandTake,
        she:ShareOfUndevelopedBuildingLand,
        she:SparseUrbanisationPrevalenceIndex,
        she:SprawlDensificationRatio ;
    skos:prefLabel "indicators used to assess soil sealing and land take" .

she:CcCoRatio a skos:Concept ;
    skos:definition "ratio between c in built-up land and organic c in soils (cc/co), according to villa et al. (2018)" ;
    skos:prefLabel "cc/co ratio" ;
    she:hasInterpretation she:CcCoRatioInterpretationHighIntensitySealing,
        she:CcCoRatioInterpretationLowIntensitySealing,
        she:CcCoRatioInterpretationMediumIntensitySealing,
        she:CcCoRatioInterpretationUnsealedLand ;
    she:testedUsing she:MultiTemporalSOCStockMaps .

she:CcCoRatioInterpretationHighIntensitySealing a skos:Concept ;
    skos:prefLabel ">2.0 high-intensity sealing" .

she:CcCoRatioInterpretationLowIntensitySealing a skos:Concept ;
    skos:prefLabel "≤0.5 low-intensity sealing" .

she:CcCoRatioInterpretationMediumIntensitySealing a skos:Concept ;
    skos:prefLabel "0.5≤2.0 medium-intensity sealing" .

she:CcCoRatioInterpretationUnsealedLand a skos:Concept ;
    skos:prefLabel "0 = unsealed land" .

she:EEALandAndSoilIndicatorSetLSI001 a skos:Concept ;
    skos:prefLabel "eea land and soil indicator set (lsi001)" .

she:EEALandAndSoilIndicatorSetLSI002 a skos:Concept ;
    skos:prefLabel "eea land and soil indicator set (lsi002)" .

she:EighthEnvironmentActionProgrammeHeadlineIndicatorSetSDGTarget15_3 a skos:Concept ;
    skos:prefLabel "8th environment action programme headline indicator set, sdg target 15.3" .

she:Imperviousness a skos:Concept ;
    skos:definition "european data set used in combination with other assessments, i.e. fragmentation, land recycling" ;
    skos:narrower she:ImperviousnessPerArea,
        she:ImperviousnessPerCapita,
        she:ImperviousnessStratified ;
    skos:prefLabel "imperviousness" ;
    she:hasSource she:EEALandAndSoilIndicatorSetLSI002 .

she:ImperviousnessPerArea a skos:Concept ;
    skos:prefLabel "per area" .

she:ImperviousnessPerCapita a skos:Concept ;
    skos:prefLabel "per capita" .

she:ImperviousnessStratified a skos:Concept ;
    skos:definition "example stratification: urban centre, peri-urban, rural" ;
    skos:prefLabel "stratified" .

she:LandRecycling a skos:Concept ;
    skos:definition "includes recultivation" ;
    skos:prefLabel "land recycling" .

she:LandTake a skos:Concept ;
    skos:definition "used to report land take under the european and global environment programmes. stratified, e.g. by major land cover category, urban protected areas, functional urban areas, urban floodplains" ;
    skos:prefLabel "land take" ;
    she:hasSource she:EEALandAndSoilIndicatorSetLSI001,
        she:EighthEnvironmentActionProgrammeHeadlineIndicatorSetSDGTarget15_3 .

she:MultiTemporalSOCStockMaps a skos:Concept ;
    skos:prefLabel "multi-temporal soc stock maps" .

she:QualityAndQuantityOfSustainableLandUseAndUrbanRedevelopment a skos:Concept ;
    skos:prefLabel "quality and quantity of sustainable land use and urban redevelopment" .

she:RatioOfSoilSealingToLandTake a skos:Concept ;
    skos:definition "1 = total loss of all soil ecosystem services (except soil as a carrier for construction); 0 = no soil function is affected" ;
    skos:prefLabel "ratio of soil sealing to land take" ;
    she:hasSource she:QualityAndQuantityOfSustainableLandUseAndUrbanRedevelopment .

she:ShareOfUndevelopedBuildingLand a skos:Concept ;
    skos:definition ">50% of cities ('population ≥50,000') have only a little (<10%) building land left while smaller towns have a larger buffer" ;
    skos:prefLabel "share of undeveloped building land" .

she:SparseUrbanisationPrevalenceIndex a skos:Concept ;
    skos:definition "ratio of low-intensity sealed land to severely sealed land; degree of anthropogenic sealing" ;
    skos:prefLabel "sparse urbanisation prevalence index" .

she:SprawlDensificationRatio a skos:Concept ;
    skos:definition "ratio of new sparse urban areas to urban densification area (trend in soil sealing change)" ;
    skos:prefLabel "sprawl/densification ratio" ;
    she:hasInterpretation she:SprawlDensificationRatioInterpretationCompactUrbanForms,
        she:SprawlDensificationRatioInterpretationDiffuseUrbanForms .

she:SprawlDensificationRatioInterpretationCompactUrbanForms a skos:Concept ;
    skos:prefLabel "<1 tendency towards more compact urban forms" .

she:SprawlDensificationRatioInterpretationDiffuseUrbanForms a skos:Concept ;
    skos:prefLabel ">1 tendency to more diffuse urban forms" .

