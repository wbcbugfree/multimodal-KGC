@prefix she: <https://soilwise-he.github.io/soil-health#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

she:SoilThreatIndicators a skos:Concept ;
    skos:narrower she:SoilBiodiversityLoss,
        she:SoilCompaction,
        she:SoilErosion,
        she:SoilPollution,
        she:SoilSealing ;
    skos:note "the current knowledge base covers a limited set of land uses and soil properties, for which thresholds are available; in the future, all relevant land uses and sites need to be covered." ;
    skos:prefLabel "overview of soil threat indicators investigated in this report (cont.)" .

she:Agriculture a skos:Concept ;
    skos:prefLabel "agriculture" ;
    she:hasIndicator she:ExceedanceOfActualRateOfSoilLossByWaterErosion .

she:AirCapacity a skos:Concept ;
    skos:prefLabel "air capacity (ac) <5%" .

she:AllLandUses a skos:Concept ;
    skos:prefLabel "all land uses" ;
    she:hasIndicator she:ExceedanceOfScreeningValuesForCriticalRiskFromHeavyMetalsAndOrganicPollutants .

she:Country a skos:Concept ;
    skos:prefLabel "by country" .

she:CountrySpecificValuesVaryBroadlyAndAreNotNecessarilyComparable a skos:Concept ;
    skos:prefLabel "country-specific values vary broadly and are not necessarily comparable" .

she:CurrentIndicatorDescriptionIncludesOnlySoilErosionByWater a skos:Concept ;
    skos:prefLabel "the current indicator description in this report includes only soil erosion by water, whereas the threshold addresses all other or erosion types" .

she:DatabaseDeveloped a skos:Concept ;
    skos:prefLabel "database developed (cd, cu, pb, zn, as, hg, ni, cr)" .

she:ExceedanceOfActionValues a skos:Concept ;
    skos:prefLabel "exceedance of 'action values' (zink et al., 2011)" .

she:ExceedanceOfActualRateOfSoilLossByWaterErosion a skos:Concept ;
    skos:prefLabel "exceedance of actual rate of soil loss by water erosion" ;
    she:hasRemark she:CurrentIndicatorDescriptionIncludesOnlySoilErosionByWater,
        she:PreliminaryThresholdsDerivationOfSiteAdaptedTolerableSoilLossRatesRecommended,
        she:SoilFormationRate ;
    she:hasThresholdOrTarget she:FourTonsPerHectarePerYearForDeeperSoils,
        she:TwoTonsPerHectarePerYearForShallowSoils .

she:ExceedanceOfOperatingRangesForSpecificSoilAnimalsAndMicroorganisms a skos:Concept ;
    skos:prefLabel "exceedance of operating ranges (or) for specific soil animals and microorganisms" .

she:ExceedanceOfSafeMinimumStandardsOfEcosystemConservation a skos:Concept ;
    skos:prefLabel "exceedance of safe minimum standards of ecosystem conservation" .

she:ExceedanceOfScreeningValuesForCriticalRiskFromHeavyMetalsAndOrganicPollutants a skos:Concept ;
    skos:prefLabel "exceedance of screening values for critical risk from heavy metals and organic pollutants" ;
    she:hasRemark she:CountrySpecificValuesVaryBroadlyAndAreNotNecessarilyComparable,
        she:StratificationByLandUseAndSoilTexture ;
    she:hasThresholdOrTarget she:DatabaseDeveloped,
        she:OrganicPollutants,
        she:UpdatedValuesForCdCuPbAndZn .

she:FourTonsPerHectarePerYearForDeeperSoils a skos:Concept ;
    skos:note "loss rates lower than 2t/ha/year are mandatory on soils adjacent to water bodies and/or soils with elevated levels of pollutants; such lower limits are needed to maintain water quality." ;
    skos:prefLabel "4t/ha/year for deeper soils (≥70cm)" ;
    she:isAlsoKnownAs she:SoilLossTolerance .

she:HarmfulSubsoilCompactionSubIndicators a skos:Concept ;
    skos:prefLabel "harmful subsoil compaction (sub-indicators)" ;
    she:hasRemark she:ExceedanceOfActionValues,
        she:SecondarySubIndicatorsWithAvailableThresholds ;
    she:hasThresholdOrTarget she:PrioritySubIndicators .

she:LossOfSoilBiodiversitySubIndicators a skos:Concept ;
    skos:prefLabel "loss of soil biodiversity (sub-indicators)" ;
    she:hasRemark she:RequiresSubIndicatorsBySpeciesAndOrFunctionalGroup ;
    she:hasThresholdOrTarget she:ToBeDeveloped .

she:NationalTargetsToAchieveNoNetLandTake a skos:Concept ;
    skos:prefLabel "national targets to achieve 'no net land take'" .

she:OrganicPollutants a skos:Concept ;
    skos:prefLabel "organic pollutants" .

she:PreliminaryThresholdsDerivationOfSiteAdaptedTolerableSoilLossRatesRecommended a skos:Concept ;
    skos:prefLabel "preliminary thresholds, derivation of site-adapted tolerable soil loss rates recommended" .

she:PrioritySubIndicators a skos:Concept ;
    skos:narrower she:AirCapacity,
        she:SaturatedHydraulicConductivity ;
    skos:prefLabel "priority (sub)-indicators" .

she:RequiresSubIndicatorsBySpeciesAndOrFunctionalGroup a skos:Concept ;
    skos:prefLabel "requires sub-indicators by species and/or (functional) group" .

she:SaturatedHydraulicConductivity a skos:Concept ;
    skos:prefLabel "saturated hydraulic conductivity (ks) <10cm/day" .

she:SealedAreaPerTotalLandArea a skos:Concept ;
    skos:prefLabel "sealed area per total land area" ;
    she:hasThresholdOrTarget she:NationalTargetsToAchieveNoNetLandTake .

she:SecondarySubIndicatorsWithAvailableThresholds a skos:Concept ;
    skos:prefLabel "secondary sub-indicators with available thresholds: bulk density, internal soil strength, air permeability and oxygen diffusion" .

she:SoilBiodiversityLoss a skos:Concept ;
    skos:narrower she:LossOfSoilBiodiversitySubIndicators ;
    skos:prefLabel "soil biodiversity loss" .

she:SoilCompaction a skos:Concept ;
    skos:narrower she:HarmfulSubsoilCompactionSubIndicators ;
    skos:prefLabel "soil compaction" .

she:SoilErosion a skos:Concept ;
    skos:narrower she:Agriculture ;
    skos:prefLabel "soil erosion" .

she:SoilFormationRate a skos:Concept ;
    skos:prefLabel "soil formation rate: 0.3-1.4 t/ha/year (verheijen et al., 2009)" .

she:SoilLossTolerance a skos:Concept ;
    skos:prefLabel "soil loss tolerance" .

she:SoilPollution a skos:Concept ;
    skos:narrower she:AllLandUses ;
    skos:prefLabel "soil pollution" .

she:SoilSealing a skos:Concept ;
    skos:narrower she:SealedAreaPerTotalLandArea ;
    skos:prefLabel "soil sealing" .

she:StratificationByLandUseAndSoilTexture a skos:Concept ;
    skos:prefLabel "stratification by land use and soil texture" .

she:ToBeDeveloped a skos:Concept ;
    skos:narrower she:ExceedanceOfOperatingRangesForSpecificSoilAnimalsAndMicroorganisms,
        she:ExceedanceOfSafeMinimumStandardsOfEcosystemConservation ;
    skos:prefLabel "to be developed" .

she:TwoTonsPerHectarePerYearForShallowSoils a skos:Concept ;
    skos:prefLabel "2t/ha/year for shallow soils (<70cm depth)" .

she:UpdatedValuesForCdCuPbAndZn a skos:Concept ;
    skos:prefLabel "updated values for cd, cu, pb and zn (mg/kg) in this report" ;
    she:by she:Country .

