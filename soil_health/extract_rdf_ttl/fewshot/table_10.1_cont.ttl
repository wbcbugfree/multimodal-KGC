@prefix she: <https://soilwise-he.github.io/soil-health#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

she:SoilThreatIndicators a skos:Concept ;
    skos:prefLabel "soil threat indicators" ;
    skos:narrower she:SoilPollution,
        she:SoilErosion,
        she:SoilBiodiversityLoss,
        she:SoilCompaction,
        she:SoilSealing ;
    skos:note "The current knowledge base covers a limited set of land uses and soil properties, for which thresholds are available; in the future, all relevant land uses and sites need to be covered." .

she:SoilPollution a skos:Concept ;
    skos:prefLabel "soil pollution" ;
    skos:narrower she:ExceedanceOfScreeningValuesForCriticalRiskFromHeavyMetalsAndOrganicPollutants .

she:ExceedanceOfScreeningValuesForCriticalRiskFromHeavyMetalsAndOrganicPollutants a skos:Concept ;
    skos:prefLabel "exceedance of screening values for critical risk from heavy metals and organic pollutants" ;
    skos:note "Country-specific values vary broadly and are not necessarily comparable. Stratification by land use and soil texture." ;
    she:appliesToLandUse "all land uses" ;
    she:hasIndicatorFor she:Cd, she:Cu, she:Pb, she:Zn, she:As, she:Hg, she:Ni, she:Cr, she:OrganicPollutants .

she:Cd a skos:Concept ; skos:prefLabel "cd" .
she:Cu a skos:Concept ; skos:prefLabel "cu" .
she:Pb a skos:Concept ; skos:prefLabel "pb" .
she:Zn a skos:Concept ; skos:prefLabel "zn" .
she:As a skos:Concept ; skos:prefLabel "as" .
she:Hg a skos:Concept ; skos:prefLabel "hg" .
she:Ni a skos:Concept ; skos:prefLabel "ni" .
she:Cr a skos:Concept ; skos:prefLabel "cr" .
she:OrganicPollutants a skos:Concept ; skos:prefLabel "organic pollutants" .

she:SoilErosion a skos:Concept ;
    skos:prefLabel "soil erosion" ;
    skos:narrower she:ExceedanceOfActualRateOfSoilLossByWaterErosion .

she:ExceedanceOfActualRateOfSoilLossByWaterErosion a skos:Concept ;
    skos:prefLabel "exceedance of actual rate of soil loss by water erosion" ;
    skos:note "Soil formation rate: 0.3-1.4 t/ha/year (Verheijen et al., 2009). Preliminary thresholds, derivation of site-adapted tolerable soil loss rates recommended. The current indicator description in this report includes only soil erosion by water, whereas the threshold addresses all other erosion types." ;
    she:appliesToLandUse "agriculture" ;
    she:hasThreshold [
        a skos:Concept ;
        skos:prefLabel "soil loss tolerance for shallow soils" ;
        she:hasCondition "shallow soils (<70cm depth)" ;
        she:hasValue "2t/ha/year"
    ], [
        a skos:Concept ;
        skos:prefLabel "soil loss tolerance for deeper soils" ;
        skos:note "Loss rates lower than 2t/ha/year are mandatory on soils adjacent to water bodies and/or soils with elevated levels of pollutants; such lower limits are needed to maintain water quality." ;
        she:hasCondition "deeper soils (≥70cm)" ;
        she:hasValue "4t/ha/year"
    ] .

she:SoilBiodiversityLoss a skos:Concept ;
    skos:prefLabel "soil biodiversity loss" ;
    skos:narrower she:LossOfSoilBiodiversity .

she:LossOfSoilBiodiversity a skos:Concept ;
    skos:prefLabel "loss of soil biodiversity" ;
    skos:note "Requires sub-indicators by species and/ or (functional) group" ;
    she:hasSubIndicator she:ExceedanceOfSafeMinimumStandards,
        she:ExceedanceOfOperatingRanges .

she:ExceedanceOfSafeMinimumStandards a skos:Concept ;
    skos:prefLabel "exceedance of safe minimum standards of ecosystem conservation" .

she:ExceedanceOfOperatingRanges a skos:Concept ;
    skos:prefLabel "exceedance of operating ranges (or) for specific soil animals and microorganisms" .

she:SoilCompaction a skos:Concept ;
    skos:prefLabel "soil compaction" ;
    skos:narrower she:HarmfulSubsoilCompaction .

she:HarmfulSubsoilCompaction a skos:Concept ;
    skos:prefLabel "harmful subsoil compaction" ;
    skos:note "Exceedance of 'action values' (Zink et al., 2011)" ;
    she:hasPriorityIndicator she:SaturatedHydraulicConductivity,
        she:AirCapacity ;
    she:hasSecondaryIndicator she:BulkDensity,
        she:InternalSoilStrength,
        she:AirPermeability,
        she:OxygenDiffusion .

she:SaturatedHydraulicConductivity a skos:Concept ;
    skos:prefLabel "saturated hydraulic conductivity" ;
    she:hasAbbreviation "Ks" ;
    she:hasThresholdValue "<10cm/day" .

she:AirCapacity a skos:Concept ;
    skos:prefLabel "air capacity" ;
    she:hasAbbreviation "AC" ;
    she:hasThresholdValue "<5%" .

she:BulkDensity a skos:Concept ; skos:prefLabel "bulk density" .
she:InternalSoilStrength a skos:Concept ; skos:prefLabel "internal soil strength" .
she:AirPermeability a skos:Concept ; skos:prefLabel "air permeability" .
she:OxygenDiffusion a skos:Concept ; skos:prefLabel "oxygen diffusion" .

she:SoilSealing a skos:Concept ;
    skos:prefLabel "soil sealing" ;
    skos:narrower she:SealedAreaPerTotalLandArea .

she:SealedAreaPerTotalLandArea a skos:Concept ;
    skos:prefLabel "sealed area per total land area" ;
    skos:note "National targets to achieve 'no net land take'" .
