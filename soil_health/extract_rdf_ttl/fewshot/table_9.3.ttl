@prefix she: <https://soilwise-he.github.io/soil-health#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

she:SoilSealingDataComparison2015 a skos:Concept ;
    skos:prefLabel "available national soil sealing data compared with copernicus data, 2015" ;
    skos:narrower she:Austria,
                  she:BelgiumFlanders,
                  she:Luxembourg .

she:SoilSealing a skos:Concept ;
    skos:prefLabel "soil sealing" ;
    skos:narrower she:EEACopernicus,
                  she:NationalMethod .

she:NationalMethod a skos:Concept ;
    skos:prefLabel "national method" .

she:EEACopernicus a skos:Concept ;
    skos:prefLabel "eea/copernicus" ;
    she:hasAbbreviation "EEA" .

she:BelgiumFlanders a skos:Concept ;
    skos:prefLabel "belgium (flanders)" ;
    she:hasCountrySize "13,625km²" ;
    she:hasNationalMethodSealingArea "1,935km²" ;
    she:hasNationalMethodSealingPercentage "14.2%" ;
    she:hasEEACopernicusSealingArea "1,212km²" ;
    she:hasEEACopernicusSealingPercentage "8.9%" .

she:Austria a skos:Concept ;
    skos:prefLabel "austria" ;
    she:hasCountrySize "83,882km²" ;
    she:hasNationalMethodSealingArea "2,298km²" ;
    she:hasNationalMethodSealingPercentage "2.7%" ;
    she:hasEEACopernicusSealingArea "1,475km²" ;
    she:hasEEACopernicusSealingPercentage "1.8%" .

she:Luxembourg a skos:Concept ;
    skos:prefLabel "luxembourg" ;
    she:hasCountrySize "2,593km²" ;
    she:hasNationalMethodSealingArea "176km²" ;
    she:hasNationalMethodSealingPercentage "6.8%" ;
    she:hasEEACopernicusSealingArea "49km²" ;
    she:hasEEACopernicusSealingPercentage "1.9%" ;
    skos:note "For Luxembourg, national method data refers to the year 2018, as there are no data for 2015." .
