@prefix she: <https://soilwise-he.github.io/soil-health#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

she:RelationshipOfSoilErosionToSocietalNeedsAndSoilFunctions a skos:Concept ;
    skos:narrower she:SocietalNeed,
        she:SoilErosion,
        she:SoilService ;
    skos:prefLabel "relationship of soil erosion to key societal needs and soil functions" .

she:Management a skos:Concept ;
    skos:prefLabel "management" .

she:SocietalNeed a skos:Concept ;
    skos:narrower she:Biodiversity,
        she:Biomass,
        she:Climate,
        she:Infrastructure,
        she:Water ;
    skos:prefLabel "societal need" .

she:SoilSedimentVolume a skos:Concept ;
    skos:prefLabel "soil sediment volume" ;
    she:requires she:Management .

she:SoilService a skos:Concept ;
    skos:narrower she:CarbonStorage,
        she:FilteringOfContaminants,
        she:GrowthOfCrops,
        she:HabitatForPlantsInsectsMicrobesFungiAndAnyMicrofauna,
        she:PlatformForInfrastructure,
        she:StorageOfRelocatedMaterialOrArtefacts,
        she:WaterStorage,
        she:WoodAndFibreProduction ;
    skos:prefLabel "soil service" .

she:Biodiversity a skos:Concept ;
    skos:prefLabel "biodiversity" ;
    she:isNegativelyAffectedBy she:SoilErosion ;
    she:isSupportedByService she:HabitatForPlantsInsectsMicrobesFungiAndAnyMicrofauna .

she:CarbonStorage a skos:Concept ;
    skos:prefLabel "carbon storage" ;
    she:isNegativelyAffectedBy she:SoilErosion ;
    she:providesServiceFor she:Climate .

she:Climate a skos:Concept ;
    skos:prefLabel "climate" ;
    she:isNegativelyAffectedBy she:SoilErosion ;
    she:isSupportedByService she:CarbonStorage .

she:FilteringOfContaminants a skos:Concept ;
    skos:prefLabel "filtering of contaminants" ;
    she:isNegativelyAffectedBy she:SoilErosion ;
    she:providesServiceFor she:Water .

she:GrowthOfCrops a skos:Concept ;
    skos:prefLabel "growth of crops" ;
    she:isNegativelyAffectedBy she:SoilErosion ;
    she:providesServiceFor she:Biomass .

she:HabitatForPlantsInsectsMicrobesFungiAndAnyMicrofauna a skos:Concept ;
    skos:prefLabel "habitat for plants, insects, microbes, fungi and any microfauna" ;
    she:isNegativelyAffectedBy she:SoilErosion ;
    she:providesServiceFor she:Biodiversity .

she:PlatformForInfrastructure a skos:Concept ;
    skos:prefLabel "platform for infrastructure" ;
    she:isNegativelyAffectedBy she:SoilErosion ;
    she:providesServiceFor she:Infrastructure .

she:StorageOfRelocatedMaterialOrArtefacts a skos:Concept ;
    skos:definition "excavated geological material, sediments, cables and pipelines, archaeological material" ;
    skos:prefLabel "storage of relocated material or artefacts (excavated geological material, sediments, cables and pipelines, archaeological material)" ;
    she:isNegativelyAffectedBy she:SoilErosion ;
    she:providesServiceFor she:Infrastructure .

she:WaterStorage a skos:Concept ;
    skos:prefLabel "water storage" ;
    she:isNegativelyAffectedBy she:SoilErosion ;
    she:providesServiceFor she:Water .

she:WoodAndFibreProduction a skos:Concept ;
    skos:prefLabel "wood and fibre production" ;
    she:isNegativelyAffectedBy she:SoilErosion ;
    she:providesServiceFor she:Biomass .

she:Biomass a skos:Concept ;
    skos:prefLabel "biomass" ;
    she:isNegativelyAffectedBy she:SoilErosion ;
    she:isSupportedByService she:GrowthOfCrops,
        she:WoodAndFibreProduction .

she:Infrastructure a skos:Concept ;
    skos:prefLabel "infrastructure" ;
    she:isNegativelyAffectedBy she:SoilErosion ;
    she:isSupportedByService she:PlatformForInfrastructure,
        she:StorageOfRelocatedMaterialOrArtefacts .

she:Water a skos:Concept ;
    skos:prefLabel "water" ;
    she:isNegativelyAffectedBy she:SoilErosion ;
    she:isSupportedByService she:FilteringOfContaminants,
        she:WaterStorage .

she:SoilErosion a skos:Concept ;
    skos:prefLabel "soil erosion" ;
    she:increases she:SoilSedimentVolume .

