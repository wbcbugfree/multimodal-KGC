@prefix she: <https://soilwise-he.github.io/soil-health#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

she:EnvironmentalThresholdsForOTUsOfEctomycorrhizalFungi a skos:Concept ;
    skos:narrower she:FoliarNPRatio,
        she:ForestFloorPH,
        she:MeanAnnualAirTemperature,
        she:ThroughfallNitrogenDeposition,
        she:ThroughfallPotassiumDeposition ;
    skos:prefLabel "environmental thresholds for operational taxonomic units (otus) of ectomycorrhizal fungi" ;
    she:hasSource "Compiled from Van der Linde et al. (2018)." .

she:FoliarNPRatio a skos:Concept ;
    skos:prefLabel "foliar n:p ratio" ;
    she:hasDecreasingOTUsThreshold "10.2" ;
    she:hasIncreasingOTUsThreshold "13.3" .

she:ForestFloorPH a skos:Concept ;
    skos:prefLabel "forest floor ph" ;
    she:hasDecreasingOTUsThreshold "3.8" .

she:MeanAnnualAirTemperature a skos:Concept ;
    skos:prefLabel "mean annual air temperature" ;
    she:hasDecreasingOTUsThreshold "7.4°C" ;
    she:hasIncreasingOTUsThreshold "9.1°C" .

she:ThroughfallNitrogenDeposition a skos:Concept ;
    skos:prefLabel "throughfall nitrogen deposition" ;
    she:hasDecreasingOTUsThreshold "5.8kg N/ha/year" ;
    she:hasIncreasingOTUsThreshold "15.5kg N/ha/year" .

she:ThroughfallPotassiumDeposition a skos:Concept ;
    skos:prefLabel "throughfall potassium deposition" ;
    she:hasDecreasingOTUsThreshold "6.9kg K/ha/year" ;
    she:hasIncreasingOTUsThreshold "21.7kg K/ha/year" .

