@prefix she: <https://soilwise-he.github.io/soil-health#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

she:BaselineAndThresholdApproachForSoilBiodiversityMonitoring a skos:Concept ;
    skos:narrower she:ReferenceState,
        she:TransitionalStages,
        she:UnacceptableStress ;
    skos:prefLabel "baseline and threshold approach for soil biodiversity monitoring" .

she:Damage a skos:Concept ;
    skos:prefLabel "damage" ;
    she:isConsequenceOf she:UnacceptableStress ;
    she:isStateOf she:SoilBiologicalCondition .

she:DesiredValueRange a skos:Concept ;
    skos:prefLabel "desired value (range)" ;
    she:isLevelOf she:SoilBiologicalCondition .

she:EcosystemSpecific a skos:Concept ;
    skos:prefLabel "ecosystem-specific" .

she:EmergencyPush a skos:Concept ;
    skos:prefLabel "emergency push" ;
    she:causesTemporaryIncreaseIn she:SoilBiologicalCondition .

she:ReferenceState a skos:Concept ;
    skos:prefLabel "reference state" ;
    she:isCharacterizedBy she:EcosystemSpecific ;
    she:maintains she:DesiredValueRange .

she:StressLevel a skos:Concept ;
    skos:prefLabel "stress level" .

she:StressResponse a skos:Concept ;
    skos:prefLabel "stress response" ;
    she:describesBehaviorOf she:SoilBiologicalCondition ;
    she:precedes she:Decline .

she:TransitionalStages a skos:Concept ;
    skos:prefLabel "transitional stages" ;
    she:includes she:Decline,
        she:EmergencyPush,
        she:StressResponse .

she:Decline a skos:Concept ;
    skos:prefLabel "decline" ;
    she:describesTrendOf she:SoilBiologicalCondition ;
    she:leadsTo she:Threshold .

she:Threshold a skos:Concept ;
    skos:prefLabel "threshold" ;
    she:isCriticalLevelOf she:SoilBiologicalCondition ;
    she:marksBoundaryOf she:UnacceptableStress .

she:UnacceptableStress a skos:Concept ;
    skos:prefLabel "unacceptable stress" ;
    she:isEnteredAt she:Threshold ;
    she:resultsIn she:Damage .

she:SoilBiologicalCondition a skos:Concept ;
    skos:prefLabel "soil biological condition" ;
    she:isAffectedBy she:StressLevel .

