@prefix she: <https://soilwise-he.github.io/soil-health#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

she:SummarisedCriticalPhValues a skos:Concept ;
    skos:prefLabel "summarised critical ph values for wheat, maize and rice derived from short-term manipulation experiments (ste) and long-term observations (lte)" ;
    skos:note "Source: Compiled from Zhu et al. (2020)." .

she:Crop a skos:Concept ;
    skos:prefLabel "crop" ;
    skos:narrower she:Wheat,
                  she:Maize,
                  she:Rice .

she:Wheat a skos:Concept ;
    skos:prefLabel "wheat" ;
    she:hasPhAt95PercentYield [
        she:hasMethod she:STE ;
        she:hasValue 4.5
    ] , [
        she:hasMethod she:LTE ;
        she:hasValue 5.9
    ] , [
        she:hasMethod she:SteLte ;
        she:hasValue 5.3
    ] .

she:Maize a skos:Concept ;
    skos:prefLabel "maize" ;
    she:hasPhAt95PercentYield [
        she:hasMethod she:STE ;
        she:hasValue 4.6
    ] , [
        she:hasMethod she:LTE ;
        she:hasValue 5.1
    ] , [
        she:hasMethod she:SteLte ;
        she:hasValue 4.8
    ] .

she:Rice a skos:Concept ;
    skos:prefLabel "rice" ;
    she:hasPhAt95PercentYield [
        she:hasMethod she:STE ;
        she:hasValue 4.7
    ] , [
        she:hasMethod she:LTE ;
        she:hasValue 5.0
    ] , [
        she:hasMethod she:SteLte ;
        she:hasValue 4.7
    ] .

she:PhAt95PercentYield a skos:Concept ;
    skos:prefLabel "ph at 95% yield" ;
    skos:narrower she:STE,
                  she:LTE,
                  she:SteLte .

she:STE a skos:Concept ;
    skos:prefLabel "ste" ;
    skos:definition "short-term manipulation experiments" ;
    she:hasAbbreviation "STE" .

she:LTE a skos:Concept ;
    skos:prefLabel "lte" ;
    skos:definition "long-term observations" ;
    she:hasAbbreviation "LTE" .

she:SteLte a skos:Concept ;
    skos:prefLabel "ste+lte" ;
    she:hasAbbreviation "STE+LTE" .
