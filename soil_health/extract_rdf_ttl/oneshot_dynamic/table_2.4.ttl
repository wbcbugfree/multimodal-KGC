@prefix she: <https://soilwise-he.github.io/soil-health#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

she:MeanSocTargetValueMatrix a skos:Concept ;
    skos:prefLabel "matrix of mean soc target values (% soil mass) for mineral cropland soils" ;
    skos:definition "Matrix of mean SOC (Soil Organic Carbon) target values expressed as a percentage of soil mass, specific to mineral cropland soils based on national data sets." ;
    skos:note "Data are valid for Germany and neighbouring countries for different soil textures, climatic conditions and fertilisation regimes." .

she:SoilTextureClass a skos:Concept ;
    skos:prefLabel "soil texture class" ;
    skos:narrower she:Sand,
                  she:Silt,
                  she:LoamAndClay .

she:Sand a skos:Concept ;
    skos:prefLabel "sand" .

she:Silt a skos:Concept ;
    skos:prefLabel "silt" .

she:LoamAndClay a skos:Concept ;
    skos:prefLabel "loam and clay" .

she:ManagementIntensity a skos:Concept ;
    skos:prefLabel "management intensity (fertiliser)" ;
    skos:narrower she:MaxBoth,
                  she:OrganicAndMineral,
                  she:Organic,
                  she:Mineral,
                  she:Null .

she:MaxBoth a skos:Concept ;
    skos:prefLabel "max. both" ;
    skos:definition "Maximal application of organic and mineral fertiliser." .

she:OrganicAndMineral a skos:Concept ;
    skos:prefLabel "organic and mineral" .

she:Organic a skos:Concept ;
    skos:prefLabel "organic" .

she:Mineral a skos:Concept ;
    skos:prefLabel "mineral" .

she:Null a skos:Concept ;
    skos:prefLabel "null" ;
    skos:definition "No fertiliser applied." .

she:ClimaticWaterBalanceDuringSummer a skos:Concept ;
    skos:prefLabel "climatic water balance (mm) during summer" ;
    skos:note "Negative water balance: potential evapotranspiration more than precipitation during summer. Positive values indicate climate-induced surplus in the water budget from April to September." ;
    skos:narrower she:LessThanMinus100,
                  she:Minus100To0,
                  she:MoreThan0 .

she:LessThanMinus100 a skos:Concept ;
    skos:prefLabel "less than -100" .

she:Minus100To0 a skos:Concept ;
    skos:prefLabel "-100 to 0" .

she:MoreThan0 a skos:Concept ;
    skos:prefLabel "more than 0" .

she:Sand she:hasMeanSocTargetValue 
    [ she:value 1.01 ; she:hasManagementIntensity she:MaxBoth ; she:hasClimaticWaterBalance she:LessThanMinus100 ] ,
    [ she:value 1.51 ; she:hasManagementIntensity she:MaxBoth ; she:hasClimaticWaterBalance she:Minus100To0 ] ,
    [ she:value 2.01 ; she:hasManagementIntensity she:MaxBoth ; she:hasClimaticWaterBalance she:MoreThan0 ] ,
    [ she:value 0.95 ; she:hasManagementIntensity she:OrganicAndMineral ; she:hasClimaticWaterBalance she:LessThanMinus100 ] ,
    [ she:value 1.45 ; she:hasManagementIntensity she:OrganicAndMineral ; she:hasClimaticWaterBalance she:Minus100To0 ] ,
    [ she:value 1.95 ; she:hasManagementIntensity she:OrganicAndMineral ; she:hasClimaticWaterBalance she:MoreThan0 ] ,
    [ she:value 0.83 ; she:hasManagementIntensity she:Organic ; she:hasClimaticWaterBalance she:LessThanMinus100 ] ,
    [ she:value 1.33 ; she:hasManagementIntensity she:Organic ; she:hasClimaticWaterBalance she:Minus100To0 ] ,
    [ she:value 1.83 ; she:hasManagementIntensity she:Organic ; she:hasClimaticWaterBalance she:MoreThan0 ] ,
    [ she:value 0.73 ; she:hasManagementIntensity she:Mineral ; she:hasClimaticWaterBalance she:LessThanMinus100 ] ,
    [ she:value 1.23 ; she:hasManagementIntensity she:Mineral ; she:hasClimaticWaterBalance she:Minus100To0 ] ,
    [ she:value 1.73 ; she:hasManagementIntensity she:Mineral ; she:hasClimaticWaterBalance she:MoreThan0 ] ,
    [ she:value 0.70 ; she:hasManagementIntensity she:Null ; she:hasClimaticWaterBalance she:LessThanMinus100 ] ,
    [ she:value 1.2 ; she:hasManagementIntensity she:Null ; she:hasClimaticWaterBalance she:Minus100To0 ] ,
    [ she:value 1.7 ; she:hasManagementIntensity she:Null ; she:hasClimaticWaterBalance she:MoreThan0 ] .

