@prefix she: <https://soilwise-he.github.io/soil-health#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

she:MainCharacteristicsOfDiffuseAndPointSourceSoilPollution a skos:Concept ;
    skos:prefLabel "main characteristics of diffuse and point source soil pollution" ;
    skos:narrower she:DiffusePollution,
        she:PointSourcePollution .

she:Characteristic a skos:Concept ;
    skos:prefLabel "characteristic" ;
    skos:narrower she:AvailabilityThresholdsInReceptors,
        she:Policy,
        she:ProceduralFramework,
        she:ProtectionTarget,
        she:Source .

she:DiffusePollution a skos:Concept ;
    skos:prefLabel "diffuse pollution" ;
    she:hasAvailabilityThreshold she:MetalsMetalloids,
        she:Nutrients,
        she:PlantProtectionChemicals ;
    she:hasPolicy she:EUWideLimitValues,
        she:InputRegulation,
        she:QualityStandards,
        she:SewageSludgePolicy ;
    she:hasProceduralFramework she:NaturalBackgroundLevels,
        she:RiskLimits,
        she:SoilScreeningValues ;
    she:hasProtectionTarget she:AnimalHusbandry,
        she:AquaticEcosystems,
        she:ArableCroppingSystems,
        she:DirectHumanExposure,
        she:TerrestrialEcosystems ;
    she:hasSource she:AgriculturalAreas,
        she:DDT,
        she:FloodplainSoils,
        she:Metals,
        she:Microplastics,
        she:Nanoparticles,
        she:Nutrients,
        she:PersistentOrganicChemicals,
        she:PlantProtectionProducts,
        she:ProximityPollution .

she:PointSourcePollution a skos:Concept ;
    skos:prefLabel "point source pollution" ;
    she:hasAvailabilityThreshold she:AromaticCompounds,
        she:Asbestos,
        she:BTEX,
        she:EcologicalEffectsLevels,
        she:IndustrialOrganicChemicals,
        she:MetalsMetalloids,
        she:MineralOil,
        she:PAHs,
        she:TDI,
        she:VolatileOrganicChlorinatedCompounds ;
    she:hasPolicy she:IED,
        she:NationalRemediationTargets,
        she:Remediation,
        she:SoilManagement,
        she:WFD,
        she:ZeroPollutionActionPlan ;
    she:hasProceduralFramework she:EcotoxicologicalResponse,
        she:FutureIntendedLandUse,
        she:RiskBasedAssessment,
        she:TieredApproaches ;
    she:hasProtectionTarget she:DrinkingWaterResources,
        she:HumanHealth,
        she:SoilEcosystem ;
    she:hasSource she:HistoricalIndustrialEmissions,
        she:IED,
        she:IndustrialInstallations .

she:AgriculturalAreas a skos:Concept ;
    skos:prefLabel "agricultural areas" .

she:AnimalHusbandry a skos:Concept ;
    skos:prefLabel "animal husbandry" ;
    skos:related she:Grassland .

she:AquaticEcosystems a skos:Concept ;
    skos:prefLabel "aquatic ecosystems" .

she:ArableCroppingSystems a skos:Concept ;
    skos:prefLabel "arable cropping systems" .

she:AromaticCompounds a skos:Concept ;
    skos:prefLabel "aromatic compounds" .

she:Asbestos a skos:Concept ;
    skos:prefLabel "asbestos" .

she:BTEX a skos:Concept ;
    skos:definition "benzene, toluene, ethylbenzene and xylene" ;
    skos:prefLabel "btex" ;
    she:hasAbbreviation "BTEX" .

she:DDT a skos:Concept ;
    skos:prefLabel "ddt" ;
    skos:related she:FruitTreeCropping .

she:DirectHumanExposure a skos:Concept ;
    skos:prefLabel "direct human exposure" .

she:DrinkingWaterResources a skos:Concept ;
    skos:prefLabel "drinking water resources" ;
    skos:note "considered in context of leaching from soil or direct emissions" .

she:EcologicalEffectsLevels a skos:Concept ;
    skos:prefLabel "ecological effects levels" .

she:EcotoxicologicalResponse a skos:Concept ;
    skos:prefLabel "ecotoxicological response" .

she:EUWideLimitValues a skos:Concept ;
    skos:prefLabel "eu-wide limit values" ;
    skos:note "regulate quality of mineral and organic fertilisers, soil improvers, and sludges" .

she:FloodplainSoils a skos:Concept ;
    skos:prefLabel "floodplain soils" .

she:FruitTreeCropping a skos:Concept ;
    skos:prefLabel "fruit tree cropping" .

she:FutureIntendedLandUse a skos:Concept ;
    skos:prefLabel "future intended land use" .

she:Grassland a skos:Concept ;
    skos:prefLabel "grassland" .

she:HistoricalIndustrialEmissions a skos:Concept ;
    skos:prefLabel "historical industrial emissions" .

she:HumanHealth a skos:Concept ;
    skos:prefLabel "human health" .

she:IndustrialInstallations a skos:Concept ;
    skos:prefLabel "industrial installations" .

she:IndustrialOrganicChemicals a skos:Concept ;
    skos:prefLabel "industrial organic chemicals" .

she:InputRegulation a skos:Concept ;
    skos:prefLabel "input regulation" ;
    skos:related she:Nitrogen,
        she:Phosphorus .

she:Metals a skos:Concept ;
    skos:prefLabel "metals" .

she:MetalsMetalloids a skos:Concept ;
    skos:prefLabel "metals/metalloids" .

she:Microplastics a skos:Concept ;
    skos:prefLabel "microplastics" .

she:MineralOil a skos:Concept ;
    skos:prefLabel "mineral oil" .

she:Nanoparticles a skos:Concept ;
    skos:prefLabel "nanoparticles" .

she:NationalRemediationTargets a skos:Concept ;
    skos:prefLabel "national remediation targets" .

she:NaturalBackgroundLevels a skos:Concept ;
    skos:prefLabel "natural background levels" .

she:Nitrogen a skos:Concept ;
    skos:prefLabel "nitrogen" .

she:PAHs a skos:Concept ;
    skos:prefLabel "pahs" ;
    she:hasAbbreviation "PAHs" .

she:PersistentOrganicChemicals a skos:Concept ;
    skos:prefLabel "persistent organic chemicals" .

she:Phosphorus a skos:Concept ;
    skos:prefLabel "phosphorus" .

she:PlantProtectionChemicals a skos:Concept ;
    skos:prefLabel "plant protection chemicals" .

she:PlantProtectionProducts a skos:Concept ;
    skos:prefLabel "plant protection products" .

she:ProximityPollution a skos:Concept ;
    skos:prefLabel "proximity pollution" .

she:QualityStandards a skos:Concept ;
    skos:prefLabel "quality standards" .

she:Remediation a skos:Concept ;
    skos:prefLabel "remediation" .

she:RiskBasedAssessment a skos:Concept ;
    skos:prefLabel "risk-based assessment" .

she:RiskLimits a skos:Concept ;
    skos:prefLabel "risk limits" ;
    skos:related she:DrinkingWater,
        she:Foodstuffs .

she:SewageSludgePolicy a skos:Concept ;
    skos:prefLabel "sewage sludge policy" ;
    skos:note "based on preventing accumulation" .

she:SoilEcosystem a skos:Concept ;
    skos:prefLabel "soil ecosystem" .

she:SoilManagement a skos:Concept ;
    skos:prefLabel "soil management" .

she:SoilScreeningValues a skos:Concept ;
    skos:prefLabel "soil screening values" .

she:TerrestrialEcosystems a skos:Concept ;
    skos:prefLabel "terrestrial ecosystems" .

she:TieredApproaches a skos:Concept ;
    skos:prefLabel "tiered approaches" .

she:VolatileOrganicChlorinatedCompounds a skos:Concept ;
    skos:prefLabel "volatile organic chlorinated compounds" .

she:ZeroPollutionActionPlan a skos:Concept ;
    skos:prefLabel "zero pollution action plan" .

she:AvailabilityThresholdsInReceptors a skos:Concept ;
    skos:prefLabel "availability thresholds in receptors" .

she:IED a skos:Concept ;
    skos:altLabel "industrial emissions directive" ;
    skos:prefLabel "ied" ;
    she:hasAbbreviation "IED" .

she:Nutrients a skos:Concept ;
    skos:prefLabel "nutrients" .

she:Policy a skos:Concept ;
    skos:prefLabel "policy" .

she:ProceduralFramework a skos:Concept ;
    skos:prefLabel "procedural framework" .

she:ProtectionTarget a skos:Concept ;
    skos:prefLabel "protection target" .

she:Source a skos:Concept ;
    skos:prefLabel "source" .

she:TDI a skos:Concept ;
    skos:definition "tolerable daily intake" ;
    skos:prefLabel "tdi" ;
    she:hasAbbreviation "TDI" .

she:WFD a skos:Concept ;
    skos:altLabel "water framework directive" ;
    skos:prefLabel "wfd" ;
    she:hasAbbreviation "WFD" .
