@prefix she: <https://soilwise-he.github.io/soil-health#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

she:SocietalNeeds a skos:Concept ;
    skos:prefLabel "societal needs" ;
    skos:narrower she:Biomass,
        she:Water,
        she:Climate,
        she:Biodiversity,
        she:Infrastructure .

she:Biomass a skos:Concept ;
    skos:prefLabel "biomass" ;
    skos:narrower she:WoodAndFibreProduction,
        she:GrowthOfCrops .

she:Water a skos:Concept ;
    skos:prefLabel "water" ;
    skos:narrower she:FilteringOfContaminants,
        she:WaterStorage .

she:Climate a skos:Concept ;
    skos:prefLabel "climate" ;
    skos:narrower she:CarbonStage .

she:Biodiversity a skos:Concept ;
    skos:prefLabel "biodiversity" ;
    skos:narrower she:HabitatForPlantsInsectsMicrobesFungi .

she:Infrastructure a skos:Concept ;
    skos:prefLabel "infrastructure" ;
    skos:narrower she:PlataformForInfrastructure,
        she:StorageOfGeologicalMaterial .

she:SoilServices a skos:Concept ;
    skos:prefLabel "soil services" ;
    skos:narrower she:WoodAndFibreProduction,
        she:GrowthOfCrops,
        she:FilteringOfContaminants,
        she:WaterStorage,
        she:CarbonStage,
        she:HabitatForPlantsInsectsMicrobesFungi,
        she:PlataformForInfrastructure,
        she:StorageOfGeologicalMaterial .

she:WoodAndFibreProduction a skos:Concept ;
    skos:prefLabel "wood and fibre production" .

she:GrowthOfCrops a skos:Concept ;
    skos:prefLabel "growth of crops" .

she:FilteringOfContaminants a skos:Concept ;
    skos:prefLabel "filtering of contaminants" .

she:WaterStorage a skos:Concept ;
    skos:prefLabel "water storage" .

she:CarbonStage a skos:Concept ;
    skos:prefLabel "carbon stage" .

she:HabitatForPlantsInsectsMicrobesFungi a skos:Concept ;
    skos:prefLabel "habitat for plants, insects, microbes, fungi" .

she:PlataformForInfrastructure a skos:Concept ;
    skos:prefLabel "plataform for infrastructure" .

she:StorageOfGeologicalMaterial a skos:Concept ;
    skos:prefLabel "storage of geological material" .

she:SoilThreatIndicators a skos:Concept ;
    skos:prefLabel "soil threat indicators" ;
    skos:narrower she:SoilOrganicCarbon,
        she:SoilNutrientStatuts,
        she:SoilAcidification,
        she:SoilPollution,
        she:SoilBiodiversity,
        she:SoilErosion,
        she:SoilCompaction,
        she:SoilSealing .

she:SoilOrganicCarbon a skos:Concept ;
    skos:prefLabel "soil organic carbon" ;
    she:hasPositiveImpactOn she:Biomass,
        she:Water,
        she:Climate,
        she:Biodiversity ;
    she:hasNeutralImpactOn she:Infrastructure ;
    skos:note "(i) Soil organic carbon/infrastructure: organic soils are unstable as platform for infrastructure." .

she:SoilNutrientStatuts a skos:Concept ;
    skos:prefLabel "soil nutrient statuts" ;
    she:hasPositiveImpactOn she:Biomass,
        she:Biodiversity ;
    she:hasNegativeImpactOn she:Water ;
    she:hasNeutralImpactOn she:Climate,
        she:Infrastructure ;
    skos:note "(ii) The filtering capacity of soils prevents of buffers eutrophication and acidification." .

she:SoilAcidification a skos:Concept ;
    skos:prefLabel "soil acidification" ;
    she:hasNegativeImpactOn she:Biomass,
        she:Water,
        she:Biodiversity ;
    she:hasNeutralImpactOn she:Climate,
        she:Infrastructure ;
    skos:note "(iii) Soil organic /carbon storage: fulvic acid (from acidified forest floors) engances bleaching and nutrient loss, as well as loss of dissolved organic carbon; acidic soils slow down decomposition. From a climate point of view, soil acidification could favour carbon storage, as it leads to a lower biological activity and hence accumulation of dead biomass." .

she:SoilPollution a skos:Concept ;
    skos:prefLabel "soil pollution" ;
    she:hasNegativeImpactOn she:Biomass,
        she:Water,
        she:Climate,
        she:Biodiversity ;
    she:hasNeutralImpactOn she:Infrastructure ;
    skos:note "(iv) Land prices are lower if the soil is polluted, as remediation costs are incurred." .

she:SoilBiodiversity a skos:Concept ;
    skos:prefLabel "soil biodiversity" ;
    she:hasPositiveImpactOn she:Biomass,
        she:Water,
        she:Climate,
        she:Biodiversity ;
    she:hasNeutralImpactOn she:Infrastructure .

she:SoilErosion a skos:Concept ;
    skos:prefLabel "soil erosion" ;
    she:hasNegativeImpactOn she:Biomass,
        she:Water,
        she:Climate,
        she:Biodiversity ;
    she:hasNeutralImpactOn she:Infrastructure .

she:SoilCompaction a skos:Concept ;
    skos:prefLabel "soil compaction" ;
    she:hasNegativeImpactOn she:Biomass,
        she:Water,
        she:Climate,
        she:Biodiversity ;
    she:hasNeutralImpactOn she:Infrastructure .

she:SoilSealing a skos:Concept ;
    skos:prefLabel "soil sealing" ;
    she:hasNegativeImpactOn she:Biomass,
        she:Water,
        she:Climate,
        she:Biodiversity ;
    she:hasPositiveImpactOn she:Infrastructure .
