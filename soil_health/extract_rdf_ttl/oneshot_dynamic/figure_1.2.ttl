@prefix she: <https://soilwise-he.github.io/soil-health#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

she:ConceptualFrameworkForSoilDegradationAssessment a skos:Concept ;
    skos:prefLabel "conceptual framework for soil degradation assessment" ;
    skos:note "Source: EEA." ;
    skos:narrower she:EcosystemService,
                  she:SoilFunction,
                  she:Endpoints,
                  she:ChangeOfLandUseAndOrManagement,
                  she:SoilWaterProductQuality,
                  she:ThresholdsLimits,
                  she:Evaluation,
                  she:ActualLevelLessThanThreshold,
                  she:ActualLevelGreaterThanThreshold,
                  she:ActionNeededPolicyInduced .

she:EcosystemService a skos:Concept ;
    skos:prefLabel "ecosystem service" ;
    she:leadsTo she:SoilFunction .

she:SoilFunction a skos:Concept ;
    skos:prefLabel "soil function" ;
    she:leadsTo she:Endpoints .

she:Endpoints a skos:Concept ;
    skos:prefLabel "endpoints" ;
    she:leadsTo she:SoilWaterProductQuality .

she:ChangeOfLandUseAndOrManagement a skos:Concept ;
    skos:prefLabel "change of land use and/or management" ;
    she:leadsTo she:SoilWaterProductQuality .

she:SoilWaterProductQuality a skos:Concept ;
    skos:prefLabel "soil/ water/ product/ quality" ;
    she:leadsTo she:ThresholdsLimits .

she:ThresholdsLimits a skos:Concept ;
    skos:prefLabel "thresholds (limits)" ;
    she:leadsTo she:Evaluation .

she:Evaluation a skos:Concept ;
    skos:prefLabel "evaluation" ;
    she:leadsTo she:ActualLevelLessThanThreshold,
                she:ActualLevelGreaterThanThreshold .

she:ActualLevelLessThanThreshold a skos:Concept ;
    skos:prefLabel "actual level < threshold" .

she:ActualLevelGreaterThanThreshold a skos:Concept ;
    skos:prefLabel "actual level > threshold" ;
    she:leadsTo she:ActionNeededPolicyInduced .

she:ActionNeededPolicyInduced a skos:Concept ;
    skos:prefLabel "action needed (policy induced)" ;
    she:leadsTo she:ChangeOfLandUseAndOrManagement .
