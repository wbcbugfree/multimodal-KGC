                     [ she:forElement she:Cadmium ; she:atRiskLevel she:ActionValue ; she:hasStratum she:LandUse ; she:hasSsvValue "0.1-20" ],
                     [ she:forElement she:Copper ; she:atRiskLevel she:WarningValue ; she:hasStratum she:LandUse ; she:hasSsvValue "1" ; skos:note "Analysis based on concentrated ammonium nitrate" ],
                     [ she:forElement she:Copper ; she:atRiskLevel she:ActionValue ; she:hasStratum she:LandUse ; she:hasSsvValue "1,300" ],
                     [ she:forElement she:Lead ; she:atRiskLevel she:WarningValue ; skos:note "Analysis based on concentrated ammonium nitrate" ],
                     [ she:forElement she:Zinc ; she:atRiskLevel she:WarningValue ; skos:note "Analysis based on concentrated ammonium nitrate" ] .

