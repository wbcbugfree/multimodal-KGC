@prefix she: <https://soilwise-he.github.io/soil-health#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

she:SoilScreeningValue a skos:Concept ;
    skos:prefLabel "soil screening value" ;
    she:hasAbbreviation "ssv" ;
    skos:definition "screening values for cadmium, copper, lead and zinc in soil for intermediate and critical risk levels (mg/kg)" .

she:Cadmium a skos:Concept ;
    skos:prefLabel "cadmium" ;
    skos:narrower she:WarningValue, she:ActionValue .

she:Copper a skos:Concept ;
    skos:prefLabel "copper" ;
    skos:narrower she:WarningValue, she:ActionValue .

she:Lead a skos:Concept ;
    skos:prefLabel "lead" ;
    skos:narrower she:WarningValue, she:ActionValue .

she:Zinc a skos:Concept ;
    skos:prefLabel "zinc" ;
    skos:narrower she:WarningValue, she:ActionValue .

she:WarningValue a skos:Concept ;
    skos:prefLabel "warning value" ;
    skos:note "intermediate risk level" .

she:ActionValue a skos:Concept ;
    skos:prefLabel "action value" ;
    skos:note "critical risk level" .

she:Stratum a skos:Concept ;
    skos:prefLabel "stratum" ;
    skos:narrower she:LandUse, she:Texture, she:SoilOrganicMatter, she:SaturatedHydraulicConductivity, she:SoilDepth, she:PH, she:Clay .

she:LandUse a skos:Concept ;
    skos:prefLabel "land use" ;
    she:hasAbbreviation "LU" .

she:Texture a skos:Concept ;
    skos:prefLabel "texture" ;
    she:hasAbbreviation "text." .

she:SoilOrganicMatter a skos:Concept ;
    skos:prefLabel "soil organic matter" ;
    she:hasAbbreviation "SOM" .

she:SaturatedHydraulicConductivity a skos:Concept ;
    skos:prefLabel "saturated hydraulic conductivity" ;
    she:hasAbbreviation "SHC" .

she:SoilDepth a skos:Concept ;
    skos:prefLabel "soil depth" ;
    she:hasAbbreviation "z" .

she:PH a skos:Concept ;
    skos:prefLabel "ph" .

she:Clay a skos:Concept ;
    skos:prefLabel "clay" .

she:Austria a skos:Concept ;
    skos:prefLabel "austria" ;
    she:hasSsvRecord [ she:forElement she:Cadmium ; she:atRiskLevel she:WarningValue ; she:hasStratum she:LandUse ; she:hasSsvValue "1-40" ],
                     [ she:forElement she:Cadmium ; she:atRiskLevel she:ActionValue ; she:hasSsvValue "10" ],
                     [ she:forElement she:Copper ; she:atRiskLevel she:WarningValue ; she:hasStratum she:LandUse ; she:hasSsvValue "100-1,500" ],
                     [ she:forElement she:Copper ; she:atRiskLevel she:ActionValue ; she:hasSsvValue "600" ],
                     [ she:forElement she:Lead ; she:atRiskLevel she:WarningValue ; she:hasStratum she:LandUse ; she:hasSsvValue "100-300" ],
                     [ she:forElement she:Lead ; she:atRiskLevel she:ActionValue ; she:hasSsvValue "500" ],
                     [ she:forElement she:Zinc ; she:atRiskLevel she:WarningValue ; she:hasSsvValue "300" ] .

she:BelgiumBrussels a skos:Concept ;
    skos:prefLabel "belgium/brussels" ;
    she:hasSsvRecord [ she:forElement she:Cadmium ; she:atRiskLevel she:WarningValue ; she:hasSsvValue "1" ],
                     [ she:forElement she:Cadmium ; she:atRiskLevel she:ActionValue ; she:hasStratum she:LandUse ; she:hasSsvValue "2-30" ],
                     [ she:forElement she:Copper ; she:atRiskLevel she:WarningValue ; she:hasSsvValue "40" ],
                     [ she:forElement she:Copper ; she:atRiskLevel she:ActionValue ; she:hasStratum she:LandUse ; she:hasSsvValue "145-800" ],
                     [ she:forElement she:Lead ; she:atRiskLevel she:WarningValue ; she:hasSsvValue "120" ],
                     [ she:forElement she:Lead ; she:atRiskLevel she:ActionValue ; she:hasStratum she:LandUse ; she:hasSsvValue "200-2,500" ],
                     [ she:forElement she:Zinc ; she:atRiskLevel she:WarningValue ; she:hasSsvValue "120" ],
                     [ she:forElement she:Zinc ; she:atRiskLevel she:ActionValue ; she:hasStratum she:LandUse ; she:hasSsvValue "300-3,000" ] .

she:BelgiumFlanders a skos:Concept ;
    skos:prefLabel "belgium/flanders" ;
    she:hasSsvRecord [ she:forElement she:Cadmium ; she:atRiskLevel she:ActionValue ; she:hasStratum she:LandUse ; she:hasSsvValue "2-30" ],
                     [ she:forElement she:Copper ; she:atRiskLevel she:ActionValue ; she:hasStratum she:LandUse ; she:hasSsvValue "200-800" ],
                     [ she:forElement she:Lead ; she:atRiskLevel she:ActionValue ; she:hasStratum she:LandUse ; she:hasSsvValue "200-2,500" ],
                     [ she:forElement she:Zinc ; she:atRiskLevel she:ActionValue ; she:hasStratum she:LandUse ; she:hasSsvValue "600-3,000" ] .

