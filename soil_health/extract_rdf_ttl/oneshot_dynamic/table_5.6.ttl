                     [ she:forElement she:Copper ; she:atRiskLevel she:ActionValue ; she:hasStratum she:LandUse ; she:hasSsvValue "53-600" ],
                     [ she:forElement she:Lead ; she:atRiskLevel she:ActionValue ; she:hasStratum she:LandUse ; she:hasSsvValue "120-1,840" ],
                     [ she:forElement she:Zinc ; she:atRiskLevel she:ActionValue ; she:hasStratum she:LandUse ; she:hasSsvValue "196-3,000" ] .

she:Bulgaria a skos:Concept ;
    skos:prefLabel "bulgaria" ;
    she:hasSsvRecord [ she:forElement she:Cadmium ; she:atRiskLevel she:WarningValue ; she:hasStratum she:LandUse, she:PH ; she:hasSsvValue "1.5-3.5" ],
                     [ she:forElement she:Cadmium ; she:atRiskLevel she:ActionValue ; she:hasSsvValue "12" ],
                     [ she:forElement she:Copper ; she:atRiskLevel she:WarningValue ; she:hasStratum she:LandUse, she:PH ; she:hasSsvValue "80-300" ],
                     [ she:forElement she:Copper ; she:atRiskLevel she:ActionValue ; she:hasSsvValue "500" ],
                     [ she:forElement she:Lead ; she:atRiskLevel she:WarningValue ; she:hasStratum she:LandUse, she:PH ; she:hasSsvValue "60-150" ],
                     [ she:forElement she:Lead ; she:atRiskLevel she:ActionValue ; she:hasSsvValue "500" ],
                     [ she:forElement she:Zinc ; she:atRiskLevel she:WarningValue ; she:hasStratum she:LandUse, she:PH ; she:hasSsvValue "200-450" ],
                     [ she:forElement she:Zinc ; she:atRiskLevel she:ActionValue ; she:hasSsvValue "900" ] .

she:Czechia a skos:Concept ;
    skos:prefLabel "czechia" ;
    she:hasSsvRecord [ she:forElement she:Cadmium ; she:atRiskLevel she:WarningValue ; she:hasStratum she:LandUse, she:PH, she:Texture ; she:hasSsvValue "1.5-20" ],
                     [ she:forElement she:Copper ; she:atRiskLevel she:WarningValue ; she:hasStratum she:PH ; she:hasSsvValue "150-300" ],
                     [ she:forElement she:Lead ; she:atRiskLevel she:WarningValue ; she:hasStratum she:LandUse ; she:hasSsvValue "300-400" ],
                     [ she:forElement she:Zinc ; she:atRiskLevel she:WarningValue ; she:hasSsvValue "400" ] .

she:Denmark a skos:Concept ;
    skos:prefLabel "denmark" ;
    she:hasSsvRecord [ she:forElement she:Cadmium ; she:atRiskLevel she:WarningValue ; she:hasSsvValue "5" ],
                     [ she:forElement she:Copper ; she:atRiskLevel she:WarningValue ; she:hasStratum she:LandUse ; she:hasSsvValue "1,000" ],
                     [ she:forElement she:Lead ; she:atRiskLevel she:WarningValue ; she:hasSsvValue "40" ],
                     [ she:forElement she:Lead ; she:atRiskLevel she:ActionValue ; she:hasSsvValue "400" ],
                     [ she:forElement she:Zinc ; she:atRiskLevel she:WarningValue ; she:hasSsvValue "500" ],
                     [ she:forElement she:Zinc ; she:atRiskLevel she:ActionValue ; she:hasSsvValue "1,000" ] .

she:Finland a skos:Concept ;
    skos:prefLabel "finland" ;
    she:hasSsvRecord [ she:forElement she:Cadmium ; she:atRiskLevel she:WarningValue ; she:hasSsvValue "1" ],
                     [ she:forElement she:Cadmium ; she:atRiskLevel she:ActionValue ; she:hasStratum she:LandUse ; she:hasSsvValue "10-20" ],
                     [ she:forElement she:Copper ; she:atRiskLevel she:WarningValue ; she:hasSsvValue "100" ],
                     [ she:forElement she:Copper ; she:atRiskLevel she:ActionValue ; she:hasStratum she:LandUse ; she:hasSsvValue "150-200" ],
                     [ she:forElement she:Lead ; she:atRiskLevel she:WarningValue ; she:hasSsvValue "60" ],
                     [ she:forElement she:Lead ; she:atRiskLevel she:ActionValue ; she:hasStratum she:LandUse ; she:hasSsvValue "200-750" ],
                     [ she:forElement she:Zinc ; she:atRiskLevel she:WarningValue ; she:hasSsvValue "200" ],
                     [ she:forElement she:Zinc ; she:atRiskLevel she:ActionValue ; she:hasStratum she:LandUse ; she:hasSsvValue "250-400" ] .

