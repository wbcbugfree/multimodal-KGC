        [ she:hasValue 0.6 ; she:appliesToCountry she:BelgiumWallonia ],
        [ she:hasValue 1 ; she:appliesToCountry she:Finland ],
        [ she:hasValue 2 ; she:appliesToCountry she:Italy ],
        [ she:hasValue 76.5 ; she:appliesToCountry she:Poland ],
        [ she:hasValue 10 ; she:appliesToCountry she:Spain ] .

