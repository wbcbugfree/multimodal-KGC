@prefix she: <https://soilwise-he.github.io/soil-health#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

she:Table5_7 a skos:Concept ;
    skos:prefLabel "screening values for potentially unacceptable risk (industrial soil use) for organic contaminants (mg/kg)" ;
    skos:definition "screening values for industrial soil use by country/region and pollutant, measured in mg/kg." ;
    skos:note "B: Brussels; F: Flanders; W: Wallonia. For Finland, the upper guideline values are presented. Until 2007, 13 countries had not reported any national SSVs for organic pollutants. Source: Carlon et al. (2007)." ;
    skos:narrower she:CountryRegion,
        she:Pollutant .

she:CountryRegion a skos:Concept ;
    skos:prefLabel "country/region" ;
    skos:narrower she:BelgiumBrussels,
        she:BelgiumFlanders,
        she:BelgiumWallonia,
        she:Finland,
        she:Italy,
        she:Poland,
        she:Spain .

she:BelgiumBrussels a skos:Concept ;
    skos:prefLabel "belgium (b)" ;
    skos:note "brussels" ;
    she:hasAbbreviation "B" .

she:BelgiumFlanders a skos:Concept ;
    skos:prefLabel "belgium (f)" ;
    skos:note "flanders" ;
    she:hasAbbreviation "F" .

she:BelgiumWallonia a skos:Concept ;
    skos:prefLabel "belgium (w)" ;
    skos:note "wallonia" ;
    she:hasAbbreviation "W" .

she:Finland a skos:Concept ;
    skos:prefLabel "finland" ;
    skos:note "the upper guideline values are presented" .

she:Italy a skos:Concept ;
    skos:prefLabel "italy" .

she:Poland a skos:Concept ;
    skos:prefLabel "poland" .

she:Spain a skos:Concept ;
    skos:prefLabel "spain" .

she:Pollutant a skos:Concept ;
    skos:prefLabel "pollutant" ;
    skos:narrower she:Anthracene,
        she:AtrazineP,
        she:Benzene,
        she:BenzoAAnthracene,
        she:BenzoAPyrene,
        she:BenzoGHIPerylene,
        she:CresolsSum,
        she:Dichloromethane,
        she:Ethylbenzene,
        she:Hexachlorobenzene,
        she:MethylTButylEther,
        she:Naphthalene,
        she:PAHsTotal,
        she:PCB,
        she:Phenol,
        she:Tetrachloromethane,
        she:Toluene,
        she:Trichloroethane111,
        she:Trichloroethylene,
        she:Xylene .

she:Anthracene a skos:Concept ;
    skos:prefLabel "anthracene" ;
    she:hasScreeningValue [ she:hasValue 4690 ; she:appliesToCountry she:BelgiumFlanders ],
        [ she:hasValue 4690 ; she:appliesToCountry she:BelgiumBrussels ],
        [ she:hasValue 15 ; she:appliesToCountry she:Finland ],
        [ she:hasValue 50 ; she:appliesToCountry she:Italy ],
        [ she:hasValue 25 ; she:appliesToCountry she:Poland ],
        [ she:hasValue 100 ; she:appliesToCountry she:Spain ] .

she:AtrazineP a skos:Concept ;
    skos:prefLabel "atrazine (p)" ;
    she:hasScreeningValue [ she:hasValue 2 ; she:appliesToCountry she:Finland ],
        [ she:hasValue 1 ; she:appliesToCountry she:Italy ],
        [ she:hasValue 3 ; she:appliesToCountry she:Poland ] .

she:Benzene a skos:Concept ;
