@prefix she: <https://soilwise-he.github.io/soil-health#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

she:DefinitionOfSomThresholdsDerivedFromAFarmerQuestionnaire a skos:Concept ;
    skos:prefLabel "definition of som thresholds derived from a farmer questionnaire" ;
    skos:narrower she:Threshold1,
                  she:Threshold2 ;
    skos:note "Sources: Elaborated based on Hijbeek et al. (2017b); SOC data for the area estimates are from De Brogniez et al. (2015)." .

she:Threshold1 a skos:Concept ;
    skos:prefLabel "threshold 1" ;
    skos:definition "Lower end of SOM value range (10th percentile) at which farmers judge their current SOM content sufficient" ;
    skos:note "Below this threshold value, no farmers are expected to be satisfied with their SOM content",
              "1.1% of the European cropland area is concerned (in particular northern France)" ;
    skos:related she:Som,
                 she:Farmers,
                 she:EuropeanCroplandArea,
                 she:NorthernFrance ;
    she:hasPercentile she:Percentile10 .

she:Threshold2 a skos:Concept ;
    skos:prefLabel "threshold 2" ;
    skos:definition "Upper end of the range of values (90th percentile) at which farmers perceive a high or very high deficiency of SOM content" ;
    skos:note "Above this threshold, no farmers are expected to be dissatisfied with their SOM content",
              "14.3% of the cropland area (mostly central/eastern Europe and southern Europe)" ;
    skos:related she:Som,
                 she:Farmers,
                 she:EuropeanCroplandArea,
                 she:CentralEasternEurope,
                 she:SouthernEurope ;
    she:hasPercentile she:Percentile90 .

she:Som a skos:Concept ;
    skos:prefLabel "som" ;
    she:hasAbbreviation "SOM" .

she:Farmers a skos:Concept ;
    skos:prefLabel "farmers" .

she:EuropeanCroplandArea a skos:Concept ;
    skos:prefLabel "european cropland area" .

she:NorthernFrance a skos:Concept ;
    skos:prefLabel "northern france" .

she:CentralEasternEurope a skos:Concept ;
    skos:prefLabel "central/eastern europe" .

she:SouthernEurope a skos:Concept ;
    skos:prefLabel "southern europe" .

she:Percentile10 a skos:Concept ;
    skos:prefLabel "10th percentile" .

she:Percentile90 a skos:Concept ;
    skos:prefLabel "90th percentile" .

she:Soc a skos:Concept ;
    skos:prefLabel "soc" ;
    she:hasAbbreviation "SOC" .
