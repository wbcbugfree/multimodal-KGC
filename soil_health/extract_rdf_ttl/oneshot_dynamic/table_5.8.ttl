@prefix she: <https://soilwise-he.github.io/soil-health#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

she:ScreeningValuesTable a skos:Concept ;
    skos:prefLabel "screening values for potentially unacceptable risk (residential soil use) for organic contaminants" ;
    skos:note "Compiled from Carlon et al. (2007). Values are in mg/kg unless otherwise specified. B: Brussels, F: Flanders, W: Wallonia. PCDD: polychlorinated dibenzodioxins, PCDF: polychlorinated dibenzofurans." ;
    skos:narrower she:Compound, she:CountryRegion .

she:CountryRegion a skos:Concept ;
    skos:prefLabel "country/region" ;
    skos:narrower she:AT, she:BE_F, she:BE_B, she:BE_W, she:CZ, she:FI, she:IT, she:LT, she:NL, she:PL, she:ES, she:UK, she:DK .

she:Compound a skos:Concept ;
    skos:prefLabel "compound" ;
    skos:narrower she:Benzene, she:Ethylbenzene, she:Toluene, she:Xylene, she:Naphthalene, 
                  she:Anthracene, she:BenzoAAnthracene, she:BenzoGHIPerylene, she:PAHsTotal, 
                  she:Dichloromethane, she:Trichloroethylene, she:Tetrachloromethane, 
                  she:Hexachlorobenzene, she:Phenol, she:CresolsSum, she:AtrazineP, 
                  she:DDTSum, she:PCB, she:MethylTButylEther, she:OneOneOneTrichloroethane, 
                  she:ChlorobenzenesSum, she:BenzoAPyrene, she:PCDD_PCDF .

she:AT a skos:Concept ; skos:prefLabel "at" ; skos:note "austria" .
she:BE_F a skos:Concept ; skos:prefLabel "be (f)" ; skos:note "flanders" .
she:BE_B a skos:Concept ; skos:prefLabel "be (b)" ; skos:note "brussels" .
she:BE_W a skos:Concept ; skos:prefLabel "be (w)" ; skos:note "wallonia" .
she:CZ a skos:Concept ; skos:prefLabel "cz" ; skos:note "czech republic" .
she:FI a skos:Concept ; skos:prefLabel "fi" ; skos:note "finland" .
she:IT a skos:Concept ; skos:prefLabel "it" ; skos:note "italy" .
she:LT a skos:Concept ; skos:prefLabel "lt" ; skos:note "lithuania" .
she:NL a skos:Concept ; skos:prefLabel "nl" ; skos:note "netherlands" .
she:PL a skos:Concept ; skos:prefLabel "pl" ; skos:note "poland" .
she:ES a skos:Concept ; skos:prefLabel "es" ; skos:note "spain" .
she:UK a skos:Concept ; skos:prefLabel "uk" ; skos:note "united kingdom" .
she:DK a skos:Concept ; skos:prefLabel "dk" ; skos:note "denmark" .

