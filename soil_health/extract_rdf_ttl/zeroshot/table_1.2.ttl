@prefix she: <https://soilwise-he.github.io/soil-health#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

she:ImportantSoilFunctions a skos:Concept ;
    skos:narrower she:CarbonStorage,
        she:HabitatForBiologicalActivity,
        she:NutrientCycling,
        she:Production,
        she:WaterStorageAndQuality ;
    skos:prefLabel "important soil functions" .

she:CapacityToProvideNutrientsFromMineralAndOrganicSoilResourcesInAvailableFormNutrientMobilisationCapacity a skos:Concept ;
    skos:definition "capacity to provide nutrients from mineral and organic soil resources in available form (nutrient mobilisation capacity)" ;
    skos:prefLabel "capacity to provide nutrients from mineral and organic soil resources in available form (nutrient mobilisation capacity)" .

she:CarbonStorage a skos:Concept ;
    skos:definition "capacity to store and stabilise soc" ;
    skos:prefLabel "carbon storage" .

she:HabitatForBiologicalActivity a skos:Concept ;
    skos:definition "provision of a species (gene) pool that can buffer ecosystem functions against species extinction (assumption: loss of soil function is more likely with low species diversity in each functional group)" ;
    skos:prefLabel "habitat for biological activity" .

she:NutrientCycling a skos:Concept ;
    skos:narrower she:CapacityToProvideNutrientsFromMineralAndOrganicSoilResourcesInAvailableFormNutrientMobilisationCapacity,
        she:TheCapacityToStoreMobileNutrientsWithinTheRootZoneToAvoidLossesByLeachingAndGaseousEmissionsNutrientBufferingCapacity ;
    skos:prefLabel "nutrient cycling" .

she:Production a skos:Concept ;
    skos:definition "capacity to produce biomass" ;
    skos:prefLabel "production" .

she:TheCapacityToStoreMobileNutrientsWithinTheRootZoneToAvoidLossesByLeachingAndGaseousEmissionsNutrientBufferingCapacity a skos:Concept ;
    skos:definition "the capacity to store mobile nutrients within the root zone to avoid losses by leaching and gaseous emissions (nutrient buffering capacity)" ;
    skos:prefLabel "the capacity to store mobile nutrients within the root zone to avoid losses by leaching and gaseous emissions (nutrient buffering capacity)" .

she:WaterStorageAndQuality a skos:Concept ;
    skos:definition "capacity to store precipitation water and filter for soil pollutants" ;
    skos:prefLabel "water storage and quality" .

