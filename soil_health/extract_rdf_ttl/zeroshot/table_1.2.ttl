@prefix she: <https://soilwise-he.github.io/soil-health#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

she:ImportantSoilFunctions a skos:Concept ;
    skos:prefLabel "important soil functions" ;
    skos:note "Table 1.2; Source: Modified from Vogel et al. (2020). Reproduction licensed under Creative Commons CC BY 4.0 (https://creativecommons.org/licenses/by/4.0/)." ;
    skos:narrower she:Production,
                  she:WaterStorageAndQuality,
                  she:CarbonStorage,
                  she:NutrientCycling,
                  she:HabitatForBiologicalActivity .

she:Production a skos:Concept ;
    skos:prefLabel "production" ;
    skos:definition "Capacity to produce biomass" ;
    skos:broader she:ImportantSoilFunctions .

she:WaterStorageAndQuality a skos:Concept ;
    skos:prefLabel "water storage and quality" ;
    skos:definition "Capacity to store precipitation water and filter for soil pollutants" ;
    skos:broader she:ImportantSoilFunctions .

she:CarbonStorage a skos:Concept ;
    skos:prefLabel "carbon storage" ;
    skos:definition "Capacity to store and stabilise SOC" ;
    she:hasAbbreviation "SOC" ;
    skos:broader she:ImportantSoilFunctions .

she:NutrientCycling a skos:Concept ;
    skos:prefLabel "nutrient cycling" ;
    skos:definition "i. Capacity to provide nutrients from mineral and organic soil resources in available form (nutrient mobilisation capacity); ii. The capacity to store mobile nutrients within the root zone to avoid losses by leaching and gaseous emissions (nutrient buffering capacity)" ;
    skos:altLabel "nutrient mobilisation capacity", "nutrient buffering capacity" ;
    skos:broader she:ImportantSoilFunctions .

she:HabitatForBiologicalActivity a skos:Concept ;
    skos:prefLabel "habitat for biological activity" ;
    skos:definition "Provision of a species (gene) pool that can buffer ecosystem functions against species extinction (assumption: loss of soil function is more likely with low species diversity in each functional group)" ;
    skos:broader she:ImportantSoilFunctions .
