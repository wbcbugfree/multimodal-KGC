@prefix she: <https://soilwise-he.github.io/soil-health#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

she:Figure41 a skos:Concept ;
    skos:narrower she:FitMaize,
        she:FitRice,
        she:FitWheat,
        she:Maize,
        she:Rice,
        she:Wheat ;
    skos:prefLabel "figure 4.1" ;
    she:hasSource "Adapted after Zhu et al. (2020)." ;
    she:hasTitle she:ImpactOfSoilPHOnTheRelativeYieldsOfWheatMaizeAndRiceUsingCombinedShortTermPHManipulationExperimentsAndLongTermObservations ;
    she:hasXAxis she:PH ;
    she:hasYAxis she:RelativeYield .

she:FitMaize a skos:Concept ;
    skos:prefLabel "fit maize" ;
    she:isFittedCurveFor she:Maize .

she:FitRice a skos:Concept ;
    skos:prefLabel "fit rice" ;
    she:isFittedCurveFor she:Rice .

she:FitWheat a skos:Concept ;
    skos:prefLabel "fit wheat" ;
    she:isFittedCurveFor she:Wheat .

she:ImpactOfSoilPHOnTheRelativeYieldsOfWheatMaizeAndRiceUsingCombinedShortTermPHManipulationExperimentsAndLongTermObservations a skos:Concept ;
    skos:prefLabel "impact of soil ph on the relative yields of wheat, maize and rice using combined short-term ph manipulation experiments and long-term observations" ;
    she:concernsCrop she:Maize,
        she:Rice,
        she:Wheat ;
    she:describesRelationshipBetween she:PH,
        she:RelativeYield .

she:PH a skos:Concept ;
    skos:prefLabel "ph" .

she:RelativeYield a skos:Concept ;
    skos:prefLabel "relative yield" .

she:Maize a skos:Concept ;
    skos:prefLabel "maize" .

she:Rice a skos:Concept ;
    skos:prefLabel "rice" .

she:Wheat a skos:Concept ;
    skos:prefLabel "wheat" .

