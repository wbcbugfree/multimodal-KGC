@prefix she: <https://soilwise-he.github.io/soil-health#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

she:Figure41 a skos:Concept ;
    skos:prefLabel "figure 4.1" ;
    skos:note "impact of soil ph on the relative yields of wheat, maize and rice using combined short-term ph manipulation experiments and long-term observations" ;
    she:adaptedFrom she:ZhuEtAl2020 ;
    skos:narrower she:SoilPH,
                  she:RelativeYield,
                  she:ExperimentalMethodology .

she:SoilPH a skos:Concept ;
    skos:prefLabel "soil ph" ;
    she:hasSymbol "pH" ;
    she:affects she:RelativeYield .

she:RelativeYield a skos:Concept ;
    skos:prefLabel "relative yield" ;
    skos:narrower she:Rice,
                  she:Wheat,
                  she:Maize .

she:Rice a skos:Concept ;
    skos:prefLabel "rice" ;
    she:hasFitCurve she:FitRice .

she:Wheat a skos:Concept ;
    skos:prefLabel "wheat" ;
    she:hasFitCurve she:FitWheat .

she:Maize a skos:Concept ;
    skos:prefLabel "maize" ;
    she:hasFitCurve she:FitMaize .

she:FitRice a skos:Concept ;
    skos:prefLabel "fit rice" .

she:FitWheat a skos:Concept ;
    skos:prefLabel "fit wheat" .

she:FitMaize a skos:Concept ;
    skos:prefLabel "fit maize" .

she:ExperimentalMethodology a skos:Concept ;
    skos:prefLabel "experimental methodology" ;
    skos:narrower she:ShortTermPHManipulationExperiments,
                  she:LongTermObservations .

she:ShortTermPHManipulationExperiments a skos:Concept ;
    skos:prefLabel "short-term ph manipulation experiments" .

she:LongTermObservations a skos:Concept ;
    skos:prefLabel "long-term observations" .

she:ZhuEtAl2020 a skos:Concept ;
    skos:prefLabel "zhu et al. (2020)" .
