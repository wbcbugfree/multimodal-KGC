@prefix she: <https://soilwise-he.github.io/soil-health#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

she:Table2_6 a skos:Concept ;
    skos:prefLabel "table 2.6" ;
    skos:definition "site-specific lower soc benchmarks for german agricultural soils across different strata" ;
    skos:note "source: compiled from drexler et al. (2002)." ;
    skos:narrower she:ArableSoil,
                  she:PermanentGrassland,
                  she:Texture .

she:ArableSoil a skos:Concept ;
    skos:prefLabel "arable soil" ;
    skos:narrower she:ArableLowMAP,
                  she:ArableHighMAP .

she:PermanentGrassland a skos:Concept ;
    skos:prefLabel "permanent grassland" ;
    skos:narrower she:GrasslandLowMAP,
                  she:GrasslandHighMAP .

she:MeanAnnualPrecipitation a skos:Concept ;
    skos:prefLabel "mean annual precipitation" ;
    she:hasAbbreviation "MAP" ;
    skos:note "unit: mm" .

she:ArableLowMAP a skos:Concept ;
    skos:prefLabel "low map" ;
    skos:definition "<700" ;
    skos:related she:MeanAnnualPrecipitation .

she:ArableHighMAP a skos:Concept ;
    skos:prefLabel "high map" ;
    skos:definition ">700" ;
    skos:related she:MeanAnnualPrecipitation .

she:GrasslandLowMAP a skos:Concept ;
    skos:prefLabel "low map" ;
    skos:definition "<650" ;
    skos:related she:MeanAnnualPrecipitation .

she:GrasslandHighMAP a skos:Concept ;
    skos:prefLabel "high map" ;
    skos:definition ">650" ;
    skos:related she:MeanAnnualPrecipitation .

she:Texture a skos:Concept ;
    skos:prefLabel "texture" ;
    skos:narrower she:Light,
                  she:Medium,
                  she:MediumII,
                  she:HeavyI,
                  she:HeavyII .

she:Light a skos:Concept ;
    skos:prefLabel "light" ;
    skos:note "<12% clay, <50% silt" .

she:Medium a skos:Concept ;
    skos:prefLabel "medium" ;
    skos:altLabel "medium i" ;
    skos:note "12-17% clay, <50% silt" .

she:MediumII a skos:Concept ;
    skos:prefLabel "medium ii" ;
    skos:note "17-25% clay, <50% silt" .

she:HeavyI a skos:Concept ;
    skos:prefLabel "heavy i" ;
    skos:note "25-35% clay" .

she:HeavyII a skos:Concept ;
    skos:prefLabel "heavy ii" ;
    skos:note ">35% clay" .

she:LowerSOCBenchmark a skos:Concept ;
    skos:prefLabel "lower soc benchmark" .

she:Light she:hasLowerSOCBenchmark [
    she:underCondition she:ArableLowMAP ;
    she:hasValue "0.7"
] ;
she:hasLowerSOCBenchmark [
    she:underCondition she:ArableHighMAP ;
    she:hasValue "0.9"
] ;
she:hasLowerSOCBenchmark [
    she:underCondition she:GrasslandLowMAP ;
    she:hasValue "1.4"
] ;
she:hasLowerSOCBenchmark [
    she:underCondition she:GrasslandHighMAP ;
    she:hasValue "2.0"
] .

she:Medium she:hasLowerSOCBenchmark [
    she:underCondition she:ArableLowMAP ;
    she:hasValue "1.0"
] ;
she:hasLowerSOCBenchmark [
    she:underCondition she:ArableHighMAP ;
    she:hasValue "1.1"
] ;
she:hasLowerSOCBenchmark [
    she:underCondition she:GrasslandLowMAP ;
    she:hasValue "2.3"
] ;
she:hasLowerSOCBenchmark [
    she:underCondition she:GrasslandHighMAP ;
    she:hasValue "3.0"
] .

she:MediumII she:hasLowerSOCBenchmark [
    she:underCondition she:ArableLowMAP ;
    she:hasValue "1.1"
] ;
she:hasLowerSOCBenchmark [
    she:underCondition she:ArableHighMAP ;
    she:hasValue "1.4"
] ;
she:hasLowerSOCBenchmark [
    she:underCondition she:GrasslandLowMAP ;
    she:hasValue "2.7"
] ;
she:hasLowerSOCBenchmark [
    she:underCondition she:GrasslandHighMAP ;
    she:hasValue "3.1"
] .

she:HeavyI she:hasLowerSOCBenchmark [
    she:underCondition she:ArableLowMAP ;
    she:hasValue "1.2"
] ;
she:hasLowerSOCBenchmark [
    she:underCondition she:ArableHighMAP ;
    she:hasValue "1.4"
] ;
she:hasLowerSOCBenchmark [
    she:underCondition she:GrasslandLowMAP ;
    she:hasValue "3.3"
] ;
she:hasLowerSOCBenchmark [
    she:underCondition she:GrasslandHighMAP ;
    she:hasValue "3.7"
] .

she:HeavyII she:hasLowerSOCBenchmark [
    she:underCondition she:ArableLowMAP ;
    she:hasValue "1.5"
] ;
she:hasLowerSOCBenchmark [
    she:underCondition she:ArableHighMAP ;
    she:hasValue "2.0"
] ;
she:hasLowerSOCBenchmark [
    she:underCondition she:GrasslandLowMAP ;
    she:hasValue "3.7"
] ;
she:hasLowerSOCBenchmark [
    she:underCondition she:GrasslandHighMAP ;
    she:hasValue "4.3"
] .
