@prefix she: <https://soilwise-he.github.io/soil-health#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

she:SoilRelatedPolicyObjectivesAndTargets a skos:Concept ;
    skos:prefLabel "soil-related policy objectives and targets at eu and global levels (binding and incentive-based non-binding policies and measures) (cont.)" ;
    skos:narrower she:ZeroPollutionActionPlanForAirSoilAndWater,
                  she:EuSoilStrategy2030 ;
    skos:note "(a) Ecosystem monitoring under Article 9 and Annex V of the NEC Directive. The extent of the impacts of air pollution on ecosystems in the EU is based on the exceedance of critical loads and levels for sulphur, nitrogen and ozone. The definition of thresholds is largely based on the Working Group on Effects under the Gothenburg Protocol to the Convention on Long-range Transboundary Air Pollution, including international cooperative programmes on forests, vegetation and integrated monitoring." ;
    skos:note "(b) Including (1) 'A clean planet for all' (EC, 2018), followed by the long-term low greenhouse gas emission development strategy (EC, 2020k), (2) the circular economy action plan for a clean and competitive Europe (EC, 2020l), and (3) new strategies under the European Green Deal (biodiversity strategy 2030, farm to fork strategy, zero pollution action plan)." .

she:ZeroPollutionActionPlanForAirSoilAndWater a skos:Concept ;
    skos:prefLabel "zero pollution action plan for air, soil and water (ec, 2021c)" ;
    she:hasRelevantPolicyObjective she:ZeroPollutionAmbition,
                                   she:MonitorReportPreventRemedyPollution,
                                   she:ProposeNewLegislation,
                                   she:FacilitateSoilPollutionRemediation .

she:ZeroPollutionAmbition a skos:Concept ;
    skos:prefLabel "a zero pollution ambition for a toxin-free environment, including for air, water and soil" .

she:MonitorReportPreventRemedyPollution a skos:Concept ;
    skos:prefLabel "to better monitor, report, prevent and remedy pollution from air, water, soil and consumer products to levels that are no longer harmful to human health and the environment" .

she:ProposeNewLegislation a skos:Concept ;
    skos:prefLabel "to propose new legislation covering significant pollution sources, which are not yet addressed by other policies, strategies and protocols" .

she:FacilitateSoilPollutionRemediation a skos:Concept ;
    skos:prefLabel "to facilitate remediation of soil pollution via (1) a monitoring framework on the state of pollution and (2) an outlook report, including a specific assessment of the evolution of human health and environmental impacts" .

she:EuSoilStrategy2030 a skos:Concept ;
    skos:prefLabel "eu soil strategy 2030 (ec, 2021e)" ;
    she:hasRelevantPolicyObjective she:HealthyConditionBy2050,
                                   she:CombatDesertificationAndRestoreEcosystems,
                                   she:ClimateNeutralityAndPollutionImpactReduction,
                                   she:ProgressInContaminatedSitesManagement .

she:HealthyConditionBy2050 a skos:Concept ;
    skos:prefLabel "by 2050, all eu soil ecosystems are in healthy condition and are thus more resilient" .

she:CombatDesertificationAndRestoreEcosystems a skos:Concept ;
    skos:prefLabel "to combat desertification and to achieve no net land take, to restore degraded ecosystems including soils," .

she:ClimateNeutralityAndPollutionImpactReduction a skos:Concept ;
    skos:prefLabel "to contribute to (1) land-based climate neutrality by 2035, and (2) reducing the impact of soil pollution (on ecosystems, waters, human health)" .

she:ProgressInContaminatedSitesManagement a skos:Concept ;
    skos:prefLabel "to achieve progress in the management of contaminated sites" .
