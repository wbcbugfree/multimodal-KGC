@prefix she: <https://soilwise-he.github.io/soil-health#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

she:ConsiderationOfCountryAndSiteSpecificConditions a skos:Concept ;
    skos:broader she:RiskAssessmentTool ;
    skos:prefLabel "consideration of country- and site-specific conditions" ;
    she:hasComponent she:GeographicalConditions,
        she:HistoryOfLandManagementNationalLegalConditions,
        she:LocalManagement .

she:EcologicalRiskAssessment a skos:Concept ;
    skos:broader she:RiskAssessmentTool ;
    skos:prefLabel "ecological risk assessment" ;
    she:hasComponent she:DatabaseWithPollutantCompoundCharacteristics,
        she:DeterminationOfCompoundSpecificBioavailableFractions,
        she:SpeciesSensitivityDistribution .

she:EndpointSpecificRiskAssessmentTools a skos:Concept ;
    skos:broader she:RiskAssessmentTool ;
    skos:prefLabel "endpoint-specific risk assessment tools" ;
    she:hasComponent she:DescriptionOfRelevantPathwayAndModelsNeededToDescribeTheseToPredictFlowsOfPollutantsToEndpointsConsidered,
        she:RelevantEuWideCriticalLimitsUsedInSpecificEndpointsConsidered .

she:HumanHealthRiskAssessment a skos:Concept ;
    skos:broader she:RiskAssessmentTool ;
    skos:prefLabel "human health risk assessment" ;
    she:hasComponent she:DailyInhalationRates,
        she:ExamplesAverageAmountOfSoilIngestedDailyByChildrenBierkensEtAl2011DermalUptakeFromSoilMaterialModels,
        she:TolerableExposure .

she:DailyInhalationRates a skos:Concept ;
    skos:broader she:StandardisedTools ;
    skos:prefLabel "daily inhalation rates" .

she:DatabaseWithPollutantCompoundCharacteristics a skos:Concept ;
    skos:broader she:StandardisedTools ;
    skos:prefLabel "database with pollutant/compound characteristics (e.g. water solubility, vapour pressure, water-octanol partition coefficients)" .

she:DescriptionOfRelevantPathwayAndModelsNeededToDescribeTheseToPredictFlowsOfPollutantsToEndpointsConsidered a skos:Concept ;
    skos:broader she:StandardisedTools ;
    skos:prefLabel "description of relevant pathway and models needed to describe these to predict flows of pollutants to endpoints considered" .

she:DeterminationOfCompoundSpecificBioavailableFractions a skos:Concept ;
    skos:broader she:StandardisedTools ;
    skos:prefLabel "determination of compound-specific bioavailable fractions (e.g. correction factors for the difference between intake and uptake of metals in the human body)" .

she:ExamplesAverageAmountOfSoilIngestedDailyByChildrenBierkensEtAl2011DermalUptakeFromSoilMaterialModels a skos:Concept ;
    skos:broader she:StandardisedTools ;
    skos:prefLabel "examples: average amount of soil ingested daily by children (bierkens et al., 2011); dermal uptake from soil material models" .

she:GeographicalConditions a skos:Concept ;
    skos:broader she:FlexibleTools ;
    skos:prefLabel "geographical conditions, e.g. for vapour intrusion models, which are dependent on soil type and groundwater depth" .

she:HistoryOfLandManagementNationalLegalConditions a skos:Concept ;
    skos:broader she:FlexibleTools ;
    skos:prefLabel "history of land management; national legal conditions" .

she:LocalManagement a skos:Concept ;
    skos:broader she:FlexibleTools ;
    skos:prefLabel "local management, e.g. home-grown vegetable consumption, food consumption data" .

she:RelevantEuWideCriticalLimitsUsedInSpecificEndpointsConsidered a skos:Concept ;
    skos:broader she:StandardisedTools ;
    skos:prefLabel "relevant eu-wide critical limits used in specific endpoints considered (e.g. critical limits in food, surface water or soil pore water concentrations)" .

she:SpeciesSensitivityDistribution a skos:Concept ;
    skos:broader she:StandardisedTools ;
    skos:definition "the species sensitivity distribution (ssd) is the empirical relation between soil concentration and fraction of species affected. the ssd gives the corresponding risk limit that can be used as an ecologically based soil health standard (swartjes et al., 2009)." ;
    skos:prefLabel "species sensitivity distribution (a) to determine ecologically-based soil health standards" .

she:TolerableExposure a skos:Concept ;
    skos:broader she:StandardisedTools ;
    skos:prefLabel "tolerable exposure (reference dose or tolerable daily intake, which can be similar for a defined sensitive group of people); risk per unit of exposure" .

she:ComponentToBeInternationallyStandardisedAgreed a skos:Concept ;
    skos:broader she:Table510DesignOfAEuropeanToolboxForStimulatingConvergenceInRiskBasedLandManagementInTheEUMemberStates ;
    skos:prefLabel "component to be internationally standardised/agreed" .

she:Table510DesignOfAEuropeanToolboxForStimulatingConvergenceInRiskBasedLandManagementInTheEUMemberStates a skos:Concept ;
    skos:prefLabel "table 5.10 design of a european toolbox for stimulating convergence in risk-based land management in the eu member states" .

she:FlexibleTools a skos:Concept ;
    skos:broader she:ComponentToBeInternationallyStandardisedAgreed ;
    skos:prefLabel "2. flexible tools" .

she:RiskAssessmentTool a skos:Concept ;
    skos:broader she:Table510DesignOfAEuropeanToolboxForStimulatingConvergenceInRiskBasedLandManagementInTheEUMemberStates ;
    skos:prefLabel "risk assessment tool" .

she:StandardisedTools a skos:Concept ;
    skos:broader she:ComponentToBeInternationallyStandardisedAgreed ;
    skos:prefLabel "1. standardised tools" .

