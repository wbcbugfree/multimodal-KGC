@prefix she: <https://soilwise-he.github.io/soil-health#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

she:SOMFractionsPoolsInSoils a skos:Concept ;
    skos:prefLabel "som fractions/pools in soils" ;
    skos:note "Sources: Skjemstad et al. (2004); Rodionov et al. (2010); Gobin et al. (2011); Cotrufo et al. (2019); Lavallee et al. (2019)." ;
    skos:narrower she:MicrobialBiomassC,
                  she:POM,
                  she:MAOM,
                  she:InertOrganicMatterBlackCarbon .

she:OrganicMatterFractionPool a skos:Concept ;
    skos:prefLabel "organic matter fraction/pool" ;
    skos:narrower she:MicrobialBiomassC,
                  she:POM,
                  she:MAOM,
                  she:InertOrganicMatterBlackCarbon .

she:ApproximateShareOfTotalSOM a skos:Concept ;
    skos:prefLabel "approximate share of total som" .

she:CharacteristicsOfPool a skos:Concept ;
    skos:prefLabel "characteristics of pool" .

she:MicrobialBiomassC a skos:Concept ;
    skos:prefLabel "microbial biomass c (bacteria, fungi)" ;
    she:hasApproximateShare "1-5%" ;
    she:hasCharacteristics "Labile, active" .

she:POM a skos:Concept ;
    skos:prefLabel "pom" ;
    she:hasAbbreviation "POM" ;
    skos:definition "It can be further subdivided into freshly added plant and animal residues, usually coarse POM with a low degree of decomposition (e.g. >250µm), and partially decomposed residues, frequently finer sized" ;
    she:hasApproximateShare "5-25%" ;
    she:hasCharacteristics "Labile, active" .

she:MAOM a skos:Concept ;
    skos:prefLabel "maom" ;
    she:hasAbbreviation "MAOM" ;
    skos:definition "largely consisting of microbial necromass and other adsorbed organic soil constituents" ;
    she:hasApproximateShare "50-75%" ;
    she:hasCharacteristics "Stable, activity level depends on degree of organo-mineral complexation" .

she:InertOrganicMatterBlackCarbon a skos:Concept ;
    skos:prefLabel "inert organic matter, black carbon" ;
    she:hasApproximateShare "5-20% or more" ;
    she:hasCharacteristics "Constant, passive" .
