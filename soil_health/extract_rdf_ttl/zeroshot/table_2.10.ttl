@prefix she: <https://soilwise-he.github.io/soil-health#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

she:DefinitionOfSomThresholdsDerivedFromAFarmerQuestionnaire a skos:Concept ;
    skos:narrower she:Threshold1,
        she:Threshold2 ;
    skos:prefLabel "definition of som thresholds derived from a farmer questionnaire" ;
    she:elaboratedBasedOn she:HijbeekEtAl2017B .

she:AboveThisThresholdNoFarmersAreExpectedToBeDissatisfiedWithTheirSomContent a skos:Concept ;
    skos:prefLabel "above this threshold, no farmers are expected to be dissatisfied with their som content" .

she:BelowThisThresholdValueNoFarmersAreExpectedToBeSatisfiedWithTheirSomContent a skos:Concept ;
    skos:prefLabel "below this threshold value, no farmers are expected to be satisfied with their som content" .

she:Concept11PercentOfTheEuropeanCroplandAreaIsConcernedInParticularNorthernFrance a skos:Concept ;
    skos:prefLabel "1.1% of the european cropland area is concerned (in particular northern france)" ;
    she:hasSourceForAreaEstimate she:DeBrogniezEtAl2015 .

she:Concept143PercentOfTheCroplandAreaMostlyCentralEasternEuropeAndSouthernEurope a skos:Concept ;
    skos:prefLabel "14.3% of the cropland area (mostly central/eastern europe and southern europe)" ;
    she:hasSourceForAreaEstimate she:DeBrogniezEtAl2015 .

she:HijbeekEtAl2017B a skos:Concept ;
    skos:prefLabel "hijbeek et al. (2017b)" .

she:LowerEndOfSomValueRange10ThPercentileAtWhichFarmersJudgeTheirCurrentSomContentSufficient a skos:Concept ;
    skos:prefLabel "lower end of som value range (10th percentile) at which farmers judge their current som content sufficient" .

she:Threshold1 a skos:Concept ;
    skos:prefLabel "threshold 1" ;
    she:hasAreaConcerned she:Concept11PercentOfTheEuropeanCroplandAreaIsConcernedInParticularNorthernFrance ;
    she:hasDescription she:LowerEndOfSomValueRange10ThPercentileAtWhichFarmersJudgeTheirCurrentSomContentSufficient ;
    she:hasImplication she:BelowThisThresholdValueNoFarmersAreExpectedToBeSatisfiedWithTheirSomContent .

she:Threshold2 a skos:Concept ;
    skos:prefLabel "threshold 2" ;
    she:hasAreaConcerned she:Concept143PercentOfTheCroplandAreaMostlyCentralEasternEuropeAndSouthernEurope ;
    she:hasDescription she:UpperEndOfTheRangeOfValues90ThPercentileAtWhichFarmersPerceiveAHighOrVeryHighDeficiencyOfSomContent ;
    she:hasImplication she:AboveThisThresholdNoFarmersAreExpectedToBeDissatisfiedWithTheirSomContent .

she:UpperEndOfTheRangeOfValues90ThPercentileAtWhichFarmersPerceiveAHighOrVeryHighDeficiencyOfSomContent a skos:Concept ;
    skos:prefLabel "upper end of the range of values (90th percentile) at which farmers perceive a high or very high deficiency of som content" .

she:DeBrogniezEtAl2015 a skos:Concept ;
    skos:prefLabel "de brogniez et al. (2015)" .

