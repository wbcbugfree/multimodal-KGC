@prefix she: <https://soilwise-he.github.io/soil-health#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

she:Note a skos:Concept ;
    skos:definition "benchmark sites reflect environmental and management conditions that are representative of a large area (van lynden et al., 2004). each site represents a very specific set of local conditions that are distinct from other environments. benchmark sites are particularly important to validate simulation models of indicators." ;
    skos:prefLabel "note" ;
    she:providesFurtherInformationOn she:BenchmarkValues .

she:OverviewOfSocThresholds a skos:Concept ;
    skos:narrower she:CommentsOnThePracticalityOfExistingThresholds,
        she:Definition,
        she:SectionOfReport ;
    skos:prefLabel "overview of soc thresholds" .

she:CommentsOnThePracticalityOfExistingThresholds a skos:Concept ;
    skos:prefLabel "comments on the practicality of existing thresholds" .

she:Concept25thPercentileOfSocValuesForPermanentGrassland a skos:Concept ;
    skos:prefLabel "25th percentile of soc values for permanent grassland (sparling et al., 2003)" ;
    she:hasComment "pragmatic, but selection of quartile thresholds requires validation" .

she:Definition a skos:Concept ;
    skos:narrower she:BenchmarkValues,
        she:Concept125th875thPercentilesAsUpperAndLowerBenchmarks,
        she:Concept25thPercentileOfSocValuesForPermanentGrassland,
        she:FarmersPerspectiveOnDeficientSoc,
        she:ModelledSocSteadyState25YearsForGrassland,
        she:NearNaturalForestSoils,
        she:OptimalSocContentForSoilFunctioning,
        she:ReciprocalSocSequestrationPotential,
        she:ReferenceValuesSiteSpecificTypicalSocOrSomValuesUnderCurrentManagement,
        she:SoilVulnerabilityIndexBasedOnTheSocClayRatio,
        she:ThresholdsFromLongTermFieldExperiments ;
    skos:prefLabel "definition" .

she:ModelledSocSteadyState25YearsForGrassland a skos:Concept ;
    skos:prefLabel "modelled soc steady state (25 years) for grassland (sparling et al., 2003)" ;
    she:hasComment "80% of steady state as target soc value" .

she:NearNaturalForestSoils a skos:Concept ;
    skos:prefLabel "near-natural forest soils (arshad and martin, 2002)" ;
    she:hasComment "problematic, because humus dynamics in cropland soils (low c input, high c turnover) are different from forest soils, leading to a lower level c equilibrium at cropland sites" .

she:ReferenceValuesSiteSpecificTypicalSocOrSomValuesUnderCurrentManagement a skos:Concept ;
    skos:prefLabel "reference values, site-specific, typical soc or som values under current management (arshad and martin, 2002)" ;
    she:hasComment "can be derived from existing monitoring systems for different land uses (e.g. as baseline); 50% of the standard deviation of the mean are 'low', indicating deficiency" .

she:Section232 a skos:Concept ;
    skos:narrower she:Concept125th875thPercentilesAsUpperAndLowerBenchmarks,
        she:OptimalSocContentForSoilFunctioning ;
    skos:prefLabel "2.3.2" .

she:Section233 a skos:Concept ;
    skos:narrower she:SoilVulnerabilityIndexBasedOnTheSocClayRatio ;
    skos:prefLabel "2.3.3" .

she:Section234 a skos:Concept ;
    skos:narrower she:ReciprocalSocSequestrationPotential ;
    skos:prefLabel "2.3.4" .

she:Section235 a skos:Concept ;
    skos:narrower she:ThresholdsFromLongTermFieldExperiments ;
    skos:prefLabel "2.3.5" .

she:Section236 a skos:Concept ;
    skos:narrower she:FarmersPerspectiveOnDeficientSoc ;
    skos:prefLabel "2.3.6" .

she:SectionOfReport a skos:Concept ;
    skos:narrower she:Section232,
        she:Section233,
        she:Section234,
        she:Section235,
        she:Section236 ;
    skos:prefLabel "section of report" .

she:BenchmarkValues a skos:Concept ;
    skos:prefLabel "benchmark values" ;
    she:hasComment "requires extensive monitoring evaluations and large data sets to sufficiently define site-specific value ranges" .

she:Concept125th875thPercentilesAsUpperAndLowerBenchmarks a skos:Concept ;
    skos:prefLabel "12.5th - 87.5th percentiles as upper and lower benchmarks" ;
    she:hasComment "example: drexler et al. (2022)" .

she:FarmersPerspectiveOnDeficientSoc a skos:Concept ;
    skos:prefLabel "farmers' perspective on deficient soc" ;
    she:hasComment "degraded soc levels according to farmers' perceptions (values for europe)" .

she:OptimalSocContentForSoilFunctioning a skos:Concept ;
    skos:prefLabel "optimal soc content for soil functioning (based on the role of soc in soil functional pedotransfer function, combined with data from long-term field experiments) (wessolek et al., 2008)" ;
    she:hasComment "if the inert stable soc fraction is known, körschens et al. (1998) suggest that optimal soc is c_inert + 0.62%(c_inert); a separate pedotransfer function is suggested to identify the inert fraction based on the clay content (körschens and schulz (1999); validity range by körschens (1999): 400-800mm precipitation and 6-10°c average annual temperature). note that c_inert as defined by körschens et al. (1998), residual c at fallow trials, differs from c_inert commonly used in soil modelling (e.g. black carbon; skjemstad et al., 2004)",
        "needs to be validated for clay-rich soils and climate regions outside central europe",
        "reference values for central european cropland soil and climatic conditions are available",
        "values are site specific and ensure sufficient yield while not limiting natural soil functions." .

she:ReciprocalSocSequestrationPotential a skos:Concept ;
    skos:prefLabel "reciprocal soc sequestration potential" ;
    she:hasComment "optimum soc content for the co₂ mitigation function of soils; target values represent soc equilibrium under long-term sustainable soil management" .

she:SoilVulnerabilityIndexBasedOnTheSocClayRatio a skos:Concept ;
    skos:prefLabel "soil vulnerability index based on the soc/clay ratio" ;
    she:hasComment "optimum soc content, defined as 10% of the observed clay content (piloted in switzerland, england and wales)" .

she:ThresholdsFromLongTermFieldExperiments a skos:Concept ;
    skos:prefLabel "thresholds from long-term field experiments" ;
    she:hasComment "minimum soc levels for sustainable crop production (values for central europe); values are conceptually comparable to optimal values (see section 2.3.2)" .

