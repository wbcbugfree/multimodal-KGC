@prefix she: <https://soilwise-he.github.io/soil-health#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

she:MatrixOfMeanSOCThresholds a skos:Concept ;
    skos:prefLabel "matrix of mean soc minimum and maximum thresholds for cropland soils (% soil mass)" ;
    skos:note "source: compiled from wessolek et al. (2008)." ;
    skos:narrower she:SoilTextureClass, she:ClimaticWaterBalanceSummer .

she:SoilTextureClass a skos:Concept ;
    skos:prefLabel "soil texture class" ;
    skos:narrower she:Sand, she:Silt, she:LoamAndClay .

she:Sand a skos:Concept ;
    skos:prefLabel "sand" ;
    she:hasSOCThreshold [
        she:atClimaticWaterBalance she:LessThanMinus100 ;
        she:hasMinSOCThreshold "0.5" ;
        she:hasMaxSOCThreshold "1.23"
    ] ;
    she:hasSOCThreshold [
        she:atClimaticWaterBalance she:Minus100To0 ;
        she:hasMinSOCThreshold "0.9" ;
        she:hasMaxSOCThreshold "1.73"
    ] ;
    she:hasSOCThreshold [
        she:atClimaticWaterBalance she:MoreThan0 ;
        she:hasMinSOCThreshold "1.2" ;
        she:hasMaxSOCThreshold "2.23"
    ] .

she:Silt a skos:Concept ;
    skos:prefLabel "silt" ;
    she:hasSOCThreshold [
        she:atClimaticWaterBalance she:LessThanMinus100 ;
        she:hasMinSOCThreshold "1.5" ;
        she:hasMaxSOCThreshold "2.53"
    ] ;
    she:hasSOCThreshold [
        she:atClimaticWaterBalance she:Minus100To0 ;
        she:hasMinSOCThreshold "1.0" ;
        she:hasMaxSOCThreshold "2.07"
    ] ;
    she:hasSOCThreshold [
        she:atClimaticWaterBalance she:MoreThan0 ;
        she:hasMinSOCThreshold "0.8" ;
        she:hasMaxSOCThreshold "1.59"
    ] .

she:LoamAndClay a skos:Concept ;
    skos:prefLabel "loam and clay" ;
    she:hasSOCThreshold [
        she:atClimaticWaterBalance she:LessThanMinus100 ;
        she:hasMinSOCThreshold "0.6" ;
        she:hasMaxSOCThreshold "1.47"
    ] ;
    she:hasSOCThreshold [
        she:atClimaticWaterBalance she:Minus100To0 ;
        she:hasMinSOCThreshold "0.9" ;
        she:hasMaxSOCThreshold "1.92"
    ] ;
    she:hasSOCThreshold [
        she:atClimaticWaterBalance she:MoreThan0 ;
        she:hasMinSOCThreshold "1.9" ;
        she:hasMaxSOCThreshold "3.23"
    ] .

she:ClimaticWaterBalanceSummer a skos:Concept ;
    skos:prefLabel "climatic water balance (mm) summer" ;
    skos:narrower she:LessThanMinus100, she:Minus100To0, she:MoreThan0 .

she:LessThanMinus100 a skos:Concept ;
    skos:prefLabel "less than -100" ;
    skos:narrower she:Min, she:Max .

she:Minus100To0 a skos:Concept ;
    skos:prefLabel "-100 to 0" ;
    skos:narrower she:Min, she:Max .

she:MoreThan0 a skos:Concept ;
    skos:prefLabel "more than 0" ;
    skos:narrower she:Min, she:Max .

she:Min a skos:Concept ;
    skos:prefLabel "min." .

she:Max a skos:Concept ;
    skos:prefLabel "max." .
