@prefix she: <https://soilwise-he.github.io/soil-health#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

she:AggregationOfSOCThresholdsForSoilGroups a skos:Concept ;
    skos:prefLabel "aggregation of soc thresholds for soil groups" ;
    skos:narrower she:SoilGroup,
                  she:ClayFineSiltPercentage,
                  she:KorschensEtAl1998,
                  she:BMLFUW2017MinimumSOCThreshold,
                  she:SOCClayRatio .

she:SoilGroup a skos:Concept ;
    skos:prefLabel "soil group" ;
    skos:narrower she:LightSoilGroup,
                  she:MediumSoilGroup,
                  she:HeavySoilGroup .

she:LightSoilGroup a skos:Concept ;
    skos:prefLabel "light (<15% clay)" ;
    skos:narrower she:Clay4To7,
                  she:Clay8To14 ;
    she:hasBMLFUWMinimumSOCThreshold "1.2" ;
    she:hasSOCRatio1_8Threshold "<1.9" ;
    she:hasSOCRatio1_10Threshold "<1.5" ;
    she:hasSOCRatio1_13Threshold "<1.2" .

she:MediumSoilGroup a skos:Concept ;
    skos:prefLabel "medium (15-25% clay)" ;
    skos:narrower she:Clay15To22,
                  she:Clay23To25 ;
    she:hasBMLFUWMinimumSOCThreshold "1.5" ;
    she:hasSOCRatio1_8Threshold "1.9-3.1" ;
    she:hasSOCRatio1_10Threshold "1.5-2.5" ;
    she:hasSOCRatio1_13Threshold "1.2-1.9" .

she:HeavySoilGroup a skos:Concept ;
    skos:prefLabel "heavy (>25% clay)" ;
    skos:narrower she:Clay25To32,
                  she:ClayAbove32 ;
    she:hasBMLFUWMinimumSOCThreshold "1.7" ;
    she:hasSOCRatio1_8Threshold ">3.1" ;
    she:hasSOCRatio1_10Threshold ">2.5" ;
    she:hasSOCRatio1_13Threshold ">1.9" .

she:ClayFineSiltPercentage a skos:Concept ;
    skos:prefLabel "clay/fine silt (%)" .

she:Clay4To7 a skos:Concept ;
    skos:prefLabel "4-7" ;
    she:hasSandySoilSOCThreshold "<0.6" .

she:Clay8To14 a skos:Concept ;
    skos:prefLabel "8-14" ;
    she:hasSandySoilSOCThreshold "0.6-0.9" ;
    she:hasLoamySoilSOCThreshold "0.8-0.9" .

she:Clay15To22 a skos:Concept ;
    skos:prefLabel "15-22" ;
    she:hasSandySoilSOCThreshold "0.9-1.2" ;
    she:hasLoamySoilSOCThreshold "1.0-1.3" .

she:Clay23To25 a skos:Concept ;
    skos:prefLabel "23-25" ;
    she:hasSandySoilSOCThreshold "1.3-1.6" ;
    she:hasLoamySoilSOCThreshold "1.3-1.5" .

she:Clay25To32 a skos:Concept ;
    skos:prefLabel "25-32" ;
    she:hasLoamySoilSOCThreshold "1.5-1.7" .

she:ClayAbove32 a skos:Concept ;
    skos:prefLabel ">32" ;
    she:hasLoamySoilSOCThreshold "1.7-2.0" .

she:KorschensEtAl1998 a skos:Concept ;
    skos:prefLabel "körschens et al. (1998)" ;
    skos:narrower she:SandySoils,
                  she:LoamySoils .

she:SandySoils a skos:Concept ;
    skos:prefLabel "sandy soils" .

she:LoamySoils a skos:Concept ;
    skos:prefLabel "loamy soils" .

she:BMLFUW2017MinimumSOCThreshold a skos:Concept ;
    skos:prefLabel "bmlfuw (2017) minimum soc threshold" .

she:SOCClayRatio a skos:Concept ;
    skos:prefLabel "soc/clay ratio" ;
    skos:narrower she:Ratio1_8,
                  she:Ratio1_10,
                  she:Ratio1_13 .

she:Ratio1_8 a skos:Concept ;
    skos:prefLabel "1/8" ;
    skos:note "optimum for good structural quality" .

she:Ratio1_10 a skos:Concept ;
    skos:prefLabel "1/10" ;
    skos:note "minimum desired soc level for farmers" .

she:Ratio1_13 a skos:Concept ;
    skos:prefLabel "1/13" ;
    skos:note "structural soil quality is unacceptable" .
