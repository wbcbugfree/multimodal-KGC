@prefix she: <https://soilwise-he.github.io/soil-health#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

she:CriticalLevelForCropYield a skos:Concept ;
    skos:prefLabel "critical level for crop yield" ;
    she:isACriticalLevelFor she:CropYield ;
    she:isDefinedBy she:SoilPFertilityStatus .

she:CriticalLevelForPLeachingPotential a skos:Concept ;
    skos:prefLabel "critical level for p leaching potential" ;
    she:isACriticalLevelFor she:PLeachingPotential ;
    she:isDefinedBy she:SoilPFertilityStatus .

she:RelationshipsBetweenCropYieldLeftYAxisAndPLeachingRiskRightYAxisAndSoilPFertilityStatus a skos:Concept ;
    skos:prefLabel "relationships between crop yield (left y-axis) and p leaching risk (right y-axis) and soil p fertility status" ;
    she:describesRelationshipBetween she:CropYield,
        she:PLeachingRisk,
        she:SoilPFertilityStatus .

she:PLeachingRisk a skos:Concept ;
    skos:prefLabel "p leaching risk" ;
    she:representsTheConceptOf she:PLeachingPotential ;
    she:variesWith she:SoilPFertilityStatus .

she:CropYield a skos:Concept ;
    skos:prefLabel "crop yield" ;
    she:variesWith she:SoilPFertilityStatus .

she:PLeachingPotential a skos:Concept ;
    skos:prefLabel "p leaching potential" .

she:SoilPFertilityStatus a skos:Concept ;
    skos:prefLabel "soil p fertility status" .

