@prefix she: <https://soilwise-he.github.io/soil-health#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

she:MonitoringBiologicalGroupsResultsFrenchSoilMonitoringNetwork a skos:Concept ;
    skos:prefLabel "monitoring biological groups: results from the french soil monitoring network" ;
    skos:narrower she:ParametersIndicators,
                  she:IndicatorValue,
                  she:SiteDensity,
                  she:Source .

she:ParametersIndicators a skos:Concept ;
    skos:prefLabel "parameters/indicators" ;
    skos:narrower she:AbundanceEarthwormsNematodesAcariBacterialCommunityMicrobialBiomassEarthwormSpeciesRichness,
                  she:MacroInvertebrateAbundanceCollembolanAbundanceRichnessNematodeRichness,
                  she:BiologicalSoilQualityIndexBasedOnSoilMacroInvertebrateCommunityPatterns,
                  she:EarthwormCommunityAndSpeciesAbundanceBiomassFunctionalStructureAndEcologicalTraits,
                  she:SoilMicrobialAbundanceAndDiversity .

she:IndicatorValue a skos:Concept ;
    skos:prefLabel "indicator value" ;
    skos:narrower she:MainLandUseGrasslandCroplandForest,
                  she:AgriculturalPractice,
                  she:MainLandUseDegreeSoilPollution,
                  she:MainLandUseAndOrAgriculturalPractices .

she:SiteDensity a skos:Concept ;
    skos:prefLabel "site density" .

she:Source a skos:Concept ;
    skos:prefLabel "source" ;
    skos:narrower she:CluzeauEtAl2012,
                  she:RuizEtAl2011,
                  she:PeresEtAl2011,
                  she:TerratEtAl2017 .

she:AbundanceEarthwormsNematodesAcariBacterialCommunityMicrobialBiomassEarthwormSpeciesRichness a skos:Concept ;
    skos:prefLabel "abundance of earthworms, nematodes, acari and the bacterial community, microbial biomass and earthworm species richness" ;
    she:hasIndicatorValue she:MainLandUseGrasslandCroplandForest ;
    she:hasSiteDensity "109" ;
    she:hasSource she:CluzeauEtAl2012 .

she:MacroInvertebrateAbundanceCollembolanAbundanceRichnessNematodeRichness a skos:Concept ;
    skos:prefLabel "macro-invertebrate abundance, collembolan abundance and richness, and nematode richness" ;
    she:hasIndicatorValue she:AgriculturalPractice ;
    she:hasSiteDensity "109" ;
    she:hasSource she:CluzeauEtAl2012 .

she:BiologicalSoilQualityIndexBasedOnSoilMacroInvertebrateCommunityPatterns a skos:Concept ;
    skos:prefLabel "biological soil quality index based on soil macro-invertebrate community patterns" ;
    she:hasIndicatorValue she:AgriculturalPractice ;
    she:hasSiteDensity "22" ;
    she:hasSource she:RuizEtAl2011 .

she:EarthwormCommunityAndSpeciesAbundanceBiomassFunctionalStructureAndEcologicalTraits a skos:Concept ;
    skos:prefLabel "earthworm community and species (abundance, biomass, functional structure and ecological traits)" ;
    she:hasIndicatorValue she:MainLandUseDegreeSoilPollution ;
    she:hasSiteDensity "13" ;
    she:hasSource she:PeresEtAl2011 .

she:SoilMicrobialAbundanceAndDiversity a skos:Concept ;
    skos:prefLabel "soil microbial abundance and diversity" ;
    she:hasIndicatorValue she:MainLandUseAndOrAgriculturalPractices ;
    she:hasSiteDensity ">1700" ;
    she:hasSource she:TerratEtAl2017 .

she:MainLandUseGrasslandCroplandForest a skos:Concept ;
    skos:prefLabel "main land use (grassland, cropland, forest)" .

she:AgriculturalPractice a skos:Concept ;
    skos:prefLabel "agricultural practice" .

she:MainLandUseDegreeSoilPollution a skos:Concept ;
    skos:prefLabel "main land use, degree of soil pollution" .

she:MainLandUseAndOrAgriculturalPractices a skos:Concept ;
    skos:prefLabel "main land use and/or agricultural practices" .

she:CluzeauEtAl2012 a skos:Concept ;
    skos:prefLabel "cluzeau et al. (2012)" .

she:RuizEtAl2011 a skos:Concept ;
    skos:prefLabel "ruiz et al. (2011)" .

she:PeresEtAl2011 a skos:Concept ;
    skos:prefLabel "pérès et al. (2011)" .

she:TerratEtAl2017 a skos:Concept ;
    skos:prefLabel "terrat et al. (2017)" .
