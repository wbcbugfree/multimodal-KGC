@prefix she: <https://soilwise-he.github.io/soil-health#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

she:Table6_3 a skos:Concept ;
    skos:prefLabel "table 6.3" ;
    skos:note "indicators proposed for soil biodiversity monitoring" ;
    skos:narrower she:Indicator,
                  she:CreamerEtAl2019,
                  she:HuberEtAl2008,
                  she:Breure2004 .

she:Indicator a skos:Concept ;
    skos:prefLabel "indicator" ;
    skos:narrower she:DiversityOfEarthworms,
                  she:DiversityOfCollembolans,
                  she:MicrobialBiomass,
                  she:DiversityOfNematodes,
                  she:SoilTexture,
                  she:BulkDensity,
                  she:GroundwaterTableDepth,
                  she:PH,
                  she:CNRatio,
                  she:NPRatio,
                  she:SoilOrganicMatter,
                  she:OrganicCarbonContent .

she:CreamerEtAl2019 a skos:Concept ;
    skos:prefLabel "creamer et al. (2019)" .

she:HuberEtAl2008 a skos:Concept ;
    skos:prefLabel "huber et al. (2008)" .

she:Breure2004 a skos:Concept ;
    skos:prefLabel "breure (2004)" .

she:DiversityOfEarthworms a skos:Concept ;
    skos:prefLabel "diversity of earthworms" ;
    she:isProposedBy she:CreamerEtAl2019,
                     she:HuberEtAl2008,
                     she:Breure2004 .

she:DiversityOfCollembolans a skos:Concept ;
    skos:prefLabel "diversity of collembolans" ;
    she:isProposedBy she:HuberEtAl2008 .

she:MicrobialBiomass a skos:Concept ;
    skos:prefLabel "microbial biomass" ;
    she:isProposedBy she:CreamerEtAl2019,
                     she:HuberEtAl2008,
                     she:Breure2004 .

she:DiversityOfNematodes a skos:Concept ;
    skos:prefLabel "diversity of nematodes" ;
    she:isProposedBy she:CreamerEtAl2019,
                     she:Breure2004 .

she:SoilTexture a skos:Concept ;
    skos:prefLabel "soil texture" ;
    she:isProposedBy she:CreamerEtAl2019 .

she:BulkDensity a skos:Concept ;
    skos:prefLabel "bulk density" ;
    she:isProposedBy she:CreamerEtAl2019 .

she:GroundwaterTableDepth a skos:Concept ;
    skos:prefLabel "groundwater table depth" ;
    she:isProposedBy she:CreamerEtAl2019 .

she:PH a skos:Concept ;
    skos:prefLabel "ph" ;
    she:hasSymbol "pH" ;
    she:isProposedBy she:CreamerEtAl2019 .

she:CNRatio a skos:Concept ;
    skos:prefLabel "c:n ratio" ;
    she:hasSymbol "C:N ratio" ;
    she:isProposedBy she:CreamerEtAl2019 .

she:NPRatio a skos:Concept ;
    skos:prefLabel "n:p ratio" ;
    she:hasSymbol "N:P ratio" ;
    she:isProposedBy she:CreamerEtAl2019 .

she:SoilOrganicMatter a skos:Concept ;
    skos:prefLabel "soil organic matter" ;
    she:isProposedBy she:CreamerEtAl2019 .

she:OrganicCarbonContent a skos:Concept ;
    skos:prefLabel "organic carbon content" ;
    she:isProposedBy she:CreamerEtAl2019 .
