@prefix she: <https://soilwise-he.github.io/soil-health#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

she:ConceptualOverviewOfSOCThresholdsAndCarbonSequestration a skos:Concept ;
    skos:prefLabel "conceptual overview of soc thresholds and carbon sequestration" ;
    skos:narrower she:SoilOrganicCarbon,
                  she:CarbonSequestration,
                  she:EcologicalTargets .

she:SoilOrganicCarbon a skos:Concept ;
    skos:prefLabel "soil organic carbon" ;
    she:hasAbbreviation "SOC" ;
    skos:narrower she:MaximumSOCPool,
                  she:OptimalSOCToFulfilSoilFunctions,
                  she:SOCNeededForOptimalYield,
                  she:SOCAtBusinessAsUsual,
                  she:SOCAtBusinessAsUsualPlusClimateChange,
                  she:BaselineDepletedSOCPool .

she:CarbonSequestration a skos:Concept ;
    skos:prefLabel "carbon sequestration" .

she:MaximumSOCPool a skos:Concept ;
    skos:prefLabel "maximum soc pool" ;
    skos:note "Under current climatic condition, no management" .

she:OptimalSOCToFulfilSoilFunctions a skos:Concept ;
    skos:prefLabel "optimal soc to fulfil soil functions" .

she:SOCNeededForOptimalYield a skos:Concept ;
    skos:prefLabel "soc needed for optimal yield" .

she:SOCAtBusinessAsUsual a skos:Concept ;
    skos:prefLabel "soc at business as usual" .

she:SOCAtBusinessAsUsualPlusClimateChange a skos:Concept ;
    skos:prefLabel "soc at business-as-usual + climate change" ;
    skos:note "Technically minimal SOC pool" .

she:BaselineDepletedSOCPool a skos:Concept ;
    skos:prefLabel "baseline depleted soc pool" .

she:IncentivesForSustainableSoilManagement a skos:Concept ;
    skos:prefLabel "incentives for sustainable soil management" ;
    she:affects she:SoilOrganicCarbon ;
    she:aimsAt she:OptimalSOCToFulfilSoilFunctions .

she:ImprovementsOfFertilisation a skos:Concept ;
    skos:prefLabel "improvements of fertilisation" ;
    she:affects she:SoilOrganicCarbon ;
    she:aimsAt she:SOCNeededForOptimalYield .

she:NoChange a skos:Concept ;
    skos:prefLabel "no change" .

she:Time a skos:Concept ;
    skos:prefLabel "time" .

she:EcologicalTargets a skos:Concept ;
    skos:prefLabel "ecological targets" ;
    skos:narrower she:TechnicalAchievableSOCSequestration,
                  she:EconomicalAchievableSOCSequestration,
                  she:HealthySoils,
                  she:FarmersPerceivedSOCDeficiency,
                  she:EcologicallyNeededSequestration .

she:TechnicalAchievableSOCSequestration a skos:Concept ;
    skos:prefLabel "technical achievable soc sequestration" ;
    she:relatedTo she:MaximumSOCPool .

she:EconomicalAchievableSOCSequestration a skos:Concept ;
    skos:prefLabel "economical achievable soc sequestration" ;
    she:relatedTo she:SOCNeededForOptimalYield,
                  she:SOCAtBusinessAsUsual .

she:HealthySoils a skos:Concept ;
    skos:prefLabel "healthy soils" ;
    she:relatedTo she:MaximumSOCPool,
                  she:OptimalSOCToFulfilSoilFunctions .

she:FarmersPerceivedSOCDeficiency a skos:Concept ;
    skos:prefLabel "farmers perceived soc deficiency" ;
    she:relatedTo she:SOCNeededForOptimalYield,
                  she:SOCAtBusinessAsUsual .

she:EcologicallyNeededSequestration a skos:Concept ;
    skos:prefLabel "ecologically needed sequestration" ;
    she:relatedTo she:OptimalSOCToFulfilSoilFunctions .
