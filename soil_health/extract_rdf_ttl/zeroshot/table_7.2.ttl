@prefix she: <https://soilwise-he.github.io/soil-health#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

she:SoilLossRatesArableLandEurope a skos:Concept ;
    skos:prefLabel "soil loss rates from different types of erosion on arable land in europe taken from studies at a continental scale" ;
    skos:narrower she:ErosionType,
                  she:Approach,
                  she:ReferencePeriod,
                  she:MeanSoilLossRateHeader,
                  she:ReferenceHeader .

she:ErosionType a skos:Concept ;
    skos:prefLabel "erosion type" ;
    skos:narrower she:SoilErosionByWater,
                  she:SoilErosionByWind,
                  she:GullyErosion,
                  she:TillageErosion,
                  she:SoilLossByCropHarvesting .

she:Approach a skos:Concept ;
    skos:prefLabel "approach" ;
    skos:narrower she:EmpiricalModelRUSLE2015,
                  she:UpscalingPlotData,
                  she:EmpiricalModelGISRWEQ,
                  she:ObservationsAndScreenInterpretation,
                  she:EmpiricalGISBasedModel,
                  she:UpscalingStudyResults .

she:ReferencePeriod a skos:Concept ;
    skos:prefLabel "reference period" .

she:MeanSoilLossRateHeader a skos:Concept ;
    skos:prefLabel "mean soil loss rate (arable land) (t/ha/year)" .

she:ReferenceHeader a skos:Concept ;
    skos:prefLabel "reference" .

she:SoilErosionByWater a skos:Concept ;
    skos:prefLabel "soil erosion by water" ;
    she:hasStudyResult [
        she:hasApproach she:EmpiricalModelRUSLE2015 ;
        she:hasReferencePeriod "2016" ;
        she:hasMeanSoilLossRate "2.65" ;
        she:hasReference "Panagos et al. (2020a)"
    ] , [
        she:hasApproach she:UpscalingPlotData ;
        she:hasMeanSoilLossRate "3.6" ;
        she:hasReference "Cerdan et al. (2010)"
    ] .

she:SoilErosionByWind a skos:Concept ;
    skos:prefLabel "soil erosion by wind" ;
    she:hasStudyResult [
        she:hasApproach she:EmpiricalModelGISRWEQ ;
        she:hasReferencePeriod "2001-2010" ;
        she:hasMeanSoilLossRate "0.53" ;
        she:hasReference "Borelli et al. (2017)"
    ] .

she:GullyErosion a skos:Concept ;
    skos:prefLabel "gully erosion" ;
    she:hasStudyResult [
        she:hasApproach she:ObservationsAndScreenInterpretation ;
        she:hasReferencePeriod "2018-" ;
        she:hasMeanSoilLossRate "unknown" ;
        she:hasReference "Borelli et al. (2022)"
    ] .

she:TillageErosion a skos:Concept ;
    skos:prefLabel "tillage erosion" ;
    she:hasStudyResult [
        she:hasApproach she:EmpiricalGISBasedModel ;
        she:hasReferencePeriod "2000" ;
        she:hasMeanSoilLossRate "3.3" ;
        she:hasReference "Van Oost (2009)"
    ] .

she:SoilLossByCropHarvesting a skos:Concept ;
    skos:prefLabel "soil loss by crop harvesting" ;
    she:hasStudyResult [
        she:hasApproach she:UpscalingStudyResults ;
        she:hasReferencePeriod "2000-2016" ;
        she:hasMeanSoilLossRate "0.134" ;
        skos:note "(a) Due to potato and sugar beet harvesting; recalculated for the total arable land area." ;
        she:hasReference "Panagos et al. (2019)"
    ] .

she:EmpiricalModelRUSLE2015 a skos:Concept ;
    skos:prefLabel "empirical model (rusle2015)" ;
    she:hasAbbreviation "RUSLE2015" .

she:UpscalingPlotData a skos:Concept ;
    skos:prefLabel "upscaling plot data" .

she:EmpiricalModelGISRWEQ a skos:Concept ;
    skos:prefLabel "empirical model (gis-rweq)" ;
    she:hasAbbreviation "GIS-RWEQ" .

she:ObservationsAndScreenInterpretation a skos:Concept ;
    skos:prefLabel "observations and screen interpretation" .

she:EmpiricalGISBasedModel a skos:Concept ;
    skos:prefLabel "empirical gis-based model" .

she:UpscalingStudyResults a skos:Concept ;
    skos:prefLabel "upscaling study results" .
