@prefix she: <https://soilwise-he.github.io/soil-health#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

she:SoilRelatedPolicyObjectivesAndTargetsAtEuAndGlobalLevels a skos:Concept ;
    skos:prefLabel "soil-related policy objectives and targets at eu and global levels" ;
    skos:note "binding and incentive-based non-binding policies and measures" ;
    skos:narrower she:WaterFrameworkDirective,
                  she:RoadmapForAResourceEfficientEurope,
                  she:NationalEmissionCeilingsDirective,
                  she:LulucfRegulation,
                  she:CapRegulationFinancingManagementMonitoring,
                  she:EighthEnvironmentActionProgramme2030,
                  she:BiodiversityStrategyTo2030,
                  she:FarmToForkStrategy .

she:WaterFrameworkDirective a skos:Concept ;
    skos:prefLabel "water framework directive (2000/60/ec)" ;
    she:hasRelevantObjective "Member States to produce river basin management plans, requiring the identification of point sources and their impacts" ;
    she:hasRelevantObjective "Member States to establish programmes of measures and implement 'basic' measures, including adapted agricultural production schemes to reduce nitrogen inputs to agricultural soils and as a consequence connected water bodies" .

she:RoadmapForAResourceEfficientEurope a skos:Concept ;
    skos:prefLabel "roadmap for a resource efficient europe (ec, 2011)" ;
    she:hasRelevantTarget "Soil erosion is reduced by 2050" ;
    she:hasRelevantTarget "Increase in soil organic matter between 2011 and 2050" ;
    she:hasRelevantTarget "By 2020 remedial work on contaminated sites well under way" ;
    she:hasRelevantTarget "Achieve no net land take by 2050" .

she:NationalEmissionCeilingsDirective a skos:Concept ;
    skos:prefLabel "national emission ceilings directive ((eu) 2016/2284)" ;
    skos:note "(a)" ;
    she:hasRelevantObjective "Air pollution and its impacts on ecosystems and biodiversity are further reduced with the long-term aim of not exceeding critical loads and levels (based on Seventh Environment Action Programme)" ;
    she:hasRelevantTarget "To reduce the ecosystem area subject to eutrophication by 35% by 2030, compared with 2005 (Clean air programme for Europe (EC, 2013))" ;
    she:hasRelevantTarget "To achieve national emission reduction targets for anthropogenic emissions" ;
    she:hasRelevantObjective "Member States to assess the impacts of air pollutants to sensitive receiving environments (natural and semi-natural habitats and forest ecosystems)" .

she:LulucfRegulation a skos:Concept ;
    skos:prefLabel "lulucf regulation ((eu) 2018/841)" ;
    she:hasRelevantTarget "To ensure the contribution of the LULUCF sector to the achievement of the EU's emission reduction target of at least 40% and to the long-term goal of the Paris Agreement in the period 2021-2030" ;
    she:hasRelevantObjective "Member States have binding commitments to compensate CO2 emissions from the land use sector; land management practices that increase soil organic carbon stocks are accountable compensation measures" .

she:CapRegulationFinancingManagementMonitoring a skos:Concept ;
    skos:prefLabel "regulation (eu) no 1306/2013 on the financing, management and monitoring of the cap 2021-2027" ;
    she:hasRelevantObjective "CAP post-2020 continues to promote practices beneficial to the climate and the environment; introduces eco-schemes for additional measures. Impact indicators indicate the increase in soil carbon, reduction in soil erosion and nutrient (N) loss; a result indicator covers practices targeted to improve soils" ;
    she:hasRelevantObjective "GAECs as conditional standards remain valid in the future CAP, including GAECs in support of soil protection and quality: GAEC 6 'Tillage management'; GAEC 7 'No bare soil'; GAEC 8 'Crop rotation'" ;
    skos:narrower she:Gaec6, she:Gaec7, she:Gaec8 .

she:Gaec6 a skos:Concept ;
    skos:prefLabel "gaec 6 'tillage management'" .

she:Gaec7 a skos:Concept ;
    skos:prefLabel "gaec 7 'no bare soil'" .

she:Gaec8 a skos:Concept ;
    skos:prefLabel "gaec 8 'crop rotation'" .

she:EighthEnvironmentActionProgramme2030 a skos:Concept ;
    skos:prefLabel "eighth environment action programme 2030 (ec, 2020b)" ;
    she:hasRelevantObjective "Protecting, preserving and restoring biodiversity and enhancing natural capital, notably air, water, soil, and forest, freshwater, wetland and marine ecosystems" ;
    she:hasRelevantObjective "Umbrella programme (b) against biodiversity loss and ecosystem services degradation, climate change and its impacts, and unsustainable use of resources, pollution, and associated risks to human health" .

she:BiodiversityStrategyTo2030 a skos:Concept ;
    skos:prefLabel "biodiversity strategy to 2030 (ec, 2020e)" ;
    she:hasRelevantTarget "Legally protect a minimum of 30% of the EU's land area" ;
    she:hasRelevantTarget she:OrganicFarmingTarget2030 ;
    she:hasRelevantTarget "At least 10% of the agricultural area is under high-diversity landscape features" ;
    she:hasRelevantTarget "The risk and use of chemical pesticides is reduced by 50%, and the use of more hazardous pesticides is reduced by 50%" .

she:FarmToForkStrategy a skos:Concept ;
    skos:prefLabel "farm to fork strategy (ec, 2020f)" ;
    she:hasRelevantTarget "To reduce the overall use and risk of chemical pesticides by 50% and the use of more hazardous pesticides by 50% by 2030" ;
    she:hasRelevantTarget "To reduce the use of fertilisers by 2030 by at least 20%" ;
    she:hasRelevantTarget she:OrganicFarmingTarget2030 .

she:OrganicFarmingTarget2030 a skos:Concept ;
    skos:prefLabel "at least 25% of the eu's agricultural land must be organically farmed by 2030" .
