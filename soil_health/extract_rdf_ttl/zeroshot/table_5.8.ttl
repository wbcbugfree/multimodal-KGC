she:Table5_8 a skos:Concept ;
    skos:prefLabel "screening values for potentially unacceptable risk (residential soil use) for organic contaminants (mg/kg)" ;
    skos:note "B, Brussels, F, Flanders; W, Wallonia; PCDD, polychlorinated dibenzodioxins; PCDF, polychlorinated dibenzofurans. For countries not represented, see also note for Figure 5-7. Compiled from Carlon et al. (2007)." ;
    skos:narrower she:CompoundHeader, she:CountryRegionHeader .

she:CountryRegionHeader a skos:Concept ;
    skos:prefLabel "country/region" ;
