@prefix she: <https://soilwise-he.github.io/soil-health#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

she:ImpactOfSoilPHOnRelativeYields a skos:Concept ;
    skos:prefLabel "impact of soil ph on the relative yields of wheat, maize and rice using combined short-term ph manipulation experiments and long-term observations" ;
    skos:note "Source: Adapted after Zhu et al. (2020)." ;
    skos:narrower she:SoilPH,
                  she:RelativeYield,
                  she:Rice,
                  she:Wheat,
                  she:Maize,
                  she:FitRice,
                  she:FitWheat,
                  she:FitMaize,
                  she:ShortTermPHManipulationExperiments,
                  she:LongTermObservations .

she:SoilPH a skos:Concept ;
    skos:prefLabel "soil ph" ;
    she:hasAbbreviation "pH" ;
    she:impacts she:RelativeYield .

she:RelativeYield a skos:Concept ;
    skos:prefLabel "relative yield" .

she:Rice a skos:Concept ;
    skos:prefLabel "rice" ;
    she:hasRelativeYieldImpactedBy she:SoilPH ;
    she:studiedUsing she:ShortTermPHManipulationExperiments,
                     she:LongTermObservations ;
    skos:related she:FitRice .

she:Wheat a skos:Concept ;
    skos:prefLabel "wheat" ;
    she:hasRelativeYieldImpactedBy she:SoilPH ;
    she:studiedUsing she:ShortTermPHManipulationExperiments,
                     she:LongTermObservations ;
    skos:related she:FitWheat .

she:Maize a skos:Concept ;
    skos:prefLabel "maize" ;
    she:hasRelativeYieldImpactedBy she:SoilPH ;
    she:studiedUsing she:ShortTermPHManipulationExperiments,
                     she:LongTermObservations ;
    skos:related she:FitMaize .

she:FitRice a skos:Concept ;
    skos:prefLabel "fit rice" .

she:FitWheat a skos:Concept ;
    skos:prefLabel "fit wheat" .

she:FitMaize a skos:Concept ;
    skos:prefLabel "fit maize" .

she:ShortTermPHManipulationExperiments a skos:Concept ;
    skos:prefLabel "short-term ph manipulation experiments" .

she:LongTermObservations a skos:Concept ;
    skos:prefLabel "long-term observations" .
