@prefix she: <https://soilwise-he.github.io/soil-health#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

she:ThresholdsForEnvironmentalVariablesForSoilBiodiversity a skos:Concept ;
    skos:prefLabel "thresholds for environmental variables that may have a strong effect on soil biodiversity" ;
    skos:note "source: compiled from aksoy et al. (2017)." ;
    skos:narrower she:Variable,
                  she:ClassesOfParametersForScoringSoilBiodiversityPotential .

she:SoilBiodiversity a skos:Concept ;
    skos:prefLabel "soil biodiversity" .

she:Variable a skos:Concept ;
    skos:prefLabel "variable" ;
    skos:narrower she:PH,
                  she:SoilTexturalClass,
                  she:OrganicMatter,
                  she:PotentialEvapotranspiration,
                  she:AnnualAverageTemperature,
                  she:SoilBiomassProductivity,
                  she:LandUseLandCover .

she:ClassesOfParametersForScoringSoilBiodiversityPotential a skos:Concept ;
    skos:prefLabel "classes of parameters for scoring soil biodiversity potential" .

she:PH a skos:Concept ;
    skos:prefLabel "ph" ;
    skos:broader she:Variable ;
    she:mayHaveStrongEffectOn she:SoilBiodiversity ;
    skos:narrower she:LessThan4,
                  she:Between4And5Point2,
                  she:Between5Point2And8Point2,
                  she:GreaterThan8Point2 .

she:SoilTexturalClass a skos:Concept ;
    skos:prefLabel "soil textural class" ;
    skos:broader she:Variable ;
    she:mayHaveStrongEffectOn she:SoilBiodiversity ;
    skos:narrower she:Coarse,
                  she:Medium,
                  she:MediumFine,
                  she:Fine .

she:OrganicMatter a skos:Concept ;
    skos:prefLabel "organic matter" ;
    she:hasSymbol "%" ;
    skos:broader she:Variable ;
    she:mayHaveStrongEffectOn she:SoilBiodiversity ;
    skos:narrower she:LessThan1,
                  she:Between1And2,
                  she:Between2And4,
                  she:GreaterThan4 .

she:PotentialEvapotranspiration a skos:Concept ;
    skos:prefLabel "potential evapotranspiration" ;
    she:hasSymbol "mm" ;
    skos:broader she:Variable ;
    she:mayHaveStrongEffectOn she:SoilBiodiversity ;
    skos:narrower she:LessThanMinus500,
                  she:BetweenMinus500And500,
                  she:GreaterThan500 .

she:AnnualAverageTemperature a skos:Concept ;
    skos:prefLabel "annual average temperature" ;
    she:hasSymbol "°c" ;
    skos:broader she:Variable ;
    she:mayHaveStrongEffectOn she:SoilBiodiversity ;
    skos:narrower she:LessThan5,
                  she:Between5And20,
                  she:GreaterThan20 .

she:SoilBiomassProductivity a skos:Concept ;
    skos:prefLabel "soil biomass productivity" ;
    skos:broader she:Variable ;
    she:mayHaveStrongEffectOn she:SoilBiodiversity ;
    skos:narrower she:Poor,
                  she:Average,
                  she:Good .

she:LandUseLandCover a skos:Concept ;
    skos:prefLabel "land use/land cover" ;
    skos:broader she:Variable ;
    she:mayHaveStrongEffectOn she:SoilBiodiversity ;
    skos:narrower she:Artificial,
                  she:Arable,
                  she:PermanentCrops,
                  she:Others .

she:LessThan4 a skos:Concept ;
    skos:prefLabel "<4" .

she:Between4And5Point2 a skos:Concept ;
    skos:prefLabel "4-5.2" .

she:Between5Point2And8Point2 a skos:Concept ;
    skos:prefLabel "5.2-8.2" .

she:GreaterThan8Point2 a skos:Concept ;
    skos:prefLabel ">8.2" .

she:Coarse a skos:Concept ;
    skos:prefLabel "coarse" .

she:Medium a skos:Concept ;
    skos:prefLabel "medium" .

she:MediumFine a skos:Concept ;
    skos:prefLabel "medium-fine" .

she:Fine a skos:Concept ;
    skos:prefLabel "fine" .

she:LessThan1 a skos:Concept ;
    skos:prefLabel "<1" .

she:Between1And2 a skos:Concept ;
    skos:prefLabel "1-2" .

she:Between2And4 a skos:Concept ;
    skos:prefLabel "2-4" .

she:GreaterThan4 a skos:Concept ;
    skos:prefLabel ">4" .

she:LessThanMinus500 a skos:Concept ;
    skos:prefLabel "<-500" .

she:BetweenMinus500And500 a skos:Concept ;
    skos:prefLabel "-500 to 500" .

she:GreaterThan500 a skos:Concept ;
    skos:prefLabel ">500" .

she:LessThan5 a skos:Concept ;
    skos:prefLabel "<5" .

she:Between5And20 a skos:Concept ;
    skos:prefLabel "5-20" .

she:GreaterThan20 a skos:Concept ;
    skos:prefLabel ">20" .

she:Poor a skos:Concept ;
    skos:prefLabel "poor" .

she:Average a skos:Concept ;
    skos:prefLabel "average" .

she:Good a skos:Concept ;
    skos:prefLabel "good" .

she:Artificial a skos:Concept ;
    skos:prefLabel "artificial" .

she:Arable a skos:Concept ;
    skos:prefLabel "arable" .

she:PermanentCrops a skos:Concept ;
    skos:prefLabel "permanent crops" .

she:Others a skos:Concept ;
    skos:prefLabel "others" .
