@prefix she: <https://soilwise-he.github.io/soil-health#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

she:ThresholdsForEnvironmentalVariablesAffectingSoilBiodiversity a skos:Concept ;
    skos:narrower she:ClassesOfParametersForScoringSoilBiodiversityPotential,
        she:Variable ;
    skos:prefLabel "thresholds for environmental variables that may have a strong effect on soil biodiversity" .

she:AnnualAverageTemperature a skos:Concept ;
    skos:prefLabel "annual average temperature (°c)" ;
    she:hasParameterClass she:AnnualAverageTemperature5To20,
        she:AnnualAverageTemperatureGreaterThan20,
        she:AnnualAverageTemperatureLessThan5 .

she:AnnualAverageTemperature5To20 a skos:Concept ;
    skos:prefLabel "5-20" .

she:AnnualAverageTemperatureGreaterThan20 a skos:Concept ;
    skos:prefLabel ">20" .

she:AnnualAverageTemperatureLessThan5 a skos:Concept ;
    skos:prefLabel "<5" .

she:Arable a skos:Concept ;
    skos:prefLabel "arable" .

she:Artificial a skos:Concept ;
    skos:prefLabel "artificial" .

she:Average a skos:Concept ;
    skos:prefLabel "average" .

she:ClassesOfParametersForScoringSoilBiodiversityPotential a skos:Concept ;
    skos:prefLabel "classes of parameters for scoring soil biodiversity potential" .

she:Coarse a skos:Concept ;
    skos:prefLabel "coarse" .

she:Fine a skos:Concept ;
    skos:prefLabel "fine" .

she:Good a skos:Concept ;
    skos:prefLabel "good" .

she:LandUseLandCover a skos:Concept ;
    skos:prefLabel "land use/land cover" ;
    she:hasParameterClass she:Arable,
        she:Artificial,
        she:Others,
        she:PermanentCrops .

she:Medium a skos:Concept ;
    skos:prefLabel "medium" .

she:MediumFine a skos:Concept ;
    skos:prefLabel "medium-fine" .

she:OrganicMatter a skos:Concept ;
    skos:prefLabel "organic matter (%)" ;
    she:hasParameterClass she:OrganicMatter1To2,
        she:OrganicMatter2To4,
        she:OrganicMatterGreaterThan4,
        she:OrganicMatterLessThan1 .

she:OrganicMatter1To2 a skos:Concept ;
    skos:prefLabel "1-2" .

she:OrganicMatter2To4 a skos:Concept ;
    skos:prefLabel "2-4" .

she:OrganicMatterGreaterThan4 a skos:Concept ;
    skos:prefLabel ">4" .

she:OrganicMatterLessThan1 a skos:Concept ;
    skos:prefLabel "<1" .

she:Others a skos:Concept ;
    skos:prefLabel "others" .

she:PH a skos:Concept ;
    skos:prefLabel "ph" ;
    she:hasParameterClass she:PH4To5_2,
        she:PH5_2To8_2,
        she:PHGreaterThan8_2,
        she:PHLessThan4 .

she:PH4To5_2 a skos:Concept ;
    skos:prefLabel "4-5.2" .

she:PH5_2To8_2 a skos:Concept ;
    skos:prefLabel "5.2-8.2" .

she:PHGreaterThan8_2 a skos:Concept ;
    skos:prefLabel ">8.2" .

she:PHLessThan4 a skos:Concept ;
    skos:prefLabel "<4" .

she:PermanentCrops a skos:Concept ;
    skos:prefLabel "permanent crops" .

she:Poor a skos:Concept ;
    skos:prefLabel "poor" .

she:PotentialEvapotranspiration a skos:Concept ;
    skos:prefLabel "potential evapotranspiration (mm)" ;
    she:hasParameterClass she:PotentialEvapotranspirationGreaterThan500,
        she:PotentialEvapotranspirationLessThanMinus500,
        she:PotentialEvapotranspirationMinus500To500 .

she:PotentialEvapotranspirationGreaterThan500 a skos:Concept ;
    skos:prefLabel ">500" .

she:PotentialEvapotranspirationLessThanMinus500 a skos:Concept ;
    skos:prefLabel "<-500" .

she:PotentialEvapotranspirationMinus500To500 a skos:Concept ;
    skos:prefLabel "-500 to 500" .

she:SoilBiomassProductivity a skos:Concept ;
    skos:prefLabel "soil biomass productivity" ;
    she:hasParameterClass she:Average,
        she:Good,
        she:Poor .

she:SoilTexturalClass a skos:Concept ;
    skos:prefLabel "soil textural class" ;
    she:hasParameterClass she:Coarse,
        she:Fine,
        she:Medium,
        she:MediumFine .

she:Variable a skos:Concept ;
    skos:narrower she:AnnualAverageTemperature,
        she:LandUseLandCover,
        she:OrganicMatter,
        she:PH,
        she:PotentialEvapotranspiration,
        she:SoilBiomassProductivity,
        she:SoilTexturalClass ;
    skos:prefLabel "variable" .

