@prefix she: <https://soilwise-he.github.io/soil-health#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

she:DynamicAssessmentOfSoilHealth a skos:Concept ;
    skos:prefLabel "dynamic assessment of soil health" ;
    skos:narrower she:Unhealthy,
                  she:Intermediate,
                  she:Healthy ;
    skos:note "Source: EEA." ;
    she:relates she:IndicatorsFromMonitoring,
                she:Time .

she:IndicatorsFromMonitoring a skos:Concept ;
    skos:prefLabel "indicators from monitoring" .

she:Time a skos:Concept ;
    skos:prefLabel "time" .

she:Unhealthy a skos:Concept ;
    skos:prefLabel "unhealthy" ;
    skos:definition "at least one indicator exceeds thresholds for unacceptable degradation (ecosystem services significantly compromised)" ;
    she:hasCondition she:ThresholdForUnacceptableDegradation .

she:ThresholdForUnacceptableDegradation a skos:Concept ;
    skos:prefLabel "threshold for unacceptable degradation" .

she:Intermediate a skos:Concept ;
    skos:prefLabel "intermediate" ;
    skos:definition "slight soil degradation at warning level (pre-cautionary soil protection)" ;
    skos:narrower she:ExceedanceOfThresholdsForIntermediateRisk,
                  she:PositiveIndicatorTrendWhileThresholdsForUnacceptableDegradationAreStillExceeded,
                  she:NegativeIndicatorTrendWithoutAnyThresholdExceedance,
                  she:SustainableSoilManagementInPlaceWhileThresholdsAreExceeded .

she:ExceedanceOfThresholdsForIntermediateRisk a skos:Concept ;
    skos:prefLabel "exceedance of thresholds for intermediate risk (where available)" .

she:PositiveIndicatorTrendWhileThresholdsForUnacceptableDegradationAreStillExceeded a skos:Concept ;
    skos:prefLabel "positive indicator trend while thresholds for unacceptable degradation are still exceeded" .

she:NegativeIndicatorTrendWithoutAnyThresholdExceedance a skos:Concept ;
    skos:prefLabel "negative indicator trend without any threshold exceedance" .

she:SustainableSoilManagementInPlaceWhileThresholdsAreExceeded a skos:Concept ;
    skos:prefLabel "sustainable soil management in place while thresholds are exceeded" .

she:Healthy a skos:Concept ;
    skos:prefLabel "healthy" ;
    skos:definition "none of the indicators shows any threshold exceedance" .

she:PositiveTrend a skos:Concept ;
    skos:prefLabel "positive trend" ;
    she:indicatesImprovementTowards she:Healthy .

she:NegativeTrend a skos:Concept ;
    skos:prefLabel "negative trend" ;
    she:indicatesDegradationTowards she:Unhealthy .
