@prefix she: <https://soilwise-he.github.io/soil-health#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

she:FactorsContributingToDifferencesInRiskAssessment a skos:Concept ;
    skos:narrower she:ClimaticFactors,
        she:CulturalFactors,
        she:GeographicalFactors,
        she:RegulatoryAndPoliticalFactors,
        she:ScientificFactors ;
    skos:prefLabel "factors contributing to differences in risk assessment tools and approaches, and to differences in ssvs among eu member states" .

she:ClimaticFactors a skos:Concept ;
    skos:narrower she:NetAnnualWaterSurplus,
        she:TemperatureRainfall,
        she:TimeSpentOutdoors ;
    skos:prefLabel "climatic factors" .

she:ComplementaritiesWithOtherExistingLaws a skos:Concept ;
    skos:definition "definition of attributes in risk assessment" ;
    skos:prefLabel "complementarities with other existing laws" .

she:CulturalFactors a skos:Concept ;
    skos:narrower she:DrinkingWaterFromPrivateWells,
        she:SelfSupplyGardeningSubsistenceFarming,
        she:UrbanRecreation ;
    skos:prefLabel "cultural factors" .

she:DepthOfGroundwaterTable a skos:Concept ;
    skos:definition "vapour intrusion and, hence, human exposure through inhalation. it also affects the potential impact of soil quality on water quality, since contact time between soil and surface water is shorter in areas with high water tables" ;
    skos:prefLabel "depth of groundwater table" .

she:DrinkingWaterFromPrivateWells a skos:Concept ;
    skos:definition "exposure through the consumption of groundwater as drinking water" ;
    skos:prefLabel "drinking water from private wells" .

she:FundingRegime a skos:Concept ;
    skos:definition "acceptable exposure, exposure time, aggregate exposure; mixtures and non-soil sources" ;
    skos:prefLabel "funding regime" .

she:GeographicalFactors a skos:Concept ;
    skos:narrower she:DepthOfGroundwaterTable,
        she:SoilProperties ;
    skos:prefLabel "geographical factors" .

she:Governance a skos:Concept ;
    skos:definition "authorities involved and responsible; land reclamation policies, spatial planning, drinking water protection" ;
    skos:prefLabel "governance" .

she:NetAnnualWaterSurplus a skos:Concept ;
    skos:definition "leaching/accumulation is controlled largely by water flux (in combination with soil properties)" ;
    skos:prefLabel "net annual water surplus" .

she:PrioritisationOfEconomicAndEnvironmentalValues a skos:Concept ;
    skos:definition "role and use of background values" ;
    skos:prefLabel "prioritisation of economic and environmental values" .

she:RegulatoryAndPoliticalFactors a skos:Concept ;
    skos:narrower she:ComplementaritiesWithOtherExistingLaws,
        she:Governance,
        she:PrioritisationOfEconomicAndEnvironmentalValues ;
    skos:prefLabel "regulatory and political factors" .

she:ScientificAndAnalyticalExperienceAndCooperation a skos:Concept ;
    skos:definition "selection of protection targets and exposure pathways; method and use of background concentrations; toxicological data sources" ;
    skos:prefLabel "scientific and analytical experience and cooperation" .

she:ScientificFactors a skos:Concept ;
    skos:narrower she:FundingRegime,
        she:ScientificAndAnalyticalExperienceAndCooperation ;
    skos:prefLabel "scientific factors" .

she:SelfSupplyGardeningSubsistenceFarming a skos:Concept ;
    skos:definition "exposure through the consumption of vegetables grown in kitchen gardens" ;
    skos:prefLabel "self-supply gardening, subsistence farming" .

she:SoilProperties a skos:Concept ;
    skos:definition "(bio)availability affecting ecology as well as filtering function" ;
    skos:prefLabel "soil properties" .

she:TemperatureRainfall a skos:Concept ;
    skos:definition "climate controls crop types used by farmers and hence potential uptake of pollutants from soil" ;
    skos:prefLabel "temperature/rainfall" .

she:TimeSpentOutdoors a skos:Concept ;
    skos:definition "potential contact with soil and, hence, exposure through soil ingestion" ;
    skos:prefLabel "time spent outdoors" .

she:UrbanRecreation a skos:Concept ;
    skos:prefLabel "urban recreation" .

