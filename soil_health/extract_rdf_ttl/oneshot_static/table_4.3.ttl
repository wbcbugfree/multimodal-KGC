@prefix she: <https://soilwise-he.github.io/soil-health#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

she:SummarisedCriticalPHValues a skos:Concept ;
    skos:prefLabel "summarised critical ph values for wheat, maize and rice" ;
    skos:definition "summarised critical ph values for wheat, maize and rice derived from short-term manipulation experiments (ste) and long-term observations (lte)" ;
    skos:note "Source: Compiled from Zhu et al. (2020)." ;
    skos:narrower she:Crop,
                  she:PHAt95PercentYield .

she:Crop a skos:Concept ;
    skos:prefLabel "crop" ;
    skos:narrower she:Wheat,
                  she:Maize,
                  she:Rice .

she:PHAt95PercentYield a skos:Concept ;
    skos:prefLabel "ph at 95% yield" ;
    skos:narrower she:STE,
                  she:LTE,
                  she:STELTE .

she:STE a skos:Concept ;
    skos:prefLabel "short-term manipulation experiments" ;
    she:hasAbbreviation "STE" .

she:LTE a skos:Concept ;
    skos:prefLabel "long-term observations" ;
    she:hasAbbreviation "LTE" .

she:STELTE a skos:Concept ;
    skos:prefLabel "ste+lte" .

she:Wheat a skos:Concept ;
    skos:prefLabel "wheat" ;
    she:hasPHValueSTE "4.5" ;
    she:hasPHValueLTE "5.9" ;
    she:hasPHValueSTELTE "5.3" .

she:Maize a skos:Concept ;
    skos:prefLabel "maize" ;
    she:hasPHValueSTE "4.6" ;
    she:hasPHValueLTE "5.1" ;
    she:hasPHValueSTELTE "4.8" .

she:Rice a skos:Concept ;
    skos:prefLabel "rice" ;
    she:hasPHValueSTE "4.7" ;
    she:hasPHValueLTE "5.0" ;
    she:hasPHValueSTELTE "4.7" .
