@prefix she: <https://soilwise-he.github.io/soil-health#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

she:Biodiversity a skos:Concept ;
    skos:narrower she:SocietalNeed ;
    skos:prefLabel "biodiversity" ;
    she:supportedByService she:HabitatForPlantsInsectsMicrobesFungi .

she:Biomass a skos:Concept ;
    skos:narrower she:SocietalNeed ;
    skos:prefLabel "biomass" ;
    she:supportedByService she:GrowthOfCrops,
        she:WoodAndFibreProduction .

she:Climate a skos:Concept ;
    skos:narrower she:SocietalNeed ;
    skos:prefLabel "climate" ;
    she:supportedByService she:CarbonStorage .

she:Infrastructure a skos:Concept ;
    skos:narrower she:SocietalNeed ;
    skos:prefLabel "infrastructure" ;
    she:supportedByService she:PlatformForInfrastructure,
        she:StorageOfGeologicalMaterial .

she:Water a skos:Concept ;
    skos:narrower she:SocietalNeed ;
    skos:prefLabel "water" ;
    she:supportedByService she:FilteringOfContaminants,
        she:WaterStorage .

she:CarbonStorage a skos:Concept ;
    skos:narrower she:SoilService ;
    skos:prefLabel "carbon storage" ;
    she:hasImpact she:PositiveImpact .

she:FilteringOfContaminants a skos:Concept ;
    skos:narrower she:SoilService ;
    skos:prefLabel "filtering of contaminants" ;
    she:hasImpact she:PositiveImpact .

she:GrowthOfCrops a skos:Concept ;
    skos:narrower she:SoilService ;
    skos:prefLabel "growth of crops" ;
    she:hasImpact she:PositiveImpact .

she:HabitatForPlantsInsectsMicrobesFungi a skos:Concept ;
    skos:narrower she:SoilService ;
    skos:prefLabel "habitat for plants, insects, microbes, fungi" ;
    she:hasImpact she:PositiveImpact .

she:PlatformForInfrastructure a skos:Concept ;
    skos:narrower she:SoilService ;
    skos:prefLabel "platform for infrastructure" ;
    she:hasImpact she:IndifferentImpact .

she:StorageOfGeologicalMaterial a skos:Concept ;
    skos:narrower she:SoilService ;
    skos:prefLabel "storage of geological material" ;
    she:hasImpact she:IndifferentImpact .

she:WaterStorage a skos:Concept ;
    skos:narrower she:SoilService ;
    skos:prefLabel "water storage" ;
    she:hasImpact she:PositiveImpact .

she:WoodAndFibreProduction a skos:Concept ;
    skos:narrower she:SoilService ;
    skos:prefLabel "wood and fibre production" ;
    she:hasImpact she:PositiveImpact .

she:Impact a skos:Concept ;
    skos:broader she:RelationshipOfSoilBiodiversityToKeySocietalNeedsAndSoilFunctions ;
    skos:prefLabel "impact" .

she:IndifferentImpact a skos:Concept ;
    skos:narrower she:Impact ;
    skos:prefLabel "indifferent" .

she:RelationshipOfSoilBiodiversityToKeySocietalNeedsAndSoilFunctions a skos:Concept ;
    skos:prefLabel "relationship of soil biodiversity to key societal needs and soil functions" .

she:SocietalNeed a skos:Concept ;
    skos:broader she:RelationshipOfSoilBiodiversityToKeySocietalNeedsAndSoilFunctions ;
    skos:prefLabel "societal need" .

she:PositiveImpact a skos:Concept ;
    skos:narrower she:Impact ;
    skos:prefLabel "+" .

she:SoilService a skos:Concept ;
    skos:broader she:RelationshipOfSoilBiodiversityToKeySocietalNeedsAndSoilFunctions ;
    skos:prefLabel "soil service" .

