@prefix she: <https://soilwise-he.github.io/soil-health#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

she:EuropeanCroplandArea a skos:Concept ;
    skos:prefLabel "european cropland area" .

she:SomContent a skos:Concept ;
    skos:prefLabel "som content" .

she:Threshold1 a skos:Concept ;
    skos:broader she:SomThresholdsDerivedFromFarmerQuestionnaire ;
    skos:definition "lower end of som value range (10th percentile) at which farmers judge their current som content sufficient" ;
    skos:prefLabel "threshold 1" ;
    she:concernedArea "1.1% of the european cropland area" ;
    she:implication "below this threshold value, no farmers are expected to be satisfied with their som content" ;
    she:specificallyConcernsRegion she:NorthernFrance .

she:Threshold2 a skos:Concept ;
    skos:broader she:SomThresholdsDerivedFromFarmerQuestionnaire ;
    skos:definition "upper end of the range of values (90th percentile) at which farmers perceive a high or very high deficiency of som content" ;
    skos:prefLabel "threshold 2" ;
    she:concernedArea "14.3% of the cropland area" ;
    she:implication "above this threshold, no farmers are expected to be dissatisfied with their som content" ;
    she:specificallyConcernsRegion she:CentralEasternEurope,
        she:SouthernEurope .

she:CentralEasternEurope a skos:Concept ;
    skos:prefLabel "central/eastern europe" .

she:NorthernFrance a skos:Concept ;
    skos:prefLabel "northern france" .

she:SouthernEurope a skos:Concept ;
    skos:prefLabel "southern europe" .

she:SomThresholdsDerivedFromFarmerQuestionnaire a skos:Concept ;
    skos:prefLabel "definition of som thresholds derived from a farmer questionnaire" .

