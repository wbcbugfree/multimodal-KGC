@prefix she: <https://soilwise-he.github.io/soil-health#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

she:DerivedSoilProperties a skos:Concept ;
    skos:definition "modeling" ;
    skos:narrower she:AdsorptionAndCationExchangeCapacity,
        she:AggregateStability,
        she:CationExchangeCapacity,
        she:ElectricConductivity,
        she:Erodibility,
        she:HydraulicConductivity,
        she:Porosity,
        she:RootingDepth,
        she:WaterRunoffInfiltration ;
    skos:prefLabel "derived soil properties" ;
    she:determines she:SoilQuality .

she:DriversAndPressures a skos:Concept ;
    skos:prefLabel "drivers and pressures" .

she:ExternalEnvironmentalFactors a skos:Concept ;
    skos:definition "climate, land use, inputs, emissions" ;
    skos:prefLabel "external (environmental) factors" ;
    she:influences she:NonSoilIndicators .

she:ObservableSoilProperties a skos:Concept ;
    skos:definition "measurements" ;
    skos:narrower she:BiologicalProperties,
        she:BulkDensity,
        she:CationAndAnionContentContaminantsNutrientsAcidifiersSalts,
        she:ChemicalProperties,
        she:DepthStoneContentMineralog,
        she:PhysicalProperties,
        she:SocNP,
        she:SoilBiotaMicroMacro,
        she:TexturalClassesStructurePh,
        she:WaterContentSoilTemperature ;
    skos:prefLabel "observable soil properties" ;
    she:determines she:SoilQuality .

she:StatusAndTrends a skos:Concept ;
    skos:prefLabel "status and trends" .

she:Thresholds a skos:Concept ;
    skos:narrower she:CriticalLevels ;
    skos:prefLabel "thresholds" ;
    she:leadsTo she:SoilHealth .

she:AdsorptionAndCationExchangeCapacity a skos:Concept ;
    skos:prefLabel "adsorption and cation exchange capacity" .

she:AggregateStability a skos:Concept ;
    skos:prefLabel "aggregate stability" .

she:BiologicalProperties a skos:Concept ;
    skos:prefLabel "biological properties" .

she:BiomassProductivity a skos:Concept ;
    skos:prefLabel "biomass productivity" ;
    she:relatesTo she:FoodProduction .

she:BulkDensity a skos:Concept ;
    skos:prefLabel "bulk density" .

she:CarbonStorageCapacity a skos:Concept ;
    skos:prefLabel "carbon storage capacity" ;
    she:relatesTo she:CarbonPoolAndClimateRegulations .

she:CationAndAnionContentContaminantsNutrientsAcidifiersSalts a skos:Concept ;
    skos:prefLabel "cation and anion content (contaminants, nutrients, acidifiers, salts)" .

she:CationExchangeCapacity a skos:Concept ;
    skos:prefLabel "cation exchange capacity" .

she:ChemicalProperties a skos:Concept ;
    skos:prefLabel "chemical properties" .

she:CriticalLevels a skos:Concept ;
    skos:prefLabel "critical levels" .

she:DepthStoneContentMineralog a skos:Concept ;
    skos:prefLabel "depth, stone content, mineralog" .

she:ElectricConductivity a skos:Concept ;
    skos:prefLabel "electric conductivity" .

she:Erodibility a skos:Concept ;
    skos:prefLabel "erodibility" .

she:GroundwaterReproduction a skos:Concept ;
    skos:prefLabel "groundwater reproduction" ;
    she:relatesTo she:WaterPurificationAndRegulation .

she:HabitatProvisionCapacity a skos:Concept ;
    skos:prefLabel "habitat provision capacity" ;
    she:relatesTo she:Habitat .

she:HydraulicConductivity a skos:Concept ;
    skos:prefLabel "hydraulic conductivity" .

she:NonSoilIndicators a skos:Concept ;
    skos:prefLabel "non-soil indicators" ;
    she:influences she:EcosystemServices,
        she:SoilFunctions .

she:NutrientMobilisationAndBufferingCapacity a skos:Concept ;
    skos:prefLabel "nutrient mobilisation and buffering capacity" ;
    she:relatesTo she:NutrientDynamics .

she:PhysicalProperties a skos:Concept ;
    skos:prefLabel "physical properties" .

she:Porosity a skos:Concept ;
    skos:prefLabel "porosity" .

she:RootingDepth a skos:Concept ;
    skos:prefLabel "rooting depth" .

she:Salinisation a skos:Concept ;
    skos:prefLabel "salinisation (*)" .

she:SocLoss a skos:Concept ;
    skos:prefLabel "soc loss" .

she:SocNP a skos:Concept ;
    skos:prefLabel "soc, n, p" .

she:SoilAcidification a skos:Concept ;
    skos:prefLabel "soil acidification" .

she:SoilBiodiversityLoss a skos:Concept ;
    skos:prefLabel "soil biodiversity loss" .

she:SoilBiotaMicroMacro a skos:Concept ;
    skos:prefLabel "soil biota (micro, meso, macro)" .

she:SoilCompaction a skos:Concept ;
    skos:prefLabel "soil compaction" .

she:SoilErosion a skos:Concept ;
    skos:prefLabel "soil erosion" .

she:SoilFunctionalIndicators a skos:Concept ;
    skos:narrower she:BiomassProductivity,
        she:CarbonStorageCapacity,
        she:GroundwaterReproduction,
        she:HabitatProvisionCapacity,
        she:NutrientMobilisationAndBufferingCapacity,
        she:SoilMoistureDeficit,
        she:WaterStorageCapacity ;
    skos:prefLabel "soil functional indicators" ;
    she:conditionsTheExtentOf she:SoilThreatIndicators ;
    she:leadsTo she:Impact ;
    she:measures she:EcosystemServices,
        she:SoilFunctions .

she:SoilMoistureDeficit a skos:Concept ;
    skos:prefLabel "soil moisture deficit" ;
    she:relatesTo she:WaterPurificationAndRegulation .

she:SoilNutrientLossNAndP a skos:Concept ;
    skos:prefLabel "soil nutrient loss — n and p" .

she:SoilPollution a skos:Concept ;
    skos:prefLabel "soil pollution" .

she:SoilSealing a skos:Concept ;
    skos:prefLabel "soil sealing" .

she:TexturalClassesStructurePh a skos:Concept ;
    skos:prefLabel "textural classes, structure ph" .

she:WaterContentSoilTemperature a skos:Concept ;
    skos:prefLabel "water content, soil temperature" .

she:WaterRunoffInfiltration a skos:Concept ;
    skos:prefLabel "water runoff, infiltration" .

she:WaterStorageCapacity a skos:Concept ;
    skos:prefLabel "water storage capacity" ;
    she:relatesTo she:WaterRetention .

she:CarbonPoolAndClimateRegulations a skos:Concept ;
    skos:broader she:Regulation ;
    skos:prefLabel "carbon pool and climate regulations" .

she:EcosystemServices a skos:Concept ;
    skos:narrower she:Provisioning,
        she:Regulation,
        she:Supporting ;
    skos:prefLabel "ecosystem services" ;
    she:contributesTo she:SoilHealth .

she:FoodProduction a skos:Concept ;
    skos:broader she:Provisioning ;
    skos:prefLabel "food production" .

she:Habitat a skos:Concept ;
    skos:broader she:Supporting ;
    skos:prefLabel "habitat" .

she:Impact a skos:Concept ;
    skos:prefLabel "impact" .

she:NutrientDynamics a skos:Concept ;
    skos:broader she:Supporting ;
    skos:prefLabel "nutrient dynamics" .

she:SoilQuality a skos:Concept ;
    skos:prefLabel "soil quality" ;
    she:setsTheConditionFor she:SoilFunctionalIndicators,
        she:SoilThreatIndicators .

she:SoilThreatIndicators a skos:Concept ;
    skos:narrower she:Salinisation,
        she:SocLoss,
        she:SoilAcidification,
        she:SoilBiodiversityLoss,
        she:SoilCompaction,
        she:SoilErosion,
        she:SoilNutrientLossNAndP,
        she:SoilPollution,
        she:SoilSealing ;
    skos:prefLabel "soil threat indicators" ;
    she:hasEffectOn she:SoilFunctions .

she:WaterRetention a skos:Concept ;
    skos:broader she:Provisioning ;
    skos:prefLabel "water retention" .

she:Provisioning a skos:Concept ;
    skos:prefLabel "provisioning" .

she:Regulation a skos:Concept ;
    skos:prefLabel "regulation" .

she:SoilFunctions a skos:Concept ;
    skos:narrower she:CarbonPoolAndClimateRegulations,
        she:FoodProduction,
        she:Habitat,
        she:NutrientDynamics,
        she:WaterPurificationAndRegulation,
        she:WaterRetention ;
    skos:prefLabel "soil functions" ;
    she:contributesTo she:SoilHealth .

she:SoilHealth a skos:Concept ;
    skos:definition "level to which soil functions are fulfilled" ;
    skos:prefLabel "soil health" ;
    she:leadsTo she:Impact .

she:Supporting a skos:Concept ;
    skos:prefLabel "supporting" .

she:WaterPurificationAndRegulation a skos:Concept ;
    skos:broader she:Regulation ;
    skos:prefLabel "water purification and regulation" .

