@prefix she: <https://soilwise-he.github.io/soil-health#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

she:RelationshipSoilOlsenPAndWheatYield a skos:Concept ;
    skos:prefLabel "the relationship between soil olsen-p contents and relative yield of wheat in long-term experiments in china" ;
    skos:narrower she:RelativeYield,
                  she:SoilOlsenPContent,
                  she:NutrientTreatments,
                  she:Regression,
                  she:CriticalPLevelAt90PercentYield ;
    skos:note "Source: Chen, X. et al., unpublished data." .

she:RelativeYield a skos:Concept ;
    skos:prefLabel "relative yield" ;
    she:hasUnit "percentage" .

she:SoilOlsenPContent a skos:Concept ;
    skos:prefLabel "soil olsen-p content" ;
    she:hasSymbol "Olsen-P" ;
    she:hasUnit "mg/kg" .

she:Regression a skos:Concept ;
    skos:prefLabel "regression" ;
    she:relatesTo she:RelativeYield,
                  she:SoilOlsenPContent .

she:CriticalPLevelAt90PercentYield a skos:Concept ;
    skos:prefLabel "critical p level at 90% relative yield" ;
    she:definesThresholdAt she:RelativeYield ;
    skos:note "The dashed red line indicates the critical phosphorus level required to reach 90% of the relative yield." .

she:NutrientTreatments a skos:Concept ;
    skos:prefLabel "nutrient treatments" ;
    skos:narrower she:CK,
                  she:NK,
                  she:NPK,
                  she:NPKM,
                  she:OnePointFiveNPKM,
                  she:NPKS .

she:CK a skos:Concept ;
    skos:prefLabel "ck" ;
    skos:definition "control plot without nutrient additions" .

she:NK a skos:Concept ;
    skos:prefLabel "nk" ;
    she:hasNutrientAddition she:Nitrogen,
                           she:Potassium .

she:NPK a skos:Concept ;
    skos:prefLabel "npk" ;
    she:hasNutrientAddition she:Nitrogen,
                           she:Phosphorus,
                           she:Potassium .

she:NPKM a skos:Concept ;
    skos:prefLabel "npkm" ;
    she:hasNutrientAddition she:Nitrogen,
                           she:Phosphorus,
                           she:Potassium,
                           she:AnimalManure .

she:OnePointFiveNPKM a skos:Concept ;
    skos:prefLabel "1.5npkm" ;
    skos:definition "50% higher addition of n, p, k and manure than in the standard treatment" ;
    she:hasAbbreviation "1.5 NPKM" .

she:NPKS a skos:Concept ;
    skos:prefLabel "npks" ;
    she:hasNutrientAddition she:Nitrogen,
                           she:Phosphorus,
                           she:Potassium,
                           she:Sulphur .

she:Nitrogen a skos:Concept ;
    skos:prefLabel "nitrogen" ;
    she:hasSymbol "N" .

she:Phosphorus a skos:Concept ;
    skos:prefLabel "phosphorus" ;
    she:hasSymbol "P" .

she:Potassium a skos:Concept ;
    skos:prefLabel "potassium" ;
    she:hasSymbol "K" .

she:Sulphur a skos:Concept ;
    skos:prefLabel "sulphur" ;
    she:hasSymbol "S" .

she:AnimalManure a skos:Concept ;
    skos:prefLabel "animal manure" ;
    she:hasSymbol "M" .

she:Wheat a skos:Concept ;
    skos:prefLabel "wheat" ;
    skos:related she:RelationshipSoilOlsenPAndWheatYield .

she:LongTermExperimentsInChina a skos:Concept ;
    skos:prefLabel "long-term experiments in china" ;
    skos:related she:RelationshipSoilOlsenPAndWheatYield .
