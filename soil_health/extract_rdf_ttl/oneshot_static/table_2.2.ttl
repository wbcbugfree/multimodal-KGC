@prefix she: <https://soilwise-he.github.io/soil-health#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

she:SomFractionsPoolsInSoils a skos:Concept ;
    skos:prefLabel "som fractions/pools in soils" ;
    skos:narrower she:MicrobialBiomassC,
                  she:Pom,
                  she:Maom,
                  she:InertOrganicMatter .

she:MicrobialBiomassC a skos:Concept ;
    skos:prefLabel "microbial biomass c (bacteria, fungi)" ;
    she:hasSymbol "C" ;
    she:hasShareOfTotalSom "1-5%" ;
    she:hasPoolCharacteristic "labile", "active" .

she:Pom a skos:Concept ;
    skos:prefLabel "pom" ;
    she:hasAbbreviation "POM" ;
    skos:note "it can be further subdivided into freshly added plant and animal residues, usually coarse pom with a low degree of decomposition (e.g. >250μm), and partially decomposed residues, frequently finer sized" ;
    she:hasShareOfTotalSom "5-25%" ;
    she:hasPoolCharacteristic "labile", "active" .

she:Maom a skos:Concept ;
    skos:prefLabel "maom" ;
    she:hasAbbreviation "MAOM" ;
    skos:note "largely consisting of microbial necromass and other adsorbed organic soil constituents" ;
    she:hasShareOfTotalSom "50-75%" ;
    she:hasPoolCharacteristic "stable", "activity level depends on degree of organo-mineral complexation" .

she:InertOrganicMatter a skos:Concept ;
    skos:prefLabel "inert organic matter" ;
    skos:altLabel "black carbon" ;
    she:hasShareOfTotalSom "5-20% or more" ;
    she:hasPoolCharacteristic "constant", "passive" .

she:OrganicMatterFractionPool a skos:Concept ;
    skos:prefLabel "organic matter fraction/pool" ;
    skos:narrower she:MicrobialBiomassC,
                  she:Pom,
                  she:Maom,
                  she:InertOrganicMatter .

she:ApproximateShareOfTotalSom a skos:Concept ;
    skos:prefLabel "approximate share of total som" ;
    she:hasAbbreviation "SOM" .

she:CharacteristicsOfPool a skos:Concept ;
    skos:prefLabel "characteristics of pool" .
