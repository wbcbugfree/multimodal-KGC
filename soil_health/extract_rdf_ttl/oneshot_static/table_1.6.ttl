@prefix she: <https://soilwise-he.github.io/soil-health#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

she:MissionBoardForSoilHealthAndFood a skos:Concept ;
    skos:prefLabel "eu's mission board for soil health and food" ;
    skos:narrower she:Objective1,
                  she:Objective2,
                  she:Objective3,
                  she:Objective4,
                  she:Objective5,
                  she:Objective6,
                  she:Objective7,
                  she:Objective8 .

she:Objective1 a skos:Concept ;
    skos:prefLabel "1. reduce land degradation, including desertification and salinisation" ;
    skos:narrower she:Target1_1 .

she:Target1_1 a skos:Concept ;
    skos:prefLabel "1.1. 50% of degraded land is restored moving beyond land degradation neutrality" ;
    she:hasIndicator she:PresenceOfSoilPollutantsExcessNutrientsAndSalts,
                     she:SoilOrganicCarbon,
                     she:SoilStructureBulkDensityAbsenceOfSoilSealingErosion,
                     she:SoilBiodiversity,
                     she:SoilNutrientsAndPh,
                     she:VegetationCover,
                     she:LandscapeHeterogeneity,
                     she:AreaOfForestAndOtherWoodedLands .

she:Objective2 a skos:Concept ;
    skos:prefLabel "2. conserve (e.g. in forests, permanent pastures, wetlands) and increase soil organic carbon stocks" ;
    skos:narrower she:Target2_1,
                  she:Target2_2 .

she:Target2_1 a skos:Concept ;
    skos:prefLabel "2.1. current carbon concentration losses on cultivated land (0.5% per year) are reversed to an increase by 0.1-0.4% per year" ;
    she:hasIndicator she:SoilOrganicCarbon,
                     she:VegetationCover .

she:Target2_2 a skos:Concept ;
    skos:prefLabel "2.2. the area of management peatlands losing carbon is reduced by 30-50%" ;
    she:hasIndicator she:SoilOrganicCarbon,
                     she:VegetationCover .

she:Objective3 a skos:Concept ;
    skos:prefLabel "3. no net soil sealing and increase the re-use of urban soils for urban development" ;
    skos:narrower she:Target3_1,
                  she:Target3_2 .

she:Target3_1 a skos:Concept ;
    skos:prefLabel "3.1. switch from 24% to no net soil sealing" ;
    she:hasIndicator she:SoilStructureBulkDensityAbsenceOfSoilSealingErosion,
                     she:VegetationCover .

she:Target3_2 a skos:Concept ;
    skos:prefLabel "3.2. the current rate of soil re-use is increased from current 13% to 50% to help meet the eu target of no net land take by 2050" ;
    she:hasIndicator she:SoilStructureBulkDensityAbsenceOfSoilSealingErosion,
                     she:VegetationCover .

she:Objective4 a skos:Concept ;
    skos:prefLabel "4. reduce soil pollution and enhance restoration" ;
    skos:narrower she:Target4_1,
                  she:Target4_2,
                  she:Target4_3 .

she:Target4_1 a skos:Concept ;
    skos:prefLabel "4.1. 25% of land under organic farming" ;
    she:hasIndicator she:PresenceOfSoilPollutantsExcessNutrientsAndSalts .

she:Target4_2 a skos:Concept ;
    skos:prefLabel "4.2. a further 5-25% additional land (i.e. over and above the 25% in full organic) with reduced risk from eutrophication, pesticides, anti-microbials and other contaminants" ;
    she:hasIndicator she:PresenceOfSoilPollutantsExcessNutrientsAndSalts .

she:Target4_3 a skos:Concept ;
    skos:prefLabel "4.3. doubling of the rate of restoration of polluted sites" ;
    she:hasIndicator she:PresenceOfSoilPollutantsExcessNutrientsAndSalts .

she:Objective5 a skos:Concept ;
    skos:prefLabel "5. prevent erosion" ;
    skos:narrower she:Target5_1 .

she:Target5_1 a skos:Concept ;
    skos:prefLabel "5.1. stop erosion on 30-50% of land with unsustainable erosion risk" ;
    she:hasIndicator she:SoilStructureBulkDensityAbsenceOfSoilSealingErosion,
                     she:VegetationCover,
                     she:LandscapeHeterogeneity,
                     she:AreaOfForestAndOtherWoodedLands .

she:Objective6 a skos:Concept ;
    skos:prefLabel "6. improve soil structure to enhance habitat quality for soil biota and crops" ;
    skos:narrower she:Target6_1 .

she:Target6_1 a skos:Concept ;
    skos:prefLabel "6.1. reduction by 30-50% of soil with high density subsoils" ;
    she:hasIndicator she:SoilStructureBulkDensityAbsenceOfSoilSealingErosion,
                     she:VegetationCover,
                     she:LandscapeHeterogeneity .

she:Objective7 a skos:Concept ;
    skos:prefLabel "7. reduce the eu global footprint on soils" ;
    skos:narrower she:Target7_1 .

she:Target7_1 a skos:Concept ;
    skos:prefLabel "7.1. the impact of eu's food, timber and biomass imports on land degradation are reduced by 20-40%" ;
    she:hasIndicator she:FoodFeedAndFibreImports .

she:Objective8 a skos:Concept ;
    skos:prefLabel "8. increase soil literacy in society across member states" ;
    skos:narrower she:Target8_1,
                  she:Target8_2,
                  she:Target8_3 .

she:Target8_1 a skos:Concept ;
    skos:prefLabel "8.1. soil health is firmly embedded in schools and educational curricula" ;
    she:hasIndicator she:PresenceOfSoilPollutantsExcessNutrientsAndSalts,
                     she:SoilOrganicCarbon,
                     she:SoilStructureBulkDensityAbsenceOfSoilSealingErosion,
                     she:SoilBiodiversity,
                     she:SoilNutrientsAndPh,
                     she:VegetationCover,
                     she:LandscapeHeterogeneity,
                     she:AreaOfForestAndOtherWoodedLands .

she:Target8_2 a skos:Concept ;
    skos:prefLabel "8.2. uptake of soil health training by land managers is increased" ;
    she:hasIndicator she:PresenceOfSoilPollutantsExcessNutrientsAndSalts,
                     she:SoilOrganicCarbon,
                     she:SoilStructureBulkDensityAbsenceOfSoilSealingErosion,
                     she:SoilBiodiversity,
                     she:SoilNutrientsAndPh,
                     she:VegetationCover,
                     she:LandscapeHeterogeneity,
                     she:AreaOfForestAndOtherWoodedLands .

she:Target8_3 a skos:Concept ;
    skos:prefLabel "8.3. understanding of impact of consumer choices on soil health is increased" ;
    she:hasIndicator she:PresenceOfSoilPollutantsExcessNutrientsAndSalts,
                     she:SoilOrganicCarbon,
                     she:SoilStructureBulkDensityAbsenceOfSoilSealingErosion,
                     she:SoilBiodiversity,
                     she:SoilNutrientsAndPh,
                     she:VegetationCover,
                     she:LandscapeHeterogeneity,
                     she:AreaOfForestAndOtherWoodedLands .

she:PresenceOfSoilPollutantsExcessNutrientsAndSalts a skos:Concept ;
    skos:prefLabel "presence of soil pollutants, excess nutrients and salts" .

she:SoilOrganicCarbon a skos:Concept ;
    skos:prefLabel "soil organic carbon" .

she:SoilStructureBulkDensityAbsenceOfSoilSealingErosion a skos:Concept ;
    skos:prefLabel "soil structure bulk density & absence of soil sealing /erosion" .

she:SoilBiodiversity a skos:Concept ;
    skos:prefLabel "soil biodiversity" .

she:SoilNutrientsAndPh a skos:Concept ;
    skos:prefLabel "soil nutrients and ph" .

she:VegetationCover a skos:Concept ;
    skos:prefLabel "vegetation cover" .

she:LandscapeHeterogeneity a skos:Concept ;
    skos:prefLabel "landscape heterogeneity" .

she:AreaOfForestAndOtherWoodedLands a skos:Concept ;
    skos:prefLabel "area of forest and other wooded lands" .

she:FoodFeedAndFibreImports a skos:Concept ;
    skos:prefLabel "food, feed and fibre imports" .
