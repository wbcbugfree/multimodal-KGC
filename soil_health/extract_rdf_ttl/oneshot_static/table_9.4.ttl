@prefix she: <https://soilwise-he.github.io/soil-health#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

she:AchieveNoNetLandTakeBy2050 a skos:Concept ;
    skos:broader she:CurrentTargetsAndBaselinesForSoilSealingLandTake ;
    skos:prefLabel "achieve no net land take by 2050" ;
    she:hasIndicator she:LandTakeKm2Per3YearPeriod ;
    she:hasSource she:EU,
        she:RoadmapToAResourceEfficientEurope .

she:DecreaseLandTakeGradually a skos:Concept ;
    skos:broader she:CurrentTargetsAndBaselinesForSoilSealingLandTake ;
    skos:prefLabel "to decrease land take gradually: 2016: land take 6ha/day (baseline) 2025 interim target 3ha/day 2040 final target 0ha/day ('land take neutral')" ;
    she:hasIndicator she:AverageAnnualLandTakeMeasuredInHectaresPerDay ;
    she:hasSource she:Flanders,
        she:StrategicVisionOfSpatialPolicyPlanOfFlanders .

she:HalveLandTakeAtExpenseOfAgriculturalLand a skos:Concept ;
    skos:broader she:CurrentTargetsAndBaselinesForSoilSealingLandTake ;
    skos:prefLabel "to halve land take at the expense of agricultural land until 2020 and reduce urban sprawl" ;
    she:hasIndicator she:AverageAnnualLandTakeMeasuredInThousandHectaresPerYearInMetropolitanAreas ;
    she:hasSource she:France .

she:ReduceAnnualLandTakeTo2_5HaDayBy2030 a skos:Concept ;
    skos:broader she:CurrentTargetsAndBaselinesForSoilSealingLandTake ;
    skos:prefLabel "to reduce annual land take to a rate of 2.5ha/day by 2030 and to compensate unavoidable soil sealing" ;
    she:hasIndicator she:AverageAnnualLandTakeMeasuredInHectaresPerDay ;
    she:hasSource she:AustrianGovernmentProgramme2020_2024 .

she:ReduceLandConsumptionFrom1_3HaDayTo0HaDayBy2050 a skos:Concept ;
    skos:broader she:CurrentTargetsAndBaselinesForSoilSealingLandTake ;
    skos:prefLabel "to reduce land consumption from 1.3ha/day (average 2000-2006) to 1ha/day by 2020 and 0ha/day by 2050" ;
    she:hasIndicator she:AverageAnnualLandTakeMeasuredInHectaresPerDay ;
    she:hasSource she:Luxembourg .

she:ReduceLandTakeForSettlementsAndTrafficRoutes a skos:Concept ;
    skos:broader she:CurrentTargetsAndBaselinesForSoilSealingLandTake ;
    skos:prefLabel "to reduce land take for settlements and traffic routes to less than 30ha/day by 2030 (at present 52ha/day as a 4-year average from 2016 to 2019)" ;
    she:hasIndicator she:AverageAnnualLandTakeMeasuredInHectaresPerDay ;
    she:hasSource she:GermanSustainabilityStrategy2016 .

she:StopNetLandSoilTakeBy2050 a skos:Concept ;
    skos:broader she:CurrentTargetsAndBaselinesForSoilSealingLandTake ;
    skos:prefLabel "to stop net land (soil) take ('use') by 2050" ;
    she:hasIndicator she:NotYetDefined ;
    she:hasSource she:Switzerland .

she:AustrianGovernmentProgramme2020_2024 a skos:Concept ;
    skos:definition "austrian government programme 2020-2024 (https://www.bundeskanzleramt.gv.at/bundeskanzleramt/die-bundesregierung/regierungsdokumente.html), p. 104." ;
    skos:prefLabel "austrian government programme 2020-2024" .

she:AverageAnnualLandTakeMeasuredInThousandHectaresPerYearInMetropolitanAreas a skos:Concept ;
    skos:prefLabel "average annual land take measured in thousand hectares per year in metropolitan areas" .

she:EU a skos:Concept ;
    skos:narrower she:RoadmapToAResourceEfficientEurope ;
    skos:prefLabel "eu" .

she:Flanders a skos:Concept ;
    skos:narrower she:StrategicVisionOfSpatialPolicyPlanOfFlanders ;
    skos:prefLabel "flanders" .

she:France a skos:Concept ;
    skos:definition "the law of agricultural and fishery modernization (https://artificialisation.biodiversitetousvivants.fr)." ;
    skos:prefLabel "france" .

she:GermanSustainabilityStrategy2016 a skos:Concept ;
    skos:definition "german sustainability strategy 2016 (https://sustainabledevelopment-deutschland.github.io/en/11-1-a)." ;
    skos:prefLabel "german sustainability strategy 2016" .

she:LandTakeKm2Per3YearPeriod a skos:Concept ;
    skos:prefLabel "land take (km²) per 3-year period" .

she:Luxembourg a skos:Concept ;
    skos:definition "un luxembourg durable pour une meilleure qualité de vie (https://environnement.public.lu/dam-assets/documents/developpement-durable/un-luxembourg-plus-durable-pour-une-meilleure-qualite-de-vie-2010.pdf), p. 35." ;
    skos:prefLabel "luxembourg" .

she:NotYetDefined a skos:Concept ;
    skos:prefLabel "not yet defined" .

she:Switzerland a skos:Concept ;
    skos:definition "schweizerischer bundesrat (2020, p. 22). this target implements sdg target 15.3 and the seventh environment action programme (no net land take). compensation measures included, however, are based on qualitative requirements and measures rather than area related. soil sealing is used as an indicator for land take until a national soil functions map is available." ;
    skos:prefLabel "switzerland" .

she:RoadmapToAResourceEfficientEurope a skos:Concept ;
    skos:definition "ec (2011, p. 15, milestone 4.6)." ;
    skos:prefLabel "roadmap to a resource efficient europe" .

she:StrategicVisionOfSpatialPolicyPlanOfFlanders a skos:Concept ;
    skos:definition "strategic vision of the spatial policy plan of flanders (https://www.vlaanderen.be/publicaties/beleidsplan-ruimte-vlaanderen-strategische-visie-geillustreerde-versie), p. 36." ;
    skos:prefLabel "strategic vision of the spatial policy plan of flanders" .

she:AverageAnnualLandTakeMeasuredInHectaresPerDay a skos:Concept ;
    skos:prefLabel "average annual land take measured in hectares per day" .

she:CurrentTargetsAndBaselinesForSoilSealingLandTake a skos:Concept ;
    skos:prefLabel "current targets and baselines for soil sealing/land take in selected european countries" .

