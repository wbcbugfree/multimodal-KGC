@prefix she: <https://soilwise-he.github.io/soil-health#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

she:SoilThreatIndicatorsInvestigated a skos:Concept ;
    skos:prefLabel "soil threat indicators investigated" ;
    skos:note "The current knowledge base covers a limited set of land uses and soil properties, for which thresholds are available; in the future, all relevant land uses and sites need to be covered." ;
    skos:narrower she:SoilPollution,
                  she:SoilErosion,
                  she:SoilBiodiversityLoss,
                  she:SoilCompaction,
                  she:SoilSealing .

she:SoilPollution a skos:Concept ;
    skos:prefLabel "soil pollution" ;
    she:hasApplicationScope she:AllLandUses ;
    she:hasIndicator she:HeavyMetalsAndOrganicPollutantsRisk ;
    skos:note "Country-specific values vary broadly and are not necessarily comparable",
              "Stratification by land use and soil texture" .

she:AllLandUses a skos:Concept ;
    skos:prefLabel "all land uses" .

she:HeavyMetalsAndOrganicPollutantsRisk a skos:Concept ;
    skos:prefLabel "exceedance of screening values for critical risk from heavy metals and organic pollutants" ;
    skos:note "Updated values for Cd, Cu, Pb and Zn (mg/kg) in this report",
              "Database developed (Cd, Cu, Pb, Zn, As, Hg, Ni, Cr)",
              "Organic pollutants" .

she:SoilErosion a skos:Concept ;
    skos:prefLabel "soil erosion" ;
    she:hasApplicationScope she:Agriculture ;
    she:hasIndicator she:WaterErosionLossRate ;
    skos:note "Soil formation rate: 0.3-1.4 t/ha/year (Verheijen et al., 2009)",
              "Preliminary thresholds, derivation of site-adapted tolerable soil loss rates recommended",
              "The current indicator description in this report includes only soil erosion by water, whereas the threshold addresses all other erosion types" .

she:Agriculture a skos:Concept ;
    skos:prefLabel "agriculture" .

she:WaterErosionLossRate a skos:Concept ;
    skos:prefLabel "exceedance of actual rate of soil loss by water erosion" ;
    she:hasSoilLossTolerance [
        she:value "2t/ha/year" ;
        she:appliesTo she:ShallowSoils ;
        skos:note "Loss rates lower than 2t/ha/year are mandatory on soils adjacent to water bodies and/or soils with elevated levels of pollutants; such lower limits are needed to maintain water quality."
    ],
    [
        she:value "4t/ha/year" ;
        she:appliesTo she:DeeperSoils
    ] .

she:ShallowSoils a skos:Concept ;
    skos:prefLabel "shallow soils (<70cm depth)" .

she:DeeperSoils a skos:Concept ;
    skos:prefLabel "deeper soils (≥70cm)" .

she:SoilBiodiversityLoss a skos:Concept ;
    skos:prefLabel "soil biodiversity loss" ;
    she:hasIndicator she:LossOfSoilBiodiversitySubIndicators ;
    skos:note "Requires sub-indicators by species and/ or (functional) group" .

she:LossOfSoilBiodiversitySubIndicators a skos:Concept ;
    skos:prefLabel "loss of soil biodiversity (sub-indicators)" ;
    skos:note "To be developed" ;
    she:hasPlannedIndicator she:SafeMinimumStandardsExceedance,
                             she:OperatingRangesExceedance .

she:SafeMinimumStandardsExceedance a skos:Concept ;
    skos:prefLabel "exceedance of safe minimum standards of ecosystem conservation" .

she:OperatingRangesExceedance a skos:Concept ;
    skos:prefLabel "exceedance of operating ranges (or) for specific soil animals and microorganisms" ;
    she:hasAbbreviation "OR" .

she:SoilCompaction a skos:Concept ;
    skos:prefLabel "soil compaction" ;
    she:hasIndicator she:HarmfulSubsoilCompactionSubIndicators ;
    skos:note "Exceedance of 'action values' (Zink et al., 2011)" .

she:HarmfulSubsoilCompactionSubIndicators a skos:Concept ;
    skos:prefLabel "harmful subsoil compaction (sub-indicators)" ;
    she:hasPriorityIndicator she:SaturatedHydraulicConductivity,
                             she:AirCapacity ;
    she:hasSecondaryIndicator she:BulkDensity,
                               she:InternalSoilStrength,
                               she:AirPermeability,
                               she:OxygenDiffusion .

she:SaturatedHydraulicConductivity a skos:Concept ;
    skos:prefLabel "saturated hydraulic conductivity (ks)" ;
    she:hasAbbreviation "Ks" ;
    she:hasThreshold "<10cm/day" .

she:AirCapacity a skos:Concept ;
    skos:prefLabel "air capacity (ac)" ;
    she:hasAbbreviation "AC" ;
    she:hasThreshold "<5%" .

she:BulkDensity a skos:Concept ;
    skos:prefLabel "bulk density" .

she:InternalSoilStrength a skos:Concept ;
    skos:prefLabel "internal soil strength" .

she:AirPermeability a skos:Concept ;
    skos:prefLabel "air permeability" .

she:OxygenDiffusion a skos:Concept ;
    skos:prefLabel "oxygen diffusion" .

she:SoilSealing a skos:Concept ;
    skos:prefLabel "soil sealing" ;
    she:hasIndicator she:SealedAreaPerTotalLandArea ;
    skos:note "National targets to achieve 'no net land take'" .

she:SealedAreaPerTotalLandArea a skos:Concept ;
    skos:prefLabel "sealed area per total land area" .
