@prefix she: <https://soilwise-he.github.io/soil-health#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

she:SoilSealingDataComparison2015 a skos:Concept ;
    skos:prefLabel "available national soil sealing data compared with copernicus data, 2015" ;
    skos:note "Table 9.3" ;
    skos:narrower she:BelgiumFlanders,
                  she:Austria,
                  she:Luxembourg .

she:Country a skos:Concept ;
    skos:prefLabel "country" .

she:CountrySize a skos:Concept ;
    skos:prefLabel "country size" .

she:SoilSealingAreaPercentage a skos:Concept ;
    skos:prefLabel "soil sealing (area, %)" ;
    skos:narrower she:NationalMethod,
                  she:EeaCopernicus .

she:NationalMethod a skos:Concept ;
    skos:prefLabel "national method" .

she:EeaCopernicus a skos:Concept ;
    skos:prefLabel "eea/copernicus" ;
    she:hasAbbreviation "EEA/Copernicus" .

she:BelgiumFlanders a skos:Concept ;
    skos:prefLabel "belgium (flanders)" ;
    she:hasCountrySize "13,625km²" ;
    she:hasNationalSoilSealingArea "1,935km²" ;
    she:hasNationalSoilSealingPercentage "14.2%" ;
    she:hasEeaCopernicusSoilSealingArea "1,212km²" ;
    she:hasEeaCopernicusSoilSealingPercentage "8.9%" .

she:Austria a skos:Concept ;
    skos:prefLabel "austria" ;
    she:hasCountrySize "83,882km²" ;
    she:hasNationalSoilSealingArea "2,298km²" ;
    she:hasNationalSoilSealingPercentage "2.7%" ;
    she:hasEeaCopernicusSoilSealingArea "1,475km²" ;
    she:hasEeaCopernicusSoilSealingPercentage "1.8%" .

she:Luxembourg a skos:Concept ;
    skos:prefLabel "luxembourg" ;
    she:hasCountrySize "2,593km²" ;
    she:hasNationalSoilSealingArea "176km²" ;
    she:hasNationalSoilSealingPercentage "6.8%" ;
    she:hasEeaCopernicusSoilSealingArea "49km²" ;
    she:hasEeaCopernicusSoilSealingPercentage "1.9%" ;
    skos:note "(a) Refers to the year 2018, as there are no data for 2015." .
