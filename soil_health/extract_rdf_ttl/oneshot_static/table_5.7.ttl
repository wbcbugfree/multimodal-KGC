@prefix she: <https://soilwise-he.github.io/soil-health#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

she:ScreeningValuesOrganicContaminantsIndustrialSoil a skos:Concept ;
    skos:prefLabel "screening values for potentially unacceptable risk (industrial soil use) for organic contaminants (mg/kg)" ;
    skos:note "B, Brussels; F, Flanders, W, Wallonia. For Finland, the upper guideline values are presented." ;
    skos:note "Not presented are countries where the intended land use is not clearly stated." ;
    skos:note "Until 2007, 13 countries had not reported any national SSVs for organic pollutants." ;
    skos:note "The list of substances in several national guidelines is larger than represented here." ;
    she:hasUnit "mg/kg" ;
    skos:narrower she:Benzene,
        she:Ethylbenzene,
        she:Toluene,
        she:Xylene,
        she:Naphthalene,
        she:Anthracene,
        she:BenzoAAnthracene,
        she:BenzoGHIPerylene,
        she:PAHsTotal,
        she:Dichloromethane,
        she:Trichloroethylene,
        she:Tetrachloromethane,
        she:Hexachlorobenzene,
        she:Phenol,
        she:CresolsSum,
        she:AtrazineP,
        she:PCB,
        she:MethylTButylEther,
        she:OneOneOneTrichloroethane,
        she:BenzoAPyrene .

she:BelgiumF a skos:Concept ;
    skos:prefLabel "belgium (f)" ;
    she:hasRegion "flanders" .

she:BelgiumB a skos:Concept ;
    skos:prefLabel "belgium (b)" ;
    she:hasRegion "brussels" .

she:BelgiumW a skos:Concept ;
    skos:prefLabel "belgium (w)" ;
    she:hasRegion "wallonia" .

she:Finland a skos:Concept ;
    skos:prefLabel "finland" ;
    skos:note "upper guideline values" .

she:Italy a skos:Concept ;
    skos:prefLabel "italy" .

she:Poland a skos:Concept ;
    skos:prefLabel "poland" .

she:Spain a skos:Concept ;
    skos:prefLabel "spain" .

she:Benzene a skos:Concept ;
    skos:prefLabel "benzene" ;
    she:hasScreeningValue [ she:hasCountry she:BelgiumF ; she:hasValue "1" ],
        [ she:hasCountry she:BelgiumB ; she:hasValue "1" ],
        [ she:hasCountry she:BelgiumW ; she:hasValue "0.6" ],
        [ she:hasCountry she:Finland ; she:hasValue "1" ],
        [ she:hasCountry she:Italy ; she:hasValue "2" ],
        [ she:hasCountry she:Poland ; she:hasValue "76.5" ],
        [ she:hasCountry she:Spain ; she:hasValue "10" ] .

