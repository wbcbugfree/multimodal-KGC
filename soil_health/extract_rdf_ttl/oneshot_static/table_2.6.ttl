@prefix she: <https://soilwise-he.github.io/soil-health#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

she:LowerSOCBenchmarksForGermanAgriculturalSoils a skos:Concept ;
    skos:prefLabel "site-specific lower soc benchmarks for german agricultural soils across different strata" ;
    skos:narrower she:ArableSoil,
        she:PermanentGrassland ;
    skos:note "Source: Compiled from Drexler et al. (2002)." .

she:ArableSoil a skos:Concept ;
    skos:prefLabel "arable soil" ;
    skos:narrower she:LowMAP,
        she:HighMAP .

she:PermanentGrassland a skos:Concept ;
    skos:prefLabel "permanent grassland" ;
    skos:narrower she:LowMAP,
        she:HighMAP .

she:Texture a skos:Concept ;
    skos:prefLabel "texture" ;
    skos:narrower she:Light,
        she:Medium,
        she:MediumII,
        she:HeavyI,
        she:HeavyII ;
    skos:note "(a) Light <12% clay, <50% silt; medium I 12-17% clay, <50% silt; medium II 17-25% clay; heavy I 25-35% clay; heavy II >35% clay." .

she:MeanAnnualPrecipitation a skos:Concept ;
    skos:prefLabel "mean annual precipitation" ;
    she:hasAbbreviation "MAP" ;
    skos:note "Unit: mm" .

she:LowMAP a skos:Concept ;
    skos:prefLabel "low map" ;
    skos:related she:MeanAnnualPrecipitation .

she:HighMAP a skos:Concept ;
    skos:prefLabel "high map" ;
    skos:related she:MeanAnnualPrecipitation .

she:LowerBenchmark a skos:Concept ;
    skos:prefLabel "lower benchmark" .

she:Light a skos:Concept ;
    skos:prefLabel "light" ;
    skos:definition "<12% clay, <50% silt" ;
    she:hasLowerSOCBenchmark [
        she:soilUse she:ArableSoil ;
        she:mapClass she:LowMAP ;
        she:mapThreshold "<700" ;
        she:benchmarkValue "0.7"
    ] , [
        she:soilUse she:ArableSoil ;
        she:mapClass she:HighMAP ;
        she:mapThreshold ">700" ;
        she:benchmarkValue "0.9"
    ] , [
        she:soilUse she:PermanentGrassland ;
        she:mapClass she:LowMAP ;
        she:mapThreshold "<650" ;
        she:benchmarkValue "1.4"
    ] , [
        she:soilUse she:PermanentGrassland ;
        she:mapClass she:HighMAP ;
        she:mapThreshold ">650" ;
        she:benchmarkValue "2.0"
    ] .

she:Medium a skos:Concept ;
    skos:prefLabel "medium" ;
    skos:definition "12-17% clay, <50% silt" ;
    skos:note "Labelled as medium I in footnotes" ;
    she:hasLowerSOCBenchmark [
        she:soilUse she:ArableSoil ;
        she:mapClass she:LowMAP ;
        she:mapThreshold "<850" ;
        she:benchmarkValue "1.0"
    ] , [
        she:soilUse she:ArableSoil ;
        she:mapClass she:HighMAP ;
        she:mapThreshold ">850" ;
        she:benchmarkValue "1.1"
    ] , [
        she:soilUse she:PermanentGrassland ;
        she:mapClass she:LowMAP ;
        she:mapThreshold "<950" ;
        she:benchmarkValue "2.3" ;
        skos:note "MAP threshold for permanent grassland medium texture is <950"
    ] , [
        she:soilUse she:PermanentGrassland ;
        she:mapClass she:HighMAP ;
        she:mapThreshold ">950" ;
        she:benchmarkValue "3.0"
    ] .

she:MediumII a skos:Concept ;
    skos:prefLabel "medium ii" ;
    skos:definition "17-25% clay" ;
    she:hasLowerSOCBenchmark [
        she:soilUse she:ArableSoil ;
        she:mapClass she:LowMAP ;
        she:mapThreshold "<1,000" ;
        she:benchmarkValue "1.1"
    ] , [
        she:soilUse she:ArableSoil ;
        she:mapClass she:HighMAP ;
        she:mapThreshold ">1,000" ;
        she:benchmarkValue "1.4"
    ] , [
        she:soilUse she:PermanentGrassland ;
        she:mapClass she:LowMAP ;
        she:mapThreshold "<1,250" ;
        she:benchmarkValue "2.7"
    ] , [
        she:soilUse she:PermanentGrassland ;
        she:mapClass she:HighMAP ;
        she:mapThreshold ">1,250" ;
        she:benchmarkValue "3.1"
    ] .

she:HeavyI a skos:Concept ;
    skos:prefLabel "heavy i" ;
    skos:definition "25-35% clay" ;
    she:hasLowerSOCBenchmark [
        she:soilUse she:ArableSoil ;
        she:mapClass she:LowMAP ;
        she:mapThreshold "<900" ;
        she:benchmarkValue "1.2"
    ] , [
        she:soilUse she:ArableSoil ;
        she:mapClass she:HighMAP ;
        she:mapThreshold ">900" ;
        she:benchmarkValue "1.4"
    ] , [
        she:soilUse she:PermanentGrassland ;
        she:mapClass she:LowMAP ;
        she:mapThreshold "<750" ;
        she:benchmarkValue "3.3"
    ] , [
        she:soilUse she:PermanentGrassland ;
        she:mapClass she:HighMAP ;
        she:mapThreshold ">750" ;
        she:benchmarkValue "3.7"
    ] .

she:HeavyII a skos:Concept ;
    skos:prefLabel "heavy ii" ;
    skos:definition ">35% clay" ;
    she:hasLowerSOCBenchmark [
        she:soilUse she:ArableSoil ;
        she:mapClass she:LowMAP ;
        she:mapThreshold "<900" ;
        she:benchmarkValue "1.5"
    ] , [
        she:soilUse she:ArableSoil ;
        she:mapClass she:HighMAP ;
        she:mapThreshold ">900" ;
        she:benchmarkValue "2.0"
    ] , [
        she:soilUse she:PermanentGrassland ;
        she:mapClass she:LowMAP ;
        she:mapThreshold "<750" ;
        she:benchmarkValue "3.7"
    ] , [
        she:soilUse she:PermanentGrassland ;
        she:mapClass she:HighMAP ;
        she:mapThreshold ">750" ;
        she:benchmarkValue "4.3"
    ] .
