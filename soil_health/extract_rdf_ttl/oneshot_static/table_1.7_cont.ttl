@prefix she: <https://soilwise-he.github.io/soil-health#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

she:Table1_7 a skos:Concept ;
    skos:narrower she:EUSoilStrategy2030,
        she:ZeroPollutionActionPlanForAirSoilAndWater ;
    skos:prefLabel "table 1.7 soil-related policy objectives and targets at eu and global levels (binding and incentive-based non-binding policies and measures) (cont.)" .

she:AchieveProgressInManagementOfContaminatedSites a skos:Concept ;
    skos:prefLabel "to achieve progress in the management of contaminated sites" .

she:BetterMonitorReportPreventAndRemedyPollution a skos:Concept ;
    skos:prefLabel "to better monitor, report, prevent and remedy pollution from air, water, soil and consumer products to levels that are no longer harmful to human health and the environment" .

she:By2050AllEUSoilEcosystemsAreInHealthyCondition a skos:Concept ;
    skos:prefLabel "by 2050, all eu soil ecosystems are in healthy condition and are thus more resilient" .

she:CombatDesertificationAndAchieveNoNetLandTake a skos:Concept ;
    skos:prefLabel "to combat desertification and to achieve no net land take, to restore degraded ecosystems including soils," .

she:ContributeToLandBasedClimateNeutralityBy2035 a skos:Concept ;
    skos:prefLabel "to contribute to (1) land-based climate neutrality by 2035, and (2) reducing the impact of soil pollution (on ecosystems, waters, human health)" .

she:EUSoilStrategy2030 a skos:Concept ;
    skos:prefLabel "eu soil strategy 2030 (ec, 2021e)" ;
    she:definesObjective she:AchieveProgressInManagementOfContaminatedSites,
        she:By2050AllEUSoilEcosystemsAreInHealthyCondition,
        she:CombatDesertificationAndAchieveNoNetLandTake,
        she:ContributeToLandBasedClimateNeutralityBy2035 .

she:FacilitateRemediationOfSoilPollution a skos:Concept ;
    skos:prefLabel "to facilitate remediation of soil pollution via (1) a monitoring framework on the state of pollution and (2) an outlook report, including a specific assessment of the evolution of human health and environmental impacts" .

she:ProposeNewLegislationCoveringSignificantPollutionSources a skos:Concept ;
    skos:prefLabel "to propose new legislation covering significant pollution sources, which are not yet addressed by other policies, strategies and protocols" .

she:ZeroPollutionActionPlanForAirSoilAndWater a skos:Concept ;
    skos:prefLabel "zero pollution action plan for air, soil and water (ec, 2021c)" ;
    she:definesObjective she:BetterMonitorReportPreventAndRemedyPollution,
        she:FacilitateRemediationOfSoilPollution,
        she:ProposeNewLegislationCoveringSignificantPollutionSources,
        she:ZeroPollutionAmbitionForAToxinFreeEnvironment .

she:ZeroPollutionAmbitionForAToxinFreeEnvironment a skos:Concept ;
    skos:prefLabel "a zero pollution ambition for a toxin-free environment, including for air, water and soil" .

