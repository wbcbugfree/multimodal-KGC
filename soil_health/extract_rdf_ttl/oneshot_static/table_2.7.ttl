@prefix she: <https://soilwise-he.github.io/soil-health#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

she:SocClayRatioAsIndex a skos:Concept ;
    skos:prefLabel "soc/clay ratio as an index of good soil structure" ;
    skos:narrower she:SocClayRatio,
                  she:SoilStructure .

she:SocClayRatio a skos:Concept ;
    skos:prefLabel "soc/clay ratio" ;
    skos:narrower she:RatioGreater0125,
                  she:Ratio01,
                  she:RatioLess007 .

she:RatioGreater0125 a skos:Concept ;
    skos:prefLabel ">0.125 (1/8)" ;
    skos:note "field-level optimum for good structural quality",
              "soc enriched relative to the clay content" ;
    she:indicates she:GoodStructuralQuality .

she:Ratio01 a skos:Concept ;
    skos:prefLabel "0.1 (1/10) (1/8-1/13)" ;
    skos:note "goal for farmers as minimum desired soc level" .

she:RatioLess007 a skos:Concept ;
    skos:prefLabel "<0.07 (1/13)" ;
    skos:note "structural soil quality is likely to be unacceptable",
              "soc depleted relative to the clay content" ;
    she:indicates she:UnacceptableSoilQuality .

she:SoilStructure a skos:Concept ;
    skos:prefLabel "soil structure" ;
    skos:note "vess, visual evaluation of soil structure; the score ranges from 1 (good structure) to 5 (poor structure)" ;
    she:evaluatedBy she:Vess ;
    skos:narrower she:VessLess3,
                  she:VessGreater3 .

she:Vess a skos:Concept ;
    skos:prefLabel "visual evaluation of soil structure" ;
    she:hasAbbreviation "VESS" .

she:VessLess3 a skos:Concept ;
    skos:prefLabel ">1/10 (vess <3)" ;
    she:indicates she:AcceptableOrGoodSoilStructure .

she:VessGreater3 a skos:Concept ;
    skos:prefLabel "< 1/10 (vess >3)" ;
    she:indicates she:DegradedSoilStructure .

she:GoodStructuralQuality a skos:Concept ;
    skos:prefLabel "good structural quality" .

she:UnacceptableSoilQuality a skos:Concept ;
    skos:prefLabel "unacceptable soil quality" .

she:AcceptableOrGoodSoilStructure a skos:Concept ;
    skos:prefLabel "acceptable or good soil structure" .

she:DegradedSoilStructure a skos:Concept ;
    skos:prefLabel "degraded soil structure" .
