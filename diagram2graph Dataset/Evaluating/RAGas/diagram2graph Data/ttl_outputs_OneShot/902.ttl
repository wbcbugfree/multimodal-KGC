@prefix she:  <https://soilwise-he.github.io/soil-health#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

she:Start a skos:Concept ;
    skos:prefLabel "start" ;
    skos:narrower she:HaveYouEverDrawBigFlowchart .

she:HaveYouEverDrawBigFlowchart a skos:Concept ;
    skos:prefLabel "have you ever draw big flowchart" ;
    she:ifYes she:ItsJustBoxesHowHardCanItBe ;
    she:ifNo she:Awesome .

she:ItsJustBoxesHowHardCanItBe a skos:Concept ;
    skos:prefLabel "it's just boxes how hard can it be?" ;
    skos:narrower she:Easy .

she:Easy a skos:Concept ;
    skos:prefLabel "easy" ;
    skos:narrower she:LangchainIsTheBestFrameworki .

she:LangchainIsTheBestFrameworki a skos:Concept ;
    skos:prefLabel "langchain is the best frameworki" ;
    skos:narrower she:End .

she:Awesome a skos:Concept ;
    skos:prefLabel "awesome" ;
    skos:narrower she:Draw .

she:Draw a skos:Concept ;
    skos:prefLabel "draw" ;
    skos:narrower she:Okay .

she:Okay a skos:Concept ;
    skos:prefLabel "okay" ;
    skos:narrower she:End .

she:End a skos:Concept ;
    skos:prefLabel "end" .
