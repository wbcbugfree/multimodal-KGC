@prefix she:  <https://soilwise-he.github.io/soil-health#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

she:Start a skos:Concept ;
    skos:prefLabel "start" ;
    she:leadsTo she:InputTotalScore .

she:InputTotalScore a skos:Concept ;
    skos:prefLabel "input total score" ;
    she:leadsTo she:IfTotalScoreGreaterThan800 .

she:IfTotalScoreGreaterThan800 a skos:Concept ;
    skos:prefLabel "if total score > 800" ;
    she:leadsToIfTrue she:GoodCollege ;
    she:leadsToIfFalse she:NotGoodCollege .

she:NotGoodCollege a skos:Concept ;
    skos:prefLabel "not good college" ;
    she:leadsTo she:End .

she:GoodCollege a skos:Concept ;
    skos:prefLabel "good college" ;
    she:leadsTo she:End .

she:End a skos:Concept ;
    skos:prefLabel "end" .
