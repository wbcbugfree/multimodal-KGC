@prefix she:  <https://soilwise-he.github.io/soil-health#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

she:Begin a skos:Concept ;
    skos:prefLabel "begin" ;
    she:precedes she:InputData .

she:InputData a skos:Concept ;
    skos:prefLabel "input data" ;
    she:precedes she:LookingForEntropy .

she:LookingForEntropy a skos:Concept ;
    skos:prefLabel "looking for entropy" ;
    she:precedes she:Gain .

she:Gain a skos:Concept ;
    skos:prefLabel "gain" ;
    she:precedes she:HighestGain .

she:HighestGain a skos:Concept ;
    skos:prefLabel "highest gain" ;
    she:precedes she:CreatingANodeBranch .

she:CreatingANodeBranch a skos:Concept ;
    skos:prefLabel "creating a node branch" ;
    she:precedes she:Finished .

she:Finished a skos:Concept ;
    skos:prefLabel "finished" ;
    she:leadsToIfNo she:LookingForEntropy ;
    she:leadsToIfYes she:Stop .

she:Stop a skos:Concept ;
    skos:prefLabel "stop" .
