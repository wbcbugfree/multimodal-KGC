@prefix she:  <https://soilwise-he.github.io/soil-health#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

she:Start a skos:Concept ;
    skos:prefLabel "start" ;
    she:leadsTo she:ReadInputN .

she:ReadInputN a skos:Concept ;
    skos:prefLabel "read" ;
    she:leadsTo she:InitializeVariablesMAndF .

she:InitializeVariablesMAndF a skos:Concept ;
    skos:prefLabel "m = 1 f = 1" ;
    she:leadsTo she:CalculateFactorialStep .

she:CalculateFactorialStep a skos:Concept ;
    skos:prefLabel "f = f * m" ;
    she:leadsTo she:CheckLoopCondition .

she:CheckLoopCondition a skos:Concept ;
    skos:prefLabel "m = n?" ;
    she:onFalse she:IncrementM ;
    she:onTrue she:PrintResult .

she:IncrementM a skos:Concept ;
    skos:prefLabel "m = m + 1" ;
    she:loopsTo she:CalculateFactorialStep .

she:PrintResult a skos:Concept ;
    skos:prefLabel "print" ;
    she:leadsTo she:EndProcess .

she:EndProcess a skos:Concept ;
    skos:prefLabel "end" .
