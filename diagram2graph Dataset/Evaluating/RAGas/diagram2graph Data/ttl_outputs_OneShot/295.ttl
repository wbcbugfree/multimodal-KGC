@prefix she:  <https://soilwise-he.github.io/soil-health#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

she:Begin a skos:Concept ;
    skos:prefLabel "begin" ;
    she:leadsTo she:DoYouUnderstandFlowcharts .

she:DoYouUnderstandFlowcharts a skos:Concept ;
    skos:prefLabel "do you understand flowcharts?" ;
    she:ifYesLeadsTo she:Great ;
    she:ifNoLeadsTo she:WouldYouLikeToStartWithTheBasics .

she:Great a skos:Concept ;
    skos:prefLabel "great!" ;
    she:leadsTo she:ExplainEveryone .

she:ExplainEveryone a skos:Concept ;
    skos:prefLabel "explain everyone" .

she:WouldYouLikeToStartWithTheBasics a skos:Concept ;
    skos:prefLabel "would you like to start with the basics?" ;
    she:ifYesLeadsTo she:ReadEachDetail ;
    she:ifNoLeadsTo she:FurtherReadingAboutFlowcharts .

she:ReadEachDetail a skos:Concept ;
    skos:prefLabel "read each detail" .

she:FurtherReadingAboutFlowcharts a skos:Concept ;
    skos:prefLabel "further reading about flowcharts" .
