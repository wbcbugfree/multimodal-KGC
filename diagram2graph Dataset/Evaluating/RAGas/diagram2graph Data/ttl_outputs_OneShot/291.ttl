@prefix she:  <https://soilwise-he.github.io/soil-health#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

she:Start a skos:Concept ;
    skos:prefLabel "start" ;
    she:initiatesProcess she:EnterWebsite .

she:EnterWebsite a skos:Concept ;
    skos:prefLabel "enter website" ;
    she:resultsIn she:Homepage .

she:Homepage a skos:Concept ;
    skos:prefLabel "homepage" ;
    she:promptsAction she:EnterDetails .

she:EnterDetails a skos:Concept ;
    skos:prefLabel "enter details" ;
    she:requiresValidation she:Correct .

she:Correct a skos:Concept ;
    skos:prefLabel "correct?" ;
    she:onSuccess she:Enter ;
    she:onFailure she:EnterAgain .

she:Enter a skos:Concept ;
    skos:prefLabel "enter" ;
    she:concludesProcessWith she:Stop .

she:Stop a skos:Concept ;
    skos:prefLabel "stop" .

she:EnterAgain a skos:Concept ;
    skos:prefLabel "enter again" ;
    she:repromptsFor she:EnterDetails .
