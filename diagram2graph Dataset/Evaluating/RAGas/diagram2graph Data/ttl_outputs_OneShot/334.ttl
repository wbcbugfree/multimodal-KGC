@prefix she:  <https://soilwise-he.github.io/soil-health#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

she:Start a skos:Concept ;
    skos:prefLabel "start" ;
    she:leadsTo she:InputVariables .

she:InputVariables a skos:Concept ;
    skos:prefLabel "input variables" ;
    she:leadsTo she:CalculateC .

she:CalculateC a skos:Concept ;
    skos:prefLabel "c = (f-32) * 519" ;
    she:leadsTo she:DisplayAllVariables .

she:DisplayAllVariables a skos:Concept ;
    skos:prefLabel "display all variables" ;
    she:leadsTo she:Stop .

she:Stop a skos:Concept ;
    skos:prefLabel "stop" .
