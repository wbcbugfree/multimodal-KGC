@prefix she:  <https://soilwise-he.github.io/soil-health#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

she:Begin a skos:Concept ;
    skos:prefLabel "begin" ;
    she:initiates she:GenerateInitialPopulation .

she:GenerateInitialPopulation a skos:Concept ;
    skos:prefLabel "generate initial population" ;
    she:nextStepIs she:ComputeFitnessOfEachIndividual .

she:ComputeFitnessOfEachIndividual a skos:Concept ;
    skos:prefLabel "compute the fitness of each individual" ;
    she:nextStepIs she:CheckAllPerson .

she:CheckAllPerson a skos:Concept ;
    skos:prefLabel "check all person" ;
    she:nextStepIs she:CategorizeThem .

she:CategorizeThem a skos:Concept ;
    skos:prefLabel "categorize them" ;
    she:nextStepIs she:Converging .

she:Converging a skos:Concept ;
    skos:prefLabel "converging ?" ;
    she:ifTrue she:End ;
    she:ifFalse she:ComputeFitnessOfEachIndividual .

she:End a skos:Concept ;
    skos:prefLabel "end" .
