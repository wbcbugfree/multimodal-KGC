@prefix she:  <https://soilwise-he.github.io/soil-health#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

she:Start a skos:Concept ;
    skos:prefLabel "start" ;
    she:leadsTo she:InitializeCount .

she:InitializeCount a skos:Concept ;
    skos:prefLabel "count = 1" ;
    she:leadsTo she:CheckCountCondition .

she:CheckCountCondition a skos:Concept ;
    skos:prefLabel "count <= 3" ;
    she:onYesLeadsTo she:InputData ;
    she:onNoLeadsTo she:Stop .

she:InputData a skos:Concept ;
    skos:prefLabel "input" ;
    she:leadsTo she:CalculateSimpleInterest .

she:CalculateSimpleInterest a skos:Concept ;
    skos:prefLabel "p * n * r / 100" ;
    she:leadsTo she:PrintResult .

she:PrintResult a skos:Concept ;
    skos:prefLabel "print" ;
    she:leadsTo she:IncrementCount .

she:IncrementCount a skos:Concept ;
    skos:prefLabel "count = count + 1" ;
    she:loopsBackTo she:CheckCountCondition .

she:Stop a skos:Concept ;
    skos:prefLabel "stop" .
