@prefix she:  <https://soilwise-he.github.io/soil-health#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

she:Start a skos:Concept ;
    skos:prefLabel "start" ;
    she:followedBy she:Input .

she:Input a skos:Concept ;
    skos:prefLabel "input" ;
    she:followedBy she:CalculateC .

she:CalculateC a skos:Concept ;
    skos:prefLabel "c=a+b" ;
    she:followedBy she:PrintB .

she:PrintB a skos:Concept ;
    skos:prefLabel "print b" ;
    she:followedBy she:End .

she:End a skos:Concept ;
    skos:prefLabel "end" .
