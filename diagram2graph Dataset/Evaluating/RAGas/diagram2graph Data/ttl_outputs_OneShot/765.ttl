@prefix she:  <https://soilwise-he.github.io/soil-health#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

she:Begin a skos:Concept ;
    skos:prefLabel "begin" ;
    she:leadsTo she:MakeCoffee .

she:MakeCoffee a skos:Concept ;
    skos:prefLabel "make coffee" ;
    she:leadsTo she:BrowseTheWeb .

she:BrowseTheWeb a skos:Concept ;
    skos:prefLabel "browse the web?" ;
    she:ifYes she:MakeCoffee ;
    she:ifNo she:OkayThen .

she:OkayThen a skos:Concept ;
    skos:prefLabel "okay then" ;
    she:leadsTo she:SeeYouLater .

she:SeeYouLater a skos:Concept ;
    skos:prefLabel "see you later" ;
    she:leadsTo she:ThingDone .

she:ThingDone a skos:Concept ;
    skos:prefLabel "thing done" .
