@prefix she:  <https://soilwise-he.github.io/soil-health#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

she:Fruits a skos:Concept ;
    skos:prefLabel "fruits" ;
    she:leadsTo she:InputMangoPitayaDurian .

she:InputMangoPitayaDurian a skos:Concept ;
    skos:prefLabel "input mango, pitaya, durian" ;
    she:leadsTo she:PreferMangoToPitaya .

she:PreferMangoToPitaya a skos:Concept ;
    skos:prefLabel "prefer mango to pitaya?" ;
    she:leadsToIfFalse she:PreferPitayaToDurian ;
    she:leadsToIfTrue she:PreferMangoToDurian .

she:PreferPitayaToDurian a skos:Concept ;
    skos:prefLabel "prefer pitaya to durian?" ;
    she:leadsToIfYes she:GoForMango ;
    she:leadsToIfNo she:GoForMango .

she:PreferMangoToDurian a skos:Concept ;
    skos:prefLabel "prefer mango to durian?" ;
    she:leadsToIfNo she:GoForPitaya ;
    she:leadsToIfYes she:GoForPitaya .

she:GoForMango a skos:Concept ;
    skos:prefLabel "go for mango" ;
    she:leadsTo she:End .

she:GoForPitaya a skos:Concept ;
    skos:prefLabel "go for pitaya" ;
    she:leadsTo she:End .

she:End a skos:Concept ;
    skos:prefLabel "end" .
