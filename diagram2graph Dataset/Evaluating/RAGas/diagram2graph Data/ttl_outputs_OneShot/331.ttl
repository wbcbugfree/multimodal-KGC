@prefix she:  <https://soilwise-he.github.io/soil-health#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

she:Start a skos:Concept ;
    skos:prefLabel "start" ;
    she:precedes she:TakeInputs .

she:TakeInputs a skos:Concept ;
    skos:prefLabel "take inputs" ;
    she:precedes she:CalculatePerimeter .

she:CalculatePerimeter a skos:Concept ;
    skos:prefLabel "perimeter = 2 * (length + width)" ;
    she:precedes she:PrintPerimeter .

she:PrintPerimeter a skos:Concept ;
    skos:prefLabel "print the perimeter" ;
    she:precedes she:End .

she:End a skos:Concept ;
    skos:prefLabel "end" .
