@prefix she:  <https://soilwise-he.github.io/soil-health#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

she:Start a skos:Concept ;
    skos:prefLabel "start" ;
    she:leadsTo she:ScanBarcode .

she:ScanBarcode a skos:Concept ;
    skos:prefLabel "scan bar code" ;
    she:leadsTo she:ReaderDecryptsAndSendsTo3DObjectManagementInterface .

she:ReaderDecryptsAndSendsTo3DObjectManagementInterface a skos:Concept ;
    skos:prefLabel "\"reader\" decrypts message and sends it to \"3d object management interface\"" ;
    she:leadsTo she:CheckWebsite .

she:CheckWebsite a skos:Concept ;
    skos:prefLabel "check the website" ;
    she:leadsTo she:BackendServerChecksAndComparesData .

she:BackendServerChecksAndComparesData a skos:Concept ;
    skos:prefLabel "the back-end server checks data and compares it with \"3d objects database\"" ;
    she:leadsTo she:DataMatchCheck .

she:DataMatchCheck a skos:Concept ;
    skos:prefLabel "does data match the detail in \"3d objects database\"" ;
    she:onYesPath she:The3DObjectIsDisplayedOnTheUserScreen ;
    she:onNoPath she:AnErrorMessageIsDisplayedOnTheUserScreen .

she:AnErrorMessageIsDisplayedOnTheUserScreen a skos:Concept ;
    skos:prefLabel "an error message is displayed on the user screen" .

she:The3DObjectIsDisplayedOnTheUserScreen a skos:Concept ;
    skos:prefLabel "the 3d object is displayed on the user screen" .
