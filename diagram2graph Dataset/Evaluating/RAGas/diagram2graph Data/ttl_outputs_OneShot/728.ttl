@prefix she:  <https://soilwise-he.github.io/soil-health#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

she:LampDoesntWork a skos:Concept ;
    skos:prefLabel "lamp doesn't work" ;
    she:leadsTo she:LampPluggedIn_1 .

she:LampPluggedIn_1 a skos:Concept ;
    skos:prefLabel "lamp plugged in?" ;
    she:hasNoOutcome she:PlugInLamp ;
    she:hasYesOutcome she:LampPluggedIn_2 .

she:PlugInLamp a skos:Concept ;
    skos:prefLabel "plug in lamp" .

she:LampPluggedIn_2 a skos:Concept ;
    skos:prefLabel "lamp plugged in?" ;
    she:hasYesOutcome she:ReplaceBulb ;
    she:hasNoOutcome she:PrintK .

she:ReplaceBulb a skos:Concept ;
    skos:prefLabel "replace bulb" .

she:PrintK a skos:Concept ;
    skos:prefLabel "print k" .
