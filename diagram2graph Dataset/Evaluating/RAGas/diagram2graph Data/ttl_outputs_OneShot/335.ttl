@prefix she:  <https://soilwise-he.github.io/soil-health#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

she:Start a skos:Concept ;
    skos:prefLabel "start" ;
    she:precedes she:InitializeCount .

she:InitializeCount a skos:Concept ;
    skos:prefLabel "count = 0" ;
    she:precedes she:PerformOperation .

she:PerformOperation a skos:Concept ;
    skos:prefLabel "operation" ;
    she:precedes she:IncrementCount .

she:IncrementCount a skos:Concept ;
    skos:prefLabel "count = count + 1" ;
    she:precedes she:CheckLoopCondition .

she:CheckLoopCondition a skos:Concept ;
    skos:prefLabel "is count < 10" ;
    she:leadsToIfTrue she:PerformOperation ;
    she:leadsToIfFalse she:Stop .

she:Stop a skos:Concept ;
    skos:prefLabel "stop" .
