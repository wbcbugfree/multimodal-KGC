@prefix she: <https://soilwise-he.github.io/soil-health#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

she:Start a skos:Concept ;
    skos:prefLabel "start" ;
    she:leadsTo she:EnterMeasurements .

she:EnterMeasurements a skos:Concept ;
    skos:prefLabel "enter measurements" ;
    she:leadsTo she:InputWidth,
                she:InputValueOfLong .

she:InputWidth a skos:Concept ;
    skos:prefLabel "input width" ;
    she:feedsInto she:WidthTimesLong .

she:InputValueOfLong a skos:Concept ;
    skos:prefLabel "input value of long" ;
    she:leadsTo she:InputLong .

she:InputLong a skos:Concept ;
    skos:prefLabel "input long" ;
    she:feedsInto she:WidthTimesLong .

she:WidthTimesLong a skos:Concept ;
    skos:prefLabel "width * long" ;
    she:produces she:AreaOfARectangle .

she:AreaOfARectangle a skos:Concept ;
    skos:prefLabel "area of a rectangle" ;
    she:leadsTo she:End .

she:End a skos:Concept ;
    skos:prefLabel "end" .
