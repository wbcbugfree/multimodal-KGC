@prefix she:  <https://soilwise-he.github.io/soil-health#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

she:LoginProfile a skos:Concept ;
    skos:prefLabel "login profile" ;
    she:initiatesProcess she:StillLoggedIn .

she:StillLoggedIn a skos:Concept ;
    skos:prefLabel "still logged in?" ;
    she:ifYesProceedsTo she:GoOn ;
    she:ifNoProceedsTo she:SessionTimeOut .

she:GoOn a skos:Concept ;
    skos:prefLabel "go on" ;
    she:proceedsTo she:StillLoggedIn .

she:SessionTimeOut a skos:Concept ;
    skos:prefLabel "session time out" ;
    she:proceedsTo she:LoginAgain .

she:LoginAgain a skos:Concept ;
    skos:prefLabel "login again" ;
    she:proceedsTo she:LoggedIn .

she:LoggedIn a skos:Concept ;
    skos:prefLabel "logged in?" ;
    she:ifYesProceedsTo she:GoOn ;
    she:ifNoProceedsTo she:PauseCounting .

she:PauseCounting a skos:Concept ;
    skos:prefLabel "pause counting" .
