@prefix she: <https://soilwise-he.github.io/soil-health#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

she:Start a skos:Concept ;
    skos:prefLabel "start" ;
    she:followedBy she:FillTheBathWithWater .

she:FillTheBathWithWater a skos:Concept ;
    skos:prefLabel "fill the bath with water" ;
    she:followedBy she:AddWarmWater .

she:AddWarmWater a skos:Concept ;
    skos:prefLabel "add warm water" ;
    she:followedBy she:GetIntoBath .

she:GetIntoBath a skos:Concept ;
    skos:prefLabel "get into bath" ;
    she:followedBy she:Wash .

she:Wash a skos:Concept ;
    skos:prefLabel "wash" ;
    she:followedBy she:ComeOut .

she:ComeOut a skos:Concept ;
    skos:prefLabel "come out" ;
    she:followedBy she:EmptyTheBathWater .

she:EmptyTheBathWater a skos:Concept ;
    skos:prefLabel "empty the bath water" ;
    she:followedBy she:GetDressed .

she:GetDressed a skos:Concept ;
    skos:prefLabel "get dressed" ;
    she:followedBy she:End .

she:End a skos:Concept ;
    skos:prefLabel "end" .
