@prefix she:  <https://soilwise-he.github.io/soil-health#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

she:Start a skos:Concept ;
    skos:prefLabel "start" ;
    she:leadsTo she:ReadTemp .

she:ReadTemp a skos:Concept ;
    skos:prefLabel "read temp" ;
    she:leadsTo she:TempLessThan32 .

she:TempLessThan32 a skos:Concept ;
    skos:prefLabel "temp < 32?" ;
    she:ifTrueLeadsTo she:GoOut ;
    she:ifFalseLeadsTo she:DontGoOut .

she:GoOut a skos:Concept ;
    skos:prefLabel "go out" ;
    she:leadsTo she:End .

she:DontGoOut a skos:Concept ;
    skos:prefLabel "don't go out" ;
    she:leadsTo she:End .

she:End a skos:Concept ;
    skos:prefLabel "end" .
