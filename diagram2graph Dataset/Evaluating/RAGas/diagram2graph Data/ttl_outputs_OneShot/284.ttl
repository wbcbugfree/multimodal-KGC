@prefix she:  <https://soilwise-he.github.io/soil-health#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

she:Start a skos:Concept ;
    skos:prefLabel "start" ;
    she:follows she:IdentifyProblem .

she:IdentifyProblem a skos:Concept ;
    skos:prefLabel "identify problem" ;
    she:follows she:WorkOnIt .

she:WorkOnIt a skos:Concept ;
    skos:prefLabel "work on it" ;
    she:follows she:NoteThemDownInADiagramOrTable .

she:NoteThemDownInADiagramOrTable a skos:Concept ;
    skos:prefLabel "note them down in a diagram or table." ;
    she:follows she:AskForAssistant .

she:AskForAssistant a skos:Concept ;
    skos:prefLabel "ask for assistant" ;
    she:follows she:NeedMoreHelp .

she:NeedMoreHelp a skos:Concept ;
    skos:prefLabel "need more help?" ;
    she:hasConditionalBranchYes she:FindSolutionsToTheRootCausesIdentified ;
    she:hasConditionalBranchNo she:AskForAssistant .

she:FindSolutionsToTheRootCausesIdentified a skos:Concept ;
    skos:prefLabel "find solutions to the root causes identified." ;
    she:follows she:End .

she:End a skos:Concept ;
    skos:prefLabel "end" .
