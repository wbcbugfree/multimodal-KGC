@prefix she:  <https://soilwise-he.github.io/soil-health#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

she:Begin a skos:Concept ;
    skos:prefLabel "begin" ;
    she:initiates she:Login .

she:Login a skos:Concept ;
    skos:prefLabel "login" ;
    she:proceedsToDecision she:LoginCorrect .

she:LoginCorrect a skos:Concept ;
    skos:prefLabel "login correct?" ;
    she:onIncorrect she:Login ;
    she:onCorrect she:FrontPage .

she:FrontPage a skos:Concept ;
    skos:prefLabel "front page" .
