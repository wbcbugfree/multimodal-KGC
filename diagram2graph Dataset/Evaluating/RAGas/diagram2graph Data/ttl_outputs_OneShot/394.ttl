@prefix she:  <https://soilwise-he.github.io/soil-health#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

she:Start a skos:Concept ;
    skos:prefLabel "start" ;
    she:followedBy she:PowerOn .

she:PowerOn a skos:Concept ;
    skos:prefLabel "power on" ;
    she:followedBy she:LookForPreviousData .

she:LookForPreviousData a skos:Concept ;
    skos:prefLabel "look for previous data" ;
    she:followedBy she:GenerateMapAndLocation .

she:GenerateMapAndLocation a skos:Concept ;
    skos:prefLabel "generate map and location" ;
    she:followedBy she:PlanRoute .

she:PlanRoute a skos:Concept ;
    skos:prefLabel "plan route" ;
    she:produces she:Route ;
    she:followedBy she:Stop .

she:Route a skos:Concept ;
    skos:prefLabel "route" .

she:Stop a skos:Concept ;
    skos:prefLabel "stop" .
