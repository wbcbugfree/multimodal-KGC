@prefix she:  <https://soilwise-he.github.io/soil-health#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

she:Begin a skos:Concept ;
    skos:prefLabel "begin" ;
    she:followedBy she:GenerateNewColony .

she:GenerateNewColony a skos:Concept ;
    skos:prefLabel "generate new colony" ;
    she:followedBy she:ColonyPerformanceEvaluation .

she:ColonyPerformanceEvaluation a skos:Concept ;
    skos:prefLabel "colony performance evaluation" ;
    she:followedBy she:BinarySearch .

she:BinarySearch a skos:Concept ;
    skos:prefLabel "binary search" ;
    she:followedBy she:CrowdingDistanceSorting .

she:CrowdingDistanceSorting a skos:Concept ;
    skos:prefLabel "crowding distance sorting" ;
    she:followedBy she:UpdateColony .

she:UpdateColony a skos:Concept ;
    skos:prefLabel "update colony" ;
    she:followedBy she:NeedMoreValues .

she:NeedMoreValues a skos:Concept ;
    skos:prefLabel "need more values?" ;
    she:branchesToYes she:End ;
    she:branchesToNo she:ColonyPerformanceEvaluation .

she:End a skos:Concept ;
    skos:prefLabel "end" .
