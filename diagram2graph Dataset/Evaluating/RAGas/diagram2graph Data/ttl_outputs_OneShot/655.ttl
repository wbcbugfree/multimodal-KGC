@prefix she:  <https://soilwise-he.github.io/soil-health#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

she:Start a skos:Concept ;
    skos:prefLabel "start" ;
    she:leadsTo she:ReadValue .

she:ReadValue a skos:Concept ;
    skos:prefLabel "read value" ;
    she:leadsTo she:TempLessThan32 .

she:TempLessThan32 a skos:Concept ;
    skos:prefLabel "temp < 32?" ;
    she:whenTrueLeadsTo she:PrintCold ;
    she:whenFalseLeadsTo she:PrintNotCold .

she:PrintCold a skos:Concept ;
    skos:prefLabel "print cold" ;
    she:leadsTo she:End .

she:PrintNotCold a skos:Concept ;
    skos:prefLabel "print not cold" ;
    she:leadsTo she:End .

she:End a skos:Concept ;
    skos:prefLabel "end" .
