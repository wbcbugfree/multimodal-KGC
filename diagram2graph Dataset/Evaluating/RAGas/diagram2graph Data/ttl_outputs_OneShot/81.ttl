@prefix she:  <https://soilwise-he.github.io/soil-health#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

she:Start a skos:Concept ;
    skos:prefLabel "start" ;
    she:leadsTo she:Read .

she:Read a skos:Concept ;
    skos:prefLabel "read" ;
    she:leadsTo she:InitializeVariables .

she:InitializeVariables a skos:Concept ;
    skos:prefLabel "m=1 f=1" ;
    she:leadsTo she:CalculateFactorialStep .

she:CalculateFactorialStep a skos:Concept ;
    skos:prefLabel "f=f*m" ;
    she:leadsTo she:CheckCondition .

she:CheckCondition a skos:Concept ;
    skos:prefLabel "m=n?" ;
    she:ifNoThen she:IncrementM ;
    she:ifYesThen she:Print .

she:IncrementM a skos:Concept ;
    skos:prefLabel "m=m+1" ;
    she:loopsBackTo she:CalculateFactorialStep .

she:Print a skos:Concept ;
    skos:prefLabel "print" ;
    she:leadsTo she:End .

she:End a skos:Concept ;
    skos:prefLabel "end" .
