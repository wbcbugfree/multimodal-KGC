@prefix she: <https://soilwise-he.github.io/soil-health#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

she:Start a skos:Concept ;
    skos:prefLabel "start" ;
    she:leadsTo she:HardWork .

she:HardWork a skos:Concept ;
    skos:prefLabel "hard work" ;
    she:leadsTo she:Franchise .

she:Franchise a skos:Concept ;
    skos:prefLabel "franchise" ;
    she:leadsTo she:Success .

she:Success a skos:Concept ;
    skos:prefLabel "success" ;
    she:onYesLeadsTo she:OrderMore ;
    she:onNoLeadsTo she:NewStrategy .

she:NewStrategy a skos:Concept ;
    skos:prefLabel "new strategy" ;
    she:returnsTo she:Franchise .

she:OrderMore a skos:Concept ;
    skos:prefLabel "order more" ;
    she:leadsTo she:Sold .

she:Sold a skos:Concept ;
    skos:prefLabel "sold" ;
    she:onYesLeadsTo she:Expandable ;
    she:onNoLeadsTo she:NewStrategy .

she:Expandable a skos:Concept ;
    skos:prefLabel "expandable" ;
    she:onYesLeadsTo she:OpenMoreStore ;
    she:onNoLeadsTo she:End .

she:OpenMoreStore a skos:Concept ;
    skos:prefLabel "open more store" ;
    she:returnsTo she:Success .

she:End a skos:Concept ;
    skos:prefLabel "end" .
