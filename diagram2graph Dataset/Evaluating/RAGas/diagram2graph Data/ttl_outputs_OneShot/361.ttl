@prefix she:  <https://soilwise-he.github.io/soil-health#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

she:Start a skos:Concept ;
    skos:prefLabel "start" ;
    she:precedes she:InputProcess .

she:InputProcess a skos:Concept ;
    skos:prefLabel "input" ;
    she:precedes she:CalculateArea .

she:CalculateArea a skos:Concept ;
    skos:prefLabel "area = width*height" ;
    she:precedes she:OutputHeight .

she:OutputHeight a skos:Concept ;
    skos:prefLabel "height" ;
    she:precedes she:Stop .

she:Stop a skos:Concept ;
    skos:prefLabel "stop" .
