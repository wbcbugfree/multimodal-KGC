@prefix she:  <https://soilwise-he.github.io/soil-health#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

she:Begin a skos:Concept ;
    skos:prefLabel "begin" ;
    she:precedes she:Lapping .

she:Lapping a skos:Concept ;
    skos:prefLabel "lapping" ;
    she:precedes she:DieSawing .

she:DieSawing a skos:Concept ;
    skos:prefLabel "die sawing" ;
    she:precedes she:DieBonding .

she:DieBonding a skos:Concept ;
    skos:prefLabel "die bonding" ;
    she:precedes she:Wire .

she:Wire a skos:Concept ;
    skos:prefLabel "wire" ;
    she:precedes she:Molding .

she:Molding a skos:Concept ;
    skos:prefLabel "molding" ;
    she:precedes she:Marketing .

she:Marketing a skos:Concept ;
    skos:prefLabel "marketing" ;
    she:precedes she:Plating .

she:Plating a skos:Concept ;
    skos:prefLabel "plating" ;
    she:precedes she:Sampling .

she:Sampling a skos:Concept ;
    skos:prefLabel "sampling" ;
    she:precedes she:Forming .

she:Forming a skos:Concept ;
    skos:prefLabel "forming" ;
    she:precedes she:End .

she:End a skos:Concept ;
    skos:prefLabel "end" .
