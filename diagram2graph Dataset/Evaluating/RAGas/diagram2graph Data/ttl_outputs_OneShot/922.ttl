@prefix she:  <https://soilwise-he.github.io/soil-health#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

she:Start a skos:Concept ;
    skos:prefLabel "start" ;
    she:leadsTo she:DeclareVariables .

she:DeclareVariables a skos:Concept ;
    skos:prefLabel "declare variable a, b, c, d, x1, x2, rp, ip" ;
    she:leadsTo she:CalculateDiscriminant .

she:CalculateDiscriminant a skos:Concept ;
    skos:prefLabel "calculate discriminant by d < b²- 4ac" ;
    she:leadsTo she:CheckDiscriminant .

she:CheckDiscriminant a skos:Concept ;
    skos:prefLabel "is d >= 0?" ;
    she:hasTruePath she:CalculateRealRoots ;
    she:hasFalsePath she:CalculateComplexParts .

she:CalculateRealRoots a skos:Concept ;
    skos:prefLabel "r1←(-b + √d) /2a\nr2←(-b + √d) /2a" ;
    she:leadsTo she:DisplayRoots .

she:CalculateComplexParts a skos:Concept ;
    skos:prefLabel "ip← -b/ 2a\nrp← √-d) /2a" ;
    she:leadsTo she:CalculateComplexRoots .

she:CalculateComplexRoots a skos:Concept ;
    skos:prefLabel "x1← ip + j*ip\nx2←rp - j*ip" ;
    she:leadsTo she:DisplayRoots .

she:DisplayRoots a skos:Concept ;
    skos:prefLabel "display r1 and r2" ;
    she:leadsTo she:End .

she:End a skos:Concept ;
    skos:prefLabel "end" .
