@prefix she:  <https://soilwise-he.github.io/soil-health#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

she:Start a skos:Concept ;
    skos:prefLabel "start" ;
    she:initiates she:Brainstorm .

she:Brainstorm a skos:Concept ;
    skos:prefLabel "brainstorm" ;
    she:produces she:TopicAssigned .

she:TopicAssigned a skos:Concept ;
    skos:prefLabel "topic assigned" ;
    she:proceedsTo she:Outline .

she:Outline a skos:Concept ;
    skos:prefLabel "outline" ;
    she:proceedsTo she:Discuss .

she:Discuss a skos:Concept ;
    skos:prefLabel "discuss" ;
    she:proceedsTo she:Draft ;
    she:returnsTo she:TopicAssigned .

she:Draft a skos:Concept ;
    skos:prefLabel "draft" ;
    she:proceedsTo she:DraftReview .

she:DraftReview a skos:Concept ;
    skos:prefLabel "draft review" ;
    she:ifApprovedProceedsTo she:Finish ;
    she:ifChangesRequiredReturnsTo she:Discuss .

she:Finish a skos:Concept ;
    skos:prefLabel "finish" .
