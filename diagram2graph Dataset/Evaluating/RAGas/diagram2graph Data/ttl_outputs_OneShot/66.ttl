@prefix she:  <https://soilwise-he.github.io/soil-health#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

she:Start a skos:Concept ;
    skos:prefLabel "start" ;
    she:nextStep she:PaymentGateway .

she:PaymentGateway a skos:Concept ;
    skos:prefLabel "payment gateway" ;
    she:nextStep she:EnterAmountAndMode .

she:EnterAmountAndMode a skos:Concept ;
    skos:prefLabel "enter your amount and mode" ;
    she:nextStep she:EnterCode .

she:EnterCode a skos:Concept ;
    skos:prefLabel "enter code" ;
    she:nextStep she:SelectGateway .

she:SelectGateway a skos:Concept ;
    skos:prefLabel "select gateway" ;
    she:nextStep she:Converging .

she:Converging a skos:Concept ;
    skos:prefLabel "converging?" ;
    she:ifYesThen she:End ;
    she:ifNoThen she:EnterAmountAndMode .

she:End a skos:Concept ;
    skos:prefLabel "end" .
