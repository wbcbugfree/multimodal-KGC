@prefix she: <https://soilwise-he.github.io/soil-health#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

she:Begin a skos:Concept ;
    skos:prefLabel "begin" ;
    she:leadsTo she:PickUpItem .

she:PickUpItem a skos:Concept ;
    skos:prefLabel "pick up item" ;
    she:leadsTo she:DoesThisItemSparkJoyForMe .

she:DoesThisItemSparkJoyForMe a skos:Concept ;
    skos:prefLabel "does this item spark joy for me?" ;
    she:ifNoLeadsTo she:Delete ;
    she:ifYesLeadsTo she:Save .

she:Delete a skos:Concept ;
    skos:prefLabel "delete" .

she:Save a skos:Concept ;
    skos:prefLabel "save" .
