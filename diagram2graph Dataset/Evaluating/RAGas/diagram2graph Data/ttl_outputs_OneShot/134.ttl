@prefix she: <https://soilwise-he.github.io/soil-health#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

she:Start a skos:Concept ;
    skos:prefLabel "start" ;
    she:hasNextStep she:ReadAI0AI1AndAI2 .

she:ReadAI0AI1AndAI2 a skos:Concept ;
    skos:prefLabel "read ai0, ai1 and ai2" ;
    she:hasNextStep she:ConvertValuesToStandard .

she:ConvertValuesToStandard a skos:Concept ;
    skos:prefLabel "convert values to standard" ;
    she:hasNextStep she:CurrentValueGreaterThanSafetyThresholds ;
    she:alsoLeadsTo she:PrintOutput .

she:CurrentValueGreaterThanSafetyThresholds a skos:Concept ;
    skos:prefLabel "current value > safety thresholds" ;
    she:ifTrueLeadsTo she:DisplayWarningWithVisualIndicator ;
    she:ifFalseLeadsTo she:PrintMessage .

she:DisplayWarningWithVisualIndicator a skos:Concept ;
    skos:prefLabel "display warning with visual indicator" ;
    she:loopsBackTo she:ConvertValuesToStandard .

she:PrintMessage a skos:Concept ;
    skos:prefLabel "print message" ;
    she:loopsBackTo she:ConvertValuesToStandard .

she:PrintOutput a skos:Concept ;
    skos:prefLabel "print output" ;
    she:hasNextStep she:LogTheDataInTxtFilesForFutureAnalysis .

she:LogTheDataInTxtFilesForFutureAnalysis a skos:Concept ;
    skos:prefLabel "log the data in txt files for future analysis" ;
    she:hasNextStep she:End .

she:End a skos:Concept ;
    skos:prefLabel "end" .
