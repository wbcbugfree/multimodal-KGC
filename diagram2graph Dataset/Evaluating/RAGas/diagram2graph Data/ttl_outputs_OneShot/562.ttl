@prefix she:  <https://soilwise-he.github.io/soil-health#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

she:Start a skos:Concept ;
    skos:prefLabel "start" ;
    she:leadsTo she:DocumentFilter .

she:DocumentFilter a skos:Concept ;
    skos:prefLabel "document-filter" ;
    she:leadsTo she:Screening .

she:Screening a skos:Concept ;
    skos:prefLabel "screening" ;
    she:leadsTo she:DocumentConverter .

she:DocumentConverter a skos:Concept ;
    skos:prefLabel "document-converter" ;
    she:leadsTo she:DocumentConverterTopic .

she:DocumentConverterTopic a skos:Concept ;
    skos:prefLabel "document-converter-topic" ;
    she:leadsTo she:Published .

she:Published a skos:Concept ;
    skos:prefLabel "published" ;
    she:branchesTo she:S3PublisherTopic,
                   she:WorkflowS3 .

she:S3PublisherTopic a skos:Concept ;
    skos:prefLabel "s3-publisher-topic" .

she:WorkflowS3 a skos:Concept ;
    skos:prefLabel "workflow-s3" .
