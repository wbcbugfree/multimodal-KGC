@prefix she:  <https://soilwise-he.github.io/soil-health#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

she:Start a skos:Concept ;
    skos:prefLabel "start" ;
    she:proceedsTo she:Initialize .

she:Initialize a skos:Concept ;
    skos:prefLabel "initialize" ;
    she:proceedsTo she:CheckCondition .

she:CheckCondition a skos:Concept ;
    skos:prefLabel "check condition" ;
    she:onTrueProceedsTo she:Initialize ;
    she:onFalseProceedsTo she:ExitLoop .

she:ExitLoop a skos:Concept ;
    skos:prefLabel "exit loop" ;
    she:proceedsTo she:Stop .

she:Stop a skos:Concept ;
    skos:prefLabel "stop" .
