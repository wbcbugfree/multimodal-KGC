@prefix she: <https://soilwise-he.github.io/soil-health#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

she:Start a skos:Concept ;
    skos:prefLabel "start" ;
    she:leadsTo she:Input .

she:Input a skos:Concept ;
    skos:prefLabel "input" ;
    she:leadsTo she:IfAngkaMod2Equals1 .

she:IfAngkaMod2Equals1 a skos:Concept ;
    skos:prefLabel "if (angka % 2 == 1)" ;
    she:onTrue she:PrimeNumber ;
    she:onFalse she:NonPrime .

she:PrimeNumber a skos:Concept ;
    skos:prefLabel "prime number" ;
    she:leadsTo she:Finish .

she:NonPrime a skos:Concept ;
    skos:prefLabel "non prime" ;
    she:leadsTo she:Finish .

she:Finish a skos:Concept ;
    skos:prefLabel "finish" .
