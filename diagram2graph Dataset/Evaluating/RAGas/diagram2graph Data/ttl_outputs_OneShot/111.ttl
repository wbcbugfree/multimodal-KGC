@prefix she:  <https://soilwise-he.github.io/soil-health#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

she:Start a skos:Concept ;
    skos:prefLabel "start" ;
    she:nextStep she:DoorBell .

she:DoorBell a skos:Concept ;
    skos:prefLabel "door bell" ;
    she:nextStep she:ReadyToGetUp .

she:ReadyToGetUp a skos:Concept ;
    skos:prefLabel "ready to get up?" ;
    she:ifConditionYes she:Wakeup ;
    she:ifConditionNo she:IgnoreBell .

she:Wakeup a skos:Concept ;
    skos:prefLabel "wakeup" ;
    she:nextStep she:End .

she:End a skos:Concept ;
    skos:prefLabel "end" .

she:Relay a skos:Concept ;
    skos:prefLabel "relay" ;
    she:triggers she:DoorBell .

she:IgnoreBell a skos:Concept ;
    skos:prefLabel "ignore bell" ;
    she:nextStep she:Relay .
