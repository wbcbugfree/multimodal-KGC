@prefix she:  <https://soilwise-he.github.io/soil-health#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

she:Begin a skos:Concept ;
    skos:prefLabel "begin" ;
    she:followedBy she:Has5Attempts .

she:Has5Attempts a skos:Concept ;
    skos:prefLabel "has 5 attempts" ;
    she:onYes she:Block ;
    she:onNo she:Login .

she:Block a skos:Concept ;
    skos:prefLabel "block" ;
    she:followedBy she:Alert .

she:Login a skos:Concept ;
    skos:prefLabel "login" ;
    she:followedBy she:Authorized .

she:Authorized a skos:Concept ;
    skos:prefLabel "authorized" ;
    she:onYes she:Allow ;
    she:onNo she:Has5Attempts .

she:Alert a skos:Concept ;
    skos:prefLabel "alert" ;
    she:followedBy she:Stop .

she:Allow a skos:Concept ;
    skos:prefLabel "allow" ;
    she:followedBy she:Stop .

she:Stop a skos:Concept ;
    skos:prefLabel "stop" .
