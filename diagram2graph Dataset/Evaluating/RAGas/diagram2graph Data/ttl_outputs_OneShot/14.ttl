@prefix she:  <https://soilwise-he.github.io/soil-health#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

she:Begin a skos:Concept ;
    skos:prefLabel "begin" ;
    she:leadsTo she:DoorKnock .

she:DoorKnock a skos:Concept ;
    skos:prefLabel "door knock" ;
    she:leadsTo she:ReadyToWakeUp .

she:ReadyToWakeUp a skos:Concept ;
    skos:prefLabel "ready to wake up" ;
    she:ifYesLeadsTo she:GetUp ;
    she:ifNoLeadsTo she:Sleep .

she:GetUp a skos:Concept ;
    skos:prefLabel "get up" .

she:Sleep a skos:Concept ;
    skos:prefLabel "sleep" ;
    she:leadsTo she:ForgetIt .

she:ForgetIt a skos:Concept ;
    skos:prefLabel "forget it" ;
    she:returnsTo she:DoorKnock .
