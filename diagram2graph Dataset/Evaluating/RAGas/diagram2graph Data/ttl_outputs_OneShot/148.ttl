@prefix she:  <https://soilwise-he.github.io/soil-health#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

she:Start a skos:Concept ;
    skos:prefLabel "start" ;
    she:precedes she:Initialize .

she:Initialize a skos:Concept ;
    skos:prefLabel "initialize" ;
    she:precedes she:CalculateL .

she:CalculateL a skos:Concept ;
    skos:prefLabel "l = p * l" ;
    she:precedes she:Print .

she:Print a skos:Concept ;
    skos:prefLabel "print" ;
    she:precedes she:End .

she:End a skos:Concept ;
    skos:prefLabel "end" .
