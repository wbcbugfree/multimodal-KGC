@prefix she:  <https://soilwise-he.github.io/soil-health#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

she:Start a skos:Concept ;
    skos:prefLabel "start" ;
    she:nextStep she:Process .

she:Process a skos:Concept ;
    skos:prefLabel "process" ;
    she:nextStep she:Decision .

she:Decision a skos:Concept ;
    skos:prefLabel "decision" ;
    she:nextStepIfNo she:EnjoyNoPath ;
    she:nextStepIfYes she:Data .

she:EnjoyNoPath a skos:Concept ;
    skos:prefLabel "enjoy" .

she:Data a skos:Concept ;
    skos:prefLabel "data" ;
    she:nextStep she:EnjoyYesPath .

she:EnjoyYesPath a skos:Concept ;
    skos:prefLabel "enjoy" ;
    she:nextStep she:End .

she:End a skos:Concept ;
    skos:prefLabel "end" .
