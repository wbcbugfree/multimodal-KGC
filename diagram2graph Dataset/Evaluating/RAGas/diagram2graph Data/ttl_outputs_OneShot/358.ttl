@prefix she:  <https://soilwise-he.github.io/soil-health#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

she:Start a skos:Concept ;
    skos:prefLabel "start" ;
    she:precedes she:EnterNumbers .

she:EnterNumbers a skos:Concept ;
    skos:prefLabel "enter numbers" ;
    she:precedes she:Process .

she:Process a skos:Concept ;
    skos:prefLabel "process" ;
    she:precedes she:Output .

she:Output a skos:Concept ;
    skos:prefLabel "output" ;
    she:precedes she:End .

she:End a skos:Concept ;
    skos:prefLabel "end" .
