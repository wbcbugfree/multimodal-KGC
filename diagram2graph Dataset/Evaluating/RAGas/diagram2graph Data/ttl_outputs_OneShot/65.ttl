@prefix she:  <https://soilwise-he.github.io/soil-health#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

she:Start a skos:Concept ;
    skos:prefLabel "start" ;
    she:nextStep she:Collide .

she:Collide a skos:Concept ;
    skos:prefLabel "collide" ;
    she:nextStep she:WakeUp .

she:WakeUp a skos:Concept ;
    skos:prefLabel "wake up" ;
    she:nextStep she:Run .

she:Run a skos:Concept ;
    skos:prefLabel "run" ;
    she:nextStep she:End .

she:End a skos:Concept ;
    skos:prefLabel "end" .
