@prefix she:  <https://soilwise-he.github.io/soil-health#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

she:Start a skos:Concept ;
    skos:prefLabel "start" ;
    skos:narrower she:HaveAnAccount .

she:HaveAnAccount a skos:Concept ;
    skos:prefLabel "have an account" ;
    she:ifYesProceedsTo she:Login ;
    she:ifNoProceedsTo she:Register .

she:Register a skos:Concept ;
    skos:prefLabel "register" ;
    skos:narrower she:SelectTheBusAndDateAndTime .

she:Login a skos:Concept ;
    skos:prefLabel "login" ;
    skos:narrower she:SelectTheBusAndDateAndTime .

she:SelectTheBusAndDateAndTime a skos:Concept ;
    skos:prefLabel "select the bus and date and time" ;
    skos:narrower she:ConfirmBooking .

she:ConfirmBooking a skos:Concept ;
    skos:prefLabel "confirm booking" ;
    she:ifConfirmedProceedsTo she:PaymentProcess ;
    she:ifNotConfirmedLoopsTo she:SelectTheBusAndDateAndTime .

she:PaymentProcess a skos:Concept ;
    skos:prefLabel "payment process" ;
    skos:narrower she:End .

she:End a skos:Concept ;
    skos:prefLabel "end" .
