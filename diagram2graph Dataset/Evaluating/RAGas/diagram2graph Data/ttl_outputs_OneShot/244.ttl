@prefix she:  <https://soilwise-he.github.io/soil-health#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

she:Start a skos:Concept ;
    skos:prefLabel "start" ;
    she:nextStep she:InputUsername .

she:InputUsername a skos:Concept ;
    skos:prefLabel "username" ;
    she:nextStep she:InputPassword .

she:InputPassword a skos:Concept ;
    skos:prefLabel "password" ;
    she:nextStep she:VerifyCredentials .

she:VerifyCredentials a skos:Concept ;
    skos:prefLabel "username && password correspond to the ones in database?" ;
    she:onYes she:ProcessLoginAttempt ;
    she:onNo she:InvalidCredentialsMessage .

she:InvalidCredentialsMessage a skos:Concept ;
    skos:prefLabel "\"invalid credentials\"" ;
    she:loopsBackTo she:InputUsername .

she:ProcessLoginAttempt a skos:Concept ;
    skos:prefLabel "enter id and password" ;
    she:nextStep she:CheckUserBlockedStatus .

she:CheckUserBlockedStatus a skos:Concept ;
    skos:prefLabel "is user_id blocked?" ;
    she:onYes she:ForbiddenStatus ;
    she:onNo she:LoginSuccessful .

she:ForbiddenStatus a skos:Concept ;
    skos:prefLabel "\"403 forbidden\"" ;
    she:loopsBackTo she:InputUsername .

she:LoginSuccessful a skos:Concept ;
    skos:prefLabel "login successfully" ;
    she:nextStep she:End .

she:End a skos:Concept ;
    skos:prefLabel "end" .
