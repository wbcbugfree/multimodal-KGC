@prefix she: <https://soilwise-he.github.io/soil-health#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

she:Begin a skos:Concept ;
    skos:prefLabel "begin" ;
    she:leadsTo she:AddSlackVariablesToInequalityConstraints .

she:AddSlackVariablesToInequalityConstraints a skos:Concept ;
    skos:prefLabel "add slack variables to inequality constraints" ;
    she:leadsTo she:CalculateVariables .

she:CalculateVariables a skos:Concept ;
    skos:prefLabel "calculate variables" ;
    she:leadsTo she:CalculateReducedGradient .

she:CalculateReducedGradient a skos:Concept ;
    skos:prefLabel "calculate reduced gradient" ;
    she:leadsTo she:DetermineSearchVector .

she:DetermineSearchVector a skos:Concept ;
    skos:prefLabel "determine search vector" ;
    she:leadsTo she:PerformOperations .

she:PerformOperations a skos:Concept ;
    skos:prefLabel "perform operations" ;
    she:leadsTo she:Converged .

she:Converged a skos:Concept ;
    skos:prefLabel "converged ?" ;
    she:ifNoLeadsTo she:CalculateVariables ;
    she:ifYesLeadsTo she:Exit .

she:Exit a skos:Concept ;
    skos:prefLabel "exit" .
