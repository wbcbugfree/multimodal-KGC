@prefix she:  <https://soilwise-he.github.io/soil-health#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

she:Begin a skos:Concept ;
    skos:prefLabel "begin" ;
    she:leadsTo she:InputN .

she:InputN a skos:Concept ;
    skos:prefLabel "input n" ;
    she:leadsTo she:CheckIfNEven .

she:CheckIfNEven a skos:Concept ;
    skos:prefLabel "n%2==0" ;
    she:onTrue she:EvenResult ;
    she:onFalse she:OddResult .

she:EvenResult a skos:Concept ;
    skos:prefLabel "even" ;
    she:leadsTo she:End .

she:OddResult a skos:Concept ;
    skos:prefLabel "odd" ;
    she:leadsTo she:End .

she:End a skos:Concept ;
    skos:prefLabel "end" .
