@prefix she: <https://soilwise-he.github.io/soil-health#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

she:Start a skos:Concept ;
    skos:prefLabel "start" ;
    she:leadsTo she:Process .

she:Process a skos:Concept ;
    skos:prefLabel "process" ;
    she:leadsTo she:Decision .

she:Decision a skos:Concept ;
    skos:prefLabel "decision" ;
    she:leadsTo she:Work,
                she:Sleep .

she:Work a skos:Concept ;
    skos:prefLabel "work" ;
    she:leadsToIfYes she:Enjoy ;
    she:leadsToIfNo she:Party .

she:Sleep a skos:Concept ;
    skos:prefLabel "sleep" ;
    she:leadsTo she:Home .

she:Home a skos:Concept ;
    skos:prefLabel "home" ;
    she:leadsTo she:End .

she:End a skos:Concept ;
    skos:prefLabel "end" .

she:Party a skos:Concept ;
    skos:prefLabel "party" .

she:Enjoy a skos:Concept ;
    skos:prefLabel "enjoy" .
