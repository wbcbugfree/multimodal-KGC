@prefix she:  <https://soilwise-he.github.io/soil-health#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

she:Begin a skos:Concept ;
    skos:prefLabel "begin" ;
    she:leadsTo she:DoYouWantToDoThis .

she:DoYouWantToDoThis a skos:Concept ;
    skos:prefLabel "do you want to do this?" ;
    she:ifNoThen she:DontDoIt ;
    she:ifYesThen she:WillItLikelyEndInDisaster .

she:DontDoIt a skos:Concept ;
    skos:prefLabel "don't do it" ;
    she:leadsTo she:End .

she:WillItLikelyEndInDisaster a skos:Concept ;
    skos:prefLabel "will it likely end in disaster?" ;
    she:ifNoThen she:DoIt ;
    she:ifYesThen she:GoodMovie .

she:DoIt a skos:Concept ;
    skos:prefLabel "do it" ;
    she:leadsTo she:End .

she:GoodMovie a skos:Concept ;
    skos:prefLabel "good movie?" ;
    she:ifNoThen she:DontDoIt ;
    she:ifYesThen she:DoIt .

she:End a skos:Concept ;
    skos:prefLabel "end" .
