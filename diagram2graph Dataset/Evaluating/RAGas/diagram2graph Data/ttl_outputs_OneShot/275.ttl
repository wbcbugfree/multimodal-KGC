@prefix she: <https://soilwise-he.github.io/soil-health#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

she:SelectTopic a skos:Concept ;
    skos:prefLabel "select topic" ;
    she:leadsTo she:BackgroundSearch .

she:BackgroundSearch a skos:Concept ;
    skos:prefLabel "background search" ;
    she:leadsTo she:DevelopSearchStrategy .

she:DevelopSearchStrategy a skos:Concept ;
    skos:prefLabel "develop search strategy" ;
    she:leadsTo she:TaskAssign,
                she:RevisionOfPaper .

she:TaskAssign a skos:Concept ;
    skos:prefLabel "task assign" ;
    she:leadsTo she:EvaluateInformationForAccuracyAndReliability .

she:EvaluateInformationForAccuracyAndReliability a skos:Concept ;
    skos:prefLabel "evaluate information for accuracy & reliability" ;
    she:leadsTo she:DiscussWithOthers .

she:DiscussWithOthers a skos:Concept ;
    skos:prefLabel "discuss with others" ;
    she:leadsTo she:RevisionOfPaper .

she:RevisionOfPaper a skos:Concept ;
    skos:prefLabel "revision of paper" ;
    she:leadsTo she:Report,
                she:Submit .

she:Report a skos:Concept ;
    skos:prefLabel "report" .

she:Submit a skos:Concept ;
    skos:prefLabel "submit" .
