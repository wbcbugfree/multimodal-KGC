@prefix she:  <https://soilwise-he.github.io/soil-health#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

she:Start a skos:Concept ;
    skos:prefLabel "start" ;
    she:precedes she:ReadInputs .

she:ReadInputs a skos:Concept ;
    skos:prefLabel "read inputs" ;
    she:precedes she:ClaculateS .

she:ClaculateS a skos:Concept ;
    skos:prefLabel "claculate s" ;
    she:precedes she:CalculateAreaFormula .

she:CalculateAreaFormula a skos:Concept ;
    skos:prefLabel "calculate area = sqrt(s*(s-a)*(s-b)*(s-c))" ;
    she:precedes she:PrintArea .

she:PrintArea a skos:Concept ;
    skos:prefLabel "print area" ;
    she:precedes she:End .

she:End a skos:Concept ;
    skos:prefLabel "end" .
