@prefix she: <https://soilwise-he.github.io/soil-health#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

she:Start a skos:Concept ;
    skos:prefLabel "start" ;
    she:leadsTo she:ApprovalNeeded .

she:ApprovalNeeded a skos:Concept ;
    skos:prefLabel "approval needed?" ;
    she:ifYesLeadsTo she:GoToManager ;
    she:ifNoLeadsTo she:Finished .

she:GoToManager a skos:Concept ;
    skos:prefLabel "go to manager" .

she:Finished a skos:Concept ;
    skos:prefLabel "finished" .
