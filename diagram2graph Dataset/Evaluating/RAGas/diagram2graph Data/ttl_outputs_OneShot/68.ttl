@prefix she:  <https://soilwise-he.github.io/soil-health#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

she:Begin a skos:Concept ;
    skos:prefLabel "begin" ;
    she:leadsTo she:PourColdWater .

she:PourColdWater a skos:Concept ;
    skos:prefLabel "pour cold water" ;
    she:leadsTo she:SetWaterLevelReached .

she:SetWaterLevelReached a skos:Concept ;
    skos:prefLabel "set water level reached?" ;
    she:ifNoThen she:PourColdWater ;
    she:ifYesThen she:PourHotWater .

she:PourHotWater a skos:Concept ;
    skos:prefLabel "pour hot water" ;
    she:leadsTo she:CheckWaterTemperature .

she:CheckWaterTemperature a skos:Concept ;
    skos:prefLabel "check water temperature" ;
    she:ifNoThen she:PourHotWater ;
    she:ifYesThen she:WashingProcessPumpON .

she:WashingProcessPumpON a skos:Concept ;
    skos:prefLabel "washing process (pump on)" ;
    she:leadsTo she:CheckTimeLimit .

she:CheckTimeLimit a skos:Concept ;
    skos:prefLabel "check time limit" ;
    she:ifNoThen she:WashingProcessPumpON ;
    she:ifYesThen she:End .

she:End a skos:Concept ;
    skos:prefLabel "end" .
