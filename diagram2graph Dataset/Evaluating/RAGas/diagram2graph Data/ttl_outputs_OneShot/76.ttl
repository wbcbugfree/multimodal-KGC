@prefix she:  <https://soilwise-he.github.io/soil-health#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

she:Start a skos:Concept ;
    skos:prefLabel "start" ;
    she:leadsTo she:IsItNecessary .

she:IsItNecessary a skos:Concept ;
    skos:prefLabel "is it necessary?" ;
    she:leadsToIfNo she:DontDoIt ;
    she:leadsToIfYes she:WillItFail .

she:DontDoIt a skos:Concept ;
    skos:prefLabel "don't do it!" .

she:WillItFail a skos:Concept ;
    skos:prefLabel "will it fail?" ;
    she:leadsToIfNo she:DoIt ;
    she:leadsToIfYes she:Knowledge .

she:Knowledge a skos:Concept ;
    skos:prefLabel "knowledge" ;
    she:leadsToIfNo she:DontDoIt ;
    she:leadsToIfYes she:DoIt .

she:DoIt a skos:Concept ;
    skos:prefLabel "do it!" .
