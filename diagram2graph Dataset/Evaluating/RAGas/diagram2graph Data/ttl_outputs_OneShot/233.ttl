@prefix she: <https://soilwise-he.github.io/soil-health#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

she:Start a skos:Concept ;
    skos:prefLabel "start" ;
    she:leadsTo she:AreYouHappy .

she:AreYouHappy a skos:Concept ;
    skos:prefLabel "are you happy?" ;
    she:ifYes she:VeryGoodHaveAGreatDay ;
    she:ifNo she:WantToBeHappy .

she:VeryGoodHaveAGreatDay a skos:Concept ;
    skos:prefLabel "very good, have a great day!" ;
    she:leadsTo she:Finish .

she:Finish a skos:Concept ;
    skos:prefLabel "finish" .

she:WantToBeHappy a skos:Concept ;
    skos:prefLabel "want to be happy?" ;
    she:ifYes she:VeryGoodThenYouAreAlreadyHappy ;
    she:ifNo she:StayFit .

she:VeryGoodThenYouAreAlreadyHappy a skos:Concept ;
    skos:prefLabel "very good, then you are already happy" ;
    she:leadsTo she:Finish .

she:StayFit a skos:Concept ;
    skos:prefLabel "stay fit" ;
    she:loopsBackTo she:Start .
