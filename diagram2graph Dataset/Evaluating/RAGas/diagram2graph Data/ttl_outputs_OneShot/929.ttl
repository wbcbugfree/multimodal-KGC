@prefix she:  <https://soilwise-he.github.io/soil-health#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

she:Start a skos:Concept ;
    skos:prefLabel "start" ;
    she:initiates she:InputN .

she:InputN a skos:Concept ;
    skos:prefLabel "input n" ;
    she:leadsToCalculation she:CalculateRemainder .

she:CalculateRemainder a skos:Concept ;
    skos:prefLabel "remainder = n modulo 2" ;
    she:leadsToDecision she:CheckRemainderZero .

she:CheckRemainderZero a skos:Concept ;
    skos:prefLabel "remainder = 0?" ;
    she:ifTrue she:SetAnswerEven ;
    she:ifFalse she:SetAnswerOdd .

she:SetAnswerEven a skos:Concept ;
    skos:prefLabel "answer = even" ;
    she:leadsToOutput she:OutputAnswer .

she:SetAnswerOdd a skos:Concept ;
    skos:prefLabel "answer = odd" ;
    she:leadsToOutput she:OutputAnswer .

she:OutputAnswer a skos:Concept ;
    skos:prefLabel "output answer" ;
    she:concludesProcess she:End .

she:End a skos:Concept ;
    skos:prefLabel "end" .
