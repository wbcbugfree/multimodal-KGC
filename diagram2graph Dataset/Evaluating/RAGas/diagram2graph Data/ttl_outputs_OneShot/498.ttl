@prefix she:  <https://soilwise-he.github.io/soil-health#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

she:Start a skos:Concept ;
    skos:prefLabel "start" ;
    she:follows she:Initialize .

she:Initialize a skos:Concept ;
    skos:prefLabel "initialize" ;
    she:follows she:CalculateAverage .

she:CalculateAverage a skos:Concept ;
    skos:prefLabel "average = (num1+num2)/2" ;
    she:follows she:PrintAverage .

she:PrintAverage a skos:Concept ;
    skos:prefLabel "print average" ;
    she:follows she:End .

she:End a skos:Concept ;
    skos:prefLabel "end" .
