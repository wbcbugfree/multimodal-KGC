@prefix she:  <https://soilwise-he.github.io/soil-health#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

she:Start a skos:Concept ;
    skos:prefLabel "start" ;
    she:precedes she:InitializeVariables .

she:InitializeVariables a skos:Concept ;
    skos:prefLabel "sum = 0 n = 50" ;
    she:precedes she:UpdateProcess .

she:UpdateProcess a skos:Concept ;
    skos:prefLabel "update" ;
    she:precedes she:AddNToSum .

she:AddNToSum a skos:Concept ;
    skos:prefLabel "sum = sum + n" ;
    she:precedes she:IsNEqualTo99 .

she:IsNEqualTo99 a skos:Concept ;
    skos:prefLabel "n = 99?" ;
    she:ifConditionIsFalse she:UpdateProcess ;
    she:ifConditionIsTrue she:OutputSum .

she:OutputSum a skos:Concept ;
    skos:prefLabel "print sum" ;
    she:precedes she:EndProcess .

she:EndProcess a skos:Concept ;
    skos:prefLabel "end" .
