@prefix she:  <https://soilwise-he.github.io/soil-health#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

she:Start a skos:Concept ;
    skos:prefLabel "start" ;
    she:startsProcess she:ObjectDetectedInLeft .

she:ObjectDetectedInLeft a skos:Concept ;
    skos:prefLabel "object detected in left" ;
    she:onYes she:TurnLeft ;
    she:onNo she:ObjectDetectedInRight .

she:TurnLeft a skos:Concept ;
    skos:prefLabel "turn left" ;
    she:continuesTo she:ObjectDetectedInLeft .

she:ObjectDetectedInRight a skos:Concept ;
    skos:prefLabel "object detected in right" ;
    she:onYes she:TurnRight ;
    she:onNo she:ObjectDetectedInLeft .

she:TurnRight a skos:Concept ;
    skos:prefLabel "turn right" ;
    she:continuesTo she:ObjectDetectedInLeft .
