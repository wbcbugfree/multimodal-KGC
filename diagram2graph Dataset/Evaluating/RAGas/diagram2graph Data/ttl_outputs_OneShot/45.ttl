@prefix she:  <https://soilwise-he.github.io/soil-health#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

she:Start a skos:Concept ;
    skos:prefLabel "start" ;
    she:leadsTo she:Process1 .

she:Process1 a skos:Concept ;
    skos:prefLabel "process 1" ;
    she:leadsTo she:Decision .

she:Decision a skos:Concept ;
    skos:prefLabel "decision" ;
    she:leadsToIfNo she:Process2 ;
    she:leadsToIfYes she:Process3 .

she:Process2 a skos:Concept ;
    skos:prefLabel "process 2" ;
    she:leadsTo she:Process1 .

she:Process3 a skos:Concept ;
    skos:prefLabel "process 3" ;
    she:leadsTo she:Stop .

she:Stop a skos:Concept ;
    skos:prefLabel "stop" .
