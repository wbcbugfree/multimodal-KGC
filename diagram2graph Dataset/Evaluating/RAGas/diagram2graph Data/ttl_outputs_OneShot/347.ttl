@prefix she:  <https://soilwise-he.github.io/soil-health#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

she:Start a skos:Concept ;
    skos:prefLabel "start" ;
    she:precedes she:Inputs .

she:Inputs a skos:Concept ;
    skos:prefLabel "inputs" ;
    she:precedes she:FindArea .

she:FindArea a skos:Concept ;
    skos:prefLabel "find area" ;
    she:precedes she:Display .

she:Display a skos:Concept ;
    skos:prefLabel "display" ;
    she:precedes she:Stop .

she:Stop a skos:Concept ;
    skos:prefLabel "stop" .
