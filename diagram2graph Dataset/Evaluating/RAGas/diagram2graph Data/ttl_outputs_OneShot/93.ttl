@prefix she:  <https://soilwise-he.github.io/soil-health#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

she:Start a skos:Concept ;
    skos:prefLabel "start" ;
    she:proceedsTo she:Initialize .

she:Initialize a skos:Concept ;
    skos:prefLabel "initialize" ;
    she:proceedsTo she:Decision .

she:Decision a skos:Concept ;
    skos:prefLabel "decision" ;
    she:ifNoProceedsTo she:Update ;
    she:ifYesProceedsTo she:End .

she:Update a skos:Concept ;
    skos:prefLabel "update" ;
    she:loopsBackTo she:Initialize .

she:End a skos:Concept ;
    skos:prefLabel "end" .
