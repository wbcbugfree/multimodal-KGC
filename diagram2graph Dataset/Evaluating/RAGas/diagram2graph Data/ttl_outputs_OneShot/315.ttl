@prefix she:  <https://soilwise-he.github.io/soil-health#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

she:Start a skos:Concept ;
    skos:prefLabel "start" ;
    she:hasNextStep she:Initialize .

she:Initialize a skos:Concept ;
    skos:prefLabel "initialize" ;
    she:hasNextStep she:CalculateSum .

she:CalculateSum a skos:Concept ;
    skos:prefLabel "sum=a+b" ;
    she:hasNextStep she:PrintValueOfSum .

she:PrintValueOfSum a skos:Concept ;
    skos:prefLabel "print value of sum" ;
    she:hasNextStep she:Stop .

she:Stop a skos:Concept ;
    skos:prefLabel "stop" .
