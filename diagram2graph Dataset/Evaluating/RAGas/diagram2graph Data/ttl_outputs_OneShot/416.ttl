@prefix she:  <https://soilwise-he.github.io/soil-health#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

she:Start a skos:Concept ;
    skos:prefLabel "start" ;
    she:leadsTo she:GreetCustomer .

she:GreetCustomer a skos:Concept ;
    skos:prefLabel "greet customer" ;
    she:leadsTo she:TalkWithThem .

she:TalkWithThem a skos:Concept ;
    skos:prefLabel "talk with them" ;
    she:leadsTo she:NeedHelp .

she:NeedHelp a skos:Concept ;
    skos:prefLabel "need help" ;
    she:ifYesLeadsTo she:CallManager ;
    she:ifNoLeadsTo she:End .

she:CallManager a skos:Concept ;
    skos:prefLabel "call manager" ;
    she:leadsTo she:ManagerAssist .

she:ManagerAssist a skos:Concept ;
    skos:prefLabel "manager assist" ;
    she:leadsTo she:End .

she:End a skos:Concept ;
    skos:prefLabel "end" .
