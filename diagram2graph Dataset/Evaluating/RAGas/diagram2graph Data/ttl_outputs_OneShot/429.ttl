@prefix she: <https://soilwise-he.github.io/soil-health#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

she:Begin a skos:Concept ;
    skos:prefLabel "begin" ;
    she:leadsTo she:ReadN .

she:ReadN a skos:Concept ;
    skos:prefLabel "read n" ;
    she:leadsTo she:InitializeM .

she:InitializeM a skos:Concept ;
    skos:prefLabel "m = 1" ;
    she:leadsTo she:InitializeF .

she:InitializeF a skos:Concept ;
    skos:prefLabel "f = 1" ;
    she:leadsTo she:MultiplyFByM .

she:MultiplyFByM a skos:Concept ;
    skos:prefLabel "f = f * m" ;
    she:leadsTo she:CheckMIsEqualToN .

she:CheckMIsEqualToN a skos:Concept ;
    skos:prefLabel "m = n?" ;
    she:onNoPathLeadsTo she:IncrementM ;
    she:onYesPathLeadsTo she:PrintF .

she:IncrementM a skos:Concept ;
    skos:prefLabel "m = m + 1" ;
    she:leadsTo she:MultiplyFByM .

she:PrintF a skos:Concept ;
    skos:prefLabel "print f" .
