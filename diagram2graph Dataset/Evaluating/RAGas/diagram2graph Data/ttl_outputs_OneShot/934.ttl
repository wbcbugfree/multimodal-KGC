@prefix she: <https://soilwise-he.github.io/soil-health#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

she:Start a skos:Concept ;
    skos:prefLabel "start" ;
    she:proceedsTo she:Homepage .

she:Homepage a skos:Concept ;
    skos:prefLabel "homepage" ;
    she:proceedsTo she:HaveAnAccount .

she:HaveAnAccount a skos:Concept ;
    skos:prefLabel "have an account" ;
    she:onNo she:SignUp ;
    she:onYes she:LogIn .

she:SignUp a skos:Concept ;
    skos:prefLabel "sign up" ;
    she:proceedsTo she:FillOutTheInformation .

she:FillOutTheInformation a skos:Concept ;
    skos:prefLabel "fill out the information" ;
    she:proceedsTo she:Submit .

she:Submit a skos:Concept ;
    skos:prefLabel "submit" ;
    she:proceedsTo she:LogIn .

she:LogIn a skos:Concept ;
    skos:prefLabel "log in" ;
    she:proceedsTo she:EnterDetails .

she:EnterDetails a skos:Concept ;
    skos:prefLabel "enter details" ;
    she:proceedsTo she:EmailAndPasswordValid .

she:EmailAndPasswordValid a skos:Concept ;
    skos:prefLabel "e-mail and password valid" ;
    she:onNo she:LogIn ;
    she:onYes she:LoggedInToTheSystem .

she:LoggedInToTheSystem a skos:Concept ;
    skos:prefLabel "logged in to the system" ;
    she:proceedsTo she:End .

she:End a skos:Concept ;
    skos:prefLabel "end" .
