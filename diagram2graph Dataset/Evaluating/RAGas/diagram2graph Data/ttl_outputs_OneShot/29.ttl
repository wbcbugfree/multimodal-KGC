@prefix she:  <https://soilwise-he.github.io/soil-health#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

she:Start a skos:Concept ;
    skos:prefLabel "start" ;
    she:leadsTo she:TakeAllValues .

she:TakeAllValues a skos:Concept ;
    skos:prefLabel "take all values" ;
    she:leadsTo she:InputHoursPerWeek .

she:InputHoursPerWeek a skos:Concept ;
    skos:prefLabel "input hours per week" ;
    she:leadsTo she:CalculateWeeklyPay .

she:CalculateWeeklyPay a skos:Concept ;
    skos:prefLabel "hourly pay x hours per week" ;
    she:leadsTo she:CheckWeeklyPayCondition .

she:CheckWeeklyPayCondition a skos:Concept ;
    skos:prefLabel "weeklypay > 400" ;
    she:ifTrueLeadsTo she:OutputCanAffordToLiveAlong ;
    she:ifFalseLeadsTo she:PoorCondition .

she:OutputCanAffordToLiveAlong a skos:Concept ;
    skos:prefLabel "output can afford to live along" ;
    she:leadsTo she:End .

she:PoorCondition a skos:Concept ;
    skos:prefLabel "poor condition" ;
    she:leadsTo she:End .

she:End a skos:Concept ;
    skos:prefLabel "end" .
