@prefix she:  <https://soilwise-he.github.io/soil-health#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

she:Start a skos:Concept ;
    skos:prefLabel "start" ;
    she:nextStepIs she:InputF .

she:InputF a skos:Concept ;
    skos:prefLabel "input f" ;
    she:nextStepIs she:CalculateC .

she:CalculateC a skos:Concept ;
    skos:prefLabel "c=5/9*(f-32)" ;
    she:nextStepIs she:PrintC .

she:PrintC a skos:Concept ;
    skos:prefLabel "print c" ;
    she:nextStepIs she:End .

she:End a skos:Concept ;
    skos:prefLabel "end" .
