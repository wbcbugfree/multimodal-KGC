@prefix she:  <https://soilwise-he.github.io/soil-health#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

she:AnalogRetrieval a skos:Concept ;
    skos:prefLabel "analog retrieval" ;
    she:performsLearningToReach she:Sampling .

she:Sampling a skos:Concept ;
    skos:prefLabel "sampling" ;
    she:performsSelfSupervisedLearningToReach she:AnalogicalInference .

she:AnalogicalInference a skos:Concept ;
    skos:prefLabel "analogical inference" ;
    she:performsIntersectionToReach she:End .

she:End a skos:Concept ;
    skos:prefLabel "end" .
