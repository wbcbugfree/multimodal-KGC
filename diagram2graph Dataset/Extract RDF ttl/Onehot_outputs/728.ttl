@prefix d2g:  <http://example.org/diagram2graph#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://example.org/diagram/diagram/node/1> a d2g:Node, d2g:Process ;
    rdfs:label "Lamp doesn't work" ;
    d2g:shape d2g:Task .

<http://example.org/diagram/diagram/node/2> a d2g:Node, d2g:Decision ;
    rdfs:label "Lamp plugged in?" ;
    d2g:shape d2g:Gateway .

<http://example.org/diagram/diagram/node/3> a d2g:Node, d2g:Process ;
    rdfs:label "Plug in lamp" ;
    d2g:shape d2g:Task .

<http://example.org/diagram/diagram/node/4> a d2g:Node, d2g:Decision ;
    rdfs:label "Lamp plugged in?" ;
    d2g:shape d2g:Gateway .

<http://example.org/diagram/diagram/node/5> a d2g:Node, d2g:Process ;
    rdfs:label "Replace bulb" ;
    d2g:shape d2g:Task .

<http://example.org/diagram/diagram/node/6> a d2g:Node, d2g:Process ;
    rdfs:label "PRINT K" ;
    d2g:shape d2g:Task .

<http://example.org/diagram/diagram/edge/12> a d2g:Edge, d2g:Solid ;
    d2g:source <http://example.org/diagram/diagram/node/1> ;
    d2g:target <http://example.org/diagram/diagram/node/2> ;
    d2g:relationshipType d2g:Follows .

<http://example.org/diagram/diagram/edge/23> a d2g:Edge, d2g:Solid ;
    d2g:source <http://example.org/diagram/diagram/node/2> ;
    d2g:target <http://example.org/diagram/diagram/node/3> ;
    d2g:relationshipType d2g:Branches ;
    d2g:relationshipValue "No" .

<http://example.org/diagram/diagram/edge/24> a d2g:Edge, d2g:Solid ;
    d2g:source <http://example.org/diagram/diagram/node/2> ;
    d2g:target <http://example.org/diagram/diagram/node/4> ;
    d2g:relationshipType d2g:Branches ;
    d2g:relationshipValue "Yes" .

<http://example.org/diagram/diagram/edge/45> a d2g:Edge, d2g:Solid ;
    d2g:source <http://example.org/diagram/diagram/node/4> ;
    d2g:target <http://example.org/diagram/diagram/node/5> ;
    d2g:relationshipType d2g:Branches ;
    d2g:relationshipValue "Yes" .

<http://example.org/diagram/diagram/edge/46> a d2g:Edge, d2g:Solid ;
    d2g:source <http://example.org/diagram/diagram/node/4> ;
    d2g:target <http://example.org/diagram/diagram/node/6> ;
    d2g:relationshipType d2g:Branches ;
    d2g:relationshipValue "No" .

<http://example.org/diagram/diagram/node/1> d2g:follows <http://example.org/diagram/diagram/node/2> .
<http://example.org/diagram/diagram/node/2> d2g:branches <http://example.org/diagram/diagram/node/3> .
<http://example.org/diagram/diagram/node/2> d2g:branches <http://example.org/diagram/diagram/node/4> .
<http://example.org/diagram/diagram/node/4> d2g:branches <http://example.org/diagram/diagram/node/5> .
<http://example.org/diagram/diagram/node/4> d2g:branches <http://example.org/diagram/diagram/node/6> .
