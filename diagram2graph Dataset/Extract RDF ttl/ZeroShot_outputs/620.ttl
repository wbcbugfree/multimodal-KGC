@prefix d2g: <http://example.org/diagram2graph#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://example.org/diagram/diagram/node/1> a d2g:Node, d2g:Start ;
    rdfs:label "Start" ;
    d2g:shape d2g:StartEvent .

<http://example.org/diagram/diagram/node/2> a d2g:Node, d2g:Process ;
    rdfs:label "Submit the registration form" ;
    d2g:shape d2g:Task .

<http://example.org/diagram/diagram/node/3> a d2g:Node, d2g:Decision ;
    rdfs:label "Form Complete?" ;
    d2g:shape d2g:Gateway .

<http://example.org/diagram/diagram/node/4> a d2g:Node, d2g:Terminator ;
    rdfs:label "End" ;
    d2g:shape d2g:EndEvent .

<http://example.org/diagram/diagram/node/5> a d2g:Node, d2g:Process ;
    rdfs:label "Confirmation" ;
    d2g:shape d2g:Task .

<http://example.org/diagram/diagram/node/6> a d2g:Node, d2g:Process ;
    rdfs:label "Verify details" ;
    d2g:shape d2g:Task .

<http://example.org/diagram/diagram/node/7> a d2g:Node, d2g:Process ;
    rdfs:label "Return Document" ;
    d2g:shape d2g:Task .

<http://example.org/diagram/diagram/node/8> a d2g:Node, d2g:Decision ;
    rdfs:label "Accept Submission?" ;
    d2g:shape d2g:Gateway .

<http://example.org/diagram/diagram/node/9> a d2g:Node, d2g:Process ;
    rdfs:label "Write Acceptance Letter" ;
    d2g:shape d2g:Task .

<http://example.org/diagram/diagram/edge/12> a d2g:Edge, d2g:Solid ;
    d2g:source <http://example.org/diagram/diagram/node/1> ;
    d2g:target <http://example.org/diagram/diagram/node/2> ;
    d2g:relationshipType d2g:Follows .

<http://example.org/diagram/diagram/node/1> d2g:follows <http://example.org/diagram/diagram/node/2> .

<http://example.org/diagram/diagram/edge/23> a d2g:Edge, d2g:Solid ;
    d2g:source <http://example.org/diagram/diagram/node/2> ;
    d2g:target <http://example.org/diagram/diagram/node/3> ;
    d2g:relationshipType d2g:Follows .

<http://example.org/diagram/diagram/node/2> d2g:follows <http://example.org/diagram/diagram/node/3> .

<http://example.org/diagram/diagram/edge/32> a d2g:Edge, d2g:Solid ;
    d2g:source <http://example.org/diagram/diagram/node/3> ;
    d2g:target <http://example.org/diagram/diagram/node/2> ;
    d2g:relationshipType d2g:Branches ;
    d2g:relationshipValue "No" .

<http://example.org/diagram/diagram/node/3> d2g:branches <http://example.org/diagram/diagram/node/2> .

<http://example.org/diagram/diagram/edge/36> a d2g:Edge, d2g:Solid ;
    d2g:source <http://example.org/diagram/diagram/node/3> ;
    d2g:target <http://example.org/diagram/diagram/node/6> ;
    d2g:relationshipType d2g:Branches ;
    d2g:relationshipValue "Yes" .

<http://example.org/diagram/diagram/node/3> d2g:branches <http://example.org/diagram/diagram/node/6> .

<http://example.org/diagram/diagram/edge/68> a d2g:Edge, d2g:Solid ;
    d2g:source <http://example.org/diagram/diagram/node/6> ;
    d2g:target <http://example.org/diagram/diagram/node/8> ;
    d2g:relationshipType d2g:Follows .

<http://example.org/diagram/diagram/node/6> d2g:follows <http://example.org/diagram/diagram/node/8> .

<http://example.org/diagram/diagram/edge/87> a d2g:Edge, d2g:Solid ;
    d2g:source <http://example.org/diagram/diagram/node/8> ;
    d2g:target <http://example.org/diagram/diagram/node/7> ;
    d2g:relationshipType d2g:Branches ;
    d2g:relationshipValue "No" .

<http://example.org/diagram/diagram/node/8> d2g:branches <http://example.org/diagram/diagram/node/7> .

<http://example.org/diagram/diagram/edge/89> a d2g:Edge, d2g:Solid ;
    d2g:source <http://example.org/diagram/diagram/node/8> ;
    d2g:target <http://example.org/diagram/diagram/node/9> ;
    d2g:relationshipType d2g:Branches ;
    d2g:relationshipValue "Yes" .

<http://example.org/diagram/diagram/node/8> d2g:branches <http://example.org/diagram/diagram/node/9> .

<http://example.org/diagram/diagram/edge/74> a d2g:Edge, d2g:Solid ;
    d2g:source <http://example.org/diagram/diagram/node/7> ;
    d2g:target <http://example.org/diagram/diagram/node/4> ;
    d2g:relationshipType d2g:Follows .

<http://example.org/diagram/diagram/node/7> d2g:follows <http://example.org/diagram/diagram/node/4> .

<http://example.org/diagram/diagram/edge/95> a d2g:Edge, d2g:Solid ;
    d2g:source <http://example.org/diagram/diagram/node/9> ;
    d2g:target <http://example.org/diagram/diagram/node/5> ;
    d2g:relationshipType d2g:Follows .

<http://example.org/diagram/diagram/node/9> d2g:follows <http://example.org/diagram/diagram/node/5> .

<http://example.org/diagram/diagram/edge/54> a d2g:Edge, d2g:Solid ;
    d2g:source <http://example.org/diagram/diagram/node/5> ;
    d2g:target <http://example.org/diagram/diagram/node/4> ;
    d2g:relationshipType d2g:Follows .

<http://example.org/diagram/diagram/node/5> d2g:follows <http://example.org/diagram/diagram/node/4> .
