@prefix d2g: <http://example.org/diagram2graph#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

# === Nodes ===
<http://example.org/diagram/diagram/node/start> a d2g:Start, d2g:Node ;
    rdfs:label "Start" ;
    d2g:shape d2g:StartEvent .

<http://example.org/diagram/diagram/node/read_values> a d2g:Process, d2g:Node ;
    rdfs:label "Read Values" ;
    d2g:shape d2g:Task .

<http://example.org/diagram/diagram/node/new_trials_available> a d2g:Decision, d2g:Node ;
    rdfs:label "new trials available?" ;
    d2g:shape d2g:Gateway .

<http://example.org/diagram/diagram/node/read_new_trial> a d2g:Process, d2g:Node ;
    rdfs:label "read new trial" ;
    d2g:shape d2g:Task .

<http://example.org/diagram/diagram/node/average_available> a d2g:Decision, d2g:Node ;
    rdfs:label "average avaible for condition?" ;
    d2g:shape d2g:Gateway .

<http://example.org/diagram/diagram/node/initialize> a d2g:Process, d2g:Node ;
    rdfs:label "Initialize" ;
    d2g:shape d2g:Task .

<http://example.org/diagram/diagram/node/add_data_to_cumulative_sum> a d2g:Process, d2g:Node ;
    rdfs:label "add data to cumulative sum" ;
    d2g:shape d2g:Task .

<http://example.org/diagram/diagram/node/compute_t_value_and_plot> a d2g:Process, d2g:Node ;
    rdfs:label "compute t-value and plot" ;
    d2g:shape d2g:Task .

<http://example.org/diagram/diagram/node/continue> a d2g:Decision, d2g:Node ;
    rdfs:label "continue?" ;
    d2g:shape d2g:Gateway .

<http://example.org/diagram/diagram/node/stop> a d2g:Terminator, d2g:Node ;
    rdfs:label "Stop" ;
    d2g:shape d2g:EndEvent .

# === Edges ===
<http://example.org/diagram/diagram/edge/startread_values> a d2g:Solid, d2g:Edge ;
    d2g:source <http://example.org/diagram/diagram/node/start> ;
    d2g:target <http://example.org/diagram/diagram/node/read_values> ;
    d2g:relationshipType d2g:Follows .

<http://example.org/diagram/diagram/node/start> d2g:follows <http://example.org/diagram/diagram/node/read_values> .

<http://example.org/diagram/diagram/edge/read_valuesnew_trials_available> a d2g:Solid, d2g:Edge ;
    d2g:source <http://example.org/diagram/diagram/node/read_values> ;
    d2g:target <http://example.org/diagram/diagram/node/new_trials_available> ;
    d2g:relationshipType d2g:Follows .

<http://example.org/diagram/diagram/node/read_values> d2g:follows <http://example.org/diagram/diagram/node/new_trials_available> .

<http://example.org/diagram/diagram/edge/new_trials_availableread_new_trial> a d2g:Solid, d2g:Edge ;
    d2g:source <http://example.org/diagram/diagram/node/new_trials_available> ;
    d2g:target <http://example.org/diagram/diagram/node/read_new_trial> ;
    d2g:relationshipType d2g:DependsOn ;
    d2g:relationshipValue "yes" .

<http://example.org/diagram/diagram/node/new_trials_available> d2g:depends_on <http://example.org/diagram/diagram/node/read_new_trial> .

<http://example.org/diagram/diagram/edge/new_trials_availableread_values> a d2g:Solid, d2g:Edge ;
    d2g:source <http://example.org/diagram/diagram/node/new_trials_available> ;
    d2g:target <http://example.org/diagram/diagram/node/read_values> ;
    d2g:relationshipType d2g:DependsOn ;
    d2g:relationshipValue "no" .

<http://example.org/diagram/diagram/node/new_trials_available> d2g:depends_on <http://example.org/diagram/diagram/node/read_values> .

<http://example.org/diagram/diagram/edge/read_new_trialaverage_available> a d2g:Solid, d2g:Edge ;
    d2g:source <http://example.org/diagram/diagram/node/read_new_trial> ;
    d2g:target <http://example.org/diagram/diagram/node/average_available> ;
    d2g:relationshipType d2g:Follows .

<http://example.org/diagram/diagram/node/read_new_trial> d2g:follows <http://example.org/diagram/diagram/node/average_available> .

<http://example.org/diagram/diagram/edge/average_availableinitialize> a d2g:Solid, d2g:Edge ;
    d2g:source <http://example.org/diagram/diagram/node/average_available> ;
    d2g:target <http://example.org/diagram/diagram/node/initialize> ;
    d2g:relationshipType d2g:DependsOn ;
    d2g:relationshipValue "no" .

<http://example.org/diagram/diagram/node/average_available> d2g:depends_on <http://example.org/diagram/diagram/node/initialize> .

<http://example.org/diagram/diagram/edge/average_availableadd_data_to_cumulative_sum> a d2g:Solid, d2g:Edge ;
    d2g:source <http://example.org/diagram/diagram/node/average_available> ;
    d2g:target <http://example.org/diagram/diagram/node/add_data_to_cumulative_sum> ;
    d2g:relationshipType d2g:DependsOn ;
    d2g:relationshipValue "yes" .

<http://example.org/diagram/diagram/node/average_available> d2g:depends_on <http://example.org/diagram/diagram/node/add_data_to_cumulative_sum> .

<http://example.org/diagram/diagram/edge/initializeadd_data_to_cumulative_sum> a d2g:Solid, d2g:Edge ;
    d2g:source <http://example.org/diagram/diagram/node/initialize> ;
    d2g:target <http://example.org/diagram/diagram/node/add_data_to_cumulative_sum> ;
    d2g:relationshipType d2g:Follows .

<http://example.org/diagram/diagram/node/initialize> d2g:follows <http://example.org/diagram/diagram/node/add_data_to_cumulative_sum> .

<http://example.org/diagram/diagram/edge/add_data_to_cumulative_sumcompute_t_value_and_plot> a d2g:Solid, d2g:Edge ;
    d2g:source <http://example.org/diagram/diagram/node/add_data_to_cumulative_sum> ;
    d2g:target <http://example.org/diagram/diagram/node/compute_t_value_and_plot> ;
    d2g:relationshipType d2g:Follows .

<http://example.org/diagram/diagram/node/add_data_to_cumulative_sum> d2g:follows <http://example.org/diagram/diagram/node/compute_t_value_and_plot> .

<http://example.org/diagram/diagram/edge/compute_t_value_and_plotcontinue> a d2g:Solid, d2g:Edge ;
    d2g:source <http://example.org/diagram/diagram/node/compute_t_value_and_plot> ;
    d2g:target <http://example.org/diagram/diagram/node/continue> ;
    d2g:relationshipType d2g:Follows .

<http://example.org/diagram/diagram/node/compute_t_value_and_plot> d2g:follows <http://example.org/diagram/diagram/node/continue> .

<http://example.org/diagram/diagram/edge/continueread_values> a d2g:Solid, d2g:Edge ;
    d2g:source <http://example.org/diagram/diagram/node/continue> ;
    d2g:target <http://example.org/diagram/diagram/node/read_values> ;
    d2g:relationshipType d2g:DependsOn ;
    d2g:relationshipValue "yes" .

<http://example.org/diagram/diagram/node/continue> d2g:depends_on <http://example.org/diagram/diagram/node/read_values> .

<http://example.org/diagram/diagram/edge/continuestop> a d2g:Solid, d2g:Edge ;
    d2g:source <http://example.org/diagram/diagram/node/continue> ;
    d2g:target <http://example.org/diagram/diagram/node/stop> ;
    d2g:relationshipType d2g:DependsOn ;
    d2g:relationshipValue "no" .

<http://example.org/diagram/diagram/node/continue> d2g:depends_on <http://example.org/diagram/diagram/node/stop> .
