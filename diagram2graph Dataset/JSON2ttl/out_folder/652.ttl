@prefix d2g: <http://example.org/diagram2graph#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

# === Nodes ===
<http://example.org/diagram/diagram/node/start> a d2g:Start, d2g:Node ;
    rdfs:label "Start" ;
    d2g:shape d2g:StartEvent .

<http://example.org/diagram/diagram/node/documentation_work> a d2g:Process, d2g:Node ;
    rdfs:label "Documentation Work" ;
    d2g:shape d2g:Task .

<http://example.org/diagram/diagram/node/print_cycle_count_sheets> a d2g:Process, d2g:Node ;
    rdfs:label "Print cycle count sheets" ;
    d2g:shape d2g:Task .

<http://example.org/diagram/diagram/node/perform_physical_count_of_stock> a d2g:Process, d2g:Node ;
    rdfs:label "Perform physical count of stock" ;
    d2g:shape d2g:Task .

<http://example.org/diagram/diagram/node/enter_physical_counts> a d2g:Process, d2g:Node ;
    rdfs:label "Enter physical counts" ;
    d2g:shape d2g:Task .

<http://example.org/diagram/diagram/node/report_differences> a d2g:Process, d2g:Node ;
    rdfs:label "Report differences" ;
    d2g:shape d2g:Task .

<http://example.org/diagram/diagram/node/recount_inventory> a d2g:Decision, d2g:Node ;
    rdfs:label "Recount inventory?" ;
    d2g:shape d2g:Gateway .

<http://example.org/diagram/diagram/node/display_documents> a d2g:Process, d2g:Node ;
    rdfs:label "Display documents" ;
    d2g:shape d2g:Task .

<http://example.org/diagram/diagram/node/perform_physical_count_of_stock_1> a d2g:Process, d2g:Node ;
    rdfs:label "Perform physical count of stock" ;
    d2g:shape d2g:Task .

<http://example.org/diagram/diagram/node/post_inventory_documents> a d2g:Process, d2g:Node ;
    rdfs:label "Post inventory documents" ;
    d2g:shape d2g:Task .

<http://example.org/diagram/diagram/node/end> a d2g:Terminator, d2g:Node ;
    rdfs:label "End" ;
    d2g:shape d2g:EndEvent .

# === Edges ===
<http://example.org/diagram/diagram/edge/e58865> a d2g:Solid, d2g:Edge ;
    d2g:source <http://example.org/diagram/diagram/node/> ;
    d2g:target <http://example.org/diagram/diagram/node/documentation_work> ;
    d2g:relationshipType d2g:Follows .

<http://example.org/diagram/diagram/node/> d2g:follows <http://example.org/diagram/diagram/node/documentation_work> .

<http://example.org/diagram/diagram/edge/e61540> a d2g:Solid, d2g:Edge ;
    d2g:source <http://example.org/diagram/diagram/node/> ;
    d2g:target <http://example.org/diagram/diagram/node/print_cycle_count_sheets> ;
    d2g:relationshipType d2g:Follows .

<http://example.org/diagram/diagram/node/> d2g:follows <http://example.org/diagram/diagram/node/print_cycle_count_sheets> .

<http://example.org/diagram/diagram/edge/e15147> a d2g:Solid, d2g:Edge ;
    d2g:source <http://example.org/diagram/diagram/node/> ;
    d2g:target <http://example.org/diagram/diagram/node/perform_physical_count_of_stock> ;
    d2g:relationshipType d2g:Follows .

<http://example.org/diagram/diagram/node/> d2g:follows <http://example.org/diagram/diagram/node/perform_physical_count_of_stock> .

<http://example.org/diagram/diagram/edge/e9461> a d2g:Solid, d2g:Edge ;
    d2g:source <http://example.org/diagram/diagram/node/> ;
    d2g:target <http://example.org/diagram/diagram/node/enter_physical_counts> ;
    d2g:relationshipType d2g:Follows .

<http://example.org/diagram/diagram/node/> d2g:follows <http://example.org/diagram/diagram/node/enter_physical_counts> .

<http://example.org/diagram/diagram/edge/e52819> a d2g:Solid, d2g:Edge ;
    d2g:source <http://example.org/diagram/diagram/node/> ;
    d2g:target <http://example.org/diagram/diagram/node/report_differences> ;
    d2g:relationshipType d2g:Follows .

<http://example.org/diagram/diagram/node/> d2g:follows <http://example.org/diagram/diagram/node/report_differences> .

<http://example.org/diagram/diagram/edge/e166> a d2g:Solid, d2g:Edge ;
    d2g:source <http://example.org/diagram/diagram/node/> ;
    d2g:target <http://example.org/diagram/diagram/node/recount_inventory> ;
    d2g:relationshipType d2g:Follows .

<http://example.org/diagram/diagram/node/> d2g:follows <http://example.org/diagram/diagram/node/recount_inventory> .

<http://example.org/diagram/diagram/edge/e9036> a d2g:Solid, d2g:Edge ;
    d2g:source <http://example.org/diagram/diagram/node/> ;
    d2g:target <http://example.org/diagram/diagram/node/post_inventory_documents> ;
    d2g:relationshipType d2g:DependsOn ;
    d2g:relationshipValue "No" .

<http://example.org/diagram/diagram/node/> d2g:depends_on <http://example.org/diagram/diagram/node/post_inventory_documents> .

<http://example.org/diagram/diagram/edge/e88215> a d2g:Solid, d2g:Edge ;
    d2g:source <http://example.org/diagram/diagram/node/> ;
    d2g:target <http://example.org/diagram/diagram/node/display_documents> ;
    d2g:relationshipType d2g:DependsOn ;
    d2g:relationshipValue "Yes" .

<http://example.org/diagram/diagram/node/> d2g:depends_on <http://example.org/diagram/diagram/node/display_documents> .

<http://example.org/diagram/diagram/edge/e87426> a d2g:Solid, d2g:Edge ;
    d2g:source <http://example.org/diagram/diagram/node/> ;
    d2g:target <http://example.org/diagram/diagram/node/perform_physical_count_of_stock_1> ;
    d2g:relationshipType d2g:Follows .

<http://example.org/diagram/diagram/node/> d2g:follows <http://example.org/diagram/diagram/node/perform_physical_count_of_stock_1> .

<http://example.org/diagram/diagram/edge/e52819> a d2g:Solid, d2g:Edge ;
    d2g:source <http://example.org/diagram/diagram/node/> ;
    d2g:target <http://example.org/diagram/diagram/node/report_differences> ;
    d2g:relationshipType d2g:Follows .

<http://example.org/diagram/diagram/node/> d2g:follows <http://example.org/diagram/diagram/node/report_differences> .

<http://example.org/diagram/diagram/edge/e95726> a d2g:Solid, d2g:Edge ;
    d2g:source <http://example.org/diagram/diagram/node/> ;
    d2g:target <http://example.org/diagram/diagram/node/end> ;
    d2g:relationshipType d2g:Follows .

<http://example.org/diagram/diagram/node/> d2g:follows <http://example.org/diagram/diagram/node/end> .
