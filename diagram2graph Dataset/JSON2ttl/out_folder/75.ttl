    d2g:source <http://example.org/diagram/diagram/node/8> ;
    d2g:target <http://example.org/diagram/diagram/node/9> ;
    d2g:relationshipType d2g:Follows .

<http://example.org/diagram/diagram/node/8> d2g:follows <http://example.org/diagram/diagram/node/9> .

<http://example.org/diagram/diagram/edge/910> a d2g:Solid, d2g:Edge ;
    d2g:source <http://example.org/diagram/diagram/node/9> ;
    d2g:target <http://example.org/diagram/diagram/node/10> ;
    d2g:relationshipType d2g:Follows .

<http://example.org/diagram/diagram/node/9> d2g:follows <http://example.org/diagram/diagram/node/10> .

<http://example.org/diagram/diagram/edge/1011> a d2g:Solid, d2g:Edge ;
    d2g:source <http://example.org/diagram/diagram/node/10> ;
    d2g:target <http://example.org/diagram/diagram/node/11> ;
