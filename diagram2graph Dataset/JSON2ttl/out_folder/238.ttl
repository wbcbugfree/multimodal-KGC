@prefix d2g: <http://example.org/diagram2graph#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

# === Nodes ===
<http://example.org/diagram/diagram/node/start> a d2g:Start, d2g:Node ;
    rdfs:label "Start" ;
    d2g:shape d2g:StartEvent .

<http://example.org/diagram/diagram/node/login> a d2g:Process, d2g:Node ;
    rdfs:label "Login" ;
    d2g:shape d2g:Task .

<http://example.org/diagram/diagram/node/verified> a d2g:Decision, d2g:Node ;
    rdfs:label "Verified?" ;
    d2g:shape d2g:Gateway .

<http://example.org/diagram/diagram/node/dashboard> a d2g:Process, d2g:Node ;
    rdfs:label "Dashboard" ;
    d2g:shape d2g:Task .

<http://example.org/diagram/diagram/node/click_report_incident> a d2g:Process, d2g:Node ;
    rdfs:label "Click on the report incident link" ;
    d2g:shape d2g:Task .

<http://example.org/diagram/diagram/node/fill_form> a d2g:Process, d2g:Node ;
    rdfs:label "Fill the form" ;
    d2g:shape d2g:Task .

<http://example.org/diagram/diagram/node/validation_module> a d2g:Process, d2g:Node ;
    rdfs:label "Validation Module" ;
    d2g:shape d2g:Task .

<http://example.org/diagram/diagram/node/need> a d2g:Decision, d2g:Node ;
    rdfs:label "Need?" ;
    d2g:shape d2g:Gateway .

<http://example.org/diagram/diagram/node/submit> a d2g:Process, d2g:Node ;
    rdfs:label "Submit" ;
    d2g:shape d2g:Task .

<http://example.org/diagram/diagram/node/update_form> a d2g:Process, d2g:Node ;
    rdfs:label "Update form" ;
    d2g:shape d2g:Task .

<http://example.org/diagram/diagram/node/view_comments> a d2g:Process, d2g:Node ;
    rdfs:label "View comments on the post" ;
    d2g:shape d2g:Task .

<http://example.org/diagram/diagram/node/stop> a d2g:Terminator, d2g:Node ;
    rdfs:label "Stop" ;
    d2g:shape d2g:EndEvent .

# === Edges ===
<http://example.org/diagram/diagram/edge/startlogin> a d2g:Solid, d2g:Edge ;
    d2g:source <http://example.org/diagram/diagram/node/start> ;
    d2g:target <http://example.org/diagram/diagram/node/login> ;
    d2g:relationshipType d2g:Follows .

<http://example.org/diagram/diagram/node/start> d2g:follows <http://example.org/diagram/diagram/node/login> .

<http://example.org/diagram/diagram/edge/loginverified> a d2g:Solid, d2g:Edge ;
    d2g:source <http://example.org/diagram/diagram/node/login> ;
    d2g:target <http://example.org/diagram/diagram/node/verified> ;
    d2g:relationshipType d2g:Follows .

<http://example.org/diagram/diagram/node/login> d2g:follows <http://example.org/diagram/diagram/node/verified> .

<http://example.org/diagram/diagram/edge/verifieddashboard> a d2g:Solid, d2g:Edge ;
    d2g:source <http://example.org/diagram/diagram/node/verified> ;
    d2g:target <http://example.org/diagram/diagram/node/dashboard> ;
    d2g:relationshipType d2g:DependsOn ;
    d2g:relationshipValue "Yes" .

<http://example.org/diagram/diagram/node/verified> d2g:depends_on <http://example.org/diagram/diagram/node/dashboard> .

<http://example.org/diagram/diagram/edge/verifiedlogin> a d2g:Solid, d2g:Edge ;
    d2g:source <http://example.org/diagram/diagram/node/verified> ;
    d2g:target <http://example.org/diagram/diagram/node/login> ;
    d2g:relationshipType d2g:DependsOn ;
    d2g:relationshipValue "No" .

<http://example.org/diagram/diagram/node/verified> d2g:depends_on <http://example.org/diagram/diagram/node/login> .

<http://example.org/diagram/diagram/edge/dashboardclick_report_incident> a d2g:Solid, d2g:Edge ;
    d2g:source <http://example.org/diagram/diagram/node/dashboard> ;
    d2g:target <http://example.org/diagram/diagram/node/click_report_incident> ;
    d2g:relationshipType d2g:Follows .

<http://example.org/diagram/diagram/node/dashboard> d2g:follows <http://example.org/diagram/diagram/node/click_report_incident> .

<http://example.org/diagram/diagram/edge/click_report_incidentfill_form> a d2g:Solid, d2g:Edge ;
    d2g:source <http://example.org/diagram/diagram/node/click_report_incident> ;
    d2g:target <http://example.org/diagram/diagram/node/fill_form> ;
    d2g:relationshipType d2g:Follows .

<http://example.org/diagram/diagram/node/click_report_incident> d2g:follows <http://example.org/diagram/diagram/node/fill_form> .

<http://example.org/diagram/diagram/edge/fill_formvalidation_module> a d2g:Solid, d2g:Edge ;
    d2g:source <http://example.org/diagram/diagram/node/fill_form> ;
    d2g:target <http://example.org/diagram/diagram/node/validation_module> ;
    d2g:relationshipType d2g:Follows .

<http://example.org/diagram/diagram/node/fill_form> d2g:follows <http://example.org/diagram/diagram/node/validation_module> .

<http://example.org/diagram/diagram/edge/validation_moduleneed> a d2g:Solid, d2g:Edge ;
    d2g:source <http://example.org/diagram/diagram/node/validation_module> ;
    d2g:target <http://example.org/diagram/diagram/node/need> ;
    d2g:relationshipType d2g:Follows .

<http://example.org/diagram/diagram/node/validation_module> d2g:follows <http://example.org/diagram/diagram/node/need> .

<http://example.org/diagram/diagram/edge/needview_comments> a d2g:Solid, d2g:Edge ;
    d2g:source <http://example.org/diagram/diagram/node/need> ;
    d2g:target <http://example.org/diagram/diagram/node/view_comments> ;
    d2g:relationshipType d2g:DependsOn ;
    d2g:relationshipValue "Yes" .

<http://example.org/diagram/diagram/node/need> d2g:depends_on <http://example.org/diagram/diagram/node/view_comments> .

<http://example.org/diagram/diagram/edge/needupdate_form> a d2g:Solid, d2g:Edge ;
    d2g:source <http://example.org/diagram/diagram/node/need> ;
    d2g:target <http://example.org/diagram/diagram/node/update_form> ;
    d2g:relationshipType d2g:DependsOn ;
    d2g:relationshipValue "No" .

<http://example.org/diagram/diagram/node/need> d2g:depends_on <http://example.org/diagram/diagram/node/update_form> .

<http://example.org/diagram/diagram/edge/update_formsubmit> a d2g:Solid, d2g:Edge ;
    d2g:source <http://example.org/diagram/diagram/node/update_form> ;
    d2g:target <http://example.org/diagram/diagram/node/submit> ;
    d2g:relationshipType d2g:Follows .

<http://example.org/diagram/diagram/node/update_form> d2g:follows <http://example.org/diagram/diagram/node/submit> .

<http://example.org/diagram/diagram/edge/submitvalidation_module> a d2g:Solid, d2g:Edge ;
    d2g:source <http://example.org/diagram/diagram/node/submit> ;
    d2g:target <http://example.org/diagram/diagram/node/validation_module> ;
    d2g:relationshipType d2g:Follows .

<http://example.org/diagram/diagram/node/submit> d2g:follows <http://example.org/diagram/diagram/node/validation_module> .

<http://example.org/diagram/diagram/edge/view_commentsstop> a d2g:Solid, d2g:Edge ;
    d2g:source <http://example.org/diagram/diagram/node/view_comments> ;
    d2g:target <http://example.org/diagram/diagram/node/stop> ;
    d2g:relationshipType d2g:Follows .

<http://example.org/diagram/diagram/node/view_comments> d2g:follows <http://example.org/diagram/diagram/node/stop> .
