@prefix : <http://example.org/diagram2graph#> .

:Node1 a :Start, :Node ;
    :label "Begin" ;
    :shape :StartEvent .

:Node2 a :Process, :Node ;
    :label "SUM=0" ;
    :shape :Task .

:Node3 a :Process, :Node ;
    :label "Input N" ;
    :shape :Task .

:Node4 a :Decision, :Node ;
    :label "N!=0?" ;
    :shape :Gateway .

:Node5 a :Process, :Node ;
    :label "Print SUM" ;
    :shape :Task .

:Node6 a :Process, :Node ;
    :label "REM=N%10" ;
    :shape :Task .

:Node7 a :Process, :Node ;
    :label "SUM=SUM+REM" ;
    :shape :Task .

:Node8 a :Process, :Node ;
    :label "N=N/10" ;
    :shape :Task .

:Node9 a :Terminator, :Node ;
    :label "Stop" ;
    :shape :EndEvent .

:Edge12 a :Solid, :Edge ;
    :source :Node1 ;
    :target :Node2 ;
    :relationshipType :Follows .

:Edge23 a :Solid, :Edge ;
    :source :Node2 ;
    :target :Node3 ;
    :relationshipType :Follows .

:Edge34 a :Solid, :Edge ;
    :source :Node3 ;
    :target :Node4 ;
    :relationshipType :Follows .

:Edge45 a :Solid, :Edge ;
    :source :Node4 ;
    :target :Node5 ;
    :relationshipType :Follows ;
    :relationshipValue "False" .

:Edge46 a :Solid, :Edge ;
    :source :Node4 ;
    :target :Node6 ;
    :relationshipType :Follows ;
    :relationshipValue "TRUE" .

:Edge67 a :Solid, :Edge ;
    :source :Node6 ;
    :target :Node7 ;
    :relationshipType :Follows .

:Edge78 a :Solid, :Edge ;
    :source :Node7 ;
    :target :Node8 ;
    :relationshipType :Follows .

:Edge84 a :Solid, :Edge ;
    :source :Node8 ;
    :target :Node4 ;
    :relationshipType :Follows .

:Edge59 a :Solid, :Edge ;
    :source :Node5 ;
    :target :Node9 ;
    :relationshipType :Follows .
