@prefix : <http://example.org/diagram2graph#> .

:Node1 a :Start, :Node ;
    :label "Start" ;
    :shape :StartEvent .

:Node2 a :Process, :Node ;
    :label "Open Email" ;
    :shape :Task .

:Node3 a :Process, :Node ;
    :label "Read email" ;
    :shape :Task .

:Node4 a :Decision, :Node ;
    :label "Input Structured?" ;
    :shape :Gateway .

:Node5 a :Process, :Node ;
    :label "Process Manually" ;
    :shape :Task .

:Node6 a :Terminator, :Node ;
    :label "End" ;
    :shape :EndEvent .

:Node7 a :Process, :Node ;
    :label "Extract Data" ;
    :shape :Task .

:Node8 a :Process, :Node ;
    :label "Lookup Product Description" ;
    :shape :Task .

:Node9 a :Decision, :Node ;
    :label "Match Found?" ;
    :shape :Gateway .

:Node10 a :Process, :Node ;
    :label "Send Email to Update File" ;
    :shape :Task .

:Edge1 a :Solid, :Edge ;
    :source :Node1 ;
    :target :Node2 ;
    :relationshipType :Follows .

:Edge2 a :Solid, :Edge ;
    :source :Node2 ;
    :target :Node3 ;
    :relationshipType :Follows .

:Edge3 a :Solid, :Edge ;
    :source :Node3 ;
    :target :Node4 ;
    :relationshipType :Follows .

:Edge4 a :Solid, :Edge ;
    :source :Node4 ;
    :target :Node5 ;
    :relationshipType :Branches ;
    :relationshipValue "NO" .

:Edge5 a :Solid, :Edge ;
    :source :Node4 ;
    :target :Node7 ;
    :relationshipType :Branches ;
    :relationshipValue "YES" .

:Edge6 a :Solid, :Edge ;
    :source :Node5 ;
    :target :Node6 ;
    :relationshipType :Follows .

:Edge7 a :Solid, :Edge ;
    :source :Node7 ;
    :target :Node8 ;
    :relationshipType :Follows .

:Edge8 a :Solid, :Edge ;
    :source :Node8 ;
    :target :Node9 ;
    :relationshipType :Follows .

:Edge9 a :Solid, :Edge ;
    :source :Node10 ;
    :target :Node6 ;
    :relationshipType :Follows .

:Edge10 a :Solid, :Edge ;
    :source :Node9 ;
    :target :Node10 ;
    :relationshipType :Branches ;
    :relationshipValue "NO" .
