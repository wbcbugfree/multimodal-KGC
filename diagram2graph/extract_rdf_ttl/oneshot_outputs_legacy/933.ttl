@prefix : <http://example.org/diagram2graph#> .

:Node1 a :Start, :Node ;
    :label "Start" ;
    :shape :StartEvent .

:Node2 a :Process, :Node ;
    :label "Look for address" ;
    :shape :Task .

:Node3 a :Decision, :Node ;
    :label "Did you find it?" ;
    :shape :Gateway .

:Node4 a :Decision, :Node ;
    :label "Ask someone" ;
    :shape :Gateway .

:Node5 a :Terminator, :Node ;
    :label "Stop looking" ;
    :shape :EndEvent .

:Edge1 a :Solid, :Edge ;
    :source :Node1 ;
    :target :Node2 ;
    :relationshipType :Follows .

:Edge2 a :Solid, :Edge ;
    :source :Node2 ;
    :target :Node3 ;
    :relationshipType :Follows .

:Edge3 a :Solid, :Edge ;
    :source :Node3 ;
    :target :Node4 ;
    :relationshipType :Branches ;
    :relationshipValue "No" .

:Edge4 a :Solid, :Edge ;
    :source :Node3 ;
    :target :Node5 ;
    :relationshipType :Branches ;
    :relationshipValue "Yes" .

:Edge5 a :Solid, :Edge ;
    :source :Node4 ;
    :target :Node2 ;
    :relationshipType :Branches ;
    :relationshipValue "Yes" .

:Edge6 a :Solid, :Edge ;
    :source :Node4 ;
    :target :Node5 ;
    :relationshipType :Branches ;
    :relationshipValue "No" .
