@prefix : <http://example.org/diagram2graph#> .

:Node1 a :Start, :Node ;
    :label "Start" ;
    :shape :StartEvent .

:Node2 a :Process, :Node ;
    :label "Enter Website" ;
    :shape :Task .

:Node3 a :Process, :Node ;
    :label "Homepage" ;
    :shape :Task .

:Node4 a :Process, :Node ;
    :label "Enter Details" ;
    :shape :Task .

:Node5 a :Decision, :Node ;
    :label "Correct?" ;
    :shape :Gateway .

:Node6 a :Process, :Node ;
    :label "Enter" ;
    :shape :Task .

:Node7 a :Terminator, :Node ;
    :label "Stop" ;
    :shape :EndEvent .

:Node8 a :Process, :Node ;
    :label "Enter Again" ;
    :shape :Task .

:Edge1 a :Solid, :Edge ;
    :source :Node1 ;
    :target :Node2 ;
    :relationshipType :Follows .

:Edge2 a :Solid, :Edge ;
    :source :Node2 ;
    :target :Node3 ;
    :relationshipType :Follows .

:Edge3 a :Solid, :Edge ;
    :source :Node3 ;
    :target :Node4 ;
    :relationshipType :Follows .

:Edge4 a :Solid, :Edge ;
    :source :Node4 ;
    :target :Node5 ;
    :relationshipType :Follows .

:Edge5 a :Solid, :Edge ;
    :source :Node5 ;
    :target :Node6 ;
    :relationshipType :Branches ;
    :relationshipValue "Yes" .

:Edge6 a :Solid, :Edge ;
    :source :Node5 ;
    :target :Node8 ;
    :relationshipType :Branches ;
    :relationshipValue "No" .

:Edge7 a :Solid, :Edge ;
    :source :Node6 ;
    :target :Node7 ;
    :relationshipType :Follows .

:Edge8 a :Solid, :Edge ;
    :source :Node8 ;
    :target :Node4 ;
    :relationshipType :Follows .
