@prefix : <http://example.org/diagram2graph#> .

:Node1 a :Start, :Node ;
    :label "Start" ;
    :shape :StartEvent .

:Node2 a :Process, :Node ;
    :label "Initialize i" ;
    :shape :Task .

:Node3 a :Terminator, :Node ;
    :label "Terminate Process" ;
    :shape :EndEvent .

:Node4 a :Decision, :Node ;
    :label "Enough Quotes?" ;
    :shape :Gateway .

:Node5 a :Process, :Node ;
    :label "Ready" ;
    :shape :Task .

:Node6 a :Decision, :Node ;
    :label "Purchase Approval?" ;
    :shape :Gateway .

:Node7 a :Terminator, :Node ;
    :label "End" ;
    :shape :EndEvent .

:Edge1 a :Solid, :Edge ;
    :source :Node1 ;
    :target :Node2 ;
    :relationshipType :Follows .

:Edge2 a :Solid, :Edge ;
    :source :Node2 ;
    :target :Node3 ;
    :relationshipType :Follows ;
    :relationshipValue "i > N" .

:Edge3 a :Solid, :Edge ;
    :source :Node2 ;
    :target :Node4 ;
    :relationshipType :Follows .

:Edge4 a :Solid, :Edge ;
    :source :Node4 ;
    :target :Node2 ;
    :relationshipType :Branches ;
    :relationshipValue "tender++" .

:Edge5 a :Solid, :Edge ;
    :source :Node4 ;
    :target :Node5 ;
    :relationshipType :Branches ;
    :relationshipValue "Yes" .

:Edge6 a :Solid, :Edge ;
    :source :Node5 ;
    :target :Node6 ;
    :relationshipType :Follows .

:Edge7 a :Solid, :Edge ;
    :source :Node6 ;
    :target :Node3 ;
    :relationshipType :Branches ;
    :relationshipValue "Rejected" .

:Edge8 a :Solid, :Edge ;
    :source :Node6 ;
    :target :Node7 ;
    :relationshipType :Branches ;
    :relationshipValue "Yes" .
