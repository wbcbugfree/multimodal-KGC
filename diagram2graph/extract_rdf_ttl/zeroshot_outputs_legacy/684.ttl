@prefix : <http://example.org/diagram2graph#> .

:Node1 a :Start, :Node ;
    :label "Begin" ;
    :shape :StartEvent .

:Node2 a :Process, :Node ;
    :label "Initialize weights and biases With random values" ;
    :shape :StartEvent .

:Node3 a :Process, :Node ;
    :label "Perform operations" ;
    :shape :StartEvent .

:Node4 a :Process, :Node ;
    :label "Calculate Error" ;
    :shape :StartEvent .

:Node5 a :Decision, :Node ;
    :label "Error <= Error" ;
    :shape :Gateway .

:Node6 a :Decision, :Node ;
    :label "Epoch >= Epoch" ;
    :shape :Gateway .

:Node7 a :Process, :Node ;
    :label "Epoch = epoch + 1" ;
    :shape :Task .

:Node8 a :Process, :Node ;
    :label "Update weights and biases" ;
    :shape :Task .

:Node9 a :Process, :Node ;
    :label "End" ;
    :shape :Task .

:Edge1 a :Solid, :Edge ;
    :source :Node1 ;
    :target :Node2 ;
    :relationshipType :Follows .

:Edge2 a :Solid, :Edge ;
    :source :Node2 ;
    :target :Node3 ;
    :relationshipType :Follows .

:Edge3 a :Solid, :Edge ;
    :source :Node3 ;
    :target :Node4 ;
    :relationshipType :Follows .
