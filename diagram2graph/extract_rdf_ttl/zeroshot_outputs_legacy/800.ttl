@prefix : <http://example.org/diagram2graph#> .

:Node1 a :Process, :Node ;
    :label "Assessment" ;
    :shape :Task .

:Node2 a :Process, :Node ;
    :label "Team work" ;
    :shape :Task .

:Node3 a :Process, :Node ;
    :label "Work" ;
    :shape :Task .

:Node4 a :Process, :Node ;
    :label "Gather" ;
    :shape :Task .

:Node5 a :Process, :Node ;
    :label "Complete" ;
    :shape :Task .

:Node6 a :Process, :Node ;
    :label "Closure" ;
    :shape :Task .

:Node7 a :Process, :Node ;
    :label "Primary closure" ;
    :shape :Task .

:Node8 a :Process, :Node ;
    :label "Bandaging" ;
    :shape :Task .

:Node9 a :Process, :Node ;
    :label "Delayed primary closure" ;
    :shape :Task .

:Node10 a :Process, :Node ;
    :label "Secondary closure" ;
    :shape :Task .

:Edge1 a :Solid, :Edge ;
    :source :Node1 ;
    :target :Node2 ;
    :relationshipType :Follows .

:Edge2 a :Solid, :Edge ;
    :source :Node2 ;
    :target :Node3 ;
    :relationshipType :Follows .

:Edge3 a :Solid, :Edge ;
    :source :Node3 ;
    :target :Node4 ;
    :relationshipType :Follows .

:Edge4 a :Solid, :Edge ;
    :source :Node4 ;
    :target :Node5 ;
    :relationshipType :Follows .

:Edge5 a :Solid, :Edge ;
    :source :Node5 ;
    :target :Node6 ;
    :relationshipType :Follows .

:Edge6 a :Solid, :Edge ;
    :source :Node6 ;
    :target :Node7 ;
    :relationshipType :Follows .

:Edge7 a :Solid, :Edge ;
    :source :Node6 ;
    :target :Node8 ;
    :relationshipType :Follows .

:Edge8 a :Solid, :Edge ;
    :source :Node8 ;
    :target :Node9 ;
    :relationshipType :Follows .

:Edge9 a :Solid, :Edge ;
    :source :Node8 ;
    :target :Node10 ;
    :relationshipType :Follows .
