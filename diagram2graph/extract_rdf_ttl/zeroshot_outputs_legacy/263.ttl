@prefix : <http://example.org/diagram2graph#> .

:Node1 a :Start, :Node ;
    :label "START" ;
    :shape :StartEvent .

:Node2 a :Process, :Node ;
    :label "Input Variable:\nK" ;
    :shape :Task .

:Node3 a :Decision, :Node ;
    :label "If K%2==\n0" ;
    :shape :Gateway .

:Node4 a :Process, :Node ;
    :label "Print: K is\nodd" ;
    :shape :Task .

:Node5 a :Process, :Node ;
    :label "Print: K is\nEven" ;
    :shape :Task .

:Node6 a :Terminator, :Node ;
    :label "STOP" ;
    :shape :EndEvent .

:Edge1 a :Solid, :Edge ;
    :source :Node1 ;
    :target :Node2 ;
    :relationshipType :Follows .

:Edge2 a :Solid, :Edge ;
    :source :Node2 ;
    :target :Node3 ;
    :relationshipType :Follows .

:Edge3 a :Solid, :Edge ;
    :source :Node3 ;
    :target :Node4 ;
    :relationshipType :Branches ;
    :relationshipValue "False" .

:Edge4 a :Solid, :Edge ;
    :source :Node3 ;
    :target :Node5 ;
    :relationshipType :Branches ;
    :relationshipValue "True" .

:Edge5 a :Solid, :Edge ;
    :source :Node4 ;
    :target :Node6 ;
    :relationshipType :Follows .

:Edge6 a :Solid, :Edge ;
    :source :Node5 ;
    :target :Node6 ;
    :relationshipType :Follows .
