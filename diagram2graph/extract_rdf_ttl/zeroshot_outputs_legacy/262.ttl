@prefix : <http://example.org/diagram2graph#> .

:Node1 a :Start, :Node ;
    :label "Start" ;
    :shape :StartEvent .

:Node2 a :Process, :Node ;
    :label "READ" ;
    :shape :Task .

:Node3 a :Process, :Node ;
    :label "M = 1\nF = 1" ;
    :shape :Task .

:Node4 a :Process, :Node ;
    :label "F = F * M" ;
    :shape :Task .

:Node5 a :Decision, :Node ;
    :label "M = N?" ;
    :shape :Gateway .

:Node6 a :Process, :Node ;
    :label "M = M+1" ;
    :shape :Task .

:Node7 a :Process, :Node ;
    :label "PRINT" ;
    :shape :Task .

:Node8 a :Terminator, :Node ;
    :label "END" ;
    :shape :EndEvent .

:Edge1 a :Solid, :Edge ;
    :source :Node1 ;
    :target :Node2 ;
    :relationshipType :Follows .

:Edge2 a :Solid, :Edge ;
    :source :Node2 ;
    :target :Node3 ;
    :relationshipType :Follows .

:Edge3 a :Solid, :Edge ;
    :source :Node3 ;
    :target :Node4 ;
    :relationshipType :Follows .

:Edge4 a :Solid, :Edge ;
    :source :Node4 ;
    :target :Node5 ;
    :relationshipType :Follows .

:Edge5 a :Solid, :Edge ;
    :source :Node5 ;
    :target :Node6 ;
    :relationshipType :Branches ;
    :relationshipValue "NO" .

:Edge6 a :Solid, :Edge ;
    :source :Node5 ;
    :target :Node7 ;
    :relationshipType :Branches ;
    :relationshipValue "YES" .

:Edge7 a :Solid, :Edge ;
    :source :Node6 ;
    :target :Node4 ;
    :relationshipType :Follows .

:Edge8 a :Solid, :Edge ;
    :source :Node7 ;
    :target :Node8 ;
    :relationshipType :Follows .
