@prefix : <http://example.org/diagram2graph#> .

:Node1 a :Start, :Node ;
    :label "Begin" ;
    :shape :StartEvent .

:Node2 a :Process, :Node ;
    :label "statements" ;
    :shape :Task .

:Node3 a :Decision, :Node ;
    :label "condition" ;
    :shape :Gateway .

:Node4 a :Process, :Node ;
    :label "statements 1" ;
    :shape :Task .

:Node5 a :Process, :Node ;
    :label "statements 2" ;
    :shape :Task .

:Node6 a :Terminator, :Node ;
    :label "Stop" ;
    :shape :EndEvent .

:Edge1 a :Solid, :Edge ;
    :source :Node1 ;
    :target :Node2 ;
    :relationshipType :Follows .

:Edge2 a :Solid, :Edge ;
    :source :Node2 ;
    :target :Node3 ;
    :relationshipType :Follows .

:Edge3 a :Solid, :Edge ;
    :source :Node3 ;
    :target :Node4 ;
    :relationshipType :Branches ;
    :relationshipValue "True" .

:Edge4 a :Solid, :Edge ;
    :source :Node3 ;
    :target :Node5 ;
    :relationshipType :Branches ;
    :relationshipValue "Flalse" .

:Edge5 a :Solid, :Edge ;
    :source :Node4 ;
    :target :Node3 ;
    :relationshipType :Follows .

:Edge6 a :Solid, :Edge ;
    :source :Node5 ;
    :target :Node6 ;
    :relationshipType :Follows .
