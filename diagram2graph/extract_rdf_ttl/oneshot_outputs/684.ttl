@prefix : <http://example.org/diagram2graph#> .

:Node1 a :Start, :Node ;
    :label "Begin" ;
    :shape :StartEvent .

:Node2 a :Process, :Node ;
    :label "Initialize weights and biases With random values" ;
    :shape :Task .

:Node3 a :Process, :Node ;
    :label "Perform operations" ;
    :shape :Task .

:Node4 a :Process, :Node ;
    :label "Calculate Error" ;
    :shape :Task .

:Node5 a :Decision, :Node ;
    :label "Error ≤ Error" ;
    :shape :Gateway .

:Node6 a :Decision, :Node ;
    :label "Epoch ≥ Epoch" ;
    :shape :Gateway .

:Node7 a :Terminator, :Node ;
    :label "End" ;
    :shape :EndEvent .

:Node8 a :Process, :Node ;
    :label "Epoch = epoch + 1" ;
    :shape :Task .

:Node9 a :Process, :Node ;
    :label "Update weights and biases" ;
    :shape :Task .

:Edge1 a :Solid, :Edge ;
    :source :Node1 ;
    :target :Node2 ;
    :relationshipType :Follows .

:Edge2 a :Solid, :Edge ;
    :source :Node2 ;
    :target :Node3 ;
    :relationshipType :Follows .

:Edge3 a :Solid, :Edge ;
    :source :Node3 ;
    :target :Node4 ;
    :relationshipType :Follows .

:Edge4 a :Solid, :Edge ;
    :source :Node4 ;
    :target :Node5 ;
    :relationshipType :Follows .

:Edge5 a :Solid, :Edge ;
    :source :Node5 ;
    :target :Node7 ;
    :relationshipType :Branches ;
    :relationshipValue "Yes" .

:Edge6 a :Solid, :Edge ;
    :source :Node5 ;
    :target :Node6 ;
    :relationshipType :Branches ;
    :relationshipValue "No" .

:Edge7 a :Solid, :Edge ;
    :source :Node6 ;
    :target :Node7 ;
    :relationshipType :Branches ;
    :relationshipValue "Yes" .

:Edge8 a :Solid, :Edge ;
    :source :Node6 ;
    :target :Node9 ;
    :relationshipType :Branches ;
    :relationshipValue "No" .

:Edge9 a :Solid, :Edge ;
    :source :Node9 ;
    :target :Node8 ;
    :relationshipType :Follows .

:Edge10 a :Solid, :Edge ;
    :source :Node8 ;
    :target :Node3 ;
    :relationshipType :Follows .
