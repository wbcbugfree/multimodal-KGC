@prefix : <http://example.org/diagram2graph#> .

:Node1 a :Start, :Node ;
    :label "start" ;
    :shape :StartEvent .

:Node2 a :Process, :Node ;
    :label "Input data user" ;
    :shape :Task .

:Node3 a :Decision, :Node ;
    :label "Enter ID" ;
    :shape :Gateway .

:Node4 a :Process, :Node ;
    :label "Authentication" ;
    :shape :Task .

:Node5 a :Process, :Node ;
    :label "Memory" ;
    :shape :Task .

:Node6 a :Process, :Node ;
    :label "Result" ;
    :shape :Task .

:Node7 a :Terminator, :Node ;
    :label "end" ;
    :shape :EndEvent .

:Edge12 a :Solid, :Edge ;
    :source :Node1 ;
    :target :Node2 ;
    :relationshipType :Follows .

:Edge23 a :Solid, :Edge ;
    :source :Node2 ;
    :target :Node3 ;
    :relationshipType :Follows .

:Edge34 a :Solid, :Edge ;
    :source :Node3 ;
    :target :Node4 ;
    :relationshipType :Branches .

:Edge45 a :Solid, :Edge ;
    :source :Node4 ;
    :target :Node5 ;
    :relationshipType :Follows .

:Edge56 a :Solid, :Edge ;
    :source :Node5 ;
    :target :Node6 ;
    :relationshipType :Follows .

:Edge67 a :Solid, :Edge ;
    :source :Node6 ;
    :target :Node7 ;
    :relationshipType :Follows .
