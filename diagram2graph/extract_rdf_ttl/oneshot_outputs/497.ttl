@prefix : <http://example.org/diagram2graph#> .

:Node1 a :Start, :Node ;
    :label "Begin" ;
    :shape :StartEvent .

:Node2 a :Decision, :Node ;
    :label "Do you want to do this?" ;
    :shape :Gateway .

:Node3 a :Process, :Node ;
    :label "Don't do it" ;
    :shape :Task .

:Node4 a :Decision, :Node ;
    :label "Will it likely end in disaster?" ;
    :shape :Gateway .

:Node5 a :Terminator, :Node ;
    :label "End" ;
    :shape :EndEvent .

:Node6 a :Process, :Node ;
    :label "Do it" ;
    :shape :Task .

:Node7 a :Decision, :Node ;
    :label "Good Movie?" ;
    :shape :Gateway .

:Node8 a :Terminator, :Node ;
    :label "End" ;
    :shape :EndEvent .

:Edge12 a :Solid, :Edge ;
    :source :Node1 ;
    :target :Node2 ;
    :relationshipType :Follows .

:Edge23 a :Solid, :Edge ;
    :source :Node2 ;
    :target :Node3 ;
    :relationshipType :Branches ;
    :relationshipValue "No" .

:Edge24 a :Solid, :Edge ;
    :source :Node2 ;
    :target :Node4 ;
    :relationshipType :Follows .

:Edge35 a :Solid, :Edge ;
    :source :Node3 ;
    :target :Node5 ;
    :relationshipType :Follows .

:Edge46 a :Solid, :Edge ;
    :source :Node4 ;
    :target :Node6 ;
    :relationshipType :Branches ;
    :relationshipValue "No" .

:Edge47 a :Solid, :Edge ;
    :source :Node4 ;
    :target :Node7 ;
    :relationshipType :Branches ;
    :relationshipValue "Yes" .

:Edge68 a :Solid, :Edge ;
    :source :Node6 ;
    :target :Node8 ;
    :relationshipType :Follows .

:Edge73 a :Solid, :Edge ;
    :source :Node7 ;
    :target :Node3 ;
    :relationshipType :Branches ;
    :relationshipValue "No" .

:Edge76 a :Solid, :Edge ;
    :source :Node7 ;
    :target :Node6 ;
    :relationshipType :Branches ;
    :relationshipValue "Yes" .
