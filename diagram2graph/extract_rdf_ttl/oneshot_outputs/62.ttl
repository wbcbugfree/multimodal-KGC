@prefix : <http://example.org/diagram2graph#> .

:Node1 a :Start, :Node ;
    :label "Begin" ;
    :shape :StartEvent .

:Node2 a :Process, :Node ;
    :label "Initialize variables" ;
    :shape :Task .

:Node3 a :Process, :Node ;
    :label "INPUT\nnumbers" ;
    :shape :Task .

:Node4 a :Decision, :Node ;
    :label "All numbers\nbeen entered?" ;
    :shape :Gateway .

:Node5 a :Process, :Node ;
    :label "INPUT latest" ;
    :shape :Task .

:Node6 a :Process, :Node ;
    :label "total = total + latest" ;
    :shape :Task .

:Node7 a :Process, :Node ;
    :label "average = total /\nnumbers" ;
    :shape :Task .

:Node8 a :Process, :Node ;
    :label "Print Output" ;
    :shape :Task .

:Node9 a :Terminator, :Node ;
    :label "Stop" ;
    :shape :EndEvent .

:Edge12 a :Solid, :Edge ;
    :source :Node1 ;
    :target :Node2 ;
    :relationshipType :Follows .

:Edge23 a :Solid, :Edge ;
    :source :Node2 ;
    :target :Node3 ;
    :relationshipType :Follows .

:Edge34 a :Solid, :Edge ;
    :source :Node3 ;
    :target :Node4 ;
    :relationshipType :Follows .

:Edge45 a :Solid, :Edge ;
    :source :Node4 ;
    :target :Node5 ;
    :relationshipType :Branches ;
    :relationshipValue "No" .

:Edge47 a :Solid, :Edge ;
    :source :Node4 ;
    :target :Node7 ;
    :relationshipType :Branches ;
    :relationshipValue "Yes" .

:Edge56 a :Solid, :Edge ;
    :source :Node5 ;
    :target :Node6 ;
    :relationshipType :Follows .

:Edge64 a :Solid, :Edge ;
    :source :Node6 ;
    :target :Node4 ;
    :relationshipType :Follows .

:Edge78 a :Solid, :Edge ;
    :source :Node7 ;
    :target :Node8 ;
    :relationshipType :Follows .

:Edge89 a :Solid, :Edge ;
    :source :Node8 ;
    :target :Node9 ;
    :relationshipType :Follows .
