@prefix : <http://example.org/diagram2graph#> .

:Node1 a :Start, :Node ;
    :label "Begin" ;
    :shape :StartEvent .

:Node2 a :Process, :Node ;
    :label "Alarm Rings" ;
    :shape :Task .

:Node3 a :Decision, :Node ;
    :label "Ready to face the world?" ;
    :shape :Gateway .

:Node4 a :Process, :Node ;
    :label "Get Up" ;
    :shape :Task .

:Node5 a :Terminator, :Node ;
    :label "End" ;
    :shape :EndEvent .

:Node6 a :Delay, :Node ;
    :label "Ignore" ;
    :shape :Task .

:Node7 a :Process, :Node ;
    :label "Hit SNOOZE" ;
    :shape :Task .

:Edge12 a :Solid, :Edge ;
    :source :Node1 ;
    :target :Node2 ;
    :relationshipType :Follows .

:Edge23 a :Solid, :Edge ;
    :source :Node2 ;
    :target :Node3 ;
    :relationshipType :Follows .

:Edge34 a :Solid, :Edge ;
    :source :Node3 ;
    :target :Node4 ;
    :relationshipType :Branches ;
    :relationshipValue "Yes" .

:Edge37 a :Solid, :Edge ;
    :source :Node3 ;
    :target :Node7 ;
    :relationshipType :Branches ;
    :relationshipValue "No" .

:Edge45 a :Solid, :Edge ;
    :source :Node4 ;
    :target :Node5 ;
    :relationshipType :Follows .

:Edge62 a :Solid, :Edge ;
    :source :Node6 ;
    :target :Node2 ;
    :relationshipType :Follows .

:Edge76 a :Solid, :Edge ;
    :source :Node7 ;
    :target :Node6 ;
    :relationshipType :Follows .
