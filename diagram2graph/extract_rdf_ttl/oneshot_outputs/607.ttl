@prefix : <http://example.org/diagram2graph#> .

:Node1 a :Process, :Node ;
    :label "Data" ;
    :shape :Task .

:Node2 a :Start, :Node ;
    :label "Start" ;
    :shape :StartEvent .

:Node3 a :Process, :Node ;
    :label "Initial" ;
    :shape :Task .

:Node4 a :Decision, :Node ;
    :label "Process" ;
    :shape :Gateway .

:Node5 a :Process, :Node ;
    :label "Document" ;
    :shape :Task .

:Node6 a :Process, :Node ;
    :label "Data" ;
    :shape :Task .

:Edge1 a :Solid, :Edge ;
    :source :Node2 ;
    :target :Node3 ;
    :relationshipType :Follows .

:Edge2 a :Solid, :Edge ;
    :source :Node3 ;
    :target :Node4 ;
    :relationshipType :Follows .

:Edge3 a :Solid, :Edge ;
    :source :Node4 ;
    :target :Node1 ;
    :relationshipType :Branches ;
    :relationshipValue "Yes" .

:Edge4 a :Solid, :Edge ;
    :source :Node4 ;
    :target :Node6 ;
    :relationshipType :Branches ;
    :relationshipValue "No" .

:Edge5 a :Solid, :Edge ;
    :source :Node1 ;
    :target :Node5 ;
    :relationshipType :Follows .

:Edge6 a :Solid, :Edge ;
    :source :Node6 ;
    :target :Node5 ;
    :relationshipType :Follows .
