@prefix : <http://example.org/diagram2graph#> .

:Node1 a :Start, :Node ;
    :label "A" ;
    :shape :StartEvent .

:Node2 a :Process, :Node ;
    :label "Process step 3" ;
    :shape :Task .

:Node3 a :Process, :Node ;
    :label "Process step 4" ;
    :shape :Task .

:Node4 a :Process, :Node ;
    :label "Process step 5" ;
    :shape :Task .

:Node5 a :Process, :Node ;
    :label "Process step 6" ;
    :shape :Task .

:Node6 a :Terminator, :Node ;
    :label "End" ;
    :shape :EndEvent .

:Edge12 a :Solid, :Edge ;
    :source :Node1 ;
    :target :Node2 ;
    :relationshipType :Follows .

:Edge23 a :Solid, :Edge ;
    :source :Node2 ;
    :target :Node3 ;
    :relationshipType :Follows .

:Edge34 a :Solid, :Edge ;
    :source :Node3 ;
    :target :Node4 ;
    :relationshipType :Follows .

:Edge45 a :Solid, :Edge ;
    :source :Node4 ;
    :target :Node5 ;
    :relationshipType :Follows .

:Edge56 a :Solid, :Edge ;
    :source :Node5 ;
    :target :Node6 ;
    :relationshipType :Follows .
