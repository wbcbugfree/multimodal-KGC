@prefix : <http://example.org/diagram2graph#> .

:Node1 a :Start, :Node ;
    :label "Start" ;
    :shape :StartEvent .

:Node2 a :Decision, :Node ;
    :label "Is your apps main goal is to support the porduct?" ;
    :shape :Gateway .

:Node3 a :Process, :Node ;
    :label "Consider hit apps" ;
    :shape :Task .

:Node4 a :Decision, :Node ;
    :label "Is your app inherently viral?" ;
    :shape :Gateway .

:Node5 a :Process, :Node ;
    :label "Consider Free with IAPs" ;
    :shape :Task .

:Node6 a :Decision, :Node ;
    :label "Does user have valid ID?" ;
    :shape :Gateway .

:Node7 a :Decision, :Node ;
    :label "Can you easily explain the apps value in screenshots?" ;
    :shape :Gateway .

:Node8 a :Process, :Node ;
    :label "Paid service" ;
    :shape :Task .

:Node9 a :Decision, :Node ;
    :label "Is the app itself your core revenue stream" ;
    :shape :Gateway .

:Edge1 a :Solid, :Edge ;
    :source :Node1 ;
    :target :Node2 ;
    :relationshipType :Follows .

:Edge2 a :Solid, :Edge ;
    :source :Node2 ;
    :target :Node3 ;
    :relationshipType :Branches ;
    :relationshipValue "Yes" .

:Edge3 a :Solid, :Edge ;
    :source :Node2 ;
    :target :Node4 ;
    :relationshipType :Follows .

:Edge4 a :Solid, :Edge ;
    :source :Node4 ;
    :target :Node5 ;
    :relationshipType :Follows .

:Edge5 a :Solid, :Edge ;
    :source :Node4 ;
    :target :Node6 ;
    :relationshipType :Follows .

:Edge6 a :Solid, :Edge ;
    :source :Node6 ;
    :target :Node5 ;
    :relationshipType :Follows .

:Edge7 a :Solid, :Edge ;
    :source :Node6 ;
    :target :Node7 ;
    :relationshipType :Follows .

:Edge8 a :Solid, :Edge ;
    :source :Node7 ;
    :target :Node8 ;
    :relationshipType :Follows .

:Edge9 a :Solid, :Edge ;
    :source :Node7 ;
    :target :Node9 ;
    :relationshipType :Follows .

:Edge10 a :Solid, :Edge ;
    :source :Node9 ;
    :target :Node8 ;
    :relationshipType :Follows .
