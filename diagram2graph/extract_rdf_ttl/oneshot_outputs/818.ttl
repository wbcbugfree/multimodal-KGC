@prefix : <http://example.org/diagram2graph#> .

:Node1 a :Process, :Node ;
    :label "Input" ;
    :shape :Task .

:Node2 a :Process, :Node ;
    :label "Filtering" ;
    :shape :Task .

:Node3 a :Process, :Node ;
    :label "Connect ribs" ;
    :shape :Task .

:Node4 a :Process, :Node ;
    :label "Skeleton" ;
    :shape :Task .

:Node5 a :Process, :Node ;
    :label "Segmentation Using Level set" ;
    :shape :Task .

:Edge1 a :Solid, :Edge ;
    :source :Node1 ;
    :target :Node2 ;
    :relationshipType :Follows .

:Edge2 a :Solid, :Edge ;
    :source :Node2 ;
    :target :Node3 ;
    :relationshipType :Follows .

:Edge3 a :Solid, :Edge ;
    :source :Node3 ;
    :target :Node4 ;
    :relationshipType :Follows .

:Edge4 a :Solid, :Edge ;
    :source :Node4 ;
    :target :Node5 ;
    :relationshipType :Follows .
