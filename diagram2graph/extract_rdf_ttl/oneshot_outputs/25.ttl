@prefix : <http://example.org/diagram2graph#> .

:Node1 a :Process, :Node ;
    :label "Start" ;
    :shape :Task .

:Node2 a :Process, :Node ;
    :label "Topic assigned" ;
    :shape :Task .

:Node3 a :Process, :Node ;
    :label "Discuss" ;
    :shape :Task .

:Node4 a :Process, :Node ;
    :label "Draft review" ;
    :shape :Task .

:Node5 a :Process, :Node ;
    :label "Finish" ;
    :shape :Task .

:Edge1 a :Solid, :Edge ;
    :source :Node1 ;
    :target :Node2 ;
    :relationshipType :Follows ;
    :relationshipValue "Brainstorm" .

:Edge2 a :Solid, :Edge ;
    :source :Node2 ;
    :target :Node3 ;
    :relationshipType :Follows ;
    :relationshipValue "Outline" .

:Edge3 a :Solid, :Edge ;
    :source :Node3 ;
    :target :Node2 ;
    :relationshipType :Follows ;
    :relationshipValue "Return" .

:Edge4 a :Solid, :Edge ;
    :source :Node4 ;
    :target :Node3 ;
    :relationshipType :Follows ;
    :relationshipValue "changes" .

:Edge5 a :Solid, :Edge ;
    :source :Node3 ;
    :target :Node4 ;
    :relationshipType :Follows ;
    :relationshipValue "Draft" .

:Edge6 a :Solid, :Edge ;
    :source :Node4 ;
    :target :Node5 ;
    :relationshipType :Follows ;
    :relationshipValue "Approved" .
