@prefix : <http://example.org/diagram2graph#> .

:Node1 a :Start, :Node ;
    :label "Start" ;
    :shape :StartEvent .

:Node2 a :Process, :Node ;
    :label "Brainstorm" ;
    :shape :Task .

:Node3 a :Process, :Node ;
    :label "Topic assigned" ;
    :shape :Task .

:Node4 a :Process, :Node ;
    :label "Discuss" ;
    :shape :Task .

:Node5 a :Process, :Node ;
    :label "Draft review" ;
    :shape :Task .

:Node6 a :Terminator, :Node ;
    :label "Finish" ;
    :shape :EndEvent .

:Edge12 a :Solid, :Edge ;
    :source :Node1 ;
    :target :Node2 ;
    :relationshipType :Follows .

:Edge23 a :Solid, :Edge ;
    :source :Node2 ;
    :target :Node3 ;
    :relationshipType :Follows .

:Edge34 a :Solid, :Edge ;
    :source :Node3 ;
    :target :Node4 ;
    :relationshipType :Follows ;
    :relationshipValue "Outline" .

:Edge43 a :Solid, :Edge ;
    :source :Node4 ;
    :target :Node3 ;
    :relationshipType :Follows ;
    :relationshipValue "Return" .

:Edge45 a :Solid, :Edge ;
    :source :Node4 ;
    :target :Node5 ;
    :relationshipType :Follows ;
    :relationshipValue "Draft" .

:Edge54 a :Solid, :Edge ;
    :source :Node5 ;
    :target :Node4 ;
    :relationshipType :Follows ;
    :relationshipValue "changes" .

:Edge56 a :Solid, :Edge ;
    :source :Node5 ;
    :target :Node6 ;
    :relationshipType :Follows ;
    :relationshipValue "Approved" .
