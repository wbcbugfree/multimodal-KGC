@prefix : <http://example.org/diagram2graph#> .

:Node1 a :Start, :Node ;
    :label "Start" ;
    :shape :StartEvent .

:Node2 a :Process, :Node ;
    :label "Documentation Work" ;
    :shape :Task .

:Node3 a :Process, :Node ;
    :label "Print cycle count sheets" ;
    :shape :Task .

:Node4 a :Process, :Node ;
    :label "Perform physical count of stock" ;
    :shape :Task .

:Node5 a :Process, :Node ;
    :label "Enter physical counts" ;
    :shape :Task .

:Node6 a :Process, :Node ;
    :label "Report differences" ;
    :shape :Task .

:Node7 a :Decision, :Node ;
    :label "Recount inventory ?" ;
    :shape :Gateway .

:Node8 a :Process, :Node ;
    :label "Post inventory documents" ;
    :shape :Task .

:Node9 a :Terminator, :Node ;
    :label "End" ;
    :shape :EndEvent .

:Node10 a :Process, :Node ;
    :label "Display documents" ;
    :shape :Task .

:Node11 a :Process, :Node ;
    :label "Perform physical count of stock" ;
    :shape :Task .

:Edge12 a :Solid, :Edge ;
    :source :Node1 ;
    :target :Node2 ;
    :relationshipType :Follows .

:Edge23 a :Solid, :Edge ;
    :source :Node2 ;
    :target :Node3 ;
    :relationshipType :Follows .

:Edge34 a :Solid, :Edge ;
    :source :Node3 ;
    :target :Node4 ;
    :relationshipType :Follows .

:Edge45 a :Solid, :Edge ;
    :source :Node4 ;
    :target :Node5 ;
    :relationshipType :Follows .

:Edge56 a :Solid, :Edge ;
    :source :Node5 ;
    :target :Node6 ;
    :relationshipType :Follows .

:Edge67 a :Solid, :Edge ;
    :source :Node6 ;
    :target :Node7 ;
    :relationshipType :Follows .

:Edge78 a :Solid, :Edge ;
    :source :Node7 ;
    :target :Node8 ;
    :relationshipType :Branches ;
    :relationshipValue "No" .

:Edge89 a :Solid, :Edge ;
    :source :Node8 ;
    :target :Node9 ;
    :relationshipType :Follows .

:Edge116 a :Solid, :Edge ;
    :source :Node11 ;
    :target :Node6 ;
    :relationshipType :Follows .

:Edge710 a :Solid, :Edge ;
    :source :Node7 ;
    :target :Node10 ;
    :relationshipType :Branches ;
    :relationshipValue "Yes" .

:Edge1011 a :Solid, :Edge ;
    :source :Node10 ;
    :target :Node11 ;
    :relationshipType :Follows .
