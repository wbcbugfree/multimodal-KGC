@prefix : <http://example.org/diagram2graph#> .

:Node1 a :Start, :Node ;
    :label "Start" ;
    :shape :StartEvent .

:Node2 a :Decision, :Node ;
    :label "If Condition" ;
    :shape :Gateway .

:Node3 a :Process, :Node ;
    :label "If Body" ;
    :shape :Task .

:Node4 a :Process, :Node ;
    :label "Else Body" ;
    :shape :Task .

:Node5 a :Process, :Node ;
    :label "Statement just below if" ;
    :shape :Task .

:Node6 a :Terminator, :Node ;
    :label "Exit" ;
    :shape :EndEvent .

:Edge12 a :Solid, :Edge ;
    :source :Node1 ;
    :target :Node2 ;
    :relationshipType :Follows .

:Edge23 a :Solid, :Edge ;
    :source :Node2 ;
    :target :Node3 ;
    :relationshipType :Branches ;
    :relationshipValue "True" .

:Edge24 a :Solid, :Edge ;
    :source :Node2 ;
    :target :Node4 ;
    :relationshipType :Branches ;
    :relationshipValue "False" .

:Edge35 a :Solid, :Edge ;
    :source :Node3 ;
    :target :Node5 ;
    :relationshipType :Follows .

:Edge45 a :Solid, :Edge ;
    :source :Node4 ;
    :target :Node5 ;
    :relationshipType :Follows .

:Edge56 a :Solid, :Edge ;
    :source :Node5 ;
    :target :Node6 ;
    :relationshipType :Follows .
