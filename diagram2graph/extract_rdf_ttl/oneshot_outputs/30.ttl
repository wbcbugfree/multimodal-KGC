@prefix : <http://example.org/diagram2graph#> .

:Node1 a :Start, :Node ;
    :label "Begin" ;
    :shape :StartEvent .

:Node2 a :Process, :Node ;
    :label "X=1" ;
    :shape :Task .

:Node3 a :Decision, :Node ;
    :label "X>1" ;
    :shape :Gateway .

:Node4 a :Terminator, :Node ;
    :label "End" ;
    :shape :EndEvent .

:Node5 a :Process, :Node ;
    :label "OUTPUT X" ;
    :shape :Task .

:Node6 a :Process, :Node ;
    :label "X=X+1" ;
    :shape :Task .

:Edge12 a :Solid, :Edge ;
    :source :Node1 ;
    :target :Node2 ;
    :relationshipType :Follows .

:Edge23 a :Solid, :Edge ;
    :source :Node2 ;
    :target :Node3 ;
    :relationshipType :Follows .

:Edge34 a :Solid, :Edge ;
    :source :Node3 ;
    :target :Node4 ;
    :relationshipType :Branches ;
    :relationshipValue "No" .

:Edge35 a :Solid, :Edge ;
    :source :Node3 ;
    :target :Node5 ;
    :relationshipType :Branches ;
    :relationshipValue "Yes" .

:Edge56 a :Solid, :Edge ;
    :source :Node5 ;
    :target :Node6 ;
    :relationshipType :Follows .

:Edge63 a :Solid, :Edge ;
    :source :Node6 ;
    :target :Node3 ;
    :relationshipType :Follows .
