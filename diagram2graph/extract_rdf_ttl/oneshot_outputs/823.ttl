@prefix : <http://example.org/diagram2graph#> .

:Node1 a :Process, :Node ;
    :label "Application" ;
    :shape :Task .

:Node2 a :Process, :Node ;
    :label "Login" ;
    :shape :Task .

:Node3 a :Process, :Node ;
    :label "Apply" ;
    :shape :Task .

:Node4 a :Process, :Node ;
    :label "Shortlist resumes" ;
    :shape :Task .

:Node5 a :Process, :Node ;
    :label "E-mail resumes to departments" ;
    :shape :Task .

:Node6 a :Decision, :Node ;
    :label "Resumes approved ?" ;
    :shape :Gateway .

:Node7 a :Process, :Node ;
    :label "Call for interview" ;
    :shape :Task .

:Node8 a :Terminator, :Node ;
    :label "End hiring Stage 1" ;
    :shape :EndEvent .

:Node9 a :Process, :Node ;
    :label "Screen more resumes" ;
    :shape :Task .

:Edge12 a :Solid, :Edge ;
    :source :Node1 ;
    :target :Node2 ;
    :relationshipType :Follows .

:Edge23 a :Solid, :Edge ;
    :source :Node2 ;
    :target :Node3 ;
    :relationshipType :Follows .

:Edge34 a :Solid, :Edge ;
    :source :Node3 ;
    :target :Node4 ;
    :relationshipType :Follows .

:Edge45 a :Solid, :Edge ;
    :source :Node4 ;
    :target :Node5 ;
    :relationshipType :Follows .

:Edge56 a :Solid, :Edge ;
    :source :Node5 ;
    :target :Node6 ;
    :relationshipType :Follows .

:Edge67 a :Solid, :Edge ;
    :source :Node6 ;
    :target :Node7 ;
    :relationshipType :Branches ;
    :relationshipValue "Yes" .

:Edge69 a :Solid, :Edge ;
    :source :Node6 ;
    :target :Node9 ;
    :relationshipType :Branches ;
    :relationshipValue "No" .

:Edge78 a :Solid, :Edge ;
    :source :Node7 ;
    :target :Node8 ;
    :relationshipType :Follows .

:Edge95 a :Solid, :Edge ;
    :source :Node9 ;
    :target :Node5 ;
    :relationshipType :Follows .
