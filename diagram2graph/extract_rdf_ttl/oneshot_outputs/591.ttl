@prefix : <http://example.org/diagram2graph#> .

:Node1 a :Start, :Node ;
    :label "Start" ;
    :shape :StartEvent .

:Node2 a :Process, :Node ;
    :label "Scan Bar code" ;
    :shape :Task .

:Node3 a :Process, :Node ;
    :label "\"Reader\" decrypts message and sends it to \"3D object management interface\"" ;
    :shape :Task .

:Node4 a :Process, :Node ;
    :label "Check the website" ;
    :shape :Task .

:Node5 a :Process, :Node ;
    :label "The back-end server checks data and compares it with \"3D objects database\"" ;
    :shape :Task .

:Node6 a :Decision, :Node ;
    :label "Does data match the detail in \"3D objects database\"" ;
    :shape :Gateway .

:Node7 a :Process, :Node ;
    :label "An error message is displayed on the user screen" ;
    :shape :Task .

:Node8 a :Process, :Node ;
    :label "The 3D object is displayed on the user screen" ;
    :shape :Task .

:Edge12 a :Solid, :Edge ;
    :source :Node1 ;
    :target :Node2 ;
    :relationshipType :Follows .

:Edge23 a :Solid, :Edge ;
    :source :Node2 ;
    :target :Node3 ;
    :relationshipType :Follows .

:Edge34 a :Solid, :Edge ;
    :source :Node3 ;
    :target :Node4 ;
    :relationshipType :Follows .

:Edge45 a :Solid, :Edge ;
    :source :Node4 ;
    :target :Node5 ;
    :relationshipType :Follows .

:Edge56 a :Solid, :Edge ;
    :source :Node5 ;
    :target :Node6 ;
    :relationshipType :Follows .

:Edge67 a :Solid, :Edge ;
    :source :Node6 ;
    :target :Node7 ;
    :relationshipType :Branches ;
    :relationshipValue "No?" .

:Edge68 a :Solid, :Edge ;
    :source :Node6 ;
    :target :Node8 ;
    :relationshipType :Branches ;
    :relationshipValue "Yes?" .
