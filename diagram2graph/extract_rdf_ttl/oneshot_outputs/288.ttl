@prefix : <http://example.org/diagram2graph#> .

:Node1 a :Start, :Node ;
    :label "Begin" ;
    :shape :StartEvent .

:Node2 a :Process, :Node ;
    :label "Pre-configuration" ;
    :shape :Task .

:Node3 a :Process, :Node ;
    :label "Input" ;
    :shape :Task .

:Node4 a :Process, :Node ;
    :label "Input Signal Analysis" ;
    :shape :Task .

:Node5 a :Decision, :Node ;
    :label "Input Signal Analysis Finished?" ;
    :shape :Gateway .

:Node6 a :Process, :Node ;
    :label "Update" ;
    :shape :Task .

:Node7 a :Process, :Node ;
    :label "Output Signal Analysis" ;
    :shape :Task .

:Node8 a :Decision, :Node ;
    :label "Output Signal Analysis Finished?" ;
    :shape :Gateway .

:Node9 a :Process, :Node ;
    :label "Back to work" ;
    :shape :Task .

:Edge12 a :Solid, :Edge ;
    :source :Node1 ;
    :target :Node2 ;
    :relationshipType :Follows .

:Edge23 a :Solid, :Edge ;
    :source :Node2 ;
    :target :Node3 ;
    :relationshipType :Follows .

:Edge34 a :Solid, :Edge ;
    :source :Node3 ;
    :target :Node4 ;
    :relationshipType :Follows .

:Edge45 a :Solid, :Edge ;
    :source :Node4 ;
    :target :Node5 ;
    :relationshipType :Follows .

:Edge53 a :Solid, :Edge ;
    :source :Node5 ;
    :target :Node3 ;
    :relationshipType :Branches ;
    :relationshipValue "NO" .

:Edge57 a :Solid, :Edge ;
    :source :Node5 ;
    :target :Node7 ;
    :relationshipType :Branches ;
    :relationshipValue "YES" .

:Edge63 a :Solid, :Edge ;
    :source :Node6 ;
    :target :Node3 ;
    :relationshipType :Follows .

:Edge78 a :Solid, :Edge ;
    :source :Node7 ;
    :target :Node8 ;
    :relationshipType :Follows .

:Edge86 a :Solid, :Edge ;
    :source :Node8 ;
    :target :Node6 ;
    :relationshipType :Branches ;
    :relationshipValue "NO" .

:Edge89 a :Solid, :Edge ;
    :source :Node8 ;
    :target :Node9 ;
    :relationshipType :Branches ;
    :relationshipValue "YES" .

:Edge93 a :Solid, :Edge ;
    :source :Node9 ;
    :target :Node3 ;
    :relationshipType :Follows .
