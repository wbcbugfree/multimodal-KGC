@prefix : <http://example.org/diagram2graph#> .

:Node1 a :Start, :Node ;
    :label "Start" ;
    :shape :StartEvent .

:Node2 a :Process, :Node ;
    :label "Round 1 T = 1" ;
    :shape :Task .

:Node3 a :Process, :Node ;
    :label "Next round draw" ;
    :shape :Task .

:Node4 a :Process, :Node ;
    :label "Draw lots to select witness nodes" ;
    :shape :Task .

:Node5 a :Decision, :Node ;
    :label "Timeout verification" ;
    :shape :Gateway .

:Node6 a :Process, :Node ;
    :label "Binarize block" ;
    :shape :Task .

:Node7 a :Process, :Node ;
    :label "Packing block" ;
    :shape :Task .

:Node8 a :Decision, :Node ;
    :label "Block verification" ;
    :shape :Gateway .

:Node9 a :Process, :Node ;
    :label "Authentication" ;
    :shape :Task .

:Node10 a :Process, :Node ;
    :label "Finish" ;
    :shape :Task .

:Edge12 a :Solid, :Edge ;
    :source :Node1 ;
    :target :Node2 ;
    :relationshipType :Follows .

:Edge24 a :Solid, :Edge ;
    :source :Node2 ;
    :target :Node4 ;
    :relationshipType :Follows .

:Edge34 a :Solid, :Edge ;
    :source :Node3 ;
    :target :Node4 ;
    :relationshipType :Follows .

:Edge46 a :Solid, :Edge ;
    :source :Node4 ;
    :target :Node6 ;
    :relationshipType :Follows .

:Edge53 a :Solid, :Edge ;
    :source :Node5 ;
    :target :Node3 ;
    :relationshipType :Branches ;
    :relationshipValue "Timeout" .

:Edge67 a :Solid, :Edge ;
    :source :Node6 ;
    :target :Node7 ;
    :relationshipType :Follows .

:Edge78 a :Solid, :Edge ;
    :source :Node7 ;
    :target :Node8 ;
    :relationshipType :Follows .

:Edge85 a :Solid, :Edge ;
    :source :Node8 ;
    :target :Node5 ;
    :relationshipType :Branches ;
    :relationshipValue "Verification failed" .

:Edge89 a :Solid, :Edge ;
    :source :Node8 ;
    :target :Node9 ;
    :relationshipType :Branches .

:Edge96 a :Solid, :Edge ;
    :source :Node9 ;
    :target :Node6 ;
    :relationshipType :Follows .

:Edge810 a :Solid, :Edge ;
    :source :Node8 ;
    :target :Node10 ;
    :relationshipType :Branches ;
    :relationshipValue "Success" .
