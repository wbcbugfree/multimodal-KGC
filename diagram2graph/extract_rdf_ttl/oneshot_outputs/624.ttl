@prefix : <http://example.org/diagram2graph#> .

:Node1 a :Start, :Node ;
    :label "Fruits" ;
    :shape :StartEvent .

:Node2 a :Process, :Node ;
    :label "Input mango, pitaya, durian" ;
    :shape :Task .

:Node3 a :Decision, :Node ;
    :label "Prefer pitaya to durian?" ;
    :shape :Gateway .

:Node4 a :Decision, :Node ;
    :label "Prefer mango to pitaya?" ;
    :shape :Gateway .

:Node5 a :Decision, :Node ;
    :label "Prefer mango to durain" ;
    :shape :Gateway .

:Node6 a :Process, :Node ;
    :label "Go for mango" ;
    :shape :Task .

:Node7 a :Process, :Node ;
    :label "Go for pitaya" ;
    :shape :Task .

:Node8 a :Process, :Node ;
    :label "Go for pitaya" ;
    :shape :Task .

:Node9 a :Terminator, :Node ;
    :label "End" ;
    :shape :EndEvent .

:Edge1 a :Solid, :Edge ;
    :source :Node1 ;
    :target :Node2 ;
    :relationshipType :Follows .

:Edge2 a :Solid, :Edge ;
    :source :Node2 ;
    :target :Node4 ;
    :relationshipType :Follows .

:Edge3 a :Solid, :Edge ;
    :source :Node4 ;
    :target :Node3 ;
    :relationshipType :Branches ;
    :relationshipValue "No" .

:Edge4 a :Solid, :Edge ;
    :source :Node4 ;
    :target :Node5 ;
    :relationshipType :Branches ;
    :relationshipValue "Yes" .

:Edge5 a :Solid, :Edge ;
    :source :Node3 ;
    :target :Node6 ;
    :relationshipType :Branches ;
    :relationshipValue "Yes" .
