@prefix : <http://example.org/diagram2graph#> .

:Node1 a :Start, :Node ;
    :label "Mail Invoice to Accounts Payable" ;
    :shape :StartEvent .

:Node2 a :Process, :Node ;
    :label "Review Invoice for Compliance" ;
    :shape :Task .

:Node3 a :Decision, :Node ;
    :label "Invoice Meets Requirement?" ;
    :shape :Gateway .

:Node4 a :Process, :Node ;
    :label "Don't accept" ;
    :shape :Task .

:Node5 a :Decision, :Node ;
    :label "Approval?" ;
    :shape :Gateway .

:Node6 a :Process, :Node ;
    :label "Place in queue" ;
    :shape :Task .

:Node7 a :Process, :Node ;
    :label "Invoice Placed in Payment Queue" ;
    :shape :Task .

:Node8 a :Decision, :Node ;
    :label "Action Taken, Issue Resolved?" ;
    :shape :Gateway .

:Node9 a :Terminator, :Node ;
    :label "Payment Processed" ;
    :shape :EndEvent .

:Edge1 a :Solid, :Edge ;
    :source :Node1 ;
    :target :Node2 ;
    :relationshipType :Follows .

:Edge2 a :Solid, :Edge ;
    :source :Node2 ;
    :target :Node3 ;
    :relationshipType :Follows .

:Edge3 a :Dashed, :Edge ;
    :source :Node3 ;
    :target :Node4 ;
    :relationshipType :Branches ;
    :relationshipValue "No" .

:Edge4 a :Solid, :Edge ;
    :source :Node3 ;
    :target :Node5 ;
    :relationshipType :Branches ;
    :relationshipValue "Yes" .

:Edge5 a :Dashed, :Edge ;
    :source :Node5 ;
    :target :Node6 ;
    :relationshipType :Branches ;
    :relationshipValue "No" .

:Edge6 a :Dashed, :Edge ;
    :source :Node5 ;
    :target :Node7 ;
    :relationshipType :Branches ;
    :relationshipValue "Yes" .

:Edge7 a :Solid, :Edge ;
    :source :Node7 ;
    :target :Node9 ;
    :relationshipType :Follows .

:Edge8 a :Dashed, :Edge ;
    :source :Node8 ;
    :target :Node6 ;
    :relationshipType :Branches ;
    :relationshipValue "No" .

:Edge9 a :Solid, :Edge ;
    :source :Node8 ;
    :target :Node5 ;
    :relationshipType :Branches ;
    :relationshipValue "Yes" .
