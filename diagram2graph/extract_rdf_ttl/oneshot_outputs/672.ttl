@prefix : <http://example.org/diagram2graph#> .

:Node1 a :Start, :Node ;
    :label "START" ;
    :shape :StartEvent .

:Node2 a :Process, :Node ;
    :label "Read Inputs" ;
    :shape :Task .

:Node3 a :Process, :Node ;
    :label "Read command from\nBluetooth Unit" ;
    :shape :Task .

:Node4 a :Process, :Node ;
    :label "Run sensors" ;
    :shape :Task .

:Node5 a :Process, :Node ;
    :label "Read sensor values" ;
    :shape :Task .

:Node6 a :Process, :Node ;
    :label "Send read sensor values\nTo bluetooth unit" ;
    :shape :Task .

:Edge12 a :Solid, :Edge ;
    :source :Node1 ;
    :target :Node2 ;
    :relationshipType :Follows .

:Edge23 a :Solid, :Edge ;
    :source :Node2 ;
    :target :Node3 ;
    :relationshipType :Follows .

:Edge34 a :Solid, :Edge ;
    :source :Node3 ;
    :target :Node4 ;
    :relationshipType :Follows .

:Edge45 a :Solid, :Edge ;
    :source :Node4 ;
    :target :Node5 ;
    :relationshipType :Follows .

:Edge56 a :Solid, :Edge ;
    :source :Node5 ;
    :target :Node6 ;
    :relationshipType :Follows .

:Edge63 a :Solid, :Edge ;
    :source :Node6 ;
    :target :Node3 ;
    :relationshipType :Follows .
