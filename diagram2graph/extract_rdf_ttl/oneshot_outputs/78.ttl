@prefix : <http://example.org/diagram2graph#> .

:Node1 a :Start, :Node ;
    :label "Begin" ;
    :shape :StartEvent .

:Node2 a :Process, :Node ;
    :label "Add slack variables to\ninequality constraints" ;
    :shape :Task .

:Node3 a :Process, :Node ;
    :label "Calculate variables" ;
    :shape :Task .

:Node4 a :Process, :Node ;
    :label "Calculate reduced\ngradient" ;
    :shape :Task .

:Node5 a :Process, :Node ;
    :label "Determine\nsearch vector" ;
    :shape :Task .

:Node6 a :Process, :Node ;
    :label "Perform operations" ;
    :shape :Task .

:Node7 a :Decision, :Node ;
    :label "Converged\n?" ;
    :shape :Gateway .

:Node8 a :Terminator, :Node ;
    :label "Exit" ;
    :shape :EndEvent .

:Edge1 a :Solid, :Edge ;
    :source :Node1 ;
    :target :Node2 ;
    :relationshipType :Follows .

:Edge2 a :Solid, :Edge ;
    :source :Node2 ;
    :target :Node3 ;
    :relationshipType :Follows .

:Edge3 a :Solid, :Edge ;
    :source :Node3 ;
    :target :Node4 ;
    :relationshipType :Follows .

:Edge4 a :Solid, :Edge ;
    :source :Node4 ;
    :target :Node5 ;
    :relationshipType :Follows .

:Edge5 a :Solid, :Edge ;
    :source :Node5 ;
    :target :Node6 ;
    :relationshipType :Follows .

:Edge6 a :Solid, :Edge ;
    :source :Node6 ;
    :target :Node7 ;
    :relationshipType :Follows .

:Edge7 a :Solid, :Edge ;
    :source :Node7 ;
    :target :Node3 ;
    :relationshipType :Branches ;
    :relationshipValue "No" .

:Edge8 a :Solid, :Edge ;
    :source :Node7 ;
    :target :Node8 ;
    :relationshipType :Branches ;
    :relationshipValue "Yes" .
