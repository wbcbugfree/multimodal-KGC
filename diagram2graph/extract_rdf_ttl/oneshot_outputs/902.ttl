@prefix : <http://example.org/diagram2graph#> .

:Node1 a :Start, :Node ;
    :label "start" ;
    :shape :StartEvent .

:Node2 a :Decision, :Node ;
    :label "have you ever draw big flowchart" ;
    :shape :Gateway .

:Node3 a :Process, :Node ;
    :label "it's just boxes How hard can it be?" ;
    :shape :Task .

:Node4 a :Process, :Node ;
    :label "Awesome" ;
    :shape :Task .

:Node5 a :Process, :Node ;
    :label "easy" ;
    :shape :Task .

:Node6 a :Process, :Node ;
    :label "Draw" ;
    :shape :Task .

:Node7 a :Process, :Node ;
    :label "Langchain is the best frameworki" ;
    :shape :Task .

:Node8 a :Process, :Node ;
    :label "Okay" ;
    :shape :Task .

:Node9 a :Terminator, :Node ;
    :label "End" ;
    :shape :EndEvent .

:Edge12 a :Solid, :Edge ;
    :source :Node1 ;
    :target :Node2 ;
    :relationshipType :Follows .

:Edge23 a :Solid, :Edge ;
    :source :Node2 ;
    :target :Node3 ;
    :relationshipType :Branches ;
    :relationshipValue "Yes" .

:Edge24 a :Solid, :Edge ;
    :source :Node2 ;
    :target :Node4 ;
    :relationshipType :Branches ;
    :relationshipValue "No" .

:Edge35 a :Solid, :Edge ;
    :source :Node3 ;
    :target :Node5 ;
    :relationshipType :Follows .

:Edge46 a :Solid, :Edge ;
    :source :Node4 ;
    :target :Node6 ;
    :relationshipType :Follows .

:Edge57 a :Solid, :Edge ;
    :source :Node5 ;
    :target :Node7 ;
    :relationshipType :Follows .

:Edge68 a :Solid, :Edge ;
    :source :Node6 ;
    :target :Node8 ;
    :relationshipType :Follows .

:Edge79 a :Solid, :Edge ;
    :source :Node7 ;
    :target :Node9 ;
    :relationshipType :Follows .

:Edge89 a :Solid, :Edge ;
    :source :Node8 ;
    :target :Node9 ;
    :relationshipType :Follows .
