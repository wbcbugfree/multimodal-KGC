@prefix : <http://example.org/diagram2graph#> .

:Node1 a :Start, :Node ;
    :label "Begin" ;
    :shape :StartEvent .

:Node2 a :Process, :Node ;
    :label "Online Application" ;
    :shape :Task .

:Node3 a :Process, :Node ;
    :label "Applicant meets with a loan officer to discuss their needs" ;
    :shape :Task .

:Node4 a :Process, :Node ;
    :label "Process Application" ;
    :shape :Task .

:Node5 a :Decision, :Node ;
    :label "Application reviewed by the office manager" ;
    :shape :Gateway .

:Node6 a :Process, :Node ;
    :label "Application Rejected" ;
    :shape :Task .

:Node7 a :Process, :Node ;
    :label "Application Approved" ;
    :shape :Task .

:Node8 a :Terminator, :Node ;
    :label "END" ;
    :shape :EndEvent .

:Edge12 a :Solid, :Edge ;
    :source :Node1 ;
    :target :Node2 ;
    :relationshipType :Follows .

:Edge23 a :Solid, :Edge ;
    :source :Node2 ;
    :target :Node3 ;
    :relationshipType :Follows .

:Edge34 a :Solid, :Edge ;
    :source :Node3 ;
    :target :Node4 ;
    :relationshipType :Follows .

:Edge45 a :Solid, :Edge ;
    :source :Node4 ;
    :target :Node5 ;
    :relationshipType :Follows .

:Edge56 a :Solid, :Edge ;
    :source :Node5 ;
    :target :Node6 ;
    :relationshipType :Branches ;
    :relationshipValue "N" .

:Edge57 a :Solid, :Edge ;
    :source :Node5 ;
    :target :Node7 ;
    :relationshipType :Branches ;
    :relationshipValue "Y" .

:Edge68 a :Solid, :Edge ;
    :source :Node6 ;
    :target :Node8 ;
    :relationshipType :Follows .

:Edge78 a :Solid, :Edge ;
    :source :Node7 ;
    :target :Node8 ;
    :relationshipType :Follows .
