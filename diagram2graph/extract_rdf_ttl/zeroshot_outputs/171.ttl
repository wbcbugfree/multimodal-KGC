@prefix : <http://example.org/diagram2graph#> .

:Node1 a :Start, :Node ;
    :label "Start" ;
    :shape :StartEvent .

:Node2 a :Decision, :Node ;
    :label "Are you happy?" ;
    :shape :Gateway .

:Node3 a :Process, :Node ;
    :label "Make others happy" ;
    :shape :Task .

:Node4 a :Terminator, :Node ;
    :label "Stop" ;
    :shape :EndEvent .

:Node5 a :Decision, :Node ;
    :label "Want to be happy?" ;
    :shape :Gateway .

:Node6 a :Process, :Node ;
    :label "Ask someone" ;
    :shape :Task .

:Node7 a :Process, :Node ;
    :label "all over" ;
    :shape :Task .

:Edge12 a :Solid, :Edge ;
    :source :Node1 ;
    :target :Node2 ;
    :relationshipType :Follows .

:Edge23 a :Solid, :Edge ;
    :source :Node2 ;
    :target :Node3 ;
    :relationshipType :Branches ;
    :relationshipValue "Yes" .

:Edge25 a :Solid, :Edge ;
    :source :Node2 ;
    :target :Node5 ;
    :relationshipType :Branches ;
    :relationshipValue "No" .

:Edge34 a :Solid, :Edge ;
    :source :Node3 ;
    :target :Node4 ;
    :relationshipType :Follows .

:Edge56 a :Solid, :Edge ;
    :source :Node5 ;
    :target :Node6 ;
    :relationshipType :Branches ;
    :relationshipValue "Yes" .

:Edge57 a :Solid, :Edge ;
    :source :Node5 ;
    :target :Node7 ;
    :relationshipType :Branches ;
    :relationshipValue "No" .

:Edge64 a :Solid, :Edge ;
    :source :Node6 ;
    :target :Node4 ;
    :relationshipType :Follows .

:Edge71 a :Solid, :Edge ;
    :source :Node7 ;
    :target :Node1 ;
    :relationshipType :Follows .
