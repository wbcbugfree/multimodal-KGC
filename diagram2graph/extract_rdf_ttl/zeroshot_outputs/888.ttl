@prefix : <http://example.org/diagram2graph#> .

:Node1 a :Process, :Node ;
    :label "Raw Materials" ;
    :shape :Task .

:Node2 a :Process, :Node ;
    :label "Melting" ;
    :shape :Task .

:Node3 a :Process, :Node ;
    :label "Forming" ;
    :shape :Task .

:Node4 a :Process, :Node ;
    :label "Sampling" ;
    :shape :Task .

:Node5 a :Process, :Node ;
    :label "Warehousing" ;
    :shape :Task .

:Node6 a :Process, :Node ;
    :label "Secondary Processing" ;
    :shape :Task .

:Node7 a :Process, :Node ;
    :label "Inspection and Testing" ;
    :shape :Task .

:Edge1 a :Solid, :Edge ;
    :source :Node1 ;
    :target :Node2 ;
    :relationshipType :Follows .

:Edge2 a :Solid, :Edge ;
    :source :Node2 ;
    :target :Node3 ;
    :relationshipType :Follows .

:Edge3 a :Solid, :Edge ;
    :source :Node3 ;
    :target :Node4 ;
    :relationshipType :Follows .

:Edge4 a :Solid, :Edge ;
    :source :Node4 ;
    :target :Node7 ;
    :relationshipType :Follows .

:Edge5 a :Solid, :Edge ;
    :source :Node6 ;
    :target :Node5 ;
    :relationshipType :Follows .

:Edge6 a :Solid, :Edge ;
    :source :Node7 ;
    :target :Node6 ;
    :relationshipType :Follows .
