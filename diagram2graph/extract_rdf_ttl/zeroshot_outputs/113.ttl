@prefix : <http://example.org/diagram2graph#> .

:Node1 a :Decision, :Node ;
    :label "Do you have time to flee?" ;
    :shape :Gateway .

:Node2 a :Process, :Node ;
    :label "Run quickly" ;
    :shape :Task .

:Node3 a :Decision, :Node ;
    :label "Are you wearing sun glasses?" ;
    :shape :Gateway .

:Node4 a :Process, :Node ;
    :label "Don't run" ;
    :shape :Task .

:Node5 a :Terminator, :Node ;
    :label "Yeah! No need to say hi." ;
    :shape :EndEvent .

:Node6 a :Decision, :Node ;
    :label "Could you pretend to get a call?" ;
    :shape :Gateway .

:Node7 a :Process, :Node ;
    :label "No problem" ;
    :shape :Task .

:Node8 a :Terminator, :Node ;
    :label "Finish" ;
    :shape :EndEvent .

:Edge1 a :Solid, :Edge ;
    :source :Node1 ;
    :target :Node2 ;
    :relationshipType :Branches ;
    :relationshipValue "Yes" .

:Edge2 a :Solid, :Edge ;
    :source :Node1 ;
    :target :Node3 ;
    :relationshipType :Branches ;
    :relationshipValue "No" .

:Edge3 a :Solid, :Edge ;
    :source :Node2 ;
    :target :Node5 ;
    :relationshipType :Follows .

:Edge4 a :Solid, :Edge ;
    :source :Node3 ;
    :target :Node4 ;
    :relationshipType :Branches ;
    :relationshipValue "Yes" .

:Edge5 a :Solid, :Edge ;
    :source :Node3 ;
    :target :Node6 ;
    :relationshipType :Branches ;
    :relationshipValue "No" .

:Edge6 a :Solid, :Edge ;
    :source :Node4 ;
    :target :Node5 ;
    :relationshipType :Follows .

:Edge7 a :Solid, :Edge ;
    :source :Node6 ;
    :target :Node7 ;
    :relationshipType :Branches ;
    :relationshipValue "Yes" .

:Edge8 a :Solid, :Edge ;
    :source :Node6 ;
    :target :Node8 ;
    :relationshipType :Branches ;
    :relationshipValue "No" .

:Edge9 a :Solid, :Edge ;
    :source :Node7 ;
    :target :Node5 ;
    :relationshipType :Follows .
