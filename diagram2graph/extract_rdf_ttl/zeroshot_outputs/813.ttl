@prefix : <http://example.org/diagram2graph#> .

:Node1 a :Process, :Node ;
    :label "Topic" ;
    :shape :Task .

:Node2 a :Process, :Node ;
    :label "Power signal" ;
    :shape :Task .

:Node3 a :Process, :Node ;
    :label "Processor" ;
    :shape :Task .

:Node4 a :Process, :Node ;
    :label "Output" ;
    :shape :Task .

:Node5 a :Process, :Node ;
    :label "End" ;
    :shape :Task .

:Edge12 a :Solid, :Edge ;
    :source :Node1 ;
    :target :Node2 ;
    :relationshipType :Follows .

:Edge23 a :Solid, :Edge ;
    :source :Node2 ;
    :target :Node3 ;
    :relationshipType :Follows ;
    :relationshipValue "Stream" .

:Edge34 a :Solid, :Edge ;
    :source :Node3 ;
    :target :Node4 ;
    :relationshipType :Follows ;
    :relationshipValue "Stream" .

:Edge45 a :Solid, :Edge ;
    :source :Node4 ;
    :target :Node5 ;
    :relationshipType :Follows .
