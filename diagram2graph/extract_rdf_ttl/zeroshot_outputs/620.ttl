@prefix : <http://example.org/diagram2graph#> .

:Node1 a :Start, :Node ;
    :label "Start" ;
    :shape :StartEvent .

:Node2 a :Process, :Node ;
    :label "Submit the registration form" ;
    :shape :Task .

:Node3 a :Decision, :Node ;
    :label "Form Complete?" ;
    :shape :Gateway .

:Node4 a :Terminator, :Node ;
    :label "End" ;
    :shape :EndEvent .

:Node5 a :Process, :Node ;
    :label "Confirmation" ;
    :shape :Task .

:Node6 a :Process, :Node ;
    :label "Verify details" ;
    :shape :Task .

:Node7 a :Process, :Node ;
    :label "Return Document" ;
    :shape :Task .

:Node8 a :Decision, :Node ;
    :label "Accept Submission?" ;
    :shape :Gateway .

:Node9 a :Process, :Node ;
    :label "Write Acceptance Letter" ;
    :shape :Task .

:Edge12 a :Solid, :Edge ;
    :source :Node1 ;
    :target :Node2 ;
    :relationshipType :Follows .

:Edge23 a :Solid, :Edge ;
    :source :Node2 ;
    :target :Node3 ;
    :relationshipType :Follows .

:Edge32 a :Solid, :Edge ;
    :source :Node3 ;
    :target :Node2 ;
    :relationshipType :Branches ;
    :relationshipValue "No" .

:Edge36 a :Solid, :Edge ;
    :source :Node3 ;
    :target :Node6 ;
    :relationshipType :Branches ;
    :relationshipValue "Yes" .

:Edge54 a :Solid, :Edge ;
    :source :Node5 ;
    :target :Node4 ;
    :relationshipType :Follows .

:Edge68 a :Solid, :Edge ;
    :source :Node6 ;
    :target :Node8 ;
    :relationshipType :Follows .

:Edge74 a :Solid, :Edge ;
    :source :Node7 ;
    :target :Node4 ;
    :relationshipType :Follows .

:Edge87 a :Solid, :Edge ;
    :source :Node8 ;
    :target :Node7 ;
    :relationshipType :Branches ;
    :relationshipValue "No" .

:Edge89 a :Solid, :Edge ;
    :source :Node8 ;
    :target :Node9 ;
    :relationshipType :Branches ;
    :relationshipValue "Yes" .

:Edge95 a :Solid, :Edge ;
    :source :Node9 ;
    :target :Node5 ;
    :relationshipType :Follows .
