@prefix : <http://example.org/diagram2graph#> .

:Node1 a :Process, :Node ;
    :label "Add" ;
    :shape :Task .

:Node2 a :Terminator, :Node ;
    :label "End" ;
    :shape :EndEvent .

:Node3 a :Start, :Node ;
    :label "Begin" ;
    :shape :StartEvent .

:Node4 a :Process, :Node ;
    :label "Input" ;
    :shape :Task .

:Node5 a :Process, :Node ;
    :label "Process" ;
    :shape :Task .

:Node6 a :Process, :Node ;
    :label "Subtract" ;
    :shape :Task .

:Node7 a :Terminator, :Node ;
    :label "End" ;
    :shape :EndEvent .

:Edge1 a :Solid, :Edge ;
    :source :Node5 ;
    :target :Node1 ;
    :relationshipType :Branches ;
    :relationshipValue "yes" .

:Edge2 a :Solid, :Edge ;
    :source :Node1 ;
    :target :Node2 ;
    :relationshipType :Follows .

:Edge3 a :Solid, :Edge ;
    :source :Node3 ;
    :target :Node4 ;
    :relationshipType :Follows .

:Edge4 a :Solid, :Edge ;
    :source :Node4 ;
    :target :Node5 ;
    :relationshipType :Follows .

:Edge5 a :Solid, :Edge ;
    :source :Node5 ;
    :target :Node6 ;
    :relationshipType :Branches ;
    :relationshipValue "No" .

:Edge6 a :Solid, :Edge ;
    :source :Node6 ;
    :target :Node7 ;
    :relationshipType :Follows .
