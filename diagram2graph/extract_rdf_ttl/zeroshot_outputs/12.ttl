@prefix : <http://example.org/diagram2graph#> .

:Node1 a :Process, :Node ;
    :label "Login Profile" ;
    :shape :Task .

:Node2 a :Decision, :Node ;
    :label "Still Logged in?" ;
    :shape :Gateway .

:Node3 a :Process, :Node ;
    :label "Session time out" ;
    :shape :Task .

:Node4 a :Process, :Node ;
    :label "Go On" ;
    :shape :Task .

:Node5 a :Process, :Node ;
    :label "Login Again" ;
    :shape :Task .

:Node6 a :Decision, :Node ;
    :label "Logged in?" ;
    :shape :Gateway .

:Node7 a :Process, :Node ;
    :label "Pause Counting" ;
    :shape :Task .

:Edge12 a :Solid, :Edge ;
    :source :Node1 ;
    :target :Node2 ;
    :relationshipType :Follows .

:Edge23 a :Solid, :Edge ;
    :source :Node2 ;
    :target :Node3 ;
    :relationshipType :Branches ;
    :relationshipValue "No" .

:Edge24 a :Solid, :Edge ;
    :source :Node2 ;
    :target :Node4 ;
    :relationshipType :Branches ;
    :relationshipValue "Yes" .

:Edge35 a :Solid, :Edge ;
    :source :Node3 ;
    :target :Node5 ;
    :relationshipType :Follows .

:Edge42 a :Solid, :Edge ;
    :source :Node4 ;
    :target :Node2 ;
    :relationshipType :Follows .

:Edge56 a :Solid, :Edge ;
    :source :Node5 ;
    :target :Node6 ;
    :relationshipType :Follows .

:Edge64 a :Solid, :Edge ;
    :source :Node6 ;
    :target :Node4 ;
    :relationshipType :Branches ;
    :relationshipValue "Yes" .

:Edge67 a :Solid, :Edge ;
    :source :Node6 ;
    :target :Node7 ;
    :relationshipType :Branches ;
    :relationshipValue "No" .
