@prefix : <http://example.org/diagram2graph#> .

:Node1 a :Start, :Node ;
    :label "Start" ;
    :shape :StartEvent .

:Node2 a :Process, :Node ;
    :label "Power on" ;
    :shape :Task .

:Node3 a :Decision, :Node ;
    :label "Coffee selected" ;
    :shape :Gateway .

:Node4 a :Process, :Node ;
    :label "Add Chocolate powder" ;
    :shape :Task .

:Node5 a :Process, :Node ;
    :label "Add frothed milk" ;
    :shape :Task .

:Node6 a :Process, :Node ;
    :label "Add sugar" ;
    :shape :Task .

:Node7 a :Decision, :Node ;
    :label "Power pressed" ;
    :shape :Gateway .

:Node8 a :Process, :Node ;
    :label "Power off" ;
    :shape :Task .

:Node9 a :Terminator, :Node ;
    :label "End" ;
    :shape :EndEvent .

:Edge12 a :Solid, :Edge ;
    :source :Node1 ;
    :target :Node2 ;
    :relationshipType :Follows .

:Edge23 a :Solid, :Edge ;
    :source :Node2 ;
    :target :Node3 ;
    :relationshipType :Follows .

:Edge34 a :Solid, :Edge ;
    :source :Node3 ;
    :target :Node4 ;
    :relationshipType :Branches ;
    :relationshipValue "Mocha" .

:Edge35 a :Solid, :Edge ;
    :source :Node3 ;
    :target :Node5 ;
    :relationshipType :Branches ;
    :relationshipValue "Latte" .

:Edge36 a :Solid, :Edge ;
    :source :Node3 ;
    :target :Node6 ;
    :relationshipType :Branches ;
    :relationshipValue "Espresso" .

:Edge45 a :Solid, :Edge ;
    :source :Node4 ;
    :target :Node5 ;
    :relationshipType :Follows .

:Edge56 a :Solid, :Edge ;
    :source :Node5 ;
    :target :Node6 ;
    :relationshipType :Follows .

:Edge67 a :Solid, :Edge ;
    :source :Node6 ;
    :target :Node7 ;
    :relationshipType :Follows .

:Edge78 a :Solid, :Edge ;
    :source :Node7 ;
    :target :Node8 ;
    :relationshipType :Branches .

:Edge89 a :Solid, :Edge ;
    :source :Node8 ;
    :target :Node9 ;
    :relationshipType :Follows .
