@prefix : <http://example.org/diagram2graph#> .

:Node1 a :Start, :Node ;
    :label "START" ;
    :shape :StartEvent .

:Node2 a :Process, :Node ;
    :label "COMPUTE LOCAL ADMIN GROUP NAME" ;
    :shape :Task .

:Node3 a :Decision, :Node ;
    :label "ADD OR REMOVE?" ;
    :shape :Gateway .

:Node4 a :Process, :Node ;
    :label "Update" ;
    :shape :Task .

:Node5 a :Process, :Node ;
    :label "ADD USERS TO GROUP" ;
    :shape :Task .

:Node6 a :Process, :Node ;
    :label "Personalize" ;
    :shape :Task .

:Node7 a :Process, :Node ;
    :label "DISPLAY CURRENT MEMBERS" ;
    :shape :Task .

:Node8 a :Process, :Node ;
    :label "Check" ;
    :shape :Task .

:Node9 a :Terminator, :Node ;
    :label "END" ;
    :shape :EndEvent .

:Edge1 a :Solid, :Edge ;
    :source :Node1 ;
    :target :Node2 ;
    :relationshipType :Follows .

:Edge2 a :Solid, :Edge ;
    :source :Node2 ;
    :target :Node3 ;
    :relationshipType :Follows .

:Edge3 a :Solid, :Edge ;
    :source :Node3 ;
    :target :Node4 ;
    :relationshipType :Branches ;
    :relationshipValue "ADD" .

:Edge4 a :Solid, :Edge ;
    :source :Node3 ;
    :target :Node6 ;
    :relationshipType :Branches ;
    :relationshipValue "REMOVE" .

:Edge5 a :Solid, :Edge ;
    :source :Node4 ;
    :target :Node5 ;
    :relationshipType :Follows .

:Edge6 a :Solid, :Edge ;
    :source :Node5 ;
    :target :Node9 ;
    :relationshipType :Follows .

:Edge7 a :Solid, :Edge ;
    :source :Node6 ;
    :target :Node7 ;
    :relationshipType :Follows .

:Edge8 a :Solid, :Edge ;
    :source :Node7 ;
    :target :Node8 ;
    :relationshipType :Follows .

:Edge9 a :Solid, :Edge ;
    :source :Node8 ;
    :target :Node9 ;
    :relationshipType :Follows .
