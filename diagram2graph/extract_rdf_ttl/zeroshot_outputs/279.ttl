@prefix : <http://example.org/diagram2graph#> .

:Node1 a :Process, :Node ;
    :label "Start" ;
    :shape :Task .

:Node2 a :Process, :Node ;
    :label "Find changes in work" ;
    :shape :Task .

:Node3 a :Decision, :Node ;
    :label "Approval" ;
    :shape :Gateway .

:Node4 a :Process, :Node ;
    :label "Method" ;
    :shape :Task .

:Node5 a :Decision, :Node ;
    :label "Agree?" ;
    :shape :Gateway .

:Node6 a :Process, :Node ;
    :label "Expand" ;
    :shape :Task .

:Node7 a :Process, :Node ;
    :label "Discard" ;
    :shape :Task .

:Node8 a :Process, :Node ;
    :label "Ignore change" ;
    :shape :Task .

:Node9 a :Process, :Node ;
    :label "END" ;
    :shape :Task .

:Edge1 a :Solid, :Edge ;
    :source :Node1 ;
    :target :Node2 ;
    :relationshipType :Follows .

:Edge2 a :Solid, :Edge ;
    :source :Node2 ;
    :target :Node3 ;
    :relationshipType :Follows .

:Edge3 a :Solid, :Edge ;
    :source :Node3 ;
    :target :Node4 ;
    :relationshipType :Branches ;
    :relationshipValue "Yes" .

:Edge4 a :Solid, :Edge ;
    :source :Node3 ;
    :target :Node8 ;
    :relationshipType :Branches ;
    :relationshipValue "No" .

:Edge5 a :Solid, :Edge ;
    :source :Node4 ;
    :target :Node5 ;
    :relationshipType :Follows .

:Edge6 a :Solid, :Edge ;
    :source :Node5 ;
    :target :Node6 ;
    :relationshipType :Branches ;
    :relationshipValue "Yes" .

:Edge7 a :Solid, :Edge ;
    :source :Node5 ;
    :target :Node7 ;
    :relationshipType :Branches ;
    :relationshipValue "No" .

:Edge8 a :Solid, :Edge ;
    :source :Node6 ;
    :target :Node9 ;
    :relationshipType :Follows .

:Edge9 a :Solid, :Edge ;
    :source :Node7 ;
    :target :Node9 ;
    :relationshipType :Follows .

:Edge10 a :Solid, :Edge ;
    :source :Node8 ;
    :target :Node9 ;
    :relationshipType :Follows .
