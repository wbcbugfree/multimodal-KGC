@prefix : <http://example.org/diagram2graph#> .

:Node1 a :Start, :Node ;
    :label "1" ;
    :shape :StartEvent .

:Node2 a :Start, :Node ;
    :label "Costumer\nOrder" ;
    :shape :StartEvent .

:Node3 a :Process, :Node ;
    :label "Sales\nOrder" ;
    :shape :Task .

:Node4 a :Decision, :Node ;
    :label "Documentation" ;
    :shape :Gateway .

:Node5 a :Process, :Node ;
    :label "Prepare\nDO" ;
    :shape :Task .

:Node6 a :Process, :Node ;
    :label "Shipment" ;
    :shape :Task .

:Node7 a :Process, :Node ;
    :label "Goods\nDelivered" ;
    :shape :Task .

:Node8 a :Terminator, :Node ;
    :label "2" ;
    :shape :EndEvent .

:Edge12 a :Solid, :Edge ;
    :source :Node1 ;
    :target :Node2 ;
    :relationshipType :Follows .

:Edge23 a :Solid, :Edge ;
    :source :Node2 ;
    :target :Node3 ;
    :relationshipType :Follows .

:Edge34 a :Solid, :Edge ;
    :source :Node3 ;
    :target :Node4 ;
    :relationshipType :Follows .

:Edge43 a :Solid, :Edge ;
    :source :Node4 ;
    :target :Node3 ;
    :relationshipType :Branches ;
    :relationshipValue "No" .

:Edge45 a :Solid, :Edge ;
    :source :Node4 ;
    :target :Node5 ;
    :relationshipType :Branches ;
    :relationshipValue "Yes" .

:Edge56 a :Solid, :Edge ;
    :source :Node5 ;
    :target :Node6 ;
    :relationshipType :Follows .

:Edge67 a :Solid, :Edge ;
    :source :Node6 ;
    :target :Node7 ;
    :relationshipType :Follows .

:Edge78 a :Solid, :Edge ;
    :source :Node7 ;
    :target :Node8 ;
    :relationshipType :Follows .
