@prefix : <http://example.org/diagram2graph#> .

:Node1 a :Process, :Node ;
    :label "Do 1" ;
    :shape :Task .

:Node2 a :Start, :Node ;
    :label "Start" ;
    :shape :StartEvent .

:Node3 a :Decision, :Node ;
    :label "Make decision" ;
    :shape :Gateway .

:Node4 a :Process, :Node ;
    :label "Do 3" ;
    :shape :Task .

:Node5 a :Process, :Node ;
    :label "Do 2" ;
    :shape :Task .

:Node6 a :Terminator, :Node ;
    :label "Stop" ;
    :shape :EndEvent .

:Edge14 a :Solid, :Edge ;
    :source :Node1 ;
    :target :Node4 ;
    :relationshipType :Follows .

:Edge23 a :Solid, :Edge ;
    :source :Node2 ;
    :target :Node3 ;
    :relationshipType :Follows .

:Edge31 a :Solid, :Edge ;
    :source :Node3 ;
    :target :Node1 ;
    :relationshipType :Branches ;
    :relationshipValue "outcome 1" .

:Edge35 a :Solid, :Edge ;
    :source :Node3 ;
    :target :Node5 ;
    :relationshipType :Branches ;
    :relationshipValue "outcome 2" .

:Edge46 a :Solid, :Edge ;
    :source :Node4 ;
    :target :Node6 ;
    :relationshipType :Follows .

:Edge54 a :Solid, :Edge ;
    :source :Node5 ;
    :target :Node4 ;
    :relationshipType :Follows .
