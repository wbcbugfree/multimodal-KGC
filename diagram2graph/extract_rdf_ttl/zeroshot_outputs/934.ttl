@prefix : <http://example.org/diagram2graph#> .

:Node1 a :Start, :Node ;
    :label "Start" ;
    :shape :StartEvent .

:Node2 a :Process, :Node ;
    :label "Homepage" ;
    :shape :Task .

:Node3 a :Decision, :Node ;
    :label "have an account" ;
    :shape :Gateway .

:Node4 a :Process, :Node ;
    :label "Sign up" ;
    :shape :Task .

:Node5 a :Process, :Node ;
    :label "Fill out the information" ;
    :shape :Task .

:Node6 a :Process, :Node ;
    :label "Submit" ;
    :shape :Task .

:Node7 a :Process, :Node ;
    :label "Log in" ;
    :shape :Task .

:Node8 a :Process, :Node ;
    :label "Enter details" ;
    :shape :Task .

:Node9 a :Decision, :Node ;
    :label "e-mail and password valid" ;
    :shape :Gateway .

:Node10 a :Process, :Node ;
    :label "loged in to the system" ;
    :shape :Task .

:Node11 a :Terminator, :Node ;
    :label "end" ;
    :shape :EndEvent .

:Edge1 a :Solid, :Edge ;
    :source :Node1 ;
    :target :Node2 ;
    :relationshipType :Follows .

:Edge2 a :Solid, :Edge ;
    :source :Node2 ;
    :target :Node3 ;
    :relationshipType :Follows .

:Edge3 a :Solid, :Edge ;
    :source :Node3 ;
    :target :Node4 ;
    :relationshipType :Branches ;
    :relationshipValue "No" .

:Edge4 a :Solid, :Edge ;
    :source :Node4 ;
    :target :Node5 ;
    :relationshipType :Follows .

:Edge5 a :Solid, :Edge ;
    :source :Node5 ;
    :target :Node6 ;
    :relationshipType :Follows .

:Edge6 a :Solid, :Edge ;
    :source :Node6 ;
    :target :Node7 ;
    :relationshipType :Follows .

:Edge7 a :Solid, :Edge ;
    :source :Node3 ;
    :target :Node7 ;
    :relationshipType :Branches ;
    :relationshipValue "yes" .

:Edge8 a :Solid, :Edge ;
    :source :Node7 ;
    :target :Node8 ;
    :relationshipType :Follows .

:Edge9 a :Solid, :Edge ;
    :source :Node8 ;
    :target :Node9 ;
    :relationshipType :Follows .

:Edge10 a :Solid, :Edge ;
    :source :Node9 ;
    :target :Node7 ;
    :relationshipType :Branches ;
    :relationshipValue "no" .

:Edge11 a :Solid, :Edge ;
    :source :Node9 ;
    :target :Node10 ;
    :relationshipType :Branches ;
    :relationshipValue "yes" .

:Edge12 a :Solid, :Edge ;
    :source :Node10 ;
    :target :Node11 ;
    :relationshipType :Follows .
