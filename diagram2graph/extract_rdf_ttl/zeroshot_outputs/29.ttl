@prefix : <http://example.org/diagram2graph#> .

:Node1 a :Start, :Node ;
    :label "" ;
    :shape :StartEvent .

:Node2 a :Process, :Node ;
    :label "Take all values" ;
    :shape :Task .

:Node3 a :Process, :Node ;
    :label "Input Hours Per Week" ;
    :shape :Task .

:Node4 a :Process, :Node ;
    :label "Hourly Pay x Hours Per Week" ;
    :shape :Task .

:Node5 a :Decision, :Node ;
    :label "weeklypay > 400" ;
    :shape :Gateway .

:Node6 a :Process, :Node ;
    :label "Output can afford to live along" ;
    :shape :Task .

:Node7 a :Process, :Node ;
    :label "Poor condition" ;
    :shape :Task .

:Node8 a :Terminator, :Node ;
    :label "End" ;
    :shape :EndEvent .

:Edge12 a :Solid, :Edge ;
    :source :Node1 ;
    :target :Node2 ;
    :relationshipType :Follows .

:Edge23 a :Solid, :Edge ;
    :source :Node2 ;
    :target :Node3 ;
    :relationshipType :Follows .

:Edge34 a :Solid, :Edge ;
    :source :Node3 ;
    :target :Node4 ;
    :relationshipType :Follows .

:Edge45 a :Solid, :Edge ;
    :source :Node4 ;
    :target :Node5 ;
    :relationshipType :Follows .

:Edge56 a :Solid, :Edge ;
    :source :Node5 ;
    :target :Node6 ;
    :relationshipType :Branches ;
    :relationshipValue "true" .

:Edge57 a :Solid, :Edge ;
    :source :Node5 ;
    :target :Node7 ;
    :relationshipType :Branches ;
    :relationshipValue "false" .

:Edge68 a :Solid, :Edge ;
    :source :Node6 ;
    :target :Node8 ;
    :relationshipType :Follows .

:Edge78 a :Solid, :Edge ;
    :source :Node7 ;
    :target :Node8 ;
    :relationshipType :Follows .
