@prefix d2g: <http://example.org/diagram2graph#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://example.org/diagram/diagram/node/1> a d2g:Node, d2g:Start ;
    rdfs:label "Begin" ;
    d2g:shape d2g:StartEvent .

<http://example.org/diagram/diagram/node/2> a d2g:Node, d2g:Decision ;
    rdfs:label "Does the user has an account?" ;
    d2g:shape d2g:Gateway .

<http://example.org/diagram/diagram/node/3> a d2g:Node, d2g:Process ;
    rdfs:label "Go to website" ;
    d2g:shape d2g:Task .

<http://example.org/diagram/diagram/node/4> a d2g:Node, d2g:Process ;
    rdfs:label "User enter email" ;
    d2g:shape d2g:Task .

<http://example.org/diagram/diagram/node/5> a d2g:Node, d2g:Process ;
    rdfs:label "\"Open an account\" page open" ;
    d2g:shape d2g:Task .

<http://example.org/diagram/diagram/node/6> a d2g:Node, d2g:Process ;
    rdfs:label "User enter password" ;
    d2g:shape d2g:Task .

<http://example.org/diagram/diagram/node/7> a d2g:Node, d2g:Process ;
    rdfs:label "User clicks on the login button" ;
    d2g:shape d2g:Task .

<http://example.org/diagram/diagram/node/8> a d2g:Node, d2g:Decision ;
    rdfs:label "Are the email and password is correct?" ;
    d2g:shape d2g:Gateway .

<http://example.org/diagram/diagram/node/9> a d2g:Node, d2g:Terminator ;
    rdfs:label "Close" ;
    d2g:shape d2g:EndEvent .

<http://example.org/diagram/diagram/node/10> a d2g:Node, d2g:Process ;
    rdfs:label "Error message appears" ;
    d2g:shape d2g:Task .

<http://example.org/diagram/diagram/edge/12> a d2g:Edge, d2g:Solid ;
    d2g:source <http://example.org/diagram/diagram/node/1> ;
    d2g:target <http://example.org/diagram/diagram/node/2> ;
    d2g:relationshipType d2g:Follows .

<http://example.org/diagram/diagram/node/1> d2g:follows <http://example.org/diagram/diagram/node/2> .

<http://example.org/diagram/diagram/edge/23> a d2g:Edge, d2g:Solid ;
    d2g:source <http://example.org/diagram/diagram/node/2> ;
    d2g:target <http://example.org/diagram/diagram/node/3> ;
    d2g:relationshipType d2g:Branches ;
    d2g:relationshipValue "No" .

<http://example.org/diagram/diagram/node/2> d2g:branches <http://example.org/diagram/diagram/node/3> .

<http://example.org/diagram/diagram/edge/24> a d2g:Edge, d2g:Solid ;
    d2g:source <http://example.org/diagram/diagram/node/2> ;
    d2g:target <http://example.org/diagram/diagram/node/4> ;
    d2g:relationshipType d2g:Branches ;
    d2g:relationshipValue "Yes" .

<http://example.org/diagram/diagram/node/2> d2g:branches <http://example.org/diagram/diagram/node/4> .

<http://example.org/diagram/diagram/edge/35> a d2g:Edge, d2g:Solid ;
    d2g:source <http://example.org/diagram/diagram/node/3> ;
    d2g:target <http://example.org/diagram/diagram/node/5> ;
    d2g:relationshipType d2g:Follows .

<http://example.org/diagram/diagram/node/3> d2g:follows <http://example.org/diagram/diagram/node/5> .

<http://example.org/diagram/diagram/edge/46> a d2g:Edge, d2g:Solid ;
    d2g:source <http://example.org/diagram/diagram/node/4> ;
    d2g:target <http://example.org/diagram/diagram/node/6> ;
    d2g:relationshipType d2g:Follows .

<http://example.org/diagram/diagram/node/4> d2g:follows <http://example.org/diagram/diagram/node/6> .

<http://example.org/diagram/diagram/edge/67> a d2g:Edge, d2g:Solid ;
    d2g:source <http://example.org/diagram/diagram/node/6> ;
    d2g:target <http://example.org/diagram/diagram/node/7> ;
    d2g:relationshipType d2g:Follows .

<http://example.org/diagram/diagram/node/6> d2g:follows <http://example.org/diagram/diagram/node/7> .

<http://example.org/diagram/diagram/edge/78> a d2g:Edge, d2g:Solid ;
    d2g:source <http://example.org/diagram/diagram/node/7> ;
    d2g:target <http://example.org/diagram/diagram/node/8> ;
    d2g:relationshipType d2g:Follows .

<http://example.org/diagram/diagram/node/7> d2g:follows <http://example.org/diagram/diagram/node/8> .

<http://example.org/diagram/diagram/edge/89> a d2g:Edge, d2g:Solid ;
    d2g:source <http://example.org/diagram/diagram/node/8> ;
    d2g:target <http://example.org/diagram/diagram/node/9> ;
    d2g:relationshipType d2g:Branches ;
    d2g:relationshipValue "No" .

<http://example.org/diagram/diagram/node/8> d2g:branches <http://example.org/diagram/diagram/node/9> .

<http://example.org/diagram/diagram/edge/810> a d2g:Edge, d2g:Solid ;
    d2g:source <http://example.org/diagram/diagram/node/8> ;
    d2g:target <http://example.org/diagram/diagram/node/10> ;
    d2g:relationshipType d2g:Branches ;
    d2g:relationshipValue "Yes" .

<http://example.org/diagram/diagram/node/8> d2g:branches <http://example.org/diagram/diagram/node/10> .
