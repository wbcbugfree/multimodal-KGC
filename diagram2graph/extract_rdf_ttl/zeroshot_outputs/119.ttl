@prefix : <http://example.org/diagram2graph#> .

:Node1 a :Start, :Node ;
    :label "Begin" ;
    :shape :StartEvent .

:Node2 a :Process, :Node ;
    :label "iCounter = 1" ;
    :shape :Task .

:Node3 a :Process, :Node ;
    :label "Output: iCounter" ;
    :shape :Task .

:Node4 a :Process, :Node ;
    :label "Increment" ;
    :shape :Task .

:Node5 a :Decision, :Node ;
    :label "iCounter <= 10" ;
    :shape :Gateway .

:Node6 a :Terminator, :Node ;
    :label "End" ;
    :shape :EndEvent .

:Edge12 a :Solid, :Edge ;
    :source :Node1 ;
    :target :Node2 ;
    :relationshipType :Follows .

:Edge23 a :Solid, :Edge ;
    :source :Node2 ;
    :target :Node3 ;
    :relationshipType :Follows .

:Edge34 a :Solid, :Edge ;
    :source :Node3 ;
    :target :Node4 ;
    :relationshipType :Follows .

:Edge45 a :Solid, :Edge ;
    :source :Node4 ;
    :target :Node5 ;
    :relationshipType :Follows .

:Edge53 a :Solid, :Edge ;
    :source :Node5 ;
    :target :Node3 ;
    :relationshipType :Branches ;
    :relationshipValue "True" .

:Edge56 a :Solid, :Edge ;
    :source :Node5 ;
    :target :Node6 ;
    :relationshipType :Branches ;
    :relationshipValue "False" .
