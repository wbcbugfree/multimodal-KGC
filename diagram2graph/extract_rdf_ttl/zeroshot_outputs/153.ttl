@prefix : <http://example.org/diagram2graph#> .

:Node1 a :Start, :Node ;
    :label "Begin" ;
    :shape :StartEvent .

:Node2 a :Process, :Node ;
    :label "Switch On lights" ;
    :shape :Task .

:Node3 a :Process, :Node ;
    :label "Turn the LED connected to Q0 off" ;
    :shape :Task .

:Node4 a :Decision, :Node ;
    :label "Check if the LDR connected to A1 is in darkness" ;
    :shape :Gateway .

:Node5 a :Process, :Node ;
    :label "Switch Off lights" ;
    :shape :Task .

:Node6 a :Process, :Node ;
    :label "Turn the LED connected to Q0 on" ;
    :shape :Task .

:Edge12 a :Solid, :Edge ;
    :source :Node1 ;
    :target :Node2 ;
    :relationshipType :Follows .

:Edge23 a :Solid, :Edge ;
    :source :Node2 ;
    :target :Node3 ;
    :relationshipType :Follows .

:Edge34 a :Solid, :Edge ;
    :source :Node3 ;
    :target :Node4 ;
    :relationshipType :Follows .

:Edge45 a :Solid, :Edge ;
    :source :Node4 ;
    :target :Node5 ;
    :relationshipType :Branches ;
    :relationshipValue "N" .

:Edge46 a :Solid, :Edge ;
    :source :Node4 ;
    :target :Node6 ;
    :relationshipType :Branches ;
    :relationshipValue "Y" .

:Edge54 a :Solid, :Edge ;
    :source :Node5 ;
    :target :Node4 ;
    :relationshipType :Follows .

:Edge64 a :Solid, :Edge ;
    :source :Node6 ;
    :target :Node4 ;
    :relationshipType :Follows .
