@prefix : <http://example.org/diagram2graph#> .

:Node1 a :Start, :Node ;
    :label "Begin" ;
    :shape :StartEvent .

:Node2 a :Decision, :Node ;
    :label "Are you happy?" ;
    :shape :Gateway .

:Node3 a :Process, :Node ;
    :label "Yes a lot" ;
    :shape :Task .

:Node4 a :Decision, :Node ;
    :label "Want to be happy?" ;
    :shape :Gateway .

:Edge1 a :Solid, :Edge ;
    :source :Node1 ;
    :target :Node2 ;
    :relationshipType :Follows .

:Edge2 a :Solid, :Edge ;
    :source :Node2 ;
    :target :Node3 ;
    :relationshipType :Branches .

:Edge3 a :Solid, :Edge ;
    :source :Node2 ;
    :target :Node4 ;
    :relationshipType :Branches .
