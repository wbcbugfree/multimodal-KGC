@prefix : <http://example.org/diagram2graph#> .

:Node1 a :Process, :Node ;
    :label "Begin" ;
    :shape :Task .

:Node2 a :Process, :Node ;
    :label "1. Record Customer's Application" ;
    :shape :Task .

:Node3 a :Process, :Node ;
    :label "2. Initial Processing" ;
    :shape :Task .

:Node4 a :Process, :Node ;
    :label "5. Evaluate" ;
    :shape :Task .

:Node5 a :Process, :Node ;
    :label "4. Documentation" ;
    :shape :Task .

:Node6 a :Process, :Node ;
    :label "3. Obtain Documents from Customer" ;
    :shape :Task .

:Node7 a :Process, :Node ;
    :label "6. Approval" ;
    :shape :Task .

:Node8 a :Process, :Node ;
    :label "7. Loan Granted" ;
    :shape :Task .

:Node9 a :Process, :Node ;
    :label "Finish" ;
    :shape :Task .

:Edge1 a :Solid, :Edge ;
    :source :Node1 ;
    :target :Node2 ;
    :relationshipType :Follows .

:Edge2 a :Solid, :Edge ;
    :source :Node2 ;
    :target :Node3 ;
    :relationshipType :Follows .

:Edge3 a :Solid, :Edge ;
    :source :Node3 ;
    :target :Node6 ;
    :relationshipType :Follows .

:Edge4 a :Solid, :Edge ;
    :source :Node6 ;
    :target :Node5 ;
    :relationshipType :Follows .

:Edge5 a :Solid, :Edge ;
    :source :Node5 ;
    :target :Node4 ;
    :relationshipType :Follows .

:Edge6 a :Solid, :Edge ;
    :source :Node4 ;
    :target :Node7 ;
    :relationshipType :Follows .

:Edge7 a :Solid, :Edge ;
    :source :Node7 ;
    :target :Node8 ;
    :relationshipType :Follows .

:Edge8 a :Solid, :Edge ;
    :source :Node8 ;
    :target :Node9 ;
    :relationshipType :Follows .
