@prefix : <http://example.org/diagram2graph#> .

:Node1 a :Start, :Node ;
    :label "Begin" ;
    :shape :StartEvent .

:Node2 a :Process, :Node ;
    :label "Lapping" ;
    :shape :Task .

:Node3 a :Process, :Node ;
    :label "Die sawing" ;
    :shape :Task .

:Node4 a :Process, :Node ;
    :label "Die bonding" ;
    :shape :Task .

:Node5 a :Process, :Node ;
    :label "Wire" ;
    :shape :Task .

:Node6 a :Process, :Node ;
    :label "Molding" ;
    :shape :Task .

:Node7 a :Process, :Node ;
    :label "Marketing" ;
    :shape :Task .

:Node8 a :Process, :Node ;
    :label "Plating" ;
    :shape :Task .

:Node9 a :Process, :Node ;
    :label "sampling" ;
    :shape :Task .

:Node10 a :Process, :Node ;
    :label "Forming" ;
    :shape :Task .

:Node11 a :Terminator, :Node ;
    :label "End" ;
    :shape :EndEvent .

:Edge1 a :Solid, :Edge ;
    :source :Node1 ;
    :target :Node2 ;
    :relationshipType :Follows .

:Edge2 a :Solid, :Edge ;
    :source :Node2 ;
    :target :Node3 ;
    :relationshipType :Follows .

:Edge3 a :Solid, :Edge ;
    :source :Node3 ;
    :target :Node4 ;
    :relationshipType :Follows .

:Edge4 a :Solid, :Edge ;
    :source :Node4 ;
    :target :Node5 ;
    :relationshipType :Follows .

:Edge5 a :Solid, :Edge ;
    :source :Node5 ;
    :target :Node6 ;
    :relationshipType :Follows .

:Edge6 a :Solid, :Edge ;
    :source :Node6 ;
    :target :Node7 ;
    :relationshipType :Follows .

:Edge7 a :Solid, :Edge ;
    :source :Node7 ;
    :target :Node8 ;
    :relationshipType :Follows .

:Edge8 a :Solid, :Edge ;
    :source :Node8 ;
    :target :Node9 ;
    :relationshipType :Follows .

:Edge9 a :Solid, :Edge ;
    :source :Node9 ;
    :target :Node10 ;
    :relationshipType :Follows .

:Edge10 a :Solid, :Edge ;
    :source :Node10 ;
    :target :Node11 ;
    :relationshipType :Follows .
