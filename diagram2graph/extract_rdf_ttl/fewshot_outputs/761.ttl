@prefix : <http://example.org/diagram2graph#> .

:Node1 a :Start, :Node ;
    :label "Begin" ;
    :shape :StartEvent .

:Node2 a :Process, :Node ;
    :label "Initial Population" ;
    :shape :Task .

:Node3 a :Process, :Node ;
    :label "Fitness Evaluation" ;
    :shape :Task .

:Node4 a :Process, :Node ;
    :label "Tournament Selection" ;
    :shape :Task .

:Node5 a :Process, :Node ;
    :label "Team Selection" ;
    :shape :Task .

:Node6 a :Process, :Node ;
    :label "Finalize Team" ;
    :shape :Task .

:Node7 a :Process, :Node ;
    :label "New Generation" ;
    :shape :Task .

:Node8 a :Decision, :Node ;
    :label "condition fulfil?" ;
    :shape :Gateway .

:Node9 a :Terminator, :Node ;
    :label "" ;
    :shape :EndEvent .

:Edge12 a :Solid, :Edge ;
    :source :Node1 ;
    :target :Node2 ;
    :relationshipType :Follows .

:Edge23 a :Solid, :Edge ;
    :source :Node2 ;
    :target :Node3 ;
    :relationshipType :Follows .

:Edge34 a :Solid, :Edge ;
    :source :Node3 ;
    :target :Node4 ;
    :relationshipType :Follows .

:Edge45 a :Solid, :Edge ;
    :source :Node4 ;
    :target :Node5 ;
    :relationshipType :Follows .

:Edge56 a :Solid, :Edge ;
    :source :Node5 ;
    :target :Node6 ;
    :relationshipType :Follows .

:Edge67 a :Solid, :Edge ;
    :source :Node6 ;
    :target :Node7 ;
    :relationshipType :Follows .

:Edge78 a :Solid, :Edge ;
    :source :Node7 ;
    :target :Node8 ;
    :relationshipType :Follows .

:Edge84 a :Solid, :Edge ;
    :source :Node8 ;
    :target :Node4 ;
    :relationshipType :Branches ;
    :relationshipValue "NO" .

:Edge89 a :Solid, :Edge ;
    :source :Node8 ;
    :target :Node9 ;
    :relationshipType :Branches ;
    :relationshipValue "YES" .
