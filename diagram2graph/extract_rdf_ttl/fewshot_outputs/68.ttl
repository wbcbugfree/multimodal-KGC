@prefix : <http://example.org/diagram2graph#> .

:Node1 a :Start, :Node ;
    :label "Begin" ;
    :shape :StartEvent .

:Node2 a :Process, :Node ;
    :label "Pour Cold Water" ;
    :shape :Task .

:Node3 a :Decision, :Node ;
    :label "Set Water\nLevel\nReached?" ;
    :shape :Gateway .

:Node4 a :Process, :Node ;
    :label "Pour Hot Water" ;
    :shape :Task .

:Node5 a :Decision, :Node ;
    :label "Check Water\nTemperature" ;
    :shape :Gateway .

:Node6 a :Process, :Node ;
    :label "Washing Process\n(Pump ON)" ;
    :shape :Task .

:Node7 a :Decision, :Node ;
    :label "Check Time\nLimit" ;
    :shape :Gateway .

:Node8 a :Terminator, :Node ;
    :label "End" ;
    :shape :EndEvent .

:Edge12 a :Solid, :Edge ;
    :source :Node1 ;
    :target :Node2 ;
    :relationshipType :Follows .

:Edge23 a :Solid, :Edge ;
    :source :Node2 ;
    :target :Node3 ;
    :relationshipType :Follows .

:Edge32 a :Solid, :Edge ;
    :source :Node3 ;
    :target :Node2 ;
    :relationshipType :Branches ;
    :relationshipValue "No" .

:Edge34 a :Solid, :Edge ;
    :source :Node3 ;
    :target :Node4 ;
    :relationshipType :Branches ;
    :relationshipValue "Yes" .

:Edge45 a :Solid, :Edge ;
    :source :Node4 ;
    :target :Node5 ;
    :relationshipType :Follows .

:Edge54 a :Solid, :Edge ;
    :source :Node5 ;
    :target :Node4 ;
    :relationshipType :Branches ;
    :relationshipValue "No" .

:Edge56 a :Solid, :Edge ;
    :source :Node5 ;
    :target :Node6 ;
    :relationshipType :Branches ;
    :relationshipValue "Yes" .

:Edge67 a :Solid, :Edge ;
    :source :Node6 ;
    :target :Node7 ;
    :relationshipType :Follows .

:Edge76 a :Solid, :Edge ;
    :source :Node7 ;
    :target :Node6 ;
    :relationshipType :Branches ;
    :relationshipValue "No" .

:Edge78 a :Solid, :Edge ;
    :source :Node7 ;
    :target :Node8 ;
    :relationshipType :Branches ;
    :relationshipValue "Yes" .
