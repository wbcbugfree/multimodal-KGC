@prefix : <http://example.org/diagram2graph#> .

:Node1 a :Process, :Node ;
    :label "Movie" ;
    :shape :Task .

:Node2 a :Decision, :Node ;
    :label "has subtitles" ;
    :shape :Gateway .

:Node3 a :Process, :Node ;
    :label "Ask someone" ;
    :shape :Task .

:Node4 a :Decision, :Node ;
    :label "Type" ;
    :shape :Gateway .

:Node5 a :Process, :Node ;
    :label "Summarize based on selected algorithm" ;
    :shape :Task .

:Node6 a :Process, :Node ;
    :label "Create new algorithm" ;
    :shape :Task .

:Node7 a :Process, :Node ;
    :label "Generate the summarized video" ;
    :shape :Task .

:Edge1 a :Solid, :Edge ;
    :source :Node1 ;
    :target :Node2 ;
    :relationshipType :Follows .

:Edge2 a :Solid, :Edge ;
    :source :Node2 ;
    :target :Node4 ;
    :relationshipType :Branches ;
    :relationshipValue "Yes" .

:Edge3 a :Solid, :Edge ;
    :source :Node2 ;
    :target :Node3 ;
    :relationshipType :Branches ;
    :relationshipValue "No" .

:Edge4 a :Solid, :Edge ;
    :source :Node3 ;
    :target :Node4 ;
    :relationshipType :Follows .

:Edge5 a :Solid, :Edge ;
    :source :Node4 ;
    :target :Node5 ;
    :relationshipType :Branches ;
    :relationshipValue "Single" .

:Edge6 a :Solid, :Edge ;
    :source :Node4 ;
    :target :Node6 ;
    :relationshipType :Branches ;
    :relationshipValue "Combined" .

:Edge7 a :Solid, :Edge ;
    :source :Node5 ;
    :target :Node7 ;
    :relationshipType :Follows .

:Edge8 a :Solid, :Edge ;
    :source :Node6 ;
    :target :Node7 ;
    :relationshipType :Follows .
