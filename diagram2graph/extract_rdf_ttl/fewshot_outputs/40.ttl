@prefix : <http://example.org/diagram2graph#> .

:Node1 a :Start, :Node ;
    :label "Start" ;
    :shape :StartEvent .

:Node2 a :Decision, :Node ;
    :label "Object detected in left" ;
    :shape :Gateway .

:Node3 a :Process, :Node ;
    :label "Turn Left" ;
    :shape :Task .

:Node4 a :Decision, :Node ;
    :label "Object detected in right" ;
    :shape :Gateway .

:Node5 a :Process, :Node ;
    :label "Turn Right" ;
    :shape :Task .

:Edge12 a :Solid, :Edge ;
    :source :Node1 ;
    :target :Node2 ;
    :relationshipType :Follows .

:Edge23 a :Solid, :Edge ;
    :source :Node2 ;
    :target :Node3 ;
    :relationshipType :Branches ;
    :relationshipValue "Yes" .

:Edge24 a :Solid, :Edge ;
    :source :Node2 ;
    :target :Node4 ;
    :relationshipType :Branches ;
    :relationshipValue "No" .

:Edge32 a :Solid, :Edge ;
    :source :Node3 ;
    :target :Node2 ;
    :relationshipType :Follows .

:Edge42 a :Solid, :Edge ;
    :source :Node4 ;
    :target :Node2 ;
    :relationshipType :Branches ;
    :relationshipValue "No" .

:Edge45 a :Solid, :Edge ;
    :source :Node4 ;
    :target :Node5 ;
    :relationshipType :Branches ;
    :relationshipValue "Yes" .

:Edge52 a :Solid, :Edge ;
    :source :Node5 ;
    :target :Node2 ;
    :relationshipType :Follows .
