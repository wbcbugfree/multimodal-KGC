@prefix : <http://example.org/diagram2graph#> .

:Node1 a :Start, :Node ;
    :label "" ;
    :shape :StartEvent .

:Node2 a :Process, :Node ;
    :label "User enters login name and password" ;
    :shape :Task .

:Node3 a :Decision, :Node ;
    :label "Correct login and password?" ;
    :shape :Gateway .

:Node4 a :Process, :Node ;
    :label "Alert" ;
    :shape :Task .

:Node5 a :Process, :Node ;
    :label "User successfully logs in" ;
    :shape :Task .

:Node6 a :Process, :Node ;
    :label "Display" ;
    :shape :Task .

:Node7 a :Terminator, :Node ;
    :label "" ;
    :shape :EndEvent .

:Node8 a :Process, :Node ;
    :label "User logs into the system" ;
    :shape :Task .

:Edge12 a :Solid, :Edge ;
    :source :Node1 ;
    :target :Node2 ;
    :relationshipType :Follows .

:Edge23 a :Solid, :Edge ;
    :source :Node2 ;
    :target :Node3 ;
    :relationshipType :Follows .

:Edge34 a :Solid, :Edge ;
    :source :Node3 ;
    :target :Node4 ;
    :relationshipType :Branches ;
    :relationshipValue "No" .

:Edge35 a :Solid, :Edge ;
    :source :Node3 ;
    :target :Node5 ;
    :relationshipType :Branches ;
    :relationshipValue "Yes" .

:Edge42 a :Solid, :Edge ;
    :source :Node4 ;
    :target :Node2 ;
    :relationshipType :Follows .

:Edge56 a :Solid, :Edge ;
    :source :Node5 ;
    :target :Node6 ;
    :relationshipType :Follows .

:Edge67 a :Solid, :Edge ;
    :source :Node6 ;
    :target :Node7 ;
    :relationshipType :Follows .

:Edge78 a :Solid, :Edge ;
    :source :Node7 ;
    :target :Node8 ;
    :relationshipType :Follows .
