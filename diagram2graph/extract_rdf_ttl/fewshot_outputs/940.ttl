@prefix : <http://example.org/diagram2graph#> .

:Node1 a :Start, :Node ;
    :label "Begin" ;
    :shape :StartEvent .

:Node2 a :Process, :Node ;
    :label "Enter to the website" ;
    :shape :Task .

:Node3 a :Decision, :Node ;
    :label "have an account" ;
    :shape :Gateway .

:Node4 a :Process, :Node ;
    :label "Sign up" ;
    :shape :Task .

:Node5 a :Process, :Node ;
    :label "Fill details" ;
    :shape :Task .

:Node6 a :Process, :Node ;
    :label "Log in" ;
    :shape :Task .

:Node7 a :Process, :Node ;
    :label "Submit" ;
    :shape :Task .

:Node8 a :Process, :Node ;
    :label "Enter e-mail and password" ;
    :shape :Task .

:Node9 a :Decision, :Node ;
    :label "e-mail and password valid" ;
    :shape :Gateway .

:Node10 a :Process, :Node ;
    :label "Profile" ;
    :shape :Task .

:Node11 a :Terminator, :Node ;
    :label "end" ;
    :shape :EndEvent .

:Edge12 a :Solid, :Edge ;
    :source :Node1 ;
    :target :Node2 ;
    :relationshipType :Follows .

:Edge23 a :Solid, :Edge ;
    :source :Node2 ;
    :target :Node3 ;
    :relationshipType :Follows .

:Edge34 a :Solid, :Edge ;
    :source :Node3 ;
    :target :Node4 ;
    :relationshipType :Branches ;
    :relationshipValue "No" .

:Edge36 a :Solid, :Edge ;
    :source :Node3 ;
    :target :Node6 ;
    :relationshipType :Branches ;
    :relationshipValue "yes" .

:Edge45 a :Solid, :Edge ;
    :source :Node4 ;
    :target :Node5 ;
    :relationshipType :Follows .

:Edge57 a :Solid, :Edge ;
    :source :Node5 ;
    :target :Node7 ;
    :relationshipType :Follows .

:Edge68 a :Solid, :Edge ;
    :source :Node6 ;
    :target :Node8 ;
    :relationshipType :Follows .

:Edge76 a :Solid, :Edge ;
    :source :Node7 ;
    :target :Node6 ;
    :relationshipType :Follows .

:Edge89 a :Solid, :Edge ;
    :source :Node8 ;
    :target :Node9 ;
    :relationshipType :Follows .

:Edge98 a :Solid, :Edge ;
    :source :Node9 ;
    :target :Node8 ;
    :relationshipType :Branches ;
    :relationshipValue "no" .

:Edge910 a :Solid, :Edge ;
    :source :Node9 ;
    :target :Node10 ;
    :relationshipType :Branches ;
    :relationshipValue "yes" .

:Edge1011 a :Solid, :Edge ;
    :source :Node10 ;
    :target :Node11 ;
    :relationshipType :Follows .
