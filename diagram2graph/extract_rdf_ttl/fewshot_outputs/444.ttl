@prefix : <http://example.org/diagram2graph#> .

:Node1 a :Start, :Node ;
    :label "Begin" ;
    :shape :StartEvent .

:Node2 a :Process, :Node ;
    :label "Process step 1" ;
    :shape :Task .

:Node3 a :Decision, :Node ;
    :label "Decision?" ;
    :shape :Gateway .

:Node4 a :Process, :Node ;
    :label "Process step 2" ;
    :shape :Task .

:Node5 a :Terminator, :Node ;
    :label "A" ;
    :shape :EndEvent .

:Edge12 a :Solid, :Edge ;
    :source :Node1 ;
    :target :Node2 ;
    :relationshipType :Follows .

:Edge23 a :Solid, :Edge ;
    :source :Node2 ;
    :target :Node3 ;
    :relationshipType :Follows .

:Edge32 a :Solid, :Edge ;
    :source :Node3 ;
    :target :Node2 ;
    :relationshipType :Branches ;
    :relationshipValue "Choice 2" .

:Edge34 a :Solid, :Edge ;
    :source :Node3 ;
    :target :Node4 ;
    :relationshipType :Branches ;
    :relationshipValue "Choice 1" .

:Edge45 a :Solid, :Edge ;
    :source :Node4 ;
    :target :Node5 ;
    :relationshipType :Follows .
