@prefix : <http://example.org/diagram2graph#> .

:Node1 a :Start, :Node ;
    :label "Begin" ;
    :shape :StartEvent .

:Node2 a :Process, :Node ;
    :label "READ N" ;
    :shape :Task .

:Node3 a :Process, :Node ;
    :label "M = 1" ;
    :shape :Task .

:Node4 a :Process, :Node ;
    :label "F = 1" ;
    :shape :Task .

:Node5 a :Process, :Node ;
    :label "F = F * M" ;
    :shape :Task .

:Node6 a :Decision, :Node ;
    :label "M = N?" ;
    :shape :Gateway .

:Node7 a :Process, :Node ;
    :label "M = M + 1" ;
    :shape :Task .

:Node8 a :Process, :Node ;
    :label "PRINT F" ;
    :shape :Task .

:Edge12 a :Solid, :Edge ;
    :source :Node1 ;
    :target :Node2 ;
    :relationshipType :Follows .

:Edge23 a :Solid, :Edge ;
    :source :Node2 ;
    :target :Node3 ;
    :relationshipType :Follows .

:Edge34 a :Solid, :Edge ;
    :source :Node3 ;
    :target :Node4 ;
    :relationshipType :Follows .

:Edge45 a :Solid, :Edge ;
    :source :Node4 ;
    :target :Node5 ;
    :relationshipType :Follows .

:Edge56 a :Solid, :Edge ;
    :source :Node5 ;
    :target :Node6 ;
    :relationshipType :Follows .

:Edge67 a :Solid, :Edge ;
    :source :Node6 ;
    :target :Node7 ;
    :relationshipType :Branches ;
    :relationshipValue "NO" .

:Edge68 a :Solid, :Edge ;
    :source :Node6 ;
    :target :Node8 ;
    :relationshipType :Branches ;
    :relationshipValue "YES" .

:Edge75 a :Solid, :Edge ;
    :source :Node7 ;
    :target :Node5 ;
    :relationshipType :Follows .
