@prefix : <http://example.org/diagram2graph#> .

:Node1 a :Start, :Node ;
    :label "BEGIN" ;
    :shape :StartEvent .

:Node2 a :Process, :Node ;
    :label "Enter Limit" ;
    :shape :Task .

:Node3 a :Process, :Node ;
    :label "Initialize number" ;
    :shape :Task .

:Node4 a :Process, :Node ;
    :label "Set Sum equal to 0" ;
    :shape :Task .

:Node5 a :Process, :Node ;
    :label "DO" ;
    :shape :Task .

:Node6 a :Decision, :Node ;
    :label "If Sum > Limit" ;
    :shape :Gateway .

:Node7 a :Process, :Node ;
    :label "Update values" ;
    :shape :Task .

:Node8 a :Process, :Node ;
    :label "Decrease loss" ;
    :shape :Task .

:Node9 a :Process, :Node ;
    :label "Display Number and Sum" ;
    :shape :Task .

:Node10 a :Terminator, :Node ;
    :label "END" ;
    :shape :EndEvent .

:Edge12 a :Solid, :Edge ;
    :source :Node1 ;
    :target :Node2 ;
    :relationshipType :Follows .

:Edge23 a :Solid, :Edge ;
    :source :Node2 ;
    :target :Node3 ;
    :relationshipType :Follows .

:Edge34 a :Solid, :Edge ;
    :source :Node3 ;
    :target :Node4 ;
    :relationshipType :Follows .

:Edge45 a :Solid, :Edge ;
    :source :Node4 ;
    :target :Node5 ;
    :relationshipType :Follows .

:Edge56 a :Solid, :Edge ;
    :source :Node5 ;
    :target :Node6 ;
    :relationshipType :Follows .

:Edge67 a :Solid, :Edge ;
    :source :Node6 ;
    :target :Node7 ;
    :relationshipType :Branches ;
    :relationshipValue "false" .

:Edge69 a :Solid, :Edge ;
    :source :Node6 ;
    :target :Node9 ;
    :relationshipType :Branches ;
    :relationshipValue "true" .

:Edge78 a :Solid, :Edge ;
    :source :Node7 ;
    :target :Node8 ;
    :relationshipType :Follows .

:Edge85 a :Solid, :Edge ;
    :source :Node8 ;
    :target :Node5 ;
    :relationshipType :Follows .

:Edge910 a :Solid, :Edge ;
    :source :Node9 ;
    :target :Node10 ;
    :relationshipType :Follows .
