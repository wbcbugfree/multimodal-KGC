@prefix : <http://example.org/diagram2graph#> .

:Node1 a :Start, :Node ;
    :label "Start" ;
    :shape :StartEvent .

:Node2 a :Process, :Node ;
    :label "Round 1\nT = 1" ;
    :shape :Task .

:Node3 a :Process, :Node ;
    :label "Next round draw" ;
    :shape :Task .

:Node4 a :Process, :Node ;
    :label "Draw lots to select\nwitness nodes" ;
    :shape :Task .

:Node5 a :Decision, :Node ;
    :label "Timeout\nverification" ;
    :shape :Gateway .

:Node6 a :Process, :Node ;
    :label "Binarize block" ;
    :shape :Task .

:Node7 a :Process, :Node ;
    :label "Packing\nblock" ;
    :shape :Task .

:Node8 a :Process, :Node ;
    :label "Authentication" ;
    :shape :Task .

:Node9 a :Decision, :Node ;
    :label "Block\nverification" ;
    :shape :Gateway .

:Node10 a :Terminator, :Node ;
    :label "Finish" ;
    :shape :EndEvent .

:Edge1 a :Solid, :Edge ;
    :source :Node1 ;
    :target :Node2 ;
    :relationshipType :Follows .

:Edge2 a :Solid, :Edge ;
    :source :Node2 ;
    :target :Node4 ;
    :relationshipType :Follows .

:Edge3 a :Solid, :Edge ;
    :source :Node3 ;
    :target :Node4 ;
    :relationshipType :Follows .

:Edge4 a :Solid, :Edge ;
    :source :Node4 ;
    :target :Node6 ;
    :relationshipType :Follows .

:Edge5 a :Solid, :Edge ;
    :source :Node6 ;
    :target :Node7 ;
    :relationshipType :Follows .

:Edge6 a :Solid, :Edge ;
    :source :Node7 ;
    :target :Node9 ;
    :relationshipType :Follows .

:Edge7 a :Solid, :Edge ;
    :source :Node9 ;
    :target :Node10 ;
    :relationshipType :Branches ;
    :relationshipValue "Success" .

:Edge8 a :Solid, :Edge ;
    :source :Node9 ;
    :target :Node8 ;
    :relationshipType :Branches .

:Edge9 a :Solid, :Edge ;
    :source :Node8 ;
    :target :Node6 ;
    :relationshipType :Follows .

:Edge10 a :Solid, :Edge ;
    :source :Node9 ;
    :target :Node5 ;
    :relationshipType :Branches ;
    :relationshipValue "Verification failed" .

:Edge11 a :Solid, :Edge ;
    :source :Node5 ;
    :target :Node3 ;
    :relationshipType :Branches ;
    :relationshipValue "Timeout" .
