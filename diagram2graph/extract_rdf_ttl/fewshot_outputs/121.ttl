@prefix : <http://example.org/diagram2graph#> .

:Node1 a :Start, :Node ;
    :label "Begin" ;
    :shape :StartEvent .

:Node2 a :Process, :Node ;
    :label "Generate Initial Population" ;
    :shape :Task .

:Node3 a :Process, :Node ;
    :label "Compute the fitness of each individual" ;
    :shape :Task .

:Node4 a :Process, :Node ;
    :label "Check all person" ;
    :shape :Task .

:Node5 a :Process, :Node ;
    :label "Categorize them" ;
    :shape :Task .

:Node6 a :Decision, :Node ;
    :label "Converging ?" ;
    :shape :Gateway .

:Node7 a :Terminator, :Node ;
    :label "End" ;
    :shape :EndEvent .

:Edge1 a :Solid, :Edge ;
    :source :Node1 ;
    :target :Node2 ;
    :relationshipType :Follows .

:Edge2 a :Solid, :Edge ;
    :source :Node2 ;
    :target :Node3 ;
    :relationshipType :Follows .

:Edge3 a :Solid, :Edge ;
    :source :Node3 ;
    :target :Node4 ;
    :relationshipType :Follows .

:Edge4 a :Solid, :Edge ;
    :source :Node4 ;
    :target :Node5 ;
    :relationshipType :Follows .

:Edge5 a :Solid, :Edge ;
    :source :Node5 ;
    :target :Node6 ;
    :relationshipType :Follows .

:Edge6 a :Solid, :Edge ;
    :source :Node6 ;
    :target :Node7 ;
    :relationshipType :Follows ;
    :relationshipValue "YES" .

:Edge7 a :Solid, :Edge ;
    :source :Node6 ;
    :target :Node3 ;
    :relationshipType :Follows ;
    :relationshipValue "NO" .
