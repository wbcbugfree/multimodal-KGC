@prefix : <http://example.org/diagram2graph#> .

:Node1 a :Start, :Node ;
    :label "Start" ;
    :shape :StartEvent .

:Node2 a :Process, :Node ;
    :label "Brainstorm" ;
    :shape :Task .

:Node3 a :Process, :Node ;
    :label "Topic assigned" ;
    :shape :Task .

:Node4 a :Process, :Node ;
    :label "Outline" ;
    :shape :Task .

:Node5 a :Process, :Node ;
    :label "Discuss" ;
    :shape :Task .

:Node6 a :Process, :Node ;
    :label "Draft" ;
    :shape :Task .

:Node7 a :Process, :Node ;
    :label "Draft review" ;
    :shape :Task .

:Node8 a :Terminator, :Node ;
    :label "Finish" ;
    :shape :EndEvent .

:Edge12 a :Solid, :Edge ;
    :source :Node1 ;
    :target :Node2 ;
    :relationshipType :Follows .

:Edge23 a :Solid, :Edge ;
    :source :Node2 ;
    :target :Node3 ;
    :relationshipType :Follows .

:Edge34 a :Solid, :Edge ;
    :source :Node3 ;
    :target :Node4 ;
    :relationshipType :Follows .

:Edge45 a :Solid, :Edge ;
    :source :Node4 ;
    :target :Node5 ;
    :relationshipType :Follows .

:Edge53 a :Solid, :Edge ;
    :source :Node5 ;
    :target :Node3 ;
    :relationshipType :Follows ;
    :relationshipValue "Return" .

:Edge56 a :Solid, :Edge ;
    :source :Node5 ;
    :target :Node6 ;
    :relationshipType :Follows .

:Edge67 a :Solid, :Edge ;
    :source :Node6 ;
    :target :Node7 ;
    :relationshipType :Follows .

:Edge75 a :Solid, :Edge ;
    :source :Node7 ;
    :target :Node5 ;
    :relationshipType :Follows ;
    :relationshipValue "changes" .

:Edge78 a :Solid, :Edge ;
    :source :Node7 ;
    :target :Node8 ;
    :relationshipType :Follows ;
    :relationshipValue "Approved" .
