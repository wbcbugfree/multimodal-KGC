@prefix : <http://example.org/diagram2graph#> .

:Node1 a :Start, :Node ;
    :label "Start" ;
    :shape :StartEvent .

:Node2 a :Process, :Node ;
    :label "Username" ;
    :shape :Task .

:Node3 a :Process, :Node ;
    :label "Password" ;
    :shape :Task .

:Node4 a :Decision, :Node ;
    :label "Username && Password correspond to the ones in database?" ;
    :shape :Gateway .

:Node5 a :Process, :Node ;
    :label "Enter ID and password" ;
    :shape :Task .

:Node6 a :Process, :Node ;
    :label "\"Invalid credentials\"" ;
    :shape :Task .

:Node7 a :Decision, :Node ;
    :label "Is User_ID blocked?" ;
    :shape :Gateway .

:Node8 a :Process, :Node ;
    :label "\"403 Forbidden\"" ;
    :shape :Task .

:Node9 a :Process, :Node ;
    :label "Login successfully" ;
    :shape :Task .

:Node10 a :Terminator, :Node ;
    :label "End" ;
    :shape :EndEvent .

:Edge12 a :Solid, :Edge ;
    :source :Node1 ;
    :target :Node2 ;
    :relationshipType :Follows .

:Edge23 a :Solid, :Edge ;
    :source :Node2 ;
    :target :Node3 ;
    :relationshipType :Follows .

:Edge34 a :Solid, :Edge ;
    :source :Node3 ;
    :target :Node4 ;
    :relationshipType :Follows .

:Edge45 a :Solid, :Edge ;
    :source :Node4 ;
    :target :Node5 ;
    :relationshipType :Branches ;
    :relationshipValue "Yes" .

:Edge46 a :Solid, :Edge ;
    :source :Node4 ;
    :target :Node6 ;
    :relationshipType :Branches ;
    :relationshipValue "No" .

:Edge57 a :Solid, :Edge ;
    :source :Node5 ;
    :target :Node7 ;
    :relationshipType :Follows .

:Edge62 a :Solid, :Edge ;
    :source :Node6 ;
    :target :Node2 ;
    :relationshipType :Follows .

:Edge78 a :Solid, :Edge ;
    :source :Node7 ;
    :target :Node8 ;
    :relationshipType :Branches ;
    :relationshipValue "Yes" .

:Edge79 a :Solid, :Edge ;
    :source :Node7 ;
    :target :Node9 ;
    :relationshipType :Branches ;
    :relationshipValue "No" .

:Edge82 a :Solid, :Edge ;
    :source :Node8 ;
    :target :Node2 ;
    :relationshipType :Follows .

:Edge910 a :Solid, :Edge ;
    :source :Node9 ;
    :target :Node10 ;
    :relationshipType :Follows .
