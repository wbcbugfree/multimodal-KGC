@prefix : <http://example.org/diagram2graph#> .

:Node1 a :Start, :Node ;
    :label "Start" ;
    :shape :StartEvent .

:Node2 a :Process, :Node ;
    :label "Define Optimization Problem" ;
    :shape :Task .

:Node3 a :Process, :Node ;
    :label "calculate matrix" ;
    :shape :Task .

:Node4 a :Process, :Node ;
    :label "Obtain result" ;
    :shape :Task .

:Node5 a :Process, :Node ;
    :label "Perform Data Mining Algorithms" ;
    :shape :Task .

:Node6 a :Process, :Node ;
    :label "Evaluate" ;
    :shape :Task .

:Node7 a :Process, :Node ;
    :label "Modify Mining Rules" ;
    :shape :Task .

:Node8 a :Decision, :Node ;
    :label "Meet Design Requirements?" ;
    :shape :Gateway .

:Node9 a :Terminator, :Node ;
    :label "Stop" ;
    :shape :EndEvent .

:Edge12 a :Solid, :Edge ;
    :source :Node1 ;
    :target :Node2 ;
    :relationshipType :Follows .

:Edge23 a :Solid, :Edge ;
    :source :Node2 ;
    :target :Node3 ;
    :relationshipType :Follows .

:Edge34 a :Solid, :Edge ;
    :source :Node3 ;
    :target :Node4 ;
    :relationshipType :Follows .

:Edge45 a :Solid, :Edge ;
    :source :Node4 ;
    :target :Node5 ;
    :relationshipType :Follows .

:Edge56 a :Solid, :Edge ;
    :source :Node5 ;
    :target :Node6 ;
    :relationshipType :Follows .

:Edge68 a :Solid, :Edge ;
    :source :Node6 ;
    :target :Node8 ;
    :relationshipType :Follows .

:Edge75 a :Solid, :Edge ;
    :source :Node7 ;
    :target :Node5 ;
    :relationshipType :Follows .

:Edge87 a :Solid, :Edge ;
    :source :Node8 ;
    :target :Node7 ;
    :relationshipType :Branches ;
    :relationshipValue "No" .

:Edge89 a :Solid, :Edge ;
    :source :Node8 ;
    :target :Node9 ;
    :relationshipType :Branches ;
    :relationshipValue "Yes" .
