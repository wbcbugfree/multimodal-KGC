@prefix : <http://example.org/diagram2graph#> .

:Node1 a :Process, :Node ;
    :label "Input" ;
    :shape :Task .

:Node2 a :Process, :Node ;
    :label "Filtering" ;
    :shape :Task .

:Node3 a :Process, :Node ;
    :label "Calculate potential field" ;
    :shape :Task .

:Node4 a :Process, :Node ;
    :label "Segmentation" ;
    :shape :Task .

:Node5 a :Process, :Node ;
    :label "Feature Extraction" ;
    :shape :Task .

:Node6 a :Process, :Node ;
    :label "Classification" ;
    :shape :Task .

:Edge1 a :Solid, :Edge ;
    :source :Node1 ;
    :target :Node2 ;
    :relationshipType :Follows .

:Edge2 a :Solid, :Edge ;
    :source :Node2 ;
    :target :Node3 ;
    :relationshipType :Follows .

:Edge3 a :Solid, :Edge ;
    :source :Node3 ;
    :target :Node4 ;
    :relationshipType :Follows .

:Edge4 a :Solid, :Edge ;
    :source :Node4 ;
    :target :Node5 ;
    :relationshipType :Follows .

:Edge5 a :Solid, :Edge ;
    :source :Node5 ;
    :target :Node6 ;
    :relationshipType :Follows .
