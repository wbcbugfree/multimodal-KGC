@prefix : <http://example.org/diagram2graph#> .

:Node1 a :Process, :Node ;
    :label "Analog\nretrieval" ;
    :shape :Task .

:Node2 a :Process, :Node ;
    :label "Sampling" ;
    :shape :Task .

:Node3 a :Process, :Node ;
    :label "Analogical\ninference" ;
    :shape :Task .

:Node4 a :Terminator, :Node ;
    :label "End" ;
    :shape :EndEvent .

:Edge12 a :Solid, :Edge ;
    :source :Node1 ;
    :target :Node2 ;
    :relationshipType :Follows ;
    :relationshipValue "learning" .

:Edge23 a :Solid, :Edge ;
    :source :Node2 ;
    :target :Node3 ;
    :relationshipType :Follows ;
    :relationshipValue "Self-\nsupervised\nlearning" .

:Edge34 a :Solid, :Edge ;
    :source :Node3 ;
    :target :Node4 ;
    :relationshipType :Follows ;
    :relationshipValue "Intersection" .
