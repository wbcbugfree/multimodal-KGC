@prefix : <http://example.org/diagram2graph#> .

:Node1 a :Start, :Node ;
    :label "Start" ;
    :shape :StartEvent .

:Node2 a :Process, :Node ;
    :label "Read Temperature" ;
    :shape :Task .

:Node3 a :Decision, :Node ;
    :label "Temperature < 32 ?" ;
    :shape :Gateway .

:Node4 a :Process, :Node ;
    :label "Not so cold" ;
    :shape :Task .

:Node5 a :Process, :Node ;
    :label "Cold" ;
    :shape :Task .

:Node6 a :Terminator, :Node ;
    :label "End" ;
    :shape :EndEvent .

:Edge12 a :Solid, :Edge ;
    :source :Node1 ;
    :target :Node2 ;
    :relationshipType :Follows .

:Edge23 a :Solid, :Edge ;
    :source :Node2 ;
    :target :Node3 ;
    :relationshipType :Follows .

:Edge34 a :Solid, :Edge ;
    :source :Node3 ;
    :target :Node4 ;
    :relationshipType :Branches ;
    :relationshipValue "YES" .

:Edge35 a :Solid, :Edge ;
    :source :Node3 ;
    :target :Node5 ;
    :relationshipType :Branches ;
    :relationshipValue "NO" .

:Edge46 a :Solid, :Edge ;
    :source :Node4 ;
    :target :Node6 ;
    :relationshipType :Follows .

:Edge56 a :Solid, :Edge ;
    :source :Node5 ;
    :target :Node6 ;
    :relationshipType :Follows .
