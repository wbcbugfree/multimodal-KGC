@prefix : <http://example.org/diagram2graph#> .

:Node1 a :Start, :Node ;
    :label "Begin" ;
    :shape :StartEvent .

:Node2 a :Process, :Node ;
    :label "Step 1" ;
    :shape :Task .

:Node3 a :Decision, :Node ;
    :label "Decision" ;
    :shape :Gateway .

:Node4 a :Process, :Node ;
    :label "Step 2" ;
    :shape :Task .

:Node5 a :Terminator, :Node ;
    :label "End" ;
    :shape :EndEvent .

:Edge12 a :Solid, :Edge ;
    :source :Node1 ;
    :target :Node2 ;
    :relationshipType :Follows .

:Edge23 a :Solid, :Edge ;
    :source :Node2 ;
    :target :Node3 ;
    :relationshipType :Follows .

:Edge32 a :Solid, :Edge ;
    :source :Node3 ;
    :target :Node2 ;
    :relationshipType :Branches ;
    :relationshipValue "No" .

:Edge34 a :Solid, :Edge ;
    :source :Node3 ;
    :target :Node4 ;
    :relationshipType :Branches ;
    :relationshipValue "Yes" .

:Edge45 a :Solid, :Edge ;
    :source :Node4 ;
    :target :Node5 ;
    :relationshipType :Follows .
