@prefix : <http://example.org/diagram2graph#> .

:Node1 a :Start, :Node ;
    :label "Start" ;
    :shape :StartEvent .

:Node2 a :Decision, :Node ;
    :label "Is target sector < max sector?" ;
    :shape :Gateway .

:Node3 a :Process, :Node ;
    :label "Increment Sector" ;
    :shape :Task .

:Node4 a :Process, :Node ;
    :label "Target Sector = 0" ;
    :shape :Task .

:Node5 a :Decision, :Node ;
    :label "Want to update?" ;
    :shape :Gateway .

:Node6 a :Process, :Node ;
    :label "Increment head" ;
    :shape :Task .

:Node7 a :Process, :Node ;
    :label "Target head = 0" ;
    :shape :Task .

:Node8 a :Process, :Node ;
    :label "Increment" ;
    :shape :Task .

:Node9 a :Terminator, :Node ;
    :label "End" ;
    :shape :EndEvent .

:Edge12 a :Solid, :Edge ;
    :source :Node1 ;
    :target :Node2 ;
    :relationshipType :Follows .

:Edge23 a :Solid, :Edge ;
    :source :Node2 ;
    :target :Node3 ;
    :relationshipType :Branches ;
    :relationshipValue "Yes" .

:Edge24 a :Solid, :Edge ;
    :source :Node2 ;
    :target :Node4 ;
    :relationshipType :Branches ;
    :relationshipValue "No" .

:Edge39 a :Solid, :Edge ;
    :source :Node3 ;
    :target :Node9 ;
    :relationshipType :Follows .

:Edge45 a :Solid, :Edge ;
    :source :Node4 ;
    :target :Node5 ;
    :relationshipType :Follows .

:Edge56 a :Solid, :Edge ;
    :source :Node5 ;
    :target :Node6 ;
    :relationshipType :Branches ;
    :relationshipValue "Yes" .

:Edge57 a :Solid, :Edge ;
    :source :Node5 ;
    :target :Node7 ;
    :relationshipType :Branches ;
    :relationshipValue "No" .

:Edge69 a :Solid, :Edge ;
    :source :Node6 ;
    :target :Node9 ;
    :relationshipType :Follows .

:Edge78 a :Solid, :Edge ;
    :source :Node7 ;
    :target :Node8 ;
    :relationshipType :Follows .

:Edge89 a :Solid, :Edge ;
    :source :Node8 ;
    :target :Node9 ;
    :relationshipType :Follows .
