@prefix : <http://example.org/diagram2graph#> .

:Node1 a :Start, :Node ;
    :label "Start" ;
    :shape :StartEvent .

:Node2 a :Process, :Node ;
    :label "Initialize parameters of particle swarm" ;
    :shape :Task .

:Node3 a :Process, :Node ;
    :label "Calculate the fitness function" ;
    :shape :Task .

:Node4 a :Process, :Node ;
    :label "Compare with others fitness" ;
    :shape :Task .

:Node5 a :Process, :Node ;
    :label "Update the global best position of particle swarm" ;
    :shape :Task .

:Node6 a :Process, :Node ;
    :label "Find overall performance" ;
    :shape :Task .

:Node7 a :Decision, :Node ;
    :label "Does it satisfy the termination conditions?" ;
    :shape :Gateway .

:Node8 a :Process, :Node ;
    :label "Display the results" ;
    :shape :Task .

:Node9 a :Terminator, :Node ;
    :label "End" ;
    :shape :EndEvent .

:Edge1 a :Solid, :Edge ;
    :source :Node1 ;
    :target :Node2 ;
    :relationshipType :Follows .

:Edge2 a :Solid, :Edge ;
    :source :Node2 ;
    :target :Node3 ;
    :relationshipType :Follows .

:Edge3 a :Solid, :Edge ;
    :source :Node3 ;
    :target :Node4 ;
    :relationshipType :Follows .

:Edge4 a :Solid, :Edge ;
    :source :Node3 ;
    :target :Node4 ;
    :relationshipType :Follows .

:Edge4 a :Solid, :Edge ;
    :source :Node4 ;
    :target :Node5 ;
    :relationshipType :Follows .

:Edge5 a :Solid, :Edge ;
    :source :Node5 ;
    :target :Node6 ;
    :relationshipType :Follows .

:Edge6 a :Solid, :Edge ;
    :source :Node6 ;
    :target :Node7 ;
    :relationshipType :Follows .

:Edge7 a :Solid, :Edge ;
    :source :Node7 ;
    :target :Node8 ;
    :relationshipType :Branches ;
    :relationshipValue "Y" .

:Edge8 a :Solid, :Edge ;
    :source :Node7 ;
    :target :Node3 ;
    :relationshipType :Branches ;
    :relationshipValue "N" .

:Edge9 a :Solid, :Edge ;
    :source :Node8 ;
    :target :Node9 ;
    :relationshipType :Follows .
