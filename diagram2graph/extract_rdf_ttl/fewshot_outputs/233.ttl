@prefix : <http://example.org/diagram2graph#> .

:Node1 a :Start, :Node ;
    :label "Start" ;
    :shape :StartEvent .

:Node2 a :Decision, :Node ;
    :label "Are you happy?" ;
    :shape :Gateway .

:Node3 a :Process, :Node ;
    :label "Very good, have a great day!" ;
    :shape :Task .

:Node4 a :Decision, :Node ;
    :label "Want to be happy?" ;
    :shape :Gateway .

:Node5 a :Process, :Node ;
    :label "Very good, Then you are already happy" ;
    :shape :Task .

:Node6 a :Process, :Node ;
    :label "Stay fit" ;
    :shape :Task .

:Node7 a :Terminator, :Node ;
    :label "Finish" ;
    :shape :EndEvent .

:Edge12 a :Solid, :Edge ;
    :source :Node1 ;
    :target :Node2 ;
    :relationshipType :Follows .

:Edge23 a :Solid, :Edge ;
    :source :Node2 ;
    :target :Node3 ;
    :relationshipType :Branches ;
    :relationshipValue "Yes" .

:Edge24 a :Solid, :Edge ;
    :source :Node2 ;
    :target :Node4 ;
    :relationshipType :Branches ;
    :relationshipValue "No" .

:Edge37 a :Solid, :Edge ;
    :source :Node3 ;
    :target :Node7 ;
    :relationshipType :Follows .

:Edge45 a :Solid, :Edge ;
    :source :Node4 ;
    :target :Node5 ;
    :relationshipType :Branches ;
    :relationshipValue "Yes" .

:Edge46 a :Solid, :Edge ;
    :source :Node4 ;
    :target :Node6 ;
    :relationshipType :Branches ;
    :relationshipValue "No" .

:Edge57 a :Solid, :Edge ;
    :source :Node5 ;
    :target :Node7 ;
    :relationshipType :Follows .

:Edge62 a :Solid, :Edge ;
    :source :Node6 ;
    :target :Node2 ;
    :relationshipType :Follows .
