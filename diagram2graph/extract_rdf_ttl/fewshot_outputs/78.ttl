@prefix : <http://example.org/diagram2graph#> .

:Node1 a :Start, :Node ;
    :label "Begin" ;
    :shape :StartEvent .

:Node2 a :Process, :Node ;
    :label "Add slack variables to inequality constraints" ;
    :shape :Task .

:Node3 a :Process, :Node ;
    :label "Calculate variables" ;
    :shape :Task .

:Node4 a :Process, :Node ;
    :label "Calculate reduced gradient" ;
    :shape :Task .

:Node5 a :Process, :Node ;
    :label "Determine search vector" ;
    :shape :Task .

:Node6 a :Process, :Node ;
    :label "Perform operations" ;
    :shape :Task .

:Node7 a :Decision, :Node ;
    :label "Converged\n?" ;
    :shape :Gateway .

:Node8 a :Process, :Node ;
    :label "Exit" ;
    :shape :Task .

:Edge12 a :Solid, :Edge ;
    :source :Node1 ;
    :target :Node2 ;
    :relationshipType :Follows .

:Edge23 a :Solid, :Edge ;
    :source :Node2 ;
    :target :Node3 ;
    :relationshipType :Follows .

:Edge34 a :Solid, :Edge ;
    :source :Node3 ;
    :target :Node4 ;
    :relationshipType :Follows .

:Edge45 a :Solid, :Edge ;
    :source :Node4 ;
    :target :Node5 ;
    :relationshipType :Follows .

:Edge56 a :Solid, :Edge ;
    :source :Node5 ;
    :target :Node6 ;
    :relationshipType :Follows .

:Edge67 a :Solid, :Edge ;
    :source :Node6 ;
    :target :Node7 ;
    :relationshipType :Follows .

:Edge73 a :Solid, :Edge ;
    :source :Node7 ;
    :target :Node3 ;
    :relationshipType :Branches ;
    :relationshipValue "No" .

:Edge78 a :Solid, :Edge ;
    :source :Node7 ;
    :target :Node8 ;
    :relationshipType :Branches ;
    :relationshipValue "Yes" .
