@prefix : <http://example.org/diagram2graph#> .

:Node1 a :Start, :Node ;
    :label "Begin" ;
    :shape :StartEvent .

:Node2 a :Decision, :Node ;
    :label "Does the user has an account?" ;
    :shape :Gateway .

:Node3 a :Process, :Node ;
    :label "Go to website" ;
    :shape :Task .

:Node4 a :Process, :Node ;
    :label "\"Open an account\" page open" ;
    :shape :Task .

:Node5 a :Process, :Node ;
    :label "User enter email" ;
    :shape :Task .

:Node6 a :Process, :Node ;
    :label "User enter password" ;
    :shape :Task .

:Node7 a :Process, :Node ;
    :label "User clicks on the login button" ;
    :shape :Task .

:Node8 a :Decision, :Node ;
    :label "Are the email and password is correct?" ;
    :shape :Gateway .

:Node9 a :Terminator, :Node ;
    :label "Close" ;
    :shape :EndEvent .

:Node10 a :Process, :Node ;
    :label "Error message appears" ;
    :shape :Task .

:Edge12 a :Solid, :Edge ;
    :source :Node1 ;
    :target :Node2 ;
    :relationshipType :Follows .

:Edge23 a :Solid, :Edge ;
    :source :Node2 ;
    :target :Node3 ;
    :relationshipType :Branches ;
    :relationshipValue "No" .

:Edge25 a :Solid, :Edge ;
    :source :Node2 ;
    :target :Node5 ;
    :relationshipType :Branches ;
    :relationshipValue "Yes" .

:Edge34 a :Solid, :Edge ;
    :source :Node3 ;
    :target :Node4 ;
    :relationshipType :Follows .

:Edge56 a :Solid, :Edge ;
    :source :Node5 ;
    :target :Node6 ;
    :relationshipType :Follows .

:Edge67 a :Solid, :Edge ;
    :source :Node6 ;
    :target :Node7 ;
    :relationshipType :Follows .

:Edge78 a :Solid, :Edge ;
    :source :Node7 ;
    :target :Node8 ;
    :relationshipType :Follows .

:Edge89 a :Solid, :Edge ;
    :source :Node8 ;
    :target :Node9 ;
    :relationshipType :Branches ;
    :relationshipValue "No" .

:Edge810 a :Solid, :Edge ;
    :source :Node8 ;
    :target :Node10 ;
    :relationshipType :Branches ;
    :relationshipValue "Yes" .
