@prefix : <http://example.org/diagram2graph#> .

:Node1 a :Start, :Node ;
    :label "START" ;
    :shape :StartEvent .

:Node2 a :Process, :Node ;
    :label "COMPUTE LOCAL\nADMIN GROUP\nNAME" ;
    :shape :Task .

:Node3 a :Decision, :Node ;
    :label "ADD OR\nREMOVE?" ;
    :shape :Gateway .

:Node4 a :Process, :Node ;
    :label "Update" ;
    :shape :Task .

:Node5 a :Process, :Node ;
    :label "ADD USERS TO\nGROUP" ;
    :shape :Task .

:Node6 a :Terminator, :Node ;
    :label "END" ;
    :shape :EndEvent .

:Node7 a :Process, :Node ;
    :label "Personalize" ;
    :shape :Task .

:Node8 a :Process, :Node ;
    :label "DISPLAY CURRENT\nMEMBERS" ;
    :shape :Task .

:Node9 a :Process, :Node ;
    :label "Check" ;
    :shape :Task .

:Edge12 a :Solid, :Edge ;
    :source :Node1 ;
    :target :Node2 ;
    :relationshipType :Follows .

:Edge23 a :Solid, :Edge ;
    :source :Node2 ;
    :target :Node3 ;
    :relationshipType :Follows .

:Edge34 a :Solid, :Edge ;
    :source :Node3 ;
    :target :Node4 ;
    :relationshipType :Branches ;
    :relationshipValue "ADD" .

:Edge37 a :Solid, :Edge ;
    :source :Node3 ;
    :target :Node7 ;
    :relationshipType :Branches ;
    :relationshipValue "REMOVE" .

:Edge45 a :Solid, :Edge ;
    :source :Node4 ;
    :target :Node5 ;
    :relationshipType :Follows .

:Edge56 a :Solid, :Edge ;
    :source :Node5 ;
    :target :Node6 ;
    :relationshipType :Follows .

:Edge78 a :Solid, :Edge ;
    :source :Node7 ;
    :target :Node8 ;
    :relationshipType :Follows .

:Edge89 a :Solid, :Edge ;
    :source :Node8 ;
    :target :Node9 ;
    :relationshipType :Follows .

:Edge96 a :Solid, :Edge ;
    :source :Node9 ;
    :target :Node6 ;
    :relationshipType :Follows .
