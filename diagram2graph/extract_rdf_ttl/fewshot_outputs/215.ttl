@prefix : <http://example.org/diagram2graph#> .

:Node1 a :Start, :Node ;
    :label "start" ;
    :shape :StartEvent .

:Node2 a :Process, :Node ;
    :label "identity authentication" ;
    :shape :Task .

:Node3 a :Decision, :Node ;
    :label "identity verification" ;
    :shape :Gateway .

:Node4 a :Process, :Node ;
    :label "Try Again" ;
    :shape :Task .

:Node5 a :Decision, :Node ;
    :label "Profile" ;
    :shape :Gateway .

:Node6 a :Process, :Node ;
    :label "User" ;
    :shape :Task .

:Node7 a :Process, :Node ;
    :label "identity management" ;
    :shape :Task .

:Edge1 a :Solid, :Edge ;
    :source :Node1 ;
    :target :Node2 ;
    :relationshipType :Follows .

:Edge2 a :Solid, :Edge ;
    :source :Node2 ;
    :target :Node3 ;
    :relationshipType :Follows .

:Edge3 a :Solid, :Edge ;
    :source :Node3 ;
    :target :Node4 ;
    :relationshipType :Branches ;
    :relationshipValue "N" .

:Edge4 a :Solid, :Edge ;
    :source :Node4 ;
    :target :Node3 ;
    :relationshipType :Follows .

:Edge5 a :Solid, :Edge ;
    :source :Node3 ;
    :target :Node5 ;
    :relationshipType :Branches ;
    :relationshipValue "Y" .

:Edge6 a :Solid, :Edge ;
    :source :Node5 ;
    :target :Node6 ;
    :relationshipType :Branches ;
    :relationshipValue "N" .

:Edge7 a :Solid, :Edge ;
    :source :Node5 ;
    :target :Node7 ;
    :relationshipType :Branches ;
    :relationshipValue "Y" .
