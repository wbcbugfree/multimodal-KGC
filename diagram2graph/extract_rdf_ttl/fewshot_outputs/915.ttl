@prefix : <http://example.org/diagram2graph#> .

:Node1 a :Start, :Node ;
    :label "Start" ;
    :shape :StartEvent .

:Node2 a :Process, :Node ;
    :label "Process" ;
    :shape :Task .

:Node3 a :Decision, :Node ;
    :label "Decision" ;
    :shape :Gateway .

:Node4 a :Process, :Node ;
    :label "Work" ;
    :shape :Task .

:Node5 a :Process, :Node ;
    :label "Party" ;
    :shape :Task .

:Node6 a :Process, :Node ;
    :label "Sleep" ;
    :shape :Task .

:Node7 a :Process, :Node ;
    :label "Enjoy" ;
    :shape :Task .

:Node8 a :Process, :Node ;
    :label "Home" ;
    :shape :Task .

:Node9 a :Terminator, :Node ;
    :label "End" ;
    :shape :EndEvent .

:Edge1 a :Solid, :Edge ;
    :source :Node1 ;
    :target :Node2 ;
    :relationshipType :Follows .

:Edge2 a :Solid, :Edge ;
    :source :Node2 ;
    :target :Node3 ;
    :relationshipType :Follows .

:Edge3 a :Solid, :Edge ;
    :source :Node3 ;
    :target :Node4 ;
    :relationshipType :Branches .

:Edge4 a :Solid, :Edge ;
    :source :Node3 ;
    :target :Node6 ;
    :relationshipType :Branches .

:Edge5 a :Solid, :Edge ;
    :source :Node4 ;
    :target :Node5 ;
    :relationshipType :Follows ;
    :relationshipValue "No" .

:Edge6 a :Solid, :Edge ;
    :source :Node4 ;
    :target :Node7 ;
    :relationshipType :Follows ;
    :relationshipValue "Yes" .

:Edge7 a :Solid, :Edge ;
    :source :Node6 ;
    :target :Node8 ;
    :relationshipType :Follows .

:Edge8 a :Solid, :Edge ;
    :source :Node8 ;
    :target :Node9 ;
    :relationshipType :Follows .
