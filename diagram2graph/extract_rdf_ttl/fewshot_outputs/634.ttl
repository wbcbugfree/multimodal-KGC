@prefix : <http://example.org/diagram2graph#> .

:Node1 a :Process, :Node ;
    :label "Initial" ;
    :shape :Task .

:Node2 a :Decision, :Node ;
    :label "Case 1" ;
    :shape :Gateway .

:Node3 a :Process, :Node ;
    :label "Statement 1" ;
    :shape :Task .

:Node4 a :Decision, :Node ;
    :label "Case 2" ;
    :shape :Gateway .

:Node5 a :Process, :Node ;
    :label "Statement 2" ;
    :shape :Task .

:Node6 a :Decision, :Node ;
    :label "Case N" ;
    :shape :Gateway .

:Node7 a :Process, :Node ;
    :label "Statement N" ;
    :shape :Task .

:Node8 a :Process, :Node ;
    :label "Default statement" ;
    :shape :Task .

:Node9 a :Terminator, :Node ;
    :label "End" ;
    :shape :EndEvent .

:Edge12 a :Solid, :Edge ;
    :source :Node1 ;
    :target :Node2 ;
    :relationshipType :Follows .

:Edge23 a :Solid, :Edge ;
    :source :Node2 ;
    :target :Node3 ;
    :relationshipType :Branches ;
    :relationshipValue "YES" .

:Edge24 a :Solid, :Edge ;
    :source :Node2 ;
    :target :Node4 ;
    :relationshipType :Branches ;
    :relationshipValue "NO" .

:Edge39 a :Solid, :Edge ;
    :source :Node3 ;
    :target :Node9 ;
    :relationshipType :Follows .

:Edge45 a :Solid, :Edge ;
    :source :Node4 ;
    :target :Node5 ;
    :relationshipType :Branches ;
    :relationshipValue "YES" .

:Edge46 a :Dashed, :Edge ;
    :source :Node4 ;
    :target :Node6 ;
    :relationshipType :Branches ;
    :relationshipValue "NO" .

:Edge59 a :Solid, :Edge ;
    :source :Node5 ;
    :target :Node9 ;
    :relationshipType :Follows .

:Edge67 a :Solid, :Edge ;
    :source :Node6 ;
    :target :Node7 ;
    :relationshipType :Branches ;
    :relationshipValue "YES" .

:Edge68 a :Solid, :Edge ;
    :source :Node6 ;
    :target :Node8 ;
    :relationshipType :Branches ;
    :relationshipValue "NO" .

:Edge79 a :Solid, :Edge ;
    :source :Node7 ;
    :target :Node9 ;
    :relationshipType :Follows .

:Edge89 a :Solid, :Edge ;
    :source :Node8 ;
    :target :Node9 ;
    :relationshipType :Follows .
