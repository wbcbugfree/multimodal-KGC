@prefix : <http://example.org/diagram2graph#> .

:Node1 a :Process, :Node ;
    :label "New Member" ;
    :shape :Task .

:Node2 a :Process, :Node ;
    :label "Login" ;
    :shape :Task .

:Node3 a :Process, :Node ;
    :label "Authentication" ;
    :shape :Task .

:Node4 a :Process, :Node ;
    :label "D1" ;
    :shape :Task .

:Node5 a :Process, :Node ;
    :label "Print info" ;
    :shape :Task .

:Node6 a :Process, :Node ;
    :label "Validation" ;
    :shape :Task .

:Node7 a :Process, :Node ;
    :label "D2" ;
    :shape :Task .

:Edge12 a :Solid, :Edge ;
    :source :Node1 ;
    :target :Node2 ;
    :relationshipType :Follows ;
    :relationshipValue "User name\nPassword" .

:Edge23 a :Solid, :Edge ;
    :source :Node2 ;
    :target :Node3 ;
    :relationshipType :Follows .

:Edge34 a :Solid, :Edge ;
    :source :Node3 ;
    :target :Node4 ;
    :relationshipType :Follows .

:Edge35 a :Solid, :Edge ;
    :source :Node3 ;
    :target :Node5 ;
    :relationshipType :Follows ;
    :relationshipValue "If not a member" .

:Edge51 a :Solid, :Edge ;
    :source :Node5 ;
    :target :Node1 ;
    :relationshipType :Follows .

:Edge67 a :Solid, :Edge ;
    :source :Node6 ;
    :target :Node7 ;
    :relationshipType :Follows ;
    :relationshipValue "ADP Username\nADP Password" .

:Edge36_1 a :Solid, :Edge ;
    :source :Node3 ;
    :target :Node6 ;
    :relationshipType :Follows ;
    :relationshipValue "If existing member" .

:Edge36_2 a :Solid, :Edge ;
    :source :Node3 ;
    :target :Node6 ;
    :relationshipType :Follows ;
    :relationshipValue "ADP Username\nADP Password" .
