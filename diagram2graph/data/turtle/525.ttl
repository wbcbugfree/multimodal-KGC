@prefix : <http://example.org/diagram2graph#> .

:Node1 a :Decision, :Node ;
    :label "Log In" ;
    :shape :Gateway .

:Node2 a :Decision, :Node ;
    :label "Logged In" ;
    :shape :Gateway .

:Node3 a :Process, :Node ;
    :label "OpenID log in" ;
    :shape :Task .

:Node4 a :Terminator, :Node ;
    :label "End" ;
    :shape :EndEvent .

:Edge1 a :Solid, :Edge ;
    :source :Node1 ;
    :target :Node2 ;
    :relationshipType :Follows ;
    :relationshipValue "OpenID login" .

:Edge2 a :Solid, :Edge ;
    :source :Node2 ;
    :target :Node3 ;
    :relationshipType :Branches ;
    :relationshipValue "No" .

:Edge3 a :Solid, :Edge ;
    :source :Node2 ;
    :target :Node4 ;
    :relationshipType :Branches ;
    :relationshipValue "Yes" .

:Edge4 a :Solid, :Edge ;
    :source :Node3 ;
    :target :Node4 ;
    :relationshipType :Follows .
