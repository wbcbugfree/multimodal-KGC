@prefix : <http://example.org/diagram2graph#> .

:Node1 a :Start, :Node ;
    :label "Start Loop" ;
    :shape :StartEvent .

:Node2 a :Decision, :Node ;
    :label "Initialize" ;
    :shape :Gateway .

:Node3 a :Terminator, :Node ;
    :label "End Loop" ;
    :shape :EndEvent .

:Node4 a :Process, :Node ;
    :label "Process" ;
    :shape :Task .

:Node5 a :Process, :Node ;
    :label "Increment or Decrement" ;
    :shape :Task .

:Edge1 a :Solid, :Edge ;
    :source :Node1 ;
    :target :Node2 ;
    :relationshipType :Follows .

:Edge2 a :Solid, :Edge ;
    :source :Node2 ;
    :target :Node3 ;
    :relationshipType :Branches ;
    :relationshipValue "False" .

:Edge3 a :Solid, :Edge ;
    :source :Node2 ;
    :target :Node4 ;
    :relationshipType :Branches ;
    :relationshipValue "True" .

:Edge4 a :Solid, :Edge ;
    :source :Node4 ;
    :target :Node5 ;
    :relationshipType :Follows .

:Edge5 a :Solid, :Edge ;
    :source :Node5 ;
    :target :Node2 ;
    :relationshipType :Follows .
