@prefix : <http://example.org/diagram2graph#> .

:Nodefruits a :Start, :Node ;
    :label "Fruits" ;
    :shape :StartEvent .

:Nodeinput_mango_pitaya_durian a :Process, :Node ;
    :label "Input mango, pitaya, durian" ;
    :shape :Task .

:Nodeprefer_pitaya_to_durian a :Decision, :Node ;
    :label "Prefer pitaya to durian?" ;
    :shape :Gateway .

:Nodeprefer_mango_to_pitaya a :Decision, :Node ;
    :label "Prefer mango to pitaya?" ;
    :shape :Gateway .

:Nodeprefer_mango_durian a :Decision, :Node ;
    :label "Prefer mango to durian?" ;
    :shape :Gateway .

:Nodego_for_mango a :Process, :Node ;
    :label "Go for mango" ;
    :shape :Task .

:Nodego_for_pitaya a :Process, :Node ;
    :label "Go for pitaya" ;
    :shape :Task .

:Nodego_for_pitaya_1 a :Process, :Node ;
    :label "Go for pitaya" ;
    :shape :Task .

:Nodeend a :Terminator, :Node ;
    :label "End" ;
    :shape :EndEvent .

:Edge1 a :Solid, :Edge ;
    :source :Nodefruits ;
    :target :Nodeinput_mango_pitaya_durian ;
    :relationshipType :Follows .

:Edge2 a :Solid, :Edge ;
    :source :Nodeinput_mango_pitaya_durian ;
    :target :Nodeprefer_mango_to_pitaya ;
    :relationshipType :Follows .

:Edge3 a :Solid, :Edge ;
    :source :Nodeprefer_mango_to_pitaya ;
    :target :Nodeprefer_pitaya_to_durian ;
    :relationshipType :Branches .

:Edge4 a :Solid, :Edge ;
    :source :Nodeprefer_mango_to_pitaya ;
    :target :Nodeprefer_mango_durian ;
    :relationshipType :Branches .

:Edge5 a :Solid, :Edge ;
    :source :Nodeprefer_pitaya_to_durian ;
    :target :Nodego_for_mango ;
    :relationshipType :DependsOn ;
    :relationshipValue "No" .

:Edge6 a :Solid, :Edge ;
    :source :Nodeprefer_pitaya_to_durian ;
    :target :Nodego_for_mango ;
    :relationshipType :DependsOn ;
    :relationshipValue "Yes" .

:Edge7 a :Solid, :Edge ;
    :source :Nodeprefer_mango_durian ;
    :target :Nodego_for_pitaya ;
    :relationshipType :DependsOn ;
    :relationshipValue "No" .

:Edge8 a :Solid, :Edge ;
    :source :Nodeprefer_mango_durian ;
    :target :Nodego_for_pitaya_1 ;
    :relationshipType :DependsOn ;
    :relationshipValue "Yes" .

:Edge9 a :Solid, :Edge ;
    :source :Nodego_for_mango ;
    :target :Nodeend ;
    :relationshipType :Follows .

:Edge10 a :Solid, :Edge ;
    :source :Nodego_for_pitaya ;
    :target :Nodeend ;
    :relationshipType :Follows .

:Edge11 a :Solid, :Edge ;
    :source :Nodego_for_pitaya_1 ;
    :target :Nodeend ;
    :relationshipType :Follows .
