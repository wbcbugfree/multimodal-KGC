@prefix : <http://example.org/diagram2graph#> .

:Nodestart a :Start, :Node ;
    :label "Start" ;
    :shape :StartEvent .

:Nodedocumentation_work a :Process, :Node ;
    :label "Documentation Work" ;
    :shape :Task .

:Nodeprint_cycle_count_sheets a :Process, :Node ;
    :label "Print cycle count sheets" ;
    :shape :Task .

:Nodeperform_physical_count_of_stock a :Process, :Node ;
    :label "Perform physical count of stock" ;
    :shape :Task .

:Nodeenter_physical_counts a :Process, :Node ;
    :label "Enter physical counts" ;
    :shape :Task .

:Nodereport_differences a :Process, :Node ;
    :label "Report differences" ;
    :shape :Task .

:Noderecount_inventory a :Decision, :Node ;
    :label "Recount inventory?" ;
    :shape :Gateway .

:Nodedisplay_documents a :Process, :Node ;
    :label "Display documents" ;
    :shape :Task .

:Nodeperform_physical_count_of_stock_1 a :Process, :Node ;
    :label "Perform physical count of stock" ;
    :shape :Task .

:Nodepost_inventory_documents a :Process, :Node ;
    :label "Post inventory documents" ;
    :shape :Task .

:Nodeend a :Terminator, :Node ;
    :label "End" ;
    :shape :EndEvent .

:Edgestartdocumentation_work a :Solid, :Edge ;
    :source :Nodestart ;
    :target :Nodedocumentation_work ;
    :relationshipType :Follows .

:Edgedocumentation_workprint_cycle_count_sheets a :Solid, :Edge ;
    :source :Nodedocumentation_work ;
    :target :Nodeprint_cycle_count_sheets ;
    :relationshipType :Follows .

:Edgeprint_cycle_count_sheetsperform_physical_count_of_stock a :Solid, :Edge ;
    :source :Nodeprint_cycle_count_sheets ;
    :target :Nodeperform_physical_count_of_stock ;
    :relationshipType :Follows .

:Edgeperform_physical_count_of_stockenter_physical_counts a :Solid, :Edge ;
    :source :Nodeperform_physical_count_of_stock ;
    :target :Nodeenter_physical_counts ;
    :relationshipType :Follows .

:Edgeenter_physical_countsreport_differences a :Solid, :Edge ;
    :source :Nodeenter_physical_counts ;
    :target :Nodereport_differences ;
    :relationshipType :Follows .

:Edgereport_differencesrecount_inventory a :Solid, :Edge ;
    :source :Nodereport_differences ;
    :target :Noderecount_inventory ;
    :relationshipType :Follows .

:Edgerecount_inventorypost_inventory_documents a :Solid, :Edge ;
    :source :Noderecount_inventory ;
    :target :Nodepost_inventory_documents ;
    :relationshipType :DependsOn ;
    :relationshipValue "No" .

:Edgerecount_inventorydisplay_documents a :Solid, :Edge ;
    :source :Noderecount_inventory ;
    :target :Nodedisplay_documents ;
    :relationshipType :DependsOn ;
    :relationshipValue "Yes" .

:Edgedisplay_documentsperform_physical_count_of_stock_1 a :Solid, :Edge ;
    :source :Nodedisplay_documents ;
    :target :Nodeperform_physical_count_of_stock_1 ;
    :relationshipType :Follows .

:Edgeperform_physical_count_of_stock_1report_differences a :Solid, :Edge ;
    :source :Nodeperform_physical_count_of_stock_1 ;
    :target :Nodereport_differences ;
    :relationshipType :Follows .

:Edgepost_inventory_documentsend a :Solid, :Edge ;
    :source :Nodepost_inventory_documents ;
    :target :Nodeend ;
    :relationshipType :Follows .
