@prefix : <http://example.org/diagram2graph#> .

:Node1 a :Start, :Node ;
    :label "START" ;
    :shape :StartEvent .

:Node2 a :Process, :Node ;
    :label "ACCEPT INPUT FROM USER" ;
    :shape :Task .

:Node3 a :Decision, :Node ;
    :label "CONDITION for(i=1;i<=a;i++)" ;
    :shape :Gateway .

:Node4 a :Process, :Node ;
    :label "Process" ;
    :shape :Task .

:Node5 a :Process, :Node ;
    :label "PRINT VALUE OF FACTORIAL" ;
    :shape :Task .

:Node6 a :Terminator, :Node ;
    :label "STOP" ;
    :shape :EndEvent .

:Edge1 a :Solid, :Edge ;
    :source :Node1 ;
    :target :Node2 ;
    :relationshipType :Follows .

:Edge2 a :Solid, :Edge ;
    :source :Node2 ;
    :target :Node3 ;
    :relationshipType :Follows .

:Edge3 a :Solid, :Edge ;
    :source :Node3 ;
    :target :Node4 ;
    :relationshipType :Branches ;
    :relationshipValue "CONDITION is TRUE" .

:Edge4 a :Solid, :Edge ;
    :source :Node3 ;
    :target :Node5 ;
    :relationshipType :Branches ;
    :relationshipValue "CONDITION is FALSE" .

:Edge5 a :Solid, :Edge ;
    :source :Node4 ;
    :target :Node3 ;
    :relationshipType :Branches .

:Edge6 a :Solid, :Edge ;
    :source :Node4 ;
    :target :Node3 ;
    :relationshipType :Branches .

:Edge7 a :Solid, :Edge ;
    :source :Node5 ;
    :target :Node6 ;
    :relationshipType :Follows .
