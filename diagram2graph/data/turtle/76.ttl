@prefix : <http://example.org/diagram2graph#> .

:Node1 a :Start, :Node ;
    :label "START" ;
    :shape :StartEvent .

:Node2 a :Decision, :Node ;
    :label "Is it necessary?" ;
    :shape :Gateway .

:Node3 a :Process, :Node ;
    :label "Don't do it!" ;
    :shape :Task .

:Node4 a :Decision, :Node ;
    :label "Will it fail?" ;
    :shape :Gateway .

:Node5 a :Process, :Node ;
    :label "Do it!" ;
    :shape :Task .

:Node6 a :Decision, :Node ;
    :label "Knowledge" ;
    :shape :Gateway .

:Edge1 a :Solid, :Edge ;
    :source :Node1 ;
    :target :Node2 ;
    :relationshipType :Follows .

:Edge2 a :Solid, :Edge ;
    :source :Node2 ;
    :target :Node3 ;
    :relationshipType :Branches ;
    :relationshipValue "NO" .

:Edge3 a :Solid, :Edge ;
    :source :Node2 ;
    :target :Node4 ;
    :relationshipType :Branches ;
    :relationshipValue "YES" .

:Edge4 a :Solid, :Edge ;
    :source :Node4 ;
    :target :Node5 ;
    :relationshipType :Branches ;
    :relationshipValue "NO" .

:Edge5 a :Solid, :Edge ;
    :source :Node4 ;
    :target :Node6 ;
    :relationshipType :Branches ;
    :relationshipValue "YES" .

:Edge6 a :Solid, :Edge ;
    :source :Node6 ;
    :target :Node3 ;
    :relationshipType :Branches ;
    :relationshipValue "NO" .

:Edge7 a :Solid, :Edge ;
    :source :Node6 ;
    :target :Node5 ;
    :relationshipType :Branches ;
    :relationshipValue "YES" .
