@prefix : <http://example.org/diagram2graph#> .

:Nodestart a :Start, :Node ;
    :label "START" ;
    :shape :StartEvent .

:Nodegreet a :Process, :Node ;
    :label "Greet" ;
    :shape :Task .

:Nodeenter_id a :Process, :Node ;
    :label "Enter ID" ;
    :shape :Task .

:Nodeinput_driver_info a :Process, :Node ;
    :label "INPUT DRIVER INFORMATION" ;
    :shape :Task .

:Nodeverify_finger_scan a :Process, :Node ;
    :label "Verify finger scan" ;
    :shape :Task .

:Nodescan_finger_again a :Process, :Node ;
    :label "SCAN FINGER AGAIN" ;
    :shape :Task .

:Nodescan_match_decision a :Decision, :Node ;
    :label "1ST AND 2ND SCAN MATCH?" ;
    :shape :Gateway .

:Nodelogin a :Process, :Node ;
    :label "Login" ;
    :shape :Task .

:Nodestop a :Terminator, :Node ;
    :label "STOP" ;
    :shape :EndEvent .

:Nodeaccept_no_commands a :Process, :Node ;
    :label "ACCEPT NO COMMANDS" ;
    :shape :Task .

:Edge1 a :Solid, :Edge ;
    :source :Nodestart ;
    :target :Nodegreet ;
    :relationshipType :Follows .

:Edge2 a :Solid, :Edge ;
    :source :Nodegreet ;
    :target :Nodeenter_id ;
    :relationshipType :Branches .

:Edge3 a :Dashed, :Edge ;
    :source :Nodegreet ;
    :target :Nodeaccept_no_commands ;
    :relationshipType :Branches ;
    :relationshipValue "FAILURE" .

:Edge4 a :Solid, :Edge ;
    :source :Nodeenter_id ;
    :target :Nodeinput_driver_info ;
    :relationshipType :Follows .

:Edge5 a :Solid, :Edge ;
    :source :Nodeinput_driver_info ;
    :target :Nodeverify_finger_scan ;
    :relationshipType :Follows .

:Edge6 a :Solid, :Edge ;
    :source :Nodeverify_finger_scan ;
    :target :Nodescan_finger_again ;
    :relationshipType :Follows .

:Edge7 a :Solid, :Edge ;
    :source :Nodescan_finger_again ;
    :target :Nodescan_match_decision ;
    :relationshipType :Follows .

:Edge8 a :Solid, :Edge ;
    :source :Nodescan_match_decision ;
    :target :Nodelogin ;
    :relationshipType :Branches ;
    :relationshipValue "YES" .

:Edge9 a :Solid, :Edge ;
    :source :Nodescan_match_decision ;
    :target :Nodeenter_id ;
    :relationshipType :Branches ;
    :relationshipValue "NO" .

:Edge10 a :Solid, :Edge ;
    :source :Nodelogin ;
    :target :Nodestop ;
    :relationshipType :Follows .
