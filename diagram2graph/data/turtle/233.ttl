@prefix : <http://example.org/diagram2graph#> .

:Node1 a :Start, :Node ;
    :label "Start" ;
    :shape :StartEvent .

:Node2 a :Decision, :Node ;
    :label "Are you happy?" ;
    :shape :Gateway .

:Node3 a :Process, :Node ;
    :label "Very good, have a great day!" ;
    :shape :Task .

:Node4 a :Terminator, :Node ;
    :label "Finish" ;
    :shape :EndEvent .

:Node5 a :Decision, :Node ;
    :label "Want to be happy?" ;
    :shape :Gateway .

:Node6 a :Process, :Node ;
    :label "Very good, Then you are already happy" ;
    :shape :Task .

:Node7 a :Process, :Node ;
    :label "Stay fit" ;
    :shape :Task .

:Edge1 a :Solid, :Edge ;
    :source :Node1 ;
    :target :Node2 ;
    :relationshipType :Follows .

:Edge2 a :Solid, :Edge ;
    :source :Node2 ;
    :target :Node3 ;
    :relationshipType :Branches ;
    :relationshipValue "Yes" .

:Edge3 a :Solid, :Edge ;
    :source :Node3 ;
    :target :Node4 ;
    :relationshipType :Follows .

:Edge4 a :Solid, :Edge ;
    :source :Node2 ;
    :target :Node5 ;
    :relationshipType :Branches ;
    :relationshipValue "No" .

:Edge5 a :Solid, :Edge ;
    :source :Node5 ;
    :target :Node6 ;
    :relationshipType :Branches .

:Edge6 a :Solid, :Edge ;
    :source :Node6 ;
    :target :Node4 ;
    :relationshipType :Follows .

:Edge7 a :Solid, :Edge ;
    :source :Node5 ;
    :target :Node7 ;
    :relationshipType :Branches ;
    :relationshipValue "No" .

:Edge8 a :Solid, :Edge ;
    :source :Node7 ;
    :target :Node1 ;
    :relationshipType :Follows .
