@prefix : <http://example.org/diagram2graph#> .

:Node1 a :Start, :Node ;
    :label "Start" ;
    :shape :StartEvent .

:Node2 a :Process, :Node ;
    :label "Entry Users Personal ID" ;
    :shape :Task .

:Node3 a :Process, :Node ;
    :label "Login Success" ;
    :shape :Task .

:Node4 a :Process, :Node ;
    :label "Read to-n Answer" ;
    :shape :Task .

:Node5 a :Process, :Node ;
    :label "Start Loop" ;
    :shape :Task .

:Node6 a :Process, :Node ;
    :label "Inference Process" ;
    :shape :Task .

:Node7 a :Decision, :Node ;
    :label "Conclusion" ;
    :shape :Gateway .

:Node8 a :Process, :Node ;
    :label "Positioning Detection for monitoring" ;
    :shape :Task .

:Node9 a :Terminator, :Node ;
    :label "Stop" ;
    :shape :EndEvent .

:Edge12 a :Solid, :Edge ;
    :source :Node1 ;
    :target :Node2 ;
    :relationshipType :Follows .

:Edge23 a :Solid, :Edge ;
    :source :Node2 ;
    :target :Node3 ;
    :relationshipType :Follows .

:Edge34 a :Solid, :Edge ;
    :source :Node3 ;
    :target :Node4 ;
    :relationshipType :Follows .

:Edge45 a :Solid, :Edge ;
    :source :Node4 ;
    :target :Node5 ;
    :relationshipType :Follows .

:Edge56 a :Solid, :Edge ;
    :source :Node5 ;
    :target :Node6 ;
    :relationshipType :Branches .

:Edge53 a :Solid, :Edge ;
    :source :Node5 ;
    :target :Node3 ;
    :relationshipType :Branches .

:Edge67 a :Solid, :Edge ;
    :source :Node6 ;
    :target :Node7 ;
    :relationshipType :Follows .

:Edge78 a :Solid, :Edge ;
    :source :Node7 ;
    :target :Node8 ;
    :relationshipType :Branches ;
    :relationshipValue "Yes" .

:Edge79 a :Solid, :Edge ;
    :source :Node7 ;
    :target :Node9 ;
    :relationshipType :Branches ;
    :relationshipValue "No" .

:Edge89 a :Solid, :Edge ;
    :source :Node8 ;
    :target :Node9 ;
    :relationshipType :Follows .
