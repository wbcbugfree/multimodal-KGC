@prefix : <http://example.org/diagram2graph#> .

:Node1 a :Start, :Node ;
    :label "Connector" ;
    :shape :StartEvent .

:Node2 a :Process, :Node ;
    :label "Check Time" ;
    :shape :Task .

:Node3 a :Decision, :Node ;
    :label "Before 4 pm?" ;
    :shape :Gateway .

:Node4 a :Process, :Node ;
    :label "Home" ;
    :shape :Task .

:Node5 a :Process, :Node ;
    :label "Office" ;
    :shape :Task .

:Node6 a :Process, :Node ;
    :label "Check" ;
    :shape :Task .

:Node7 a :Decision, :Node ;
    :label "Before 7 pm?" ;
    :shape :Gateway .

:Node8 a :Process, :Node ;
    :label "School" ;
    :shape :Task .

:Node9 a :Terminator, :Node ;
    :label "End" ;
    :shape :EndEvent .

:Edge12 a :Solid, :Edge ;
    :source :Node1 ;
    :target :Node2 ;
    :relationshipType :Follows .

:Edge23 a :Solid, :Edge ;
    :source :Node2 ;
    :target :Node3 ;
    :relationshipType :Follows .

:Edge34 a :Solid, :Edge ;
    :source :Node3 ;
    :target :Node4 ;
    :relationshipType :Branches ;
    :relationshipValue "Yes" .

:Edge35 a :Solid, :Edge ;
    :source :Node3 ;
    :target :Node5 ;
    :relationshipType :Branches ;
    :relationshipValue "No" .

:Edge56 a :Solid, :Edge ;
    :source :Node5 ;
    :target :Node6 ;
    :relationshipType :Follows .

:Edge67 a :Solid, :Edge ;
    :source :Node6 ;
    :target :Node7 ;
    :relationshipType :Follows .

:Edge75 a :Solid, :Edge ;
    :source :Node7 ;
    :target :Node5 ;
    :relationshipType :Branches ;
    :relationshipValue "No" .

:Edge78 a :Solid, :Edge ;
    :source :Node7 ;
    :target :Node8 ;
    :relationshipType :Branches ;
    :relationshipValue "Yes" .

:Edge89 a :Solid, :Edge ;
    :source :Node8 ;
    :target :Node9 ;
    :relationshipType :Follows .
