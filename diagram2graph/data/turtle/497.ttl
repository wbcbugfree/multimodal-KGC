@prefix : <http://example.org/diagram2graph#> .

:Node1 a :Start, :Node ;
    :label "Begin" ;
    :shape :StartEvent .

:Node2 a :Decision, :Node ;
    :label "Do you want to do this?" ;
    :shape :Gateway .

:Node3 a :Process, :Node ;
    :label "Don't do it" ;
    :shape :Task .

:Node4 a :Terminator, :Node ;
    :label "End" ;
    :shape :EndEvent .

:Node5 a :Decision, :Node ;
    :label "Will it likely end in disaster?" ;
    :shape :Gateway .

:Node6 a :Process, :Node ;
    :label "Do it" ;
    :shape :Task .

:Node7 a :Decision, :Node ;
    :label "Good Movie?" ;
    :shape :Gateway .

:Edge12 a :Solid, :Edge ;
    :source :Node1 ;
    :target :Node2 ;
    :relationshipType :Follows .

:Edge23 a :Solid, :Edge ;
    :source :Node2 ;
    :target :Node3 ;
    :relationshipType :Branches .

:Edge34 a :Solid, :Edge ;
    :source :Node3 ;
    :target :Node4 ;
    :relationshipType :Follows .

:Edge25 a :Solid, :Edge ;
    :source :Node2 ;
    :target :Node5 ;
    :relationshipType :Branches .

:Edge56 a :Solid, :Edge ;
    :source :Node5 ;
    :target :Node6 ;
    :relationshipType :Branches ;
    :relationshipValue "No" .

:Edge64 a :Solid, :Edge ;
    :source :Node6 ;
    :target :Node4 ;
    :relationshipType :Follows .

:Edge57 a :Solid, :Edge ;
    :source :Node5 ;
    :target :Node7 ;
    :relationshipType :Branches ;
    :relationshipValue "Yes" .

:Edge73 a :Solid, :Edge ;
    :source :Node7 ;
    :target :Node3 ;
    :relationshipType :Branches ;
    :relationshipValue "No" .

:Edge76 a :Solid, :Edge ;
    :source :Node7 ;
    :target :Node6 ;
    :relationshipType :Branches ;
    :relationshipValue "Yes" .
