@prefix : <http://example.org/diagram2graph#> .

:Node1 a :Start, :Node ;
    :label "Begin" ;
    :shape :StartEvent .

:Node2 a :Process, :Node ;
    :label "Login" ;
    :shape :Task .

:Node3 a :Decision, :Node ;
    :label "Login correct?" ;
    :shape :Gateway .

:Node4 a :Process, :Node ;
    :label "Front Page" ;
    :shape :Task .

:Edge12 a :Solid, :Edge ;
    :source :Node1 ;
    :target :Node2 ;
    :relationshipType :Follows .

:Edge23 a :Solid, :Edge ;
    :source :Node2 ;
    :target :Node3 ;
    :relationshipType :Follows .

:Edge34 a :Solid, :Edge ;
    :source :Node3 ;
    :target :Node4 ;
    :relationshipType :Follows .

:Edge32 a :Solid, :Edge ;
    :source :Node3 ;
    :target :Node2 ;
    :relationshipType :Follows ;
    :relationshipValue "Correct" .
