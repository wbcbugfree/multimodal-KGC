@prefix : <http://example.org/diagram2graph#> .

:Node0 a :Start, :Node ;
    :label "start" ;
    :shape :StartEvent .

:Node1 a :Decision, :Node ;
    :label "have you ever draw big flowchart" ;
    :shape :Gateway .

:Node2 a :Process, :Node ;
    :label "Awesome" ;
    :shape :Task .

:Node3 a :Process, :Node ;
    :label "Draw" ;
    :shape :Task .

:Node4 a :Process, :Node ;
    :label "Okay" ;
    :shape :Task .

:Node5 a :Process, :Node ;
    :label "it's just boxes How hard can it be?" ;
    :shape :Task .

:Node6 a :Process, :Node ;
    :label "easy" ;
    :shape :Task .

:Node7 a :Process, :Node ;
    :label "Langchain is the best frameworki" ;
    :shape :Task .

:Node8 a :Terminator, :Node ;
    :label "End" ;
    :shape :EndEvent .

:Edge1 a :Solid, :Edge ;
    :source :Node0 ;
    :target :Node1 ;
    :relationshipType :Follows .

:Edge2 a :Solid, :Edge ;
    :source :Node1 ;
    :target :Node2 ;
    :relationshipType :Branches ;
    :relationshipValue "No" .

:Edge3 a :Solid, :Edge ;
    :source :Node1 ;
    :target :Node5 ;
    :relationshipType :Branches ;
    :relationshipValue "Yes" .

:Edge4 a :Solid, :Edge ;
    :source :Node2 ;
    :target :Node3 ;
    :relationshipType :Follows .

:Edge5 a :Solid, :Edge ;
    :source :Node3 ;
    :target :Node4 ;
    :relationshipType :Follows .

:Edge6 a :Solid, :Edge ;
    :source :Node4 ;
    :target :Node8 ;
    :relationshipType :Follows .

:Edge7 a :Solid, :Edge ;
    :source :Node5 ;
    :target :Node6 ;
    :relationshipType :Follows .

:Edge8 a :Solid, :Edge ;
    :source :Node6 ;
    :target :Node7 ;
    :relationshipType :Follows .

:Edge9 a :Solid, :Edge ;
    :source :Node7 ;
    :target :Node8 ;
    :relationshipType :Follows .
