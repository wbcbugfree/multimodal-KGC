@prefix : <http://example.org/diagram2graph#> .

:Node1 a :Start, :Node ;
    :label "START" ;
    :shape :StartEvent .

:Node2 a :Process, :Node ;
    :label "Check Weather" ;
    :shape :Task .

:Node3 a :Decision, :Node ;
    :label "Is it raining?" ;
    :shape :Gateway .

:Node4 a :Process, :Node ;
    :label "Leave umbrella at home" ;
    :shape :Task .

:Node5 a :Process, :Node ;
    :label "Take an umbrella" ;
    :shape :Task .

:Node6 a :Terminator, :Node ;
    :label "END" ;
    :shape :EndEvent .

:Edge1 a :Solid, :Edge ;
    :source :Node1 ;
    :target :Node2 ;
    :relationshipType :Follows .

:Edge2 a :Solid, :Edge ;
    :source :Node2 ;
    :target :Node3 ;
    :relationshipType :Follows .

:Edge3 a :Solid, :Edge ;
    :source :Node3 ;
    :target :Node4 ;
    :relationshipType :Branches ;
    :relationshipValue "NO" .

:Edge4 a :Solid, :Edge ;
    :source :Node3 ;
    :target :Node5 ;
    :relationshipType :Branches ;
    :relationshipValue "YES" .

:Edge5 a :Solid, :Edge ;
    :source :Node4 ;
    :target :Node6 ;
    :relationshipType :Follows .

:Edge6 a :Solid, :Edge ;
    :source :Node5 ;
    :target :Node6 ;
    :relationshipType :Follows .
