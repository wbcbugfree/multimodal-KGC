@prefix : <http://example.org/diagram2graph#> .

:Node1 a :Start, :Node ;
    :label "Start" ;
    :shape :StartEvent .

:Node2 a :Process, :Node ;
    :label "Find changes in work" ;
    :shape :Task .

:Node3 a :Decision, :Node ;
    :label "Approval" ;
    :shape :Gateway .

:Node4 a :Process, :Node ;
    :label "Ignore change" ;
    :shape :Task .

:Node5 a :Process, :Node ;
    :label "Method" ;
    :shape :Task .

:Node6 a :Decision, :Node ;
    :label "Agree?" ;
    :shape :Gateway .

:Node7 a :Process, :Node ;
    :label "Expand" ;
    :shape :Task .

:Node8 a :Process, :Node ;
    :label "Discard" ;
    :shape :Task .

:Node9 a :Terminator, :Node ;
    :label "END" ;
    :shape :EndEvent .

:Edge12 a :Solid, :Edge ;
    :source :Node1 ;
    :target :Node2 ;
    :relationshipType :Follows .

:Edge23 a :Solid, :Edge ;
    :source :Node2 ;
    :target :Node3 ;
    :relationshipType :Follows .

:Edge34 a :Solid, :Edge ;
    :source :Node3 ;
    :target :Node4 ;
    :relationshipType :Branches ;
    :relationshipValue "No" .

:Edge35 a :Solid, :Edge ;
    :source :Node3 ;
    :target :Node5 ;
    :relationshipType :Branches ;
    :relationshipValue "Yes" .

:Edge56 a :Solid, :Edge ;
    :source :Node5 ;
    :target :Node6 ;
    :relationshipType :Follows .

:Edge67 a :Solid, :Edge ;
    :source :Node6 ;
    :target :Node7 ;
    :relationshipType :Branches ;
    :relationshipValue "Yes" .

:Edge68 a :Solid, :Edge ;
    :source :Node6 ;
    :target :Node8 ;
    :relationshipType :Branches ;
    :relationshipValue "No" .

:Edge79 a :Solid, :Edge ;
    :source :Node7 ;
    :target :Node9 ;
    :relationshipType :Follows .

:Edge89 a :Solid, :Edge ;
    :source :Node8 ;
    :target :Node9 ;
    :relationshipType :Follows .

:Edge49 a :Solid, :Edge ;
    :source :Node4 ;
    :target :Node9 ;
    :relationshipType :Follows .
