@prefix : <http://example.org/diagram2graph#> .

:Nodebegin a :Start, :Node ;
    :label "Begin" ;
    :shape :StartEvent .

:Nodeedit_video a :Process, :Node ;
    :label "Edit video" ;
    :shape :Task .

:Nodesmaller_than_2gb a :Decision, :Node ;
    :label "Smaller than 2GB?" ;
    :shape :Gateway .

:Nodeclick_to_upload a :Process, :Node ;
    :label "Click to upload" ;
    :shape :Task .

:Nodehave_account_already a :Decision, :Node ;
    :label "Have an account already?" ;
    :shape :Gateway .

:Noderegister a :Process, :Node ;
    :label "Register" ;
    :shape :Task .

:Nodelogin a :Process, :Node ;
    :label "Login" ;
    :shape :Task .

:Nodefind_on_computer a :Process, :Node ;
    :label "Find on computer" ;
    :shape :Task .

:Nodeadd_description_and_tags a :Process, :Node ;
    :label "Add description and tags" ;
    :shape :Task .

:Nodestop a :Terminator, :Node ;
    :label "Stop" ;
    :shape :EndEvent .

:Edge1 a :Solid, :Edge ;
    :source :Nodebegin ;
    :target :Nodeedit_video ;
    :relationshipType :Follows .

:Edge2 a :Solid, :Edge ;
    :source :Nodeedit_video ;
    :target :Nodesmaller_than_2gb ;
    :relationshipType :Follows .

:Edge3 a :Solid, :Edge ;
    :source :Nodesmaller_than_2gb ;
    :target :Nodeclick_to_upload ;
    :relationshipType :DependsOn ;
    :relationshipValue "YES" .

:Edge4 a :Solid, :Edge ;
    :source :Nodesmaller_than_2gb ;
    :target :Nodeedit_video ;
    :relationshipType :DependsOn ;
    :relationshipValue "NO" .

:Edge5 a :Solid, :Edge ;
    :source :Nodeclick_to_upload ;
    :target :Nodehave_account_already ;
    :relationshipType :Follows .

:Edge6 a :Solid, :Edge ;
    :source :Nodehave_account_already ;
    :target :Noderegister ;
    :relationshipType :DependsOn ;
    :relationshipValue "NO" .

:Edge7 a :Solid, :Edge ;
    :source :Nodehave_account_already ;
    :target :Nodelogin ;
    :relationshipType :DependsOn ;
    :relationshipValue "YES" .

:Edge8 a :Solid, :Edge ;
    :source :Noderegister ;
    :target :Nodelogin ;
    :relationshipType :Follows .

:Edge9 a :Solid, :Edge ;
    :source :Nodelogin ;
    :target :Nodefind_on_computer ;
    :relationshipType :Follows .

:Edge10 a :Solid, :Edge ;
    :source :Nodefind_on_computer ;
    :target :Nodeadd_description_and_tags ;
    :relationshipType :Follows .

:Edge11 a :Solid, :Edge ;
    :source :Nodeadd_description_and_tags ;
    :target :Nodestop ;
    :relationshipType :Follows .
