@prefix : <http://example.org/diagram2graph#> .

:Node1 a :Start, :Node ;
    :label "Begin" ;
    :shape :StartEvent .

:Node2 a :Process, :Node ;
    :label "Edit video" ;
    :shape :Task .

:Node3 a :Decision, :Node ;
    :label "Smaller than 2GB?" ;
    :shape :Gateway .

:Node4 a :Process, :Node ;
    :label "Click to upload" ;
    :shape :Task .

:Node5 a :Decision, :Node ;
    :label "Have an account already?" ;
    :shape :Gateway .

:Node6 a :Process, :Node ;
    :label "Register" ;
    :shape :Task .

:Node7 a :Process, :Node ;
    :label "Login" ;
    :shape :Task .

:Node8 a :Process, :Node ;
    :label "Find on computer" ;
    :shape :Task .

:Node9 a :Process, :Node ;
    :label "Add description and tags" ;
    :shape :Task .

:Node10 a :Terminator, :Node ;
    :label "Stop" ;
    :shape :EndEvent .

:Edge1 a :Solid, :Edge ;
    :source :Node1 ;
    :target :Node2 ;
    :relationshipType :Follows .

:Edge2 a :Solid, :Edge ;
    :source :Node2 ;
    :target :Node3 ;
    :relationshipType :Follows .

:Edge3 a :Solid, :Edge ;
    :source :Node3 ;
    :target :Node4 ;
    :relationshipType :DependsOn ;
    :relationshipValue "YES" .

:Edge4 a :Solid, :Edge ;
    :source :Node3 ;
    :target :Node2 ;
    :relationshipType :DependsOn ;
    :relationshipValue "NO" .

:Edge5 a :Solid, :Edge ;
    :source :Node4 ;
    :target :Node5 ;
    :relationshipType :Follows .

:Edge6 a :Solid, :Edge ;
    :source :Node5 ;
    :target :Node6 ;
    :relationshipType :DependsOn ;
    :relationshipValue "NO" .

:Edge7 a :Solid, :Edge ;
    :source :Node5 ;
    :target :Node7 ;
    :relationshipType :DependsOn ;
    :relationshipValue "YES" .

:Edge8 a :Solid, :Edge ;
    :source :Node6 ;
    :target :Node7 ;
    :relationshipType :Follows .

:Edge9 a :Solid, :Edge ;
    :source :Node7 ;
    :target :Node8 ;
    :relationshipType :Follows .

:Edge10 a :Solid, :Edge ;
    :source :Node8 ;
    :target :Node9 ;
    :relationshipType :Follows .

:Edge11 a :Solid, :Edge ;
    :source :Node9 ;
    :target :Node10 ;
    :relationshipType :Follows .
