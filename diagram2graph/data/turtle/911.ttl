@prefix : <http://example.org/diagram2graph#> .

:Node1 a :Start, :Node ;
    :label "Start" ;
    :shape :StartEvent .

:Node2 a :Process, :Node ;
    :label "Declare variables a,b,D,x1,x2,rp and ip" ;
    :shape :Task .

:Node3 a :Process, :Node ;
    :label "Calculate discriminant, D<-b^2-4ac" ;
    :shape :Task .

:Node4 a :Decision, :Node ;
    :label "is D>=0?" ;
    :shape :Gateway .

:Node5 a :Process, :Node ;
    :label "r1 ← (-b +√D) / 2a\nr2 ← (-b +√D) / 2a" ;
    :shape :Task .

:Node6 a :Process, :Node ;
    :label "ip <- -b/21\nrp <- √-D / 2a" ;
    :shape :Task .

:Node7 a :Process, :Node ;
    :label "x1 <- ip + j*ip\nx2 <- ip - j*ip" ;
    :shape :Task .

:Node8 a :Process, :Node ;
    :label "Display r1 and r2" ;
    :shape :Task .

:Node9 a :Terminator, :Node ;
    :label "Stop" ;
    :shape :EndEvent .

:Edge12 a :Solid, :Edge ;
    :source :Node1 ;
    :target :Node2 ;
    :relationshipType :Follows .

:Edge23 a :Solid, :Edge ;
    :source :Node2 ;
    :target :Node3 ;
    :relationshipType :Follows .

:Edge34 a :Solid, :Edge ;
    :source :Node3 ;
    :target :Node4 ;
    :relationshipType :Follows .

:Edge45 a :Solid, :Edge ;
    :source :Node4 ;
    :target :Node5 ;
    :relationshipType :Branches ;
    :relationshipValue "True" .

:Edge46 a :Solid, :Edge ;
    :source :Node4 ;
    :target :Node6 ;
    :relationshipType :Branches ;
    :relationshipValue "False" .

:Edge67 a :Solid, :Edge ;
    :source :Node6 ;
    :target :Node7 ;
    :relationshipType :Follows .

:Edge58 a :Solid, :Edge ;
    :source :Node5 ;
    :target :Node8 ;
    :relationshipType :Follows .

:Edge78 a :Solid, :Edge ;
    :source :Node7 ;
    :target :Node8 ;
    :relationshipType :Follows .

:Edge89 a :Solid, :Edge ;
    :source :Node8 ;
    :target :Node9 ;
    :relationshipType :Follows .
