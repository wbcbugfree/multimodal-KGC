@prefix : <http://example.org/diagram2graph#> .

:Node1 a :Start, :Node ;
    :label "Start" ;
    :shape :StartEvent .

:Node2 a :Process, :Node ;
    :label "INPUT numbers" ;
    :shape :Task .

:Node3 a :Decision, :Node ;
    :label "Perform operation" ;
    :shape :Gateway .

:Node4 a :Process, :Node ;
    :label "Find Average" ;
    :shape :Task .

:Node5 a :Process, :Node ;
    :label "INPUT latest" ;
    :shape :Task .

:Node6 a :Process, :Node ;
    :label "total=total+latest" ;
    :shape :Task .

:Node7 a :Process, :Node ;
    :label "OUTPUT \"The total of the numbers was\"+total" ;
    :shape :Task .

:Node8 a :Process, :Node ;
    :label "Print result" ;
    :shape :Task .

:Node9 a :Terminator, :Node ;
    :label "Stop" ;
    :shape :EndEvent .

:Edge12 a :Solid, :Edge ;
    :source :Node1 ;
    :target :Node2 ;
    :relationshipType :Follows .

:Edge23 a :Solid, :Edge ;
    :source :Node2 ;
    :target :Node3 ;
    :relationshipType :Follows .

:Edge34 a :Solid, :Edge ;
    :source :Node3 ;
    :target :Node4 ;
    :relationshipType :Branches ;
    :relationshipValue "Yes" .

:Edge35 a :Solid, :Edge ;
    :source :Node3 ;
    :target :Node5 ;
    :relationshipType :Branches ;
    :relationshipValue "No" .

:Edge56 a :Solid, :Edge ;
    :source :Node5 ;
    :target :Node6 ;
    :relationshipType :Follows .

:Edge63 a :Solid, :Edge ;
    :source :Node6 ;
    :target :Node3 ;
    :relationshipType :Follows .

:Edge47 a :Solid, :Edge ;
    :source :Node4 ;
    :target :Node7 ;
    :relationshipType :Follows .

:Edge78 a :Solid, :Edge ;
    :source :Node7 ;
    :target :Node8 ;
    :relationshipType :Follows .

:Edge89 a :Solid, :Edge ;
    :source :Node8 ;
    :target :Node9 ;
    :relationshipType :Follows .
