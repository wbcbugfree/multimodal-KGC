@prefix : <http://example.org/diagram2graph#> .

:Node1 a :Start, :Node ;
    :label "Start" ;
    :shape :StartEvent .

:Node2 a :Decision, :Node ;
    :label "Obect Detected" ;
    :shape :Gateway .

:Node3 a :Process, :Node ;
    :label "Drive Forwards" ;
    :shape :Task .

:Node4 a :Process, :Node ;
    :label "Turn Robot" ;
    :shape :Task .

:Edge12 a :Solid, :Edge ;
    :source :Node1 ;
    :target :Node2 ;
    :relationshipType :Follows .

:Edge23 a :Solid, :Edge ;
    :source :Node2 ;
    :target :Node3 ;
    :relationshipType :Branches ;
    :relationshipValue "Yes" .

:Edge24 a :Solid, :Edge ;
    :source :Node2 ;
    :target :Node4 ;
    :relationshipType :Branches ;
    :relationshipValue "No" .

:Edge32 a :Solid, :Edge ;
    :source :Node3 ;
    :target :Node2 ;
    :relationshipType :Follows .

:Edge42 a :Solid, :Edge ;
    :source :Node4 ;
    :target :Node2 ;
    :relationshipType :Follows .
