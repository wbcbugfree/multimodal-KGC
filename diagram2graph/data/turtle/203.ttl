@prefix : <http://example.org/diagram2graph#> .

:Nodecustomer_consulting a :Process, :Node ;
    :label "Customer Consulting and Quotation" ;
    :shape :Task .

:Nodedeal a :Decision, :Node ;
    :label "Deal?" ;
    :shape :Gateway .

:Nodego_home a :Process, :Node ;
    :label "Go home" ;
    :shape :Task .

:Nodeinvoice a :Process, :Node ;
    :label "Invoice" ;
    :shape :Task .

:Nodeshipping a :Process, :Node ;
    :label "Shipping" ;
    :shape :Task .

:Nodecustom_clearance a :Process, :Node ;
    :label "Custom Clearance" ;
    :shape :Task .

:Nodepayment_mode a :Process, :Node ;
    :label "Payment mode" ;
    :shape :Task .

:Nodedelivery a :Process, :Node ;
    :label "Delivery" ;
    :shape :Task .

:Nodeservice_payment a :Process, :Node ;
    :label "Service Payment" ;
    :shape :Task .

:Nodepay_foreign_exchange a :Decision, :Node ;
    :label "Pay Foreign Exchange?" ;
    :shape :Gateway .

:Nodepayment a :Process, :Node ;
    :label "Payment" ;
    :shape :Task .

:Nodestop a :Terminator, :Node ;
    :label "Stop" ;
    :shape :EndEvent .

:Edgecustomer_consultingdeal a :Solid, :Edge ;
    :source :Nodecustomer_consulting ;
    :target :Nodedeal ;
    :relationshipType :Follows .

:Edgedealinvoice a :Solid, :Edge ;
    :source :Nodedeal ;
    :target :Nodeinvoice ;
    :relationshipType :DependsOn ;
    :relationshipValue "Yes" .

:Edgedealgo_home a :Dashed, :Edge ;
    :source :Nodedeal ;
    :target :Nodego_home ;
    :relationshipType :DependsOn ;
    :relationshipValue "No" .

:Edgeinvoiceshipping a :Solid, :Edge ;
    :source :Nodeinvoice ;
    :target :Nodeshipping ;
    :relationshipType :Follows .

:Edgeshippingcustom_clearance a :Solid, :Edge ;
    :source :Nodeshipping ;
    :target :Nodecustom_clearance ;
    :relationshipType :Follows .

:Edgecustom_clearancepayment_mode a :Solid, :Edge ;
    :source :Nodecustom_clearance ;
    :target :Nodepayment_mode ;
    :relationshipType :Follows .

:Edgepayment_modedelivery a :Solid, :Edge ;
    :source :Nodepayment_mode ;
    :target :Nodedelivery ;
    :relationshipType :Follows .

:Edgedeliveryservice_payment a :Solid, :Edge ;
    :source :Nodedelivery ;
    :target :Nodeservice_payment ;
    :relationshipType :Follows .

:Edgeservice_paymentpay_foreign_exchange a :Solid, :Edge ;
    :source :Nodeservice_payment ;
    :target :Nodepay_foreign_exchange ;
    :relationshipType :Follows .

:Edgepay_foreign_exchangepayment a :Solid, :Edge ;
    :source :Nodepay_foreign_exchange ;
    :target :Nodepayment ;
    :relationshipType :DependsOn ;
    :relationshipValue "Yes" .

:Edgepay_foreign_exchangestop a :Dashed, :Edge ;
    :source :Nodepay_foreign_exchange ;
    :target :Nodestop ;
    :relationshipType :DependsOn ;
    :relationshipValue "No" .

:Edgepaymentstop a :Solid, :Edge ;
    :source :Nodepayment ;
    :target :Nodestop ;
    :relationshipType :Follows .
