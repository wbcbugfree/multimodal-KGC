@prefix : <http://example.org/diagram2graph#> .

:Nodecustomer_consulting a :Process, :Node ;
    :label "Customer Consulting and Quotation" ;
    :shape :Task .

:Nodedeal a :Decision, :Node ;
    :label "Deal?" ;
    :shape :Gateway .

:Nodego_home a :Process, :Node ;
    :label "Go home" ;
    :shape :Task .

:Nodeinvoice a :Process, :Node ;
    :label "Invoice" ;
    :shape :Task .

:Nodeshipping a :Process, :Node ;
    :label "Shipping" ;
    :shape :Task .

:Nodecustom_clearance a :Process, :Node ;
    :label "Custom Clearance" ;
    :shape :Task .

:Nodepayment_mode a :Process, :Node ;
    :label "Payment mode" ;
    :shape :Task .

:Nodedelivery a :Process, :Node ;
    :label "Delivery" ;
    :shape :Task .

:Nodeservice_payment a :Process, :Node ;
    :label "Service Payment" ;
    :shape :Task .

:Nodepay_foreign_exchange a :Decision, :Node ;
    :label "Pay Foreign Exchange?" ;
    :shape :Gateway .

:Nodepayment a :Process, :Node ;
    :label "Payment" ;
    :shape :Task .

:Nodestop a :Terminator, :Node ;
    :label "Stop" ;
    :shape :EndEvent .

:Edge1 a :Solid, :Edge ;
    :source :Nodecustomer_consulting ;
    :target :Nodedeal ;
    :relationshipType :Follows .

:Edge2 a :Solid, :Edge ;
    :source :Nodedeal ;
    :target :Nodeinvoice ;
    :relationshipType :DependsOn ;
    :relationshipValue "Yes" .

:Edge3 a :Dashed, :Edge ;
    :source :Nodedeal ;
    :target :Nodego_home ;
    :relationshipType :DependsOn ;
    :relationshipValue "No" .

:Edge4 a :Solid, :Edge ;
    :source :Nodeinvoice ;
    :target :Nodeshipping ;
    :relationshipType :Follows .

:Edge5 a :Solid, :Edge ;
    :source :Nodeshipping ;
    :target :Nodecustom_clearance ;
    :relationshipType :Follows .

:Edge6 a :Solid, :Edge ;
    :source :Nodecustom_clearance ;
    :target :Nodepayment_mode ;
    :relationshipType :Follows .

:Edge7 a :Solid, :Edge ;
    :source :Nodepayment_mode ;
    :target :Nodedelivery ;
    :relationshipType :Follows .

:Edge8 a :Solid, :Edge ;
    :source :Nodedelivery ;
    :target :Nodeservice_payment ;
    :relationshipType :Follows .

:Edge9 a :Solid, :Edge ;
    :source :Nodeservice_payment ;
    :target :Nodepay_foreign_exchange ;
    :relationshipType :Follows .

:Edge10 a :Solid, :Edge ;
    :source :Nodepay_foreign_exchange ;
    :target :Nodepayment ;
    :relationshipType :DependsOn ;
    :relationshipValue "Yes" .

:Edge11 a :Dashed, :Edge ;
    :source :Nodepay_foreign_exchange ;
    :target :Nodestop ;
    :relationshipType :DependsOn ;
    :relationshipValue "No" .

:Edge12 a :Solid, :Edge ;
    :source :Nodepayment ;
    :target :Nodestop ;
    :relationshipType :Follows .
