@prefix : <http://example.org/diagram2graph#> .

:Node1 a :Process, :Node ;
    :label "Customer Consulting and Quotation" ;
    :shape :Task .

:Node2 a :Decision, :Node ;
    :label "Deal?" ;
    :shape :Gateway .

:Node3 a :Process, :Node ;
    :label "Go home" ;
    :shape :Task .

:Node4 a :Process, :Node ;
    :label "Invoice" ;
    :shape :Task .

:Node5 a :Process, :Node ;
    :label "Shipping" ;
    :shape :Task .

:Node6 a :Process, :Node ;
    :label "Custom Clearance" ;
    :shape :Task .

:Node7 a :Process, :Node ;
    :label "Payment mode" ;
    :shape :Task .

:Node8 a :Process, :Node ;
    :label "Delivery" ;
    :shape :Task .

:Node9 a :Process, :Node ;
    :label "Service Payment" ;
    :shape :Task .

:Node10 a :Decision, :Node ;
    :label "Pay Foreign Exchange?" ;
    :shape :Gateway .

:Node11 a :Process, :Node ;
    :label "Payment" ;
    :shape :Task .

:Node12 a :Terminator, :Node ;
    :label "Stop" ;
    :shape :EndEvent .

:Edge1 a :Solid, :Edge ;
    :source :Node1 ;
    :target :Node2 ;
    :relationshipType :Follows .

:Edge2 a :Solid, :Edge ;
    :source :Node2 ;
    :target :Node4 ;
    :relationshipType :DependsOn ;
    :relationshipValue "Yes" .

:Edge3 a :Dashed, :Edge ;
    :source :Node2 ;
    :target :Node3 ;
    :relationshipType :DependsOn ;
    :relationshipValue "No" .

:Edge4 a :Solid, :Edge ;
    :source :Node4 ;
    :target :Node5 ;
    :relationshipType :Follows .

:Edge5 a :Solid, :Edge ;
    :source :Node5 ;
    :target :Node6 ;
    :relationshipType :Follows .

:Edge6 a :Solid, :Edge ;
    :source :Node6 ;
    :target :Node7 ;
    :relationshipType :Follows .

:Edge7 a :Solid, :Edge ;
    :source :Node7 ;
    :target :Node8 ;
    :relationshipType :Follows .

:Edge8 a :Solid, :Edge ;
    :source :Node8 ;
    :target :Node9 ;
    :relationshipType :Follows .

:Edge9 a :Solid, :Edge ;
    :source :Node9 ;
    :target :Node10 ;
    :relationshipType :Follows .

:Edge10 a :Solid, :Edge ;
    :source :Node10 ;
    :target :Node11 ;
    :relationshipType :DependsOn ;
    :relationshipValue "Yes" .

:Edge11 a :Dashed, :Edge ;
    :source :Node10 ;
    :target :Node12 ;
    :relationshipType :DependsOn ;
    :relationshipValue "No" .

:Edge12 a :Solid, :Edge ;
    :source :Node11 ;
    :target :Node12 ;
    :relationshipType :Follows .
