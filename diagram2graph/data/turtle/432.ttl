@prefix : <http://example.org/diagram2graph#> .

:Node1 a :Start, :Node ;
    :label "Begin" ;
    :shape :StartEvent .

:Node2 a :Process, :Node ;
    :label "Total patients" ;
    :shape :Task .

:Node3 a :Process, :Node ;
    :label "Serious patients" ;
    :shape :Task .

:Node4 a :Process, :Node ;
    :label "Operation needed" ;
    :shape :Task .

:Node5 a :Process, :Node ;
    :label "Doctor needed" ;
    :shape :Task .

:Node6 a :Process, :Node ;
    :label "No operation needed" ;
    :shape :Task .

:Node7 a :Process, :Node ;
    :label "PACC Group" ;
    :shape :Task .

:Node8 a :Terminator, :Node ;
    :label "Get well soon" ;
    :shape :EndEvent .

:Edge12 a :Solid, :Edge ;
    :source :Node1 ;
    :target :Node2 ;
    :relationshipType :Follows .

:Edge23 a :Solid, :Edge ;
    :source :Node2 ;
    :target :Node3 ;
    :relationshipType :Follows .

:Edge34 a :Solid, :Edge ;
    :source :Node3 ;
    :target :Node4 ;
    :relationshipType :Branches .

:Edge35 a :Solid, :Edge ;
    :source :Node3 ;
    :target :Node5 ;
    :relationshipType :Branches .

:Edge36 a :Solid, :Edge ;
    :source :Node3 ;
    :target :Node6 ;
    :relationshipType :Branches .

:Edge47 a :Solid, :Edge ;
    :source :Node4 ;
    :target :Node7 ;
    :relationshipType :Follows .

:Edge58 a :Solid, :Edge ;
    :source :Node5 ;
    :target :Node8 ;
    :relationshipType :Follows .

:Edge68 a :Solid, :Edge ;
    :source :Node6 ;
    :target :Node8 ;
    :relationshipType :Follows .
