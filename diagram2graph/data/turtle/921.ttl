@prefix : <http://example.org/diagram2graph#> .

:Node1 a :Start, :Node ;
    :label "Start" ;
    :shape :StartEvent .

:Node2 a :Start, :Node ;
    :label "Enter www.acme.com" ;
    :shape :StartEvent .

:Node3 a :Process, :Node ;
    :label "Acme Home page" ;
    :shape :Task .

:Node4 a :Process, :Node ;
    :label "Enter Email ID and Password" ;
    :shape :Task .

:Node5 a :Decision, :Node ;
    :label "Is Email ID and Password Correct?" ;
    :shape :Gateway .

:Node6 a :Process, :Node ;
    :label "Display Account" ;
    :shape :Task .

:Node7 a :Process, :Node ;
    :label "Login Error" ;
    :shape :Task .

:Node8 a :Terminator, :Node ;
    :label "Stop" ;
    :shape :EndEvent .

:Edge1 a :Solid, :Edge ;
    :source :Node1 ;
    :target :Node2 ;
    :relationshipType :Follows .

:Edge2 a :Solid, :Edge ;
    :source :Node2 ;
    :target :Node3 ;
    :relationshipType :Follows .

:Edge3 a :Solid, :Edge ;
    :source :Node3 ;
    :target :Node4 ;
    :relationshipType :Follows .

:Edge4 a :Solid, :Edge ;
    :source :Node4 ;
    :target :Node5 ;
    :relationshipType :Follows .

:Edge5 a :Solid, :Edge ;
    :source :Node5 ;
    :target :Node6 ;
    :relationshipType :Branches ;
    :relationshipValue "Yes" .

:Edge6 a :Solid, :Edge ;
    :source :Node5 ;
    :target :Node7 ;
    :relationshipType :Branches ;
    :relationshipValue "No" .

:Edge7 a :Solid, :Edge ;
    :source :Node6 ;
    :target :Node8 ;
    :relationshipType :Follows .

:Edge8 a :Solid, :Edge ;
    :source :Node7 ;
    :target :Node4 ;
    :relationshipType :Follows .
