@prefix d2g: <http://example.org/diagram2graph#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

# === Nodes ===
<http://example.org/diagram/diagram/node/start> a d2g:Start, d2g:Node ;
    rdfs:label "Start" ;
    d2g:shape d2g:StartEvent .

<http://example.org/diagram/diagram/node/hard_work> a d2g:Process, d2g:Node ;
    rdfs:label "Hard work" ;
    d2g:shape d2g:Task .

<http://example.org/diagram/diagram/node/franchise> a d2g:Process, d2g:Node ;
    rdfs:label "Franchise" ;
    d2g:shape d2g:Task .

<http://example.org/diagram/diagram/node/success> a d2g:Decision, d2g:Node ;
    rdfs:label "Success" ;
    d2g:shape d2g:Gateway .

<http://example.org/diagram/diagram/node/order_more> a d2g:Process, d2g:Node ;
    rdfs:label "Order more" ;
    d2g:shape d2g:Task .

<http://example.org/diagram/diagram/node/sold> a d2g:Decision, d2g:Node ;
    rdfs:label "Sold" ;
    d2g:shape d2g:Gateway .

<http://example.org/diagram/diagram/node/expandable> a d2g:Decision, d2g:Node ;
    rdfs:label "Expandable" ;
    d2g:shape d2g:Gateway .

<http://example.org/diagram/diagram/node/open_more_store> a d2g:Process, d2g:Node ;
    rdfs:label "Open more store" ;
    d2g:shape d2g:Task .

<http://example.org/diagram/diagram/node/new_strategy> a d2g:Process, d2g:Node ;
    rdfs:label "New Strategy" ;
    d2g:shape d2g:Task .

<http://example.org/diagram/diagram/node/end> a d2g:Terminator, d2g:Node ;
    rdfs:label "End" ;
    d2g:shape d2g:EndEvent .

# === Edges ===
<http://example.org/diagram/diagram/edge/starthard_work> a d2g:Solid, d2g:Edge ;
    d2g:source <http://example.org/diagram/diagram/node/start> ;
    d2g:target <http://example.org/diagram/diagram/node/hard_work> ;
    d2g:relationshipType d2g:Follows .

<http://example.org/diagram/diagram/node/start> d2g:follows <http://example.org/diagram/diagram/node/hard_work> .

<http://example.org/diagram/diagram/edge/hard_workfranchise> a d2g:Solid, d2g:Edge ;
    d2g:source <http://example.org/diagram/diagram/node/hard_work> ;
    d2g:target <http://example.org/diagram/diagram/node/franchise> ;
    d2g:relationshipType d2g:Branches .

<http://example.org/diagram/diagram/node/hard_work> d2g:branches <http://example.org/diagram/diagram/node/franchise> .

<http://example.org/diagram/diagram/edge/hard_worknew_strategy> a d2g:Solid, d2g:Edge ;
    d2g:source <http://example.org/diagram/diagram/node/hard_work> ;
    d2g:target <http://example.org/diagram/diagram/node/new_strategy> ;
    d2g:relationshipType d2g:Branches .

<http://example.org/diagram/diagram/node/hard_work> d2g:branches <http://example.org/diagram/diagram/node/new_strategy> .

<http://example.org/diagram/diagram/edge/franchisesuccess> a d2g:Solid, d2g:Edge ;
    d2g:source <http://example.org/diagram/diagram/node/franchise> ;
    d2g:target <http://example.org/diagram/diagram/node/success> ;
    d2g:relationshipType d2g:Follows .

<http://example.org/diagram/diagram/node/franchise> d2g:follows <http://example.org/diagram/diagram/node/success> .

<http://example.org/diagram/diagram/edge/successorder_more> a d2g:Solid, d2g:Edge ;
    d2g:source <http://example.org/diagram/diagram/node/success> ;
    d2g:target <http://example.org/diagram/diagram/node/order_more> ;
    d2g:relationshipType d2g:DependsOn ;
    d2g:relationshipValue "Yes" .

<http://example.org/diagram/diagram/node/success> d2g:depends_on <http://example.org/diagram/diagram/node/order_more> .

<http://example.org/diagram/diagram/edge/successnew_strategy> a d2g:Solid, d2g:Edge ;
    d2g:source <http://example.org/diagram/diagram/node/success> ;
    d2g:target <http://example.org/diagram/diagram/node/new_strategy> ;
    d2g:relationshipType d2g:DependsOn ;
    d2g:relationshipValue "No" .

<http://example.org/diagram/diagram/node/success> d2g:depends_on <http://example.org/diagram/diagram/node/new_strategy> .

<http://example.org/diagram/diagram/edge/order_moresold> a d2g:Solid, d2g:Edge ;
    d2g:source <http://example.org/diagram/diagram/node/order_more> ;
    d2g:target <http://example.org/diagram/diagram/node/sold> ;
    d2g:relationshipType d2g:Follows .

<http://example.org/diagram/diagram/node/order_more> d2g:follows <http://example.org/diagram/diagram/node/sold> .

<http://example.org/diagram/diagram/edge/soldexpandable> a d2g:Solid, d2g:Edge ;
    d2g:source <http://example.org/diagram/diagram/node/sold> ;
    d2g:target <http://example.org/diagram/diagram/node/expandable> ;
    d2g:relationshipType d2g:DependsOn ;
    d2g:relationshipValue "Yes" .

<http://example.org/diagram/diagram/node/sold> d2g:depends_on <http://example.org/diagram/diagram/node/expandable> .

<http://example.org/diagram/diagram/edge/soldnew_strategy> a d2g:Solid, d2g:Edge ;
    d2g:source <http://example.org/diagram/diagram/node/sold> ;
    d2g:target <http://example.org/diagram/diagram/node/new_strategy> ;
    d2g:relationshipType d2g:DependsOn ;
    d2g:relationshipValue "No" .

<http://example.org/diagram/diagram/node/sold> d2g:depends_on <http://example.org/diagram/diagram/node/new_strategy> .

<http://example.org/diagram/diagram/edge/expandableopen_more_store> a d2g:Solid, d2g:Edge ;
    d2g:source <http://example.org/diagram/diagram/node/expandable> ;
    d2g:target <http://example.org/diagram/diagram/node/open_more_store> ;
    d2g:relationshipType d2g:DependsOn ;
    d2g:relationshipValue "Yes" .

<http://example.org/diagram/diagram/node/expandable> d2g:depends_on <http://example.org/diagram/diagram/node/open_more_store> .

<http://example.org/diagram/diagram/edge/expandableend> a d2g:Solid, d2g:Edge ;
    d2g:source <http://example.org/diagram/diagram/node/expandable> ;
    d2g:target <http://example.org/diagram/diagram/node/end> ;
    d2g:relationshipType d2g:DependsOn ;
    d2g:relationshipValue "No" .

<http://example.org/diagram/diagram/node/expandable> d2g:depends_on <http://example.org/diagram/diagram/node/end> .

<http://example.org/diagram/diagram/edge/open_more_storesuccess> a d2g:Solid, d2g:Edge ;
    d2g:source <http://example.org/diagram/diagram/node/open_more_store> ;
    d2g:target <http://example.org/diagram/diagram/node/success> ;
    d2g:relationshipType d2g:Follows .

<http://example.org/diagram/diagram/node/open_more_store> d2g:follows <http://example.org/diagram/diagram/node/success> .
