@prefix : <http://example.org/diagram2graph#> .

:Node1 a :Start, :Node ;
    :label "Start" ;
    :shape :StartEvent .

:Node2 a :Process, :Node ;
    :label "Hard work" ;
    :shape :Task .

:Node3 a :Process, :Node ;
    :label "Franchise" ;
    :shape :Task .

:Node4 a :Decision, :Node ;
    :label "Success" ;
    :shape :Gateway .

:Node5 a :Process, :Node ;
    :label "Order more" ;
    :shape :Task .

:Node6 a :Decision, :Node ;
    :label "Sold" ;
    :shape :Gateway .

:Node7 a :Decision, :Node ;
    :label "Expandable" ;
    :shape :Gateway .

:Node8 a :Process, :Node ;
    :label "Open more store" ;
    :shape :Task .

:Node9 a :Process, :Node ;
    :label "New Strategy" ;
    :shape :Task .

:Node10 a :Terminator, :Node ;
    :label "End" ;
    :shape :EndEvent .

:Edge1 a :Solid, :Edge ;
    :source :Node1 ;
    :target :Node2 ;
    :relationshipType :Follows .

:Edge2 a :Solid, :Edge ;
    :source :Node2 ;
    :target :Node3 ;
    :relationshipType :Branches .

:Edge3 a :Solid, :Edge ;
    :source :Node2 ;
    :target :Node9 ;
    :relationshipType :Branches .

:Edge4 a :Solid, :Edge ;
    :source :Node3 ;
    :target :Node4 ;
    :relationshipType :Follows .

:Edge5 a :Solid, :Edge ;
    :source :Node4 ;
    :target :Node5 ;
    :relationshipType :DependsOn ;
    :relationshipValue "Yes" .

:Edge6 a :Solid, :Edge ;
    :source :Node4 ;
    :target :Node9 ;
    :relationshipType :DependsOn ;
    :relationshipValue "No" .

:Edge7 a :Solid, :Edge ;
    :source :Node5 ;
    :target :Node6 ;
    :relationshipType :Follows .

:Edge8 a :Solid, :Edge ;
    :source :Node6 ;
    :target :Node7 ;
    :relationshipType :DependsOn ;
    :relationshipValue "Yes" .

:Edge9 a :Solid, :Edge ;
    :source :Node6 ;
    :target :Node9 ;
    :relationshipType :DependsOn ;
    :relationshipValue "No" .

:Edge10 a :Solid, :Edge ;
    :source :Node7 ;
    :target :Node8 ;
    :relationshipType :DependsOn ;
    :relationshipValue "Yes" .

:Edge11 a :Solid, :Edge ;
    :source :Node7 ;
    :target :Node10 ;
    :relationshipType :DependsOn ;
    :relationshipValue "No" .

:Edge12 a :Solid, :Edge ;
    :source :Node8 ;
    :target :Node4 ;
    :relationshipType :Follows .
