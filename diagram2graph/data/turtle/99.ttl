@prefix : <http://example.org/diagram2graph#> .

:Nodestart a :Start, :Node ;
    :label "Start" ;
    :shape :StartEvent .

:Nodehard_work a :Process, :Node ;
    :label "Hard work" ;
    :shape :Task .

:Nodefranchise a :Process, :Node ;
    :label "Franchise" ;
    :shape :Task .

:Nodesuccess a :Decision, :Node ;
    :label "Success" ;
    :shape :Gateway .

:Nodeorder_more a :Process, :Node ;
    :label "Order more" ;
    :shape :Task .

:Nodesold a :Decision, :Node ;
    :label "Sold" ;
    :shape :Gateway .

:Nodeexpandable a :Decision, :Node ;
    :label "Expandable" ;
    :shape :Gateway .

:Nodeopen_more_store a :Process, :Node ;
    :label "Open more store" ;
    :shape :Task .

:Nodenew_strategy a :Process, :Node ;
    :label "New Strategy" ;
    :shape :Task .

:Nodeend a :Terminator, :Node ;
    :label "End" ;
    :shape :EndEvent .

:Edge1 a :Solid, :Edge ;
    :source :Nodestart ;
    :target :Nodehard_work ;
    :relationshipType :Follows .

:Edge2 a :Solid, :Edge ;
    :source :Nodehard_work ;
    :target :Nodefranchise ;
    :relationshipType :Branches .

:Edge3 a :Solid, :Edge ;
    :source :Nodehard_work ;
    :target :Nodenew_strategy ;
    :relationshipType :Branches .

:Edge4 a :Solid, :Edge ;
    :source :Nodefranchise ;
    :target :Nodesuccess ;
    :relationshipType :Follows .

:Edge5 a :Solid, :Edge ;
    :source :Nodesuccess ;
    :target :Nodeorder_more ;
    :relationshipType :DependsOn ;
    :relationshipValue "Yes" .

:Edge6 a :Solid, :Edge ;
    :source :Nodesuccess ;
    :target :Nodenew_strategy ;
    :relationshipType :DependsOn ;
    :relationshipValue "No" .

:Edge7 a :Solid, :Edge ;
    :source :Nodeorder_more ;
    :target :Nodesold ;
    :relationshipType :Follows .

:Edge8 a :Solid, :Edge ;
    :source :Nodesold ;
    :target :Nodeexpandable ;
    :relationshipType :DependsOn ;
    :relationshipValue "Yes" .

:Edge9 a :Solid, :Edge ;
    :source :Nodesold ;
    :target :Nodenew_strategy ;
    :relationshipType :DependsOn ;
    :relationshipValue "No" .

:Edge10 a :Solid, :Edge ;
    :source :Nodeexpandable ;
    :target :Nodeopen_more_store ;
    :relationshipType :DependsOn ;
    :relationshipValue "Yes" .

:Edge11 a :Solid, :Edge ;
    :source :Nodeexpandable ;
    :target :Nodeend ;
    :relationshipType :DependsOn ;
    :relationshipValue "No" .

:Edge12 a :Solid, :Edge ;
    :source :Nodeopen_more_store ;
    :target :Nodesuccess ;
    :relationshipType :Follows .
