@prefix : <http://example.org/diagram2graph#> .

:Nodestart a :Start, :Node ;
    :label "Start" ;
    :shape :StartEvent .

:Nodelogin a :Process, :Node ;
    :label "Login" ;
    :shape :Task .

:Nodeverified a :Decision, :Node ;
    :label "Verified?" ;
    :shape :Gateway .

:Nodedashboard a :Process, :Node ;
    :label "Dashboard" ;
    :shape :Task .

:Nodeclick_report_incident a :Process, :Node ;
    :label "Click on the report incident link" ;
    :shape :Task .

:Nodefill_form a :Process, :Node ;
    :label "Fill the form" ;
    :shape :Task .

:Nodevalidation_module a :Process, :Node ;
    :label "Validation Module" ;
    :shape :Task .

:Nodeneed a :Decision, :Node ;
    :label "Need?" ;
    :shape :Gateway .

:Nodesubmit a :Process, :Node ;
    :label "Submit" ;
    :shape :Task .

:Nodeupdate_form a :Process, :Node ;
    :label "Update form" ;
    :shape :Task .

:Nodeview_comments a :Process, :Node ;
    :label "View comments on the post" ;
    :shape :Task .

:Nodestop a :Terminator, :Node ;
    :label "Stop" ;
    :shape :EndEvent .

:Edge1 a :Solid, :Edge ;
    :source :Nodestart ;
    :target :Nodelogin ;
    :relationshipType :Follows .

:Edge2 a :Solid, :Edge ;
    :source :Nodelogin ;
    :target :Nodeverified ;
    :relationshipType :Follows .

:Edge3 a :Solid, :Edge ;
    :source :Nodeverified ;
    :target :Nodedashboard ;
    :relationshipType :DependsOn ;
    :relationshipValue "Yes" .

:Edge4 a :Solid, :Edge ;
    :source :Nodeverified ;
    :target :Nodelogin ;
    :relationshipType :DependsOn ;
    :relationshipValue "No" .

:Edge5 a :Solid, :Edge ;
    :source :Nodedashboard ;
    :target :Nodeclick_report_incident ;
    :relationshipType :Follows .

:Edge6 a :Solid, :Edge ;
    :source :Nodeclick_report_incident ;
    :target :Nodefill_form ;
    :relationshipType :Follows .

:Edge7 a :Solid, :Edge ;
    :source :Nodefill_form ;
    :target :Nodevalidation_module ;
    :relationshipType :Follows .

:Edge8 a :Solid, :Edge ;
    :source :Nodevalidation_module ;
    :target :Nodeneed ;
    :relationshipType :Follows .

:Edge9 a :Solid, :Edge ;
    :source :Nodeneed ;
    :target :Nodeview_comments ;
    :relationshipType :DependsOn ;
    :relationshipValue "Yes" .

:Edge10 a :Solid, :Edge ;
    :source :Nodeneed ;
    :target :Nodeupdate_form ;
    :relationshipType :DependsOn ;
    :relationshipValue "No" .

:Edge11 a :Solid, :Edge ;
    :source :Nodeupdate_form ;
    :target :Nodesubmit ;
    :relationshipType :Follows .

:Edge12 a :Solid, :Edge ;
    :source :Nodesubmit ;
    :target :Nodevalidation_module ;
    :relationshipType :Follows .

:Edge13 a :Solid, :Edge ;
    :source :Nodeview_comments ;
    :target :Nodestop ;
    :relationshipType :Follows .
