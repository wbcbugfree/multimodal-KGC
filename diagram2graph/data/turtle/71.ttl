@prefix : <http://example.org/diagram2graph#> .

:Nodestart a :Start, :Node ;
    :label "Start" ;
    :shape :StartEvent .

:Noderead_values a :Process, :Node ;
    :label "Read Values" ;
    :shape :Task .

:Nodenew_trials_available a :Decision, :Node ;
    :label "new trials available?" ;
    :shape :Gateway .

:Noderead_new_trial a :Process, :Node ;
    :label "read new trial" ;
    :shape :Task .

:Nodeaverage_available a :Decision, :Node ;
    :label "average avaible for condition?" ;
    :shape :Gateway .

:Nodeinitialize a :Process, :Node ;
    :label "Initialize" ;
    :shape :Task .

:Nodeadd_data_to_cumulative_sum a :Process, :Node ;
    :label "add data to cumulative sum" ;
    :shape :Task .

:Nodecompute_t_value_and_plot a :Process, :Node ;
    :label "compute t-value and plot" ;
    :shape :Task .

:Nodecontinue a :Decision, :Node ;
    :label "continue?" ;
    :shape :Gateway .

:Nodestop a :Terminator, :Node ;
    :label "Stop" ;
    :shape :EndEvent .

:Edge1 a :Solid, :Edge ;
    :source :Nodestart ;
    :target :Noderead_values ;
    :relationshipType :Follows .

:Edge2 a :Solid, :Edge ;
    :source :Noderead_values ;
    :target :Nodenew_trials_available ;
    :relationshipType :Follows .

:Edge3 a :Solid, :Edge ;
    :source :Nodenew_trials_available ;
    :target :Noderead_new_trial ;
    :relationshipType :DependsOn ;
    :relationshipValue "yes" .

:Edge4 a :Solid, :Edge ;
    :source :Nodenew_trials_available ;
    :target :Noderead_values ;
    :relationshipType :DependsOn ;
    :relationshipValue "no" .

:Edge5 a :Solid, :Edge ;
    :source :Noderead_new_trial ;
    :target :Nodeaverage_available ;
    :relationshipType :Follows .

:Edge6 a :Solid, :Edge ;
    :source :Nodeaverage_available ;
    :target :Nodeinitialize ;
    :relationshipType :DependsOn ;
    :relationshipValue "no" .

:Edge7 a :Solid, :Edge ;
    :source :Nodeaverage_available ;
    :target :Nodeadd_data_to_cumulative_sum ;
    :relationshipType :DependsOn ;
    :relationshipValue "yes" .

:Edge8 a :Solid, :Edge ;
    :source :Nodeinitialize ;
    :target :Nodeadd_data_to_cumulative_sum ;
    :relationshipType :Follows .

:Edge9 a :Solid, :Edge ;
    :source :Nodeadd_data_to_cumulative_sum ;
    :target :Nodecompute_t_value_and_plot ;
    :relationshipType :Follows .

:Edge10 a :Solid, :Edge ;
    :source :Nodecompute_t_value_and_plot ;
    :target :Nodecontinue ;
    :relationshipType :Follows .

:Edge11 a :Solid, :Edge ;
    :source :Nodecontinue ;
    :target :Noderead_values ;
    :relationshipType :DependsOn ;
    :relationshipValue "yes" .

:Edge12 a :Solid, :Edge ;
    :source :Nodecontinue ;
    :target :Nodestop ;
    :relationshipType :DependsOn ;
    :relationshipValue "no" .
