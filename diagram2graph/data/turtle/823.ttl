@prefix : <http://example.org/diagram2graph#> .

:Node1 a :Start, :Node ;
    :label "Application" ;
    :shape :StartEvent .

:Node2 a :Process, :Node ;
    :label "Login" ;
    :shape :Task .

:Node3 a :Process, :Node ;
    :label "Apply" ;
    :shape :Task .

:Node4 a :Process, :Node ;
    :label "Shortlist resumes" ;
    :shape :Task .

:Node5 a :Process, :Node ;
    :label "E-mail resumes to departments" ;
    :shape :Task .

:Node6 a :Decision, :Node ;
    :label "Resumes approved?" ;
    :shape :Gateway .

:Node7 a :Process, :Node ;
    :label "Screen more resumes" ;
    :shape :Task .

:Node8 a :Process, :Node ;
    :label "Call for Interview" ;
    :shape :Task .

:Node9 a :Terminator, :Node ;
    :label "End hiring Stage 1" ;
    :shape :EndEvent .

:Edge1 a :Solid, :Edge ;
    :source :Node1 ;
    :target :Node2 ;
    :relationshipType :Follows .

:Edge2 a :Solid, :Edge ;
    :source :Node2 ;
    :target :Node3 ;
    :relationshipType :Follows .

:Edge3 a :Solid, :Edge ;
    :source :Node3 ;
    :target :Node4 ;
    :relationshipType :Follows .

:Edge4 a :Solid, :Edge ;
    :source :Node4 ;
    :target :Node5 ;
    :relationshipType :Follows .

:Edge5 a :Solid, :Edge ;
    :source :Node5 ;
    :target :Node6 ;
    :relationshipType :Follows .

:Edge6 a :Solid, :Edge ;
    :source :Node6 ;
    :target :Node7 ;
    :relationshipType :Branches ;
    :relationshipValue "No" .

:Edge7 a :Solid, :Edge ;
    :source :Node7 ;
    :target :Node5 ;
    :relationshipType :Follows .

:Edge8 a :Solid, :Edge ;
    :source :Node6 ;
    :target :Node8 ;
    :relationshipType :Branches ;
    :relationshipValue "Yes" .

:Edge9 a :Solid, :Edge ;
    :source :Node8 ;
    :target :Node9 ;
    :relationshipType :Follows .
