@prefix : <http://example.org/diagram2graph#> .

:Noden1 a :Process, :Node ;
    :label "Assessment" ;
    :shape :Task .

:Noden2 a :Process, :Node ;
    :label "Team work" ;
    :shape :Task .

:Noden3 a :Process, :Node ;
    :label "Work" ;
    :shape :Task .

:Noden4 a :Process, :Node ;
    :label "Gather" ;
    :shape :Task .

:Noden5 a :Process, :Node ;
    :label "Complete" ;
    :shape :Task .

:Noden6 a :Process, :Node ;
    :label "Closure" ;
    :shape :Task .

:Noden7 a :Process, :Node ;
    :label "Primary closure" ;
    :shape :Task .

:Noden8 a :Process, :Node ;
    :label "Bandaging" ;
    :shape :Task .

:Noden9 a :Process, :Node ;
    :label "Delayed primary closure" ;
    :shape :Task .

:Noden10 a :Process, :Node ;
    :label "Secondary closure" ;
    :shape :Task .

:Edgen1n2 a :Solid, :Edge ;
    :source :Noden1 ;
    :target :Noden2 ;
    :relationshipType :Follows .

:Edgen2n3 a :Solid, :Edge ;
    :source :Noden2 ;
    :target :Noden3 ;
    :relationshipType :Follows .

:Edgen3n4 a :Solid, :Edge ;
    :source :Noden3 ;
    :target :Noden4 ;
    :relationshipType :Follows .

:Edgen4n5 a :Solid, :Edge ;
    :source :Noden4 ;
    :target :Noden5 ;
    :relationshipType :Follows .

:Edgen5n6 a :Solid, :Edge ;
    :source :Noden5 ;
    :target :Noden6 ;
    :relationshipType :Follows .

:Edgen6n7 a :Solid, :Edge ;
    :source :Noden6 ;
    :target :Noden7 ;
    :relationshipType :Branches .

:Edgen6n8 a :Solid, :Edge ;
    :source :Noden6 ;
    :target :Noden8 ;
    :relationshipType :Branches .

:Edgen8n9 a :Solid, :Edge ;
    :source :Noden8 ;
    :target :Noden9 ;
    :relationshipType :Branches .

:Edgen8n10 a :Solid, :Edge ;
    :source :Noden8 ;
    :target :Noden10 ;
    :relationshipType :Branches .
