@prefix : <http://example.org/diagram2graph#> .

:Node1 a :Start, :Node ;
    :label "Start" ;
    :shape :StartEvent .

:Node2 a :Process, :Node ;
    :label "Set up the training pattern" ;
    :shape :Task .

:Node3 a :Process, :Node ;
    :label "Set up the structure" ;
    :shape :Task .

:Node4 a :Process, :Node ;
    :label "Use the training pattern" ;
    :shape :Task .

:Node5 a :Decision, :Node ;
    :label "Training finished?" ;
    :shape :Gateway .

:Node6 a :Process, :Node ;
    :label "Save the connection weights" ;
    :shape :Task .

:Node7 a :Process, :Node ;
    :label "Power quality Analysis" ;
    :shape :Task .

:Node8 a :Terminator, :Node ;
    :label "End" ;
    :shape :EndEvent .

:Edge12 a :Solid, :Edge ;
    :source :Node1 ;
    :target :Node2 ;
    :relationshipType :Follows .

:Edge23 a :Solid, :Edge ;
    :source :Node2 ;
    :target :Node3 ;
    :relationshipType :Follows .

:Edge34 a :Solid, :Edge ;
    :source :Node3 ;
    :target :Node4 ;
    :relationshipType :Follows .

:Edge45 a :Solid, :Edge ;
    :source :Node4 ;
    :target :Node5 ;
    :relationshipType :Follows .

:Edge54 a :Solid, :Edge ;
    :source :Node5 ;
    :target :Node4 ;
    :relationshipType :Branches ;
    :relationshipValue "no" .

:Edge56 a :Solid, :Edge ;
    :source :Node5 ;
    :target :Node6 ;
    :relationshipType :Branches ;
    :relationshipValue "yes" .

:Edge67 a :Solid, :Edge ;
    :source :Node6 ;
    :target :Node7 ;
    :relationshipType :Follows .

:Edge78 a :Solid, :Edge ;
    :source :Node7 ;
    :target :Node8 ;
    :relationshipType :Follows .
