@prefix : <http://example.org/diagram2graph#> .

:Nodebegin a :Start, :Node ;
    :label "BEGIN" ;
    :shape :StartEvent .

:Nodeenter_limit a :Process, :Node ;
    :label "Enter Limit" ;
    :shape :Task .

:Nodeinitialize_number a :Process, :Node ;
    :label "Initialize number" ;
    :shape :Task .

:Nodeset_sum_to_0 a :Process, :Node ;
    :label "Set Sum equal to 0" ;
    :shape :Task .

:Nodedo a :Process, :Node ;
    :label "DO" ;
    :shape :Task .

:Nodeif_sum_greater_than_limit a :Decision, :Node ;
    :label "If Sum > Limit" ;
    :shape :Gateway .

:Nodeupdate_values a :Process, :Node ;
    :label "Update values" ;
    :shape :Task .

:Nodedecrease_loss a :Process, :Node ;
    :label "Decrease loss" ;
    :shape :Task .

:Nodedisplay_number_and_sum a :Process, :Node ;
    :label "Display Number and Sum" ;
    :shape :Task .

:Nodeend a :Terminator, :Node ;
    :label "END" ;
    :shape :EndEvent .

:Edge1 a :Solid, :Edge ;
    :source :Nodebegin ;
    :target :Nodeenter_limit ;
    :relationshipType :Follows .

:Edge2 a :Solid, :Edge ;
    :source :Nodeenter_limit ;
    :target :Nodeinitialize_number ;
    :relationshipType :Follows .

:Edge3 a :Solid, :Edge ;
    :source :Nodeinitialize_number ;
    :target :Nodeset_sum_to_0 ;
    :relationshipType :Follows .

:Edge4 a :Solid, :Edge ;
    :source :Nodeset_sum_to_0 ;
    :target :Nodedo ;
    :relationshipType :Follows .

:Edge5 a :Solid, :Edge ;
    :source :Nodedo ;
    :target :Nodeif_sum_greater_than_limit ;
    :relationshipType :Follows .

:Edge6 a :Solid, :Edge ;
    :source :Nodeif_sum_greater_than_limit ;
    :target :Nodeupdate_values ;
    :relationshipType :DependsOn ;
    :relationshipValue "false" .

:Edge7 a :Solid, :Edge ;
    :source :Nodeif_sum_greater_than_limit ;
    :target :Nodedisplay_number_and_sum ;
    :relationshipType :DependsOn ;
    :relationshipValue "true" .

:Edge8 a :Solid, :Edge ;
    :source :Nodeupdate_values ;
    :target :Nodedecrease_loss ;
    :relationshipType :Follows .

:Edge9 a :Solid, :Edge ;
    :source :Nodedecrease_loss ;
    :target :Nodedo ;
    :relationshipType :Follows .

:Edge10 a :Solid, :Edge ;
    :source :Nodedisplay_number_and_sum ;
    :target :Nodeend ;
    :relationshipType :Follows .
