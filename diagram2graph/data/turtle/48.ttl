@prefix : <http://example.org/diagram2graph#> .

:Node1 a :Start, :Node ;
    :label "START" ;
    :shape :StartEvent .

:Node2 a :Process, :Node ;
    :label "count=1" ;
    :shape :Task .

:Node3 a :Decision, :Node ;
    :label "count<=3" ;
    :shape :Gateway .

:Node4 a :Terminator, :Node ;
    :label "STOP" ;
    :shape :EndEvent .

:Node5 a :Process, :Node ;
    :label "INPUT" ;
    :shape :Task .

:Node6 a :Process, :Node ;
    :label "p*n*r/100" ;
    :shape :Task .

:Node7 a :Process, :Node ;
    :label "PRINT" ;
    :shape :Task .

:Node8 a :Process, :Node ;
    :label "count=count+1" ;
    :shape :Task .

:Edge12 a :Solid, :Edge ;
    :source :Node1 ;
    :target :Node2 ;
    :relationshipType :Follows .

:Edge23 a :Solid, :Edge ;
    :source :Node2 ;
    :target :Node3 ;
    :relationshipType :Follows .

:Edge34 a :Solid, :Edge ;
    :source :Node3 ;
    :target :Node4 ;
    :relationshipType :Branches ;
    :relationshipValue "No" .

:Edge35 a :Solid, :Edge ;
    :source :Node3 ;
    :target :Node5 ;
    :relationshipType :Branches ;
    :relationshipValue "Yes" .

:Edge56 a :Solid, :Edge ;
    :source :Node5 ;
    :target :Node6 ;
    :relationshipType :Follows .

:Edge67 a :Solid, :Edge ;
    :source :Node6 ;
    :target :Node7 ;
    :relationshipType :Follows .

:Edge78 a :Solid, :Edge ;
    :source :Node7 ;
    :target :Node8 ;
    :relationshipType :Follows .

:Edge83 a :Solid, :Edge ;
    :source :Node8 ;
    :target :Node3 ;
    :relationshipType :Follows .
