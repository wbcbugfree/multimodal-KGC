@prefix : <http://example.org/diagram2graph#> .

:Node1 a :Start, :Node ;
    :label "Start" ;
    :shape :StartEvent .

:Node2 a :Process, :Node ;
    :label "document-filter" ;
    :shape :Task .

:Node3 a :Process, :Node ;
    :label "Screening" ;
    :shape :Task .

:Node4 a :Process, :Node ;
    :label "document-converter" ;
    :shape :Task .

:Node5 a :Process, :Node ;
    :label "document-converter-topic" ;
    :shape :Task .

:Node6 a :Process, :Node ;
    :label "published" ;
    :shape :Task .

:Node7 a :Process, :Node ;
    :label "s3-publisher-topic" ;
    :shape :Task .

:Node8 a :Process, :Node ;
    :label "workflow-s3" ;
    :shape :Task .

:Edge12 a :Solid, :Edge ;
    :source :Node1 ;
    :target :Node2 ;
    :relationshipType :Follows .

:Edge23 a :Solid, :Edge ;
    :source :Node2 ;
    :target :Node3 ;
    :relationshipType :Follows .

:Edge34 a :Solid, :Edge ;
    :source :Node3 ;
    :target :Node4 ;
    :relationshipType :Follows .

:Edge45 a :Solid, :Edge ;
    :source :Node4 ;
    :target :Node5 ;
    :relationshipType :Follows .

:Edge56 a :Solid, :Edge ;
    :source :Node5 ;
    :target :Node6 ;
    :relationshipType :Follows .

:Edge67 a :Solid, :Edge ;
    :source :Node6 ;
    :target :Node7 ;
    :relationshipType :Branches .

:Edge68 a :Solid, :Edge ;
    :source :Node6 ;
    :target :Node8 ;
    :relationshipType :Branches .
