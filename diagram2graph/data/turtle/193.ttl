@prefix : <http://example.org/diagram2graph#> .

:Nodestart a :Start, :Node ;
    :label "Start" ;
    :shape :StartEvent .

:Noderound_1 a :Process, :Node ;
    :label "Round 1\nT = 1" ;
    :shape :Task .

:Nodedraw_lots a :Process, :Node ;
    :label "Draw lots to select witness nodes" ;
    :shape :Task .

:Nodebinarize_block a :Process, :Node ;
    :label "Binarize block" ;
    :shape :Task .

:Nodepacking_block a :Process, :Node ;
    :label "Packing block" ;
    :shape :Task .

:Nodeblock_verification a :Decision, :Node ;
    :label "Block verification" ;
    :shape :Gateway .

:Nodefinish a :Terminator, :Node ;
    :label "Finish" ;
    :shape :EndEvent .

:Nodetimeout_verification a :Decision, :Node ;
    :label "Timeout verification" ;
    :shape :Gateway .

:Nodenext_round_draw a :Process, :Node ;
    :label "Next round draw" ;
    :shape :Task .

:Nodeauthentication a :Process, :Node ;
    :label "Authentication" ;
    :shape :Task .

:Edgestartround_1 a :Solid, :Edge ;
    :source :Nodestart ;
    :target :Noderound_1 ;
    :relationshipType :Follows .

:Edgeround_1draw_lots a :Solid, :Edge ;
    :source :Noderound_1 ;
    :target :Nodedraw_lots ;
    :relationshipType :Follows .

:Edgedraw_lotsbinarize_block a :Solid, :Edge ;
    :source :Nodedraw_lots ;
    :target :Nodebinarize_block ;
    :relationshipType :Follows .

:Edgebinarize_blockpacking_block a :Solid, :Edge ;
    :source :Nodebinarize_block ;
    :target :Nodepacking_block ;
    :relationshipType :Follows .

:Edgepacking_blockblock_verification a :Solid, :Edge ;
    :source :Nodepacking_block ;
    :target :Nodeblock_verification ;
    :relationshipType :Follows .

:Edgeblock_verificationfinish a :Solid, :Edge ;
    :source :Nodeblock_verification ;
    :target :Nodefinish ;
    :relationshipType :DependsOn ;
    :relationshipValue "Success" .

:Edgeblock_verificationtimeout_verification a :Solid, :Edge ;
    :source :Nodeblock_verification ;
    :target :Nodetimeout_verification ;
    :relationshipType :DependsOn ;
    :relationshipValue "Verification failed" .

:Edgeauthenticationbinarize_block a :Solid, :Edge ;
    :source :Nodeauthentication ;
    :target :Nodebinarize_block ;
    :relationshipType :Follows .

:Edgetimeout_verificationnext_round_draw a :Solid, :Edge ;
    :source :Nodetimeout_verification ;
    :target :Nodenext_round_draw ;
    :relationshipType :DependsOn ;
    :relationshipValue "Timeout" .

:Edgenext_round_drawdraw_lots a :Solid, :Edge ;
    :source :Nodenext_round_draw ;
    :target :Nodedraw_lots ;
    :relationshipType :Follows .
