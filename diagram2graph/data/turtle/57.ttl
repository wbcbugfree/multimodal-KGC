@prefix : <http://example.org/diagram2graph#> .

:Node1 a :Start, :Node ;
    :label "Start" ;
    :shape :StartEvent .

:Node2 a :Process, :Node ;
    :label "Edit Video" ;
    :shape :Task .

:Node3 a :Decision, :Node ;
    :label "Short video" ;
    :shape :Gateway .

:Node4 a :Process, :Node ;
    :label "Click to upload" ;
    :shape :Task .

:Node5 a :Decision, :Node ;
    :label "VIP user?" ;
    :shape :Gateway .

:Node6 a :Process, :Node ;
    :label "Sign Up" ;
    :shape :Task .

:Node7 a :Process, :Node ;
    :label "Login" ;
    :shape :Task .

:Node8 a :Process, :Node ;
    :label "Browse to upload" ;
    :shape :Task .

:Node9 a :Terminator, :Node ;
    :label "Finish" ;
    :shape :EndEvent .

:Edge12 a :Solid, :Edge ;
    :source :Node1 ;
    :target :Node2 ;
    :relationshipType :Follows .

:Edge23 a :Solid, :Edge ;
    :source :Node2 ;
    :target :Node3 ;
    :relationshipType :Follows .

:Edge34 a :Solid, :Edge ;
    :source :Node3 ;
    :target :Node4 ;
    :relationshipType :Follows ;
    :relationshipValue "Yes" .

:Edge45 a :Solid, :Edge ;
    :source :Node4 ;
    :target :Node5 ;
    :relationshipType :Follows .

:Edge56 a :Solid, :Edge ;
    :source :Node5 ;
    :target :Node6 ;
    :relationshipType :Branches ;
    :relationshipValue "No" .

:Edge57 a :Solid, :Edge ;
    :source :Node5 ;
    :target :Node7 ;
    :relationshipType :Branches ;
    :relationshipValue "Yes" .

:Edge78 a :Solid, :Edge ;
    :source :Node7 ;
    :target :Node8 ;
    :relationshipType :Follows .

:Edge89 a :Solid, :Edge ;
    :source :Node8 ;
    :target :Node9 ;
    :relationshipType :Follows .
