@prefix : <http://example.org/diagram2graph#> .

:Node1 a :Start, :Node ;
    :label "Begin" ;
    :shape :StartEvent .

:Node2 a :Process, :Node ;
    :label "Run Main FLASH" ;
    :shape :Task .

:Node3 a :Decision, :Node ;
    :label "Is the Main FLASH Application OK?" ;
    :shape :Gateway .

:Node4 a :Process, :Node ;
    :label "Initialize IAP Interface" ;
    :shape :Task .

:Node5 a :Process, :Node ;
    :label "Main Application" ;
    :shape :Task .

:Node6 a :Decision, :Node ;
    :label "Is IAP Request Received?" ;
    :shape :Gateway .

:Node7 a :Process, :Node ;
    :label "Reprogram Main Application" ;
    :shape :Task .

:Node8 a :Terminator, :Node ;
    :label "RESET" ;
    :shape :EndEvent .

:Edge12 a :Solid, :Edge ;
    :source :Node1 ;
    :target :Node2 ;
    :relationshipType :Follows .

:Edge23 a :Solid, :Edge ;
    :source :Node2 ;
    :target :Node3 ;
    :relationshipType :Follows .

:Edge34 a :Solid, :Edge ;
    :source :Node3 ;
    :target :Node4 ;
    :relationshipType :Branches ;
    :relationshipValue "No" .

:Edge35 a :Solid, :Edge ;
    :source :Node3 ;
    :target :Node5 ;
    :relationshipType :Branches ;
    :relationshipValue "Yes" .

:Edge54 a :Solid, :Edge ;
    :source :Node5 ;
    :target :Node4 ;
    :relationshipType :Follows .

:Edge46 a :Solid, :Edge ;
    :source :Node4 ;
    :target :Node6 ;
    :relationshipType :Follows .

:Edge66 a :Solid, :Edge ;
    :source :Node6 ;
    :target :Node6 ;
    :relationshipType :Branches ;
    :relationshipValue "No" .

:Edge67 a :Solid, :Edge ;
    :source :Node6 ;
    :target :Node7 ;
    :relationshipType :Branches ;
    :relationshipValue "Yes" .

:Edge78 a :Solid, :Edge ;
    :source :Node7 ;
    :target :Node8 ;
    :relationshipType :Follows .
