@prefix : <http://example.org/diagram2graph#> .

:Node1 a :Start, :Node ;
    :label "New Budget" ;
    :shape :StartEvent .

:Node2 a :Process, :Node ;
    :label "Make an edit" ;
    :shape :Task .

:Node3 a :Decision, :Node ;
    :label "Was the article edited further?" ;
    :shape :Gateway .

:Node4 a :Decision, :Node ;
    :label "Do you agree with the change?" ;
    :shape :Gateway .

:Node5 a :Process, :Node ;
    :label "Discuss" ;
    :shape :Task .

:Node6 a :Process, :Node ;
    :label "Implement Budget" ;
    :shape :Task .

:Edge1 a :Solid, :Edge ;
    :source :Node1 ;
    :target :Node2 ;
    :relationshipType :Follows .

:Edge2 a :Solid, :Edge ;
    :source :Node2 ;
    :target :Node3 ;
    :relationshipType :Follows ;
    :relationshipValue "Wait" .

:Edge3 a :Solid, :Edge ;
    :source :Node3 ;
    :target :Node4 ;
    :relationshipType :Branches ;
    :relationshipValue "Yes" .

:Edge4 a :Solid, :Edge ;
    :source :Node3 ;
    :target :Node6 ;
    :relationshipType :Branches ;
    :relationshipValue "No" .

:Edge5 a :Solid, :Edge ;
    :source :Node4 ;
    :target :Node5 ;
    :relationshipType :Branches ;
    :relationshipValue "Disagree" .

:Edge6 a :Solid, :Edge ;
    :source :Node4 ;
    :target :Node6 ;
    :relationshipType :Branches ;
    :relationshipValue "Agree" .

:Edge7 a :Solid, :Edge ;
    :source :Node5 ;
    :target :Node2 ;
    :relationshipType :Follows ;
    :relationshipValue "Implement" .
