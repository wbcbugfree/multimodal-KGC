@prefix : <http://example.org/diagram2graph#> .

:Nodestart a :Start, :Node ;
    :label "Start" ;
    :shape :StartEvent .

:Nodeusername a :Process, :Node ;
    :label "Username" ;
    :shape :Task .

:Nodepassword a :Process, :Node ;
    :label "Password" ;
    :shape :Task .

:Nodecredentials_check a :Decision, :Node ;
    :label "Username && Password correspond to the ones in database?" ;
    :shape :Gateway .

:Nodeenter_id_password a :Process, :Node ;
    :label "Enter ID and password" ;
    :shape :Task .

:Nodeinvalid_credentials a :Process, :Node ;
    :label "\"Invalid credentials\"" ;
    :shape :Task .

:Nodeuser_blocked_check a :Decision, :Node ;
    :label "Is User_ID blocked?" ;
    :shape :Gateway .

:Nodeforbidden a :Process, :Node ;
    :label "\"403 Forbidden\"" ;
    :shape :Task .

:Nodelogin_successfully a :Process, :Node ;
    :label "Login successfully" ;
    :shape :Task .

:Nodeend a :Terminator, :Node ;
    :label "End" ;
    :shape :EndEvent .

:Edge1 a :Solid, :Edge ;
    :source :Nodestart ;
    :target :Nodeusername ;
    :relationshipType :Follows .

:Edge2 a :Solid, :Edge ;
    :source :Nodeusername ;
    :target :Nodepassword ;
    :relationshipType :Follows .

:Edge3 a :Solid, :Edge ;
    :source :Nodepassword ;
    :target :Nodecredentials_check ;
    :relationshipType :Follows .

:Edge4 a :Solid, :Edge ;
    :source :Nodecredentials_check ;
    :target :Nodeenter_id_password ;
    :relationshipType :DependsOn ;
    :relationshipValue "Yes" .

:Edge5 a :Solid, :Edge ;
    :source :Nodecredentials_check ;
    :target :Nodeinvalid_credentials ;
    :relationshipType :DependsOn ;
    :relationshipValue "No" .

:Edge6 a :Solid, :Edge ;
    :source :Nodeinvalid_credentials ;
    :target :Nodeusername ;
    :relationshipType :Follows .

:Edge7 a :Solid, :Edge ;
    :source :Nodeenter_id_password ;
    :target :Nodeuser_blocked_check ;
    :relationshipType :Follows .

:Edge8 a :Solid, :Edge ;
    :source :Nodeuser_blocked_check ;
    :target :Nodeforbidden ;
    :relationshipType :DependsOn ;
    :relationshipValue "Yes" .

:Edge9 a :Solid, :Edge ;
    :source :Nodeuser_blocked_check ;
    :target :Nodelogin_successfully ;
    :relationshipType :DependsOn ;
    :relationshipValue "No" .

:Edge10 a :Solid, :Edge ;
    :source :Nodeforbidden ;
    :target :Nodeusername ;
    :relationshipType :Follows .

:Edge11 a :Solid, :Edge ;
    :source :Nodelogin_successfully ;
    :target :Nodeend ;
    :relationshipType :Follows .
