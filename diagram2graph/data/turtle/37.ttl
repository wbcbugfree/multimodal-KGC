@prefix : <http://example.org/diagram2graph#> .

:Node1 a :Start, :Node ;
    :label "Start" ;
    :shape :StartEvent .

:Node2 a :Decision, :Node ;
    :label "If condition" ;
    :shape :Gateway .

:Node3 a :Decision, :Node ;
    :label "Nested if condition" ;
    :shape :Gateway .

:Node4 a :Process, :Node ;
    :label "If Body" ;
    :shape :Task .

:Node5 a :Process, :Node ;
    :label "Nested if Body" ;
    :shape :Task .

:Node6 a :Process, :Node ;
    :label "Pass" ;
    :shape :Task .

:Node7 a :Process, :Node ;
    :label "Statement just below if" ;
    :shape :Task .

:Node8 a :Terminator, :Node ;
    :label "Exit" ;
    :shape :EndEvent .

:Edge12 a :Solid, :Edge ;
    :source :Node1 ;
    :target :Node2 ;
    :relationshipType :Follows .

:Edge23 a :Solid, :Edge ;
    :source :Node2 ;
    :target :Node3 ;
    :relationshipType :Branches ;
    :relationshipValue "False" .

:Edge24 a :Solid, :Edge ;
    :source :Node2 ;
    :target :Node4 ;
    :relationshipType :Branches ;
    :relationshipValue "True" .

:Edge36 a :Solid, :Edge ;
    :source :Node3 ;
    :target :Node6 ;
    :relationshipType :Branches ;
    :relationshipValue "False" .

:Edge35 a :Solid, :Edge ;
    :source :Node3 ;
    :target :Node5 ;
    :relationshipType :Branches ;
    :relationshipValue "True" .

:Edge47 a :Solid, :Edge ;
    :source :Node4 ;
    :target :Node7 ;
    :relationshipType :Follows .

:Edge57 a :Solid, :Edge ;
    :source :Node5 ;
    :target :Node7 ;
    :relationshipType :Follows .

:Edge67 a :Solid, :Edge ;
    :source :Node6 ;
    :target :Node7 ;
    :relationshipType :Follows .

:Edge78 a :Solid, :Edge ;
    :source :Node7 ;
    :target :Node8 ;
    :relationshipType :Follows .
