@prefix : <http://example.org/diagram2graph#> .

:Node1 a :Start, :Node ;
    :label "Lamp doesn't work" ;
    :shape :StartEvent .

:Node2 a :Decision, :Node ;
    :label "Lamp plugged in?" ;
    :shape :Gateway .

:Node3 a :Process, :Node ;
    :label "Plug in lamp" ;
    :shape :Task .

:Node4 a :Decision, :Node ;
    :label "Lamp plugged in?" ;
    :shape :Gateway .

:Node5 a :Process, :Node ;
    :label "Replace bulb" ;
    :shape :Task .

:Node6 a :Process, :Node ;
    :label "PRINT K" ;
    :shape :Task .

:Edge12 a :Solid, :Edge ;
    :source :Node1 ;
    :target :Node2 ;
    :relationshipType :Follows .

:Edge23 a :Solid, :Edge ;
    :source :Node2 ;
    :target :Node3 ;
    :relationshipType :Branches ;
    :relationshipValue "No" .

:Edge24 a :Solid, :Edge ;
    :source :Node2 ;
    :target :Node4 ;
    :relationshipType :Branches ;
    :relationshipValue "Yes" .

:Edge45 a :Solid, :Edge ;
    :source :Node4 ;
    :target :Node5 ;
    :relationshipType :Branches ;
    :relationshipValue "Yes" .

:Edge46 a :Solid, :Edge ;
    :source :Node4 ;
    :target :Node6 ;
    :relationshipType :Branches ;
    :relationshipValue "No" .
