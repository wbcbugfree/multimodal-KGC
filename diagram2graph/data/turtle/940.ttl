@prefix : <http://example.org/diagram2graph#> .

:Node0 a :Start, :Node ;
    :label "Begin" ;
    :shape :StartEvent .

:Node1 a :Process, :Node ;
    :label "Enter to the website" ;
    :shape :Task .

:Node2 a :Decision, :Node ;
    :label "have an account?" ;
    :shape :Gateway .

:Node3 a :Process, :Node ;
    :label "Sign up" ;
    :shape :Task .

:Node4 a :Process, :Node ;
    :label "Fill details" ;
    :shape :Task .

:Node5 a :Process, :Node ;
    :label "Submit" ;
    :shape :Task .

:Node6 a :Process, :Node ;
    :label "Login" ;
    :shape :Task .

:Node7 a :Process, :Node ;
    :label "Enter e-mail and password" ;
    :shape :Task .

:Node8 a :Decision, :Node ;
    :label "e-mail and password valid?" ;
    :shape :Gateway .

:Node9 a :Process, :Node ;
    :label "Profile" ;
    :shape :Task .

:Node10 a :Terminator, :Node ;
    :label "end" ;
    :shape :EndEvent .

:Edge01 a :Solid, :Edge ;
    :source :Node0 ;
    :target :Node1 ;
    :relationshipType :Follows .

:Edge12 a :Solid, :Edge ;
    :source :Node1 ;
    :target :Node2 ;
    :relationshipType :Follows .

:Edge23 a :Solid, :Edge ;
    :source :Node2 ;
    :target :Node3 ;
    :relationshipType :Branches ;
    :relationshipValue "No" .

:Edge26 a :Solid, :Edge ;
    :source :Node2 ;
    :target :Node6 ;
    :relationshipType :Branches ;
    :relationshipValue "Yes" .

:Edge34 a :Solid, :Edge ;
    :source :Node3 ;
    :target :Node4 ;
    :relationshipType :Follows .

:Edge45 a :Solid, :Edge ;
    :source :Node4 ;
    :target :Node5 ;
    :relationshipType :Follows .

:Edge56 a :Solid, :Edge ;
    :source :Node5 ;
    :target :Node6 ;
    :relationshipType :Follows .

:Edge67 a :Solid, :Edge ;
    :source :Node6 ;
    :target :Node7 ;
    :relationshipType :Follows .

:Edge78 a :Solid, :Edge ;
    :source :Node7 ;
    :target :Node8 ;
    :relationshipType :Follows .

:Edge86 a :Solid, :Edge ;
    :source :Node8 ;
    :target :Node6 ;
    :relationshipType :Branches ;
    :relationshipValue "no" .

:Edge89 a :Solid, :Edge ;
    :source :Node8 ;
    :target :Node9 ;
    :relationshipType :Branches ;
    :relationshipValue "yes" .

:Edge910 a :Solid, :Edge ;
    :source :Node9 ;
    :target :Node10 ;
    :relationshipType :Follows .
