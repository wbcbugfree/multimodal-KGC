@prefix : <http://example.org/diagram2graph#> .

:Node1 a :Start, :Node ;
    :label "1" ;
    :shape :StartEvent .

:Node2 a :Terminator, :Node ;
    :label "2" ;
    :shape :EndEvent .

:Node3 a :Process, :Node ;
    :label "Costumer Order" ;
    :shape :Task .

:Node4 a :Process, :Node ;
    :label "Sales Order" ;
    :shape :Task .

:Node5 a :Decision, :Node ;
    :label "Documentation" ;
    :shape :Gateway .

:Node6 a :Process, :Node ;
    :label "Prepare DO" ;
    :shape :Task .

:Node7 a :Process, :Node ;
    :label "Shipment" ;
    :shape :Task .

:Node8 a :Process, :Node ;
    :label "Goods Delivered" ;
    :shape :Task .

:Edge1 a :Solid, :Edge ;
    :source :Node1 ;
    :target :Node3 ;
    :relationshipType :Follows .

:Edge2 a :Solid, :Edge ;
    :source :Node3 ;
    :target :Node4 ;
    :relationshipType :Follows .

:Edge3 a :Solid, :Edge ;
    :source :Node4 ;
    :target :Node5 ;
    :relationshipType :Follows .

:Edge4 a :Solid, :Edge ;
    :source :Node5 ;
    :target :Node4 ;
    :relationshipType :Branches ;
    :relationshipValue "No" .

:Edge5 a :Solid, :Edge ;
    :source :Node5 ;
    :target :Node6 ;
    :relationshipType :Branches ;
    :relationshipValue "Yes" .

:Edge6 a :Solid, :Edge ;
    :source :Node6 ;
    :target :Node7 ;
    :relationshipType :Follows .

:Edge7 a :Solid, :Edge ;
    :source :Node7 ;
    :target :Node8 ;
    :relationshipType :Follows .

:Edge8 a :Solid, :Edge ;
    :source :Node8 ;
    :target :Node2 ;
    :relationshipType :Follows .
