@prefix : <http://example.org/diagram2graph#> .

:Node1 a :Start, :Node ;
    :label "Begin" ;
    :shape :StartEvent .

:Node2 a :Process, :Node ;
    :label "Initialize variables" ;
    :shape :Task .

:Node3 a :Process, :Node ;
    :label "INPUT numbers" ;
    :shape :Task .

:Node4 a :Decision, :Node ;
    :label "All numbers been entered?" ;
    :shape :Gateway .

:Node5 a :Process, :Node ;
    :label "Average=total/numbers" ;
    :shape :Task .

:Node6 a :Process, :Node ;
    :label "Print Output" ;
    :shape :Task .

:Node7 a :Terminator, :Node ;
    :label "Stop" ;
    :shape :EndEvent .

:Node8 a :Process, :Node ;
    :label "INPUT latest" ;
    :shape :Task .

:Node9 a :Process, :Node ;
    :label "total=total+latest" ;
    :shape :Task .

:Edge1 a :Solid, :Edge ;
    :source :Node1 ;
    :target :Node2 ;
    :relationshipType :Follows .

:Edge2 a :Solid, :Edge ;
    :source :Node2 ;
    :target :Node3 ;
    :relationshipType :Follows .

:Edge3 a :Solid, :Edge ;
    :source :Node3 ;
    :target :Node4 ;
    :relationshipType :Follows .

:Edge4 a :Solid, :Edge ;
    :source :Node4 ;
    :target :Node5 ;
    :relationshipType :Branches ;
    :relationshipValue "Yes" .

:Edge5 a :Solid, :Edge ;
    :source :Node5 ;
    :target :Node6 ;
    :relationshipType :Follows .

:Edge6 a :Solid, :Edge ;
    :source :Node6 ;
    :target :Node7 ;
    :relationshipType :Follows .

:Edge7 a :Solid, :Edge ;
    :source :Node4 ;
    :target :Node8 ;
    :relationshipType :Branches ;
    :relationshipValue "No" .

:Edge8 a :Solid, :Edge ;
    :source :Node8 ;
    :target :Node9 ;
    :relationshipType :Follows .

:Edge9 a :Solid, :Edge ;
    :source :Node9 ;
    :target :Node4 ;
    :relationshipType :Follows .
