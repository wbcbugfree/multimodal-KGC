@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart8221 a schema:AreaChart ;
    schema:title "Honduras : Age structure from 2009 to 2019" ;
    :hasXAxisLabel "Year" ;
    :hasYAxisLabel "15-64 years" ;
    :yMin "0.0"^^xsd:decimal ;
    :yMax "0.6"^^xsd:decimal .

:DataPoint8221_1 :belongsToChart :Chart8221 ;
