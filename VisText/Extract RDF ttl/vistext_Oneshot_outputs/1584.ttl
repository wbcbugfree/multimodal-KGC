@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart1584 a schema:LineChart ;
    schema:title "Joe Gibbs Racing team (NASCAR) revenue from 2006 to 2017 (in million U.S. dollars)" ;
    :hasXAxisLabel "Year" ;
    :hasYAxisLabel "Revenue in million U.S. dollars" ;
    :yMin "0"^^xsd:decimal ;
    :yMax "150"^^xsd:decimal .

:DataPoint1584_1 a :DataPoint ;
    :belongsToChart :Chart1584 ;
    rdfs:label "2006" ;
    :xValue "2006" ;
    :yValue "110"^^xsd:decimal ;
    :valueEstimated "true" .

