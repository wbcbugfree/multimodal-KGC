@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart3255 a schema:BarChart ;
    schema:title "Number of births in Ontario , Canada from 2001 to 2020" ;
    :hasXAxisLabel "Number of births" ;
    :hasYAxisLabel "Year" .

