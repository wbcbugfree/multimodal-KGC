@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart2485 a schema:LineChart ;
    schema:title "Number of Abercrombie & Fitch stores worldwide from 1998 to 2019" ;
    :hasXAxisLabel "Year" ;
    :hasYAxisLabel "Number of stores" ;
    :xMin "1998" ;
    :xMax "2019" ;
    :yMin "0"^^xsd:decimal ;
    :yMax "400"^^xsd:decimal .

:DataPoint2485_1 a schema:DataPoint ;
    :belongsToChart :Chart2485 ;
    rdfs:label "1998" ;
    :xValue "1998" ;
    :yValue "175.0"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .

