@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart7163 a schema:BarChart ;
    schema:title "Proportion of young people reading various media outside of class in the United Kingdom (UK) from 2014 to 2019" ;
    :hasXAxisLabel "media read by young people" ;
    :hasYAxisLabel "2017/18" .

:DataPoint7163_1 a :DataPoint ;
    rdfs:label "Comics" ;
    :xValue "Comics" ;
    :yValue "0.4"^^xsd:decimal ;
    :valueEstimated "true" ;
    :belongsToChart :Chart7163 .

