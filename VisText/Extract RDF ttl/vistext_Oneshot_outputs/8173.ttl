:Chart8173 a schema:LineChart ;
    schema:title "Breakdown of NASA 's budget and how it was distributed from 2010 to 2020 (in million U.S dollars)" ;
    :hasXAxisLabel "Year" ;
    :hasYAxisLabel "Inspector General" ;
    :yMin "0"^^xsd:decimal ;
    :yMax "40"^^xsd:decimal .

