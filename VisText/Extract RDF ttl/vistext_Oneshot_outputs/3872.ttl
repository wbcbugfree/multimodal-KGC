@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart3872 a schema:BarChart ;
    schema:title "Number of deaths from unintentional carbon monoxide poisoning in the United Kingdom (UK) from 1995 to 2019 , by age" ;
    :hasXAxisLabel "Age in years" ;
    :hasYAxisLabel "Number of deaths" ;
    :yMin "0"^^xsd:decimal ;
    :yMax "120"^^xsd:decimal .

