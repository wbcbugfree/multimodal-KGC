@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart7592 a schema:LineChart ;
    schema:title "Domestic and foreign revenue of the German analysis , bio , and laboratory technologies industry from 2010 to 2019 (in billion euros)" ;
    :hasXAxisLabel "Year" ;
    :hasYAxisLabel "Foreign revenue" ;
    :yMin "0"^^xsd:decimal ;
    :yMax "5"^^xsd:decimal .

:DataPoint7592_1 a schema:DataPoint ;
    rdfs:label "2010" ;
    :xValue "2010" ;
    :yValue "3.3"^^xsd:decimal ;
    :valueEstimated "true" ;
    :belongsToChart :Chart7592 .

