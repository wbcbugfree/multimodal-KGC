@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart4843 a schema:LineChart ;
    schema:title "Average consumer spending on Super Bowl Sunday in the United States from 2011 to 2020 (in U.S. dollars)" ;
    :hasXAxisLabel "Year" ;
    :hasYAxisLabel "Planned spending in U.S. dollars" ;
    :yMin "0"^^xsd:decimal ;
    :yMax "100"^^xsd:decimal .

:DataPoint4843_1 a :DataPoint ;
    :belongsToChart :Chart4843 ;
    rdfs:label "2011" ;
    :xValue "2011" ;
    :yValue "72.0"^^xsd:decimal ;
    :valueEstimated "true" .

