@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart5023 a schema:BarChart ;
    schema:title "Sponsorship worth of professional tennis players worldwide as of July 2019 (in million U.S. dollars)" ;
    :hasXAxisLabel "Sponsorship worth in million U.S. dollars" ;
    :hasYAxisLabel "player" ;
    :xMin "0"^^xsd:decimal ;
    :xMax "90"^^xsd:decimal .

