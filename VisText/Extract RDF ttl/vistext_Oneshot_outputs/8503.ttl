@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart8503 a schema:CreativeWork ;
    schema:title "Total number of births , deaths and birth excess in the Netherlands from 2008 to 2018" ;
    :hasXAxisLabel "Year" ;
    :hasYAxisLabel "Deaths" ;
    :yMin "0"^^xsd:decimal ;
    :yMax "150000"^^xsd:decimal .

:DataPoint8503_1 :belongsToChart :Chart8503 ;
    rdfs:label "2008" ;
    :xValue "2008" ;
    :yValue "140000"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .

