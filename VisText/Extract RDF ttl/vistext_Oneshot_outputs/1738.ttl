@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart1738 a schema:BarChart ;
    schema:title "Average ticket price New York Islanders games (NHL) from 2005/06 to 2014/15 (in U.S. dollars)" ;
    :hasXAxisLabel "Average ticket price in U.S. dollars" ;
    :hasYAxisLabel "Year" ;
    :yMin "2005/06" ;
    :yMax "2014/15" .

