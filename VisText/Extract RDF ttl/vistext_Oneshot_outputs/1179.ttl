@prefix schema:<https://schema.org/> .

:Chart1179 a schema:BarChart ;
    schema:title "Consumption volume of cement in India from financial year 2009 to 2018 with an estimate for financial year 2019 (in million metric tons)" ;
    :hasXAxisLabel "Consumption in million metric tons" ;
    :hasYAxisLabel "Financial year" .

