@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart7543 a schema:LineChart ;
    schema:title "Number of Facebook fans/twitter followers of the New Orleans Saints (NFL) from 2012 to 2020 (in millions)" ;
    :hasXAxisLabel "Month" ;
    :hasYAxisLabel "Facebook fans" ;
    :xMin "2014" ;
    :xMax "2020" ;
    :yMin "0"^^xsd:decimal ;
    :yMax "4.5"^^xsd:decimal .

:DataPoint7543_1 a schema:DataPoint ;
    rdfs:label "2014" ;
    :xValue "2014" ;
    :yValue "2.9"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean ;
    :belongsToChart :Chart7543 .

:DataPoint7543_2 a schema:DataPoint ;
    rdfs:label "2015" ;
    :xValue "2015" ;
    :yValue "3.5"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean ;
    :belongsToChart :Chart7543 .

:DataPoint7543_3 a schema:DataPoint ;
    rdfs:label "2016" ;
    :xValue "2016" ;
    :yValue "4.1"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean ;
    :belongsToChart :Chart7543 .

:DataPoint7543_4 a schema:DataPoint ;
    rdfs:label "2017" ;
    :xValue "2017" ;
    :yValue "4.2"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean ;
    :belongsToChart :Chart7543 .

:DataPoint7543_5 a schema:DataPoint ;
    rdfs:label "2018" ;
    :xValue "2018" ;
    :yValue "4.2"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean ;
    :belongsToChart :Chart7543 .

:DataPoint7543_6 a schema:DataPoint ;
    rdfs:label "2019" ;
    :xValue "2019" ;
    :yValue "4.1"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean ;
    :belongsToChart :Chart7543 .

:DataPoint7543_7 a schema:DataPoint ;
    rdfs:label "2020" ;
    :xValue "2020" ;
    :yValue "4.1"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean ;
    :belongsToChart :Chart7543 .
