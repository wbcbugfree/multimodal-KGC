@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart6415 a schema:BarChart ;
    schema:title "Why do n't you use / what is the main reason you do n't use local bus services (more often) ?" ;
    :hasXAxisLabel "Main reason" ;
    :hasYAxisLabel "Response" .

:DataPoint6415_1 a :DataPoint ;
    rdfs:label "Bus fares are too high" ;
    :xValue "Bus fares are too high" ;
    :yValue "0.03"^^xsd:decimal ;
    :valueEstimated "true" ;
    :belongsToChart :Chart6415 .

