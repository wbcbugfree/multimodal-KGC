@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart1046 a schema:BarChart ;
    schema:title "Main import partners of Sweden in 2019 , by import value (in million SEK)" ;
    :hasXAxisLabel "Country" ;
    :hasYAxisLabel "Import value million SEK" ;
    :yMin "0"^^xsd:decimal ;
    :yMax "250000"^^xsd:decimal .

