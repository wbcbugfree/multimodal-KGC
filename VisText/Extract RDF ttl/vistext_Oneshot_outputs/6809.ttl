@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart6809 a schema:AreaChart ;
    schema:title "Cuba : Age structure from 2009 to 2019" ;
    :hasXAxisLabel "Year" ;
    :hasYAxisLabel "0-14 years" ;
    :xMin "2009"^^xsd:decimal ;
    :xMax "2019"^^xsd:decimal ;
    :yMin "0.0"^^xsd:decimal ;
    :yMax "0.18"^^xsd:decimal .

:DataPoint6809_1 a :Datapoint ;
    :belongsToChart :Chart6809 ;
    rdfs:label "2009" ;
    :xValue "2009" ;
    :yValue "0.17"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .

