@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart4781 a schema:BarChart ;
    schema:title "Consumption of tree nuts worldwide in 2018 , by type (in 1,000 metric tons)" ;
    :hasXAxisLabel "Consumption in thousand metric tons" ;
    :hasYAxisLabel "type of nut" .

:DataPoint4781_1 a schema:DataPoint ;
    rdfs:label "Almond" ;
    :xValue "Almond" ;
    :yValue 1000.0^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean ;
    :belongsToChart :Chart4781 .

:DataPoint4781_2 a schema:DataPoint ;
    rdfs:label "Brazil Nut" ;
    :xValue "Brazil Nut" ;
    :yValue 500.0^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean ;
    :belongsToChart :Chart4781 .

