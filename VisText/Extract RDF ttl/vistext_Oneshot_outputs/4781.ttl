    :xValue "Pine Nut" ;
    :yValue 500.0^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean ;
    :belongsToChart :Chart4781 .

:DataPoint4781_9 a schema:DataPoint ;
    rdfs:label "Pistachio" ;
