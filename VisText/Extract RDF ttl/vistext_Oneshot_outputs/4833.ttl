@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart4833 a schema:LineChart ;
    schema:title "Annual revenue of Yandex from 2007 to 2019 (in billion Russian rubles)" ;
    :hasXAxisLabel "Year" ;
    :hasYAxisLabel "Revenue in billion Russian rubles" ;
    :xMin "2007"^^xsd:string ;
    :xMax "2019"^^xsd:string ;
    :yMin "0"^^xsd:decimal ;
    :yMax "180"^^xsd:decimal .

:DataPoint4833_1 a schema:DataPoint ;
    :belongsToChart :Chart4833 ;
    rdfs:label "2007" ;
    :xValue "2007" ;
    :yValue "5"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .

