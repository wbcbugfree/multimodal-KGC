@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart8349 a schema:LineChart ;
    schema:title "Number of deaths in Belgium from 2006 to 2016 , by cause of death" ;
    :hasXAxisLabel "Year" ;
    :hasYAxisLabel "Death by natural causes" ;
    :xMin "2006" ;
    :xMax "2016" ;
    :yMin "0"^^xsd:decimal ;
    :yMax "100000"^^xsd:decimal .

:DataPoint8349_1 a :DataPoint ;
    :belongsToChart :Chart8349 ;
    rdfs:label "2006" ;
    :xValue "2006" ;
    :yValue "94000"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .

