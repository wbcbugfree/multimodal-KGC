@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart7706 a schema:BarChart ;
    schema:title "How do you think each of the following US Presidents will go down in history ?" ;
    :hasXAxisLabel "Outstanding / above average" ;
    :hasYAxisLabel "" .

