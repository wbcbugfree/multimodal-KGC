@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart64 a schema:LineChart ;
    :hasXAxisLabel "Year" ;
    :hasYAxisLabel "Price in U.S. dollars per metric ton" ;
    :yMin "0"^^xsd:decimal ;
    :yMax "250000"^^xsd:decimal .

:DataPoint64_1 a schema:DataPoint ;
    rdfs:label "2010" ;
    :xValue "2010" ;
    :yValue "20000"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean ;
    :belongsToChart :Chart64 .

:DataPoint64_2 a schema:DataPoint ;
    rdfs:label "2012" ;
    :xValue "2012" ;
    :yValue "250000"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean ;
    :belongsToChart :Chart64 .

:DataPoint64_3 a schema:DataPoint ;
    rdfs:label "2015" ;
    :xValue "2015" ;
    :yValue "50000"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean ;
    :belongsToChart :Chart64 .

:DataPoint64_4 a schema:DataPoint ;
    rdfs:label "2017" ;
    :xValue "2017" ;
    :yValue "70000"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean ;
    :belongsToChart :Chart64 .

:DataPoint64_5 a schema:DataPoint ;
    rdfs:label "2018" ;
    :xValue "2018" ;
    :yValue "60000"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean ;
    :belongsToChart :Chart64 .

:DataPoint64_6 a schema:DataPoint ;
    rdfs:label "2019" ;
    :xValue "2019" ;
    :yValue "65000"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean ;
    :belongsToChart :Chart64 .

:DataPoint64_7 a schema:DataPoint ;
    rdfs:label "2020" ;
    :xValue "2020" ;
    :yValue "75000"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean ;
    :belongsToChart :Chart64 .

:DataPoint64_8 a schema:DataPoint ;
    rdfs:label "2021" ;
    :xValue "2021" ;
    :yValue "90000"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean ;
    :belongsToChart :Chart64 .
