@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <https://schema.org/> .

:Chart8547 a schema:BarChart ;
    schema:title "Merger and acquisitions (M & A) transaction volume in the United Kingdom (UK) in 2018 and 2019 , by city or region" ;
    :hasXAxisLabel "city or region of United Kingdom" ;
    :hasYAxisLabel "2018" .

:DataPoint8547_1 a schema:DataPoint ;
    rdfs:label "East of England" ;
    :xValue "East of England" ;
    :yValue "470.0"^^xsd:decimal ;
    :valueEstimated "true" ;
    :belongsToChart :Chart8547 .

