@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart3886 a schema:LineChart ;
    schema:title "Electricity export volume from the United States between 1999 and 2019 (in gigawatt hours)" ;
    :hasXAxisLabel "Year" ;
    :hasYAxisLabel "Exports in thousand gigawatt hours" .

:DataPoint3886_1 a schema:DataPoint ;
    :belongsToChart :Chart3886 ;
    rdfs:label "1999" ;
    :xValue "1999" ;
    :yValue "14500.0"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .

