@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart4049 a schema:BarChart ;
    schema:title "Leading U.S. states based on value of barley production in 2018 (in 1,000 U.S. dollars)" ;
    :hasXAxisLabel "Production value in thousand U.S. dollars" ;
    :hasYAxisLabel "State" .

:DataPoint4049_1 a schema:DataPoint ;
    rdfs:label "Arizona" ;
    :xValue "Arizona" ;
    :yValue 5.0 ;
    :valueEstimated "true"^^xsd:boolean ;
    :belongsToChart :Chart4049 .

