@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart7039 a schema:BarChart ;
    schema:title "Which , if any , of the following measures do you think the British Government should take to contain the Coronavirus (COVID-19) ?" ;
    :hasXAxisLabel "Apr 16 to Apr 17" ;
    :hasYAxisLabel "Response" .

:DataPoint7039_1 a schema:DataPoint ;
    :belongsToChart :Chart7039 ;
    rdfs:label "Cancel large sporting events, conc..." ;
    :xValue "Cancel large sporting events, conc..." ;
    :yValue "0.82"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .

