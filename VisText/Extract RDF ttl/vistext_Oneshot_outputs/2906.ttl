@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart2906 a schema:BarChart ;
    schema:title "Number of VAT and/or PAYE based enterprises in the United Kingdom (UK) in 2020 , by turnover size band (in 1,000s)" ;
    :hasXAxisLabel "Year" ;
    :hasYAxisLabel "Number of enterprises in thousand" .

:DataPoint2906_1 :belongsToChart :Chart2906 ;
    rdfs:label "0 - 49,999 GBP" ;
    :xValue "0 - 49,999 GBP" ;
    :yValue "420.0"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .

:DataPoint2906_2 :belongsToChart :Chart2906 ;
    rdfs:label "1 billion - 4.999 billion GBP" ;
    :xValue "1 billion - 4.999 billion GBP" ;
    :yValue "20.0"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .

