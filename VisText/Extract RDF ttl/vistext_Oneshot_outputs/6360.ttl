@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart6360 a schema:LineChart ;
    schema:title "Monthly number of passenger visitors at Sydney Airport compared with the previous year in Australia from February to October 2020 , by passenger type (in 1,000s)" ;
    :hasXAxisLabel "Month" ;
    :hasYAxisLabel "Domestic" ;
    :yMin "0"^^xsd:decimal ;
    :yMax "2500"^^xsd:decimal .

:DataPoint6360_1 :belongsToChart :Chart6360 ;
    rdfs:label "February" ;
    :xValue "February" ;
    :yValue "2200"^^xsd:decimal ;
    :valueEstimated "true" .

