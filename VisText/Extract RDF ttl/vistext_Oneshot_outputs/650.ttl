@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart650 a schema:BarChart ;
    schema:title "Which group do you think is the greatest boy band of all time ?" ;
    :hasXAxisLabel "Response" ;
    :hasYAxisLabel "Share of respondents" ;
    :yMin "0.00"^^xsd:decimal ;
    :yMax "0.20"^^xsd:decimal .

