@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart1241 a schema:LineChart ;
    schema:title "Total amount of investment of private equity firms in Bulgaria from 2007 to 2016 (in million euros)" ;
    :hasXAxisLabel "Year" ;
    :hasYAxisLabel "Total investment in million euros" .

:DataPoint1241_1 :belongsToChart :Chart1241 ;
    rdfs:label "2007" ;
    :xValue "2007" ;
    :yValue "8.0"^^xsd:decimal ;
    :valueEstimated "true" .

