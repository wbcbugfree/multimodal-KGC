@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart382 a schema:BarChart ;
    schema:title "Number of monthly active Instagram users from January 2013 to June 2018 (in millions)" ;
    :hasXAxisLabel "Number of users in millions" ;
    :hasYAxisLabel "Month" ;
    :yMin "0"^^xsd:decimal ;
    :yMax "1000"^^xsd:decimal .

:DataPoint382_1 a :DataPoint ;
    :belongsToChart :Chart382 ;
    rdfs:label "Apr '17" ;
    :xValue "600"^^xsd:decimal ;
    :yValue "600"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .

