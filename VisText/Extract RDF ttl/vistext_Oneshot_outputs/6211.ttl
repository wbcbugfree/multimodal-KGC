@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart6211 a schema:BarChart ;
    schema:title "Growth in weekly sales of FMCG products due to coronavirus (COVID-19) outbreak in Poland between January and March 2020 , by type of products" ;
    :hasXAxisLabel "type of FMCG products" ;
    :hasYAxisLabel "Toilet paper" ;
    :yMin "-0.1"^^xsd:decimal ;
    :yMax "0.6"^^xsd:decimal .

:DataPoint6211_1 a schema:DataPoint ;
    rdfs:label "W01" ;
    :xValue "W01" ;
    :yValue "0.13"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean ;
    :belongsToChart :Chart6211 .

