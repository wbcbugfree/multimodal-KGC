@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart2534 a schema:BarChart ;
    schema:title "Generation of non-hydro renewable energy in the U.S. from 2007 to 2019 (in terawatt hours)" ;
    :hasXAxisLabel "Year" ;
    :hasYAxisLabel "Generation in terawatt hours" .

:DataPoint2534_1 :belongsToChart :Chart2534 ;
