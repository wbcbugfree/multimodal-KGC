    :belongsToChart :Chart5901 ;
    rdfs:label "2010" ;
    :xValue "2010" ;
    :yValue 0.0062 ;
    :valueEstimated "true"^^xsd:boolean .

:DataPoint5901_5 a schema:DataPoint ;
    :belongsToChart :Chart5901 ;
    rdfs:label "2012" ;
    :xValue "2012" ;
    :yValue 0.0080 ;
    :valueEstimated "true"^^xsd:boolean .

:DataPoint5901_6 a schema:DataPoint ;
    :belongsToChart :Chart5901 ;
