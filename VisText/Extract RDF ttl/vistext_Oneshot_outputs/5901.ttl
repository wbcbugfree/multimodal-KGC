@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart5901 a schema:LineChart ;
    schema:title "Value added of U.S. motor vehicle and parts manufacturing as a percentage of GDP between 2005 and 2017" ;
    :hasXAxisLabel "Year" ;
    :hasYAxisLabel "Value added as a percentage of GDP" .

:DataPoint5901_1 a schema:DataPoint ;
    :belongsToChart :Chart5901 ;
    rdfs:label "2005" ;
    :xValue "2005" ;
    :yValue 0.010 ;
    :valueEstimated "true"^^xsd:boolean .

:DataPoint5901_2 a schema:DataPoint ;
    :belongsToChart :Chart5901 ;
    rdfs:label "2006" ;
    :xValue "2006" ;
    :yValue 0.0097 ;
    :valueEstimated "true"^^xsd:boolean .

