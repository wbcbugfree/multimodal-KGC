@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart81 a schema:BarChart ;
    schema:title "Rakuten Ichiba 's sales from 1st quarter 2013 to 2nd quarter 2015 (in billion yen)" ;
    :hasXAxisLabel "Value in billion yen" ;
    :hasYAxisLabel "Quarter" .

:DataPoint81_1 a :DataPoint ;
    rdfs:label "Q1 '13" ;
    :xValue "Q1 '13" ;
    :yValue "25.0"^^xsd:decimal ;
    :valueEstimated "true" ;
    :belongsToChart :Chart81 .

