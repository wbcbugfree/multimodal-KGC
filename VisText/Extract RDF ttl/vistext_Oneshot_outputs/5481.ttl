@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart5481 a schema:BarChart ;
    schema:title "Oldest living Academy Award winners as of July 2020" ;
    :hasXAxisLabel "Academy Award winners" ;
    :hasYAxisLabel "Age" ;
    :yMin "0"^^xsd:decimal ;
    :yMax "100"^^xsd:decimal .

