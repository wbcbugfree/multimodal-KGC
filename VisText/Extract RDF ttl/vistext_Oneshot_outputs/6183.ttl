@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart6183 a schema:LineChart ;
    schema:title "Net revenue of Polo Ralph Lauren from FY2007 to FY2019 , by region (in million U.S. dollars)" ;
    :hasXAxisLabel "Region" ;
    :hasYAxisLabel "Asia*" ;
    :xMin "2007" ;
    :xMax "2019" ;
    :yMin "0" ;
    :yMax "1000" .

:DataPoint6183_1 a schema:DataPoint ;
    :belongsToChart :Chart6183 ;
    rdfs:label "2007" ;
    :xValue "2007" ;
    :yValue "50"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .

