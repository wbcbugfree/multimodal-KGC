:Chart7053 a schema:BarChart ;
    schema:title "Have you deliberately purchased any of these products or services online instead of offline because of the COVID-19 / coronavirus pandemic ? (as of May 31 , 2020)" ;
    :hasXAxisLabel "Response" ;
