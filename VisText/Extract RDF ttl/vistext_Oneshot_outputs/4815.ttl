@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart4815 a schema:LineChart ;
    schema:title "Migration balance (immigrants minus emigrants) in Belgium from 2010 to 2019" ;
    :hasXAxisLabel "Year" ;
    :hasYAxisLabel "Migration balance" ;
    :yMin "0"^^xsd:decimal ;
    :yMax "90000"^^xsd:decimal .

:DataPoint4815_1 a :Datapoint ;
    :belongsToChart :Chart4815 ;
    rdfs:label "2010" ;
    :xValue "2010" ;
    :yValue "85000"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .

