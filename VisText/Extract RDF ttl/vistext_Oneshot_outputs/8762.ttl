@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart8762 a schema:LineChart ;
    schema:title "Number of employees at The Cheesecake Factory from 2009 to 2019 , by segment" ;
    :hasXAxisLabel "Year" ;
    :hasYAxisLabel "Restaurant workers" ;
    :xMin "2009"^^xsd:string ;
    :xMax "2019"^^xsd:string ;
    :yMin "0"^^xsd:decimal ;
    :yMax "40000"^^xsd:decimal .

:DataPoint8762_1 a schema:DataPoint ;
    :belongsToChart :Chart8762 ;
    rdfs:label "2009" ;
    :xValue "2009" ;
    :yValue "32000"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .

