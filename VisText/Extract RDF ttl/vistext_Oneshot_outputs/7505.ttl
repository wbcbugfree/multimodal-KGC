@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart7505 a schema:BarChart ;
    schema:title "Confirmed cases and deaths of major virus outbreaks worldwide in the last 50 years as of 2020" ;
    :hasXAxisLabel "Virus (year identified)" ;
    :hasYAxisLabel "Deaths" ;
    :yMin "0"^^xsd:decimal ;
    :yMax "300000"^^xsd:decimal .

:DataPoint7505_1 a :DataPoint ;
    rdfs:label "2019-nCoV* (2020)" ;
    :xValue "2019-nCoV* (2020)" ;
    :yValue "5000"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean ;
    :belongsToChart :Chart7505 .

