@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart8105 a schema:BarChart ;
    schema:title "Monthly year-over-year retail sales development in the United States from 2019 to 2020 , by sector" ;
    :hasXAxisLabel "Month" ;
    :hasYAxisLabel "Sporting goods stores" ;
    :yMin "-0.4"^^xsd:decimal ;
    :yMax "0.2"^^xsd:decimal .

