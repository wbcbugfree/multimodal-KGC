@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart4725 a schema:LineChart ;
    schema:title "Per capita consumption of fresh mushrooms in the United States from 2009 to 2019 (in pounds)" ;
    :hasXAxisLabel "Year" ;
    :hasYAxisLabel "Per capita consumption in pounds" ;
    :xMin "2009"^^xsd:string ;
    :xMax "2019"^^xsd:string ;
    :yMin "0"^^xsd:decimal ;
    :yMax "4"^^xsd:decimal .

:DataPoint4725_1 :belongsToChart :Chart4725 ;
    rdfs:label "2009" ;
    :xValue "2009" ;
    :yValue "3.5"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .

