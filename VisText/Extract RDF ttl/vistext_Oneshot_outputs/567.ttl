@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart567 a schema:LineChart ;
    schema:title "Global foreign direct investment (FDI) position of the United Kingdom (UK) from 2004 to 2018 (in billion GBP)" ;
    :hasXAxisLabel "Year" ;
    :hasYAxisLabel "Foreign direct investment in billion GBP" ;
    :xMin "2004" ;
    :xMax "2018" ;
    :yMin "0"^^xsd:decimal ;
    :yMax "1500"^^xsd:decimal .

