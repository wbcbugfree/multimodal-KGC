@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart8765 a schema:BarChart ;
    schema:title "Clinker capacity in selected countries from 2016 to 2019 (in million metric tons)" ;
    :hasXAxisLabel "2016" ;
    :hasYAxisLabel "Country" .

