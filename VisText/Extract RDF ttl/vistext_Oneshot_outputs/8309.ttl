@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart8309 a schema:BarChart ;
    schema:title "How do you expect COVID-19 to impact your spending for any of the following ?" ;
    :hasXAxisLabel "Stay the same" ;
    :hasYAxisLabel "Response" .

