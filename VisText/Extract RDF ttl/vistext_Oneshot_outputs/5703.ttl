@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart5703 a schema:BarChart ;
    schema:title "Which social media could teen and young adult users in the United Kingdom (UK) least do without as of 3rd quarter 2019 ?" ;
    :hasXAxisLabel "Response" ;
    :hasYAxisLabel "Share of respondents" ;
    :yMin "0.00"^^xsd:decimal ;
    :yMax "0.25"^^xsd:decimal .

:DataPoint5703_1 a schema:DataPoint ;
    rdfs:label "Don't know" ;
    :xValue "Don't know" ;
    :yValue "0.09"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean ;
    :belongsToChart :Chart5703 .

