@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart2357 a schema:LineChart ;
    schema:title "Djibouti : Infant mortality rate from 2009 to 2019 (in deaths per 1,000 live births)" ;
    :hasXAxisLabel "Year" ;
    :hasYAxisLabel "Deaths per 1,000 live births" ;
    :xMin "2009"^^xsd:string ;
    :xMax "2019"^^xsd:string ;
    :yMin "0"^^xsd:decimal ;
    :yMax "70"^^xsd:decimal .

:DataPoint2357_1 a schema:DataPoint ;
    :belongsToChart :Chart2357 ;
    rdfs:label "2009" ;
    :xValue "2009" ;
    :yValue "64"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .

