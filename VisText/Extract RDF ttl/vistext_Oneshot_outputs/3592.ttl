@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart3592 a schema:BarChart ;
    schema:title "Number of tourist arrivals from the United Kingdom (UK) in Lanzarote in 2014 , by region of origin" ;
    :hasXAxisLabel "region of England" ;
    :hasYAxisLabel "Number of arrivals" ;
    :yMin "0"^^xsd:decimal ;
    :yMax "150000"^^xsd:decimal .

:DataPoint3592_1 a schema:DataPoint ;
    :belongsToChart :Chart3592 ;
    rdfs:label "East Midlands" ;
    :xValue "East Midlands" ;
    :yValue "80000"^^xsd:decimal ;
    :valueEstimated "true" .

