@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart1394 a schema:CreativeWork ;
    schema:title "Number of wage and salary workers in the United States paid hourly rates at the prevailing Federal minimum wage from 1979 to 2019 (in 1,000s)" ;
    :hasXAxisLabel "Year" ;
    :hasYAxisLabel "Number of workers in thousands" ;
    :yMin "0"^^xsd:decimal ;
    :yMax "5000"^^xsd:decimal .

