@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart2557 a schema:BarChart ;
    schema:title "Average undergraduate tuition fees for international students in Canada from 2006 to 2020 (in Canadian dollars)" ;
    :hasXAxisLabel "Tuition in Canadian dollars" ;
    :hasYAxisLabel "Year" .

:DataPoint2557_1 a schema:DataPoint ;
    rdfs:label "2006 / 2007" ;
    :xValue "2006 / 2007" ;
    :yValue "15000"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean ;
    :belongsToChart :Chart2557 .

