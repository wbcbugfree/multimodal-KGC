@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart556 a schema:LineChart ;
    schema:title "Worldwide exports of railway track material from 2007 to 2019 (in million metric tons of crude steel production)" ;
    :hasXAxisLabel "Year" ;
    :hasYAxisLabel "Exports in million metric tons" ;
    :xMin "2007" ;
    :xMax "2019" ;
    :yMin "0.0"^^xsd:decimal ;
    :yMax "3.5"^^xsd:decimal .

:DataPoint556_1 a schema:DataPoint ;
    :belongsToChart :Chart556 ;
    rdfs:label "2007" ;
    :xValue "2007" ;
    :yValue "3.3"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .

