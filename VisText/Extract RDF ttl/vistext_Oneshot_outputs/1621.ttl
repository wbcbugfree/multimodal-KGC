@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart1621 a schema:AreaChart ;
    schema:title "Registered number of bike thefts in Belgium from 2008 to 2019" ;
    :hasXAxisLabel "Year" ;
    :hasYAxisLabel "Number of bike thefts" ;
    :yMin "0"^^xsd:decimal ;
    :yMax "40000"^^xsd:decimal .

