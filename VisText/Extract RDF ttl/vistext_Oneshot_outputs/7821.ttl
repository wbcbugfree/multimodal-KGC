@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart7821 a schema:LineChart ;
    schema:title "Latvia : Age structure from 2009 to 2019" ;
    :hasXAxisLabel "Year" ;
    :hasYAxisLabel "0-14 years" ;
    :xMin "2009"^^xsd:string ;
    :xMax "2019"^^xsd:string ;
    :yMin "0.0"^^xsd:decimal ;
    :yMax "0.17"^^xsd:decimal .

:DataPoint7821_1 a schema:DataPoint ;
    rdfs:label "2009" ;
    :xValue "2009" ;
    :yValue "0.145"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean ;
    :belongsToChart :Chart7821 .

