@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart3324 a schema:BarChart ;
    schema:title "Los Angeles Angels all-time home run leaders as of October 2020" ;
    :hasXAxisLabel "Home run leaders" ;
    :hasYAxisLabel "Number of home runs" ;
    :yMin "0"^^xsd:decimal ;
    :yMax "350"^^xsd:decimal .

