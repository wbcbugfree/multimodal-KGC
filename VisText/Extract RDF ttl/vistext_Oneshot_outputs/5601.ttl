@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart5601 a schema:BarChart ;
    schema:title "Revenue of Vodafone Germany from the financial year 2008/09 to 2019/20 (in billion euros)" ;
    :hasXAxisLabel "Revenue in billion euros" ;
    :hasYAxisLabel "financial years" ;
    :yMin "0"^^xsd:decimal ;
    :yMax "10"^^xsd:decimal .

:DataPoint5601_1 a schema:DataPoint ;
    rdfs:label "2008/09" ;
    :xValue "2008/09" ;
    :yValue "7.5"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean ;
    :belongsToChart :Chart5601 .

