@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart4811 a schema:BarChart ;
    schema:title "Length of the average working week of all employees in the United States in November 2020 , by industry" ;
    :hasXAxisLabel "Hours of work" ;
    :hasYAxisLabel "industry" ;
    :xMin "0"^^xsd:decimal ;
    :xMax "40"^^xsd:decimal .

:DataPoint4811_1 a schema:DataPoint ;
    rdfs:label "Construction" ;
    :xValue "Construction" ;
    :yValue "39.5"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean ;
    :belongsToChart :Chart4811 .

