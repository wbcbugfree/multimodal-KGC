@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart1721 a schema:BarChart ;
    schema:title "Ranking of the most successful films at cinemas in Sweden in 2019 , by number of admissions" ;
    :hasXAxisLabel "Number of admissions" ;
    :hasYAxisLabel "film" ;
    :xMin "0"^^xsd:decimal ;
    :xMax "1200000"^^xsd:decimal .

