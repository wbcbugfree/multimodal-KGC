@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart6426 a schema:BarChart ;
    schema:title "Leading countries based on natural gas production in 2014 and 2018 (in billion cubic meters)" ;
    :hasXAxisLabel "2018" ;
    :hasYAxisLabel "Country" .

:DataPoint6426_1 a schema:BarChart ;
    rdfs:label "Algeria" ;
    :xValue "Algeria" ;
    :yValue "50.0"^^xsd:decimal ;
    :valueEstimated "true" ;
    :belongsToChart :Chart6426 .

