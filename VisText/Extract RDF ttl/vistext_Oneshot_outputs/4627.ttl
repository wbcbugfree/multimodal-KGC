@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart4627 a schema:BarChart ;
    schema:title "Circulation of selected large daily newspapers in Finland in 2019" ;
    :hasXAxisLabel "Number of copies" ;
    :hasYAxisLabel "newspaper" ;
    :xMin "0"^^xsd:decimal ;
    :xMax "300000"^^xsd:decimal .

:DataPoint4627_1 a :DataPoint ;
    rdfs:label "Etelä-Saimaa" ;
    :xValue "Etelä-Saimaa" ;
    :yValue "20000"^^xsd:decimal ;
    :valueEstimated "true" ;
    :belongsToChart :Chart4627 .

