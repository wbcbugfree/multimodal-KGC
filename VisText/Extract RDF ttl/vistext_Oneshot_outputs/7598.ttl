@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart7598 a schema:LineChart ;
    schema:title "Number of Facebook fans/twitter followers of the Minnesota Vikings (NFL) from 2012 to 2020 (in millions)" ;
    :hasXAxisLabel "Month" ;
    :hasYAxisLabel "Facebook fans" ;
    :yMin "0.0"^^xsd:decimal ;
    :yMax "2.5"^^xsd:decimal .

:DataPoint7598_1 a :DataPoint ;
    :belongsToChart :Chart7598 ;
    rdfs:label "2012" ;
    :xValue "2012" ;
    :yValue "1.45"^^xsd:decimal ;
    :valueEstimated "true" .

