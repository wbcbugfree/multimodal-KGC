@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart8679 a schema:LineChart ;
    schema:title "Poland : Distribution of gross domestic product (GDP) across economic sectors from 2009 to 2019" ;
    :hasXAxisLabel "Year" ;
    :hasYAxisLabel "Agriculture" .

