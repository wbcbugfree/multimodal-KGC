:Chart3330 a schema:BarChart ;
    schema:title "Which sites or services have you used in the past three months to stream/access , or share music tracks or albums through the internet ?" ;
    :hasXAxisLabel "Share of respondents" ;
    :hasYAxisLabel "Response" ;
    :xMin "0.0"^^xsd:decimal ;
    :xMax "0.6"^^xsd:decimal .

