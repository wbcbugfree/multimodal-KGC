    rdfs:label "2000" ;
    :xValue "2000" ;
    :yValue "26000.0"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .

:DataPoint3098_4 :belongsToChart :Chart3098 ;
    rdfs:label "2005" ;
    :xValue "2005" ;
    :yValue "35000.0"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .

:DataPoint3098_5 :belongsToChart :Chart3098 ;
    rdfs:label "2010" ;
    :xValue "2010" ;
    :yValue "39000.0"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .

:DataPoint3098_6 :belongsToChart :Chart3098 ;
