@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart2531 a schema:LineChart ;
    schema:title "Number of Canadian students enrolled in postsecondary institutions in Canada from 2000 to 2018 (in millions)" ;
    :hasXAxisLabel "Year" ;
    :hasYAxisLabel "Number of Canadian students in millions" ;
    :xMin "2000"^^xsd:decimal ;
    :xMax "2018"^^xsd:decimal ;
    :yMin "0.0"^^xsd:decimal ;
    :yMax "2.0"^^xsd:decimal .

:DataPoint2531_1 a schema:DataPoint ;
    rdfs:label "2000" ;
    :xValue "2000" ;
    :yValue "1.0"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean ;
    :belongsToChart :Chart2531 .

