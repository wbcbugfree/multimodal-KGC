@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart4563 a schema:BarChart ;
    schema:title "How did bullying impact you ?" ;
    :hasXAxisLabel "Response" ;
    :hasYAxisLabel "Share of respondents" ;
    :yMin "0.0"^^xsd:decimal ;
    :yMax "0.4"^^xsd:decimal .

:DataPoint4563_1 a :DataPoint ;
    rdfs:label "Developed an eating disorder" ;
    :xValue "Developed an eating disorder" ;
    :yValue "0.13"^^xsd:decimal ;
    :valueEstimated "true" ;
    :belongsToChart :Chart4563 .

:DataPoint4563_2 a :DataPoint ;
    rdfs:label "Developed depression" ;
    :xValue "Developed depression" ;
    :yValue "0.44"^^xsd:decimal ;
    :valueEstimated "true" ;
    :belongsToChart :Chart4563 .

