@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart6103 a schema:BarChart ;
    schema:title "Most popular Brazilian soccer clubs as of June 2020 , by number of social media followers (in 1,000s)" ;
    :hasXAxisLabel "Soccer clubs" ;
    :hasYAxisLabel "TikTok" .

:DataPoint6103_1 a schema:DataPoint ;
    rdfs:label "Atlético Minas Gerais" ;
    :xValue "Atlético Minas Gerais" ;
    :yValue "10.0"^^xsd:decimal ;
    :valueEstimated "true" ;
    :belongsToChart :Chart6103 .

