@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart8425 a schema:AreaChart ;
    schema:title "New Zealand : Distribution of employment by economic sector from 2010 to 2020" ;
    :hasXAxisLabel "Year" ;
    :hasYAxisLabel "" ;
    :yMin "0.0"^^xsd:decimal ;
    :yMax "0.8"^^xsd:decimal .

:DataPoint8425_1 a :DataPoint ;
    :belongsToChart :Chart8425 ;
    rdfs:label "Services" ;
    :xValue "2010" ;
    :yValue "0.75"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .

:DataPoint8425_2 a :DataPoint ;
    :belongsToChart :Chart8425 ;
    rdfs:label "Services" ;
    :xValue "2012" ;
    :yValue "0.76"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .

:DataPoint8425_3 a :DataPoint ;
    :belongsToChart :Chart8425 ;
    rdfs:label "Services" ;
    :xValue "2014" ;
    :yValue "0.77"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .

:DataPoint8425_4 a :DataPoint ;
    :belongsToChart :Chart8425 ;
    rdfs:label "Services" ;
    :xValue "2016" ;
    :yValue "0.775"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .

:DataPoint8425_5 a :DataPoint ;
    :belongsToChart :Chart8425 ;
