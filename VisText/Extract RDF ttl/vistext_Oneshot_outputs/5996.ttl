    rdfs:label "Abu Dhabi" ;
    :xValue "3.5"^^xsd:decimal ;
    :yValue "3.5"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean ;
    :belongsToChart :Chart5996 .

