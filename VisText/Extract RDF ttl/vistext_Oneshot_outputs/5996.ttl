@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <https://schema.org/> .

:Chart5996 a schema:BarChart ;
    schema:title "Most expensive cities to drink a cold beer worldwide as of June 2016 , based on beer price index (in U.S. dollars)" ;
    :hasXAxisLabel "Beer price in U.S. dollars" ;
    :hasYAxisLabel "Country" ;
    :yMin "0"^^xsd:decimal ;
    :yMax "10"^^xsd:decimal .

