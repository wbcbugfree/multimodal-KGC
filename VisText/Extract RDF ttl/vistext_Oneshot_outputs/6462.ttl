@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart6462 a schema:LineChart ;
    schema:title "Israel : Distribution of employment by economic sector from 2010 to 2020" ;
    :hasXAxisLabel "Year" ;
    :hasYAxisLabel "Services" ;
    :xMin "2010" ;
    :xMax "2020" ;
    :yMin "0.0"^^xsd:decimal ;
    :yMax "1.0"^^xsd:decimal .

:DataPoint6462_1 a schema:DataPoint ;
    :belongsToChart :Chart6462 ;
    rdfs:label "2010" ;
    :xValue "2010" ;
    :yValue "0.80"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .

:DataPoint6462_2 a schema:DataPoint ;
    :belongsToChart :Chart6462 ;
    rdfs:label "2012" ;
    :xValue "2012" ;
    :yValue "0.81"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .

:DataPoint6462_3 a schema:DataPoint ;
    :belongsToChart :Chart6462 ;
    rdfs:label "2014" ;
    :xValue "2014" ;
    :yValue "0.81"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .

:DataPoint6462_4 a schema:DataPoint ;
    :belongsToChart :Chart6462 ;
    rdfs:label "2016" ;
    :xValue "2016" ;
    :yValue "0.82"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .

:DataPoint6462_5 a schema:DataPoint ;
    :belongsToChart :Chart6462 ;
    rdfs:label "2018" ;
    :xValue "2018" ;
    :yValue "0.82"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .

:DataPoint6462_6 a schema:DataPoint ;
    :belongsToChart :Chart6462 ;
    rdfs:label "2020" ;
    :xValue "2020" ;
    :yValue "0.83"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .
