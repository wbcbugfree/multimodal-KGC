    rdfs:label "CEE (excluding Russia and Ukraine)" ;
    :xValue "CEE (excluding Russia and Ukraine)" ;
    :yValue "0.07"^^xsd:decimal ;
    :valueEstimated "true" ;
    :belongsToChart :Chart7651 .

