@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart7651 a schema:BarChart ;
    schema:title "Which region or country do you believe will witness the most M & A activity in Europe over the next 12 months ?" ;
    :hasXAxisLabel "Response" ;
    :hasYAxisLabel "2nd most active" ;
    :yMin "0.00"^^xsd:decimal ;
    :yMax "0.20"^^xsd:decimal .

:DataPoint7651_1 a schema:DataPoint ;
    rdfs:label "Austria and Switzerland" ;
    :xValue "Austria and Switzerland" ;
    :yValue "0.10"^^xsd:decimal ;
    :valueEstimated "true" ;
    :belongsToChart :Chart7651 .

:DataPoint7651_2 a schema:DataPoint ;
    rdfs:label "Benelux" ;
    :xValue "Benelux" ;
    :yValue "0.10"^^xsd:decimal ;
    :valueEstimated "true" ;
    :belongsToChart :Chart7651 .

