    rdfs:label "Italy" ;
    :xValue "Italy" ;
    :yValue "0.03"^^xsd:decimal ;
    :valueEstimated "true" ;
    :belongsToChart :Chart7651 .

:DataPoint7651_8 a schema:DataPoint ;
    rdfs:label "Nordic" ;
    :xValue "Nordic" ;
    :yValue "0.03"^^xsd:decimal ;
    :valueEstimated "true" ;
    :belongsToChart :Chart7651 .

:DataPoint7651_9 a schema:DataPoint ;
    rdfs:label "Russia and Ukraine" ;
    :xValue "Russia and Ukraine" ;
