@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart420 a schema:BarChart ;
    schema:title "Average consumer price for natural gas in the United States from winter of 2005/06 to winter of 2020/21 (in U.S. dollars per 1,000 cubic feet)" ;
    :hasXAxisLabel "Price in U.S. dollars per thousand cubic feet" ;
    :hasYAxisLabel "Year" .

:DataPoint420_1 :belongsToChart :Chart420 ;
    rdfs:label "2005/06" ;
    :xValue "2005/06" ;
    :yValue 15.5 ;
    :valueEstimated "true"^^xsd:boolean .

