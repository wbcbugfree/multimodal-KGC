@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart3910 a schema:AreaChart ;
    schema:title "Population of the Riverside-San Bernardino-Ontario metro area in the United States from 2010 to 2019" ;
    :hasXAxisLabel "Year" ;
    :hasYAxisLabel "Number of residents" ;
    :yMin "0"^^xsd:decimal ;
    :yMax "5000000"^^xsd:decimal .

:DataPoint3910_1 :belongsToChart :Chart3910 ;
    rdfs:label "2010" ;
    :xValue "2010" ;
    :yValue "4300000"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .

:DataPoint3910_2 :belongsToChart :Chart3910 ;
    rdfs:label "2012" ;
    :xValue "2012" ;
    :yValue "4400000"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .

:DataPoint3910_3 :belongsToChart :Chart3910 ;
    rdfs:label "2014" ;
    :xValue "2014" ;
    :yValue "4500000"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .

:DataPoint3910_4 :belongsToChart :Chart3910 ;
    rdfs:label "2016" ;
    :xValue "2016" ;
    :yValue "4600000"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .

:DataPoint3910_5 :belongsToChart :Chart3910 ;
    rdfs:label "2018" ;
    :xValue "2018" ;
    :yValue "4700000"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .

:DataPoint3910_6 :belongsToChart :Chart3910 ;
    rdfs:label "2019" ;
    :xValue "2019" ;
    :yValue "4750000"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .
