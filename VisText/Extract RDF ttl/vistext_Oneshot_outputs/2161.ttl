@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart2161 a schema:LineChart ;
    schema:title "Sales price of ice cream per ton manufactured in the United Kingdom (UK) from 2009 to 2019 (in GBP)" ;
    :hasXAxisLabel "Year" ;
    :hasYAxisLabel "Price per litre in British pounds" ;
    :yMin "0.0"^^xsd:decimal ;
    :yMax "1.75"^^xsd:decimal .

:DataPoint2161_1 a schema:DataPoint ;
    :belongsToChart :Chart2161 ;
    rdfs:label "2009" ;
    :xValue "2009" ;
    :yValue "1.25"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .

