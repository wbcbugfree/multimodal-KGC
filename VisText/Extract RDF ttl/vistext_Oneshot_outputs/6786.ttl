@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart6786 a schema:BarChart ;
    schema:title "Average fixed internet download and upload speeds in selected cities in the United States between 2nd and 3rd quarter 2018 (in Mbps)" ;
    :hasXAxisLabel "Upload" ;
    :hasYAxisLabel "city of the United States" .

:DataPoint6786_1 a schema:DataPoint ;
    rdfs:label "Austin, Texas" ;
    :xValue "Austin, Texas" ;
    :yValue "50"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean ;
    :belongsToChart :Chart6786 .

