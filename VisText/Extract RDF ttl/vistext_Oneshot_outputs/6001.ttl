@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart6001 a schema:LineChart ;
    schema:title "Plant load factor (PLF) of combined cycle gas turbine stations in the United Kingdom (UK) , from 2010 to 2019 (percentage)" ;
    :hasXAxisLabel "Year" ;
    :hasYAxisLabel "Plant load factor as a percentage" ;
    :yMin "0.0"^^xsd:decimal ;
    :yMax "0.6"^^xsd:decimal .

:DataPoint6001_1 a :DataPoint ;
    rdfs:label "2010" ;
    :xValue "2010" ;
    :yValue "0.6"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean ;
    :belongsToChart :Chart6001 .

