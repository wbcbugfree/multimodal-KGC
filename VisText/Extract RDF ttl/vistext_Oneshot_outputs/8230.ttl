@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart8230 a schema:LineChart ;
    schema:title "Reported cases of rubella worldwide from 1999 to 2018 , by region" ;
    :hasXAxisLabel "Year" ;
    :hasYAxisLabel "Americas" ;
    :xMin "1999" ;
    :xMax "2018" ;
    :yMin "0"^^xsd:decimal ;
    :yMax "60000"^^xsd:decimal .

:DataPoint8230_1 a :DataPoint ;
    :belongsToChart :Chart8230 ;
    rdfs:label "1999" ;
    :xValue "1999" ;
    :yValue "59000"^^xsd:decimal ;
    :valueEstimated "true" .

