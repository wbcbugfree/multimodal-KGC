@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart6393 a schema:BarChart ;
    schema:title "Average monthly precipitation in Germany from November 2019 to November 2020 (in liters per square meter)" ;
    :hasXAxisLabel "Month" ;
    :hasYAxisLabel "Long-term average" .

