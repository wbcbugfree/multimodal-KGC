@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart2105 a schema:BarChart ;
    schema:title "Volume of almonds imported to Canada from 2010/11 to 2020/21 (in 1,000 metric tons)" ;
    :hasXAxisLabel "Year" ;
    :hasYAxisLabel "Import volume in thousand metric tons" ;
    :yMin "0"^^xsd:decimal ;
    :yMax "40"^^xsd:decimal .

:DataPoint2105_1 a :DataPoint ;
    :belongsToChart :Chart2105 ;
    rdfs:label "2010/11" ;
    :xValue "2010/11" ;
    :yValue "28"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .

