@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart2093 a schema:LineChart ;
    schema:title "Rwanda : Birth rate from 2008 to 2018 (per 1,000 inhabitants)" ;
    :hasXAxisLabel "Year" ;
    :hasYAxisLabel "Birth rate per thousand population" ;
    :yMin "0"^^xsd:decimal ;
    :yMax "40"^^xsd:decimal .

:DataPoint2093_1 a :DataPoint ;
    :belongsToChart :Chart2093 ;
    rdfs:label "2008" ;
    :xValue "2008" ;
    :yValue "36.5"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .

:DataPoint2093_2 a :DataPoint ;
    :belongsToChart :Chart2093 ;
    rdfs:label "2010" ;
    :xValue "2010" ;
    :yValue "35.5"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .

:DataPoint2093_3 a :DataPoint ;
    :belongsToChart :Chart2093 ;
    rdfs:label "2012" ;
    :xValue "2012" ;
    :yValue "34.5"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .

:DataPoint2093_4 a :DataPoint ;
    :belongsToChart :Chart2093 ;
    rdfs:label "2014" ;
    :xValue "2014" ;
    :yValue "33.5"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .

:DataPoint2093_5 a :DataPoint ;
    :belongsToChart :Chart2093 ;
    rdfs:label "2016" ;
    :xValue "2016" ;
    :yValue "32.8"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .

:DataPoint2093_6 a :DataPoint ;
    :belongsToChart :Chart2093 ;
    rdfs:label "2018" ;
    :xValue "2018" ;
    :yValue "32.2"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .
