@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart5151 a schema:BarChart ;
    schema:title "Which of the following people , if any , do you consider to be picky eaters ?" ;
    :hasXAxisLabel "Unnamed: 1" ;
    :hasYAxisLabel "type of person" .

:DataPoint5151_1 a schema:DataPoint ;
    rdfs:label "A child in my household" ;
    :xValue "A child in my household" ;
    :yValue "18.0"^^xsd:decimal ;
    :valueEstimated "true" ;
    :belongsToChart :Chart5151 .

:DataPoint5151_2 a schema:DataPoint ;
    rdfs:label "Another adult I know, not in my h..." ;
    :xValue "Another adult I know, not in my h..." ;
    :yValue "12.0"^^xsd:decimal ;
    :valueEstimated "true" ;
    :belongsToChart :Chart5151 .

:DataPoint5151_3 a schema:DataPoint ;
    rdfs:label "Another adult in my household" ;
    :xValue "Another adult in my household" ;
    :yValue "4.0"^^xsd:decimal ;
    :valueEstimated "true" ;
    :belongsToChart :Chart5151 .

:DataPoint5151_4 a schema:DataPoint ;
    rdfs:label "Another child I know, not in my ho..." ;
    :xValue "Another child I know, not in my ho..." ;
    :yValue "16.0"^^xsd:decimal ;
    :valueEstimated "true" ;
    :belongsToChart :Chart5151 .

:DataPoint5151_5 a schema:DataPoint ;
    rdfs:label "I don't know anyone who I conside..." ;
    :xValue "I don't know anyone who I conside..." ;
    :yValue "28.0"^^xsd:decimal ;
    :valueEstimated "true" ;
    :belongsToChart :Chart5151 .

:DataPoint5151_6 a schema:DataPoint ;
    rdfs:label "My spouse or partner" ;
    :xValue "My spouse or partner" ;
    :yValue "14.0"^^xsd:decimal ;
    :valueEstimated "true" ;
    :belongsToChart :Chart5151 .

:DataPoint5151_7 a schema:DataPoint ;
    rdfs:label "Myself" ;
    :xValue "Myself" ;
    :yValue "26.0"^^xsd:decimal ;
    :valueEstimated "true" ;
    :belongsToChart :Chart5151 .

:DataPoint5151_8 a schema:DataPoint ;
    rdfs:label "One or more of my in-laws" ;
    :xValue "One or more of my in-laws" ;
    :yValue "4.0"^^xsd:decimal ;
    :valueEstimated "true" ;
    :belongsToChart :Chart5151 .

:DataPoint5151_9 a schema:DataPoint ;
    rdfs:label "One or more of my parents" ;
    :xValue "One or more of my parents" ;
    :yValue "5.0"^^xsd:decimal ;
    :valueEstimated "true" ;
    :belongsToChart :Chart5151 .

:DataPoint5151_10 a schema:DataPoint ;
    rdfs:label "Someone else" ;
    :xValue "Someone else" ;
    :yValue "11.0"^^xsd:decimal ;
    :valueEstimated "true" ;
    :belongsToChart :Chart5151 .
