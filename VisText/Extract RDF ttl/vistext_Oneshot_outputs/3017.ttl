@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart3017 a schema:LineChart ;
    schema:title "Registered cases of fraud in Belgium from 2008 to 2019" ;
    :hasXAxisLabel "Year" ;
    :hasYAxisLabel "Cases of fraud" ;
    :xMin "2008" ;
    :xMax "2019" ;
    :yMin "0"^^xsd:decimal ;
    :yMax "30000"^^xsd:decimal .

:DataPoint3017_1 a :DataPoint ;
    :belongsToChart :Chart3017 ;
    rdfs:label "2008" ;
    :xValue "2008" ;
    :yValue "7500"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .

