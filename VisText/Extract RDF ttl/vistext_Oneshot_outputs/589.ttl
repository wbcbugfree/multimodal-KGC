@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart589 a schema:BarChart ;
    schema:title "Chicago Bulls all-time assists leaders from 1966 to 2020" ;
    :hasXAxisLabel "Chicago Bulls players" ;
    :hasYAxisLabel "Assists" ;
    :yMin "0"^^xsd:decimal ;
    :yMax "5000"^^xsd:decimal .

:DataPoint589_1 a schema:DataPoint ;
    rdfs:label "Bob Weiss" ;
    :xValue "Bob Weiss" ;
    :yValue "1600"^^xsd:decimal ;
    :valueEstimated "true" ;
    :belongsToChart :Chart589 .

