:Chart1439 a schema:BarChart ;
    schema:title "Apparent steel consumption per capita in Mexico from 2003 to 2018 (in kilograms of finished steel products)" ;
    :hasXAxisLabel "Year" ;
    :hasYAxisLabel "Per capita use in kilograms" ;
    :yMin "0"^^xsd:decimal ;
    :yMax "200"^^xsd:decimal .

