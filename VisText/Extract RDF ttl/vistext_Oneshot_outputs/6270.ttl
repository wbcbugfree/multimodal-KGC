@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <https://schema.org/> .

:Chart6270 a schema:BarChart ;
    schema:title "Portugal : Government revenue and spending from 2014 to 2024 (in billion euros)" ;
    :hasXAxisLabel "Spending" ;
    :hasYAxisLabel "Year" ;
    :yMin "2014" ;
    :yMax "2024" .

:DataPoint6270_1 a :DataPoint ;
    rdfs:label "2014" ;
    :xValue "95"^^xsd:decimal ;
    :yValue "2014" ;
    :valueEstimated "true"^^xsd:boolean ;
    :belongsToChart :Chart6270 .

