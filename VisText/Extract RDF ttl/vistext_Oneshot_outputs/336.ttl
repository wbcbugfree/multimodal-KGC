@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart336 a schema:LineChart ;
    schema:title "Ecolab 's net income from 2009 to 2019 (in million U.S. dollars)" ;
    :hasXAxisLabel "Year" ;
    :hasYAxisLabel "Net income in million U.S. dollars" ;
    :xMin "2009" ;
    :xMax "2019" ;
    :yMin "0" ;
    :yMax "1750" .

:DataPoint336_1 a schema:DataPoint ;
    rdfs:label "2009" ;
    :xValue "2009" ;
    :yValue "400"^^xsd:decimal ;
    :valueEstimated "true" ;
    :belongsToChart :Chart336 .

:DataPoint336_2 a schema:DataPoint ;
    rdfs:label "2010" ;
    :xValue "2010" ;
    :yValue "500"^^xsd:decimal ;
    :valueEstimated "true" ;
    :belongsToChart :Chart336 .

