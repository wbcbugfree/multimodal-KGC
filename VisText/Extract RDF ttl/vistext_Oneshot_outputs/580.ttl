@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart580 a schema:LineChart ;
    schema:title "U.S. sweet potato production value from 2000 to 2019 (in 1,000 U.S. dollars)" ;
    :hasXAxisLabel "Year" ;
    :hasYAxisLabel "Production value in thousand U.S. dollars" ;
    :yMin "0"^^xsd:decimal ;
    :yMax "800000"^^xsd:decimal .

