@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <https://schema.org/> .

:Chart3805 a schema:BarChart ;
    schema:title "Investment in travel and tourism in selected countries in the Caribbean in 2017 (in billion U.S. dollars)" ;
    :hasXAxisLabel "Country" ;
    :hasYAxisLabel "Investment in billion U.S. dollars" ;
    :yMin "0.0"^^xsd:decimal ;
    :yMax "0.4"^^xsd:decimal .

