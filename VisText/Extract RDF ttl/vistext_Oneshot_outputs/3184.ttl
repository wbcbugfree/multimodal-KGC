@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart3184 a schema:LineChart ;
    :hasXAxisLabel "Time" ;
    :hasYAxisLabel "Number of shops in thousands" ;
    :yMin "0"^^xsd:decimal ;
    :yMax "10"^^xsd:decimal .

:DataPoint3184_1 :belongsToChart :Chart3184 ;
    rdfs:label "2012" ;
    :xValue "2012" ;
    :yValue "9.5"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .

