@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart3532 a schema:LineChart ;
    schema:title "Number of researchers in the research & development sector per million inhabitants in China from 2009 to 2018" ;
    :hasXAxisLabel "Year" ;
    :hasYAxisLabel "Number per million inhabitants" ;
    :xMin "2009" ;
    :xMax "2018" ;
    :yMin "0"^^xsd:decimal ;
    :yMax "1400"^^xsd:decimal .

:DataPoint3532_1 a schema:DataPoint ;
    :belongsToChart :Chart3532 ;
    rdfs:label "2009" ;
    :xValue "2009" ;
    :yValue "840"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .

