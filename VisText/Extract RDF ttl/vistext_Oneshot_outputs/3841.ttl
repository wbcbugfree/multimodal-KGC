:Chart3841 a schema:LineChart ;
    schema:title "Median total family income in Nunavut from 2000 to 2018 (in Canadian dollars)" ;
    :hasXAxisLabel "Year" ;
    :hasYAxisLabel "Income in Canadian dollars" ;
    :xMin "2000"^^xsd:integer ;
    :xMax "2018"^^xsd:integer ;
    :yMin "0"^^xsd:integer ;
    :yMax "80000"^^xsd:integer .

