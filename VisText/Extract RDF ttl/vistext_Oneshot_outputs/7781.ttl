@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <https://schema.org/> .

:Chart7781 a schema:LineChart ;
    schema:title "How many hours in a typical week would you say you use the internet ?" ;
    :hasXAxisLabel "Response" ;
    :hasYAxisLabel "At home" ;
    :yMin "0"^^xsd:decimal ;
    :yMax "15"^^xsd:decimal .

:DataPoint7781_1 a :DataPoint ;
    :belongsToChart :Chart7781 ;
    rdfs:label "2006" ;
    :xValue "2006" ;
    :yValue "6.5"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .

