@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart796 a schema:LineChart ;
    schema:title "Iran : Fertility rate from 2008 to 2018" ;
    :hasXAxisLabel "Year" ;
    :hasYAxisLabel "Fertility rate" ;
    :xMin "2008" ;
    :xMax "2018" ;
    :yMin "0.0" ;
    :yMax "0.020" .

:DataPoint796_1 a schema:DataPoint ;
    :belongsToChart :Chart796 ;
    :xValue "2008" ;
    :yValue "0.0175"^^xsd:decimal ;
    :valueEstimated "true" .

:DataPoint796_2 a schema:DataPoint ;
    :belongsToChart :Chart796 ;
    :xValue "2010" ;
    :yValue "0.0180"^^xsd:decimal ;
    :valueEstimated "true" .

:DataPoint796_3 a schema:DataPoint ;
    :belongsToChart :Chart796 ;
    :xValue "2012" ;
    :yValue "0.0185"^^xsd:decimal ;
    :valueEstimated "true" .

:DataPoint796_4 a schema:DataPoint ;
    :belongsToChart :Chart796 ;
    :xValue "2014" ;
    :yValue "0.0190"^^xsd:decimal ;
    :valueEstimated "true" .

:DataPoint796_5 a schema:DataPoint ;
    :belongsToChart :Chart796 ;
    :xValue "2016" ;
    :yValue "0.0195"^^xsd:decimal ;
    :valueEstimated "true" .

:DataPoint796_6 a schema:DataPoint ;
    :belongsToChart :Chart796 ;
    :xValue "2018" ;
    :yValue "0.0200"^^xsd:decimal ;
    :valueEstimated "true" .
