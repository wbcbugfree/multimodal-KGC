@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <https://schema.org/> .

:Chart6709 a schema:BarChart ;
    schema:title "Average retail price for peanut butter in Canada from January 2015 to June 2020 (in Canadian dollars per 500 grams)" ;
    :hasXAxisLabel "Month" ;
    :hasYAxisLabel "" ;
    :yMin "0"^^xsd:decimal ;
    :yMax "4"^^xsd:decimal .

:DataPoint6709_1 a schema:DataPoint ;
    :belongsToChart :Chart6709 ;
    rdfs:label "Apr" ;
    :xValue "Apr" ;
    :yValue "3.5"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .

