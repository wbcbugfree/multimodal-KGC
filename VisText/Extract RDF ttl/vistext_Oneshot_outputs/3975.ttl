@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart3975 a schema:LineChart ;
    schema:title "Stock price of Unilever at Euronext Amsterdam from August 2019 to January 2021 (in euros)" ;
    :hasXAxisLabel "Month" ;
    :hasYAxisLabel "Stock price in euros" ;
    :xMin "2019-08" ;
    :xMax "2021-01" ;
    :yMin "0"^^xsd:decimal ;
    :yMax "60"^^xsd:decimal .

:DataPoint3975_1 :belongsToChart :Chart3975 ;
    rdfs:label "August 2019" ;
    :xValue "2019-08" ;
    :yValue "55.0"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .

:DataPoint3975_2 :belongsToChart :Chart3975 ;
    rdfs:label "October 2019" ;
    :xValue "2019-10" ;
    :yValue "55.0"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .

:DataPoint3975_3 :belongsToChart :Chart3975 ;
    rdfs:label "January 2020" ;
    :xValue "2020-01" ;
    :yValue "55.0"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .

:DataPoint3975_4 :belongsToChart :Chart3975 ;
    rdfs:label "April 2020" ;
    :xValue "2020-04" ;
    :yValue "40.0"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .

:DataPoint3975_5 :belongsToChart :Chart3975 ;
    rdfs:label "July 2020" ;
    :xValue "2020-07" ;
    :yValue "48.0"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .

:DataPoint3975_6 :belongsToChart :Chart3975 ;
    rdfs:label "October 2020" ;
    :xValue "2020-10" ;
    :yValue "50.0"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .

:DataPoint3975_7 :belongsToChart :Chart3975 ;
    rdfs:label "January 2021" ;
    :xValue "2021-01" ;
    :yValue "50.0"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .
