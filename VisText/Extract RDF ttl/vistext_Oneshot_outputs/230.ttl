@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart230 a schema:LineChart ;
    schema:title "Electricity generation worldwide from 1990 to 2018 (in terawatt hours)" ;
    :hasXAxisLabel "Year" ;
    :hasYAxisLabel "Electricity generation in terawatt hours" ;
    :xMin "1990"^^xsd:string ;
    :xMax "2018"^^xsd:string ;
    :yMin "0"^^xsd:decimal ;
    :yMax "25000"^^xsd:decimal .

:DataPoint230_1 a :DataPoint ;
    :belongsToChart :Chart230 ;
    rdfs:label "1990" ;
    :xValue "1990" ;
    :yValue "11500"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .

:DataPoint230_2 a :DataPoint ;
    :belongsToChart :Chart230 ;
    rdfs:label "1995" ;
    :xValue "1995" ;
    :yValue "13000"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .

:DataPoint230_3 a :DataPoint ;
    :belongsToChart :Chart230 ;
    rdfs:label "2000" ;
    :xValue "2000" ;
    :yValue "15500"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .

:DataPoint230_4 a :DataPoint ;
    :belongsToChart :Chart230 ;
    rdfs:label "2005" ;
    :xValue "2005" ;
    :yValue "18000"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .

:DataPoint230_5 a :DataPoint ;
    :belongsToChart :Chart230 ;
    rdfs:label "2010" ;
    :xValue "2010" ;
    :yValue "20500"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .

:DataPoint230_6 a :DataPoint ;
    :belongsToChart :Chart230 ;
    rdfs:label "2015" ;
    :xValue "2015" ;
    :yValue "23000"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .

:DataPoint230_7 a :DataPoint ;
    :belongsToChart :Chart230 ;
    rdfs:label "2018" ;
    :xValue "2018" ;
    :yValue "25500"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .
