@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart2953 a schema:LineChart ;
    schema:title "Number of cumulative cases of coronavirus (COVID-19) worldwide from January 22 , 2020 to January 5 , 2021 , by day" ;
    :hasXAxisLabel "Year" ;
    :hasYAxisLabel "Number of cumulative cases" ;
    :yMin "0"^^xsd:decimal ;
    :yMax "80000000"^^xsd:decimal .

:DataPoint2953_1 a schema:DataPoint ;
    :belongsToChart :Chart2953 ;
    rdfs:label "January 22, 2020" ;
    :xValue "2020-01-22" ;
    :yValue "0"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .

:DataPoint2953_2 a schema:DataPoint ;
    :belongsToChart :Chart2953 ;
    rdfs:label "April 2020" ;
    :xValue "2020-04-01" ;
    :yValue "1000000"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .

:DataPoint2953_3 a schema:DataPoint ;
    :belongsToChart :Chart2953 ;
    rdfs:label "July 2020" ;
    :xValue "2020-07-01" ;
    :yValue "10000000"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .

:DataPoint2953_4 a schema:DataPoint ;
    :belongsToChart :Chart2953 ;
    rdfs:label "October 2020" ;
    :xValue "2020-10-01" ;
    :yValue "40000000"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .

:DataPoint2953_5 a schema:DataPoint ;
    :belongsToChart :Chart2953 ;
    rdfs:label "January 5, 2021" ;
    :xValue "2021-01-05" ;
    :yValue "83000000"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .
