@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart2628 a schema:CreativeWork ;
    schema:title "Number of new COVID-19 confirmed cases in Australia March to September 2020" ;
    :hasXAxisLabel "Year" ;
    :hasYAxisLabel "Number of new confirmed cases" ;
    :yMin "0"^^xsd:decimal ;
    :yMax "800"^^xsd:decimal .

:DataPoint2628_1 :belongsToChart :Chart2628 ;
    rdfs:label "April" ;
    :xValue "April" ;
    :yValue "100"^^xsd:decimal ;
    :valueEstimated "true" .

:DataPoint2628_2 :belongsToChart :Chart2628 ;
    rdfs:label "April" ;
    :xValue "April" ;
    :yValue "400"^^xsd:decimal ;
    :valueEstimated "true" .

:DataPoint2628_3 :belongsToChart :Chart2628 ;
    rdfs:label "July" ;
    :xValue "July" ;
    :yValue "500"^^xsd:decimal ;
    :valueEstimated "true" .

:DataPoint2628_4 :belongsToChart :Chart2628 ;
    rdfs:label "July" ;
    :xValue "July" ;
    :yValue "700"^^xsd:decimal ;
    :valueEstimated "true" .

:DataPoint2628_5 :belongsToChart :Chart2628 ;
    rdfs:label "October" ;
    :xValue "October" ;
    :yValue "200"^^xsd:decimal ;
    :valueEstimated "true" .

:DataPoint2628_6 :belongsToChart :Chart2628 ;
    rdfs:label "October" ;
    :xValue "October" ;
    :yValue "400"^^xsd:decimal ;
    :valueEstimated "true" .

:DataPoint2628_7 :belongsToChart :Chart2628 ;
    rdfs:label "March" ;
    :xValue "March" ;
    :yValue "100"^^xsd:decimal ;
    :valueEstimated "true" .

:DataPoint2628_8 :belongsToChart :Chart2628 ;
    rdfs:label "September" ;
    :xValue "September" ;
    :yValue "100"^^xsd:decimal ;
    :valueEstimated "true" .
