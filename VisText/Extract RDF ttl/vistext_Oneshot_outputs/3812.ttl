@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart3812 a schema:LineChart ;
    :hasXAxisLabel "Year" ;
    :hasYAxisLabel "Deaths per 1,000 live births" ;
    :yMin "0"^^xsd:decimal ;
    :yMax "80"^^xsd:decimal .

:DataPoint3812_1 a :DataPoint ;
    :belongsToChart :Chart3812 ;
    rdfs:label "2010" ;
    :xValue "2010" ;
    :yValue "70"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .

:DataPoint3812_2 a :DataPoint ;
    :belongsToChart :Chart3812 ;
    rdfs:label "2012" ;
    :xValue "2012" ;
    :yValue "67"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .

:DataPoint3812_3 a :DataPoint ;
    :belongsToChart :Chart3812 ;
    rdfs:label "2014" ;
    :xValue "2014" ;
    :yValue "64"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .

:DataPoint3812_4 a :DataPoint ;
    :belongsToChart :Chart3812 ;
    rdfs:label "2016" ;
    :xValue "2016" ;
    :yValue "61"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .

:DataPoint3812_5 a :DataPoint ;
    :belongsToChart :Chart3812 ;
    rdfs:label "2018" ;
    :xValue "2018" ;
    :yValue "58"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .
