@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart6275 a schema:AreaChart ;
    schema:title "Mean earnings in the United States from 2005 to 2019 , by highest educational degree earned" ;
    :hasXAxisLabel "Level of Education" ;
    :hasYAxisLabel "Professional Degree" ;
    :xMin "2005" ;
    :xMax "2019" ;
    :yMin "0" ;
    :yMax "150000" .

:DataPoint6275_1 :belongsToChart :Chart6275 ;
    rdfs:label "2006" ;
    :xValue "2006" ;
    :yValue "120000"^^xsd:decimal ;
    :valueEstimated "true" .

