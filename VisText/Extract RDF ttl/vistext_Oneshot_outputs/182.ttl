@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <https://schema.org/> .

:Chart182 a schema:CreativeWork ;
    schema:title "Number of students enrolled in colleges in Canada from 2000 to 2018" ;
    :hasXAxisLabel "Year" ;
    :hasYAxisLabel "Number of students" ;
    :xMin "2000" ;
    :xMax "2018" ;
    :yMin "0"^^xsd:decimal ;
    :yMax "800000"^^xsd:decimal .

:DataPoint182_1 :belongsToChart :Chart182 ;
    rdfs:label "2000" ;
    :xValue "2000" ;
    :yValue "530000"^^xsd:decimal ;
    :valueEstimated "true" .

