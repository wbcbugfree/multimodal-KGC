@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart3507 a schema:LineChart ;
    schema:title "Number of journalists and media workers murdered in Mexico from 2005 to 2018" ;
    :hasXAxisLabel "Year" ;
    :hasYAxisLabel "Number of victims" ;
    :xMin "2005"^^xsd:string ;
    :xMax "2018"^^xsd:string ;
    :yMin "0"^^xsd:decimal ;
    :yMax "20"^^xsd:decimal .

:DataPoint3507_1 :belongsToChart :Chart3507 ;
    rdfs:label "2005" ;
    :xValue "2005" ;
    :yValue "2.0"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .

