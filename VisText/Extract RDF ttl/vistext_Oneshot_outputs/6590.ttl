@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart6590 a schema:AreaChart ;
    schema:title "Number of employees in the gambling industry in the United Kingdom from 2009 to 2019 , by sector" ;
    :hasXAxisLabel "year" ;
    :hasYAxisLabel "Gaming Machine Technical" ;
    :yMin "0"^^xsd:decimal ;
    :yMax "8000"^^xsd:decimal .

:DataPoint6590_1 :belongsToChart :Chart6590 ;
    rdfs:label "Gaming Machine Technical" ;
    :xValue "2012" ;
    :yValue "7200"^^xsd:decimal ;
    :valueEstimated "true" .

:DataPoint6590_2 :belongsToChart :Chart6590 ;
    rdfs:label "Gaming Machine Technical" ;
