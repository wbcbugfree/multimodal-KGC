@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart8473 a schema:LineChart ;
    schema:title "Market share held by the leading internet browsers in Europe from 2009 to 2019" ;
    :hasXAxisLabel "Year" ;
    :hasYAxisLabel "Chrome" ;
    :xMin "2009" ;
    :xMax "2019" ;
    :yMin "0.0"^^xsd:decimal ;
    :yMax "0.6"^^xsd:decimal .

