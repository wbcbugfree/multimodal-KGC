@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart3007 a schema:LineChart ;
    schema:title "Enhanced annuities sold as a proportion of all annuities in the United Kingdom (UK) from 2003 to 2012" ;
    :hasXAxisLabel "Response" ;
    :hasYAxisLabel "Percentage of enhanced annuities sold" ;
    :yMin "0.00"^^xsd:decimal ;
    :yMax "0.20"^^xsd:decimal .

:DataPoint3007_1 :belongsToChart :Chart3007 ;
    rdfs:label "2003" ;
    :xValue "2003" ;
    :yValue "0.025"^^xsd:decimal ;
    :valueEstimated "true" .

