@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart477 a schema:LineChart ;
    schema:title "Honduras : Urbanization from 2009 to 2019" ;
    :hasXAxisLabel "Response" ;
    :hasYAxisLabel "Share of urban population in total population" ;
    :yMin "0.0"^^xsd:decimal ;
    :yMax "0.6"^^xsd:decimal .

:DataPoint477_1 a schema:DataPoint ;
    :belongsToChart :Chart477 ;
    rdfs:label "2010" ;
    :xValue "2010" ;
    :yValue "0.505"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .

:DataPoint477_2 a schema:DataPoint ;
    :belongsToChart :Chart477 ;
    rdfs:label "2012" ;
    :xValue "2012" ;
    :yValue "0.52"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .

:DataPoint477_3 a schema:DataPoint ;
    :belongsToChart :Chart477 ;
    rdfs:label "2014" ;
    :xValue "2014" ;
    :yValue "0.535"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .

:DataPoint477_4 a schema:DataPoint ;
    :belongsToChart :Chart477 ;
    rdfs:label "2016" ;
    :xValue "2016" ;
    :yValue "0.55"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .

:DataPoint477_5 a schema:DataPoint ;
    :belongsToChart :Chart477 ;
    rdfs:label "2018" ;
    :xValue "2018" ;
    :yValue "0.565"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .
