@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart298 a schema:LineChart ;
    schema:title "Hungary : Infant mortality rate from 2009 to 2019 (in deaths per 1,000 live births)" ;
    :hasXAxisLabel "Year" ;
    :hasYAxisLabel "Deaths per 1,000 live births" ;
    :xMin "2009"^^xsd:integer ;
    :xMax "2019"^^xsd:integer ;
    :yMin "0"^^xsd:decimal ;
    :yMax "5.5"^^xsd:decimal .

:DataPoint298_1 a schema:DataPoint ;
    :belongsToChart :Chart298 ;
    rdfs:label "2009" ;
    :xValue "2009" ;
    :yValue "5.2"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .

