@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart6702 a schema:BarChart ;
    schema:title "Number of bankruptcies after the coronavirus outbreak in Sweden from February to November 2020 , by industry" ;
    :hasXAxisLabel "Month" ;
    :hasYAxisLabel "Transportation" ;
    :yMin "0"^^xsd:decimal ;
    :yMax "40"^^xsd:decimal .

:DataPoint6702_1 a :DataPoint ;
    :belongsToChart :Chart6702 ;
    rdfs:label "Apr" ;
    :xValue "Apr" ;
    :yValue "35"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .

