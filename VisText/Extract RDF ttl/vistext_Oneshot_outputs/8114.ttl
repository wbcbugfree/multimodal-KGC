@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart8114 a schema:BarChart ;
    :hasXAxisLabel "Response" ;
    :hasYAxisLabel "Traditional agencies with $10m plus revenue" ;
    :yMin "0.0"^^xsd:decimal ;
    :yMax "0.7"^^xsd:decimal .

:DataPoint8114_1 a schema:DataPoint ;
    rdfs:label "Agent portion of websites" ;
    :xValue "Agent portion of websites" ;
    :yValue "0.25"^^xsd:decimal ;
    :valueEstimated "true" ;
    :belongsToChart :Chart8114 .

