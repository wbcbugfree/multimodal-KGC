:Chart6723 a schema:BarChart ;
    schema:title "Percentage of seniors aged 65 years and older that had a select number of chronic conditions as of 2017 , by country" ;
    :hasXAxisLabel "3 or more" ;
    :hasYAxisLabel "Country" ;
    :xMin "0.0"^^xsd:decimal ;
    :xMax "0.4"^^xsd:decimal .

