@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart3583 a schema:BarChart ;
    schema:title "If you think of your (last) journey , how would you (most likely) have reached your destination , if you had n't used a long-distance bus service ?" ;
    :hasXAxisLabel "Response" ;
    :hasYAxisLabel "Share of respondents" ;
    :yMin "0.0"^^xsd:decimal ;
    :yMax "0.4"^^xsd:decimal .

:DataPoint3583_1 a schema:DataPoint ;
    rdfs:label "Car pooling" ;
    :xValue "Car pooling" ;
    :yValue "0.09"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean ;
    :belongsToChart :Chart3583 .

:DataPoint3583_2 a schema:DataPoint ;
    rdfs:label "Car sharing" ;
    :xValue "Car sharing" ;
    :yValue "0.02"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean ;
    :belongsToChart :Chart3583 .

