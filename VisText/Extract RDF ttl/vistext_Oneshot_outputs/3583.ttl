    :xValue "Plane" ;
    :yValue "0.12"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean ;
    :belongsToChart :Chart3583 .

:DataPoint3583_8 a schema:DataPoint ;
    rdfs:label "Rental car" ;
    :xValue "Rental car" ;
    :yValue "0.04"^^xsd:decimal ;
