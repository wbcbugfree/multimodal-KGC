@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart5398 a schema:BarChart ;
    schema:title "Value of the leading merchandise exporters worldwide in 2019 , by exporting nation (in billion U.S. dollars)" ;
    :hasXAxisLabel "Export value in billion U.S. dollars" ;
    :hasYAxisLabel "Exporting nation" .

:DataPoint5398_1 a schema:DataPoint ;
    rdfs:label "Canada" ;
    :xValue "Canada" ;
    :yValue "250"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean ;
    :belongsToChart :Chart5398 .

