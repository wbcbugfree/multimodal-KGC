@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart2362 a schema:BarChart ;
    schema:title "Average number of civilian deaths per day from gunfire and executions in Iraq war from 2003 to 2013" ;
    :hasXAxisLabel "Year" ;
    :hasYAxisLabel "Average number of civilian deaths per day" .

