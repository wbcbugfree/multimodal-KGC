:Chart7178 a schema:AreaChart ;
    schema:title "Average hours per day spent on leisure and sports in the U.S. sorted by ethnicity from 2009 to 2019" ;
    :hasXAxisLabel "Year" ;
    :hasYAxisLabel "Black or African American" ;
    :yMin "0"^^xsd:decimal ;
    :yMax "7"^^xsd:decimal .

