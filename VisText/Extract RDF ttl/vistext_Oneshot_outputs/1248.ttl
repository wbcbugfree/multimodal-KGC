@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart1248 a schema:LineChart ;
    schema:title "Audi 's equity ratio from FY 2005 to FY 2019" ;
    :hasXAxisLabel "Year" ;
    :hasYAxisLabel "Equity ratio" ;
    :xMin "2005" ;
    :xMax "2019" ;
    :yMin "0.0"^^xsd:decimal ;
    :yMax "0.5"^^xsd:decimal .

:DataPoint1248_1 :belongsToChart :Chart1248 ;
    rdfs:label "2005" ;
    :xValue "2005" ;
    :yValue "0.37"^^xsd:decimal ;
    :valueEstimated "true" .

