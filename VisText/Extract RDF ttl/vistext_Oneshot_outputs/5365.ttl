:Chart5365 a schema:BarChart ;
    schema:title "Estimated gross domestic product (GDP) loss from removal of all illegal immigrant workers from the United States as of September 2016, by industry (in billion U.S. dollars)" ;
    :hasXAxisLabel "economic sector" ;
    :hasYAxisLabel "GDP loss in billion U.S. dollars" ;
    :yMin "0"^^xsd:decimal ;
    :yMax "80"^^xsd:decimal .

:DataPoint5365_1 a schema:DataPoint ;
    rdfs:label "Agriculture, forestry, fishing, and hunting" ;
    :xValue "Agriculture, forestry, fishing, and hunting" ;
    :yValue "20"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean ;
    :belongsToChart :Chart5365 .

