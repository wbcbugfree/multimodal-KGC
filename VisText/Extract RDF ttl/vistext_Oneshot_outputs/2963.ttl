:Chart2963 a schema:LineChart ;
    schema:title "Average monthly number of calls per mobile subscription in Sweden from 2007 to 2019" ;
    :hasXAxisLabel "Year" ;
    :hasYAxisLabel "Average number of calls per mobile subscription" ;
    :xMin "2007" ;
    :xMax "2019" ;
    :yMin "0"^^xsd:decimal ;
    :yMax "70"^^xsd:decimal .

:DataPoint2963_1 a schema:DataPoint ;
    rdfs:label "2007" ;
    :xValue "2007" ;
    :yValue "61.0"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean ;
    :belongsToChart :Chart2963 .

