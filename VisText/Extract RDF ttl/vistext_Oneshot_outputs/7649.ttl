:Chart7649 a schema:BarChart ;
    schema:title "Number of Royal Canadian Mounted Police officers in Canada in 2019 , by level of policing and province" ;
    :hasXAxisLabel "level of policing and province" ;
    :hasYAxisLabel "Federal and other policing" .

