@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart3824 a schema:BarChart ;
    schema:title "Many people have concerns or fears for their retirement . Which , if any , of the following concerns or fears do you have ?" ;
    :hasXAxisLabel "Fears and concerns" ;
    :hasYAxisLabel "Share of respondents" ;
    :yMin "0.0"^^xsd:decimal ;
    :yMax "0.6"^^xsd:decimal .

:DataPoint3824_1 a schema:DataPoint ;
    rdfs:label "Boredom" ;
    :xValue "Boredom" ;
    :yValue "0.25"^^xsd:decimal ;
    :valueEstimated "true" ;
    :belongsToChart :Chart3824 .

