@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart2080 a schema:BarChart ;
    schema:title "Average ticket price Dallas Stars (NHL) games from 2005/06 to 2014/15 (in U.S. dollars)" ;
    :hasXAxisLabel "Average ticket price in U.S. dollars" ;
    :hasYAxisLabel "Year" .

:DataPoint2080_1 a :DataPoint ;
    rdfs:label "05/06" ;
    :xValue "05/06" ;
    :yValue "25.0"^^xsd:decimal ;
    :valueEstimated "true" ;
    :belongsToChart :Chart2080 .

