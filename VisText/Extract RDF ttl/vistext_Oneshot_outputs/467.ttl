@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart467 a schema:BarChart ;
    schema:title "Number of registered LINE app users in selected countries as of October 2014 (in millions)" ;
    :hasXAxisLabel "Country" ;
    :hasYAxisLabel "Total registered users in millions" ;
    :yMin "0"^^xsd:decimal ;
    :yMax "50"^^xsd:decimal .

:DataPoint467_1 a schema:DataPoint ;
    rdfs:label "Columbia" ;
    :xValue "Columbia" ;
    :yValue "10"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean ;
    :belongsToChart :Chart467 .

:DataPoint467_2 a schema:DataPoint ;
    rdfs:label "India" ;
    :xValue "India" ;
    :yValue "15"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean ;
    :belongsToChart :Chart467 .

