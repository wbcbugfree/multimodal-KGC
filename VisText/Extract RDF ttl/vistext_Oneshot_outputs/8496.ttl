@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart8496 a schema:BarChart ;
    schema:title "Number of book readers in Italy in 2019 , by occupation and number of books read (in 1,000 readers)" ;
    :hasXAxisLabel "occupation" ;
    :hasYAxisLabel "From 1 to 3 books" .

:DataPoint8496_1 a schema:DataPoint ;
    rdfs:label "Blue collar, apprentice" ;
    :xValue "Blue collar, apprentice" ;
    :yValue "1300"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean ;
    :belongsToChart :Chart8496 .

:DataPoint8496_2 a schema:DataPoint ;
    rdfs:label "Executive, employer, professional" ;
    :xValue "Executive, employer, professional" ;
    :yValue "650"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean ;
    :belongsToChart :Chart8496 .

:DataPoint8496_3 a schema:DataPoint ;
    rdfs:label "Middle management, white collar" ;
    :xValue "Middle management, white collar" ;
    :yValue "1100"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean ;
    :belongsToChart :Chart8496 .

:DataPoint8496_4 a schema:DataPoint ;
    rdfs:label "Housewife" ;
    :xValue "Housewife" ;
    :yValue "2200"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean ;
    :belongsToChart :Chart8496 .

:DataPoint8496_5 a schema:DataPoint ;
    rdfs:label "Other condition" ;
    :xValue "Other condition" ;
    :yValue "200"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean ;
    :belongsToChart :Chart8496 .

:DataPoint8496_6 a schema:DataPoint ;
    rdfs:label "Retired" ;
    :xValue "Retired" ;
    :yValue "1500"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean ;
    :belongsToChart :Chart8496 .

:DataPoint8496_7 a schema:DataPoint ;
    rdfs:label "Self-employed, family worker" ;
    :xValue "Self-employed, family worker" ;
    :yValue "550"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean ;
    :belongsToChart :Chart8496 .

:DataPoint8496_8 a schema:DataPoint ;
    rdfs:label "Student" ;
    :xValue "Student" ;
    :yValue "1250"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean ;
    :belongsToChart :Chart8496 .

:DataPoint8496_9 a schema:DataPoint ;
    rdfs:label "Unemployed person with work ex..." ;
    :xValue "Unemployed person with work ex..." ;
    :yValue "750"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean ;
    :belongsToChart :Chart8496 .

:DataPoint8496_10 a schema:DataPoint ;
