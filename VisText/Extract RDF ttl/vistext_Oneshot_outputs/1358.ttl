@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <https://schema.org/> .

:Chart1358 a schema:BarChart ;
    schema:title "Israel : Total population from 2015 to 2025 (in million inhabitants)" ;
    :hasXAxisLabel "Inhabitants in millions" ;
    :hasYAxisLabel "Year" ;
    :xMin "0"^^xsd:decimal ;
    :xMax "10"^^xsd:decimal .

:DataPoint1358_1 a schema:DataPoint ;
    rdfs:label "2015" ;
    :xValue "2015" ;
    :yValue "8.5"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean ;
    :belongsToChart :Chart1358 .

