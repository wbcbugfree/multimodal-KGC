:Chart3450 a schema:BarChart ;
    schema:title "United States direct investments in the European Union , by industry in 2019 (in billion U.S. dollars)" ;
    :hasXAxisLabel "industry" ;
    :hasYAxisLabel "Direct investments in billion U.S. dollars" ;
    :yMin "0"^^xsd:decimal ;
    :yMax "2000"^^xsd:decimal .

