@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart6871 a schema:BarChart ;
    schema:title "Breakdown of U.S. online advertising revenue from 2010 to 2016 , by industry" ;
    :hasXAxisLabel "2010" ;
    :hasYAxisLabel "industry" .

:DataPoint6871_1 a schema:DataPoint ;
    rdfs:label "Auto" ;
    :xValue "Auto" ;
    :yValue "0.07"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean ;
    :belongsToChart :Chart6871 .

