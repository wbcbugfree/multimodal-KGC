@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart7072 a schema:LineChart ;
    schema:title "Number of justifiable homicides by law enforcement officers and private citizens in the United States from 2007 to 2019" ;
    :hasXAxisLabel "Year" ;
    :hasYAxisLabel "Private citizens" ;
    :yMin "0"^^xsd:decimal ;
    :yMax "400"^^xsd:decimal .

:DataPoint7072_1 :belongsToChart :Chart7072 ;
    rdfs:label "2007" ;
    :xValue "2007" ;
    :yValue "250.0"^^xsd:decimal ;
    :valueEstimated "true" .

