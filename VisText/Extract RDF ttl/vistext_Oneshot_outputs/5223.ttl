@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart5223 a schema:LineChart ;
    schema:title "Pig production in Malaysia from 2005 to 2018 (in million heads)" ;
    :hasXAxisLabel "Year" ;
    :hasYAxisLabel "Production in million heads" ;
    :xMin "2005" ;
    :xMax "2018" ;
    :yMin "0.0" ;
    :yMax "2.0" .

:DataPoint5223_1 a schema:DataPoint ;
    :belongsToChart :Chart5223 ;
    rdfs:label "2005" ;
    :xValue "2005" ;
    :yValue "2.05"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .

