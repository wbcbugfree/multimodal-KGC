@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart1500 a schema:LineChart ;
    schema:title "Annual net income of Telus Corporation from 2010 to 2019 (in million Canadian dollars)" ;
    :hasXAxisLabel "Year" ;
    :hasYAxisLabel "Net income in billion Canadian dollars" .

:DataPoint1500_1 a :DataPoint ;
    :belongsToChart :Chart1500 ;
    rdfs:label "2010" ;
    :xValue "2010" ;
    :yValue "1000.0"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .

