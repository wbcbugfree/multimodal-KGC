    :hasYAxisLabel "Automobile sales in thousand units" ;
    :xMin "2002"^^xsd:string ;
    :xMax "2020"^^xsd:string ;
    :yMin "0"^^xsd:decimal ;
    :yMax "5500"^^xsd:decimal .

