@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart694 a schema:BarChart ;
    schema:title "Leading 10 causes of death in lower-middle income countries worldwide in 2016 (in deaths per 100,000 population)" ;
    :hasXAxisLabel "Deaths per 100,000 population" ;
    :hasYAxisLabel "causes of death" ;
    :xMax "120"^^xsd:decimal ;
    :xMin "0"^^xsd:decimal .

:DataPoint694_1 a schema:DataPoint ;
    rdfs:label "Chronic obstructive pulmonary dis..." ;
    :xValue "20"^^xsd:decimal ;
    :yValue 1.0 ;
    :valueEstimated "true"^^xsd:boolean ;
    :belongsToChart :Chart694 .

