@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart1154 a schema:LineChart ;
    schema:title "Operating revenue of Endeavor Air from 2004 to 2019 (in million U.S. dollars)" ;
    :hasXAxisLabel "Year" ;
    :hasYAxisLabel "Revenue in million U.S. dollars" ;
    :xMin "2004" ;
    :xMax "2019" ;
    :yMin "0" ;
    :yMax "900" .

:DataPoint1154_1 :belongsToChart :Chart1154 ;
    rdfs:label "2004" ;
    :xValue "2004" ;
    :yValue "830.0"^^xsd:decimal ;
    :valueEstimated "true" .

