:Chart3864 a schema:BarChart ;
    schema:title "Most-affected countries and territories of explosive violence worldwide in 2013 , ranked by average civilian casualties per incident" ;
    :hasXAxisLabel "Country" ;
    :hasYAxisLabel "Civilian casualties per incident" ;
    :yMin "0"^^xsd:decimal ;
    :yMax "70"^^xsd:decimal .

