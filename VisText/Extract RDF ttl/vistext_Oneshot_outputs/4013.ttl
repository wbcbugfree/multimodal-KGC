@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart4013 a schema:LineChart ;
    schema:title "Boehringer Ingelheim 's expenditure on research and development as a percentage of revenue from 2004 to 2019" ;
    :hasXAxisLabel "Response" ;
    :hasYAxisLabel "Percentage of revenue" ;
    :xMin "2004" ;
    :xMax "2019" ;
    :yMin "0.00"^^xsd:decimal ;
    :yMax "0.20"^^xsd:decimal .

