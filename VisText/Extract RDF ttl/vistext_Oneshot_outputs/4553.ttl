@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart4553 a schema:BarChart ;
    schema:title "Average price of coffee in independent coffee shops in selected European cities in 2016" ;
    :hasXAxisLabel "Average price in euros" ;
    :hasYAxisLabel "city" ;
    :xMin "0"^^xsd:decimal ;
    :xMax "5"^^xsd:decimal .

