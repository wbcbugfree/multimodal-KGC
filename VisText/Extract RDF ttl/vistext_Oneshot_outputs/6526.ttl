@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart6526 a schema:BarChart ;
    schema:title "Monthly sales of over-the-counter (OTC) drugs , vitamins , herbal remedies and other health supplements at large retailers in Canada from January 2015 to April 2019 (in million Canadian dollars)" ;
    :hasXAxisLabel "Month" ;
    :hasYAxisLabel "" .

:DataPoint6526_1 a schema:DataPoint ;
    rdfs:label "Apr" ;
    :xValue "Apr" ;
    :yValue "158.0"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean ;
    :belongsToChart :Chart6526 .

