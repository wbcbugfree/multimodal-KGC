@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart6371 a schema:BarChart ;
    schema:title "Number of Burger King restaurants in the Asia Pacific region from 2012 to 2013 , by country or region" ;
    :hasXAxisLabel "Country" ;
    :hasYAxisLabel "2013" ;
    :yMin "0"^^xsd:decimal ;
    :yMax "400"^^xsd:decimal .

