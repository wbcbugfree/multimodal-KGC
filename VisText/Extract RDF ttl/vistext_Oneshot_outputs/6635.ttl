@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart6635 a schema:LineChart ;
    schema:title "Jordan : Age structure from 2009 to 2019" ;
    :hasXAxisLabel "Year" ;
    :hasYAxisLabel "0-14 years" ;
    :yMin "0.0"^^xsd:decimal ;
    :yMax "0.4"^^xsd:decimal .

:DataPoint6635_1 a schema:DataPoint ;
    :belongsToChart :Chart6635 ;
    rdfs:label "2010" ;
    :xValue "2010" ;
    :yValue "0.38"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .

:DataPoint6635_2 a schema:DataPoint ;
    :belongsToChart :Chart6635 ;
    rdfs:label "2012" ;
    :xValue "2012" ;
    :yValue "0.375"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .

:DataPoint6635_3 a schema:DataPoint ;
    :belongsToChart :Chart6635 ;
    rdfs:label "2014" ;
    :xValue "2014" ;
    :yValue "0.37"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .

:DataPoint6635_4 a schema:DataPoint ;
    :belongsToChart :Chart6635 ;
    rdfs:label "2016" ;
    :xValue "2016" ;
    :yValue "0.36"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .

:DataPoint6635_5 a schema:DataPoint ;
    :belongsToChart :Chart6635 ;
    rdfs:label "2018" ;
    :xValue "2018" ;
    :yValue "0.35"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .
