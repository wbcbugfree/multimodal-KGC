@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart5129 a schema:LineChart ;
    schema:title "Annual solar module production globally from 2000 to 2018 (in megawatts)" ;
    :hasXAxisLabel "Year" ;
    :hasYAxisLabel "Production in megawatts" ;
    :xMin "2000" ;
    :xMax "2018" ;
    :yMin "0" ;
    :yMax "120000" .

:DataPoint5129_1 a :Datapoint ;
    :belongsToChart :Chart5129 ;
    rdfs:label "2000" ;
    :xValue "2000" ;
    :yValue "1000"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .

