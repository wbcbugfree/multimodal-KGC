@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart7770 a schema:AreaChart ;
    schema:title "South Africa : Distribution of employment by economic sector from 2010 to 2020" ;
    :hasXAxisLabel "Year" ;
    :hasYAxisLabel "Industry" ;
    :xMin "2010"^^xsd:string ;
    :xMax "2020"^^xsd:string ;
    :yMin "0.00"^^xsd:decimal ;
    :yMax "0.25"^^xsd:decimal .

:DataPoint7770_1 :belongsToChart :Chart7770 ;
    rdfs:label "2010" ;
    :xValue "2010" ;
    :yValue "0.247"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .

