@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart4440 a schema:BarChart ;
    schema:title "Latin American passports with the most visa free access to other countries as of July 2020 (visa free score)" ;
    :hasXAxisLabel "Visa free score*" ;
    :hasYAxisLabel "Country" .

:DataPoint4440_1 a :DataPoint ;
    rdfs:label "Argentina" ;
    :xValue "Argentina" ;
    :yValue "160"^^xsd:decimal ;
    :valueEstimated "true" ;
    :belongsToChart :Chart4440 .

