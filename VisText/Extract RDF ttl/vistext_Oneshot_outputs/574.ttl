@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart574 a schema:BarChart ;
    schema:title "Annual volume of cranberries and blueberries sold in the United Kingdom (UK) from 2008 to 2018 (in 1,000 tonnes)" ;
    :hasXAxisLabel "Sales volume in thousand tonnes" ;
    :hasYAxisLabel "Year" ;
    :yMin "2008" ;
    :yMax "2018" .

:DataPoint574_1 a schema:DataPoint ;
    rdfs:label "2008" ;
    :xValue "3.5"^^xsd:decimal ;
    :yValue 2008 ;
    :valueEstimated "true"^^xsd:boolean ;
    :belongsToChart :Chart574 .

:DataPoint574_2 a schema:DataPoint ;
    rdfs:label "2009" ;
    :xValue "4.5"^^xsd:decimal ;
    :yValue 2009 ;
    :valueEstimated "true"^^xsd:boolean ;
    :belongsToChart :Chart574 .

