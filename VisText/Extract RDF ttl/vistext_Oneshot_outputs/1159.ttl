@prefix schema: <https://schema.org/> .

:Chart1159 a schema:LineChart ;
    schema:title "Euro (EUR) to Polish zloty (PLN) annual average exchange rate from 1999 to 2018" ;
    :hasXAxisLabel "Year" ;
    :hasYAxisLabel "Exchange rate" ;
    :xMin "1999" ;
    :xMax "2018" ;
    :yMin "0" ;
    :yMax "5" .

:DataPoint1159_1 a :Datapoint ;
    :belongsToChart :Chart1159 ;
    rdfs:label "2000" ;
    :xValue "2000" ;
    :yValue "4.1"^^xsd:decimal ;
    :valueEstimated "true" .

