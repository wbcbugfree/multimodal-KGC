@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart6581 a schema:LineChart ;
    schema:title "Iraq : Distribution of employment by economic sector from 2010 to 2020" ;
    :hasXAxisLabel "Year" ;
    :hasYAxisLabel "Services" ;
    :xMin "2010" ;
    :xMax "2020" ;
    :yMin "0.0"^^xsd:decimal ;
    :yMax "0.6"^^xsd:decimal .

:DataPoint6581_1 a :DataPoint ;
    :belongsToChart :Chart6581 ;
    rdfs:label "2010" ;
    :xValue "2010" ;
    :yValue "0.55"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .

:DataPoint6581_2 a :DataPoint ;
    :belongsToChart :Chart6581 ;
    rdfs:label "2012" ;
    :xValue "2012" ;
    :yValue "0.56"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .

:DataPoint6581_3 a :DataPoint ;
    :belongsToChart :Chart6581 ;
    rdfs:label "2014" ;
    :xValue "2014" ;
    :yValue "0.57"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .

:DataPoint6581_4 a :DataPoint ;
    :belongsToChart :Chart6581 ;
    rdfs:label "2016" ;
    :xValue "2016" ;
    :yValue "0.58"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .

:DataPoint6581_5 a :DataPoint ;
    :belongsToChart :Chart6581 ;
    rdfs:label "2018" ;
    :xValue "2018" ;
    :yValue "0.59"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .

:DataPoint6581_6 a :DataPoint ;
    :belongsToChart :Chart6581 ;
    rdfs:label "2020" ;
    :xValue "2020" ;
    :yValue "0.60"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .
