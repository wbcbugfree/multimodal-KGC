@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart170 a schema:LineChart ;
    schema:title "Laos : Infant mortality rate from 2009 to 2019 (in deaths per 1,000 live births)" ;
    :hasXAxisLabel "Year" ;
    :hasYAxisLabel "Deaths per 1,000 live births" ;
    :yMin "0"^^xsd:decimal ;
    :yMax "50"^^xsd:decimal .

:DataPoint170_1 a :DataPoint ;
    :belongsToChart :Chart170 ;
    rdfs:label "2010" ;
    :xValue "2010" ;
    :yValue "52.5"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .

:DataPoint170_2 a :DataPoint ;
    :belongsToChart :Chart170 ;
    rdfs:label "2012" ;
    :xValue "2012" ;
    :yValue "47.5"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .

:DataPoint170_3 a :DataPoint ;
    :belongsToChart :Chart170 ;
    rdfs:label "2014" ;
    :xValue "2014" ;
    :yValue "44.0"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .

:DataPoint170_4 a :DataPoint ;
    :belongsToChart :Chart170 ;
    rdfs:label "2016" ;
    :xValue "2016" ;
    :yValue "41.0"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .

:DataPoint170_5 a :DataPoint ;
    :belongsToChart :Chart170 ;
    rdfs:label "2018" ;
    :xValue "2018" ;
    :yValue "37.5"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .
