@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart757 a schema:LineChart ;
    schema:title "Toronto Blue Jays average ticket price from 2006 to 2019 (in U.S. dollars)" ;
    :hasXAxisLabel "Year" ;
    :hasYAxisLabel "Average ticket price in U.S. dollars" ;
    :xMin "2006" ;
    :xMax "2018" ;
    :yMin "0"^^xsd:decimal ;
    :yMax "35"^^xsd:decimal .

:DataPoint757_1 :belongsToChart :Chart757 ;
    rdfs:label "2006" ;
    :xValue "2006" ;
    :yValue "23.0"^^xsd:decimal ;
    :valueEstimated "true" .

:DataPoint757_2 :belongsToChart :Chart757 ;
    rdfs:label "2008" ;
    :xValue "2008" ;
    :yValue "28.5"^^xsd:decimal ;
    :valueEstimated "true" .

:DataPoint757_3 :belongsToChart :Chart757 ;
    rdfs:label "2010" ;
    :xValue "2010" ;
    :yValue "19.0"^^xsd:decimal ;
    :valueEstimated "true" .

:DataPoint757_4 :belongsToChart :Chart757 ;
    rdfs:label "2012" ;
    :xValue "2012" ;
    :yValue "24.5"^^xsd:decimal ;
    :valueEstimated "true" .

:DataPoint757_5 :belongsToChart :Chart757 ;
    rdfs:label "2014" ;
    :xValue "2014" ;
    :yValue "23.0"^^xsd:decimal ;
    :valueEstimated "true" .

:DataPoint757_6 :belongsToChart :Chart757 ;
    rdfs:label "2016" ;
    :xValue "2016" ;
    :yValue "25.0"^^xsd:decimal ;
    :valueEstimated "true" .

:DataPoint757_7 :belongsToChart :Chart757 ;
    rdfs:label "2018" ;
    :xValue "2018" ;
    :yValue "30.0"^^xsd:decimal ;
    :valueEstimated "true" .

:DataPoint757_8 :belongsToChart :Chart757 ;
    rdfs:label "2019" ;
    :xValue "2019" ;
    :yValue "29.5"^^xsd:decimal ;
    :valueEstimated "true" .
