@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart1330 a schema:BarChart ;
    schema:title "Libya : Total population from 2015 to 2025 (in million inhabitants)" ;
    :hasXAxisLabel "Inhabitants in millions" ;
    :hasYAxisLabel "Year" .

:DataPoint1330_1 a :DataPoint ;
    :belongsToChart :Chart1330 ;
    rdfs:label "2015" ;
    :xValue "6.5"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .

