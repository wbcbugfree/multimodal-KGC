@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart4052 a schema:BarChart ;
    schema:title "Net sales growth of the world 's leading 10 consumer products companies in 2013" ;
    :hasXAxisLabel "Company (Country of origin)" ;
    :hasYAxisLabel "Net sales growth" ;
    :yMin "0.00"^^xsd:decimal ;
    :yMax "0.20"^^xsd:decimal .

:DataPoint4052_1 a schema:DataPoint ;
    rdfs:label "Apple (United States)" ;
    :xValue "Apple (United States)" ;
    :yValue "0.095"^^xsd:decimal ;
    :valueEstimated "true" ;
    :belongsToChart :Chart4052 .

