@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart4766 a schema:LineChart ;
    schema:title "Norway : Urbanization from 2009 to 2019" ;
    :hasXAxisLabel "Response" ;
    :hasYAxisLabel "Share of urban population in total population" ;
    :xMin "2009"^^xsd:decimal ;
    :xMax "2019"^^xsd:decimal ;
    :yMin "0.0"^^xsd:decimal ;
    :yMax "1.0"^^xsd:decimal .

:DataPoint4766_1 a schema:DataPoint ;
    rdfs:label "2009" ;
    :xValue "2009" ;
    :yValue "0.8"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean ;
    :belongsToChart :Chart4766 .

