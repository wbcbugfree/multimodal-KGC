@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart8702 a schema:BarChart ;
    schema:title "Number of coronavirus (COVID-19) cases , recoveries , and deaths among the most impacted countries worldwide as of December 22 , 2020" ;
    :hasXAxisLabel "Recoveries" ;
    :hasYAxisLabel "Country" ;
    :xMin "0"^^xsd:decimal ;
    :xMax "50000000"^^xsd:decimal .

:DataPoint8702_1 a :DataPoint ;
    rdfs:label "Argentina" ;
    :xValue "1000000"^^xsd:decimal ;
    :yValue 1.0 ;
    :valueEstimated "true" ;
    :belongsToChart :Chart8702 .

