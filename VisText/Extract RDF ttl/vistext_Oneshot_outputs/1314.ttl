@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart1314 a schema:LineChart ;
    schema:title "Number of Volkswagen Golf registered cars in Great Britain from 2000 to 2018" ;
    :hasXAxisLabel "Year" ;
    :hasYAxisLabel "Number of registered cars" ;
    :xMin "2000" ;
    :xMax "2018" ;
    :yMin "0" ;
    :yMax "1000000" .

:DataPoint1314_1 a schema:DataPoint ;
    :belongsToChart :Chart1314 ;
    rdfs:label "2000" ;
    :xValue "2000" ;
    :yValue "650000.0"^^xsd:decimal ;
    :valueEstimated "true" .

