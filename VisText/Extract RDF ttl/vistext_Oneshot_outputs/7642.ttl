@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart7642 a schema:LineChart ;
    schema:title "Total population in Denmark from 2010 to 2020 , by age group (in millions)" ;
    :hasXAxisLabel "Year" ;
    :hasYAxisLabel "80 years and older" ;
    :yMin "0.00"^^xsd:decimal ;
    :yMax "0.28"^^xsd:decimal .

:DataPoint7642_1 a :DataPoint ;
    :belongsToChart :Chart7642 ;
    rdfs:label "2010" ;
    :xValue "2010" ;
    :yValue "0.235"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .

:DataPoint7642_2 a :DataPoint ;
    :belongsToChart :Chart7642 ;
    rdfs:label "2012" ;
    :xValue "2012" ;
    :yValue "0.238"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .

:DataPoint7642_3 a :DataPoint ;
    :belongsToChart :Chart7642 ;
    rdfs:label "2014" ;
    :xValue "2014" ;
    :yValue "0.242"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .

:DataPoint7642_4 a :DataPoint ;
    :belongsToChart :Chart7642 ;
    rdfs:label "2016" ;
    :xValue "2016" ;
    :yValue "0.247"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .

:DataPoint7642_5 a :DataPoint ;
    :belongsToChart :Chart7642 ;
    rdfs:label "2018" ;
    :xValue "2018" ;
    :yValue "0.255"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .

:DataPoint7642_6 a :DataPoint ;
    :belongsToChart :Chart7642 ;
    rdfs:label "2020" ;
    :xValue "2020" ;
    :yValue "0.265"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .
