@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <https://schema.org/> .

:Chart7048 a schema:LineChart ;
    schema:title "Revenue of the InterContinental Hotels Group (IHG) from 2008 to 2019 , by hotel ownership type (in million U.S. dollars)" ;
    :hasXAxisLabel "Year" ;
    :hasYAxisLabel "Franchised hotels" ;
    :yMin "0"^^xsd:decimal ;
    :yMax "900"^^xsd:decimal .

:DataPoint7048_1 :belongsToChart :Chart7048 ;
    rdfs:label "2008" ;
    :xValue "2008" ;
    :yValue "620.0"^^xsd:decimal ;
    :valueEstimated "true" .

:DataPoint7048_2 :belongsToChart :Chart7048 ;
    rdfs:label "2010" ;
    :xValue "2010" ;
    :yValue "550.0"^^xsd:decimal ;
    :valueEstimated "true" .

:DataPoint7048_3 :belongsToChart :Chart7048 ;
    rdfs:label "2012" ;
    :xValue "2012" ;
    :yValue "600.0"^^xsd:decimal ;
    :valueEstimated "true" .

:DataPoint7048_4 :belongsToChart :Chart7048 ;
    rdfs:label "2014" ;
    :xValue "2014" ;
    :yValue "750.0"^^xsd:decimal ;
    :valueEstimated "true" .

:DataPoint7048_5 :belongsToChart :Chart7048 ;
    rdfs:label "2016" ;
    :xValue "2016" ;
    :yValue "820.0"^^xsd:decimal ;
    :valueEstimated "true" .

:DataPoint7048_6 :belongsToChart :Chart7048 ;
