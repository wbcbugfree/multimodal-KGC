@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart3768 a schema:BarChart ;
    schema:title "Number of bakery product manufacturing establishments in Canada as of December 2019 , by region" ;
    :hasXAxisLabel "region of Canada" ;
    :hasYAxisLabel "Number of establishments" ;
    :yMin "0"^^xsd:decimal ;
    :yMax "900"^^xsd:decimal .

:DataPoint3768_1 a schema:DataPoint ;
    :belongsToChart :Chart3768 ;
    rdfs:label "Alberta" ;
    :xValue "Alberta" ;
    :yValue "175"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .

