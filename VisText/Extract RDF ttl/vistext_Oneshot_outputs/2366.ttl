@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart2366 a schema:BarChart ;
    schema:title "From the following list , please pick the five main environmental issues that you are worried about ." ;
    :hasXAxisLabel "Share of respondents" ;
    :hasYAxisLabel "Response" .

:DataPoint2366_1 a schema:DataPoint ;
    rdfs:label "Agricultural pollution (use of pesticides...)" ;
    :yValue "0.25"^^xsd:decimal ;
    :valueEstimated "true" ;
    :belongsToChart :Chart2366 .

:DataPoint2366_2 a schema:DataPoint ;
    rdfs:label "Air pollution" ;
    :yValue "0.45"^^xsd:decimal ;
    :valueEstimated "true" ;
    :belongsToChart :Chart2366 .

:DataPoint2366_3 a schema:DataPoint ;
    rdfs:label "Depletion of natural resources" ;
    :yValue "0.35"^^xsd:decimal ;
    :valueEstimated "true" ;
    :belongsToChart :Chart2366 .

:DataPoint2366_4 a schema:DataPoint ;
    rdfs:label "Loss or extinction of species and t..." ;
    :yValue "0.25"^^xsd:decimal ;
    :valueEstimated "true" ;
    :belongsToChart :Chart2366 .

:DataPoint2366_5 a schema:DataPoint ;
    rdfs:label "Our consumption habits" ;
    :yValue "0.25"^^xsd:decimal ;
    :valueEstimated "true" ;
    :belongsToChart :Chart2366 .

:DataPoint2366_6 a schema:DataPoint ;
    rdfs:label "Shortage of drinking water" ;
    :yValue "0.30"^^xsd:decimal ;
    :valueEstimated "true" ;
    :belongsToChart :Chart2366 .

:DataPoint2366_7 a schema:DataPoint ;
    rdfs:label "The growing amount of waste" ;
    :yValue "0.50"^^xsd:decimal ;
    :valueEstimated "true" ;
    :belongsToChart :Chart2366 .

:DataPoint2366_8 a schema:DataPoint ;
    rdfs:label "The impact on our health of chemi..." ;
    :yValue "0.40"^^xsd:decimal ;
    :valueEstimated "true" ;
    :belongsToChart :Chart2366 .

:DataPoint2366_9 a schema:DataPoint ;
    rdfs:label "Urban problems (traffic jams, poll..." ;
    :yValue "0.20"^^xsd:decimal ;
    :valueEstimated "true" ;
    :belongsToChart :Chart2366 .

:DataPoint2366_10 a schema:DataPoint ;
    rdfs:label "Water pollution (seas, rivers, lakes..." ;
    :yValue "0.50"^^xsd:decimal ;
    :valueEstimated "true" ;
    :belongsToChart :Chart2366 .
