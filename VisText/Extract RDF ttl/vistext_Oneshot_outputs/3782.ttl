@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart3782 a schema:CreativeWork ;
    schema:title "U.S. electric capacity resources for the SERC region during the summer peak period between 1998 and 2010 (in megawatts)" ;
    :hasXAxisLabel "Year" ;
    :hasYAxisLabel "Capacity resources in megawatts" .

:DataPoint3782_1 a :DataPoint ;
    :belongsToChart :Chart3782 ;
    rdfs:label "1998" ;
    :xValue "1998" ;
    :yValue "125000.0"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .

