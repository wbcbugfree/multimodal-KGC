@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart3295 a schema:AreaChart ;
    schema:title "Producer price index of metal cutting machine tools in the U.S. from 1990 to 2010" ;
    :hasXAxisLabel "Year" ;
    :hasYAxisLabel "Producer price index" ;
    :xMin "1990"^^xsd:string ;
    :xMax "2010"^^xsd:string ;
    :yMin "0"^^xsd:decimal ;
    :yMax "180"^^xsd:decimal .

:DataPoint3295_1 :belongsToChart :Chart3295 ;
    rdfs:label "1990" ;
    :xValue "1990" ;
    :yValue "130.0"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .

:DataPoint3295_2 :belongsToChart :Chart3295 ;
    rdfs:label "1995" ;
    :xValue "1995" ;
    :yValue "145.0"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .

:DataPoint3295_3 :belongsToChart :Chart3295 ;
    rdfs:label "2000" ;
    :xValue "2000" ;
    :yValue "158.0"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .

:DataPoint3295_4 :belongsToChart :Chart3295 ;
    rdfs:label "2005" ;
    :xValue "2005" ;
    :yValue "150.0"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .

:DataPoint3295_5 :belongsToChart :Chart3295 ;
    rdfs:label "2010" ;
    :xValue "2010" ;
    :yValue "175.0"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .
