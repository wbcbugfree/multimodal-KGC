@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart321 a schema:BarChart ;
    schema:title "Distribution of Amazon Dash button sales as of February 2016 , by brand" ;
    :hasXAxisLabel "Response" ;
    :hasYAxisLabel "Share of Amazon Dash Button sales" ;
    :yMin "0.00"^^xsd:decimal ;
    :yMax "0.25"^^xsd:decimal .

:DataPoint321_1 a schema:DataPoint ;
    rdfs:label "Bounty" ;
    :xValue "Bounty" ;
    :yValue "0.17"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean ;
    :belongsToChart :Chart321 .

:DataPoint321_2 a schema:DataPoint ;
    rdfs:label "Cottonelle" ;
    :xValue "Cottonelle" ;
    :yValue "0.21"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean ;
    :belongsToChart :Chart321 .

:DataPoint321_3 a schema:DataPoint ;
    rdfs:label "Gatorade" ;
    :xValue "Gatorade" ;
    :yValue "0.07"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean ;
    :belongsToChart :Chart321 .

:DataPoint321_4 a schema:DataPoint ;
    rdfs:label "Gillette" ;
    :xValue "Gillette" ;
    :yValue "0.05"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean ;
    :belongsToChart :Chart321 .

:DataPoint321_5 a schema:DataPoint ;
    rdfs:label "Glad" ;
    :xValue "Glad" ;
    :yValue "0.12"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean ;
    :belongsToChart :Chart321 .

:DataPoint321_6 a schema:DataPoint ;
    rdfs:label "Huggies" ;
    :xValue "Huggies" ;
    :yValue "0.035"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean ;
    :belongsToChart :Chart321 .

:DataPoint321_7 a schema:DataPoint ;
    rdfs:label "Mrs. Meyer's" ;
    :xValue "Mrs. Meyer's" ;
    :yValue "0.055"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean ;
    :belongsToChart :Chart321 .

:DataPoint321_8 a schema:DataPoint ;
    rdfs:label "Smartwaiter" ;
    :xValue "Smartwaiter" ;
    :yValue "0.045"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean ;
    :belongsToChart :Chart321 .

:DataPoint321_9 a schema:DataPoint ;
    rdfs:label "Tide" ;
    :xValue "Tide" ;
    :yValue "0.22"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean ;
    :belongsToChart :Chart321 .

:DataPoint321_10 a schema:DataPoint ;
    rdfs:label "Ziploc" ;
    :xValue "Ziploc" ;
    :yValue "0.04"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean ;
    :belongsToChart :Chart321 .
