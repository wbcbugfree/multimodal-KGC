@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <https://schema.org/> .

:Chart7845 a schema:BarChart ;
    schema:title "Number of McColl 's stores in the United Kingdom (UK) as of 2019 , by type and region" ;
    :hasXAxisLabel "Newsagent" ;
    :hasYAxisLabel "region of the United Kingdom" .

:DataPoint7845_1 a schema:DataPoint ;
    rdfs:label "East Midlands" ;
    :xValue "East Midlands" ;
    :yValue 10.0^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean ;
    :belongsToChart :Chart7845 .

