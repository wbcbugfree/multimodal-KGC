@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart3778 a schema:BarChart ;
    :hasXAxisLabel "city" ;
    :hasYAxisLabel "Number of workforce jobs in thousands" ;
    :yMin "0"^^xsd:decimal ;
    :yMax "800"^^xsd:decimal .

:DataPoint3778_1 a schema:DataPoint ;
    :belongsToChart :Chart3778 ;
    rdfs:label "East Midlands" ;
    :xValue "East Midlands" ;
    :yValue "400"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .

