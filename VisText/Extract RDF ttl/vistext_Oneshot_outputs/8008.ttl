    :yValue 0.000^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean ;
    :belongsToChart :Chart8008 .

:DataPoint8008_9 a schema:DataPoint ;
    rdfs:label "8 episodes" ;
