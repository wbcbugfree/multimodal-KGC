@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart8008 a schema:BarChart ;
    schema:title "Preferred number of TV show episodes to watch in one binge watching session among Generation X and Baby Boomers in the United Kingdom (UK) in December 2016" ;
    :hasXAxisLabel "60 years and older" ;
    :hasYAxisLabel "Response" .

:DataPoint8008_1 a schema:DataPoint ;
    rdfs:label "1 episode" ;
    :xValue "1 episode" ;
    :yValue 0.025^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean ;
    :belongsToChart :Chart8008 .

:DataPoint8008_2 a schema:DataPoint ;
    rdfs:label "10 episodes" ;
    :xValue "10 episodes" ;
    :yValue 0.130^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean ;
    :belongsToChart :Chart8008 .

