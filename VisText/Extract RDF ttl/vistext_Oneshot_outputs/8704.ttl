@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart8704 a schema:LineChart ;
    schema:title "Population in Norway from 2010 to 2020 , by age group (in millions)" ;
    :hasXAxisLabel "Year" ;
    :hasYAxisLabel "35-44 years" .

:DataPoint8704_1 :belongsToChart :Chart8704 ;
    rdfs:label "2010" ;
    :xValue "2010" ;
    :yValue "0.73"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .

:DataPoint8704_2 :belongsToChart :Chart8704 ;
    rdfs:label "2012" ;
    :xValue "2012" ;
    :yValue "0.72"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .

:DataPoint8704_3 :belongsToChart :Chart8704 ;
    rdfs:label "2014" ;
    :xValue "2014" ;
    :yValue "0.71"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .

:DataPoint8704_4 :belongsToChart :Chart8704 ;
    rdfs:label "2016" ;
    :xValue "2016" ;
    :yValue "0.70"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .

:DataPoint8704_5 :belongsToChart :Chart8704 ;
    rdfs:label "2018" ;
    :xValue "2018" ;
    :yValue "0.69"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .

:DataPoint8704_6 :belongsToChart :Chart8704 ;
    rdfs:label "2020" ;
    :xValue "2020" ;
    :yValue "0.68"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .
