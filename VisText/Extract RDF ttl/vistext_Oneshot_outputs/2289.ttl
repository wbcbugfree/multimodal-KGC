@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart2289 a schema:LineChart ;
    schema:title "Average annual expenditure on delivery services per consumer unit in the United States from 2007 to 2019 (in U.S. dollars)" ;
    :hasXAxisLabel "Year" ;
    :hasYAxisLabel "Average annual expenditure in U.S. dollars" ;
    :xMin "2007" ;
    :xMax "2019" ;
    :yMin "0"^^xsd:decimal ;
    :yMax "9"^^xsd:decimal .

:DataPoint2289_1 a schema:DataPoint ;
    rdfs:label "2007" ;
    :xValue "2007" ;
    :yValue "3.0"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean ;
    :belongsToChart :Chart2289 .

