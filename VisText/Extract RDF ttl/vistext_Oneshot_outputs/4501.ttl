@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart4501 a schema:BarChart ;
    schema:title "Leading markets based on Tinder iOS revenue in 3rd quarter 2020 (in million U.S. dollars)" ;
    :hasXAxisLabel "Country" ;
    :hasYAxisLabel "Revenue in million U.S. dollars" ;
    :yMin "0"^^xsd:decimal ;
    :yMax "12"^^xsd:decimal .

:DataPoint4501_1 a :DataPoint ;
    :belongsToChart :Chart4501 ;
    rdfs:label "Australia" ;
    :xValue "Australia" ;
    :yValue "1.3"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .

:DataPoint4501_2 a :DataPoint ;
    :belongsToChart :Chart4501 ;
    rdfs:label "Brazil" ;
    :xValue "Brazil" ;
    :yValue "3.5"^^xsd:decimal ;
