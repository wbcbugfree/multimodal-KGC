@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart1905 a schema:AreaChart ;
    schema:title "Population of the Tampa-St. Petersburg-Clearwater metro area in the United States from 2010 to 2019" ;
    :hasXAxisLabel "Year" ;
    :hasYAxisLabel "Number of residents" ;
    :yMin "0"^^xsd:decimal ;
    :yMax "3000000"^^xsd:decimal .

:DataPoint1905_1 a schema:DataPoint ;
    rdfs:label "2010" ;
    :xValue "2010" ;
    :yValue "2200000"^^xsd:decimal ;
    :valueEstimated "true" ;
    :belongsToChart :Chart1905 .

:DataPoint1905_2 a schema:DataPoint ;
    rdfs:label "2012" ;
    :xValue "2012" ;
    :yValue "2250000"^^xsd:decimal ;
    :valueEstimated "true" ;
    :belongsToChart :Chart1905 .

:DataPoint1905_3 a schema:DataPoint ;
    rdfs:label "2014" ;
    :xValue "2014" ;
    :yValue "2400000"^^xsd:decimal ;
    :valueEstimated "true" ;
    :belongsToChart :Chart1905 .

:DataPoint1905_4 a schema:DataPoint ;
    rdfs:label "2016" ;
    :xValue "2016" ;
    :yValue "2600000"^^xsd:decimal ;
    :valueEstimated "true" ;
    :belongsToChart :Chart1905 .

:DataPoint1905_5 a schema:DataPoint ;
    rdfs:label "2018" ;
    :xValue "2018" ;
    :yValue "2800000"^^xsd:decimal ;
    :valueEstimated "true" ;
    :belongsToChart :Chart1905 .

:DataPoint1905_6 a schema:DataPoint ;
    rdfs:label "2019" ;
    :xValue "2019" ;
    :yValue "2900000"^^xsd:decimal ;
    :valueEstimated "true" ;
    :belongsToChart :Chart1905 .
