@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart1902 a schema:BarChart ;
    schema:title "Number of permanent resident refugees in Canada admitted in 2019 , by province or territory" ;
    :hasXAxisLabel "province of Canada" ;
    :hasYAxisLabel "Number of resident refugees" ;
    :yMin "0"^^xsd:decimal ;
    :yMax "25000"^^xsd:decimal .

:DataPoint1902_1 a schema:DataPoint ;
    rdfs:label "Alberta" ;
    :xValue "Alberta" ;
    :yValue "5000"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean ;
    :belongsToChart :Chart1902 .

:DataPoint1902_2 a schema:DataPoint ;
    rdfs:label "British Columbia" ;
    :xValue "British Columbia" ;
    :yValue "3000"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean ;
    :belongsToChart :Chart1902 .

