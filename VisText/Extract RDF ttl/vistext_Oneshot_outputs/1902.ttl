:DataPoint1902_7 a schema:DataPoint ;
    rdfs:label "Ontario" ;
    :xValue "Ontario" ;
    :yValue "23000"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean ;
    :belongsToChart :Chart1902 .

:DataPoint1902_8 a schema:DataPoint ;
    rdfs:label "Prince Edward Island" ;
    :xValue "Prince Edward Island" ;
    :yValue "0"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean ;
    :belongsToChart :Chart1902 .

:DataPoint1902_9 a schema:DataPoint ;
    rdfs:label "Quebec" ;
    :xValue "Quebec" ;
    :yValue "5000"^^xsd:decimal ;
