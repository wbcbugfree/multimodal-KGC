@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart3713 a schema:BarChart ;
    schema:title "Belgium : Employment from 2010 to 2020 (in millions)" ;
    :hasXAxisLabel "Year" ;
    :hasYAxisLabel "Employment in millions" ;
    :yMin "0"^^xsd:decimal ;
    :yMax "5"^^xsd:decimal .

:DataPoint3713_1 a schema:DataPoint ;
    rdfs:label "2010" ;
    :xValue "2010" ;
    :yValue "4.5"^^xsd:decimal ;
    :valueEstimated "true" ;
    :belongsToChart :Chart3713 .

