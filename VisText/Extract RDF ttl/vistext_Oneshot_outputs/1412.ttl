@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart1412 a schema:BarChart ;
    schema:title "Encounter rate trends for the locations with the most computers reporting malware detections as of 2nd quarter 2016" ;
    :hasXAxisLabel "Encounter and detection rate" ;
    :hasYAxisLabel "Country" ;
    :xMin "0.00"^^xsd:decimal ;
    :xMax "0.30"^^xsd:decimal .

:DataPoint1412_1 a schema:DataPoint ;
    rdfs:label "Brazil" ;
    :xValue "Brazil" ;
    :yValue "0.24"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean ;
    :belongsToChart :Chart1412 .

