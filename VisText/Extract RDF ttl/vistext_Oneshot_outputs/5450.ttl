@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart5450 a schema:LineChart ;
    schema:title "Number of jobs in the wind energy industry worldwide from 2009 to 2019 (in 1,000s)" ;
    :hasXAxisLabel "Year" ;
    :hasYAxisLabel "Number of jobs in thousands" .

:DataPoint5450_1 a schema:DataPoint ;
    :belongsToChart :Chart5450 ;
    rdfs:label "2009" ;
    :xValue "2009" ;
    :yValue "400"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .

