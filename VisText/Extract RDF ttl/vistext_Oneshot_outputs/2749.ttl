@prefix schema:<https://schema.org/> .

:Chart2749 a schema:LineChart ;
    schema:title "Amount of money invested in rail transport infrastructure in Denmark from 2004 to 2016 (in million euros)" ;
    :hasXAxisLabel "Year" ;
    :hasYAxisLabel "Millions of euros invested" ;
    :xMin "2004" ;
    :xMax "2016" ;
    :yMin "0" ;
    :yMax "1400" .

