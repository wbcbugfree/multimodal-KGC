@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart6856 a schema:LineChart ;
    schema:title "Total population of Peru from 2008 to 2018 , by gender (in million inhabitants)" ;
    :hasXAxisLabel "Year" ;
    :hasYAxisLabel "in million inhabitants" ;
    :yMin "0"^^xsd:decimal ;
    :yMax "15"^^xsd:decimal .

:DataPoint6856_1 a schema:DataPoint ;
    rdfs:label "Male" ;
    :xValue "2008" ;
    :yValue "14.5"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean ;
    :belongsToChart :Chart6856 .

:DataPoint6856_2 a schema:DataPoint ;
    rdfs:label "Male" ;
    :xValue "2010" ;
    :yValue "14.7"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean ;
    :belongsToChart :Chart6856 .

:DataPoint6856_3 a schema:DataPoint ;
    rdfs:label "Male" ;
    :xValue "2012" ;
    :yValue "14.9"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean ;
    :belongsToChart :Chart6856 .

:DataPoint6856_4 a schema:DataPoint ;
    rdfs:label "Male" ;
    :xValue "2014" ;
    :yValue "15.1"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean ;
    :belongsToChart :Chart6856 .

:DataPoint6856_5 a schema:DataPoint ;
    rdfs:label "Male" ;
    :xValue "2016" ;
    :yValue "15.3"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean ;
    :belongsToChart :Chart6856 .

:DataPoint6856_6 a schema:DataPoint ;
    rdfs:label "Male" ;
    :xValue "2018" ;
    :yValue "15.5"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean ;
    :belongsToChart :Chart6856 .
