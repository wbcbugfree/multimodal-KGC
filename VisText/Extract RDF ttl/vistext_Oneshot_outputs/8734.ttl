@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart8734 a schema:LineChart ;
    schema:title "Poland : Distribution of employment by economic sector from 2010 to 2020" ;
    :hasXAxisLabel "Year" ;
    :hasYAxisLabel "Services" ;
    :yMin "0.0"^^xsd:decimal ;
    :yMax "0.6"^^xsd:decimal .

:DataPoint8734_1 a :Datapoint ;
    :belongsToChart :Chart8734 ;
    rdfs:label "2010" ;
    :xValue "2010" ;
    :yValue "0.55"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .

:DataPoint8734_2 a :Datapoint ;
    :belongsToChart :Chart8734 ;
    rdfs:label "2012" ;
    :xValue "2012" ;
    :yValue "0.56"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .

:DataPoint8734_3 a :Datapoint ;
    :belongsToChart :Chart8734 ;
    rdfs:label "2014" ;
    :xValue "2014" ;
    :yValue "0.57"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .

:DataPoint8734_4 a :Datapoint ;
    :belongsToChart :Chart8734 ;
    rdfs:label "2016" ;
    :xValue "2016" ;
    :yValue "0.58"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .

:DataPoint8734_5 a :Datapoint ;
    :belongsToChart :Chart8734 ;
    rdfs:label "2018" ;
    :xValue "2018" ;
    :yValue "0.59"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .

:DataPoint8734_6 a :Datapoint ;
    :belongsToChart :Chart8734 ;
    rdfs:label "2020" ;
    :xValue "2020" ;
    :yValue "0.60"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .
