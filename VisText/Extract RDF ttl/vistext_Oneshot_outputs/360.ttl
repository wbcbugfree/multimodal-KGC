@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart360 a schema:LineChart ;
    schema:title "Number of road traffic fatalities in Slovenia from 2006 to 2019" ;
    :hasXAxisLabel "Year" ;
    :hasYAxisLabel "Number of fatalities" ;
    :xMin "2006" ;
    :xMax "2018" ;
    :yMin "0"^^xsd:decimal ;
    :yMax "300"^^xsd:decimal .

:DataPoint360_1 a :DataPoint ;
    :belongsToChart :Chart360 ;
    rdfs:label "2006" ;
    :xValue "2006" ;
    :yValue "260.0"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .

