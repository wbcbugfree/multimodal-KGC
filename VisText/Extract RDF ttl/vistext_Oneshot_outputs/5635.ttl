@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart5635 a schema:BarChart ;
    schema:title "Monthly number of unemployed persons in the U.S. from November 2019 to November 2020 (in millions , adjusted)" ;
    :hasXAxisLabel "Month" ;
    :hasYAxisLabel "Number in millions" ;
    :yMin "0"^^xsd:decimal ;
    :yMax "20"^^xsd:decimal .

:DataPoint5635_1 a schema:DataPoint ;
    rdfs:label "Apr '20" ;
    :xValue "Apr '20" ;
    :yValue "22.0"^^xsd:decimal ;
    :valueEstimated "true" ;
    :belongsToChart :Chart5635 .

