@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <https://schema.org/> .

:Chart389 a schema:BarChart ;
    schema:title "Leading 10 U.S. companies based on medical device revenue in 2019 (in billion U.S. dollars)" ;
    :hasXAxisLabel "Revenue in billion U.S. dollars" ;
    :hasYAxisLabel "companies based on medical device" ;
    :xMin "0"^^xsd:decimal ;
    :xMax "35"^^xsd:decimal .

:DataPoint389_1 a :DataPoint ;
    rdfs:label "Abbott Laboratories" ;
    :yValue "8.0"^^xsd:decimal ;
    :valueEstimated "true" ;
    :belongsToChart :Chart389 .

