@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart1052 a schema:LineChart ;
    schema:title "Commercial vehicle sales in Canada from 2005 to 2019 (in 1,000 units)" ;
    :hasXAxisLabel "Year" ;
    :hasYAxisLabel "Commercial vehicle sales in thousand units" ;
    :xMin "2005"^^xsd:string ;
    :xMax "2019"^^xsd:string ;
    :yMin "0"^^xsd:decimal ;
    :yMax "1500"^^xsd:decimal .

:DataPoint1052_1 a :DataPoint ;
    :belongsToChart :Chart1052 ;
    rdfs:label "2005" ;
    :xValue "2005" ;
    :yValue "750"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .

