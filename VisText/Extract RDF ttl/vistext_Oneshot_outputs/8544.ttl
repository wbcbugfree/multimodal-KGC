:Chart8544 a schema:BarChart ;
    schema:title "Total rate of COVID-19 deaths compared to deaths among long-term care residents in select countries worldwide as of May 2020 (per million population)" ;
    :hasXAxisLabel "Number of LTC deaths per million population" ;
    :hasYAxisLabel "Country" .

:DataPoint8544_1 a :DataPoint ;
    rdfs:label "Australia" ;
