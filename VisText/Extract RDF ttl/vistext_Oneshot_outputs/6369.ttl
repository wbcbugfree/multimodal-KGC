@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart6369 a schema:AreaChart ;
    schema:title "Average hours per day spent on leisure and sports by U.S. population by age from 2010 to 2019" ;
    :hasXAxisLabel "Year" ;
    :hasYAxisLabel "Hours per day" ;
    :xMin "2010" ;
    :xMax "2018" ;
    :yMin "0" ;
    :yMax "5" .

:DataPoint6369_1 :belongsToChart :Chart6369 ;
    rdfs:label "2010" ;
    :xValue "2010" ;
    :yValue "4.75"^^xsd:decimal ;
    :valueEstimated "true" .

