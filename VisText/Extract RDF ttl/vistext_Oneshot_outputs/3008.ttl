@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart3008 a schema:BarChart ;
    schema:title "Public sector expenditure on water supply in the United Kingdom (UK) from 2009/10 to 2019/20 (in million GBP)" ;
    :hasXAxisLabel "Expenditure in million GBP" ;
    :hasYAxisLabel "Year" .

:DataPoint3008_1 a schema:Bar ;
    rdfs:label "2009/10" ;
    :xValue "2009/10" ;
    :yValue "750.0"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean ;
    :belongsToChart :Chart3008 .

