@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart1791 a schema:BarChart ;
    schema:title "The leading law firms in China in 2019 , by gross revenue (in million U.S. dollars)" ;
    :hasXAxisLabel "Gross revenue in million U.S. dollars" ;
    :hasYAxisLabel "law firm" ;
    :xMin "0"^^xsd:decimal ;
    :xMax "3000"^^xsd:decimal .

:DataPoint1791_1 a schema:DataPoint ;
    rdfs:label "Allbright" ;
    :xValue "Allbright" ;
    :yValue "250"^^xsd:decimal ;
    :valueEstimated "true" ;
    :belongsToChart :Chart1791 .

