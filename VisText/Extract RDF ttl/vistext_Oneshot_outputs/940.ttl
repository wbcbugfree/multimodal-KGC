@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart940 a schema:BarChart ;
    schema:title "Leading financial advisors to German M & A in 2016 , by deal count" ;
    :hasXAxisLabel "M&A deal count" ;
    :hasYAxisLabel "Financial advisory firms" .

:DataPoint940_1 a schema:DataPoint ;
    rdfs:label "Deloitte" ;
    :xValue "37"^^xsd:decimal ;
    :yValue "0"^^xsd:decimal ;
    :valueEstimated "true" ;
    :belongsToChart :Chart940 .

