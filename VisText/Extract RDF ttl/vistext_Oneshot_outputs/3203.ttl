@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart3203 a schema:LineChart ;
    schema:title "Central African Republic : Life expectancy at birth from 2008 to 2018" ;
    :hasXAxisLabel "Year" ;
    :hasYAxisLabel "Life expectancy at birth in years" .

:DataPoint3203_1 a :DataPoint ;
    :belongsToChart :Chart3203 ;
    rdfs:label "2008" ;
    :xValue "2008" ;
    :yValue "47.0"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .

:DataPoint3203_2 a :DataPoint ;
    :belongsToChart :Chart3203 ;
    rdfs:label "2010" ;
    :xValue "2010" ;
    :yValue "48.5"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .

:DataPoint3203_3 a :DataPoint ;
    :belongsToChart :Chart3203 ;
    rdfs:label "2012" ;
    :xValue "2012" ;
    :yValue "49.5"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .

:DataPoint3203_4 a :DataPoint ;
    :belongsToChart :Chart3203 ;
    rdfs:label "2014" ;
    :xValue "2014" ;
    :yValue "50.5"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .

:DataPoint3203_5 a :DataPoint ;
    :belongsToChart :Chart3203 ;
    rdfs:label "2016" ;
    :xValue "2016" ;
    :yValue "51.0"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .

:DataPoint3203_6 a :DataPoint ;
    :belongsToChart :Chart3203 ;
    rdfs:label "2018" ;
    :xValue "2018" ;
    :yValue "51.5"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .
