@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart2141 a schema:BarChart ;
    schema:title "B2C e-commerce as percentage of GDP in Japan from 2009 to 2018" ;
    :hasXAxisLabel "Percentage of gross domestic product" ;
    :hasYAxisLabel "Response" .

:DataPoint2141_1 a :DataPoint ;
    :belongsToChart :Chart2141 ;
    rdfs:label "2009" ;
    :xValue "2009" ;
    :yValue "0.004"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .

