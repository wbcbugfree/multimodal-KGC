@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart359 a schema:LineChart ;
    schema:title "Sales turnover of shops for do-it-yourself articles in the Netherlands from 2008 to 2019 (as value index)" ;
    :hasXAxisLabel "Year" ;
    :hasYAxisLabel "Turnover value index (2015=100)" ;
    :yMin "0"^^xsd:decimal ;
    :yMax "140"^^xsd:decimal .

:DataPoint359_1 a :DataPoint ;
    rdfs:label "2008" ;
    :xValue "2008" ;
    :yValue "135.0"^^xsd:decimal ;
    :valueEstimated "true" ;
    :belongsToChart :Chart359 .

