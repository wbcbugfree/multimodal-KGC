@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart5697 a schema:BarChart ;
    schema:title "Novartis AG 's net income from 2007 to 2019 (in billion U.S. dollars)" ;
    :hasXAxisLabel "Net income in billion U.S. dollars" ;
    :hasYAxisLabel "Year" ;
    :xMin "0"^^xsd:decimal ;
    :xMax "18"^^xsd:decimal .

