@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart697 a schema:BarChart ;
    schema:title "Gross monthly salary of Congress members in Latin America in 2018 , by country (in U.S. dollars)" ;
    :hasXAxisLabel "Monthly salary in U.S. dollars" ;
    :hasYAxisLabel "Country" .

:DataPoint697_1 a :DataPoint ;
    rdfs:label "Argentina" ;
    :xValue "Argentina" ;
    :yValue "7500.0"^^xsd:decimal ;
    :valueEstimated "true" ;
    :belongsToChart :Chart697 .

