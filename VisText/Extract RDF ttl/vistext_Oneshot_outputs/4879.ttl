@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart4879 a schema:AreaChart ;
    schema:title "Number of branches of Deutsche Bank worldwide from 2010 to 2019" ;
    :hasXAxisLabel "Year" ;
    :hasYAxisLabel "Number of branches" ;
    :yMin "0"^^xsd:decimal ;
    :yMax "3500"^^xsd:decimal .

