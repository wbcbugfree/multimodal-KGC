@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <https://schema.org/> .

:Chart6447 a schema:AreaChart ;
    schema:title "Marital status of the adult population in England and Wales from 2002 to 2019" ;
    :hasXAxisLabel "Year" ;
    :hasYAxisLabel "Married" ;
    :yMin "0"^^xsd:decimal ;
    :yMax "20000000"^^xsd:decimal .

:DataPoint6447_1 :belongsToChart :Chart6447 ;
    rdfs:label "2002" ;
    :xValue "2002" ;
    :yValue "19000000"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .

:DataPoint6447_2 :belongsToChart :Chart6447 ;
    rdfs:label "2005" ;
    :xValue "2005" ;
    :yValue "19200000"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .

:DataPoint6447_3 :belongsToChart :Chart6447 ;
    rdfs:label "2010" ;
    :xValue "2010" ;
    :yValue "19500000"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .

:DataPoint6447_4 :belongsToChart :Chart6447 ;
    rdfs:label "2015" ;
    :xValue "2015" ;
    :yValue "19800000"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .

:DataPoint6447_5 :belongsToChart :Chart6447 ;
    rdfs:label "2019" ;
    :xValue "2019" ;
    :yValue "20000000"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .
