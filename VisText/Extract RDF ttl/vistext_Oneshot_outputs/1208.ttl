@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart1208 a schema:BarChart ;
    schema:title "Number of registered players in the Korean Basketball League (KBL) in South Korea for the 20/21 season , by team" ;
    :hasXAxisLabel "basketball team" ;
    :hasYAxisLabel "Number of registered players" ;
    :yMin "0"^^xsd:decimal ;
    :yMax "20"^^xsd:decimal .

:DataPoint1208_1 a schema:DataPoint ;
    :belongsToChart :Chart1208 ;
    rdfs:label "Anyang KGC" ;
    :xValue "Anyang KGC" ;
    :yValue "15"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .

