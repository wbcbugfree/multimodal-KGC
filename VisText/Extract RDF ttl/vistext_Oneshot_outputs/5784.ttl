@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <https://schema.org/> .

:Chart5784 a schema:BarChart ;
    schema:title "Top ten horse racing meeting attendances in Britain in 2012" ;
    :hasXAxisLabel "horse racing venue" ;
    :hasYAxisLabel "Number of attendees" ;
    :yMin "0"^^xsd:decimal ;
    :yMax "300000"^^xsd:decimal .

:DataPoint5784_1 a schema:DataPoint ;
    :belongsToChart :Chart5784 ;
    rdfs:label "Aintree Grand National" ;
    :xValue "Aintree Grand National" ;
    :yValue "190000"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .

