@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart5757 a schema:BarChart ;
    schema:title "Change in carbon dioxide emissions in selected countries between 1990 and 2017" ;
    :hasXAxisLabel "Change in CO2 emissions" ;
    :hasYAxisLabel "Country" ;
    :xMin "-0.5"^^xsd:decimal ;
    :xMax "3.5"^^xsd:decimal .

:DataPoint5757_1 a schema:DataPoint ;
    rdfs:label "Australia" ;
    :xValue "Australia" ;
    :yValue "0.2"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean ;
    :belongsToChart :Chart5757 .

:DataPoint5757_2 a schema:DataPoint ;
    rdfs:label "Austria" ;
    :xValue "Austria" ;
    :yValue "0.1"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean ;
    :belongsToChart :Chart5757 .

