    :xValue "Germany" ;
    :yValue "0.3"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean ;
    :belongsToChart :Chart5757 .

:DataPoint5757_8 a schema:DataPoint ;
    rdfs:label "Japan" ;
    :xValue "Japan" ;
