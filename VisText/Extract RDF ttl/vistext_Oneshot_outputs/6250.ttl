@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart6250 a schema:BarChart ;
    schema:title "Gross gambling yield (GGY) of the gambling industry in Great Britain (GB) from 2009 to 2019 , by sector (in million GBP)" ;
    :hasXAxisLabel "Month" ;
    :hasYAxisLabel "Bingo" .

:DataPoint6250_1 a schema:DataPoint ;
    rdfs:label "Apr 09 - Mar 10" ;
    :xValue "Apr 09 - Mar 10" ;
    :yValue "605.0"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean ;
    :belongsToChart :Chart6250 .

