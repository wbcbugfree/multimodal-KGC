@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart2548 a schema:BarChart ;
    schema:title "Average prices for palm oil worldwide from 2014 to 2025 (in nominal U.S. dollars per mt)" ;
    :hasXAxisLabel "Price in nominal U.S. dollars per metric ton" ;
    :hasYAxisLabel "Year" ;
    :yMin "0"^^xsd:decimal ;
    :yMax "800"^^xsd:decimal .

:DataPoint2548_1 a schema:Bar ;
    rdfs:label "2014" ;
    :xValue "2014" ;
    :yValue "760"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean ;
    :belongsToChart :Chart2548 .

