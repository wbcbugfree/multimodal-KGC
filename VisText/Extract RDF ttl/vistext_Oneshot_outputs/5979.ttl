@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <https://schema.org/> .

:Chart5979 a schema:LineChart ;
    schema:title "Share of Google in the mobile search engine market across India from April 2019 to May 2020" ;
    :hasXAxisLabel "Month" ;
    :hasYAxisLabel "Market share" ;
    :yMin "0.0"^^xsd:decimal ;
    :yMax "1.0"^^xsd:decimal .

:DataPoint5979_1 a schema:DataPoint ;
    :belongsToChart :Chart5979 ;
    rdfs:label "April 2019" ;
    :xValue "April" ;
    :yValue "0.98"^^xsd:decimal ;
    :valueEstimated "true" .

:DataPoint5979_2 a schema:DataPoint ;
    :belongsToChart :Chart5979 ;
    rdfs:label "July 2019" ;
    :xValue "July" ;
    :yValue "0.98"^^xsd:decimal ;
    :valueEstimated "true" .

:DataPoint5979_3 a schema:DataPoint ;
    :belongsToChart :Chart5979 ;
    rdfs:label "October 2019" ;
    :xValue "October" ;
    :yValue "0.98"^^xsd:decimal ;
    :valueEstimated "true" .

:DataPoint5979_4 a schema:DataPoint ;
    :belongsToChart :Chart5979 ;
    rdfs:label "April 2020" ;
    :xValue "April" ;
    :yValue "0.98"^^xsd:decimal ;
    :valueEstimated "true" .
