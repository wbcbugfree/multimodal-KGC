@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart8294 a schema:LineChart ;
    schema:title "Number of Facebook fans/twitter followers of Orlando Magic (NBA) from 2012 to 2020 (in millions)" ;
    :hasXAxisLabel "Month" ;
    :hasYAxisLabel "Facebook fans" ;
    :xMin "2012" ;
    :xMax "2020" ;
    :yMin "0.0"^^xsd:decimal ;
    :yMax "3.0"^^xsd:decimal .

:DataPoint8294_1 a schema:DataPoint ;
    :belongsToChart :Chart8294 ;
    rdfs:label "2012" ;
    :xValue "2012" ;
    :yValue "1.55"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .

