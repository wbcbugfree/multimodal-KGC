@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart1746 a schema:BarChart ;
    schema:title "How many of each of the following products or devices , in working order , do you have in your household ?" ;
    :hasXAxisLabel "Household Device" ;
    :hasYAxisLabel "Average number of devices**" .

:DataPoint1746_1 a schema:DataPoint ;
    rdfs:label "Audio/Hi-fi system" ;
    :xValue "Audio/Hi-fi system" ;
    :yValue "1.0"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean ;
    :belongsToChart :Chart1746 .

:DataPoint1746_2 a schema:DataPoint ;
    rdfs:label "Camera/camcorder" ;
    :xValue "Camera/camcorder" ;
    :yValue "0.7"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean ;
