    :xValue "PC/laptop" ;
    :yValue "2.0"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean ;
    :belongsToChart :Chart1746 .

:DataPoint1746_8 a schema:DataPoint ;
    rdfs:label "Printer" ;
    :xValue "Printer" ;
    :yValue "2.3"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean ;
    :belongsToChart :Chart1746 .

:DataPoint1746_9 a schema:DataPoint ;
