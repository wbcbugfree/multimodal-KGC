@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <https://schema.org/> .

:Chart5098 a schema:BarChart ;
    schema:title "Most-followed drag queens from RuPaul 's drag race on Instagram worldwide as of June 2020" ;
    :hasXAxisLabel "Number of followers in millions" ;
    :hasYAxisLabel "Name (Competitive season)" .

