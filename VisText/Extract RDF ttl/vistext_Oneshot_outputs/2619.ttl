    :hasYAxisLabel "Sales volume in liters" ;
    :xMin "2009"^^xsd:string ;
    :xMax "2019"^^xsd:string ;
    :yMin "0"^^xsd:decimal ;
    :yMax "1000000"^^xsd:decimal .

