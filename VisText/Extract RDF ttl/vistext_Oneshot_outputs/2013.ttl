@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart2013 a schema:LineChart ;
    schema:title "Number of Nyrstar employees from 2009 to 2018" ;
    :hasXAxisLabel "Year" ;
    :hasYAxisLabel "Number of employees" ;
    :xMin "2009" ;
    :xMax "2017" ;
    :yMin "0" ;
    :yMax "8000" .

:DataPoint2013_1 a schema:DataPoint ;
    :belongsToChart :Chart2013 ;
    rdfs:label "2009" ;
    :xValue "2009" ;
    :yValue "2700"^^xsd:decimal ;
    :valueEstimated "true" .

:DataPoint2013_2 a schema:DataPoint ;
    :belongsToChart :Chart2013 ;
    rdfs:label "2010" ;
    :xValue "2010" ;
    :yValue "5500"^^xsd:decimal ;
    :valueEstimated "true" .

:DataPoint2013_3 a schema:DataPoint ;
    :belongsToChart :Chart2013 ;
    rdfs:label "2011" ;
    :xValue "2011" ;
    :yValue "6500"^^xsd:decimal ;
    :valueEstimated "true" .

:DataPoint2013_4 a schema:DataPoint ;
    :belongsToChart :Chart2013 ;
    rdfs:label "2012" ;
    :xValue "2012" ;
    :yValue "6300"^^xsd:decimal ;
    :valueEstimated "true" .

:DataPoint2013_5 a schema:DataPoint ;
    :belongsToChart :Chart2013 ;
    rdfs:label "2013" ;
    :xValue "2013" ;
    :yValue "6100"^^xsd:decimal ;
    :valueEstimated "true" .

:DataPoint2013_6 a schema:DataPoint ;
    :belongsToChart :Chart2013 ;
    rdfs:label "2014" ;
    :xValue "2014" ;
    :yValue "4500"^^xsd:decimal ;
    :valueEstimated "true" .

:DataPoint2013_7 a schema:DataPoint ;
    :belongsToChart :Chart2013 ;
    rdfs:label "2015" ;
    :xValue "2015" ;
    :yValue "3700"^^xsd:decimal ;
    :valueEstimated "true" .

:DataPoint2013_8 a schema:DataPoint ;
    :belongsToChart :Chart2013 ;
    rdfs:label "2016" ;
    :xValue "2016" ;
    :yValue "3800"^^xsd:decimal ;
    :valueEstimated "true" .

:DataPoint2013_9 a schema:DataPoint ;
    :belongsToChart :Chart2013 ;
    rdfs:label "2017" ;
    :xValue "2017" ;
    :yValue "3500"^^xsd:decimal ;
    :valueEstimated "true" .
