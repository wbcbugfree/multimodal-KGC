@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart5465 a schema:LineChart ;
    schema:title "Average annual food away-from-home expenditures of United States households from 2010 to 2019 (in U.S. dollars)" ;
    :hasXAxisLabel "Year" ;
    :hasYAxisLabel "Expenditure in U.S. dollars" ;
    :yMin "0"^^xsd:decimal ;
    :yMax "4000"^^xsd:decimal .

:DataPoint5465_1 a schema:DataPoint ;
    :belongsToChart :Chart5465 ;
    rdfs:label "2010" ;
    :xValue "2010" ;
    :yValue "2500"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .

