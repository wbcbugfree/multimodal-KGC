@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart7621 a schema:LineChart ;
    schema:title "Philippines : Distribution of employment by economic sector from 2010 to 2020" ;
    :hasXAxisLabel "Year" ;
    :hasYAxisLabel "Industry" ;
    :yMin "0.00"^^xsd:decimal ;
    :yMax "0.20"^^xsd:decimal .

:DataPoint7621_1 a schema:DataPoint ;
    :belongsToChart :Chart7621 ;
    rdfs:label "2010" ;
    :xValue "2010" ;
    :yValue "0.155"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .

:DataPoint7621_2 a schema:DataPoint ;
    :belongsToChart :Chart7621 ;
    rdfs:label "2012" ;
    :xValue "2012" ;
    :yValue "0.153"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .

:DataPoint7621_3 a schema:DataPoint ;
    :belongsToChart :Chart7621 ;
    rdfs:label "2014" ;
    :xValue "2014" ;
    :yValue "0.160"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .

:DataPoint7621_4 a schema:DataPoint ;
    :belongsToChart :Chart7621 ;
    rdfs:label "2016" ;
    :xValue "2016" ;
    :yValue "0.168"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .

:DataPoint7621_5 a schema:DataPoint ;
    :belongsToChart :Chart7621 ;
    rdfs:label "2018" ;
    :xValue "2018" ;
    :yValue "0.180"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .

:DataPoint7621_6 a schema:DataPoint ;
    :belongsToChart :Chart7621 ;
    rdfs:label "2020" ;
    :xValue "2020" ;
    :yValue "0.190"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .
