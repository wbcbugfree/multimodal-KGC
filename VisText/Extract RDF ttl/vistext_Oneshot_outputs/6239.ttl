@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart6239 a schema:BarChart ;
    schema:title "Monthly retail sales of clothing stores in Canada from 2015 to 2020 (in billion Canadian dollars)" ;
    :hasXAxisLabel "Month" ;
    :hasYAxisLabel "2020" .

:DataPoint6239_1 a schema:DataPoint ;
    :belongsToChart :Chart6239 ;
    rdfs:label "Apr" ;
    :xValue "Apr" ;
    :yValue "0.45"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .

