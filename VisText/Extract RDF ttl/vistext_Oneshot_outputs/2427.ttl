@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart2427 a schema:BarChart ;
    schema:title "Cities around the world with the highest fatality rates from terrorism in 2014" ;
    :hasXAxisLabel "Rate per 100,000 population" ;
    :hasYAxisLabel "city" ;
    :xMin "0"^^xsd:decimal ;
    :xMax "40"^^xsd:decimal .

:DataPoint2427_1 a schema:DataPoint ;
    rdfs:label "Baghdad" ;
    :xValue "Baghdad" ;
    :yValue "42"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean ;
    :belongsToChart :Chart2427 .

