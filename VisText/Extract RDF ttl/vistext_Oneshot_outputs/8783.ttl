@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart8783 a schema:BarChart ;
    schema:title "Number of international visitor arrivals in Finland from January to July 2020 , by country of origin" ;
    :hasXAxisLabel "January*" ;
    :hasYAxisLabel "Country" .

:DataPoint8783_1 a schema:DataPoint ;
    rdfs:label "China" ;
    :xValue "China" ;
    :yValue "15000"^^xsd:decimal ;
    :valueEstimated "true" ;
    :belongsToChart :Chart8783 .

