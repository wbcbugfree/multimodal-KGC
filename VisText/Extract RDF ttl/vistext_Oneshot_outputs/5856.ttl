@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <https://schema.org/> .

:Chart5856 a schema:BarChart ;
    schema:title "Weekend box office revenue of the leading movies in Germany in January 2020 (in 1,000 U.S. dollars)" ;
    :hasXAxisLabel "Revenue in thousand U.S. dollars" ;
    :hasYAxisLabel "Year" .

:DataPoint5856_1 a schema:DataPoint ;
    rdfs:label "1917" ;
    :xValue "1700"^^xsd:decimal ;
    :yValue "1700"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean ;
    :belongsToChart :Chart5856 .

