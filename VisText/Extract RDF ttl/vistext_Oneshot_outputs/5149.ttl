@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart5149 a schema:BarChart ;
    schema:title "Leading cotton producing countries worldwide in 2019/2020 (in 1,000 metric tons)" ;
    :hasXAxisLabel "Production in thousand metric tons" ;
    :hasYAxisLabel "Country" .

