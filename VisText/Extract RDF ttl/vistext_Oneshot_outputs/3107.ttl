@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart3107 a schema:BarChart ;
    schema:title "Most viewed YouTube video categories of male Millennial users in the United States as of April 2016" ;
    :hasXAxisLabel "Response" ;
    :hasYAxisLabel "Share of views" ;
    :yMin "0.0"^^xsd:decimal ;
    :yMax "0.5"^^xsd:decimal .

:DataPoint3107_1 a schema:DataPoint ;
    :belongsToChart :Chart3107 ;
    rdfs:label "Comedy" ;
    :xValue "Comedy" ;
    :yValue "0.02"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .

