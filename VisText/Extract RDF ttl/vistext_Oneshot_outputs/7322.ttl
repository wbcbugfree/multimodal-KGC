@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart7322 a schema:LineChart ;
    schema:title "Number of Facebook fans/twitter followers of the Carolina Panthers (NFL) from 2012 to 2020 (in millions)" ;
    :hasXAxisLabel "Month" ;
    :hasYAxisLabel "Twitter followers" .

:DataPoint7322_1 a schema:DataPoint ;
    :belongsToChart :Chart7322 ;
    rdfs:label "2012" ;
    :xValue "2012" ;
    :yValue "0.0"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .

