@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart671 a schema:BarChart ;
    schema:title "Reasons for registered voters not voting in the U.S. presidential election in 2016" ;
    :hasXAxisLabel "Response" ;
    :hasYAxisLabel "Percentage of registered voters" ;
    :yMin "0.0"^^xsd:decimal ;
    :yMax "0.25"^^xsd:decimal .

:DataPoint671_1 a schema:DataPoint ;
    rdfs:label "Did not like candidates or camp..." ;
    :xValue "Did not like candidates or camp..." ;
    :yValue "0.23"^^xsd:decimal ;
    :valueEstimated "true" ;
    :belongsToChart :Chart671 .

:DataPoint671_2 a schema:DataPoint ;
    rdfs:label "Don't know or refused" ;
    :xValue "Don't know or refused" ;
    :yValue "0.02"^^xsd:decimal ;
    :valueEstimated "true" ;
    :belongsToChart :Chart671 .

:DataPoint671_3 a schema:DataPoint ;
    rdfs:label "Forgot to vote" ;
    :xValue "Forgot to vote" ;
    :yValue "0.025"^^xsd:decimal ;
    :valueEstimated "true" ;
    :belongsToChart :Chart671 .

:DataPoint671_4 a schema:DataPoint ;
    rdfs:label "Illness or disability" ;
    :xValue "Illness or disability" ;
    :yValue "0.11"^^xsd:decimal ;
    :valueEstimated "true" ;
    :belongsToChart :Chart671 .

:DataPoint671_5 a schema:DataPoint ;
    rdfs:label "Inconvenient polling place" ;
    :xValue "Inconvenient polling place" ;
    :yValue "0.02"^^xsd:decimal ;
    :valueEstimated "true" ;
    :belongsToChart :Chart671 .

:DataPoint671_6 a schema:DataPoint ;
    rdfs:label "Not interested" ;
    :xValue "Not interested" ;
    :yValue "0.15"^^xsd:decimal ;
    :valueEstimated "true" ;
    :belongsToChart :Chart671 .

:DataPoint671_7 a schema:DataPoint ;
    rdfs:label "Other reason" ;
    :xValue "Other reason" ;
    :yValue "0.105"^^xsd:decimal ;
    :valueEstimated "true" ;
    :belongsToChart :Chart671 .

:DataPoint671_8 a schema:DataPoint ;
    rdfs:label "Out of town" ;
    :xValue "Out of town" ;
    :yValue "0.07"^^xsd:decimal ;
    :valueEstimated "true" ;
    :belongsToChart :Chart671 .

:DataPoint671_9 a schema:DataPoint ;
    rdfs:label "Registration problems" ;
    :xValue "Registration problems" ;
    :yValue "0.04"^^xsd:decimal ;
    :valueEstimated "true" ;
    :belongsToChart :Chart671 .

:DataPoint671_10 a schema:DataPoint ;
    rdfs:label "Too busy, conflicting schedule" ;
    :xValue "Too busy, conflicting schedule" ;
    :yValue "0.14"^^xsd:decimal ;
    :valueEstimated "true" ;
    :belongsToChart :Chart671 .

:DataPoint671_11 a schema:DataPoint ;
    rdfs:label "Transportation problems" ;
    :xValue "Transportation problems" ;
    :yValue "0.02"^^xsd:decimal ;
    :valueEstimated "true" ;
    :belongsToChart :Chart671 .
