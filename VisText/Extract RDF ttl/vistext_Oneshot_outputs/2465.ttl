@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart2465 a schema:AreaChart ;
    schema:title "Amount of money invested in road transport infrastructure in Denmark from 2004 to 2018 (in million euros)" ;
    :hasXAxisLabel "Year" ;
    :hasYAxisLabel "Millions of euros invested" ;
    :xMin "2004" ;
    :xMax "2018" ;
    :yMin "0"^^xsd:decimal ;
    :yMax "1400"^^xsd:decimal .

:DataPoint2465_1 :belongsToChart :Chart2465 ;
    rdfs:label "2004" ;
    :xValue "2004" ;
    :yValue "800"^^xsd:decimal ;
    :valueEstimated "true" .

