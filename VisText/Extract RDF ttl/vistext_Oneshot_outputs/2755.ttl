@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart2755 a schema:BarChart ;
    schema:title "Value of newsprint imported into India from financial year 2011 to 2019 , with an estimate for 2020 (in billion Indian rupees)" ;
    :hasXAxisLabel "Import value in billion Indian rupees" ;
    :hasYAxisLabel "Year" ;
    :yMin "0"^^xsd:decimal ;
    :yMax "70"^^xsd:decimal .

:DataPoint2755_1 a :DataPoint ;
    rdfs:label "FY 2011" ;
    :xValue "FY 2011" ;
    :yValue "23.0"^^xsd:decimal ;
    :valueEstimated "true" ;
    :belongsToChart :Chart2755 .

