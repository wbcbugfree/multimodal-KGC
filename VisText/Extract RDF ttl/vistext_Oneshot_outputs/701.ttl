@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart701 a schema:BarChart ;
    schema:title "Top 10 therapeutic categories worldwide by number of R & D products in 2020" ;
    :hasXAxisLabel "Therapeutic category" ;
    :hasYAxisLabel "Number of R&D products" ;
    :yMin "0"^^xsd:decimal ;
    :yMax "3500"^^xsd:decimal .

:DataPoint701_1 a schema:DataPoint ;
    rdfs:label "Anti-inflammatory" ;
    :xValue "Anti-inflammatory" ;
    :yValue "450"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean ;
    :belongsToChart :Chart701 .

:DataPoint701_2 a schema:DataPoint ;
    rdfs:label "Anticancer, immunological" ;
    :xValue "Anticancer, immunological" ;
    :yValue "3300"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean ;
    :belongsToChart :Chart701 .

:DataPoint701_3 a schema:DataPoint ;
    rdfs:label "Anticancer, other" ;
    :xValue "Anticancer, other" ;
    :yValue "2350"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean ;
    :belongsToChart :Chart701 .

:DataPoint701_4 a schema:DataPoint ;
    rdfs:label "Antidiabetic" ;
    :xValue "Antidiabetic" ;
    :yValue "500"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean ;
    :belongsToChart :Chart701 .

:DataPoint701_5 a schema:DataPoint ;
    rdfs:label "Gene therapy" ;
    :xValue "Gene therapy" ;
    :yValue "1150"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean ;
    :belongsToChart :Chart701 .

:DataPoint701_6 a schema:DataPoint ;
    rdfs:label "Immunosuppressant" ;
    :xValue "Immunosuppressant" ;
    :yValue "475"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean ;
    :belongsToChart :Chart701 .

:DataPoint701_7 a schema:DataPoint ;
    rdfs:label "Monoclonal antibody, other" ;
    :xValue "Monoclonal antibody, other" ;
    :yValue "850"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean ;
    :belongsToChart :Chart701 .

:DataPoint701_8 a schema:DataPoint ;
    rdfs:label "Neurological" ;
    :xValue "Neurological" ;
    :yValue "650"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean ;
    :belongsToChart :Chart701 .

:DataPoint701_9 a schema:DataPoint ;
    rdfs:label "Ophthalmological, other" ;
    :xValue "Ophthalmological, other" ;
    :yValue "600"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean ;
    :belongsToChart :Chart701 .

:DataPoint701_10 a schema:DataPoint ;
    rdfs:label "Prophylactic vaccine, anti-infective" ;
    :xValue "Prophylactic vaccine, anti-infective" ;
    :yValue "575"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean ;
    :belongsToChart :Chart701 .
