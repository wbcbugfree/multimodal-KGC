@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart1841 a schema:BarChart ;
    schema:title "Number of people with bleeding disorders in Canada in 2019 , by disorder type" ;
    :hasXAxisLabel "Number of people" ;
    :hasYAxisLabel "Bleeding Disorder Type" ;
    :xMin "0"^^xsd:decimal ;
    :xMax "5000"^^xsd:decimal .

:DataPoint1841_1 a schema:DataPoint ;
    rdfs:label "Bernard Soulier" ;
    :xValue "Bernard Soulier" ;
    :yValue "100"^^xsd:decimal ;
    :valueEstimated "true" ;
    :belongsToChart :Chart1841 .

