@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart6019 a schema:LineChart ;
    :hasXAxisLabel "Year" ;
    :hasYAxisLabel "Single men" ;
    :yMin "0"^^xsd:decimal ;
    :yMax "400000"^^xsd:decimal .

:DataPoint6019_1 a :DataPoint ;
    :belongsToChart :Chart6019 ;
    :xValue "2010" ;
    :yValue "400000"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .

:DataPoint6019_2 a :DataPoint ;
    :belongsToChart :Chart6019 ;
    :xValue "2014" ;
    :yValue "400000"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .

:DataPoint6019_3 a :DataPoint ;
