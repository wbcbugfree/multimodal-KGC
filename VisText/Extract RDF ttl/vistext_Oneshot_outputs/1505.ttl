@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart1505 a schema:LineChart ;
    schema:title "Total number of wage and salary workers in the United States from 1979 to 2019 (in millions)" ;
    :hasXAxisLabel "Year" ;
    :hasYAxisLabel "Number of workers in millions" ;
    :xMin "1979"^^xsd:string ;
    :xMax "2019"^^xsd:string ;
    :yMin "0"^^xsd:decimal ;
    :yMax "160"^^xsd:decimal .

:DataPoint1505_1 a :DataPoint ;
    :belongsToChart :Chart1505 ;
    rdfs:label "1979" ;
    :xValue "1979" ;
    :yValue "88.0"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .

:DataPoint1505_2 a :DataPoint ;
    :belongsToChart :Chart1505 ;
    rdfs:label "1980" ;
    :xValue "1980" ;
    :yValue "89.0"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .

:DataPoint1505_3 a :DataPoint ;
    :belongsToChart :Chart1505 ;
    rdfs:label "1990" ;
    :xValue "1990" ;
    :yValue "103.0"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .

:DataPoint1505_4 a :DataPoint ;
    :belongsToChart :Chart1505 ;
    rdfs:label "2000" ;
    :xValue "2000" ;
    :yValue "125.0"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .

:DataPoint1505_5 a :DataPoint ;
    :belongsToChart :Chart1505 ;
    rdfs:label "2010" ;
    :xValue "2010" ;
    :yValue "135.0"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .

:DataPoint1505_6 a :DataPoint ;
    :belongsToChart :Chart1505 ;
    rdfs:label "2019" ;
    :xValue "2019" ;
    :yValue "150.0"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .
