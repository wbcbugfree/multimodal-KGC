    :hasYAxisLabel "Number of employees in thousands" ;
    :xMin "1998" ;
    :xMax "2019" ;
    :yMin "0" ;
    :yMax "900" .

:DataPoint4364_1 :belongsToChart :Chart4364 ;
    rdfs:label "1998" ;
    :xValue "1998" ;
    :yValue "550"^^xsd:decimal ;
    :valueEstimated "true" .

