@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart4364 a schema:LineChart ;
    schema:title "Total employment in the United States mining industry from 1998 to 2019 (in 1,000)" ;
