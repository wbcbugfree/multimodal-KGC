@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart3434 a schema:BarChart ;
    schema:title "Retail price index of potato in India from January to December 2019" ;
    :hasXAxisLabel "Month" ;
    :hasYAxisLabel "Retail price index" ;
    :yMin "0"^^xsd:decimal ;
    :yMax "400"^^xsd:decimal .

:DataPoint3434_1 :belongsToChart :Chart3434 ;
