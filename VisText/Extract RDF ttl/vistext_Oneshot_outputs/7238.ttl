@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart7238 a schema:LineChart ;
    schema:title "Ghana : Distribution of employment by economic sector from 2010 to 2020" ;
    :hasXAxisLabel "Year" ;
    :hasYAxisLabel "Services" ;
    :yMin "0.0"^^xsd:decimal ;
    :yMax "0.5"^^xsd:decimal .

:DataPoint7238_1 a schema:DataPoint ;
    :belongsToChart :Chart7238 ;
    rdfs:label "2010" ;
    :xValue "2010" ;
    :yValue "0.35"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .

:DataPoint7238_2 a schema:DataPoint ;
    :belongsToChart :Chart7238 ;
    rdfs:label "2012" ;
    :xValue "2012" ;
    :yValue "0.38"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .

:DataPoint7238_3 a schema:DataPoint ;
    :belongsToChart :Chart7238 ;
    rdfs:label "2014" ;
    :xValue "2014" ;
    :yValue "0.45"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .

:DataPoint7238_4 a schema:DataPoint ;
    :belongsToChart :Chart7238 ;
    rdfs:label "2016" ;
    :xValue "2016" ;
    :yValue "0.47"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .

:DataPoint7238_5 a schema:DataPoint ;
    :belongsToChart :Chart7238 ;
    rdfs:label "2018" ;
    :xValue "2018" ;
    :yValue "0.49"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .

:DataPoint7238_6 a schema:DataPoint ;
    :belongsToChart :Chart7238 ;
    rdfs:label "2020" ;
    :xValue "2020" ;
    :yValue "0.5"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .
