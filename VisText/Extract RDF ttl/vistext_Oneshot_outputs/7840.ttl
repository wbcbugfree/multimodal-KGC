@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart7840 a schema:BarChart ;
    schema:title "Preferred number of TV show episodes to watch in one binge watching session among Millennials in the United Kingdom (UK) in December 2016" ;
    :hasXAxisLabel "Response" ;
    :hasYAxisLabel "25-39 years" .

:DataPoint7840_1 a schema:DataPoint ;
    rdfs:label "1 episode" ;
    :xValue "1 episode" ;
    :yValue "0.025"^^xsd:decimal ;
    :valueEstimated "true" ;
    :belongsToChart :Chart7840 .

