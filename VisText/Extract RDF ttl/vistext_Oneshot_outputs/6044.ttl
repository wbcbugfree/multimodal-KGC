@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart6044 a schema:BarChart ;
    schema:title "Amount of U.S. tea imports from selected countries of origin in 2018 (in 1,000 metric tons)" ;
    :hasXAxisLabel "2018" ;
    :hasYAxisLabel "Country" .

