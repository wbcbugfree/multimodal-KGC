@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart2994 a schema:BarChart ;
    :hasXAxisLabel "Country" ;
    :hasYAxisLabel "Number of casinos" ;
    schema:title "Number of casinos by country" .

:DataPoint2994_1 a :DataPoint ;
    rdfs:label "Africa" ;
    :xValue "Africa" ;
    :yValue "170"^^xsd:decimal ;
    :valueEstimated "true" ;
    :belongsToChart :Chart2994 .

