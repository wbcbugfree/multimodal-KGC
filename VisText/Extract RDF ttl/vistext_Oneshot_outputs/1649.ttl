@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart1649 a schema:LineChart ;
    schema:title "Average duration of marriages in Belgium from 2008 to 2018 (in years)" ;
    :hasXAxisLabel "Year" ;
    :hasYAxisLabel "Average duration in years" ;
    :xMin "2008" ;
    :xMax "2018" ;
    :yMin "0" ;
    :yMax "16" .

:DataPoint1649_1 a schema:DataPoint ;
    :belongsToChart :Chart1649 ;
    rdfs:label "2008" ;
    :xValue "2008" ;
    :yValue "15.0"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .

:DataPoint1649_2 a schema:DataPoint ;
    :belongsToChart :Chart1649 ;
    rdfs:label "2010" ;
    :xValue "2010" ;
    :yValue "14.7"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .

:DataPoint1649_3 a schema:DataPoint ;
    :belongsToChart :Chart1649 ;
    rdfs:label "2012" ;
    :xValue "2012" ;
    :yValue "14.8"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .

:DataPoint1649_4 a schema:DataPoint ;
    :belongsToChart :Chart1649 ;
    rdfs:label "2014" ;
    :xValue "2014" ;
    :yValue "14.9"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .

:DataPoint1649_5 a schema:DataPoint ;
    :belongsToChart :Chart1649 ;
    rdfs:label "2016" ;
    :xValue "2016" ;
    :yValue "15.2"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .

:DataPoint1649_6 a schema:DataPoint ;
    :belongsToChart :Chart1649 ;
    rdfs:label "2018" ;
    :xValue "2018" ;
    :yValue "15.3"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .
