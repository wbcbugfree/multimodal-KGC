@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <https://schema.org/> .

:Chart3650 a schema:BarChart ;
    schema:title "Average value of CPC (cost per click) of online advertising campaigns in the real estate sector in Italy in 2018 , by city (in euros)" ;
    :hasXAxisLabel "CPC in euros" ;
    :hasYAxisLabel "city of Italy" .

:DataPoint3650_1 a :DataPoint ;
    :belongsToChart :Chart3650 ;
    rdfs:label "Bari" ;
    :xValue "Bari" ;
    :yValue "0.12"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .

