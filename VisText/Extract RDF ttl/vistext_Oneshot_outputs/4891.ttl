@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart4891 a schema:BarChart ;
    schema:title "Leading fashion brands with the most Facebook fans as of October 2020 (in millions)" ;
    :hasXAxisLabel "brand" ;
    :hasYAxisLabel "Number of fans in millions" .

