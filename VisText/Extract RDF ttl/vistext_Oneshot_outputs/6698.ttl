@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart6698 a schema:BarChart ;
    schema:title "Number of bankruptcies after the coronavirus outbreak in Sweden from February to November 2020 , by industry" ;
    :hasXAxisLabel "Construction" ;
    :hasYAxisLabel "Month" .

:DataPoint6698_1 a schema:BarChart ;
    rdfs:label "Apr" ;
    :xValue "Apr" ;
    :yValue "120"^^xsd:decimal ;
    :valueEstimated "true" ;
    :belongsToChart :Chart6698 .

