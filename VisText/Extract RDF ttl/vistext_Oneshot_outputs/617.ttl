@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart617 a schema:BarChart ;
    schema:title "Operating costs for buses in Great Britain excluding London from 2004/05 to 2018/19 (in million GBP)" ;
    :hasXAxisLabel "Costs in million British pounds***" ;
    :hasYAxisLabel "Year" ;
    :xMin "0"^^xsd:decimal ;
    :xMax "4000"^^xsd:decimal .

