@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart1170 a schema:BarChart ;
    schema:title "Donations made to charity in the U.S. from 2011 to 2013 , by channel used" ;
    :hasXAxisLabel "Share of respondents" ;
    :hasYAxisLabel "Channel" ;
    :xMin "0.0"^^xsd:decimal ;
    :xMax "0.5"^^xsd:decimal .

:DataPoint1170_1 a schema:DataPoint ;
    rdfs:label "Will/planned gift" ;
    :xValue "0.05"^^xsd:decimal ;
    :yValue "0.05"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean ;
    :belongsToChart :Chart1170 .

