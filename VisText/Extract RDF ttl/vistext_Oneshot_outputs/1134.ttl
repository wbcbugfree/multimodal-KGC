@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart1134 a schema:BarChart ;
    schema:title "Average game attendance in the Football League Championship in the United Kingdom (UK) from season 2010/2011 to season 2019/2020" ;
    :hasXAxisLabel "Average attendance" ;
    :hasYAxisLabel "Season" .

:DataPoint1134_1 a :DataPoint ;
    :belongsToChart :Chart1134 ;
    rdfs:label "Season 2010/11" ;
    :xValue "Season 2010/11" ;
    :yValue "19000"^^xsd:decimal ;
    :valueEstimated "true" .

