@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart1907 a schema:LineChart ;
    schema:title "Infant mortality rate (under one year old) in Germany from 1840 to 2020" ;
    :hasXAxisLabel "Year" ;
    :hasYAxisLabel "Deaths per 1,000 live births" ;
    :xMin "1840"^^xsd:decimal ;
    :xMax "2020"^^xsd:decimal ;
    :yMin "0"^^xsd:decimal ;
    :yMax "350"^^xsd:decimal .

:DataPoint1907_1 :belongsToChart :Chart1907 ;
    rdfs:label "1840" ;
    :xValue "1840" ;
    :yValue "295.0"^^xsd:decimal ;
    :valueEstimated "true" .

