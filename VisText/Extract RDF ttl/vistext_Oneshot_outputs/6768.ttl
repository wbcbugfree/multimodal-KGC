@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart6768 a schema:AreaChart ;
    schema:title "Total population of Haiti from 2008 to 2018 , by gender (in million inhabitants)" ;
    :hasXAxisLabel "Year" ;
    :hasYAxisLabel "Total" ;
    :yMin "0"^^xsd:decimal ;
    :yMax "12"^^xsd:decimal .

:DataPoint6768_1 a :DataPoint ;
    :belongsToChart :Chart6768 ;
    rdfs:label "2008" ;
    :xValue "2008" ;
    :yValue "9.7"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .

:DataPoint6768_2 a :DataPoint ;
    :belongsToChart :Chart6768 ;
    rdfs:label "2012" ;
    :xValue "2012" ;
    :yValue "10.2"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .

:DataPoint6768_3 a :DataPoint ;
    :belongsToChart :Chart6768 ;
    rdfs:label "2016" ;
    :xValue "2016" ;
    :yValue "10.7"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .

:DataPoint6768_4 a :DataPoint ;
    :belongsToChart :Chart6768 ;
    rdfs:label "2018" ;
    :xValue "2018" ;
    :yValue "10.9"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .
