@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart1886 a schema:LineChart ;
    schema:title "Import volume of candles to the European Union (EU 28) from 2009 to 2018 (in tons)" ;
    :hasXAxisLabel "Year" ;
    :hasYAxisLabel "Imports in tons" ;
    :xMin "2008"^^xsd:integer ;
    :xMax "2018"^^xsd:integer ;
    :yMin "0"^^xsd:decimal ;
    :yMax "200000"^^xsd:decimal .

:DataPoint1886_1 a :DataPoint ;
    :belongsToChart :Chart1886 ;
    rdfs:label "2009" ;
    :xValue "2009" ;
    :yValue "190000"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .

