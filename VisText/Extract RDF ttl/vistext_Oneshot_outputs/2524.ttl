@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart2524 a schema:LineChart ;
    schema:title "U.S. producer price index of insulation materials from 1990 to 2018" ;
    :hasXAxisLabel "Year" ;
    :hasYAxisLabel "Price index" ;
    :xMin "1990" ;
    :xMax "2018" ;
    :yMin "0" ;
    :yMax "200" .

:DataPoint2524_1 :belongsToChart :Chart2524 ;
    rdfs:label "1990" ;
    :xValue "1990" ;
    :yValue "110"^^xsd:decimal ;
    :valueEstimated "true" .

:DataPoint2524_2 :belongsToChart :Chart2524 ;
    rdfs:label "1995" ;
    :xValue "1995" ;
    :yValue "125"^^xsd:decimal ;
    :valueEstimated "true" .

:DataPoint2524_3 :belongsToChart :Chart2524 ;
    rdfs:label "2000" ;
    :xValue "2000" ;
    :yValue "135"^^xsd:decimal ;
    :valueEstimated "true" .

:DataPoint2524_4 :belongsToChart :Chart2524 ;
    rdfs:label "2005" ;
    :xValue "2005" ;
    :yValue "145"^^xsd:decimal ;
    :valueEstimated "true" .

:DataPoint2524_5 :belongsToChart :Chart2524 ;
    rdfs:label "2010" ;
    :xValue "2010" ;
    :yValue "150"^^xsd:decimal ;
    :valueEstimated "true" .

:DataPoint2524_6 :belongsToChart :Chart2524 ;
    rdfs:label "2015" ;
    :xValue "2015" ;
    :yValue "175"^^xsd:decimal ;
    :valueEstimated "true" .

:DataPoint2524_7 :belongsToChart :Chart2524 ;
    rdfs:label "2018" ;
    :xValue "2018" ;
    :yValue "190"^^xsd:decimal ;
    :valueEstimated "true" .
