@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart3168 a schema:BarChart ;
    schema:title "Factor weighted gender pay gap in selected countries in Latin America and the Caribbean in 2016" ;
    :hasXAxisLabel "Gender pay gap" ;
    :hasYAxisLabel "Country" .

