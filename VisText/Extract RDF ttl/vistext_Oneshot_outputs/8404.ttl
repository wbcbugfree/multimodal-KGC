@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart8404 a schema:LineChart ;
    :hasXAxisLabel "Month" ;
    :hasYAxisLabel "All India" ;
    :yMin "0"^^xsd:decimal ;
    :yMax "150"^^xsd:decimal .

:DataPoint8404_1 a schema:DataPoint ;
    :belongsToChart :Chart8404 ;
    rdfs:label "July" ;
    :xValue "July" ;
    :yValue "140"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .

:DataPoint8404_2 a schema:DataPoint ;
    :belongsToChart :Chart8404 ;
    rdfs:label "October" ;
    :xValue "October" ;
    :yValue "144"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .

:DataPoint8404_3 a schema:DataPoint ;
    :belongsToChart :Chart8404 ;
    rdfs:label "2020" ;
    :xValue "2020" ;
    :yValue "147"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .

:DataPoint8404_4 a schema:DataPoint ;
    :belongsToChart :Chart8404 ;
    rdfs:label "April" ;
    :xValue "April" ;
    :yValue "149"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .
