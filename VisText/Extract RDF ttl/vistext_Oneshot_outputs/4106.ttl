@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart4106 a schema:BarChart ;
    schema:title "Turkey : National debt from 2015 to 2025 in relation to gross domestic product (GDP)" ;
    :hasXAxisLabel "Year" ;
    :hasYAxisLabel "National debt in relation to GDP" ;
    :yMin "0.0"^^xsd:decimal ;
    :yMax "0.5"^^xsd:decimal .

:DataPoint4106_1 a schema:DataPoint ;
    rdfs:label "2015" ;
    :xValue "2015" ;
    :yValue "0.26"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean ;
    :belongsToChart :Chart4106 .

