@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart331 a schema:BarChart ;
    schema:title "U.S. grapefruit production from 1999/2000 to 2018/2019 (in 1,000 boxes)" ;
    :hasXAxisLabel "Year" ;
    :hasYAxisLabel "Production in thousand boxes" .

