@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart6107 a schema:BarChart ;
    schema:title "Clinical trial costs by selected cost component and clinical phase as of 2014 (in U.S. dollars)" ;
    :hasXAxisLabel "Phase 1" ;
    :hasYAxisLabel "Cost component" .

:DataPoint6107_1 a schema:DataPoint ;
    rdfs:label "Administrative Staff Costs" ;
    :xValue "Administrative Staff Costs" ;
    :yValue "170000.0"^^xsd:decimal ;
    :valueEstimated "true" ;
    :belongsToChart :Chart6107 .

