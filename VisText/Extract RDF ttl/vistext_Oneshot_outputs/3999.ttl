@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart3999 a schema:BarChart ;
    schema:title "Value of gems and jewelry exported from India between financial year 2009 and 2020 (in billion U.S. dollars)" ;
    :hasXAxisLabel "year" ;
    :hasYAxisLabel "Export value in billion U.S. dollars" ;
    :yMin "0"^^xsd:decimal ;
    :yMax "50"^^xsd:decimal .

:DataPoint3999_1 a schema:DataPoint ;
    rdfs:label "FY 2009" ;
    :xValue "FY 2009" ;
    :yValue "26.0"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean ;
    :belongsToChart :Chart3999 .

