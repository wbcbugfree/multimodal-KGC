@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart7421 a schema:LineChart ;
    schema:title "Projected energy consumption worldwide from 1990 to 2040 , by energy source (in million metric tons of oil equivalent)" ;
    :hasXAxisLabel "Year" ;
    :hasYAxisLabel "Nuclear energy" ;
    :yMin "0"^^xsd:decimal ;
    :yMax "800"^^xsd:decimal .

:DataPoint7421_1 a :DataPoint ;
    :belongsToChart :Chart7421 ;
    rdfs:label "1990" ;
    :xValue "1990" ;
    :yValue "350"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .

:DataPoint7421_2 a :DataPoint ;
    :belongsToChart :Chart7421 ;
    rdfs:label "2000" ;
    :xValue "2000" ;
    :yValue "550"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .

:DataPoint7421_3 a :DataPoint ;
    :belongsToChart :Chart7421 ;
    rdfs:label "2010" ;
    :xValue "2010" ;
    :yValue "580"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .

:DataPoint7421_4 a :DataPoint ;
    :belongsToChart :Chart7421 ;
    rdfs:label "2020" ;
    :xValue "2020" ;
    :yValue "550"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .

:DataPoint7421_5 a :DataPoint ;
    :belongsToChart :Chart7421 ;
    rdfs:label "2030" ;
    :xValue "2030" ;
    :yValue "650"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .

:DataPoint7421_6 a :DataPoint ;
    :belongsToChart :Chart7421 ;
    rdfs:label "2040" ;
    :xValue "2040" ;
    :yValue "750"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .
