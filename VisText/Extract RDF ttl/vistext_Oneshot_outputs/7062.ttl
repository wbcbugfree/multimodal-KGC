@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart7062 a schema:BarChart ;
    schema:title "Share of small and medium enterprises (SME) with growth plans for the next12 months in the United Kingdom (UK) as of 2nd quarter 2014 to 2019 , by sector" ;
    :hasXAxisLabel "Q2 2014" ;
    :hasYAxisLabel "small and medium enterprises" .

:DataPoint7062_1 a :DataPoint ;
    rdfs:label "Agriculture" ;
    :xValue "Agriculture" ;
    :yValue "0.42"^^xsd:decimal ;
    :valueEstimated "true" ;
    :belongsToChart :Chart7062 .

