@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart4444 a schema:LineChart ;
    schema:title "Number of arrivals in tourist accommodation in Hungary from 2006 to 2017 (in millions)" ;
    :hasXAxisLabel "Year" ;
    :hasYAxisLabel "Number of arrivals in millions" ;
    :yMin "0"^^xsd:decimal ;
    :yMax "12"^^xsd:decimal .

:DataPoint4444_1 a schema:DataPoint ;
    rdfs:label "2006" ;
    :xValue "2006" ;
    :yValue "7.2"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean ;
    :belongsToChart :Chart4444 .

