@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart575 a schema:LineChart ;
    schema:title "Number of recreational visitors to the Grand Canyon National Park in the United States from 2008 to 2019 (in millions)" ;
    :hasXAxisLabel "Year" ;
    :hasYAxisLabel "Number of visitors in millions" ;
    :xMin "2008" ;
    :xMax "2019" ;
    :yMin "0" ;
    :yMax "6" .

:DataPoint575_1 a :DataPoint ;
    rdfs:label "2008" ;
    :xValue "2008" ;
    :yValue "4.4"^^xsd:decimal ;
    :valueEstimated "true" ;
    :belongsToChart :Chart575 .

