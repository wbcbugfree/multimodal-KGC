@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart2886 a schema:BarChart ;
    schema:title "Number of soft drink and ice manufacturing establishments in Canada as of December 2019 , by region" ;
    :hasXAxisLabel "province of Canada" ;
    :hasYAxisLabel "Number of establishments" ;
    :yMin "0"^^xsd:decimal ;
    :yMax "50"^^xsd:decimal .

:DataPoint2886_1 a schema:DataPoint ;
    :belongsToChart :Chart2886 ;
    rdfs:label "Alberta" ;
    :xValue "Alberta" ;
    :yValue "19"^^xsd:decimal ;
    :valueEstimated "true" .

