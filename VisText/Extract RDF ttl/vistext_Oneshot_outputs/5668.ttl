@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart5668 a schema:LineChart ;
    schema:title "Homeowner vacancy rates in the United States from 1990 to 2019" ;
    :hasXAxisLabel "Year" ;
    :hasYAxisLabel "Homeowner vacancy rate" ;
    :xMin "1990"^^xsd:string ;
    :xMax "2019"^^xsd:string ;
    :yMin "0.0"^^xsd:decimal ;
    :yMax "0.030"^^xsd:decimal .

:DataPoint5668_1 :belongsToChart :Chart5668 ;
    rdfs:label "1990" ;
    :xValue "1990" ;
    :yValue "0.017"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .

:DataPoint5668_2 :belongsToChart :Chart5668 ;
    rdfs:label "1995" ;
    :xValue "1995" ;
    :yValue "0.016"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .

:DataPoint5668_3 :belongsToChart :Chart5668 ;
    rdfs:label "2000" ;
    :xValue "2000" ;
    :yValue "0.017"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .

:DataPoint5668_4 :belongsToChart :Chart5668 ;
    rdfs:label "2005" ;
    :xValue "2005" ;
    :yValue "0.027"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .

:DataPoint5668_5 :belongsToChart :Chart5668 ;
    rdfs:label "2010" ;
    :xValue "2010" ;
    :yValue "0.021"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .

:DataPoint5668_6 :belongsToChart :Chart5668 ;
    rdfs:label "2015" ;
    :xValue "2015" ;
    :yValue "0.018"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .

:DataPoint5668_7 :belongsToChart :Chart5668 ;
    rdfs:label "2019" ;
    :xValue "2019" ;
    :yValue "0.015"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .
