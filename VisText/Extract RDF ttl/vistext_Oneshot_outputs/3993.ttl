@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart3993 a schema:LineChart ;
    schema:title "Number of Subaru cars sold in Norway from 2009 to 2018" ;
    :hasXAxisLabel "Year" ;
    :hasYAxisLabel "Units sold" ;
    :xMin "2009" ;
    :xMax "2018" ;
    :yMin "0" ;
    :yMax "4000" .

:DataPoint3993_1 a schema:DataPoint ;
    :belongsToChart :Chart3993 ;
    rdfs:label "2009" ;
    :xValue "2009" ;
    :yValue "2700"^^xsd:decimal ;
    :valueEstimated "true" .

:DataPoint3993_2 a schema:DataPoint ;
    :belongsToChart :Chart3993 ;
    rdfs:label "2010" ;
    :xValue "2010" ;
    :yValue "3100"^^xsd:decimal ;
    :valueEstimated "true" .

