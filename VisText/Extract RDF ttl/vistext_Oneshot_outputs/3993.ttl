    :belongsToChart :Chart3993 ;
    rdfs:label "2011" ;
    :xValue "2011" ;
    :yValue "2400"^^xsd:decimal ;
    :valueEstimated "true" .

:DataPoint3993_4 a schema:DataPoint ;
    :belongsToChart :Chart3993 ;
    rdfs:label "2012" ;
    :xValue "2012" ;
    :yValue "3500"^^xsd:decimal ;
    :valueEstimated "true" .

:DataPoint3993_5 a schema:DataPoint ;
    :belongsToChart :Chart3993 ;
    rdfs:label "2013" ;
    :xValue "2013" ;
    :yValue "3200"^^xsd:decimal ;
    :valueEstimated "true" .

:DataPoint3993_6 a schema:DataPoint ;
    :belongsToChart :Chart3993 ;
    rdfs:label "2014" ;
    :xValue "2014" ;
    :yValue "2600"^^xsd:decimal ;
    :valueEstimated "true" .

:DataPoint3993_7 a schema:DataPoint ;
    :belongsToChart :Chart3993 ;
    rdfs:label "2015" ;
    :xValue "2015" ;
    :yValue "3800"^^xsd:decimal ;
    :valueEstimated "true" .

:DataPoint3993_8 a schema:DataPoint ;
    :belongsToChart :Chart3993 ;
    rdfs:label "2016" ;
    :xValue "2016" ;
    :yValue "2800"^^xsd:decimal ;
    :valueEstimated "true" .

:DataPoint3993_9 a schema:DataPoint ;
    :belongsToChart :Chart3993 ;
    rdfs:label "2017" ;
    :xValue "2017" ;
    :yValue "2200"^^xsd:decimal ;
    :valueEstimated "true" .

:DataPoint3993_10 a schema:DataPoint ;
    :belongsToChart :Chart3993 ;
    rdfs:label "2018" ;
    :xValue "2018" ;
    :yValue "1800"^^xsd:decimal ;
    :valueEstimated "true" .
