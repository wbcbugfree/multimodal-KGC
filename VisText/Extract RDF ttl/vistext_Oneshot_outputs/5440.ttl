@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart5440 a schema:BarChart ;
    schema:title "Economic loss due to major droughts worldwide from 1900 to 2016 (in billion U.S. dollars)" ;
    :hasXAxisLabel "Economic loss in billion U.S. dollars" ;
    :hasYAxisLabel "Drought" .

:DataPoint5440_1 a :DataPoint ;
    rdfs:label "Australia, 1981" ;
    :xValue "Australia, 1981" ;
    :yValue "4.0"^^xsd:decimal ;
    :valueEstimated "true" ;
    :belongsToChart :Chart5440 .

