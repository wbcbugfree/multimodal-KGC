@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <https://schema.org/> .

:Chart5738 a schema:LineChart ;
    schema:title "Military expenditure in Norway from 2009 to 2019 (in million NOK)" ;
    :hasXAxisLabel "Year" ;
    :hasYAxisLabel "Expenditure in million NOK" ;
    :xMin "2009"^^xsd:string ;
    :xMax "2019"^^xsd:string ;
    :yMin "0"^^xsd:decimal ;
    :yMax "60000"^^xsd:decimal .

:DataPoint5738_1 a schema:DataPoint ;
    :belongsToChart :Chart5738 ;
    rdfs:label "2009" ;
    :xValue "2009" ;
    :yValue "34000"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .

