@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart1602 a schema:BarChart ;
    schema:title "Total number of biotechnology firms in selected European countries in 2018" ;
    :hasXAxisLabel "Number of companies" ;
    :hasYAxisLabel "Country" .

:DataPoint1602_1 a schema:DataPoint ;
    rdfs:label "Austria" ;
    :xValue "150"^^xsd:decimal ;
    :yValue "150"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean ;
    :belongsToChart :Chart1602 .

