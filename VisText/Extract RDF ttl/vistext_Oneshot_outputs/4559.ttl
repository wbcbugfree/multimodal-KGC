    :hasYAxisLabel "Damage in million U.S. dollars" ;
    :xMin "1995"^^xsd:string ;
    :xMax "2019"^^xsd:string ;
    :yMin "0"^^xsd:decimal ;
    :yMax "10000"^^xsd:decimal .

