@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart7661 a schema:BarChart ;
    schema:title "Migration figures of Spanish people leaving or returning to Spain from 2010 to 2019" ;
    :hasXAxisLabel "Inflow" ;
    :hasYAxisLabel "Year" .

:DataPoint7661_1 a schema:DataPoint ;
    :belongsToChart :Chart7661 ;
    rdfs:label "2010" ;
    :xValue "2010" ;
    :yValue "25000"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .

