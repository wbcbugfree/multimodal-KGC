:Chart5283 a schema:LineChart ;
    schema:title "Median household income in Wisconsin from 1990 to 2019 (in current U.S. dollars)" ;
    :hasXAxisLabel "Year" ;
    :hasYAxisLabel "Household income in current U.S. dollars" ;
    :xMin "1990"^^xsd:string ;
    :xMax "2019"^^xsd:string ;
    :yMin "0"^^xsd:decimal ;
    :yMax "70000"^^xsd:decimal .

:DataPoint5283_1 :belongsToChart :Chart5283 ;
    rdfs:label "1990" ;
    :xValue "1990" ;
    :yValue "31000"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .

