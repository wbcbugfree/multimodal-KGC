@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart4000 a schema:LineChart ;
    schema:title "Participation rate in sports activities in Flanders (Belgium) from 2008 to 2018" ;
    :hasXAxisLabel "Response" ;
    :hasYAxisLabel "Share of the Flemish citizens" ;
    :xMin "2008" ;
    :xMax "2018" ;
    :yMin "0.0"^^xsd:decimal ;
    :yMax "0.7"^^xsd:decimal .

:DataPoint4000_1 a :DataPoint ;
    :belongsToChart :Chart4000 ;
    rdfs:label "2008" ;
    :xValue "2008" ;
    :yValue "0.55"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .

:DataPoint4000_2 a :DataPoint ;
    :belongsToChart :Chart4000 ;
    rdfs:label "2010" ;
    :xValue "2010" ;
    :yValue "0.52"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .

:DataPoint4000_3 a :DataPoint ;
    :belongsToChart :Chart4000 ;
    rdfs:label "2012" ;
    :xValue "2012" ;
    :yValue "0.56"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .

:DataPoint4000_4 a :DataPoint ;
    :belongsToChart :Chart4000 ;
    rdfs:label "2014" ;
    :xValue "2014" ;
    :yValue "0.60"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .

:DataPoint4000_5 a :DataPoint ;
    :belongsToChart :Chart4000 ;
    rdfs:label "2016" ;
    :xValue "2016" ;
    :yValue "0.64"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .

:DataPoint4000_6 a :DataPoint ;
    :belongsToChart :Chart4000 ;
    rdfs:label "2018" ;
    :xValue "2018" ;
    :yValue "0.67"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .
