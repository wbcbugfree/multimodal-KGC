@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart232 a schema:LineChart ;
    schema:title "Registered cases of murder and manslaughter in Belgium from 2008 to 2019" ;
    :hasXAxisLabel "Year" ;
    :hasYAxisLabel "Cases of murder and manslaughter" .

:DataPoint232_1 a :Datapoint ;
    rdfs:label "2008" ;
    :xValue "2008" ;
    :yValue "850"^^xsd:decimal ;
    :valueEstimated "true" ;
    :belongsToChart :Chart232 .

