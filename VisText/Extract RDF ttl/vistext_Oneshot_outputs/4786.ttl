@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart4786 a schema:BarChart ;
    schema:title "Average ticket price Brooklyn Nets games of the NBA from 2006/07 to 2015/16 (in U.S. dollars)" ;
    :hasXAxisLabel "Average ticket price in U.S. dollars" ;
    :hasYAxisLabel "Year" .

:DataPoint4786_1 a schema:DataPoint ;
    rdfs:label "2006/07" ;
    :xValue "2006/07" ;
    :yValue 60.0^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean ;
    :belongsToChart :Chart4786 .

