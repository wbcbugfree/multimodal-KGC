@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart7700 a schema:BarChart ;
    schema:title "Population of Finland from 2009 to 2019 , by language (in thousands)" ;
    :hasXAxisLabel "Year" ;
    :hasYAxisLabel "Swedish" .

:DataPoint7700_1 a schema:DataPoint ;
    rdfs:label "2010" ;
    :xValue "2010" ;
    :yValue "300.0"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean ;
    :belongsToChart :Chart7700 .

:DataPoint7700_2 a schema:DataPoint ;
    rdfs:label "2012" ;
    :xValue "2012" ;
    :yValue "300.0"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean ;
    :belongsToChart :Chart7700 .

:DataPoint7700_3 a schema:DataPoint ;
    rdfs:label "2014" ;
    :xValue "2014" ;
    :yValue "300.0"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean ;
    :belongsToChart :Chart7700 .

:DataPoint7700_4 a schema:DataPoint ;
    rdfs:label "2016" ;
    :xValue "2016" ;
    :yValue "300.0"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean ;
    :belongsToChart :Chart7700 .

:DataPoint7700_5 a schema:DataPoint ;
    rdfs:label "2018" ;
    :xValue "2018" ;
    :yValue "300.0"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean ;
    :belongsToChart :Chart7700 .
