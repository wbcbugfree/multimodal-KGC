@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart5972 a schema:BarChart ;
    schema:title "Average turnaround time across major ports in India from financial year 1991 to 2019 (in days)" ;
    :hasXAxisLabel "military budget" ;
    :hasYAxisLabel "Average turnaround time in days" ;
    :yMin "0"^^xsd:decimal ;
    :yMax "8"^^xsd:decimal .

:DataPoint5972_1 a schema:DataPoint ;
    rdfs:label "FY 1991" ;
    :xValue "FY 1991" ;
    :yValue "8.1"^^xsd:decimal ;
    :valueEstimated "true" ;
    :belongsToChart :Chart5972 .

