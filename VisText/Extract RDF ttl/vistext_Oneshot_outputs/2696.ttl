@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart2696 a schema:LineChart ;
    schema:title "Laos : Fertility rate from 2008 to 2018" ;
    :hasXAxisLabel "Year" ;
    :hasYAxisLabel "Number of children born per woman" ;
    :yMin "0.0"^^xsd:decimal ;
    :yMax "3.5"^^xsd:decimal .

:DataPoint2696_1 a :DataPoint ;
    :belongsToChart :Chart2696 ;
    rdfs:label "2008" ;
    :xValue "2008" ;
    :yValue "3.3"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .

:DataPoint2696_2 a :DataPoint ;
    :belongsToChart :Chart2696 ;
    rdfs:label "2010" ;
    :xValue "2010" ;
    :yValue "3.2"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .

:DataPoint2696_3 a :DataPoint ;
    :belongsToChart :Chart2696 ;
    rdfs:label "2012" ;
    :xValue "2012" ;
    :yValue "3.1"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .

:DataPoint2696_4 a :DataPoint ;
    :belongsToChart :Chart2696 ;
    rdfs:label "2014" ;
    :xValue "2014" ;
    :yValue "3.0"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .

:DataPoint2696_5 a :DataPoint ;
    :belongsToChart :Chart2696 ;
    rdfs:label "2016" ;
    :xValue "2016" ;
    :yValue "2.9"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .

:DataPoint2696_6 a :DataPoint ;
    :belongsToChart :Chart2696 ;
    rdfs:label "2018" ;
    :xValue "2018" ;
    :yValue "2.8"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .
