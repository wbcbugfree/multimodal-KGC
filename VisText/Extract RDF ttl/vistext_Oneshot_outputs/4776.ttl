@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart4776 a schema:BarChart ;
    schema:title "Number of heterosexual marriages in Spain from 2006 to 2019" ;
    :hasXAxisLabel "Number of marriages" ;
    :hasYAxisLabel "Year" .

