@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart4690 a schema:BarChart ;
    schema:title "Population in Italy in 2019 , by age group" ;
    :hasXAxisLabel "Number of individuals" ;
    :hasYAxisLabel "Year" .

:DataPoint4690_1 a schema:DataPoint ;
    rdfs:label "0 to 2 years" ;
    :xValue "0 to 2 years" ;
    :yValue "1500000"^^xsd:decimal ;
    :valueEstimated "true" ;
    :belongsToChart :Chart4690 .

:DataPoint4690_2 a schema:DataPoint ;
    rdfs:label "12 to 17 years" ;
    :xValue "12 to 17 years" ;
    :yValue "2500000"^^xsd:decimal ;
    :valueEstimated "true" ;
    :belongsToChart :Chart4690 .

