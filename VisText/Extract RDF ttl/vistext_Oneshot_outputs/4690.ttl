    rdfs:label "45 to 54 years" ;
    :xValue "45 to 54 years" ;
    :yValue "2000000"^^xsd:decimal ;
    :valueEstimated "true" ;
    :belongsToChart :Chart4690 .

:DataPoint4690_7 a schema:DataPoint ;
    rdfs:label "55 to 64 years" ;
    :xValue "55 to 64 years" ;
    :yValue "8000000"^^xsd:decimal ;
    :valueEstimated "true" ;
    :belongsToChart :Chart4690 .

:DataPoint4690_8 a schema:DataPoint ;
    rdfs:label "65 to 74 years" ;
    :xValue "65 to 74 years" ;
    :yValue "8500000"^^xsd:decimal ;
    :valueEstimated "true" ;
    :belongsToChart :Chart4690 .

:DataPoint4690_9 a schema:DataPoint ;
    rdfs:label "75 years and more" ;
    :xValue "75 years and more" ;
    :yValue "6000000"^^xsd:decimal ;
    :valueEstimated "true" ;
    :belongsToChart :Chart4690 .

:DataPoint4690_10 a schema:DataPoint ;
    rdfs:label "6 to 11 years" ;
