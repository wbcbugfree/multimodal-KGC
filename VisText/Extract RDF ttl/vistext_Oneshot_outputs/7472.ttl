@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart7472 a schema:LineChart ;
    schema:title "Total population of the Dominican Republic from 2008 to 2018 , by gender (in million inhabitants)" ;
    :hasXAxisLabel "Year" ;
    :hasYAxisLabel "Male" ;
    :yMin "0"^^xsd:decimal ;
    :yMax "6"^^xsd:decimal .

:DataPoint7472_1 a schema:DataPoint ;
    :belongsToChart :Chart7472 ;
    rdfs:label "2008" ;
    :xValue "2008" ;
    :yValue "4.8"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .

:DataPoint7472_2 a schema:DataPoint ;
    :belongsToChart :Chart7472 ;
    rdfs:label "2010" ;
    :xValue "2010" ;
    :yValue "4.9"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .

:DataPoint7472_3 a schema:DataPoint ;
    :belongsToChart :Chart7472 ;
    rdfs:label "2012" ;
    :xValue "2012" ;
    :yValue "5.0"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .

:DataPoint7472_4 a schema:DataPoint ;
    :belongsToChart :Chart7472 ;
    rdfs:label "2014" ;
    :xValue "2014" ;
    :yValue "5.1"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .

:DataPoint7472_5 a schema:DataPoint ;
    :belongsToChart :Chart7472 ;
    rdfs:label "2016" ;
    :xValue "2016" ;
    :yValue "5.2"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .

:DataPoint7472_6 a schema:DataPoint ;
    :belongsToChart :Chart7472 ;
    rdfs:label "2018" ;
    :xValue "2018" ;
    :yValue "5.3"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .
