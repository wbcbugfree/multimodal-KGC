@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart8492 a schema:BarChart ;
    schema:title "Total circulation of community newspapers in Canada from 2013 to 2019 , by province and territory (in 1,000s)" ;
    :hasXAxisLabel "2015" ;
    :hasYAxisLabel "province of Canada" .

:DataPoint8492_1 a schema:BarChart ;
    rdfs:label "Alberta" ;
    :xValue "Alberta" ;
    :yValue "1500"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean ;
    :belongsToChart :Chart8492 .

