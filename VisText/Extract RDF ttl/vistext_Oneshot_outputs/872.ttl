    rdfs:label "2012" ;
    :xValue "2012" ;
    :yValue "750"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean ;
    :belongsToChart :Chart872 .

:DataPoint872_4 a schema:DataPoint ;
    rdfs:label "2014" ;
    :xValue "2014" ;
    :yValue "650"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean ;
    :belongsToChart :Chart872 .

:DataPoint872_5 a schema:DataPoint ;
    rdfs:label "2016" ;
    :xValue "2016" ;
    :yValue "600"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean ;
    :belongsToChart :Chart872 .

:DataPoint872_6 a schema:DataPoint ;
    rdfs:label "2018" ;
    :xValue "2018" ;
    :yValue "650"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean ;
    :belongsToChart :Chart872 .

:DataPoint872_7 a schema:DataPoint ;
    rdfs:label "2019" ;
    :xValue "2019" ;
    :yValue "1100"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean ;
    :belongsToChart :Chart872 .

:DataPoint872_8 a schema:DataPoint ;
    rdfs:label "2020 (early)" ;
    :xValue "2020" ;
    :yValue "750"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean ;
    :belongsToChart :Chart872 .

:DataPoint872_9 a schema:DataPoint ;
    rdfs:label "2020 (mid)" ;
    :xValue "2020" ;
    :yValue "2200"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean ;
