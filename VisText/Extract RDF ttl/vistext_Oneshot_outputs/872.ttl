@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart872 a schema:LineChart ;
    schema:title "Largest one-day point gains of the Dow Jones Index from 1987 to June 2020" ;
    :hasXAxisLabel "Year" ;
    :hasYAxisLabel "Change in index points within one day" ;
    :yMin "0"^^xsd:decimal ;
    :yMax "2200"^^xsd:decimal .

:DataPoint872_1 a schema:DataPoint ;
    rdfs:label "2009" ;
    :xValue "2009" ;
    :yValue "900"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean ;
    :belongsToChart :Chart872 .

:DataPoint872_2 a schema:DataPoint ;
    rdfs:label "2010" ;
    :xValue "2010" ;
    :yValue "850"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean ;
    :belongsToChart :Chart872 .

