@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart409 a schema:BarChart ;
    schema:title "Size of luxury property that one million dollars could buy in selected cities worldwide in 2019 (in square meters)" ;
    :hasXAxisLabel "Country" ;
    :hasYAxisLabel "Size in square meters" .

:DataPoint409_1 a schema:DataPoint ;
    rdfs:label "Beijing" ;
    :xValue "Beijing" ;
    :yValue "67.0"^^xsd:decimal ;
    :valueEstimated "true" ;
    :belongsToChart :Chart409 .

