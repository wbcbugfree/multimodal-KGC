@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart50 a schema:LineChart ;
    schema:title "Number of hospital beds in Spain from 2010 to 2020" ;
    :hasXAxisLabel "Year" ;
    :hasYAxisLabel "Number of hospital beds" ;
    :xMin "2010" ;
    :xMax "2020" ;
    :yMin "0"^^xsd:decimal ;
    :yMax "150000"^^xsd:decimal .

:DataPoint50_1 a schema:DataPoint ;
    :belongsToChart :Chart50 ;
    rdfs:label "2010" ;
    :xValue "2010" ;
    :yValue "148000"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .

:DataPoint50_2 a schema:DataPoint ;
    :belongsToChart :Chart50 ;
    rdfs:label "2012" ;
    :xValue "2012" ;
    :yValue "149000"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .

:DataPoint50_3 a schema:DataPoint ;
    :belongsToChart :Chart50 ;
    rdfs:label "2014" ;
    :xValue "2014" ;
    :yValue "149000"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .

:DataPoint50_4 a schema:DataPoint ;
    :belongsToChart :Chart50 ;
    rdfs:label "2016" ;
    :xValue "2016" ;
    :yValue "148000"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .

:DataPoint50_5 a schema:DataPoint ;
    :belongsToChart :Chart50 ;
    rdfs:label "2018" ;
    :xValue "2018" ;
    :yValue "147000"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .

:DataPoint50_6 a schema:DataPoint ;
    :belongsToChart :Chart50 ;
    rdfs:label "2020" ;
    :xValue "2020" ;
    :yValue "146000"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .
