@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart4466 a schema:BarChart ;
    schema:title "Tour de France number of overall victories by nation from 1903 to 2019" ;
    :hasXAxisLabel "Country" ;
    :hasYAxisLabel "Tour de France victories" ;
    :yMin "0"^^xsd:decimal ;
    :yMax "40"^^xsd:decimal .

:DataPoint4466_1 a schema:DataPoint ;
    rdfs:label "Australia" ;
    :xValue "Australia" ;
    :yValue "1"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean ;
    :belongsToChart :Chart4466 .

