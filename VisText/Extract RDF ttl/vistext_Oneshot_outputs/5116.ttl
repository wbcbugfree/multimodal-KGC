    :hasYAxisLabel "ACSI score" ;
    :xMin "2000"^^xsd:decimal ;
    :xMax "2020"^^xsd:decimal ;
    :yMin "0"^^xsd:decimal ;
    :yMax "100"^^xsd:decimal .

