@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart1002 a schema:BarChart ;
    schema:title "Response" ;
    :hasXAxisLabel "Share of respondents" ;
    :hasYAxisLabel "Response" ;
    :yMin "1"^^xsd:decimal ;
    :yMax "10"^^xsd:decimal .

:DataPoint1002_1 a :DataPoint ;
    rdfs:label "1 - Not influential at all" ;
    :xValue "0.02"^^xsd:decimal ;
    :yValue "1"^^xsd:decimal ;
    :valueEstimated "true" ;
    :belongsToChart :Chart1002 .

