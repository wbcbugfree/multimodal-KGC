@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart7098 a schema:BarChart ;
    schema:title "Greece : Government revenue and spending from 2014 to 2024 (in billion euros)" ;
    :hasXAxisLabel "Revenue" ;
    :hasYAxisLabel "Year" .

