@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart5225 a schema:BarChart ;
    schema:title "Prize money pool in million U.S. dollars" ;
    :hasXAxisLabel "Prize money pool in million U.S. dollars" ;
    :hasYAxisLabel "Sporting event" ;
    :xMin "0"^^xsd:decimal ;
    :xMax "1200"^^xsd:decimal .

:DataPoint5225_1 a :DataPoint ;
    rdfs:label "European Championship*" ;
    :xValue "European Championship*" ;
    :yValue "200"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean ;
    :belongsToChart :Chart5225 .

:DataPoint5225_2 a :DataPoint ;
    rdfs:label "FIFA World Cup" ;
    :xValue "FIFA World Cup" ;
    :yValue "700"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean ;
    :belongsToChart :Chart5225 .

