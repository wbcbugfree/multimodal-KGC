    :xValue "Wimbledon" ;
    :yValue "50"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean ;
    :belongsToChart :Chart5225 .

:DataPoint5225_9 a :DataPoint ;
    rdfs:label "World Series (MLB)*" ;
