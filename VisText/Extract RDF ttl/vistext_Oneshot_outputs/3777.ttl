@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart3777 a schema:BarChart ;
    schema:title "Chicago White Sox all-time home run leaders as of October 2020" ;
    :hasXAxisLabel "Home run leader" ;
    :hasYAxisLabel "Number of home runs" ;
    :yMin "0"^^xsd:decimal ;
    :yMax "400"^^xsd:decimal .

:DataPoint3777_1 a schema:DataPoint ;
    rdfs:label "Bill Melton" ;
    :xValue "Bill Melton" ;
    :yValue "160"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean ;
    :belongsToChart :Chart3777 .

