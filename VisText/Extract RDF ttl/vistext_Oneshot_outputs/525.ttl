@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart525 a schema:BarChart ;
    schema:title "Chile : National debt from 2015 to 2025 in relation to gross domestic product (GDP)" ;
    :hasXAxisLabel "Year" ;
    :hasYAxisLabel "National debt in relation to GDP" ;
    :yMin "0.0"^^xsd:decimal ;
    :yMax "0.5"^^xsd:decimal .

:DataPoint525_1 a :DataPoint ;
    :belongsToChart :Chart525 ;
    rdfs:label "2015" ;
    :xValue "2015" ;
    :yValue "0.17"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .

