@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart2238 a schema:BarChart ;
    schema:title "Worldwide refinery production of cobalt from 2008 to 2017 (in metric tons)" ;
    :hasXAxisLabel "Year" ;
    :hasYAxisLabel "Production in metric tons" ;
    :yMin "0"^^xsd:decimal ;
    :yMax "120000"^^xsd:decimal .

:DataPoint2238_1 a :DataPoint ;
    :belongsToChart :Chart2238 ;
    rdfs:label "2008" ;
    :xValue "2008" ;
    :yValue "58000"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .

