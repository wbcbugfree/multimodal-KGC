@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart1634 a schema:BarChart ;
    schema:title "Apprehensions by the U.S. border patrol for fiscal year 2019 , sorted by sector" ;
    :hasXAxisLabel "city of the United States" ;
    :hasYAxisLabel "Number of apprehensions" ;
    :yMin "0"^^xsd:decimal ;
    :yMax "800000"^^xsd:decimal .

:DataPoint1634_1 a schema:DataPoint ;
    rdfs:label "Big Bend, formerly Marfa" ;
    :xValue "Big Bend, formerly Marfa" ;
    :yValue "10000"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean ;
    :belongsToChart :Chart1634 .

