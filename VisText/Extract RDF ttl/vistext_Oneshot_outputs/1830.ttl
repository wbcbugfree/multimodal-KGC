@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <https://schema.org/> .

:Chart1830 a schema:CreativeWork ;
    schema:title "Total sales floor space of Fast Retailing worldwide from fiscal year 2010 to 2019 (in square-meters)" ;
    :hasXAxisLabel "Year" ;
    :hasYAxisLabel "Sales floor space in n square-meters" .

:DataPoint1830_1 a :DataPoint ;
    :belongsToChart :Chart1830 ;
    rdfs:label "2010" ;
    :xValue "2010" ;
    :yValue "700000.0"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .

