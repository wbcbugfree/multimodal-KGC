@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart3056 a schema:BarChart ;
    schema:title "Criminal use of explosives in Canada in 2014 , by incident" ;
    :hasXAxisLabel "Number of incidents involving explosives" ;
    :hasYAxisLabel "Incident" .

:DataPoint3056_1 a schema:BarChart ;
    rdfs:label "Accidental explosion" ;
    :xValue "Accidental explosion" ;
    :yValue 2.0^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean ;
    :belongsToChart :Chart3056 .

:DataPoint3056_2 a schema:BarChart ;
    rdfs:label "Attempted bombing" ;
    :xValue "Attempted bombing" ;
    :yValue 4.0^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean ;
    :belongsToChart :Chart3056 .

