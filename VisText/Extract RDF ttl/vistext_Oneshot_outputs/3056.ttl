    rdfs:label "Bombing" ;
    :xValue "Bombing" ;
    :yValue 3.0^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean ;
    :belongsToChart :Chart3056 .

:DataPoint3056_4 a schema:BarChart ;
