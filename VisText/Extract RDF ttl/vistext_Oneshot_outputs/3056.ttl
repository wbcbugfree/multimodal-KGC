:DataPoint3056_11 a schema:BarChart ;
    rdfs:label "Recovery of inert military ordnance" ;
    :xValue "Recovery of inert military ordnance" ;
    :yValue 0.0^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean ;
    :belongsToChart :Chart3056 .
