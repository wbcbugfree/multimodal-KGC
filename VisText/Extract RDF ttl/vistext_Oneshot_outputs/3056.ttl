    :yValue 12.0^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean ;
    :belongsToChart :Chart3056 .

:DataPoint3056_8 a schema:BarChart ;
    rdfs:label "Recovery of IED & HME" ;
    :xValue "Recovery of IED & HME" ;
    :yValue 59.0^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean ;
    :belongsToChart :Chart3056 .

:DataPoint3056_9 a schema:BarChart ;
    rdfs:label "Recovery of commercial & militar..." ;
    :xValue "Recovery of commercial & militar..." ;
    :yValue 10.0^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean ;
    :belongsToChart :Chart3056 .

:DataPoint3056_10 a schema:BarChart ;
