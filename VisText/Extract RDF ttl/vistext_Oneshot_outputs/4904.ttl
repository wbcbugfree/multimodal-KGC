@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart4904 a schema:LineChart ;
    schema:title "Number of daily confirmed cases of the novel coronavirus infection COVID-19 in Malaysia as of January 6 , 2021" ;
    :hasXAxisLabel "Month" ;
    :hasYAxisLabel "Number of cases" ;
    :yMin "0"^^xsd:decimal ;
    :yMax "2500"^^xsd:decimal .

:DataPoint4904_1 a schema:DataPoint ;
    :belongsToChart :Chart4904 ;
    rdfs:label "2005" ;
    :xValue "2005" ;
    :yValue "0"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .

:DataPoint4904_2 a schema:DataPoint ;
    :belongsToChart :Chart4904 ;
    rdfs:label "2010" ;
    :xValue "2010" ;
    :yValue "0"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .

:DataPoint4904_3 a schema:DataPoint ;
    :belongsToChart :Chart4904 ;
    rdfs:label "2015" ;
    :xValue "2015" ;
    :yValue "0"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .

:DataPoint4904_4 a schema:DataPoint ;
    :belongsToChart :Chart4904 ;
    rdfs:label "2020" ;
    :xValue "2020" ;
    :yValue "1500"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .

:DataPoint4904_5 a schema:DataPoint ;
    :belongsToChart :Chart4904 ;
    rdfs:label "2021" ;
    :xValue "2021" ;
    :yValue "2500"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .
