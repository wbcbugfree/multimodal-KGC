@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart8650 a schema:LineChart ;
    schema:title "Internet penetration rate in the Middle East compared to the global internet penetration rate from 2009 to 2019" ;
    :hasXAxisLabel "Year" ;
    :hasYAxisLabel "Rest of the World" ;
    :yMin "0.0"^^xsd:decimal ;
    :yMax "0.6"^^xsd:decimal .

:DataPoint8650_1 :belongsToChart :Chart8650 ;
    rdfs:label "2009" ;
    :xValue "2009" ;
    :yValue "0.25"^^xsd:decimal ;
    :valueEstimated "true" .

