@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart4345 a schema:LineChart ;
    :hasXAxisLabel "Fiscal years" ;
    :hasYAxisLabel "Number of stores" ;
    :yMin "0"^^xsd:decimal ;
    :yMax "400"^^xsd:decimal .

:DataPoint4345_1 :belongsToChart :Chart4345 ;
    rdfs:label "2005" ;
    :xValue "2005" ;
    :yValue "150"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .

