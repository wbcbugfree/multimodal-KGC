@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart76 a schema:BarChart ;
    schema:title "Non-English main home languages ranked by number of speakers in Welsh schools in 2020" ;
    :hasXAxisLabel "geographic region" ;
    :hasYAxisLabel "Number of speakers" ;
    :yMin "0"^^xsd:decimal ;
    :yMax "5000"^^xsd:decimal .

:DataPoint76_1 a schema:DataPoint ;
    rdfs:label "Arabic" ;
    :xValue "Arabic" ;
    :yValue "3400"^^xsd:decimal ;
    :valueEstimated "true" ;
    :belongsToChart :Chart76 .

:DataPoint76_2 a schema:DataPoint ;
    rdfs:label "Bengali" ;
    :xValue "Bengali" ;
    :yValue "3000"^^xsd:decimal ;
    :valueEstimated "true" ;
    :belongsToChart :Chart76 .

