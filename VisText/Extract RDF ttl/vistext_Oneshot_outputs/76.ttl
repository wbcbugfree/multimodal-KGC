    rdfs:label "Chinese" ;
    :xValue "Chinese" ;
    :yValue "1400"^^xsd:decimal ;
    :valueEstimated "true" ;
    :belongsToChart :Chart76 .

:DataPoint76_4 a schema:DataPoint ;
    rdfs:label "Panjabi" ;
    :xValue "Panjabi" ;
    :yValue "1150"^^xsd:decimal ;
    :valueEstimated "true" ;
    :belongsToChart :Chart76 .

:DataPoint76_5 a schema:DataPoint ;
    rdfs:label "Polish" ;
    :xValue "Polish" ;
    :yValue "4900"^^xsd:decimal ;
    :valueEstimated "true" ;
    :belongsToChart :Chart76 .

:DataPoint76_6 a schema:DataPoint ;
    rdfs:label "Portuguese" ;
    :xValue "Portuguese" ;
    :yValue "950"^^xsd:decimal ;
    :valueEstimated "true" ;
    :belongsToChart :Chart76 .

:DataPoint76_7 a schema:DataPoint ;
    rdfs:label "Romanian" ;
    :xValue "Romanian" ;
    :yValue "1050"^^xsd:decimal ;
    :valueEstimated "true" ;
    :belongsToChart :Chart76 .

:DataPoint76_8 a schema:DataPoint ;
    rdfs:label "Somali" ;
    :xValue "Somali" ;
    :yValue "975"^^xsd:decimal ;
    :valueEstimated "true" ;
    :belongsToChart :Chart76 .

:DataPoint76_9 a schema:DataPoint ;
    rdfs:label "Tagalog/Filipino" ;
    :xValue "Tagalog/Filipino" ;
    :yValue "975"^^xsd:decimal ;
    :valueEstimated "true" ;
    :belongsToChart :Chart76 .

:DataPoint76_10 a schema:DataPoint ;
