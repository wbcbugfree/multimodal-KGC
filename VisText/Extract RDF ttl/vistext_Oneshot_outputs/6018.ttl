@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart6018 a schema:LineChart ;
    schema:title "Colombia : Distribution of employment by economic sector from 2010 to 2020" ;
    :hasXAxisLabel "Year" ;
    :hasYAxisLabel "Agriculture" ;
    :yMin "0.00"^^xsd:decimal ;
    :yMax "0.20"^^xsd:decimal .

:DataPoint6018_1 :belongsToChart :Chart6018 ;
    rdfs:label "2010" ;
    :xValue "2010" ;
    :yValue "0.18"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .

:DataPoint6018_2 :belongsToChart :Chart6018 ;
    rdfs:label "2012" ;
    :xValue "2012" ;
    :yValue "0.17"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .

:DataPoint6018_3 :belongsToChart :Chart6018 ;
    rdfs:label "2014" ;
    :xValue "2014" ;
    :yValue "0.165"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .

:DataPoint6018_4 :belongsToChart :Chart6018 ;
    rdfs:label "2016" ;
    :xValue "2016" ;
    :yValue "0.168"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .

:DataPoint6018_5 :belongsToChart :Chart6018 ;
    rdfs:label "2018" ;
    :xValue "2018" ;
    :yValue "0.167"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .

:DataPoint6018_6 :belongsToChart :Chart6018 ;
    rdfs:label "2020" ;
    :xValue "2020" ;
    :yValue "0.165"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .
