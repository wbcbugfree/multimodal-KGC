@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <https://schema.org/> .

:Chart6232 a schema:BarChart ;
    schema:title "Monthly average daily temperatures in the United Kingdom (UK) from 2015 to 2020 (in degrees Celsius)" ;
    :hasXAxisLabel "2020" ;
    :hasYAxisLabel "Month" .

:DataPoint6232_1 a :DataPoint ;
    :belongsToChart :Chart6232 ;
    rdfs:label "Apr" ;
    :xValue "Apr" ;
    :yValue "12.0"^^xsd:decimal ;
    :valueEstimated "true" .

:DataPoint6232_2 a :DataPoint ;
    :belongsToChart :Chart6232 ;
    rdfs:label "Aug" ;
    :xValue "Aug" ;
    :yValue "17.0"^^xsd:decimal ;
    :valueEstimated "true" .

