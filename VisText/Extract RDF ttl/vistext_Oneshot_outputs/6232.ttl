    rdfs:label "Jan" ;
    :xValue "Jan" ;
    :yValue "5.0"^^xsd:decimal ;
    :valueEstimated "true" .

:DataPoint6232_5 a :DataPoint ;
    :belongsToChart :Chart6232 ;
    rdfs:label "Jul" ;
    :xValue "Jul" ;
    :yValue "15.0"^^xsd:decimal ;
    :valueEstimated "true" .

:DataPoint6232_6 a :DataPoint ;
    :belongsToChart :Chart6232 ;
