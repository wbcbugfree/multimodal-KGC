@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart2551 a schema:BarChart ;
    schema:title "Leading brands for best customer experience online , ranked by consumers in the United Kingdom (UK) in 2014" ;
    :hasXAxisLabel "Response" ;
    :hasYAxisLabel "Share of respondents" ;
    :yMin "0.0"^^xsd:decimal ;
    :yMax "0.8"^^xsd:decimal .

:DataPoint2551_1 a schema:DataPoint ;
    rdfs:label "Amazon (.co.uk)" ;
    :xValue "Amazon (.co.uk)" ;
    :yValue "0.75"^^xsd:decimal ;
    :valueEstimated "true" ;
    :belongsToChart :Chart2551 .

