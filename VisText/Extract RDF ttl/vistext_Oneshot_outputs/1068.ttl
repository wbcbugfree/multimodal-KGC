@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart1068 a schema:BarChart ;
    schema:title "Most annoying hotel guest behavior according to fellow travelers in the United States as of September 2014" ;
    :hasXAxisLabel "Response" ;
    :hasYAxisLabel "Share of respondents" .

:DataPoint1068_1 a schema:DataPoint ;
    rdfs:label "Guests that are rude to hotel staff" ;
    :xValue "Guests that are rude to hotel staff" ;
    :yValue "0.56"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean ;
    :belongsToChart :Chart1068 .

