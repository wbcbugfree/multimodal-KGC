@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart2182 a schema:LineChart ;
    schema:title "Sales of potted plants in Canada from 2010 to 2019 (in million Canadian dollars)" ;
    :hasXAxisLabel "Year" ;
    :hasYAxisLabel "Sales in million Canadian dollars" ;
    :xMin "2010"^^xsd:string ;
    :xMax "2019"^^xsd:string ;
    :yMin "0"^^xsd:decimal ;
    :yMax "900"^^xsd:decimal .

:DataPoint2182_1 a schema:DataPoint ;
    :belongsToChart :Chart2182 ;
    rdfs:label "2010" ;
    :xValue "2010" ;
    :yValue "730"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .

:DataPoint2182_2 a schema:DataPoint ;
    :belongsToChart :Chart2182 ;
    rdfs:label "2011" ;
    :xValue "2011" ;
    :yValue "670"^^xsd:decimal ;
