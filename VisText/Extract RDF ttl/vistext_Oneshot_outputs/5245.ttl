@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart5245 a schema:BarChart ;
    schema:title "Most centuries scored in international test match cricket as of September 2020 , by player" ;
    :hasXAxisLabel "Number of centuries scored" ;
    :hasYAxisLabel "player name" .

:DataPoint5245_1 a schema:DataPoint ;
    rdfs:label "AN Cook (ENG)" ;
    :yValue "32"^^xsd:decimal ;
    :valueEstimated "true" ;
    :belongsToChart :Chart5245 .

