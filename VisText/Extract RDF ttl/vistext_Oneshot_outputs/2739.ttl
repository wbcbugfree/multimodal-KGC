@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart2739 a schema:LineChart ;
    schema:title "Machinery and equipment price index in Canada from 2006 to 2016" ;
    :hasXAxisLabel "Year" ;
    :hasYAxisLabel "Price index" ;
    :xMin "2006" ;
    :xMax "2016" ;
    :yMin "0"^^xsd:decimal ;
    :yMax "120"^^xsd:decimal .

:DataPoint2739_1 :belongsToChart :Chart2739 ;
