@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart1588 a schema:BarChart ;
    schema:title "Monthly export price of high-density polyethylene in the United States from January 2017 to October 2017 (in U.S. dollars per ton)" ;
    :hasXAxisLabel "Price in U.S. dollars per ton" ;
    :hasYAxisLabel "Month" ;
    :yMin "0"^^xsd:decimal ;
    :yMax "1400"^^xsd:decimal .

:DataPoint1588_1 a schema:DataPoint ;
    rdfs:label "April" ;
    :xValue "April" ;
    :yValue "1150"^^xsd:decimal ;
    :valueEstimated "true" ;
    :belongsToChart :Chart1588 .

