:Chart7727 a schema:LineChart ;
    schema:title "Merchandise sales of Dollar General in the United States from 2009 to 2019 , by product category (in million U.S. dollars)" ;
    :hasXAxisLabel "Year" ;
    :hasYAxisLabel "Home products" ;
    :xMin "2009" ;
    :xMax "2019" ;
    :yMin "0" ;
    :yMax "1750" .

