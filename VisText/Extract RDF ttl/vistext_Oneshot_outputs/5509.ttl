@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart5509 a schema:BarChart ;
    schema:title "Coronavirus impact on online traffic of selected industries worldwide as of October 2020" ;
    :hasXAxisLabel "industry" ;
    :hasYAxisLabel "Change in traffic" ;
    :yMin "-0.4"^^xsd:decimal ;
    :yMax "0.4"^^xsd:decimal .

:DataPoint5509_1 a :DataPoint ;
    :belongsToChart :Chart5509 ;
    rdfs:label "Bank / insurance" ;
    :xValue "Bank / insurance" ;
    :yValue "0.01"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .

