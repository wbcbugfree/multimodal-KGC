@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart78 a schema:BarChart ;
    schema:title "Value of Indian trade with ASEAN countries in FY 2019 , by country (in million U.S. dollars)" ;
    :hasXAxisLabel "Country" ;
    :hasYAxisLabel "Trade value in million U.S. dollars" ;
    :yMin "0"^^xsd:decimal ;
    :yMax "30000"^^xsd:decimal .

:DataPoint78_1 a schema:DataPoint ;
    rdfs:label "Brunei" ;
    :xValue "Brunei" ;
    :yValue "1500"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean ;
    :belongsToChart :Chart78 .

:DataPoint78_2 a schema:DataPoint ;
    rdfs:label "Cambodia" ;
    :xValue "Cambodia" ;
    :yValue "500"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean ;
    :belongsToChart :Chart78 .

