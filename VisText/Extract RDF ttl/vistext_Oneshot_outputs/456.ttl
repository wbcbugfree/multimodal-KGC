@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart456 a schema:BarChart ;
    schema:title "Forecast volume of wheat consumed in the European Union (EU 27) from 2016 to 2029 (in 1,000 tonnes)" ;
    :hasXAxisLabel "Volume in thousand tonnes" ;
    :hasYAxisLabel "Year" .

:DataPoint456_1 :belongsToChart :Chart456 ;
    rdfs:label "2016" ;
    :xValue "2016" ;
    :yValue "100000"^^xsd:decimal ;
    :valueEstimated "true" .

