@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart7609 a schema:BarChart ;
    schema:title "Average spending per consumer on selected music activities in the United States as of July 2018" ;
    :hasXAxisLabel "Response" ;
    :hasYAxisLabel "$40 to $99.99" .

:DataPoint7609_1 a schema:DataPoint ;
    rdfs:label "CD albums/singles" ;
    :xValue "CD albums/singles" ;
    :yValue "0.16"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean ;
    :belongsToChart :Chart7609 .

:DataPoint7609_2 a schema:DataPoint ;
    rdfs:label "MP3/download albums" ;
    :xValue "MP3/download albums" ;
    :yValue "0.09"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean ;
    :belongsToChart :Chart7609 .

