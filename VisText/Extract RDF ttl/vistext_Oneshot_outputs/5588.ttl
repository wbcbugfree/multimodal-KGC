:Chart5588 a schema:LineChart ;
    schema:title "Total contribution of travel and tourism to the GDP in Southeast Asia from 2010 to 2019 (in billion U.S. dollars)" ;
    :hasXAxisLabel "Year" ;
    :hasYAxisLabel "GDP contribution in billion U.S. dollars" ;
    :yMin "0"^^xsd:decimal ;
    :yMax "400"^^xsd:decimal .

