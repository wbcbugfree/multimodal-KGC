@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart6555 a schema:LineChart ;
    schema:title "Luxembourg : Distribution of employment by economic sector from 2010 to 2020" ;
