@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <https://schema.org/> .

:Chart6798 a schema:LineChart ;
    schema:title "Total population of Argentina from 2008 to 2018 , by gender (in million inhabitants)" ;
    :hasXAxisLabel "Year" ;
    :hasYAxisLabel "Total" ;
    :xMin "2008" ;
    :xMax "2018" ;
    :yMin "0" ;
    :yMax "45" .

:DataPoint6798_1 a schema:DataPoint ;
    :belongsToChart :Chart6798 ;
    rdfs:label "2008" ;
    :xValue "2008" ;
    :yValue "40.5"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .

:DataPoint6798_2 a schema:DataPoint ;
    :belongsToChart :Chart6798 ;
    rdfs:label "2010" ;
    :xValue "2010" ;
    :yValue "41.0"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .

:DataPoint6798_3 a schema:DataPoint ;
    :belongsToChart :Chart6798 ;
    rdfs:label "2012" ;
    :xValue "2012" ;
    :yValue "41.5"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .

:DataPoint6798_4 a schema:DataPoint ;
    :belongsToChart :Chart6798 ;
    rdfs:label "2014" ;
    :xValue "2014" ;
    :yValue "42.0"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .

:DataPoint6798_5 a schema:DataPoint ;
    :belongsToChart :Chart6798 ;
    rdfs:label "2016" ;
    :xValue "2016" ;
    :yValue "42.5"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .

:DataPoint6798_6 a schema:DataPoint ;
    :belongsToChart :Chart6798 ;
    rdfs:label "2018" ;
    :xValue "2018" ;
    :yValue "43.0"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .
