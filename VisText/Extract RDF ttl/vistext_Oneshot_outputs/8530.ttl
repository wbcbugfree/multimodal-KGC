@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart8530 a schema:AreaChart ;
    schema:title "Spain : Distribution of the workforce across economic sectors from 2010 to 2020" ;
    :hasXAxisLabel "Year" ;
    :hasYAxisLabel "Agriculture" ;
    :yMin "0.00"^^xsd:decimal ;
    :yMax "0.05"^^xsd:decimal .

:DataPoint8530_1 a :DataPoint ;
    :belongsToChart :Chart8530 ;
    rdfs:label "2010" ;
    :xValue "2010" ;
    :yValue "0.042"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .

:DataPoint8530_2 a :DataPoint ;
    :belongsToChart :Chart8530 ;
    rdfs:label "2012" ;
    :xValue "2012" ;
    :yValue "0.041"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .

