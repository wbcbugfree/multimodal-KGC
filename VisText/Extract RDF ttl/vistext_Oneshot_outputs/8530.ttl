    :belongsToChart :Chart8530 ;
    rdfs:label "2014" ;
    :xValue "2014" ;
    :yValue "0.042"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .

:DataPoint8530_4 a :DataPoint ;
    :belongsToChart :Chart8530 ;
    rdfs:label "2016" ;
    :xValue "2016" ;
    :yValue "0.043"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .

:DataPoint8530_5 a :DataPoint ;
    :belongsToChart :Chart8530 ;
    rdfs:label "2018" ;
    :xValue "2018" ;
    :yValue "0.041"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .

:DataPoint8530_6 a :DataPoint ;
