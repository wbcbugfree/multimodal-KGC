@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart845 a schema:BarChart ;
    schema:title "Leading countries in primary energy consumption worldwide in 2019 (in exajoules)" ;
    :hasXAxisLabel "Country" ;
    :hasYAxisLabel "Consumption in exajoules" ;
    :yMin "0"^^xsd:decimal ;
    :yMax "150"^^xsd:decimal .

:DataPoint845_1 a schema:DataPoint ;
