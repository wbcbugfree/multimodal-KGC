@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart2402 a schema:BarChart ;
    schema:title "Number of tax filers in Canada in 2018 , by province" ;
    :hasXAxisLabel "province of Canada" ;
    :hasYAxisLabel "Number of taxfilers" ;
    :yMin "0"^^xsd:decimal ;
    :yMax "10000000"^^xsd:decimal .

