@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart1150 a schema:CreativeWork ;
    schema:title "Number of coronavirus (COVID-19) recoveries in Romania as of January 8 , 2021 (in 1,000s)" ;
    :hasXAxisLabel "Year" ;
    :hasYAxisLabel "Number of people in thousands" ;
    :yMin "0"^^xsd:decimal ;
    :yMax "600"^^xsd:decimal .

:DataPoint1150_1 :belongsToChart :Chart1150 ;
    rdfs:label "July" ;
    :xValue "July" ;
    :yValue "10"^^xsd:decimal ;
    :valueEstimated "true" .

:DataPoint1150_2 :belongsToChart :Chart1150 ;
    rdfs:label "September" ;
    :xValue "September" ;
    :yValue "80"^^xsd:decimal ;
    :valueEstimated "true" .

:DataPoint1150_3 :belongsToChart :Chart1150 ;
    rdfs:label "November" ;
    :xValue "November" ;
    :yValue "100"^^xsd:decimal ;
    :valueEstimated "true" .

:DataPoint1150_4 :belongsToChart :Chart1150 ;
    rdfs:label "2021" ;
    :xValue "2021" ;
    :yValue "580"^^xsd:decimal ;
    :valueEstimated "true" .
