@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart62 a schema:BarChart ;
    schema:title "Most popular health and fitness apps in the United States as of May 2018 , by reach" ;
    :hasXAxisLabel "business" ;
    :hasYAxisLabel "Mobile reach" ;
    :yMin "0.0"^^xsd:decimal ;
    :yMax "0.12"^^xsd:decimal .

:DataPoint62_1 a schema:DataPoint ;
    rdfs:label "Fitbit" ;
    :xValue "Fitbit" ;
    :yValue "0.125"^^xsd:decimal ;
    :valueEstimated "true" ;
    :belongsToChart :Chart62 .

:DataPoint62_2 a schema:DataPoint ;
    rdfs:label "Garmin Connect Mobile" ;
    :xValue "Garmin Connect Mobile" ;
    :yValue "0.012"^^xsd:decimal ;
    :valueEstimated "true" ;
    :belongsToChart :Chart62 .

:DataPoint62_3 a schema:DataPoint ;
    rdfs:label "Google Fit" ;
    :xValue "Google Fit" ;
    :yValue "0.012"^^xsd:decimal ;
    :valueEstimated "true" ;
    :belongsToChart :Chart62 .

:DataPoint62_4 a schema:DataPoint ;
    rdfs:label "My Calendar - Period Tracker" ;
    :xValue "My Calendar - Period Tracker" ;
    :yValue "0.012"^^xsd:decimal ;
    :valueEstimated "true" ;
    :belongsToChart :Chart62 .

:DataPoint62_5 a schema:DataPoint ;
    rdfs:label "MyFitnessPal" ;
    :xValue "MyFitnessPal" ;
    :yValue "0.088"^^xsd:decimal ;
    :valueEstimated "true" ;
    :belongsToChart :Chart62 .

:DataPoint62_6 a schema:DataPoint ;
    rdfs:label "Nike+ Running" ;
    :xValue "Nike+ Running" ;
    :yValue "0.072"^^xsd:decimal ;
    :valueEstimated "true" ;
    :belongsToChart :Chart62 .

:DataPoint62_7 a schema:DataPoint ;
    rdfs:label "S Health (for Samsung)" ;
    :xValue "S Health (for Samsung)" ;
    :yValue "0.012"^^xsd:decimal ;
    :valueEstimated "true" ;
    :belongsToChart :Chart62 .

:DataPoint62_8 a schema:DataPoint ;
    rdfs:label "Sleep Cycle alarm clock" ;
    :xValue "Sleep Cycle alarm clock" ;
    :yValue "0.012"^^xsd:decimal ;
    :valueEstimated "true" ;
    :belongsToChart :Chart62 .

:DataPoint62_9 a schema:DataPoint ;
    rdfs:label "Walk with Map My Walk GPS..." ;
    :xValue "Walk with Map My Walk GPS..." ;
    :yValue "0.02"^^xsd:decimal ;
    :valueEstimated "true" ;
    :belongsToChart :Chart62 .

:DataPoint62_10 a schema:DataPoint ;
    rdfs:label "Weight Watchers" ;
    :xValue "Weight Watchers" ;
    :yValue "0.019"^^xsd:decimal ;
    :valueEstimated "true" ;
