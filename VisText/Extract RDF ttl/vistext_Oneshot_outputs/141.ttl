@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart141 a schema:BarChart ;
    schema:title "Most common baby names of boys in Norway in 2019" ;
    :hasXAxisLabel "baby names" ;
    :hasYAxisLabel "Number of individuals" ;
    :yMin "0"^^xsd:decimal ;
    :yMax "400"^^xsd:decimal .

:DataPoint141_1 a schema:DataPoint ;
    rdfs:label "Aksel/Axel" ;
    :xValue "Aksel/Axel" ;
    :yValue "300"^^xsd:decimal ;
    :valueEstimated "true" ;
    :belongsToChart :Chart141 .

