@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart7860 a schema:BarChart ;
    :hasXAxisLabel "West" ;
    :hasYAxisLabel "crimes" .

:DataPoint7860_1 a :DataPoint ;
    :belongsToChart :Chart7860 ;
    rdfs:label "Aggravated assault" ;
    :yValue "0.59"^^xsd:decimal ;
    :valueEstimated "true" .

