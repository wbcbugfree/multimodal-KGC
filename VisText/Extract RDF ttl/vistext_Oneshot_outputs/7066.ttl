:Chart7066 a schema:BarChart ;
    schema:title "Percentage of employed workers from minority groups in computer occupations in the United States in 2019" ;
    :hasXAxisLabel "computer occupations" ;
    :hasYAxisLabel "Asian" ;
    :yMin "0.0"^^xsd:decimal ;
    :yMax "0.4"^^xsd:decimal .

