@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart6913 a schema:AreaChart ;
    schema:title "Consumer Price Index of pan , tobacco , and intoxicants across urban and rural India from March 2019 to March 2020 , by month" ;
    :hasXAxisLabel "Month" ;
    :hasYAxisLabel "Urban" ;
    :yMin "0"^^xsd:decimal ;
    :yMax "175"^^xsd:decimal .

:DataPoint6913_1 a schema:DataPoint ;
    rdfs:label "April" ;
    :xValue "April" ;
    :yValue "160"^^xsd:decimal ;
    :valueEstimated "true" ;
    :belongsToChart :Chart6913 .

:DataPoint6913_2 a schema:DataPoint ;
    rdfs:label "July" ;
    :xValue "July" ;
    :yValue "162"^^xsd:decimal ;
    :valueEstimated "true" ;
    :belongsToChart :Chart6913 .

:DataPoint6913_3 a schema:DataPoint ;
    rdfs:label "October" ;
    :xValue "October" ;
    :yValue "165"^^xsd:decimal ;
    :valueEstimated "true" ;
    :belongsToChart :Chart6913 .

:DataPoint6913_4 a schema:DataPoint ;
    rdfs:label "2020" ;
    :xValue "2020" ;
    :yValue "168"^^xsd:decimal ;
    :valueEstimated "true" ;
    :belongsToChart :Chart6913 .
