@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart5007 a schema:BarChart ;
    schema:title "Public sector expenditure on unemployment benefits in the United Kingdom (UK) from 2009/10 to 2019/20 (in billion GBP)" ;
    :hasXAxisLabel "Expenditure in billion GBP" ;
    :hasYAxisLabel "Year" .

:DataPoint5007_1 a :DataPoint ;
    rdfs:label "2009/10" ;
    :xValue "2009/10" ;
    :yValue "5.5"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean ;
    :belongsToChart :Chart5007 .

