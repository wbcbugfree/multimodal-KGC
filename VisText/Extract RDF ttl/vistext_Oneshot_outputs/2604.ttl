@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart2604 a schema:BarChart ;
    schema:title "Installed power capacity across Uttarakhand in India from financial year 2005 to 2018 (in megawatts)" ;
    :hasXAxisLabel "Installed power capacity in megawatts" ;
    :hasYAxisLabel "year" .

:DataPoint2604_1 a schema:DataPoint ;
    rdfs:label "FY 2005" ;
    :xValue "FY 2005" ;
    :yValue "500"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean ;
    :belongsToChart :Chart2604 .

