@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart4808 a schema:LineChart ;
    schema:title "Number of road traffic fatalities in Iceland from 2006 to 2019" ;
    :hasXAxisLabel "Year" ;
    :hasYAxisLabel "Number of fatalities" ;
    :yMin "0"^^xsd:decimal ;
    :yMax "35"^^xsd:decimal .

:DataPoint4808_1 a schema:DataPoint ;
    :belongsToChart :Chart4808 ;
    rdfs:label "2006" ;
    :xValue "2006" ;
    :yValue "30"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .

