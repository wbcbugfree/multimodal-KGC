@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart5557 a schema:BarChart ;
    schema:title "Leading coffee importing countries worldwide in 2018 (in million U.S. dollars)" ;
    :hasXAxisLabel "Country" ;
    :hasYAxisLabel "Trade value in million U.S. dollars" ;
    :yMin "0"^^xsd:decimal ;
    :yMax "6000"^^xsd:decimal .

