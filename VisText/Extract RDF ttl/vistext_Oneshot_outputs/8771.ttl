@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart8771 a schema:LineChart ;
    schema:title "Distribution of Garmin 's revenue from 2009 to 2019 , by segment" ;
    :hasXAxisLabel "Year" ;
    :hasYAxisLabel "Aviation" ;
    :yMin "0.00"^^xsd:decimal ;
    :yMax "0.20"^^xsd:decimal .

:DataPoint8771_1 a schema:DataPoint ;
    rdfs:label "2009" ;
    :xValue "2009" ;
    :yValue "0.07"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean ;
    :belongsToChart :Chart8771 .

