@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart2428 a schema:BarChart ;
    schema:title "Average spending of adults in the United States on selected sharing companies or services as of January 2016 (in U.S. dollars)" ;
    :hasXAxisLabel "company or service" ;
    :hasYAxisLabel "Average amount spent in U.S. dollars" ;
    :yMin "0"^^xsd:decimal ;
    :yMax "120"^^xsd:decimal .

:DataPoint2428_1 a schema:DataPoint ;
    rdfs:label "AirBnB" ;
    :xValue "AirBnB" ;
    :yValue "115.0"^^xsd:decimal ;
    :valueEstimated "true" ;
    :belongsToChart :Chart2428 .

