@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart5866 a schema:BarChart ;
    schema:title "Leading producers of fresh vegetables worldwide in 2018 (in million metric tons)" ;
    :hasXAxisLabel "Production in million metric tons" ;
    :hasYAxisLabel "" .

