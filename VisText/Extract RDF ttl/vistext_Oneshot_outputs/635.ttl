@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart635 a schema:LineChart ;
    schema:title "Pioneer Natural Resources ' total revenue from 2008 to 2019 (in million U.S. dollars)" ;
    :hasXAxisLabel "Year" ;
    :hasYAxisLabel "Revenue in million U.S. dollars" ;
    :yMin "0"^^xsd:decimal ;
    :yMax "10000"^^xsd:decimal .

:DataPoint635_1 :belongsToChart :Chart635 ;
    rdfs:label "2008" ;
    :xValue "2008" ;
    :yValue "1800.0"^^xsd:decimal ;
    :valueEstimated "true" .

