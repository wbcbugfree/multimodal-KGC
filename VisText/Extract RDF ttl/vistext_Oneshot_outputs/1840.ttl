@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart1840 a schema:LineChart ;
    schema:title "Debt of the Ford Motor Company from FY 2007 to FY 2019 (in million U.S. dollars)" ;
    :hasXAxisLabel "Year" ;
    :hasYAxisLabel "Net income in million U.S. dollars" ;
    :yMin "0"^^xsd:decimal ;
    :yMax "150000"^^xsd:decimal .

:DataPoint1840_1 a schema:DataPoint ;
    rdfs:label "2007" ;
    :xValue "2007" ;
    :yValue "150000"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean ;
    :belongsToChart :Chart1840 .

