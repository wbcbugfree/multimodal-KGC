@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart2853 a schema:BarChart ;
    schema:title "Percentage of underweight adolescent girls in selected countries in 2011" ;
    :hasXAxisLabel "Percentage of adolescent girls" ;
    :hasYAxisLabel "Response" ;
    :xMin "0.0"^^xsd:decimal ;
    :xMax "0.5"^^xsd:decimal .

:DataPoint2853_1 a schema:DataPoint ;
    rdfs:label "Bangladesh" ;
    :xValue "Bangladesh" ;
    :yValue "0.35"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean ;
    :belongsToChart :Chart2853 .

