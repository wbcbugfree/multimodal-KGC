@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart4755 a schema:LineChart ;
    schema:title "Revenue from music streaming in the United States from 2010 to 2019 (in billion U.S. dollars)" ;
    :hasXAxisLabel "Year" ;
    :hasYAxisLabel "Revenue in billion U.S. dollars" ;
    :xMin "2010"^^xsd:string ;
    :xMax "2019"^^xsd:string ;
    :yMin "0"^^xsd:decimal ;
    :yMax "9"^^xsd:decimal .

:DataPoint4755_1 a schema:DataPoint ;
    :belongsToChart :Chart4755 ;
    rdfs:label "2010" ;
    :xValue "2010" ;
    :yValue "0.5"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .

:DataPoint4755_2 a schema:DataPoint ;
    :belongsToChart :Chart4755 ;
    rdfs:label "2012" ;
    :xValue "2012" ;
    :yValue "1.0"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .

:DataPoint4755_3 a schema:DataPoint ;
    :belongsToChart :Chart4755 ;
    rdfs:label "2014" ;
    :xValue "2014" ;
    :yValue "2.2"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .

:DataPoint4755_4 a schema:DataPoint ;
    :belongsToChart :Chart4755 ;
    rdfs:label "2016" ;
    :xValue "2016" ;
    :yValue "4.0"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .

:DataPoint4755_5 a schema:DataPoint ;
    :belongsToChart :Chart4755 ;
    rdfs:label "2018" ;
    :xValue "2018" ;
    :yValue "7.0"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .

:DataPoint4755_6 a schema:DataPoint ;
    :belongsToChart :Chart4755 ;
    rdfs:label "2019" ;
    :xValue "2019" ;
    :yValue "8.5"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .
