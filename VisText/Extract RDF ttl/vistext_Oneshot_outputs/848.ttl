@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart848 a schema:BarChart ;
    schema:title "Top digital health deals worldwide based on invested funding in 2019 , by receiving company (in million U.S. dollars)" ;
    :hasXAxisLabel "Company (subsector)" ;
    :hasYAxisLabel "Received funding in million U.S. dollars" ;
    :yMin "0"^^xsd:decimal ;
    :yMax "700"^^xsd:decimal .

