@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart6957 a schema:LineChart ;
    schema:title "Revenue of Ipsos worldwide from 2010 to 2019 , by geographic region (in million euros)" ;
    :hasXAxisLabel "Year" ;
    :hasYAxisLabel "Europe, Middle East and Africa" ;
    :yMin "0"^^xsd:decimal ;
    :yMax "800"^^xsd:decimal .

:DataPoint6957_1 a schema:DataPoint ;
