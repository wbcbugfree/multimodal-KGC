@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart4851 a schema:BarChart ;
    schema:title "Number of knife crimes recorded in London from 2010/11 to 2019/20 (in 1,000s)" ;
    :hasXAxisLabel "Number of offences (in 1,000s)" ;
    :hasYAxisLabel "Year" .

