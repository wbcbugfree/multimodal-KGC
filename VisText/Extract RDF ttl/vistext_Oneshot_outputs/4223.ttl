@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart4223 a schema:BarChart ;
    schema:title "Volume of raw silk produced in India in financial year 2017 , by state (in 1,000 metric tons)" ;
    :hasXAxisLabel "state of India" ;
    :hasYAxisLabel "Raw silk production in thousand metric tons" ;
    :yMin "0"^^xsd:decimal ;
    :yMax "10"^^xsd:decimal .

:DataPoint4223_1 a :DataPoint ;
    rdfs:label "Andhra Pradesh" ;
    :xValue "Andhra Pradesh" ;
    :yValue "6.0"^^xsd:decimal ;
    :valueEstimated "true" ;
    :belongsToChart :Chart4223 .

