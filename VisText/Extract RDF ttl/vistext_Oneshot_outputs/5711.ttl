@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart5711 a schema:LineChart ;
    schema:title "Vending machines - total sales volume in the U.S. from 1999 to 2010 (in billion U.S. dollars)" ;
    :hasXAxisLabel "Year" ;
    :hasYAxisLabel "Vended volume (in billion U.S. dollars)" ;
    :yMin "0"^^xsd:decimal ;
    :yMax "50"^^xsd:decimal .

:DataPoint5711_1 a :DataPoint ;
    :belongsToChart :Chart5711 ;
    rdfs:label "1999" ;
    :xValue "1999" ;
    :yValue "38.0"^^xsd:decimal ;
    :valueEstimated "true" .

