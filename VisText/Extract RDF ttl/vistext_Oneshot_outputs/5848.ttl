@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart5848 a schema:LineChart ;
    schema:title "Number of employees at Intel from 2004 to 2019 (in 1,000s)" ;
    :hasXAxisLabel "Year" ;
    :hasYAxisLabel "Number of employees in thousands" ;
    :xMin "2004" ;
    :xMax "2018" ;
    :yMin "0"^^xsd:decimal ;
    :yMax "120"^^xsd:decimal .

:DataPoint5848_1 a :Datapoint ;
    :belongsToChart :Chart5848 ;
    rdfs:label "2004" ;
    :xValue "2004" ;
    :yValue "85"^^xsd:decimal ;
    :valueEstimated "true" .

