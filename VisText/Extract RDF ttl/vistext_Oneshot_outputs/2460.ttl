@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart2460 a schema:BarChart ;
    schema:title "Most valuable food brands in the United Kingdom (UK) in 2015 (in million U.S. dollars)" ;
    :hasXAxisLabel "food brand" ;
    :hasYAxisLabel "Brand value in million U.S. dollars" ;
    :yMin "0"^^xsd:decimal ;
    :yMax "12000"^^xsd:decimal .

:DataPoint2460_1 a schema:DataPoint ;
    rdfs:label "Booker Group" ;
    :xValue "Booker Group" ;
    :yValue "1500"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean ;
    :belongsToChart :Chart2460 .

