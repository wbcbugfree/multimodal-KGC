@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart3006 a schema:BarChart ;
    schema:title "Number of Dollarama stores in Canada as of January 2020 , by province" ;
    :hasXAxisLabel "province of Canada" ;
    :hasYAxisLabel "Number of stores" .

:DataPoint3006_1 a schema:DataPoint ;
    :belongsToChart :Chart3006 ;
    rdfs:label "Alberta" ;
    :xValue "Alberta" ;
    :yValue "105.0"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .

