@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart3419 a schema:LineChart ;
    schema:title "Consumption of coal energy for electricity generation in the United States from 1950 to 2019 (in million short tons)" ;
    :hasXAxisLabel "Year" ;
    :hasYAxisLabel "Consumption in million short tons" ;
    :xMin "1950"^^xsd:string ;
    :xMax "2019"^^xsd:string ;
    :yMin "0"^^xsd:decimal ;
    :yMax "1000"^^xsd:decimal .

:DataPoint3419_1 :belongsToChart :Chart3419 ;
    rdfs:label "1950" ;
    :xValue "1950" ;
    :yValue "100"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .

:DataPoint3419_2 :belongsToChart :Chart3419 ;
    rdfs:label "1960" ;
    :xValue "1960" ;
    :yValue "300"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .

:DataPoint3419_3 :belongsToChart :Chart3419 ;
    rdfs:label "1970" ;
    :xValue "1970" ;
    :yValue "600"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .

:DataPoint3419_4 :belongsToChart :Chart3419 ;
    rdfs:label "1980" ;
    :xValue "1980" ;
    :yValue "800"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .

:DataPoint3419_5 :belongsToChart :Chart3419 ;
    rdfs:label "1990" ;
    :xValue "1990" ;
    :yValue "950"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .

:DataPoint3419_6 :belongsToChart :Chart3419 ;
    rdfs:label "2000" ;
    :xValue "2000" ;
    :yValue "1050"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .

:DataPoint3419_7 :belongsToChart :Chart3419 ;
    rdfs:label "2010" ;
    :xValue "2010" ;
    :yValue "700"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .

:DataPoint3419_8 :belongsToChart :Chart3419 ;
    rdfs:label "2019" ;
    :xValue "2019" ;
    :yValue "500"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .
