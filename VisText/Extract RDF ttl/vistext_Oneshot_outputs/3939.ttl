@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart3939 a schema:LineChart ;
    schema:title "Combined desktop and mobile visits to Walmart.com from May 2019 to September 2020 (in millions)" ;
    :hasXAxisLabel "Year" ;
    :hasYAxisLabel "Number of visits in millions" ;
    :xMin "2019" ;
    :xMax "2020" ;
    :yMin "0"^^xsd:decimal ;
    :yMax "500"^^xsd:decimal .

:DataPoint3939_1 :belongsToChart :Chart3939 ;
    rdfs:label "May 2019" ;
    :xValue "May 2019" ;
    :yValue "315.0"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .

