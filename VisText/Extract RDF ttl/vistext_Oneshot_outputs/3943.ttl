@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart3943 a schema:LineChart ;
    schema:title "Number of born children per woman" ;
    :hasXAxisLabel "Year" ;
    :hasYAxisLabel "Number of born children per woman" ;
    :xMin "2008"^^xsd:string ;
    :xMax "2016"^^xsd:string ;
    :yMin "0"^^xsd:decimal ;
    :yMax "2"^^xsd:decimal .

:DataPoint3943_1 a schema:DataPoint ;
    :belongsToChart :Chart3943 ;
    rdfs:label "2008" ;
    :xValue "2008" ;
    :yValue "2.0"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .

:DataPoint3943_2 a schema:DataPoint ;
    :belongsToChart :Chart3943 ;
    rdfs:label "2010" ;
    :xValue "2010" ;
    :yValue "2.0"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .

:DataPoint3943_3 a schema:DataPoint ;
    :belongsToChart :Chart3943 ;
    rdfs:label "2012" ;
    :xValue "2012" ;
    :yValue "2.0"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .

:DataPoint3943_4 a schema:DataPoint ;
    :belongsToChart :Chart3943 ;
    rdfs:label "2014" ;
    :xValue "2014" ;
    :yValue "2.0"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .

:DataPoint3943_5 a schema:DataPoint ;
    :belongsToChart :Chart3943 ;
    rdfs:label "2016" ;
    :xValue "2016" ;
    :yValue "2.0"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .
