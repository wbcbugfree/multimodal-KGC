:Chart6602 a schema:BarChart ;
    schema:title "Growth in bankruptcies after the coronavirus outbreak in Sweden from February to November 2020 , by industry (compared to the previous year)" ;
    :hasXAxisLabel "Nov" ;
    :hasYAxisLabel "industry" .

:DataPoint6602_1 a schema:BarChart ;
    rdfs:label "Construction" ;
    :xValue "Construction" ;
    :yValue "-0.02"^^xsd:decimal ;
    :valueEstimated "true" ;
    :belongsToChart :Chart6602 .

