@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart7674 a schema:BarChart ;
    schema:title "Consumer spending expectations for the following six months on consumer products due to the coronavirus in the United States as of March 9 , 2020" ;
    :hasXAxisLabel "About the same" ;
    :hasYAxisLabel "consumer products" ;
    :xMin "0.0"^^xsd:decimal ;
    :xMax "0.8"^^xsd:decimal .

:DataPoint7674_1 a schema:DataPoint ;
    rdfs:label "Cars/automobiles" ;
    :xValue "Cars/automobiles" ;
    :yValue "0.58"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean ;
    :belongsToChart :Chart7674 .

