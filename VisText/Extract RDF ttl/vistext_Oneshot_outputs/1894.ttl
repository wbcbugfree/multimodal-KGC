@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart1894 a schema:BarChart ;
    schema:title "Share of people using the internet to pay bills or shop something in the past year in Singapore in 2017 , by type of population" ;
    :hasXAxisLabel "Share of respondents" ;
    :hasYAxisLabel "Response" ;
    :xMin "0.0"^^xsd:decimal ;
    :xMax "0.8"^^xsd:decimal .

:DataPoint1894_1 a :DataPoint ;
    rdfs:label "Adults (25 years and older)" ;
    :xValue "Adults (25 years and older)" ;
    :yValue "0.7"^^xsd:decimal ;
    :valueEstimated "true" ;
    :belongsToChart :Chart1894 .

:DataPoint1894_2 a :DataPoint ;
    rdfs:label "In labor" ;
    :xValue "In labor" ;
    :yValue "0.75"^^xsd:decimal ;
    :valueEstimated "true" ;
    :belongsToChart :Chart1894 .

:DataPoint1894_3 a :DataPoint ;
    rdfs:label "Men" ;
    :xValue "Men" ;
    :yValue "0.65"^^xsd:decimal ;
    :valueEstimated "true" ;
    :belongsToChart :Chart1894 .

:DataPoint1894_4 a :DataPoint ;
    rdfs:label "Out of labor" ;
    :xValue "Out of labor" ;
    :yValue "0.2"^^xsd:decimal ;
    :valueEstimated "true" ;
    :belongsToChart :Chart1894 .

:DataPoint1894_5 a :DataPoint ;
    rdfs:label "Poorest 40% (income)" ;
    :xValue "Poorest 40% (income)" ;
    :yValue "0.15"^^xsd:decimal ;
    :valueEstimated "true" ;
    :belongsToChart :Chart1894 .

:DataPoint1894_6 a :DataPoint ;
    rdfs:label "Primary education or less" ;
    :xValue "Primary education or less" ;
    :yValue "0.45"^^xsd:decimal ;
    :valueEstimated "true" ;
    :belongsToChart :Chart1894 .

:DataPoint1894_7 a :DataPoint ;
    rdfs:label "Richest 60% (income)" ;
    :xValue "Richest 60% (income)" ;
    :yValue "0.7"^^xsd:decimal ;
    :valueEstimated "true" ;
    :belongsToChart :Chart1894 .

:DataPoint1894_8 a :DataPoint ;
    rdfs:label "Total" ;
    :xValue "Total" ;
    :yValue "0.6"^^xsd:decimal ;
    :valueEstimated "true" ;
    :belongsToChart :Chart1894 .

:DataPoint1894_9 a :DataPoint ;
    rdfs:label "Women" ;
    :xValue "Women" ;
    :yValue "0.55"^^xsd:decimal ;
    :valueEstimated "true" ;
    :belongsToChart :Chart1894 .

:DataPoint1894_10 a :DataPoint ;
    rdfs:label "Secondary education or less" ;
    :xValue "Secondary education or less" ;
    :yValue "0.4"^^xsd:decimal ;
    :valueEstimated "true" ;
    :belongsToChart :Chart1894 .

:DataPoint1894_11 a :DataPoint ;
    rdfs:label "Young adults (15-24 years)" ;
    :xValue "Young adults (15-24 years)" ;
    :yValue "0.6"^^xsd:decimal ;
    :valueEstimated "true" ;
    :belongsToChart :Chart1894 .
