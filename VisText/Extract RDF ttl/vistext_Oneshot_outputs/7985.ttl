@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <https://schema.org/> .

:Chart7985 a schema:LineChart ;
    schema:title "Public concern about the pollution of rivers , lakes and reservoirs in the United States from 1989 to 2017" ;
    :hasXAxisLabel "Response" ;
    :hasYAxisLabel "Only a little" ;
    :yMin "0.0"^^xsd:decimal ;
    :yMax "0.18"^^xsd:decimal .

:DataPoint7985_1 a :DataPoint ;
    :belongsToChart :Chart7985 ;
    rdfs:label "1990" ;
    :xValue "1990" ;
    :yValue "0.09"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .

