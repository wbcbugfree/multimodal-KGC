@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart7778 a schema:LineChart ;
    schema:title "Distribution of the child population in the U.S. from 2000 to 2019 , by race and Hispanic origin" ;
    :hasXAxisLabel "Year" ;
    :hasYAxisLabel "White" ;
    :yMin "0.0"^^xsd:decimal ;
    :yMax "0.6"^^xsd:decimal .

:DataPoint7778_1 a :DataPoint ;
    :belongsToChart :Chart7778 ;
    rdfs:label "2000" ;
    :xValue "2000" ;
    :yValue "0.62"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .

:DataPoint7778_2 a :DataPoint ;
    :belongsToChart :Chart7778 ;
    rdfs:label "2005" ;
    :xValue "2005" ;
    :yValue "0.59"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .

:DataPoint7778_3 a :DataPoint ;
    :belongsToChart :Chart7778 ;
    rdfs:label "2010" ;
    :xValue "2010" ;
    :yValue "0.56"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .

:DataPoint7778_4 a :DataPoint ;
    :belongsToChart :Chart7778 ;
    rdfs:label "2015" ;
    :xValue "2015" ;
    :yValue "0.53"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .

:DataPoint7778_5 a :DataPoint ;
    :belongsToChart :Chart7778 ;
    rdfs:label "2019" ;
