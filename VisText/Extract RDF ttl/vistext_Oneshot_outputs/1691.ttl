@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart1691 a schema:BarChart ;
    schema:title "Oil production in the Middle East in 2018, by country (in 1,000 barrels per day)" ;
    :hasXAxisLabel "Country" ;
    :hasYAxisLabel "Oil production in thousand barrels per day" ;
    :yMin "0"^^xsd:decimal ;
    :yMax "12000"^^xsd:decimal .

:DataPoint1691_1 a schema:DataPoint ;
    rdfs:label "Iran" ;
    :xValue "Iran" ;
    :yValue "4200"^^xsd:decimal ;
    :valueEstimated "true" ;
    :belongsToChart :Chart1691 .

