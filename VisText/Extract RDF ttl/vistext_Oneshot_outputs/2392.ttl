@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart2392 a schema:BarChart ;
    schema:title "Route length of railways across Uttar Pradesh in India from financial year 2003 to 2019 (in kilometers)" ;
    :hasXAxisLabel "Route length in kilometers" ;
    :hasYAxisLabel "year" .

:DataPoint2392_1 a schema:DataPoint ;
    rdfs:label "FY 2003" ;
    :xValue "FY 2003" ;
    :yValue "8000"^^xsd:decimal ;
    :valueEstimated "true" ;
    :belongsToChart :Chart2392 .

