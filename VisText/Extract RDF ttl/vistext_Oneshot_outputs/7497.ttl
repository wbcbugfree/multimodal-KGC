@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart7497 a schema:LineChart ;
    schema:title "Total" ;
    :hasXAxisLabel "Year" ;
    :hasYAxisLabel "Total" ;
    :yMin "0"^^xsd:decimal ;
    :yMax "300"^^xsd:decimal .

:DataPoint7497_1 a schema:DataPoint ;
    rdfs:label "2008" ;
    :xValue "2008" ;
    :yValue "280"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean ;
    :belongsToChart :Chart7497 .

:DataPoint7497_2 a schema:DataPoint ;
    rdfs:label "2012" ;
    :xValue "2012" ;
    :yValue "290"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean ;
    :belongsToChart :Chart7497 .

:DataPoint7497_3 a schema:DataPoint ;
    rdfs:label "2016" ;
    :xValue "2016" ;
    :yValue "295"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean ;
    :belongsToChart :Chart7497 .
