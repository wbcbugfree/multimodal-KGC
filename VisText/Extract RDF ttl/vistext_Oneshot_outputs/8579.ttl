    :belongsToChart :Chart8579 ;
    rdfs:label "2006" ;
    :xValue "2006" ;
    :yValue "0.29"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .

:DataPoint8579_4 a schema:DataPoint ;
    :belongsToChart :Chart8579 ;
    rdfs:label "2008" ;
    :xValue "2008" ;
    :yValue "0.27"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .

:DataPoint8579_5 a schema:DataPoint ;
    :belongsToChart :Chart8579 ;
