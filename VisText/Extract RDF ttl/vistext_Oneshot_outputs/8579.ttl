@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart8579 a schema:LineChart ;
    schema:title "United States : Employee engagement 2002 to 2012" ;
    :hasXAxisLabel "Response" ;
    :hasYAxisLabel "Engaged" ;
    :xMin "2002" ;
    :xMax "2012" ;
    :yMin "0.00"^^xsd:decimal ;
    :yMax "0.30"^^xsd:decimal .

:DataPoint8579_1 a schema:DataPoint ;
    :belongsToChart :Chart8579 ;
    rdfs:label "2002" ;
    :xValue "2002" ;
    :yValue "0.30"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .

:DataPoint8579_2 a schema:DataPoint ;
    :belongsToChart :Chart8579 ;
    rdfs:label "2004" ;
    :xValue "2004" ;
    :yValue "0.28"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .

