@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart1569 a schema:LineChart ;
    schema:title "Liberia : Life expectancy at birth from 2008 to 2018" ;
    :hasXAxisLabel "Year" ;
    :hasYAxisLabel "Life expectancy at birth in years" ;
    :xMin "2008" ;
    :xMax "2018" ;
    :yMin "0"^^xsd:decimal ;
    :yMax "70"^^xsd:decimal .

:DataPoint1569_1 a schema:DataPoint ;
    rdfs:label "2008" ;
    :xValue "2008" ;
    :yValue "58.0"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean ;
    :belongsToChart :Chart1569 .

:DataPoint1569_2 a schema:DataPoint ;
    rdfs:label "2010" ;
    :xValue "2010" ;
    :yValue "59.5"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean ;
    :belongsToChart :Chart1569 .

:DataPoint1569_3 a schema:DataPoint ;
    rdfs:label "2012" ;
    :xValue "2012" ;
    :yValue "60.8"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean ;
    :belongsToChart :Chart1569 .

:DataPoint1569_4 a schema:DataPoint ;
    rdfs:label "2014" ;
    :xValue "2014" ;
    :yValue "61.8"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean ;
    :belongsToChart :Chart1569 .

:DataPoint1569_5 a schema:DataPoint ;
    rdfs:label "2016" ;
    :xValue "2016" ;
    :yValue "62.7"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean ;
    :belongsToChart :Chart1569 .

:DataPoint1569_6 a schema:DataPoint ;
    rdfs:label "2018" ;
    :xValue "2018" ;
    :yValue "63.5"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean ;
    :belongsToChart :Chart1569 .
