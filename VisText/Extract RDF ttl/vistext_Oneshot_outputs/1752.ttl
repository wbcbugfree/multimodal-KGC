@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <https://schema.org/> .

:Chart1752 a schema:BarChart ;
    schema:title "Share of traditional quantitative methods used in the market research industry worldwide in Q3 and Q4 2018" ;
    :hasXAxisLabel "Share of respondents" ;
    :hasYAxisLabel "Response" .

:DataPoint1752_1 a :DataPoint ;
    :belongsToChart :Chart1752 ;
    rdfs:label "Other quantitative techniques" ;
    :xValue "Other quantitative techniques" ;
    :yValue 0.01 ;
    :valueEstimated "true"^^xsd:boolean .

