@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <https://schema.org/> .

:Chart7341 a schema:LineChart ;
    schema:title "Number of single-person households in the Netherlands from 2009 to 2019 , by gender" ;
    :hasXAxisLabel "Year" ;
    :hasYAxisLabel "" .

:DataPoint7341_1 a :DataPoint ;
    :belongsToChart :Chart7341 ;
    rdfs:label "Men" ;
    :xValue "2010" ;
    :yValue "1250000.0"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .

:DataPoint7341_2 a :DataPoint ;
    :belongsToChart :Chart7341 ;
    rdfs:label "Men" ;
    :xValue "2012" ;
    :yValue "1300000.0"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .

:DataPoint7341_3 a :DataPoint ;
    :belongsToChart :Chart7341 ;
    rdfs:label "Men" ;
    :xValue "2014" ;
    :yValue "1350000.0"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .

:DataPoint7341_4 a :DataPoint ;
    :belongsToChart :Chart7341 ;
    rdfs:label "Men" ;
    :xValue "2016" ;
    :yValue "1400000.0"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .

:DataPoint7341_5 a :DataPoint ;
    :belongsToChart :Chart7341 ;
    rdfs:label "Men" ;
    :xValue "2018" ;
    :yValue "1450000.0"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .
