@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart958 a schema:LineChart ;
    schema:title "France : Life expectancy at birth from 2008 to 2018" ;
    :hasXAxisLabel "Year" ;
    :hasYAxisLabel "Live expectancy at birth in years" ;
    :xMin "2008"^^xsd:string ;
    :xMax "2018"^^xsd:string ;
    :yMin "0"^^xsd:decimal ;
    :yMax "100"^^xsd:decimal .

:DataPoint958_1 a schema:DataPoint ;
    :belongsToChart :Chart958 ;
    rdfs:label "2008" ;
    :xValue "2008" ;
    :yValue "80.9"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .

:DataPoint958_2 a schema:DataPoint ;
    :belongsToChart :Chart958 ;
    rdfs:label "2010" ;
    :xValue "2010" ;
    :yValue "81.4"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .

:DataPoint958_3 a schema:DataPoint ;
    :belongsToChart :Chart958 ;
    rdfs:label "2012" ;
    :xValue "2012" ;
    :yValue "81.7"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .

:DataPoint958_4 a schema:DataPoint ;
    :belongsToChart :Chart958 ;
    rdfs:label "2014" ;
    :xValue "2014" ;
    :yValue "82.0"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .

:DataPoint958_5 a schema:DataPoint ;
    :belongsToChart :Chart958 ;
    rdfs:label "2016" ;
    :xValue "2016" ;
    :yValue "82.2"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .

:DataPoint958_6 a schema:DataPoint ;
    :belongsToChart :Chart958 ;
    rdfs:label "2018" ;
    :xValue "2018" ;
    :yValue "82.3"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .
