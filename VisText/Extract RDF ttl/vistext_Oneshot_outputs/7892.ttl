@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart7892 a schema:BarChart ;
    schema:title "Interactive kiosk market revenue in the United States from 2014 to 2025 , by component (in billion U.S. dollars)" ;
    :hasXAxisLabel "Year" ;
    :hasYAxisLabel "Software" .

:DataPoint7892_1 a schema:DataPoint ;
    rdfs:label "2014" ;
    :xValue "2014" ;
    :yValue "1.4"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean ;
    :belongsToChart :Chart7892 .

