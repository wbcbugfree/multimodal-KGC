@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart702 a schema:LineChart ;
    schema:title "Deaths per 1,000 live births over time" ;
    :hasXAxisLabel "Year" ;
    :hasYAxisLabel "Deaths per 1,000 live births" ;
    :yMin "0"^^xsd:decimal ;
    :yMax "200"^^xsd:decimal .

:DataPoint702_1 :belongsToChart :Chart702 ;
    rdfs:label "1945" ;
    :xValue "1945" ;
    :yValue "195"^^xsd:decimal ;
    :valueEstimated "true" .

