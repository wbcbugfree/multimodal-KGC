@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart5709 a schema:LineChart ;
    schema:title "Number of U.S. air strikes in Pakistan from 2004 to 2018" ;
    :hasXAxisLabel "Year" ;
    :hasYAxisLabel "Number of air strikes" ;
    :xMin "2004"^^xsd:string ;
    :xMax "2018"^^xsd:string ;
    :yMin "0"^^xsd:decimal ;
    :yMax "120"^^xsd:decimal .

