:Chart7461 a schema:BarChart ;
    schema:title "Distribution of individuals who made online purchases in Luxembourg from 2009 to 2019" ;
    :hasXAxisLabel "More than a year ago" ;
    :hasYAxisLabel "Within the first trimester of the reference year" .

