@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart754 a schema:BarChart ;
    schema:title "Annual number of computed tomography (CT) scanners in the United Kingdom (UK) from 2000 to 2014" ;
    :hasXAxisLabel "Number of scanners" ;
    :hasYAxisLabel "Year" .

:DataPoint754_1 a schema:DataPoint ;
    :belongsToChart :Chart754 ;
    rdfs:label "2000*" ;
    :xValue "2000*" ;
    :yValue "200"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .

