@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart7361 a schema:BarChart ;
    schema:title "Forecasted global oil demand due to the coronavirus pandemic in each month from 2020 to 2021 , by region (in 1,000 barrels per day)" ;
    :hasXAxisLabel "Rest of the world" ;
    :hasYAxisLabel "East Asia" .

:DataPoint7361_1 a :DataPoint ;
    :belongsToChart :Chart7361 ;
    rdfs:label "15500" ;
    :xValue "15500" ;
    :yValue "20000"^^xsd:decimal ;
    :valueEstimated "true" .

