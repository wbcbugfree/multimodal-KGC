@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart7288 a schema:BarChart ;
    schema:title "Share of businesses using social media in the United Kingdom (UK) from 2013 to 2018, by industry sector" ;
    :hasXAxisLabel "industry sector" ;
    :hasYAxisLabel "2015" .

:DataPoint7288_1 a :DataPoint ;
    :belongsToChart :Chart7288 ;
    rdfs:label "Accommodation and food services" ;
    :xValue "Accommodation and food services" ;
    :yValue "0.75"^^xsd:decimal ;
    :valueEstimated "true" .

