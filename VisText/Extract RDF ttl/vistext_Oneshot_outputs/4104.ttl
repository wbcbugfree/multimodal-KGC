@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart4104 a schema:BarChart ;
    schema:title "Leading gaming content on Twitch worldwide from January 1, 2019 to June 30, 2019, by hours watched (in millions)" ;
    :hasXAxisLabel "Number of hours watched" ;
    :hasYAxisLabel "gaming content" .

:DataPoint4104_1 a schema:DataPoint ;
    rdfs:label "Apex Legends" ;
    :yValue "150.0"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean ;
    :belongsToChart :Chart4104 .

