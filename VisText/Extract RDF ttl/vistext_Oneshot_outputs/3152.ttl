@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart3152 a schema:LineChart ;
    schema:title "Number of PwС employees worldwide from 2010 to 2020" ;
    :hasXAxisLabel "Year" ;
    :hasYAxisLabel "Number of employees" ;
    :xMin "2010" ;
    :xMax "2020" ;
    :yMin "0" ;
    :yMax "300000" .

:DataPoint3152_1 a schema:DataPoint ;
    :belongsToChart :Chart3152 ;
    rdfs:label "2010" ;
    :xValue "2010" ;
    :yValue "160000.0"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .

