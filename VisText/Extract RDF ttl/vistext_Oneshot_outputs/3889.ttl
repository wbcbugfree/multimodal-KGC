@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart3889 a schema:LineChart ;
    schema:title "Average price of home heating oil in the Canadian city of Yellowknife from 1990 to 2011 (in Canadian cents per litre)" ;
    :hasXAxisLabel "Year" ;
    :hasYAxisLabel "Price in Canadian cents per litre" ;
    :xMin "1990" ;
    :xMax "2011" ;
    :yMin "0" ;
    :yMax "140" .

:DataPoint3889_1 a schema:DataPoint ;
    :belongsToChart :Chart3889 ;
    rdfs:label "1990" ;
    :xValue "1990" ;
    :yValue "38"^^xsd:decimal ;
    :valueEstimated "true" .

