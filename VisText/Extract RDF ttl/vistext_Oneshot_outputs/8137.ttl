@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart8137 a schema:LineChart ;
    schema:title "Number of building permits issued in the Netherlands from 2006 to 2016 , by type of housing" ;
    :hasXAxisLabel "Year" ;
    :hasYAxisLabel "Rental property" ;
    :xMin "2006" ;
    :xMax "2016" ;
    :yMin "0"^^xsd:decimal ;
    :yMax "25000"^^xsd:decimal .

:DataPoint8137_1 a :Datapoint ;
    :belongsToChart :Chart8137 ;
    rdfs:label "2006" ;
    :xValue "2006" ;
    :yValue "24000"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .

