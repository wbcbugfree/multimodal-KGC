@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart644 a schema:BarChart ;
    schema:title "Estimated year-on-year revenue growth rate of selected major public apparel retailers in the United Kingdom (UK) in the fiscal year 2017 (in million GBP)" ;
    :hasXAxisLabel "Revenue growth rate" ;
    :hasYAxisLabel "major public apparel retailers" .

:DataPoint644_1 a schema:DataPoint ;
    rdfs:label "ASOS" ;
    :xValue "0.05"^^xsd:decimal ;
    :yValue "0.0"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean ;
    :belongsToChart :Chart644 .

