@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart4812 a schema:LineChart ;
    schema:title "Malaysia : Fertility rate from 2008 to 2018" ;
    :hasXAxisLabel "Year" ;
    :hasYAxisLabel "Number of born children per woman" ;
    :xMin "2008" ;
    :xMax "2018" ;
    :yMin "0.0"^^xsd:decimal ;
    :yMax "2.5"^^xsd:decimal .

:DataPoint4812_1 a :DataPoint ;
    :belongsToChart :Chart4812 ;
    rdfs:label "2008" ;
    :xValue "2008" ;
    :yValue "2.25"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .

:DataPoint4812_2 a :DataPoint ;
    :belongsToChart :Chart4812 ;
    rdfs:label "2010" ;
    :xValue "2010" ;
    :yValue "2.20"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .

:DataPoint4812_3 a :DataPoint ;
    :belongsToChart :Chart4812 ;
    rdfs:label "2012" ;
    :xValue "2012" ;
    :yValue "2.15"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .

:DataPoint4812_4 a :DataPoint ;
    :belongsToChart :Chart4812 ;
    rdfs:label "2014" ;
    :xValue "2014" ;
    :yValue "2.10"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .

:DataPoint4812_5 a :DataPoint ;
    :belongsToChart :Chart4812 ;
    rdfs:label "2016" ;
    :xValue "2016" ;
    :yValue "2.05"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .

:DataPoint4812_6 a :DataPoint ;
    :belongsToChart :Chart4812 ;
    rdfs:label "2018" ;
    :xValue "2018" ;
    :yValue "2.00"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .
