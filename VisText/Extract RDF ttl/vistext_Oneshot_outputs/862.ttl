@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart862 a schema:BarChart ;
    schema:title "Number of hours of sunshine in France in 2018 , by city" ;
    :hasXAxisLabel "city in france" ;
    :hasYAxisLabel "Hours of sunshine" ;
    :yMin "0"^^xsd:decimal ;
    :yMax "2500"^^xsd:decimal .

