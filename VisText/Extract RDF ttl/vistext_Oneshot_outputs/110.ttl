@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart110 a schema:BarChart ;
    schema:title "Market cap of leading online marketplaces worldwide as of September 2020 (in million U.S. dollars)" ;
    :hasXAxisLabel "Market cap in million U.S. dollars" ;
    :hasYAxisLabel "" .

:DataPoint110_1 :belongsToChart :Chart110 ;
    rdfs:label "Uber (United States)" ;
    :xValue "Uber (United States)" ;
    :yValue "65000.0"^^xsd:decimal ;
    :valueEstimated "true" .

