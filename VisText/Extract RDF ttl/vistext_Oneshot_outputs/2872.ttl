@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <https://schema.org/> .

:Chart2872 a schema:BarChart ;
    schema:title "Most valuable Swiss watch brands worldwide in 2016 (in million CHF)" ;
    :hasXAxisLabel "Brand" ;
    :hasYAxisLabel "Brand value in million CHF" ;
    :yMin "0"^^xsd:decimal ;
    :yMax "8000"^^xsd:decimal .

:DataPoint2872_1 a schema:DataPoint ;
    rdfs:label "Audemars Piguet" ;
    :xValue "Audemars Piguet" ;
    :yValue "1000"^^xsd:decimal ;
    :valueEstimated "true" ;
    :belongsToChart :Chart2872 .

