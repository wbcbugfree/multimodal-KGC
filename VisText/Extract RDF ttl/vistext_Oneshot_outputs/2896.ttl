@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart2896 a schema:BarChart ;
    schema:title "Most popular leisure activities among Generation X in the United States as of September 2013" ;
    :hasXAxisLabel "Response" ;
    :hasYAxisLabel "Share of respondents" ;
    :yMin "0.0"^^xsd:decimal ;
    :yMax "0.4"^^xsd:decimal .

:DataPoint2896_1 a schema:DataPoint ;
    rdfs:label "Computer/internet" ;
    :xValue "Computer/internet" ;
    :yValue "0.18"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean ;
    :belongsToChart :Chart2896 .

