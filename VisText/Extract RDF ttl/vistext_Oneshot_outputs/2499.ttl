@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart2499 a schema:BarChart ;
    schema:title "Number of road traffic fatalities in Greece from 2006 to 2019" ;
    :hasXAxisLabel "Year" ;
    :hasYAxisLabel "Number of fatalities" ;
    :yMin "0"^^xsd:decimal ;
    :yMax "1800"^^xsd:decimal .

:DataPoint2499_1 a schema:DataPoint ;
    rdfs:label "2006" ;
    :xValue "2006" ;
    :yValue "1700"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean ;
    :belongsToChart :Chart2499 .

