@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart1967 a schema:BarChart ;
    schema:title "Number of doping cases in international sports from 2000 to 2010" ;
    :hasXAxisLabel "Year" ;
    :hasYAxisLabel "Number of cases" ;
    :yMin "0"^^xsd:decimal ;
    :yMax "450"^^xsd:decimal .

:DataPoint1967_1 a schema:DataPoint ;
    rdfs:label "2000" ;
    :xValue "2000" ;
    :yValue "60"^^xsd:decimal ;
    :valueEstimated "true" ;
    :belongsToChart :Chart1967 .

:DataPoint1967_2 a schema:DataPoint ;
    rdfs:label "2001" ;
    :xValue "2001" ;
    :yValue "75"^^xsd:decimal ;
    :valueEstimated "true" ;
    :belongsToChart :Chart1967 .

