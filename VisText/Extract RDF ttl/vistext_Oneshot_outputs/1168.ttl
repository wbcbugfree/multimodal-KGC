@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart1168 a schema:BarChart ;
    schema:title "Installed power capacity across Tamil Nadu in India from financial year 2005 to 2018 (in megawatts)" ;
    :hasXAxisLabel "Financial Year" ;
    :hasYAxisLabel "Installed power capacity in megawatts" ;
    :yMin "0"^^xsd:decimal ;
    :yMax "35000"^^xsd:decimal .

:DataPoint1168_1 a schema:BarChart ;
    rdfs:label "FY 2005" ;
    :xValue "FY 2005" ;
    :yValue "13000"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean ;
    :belongsToChart :Chart1168 .

