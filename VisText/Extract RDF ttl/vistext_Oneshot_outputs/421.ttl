@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart421 a schema:BarChart ;
    schema:title "Most popular tourist attractions worldwide on Instagram as of September 2018 , by number of posts (in millions)" ;
    :hasXAxisLabel "Number of hashtagged posts in millions" ;
    :hasYAxisLabel "tourist attraction" ;
    :xMin "0"^^xsd:decimal ;
    :xMax "6"^^xsd:decimal .

:DataPoint421_1 a :DataPoint ;
    rdfs:label "Angor Wat, Cambodia" ;
    :xValue "0.5"^^xsd:decimal ;
    :yValue "0.5"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean ;
    :belongsToChart :Chart421 .

