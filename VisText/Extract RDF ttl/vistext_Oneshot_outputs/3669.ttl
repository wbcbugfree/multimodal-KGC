@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart3669 a schema:LineChart ;
    schema:title "Azerbaijan : Fertility rate from 2008 to 2018" ;
    :hasXAxisLabel "Year" ;
    :hasYAxisLabel "Number of children born per woman" ;
    :xMin "2008" ;
    :xMax "2018" ;
    :yMin "0.0" ;
    :yMax "2.0" .

:DataPoint3669_1 :belongsToChart :Chart3669 ;
    rdfs:label "2008" ;
    :xValue "2008" ;
    :yValue "1.85"^^xsd:decimal ;
    :valueEstimated "true" .

