@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart5472 a schema:BarChart ;
    schema:title "Tobacco production value worldwide in 2016, by country (in million U.S. dollars)" ;
    :hasXAxisLabel "Production value in million U.S. dollars**" ;
    :hasYAxisLabel "Country" ;
    :xMin "0"^^xsd:decimal ;
    :xMax "3500"^^xsd:decimal .

:DataPoint5472_1 a :DataPoint ;
    rdfs:label "Brazil" ;
    :xValue "250"^^xsd:decimal ;
    :yValue "250"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean ;
    :belongsToChart :Chart5472 .

