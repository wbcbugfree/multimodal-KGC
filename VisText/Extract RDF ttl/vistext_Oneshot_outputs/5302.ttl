@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <https://schema.org/> .

:Chart5302 a schema:BarChart ;
    schema:title "Total number of employees of the Richemont Group worldwide from FY2011 to FY2020" ;
    :hasXAxisLabel "Number of employees" ;
    :hasYAxisLabel "Year" .

:DataPoint5302_1 a :DataPoint ;
    :belongsToChart :Chart5302 ;
    rdfs:label "2011" ;
    :xValue "2011" ;
    :yValue "25000"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .

