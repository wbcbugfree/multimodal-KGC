@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart4780 a schema:AreaChart ;
    schema:title "Old-age dependency ratio in Singapore from 2010 to 2019" ;
