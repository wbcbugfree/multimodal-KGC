@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart3147 a schema:BarChart ;
    schema:title "Number of animal food manufacturing establishments in Canada as of December in 2019 , by region" ;
    :hasXAxisLabel "Number of establishments" ;
    :hasYAxisLabel "province of Canada" ;
    :yMin "0"^^xsd:decimal ;
    :yMax "120"^^xsd:decimal .

:DataPoint3147_1 a schema:DataPoint ;
    rdfs:label "Alberta" ;
    :xValue "Alberta" ;
    :yValue "130"^^xsd:decimal ;
    :valueEstimated "true" ;
    :belongsToChart :Chart3147 .

