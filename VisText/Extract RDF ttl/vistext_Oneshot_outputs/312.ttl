    :valueEstimated "true"^^xsd:boolean ;
    :belongsToChart :Chart312 .

:DataPoint312_7 a schema:DataPoint ;
    rdfs:label "New York" ;
    :xValue "New York" ;
    :yValue "0.04"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean ;
    :belongsToChart :Chart312 .

:DataPoint312_8 a schema:DataPoint ;
    rdfs:label "Ohio" ;
    :xValue "Ohio" ;
    :yValue "0.05"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean ;
    :belongsToChart :Chart312 .

:DataPoint312_9 a schema:DataPoint ;
    rdfs:label "Pennsylvania" ;
    :xValue "Pennsylvania" ;
    :yValue "0.045"^^xsd:decimal ;
