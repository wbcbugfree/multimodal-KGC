@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart312 a schema:BarChart ;
    schema:title "U.S. states with the biggest share of eBay sellers as of June 2020" ;
    :hasXAxisLabel "State" ;
    :hasYAxisLabel "Percent of U.S. sellers" ;
    :yMin "0.00"^^xsd:decimal ;
    :yMax "0.15"^^xsd:decimal .

:DataPoint312_1 a schema:DataPoint ;
    rdfs:label "California" ;
    :xValue "California" ;
    :yValue "0.15"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean ;
    :belongsToChart :Chart312 .

:DataPoint312_2 a schema:DataPoint ;
    rdfs:label "Florida" ;
    :xValue "Florida" ;
    :yValue "0.08"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean ;
    :belongsToChart :Chart312 .

