:Chart3028 a schema:LineChart ;
    schema:title "Electricity generation from coal in the United States from 2008 to 2019 (in million megawatt hours)" ;
    :hasXAxisLabel "Year" ;
    :hasYAxisLabel "Net generation in million megawatt hours" ;
    :yMin "0"^^xsd:decimal ;
    :yMax "2000"^^xsd:decimal .

