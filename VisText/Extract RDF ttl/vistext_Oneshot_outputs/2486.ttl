@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart2486 a schema:LineChart ;
    :hasXAxisLabel "Year" ;
    :hasYAxisLabel "Consumption in billion U.S. dollars*" ;
    :yMin "0"^^xsd:decimal ;
    :yMax "4"^^xsd:decimal .

:DataPoint2486_1 :belongsToChart :Chart2486 ;
    rdfs:label "2010" ;
    :xValue "2010" ;
    :yValue "3.8"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .

:DataPoint2486_2 :belongsToChart :Chart2486 ;
    rdfs:label "2012" ;
    :xValue "2012" ;
    :yValue "3.5"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .

:DataPoint2486_3 :belongsToChart :Chart2486 ;
    rdfs:label "2014" ;
    :xValue "2014" ;
    :yValue "3.9"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .

:DataPoint2486_4 :belongsToChart :Chart2486 ;
    rdfs:label "2016" ;
    :xValue "2016" ;
    :yValue "3.7"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .

:DataPoint2486_5 :belongsToChart :Chart2486 ;
    rdfs:label "2018" ;
    :xValue "2018" ;
    :yValue "3.9"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .
