@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart1205 a schema:LineChart ;
    schema:title "Infant mortality rate in Luxembourg from 2008 to 2019 (per 1,000 live births)" ;
    :hasXAxisLabel "Year" ;
    :hasYAxisLabel "Infant mortality rate per thousand live births" ;
    :yMin "0"^^xsd:decimal ;
    :yMax "5"^^xsd:decimal .

:DataPoint1205_1 a schema:DataPoint ;
    :belongsToChart :Chart1205 ;
    rdfs:label "2008" ;
    :xValue "2008" ;
    :yValue "2.6"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .

