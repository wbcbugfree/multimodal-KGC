@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <https://schema.org/> .

:Chart7928 a schema:LineChart ;
    schema:title "Usage penetration of mobile internet in France from 2010 to 2020 , by age group" ;
    :hasXAxisLabel "Response" ;
    :hasYAxisLabel "60-74 years" ;
    :yMin "0.0"^^xsd:decimal ;
    :yMax "0.6"^^xsd:decimal .

:DataPoint7928_1 a schema:DataPoint ;
    :belongsToChart :Chart7928 ;
    rdfs:label "2010" ;
    :xValue "2010" ;
    :yValue "0.08"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .

:DataPoint7928_2 a schema:DataPoint ;
    :belongsToChart :Chart7928 ;
    rdfs:label "2012" ;
    :xValue "2012" ;
    :yValue "0.22"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .

:DataPoint7928_3 a schema:DataPoint ;
    :belongsToChart :Chart7928 ;
    rdfs:label "2014" ;
    :xValue "2014" ;
    :yValue "0.3"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .

:DataPoint7928_4 a schema:DataPoint ;
    :belongsToChart :Chart7928 ;
    rdfs:label "2016" ;
    :xValue "2016" ;
    :yValue "0.35"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .

:DataPoint7928_5 a schema:DataPoint ;
    :belongsToChart :Chart7928 ;
    rdfs:label "2018" ;
    :xValue "2018" ;
    :yValue "0.57"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .
