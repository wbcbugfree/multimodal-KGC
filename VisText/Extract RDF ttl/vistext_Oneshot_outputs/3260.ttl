@prefix schema:<https://schema.org/> .

:Chart3260 a schema:BarChart ;
    schema:title "States with the highest femicide rate in Mexico in 2019 (number of femicides per 100,000 women)" ;
    :hasXAxisLabel "States" ;
    :hasYAxisLabel "Femicide rate" ;
    :yMin "0"^^xsd:decimal ;
    :yMax "4"^^xsd:decimal .

