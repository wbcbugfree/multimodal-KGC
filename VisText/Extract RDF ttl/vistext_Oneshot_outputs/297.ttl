@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart297 a schema:BarChart ;
    schema:title "Natural gas prices for households in the Netherlands from 2010 to 2018 , semi-annually (in euro cents per kilowatt-hour)" ;
    :hasXAxisLabel "Year" ;
    :hasYAxisLabel "Euro cents per kilowatt-hour" .

:DataPoint297_1 a :DataPoint ;
    :belongsToChart :Chart297 ;
    rdfs:label "2010 S1" ;
    :xValue "2010 S1" ;
    :yValue "6.3"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .

