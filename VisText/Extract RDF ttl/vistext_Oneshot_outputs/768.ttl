@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart768 a schema:BarChart ;
    schema:title "Indoor venue exhibition space available worldwide in 2011 , by country (in million square meters)" ;
    :hasXAxisLabel "Exhibition space in million square meters" ;
    :hasYAxisLabel "Country" .

:DataPoint768_1 a schema:DataPoint ;
    rdfs:label "Belgium" ;
    :xValue "0.2"^^xsd:decimal ;
    :yValue "0.2"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean ;
    :belongsToChart :Chart768 .

