@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart4565 a schema:BarChart ;
    schema:title "U.S. states with the lowest cancer incidence rates in 2016 (per 100,000 population)" ;
    :hasXAxisLabel "Cancer incidence per 100,000 population" ;
    :hasYAxisLabel "State" .

:DataPoint4565_1 a :DataPoint ;
    rdfs:label "Arizona" ;
    :yValue "370.0"^^xsd:decimal ;
    :valueEstimated "true" ;
    :belongsToChart :Chart4565 .

