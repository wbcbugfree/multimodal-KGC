@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart5368 a schema:BarChart ;
    schema:title "Leading trends in ethnic cuisines on restaurant menus in the United States in 2015" ;
    :hasXAxisLabel "Share of respondents" ;
    :hasYAxisLabel "Response" .

:DataPoint5368_1 a :DataPoint ;
    rdfs:label "Southeast Asian cuisine (e.g. Thai, Vietnamese, etc.)" ;
    :yValue "0.53"^^xsd:decimal ;
    :valueEstimated "true" ;
    :belongsToChart :Chart5368 .

