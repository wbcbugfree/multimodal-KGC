@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart3411 a schema:LineChart ;
    schema:title "Number of people receiving unemployment benefits in Great Britain from 2000 to 2019 (in 1,000s)" ;
    :hasXAxisLabel "Year" ;
    :hasYAxisLabel "Claimants in thousands" ;
    :xMin "2000" ;
    :xMax "2019" ;
    :yMin "0" ;
    :yMax "1600" .

:DataPoint3411_1 a :DataPoint ;
    :belongsToChart :Chart3411 ;
    rdfs:label "2000" ;
    :xValue "2000" ;
    :yValue "1000"^^xsd:decimal ;
    :valueEstimated "true" .

