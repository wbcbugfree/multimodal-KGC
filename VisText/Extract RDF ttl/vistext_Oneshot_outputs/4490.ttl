@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart4490 a schema:BarChart ;
    schema:title "Leading coffee exporting countries worldwide in 2018 (in million U.S. dollars)" ;
    :hasXAxisLabel "Trade value in million U.S. dollars" ;
    :hasYAxisLabel "Country" .

