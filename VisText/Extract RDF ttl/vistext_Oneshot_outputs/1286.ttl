@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart1286 a schema:AreaChart ;
    schema:title "Number of jobs in the travel and tourism sector in Cuba from 2010 to 2019 (in 1,000s)" ;
    :hasXAxisLabel "Year" ;
    :hasYAxisLabel "Number of jobs in thousands" ;
    :yMin "0"^^xsd:decimal ;
    :yMax "600"^^xsd:decimal .

:DataPoint1286_1 :belongsToChart :Chart1286 ;
    rdfs:label "2010" ;
    :xValue "2010" ;
    :yValue "510"^^xsd:decimal ;
    :valueEstimated "true" .

