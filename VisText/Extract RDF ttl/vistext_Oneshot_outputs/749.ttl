@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart749 a schema:LineChart ;
    :hasXAxisLabel "Year" ;
    :hasYAxisLabel "Deaths per 1,000 live births" ;
    :yMin "0"^^xsd:decimal ;
    :yMax "30"^^xsd:decimal .

:DataPoint749_1 a schema:DataPoint ;
    :belongsToChart :Chart749 ;
    rdfs:label "2010" ;
    :xValue "2010" ;
    :yValue "31.5"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .

:DataPoint749_2 a schema:DataPoint ;
    :belongsToChart :Chart749 ;
    rdfs:label "2012" ;
    :xValue "2012" ;
    :yValue "28.5"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .

:DataPoint749_3 a schema:DataPoint ;
    :belongsToChart :Chart749 ;
    rdfs:label "2014" ;
    :xValue "2014" ;
    :yValue "25.0"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .

:DataPoint749_4 a schema:DataPoint ;
    :belongsToChart :Chart749 ;
    rdfs:label "2016" ;
    :xValue "2016" ;
    :yValue "21.5"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .

:DataPoint749_5 a schema:DataPoint ;
    :belongsToChart :Chart749 ;
    rdfs:label "2018" ;
    :xValue "2018" ;
    :yValue "18.0"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .
