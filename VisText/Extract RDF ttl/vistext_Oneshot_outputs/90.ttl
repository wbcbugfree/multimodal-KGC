@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart90 a schema:LineChart ;
    schema:title "Sales of cut flowers in Canada from 2010 to 2019 (in million Canadian dollars)" ;
    :hasXAxisLabel "Year" ;
    :hasYAxisLabel "Sales in million Canadian dollars" ;
    :yMin "0"^^xsd:decimal ;
    :yMax "150"^^xsd:decimal .

:DataPoint90_1 a :DataPoint ;
    :belongsToChart :Chart90 ;
    rdfs:label "2010" ;
    :xValue "2010" ;
    :yValue "135.0"^^xsd:decimal ;
    :valueEstimated "true" .

