@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart7112 a schema:LineChart ;
    schema:title "Puerto Rico : Distribution of gross domestic product (GDP) across economic sectors from 2008 to 2018" ;
    :hasXAxisLabel "Year" ;
    :hasYAxisLabel "Industry" ;
    :yMin "0.0"^^xsd:decimal ;
    :yMax "0.6"^^xsd:decimal .

:DataPoint7112_1 :belongsToChart :Chart7112 ;
    rdfs:label "2008" ;
    :xValue "2008" ;
    :yValue "0.48"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .

