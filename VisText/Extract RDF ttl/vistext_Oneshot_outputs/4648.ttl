@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart4648 a schema:LineChart ;
    schema:title "Revenue generated by Becton , Dickinson , and Company from 2011 to 2020 (in billion U.S. dollars)" ;
    :hasXAxisLabel "Year" ;
    :hasYAxisLabel "Annual revenue in billion U.S. dollars" ;
    :yMin "0"^^xsd:decimal ;
    :yMax "15"^^xsd:decimal .

:DataPoint4648_1 :belongsToChart :Chart4648 ;
    rdfs:label "2011" ;
    :xValue "2011" ;
    :yValue "6.0"^^xsd:decimal ;
    :valueEstimated "true" .

