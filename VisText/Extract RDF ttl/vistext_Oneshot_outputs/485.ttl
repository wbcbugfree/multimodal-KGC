@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart485 a schema:BarChart ;
    schema:title "The richest self-made women billionaires in the United States in 2017 (in billion U.S. dollars)" ;
    :hasXAxisLabel "self-made women billionaires" ;
    :hasYAxisLabel "Net worth in billion U.S.dollars" ;
    :yMin "0"^^xsd:decimal ;
    :yMax "5"^^xsd:decimal .

:DataPoint485_1 a schema:DataPoint ;
    rdfs:label "Diane Hendricks" ;
    :xValue "Diane Hendricks" ;
    :yValue "4.9"^^xsd:decimal ;
    :valueEstimated "true" ;
    :belongsToChart :Chart485 .

