@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart4517 a schema:BarChart ;
    schema:title "Most popular leisure activities among Baby Boomers in the United States as of September 2013" ;
    :hasXAxisLabel "Response" ;
    :hasYAxisLabel "Share of respondents" ;
    :yMin "0.0"^^xsd:decimal ;
    :yMax "0.4"^^xsd:decimal .

:DataPoint4517_1 a schema:DataPoint ;
