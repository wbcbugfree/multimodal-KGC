@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart4530 a schema:BarChart ;
    schema:title "Greece : National debt from 2014 to 2024 (in billion U.S. dollars)" ;
    :hasXAxisLabel "National debt in billion U.S. dollars" ;
    :hasYAxisLabel "Year" .

:DataPoint4530_1 a schema:DataPoint ;
