@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart963 a schema:LineChart ;
    schema:title "Total fertility rate in Japan from 1800 to 2020" ;
    :hasXAxisLabel "Year" ;
    :hasYAxisLabel "Fertility rate" ;
    :xMin "1800"^^xsd:integer ;
    :xMax "2020"^^xsd:integer ;
    :yMin "0"^^xsd:decimal ;
    :yMax "5.5"^^xsd:decimal .

:DataPoint963_1 a schema:DataPoint ;
    :belongsToChart :Chart963 ;
    :xValue "1800" ;
    :yValue "4.2"^^xsd:decimal ;
    :valueEstimated "true" .

:DataPoint963_2 a schema:DataPoint ;
    :belongsToChart :Chart963 ;
    :xValue "1850" ;
    :yValue "4.5"^^xsd:decimal ;
    :valueEstimated "true" .

:DataPoint963_3 a schema:DataPoint ;
    :belongsToChart :Chart963 ;
    :xValue "1900" ;
    :yValue "4.7"^^xsd:decimal ;
    :valueEstimated "true" .

:DataPoint963_4 a schema:DataPoint ;
    :belongsToChart :Chart963 ;
    :xValue "1950" ;
    :yValue "3.5"^^xsd:decimal ;
    :valueEstimated "true" .

:DataPoint963_5 a schema:DataPoint ;
    :belongsToChart :Chart963 ;
    :xValue "2000" ;
    :yValue "1.3"^^xsd:decimal ;
    :valueEstimated "true" .

:DataPoint963_6 a schema:DataPoint ;
    :belongsToChart :Chart963 ;
    :xValue "2020" ;
    :yValue "1.3"^^xsd:decimal ;
    :valueEstimated "true" .
