@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart7824 a schema:LineChart ;
    schema:title "Bhutan : Age structure from 2009 to 2019" ;
    :hasXAxisLabel "Year" ;
    :hasYAxisLabel "0-14 years" ;
    :xMin "2009" ;
    :xMax "2019" ;
    :yMin "0.00"^^xsd:decimal ;
    :yMax "0.35"^^xsd:decimal .

:DataPoint7824_1 :belongsToChart :Chart7824 ;
    rdfs:label "2009" ;
    :xValue "2009" ;
    :yValue "0.325"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .

