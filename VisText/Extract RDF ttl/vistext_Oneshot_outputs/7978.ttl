@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart7978 a schema:LineChart ;
    schema:title "Distribution of postsecondary enrollment in the United States from 1980 to 2018 , by race" ;
    :hasXAxisLabel "Year" ;
    :hasYAxisLabel "" ;
    :xMin "1980"^^xsd:string ;
    :xMax "2010"^^xsd:string ;
    :yMin "0.0"^^xsd:decimal ;
    :yMax "0.010"^^xsd:decimal .

:DataPoint7978_1 a :DataPoint ;
    :belongsToChart :Chart7978 ;
    rdfs:label "1980" ;
    :xValue "1980" ;
    :yValue "0.0068"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .

:DataPoint7978_2 a :DataPoint ;
    :belongsToChart :Chart7978 ;
    rdfs:label "1990" ;
    :xValue "1990" ;
    :yValue "0.0080"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .

:DataPoint7978_3 a :DataPoint ;
    :belongsToChart :Chart7978 ;
    rdfs:label "2000" ;
    :xValue "2000" ;
    :yValue "0.0095"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .

:DataPoint7978_4 a :DataPoint ;
    :belongsToChart :Chart7978 ;
    rdfs:label "2010" ;
    :xValue "2010" ;
    :yValue "0.0075"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .
