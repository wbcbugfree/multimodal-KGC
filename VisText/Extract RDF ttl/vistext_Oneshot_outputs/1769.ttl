@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart1769 a schema:LineChart ;
    schema:title "Turkey : Fertility rate from 2008 to 2018" ;
    :hasXAxisLabel "Year" ;
    :hasYAxisLabel "Children born per woman" ;
    :xMin "2008" ;
    :xMax "2016" ;
    :yMin "0.0"^^xsd:decimal ;
    :yMax "2.5"^^xsd:decimal .

:DataPoint1769_1 a :DataPoint ;
    :belongsToChart :Chart1769 ;
    rdfs:label "2008" ;
    :xValue "2008" ;
    :yValue "2.1"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .

:DataPoint1769_2 a :DataPoint ;
    :belongsToChart :Chart1769 ;
    rdfs:label "2010" ;
    :xValue "2010" ;
    :yValue "2.05"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .

:DataPoint1769_3 a :DataPoint ;
    :belongsToChart :Chart1769 ;
    rdfs:label "2012" ;
    :xValue "2012" ;
    :yValue "2.03"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .

:DataPoint1769_4 a :DataPoint ;
    :belongsToChart :Chart1769 ;
    rdfs:label "2014" ;
    :xValue "2014" ;
    :yValue "2.01"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .

:DataPoint1769_5 a :DataPoint ;
    :belongsToChart :Chart1769 ;
    rdfs:label "2016" ;
    :xValue "2016" ;
    :yValue "1.99"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .
