@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart867 a schema:LineChart ;
    schema:title "Number of participants in roller hockey in the United States from 2006 to 2017 (in millions)" ;
    :hasXAxisLabel "Year" ;
    :hasYAxisLabel "Number of participants in millions" ;
    :xMin "2006" ;
    :xMax "2017" ;
    :yMin "0.0" ;
    :yMax "2.0" .

:DataPoint867_1 a schema:DataPoint ;
    :belongsToChart :Chart867 ;
    rdfs:label "2006" ;
    :xValue "2006" ;
    :yValue "1.45"^^xsd:decimal ;
    :valueEstimated "true" .

