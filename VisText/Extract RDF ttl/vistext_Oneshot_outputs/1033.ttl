@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart1033 a schema:LineChart ;
    schema:title "Poverty rate in Maryland from 2000 to 2019" ;
    :hasXAxisLabel "Response" ;
    :hasYAxisLabel "Percentage of population" ;
    :xMin "2000"^^xsd:string ;
    :xMax "2019"^^xsd:string ;
    :yMin "0.00"^^xsd:decimal ;
    :yMax "0.10"^^xsd:decimal .

:DataPoint1033_1 :belongsToChart :Chart1033 ;
    rdfs:label "2000" ;
    :xValue "2000" ;
    :yValue "0.087"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .

