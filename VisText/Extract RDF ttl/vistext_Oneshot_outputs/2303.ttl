@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart2303 a schema:BarChart ;
    schema:title "Installed power capacity across Rajasthan in India from financial year 2005 to 2018 (in megawatts)" ;
    :hasXAxisLabel "Installed power capacity in megawatts" ;
    :hasYAxisLabel "year" .

:DataPoint2303_1 a :DataPoint ;
    :belongsToChart :Chart2303 ;
    rdfs:label "FY 2005" ;
    :xValue "FY 2005" ;
    :yValue "4000"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .

