@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart2633 a schema:BarChart ;
    schema:title "Ireland : National debt in relation to gross domestic product (GDP) from 2015 to 2025" ;
    :hasXAxisLabel "Year" ;
    :hasYAxisLabel "National debt to GDP ratio" ;
    :yMin "0.0"^^xsd:decimal ;
    :yMax "0.8"^^xsd:decimal .

:DataPoint2633_1 a schema:DataPoint ;
    rdfs:label "2015" ;
    :xValue "2015" ;
    :yValue "0.77"^^xsd:decimal ;
    :valueEstimated "true" ;
    :belongsToChart :Chart2633 .

