@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart528 a schema:BarChart ;
    schema:title "New York Mets all-time RBI (runs batted in) leaders as of October 2020" ;
    :hasXAxisLabel "Number of home runs" ;
    :hasYAxisLabel "all-time RBI leaders" ;
    :xMin "0"^^xsd:decimal ;
    :xMax "1000"^^xsd:decimal .

:DataPoint528_1 a schema:DataPoint ;
    rdfs:label "Carlos Beltran" ;
    :yValue "500"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean ;
    :belongsToChart :Chart528 .

:DataPoint528_2 a schema:DataPoint ;
    rdfs:label "Cleon Jones" ;
    :yValue "300"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean ;
    :belongsToChart :Chart528 .

