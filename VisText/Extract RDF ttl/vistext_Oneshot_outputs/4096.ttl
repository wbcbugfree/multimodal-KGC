@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart4096 a schema:LineChart ;
    schema:title "Number of participants in surfing in the United States from 2006 to 2017 (in millions)" ;
    :hasXAxisLabel "Year" ;
    :hasYAxisLabel "Number of participants in millions" ;
    :yMin "0.0"^^xsd:decimal ;
    :yMax "3.0"^^xsd:decimal .

:DataPoint4096_1 :belongsToChart :Chart4096 ;
    rdfs:label "2006" ;
    :xValue "2006" ;
    :yValue "2.2"^^xsd:decimal ;
    :valueEstimated "true" .

