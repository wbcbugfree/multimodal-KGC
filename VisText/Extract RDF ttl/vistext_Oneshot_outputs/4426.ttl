@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart4426 a schema:BarChart ;
    schema:title "Which of the following issues do you think politicians should talk about most between now and the next general election ?" ;
    :hasXAxisLabel "Response" ;
    :hasYAxisLabel "Share of respondents" ;
    :yMin "0.0"^^xsd:decimal ;
    :yMax "0.5"^^xsd:decimal .

:DataPoint4426_1 a schema:DataPoint ;
    rdfs:label "Economic growth" ;
    :xValue "Economic growth" ;
    :yValue "0.25"^^xsd:decimal ;
    :valueEstimated "true" ;
    :belongsToChart :Chart4426 .

:DataPoint4426_2 a schema:DataPoint ;
    rdfs:label "Education" ;
    :xValue "Education" ;
    :yValue "0.13"^^xsd:decimal ;
    :valueEstimated "true" ;
    :belongsToChart :Chart4426 .

