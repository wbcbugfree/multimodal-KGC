@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart2048 a schema:BarChart ;
    schema:title "Leading life insurance companies ranked by total gross premium income in Ireland in 2018 (in 1,000 euros)" ;
    :hasXAxisLabel "Gross premium income in thousand euros" ;
    :hasYAxisLabel "Life Insurance Company" ;
    :xMin "0"^^xsd:decimal ;
    :xMax "4500000"^^xsd:decimal .

:DataPoint2048_1 a :DataPoint ;
    rdfs:label "Acorn Life" ;
    :xValue "100000"^^xsd:decimal ;
    :yValue "100000"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean ;
    :belongsToChart :Chart2048 .

