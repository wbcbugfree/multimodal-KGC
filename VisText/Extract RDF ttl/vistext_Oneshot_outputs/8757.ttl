@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart8757 a schema:LineChart ;
    schema:title "Canada : Distribution of gross domestic product (GDP) across economic sectors from 2007 to 2016" ;
    :hasXAxisLabel "Year" ;
    :hasYAxisLabel "Agriculture" .

