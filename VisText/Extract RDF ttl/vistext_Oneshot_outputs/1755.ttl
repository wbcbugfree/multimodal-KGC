@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart1755 a schema:LineChart ;
    schema:title "Proved crude oil reserves in Mexico from 2009 to 2019 (in billion barrels)" ;
    :hasXAxisLabel "Year" ;
    :hasYAxisLabel "Oil reserves in billion barrels" ;
    :xMin "2009" ;
    :xMax "2019" ;
    :yMin "0"^^xsd:decimal ;
    :yMax "11"^^xsd:decimal .

:DataPoint1755_1 a :DataPoint ;
    :belongsToChart :Chart1755 ;
    rdfs:label "2009" ;
    :xValue "2009" ;
    :yValue "10.3"^^xsd:decimal ;
    :valueEstimated "true" .

