@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart2207 a schema:LineChart ;
    schema:title "Number of aircraft arrivals at Changi Airport in Singapore from 2010 to 2019" ;
    :hasXAxisLabel "Year" ;
    :hasYAxisLabel "Number of aircraft arrivals" ;
    :xMin "2010" ;
    :xMax "2019" ;
    :yMin "0" ;
    :yMax "200000" .

:DataPoint2207_1 a :DataPoint ;
    :belongsToChart :Chart2207 ;
    rdfs:label "2010" ;
    :xValue "2010" ;
    :yValue "135000"^^xsd:decimal ;
    :valueEstimated "true" .

