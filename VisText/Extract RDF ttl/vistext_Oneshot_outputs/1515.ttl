@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart1515 a schema:BarChart ;
    schema:title "Average expenditure per person per week on food and drink in the United Kingdom (UK) from 2006 to 2018/2019 (in pence)" ;
    :hasXAxisLabel "Year" ;
    :hasYAxisLabel "Average expenditure in British pence sterling" ;
    :yMin "0"^^xsd:decimal ;
    :yMax "5000"^^xsd:decimal .

