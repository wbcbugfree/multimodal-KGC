@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart1748 a schema:LineChart ;
    schema:title "Dependency rate on energy imports in Turkey from 2008 to 2017" ;
    :hasXAxisLabel "Year" ;
    :hasYAxisLabel "Energy imports dependency rate" ;
    :yMin "0.0"^^xsd:decimal ;
    :yMax "0.8"^^xsd:decimal .

