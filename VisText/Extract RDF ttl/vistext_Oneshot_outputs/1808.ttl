@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart1808 a schema:BarChart ;
    schema:title "Degree of internet freedom in Middle East and North Africa according to the Freedom House Index 2019 , by country (index points)" ;
    :hasXAxisLabel "Country" ;
    :hasYAxisLabel "Index points" ;
    :yMin "0"^^xsd:decimal ;
    :yMax "60"^^xsd:decimal .

