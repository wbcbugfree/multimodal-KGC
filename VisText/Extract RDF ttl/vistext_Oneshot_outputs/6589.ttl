@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart6589 a schema:AreaChart ;
    schema:title "Number of employees in the gambling industry in the United Kingdom from 2009 to 2019 , by sector" ;
    :hasXAxisLabel "year" ;
    :hasYAxisLabel "Bingo" .

