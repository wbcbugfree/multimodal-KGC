@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart5266 a schema:BarChart ;
    schema:title "Leading Cricket Twenty20 World Cup wicket-takers as of September 2020" ;
    :hasXAxisLabel "Number of wickets taken" ;
    :hasYAxisLabel "player name" ;
    :xMin "0"^^xsd:decimal ;
    :xMax "40"^^xsd:decimal .

:DataPoint5266_1 a schema:DataPoint ;
    rdfs:label "BAW Mendis (SL)" ;
    :xValue "BAW Mendis (SL)" ;
    :yValue "38"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean ;
    :belongsToChart :Chart5266 .

