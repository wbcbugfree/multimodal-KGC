@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart6225 a schema:BarChart ;
    schema:title "Average price of diesel fuel in France between January 2013 and December 2018 (in euros per liter)" ;
    :hasXAxisLabel "2016" ;
    :hasYAxisLabel "Month" .

:DataPoint6225_1 a schema:BarChart ;
    :belongsToChart :Chart6225 ;
    rdfs:label "Apr" ;
    :xValue "Apr" ;
    :yValue "1.18"^^xsd:decimal ;
    :valueEstimated "true" .

