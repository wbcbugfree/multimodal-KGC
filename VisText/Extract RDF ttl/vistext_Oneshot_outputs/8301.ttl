@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart8301 a schema:LineChart ;
    schema:title "Average age at widow (er) hood in the Netherlands from 2008 to 2018 , by gender (in years)" ;
    :hasXAxisLabel "Year" ;
    :hasYAxisLabel "Men" .

:DataPoint8301_1 :belongsToChart :Chart8301 ;
    rdfs:label "Men" ;
    :xValue "2008" ;
    :yValue "72.0"^^xsd:decimal ;
    :valueEstimated "true" .

:DataPoint8301_2 :belongsToChart :Chart8301 ;
    rdfs:label "Men" ;
    :xValue "2010" ;
    :yValue "72.5"^^xsd:decimal ;
    :valueEstimated "true" .

:DataPoint8301_3 :belongsToChart :Chart8301 ;
    rdfs:label "Men" ;
    :xValue "2012" ;
    :yValue "73.0"^^xsd:decimal ;
    :valueEstimated "true" .

:DataPoint8301_4 :belongsToChart :Chart8301 ;
    rdfs:label "Men" ;
    :xValue "2014" ;
    :yValue "73.5"^^xsd:decimal ;
    :valueEstimated "true" .

:DataPoint8301_5 :belongsToChart :Chart8301 ;
    rdfs:label "Men" ;
    :xValue "2016" ;
    :yValue "74.0"^^xsd:decimal ;
    :valueEstimated "true" .

:DataPoint8301_6 :belongsToChart :Chart8301 ;
    rdfs:label "Men" ;
    :xValue "2018" ;
    :yValue "74.5"^^xsd:decimal ;
    :valueEstimated "true" .
