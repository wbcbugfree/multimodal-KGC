@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart100 a schema:BarChart ;
    schema:title "Annual number of hospital beds in the United Kingdom (UK) from 2000 to 2019" ;
    :hasXAxisLabel "Year" ;
    :hasYAxisLabel "Number of beds" ;
    :yMin "0"^^xsd:decimal ;
    :yMax "250000"^^xsd:decimal .

:DataPoint100_1 a :Datapoint ;
    :belongsToChart :Chart100 ;
    rdfs:label "2000" ;
    :xValue "2000" ;
    :yValue "245000"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .

