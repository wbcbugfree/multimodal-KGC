@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart3062 a schema:LineChart ;
    :hasXAxisLabel "Year" ;
    :hasYAxisLabel "Population in millions" ;
    :yMin "0"^^xsd:decimal ;
    :yMax "25"^^xsd:decimal .

:DataPoint3062_1 :belongsToChart :Chart3062 ;
    rdfs:label "1800" ;
    :xValue "1800" ;
    :yValue "0.1"^^xsd:decimal ;
    :valueEstimated "true" .

:DataPoint3062_2 :belongsToChart :Chart3062 ;
    rdfs:label "1850" ;
    :xValue "1850" ;
    :yValue "0.5"^^xsd:decimal ;
    :valueEstimated "true" .

:DataPoint3062_3 :belongsToChart :Chart3062 ;
    rdfs:label "1900" ;
    :xValue "1900" ;
    :yValue "1.6"^^xsd:decimal ;
    :valueEstimated "true" .

:DataPoint3062_4 :belongsToChart :Chart3062 ;
    rdfs:label "1950" ;
    :xValue "1950" ;
    :yValue "5.0"^^xsd:decimal ;
    :valueEstimated "true" .

:DataPoint3062_5 :belongsToChart :Chart3062 ;
    rdfs:label "2000" ;
    :xValue "2000" ;
    :yValue "15.0"^^xsd:decimal ;
    :valueEstimated "true" .

:DataPoint3062_6 :belongsToChart :Chart3062 ;
    rdfs:label "2020" ;
    :xValue "2020" ;
    :yValue "24.0"^^xsd:decimal ;
    :valueEstimated "true" .
