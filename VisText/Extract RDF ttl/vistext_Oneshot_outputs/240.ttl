@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart240 a schema:LineChart ;
    schema:title "Budget expenditure of the central government in Norway from 2010 to 2020 (in billion NOK)" ;
    :hasXAxisLabel "Year" ;
    :hasYAxisLabel "Expenditure in billion NOK" ;
    :yMin "0"^^xsd:decimal ;
    :yMax "1500"^^xsd:decimal .

:DataPoint240_1 a :DataPoint ;
    :belongsToChart :Chart240 ;
    rdfs:label "2010" ;
    :xValue "2010" ;
    :yValue "850"^^xsd:decimal ;
    :valueEstimated "true" .

:DataPoint240_2 a :DataPoint ;
    :belongsToChart :Chart240 ;
    rdfs:label "2012" ;
    :xValue "2012" ;
    :yValue "950"^^xsd:decimal ;
    :valueEstimated "true" .

:DataPoint240_3 a :DataPoint ;
    :belongsToChart :Chart240 ;
    rdfs:label "2014" ;
    :xValue "2014" ;
    :yValue "1050"^^xsd:decimal ;
    :valueEstimated "true" .

:DataPoint240_4 a :DataPoint ;
    :belongsToChart :Chart240 ;
    rdfs:label "2016" ;
    :xValue "2016" ;
    :yValue "1200"^^xsd:decimal ;
    :valueEstimated "true" .

:DataPoint240_5 a :DataPoint ;
    :belongsToChart :Chart240 ;
    rdfs:label "2018" ;
    :xValue "2018" ;
    :yValue "1250"^^xsd:decimal ;
    :valueEstimated "true" .

:DataPoint240_6 a :DataPoint ;
    :belongsToChart :Chart240 ;
    rdfs:label "2020" ;
    :xValue "2020" ;
    :yValue "1350"^^xsd:decimal ;
    :valueEstimated "true" .
