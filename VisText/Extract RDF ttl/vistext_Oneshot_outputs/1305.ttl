@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart1305 a schema:BarChart ;
    schema:title "El Salvador : National debt from 2014 to 2024 (in billion U.S. dollars)" ;
    :hasXAxisLabel "National debt in billion U.S. dollars" ;
    :hasYAxisLabel "Year" .

