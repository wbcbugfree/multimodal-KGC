@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart2056 a schema:LineChart ;
    schema:title "Economic damage caused by North Atlantic tropical cyclones in the U.S. from 1995 to 2019 (in million U.S. dollars)" ;
    :hasXAxisLabel "Year" ;
    :hasYAxisLabel "Damage in million U.S. dollars" ;
    :xMin "1995" ;
    :xMax "2019" ;
    :yMin "0"^^xsd:decimal ;
    :yMax "100000"^^xsd:decimal .

:DataPoint2056_1 a schema:DataPoint ;
    rdfs:label "1995" ;
    :xValue "1995" ;
    :yValue "5000"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean ;
    :belongsToChart :Chart2056 .

