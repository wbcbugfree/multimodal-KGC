@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart1550 a schema:BarChart ;
    schema:title "Costa Rica : National debt from 2015 to 2025 in relation to gross domestic product (GDP)" ;
    :hasXAxisLabel "Year" ;
    :hasYAxisLabel "National debt in relation to GDP" ;
    :yMin "0.0"^^xsd:decimal ;
    :yMax "0.8"^^xsd:decimal .

:DataPoint1550_1 a schema:DataPoint ;
    rdfs:label "2015" ;
    :xValue "2015" ;
    :yValue "0.4"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean ;
    :belongsToChart :Chart1550 .

