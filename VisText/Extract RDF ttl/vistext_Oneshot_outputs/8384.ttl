@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart8384 a schema:BarChart ;
    schema:title "Per capita consumption of wine and sparkling wine in Germany from 2008 to 2019 (in liters)" ;
    :hasXAxisLabel "Sparkling wine" ;
    :hasYAxisLabel "Wine" .

:DataPoint8384_1 a schema:DataPoint ;
    rdfs:label "20.1" ;
    :xValue "20.1" ;
    :yValue "7.5"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean ;
    :belongsToChart :Chart8384 .

