@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart6423 a schema:BarChart ;
    schema:title "Average payroll of Major League Baseball teams from 2002 to 2012 (in million U.S. dollars)" ;
    :hasXAxisLabel "Year" ;
    :hasYAxisLabel "All teams" ;
    :yMin "0"^^xsd:decimal ;
    :yMax "100"^^xsd:decimal .

:DataPoint6423_1 a schema:DataPoint ;
    rdfs:label "2002" ;
    :xValue "2002" ;
    :yValue "64.0"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean ;
    :belongsToChart :Chart6423 .

