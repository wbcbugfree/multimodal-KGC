@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart2282 a schema:LineChart ;
    schema:title "Annual number of deaths as a result of breast cancer in Spain from 2005 to 2018" ;
    :hasXAxisLabel "Year" ;
    :hasYAxisLabel "Number of deaths" ;
    :xMin "2005"^^xsd:string ;
    :xMax "2018"^^xsd:string ;
    :yMin "0"^^xsd:decimal ;
    :yMax "6000"^^xsd:decimal .

:DataPoint2282_1 a schema:DataPoint ;
    rdfs:label "2005" ;
    :xValue "2005" ;
    :yValue "5500"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean ;
    :belongsToChart :Chart2282 .

