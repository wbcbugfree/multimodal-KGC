@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart3041 a schema:BarChart ;
    schema:title "Reach of leading social networking sites used by those aged 26 - 35 in the United Kingdom (UK) as of 3rd quarter 2020" ;
    :hasXAxisLabel "Share of respondents" ;
    :hasYAxisLabel "Response" .

:DataPoint3041_1 a :DataPoint ;
    rdfs:label "Facebook" ;
    :xValue "Facebook" ;
    :yValue "0.80"^^xsd:decimal ;
    :valueEstimated "true" ;
    :belongsToChart :Chart3041 .

