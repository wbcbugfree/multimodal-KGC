@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart3957 a schema:LineChart ;
    schema:title "Total number of farms in Denmark from 2010 to 2019" ;
    :hasXAxisLabel "Year" ;
    :hasYAxisLabel "Number of farms" ;
    :xMin "2010"^^xsd:string ;
    :xMax "2019"^^xsd:string ;
    :yMin "0"^^xsd:decimal ;
    :yMax "40000"^^xsd:decimal .

:DataPoint3957_1 a schema:DataPoint ;
    rdfs:label "2010" ;
    :xValue "2010" ;
    :yValue "43000"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean ;
    :belongsToChart :Chart3957 .

:DataPoint3957_2 a schema:DataPoint ;
    rdfs:label "2012" ;
    :xValue "2012" ;
    :yValue "41500"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean ;
    :belongsToChart :Chart3957 .

:DataPoint3957_3 a schema:DataPoint ;
    rdfs:label "2014" ;
    :xValue "2014" ;
    :yValue "40000"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean ;
    :belongsToChart :Chart3957 .

:DataPoint3957_4 a schema:DataPoint ;
    rdfs:label "2016" ;
    :xValue "2016" ;
    :yValue "38000"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean ;
    :belongsToChart :Chart3957 .

:DataPoint3957_5 a schema:DataPoint ;
    rdfs:label "2018" ;
    :xValue "2018" ;
    :yValue "36500"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean ;
    :belongsToChart :Chart3957 .

:DataPoint3957_6 a schema:DataPoint ;
    rdfs:label "2019" ;
    :xValue "2019" ;
    :yValue "35500"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean ;
    :belongsToChart :Chart3957 .
