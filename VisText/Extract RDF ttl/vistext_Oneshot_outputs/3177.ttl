@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart3177 a schema:BarChart ;
    schema:title "Stress symptoms during the past month reported by U.S. teenagers in 2013" ;
    :hasXAxisLabel "Response" ;
    :hasYAxisLabel "Percentage of respondents" ;
    :yMin "0.0"^^xsd:decimal ;
    :yMax "0.4"^^xsd:decimal .

:DataPoint3177_1 a :DataPoint ;
    rdfs:label "Changes in sleeping habits" ;
    :xValue "Changes in sleeping habits" ;
    :yValue "0.27"^^xsd:decimal ;
    :valueEstimated "true" ;
    :belongsToChart :Chart3177 .

