@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart6847 a schema:LineChart ;
    schema:title "Average annual income in Belgium from 2006 to 2017 , by region (in euros)" ;
    :hasXAxisLabel "Response" ;
    :hasYAxisLabel "Walloon Region" .

:DataPoint6847_1 a :DataPoint ;
    :belongsToChart :Chart6847 ;
    rdfs:label "2006" ;
    :xValue "2006" ;
    :yValue "11500.0"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .

