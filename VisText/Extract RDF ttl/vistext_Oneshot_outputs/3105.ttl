@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart3105 a schema:BarChart ;
    schema:title "Largest export commodities of the United Kingdom (UK) in 2019 (in billion GBP)" ;
    :hasXAxisLabel "Value of exports in billion GBP" ;
    :hasYAxisLabel "Export commodity" .

:DataPoint3105_1 a :DataPoint ;
    rdfs:label "Animal, vegetable oils and fats" ;
    :yValue "20.0"^^xsd:decimal ;
    :valueEstimated "true" ;
    :belongsToChart :Chart3105 .

:DataPoint3105_2 a :DataPoint ;
    rdfs:label "Beverages and tobacco" ;
    :yValue "5.0"^^xsd:decimal ;
    :valueEstimated "true" ;
    :belongsToChart :Chart3105 .

:DataPoint3105_3 a :DataPoint ;
    rdfs:label "Chemicals" ;
    :yValue "30.0"^^xsd:decimal ;
    :valueEstimated "true" ;
    :belongsToChart :Chart3105 .

:DataPoint3105_4 a :DataPoint ;
    rdfs:label "Crude Materials" ;
    :yValue "3.0"^^xsd:decimal ;
    :valueEstimated "true" ;
    :belongsToChart :Chart3105 .

:DataPoint3105_5 a :DataPoint ;
    rdfs:label "Food and live animals" ;
    :yValue "10.0"^^xsd:decimal ;
    :valueEstimated "true" ;
    :belongsToChart :Chart3105 .

:DataPoint3105_6 a :DataPoint ;
    rdfs:label "Fuels" ;
    :yValue "25.0"^^xsd:decimal ;
    :valueEstimated "true" ;
    :belongsToChart :Chart3105 .

:DataPoint3105_7 a :DataPoint ;
    rdfs:label "Machinery and transport equipment" ;
    :yValue "155.0"^^xsd:decimal ;
    :valueEstimated "true" ;
    :belongsToChart :Chart3105 .

:DataPoint3105_8 a :DataPoint ;
    rdfs:label "Material Manufactures" ;
    :yValue "40.0"^^xsd:decimal ;
    :valueEstimated "true" ;
    :belongsToChart :Chart3105 .

:DataPoint3105_9 a :DataPoint ;
    rdfs:label "Miscellanueous manufactures" ;
    :yValue "45.0"^^xsd:decimal ;
    :valueEstimated "true" ;
    :belongsToChart :Chart3105 .

:DataPoint3105_10 a :DataPoint ;
    rdfs:label "Unspecified goods" ;
    :yValue "15.0"^^xsd:decimal ;
    :valueEstimated "true" ;
    :belongsToChart :Chart3105 .
