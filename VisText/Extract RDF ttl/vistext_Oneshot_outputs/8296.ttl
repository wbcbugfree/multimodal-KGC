@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart8296 a schema:LineChart ;
    schema:title "Number of Facebook fans/twitter followers of the Houston Texans (NFL) from 2012 to 2020 (in millions)" ;
    :hasXAxisLabel "Month" ;
    :hasYAxisLabel "Twitter followers" ;
    :yMin "0.0"^^xsd:decimal ;
    :yMax "2.0"^^xsd:decimal .

:DataPoint8296_1 a :DataPoint ;
    :belongsToChart :Chart8296 ;
    rdfs:label "2012" ;
    :xValue "2012" ;
    :yValue "0.1"^^xsd:decimal ;
    :valueEstimated "true" .

