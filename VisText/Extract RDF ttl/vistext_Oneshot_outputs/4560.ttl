@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart4560 a schema:LineChart ;
    schema:title "Percentage of elderly population in Italy from 2009 to 2020" ;
    :hasXAxisLabel "Response" ;
    :hasYAxisLabel "Share of elderly people" ;
    :xMin "2009"^^xsd:string ;
    :xMax "2020"^^xsd:string ;
    :yMin "0.00"^^xsd:decimal ;
    :yMax "0.25"^^xsd:decimal .

:DataPoint4560_1 a schema:DataPoint ;
    rdfs:label "2009" ;
    :xValue "2009" ;
    :yValue "0.205"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean ;
    :belongsToChart :Chart4560 .

