@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart8402 a schema:LineChart ;
    schema:title "Rural Population Trend" ;
    :hasXAxisLabel "Month" ;
    :hasYAxisLabel "Rural" ;
    :yMin "0"^^xsd:decimal ;
    :yMax "150"^^xsd:decimal .

:DataPoint8402_1 a :DataPoint ;
    :belongsToChart :Chart8402 ;
    rdfs:label "July 2019" ;
    :xValue "July 2019" ;
    :yValue "147.0"^^xsd:decimal ;
    :valueEstimated "true" .

:DataPoint8402_2 a :DataPoint ;
    :belongsToChart :Chart8402 ;
    rdfs:label "October 2019" ;
    :xValue "October 2019" ;
    :yValue "148.0"^^xsd:decimal ;
    :valueEstimated "true" .

:DataPoint8402_3 a :DataPoint ;
    :belongsToChart :Chart8402 ;
    rdfs:label "2020" ;
    :xValue "2020" ;
    :yValue "149.0"^^xsd:decimal ;
    :valueEstimated "true" .

:DataPoint8402_4 a :DataPoint ;
    :belongsToChart :Chart8402 ;
    rdfs:label "April 2021" ;
    :xValue "April 2021" ;
    :yValue "150.0"^^xsd:decimal ;
    :valueEstimated "true" .
