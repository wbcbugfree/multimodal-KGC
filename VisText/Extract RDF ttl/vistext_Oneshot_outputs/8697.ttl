@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart8697 a schema:LineChart ;
    schema:title "Distribution of gross domestic product (GDP) across economic sectors worldwide from 2008 to 2018" ;
    :hasXAxisLabel "Year" ;
    :hasYAxisLabel "Agriculture" ;
    :yMin "0.00"^^xsd:decimal ;
    :yMax "0.04"^^xsd:decimal .

:DataPoint8697_1 :belongsToChart :Chart8697 ;
    rdfs:label "2008" ;
    :xValue "2008" ;
    :yValue "0.037"^^xsd:decimal ;
    :valueEstimated "true" .

