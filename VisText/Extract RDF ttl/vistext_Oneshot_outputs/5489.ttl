@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart5489 a schema:LineChart ;
    schema:title "Worldwide number of Airbus aircraft deliveries from 2002 to 2019 (in units)" ;
    :hasXAxisLabel "Year" ;
    :hasYAxisLabel "Number of aircraft deliveries" ;
    :xMin "2002"^^xsd:string ;
    :xMax "2019"^^xsd:string ;
    :yMin "0"^^xsd:decimal ;
    :yMax "800"^^xsd:decimal .

:DataPoint5489_1 :belongsToChart :Chart5489 ;
    rdfs:label "2002" ;
    :xValue "2002" ;
    :yValue "230"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .

