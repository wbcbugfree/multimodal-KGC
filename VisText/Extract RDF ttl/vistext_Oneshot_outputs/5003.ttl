@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <https://schema.org/> .

:Chart5003 a schema:BarChart ;
    schema:title "Most popular car brands among U.S. physicians as of 2012" ;
    :hasXAxisLabel "Percentage of respondents" ;
    :hasYAxisLabel "Response" .

:DataPoint5003_1 a :DataPoint ;
    rdfs:label "Audi" ;
    :xValue "Audi" ;
    :yValue 3.0 ;
    :valueEstimated "true"^^xsd:boolean ;
    :belongsToChart :Chart5003 .

