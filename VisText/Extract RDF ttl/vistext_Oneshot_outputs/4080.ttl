    :belongsToChart :Chart4080 ;
    rdfs:label "2010" ;
    :xValue "2010" ;
    :yValue "25.5"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .

:DataPoint4080_4 a schema:DataPoint ;
    :belongsToChart :Chart4080 ;
    rdfs:label "2012" ;
    :xValue "2012" ;
    :yValue "31.0"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .

:DataPoint4080_5 a schema:DataPoint ;
    :belongsToChart :Chart4080 ;
    rdfs:label "2014" ;
    :xValue "2014" ;
    :yValue "35.0"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .

:DataPoint4080_6 a schema:DataPoint ;
    :belongsToChart :Chart4080 ;
    rdfs:label "2016" ;
    :xValue "2016" ;
    :yValue "37.5"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .

:DataPoint4080_7 a schema:DataPoint ;
    :belongsToChart :Chart4080 ;
    rdfs:label "2018" ;
    :xValue "2018" ;
    :yValue "41.0"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .
