@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart4080 a schema:LineChart ;
    schema:title "Aggregated gross revenues of PwC 2006 to 2020 (in billion U.S. dollars)" ;
    :hasXAxisLabel "Year" ;
    :hasYAxisLabel "Revenue in billion U.S. dollars" ;
    :yMin "0"^^xsd:decimal ;
    :yMax "40"^^xsd:decimal .

:DataPoint4080_1 a schema:DataPoint ;
    :belongsToChart :Chart4080 ;
    rdfs:label "2006" ;
    :xValue "2006" ;
    :yValue "22.5"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .

:DataPoint4080_2 a schema:DataPoint ;
    :belongsToChart :Chart4080 ;
    rdfs:label "2008" ;
    :xValue "2008" ;
    :yValue "25.5"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .

