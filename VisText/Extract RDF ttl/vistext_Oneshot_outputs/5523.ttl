@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart5523 a schema:BarChart ;
    schema:title "Number of people affected by the world \'s major volcanic eruptions from 1900 to 2016" ;
    :hasXAxisLabel "volcanic eruption and date" ;
    :hasYAxisLabel "Number of victims" ;
    :yMin "0"^^xsd:decimal ;
    :yMax "1000000"^^xsd:decimal .

:DataPoint5523_1 a :DataPoint ;
    :belongsToChart :Chart5523 ;
    rdfs:label "Volcano eruption in Indonesia" ;
    :xValue "Volcano eruption in Indonesia" ;
    :yValue "230000"^^xsd:decimal ;
    :valueEstimated "true" .

