@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart2554 a schema:LineChart ;
    schema:title "Gross domestic product (GDP) per capita at current prices in Denmark from 2009 to 2019 (in thousand DKK)" ;
    :hasXAxisLabel "Year" ;
    :hasYAxisLabel "GDP in thousand DKK" ;
    :yMin "0"^^xsd:decimal ;
    :yMax "400"^^xsd:decimal .

:DataPoint2554_1 a :DataPoint ;
