@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart7407 a schema:LineChart ;
    schema:title "Indonesia : Distribution of employment by economic sector from 2010 to 2020" ;
    :hasXAxisLabel "Year" ;
    :hasYAxisLabel "Agriculture" .

:DataPoint7407_1 a :DataPoint ;
    :belongsToChart :Chart7407 ;
    rdfs:label "2010" ;
    :xValue "2010" ;
    :yValue "0.395"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .

:DataPoint7407_2 a :DataPoint ;
    :belongsToChart :Chart7407 ;
    rdfs:label "2012" ;
    :xValue "2012" ;
    :yValue "0.375"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .

:DataPoint7407_3 a :DataPoint ;
    :belongsToChart :Chart7407 ;
    rdfs:label "2014" ;
    :xValue "2014" ;
    :yValue "0.36"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .

:DataPoint7407_4 a :DataPoint ;
    :belongsToChart :Chart7407 ;
    rdfs:label "2016" ;
    :xValue "2016" ;
    :yValue "0.34"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .

:DataPoint7407_5 a :DataPoint ;
    :belongsToChart :Chart7407 ;
    rdfs:label "2018" ;
    :xValue "2018" ;
    :yValue "0.32"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .

:DataPoint7407_6 a :DataPoint ;
    :belongsToChart :Chart7407 ;
    rdfs:label "2020" ;
    :xValue "2020" ;
    :yValue "0.29"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .
