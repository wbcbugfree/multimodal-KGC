@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart175 a schema:LineChart ;
    schema:title "Number of Merck & Co. 's common shares outstanding from 2009 to 2019 (in millions)" ;
    :hasXAxisLabel "Year" ;
    :hasYAxisLabel "Number of shares in millions" .

