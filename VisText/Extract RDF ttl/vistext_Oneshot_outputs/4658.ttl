@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart4658 a schema:BarChart ;
    schema:title "Symbol groups ranked by number of convenience stores in the United Kingdom (UK) in 2014" ;
    :hasXAxisLabel "symbol group" ;
    :hasYAxisLabel "Number of stores" ;
    :yMin "0"^^xsd:decimal ;
    :yMax "3000"^^xsd:decimal .

:DataPoint4658_1 a schema:DataPoint ;
    rdfs:label "Best-one" ;
    :xValue "Best-one" ;
    :yValue "2900"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean ;
    :belongsToChart :Chart4658 .

