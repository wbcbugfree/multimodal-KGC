@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart8200 a schema:BarChart ;
    schema:title "Products and services people spend more than usual on due to the COVID-19 / coronavirus pandemic in the United States , United Kingdom and Germany 2020 (as of May 31)" ;
    :hasXAxisLabel "Response" ;
    :hasYAxisLabel "United States" .

:DataPoint8200_1 :belongsToChart :Chart8200 ;
    rdfs:label "Childcare" ;
    :xValue "Childcare" ;
    :yValue "0.04"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .

