@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart2907 a schema:BarChart ;
    schema:title "Annual consumption volume of tomatoes in Austria from 2008/09 to 2017/18 (in tonnes)" ;
    :hasXAxisLabel "Consumption volume in tonnes" ;
    :hasYAxisLabel "Year" ;
    :xMin "0"^^xsd:decimal ;
    :xMax "250000"^^xsd:decimal .

:DataPoint2907_1 a :DataPoint ;
    rdfs:label "2008/09" ;
    :xValue "2008/09" ;
    :yValue "220000"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean ;
    :belongsToChart :Chart2907 .

