@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart8203 a schema:BarChart ;
    schema:title "Share of online users in the United States who use selected social media platforms as of 3rd quarter 2020" ;
    :hasXAxisLabel "Q4 2018" ;
    :hasYAxisLabel "Platform" .

:DataPoint8203_1 a :DataPoint ;
    rdfs:label "Facebook" ;
    :xValue "0.7" ;
    :yValue "0.7"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean ;
    :belongsToChart :Chart8203 .

