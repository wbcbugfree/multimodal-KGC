@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart7504 a schema:BarChart ;
    schema:title "Thinking about once the restrictions are lifted , which of the following are you likely to try and avoid for the time being , because of coronavirus / Covid-19 ? (as of May 31 , 2020)" ;
    :hasXAxisLabel "Response" ;
    :hasYAxisLabel "United States" .

:DataPoint7504_1 a schema:DataPoint ;
    rdfs:label "Cinema / theatre" ;
    :xValue "Cinema / theatre" ;
    :yValue "0.58"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean ;
    :belongsToChart :Chart7504 .

