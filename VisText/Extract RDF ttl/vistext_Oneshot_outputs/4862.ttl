@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart4862 a schema:BarChart ;
    schema:title "Sugar production in the United States from 2009/2010 to 2019/2020 (in million metric tons)" ;
    :hasXAxisLabel "Production in million metric tons" ;
    :hasYAxisLabel "Year" .

:DataPoint4862_1 a :DataPoint ;
    :belongsToChart :Chart4862 ;
    rdfs:label "2009/2010" ;
    :xValue "2009/2010" ;
    :yValue "7.8"^^xsd:decimal ;
    :valueEstimated "true" .

