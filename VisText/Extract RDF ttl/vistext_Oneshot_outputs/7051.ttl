@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart7051 a schema:LineChart ;
    schema:title "Percentage of households in the U.S. from 1990 to 2020 , by type" ;
    :hasXAxisLabel "Year" ;
    :hasYAxisLabel "Female householder, no spouse present" ;
    :yMin "0.00"^^xsd:decimal ;
    :yMax "0.14"^^xsd:decimal .

:DataPoint7051_1 a :DataPoint ;
    :belongsToChart :Chart7051 ;
    rdfs:label "1990" ;
    :xValue "1990" ;
    :yValue "0.12"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .

:DataPoint7051_2 a :DataPoint ;
    :belongsToChart :Chart7051 ;
    rdfs:label "2000" ;
    :xValue "2000" ;
    :yValue "0.125"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .

:DataPoint7051_3 a :DataPoint ;
    :belongsToChart :Chart7051 ;
    rdfs:label "2005" ;
    :xValue "2005" ;
    :yValue "0.13"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .

:DataPoint7051_4 a :DataPoint ;
    :belongsToChart :Chart7051 ;
    rdfs:label "2010" ;
    :xValue "2010" ;
    :yValue "0.135"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .

:DataPoint7051_5 a :DataPoint ;
    :belongsToChart :Chart7051 ;
    rdfs:label "2015" ;
    :xValue "2015" ;
    :yValue "0.125"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .

:DataPoint7051_6 a :DataPoint ;
    :belongsToChart :Chart7051 ;
    rdfs:label "2020" ;
    :xValue "2020" ;
    :yValue "0.12"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .
