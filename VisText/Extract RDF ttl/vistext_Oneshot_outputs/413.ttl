@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart413 a schema:BarChart ;
    schema:title "World leaders with the most Twitter followers as of June 2020" ;
    :hasXAxisLabel "Twitter followers in millions" ;
    :hasYAxisLabel "World leader" ;
    :yMin "0"^^xsd:decimal ;
    :yMax "90"^^xsd:decimal .

:DataPoint413_1 a :DataPoint ;
    rdfs:label "Donald J. Trump, United States @..." ;
    :xValue "Donald J. Trump, United States @..." ;
    :yValue "88.0"^^xsd:decimal ;
    :valueEstimated "true" ;
    :belongsToChart :Chart413 .

