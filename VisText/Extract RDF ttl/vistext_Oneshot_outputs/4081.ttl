@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart4081 a schema:LineChart ;
    schema:title "Monsanto 's research and development (R & D) expenditure from 2008 to 2017 (in million U.S. dollars)" ;
    :hasXAxisLabel "Year" ;
    :hasYAxisLabel "Expenditure in million U.S. dollars" ;
    :xMin "2008" ;
    :xMax "2017" ;
    :yMin "0" ;
    :yMax "1750" .

:DataPoint4081_1 a schema:DataPoint ;
    rdfs:label "2008" ;
    :xValue "2008" ;
    :yValue "900"^^xsd:decimal ;
    :valueEstimated "true" ;
    :belongsToChart :Chart4081 .

:DataPoint4081_2 a schema:DataPoint ;
    rdfs:label "2009" ;
    :xValue "2009" ;
    :yValue "1050"^^xsd:decimal ;
    :valueEstimated "true" ;
    :belongsToChart :Chart4081 .

