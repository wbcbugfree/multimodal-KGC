@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart3483 a schema:BarChart ;
    schema:title "Median hourly wages of selected occupations in radio and TV broadcasting as of May 2019 (in U.S. dollars)" ;
    :hasXAxisLabel "Median hourly wage in U.S. dollars" ;
    :hasYAxisLabel "Occupation" .

