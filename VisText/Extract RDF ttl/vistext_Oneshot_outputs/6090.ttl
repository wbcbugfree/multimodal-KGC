@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart6090 a schema:BarChart ;
    schema:title "Which , if any , of the following measures have you taken in the past 2 weeks specifically to protect yourself from the Coronavirus (COVID-19) ?" ;
    :hasXAxisLabel "Response" ;
    :hasYAxisLabel "Mar 19 to Mar 20" .

:DataPoint6090_1 a schema:DataPoint ;
    rdfs:label "Ask doctor for advice" ;
    :xValue "Ask doctor for advice" ;
    :yValue "0.05"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean ;
    :belongsToChart :Chart6090 .

