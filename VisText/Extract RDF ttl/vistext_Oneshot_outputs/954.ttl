@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <https://schema.org/> .

:Chart954 a schema:LineChart ;
    schema:title "Kenya : Birth rate from 2008 to 2018 (per 1,000 inhabitants)" ;
    :hasXAxisLabel "Year" ;
    :hasYAxisLabel "Birth rate per thousand population" ;
    :yMin "0"^^xsd:decimal ;
    :yMax "40"^^xsd:decimal .

:DataPoint954_1 a schema:DataPoint ;
    :belongsToChart :Chart954 ;
    rdfs:label "2008" ;
    :xValue "2008" ;
    :yValue "36.5"^^xsd:decimal ;
    :valueEstimated "true" .

:DataPoint954_2 a schema:DataPoint ;
    :belongsToChart :Chart954 ;
    rdfs:label "2010" ;
    :xValue "2010" ;
    :yValue "35.0"^^xsd:decimal ;
    :valueEstimated "true" .

:DataPoint954_3 a schema:DataPoint ;
    :belongsToChart :Chart954 ;
    rdfs:label "2012" ;
    :xValue "2012" ;
    :yValue "33.0"^^xsd:decimal ;
    :valueEstimated "true" .

:DataPoint954_4 a schema:DataPoint ;
    :belongsToChart :Chart954 ;
    rdfs:label "2014" ;
    :xValue "2014" ;
    :yValue "31.5"^^xsd:decimal ;
    :valueEstimated "true" .

:DataPoint954_5 a schema:DataPoint ;
    :belongsToChart :Chart954 ;
    rdfs:label "2016" ;
    :xValue "2016" ;
    :yValue "30.0"^^xsd:decimal ;
    :valueEstimated "true" .

:DataPoint954_6 a schema:DataPoint ;
    :belongsToChart :Chart954 ;
    rdfs:label "2018" ;
    :xValue "2018" ;
    :yValue "29.0"^^xsd:decimal ;
    :valueEstimated "true" .
