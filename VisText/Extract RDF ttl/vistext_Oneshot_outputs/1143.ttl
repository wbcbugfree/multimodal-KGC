@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart1143 a schema:LineChart ;
    schema:title "Georgia : Infant mortality rate from 2009 to 2019 (in deaths per 1,000 live births)" ;
    :hasXAxisLabel "Year" ;
    :hasYAxisLabel "Deaths per 1,000 live births" ;
    :yMin "0"^^xsd:decimal ;
    :yMax "14"^^xsd:decimal .

:DataPoint1143_1 :belongsToChart :Chart1143 ;
    rdfs:label "2009" ;
    :xValue "2009" ;
    :yValue "13.8"^^xsd:decimal ;
    :valueEstimated "true" .

