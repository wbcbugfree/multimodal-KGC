@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart7612 a schema:BarChart ;
    schema:title "Regional distribution of BBC network TV programming spending in the United Kingdom (UK) from 2012 to 2019" ;
    :hasXAxisLabel "2014" ;
    :hasYAxisLabel "Geographic region" .

:DataPoint7612_1 a :DataPoint ;
    rdfs:label "London" ;
    :xValue "London" ;
    :yValue "0.52"^^xsd:decimal ;
    :valueEstimated "true" ;
    :belongsToChart :Chart7612 .

