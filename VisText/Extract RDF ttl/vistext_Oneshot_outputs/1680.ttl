@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart1680 a schema:BarChart ;
    schema:title "Number of single-woman households in Denmark in 2020 , by age group" ;
    :hasXAxisLabel "Number of single-women households" ;
    :hasYAxisLabel "Year" .

:DataPoint1680_1 a schema:DataPoint ;
    :belongsToChart :Chart1680 ;
    rdfs:label "100 years and more" ;
    :xValue "100 years and more" ;
    :yValue 5000.0^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .

