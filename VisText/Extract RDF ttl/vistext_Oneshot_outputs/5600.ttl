@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart5600 a schema:BarChart ;
    schema:title "Number of Distance Selling/Mail Order pharmacies in England from 2008/09 to 2018/19" ;
    :hasXAxisLabel "Year" ;
    :hasYAxisLabel "Number of pharmacies" ;
    :yMin "0"^^xsd:decimal ;
    :yMax "350"^^xsd:decimal .

:DataPoint5600_1 a schema:DataPoint ;
    rdfs:label "2008-09" ;
    :xValue "2008-09" ;
    :yValue "55"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean ;
    :belongsToChart :Chart5600 .

