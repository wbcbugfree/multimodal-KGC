@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart3262 a schema:LineChart ;
    schema:title "Consumer price index for non-food in Ethiopia from 2019 to 2020" ;
    :hasXAxisLabel "Month" ;
    :hasYAxisLabel "CPI non-food (Dec=2016)" ;
    :yMin "0"^^xsd:decimal ;
    :yMax "150"^^xsd:decimal .

:DataPoint3262_1 a :DataPoint ;
    :belongsToChart :Chart3262 ;
    rdfs:label "2019 April" ;
    :xValue "2019 April" ;
    :yValue "118.0"^^xsd:decimal ;
    :valueEstimated "true" .

