@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart7016 a schema:BarChart ;
    schema:title "Monthly sales of cookies , confectionery and snack foods at large retailers in Canada from January 2015 to April 2019 (in million Canadian dollars)" ;
    :hasXAxisLabel "2016" ;
    :hasYAxisLabel "Month" .

:DataPoint7016_1 a :DataPoint ;
    rdfs:label "Apr" ;
    :xValue "Apr" ;
    :yValue "350.0"^^xsd:decimal ;
    :valueEstimated "true" ;
    :belongsToChart :Chart7016 .

