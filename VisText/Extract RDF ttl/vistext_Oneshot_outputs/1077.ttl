@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart1077 a schema:BarChart ;
    schema:title "Coffee consumption in Canada from 2010 to 2021 (in million 60-kilogram bags)" ;
    :hasXAxisLabel "Year" ;
    :hasYAxisLabel "Consumption in million 60-kilogram bags" ;
    :yMin "0"^^xsd:decimal ;
    :yMax "5"^^xsd:decimal .

:DataPoint1077_1 a :DataPoint ;
    :belongsToChart :Chart1077 ;
    rdfs:label "2010/11" ;
    :xValue "2010/11" ;
    :yValue "4.2"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .

