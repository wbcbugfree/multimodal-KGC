@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart8515 a schema:LineChart ;
    schema:title "Greenhouse gas emissions volume in the European Union from 1990 to 2017 , by sector (in kilotonnes of CO2-equivalent)" ;
    :hasXAxisLabel "Year" ;
    :hasYAxisLabel "Waste" .

:DataPoint8515_1 :belongsToChart :Chart8515 ;
    rdfs:label "1990" ;
    :xValue "1990" ;
    :yValue "245000.0"^^xsd:decimal ;
    :valueEstimated "true" .

:DataPoint8515_2 :belongsToChart :Chart8515 ;
    rdfs:label "1995" ;
    :xValue "1995" ;
    :yValue "248000.0"^^xsd:decimal ;
    :valueEstimated "true" .

:DataPoint8515_3 :belongsToChart :Chart8515 ;
    rdfs:label "2000" ;
    :xValue "2000" ;
    :yValue "240000.0"^^xsd:decimal ;
    :valueEstimated "true" .

:DataPoint8515_4 :belongsToChart :Chart8515 ;
    rdfs:label "2005" ;
    :xValue "2005" ;
    :yValue "215000.0"^^xsd:decimal ;
    :valueEstimated "true" .

:DataPoint8515_5 :belongsToChart :Chart8515 ;
    rdfs:label "2010" ;
    :xValue "2010" ;
    :yValue "175000.0"^^xsd:decimal ;
    :valueEstimated "true" .

:DataPoint8515_6 :belongsToChart :Chart8515 ;
    rdfs:label "2015" ;
    :xValue "2015" ;
    :yValue "145000.0"^^xsd:decimal ;
    :valueEstimated "true" .
