@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart262 a schema:LineChart ;
    schema:title "Share of respondents who had set up their own social network profile in the United Kingdom (UK) from 2007 to 2019" ;
    :hasXAxisLabel "Response" ;
    :hasYAxisLabel "Share of respondents" ;
    :xMin "2007" ;
    :xMax "2019" ;
    :yMin "0.0"^^xsd:decimal ;
    :yMax "0.9"^^xsd:decimal .

:DataPoint262_1 a :DataPoint ;
    :belongsToChart :Chart262 ;
    rdfs:label "2007" ;
    :xValue "2007" ;
    :yValue "0.2"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .

