@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart3052 a schema:LineChart ;
    schema:title "Number of Nissan cars sold in Sweden from 2009 to 2019" ;
    :hasXAxisLabel "Year" ;
    :hasYAxisLabel "Units sold" ;
    :xMin "2009" ;
    :xMax "2019" ;
    :yMin "0"^^xsd:decimal ;
    :yMax "10000"^^xsd:decimal .

:DataPoint3052_1 a :DataPoint ;
    :belongsToChart :Chart3052 ;
    rdfs:label "2009" ;
    :xValue "2009" ;
    :yValue "2800"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .

