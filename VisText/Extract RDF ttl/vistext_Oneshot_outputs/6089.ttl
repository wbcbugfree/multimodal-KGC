@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart6089 a schema:BarChart ;
    schema:title "Which , if any , of the following measures have you taken in the past 2 weeks specifically to protect yourself from the Coronavirus (COVID-19) ?" ;
    :hasXAxisLabel "Feb 29 to Mar 1" ;
    :hasYAxisLabel "Response" .

:DataPoint6089_1 a schema:DataPoint ;
    rdfs:label "Avoid consumption of raw or unco..." ;
    :xValue "Avoid consumption of raw or unco..." ;
    :yValue "0.05"^^xsd:decimal ;
    :valueEstimated "true" ;
    :belongsToChart :Chart6089 .

:DataPoint6089_2 a schema:DataPoint ;
    rdfs:label "Avoid crowded public places" ;
    :xValue "Avoid crowded public places" ;
    :yValue "0.12"^^xsd:decimal ;
    :valueEstimated "true" ;
    :belongsToChart :Chart6089 .

:DataPoint6089_3 a schema:DataPoint ;
    rdfs:label "Avoid going to work" ;
    :xValue "Avoid going to work" ;
    :yValue "0.05"^^xsd:decimal ;
    :valueEstimated "true" ;
    :belongsToChart :Chart6089 .

:DataPoint6089_4 a schema:DataPoint ;
    rdfs:label "Avoid physical contact with touri..." ;
    :xValue "Avoid physical contact with touri..." ;
    :yValue "0.15"^^xsd:decimal ;
    :valueEstimated "true" ;
    :belongsToChart :Chart6089 .

:DataPoint6089_5 a schema:DataPoint ;
    rdfs:label "Improve personal hygiene with wor..." ;
    :xValue "Improve personal hygiene with wor..." ;
    :yValue "0.33"^^xsd:decimal ;
    :valueEstimated "true" ;
    :belongsToChart :Chart6089 .

:DataPoint6089_6 a schema:DataPoint ;
    rdfs:label "No measures taken" ;
    :xValue "No measures taken" ;
    :yValue "0.10"^^xsd:decimal ;
    :valueEstimated "true" ;
    :belongsToChart :Chart6089 .

:DataPoint6089_7 a schema:DataPoint ;
    rdfs:label "Refrain from touching objects in p..." ;
    :xValue "Refrain from touching objects in p..." ;
    :yValue "0.50"^^xsd:decimal ;
    :valueEstimated "true" ;
    :belongsToChart :Chart6089 .

:DataPoint6089_8 a schema:DataPoint ;
    rdfs:label "Wear a face mask in public places" ;
    :xValue "Wear a face mask in public places" ;
    :yValue "0.17"^^xsd:decimal ;
    :valueEstimated "true" ;
    :belongsToChart :Chart6089 .
