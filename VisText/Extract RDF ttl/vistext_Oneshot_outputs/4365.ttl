@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart4365 a schema:LineChart ;
    schema:title "Average regular season home attendance of the Los Angeles Dodgers from 2009 to 2019" ;
    :hasXAxisLabel "Year" ;
    :hasYAxisLabel "Average attendance" ;
    :yMin "0"^^xsd:decimal ;
    :yMax "50000"^^xsd:decimal .

:DataPoint4365_1 a schema:DataPoint ;
    rdfs:label "2009" ;
    :xValue "2009" ;
    :yValue "51000"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean ;
    :belongsToChart :Chart4365 .

