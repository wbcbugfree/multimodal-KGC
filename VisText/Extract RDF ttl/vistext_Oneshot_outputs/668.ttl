@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart668 a schema:LineChart ;
    schema:title "Share of children in total population in Indonesia from 2005 to 2019" ;
    :hasXAxisLabel "Response" ;
    :hasYAxisLabel "Percentage of total population" ;
    :xMin "2005"^^xsd:string ;
    :xMax "2019"^^xsd:string ;
    :yMin "0.00"^^xsd:decimal ;
    :yMax "0.30"^^xsd:decimal .

