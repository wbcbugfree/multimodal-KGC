@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart3674 a schema:BarChart ;
    schema:title "The Bahamas : Total population from 2015 to 2025 (in million inhabitants)" ;
    :hasXAxisLabel "Year" ;
    :hasYAxisLabel "Inhabitants in millions" ;
    :yMin "0.0"^^xsd:decimal ;
    :yMax "0.4"^^xsd:decimal .

