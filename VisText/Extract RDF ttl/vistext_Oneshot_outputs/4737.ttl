@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart4737 a schema:BarChart ;
    schema:title "Advertising and promotion costs in thousand GBP" ;
    :hasXAxisLabel "airline" ;
    :hasYAxisLabel "" ;
    :yMin "0"^^xsd:decimal ;
    :yMax "100000"^^xsd:decimal .

