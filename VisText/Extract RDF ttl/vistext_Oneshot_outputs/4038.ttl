:Chart4038 a schema:BarChart ;
    schema:title "Cincinnati Reds all-time wins leaders as of October 2020" ;
    :hasXAxisLabel "Number of games won" ;
    :hasYAxisLabel "Cincinnati Reds all-time wins leaders" .

:DataPoint4038_1 :belongsToChart :Chart4038 ;
