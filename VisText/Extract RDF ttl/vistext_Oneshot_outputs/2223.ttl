@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart2223 a schema:BarChart ;
    schema:title "Leading direct selling markets in Europe in 2019 (in billion U.S. dollars)" ;
    :hasXAxisLabel "Country" ;
    :hasYAxisLabel "Value of retail sales in billion U.S. dollars" .

:DataPoint2223_1 a schema:DataPoint ;
    rdfs:label "France" ;
    :xValue "France" ;
    :yValue "5.1"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean ;
    :belongsToChart :Chart2223 .

