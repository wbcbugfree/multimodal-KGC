@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart4115 a schema:BarChart ;
    schema:title "Average life expectancy of major household appliances as of 2011 (in years)" ;
    :hasXAxisLabel "Average life expectancy in years" ;
    :hasYAxisLabel "Household appliance" .

:DataPoint4115_1 a schema:DataPoint ;
    rdfs:label "Compactors" ;
    :xValue "Compactors" ;
    :yValue 4.0 ;
    :valueEstimated "true"^^xsd:boolean ;
    :belongsToChart :Chart4115 .

