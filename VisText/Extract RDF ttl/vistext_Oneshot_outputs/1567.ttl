@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart1567 a schema:AreaChart ;
    schema:title "Number of Toyota cars sold in France from 2009 to 2018" ;
    :hasXAxisLabel "Year" ;
    :hasYAxisLabel "Units sold" ;
    :yMin "0"^^xsd:decimal ;
    :yMax "100000"^^xsd:decimal .

:DataPoint1567_1 a :DataPoint ;
    rdfs:label "2009" ;
    :xValue "2009" ;
    :yValue "88000"^^xsd:decimal ;
    :valueEstimated "true" ;
    :belongsToChart :Chart1567 .

