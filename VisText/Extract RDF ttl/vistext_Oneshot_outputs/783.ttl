@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart783 a schema:LineChart ;
    schema:title "Piaggio Vespa registered motorcycle numbers in Great Britain from 2000 to 2018" ;
    :hasXAxisLabel "Year" ;
    :hasYAxisLabel "Number of registered motorcycles" ;
    :xMin "2000"^^xsd:string ;
    :xMax "2018"^^xsd:string ;
    :yMin "0"^^xsd:decimal ;
    :yMax "25000"^^xsd:decimal .

