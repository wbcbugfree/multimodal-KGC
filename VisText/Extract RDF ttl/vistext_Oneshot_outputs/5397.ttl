@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart5397 a schema:BarChart ;
    schema:title "Philippines : Total population from 2015 to 2025 (in million inhabitants)" ;
    :hasXAxisLabel "Year" ;
    :hasYAxisLabel "Inhabitants in millions" ;
    :yMin "0"^^xsd:decimal ;
    :yMax "120"^^xsd:decimal .

:DataPoint5397_1 :belongsToChart :Chart5397 ;
    rdfs:label "2015" ;
    :xValue "2015" ;
    :yValue "101.0"^^xsd:decimal ;
    :valueEstimated "true" .

