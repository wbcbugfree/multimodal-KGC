@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart1231 a schema:BarChart ;
    schema:title "Average number of search terms for online search queries in Canada as of January 2020" ;
    :hasXAxisLabel "Response" ;
    :hasYAxisLabel "Share of searches" ;
    :yMin "0.0"^^xsd:decimal ;
    :yMax "0.5"^^xsd:decimal .

:DataPoint1231_1 a schema:DataPoint ;
    rdfs:label "Eight words" ;
    :xValue "Eight words" ;
    :yValue "0.01"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean ;
    :belongsToChart :Chart1231 .

