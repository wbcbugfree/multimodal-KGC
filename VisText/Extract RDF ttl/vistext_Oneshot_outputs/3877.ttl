@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart3877 a schema:LineChart ;
    schema:title "Rate of prevalent cases of end-stage renal disease (ESRD) in the U.S. from 1980 to 2016 (per million population)" ;
    :hasXAxisLabel "Year" ;
    :hasYAxisLabel "Number of cases per million population" ;
    :xMin "1980"^^xsd:string ;
    :xMax "2016"^^xsd:string ;
    :yMin "0"^^xsd:decimal ;
    :yMax "2000"^^xsd:decimal .

:DataPoint3877_1 a :Datapoint ;
    :belongsToChart :Chart3877 ;
    rdfs:label "1980" ;
    :xValue "1980" ;
    :yValue "100.0"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .

