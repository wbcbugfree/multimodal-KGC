@prefix schema:<https://schema.org/> .

:Chart1460 a schema:LineChart ;
    schema:title "Real Gross Domestic Product (GDP) of the federal state of Oklahoma from 2000 to 2019 (in billion U.S. dollars)" ;
    :hasXAxisLabel "Year" ;
    :hasYAxisLabel "Real GDP in billion U.S. dollars" ;
    :xMin "2000"^^xsd:string ;
    :xMax "2019"^^xsd:string ;
    :yMin "0"^^xsd:decimal ;
    :yMax "220"^^xsd:decimal .

:DataPoint1460_1 :belongsToChart :Chart1460 ;
    rdfs:label "2000" ;
    :xValue "2000" ;
    :yValue "125"^^xsd:decimal ;
    :valueEstimated "true" .

