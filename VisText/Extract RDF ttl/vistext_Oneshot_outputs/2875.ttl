@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart2875 a schema:BarChart ;
    schema:title "Cities with the highest local purchasing power in Latin America and the Caribbean in 2020 (based on index score)" ;
    :hasXAxisLabel "city" ;
    :hasYAxisLabel "Index score*" .

:DataPoint2875_1 a schema:DataPoint ;
    rdfs:label "Brasília (Brazil)" ;
    :xValue "Brasília (Brazil)" ;
    :yValue "50.0"^^xsd:decimal ;
    :valueEstimated "true" ;
    :belongsToChart :Chart2875 .

