@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart2466 a schema:BarChart ;
    schema:title "Top ten dark money spenders in the 2016 U.S. election cycle as of August 2016" ;
    :hasXAxisLabel "Money spent in U.S. dollars" ;
    :hasYAxisLabel "dark money spenders" ;
    :xMin "0"^^xsd:decimal ;
    :xMax "20000000"^^xsd:decimal .

:DataPoint2466_1 a schema:DataPoint ;
    rdfs:label "American Future Fund" ;
    :xValue "American Future Fund" ;
    :yValue "12000000"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean ;
    :belongsToChart :Chart2466 .

