@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart1616 a schema:BarChart ;
    schema:title "Average number of persons employed at Vodafone in Germany from financial year 2007/08 to 2019/20 (in 1,000)" ;
    :hasXAxisLabel "Employees in thousands" ;
    :hasYAxisLabel "Business years" ;
    :yMin "2007/08" ;
    :yMax "2019/20" .

:DataPoint1616_1 a schema:DataPoint ;
    rdfs:label "2007/08" ;
    :xValue "14.5"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean ;
    :belongsToChart :Chart1616 .

