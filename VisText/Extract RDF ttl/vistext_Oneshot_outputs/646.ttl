@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart646 a schema:LineChart ;
    :hasXAxisLabel "Year" ;
    :hasYAxisLabel "Revenue in billion U.S. dollars" ;
    :yMin "0"^^xsd:decimal ;
    :yMax "500"^^xsd:decimal .

:DataPoint646_1 :belongsToChart :Chart646 ;
    rdfs:label "1980" ;
    :xValue "1980" ;
    :yValue "50"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .

:DataPoint646_2 :belongsToChart :Chart646 ;
    rdfs:label "1985" ;
    :xValue "1985" ;
    :yValue "100"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .

:DataPoint646_3 :belongsToChart :Chart646 ;
    rdfs:label "1990" ;
    :xValue "1990" ;
    :yValue "150"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .

:DataPoint646_4 :belongsToChart :Chart646 ;
    rdfs:label "1995" ;
    :xValue "1995" ;
    :yValue "200"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .

:DataPoint646_5 :belongsToChart :Chart646 ;
    rdfs:label "2000" ;
    :xValue "2000" ;
    :yValue "250"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .

:DataPoint646_6 :belongsToChart :Chart646 ;
    rdfs:label "2005" ;
    :xValue "2005" ;
    :yValue "350"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .

:DataPoint646_7 :belongsToChart :Chart646 ;
    rdfs:label "2010" ;
    :xValue "2010" ;
    :yValue "450"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .

:DataPoint646_8 :belongsToChart :Chart646 ;
    rdfs:label "2015" ;
    :xValue "2015" ;
    :yValue "500"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .
