    rdfs:label "Costa Rica" ;
    :yValue "160"^^xsd:decimal ;
    :valueEstimated "true" ;
    :belongsToChart :Chart430 .

:DataPoint430_5 a :DataPoint ;
    rdfs:label "Denmark" ;
    :yValue "125"^^xsd:decimal ;
    :valueEstimated "true" ;
    :belongsToChart :Chart430 .

:DataPoint430_6 a :DataPoint ;
    rdfs:label "Japan" ;
