@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart430 a schema:BarChart ;
    schema:title "Cancer mortality rate among men in selected countries worldwide between 2003 and 2007 (per 100,000 population)" ;
    :hasXAxisLabel "Mortality rate per 100,000 population" ;
    :hasYAxisLabel "Country" .

:DataPoint430_1 a :DataPoint ;
    rdfs:label "Australia" ;
    :yValue "130"^^xsd:decimal ;
    :valueEstimated "true" ;
    :belongsToChart :Chart430 .

:DataPoint430_2 a :DataPoint ;
    rdfs:label "China" ;
    :yValue "135"^^xsd:decimal ;
    :valueEstimated "true" ;
    :belongsToChart :Chart430 .

