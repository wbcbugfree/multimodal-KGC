    :xValue "2000" ;
    :yValue "95"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .

:DataPoint3946_4 :belongsToChart :Chart3946 ;
    rdfs:label "2005" ;
    :xValue "2005" ;
    :yValue "90"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .

:DataPoint3946_5 :belongsToChart :Chart3946 ;
    rdfs:label "2010" ;
    :xValue "2010" ;
    :yValue "98"^^xsd:decimal ;
