@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart6475 a schema:BarChart ;
    schema:title "Olympic Summer Games 2016 medal tally of the Italian Olympic team , by sport" ;
    :hasXAxisLabel "Bronze" ;
    :hasYAxisLabel "type of sport" .

:DataPoint6475_1 a schema:DataPoint ;
    rdfs:label "Beach volley" ;
    :xValue "Beach volley" ;
    :yValue "0.0"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean ;
    :belongsToChart :Chart6475 .

