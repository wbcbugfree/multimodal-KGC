@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart2808 a schema:BarChart ;
    schema:title "Coronavirus (COVID-19) death rate in Italy as of December 29 , 2020 , by age group" ;
    :hasXAxisLabel "Mortality rate" ;
    :hasYAxisLabel "Year" .

:DataPoint2808_1 a :DataPoint ;
    :belongsToChart :Chart2808 ;
    rdfs:label "0-9 years" ;
    :xValue "0-9 years" ;
    :yValue "0.0"^^xsd:decimal ;
    :valueEstimated "true" .

