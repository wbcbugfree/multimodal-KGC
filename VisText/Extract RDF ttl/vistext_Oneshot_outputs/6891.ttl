:Chart6891 a schema:BarChart ;
    schema:title "Crime rate per 1,000 population in the United Kingdom from 2002/03 to 2019/20 , by country" ;
    :hasXAxisLabel "United Kingdom" ;
    :hasYAxisLabel "Year" .

