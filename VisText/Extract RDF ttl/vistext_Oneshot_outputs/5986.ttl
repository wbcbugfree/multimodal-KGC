@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart5986 a schema:BarChart ;
    schema:title "U.S. whole cattle hide exports by top 10 destination countries in 2017 (in pieces)" ;
    :hasXAxisLabel "Export in number of pieces" ;
    :hasYAxisLabel "Country" ;
    :xMax "12000000"^^xsd:decimal .

:DataPoint5986_1 a schema:DataPoint ;
    rdfs:label "Bosnia and Herzegovina" ;
    :xValue "Bosnia and Herzegovina" ;
    :yValue "11000000"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean ;
    :belongsToChart :Chart5986 .

