@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart169 a schema:BarChart ;
    schema:title "Number of people immigrating to Iceland in 2019 , by country of origin" ;
    :hasXAxisLabel "Number of immigrants" ;
    :hasYAxisLabel "Country" .

