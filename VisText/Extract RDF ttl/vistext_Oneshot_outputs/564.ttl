@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart564 a schema:LineChart ;
    schema:title "Operating profit of the Roche Group from 2007 to 2019 (in million Swiss francs)" ;
    :hasXAxisLabel "Year" ;
    :hasYAxisLabel "Operating profit in million Swiss francs" .

