@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart8334 a schema:BarChart ;
    schema:title "Anticipated time of booking summer holiday in selected European countries in 2019" ;
    :hasXAxisLabel "One month or more in advance" ;
    :hasYAxisLabel "Response" .

:DataPoint8334_1 a :DataPoint ;
    rdfs:label "Austria" ;
    :yValue "0.85"^^xsd:decimal ;
    :valueEstimated "true" ;
    :belongsToChart :Chart8334 .

