@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart3697 a schema:BarChart ;
    schema:title "Most popular e-commerce properties in the United States as of September 2018 , by desktop visitors (in millions)" ;
    :hasXAxisLabel "Most popular e-commerce properties" ;
    :hasYAxisLabel "Number of desktop visitors in millions" ;
    :yMin "0"^^xsd:decimal ;
    :yMax "120"^^xsd:decimal .

