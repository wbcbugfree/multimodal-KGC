:Chart3340 a schema:BarChart ;
    schema:title "Forecast volume of molasses imported to the European Union (EU 27) from 2015 to 2028 (in 1,000 tonnes)" ;
    :hasXAxisLabel "Year" ;
    :hasYAxisLabel "Volume in thousand tonnes" ;
    :yMin "0"^^xsd:decimal ;
    :yMax "1400"^^xsd:decimal .

