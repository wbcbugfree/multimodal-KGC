@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart5251 a schema:LineChart ;
    schema:title "The Coca-Cola Company 's net operating revenues worldwide from 2007 to 2019 (in billion U.S. dollars)" ;
    :hasXAxisLabel "Year" ;
    :hasYAxisLabel "Revenues in billion U.S. dollars" ;
    :yMin "0"^^xsd:decimal ;
    :yMax "50"^^xsd:decimal .

