@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart6696 a schema:CreativeWork ;
    schema:title "Wine production in the United States and in California from 2006 to 2017 (in million gallons)" ;
    :hasXAxisLabel "Year" ;
    :hasYAxisLabel "United States" .

:DataPoint6696_1 :belongsToChart :Chart6696 ;
    rdfs:label "2006" ;
    :xValue "2006" ;
    :yValue "590.0"^^xsd:decimal ;
    :valueEstimated "true" .

