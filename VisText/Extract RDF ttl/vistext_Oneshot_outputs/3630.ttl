@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart3630 a schema:BarChart ;
    schema:title "Net sales of Gerdau S.A. from FY 2010 to FY 2019 (in million Brazilian reals)" ;
    :hasXAxisLabel "Net sales in million Brazilian reals" ;
    :hasYAxisLabel "Year" .

:DataPoint3630_1 a :DataPoint ;
    :belongsToChart :Chart3630 ;
    rdfs:label "2010" ;
    :xValue "2010" ;
    :yValue "25000"^^xsd:decimal ;
    :valueEstimated "true" .

