@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart1965 a schema:BarChart ;
    schema:title "Installed power capacity across Jammu and Kashmir in India from financial year 2005 to 2018 (in megawatts)" ;
    :hasXAxisLabel "Year" ;
    :hasYAxisLabel "Installed power capacity in megawatts" ;
    :yMin "0"^^xsd:decimal ;
    :yMax "3500"^^xsd:decimal .

:DataPoint1965_1 :belongsToChart :Chart1965 ;
    rdfs:label "FY 2005" ;
    :xValue "FY 2005" ;
    :yValue "1500"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .

