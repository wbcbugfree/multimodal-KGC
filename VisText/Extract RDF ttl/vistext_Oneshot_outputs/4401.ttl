@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart4401 a schema:BarChart ;
    schema:title "India : National debt from 2014 to 2024 (in billion U.S. dollars)" ;
    :hasXAxisLabel "Year" ;
    :hasYAxisLabel "National debt in billion U.S. dollars" ;
    :yMin "0"^^xsd:decimal ;
    :yMax "3500"^^xsd:decimal .

