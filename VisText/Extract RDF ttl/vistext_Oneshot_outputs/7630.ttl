@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart7630 a schema:BarChart ;
    schema:title "Most purchased brands during COVID-19 outbreak in Singapore as of March 2020 , by type of customer" ;
    :hasXAxisLabel "Response" ;
    :hasYAxisLabel "COVID-19 Worriers" ;
    :yMin "0.0"^^xsd:decimal ;
    :yMax "0.55"^^xsd:decimal .

:DataPoint7630_1 a schema:DataPoint ;
    rdfs:label "Dettol" ;
    :xValue "Dettol" ;
    :yValue "0.32"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean ;
    :belongsToChart :Chart7630 .

