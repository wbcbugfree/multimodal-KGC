@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart2184 a schema:LineChart ;
    schema:title "Angola : Birth rate from 2008 to 2018 (per 1,000 inhabitants)" ;
    :hasXAxisLabel "Year" ;
    :hasYAxisLabel "Birth rate per thousand population" ;
    :yMin "0"^^xsd:decimal ;
    :yMax "50"^^xsd:decimal .

:DataPoint2184_1 a schema:DataPoint ;
    rdfs:label "2008" ;
    :xValue "2008" ;
    :yValue "47.5"^^xsd:decimal ;
    :valueEstimated "true" ;
    :belongsToChart :Chart2184 .

:DataPoint2184_2 a schema:DataPoint ;
    rdfs:label "2010" ;
    :xValue "2010" ;
    :yValue "46.5"^^xsd:decimal ;
    :valueEstimated "true" ;
    :belongsToChart :Chart2184 .

:DataPoint2184_3 a schema:DataPoint ;
    rdfs:label "2012" ;
    :xValue "2012" ;
    :yValue "45.5"^^xsd:decimal ;
    :valueEstimated "true" ;
    :belongsToChart :Chart2184 .

:DataPoint2184_4 a schema:DataPoint ;
    rdfs:label "2014" ;
    :xValue "2014" ;
    :yValue "44.0"^^xsd:decimal ;
    :valueEstimated "true" ;
    :belongsToChart :Chart2184 .

:DataPoint2184_5 a schema:DataPoint ;
    rdfs:label "2016" ;
    :xValue "2016" ;
    :yValue "42.5"^^xsd:decimal ;
    :valueEstimated "true" ;
    :belongsToChart :Chart2184 .

:DataPoint2184_6 a schema:DataPoint ;
    rdfs:label "2018" ;
    :xValue "2018" ;
    :yValue "41.0"^^xsd:decimal ;
    :valueEstimated "true" ;
    :belongsToChart :Chart2184 .
