@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:<https://schema.org/> .

:Chart4639 a schema:LineChart ;
    schema:title "Average Comex spot price of silver from 1975 to 2019 (in U.S. dollars per ounce)" ;
    :hasXAxisLabel "Year" ;
    :hasYAxisLabel "Price in U.S. dollars per ounce" ;
    :xMin "1975"^^xsd:string ;
    :xMax "2019"^^xsd:string ;
    :yMin "0"^^xsd:decimal ;
    :yMax "40"^^xsd:decimal .

:DataPoint4639_1 :belongsToChart :Chart4639 ;
    rdfs:label "1975" ;
    :xValue "1975" ;
    :yValue "2.0"^^xsd:decimal ;
    :valueEstimated "true" .

