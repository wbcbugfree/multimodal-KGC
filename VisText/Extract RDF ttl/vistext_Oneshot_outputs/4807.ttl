    :hasYAxisLabel "Revenue in million U.S. dollars" ;
    :xMin "2001" ;
    :xMax "2019" ;
    :yMin "0"^^xsd:decimal ;
    :yMax "250"^^xsd:decimal .

:DataPoint4807_1 :belongsToChart :Chart4807 ;
    rdfs:label "2001" ;
    :xValue "2001" ;
    :yValue "90"^^xsd:decimal ;
    :valueEstimated "true"^^xsd:boolean .

