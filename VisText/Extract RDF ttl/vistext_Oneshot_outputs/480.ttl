@prefix :      <http://example.org/chart-extraction/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <https://schema.org/> .

:Chart480 a schema:BarChart ;
    schema:title "Outbound travel and tourism expenditure in leading countries worldwide in 2019 (in billion U.S. dollars)" ;
    :hasXAxisLabel "Internal consumption in billion U.S. dollars" ;
    :hasYAxisLabel "Country" .

:DataPoint480_1 a :DataPoint ;
    rdfs:label "Australia" ;
    :xValue "Australia" ;
    :yValue 30.0 ;
    :valueEstimated "true"^^xsd:boolean ;
    :belongsToChart :Chart480 .

:DataPoint480_2 a :DataPoint ;
    rdfs:label "Canada" ;
    :xValue "Canada" ;
    :yValue 30.0 ;
    :valueEstimated "true"^^xsd:boolean ;
