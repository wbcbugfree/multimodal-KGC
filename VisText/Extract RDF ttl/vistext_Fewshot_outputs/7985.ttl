@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-7985 a chart:Chart ;
    chart:chartType "area" ;
    chart:title "Public concern about the pollution of rivers , lakes and reservoirs in the United States from 1989 to 2017" ;
    chart:xAxis ex:x-7985 ;
    chart:yAxis ex:y-7985 .

ex:x-7985 a chart:Axis ;
    chart:label "Response" ;
    chart:scaleMin "1989" ;
    chart:scaleMax "2017" .

ex:y-7985 a chart:Axis ;
    chart:label "Only a little" ;
    chart:scaleMin "0.00" ;
    chart:scaleMax "0.17" .

ex:series-7985-1 a chart:Series .

ex:dp-7985-1-1 a chart:DataPoint ;
    chart:series ex:series-7985-1 ;
    chart:xVal "1990" ;
    chart:yVal "0.09"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-7985-1-2 a chart:DataPoint ;
    chart:series ex:series-7985-1 ;
    chart:xVal "1995" ;
    chart:yVal "0.085"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-7985-1-3 a chart:DataPoint ;
    chart:series ex:series-7985-1 ;
    chart:xVal "2000" ;
    chart:yVal "0.08"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-7985-1-4 a chart:DataPoint ;
    chart:series ex:series-7985-1 ;
    chart:xVal "2005" ;
    chart:yVal "0.12"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-7985-1-5 a chart:DataPoint ;
    chart:series ex:series-7985-1 ;
    chart:xVal "2010" ;
    chart:yVal "0.16"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-7985-1-6 a chart:DataPoint ;
    chart:series ex:series-7985-1 ;
    chart:xVal "2015" ;
    chart:yVal "0.15"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-7985-1-7 a chart:DataPoint ;
    chart:series ex:series-7985-1 ;
    chart:xVal "2017" ;
    chart:yVal "0.12"^^xsd:decimal ;
    chart:valueEstimated "true" .
