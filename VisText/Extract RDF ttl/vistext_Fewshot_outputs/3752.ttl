@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-3752 a chart:Chart ;
    chart:chartType "line" ;
    chart:title "Consumer price index (CPI) of actual rentals for housing in South Africa from March 2019 to March 2020" ;
    chart:xAxis ex:x-3752 ;
    chart:yAxis ex:y-3752 .

ex:x-3752 a chart:Axis ;
    chart:label "Month" ;
    chart:scaleMin "April" ;
    chart:scaleMax "2020" .

ex:y-3752 a chart:Axis ;
    chart:label "Consumer price index (Dec 2016 = 100)" ;
    chart:scaleMin "0" ;
    chart:scaleMax "120" .

ex:series-3752-1 a chart:Series .

ex:dp-3752-1-1 a chart:DataPoint ;
    chart:series ex:series-3752-1 ;
    chart:xVal "April" ;
    chart:yVal "114.5"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-3752-1-2 a chart:DataPoint ;
    chart:series ex:series-3752-1 ;
    chart:xVal "July" ;
    chart:yVal "115.0"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-3752-1-3 a chart:DataPoint ;
    chart:series ex:series-3752-1 ;
    chart:xVal "October" ;
    chart:yVal "115.5"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-3752-1-4 a chart:DataPoint ;
    chart:series ex:series-3752-1 ;
    chart:xVal "2020" ;
    chart:yVal "116.0"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-3752-1-5 a chart:DataPoint ;
    chart:series ex:series-3752-1 ;
    chart:xVal "March 2020" ;
    chart:yVal "116.2"^^xsd:decimal ;
    chart:valueEstimated "true" .
