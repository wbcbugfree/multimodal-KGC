@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-7163 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Proportion of young people reading various media outside of class in the United Kingdom (UK) from 2014 to 2019" ;
    chart:xAxis ex:x-7163 ;
    chart:yAxis ex:y-7163 .

ex:x-7163 a chart:Axis ;
    chart:label "media read by young people" .

ex:y-7163 a chart:Axis ;
    chart:label "2017/18" ;
    chart:scaleMin "0.0" ;
    chart:scaleMax "0.9" .

ex:series-7163-1 a chart:Series .

ex:dp-7163-1-1 a chart:DataPoint ;
    chart:series ex:series-7163-1 ;
    chart:category "Comics" ;
    chart:value "0.4"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-7163-1-2 a chart:DataPoint ;
    chart:series ex:series-7163-1 ;
    chart:category "Fiction" ;
    chart:value "0.56"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-7163-1-3 a chart:DataPoint ;
    chart:series ex:series-7163-1 ;
    chart:category "Instant messages" ;
    chart:value "0.79"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-7163-1-4 a chart:DataPoint ;
    chart:series ex:series-7163-1 ;
    chart:category "Lyrics" ;
    chart:value "0.49"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-7163-1-5 a chart:DataPoint ;
    chart:series ex:series-7163-1 ;
    chart:category "Magazines" ;
    chart:value "0.36"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-7163-1-6 a chart:DataPoint ;
    chart:series ex:series-7163-1 ;
    chart:category "Newspapers" ;
    chart:value "0.31"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-7163-1-7 a chart:DataPoint ;
    chart:series ex:series-7163-1 ;
    chart:category "Non-fiction" ;
    chart:value "0.49"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-7163-1-8 a chart:DataPoint ;
    chart:series ex:series-7163-1 ;
    chart:category "Poems" ;
    chart:value "0.18"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-7163-1-9 a chart:DataPoint ;
    chart:series ex:series-7163-1 ;
    chart:category "Text messages" ;
    chart:value "0.84"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-7163-1-10 a chart:DataPoint ;
    chart:series ex:series-7163-1 ;
    chart:category "Websites" ;
    chart:value "0.82"^^xsd:decimal ;
    chart:valueEstimated "true" .
