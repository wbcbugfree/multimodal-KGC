@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-6786 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Average fixed internet download and upload speeds in selected cities in the United States between 2nd and 3rd quarter 2018 (in Mbps)" ;
    chart:xAxis ex:x-6786 ;
    chart:yAxis ex:y-6786 .

ex:x-6786 a chart:Axis ;
    chart:label "Upload" ;
    chart:scaleMin "0" ;
    chart:scaleMax "120" .

ex:y-6786 a chart:Axis ;
    chart:label "city of the United States" ;
    chart:scaleMin "" ;
    chart:scaleMax "" .

ex:series-6786-1 a chart:Series .

ex:dp-6786-1-1 a chart:DataPoint ;
    chart:series ex:series-6786-1 ;
    chart:category "Austin, Texas" ;
    chart:value "50"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-6786-1-2 a chart:DataPoint ;
    chart:series ex:series-6786-1 ;
    chart:category "Boston, Massachusetts" ;
    chart:value "30"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-6786-1-3 a chart:DataPoint ;
    chart:series ex:series-6786-1 ;
    chart:category "Durham, North Carolina" ;
    chart:value "45"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-6786-1-4 a chart:DataPoint ;
    chart:series ex:series-6786-1 ;
    chart:category "Henderson, Nevada" ;
    chart:value "15"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-6786-1-5 a chart:DataPoint ;
    chart:series ex:series-6786-1 ;
    chart:category "Kansas City, Missouri" ;
    chart:value "125"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-6786-1-6 a chart:DataPoint ;
    chart:series ex:series-6786-1 ;
    chart:category "Lincoln, Nebraska" ;
    chart:value "105"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-6786-1-7 a chart:DataPoint ;
    chart:series ex:series-6786-1 ;
    chart:category "Lubbock, Texas" ;
    chart:value "25"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-6786-1-8 a chart:DataPoint ;
    chart:series ex:series-6786-1 ;
    chart:category "Raleigh, North Carolina" ;
    chart:value "75"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-6786-1-9 a chart:DataPoint ;
    chart:series ex:series-6786-1 ;
    chart:category "San Antonio, Texas" ;
    chart:value "55"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-6786-1-10 a chart:DataPoint ;
    chart:series ex:series-6786-1 ;
    chart:category "San Francisco, California" ;
    chart:value "70"^^xsd:decimal ;
    chart:valueEstimated "true" .
