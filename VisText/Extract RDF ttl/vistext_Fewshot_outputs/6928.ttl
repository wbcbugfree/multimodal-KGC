@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-6928 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Length of life and cause of death of United States Presidents from 1799 to November 20, 2020" ;
    chart:xAxis ex:x-6928 ;
    chart:yAxis ex:y-6928 .

ex:x-6928 a chart:Axis ;
    chart:label "Cancer" ;
    chart:scaleMin "0" ;
    chart:scaleMax "100" .

ex:y-6928 a chart:Axis ;
    chart:label "United States Presidents" ;
    chart:scaleMin "" ;
    chart:scaleMax "" .

ex:series-6928-1 a chart:Series ;
    chart:seriesName "Herbert Hoover" .

ex:series-6928-2 a chart:Series ;
    chart:seriesName "Ulysses S. Grant" .

ex:dp-6928-1-1 a chart:DataPoint ;
    chart:series ex:series-6928-1 ;
    chart:category "Herbert Hoover" ;
    chart:value "92"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-6928-2-1 a chart:DataPoint ;
    chart:series ex:series-6928-2 ;
    chart:category "Ulysses S. Grant" ;
    chart:value "63"^^xsd:decimal ;
    chart:valueEstimated "true" .
