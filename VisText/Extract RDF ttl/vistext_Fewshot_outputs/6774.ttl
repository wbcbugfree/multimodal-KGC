@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-6774 a chart:Chart ;
    chart:chartType "line" ;
    chart:title "Slovenia : Share of economic sectors in the gross domestic product (GDP) from 2009 to 2019" ;
    chart:xAxis ex:x-6774 ;
    chart:yAxis ex:y-6774 .

ex:x-6774 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2009" ;
    chart:scaleMax "2019" .

ex:y-6774 a chart:Axis ;
    chart:label "Agriculture" ;
    chart:scaleMin "0.000" ;
    chart:scaleMax "0.020" .

ex:series-6774-1 a chart:Series ;
    chart:seriesName "Agriculture" .

ex:dp-6774-1-1 a chart:DataPoint ;
    chart:series ex:series-6774-1 ;
    chart:xVal "2009" ;
    chart:yVal "0.019"^^xsd:decimal ;
    chart:value "0.019"^^xsd:decimal ;
    chart:valueEstimated "true" .

