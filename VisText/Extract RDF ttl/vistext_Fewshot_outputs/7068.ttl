@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-7068 a chart:Chart ;
    chart:chartType "line" ;
    chart:xAxis ex:x-7068 ;
    chart:yAxis ex:y-7068 .

ex:x-7068 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2010" ;
    chart:scaleMax "2018" .

ex:y-7068 a chart:Axis ;
    chart:label "Industry" ;
    chart:scaleMin "0.0" ;
    chart:scaleMax "0.4" .

ex:series-7068-1 a chart:Series .

ex:dp-7068-1-1 a chart:DataPoint ;
    chart:series ex:series-7068-1 ;
    chart:xVal "2010" ;
    chart:yVal "0.37"^^xsd:decimal ;
    chart:valueEstimated "true" .

