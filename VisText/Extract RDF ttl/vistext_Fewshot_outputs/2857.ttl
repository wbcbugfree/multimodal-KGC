@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-2857 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Number of nominations per motion picture distributor for the 2020 Golden Globe Awards" ;
    chart:xAxis ex:x-2857 ;
    chart:yAxis ex:y-2857 .

ex:x-2857 a chart:Axis ;
    chart:label "Number of nominations" ;
    chart:scaleMin "0" ;
    chart:scaleMax "18" .

ex:y-2857 a chart:Axis ;
    chart:label "film distributor" ;
    chart:scaleMin "" ;
    chart:scaleMax "" .

ex:series-2857-1 a chart:Series .

ex:dp-2857-1-1 a chart:DataPoint ;
    chart:series ex:series-2857-1 ;
    chart:category "A24" ;
    chart:value "2"^^xsd:decimal ;
    chart:valueEstimated "true" .

