@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-3630 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Net sales of Gerdau S.A. from FY 2010 to FY 2019 (in million Brazilian reals)" ;
    chart:xAxis ex:x-3630 ;
    chart:yAxis ex:y-3630 .

ex:x-3630 a chart:Axis ;
    chart:label "Net sales in million Brazilian reals" ;
    chart:scaleMin "0" ;
    chart:scaleMax "50000" .

ex:y-3630 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "" ;
    chart:scaleMax "" .

ex:series-3630-1 a chart:Series .

ex:dp-3630-1-1 a chart:DataPoint ;
    chart:series ex:series-3630-1 ;
    chart:category "2010" ;
    chart:value "27000"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-3630-1-2 a chart:DataPoint ;
    chart:series ex:series-3630-1 ;
    chart:category "2011" ;
    chart:value "29000"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-3630-1-3 a chart:DataPoint ;
    chart:series ex:series-3630-1 ;
    chart:category "2012" ;
    chart:value "31000"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-3630-1-4 a chart:DataPoint ;
    chart:series ex:series-3630-1 ;
    chart:category "2013" ;
    chart:value "32000"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-3630-1-5 a chart:DataPoint ;
    chart:series ex:series-3630-1 ;
    chart:category "2014" ;
    chart:value "33000"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-3630-1-6 a chart:DataPoint ;
    chart:series ex:series-3630-1 ;
    chart:category "2015*" ;
    chart:value "35000"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-3630-1-7 a chart:DataPoint ;
    chart:series ex:series-3630-1 ;
    chart:category "2016" ;
    chart:value "36000"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-3630-1-8 a chart:DataPoint ;
    chart:series ex:series-3630-1 ;
    chart:category "2017" ;
    chart:value "37000"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-3630-1-9 a chart:DataPoint ;
    chart:series ex:series-3630-1 ;
    chart:category "2018" ;
    chart:value "44000"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-3630-1-10 a chart:DataPoint ;
    chart:series ex:series-3630-1 ;
    chart:category "2019" ;
    chart:value "42000"^^xsd:decimal ;
    chart:valueEstimated "true" .
