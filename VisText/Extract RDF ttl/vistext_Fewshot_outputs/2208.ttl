@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-2208 a chart:Chart ;
    chart:chartType "area" ;
    chart:title "Approval rates of presidents in office in Argentina from 2002 to 2018" ;
    chart:xAxis ex:x-2208 ;
    chart:yAxis ex:y-2208 .

ex:x-2208 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2002" ;
    chart:scaleMax "2018" .

ex:y-2208 a chart:Axis ;
    chart:label "Approval rate" ;
    chart:scaleMin "0.0" ;
    chart:scaleMax "1.0" .

ex:series-2208-1 a chart:Series .

ex:dp-2208-1-1 a chart:DataPoint ;
    chart:series ex:series-2208-1 ;
    chart:xVal "2002" ;
    chart:yVal "0.82"^^xsd:decimal ;
    chart:valueEstimated "true" .

