@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-6359 a chart:Chart ;
    chart:chartType "line" ;
    chart:title "U.S. lemon imports and domestic exports from 1999 to 2017 (in metric tons)" ;
    chart:xAxis ex:x-6359 ;
    chart:yAxis ex:y-6359 .

ex:x-6359 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "1999" ;
    chart:scaleMax "2017" .

ex:y-6359 a chart:Axis ;
    chart:label "Domestic exports" ;
    chart:scaleMin "0" ;
    chart:scaleMax "150,000" .

ex:series-6359-1 a chart:Series .

ex:dp-6359-1-1 a chart:DataPoint ;
    chart:series ex:series-6359-1 ;
    chart:xVal "2000" ;
    chart:yVal "90000"^^xsd:decimal ;
    chart:valueEstimated "true" .

