    chart:series ex:series-754-1 ;
    chart:category "2006*" ;
    chart:value "450"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-754-1-8 a chart:DataPoint ;
    chart:series ex:series-754-1 ;
    chart:category "2008*" ;
