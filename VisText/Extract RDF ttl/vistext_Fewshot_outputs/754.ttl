@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-754 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Annual number of computed tomography (CT) scanners in the United Kingdom (UK) from 2000 to 2014" ;
    chart:xAxis ex:x-754 ;
    chart:yAxis ex:y-754 .

ex:x-754 a chart:Axis ;
    chart:label "Number of scanners" ;
    chart:scaleMin "0" ;
    chart:scaleMax "600" .

ex:y-754 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "" ;
    chart:scaleMax "" .

ex:series-754-1 a chart:Series .

ex:dp-754-1-1 a chart:DataPoint ;
    chart:series ex:series-754-1 ;
    chart:category "2000*" ;
    chart:value "200"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-754-1-2 a chart:DataPoint ;
    chart:series ex:series-754-1 ;
    chart:category "2001*" ;
    chart:value "350"^^xsd:decimal ;
    chart:valueEstimated "true" .

