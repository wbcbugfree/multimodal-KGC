    chart:valueEstimated "true" .

ex:dp-754-1-10 a chart:DataPoint ;
    chart:series ex:series-754-1 ;
    chart:category "2011*" ;
    chart:value "520"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-754-1-11 a chart:DataPoint ;
    chart:series ex:series-754-1 ;
