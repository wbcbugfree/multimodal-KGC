@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-8324 a chart:Chart ;
    chart:chartType "area" ;
    chart:title "Net trade in Scotland from 2000 to 2019 (in billion GBP)" ;
    chart:xAxis ex:x-8324 ;
    chart:yAxis ex:y-8324 .

ex:x-8324 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2000" ;
    chart:scaleMax "2019" .

ex:y-8324 a chart:Axis ;
    chart:label "Imports" ;
    chart:scaleMin "-100" ;
    chart:scaleMax "0" .

ex:series-8324-1 a chart:Series .

ex:dp-8324-1-1 a chart:DataPoint ;
    chart:series ex:series-8324-1 ;
    chart:xVal "2000" ;
    chart:yVal "-57"^^xsd:decimal ;
    chart:value "-57"^^xsd:decimal ;
    chart:valueEstimated "true" .

