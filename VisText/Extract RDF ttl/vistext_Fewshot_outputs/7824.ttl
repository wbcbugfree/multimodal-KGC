@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-7824 a chart:Chart ;
    chart:chartType "line" ;
    chart:title "Bhutan : Age structure from 2009 to 2019" ;
    chart:xAxis ex:x-7824 ;
    chart:yAxis ex:y-7824 .

ex:x-7824 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2009" ;
    chart:scaleMax "2019" .

ex:y-7824 a chart:Axis ;
    chart:label "0-14 years" ;
    chart:scaleMin "0.00" ;
    chart:scaleMax "0.35" .

ex:series-7824-1 a chart:Series .

ex:dp-7824-1-1 a chart:DataPoint ;
    chart:series ex:series-7824-1 ;
    chart:xVal "2009" ;
    chart:yVal "0.325"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

