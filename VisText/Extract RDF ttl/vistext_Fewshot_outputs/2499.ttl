@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-2499 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Number of road traffic fatalities in Greece from 2006 to 2019" ;
    chart:xAxis ex:x-2499 ;
    chart:yAxis ex:y-2499 .

ex:x-2499 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2006" ;
    chart:scaleMax "2019*" .

ex:y-2499 a chart:Axis ;
    chart:label "Number of fatalities" ;
    chart:scaleMin "0" ;
    chart:scaleMax "1750" .

ex:series-2499-1 a chart:Series .

ex:dp-2499-1-1 a chart:DataPoint ;
    chart:series ex:series-2499-1 ;
    chart:category "2006" ;
    chart:value "1670"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-2499-1-2 a chart:DataPoint ;
    chart:series ex:series-2499-1 ;
    chart:category "2007" ;
    chart:value "1620"^^xsd:decimal ;
    chart:valueEstimated "true" .

