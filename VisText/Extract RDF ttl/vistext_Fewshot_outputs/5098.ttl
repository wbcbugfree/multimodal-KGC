@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-5098 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Most-followed drag queens from RuPaul 's drag race on Instagram worldwide as of June 2020" ;
    chart:xAxis ex:x-5098 ;
    chart:yAxis ex:y-5098 .

ex:x-5098 a chart:Axis ;
    chart:label "Number of followers in millions" ;
    chart:scaleMin "0.0" ;
    chart:scaleMax "2.0" .

ex:y-5098 a chart:Axis ;
    chart:label "Name (Competitive season)" ;
    chart:scaleMin "" ;
    chart:scaleMax "" .

ex:series-5098-1 a chart:Series .

ex:dp-5098-1-1 a chart:DataPoint ;
    chart:series ex:series-5098-1 ;
    chart:category "Adore Delano (S6)" ;
    chart:value "1.2"^^xsd:decimal ;
    chart:valueEstimated "true" .

