@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-6292 a chart:Chart ;
    chart:chartType "line" ;
    chart:title "What is your religious preference : Protestant , Roman Catholic , Jewish , another religion , or no religion ?" ;
    chart:xAxis ex:x-6292 ;
    chart:yAxis ex:y-6292 .

ex:x-6292 a chart:Axis ;
    chart:label "Response" ;
    chart:scaleMin "1950" ;
    chart:scaleMax "2020" .

ex:y-6292 a chart:Axis ;
    chart:label "Catholic" ;
    chart:scaleMin "0.00" ;
    chart:scaleMax "0.30" .

ex:series-6292-1 a chart:Series .

ex:dp-6292-1-1 a chart:DataPoint ;
    chart:series ex:series-6292-1 ;
    chart:xVal "1950" ;
    chart:yVal "0.25"^^xsd:decimal ;
    chart:value "0.25"^^xsd:decimal ;
    chart:valueEstimated "true" .

