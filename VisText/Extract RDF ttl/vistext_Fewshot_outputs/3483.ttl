@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-3483 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Median hourly wages of selected occupations in radio and TV broadcasting as of May 2019 (in U.S. dollars)" ;
    chart:xAxis ex:x-3483 ;
    chart:yAxis ex:y-3483 .

ex:x-3483 a chart:Axis ;
    chart:label "Median hourly wage in U.S. dollars" ;
    chart:scaleMin "0" ;
    chart:scaleMax "50" .

ex:y-3483 a chart:Axis ;
    chart:label "Occupation" ;
    chart:scaleMin "" ;
    chart:scaleMax "" .

ex:series-3483-1 a chart:Series .

ex:dp-3483-1-1 a chart:DataPoint ;
    chart:series ex:series-3483-1 ;
    chart:category "Advertising sales agents" ;
    chart:value "25"^^xsd:decimal ;
    chart:valueEstimated "true" .

