@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-5932 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Total sales value of Christmas markets in Europe in 2014 , by country (in million GBP)" ;
    chart:xAxis ex:x-5932 ;
    chart:yAxis ex:y-5932 .

ex:x-5932 a chart:Axis ;
    chart:label "Sales in million GBP" ;
    chart:scaleMin "0" ;
    chart:scaleMax "2,000" .

ex:y-5932 a chart:Axis ;
    chart:label "Country" .

ex:series-5932-1 a chart:Series .

ex:dp-5932-1-1 a chart:DataPoint ;
    chart:series ex:series-5932-1 ;
    chart:category "Austria" ;
    chart:value "200"^^xsd:decimal ;
    chart:valueEstimated "true" .

