@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-6723 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Percentage of seniors aged 65 years and older that had a select number of chronic conditions as of 2017 , by country" ;
    chart:xAxis ex:x-6723 ;
    chart:yAxis ex:y-6723 .

ex:x-6723 a chart:Axis ;
    chart:label "3 or more" ;
    chart:scaleMin "0.0" ;
    chart:scaleMax "0.4" .

ex:y-6723 a chart:Axis ;
    chart:label "Country" ;
    chart:scaleMin "" ;
    chart:scaleMax "" .

ex:series-6723-1 a chart:Series .

ex:dp-6723-1-1 a chart:DataPoint ;
    chart:series ex:series-6723-1 ;
    chart:category "Australia" ;
    chart:value "0.18"^^xsd:decimal ;
    chart:valueEstimated "true" .

