@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-7543 a chart:Chart ;
    chart:chartType "line" ;
    chart:title "Number of Facebook fans/twitter followers of the New Orleans Saints (NFL) from 2012 to 2020 (in millions)" ;
    chart:xAxis ex:x-7543 ;
    chart:yAxis ex:y-7543 .

ex:x-7543 a chart:Axis ;
    chart:label "Month" ;
    chart:scaleMin "2014" ;
    chart:scaleMax "2020" .

ex:y-7543 a chart:Axis ;
    chart:label "Facebook fans" ;
    chart:scaleMin "0" ;
    chart:scaleMax "4" .

ex:series-7543-1 a chart:Series .

ex:dp-7543-1-1 a chart:DataPoint ;
    chart:series ex:series-7543-1 ;
    chart:xVal "2014" ;
    chart:yVal "2.9"^^xsd:decimal ;
    chart:value "2.9"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-7543-1-2 a chart:DataPoint ;
    chart:series ex:series-7543-1 ;
    chart:xVal "2015" ;
    chart:yVal "3.2"^^xsd:decimal ;
    chart:value "3.2"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-7543-1-3 a chart:DataPoint ;
    chart:series ex:series-7543-1 ;
    chart:xVal "2016" ;
    chart:yVal "4.1"^^xsd:decimal ;
    chart:value "4.1"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-7543-1-4 a chart:DataPoint ;
    chart:series ex:series-7543-1 ;
    chart:xVal "2017" ;
    chart:yVal "4.2"^^xsd:decimal ;
    chart:value "4.2"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-7543-1-5 a chart:DataPoint ;
    chart:series ex:series-7543-1 ;
    chart:xVal "2018" ;
    chart:yVal "4.2"^^xsd:decimal ;
    chart:value "4.2"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-7543-1-6 a chart:DataPoint ;
    chart:series ex:series-7543-1 ;
    chart:xVal "2019" ;
    chart:yVal "4.1"^^xsd:decimal ;
    chart:value "4.1"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-7543-1-7 a chart:DataPoint ;
    chart:series ex:series-7543-1 ;
    chart:xVal "2020" ;
    chart:yVal "4.0"^^xsd:decimal ;
    chart:value "4.0"^^xsd:decimal ;
    chart:valueEstimated "true" .
