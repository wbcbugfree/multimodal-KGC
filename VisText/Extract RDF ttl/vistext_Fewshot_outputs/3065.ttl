@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-3065 a chart:Chart ;
    chart:chartType "line" ;
    chart:title "Free cash flow for shareholder-owned electric utilities in the United States from 2002 to 2019 (in billion U.S. dollars)" ;
    chart:xAxis ex:x-3065 ;
    chart:yAxis ex:y-3065 .

ex:x-3065 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2002" ;
    chart:scaleMax "2019" .

ex:y-3065 a chart:Axis ;
    chart:label "Free cash flow in billion U.S. dollars" ;
    chart:scaleMin "-60" ;
    chart:scaleMax "0" .

ex:series-3065-1 a chart:Series .

ex:dp-3065-1-1 a chart:DataPoint ;
