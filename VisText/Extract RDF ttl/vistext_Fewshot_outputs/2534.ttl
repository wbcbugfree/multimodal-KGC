    chart:category "2015" ;
    chart:value "320"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-2534-1-10 a chart:DataPoint ;
    chart:series ex:series-2534-1 ;
    chart:category "2016" ;
