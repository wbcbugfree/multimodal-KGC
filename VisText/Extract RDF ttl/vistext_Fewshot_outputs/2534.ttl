@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-2534 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Generation of non-hydro renewable energy in the U.S. from 2007 to 2019 (in terawatt hours)" ;
    chart:xAxis ex:x-2534 ;
    chart:yAxis ex:y-2534 .

ex:x-2534 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2007" ;
    chart:scaleMax "2019*" .

ex:y-2534 a chart:Axis ;
    chart:label "Generation in terawatt hours" ;
    chart:scaleMin "0" ;
    chart:scaleMax "500" .

ex:series-2534-1 a chart:Series .

ex:dp-2534-1-1 a chart:DataPoint ;
    chart:series ex:series-2534-1 ;
    chart:category "2007" ;
    chart:value "100"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-2534-1-2 a chart:DataPoint ;
    chart:series ex:series-2534-1 ;
    chart:category "2008" ;
    chart:value "120"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-2534-1-3 a chart:DataPoint ;
    chart:series ex:series-2534-1 ;
    chart:category "2009" ;
    chart:value "140"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-2534-1-4 a chart:DataPoint ;
    chart:series ex:series-2534-1 ;
    chart:category "2010" ;
    chart:value "160"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-2534-1-5 a chart:DataPoint ;
    chart:series ex:series-2534-1 ;
    chart:category "2011" ;
    chart:value "200"^^xsd:decimal ;
    chart:valueEstimated "true" .

