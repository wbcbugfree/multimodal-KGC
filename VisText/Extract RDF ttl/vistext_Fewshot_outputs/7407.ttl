@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-7407 a chart:Chart ;
    chart:chartType "line" ;
    chart:title "Indonesia : Distribution of employment by economic sector from 2010 to 2020" ;
    chart:xAxis ex:x-7407 ;
    chart:yAxis ex:y-7407 .

ex:x-7407 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2010" ;
    chart:scaleMax "2020" .

ex:y-7407 a chart:Axis ;
    chart:label "Agriculture" ;
    chart:scaleMin "0.0" ;
    chart:scaleMax "0.4" .

ex:series-7407-1 a chart:Series .

ex:dp-7407-1-1 a chart:DataPoint ;
    chart:series ex:series-7407-1 ;
    chart:xVal "2010" ;
    chart:yVal "0.395"^^xsd:decimal ;
    chart:value "0.395"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-7407-1-2 a chart:DataPoint ;
    chart:series ex:series-7407-1 ;
    chart:xVal "2012" ;
    chart:yVal "0.375"^^xsd:decimal ;
    chart:value "0.375"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-7407-1-3 a chart:DataPoint ;
    chart:series ex:series-7407-1 ;
    chart:xVal "2014" ;
    chart:yVal "0.36"^^xsd:decimal ;
    chart:value "0.36"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-7407-1-4 a chart:DataPoint ;
    chart:series ex:series-7407-1 ;
    chart:xVal "2016" ;
    chart:yVal "0.33"^^xsd:decimal ;
    chart:value "0.33"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-7407-1-5 a chart:DataPoint ;
    chart:series ex:series-7407-1 ;
    chart:xVal "2018" ;
    chart:yVal "0.31"^^xsd:decimal ;
    chart:value "0.31"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-7407-1-6 a chart:DataPoint ;
    chart:series ex:series-7407-1 ;
    chart:xVal "2020" ;
    chart:yVal "0.29"^^xsd:decimal ;
    chart:value "0.29"^^xsd:decimal ;
    chart:valueEstimated "true" .
