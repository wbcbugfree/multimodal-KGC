@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-2837 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Promotional products ownership in the United States as of January 2019" ;
    chart:xAxis ex:x-2837 ;
    chart:yAxis ex:y-2837 .

ex:x-2837 a chart:Axis ;
    chart:label "Share of respondents" ;
    chart:scaleMin "0.0" ;
    chart:scaleMax "1.0" .

ex:y-2837 a chart:Axis ;
    chart:label "Response" .

ex:series-2837-1 a chart:Series .

ex:dp-2837-1-1 a chart:DataPoint ;
    chart:series ex:series-2837-1 ;
    chart:category "Bags" ;
    chart:value "0.85"^^xsd:decimal ;
    chart:valueEstimated "true" .

