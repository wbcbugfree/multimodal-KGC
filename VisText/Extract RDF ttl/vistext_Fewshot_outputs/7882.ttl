@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-7882 a chart:Chart ;
    chart:chartType "line" ;
    chart:title "Number of suspects arrested for terrorism offences in the European Union (EU) from 2010 to 2019 , by affiliation" ;
    chart:xAxis ex:x-7882 ;
    chart:yAxis ex:y-7882 .

ex:x-7882 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2010" ;
    chart:scaleMax "2019" .

ex:y-7882 a chart:Axis ;
    chart:label "Left-Wing" ;
    chart:scaleMin "0" ;
    chart:scaleMax "120" .

ex:series-7882-1 a chart:Series ;
    chart:seriesName "Left-Wing" .

ex:dp-7882-1-1 a chart:DataPoint ;
    chart:series ex:series-7882-1 ;
    chart:xVal "2010" ;
    chart:yVal "37"^^xsd:decimal ;
    chart:value "37"^^xsd:decimal ;
    chart:valueEstimated "true" .

