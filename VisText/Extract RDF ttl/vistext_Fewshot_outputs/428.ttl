@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-428 a chart:Chart ;
    chart:chartType "area" ;
    chart:title "Average annual percent change in total return of treasury bills of the United States from 2001 to 2018" ;
    chart:xAxis ex:x-428 ;
    chart:yAxis ex:y-428 .

ex:x-428 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2001" ;
    chart:scaleMax "2018" .

ex:y-428 a chart:Axis ;
    chart:label "Percent change" ;
    chart:scaleMin "0.00" ;
    chart:scaleMax "0.05" .

ex:series-428-1 a chart:Series .

ex:dp-428-1-1 a chart:DataPoint ;
    chart:series ex:series-428-1 ;
    chart:xVal "2001" ;
    chart:yVal "0.003"^^xsd:decimal ;
    chart:value "0.003"^^xsd:decimal ;
    chart:valueEstimated "true" .

