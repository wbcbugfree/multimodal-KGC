@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-2310 a chart:Chart ;
    chart:chartType "bar" ;
    chart:xAxis ex:x-2310 ;
    chart:yAxis ex:y-2310 .

ex:x-2310 a chart:Axis ;
    chart:label "Share of natural search voice**" ;
    chart:scaleMin "0.0" ;
    chart:scaleMax "0.4" .

ex:y-2310 a chart:Axis ;
    chart:label "Response" .

ex:series-2310-1 a chart:Series .

ex:dp-2310-1-1 a chart:DataPoint ;
    chart:series ex:series-2310-1 ;
    chart:category "cupid.com" ;
    chart:value "0.17"^^xsd:decimal ;
    chart:valueEstimated "true" .

