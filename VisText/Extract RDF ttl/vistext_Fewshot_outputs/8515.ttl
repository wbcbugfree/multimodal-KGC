@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-8515 a chart:Chart ;
    chart:chartType "area" ;
    chart:title "Greenhouse gas emissions volume in the European Union from 1990 to 2017 , by sector (in kilotonnes of CO2-equivalent)" ;
    chart:xAxis ex:x-8515 ;
    chart:yAxis ex:y-8515 .

ex:x-8515 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "1990" ;
    chart:scaleMax "2017" .

ex:y-8515 a chart:Axis ;
    chart:label "Waste" ;
    chart:scaleMin "0" ;
    chart:scaleMax "250000" .

ex:series-8515-1 a chart:Series .

ex:dp-8515-1-1 a chart:DataPoint ;
    chart:series ex:series-8515-1 ;
    chart:xVal "1990" ;
    chart:yVal "240000"^^xsd:decimal ;
    chart:value "240000"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-8515-1-2 a chart:DataPoint ;
    chart:series ex:series-8515-1 ;
    chart:xVal "1995" ;
    chart:yVal "248000"^^xsd:decimal ;
    chart:value "248000"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-8515-1-3 a chart:DataPoint ;
    chart:series ex:series-8515-1 ;
    chart:xVal "2000" ;
    chart:yVal "240000"^^xsd:decimal ;
    chart:value "240000"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-8515-1-4 a chart:DataPoint ;
    chart:series ex:series-8515-1 ;
    chart:xVal "2005" ;
    chart:yVal "220000"^^xsd:decimal ;
    chart:value "220000"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-8515-1-5 a chart:DataPoint ;
    chart:series ex:series-8515-1 ;
    chart:xVal "2010" ;
    chart:yVal "180000"^^xsd:decimal ;
    chart:value "180000"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-8515-1-6 a chart:DataPoint ;
    chart:series ex:series-8515-1 ;
    chart:xVal "2015" ;
    chart:yVal "145000"^^xsd:decimal ;
    chart:value "145000"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-8515-1-7 a chart:DataPoint ;
    chart:series ex:series-8515-1 ;
    chart:xVal "2017" ;
    chart:yVal "135000"^^xsd:decimal ;
    chart:value "135000"^^xsd:decimal ;
    chart:valueEstimated "true" .
