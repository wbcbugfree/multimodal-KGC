@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-5362 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Sales of the leading men 's hair coloring brands in the United States in 2020 (in million U.S. dollars)" ;
    chart:xAxis ex:x-5362 ;
    chart:yAxis ex:y-5362 .

ex:x-5362 a chart:Axis ;
    chart:label "Sales in million U.S. dollars" ;
    chart:scaleMin "0" ;
    chart:scaleMax "80" .

ex:y-5362 a chart:Axis ;
    chart:label "Brand" ;
    chart:scaleMin "" ;
    chart:scaleMax "" .

ex:series-5362-1 a chart:Series .

