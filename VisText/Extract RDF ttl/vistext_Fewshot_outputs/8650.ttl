@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-8650 a chart:Chart ;
    chart:chartType "area" ;
    chart:title "Internet penetration rate in the Middle East compared to the global internet penetration rate from 2009 to 2019" ;
    chart:xAxis ex:x-8650 ;
    chart:yAxis ex:y-8650 .

ex:x-8650 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2009" ;
    chart:scaleMax "2019" .

ex:y-8650 a chart:Axis ;
    chart:label "Rest of the World" ;
    chart:scaleMin "0.0" ;
    chart:scaleMax "0.6" .

ex:series-8650-1 a chart:Series .

ex:dp-8650-1-1 a chart:DataPoint ;
    chart:series ex:series-8650-1 ;
    chart:xVal "2009" ;
    chart:yVal "0.25"^^xsd:decimal ;
    chart:value "0.25"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-8650-1-2 a chart:DataPoint ;
    chart:series ex:series-8650-1 ;
    chart:xVal "2010" ;
    chart:yVal "0.27"^^xsd:decimal ;
    chart:value "0.27"^^xsd:decimal ;
    chart:valueEstimated "true" .

