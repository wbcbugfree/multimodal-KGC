@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-2207 a chart:Chart ;
    chart:chartType "area" ;
    chart:title "Number of aircraft arrivals at Changi Airport in Singapore from 2010 to 2019" ;
    chart:xAxis ex:x-2207 ;
    chart:yAxis ex:y-2207 .

ex:x-2207 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2010" ;
    chart:scaleMax "2019" .

ex:y-2207 a chart:Axis ;
    chart:label "Number of aircraft arrivals" ;
    chart:scaleMin "0" ;
    chart:scaleMax "200000" .

ex:series-2207-1 a chart:Series .

ex:dp-2207-1-1 a chart:DataPoint ;
    chart:series ex:series-2207-1 ;
    chart:xVal "2010" ;
    chart:yVal "130000"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-2207-1-2 a chart:DataPoint ;
    chart:series ex:series-2207-1 ;
    chart:xVal "2011" ;
    chart:yVal "145000"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-2207-1-3 a chart:DataPoint ;
    chart:series ex:series-2207-1 ;
    chart:xVal "2012" ;
    chart:yVal "155000"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-2207-1-4 a chart:DataPoint ;
    chart:series ex:series-2207-1 ;
    chart:xVal "2013" ;
    chart:yVal "165000"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-2207-1-5 a chart:DataPoint ;
    chart:series ex:series-2207-1 ;
    chart:xVal "2014" ;
    chart:yVal "170000"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-2207-1-6 a chart:DataPoint ;
    chart:series ex:series-2207-1 ;
    chart:xVal "2015" ;
    chart:yVal "175000"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-2207-1-7 a chart:DataPoint ;
    chart:series ex:series-2207-1 ;
    chart:xVal "2016" ;
    chart:yVal "180000"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-2207-1-8 a chart:DataPoint ;
    chart:series ex:series-2207-1 ;
    chart:xVal "2017" ;
    chart:yVal "185000"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-2207-1-9 a chart:DataPoint ;
    chart:series ex:series-2207-1 ;
    chart:xVal "2018" ;
    chart:yVal "190000"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-2207-1-10 a chart:DataPoint ;
    chart:series ex:series-2207-1 ;
    chart:xVal "2019" ;
    chart:yVal "195000"^^xsd:decimal ;
    chart:valueEstimated "true" .
