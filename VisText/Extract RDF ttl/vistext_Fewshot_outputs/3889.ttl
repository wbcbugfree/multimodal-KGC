    chart:label "Year" ;
    chart:scaleMin "1990" ;
    chart:scaleMax "2011" .

ex:y-3889 a chart:Axis ;
    chart:label "Price in Canadian cents per litre" ;
    chart:scaleMin "0" ;
    chart:scaleMax "120" .

ex:series-3889-1 a chart:Series .

