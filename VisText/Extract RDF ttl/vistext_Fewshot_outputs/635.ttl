@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-635 a chart:Chart ;
    chart:chartType "line" ;
    chart:title "Pioneer Natural Resources ' total revenue from 2008 to 2019 (in million U.S. dollars)" ;
    chart:xAxis ex:x-635 ;
    chart:yAxis ex:y-635 .

ex:x-635 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2008" ;
    chart:scaleMax "2019" .

ex:y-635 a chart:Axis ;
    chart:label "Revenue in million U.S. dollars" ;
    chart:scaleMin "0" ;
    chart:scaleMax "10000" .

ex:series-635-1 a chart:Series .

ex:dp-635-1-1 a chart:DataPoint ;
    chart:series ex:series-635-1 ;
    chart:xVal "2008" ;
    chart:yVal "1700"^^xsd:decimal ;
    chart:value "1700"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-635-1-2 a chart:DataPoint ;
    chart:series ex:series-635-1 ;
    chart:xVal "2009" ;
    chart:yVal "1200"^^xsd:decimal ;
    chart:value "1200"^^xsd:decimal ;
    chart:valueEstimated "true" .

