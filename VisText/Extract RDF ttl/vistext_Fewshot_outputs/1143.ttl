@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-1143 a chart:Chart ;
    chart:chartType "area" ;
    chart:title "Georgia : Infant mortality rate from 2009 to 2019 (in deaths per 1,000 live births)" ;
    chart:xAxis ex:x-1143 ;
    chart:yAxis ex:y-1143 .

ex:x-1143 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2009" ;
    chart:scaleMax "2019" .

ex:y-1143 a chart:Axis ;
    chart:label "Deaths per 1,000 live births" ;
    chart:scaleMin "0" ;
    chart:scaleMax "14" .

ex:series-1143-1 a chart:Series .

ex:dp-1143-1-1 a chart:DataPoint ;
    chart:series ex:series-1143-1 ;
    chart:xVal "2009" ;
    chart:yVal "13.5"^^xsd:decimal ;
    chart:value "13.5"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-1143-1-2 a chart:DataPoint ;
    chart:series ex:series-1143-1 ;
    chart:xVal "2010" ;
    chart:yVal "13.0"^^xsd:decimal ;
    chart:value "13.0"^^xsd:decimal ;
    chart:valueEstimated "true" .

