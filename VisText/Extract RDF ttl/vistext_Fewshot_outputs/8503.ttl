@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-8503 a chart:Chart ;
    chart:chartType "area" ;
    chart:title "Total number of births , deaths and birth excess in the Netherlands from 2008 to 2018" ;
    chart:xAxis ex:x-8503 ;
    chart:yAxis ex:y-8503 .

ex:x-8503 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2008" ;
    chart:scaleMax "2018" .

ex:y-8503 a chart:Axis ;
    chart:label "Deaths" ;
    chart:scaleMin "0" ;
    chart:scaleMax "150000" .

ex:series-8503-1 a chart:Series .

ex:series-8503-2 a chart:Series .

ex:dp-8503-1-1 a chart:DataPoint ;
    chart:series ex:series-8503-1 ;
    chart:xVal "2008" ;
    chart:yVal "125000"^^xsd:decimal ;
    chart:value "125000"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-8503-1-2 a chart:DataPoint ;
    chart:series ex:series-8503-1 ;
    chart:xVal "2010" ;
    chart:yVal "127000"^^xsd:decimal ;
    chart:value "127000"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-8503-1-3 a chart:DataPoint ;
    chart:series ex:series-8503-1 ;
    chart:xVal "2012" ;
    chart:yVal "128000"^^xsd:decimal ;
    chart:value "128000"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-8503-1-4 a chart:DataPoint ;
    chart:series ex:series-8503-1 ;
    chart:xVal "2014" ;
    chart:yVal "130000"^^xsd:decimal ;
    chart:value "130000"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-8503-1-5 a chart:DataPoint ;
    chart:series ex:series-8503-1 ;
    chart:xVal "2016" ;
    chart:yVal "135000"^^xsd:decimal ;
    chart:value "135000"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-8503-1-6 a chart:DataPoint ;
    chart:series ex:series-8503-1 ;
    chart:xVal "2018" ;
    chart:yVal "138000"^^xsd:decimal ;
    chart:value "138000"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-8503-2-1 a chart:DataPoint ;
    chart:series ex:series-8503-2 ;
    chart:xVal "2008" ;
    chart:yVal "25000"^^xsd:decimal ;
    chart:value "25000"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-8503-2-2 a chart:DataPoint ;
    chart:series ex:series-8503-2 ;
    chart:xVal "2010" ;
    chart:yVal "27000"^^xsd:decimal ;
    chart:value "27000"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-8503-2-3 a chart:DataPoint ;
    chart:series ex:series-8503-2 ;
    chart:xVal "2012" ;
    chart:yVal "28000"^^xsd:decimal ;
    chart:value "28000"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-8503-2-4 a chart:DataPoint ;
    chart:series ex:series-8503-2 ;
    chart:xVal "2014" ;
    chart:yVal "30000"^^xsd:decimal ;
    chart:value "30000"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-8503-2-5 a chart:DataPoint ;
    chart:series ex:series-8503-2 ;
    chart:xVal "2016" ;
    chart:yVal "35000"^^xsd:decimal ;
    chart:value "35000"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-8503-2-6 a chart:DataPoint ;
