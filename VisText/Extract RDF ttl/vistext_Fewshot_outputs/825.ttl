@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-825 a chart:Chart ;
    chart:chartType "area" ;
    chart:title "Child mortality rate (under five years old) in China from 1850 to 2020" ;
    chart:xAxis ex:x-825 ;
    chart:yAxis ex:y-825 .

ex:x-825 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "1850" ;
    chart:scaleMax "2020" .

ex:y-825 a chart:Axis ;
    chart:label "Deaths per 1,000 live births" ;
    chart:scaleMin "0" ;
    chart:scaleMax "500" .

ex:series-825-1 a chart:Series .

ex:dp-825-1-1 a chart:DataPoint ;
    chart:series ex:series-825-1 ;
    chart:xVal "1850" ;
    chart:yVal "450"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-825-1-2 a chart:DataPoint ;
    chart:series ex:series-825-1 ;
    chart:xVal "1875" ;
    chart:yVal "410"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-825-1-3 a chart:DataPoint ;
    chart:series ex:series-825-1 ;
    chart:xVal "1900" ;
    chart:yVal "410"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-825-1-4 a chart:DataPoint ;
    chart:series ex:series-825-1 ;
    chart:xVal "1925" ;
    chart:yVal "400"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-825-1-5 a chart:DataPoint ;
    chart:series ex:series-825-1 ;
    chart:xVal "1950" ;
    chart:yVal "220"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-825-1-6 a chart:DataPoint ;
    chart:series ex:series-825-1 ;
    chart:xVal "1975" ;
    chart:yVal "70"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-825-1-7 a chart:DataPoint ;
    chart:series ex:series-825-1 ;
    chart:xVal "2000" ;
    chart:yVal "30"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-825-1-8 a chart:DataPoint ;
    chart:series ex:series-825-1 ;
    chart:xVal "2020" ;
    chart:yVal "10"^^xsd:decimal ;
    chart:valueEstimated "true" .
