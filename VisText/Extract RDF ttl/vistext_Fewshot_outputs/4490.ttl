@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-4490 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Leading coffee exporting countries worldwide in 2018 (in million U.S. dollars)" ;
    chart:xAxis ex:x-4490 ;
    chart:yAxis ex:y-4490 .

ex:x-4490 a chart:Axis ;
    chart:label "Trade value in million U.S. dollars" ;
    chart:scaleMin "0" ;
    chart:scaleMax "4000" .

ex:y-4490 a chart:Axis ;
    chart:label "Country" .

ex:series-4490-1 a chart:Series .

ex:mark-4490-1-1 a chart:DataPoint ;
    chart:series ex:series-4490-1 ;
    chart:category "Belgium" ;
    chart:value "500"^^xsd:decimal ;
    chart:valueEstimated "true" .

