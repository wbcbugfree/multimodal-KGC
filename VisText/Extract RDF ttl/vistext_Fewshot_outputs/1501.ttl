@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-1501 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Number of retail chains in Bulgaria in 2020 , by sector" ;
    chart:xAxis ex:x-1501 ;
    chart:yAxis ex:y-1501 .

ex:x-1501 a chart:Axis ;
    chart:label "Sector" .

ex:y-1501 a chart:Axis ;
    chart:label "Number of retail chains" ;
    chart:scaleMin "0" ;
    chart:scaleMax "35" .

ex:series-1501-1 a chart:Series .

ex:dp-1501-1-1 a chart:DataPoint ;
    chart:series ex:series-1501-1 ;
    chart:category "Baby Ware" ;
    chart:value "12"^^xsd:decimal ;
    chart:valueEstimated "true" .

