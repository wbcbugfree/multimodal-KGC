@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-1801 a chart:Chart ;
    chart:chartType "area" ;
    chart:title "Madagascar : Fertility rate from 2008 to 2018" ;
    chart:xAxis ex:x-1801 ;
    chart:yAxis ex:y-1801 .

ex:x-1801 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2008" ;
    chart:scaleMax "2018" .

ex:y-1801 a chart:Axis ;
    chart:label "Number of children born per woman" ;
    chart:scaleMin "0" ;
    chart:scaleMax "5" .

ex:series-1801-1 a chart:Series .

ex:dp-1801-1-1 a chart:DataPoint ;
    chart:series ex:series-1801-1 ;
    chart:xVal "2008" ;
    chart:yVal "4.8"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-1801-1-2 a chart:DataPoint ;
    chart:series ex:series-1801-1 ;
    chart:xVal "2010" ;
    chart:yVal "4.6"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-1801-1-3 a chart:DataPoint ;
    chart:series ex:series-1801-1 ;
    chart:xVal "2012" ;
    chart:yVal "4.4"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-1801-1-4 a chart:DataPoint ;
    chart:series ex:series-1801-1 ;
    chart:xVal "2014" ;
    chart:yVal "4.2"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-1801-1-5 a chart:DataPoint ;
    chart:series ex:series-1801-1 ;
    chart:xVal "2016" ;
    chart:yVal "4.1"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-1801-1-6 a chart:DataPoint ;
    chart:series ex:series-1801-1 ;
    chart:xVal "2018" ;
    chart:yVal "4.0"^^xsd:decimal ;
    chart:valueEstimated "true" .
