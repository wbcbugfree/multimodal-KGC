@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-567 a chart:Chart ;
    chart:chartType "area" ;
    chart:title "Global foreign direct investment (FDI) position of the United Kingdom (UK) from 2004 to 2018 (in billion GBP)" ;
    chart:xAxis ex:x-567 ;
    chart:yAxis ex:y-567 .

ex:x-567 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2004" ;
    chart:scaleMax "2018" .

ex:y-567 a chart:Axis ;
    chart:label "Foreign direct investment in billion GBP" ;
    chart:scaleMin "0" ;
    chart:scaleMax "1500" .

ex:series-567-1 a chart:Series .

ex:dp-567-1-1 a chart:DataPoint ;
    chart:series ex:series-567-1 ;
    chart:xVal "2004" ;
    chart:yVal "600"^^xsd:decimal ;
    chart:value "600"^^xsd:decimal ;
    chart:valueEstimated "true" .

