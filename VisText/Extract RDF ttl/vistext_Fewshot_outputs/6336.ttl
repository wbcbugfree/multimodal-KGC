@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-6336 a chart:Chart ;
    chart:chartType "line" ;
    chart:title "Hasbro revenue breakdown by geographic region from 2009 to 2019 (in million U.S. dollars)" ;
    chart:xAxis ex:x-6336 ;
    chart:yAxis ex:y-6336 .

ex:x-6336 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2009" ;
    chart:scaleMax "2019" .

ex:y-6336 a chart:Axis ;
    chart:label "U.S. and Canada" ;
    chart:scaleMin "0" ;
    chart:scaleMax "2500" .

ex:series-6336-1 a chart:Series .

ex:dp-6336-1-1 a chart:DataPoint ;
    chart:series ex:series-6336-1 ;
    chart:xVal "2009" ;
    chart:yVal "2450"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-6336-1-2 a chart:DataPoint ;
    chart:series ex:series-6336-1 ;
    chart:xVal "2010" ;
    chart:yVal "2300"^^xsd:decimal ;
    chart:valueEstimated "true" .

