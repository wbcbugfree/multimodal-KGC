@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-2810 a chart:Chart ;
    chart:chartType "bar" ;
    chart:xAxis ex:x-2810 ;
    chart:yAxis ex:y-2810 .

ex:x-2810 a chart:Axis ;
    chart:label "Response" ;
    chart:scaleMin "2010" ;
    chart:scaleMax "2016" .

ex:y-2810 a chart:Axis ;
    chart:label "Share of female teachers" ;
    chart:scaleMin "0.0" ;
    chart:scaleMax "0.7" .

ex:series-2810-1 a chart:Series .

ex:dp-2810-1-1 a chart:DataPoint ;
    chart:series ex:series-2810-1 ;
    chart:category "2010" ;
    chart:value "0.65"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-2810-1-2 a chart:DataPoint ;
    chart:series ex:series-2810-1 ;
    chart:category "2011" ;
    chart:value "0.65"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-2810-1-3 a chart:DataPoint ;
    chart:series ex:series-2810-1 ;
    chart:category "2012" ;
    chart:value "0.65"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-2810-1-4 a chart:DataPoint ;
    chart:series ex:series-2810-1 ;
    chart:category "2013" ;
    chart:value "0.65"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-2810-1-5 a chart:DataPoint ;
    chart:series ex:series-2810-1 ;
    chart:category "2014" ;
    chart:value "0.65"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-2810-1-6 a chart:DataPoint ;
    chart:series ex:series-2810-1 ;
    chart:category "2015" ;
    chart:value "0.65"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-2810-1-7 a chart:DataPoint ;
    chart:series ex:series-2810-1 ;
    chart:category "2016" ;
    chart:value "0.65"^^xsd:decimal ;
    chart:valueEstimated "true" .
