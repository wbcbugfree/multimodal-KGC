@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-6590 a chart:Chart ;
    chart:chartType "area" ;
    chart:title "Number of employees in the gambling industry in the United Kingdom from 2009 to 2019 , by sector" ;
    chart:xAxis ex:x-6590 ;
    chart:yAxis ex:y-6590 .

ex:x-6590 a chart:Axis ;
    chart:label "year" ;
    chart:scaleMin "2009" ;
    chart:scaleMax "2019" .

ex:y-6590 a chart:Axis ;
    chart:label "Gaming Machine Technical" ;
    chart:scaleMin "0" ;
    chart:scaleMax "8000" .

ex:series-6590-1 a chart:Series ;
    chart:seriesName "Gaming Machine Technical" .

ex:series-6590-2 a chart:Series ;
    chart:seriesName "Other Sector" .

ex:dp-6590-1-1 a chart:DataPoint ;
    chart:series ex:series-6590-1 ;
    chart:xVal "2009" ;
    chart:yVal "7000"^^xsd:decimal ;
    chart:valueEstimated "true" .

