@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-3845 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Share of music video streams in the United States in 2018 , by genre" ;
    chart:xAxis ex:x-3845 ;
    chart:yAxis ex:y-3845 .

ex:x-3845 a chart:Axis ;
    chart:label "Genre" ;
    chart:scaleMin "" ;
    chart:scaleMax "" .

ex:y-3845 a chart:Axis ;
    chart:label "Share of consumption" ;
    chart:scaleMin "0.00" ;
    chart:scaleMax "0.20" .

ex:series-3845-1 a chart:Series .

ex:dp-3845-1-1 a chart:DataPoint ;
    chart:series ex:series-3845-1 ;
    chart:category "Children's" ;
    chart:value "0.01"^^xsd:decimal ;
    chart:valueEstimated "true" .

