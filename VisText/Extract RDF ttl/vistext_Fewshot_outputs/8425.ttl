@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-8425 a chart:Chart ;
    chart:chartType "area" ;
    chart:title "New Zealand : Distribution of employment by economic sector from 2010 to 2020" ;
    chart:xAxis ex:x-8425 ;
    chart:yAxis ex:y-8425 .

ex:x-8425 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2010" ;
    chart:scaleMax "2020" .

ex:y-8425 a chart:Axis ;
    chart:label "" ;
    chart:scaleMin "0.0" ;
    chart:scaleMax "0.8" .

ex:series-8425-1 a chart:Series ;
    chart:seriesName "Services" .

ex:dp-8425-1-1 a chart:DataPoint ;
    chart:series ex:series-8425-1 ;
    chart:xVal "2010" ;
    chart:yVal "0.76"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-8425-1-2 a chart:DataPoint ;
    chart:series ex:series-8425-1 ;
    chart:xVal "2012" ;
    chart:yVal "0.77"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-8425-1-3 a chart:DataPoint ;
    chart:series ex:series-8425-1 ;
    chart:xVal "2014" ;
    chart:yVal "0.77"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-8425-1-4 a chart:DataPoint ;
    chart:series ex:series-8425-1 ;
    chart:xVal "2016" ;
    chart:yVal "0.78"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-8425-1-5 a chart:DataPoint ;
    chart:series ex:series-8425-1 ;
    chart:xVal "2018" ;
    chart:yVal "0.78"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-8425-1-6 a chart:DataPoint ;
    chart:series ex:series-8425-1 ;
    chart:xVal "2020" ;
    chart:yVal "0.79"^^xsd:decimal ;
    chart:valueEstimated "true" .
