@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-1967 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Number of doping cases in international sports from 2000 to 2010" ;
    chart:xAxis ex:x-1967 ;
    chart:yAxis ex:y-1967 .

ex:x-1967 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2000" ;
    chart:scaleMax "2010" .

ex:y-1967 a chart:Axis ;
    chart:label "Number of cases" ;
    chart:scaleMin "0" ;
    chart:scaleMax "400" .

ex:series-1967-1 a chart:Series .

ex:dp-1967-1-1 a chart:DataPoint ;
    chart:series ex:series-1967-1 ;
    chart:category "2000" ;
    chart:value "60"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-1967-1-2 a chart:DataPoint ;
    chart:series ex:series-1967-1 ;
    chart:category "2001" ;
    chart:value "70"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-1967-1-3 a chart:DataPoint ;
    chart:series ex:series-1967-1 ;
    chart:category "2002" ;
    chart:value "55"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-1967-1-4 a chart:DataPoint ;
    chart:series ex:series-1967-1 ;
    chart:category "2003" ;
    chart:value "140"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-1967-1-5 a chart:DataPoint ;
    chart:series ex:series-1967-1 ;
    chart:category "2004" ;
    chart:value "160"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-1967-1-6 a chart:DataPoint ;
    chart:series ex:series-1967-1 ;
    chart:category "2005*" ;
    chart:value "430"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-1967-1-7 a chart:DataPoint ;
    chart:series ex:series-1967-1 ;
    chart:category "2006" ;
    chart:value "210"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-1967-1-8 a chart:DataPoint ;
    chart:series ex:series-1967-1 ;
    chart:category "2007" ;
    chart:value "210"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-1967-1-9 a chart:DataPoint ;
    chart:series ex:series-1967-1 ;
    chart:category "2008" ;
    chart:value "240"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-1967-1-10 a chart:DataPoint ;
    chart:series ex:series-1967-1 ;
    chart:category "2009" ;
    chart:value "220"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-1967-1-11 a chart:DataPoint ;
    chart:series ex:series-1967-1 ;
