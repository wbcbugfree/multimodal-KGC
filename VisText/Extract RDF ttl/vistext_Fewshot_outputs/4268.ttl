@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-4268 a chart:Chart ;
    chart:chartType "area" ;
    chart:title "Average price of jet boats in the U.S. from 2000 to 2013 (in U.S. dollars)" ;
    chart:xAxis ex:x-4268 ;
    chart:yAxis ex:y-4268 .

ex:x-4268 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2000" ;
    chart:scaleMax "2013" .

ex:y-4268 a chart:Axis ;
    chart:label "Average price in U.S. dollars" ;
    chart:scaleMin "0" ;
    chart:scaleMax "40000" .

ex:series-4268-1 a chart:Series .

ex:dp-4268-1-1 a chart:DataPoint ;
    chart:series ex:series-4268-1 ;
    chart:xVal "2000" ;
    chart:yVal "17000"^^xsd:decimal ;
    chart:valueEstimated "true" .

