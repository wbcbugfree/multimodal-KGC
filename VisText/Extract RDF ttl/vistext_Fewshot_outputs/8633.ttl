@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-8633 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Proposed federal spending by the U.S. government on cyber security for selected government agencies from FY 2020 to FY 2021 (in million U.S. dollars)" ;
    chart:xAxis ex:x-8633 ;
    chart:yAxis ex:y-8633 .

ex:x-8633 a chart:Axis ;
    chart:label "2020*" ;
    chart:scaleMin "0" ;
    chart:scaleMax "10000" .

ex:y-8633 a chart:Axis ;
    chart:label "United States federal executive department" .

ex:series-8633-1 a chart:Series .

ex:dp-8633-1-1 a chart:DataPoint ;
