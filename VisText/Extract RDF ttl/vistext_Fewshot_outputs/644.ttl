@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-644 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Estimated year-on-year revenue growth rate of selected major public apparel retailers in the United Kingdom (UK) in the fiscal year 2017 (in million GBP)" ;
    chart:xAxis ex:x-644 ;
    chart:yAxis ex:y-644 .

ex:x-644 a chart:Axis ;
    chart:label "Revenue growth rate" ;
    chart:scaleMin "-0.1" ;
    chart:scaleMax "0.3" .

ex:y-644 a chart:Axis ;
    chart:label "major public apparel retailers" ;
    chart:scaleMin "" ;
    chart:scaleMax "" .

ex:series-644-1 a chart:Series .

ex:dp-644-1-1 a chart:DataPoint ;
    chart:series ex:series-644-1 ;
    chart:category "ASOS" ;
    chart:value "0.17"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-644-1-2 a chart:DataPoint ;
    chart:series ex:series-644-1 ;
    chart:category "Bonmarche" ;
    chart:value "0.005"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-644-1-3 a chart:DataPoint ;
    chart:series ex:series-644-1 ;
    chart:category "Boohoo.com" ;
    chart:value "0.29"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-644-1-4 a chart:DataPoint ;
    chart:series ex:series-644-1 ;
    chart:category "Debenhams" ;
    chart:value "-0.04"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-644-1-5 a chart:DataPoint ;
    chart:series ex:series-644-1 ;
    chart:category "French Connection" ;
    chart:value "0.14"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-644-1-6 a chart:DataPoint ;
    chart:series ex:series-644-1 ;
    chart:category "JD Sports" ;
    chart:value "0.03"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-644-1-7 a chart:DataPoint ;
    chart:series ex:series-644-1 ;
    chart:category "Next" ;
    chart:value "0.002"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-644-1-8 a char:DataPoint ;
    chart:series ex:series-644-1 ;
    chart:category "M&S Clothing and Home" ;
    chart:value "0.15"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-644-1-9 a chart:DataPoint ;
    chart:series ex:series-644-1 ;
    chart:category "Primark UK" ;
    chart:value "0.08"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-644-1-10 a chart:DataPoint ;
    chart:series ex:series-644-1 ;
    chart:category "Sports Direct" ;
    chart:value "0.16"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-644-1-11 a chart:DataPoint ;
    chart:series ex:series-644-1 ;
    chart:category "SuperGroup" ;
    chart:value "0.16"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-644-1-12 a chart:DataPoint ;
    chart:series ex:series-644-1 ;
    chart:category "Ted Baker" ;
