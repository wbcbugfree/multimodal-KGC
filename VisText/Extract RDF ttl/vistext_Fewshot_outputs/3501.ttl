@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-3501 a chart:Chart ;
    chart:chartType "line" ;
    chart:xAxis ex:x-3501 ;
    chart:yAxis ex:y-3501 .

ex:x-3501 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2004" ;
    chart:scaleMax "2017" .

ex:y-3501 a chart:Axis ;
    chart:label "Families in thousands" ;
    chart:scaleMin "0" ;
    chart:scaleMax "400" .

ex:series-3501-1 a chart:Series .

ex:dp-3501-1-1 a chart:DataPoint ;
    chart:series ex:series-3501-1 ;
    chart:xVal "2004" ;
    chart:yVal "220"^^xsd:decimal ;
    chart:value "220"^^xsd:decimal ;
    chart:valueEstimated "true" .

