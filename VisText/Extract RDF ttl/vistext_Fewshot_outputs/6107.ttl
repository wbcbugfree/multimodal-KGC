@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-6107 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Clinical trial costs by selected cost component and clinical phase as of 2014 (in U.S. dollars)" ;
    chart:xAxis ex:x-6107 ;
    chart:yAxis ex:y-6107 .

ex:x-6107 a chart:Axis ;
    chart:label "Phase 1" ;
    chart:scaleMin "0" ;
    chart:scaleMax "500000" .

ex:y-6107 a chart:Axis ;
    chart:label "Cost component" ;
    chart:scaleMin "" ;
    chart:scaleMax "" .

ex:series-6107-1 a chart:Series .

ex:dp-6107-1-1 a chart:DataPoint ;
    chart:series ex:series-6107-1 ;
    chart:category "Administrative Staff Costs" ;
    chart:value "170000"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-6107-1-2 a chart:DataPoint ;
    chart:series ex:series-6107-1 ;
    chart:category "Central Lab Costs" ;
    chart:value "180000"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-6107-1-3 a chart:DataPoint ;
    chart:series ex:series-6107-1 ;
    chart:category "Clinical Procedure Total" ;
    chart:value "450000"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-6107-1-4 a chart:DataPoint ;
    chart:series ex:series-6107-1 ;
    chart:category "Cost Per IRB Approvals" ;
    chart:value "5000"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-6107-1-5 a chart:DataPoint ;
    chart:series ex:series-6107-1 ;
    chart:category "Cost of IRB Amendments" ;
    chart:value "10000"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-6107-1-6 a chart:DataPoint ;
    chart:series ex:series-6107-1 ;
    chart:category "Data Management Costs" ;
    chart:value "40000"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-6107-1-7 a chart:DataPoint ;
    chart:series ex:series-6107-1 ;
    chart:category "Patient Recruitment Costs" ;
    chart:value "20000"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-6107-1-8 a chart:DataPoint ;
    chart:series ex:series-6107-1 ;
    chart:category "Patient Retention Costs" ;
    chart:value "5000"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-6107-1-9 a chart:DataPoint ;
    chart:series ex:series-6107-1 ;
    chart:category "Physician Costs" ;
    chart:value "80000"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-6107-1-10 a chart:DataPoint ;
    chart:series ex:series-6107-1 ;
    chart:category "RN/CRA Costs" ;
    chart:value "150000"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-6107-1-11 a chart:DataPoint ;
    chart:series ex:series-6107-1 ;
    chart:category "SDV Costs" ;
    chart:value "320000"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-6107-1-12 a chart:DataPoint ;
    chart:series ex:series-6107-1 ;
    chart:category "Site Monitoring Costs" ;
    chart:value "190000"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-6107-1-13 a chart:DataPoint ;
    chart:series ex:series-6107-1 ;
    chart:category "Site Recruitment Costs" ;
    chart:value "60000"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-6107-1-14 a chart:DataPoint ;
