@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-2737 a chart:Chart ;
    chart:chartType "line" ;
    chart:title "Gross secondary school enrollment ratio in Ghana from 2008 to 2019" ;
    chart:xAxis ex:x-2737 ;
    chart:yAxis ex:y-2737 .

ex:x-2737 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2008" ;
    chart:scaleMax "2019" .

ex:y-2737 a chart:Axis ;
    chart:label "Gross secondary school enrollment ratio" ;
    chart:scaleMin "0" ;
    chart:scaleMax "80" .

ex:series-2737-1 a chart:Series .

ex:dp-2737-1-1 a chart:DataPoint ;
    chart:series ex:series-2737-1 ;
    chart:xVal "2008" ;
    chart:yVal "45"^^xsd:decimal ;
    chart:valueEstimated "true" .

