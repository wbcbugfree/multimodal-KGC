@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-7072 a chart:Chart ;
    chart:chartType "line" ;
    chart:title "Number of justifiable homicides by law enforcement officers and private citizens in the United States from 2007 to 2019" ;
    chart:xAxis ex:x-7072 ;
    chart:yAxis ex:y-7072 .

ex:x-7072 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2007" ;
    chart:scaleMax "2019" .

ex:y-7072 a chart:Axis ;
    chart:label "Private citizens" ;
    chart:scaleMin "0" ;
    chart:scaleMax "400" .

ex:series-7072-1 a chart:Series .

ex:dp-7072-1-1 a chart:DataPoint ;
    chart:series ex:series-7072-1 ;
    chart:xVal "2007" ;
    chart:yVal "250"^^xsd:decimal ;
    chart:valueEstimated "true" .

