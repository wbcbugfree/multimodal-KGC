@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-1314 a chart:Chart ;
    chart:chartType "line" ;
    chart:title "Number of Volkswagen Golf registered cars in Great Britain from 2000 to 2018" ;
    chart:xAxis ex:x-1314 ;
    chart:yAxis ex:y-1314 .

ex:x-1314 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2000" ;
    chart:scaleMax "2018" .

ex:y-1314 a chart:Axis ;
    chart:label "Number of registered cars" ;
    chart:scaleMin "0" ;
    chart:scaleMax "1000000" .

ex:series-1314-1 a chart:Series .

ex:dp-1314-1-1 a chart:DataPoint ;
    chart:series ex:series-1314-1 ;
    chart:xVal "2000" ;
    chart:yVal "650000"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-1314-1-2 a chart:DataPoint ;
    chart:series ex:series-1314-1 ;
    chart:xVal "2002" ;
    chart:yVal "750000"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-1314-1-3 a chart:DataPoint ;
    chart:series ex:series-1314-1 ;
    chart:xVal "2004" ;
    chart:yVal "800000"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-1314-1-4 a chart:DataPoint ;
    chart:series ex:series-1314-1 ;
    chart:xVal "2006" ;
    chart:yVal "830000"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-1314-1-5 a chart:DataPoint ;
    chart:series ex:series-1314-1 ;
    chart:xVal "2008" ;
    chart:yVal "860000"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-1314-1-6 a chart:DataPoint ;
    chart:series ex:series-1314-1 ;
    chart:xVal "2010" ;
    chart:yVal "890000"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-1314-1-7 a chart:DataPoint ;
    chart:series ex:series-1314-1 ;
    chart:xVal "2012" ;
    chart:yVal "920000"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-1314-1-8 a chart:DataPoint ;
    chart:series ex:series-1314-1 ;
    chart:xVal "2014" ;
    chart:yVal "940000"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-1314-1-9 a chart:DataPoint ;
    chart:series ex:series-1314-1 ;
    chart:xVal "2016" ;
    chart:yVal "960000"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-1314-1-10 a chart:DataPoint ;
    chart:series ex:series-1314-1 ;
    chart:xVal "2018" ;
    chart:yVal "970000"^^xsd:decimal ;
    chart:valueEstimated "true" .
