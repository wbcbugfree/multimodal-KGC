@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-1840 a chart:Chart ;
    chart:chartType "line" ;
    chart:title "Debt of the Ford Motor Company from FY 2007 to FY 2019 (in million U.S. dollars)" ;
    chart:xAxis ex:x-1840 ;
    chart:yAxis ex:y-1840 .

ex:x-1840 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2007" ;
    chart:scaleMax "2019" .

ex:y-1840 a chart:Axis ;
    chart:label "Net income in million U.S. dollars" ;
    chart:scaleMin "0" ;
    chart:scaleMax "150000" .

ex:series-1840-1 a chart:Series .

ex:dp-1840-1-1 a chart:DataPoint ;
    chart:series ex:series-1840-1 ;
    chart:xVal "2007" ;
    chart:yVal "150000"^^xsd:decimal ;
    chart:value "150000"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-1840-1-2 a chart:DataPoint ;
    chart:series ex:series-1840-1 ;
    chart:xVal "2008" ;
    chart:yVal "125000"^^xsd:decimal ;
    chart:value "125000"^^xsd:decimal ;
    chart:valueEstimated "true" .

