@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-8757 a chart:Chart ;
    chart:chartType "line" ;
    chart:title "Canada : Distribution of gross domestic product (GDP) across economic sectors from 2007 to 2016" ;
    chart:xAxis ex:x-8757 ;
    chart:yAxis ex:y-8757 .

ex:x-8757 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2007" ;
    chart:scaleMax "2016" .

ex:y-8757 a chart:Axis ;
    chart:label "Agriculture" ;
    chart:scaleMin "0.000" ;
    chart:scaleMax "0.020" .

ex:series-8757-1 a chart:Series .

ex:dp-8757-1-1 a chart:DataPoint ;
    chart:series ex:series-8757-1 ;
    chart:xVal "2007" ;
    chart:yVal "0.014"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-8757-1-2 a chart:DataPoint ;
    chart:series ex:series-8757-1 ;
    chart:xVal "2008" ;
    chart:yVal "0.015"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-8757-1-3 a chart:DataPoint ;
    chart:series ex:series-8757-1 ;
    chart:xVal "2009" ;
    chart:yVal "0.013"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-8757-1-4 a chart:DataPoint ;
    chart:series ex:series-8757-1 ;
    chart:xVal "2010" ;
    chart:yVal "0.012"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-8757-1-5 a chart:DataPoint ;
    chart:series ex:series-8757-1 ;
    chart:xVal "2011" ;
    chart:yVal "0.014"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-8757-1-6 a chart:DataPoint ;
    chart:series ex:series-8757-1 ;
    chart:xVal "2012" ;
    chart:yVal "0.016"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-8757-1-7 a chart:DataPoint ;
    chart:series ex:series-8757-1 ;
    chart:xVal "2013" ;
    chart:yVal "0.017"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-8757-1-8 a chart:DataPoint ;
    chart:series ex:series-8757-1 ;
    chart:xVal "2014" ;
    chart:yVal "0.016"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-8757-1-9 a chart:DataPoint ;
    chart:series ex:series-8757-1 ;
    chart:xVal "2015" ;
    chart:yVal "0.017"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-8757-1-10 a chart:DataPoint ;
    chart:series ex:series-8757-1 ;
    chart:xVal "2016" ;
