@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-3007 a chart:Chart ;
    chart:chartType "line" ;
    chart:title "Enhanced annuities sold as a proportion of all annuities in the United Kingdom (UK) from 2003 to 2012" ;
    chart:xAxis ex:x-3007 ;
    chart:yAxis ex:y-3007 .

ex:x-3007 a chart:Axis ;
    chart:label "Response" ;
    chart:scaleMin "2003" ;
    chart:scaleMax "2012" .

ex:y-3007 a chart:Axis ;
    chart:label "Percentage of enhanced annuities sold" ;
    chart:scaleMin "0.00" ;
    chart:scaleMax "0.20" .

ex:series-3007-1 a chart:Series .

ex:dp-3007-1-1 a chart:DataPoint ;
    chart:series ex:series-3007-1 ;
    chart:xVal "2003" ;
    chart:yVal "0.02"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-3007-1-2 a chart:DataPoint ;
    chart:series ex:series-3007-1 ;
    chart:xVal "2004" ;
    chart:yVal "0.03"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-3007-1-3 a chart:DataPoint ;
    chart:series ex:series-3007-1 ;
    chart:xVal "2005" ;
    chart:yVal "0.05"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-3007-1-4 a chart:DataPoint ;
    chart:series ex:series-3007-1 ;
    chart:xVal "2006" ;
    chart:yVal "0.06"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-3007-1-5 a chart:DataPoint ;
    chart:series ex:series-3007-1 ;
    chart:xVal "2007" ;
    chart:yVal "0.07"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-3007-1-6 a chart:DataPoint ;
    chart:series ex:series-3007-1 ;
    chart:xVal "2008" ;
    chart:yVal "0.08"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-3007-1-7 a chart:DataPoint ;
    chart:series ex:series-3007-1 ;
    chart:xVal "2009" ;
    chart:yVal "0.09"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-3007-1-8 a chart:DataPoint ;
    chart:series ex:series-3007-1 ;
    chart:xVal "2010" ;
    chart:yVal "0.12"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-3007-1-9 a chart:DataPoint ;
    chart:series ex:series-3007-1 ;
    chart:xVal "2011" ;
    chart:yVal "0.18"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-3007-1-10 a chart:DataPoint ;
    chart:series ex:series-3007-1 ;
    chart:xVal "2012" ;
    chart:yVal "0.24"^^xsd:decimal ;
    chart:valueEstimated "true" .
