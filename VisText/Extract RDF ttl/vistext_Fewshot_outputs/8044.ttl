@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-8044 a chart:Chart ;
    chart:chartType "area" ;
    chart:title "Average daily cigarette consumption in Great Britain from 2000 to 2016 , by gender (in cigarettes per day)" ;
    chart:xAxis ex:x-8044 ;
    chart:yAxis ex:y-8044 .

ex:x-8044 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2000" ;
    chart:scaleMax "2015" .

ex:y-8044 a chart:Axis ;
    chart:label "Women" ;
    chart:scaleMin "0" ;
    chart:scaleMax "12" .

ex:series-8044-1 a chart:Series .

ex:dp-8044-1-1 a chart:DataPoint ;
    chart:series ex:series-8044-1 ;
    chart:xVal "2000" ;
    chart:yVal "12.5"^^xsd:decimal ;
    chart:value "12.5"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-8044-1-2 a chart:DataPoint ;
    chart:series ex:series-8044-1 ;
    chart:xVal "2005" ;
    chart:yVal "12.0"^^xsd:decimal ;
    chart:value "12.0"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-8044-1-3 a chart:DataPoint ;
    chart:series ex:series-8044-1 ;
    chart:xVal "2010" ;
    chart:yVal "11.5"^^xsd:decimal ;
    chart:value "11.5"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-8044-1-4 a chart:DataPoint ;
    chart:series ex:series-8044-1 ;
    chart:xVal "2015" ;
    chart:yVal "10.8"^^xsd:decimal ;
    chart:value "10.8"^^xsd:decimal ;
    chart:valueEstimated "true" .
