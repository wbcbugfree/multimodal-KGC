@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-3322 a chart:Chart ;
    chart:chartType "area" ;
    chart:title "Costa Rica : Birth rate from 2008 to 2018 (per 1,000 inhabitants)" ;
    chart:xAxis ex:x-3322 ;
    chart:yAxis ex:y-3322 .

ex:x-3322 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2008" ;
    chart:scaleMax "2018" .

ex:y-3322 a chart:Axis ;
    chart:label "Birth rate per thousand population" ;
    chart:scaleMin "0" ;
    chart:scaleMax "18" .

ex:series-3322-1 a chart:Series .

ex:dp-3322-1-1 a chart:DataPoint ;
    chart:series ex:series-3322-1 ;
    chart:xVal "2008" ;
    chart:yVal "16.5"^^xsd:decimal ;
    chart:value "16.5"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-3322-1-2 a chart:DataPoint ;
    chart:series ex:series-3322-1 ;
    chart:xVal "2010" ;
    chart:yVal "16.0"^^xsd:decimal ;
    chart:value "16.0"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-3322-1-3 a chart:DataPoint ;
    chart:series ex:series-3322-1 ;
    chart:xVal "2012" ;
    chart:yVal "15.5"^^xsd:decimal ;
    chart:value "15.5"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-3322-1-4 a chart:DataPoint ;
    chart:series ex:series-3322-1 ;
    chart:xVal "2014" ;
    chart:yVal "15.0"^^xsd:decimal ;
    chart:value "15.0"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-3322-1-5 a chart:DataPoint ;
    chart:series ex:series-3322-1 ;
    chart:xVal "2016" ;
    chart:yVal "14.5"^^xsd:decimal ;
    chart:value "14.5"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-3322-1-6 a chart:DataPoint ;
    chart:series ex:series-3322-1 ;
    chart:xVal "2018" ;
    chart:yVal "14.0"^^xsd:decimal ;
    chart:value "14.0"^^xsd:decimal ;
    chart:valueEstimated "true" .
