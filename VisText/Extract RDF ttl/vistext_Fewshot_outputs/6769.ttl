@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-6769 a chart:Chart ;
    chart:chartType "line" ;
    chart:xAxis ex:x-6769 ;
    chart:yAxis ex:y-6769 .

ex:x-6769 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2010" ;
    chart:scaleMax "2018" .

ex:y-6769 a chart:Axis ;
    chart:label "Agribusiness" ;
    chart:scaleMin "0" ;
    chart:scaleMax "40000" .

ex:series-6769-1 a chart:Series .

ex:dp-6769-1-1 a chart:DataPoint ;
    chart:series ex:series-6769-1 ;
    chart:xVal "2010" ;
    chart:yVal "25000"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-6769-1-2 a chart:DataPoint ;
    chart:series ex:series-6769-1 ;
    chart:xVal "2011" ;
    chart:yVal "32000"^^xsd:decimal ;
    chart:valueEstimated "true" .

