    chart:valueEstimated "true" .

ex:dp-6769-1-7 a chart:DataPoint ;
    chart:series ex:series-6769-1 ;
    chart:xVal "2016" ;
    chart:yVal "26000"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-6769-1-8 a chart:DataPoint ;
