    chart:series ex:series-6769-1 ;
    chart:xVal "2013" ;
    chart:yVal "40000"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-6769-1-5 a chart:DataPoint ;
    chart:series ex:series-6769-1 ;
    chart:xVal "2014" ;
    chart:yVal "38000"^^xsd:decimal ;
    chart:valueEstimated "true" .

