@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-2531 a chart:Chart ;
    chart:chartType "line" ;
    chart:title "Number of Canadian students enrolled in postsecondary institutions in Canada from 2000 to 2018 (in millions)" ;
    chart:xAxis ex:x-2531 ;
    chart:yAxis ex:y-2531 .

ex:x-2531 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2000" ;
    chart:scaleMax "2018" .

ex:y-2531 a chart:Axis ;
    chart:label "Number of Canadian students in millions" ;
    chart:scaleMin "0.0" ;
    chart:scaleMax "2.0" .

ex:series-2531-1 a chart:Series .

ex:dp-2531-1-1 a chart:DataPoint ;
    chart:series ex:series-2531-1 ;
    chart:xVal "2000" ;
    chart:yVal "1.0"^^xsd:decimal ;
    chart:value "1.0"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-2531-1-2 a chart:DataPoint ;
    chart:series ex:series-2531-1 ;
    chart:xVal "2002" ;
    chart:yVal "1.35"^^xsd:decimal ;
    chart:value "1.35"^^xsd:decimal ;
    chart:valueEstimated "true" .

