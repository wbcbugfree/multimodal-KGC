@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-3939 a chart:Chart ;
    chart:chartType "line" ;
    chart:title "Combined desktop and mobile visits to Walmart.com from May 2019 to September 2020 (in millions)" ;
    chart:xAxis ex:x-3939 ;
    chart:yAxis ex:y-3939 .

ex:x-3939 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "July 2019" ;
    chart:scaleMax "July 2020" .

ex:y-3939 a chart:Axis ;
    chart:label "Number of visits in millions" ;
    chart:scaleMin "0" ;
    chart:scaleMax "500" .

ex:series-3939-1 a chart:Series .

ex:dp-3939-1-1 a chart:DataPoint ;
    chart:series ex:series-3939-1 ;
    chart:xVal "July 2019" ;
    chart:yVal "315"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-3939-1-2 a chart:DataPoint ;
    chart:series ex:series-3939-1 ;
    chart:xVal "October 2019" ;
    chart:yVal "330"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-3939-1-3 a chart:DataPoint ;
    chart:series ex:series-3939-1 ;
    chart:xVal "January 2020" ;
    chart:yVal "295"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-3939-1-4 a chart:DataPoint ;
    chart:series ex:series-3939-1 ;
    chart:xVal "April 2020" ;
    chart:yVal "290"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-3939-1-5 a chart:DataPoint ;
    chart:series ex:series-3939-1 ;
    chart:xVal "July 2020" ;
    chart:yVal "430"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-3939-1-6 a chart:DataPoint ;
    chart:series ex:series-3939-1 ;
    chart:xVal "October 2020" ;
    chart:yVal "410"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-3939-1-7 a chart:DataPoint ;
    chart:series ex:series-3939-1 ;
    chart:xVal "January 2021" ;
    chart:yVal "440"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-3939-1-8 a chart:DataPoint ;
    chart:series ex:series-3939-1 ;
    chart:xVal "April 2021" ;
    chart:yVal "380"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-3939-1-9 a chart:DataPoint ;
    chart:series ex:series-3939-1 ;
    chart:xVal "July 2021" ;
    chart:yVal "360"^^xsd:decimal ;
    chart:valueEstimated "true" .
