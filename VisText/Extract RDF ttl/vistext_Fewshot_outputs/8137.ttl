@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-8137 a chart:Chart ;
    chart:chartType "line" ;
    chart:title "Number of building permits issued in the Netherlands from 2006 to 2016 , by type of housing" ;
    chart:xAxis ex:x-8137 ;
    chart:yAxis ex:y-8137 .

ex:x-8137 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2006" ;
    chart:scaleMax "2016" .

ex:y-8137 a chart:Axis ;
    chart:label "Rental property" ;
    chart:scaleMin "0" ;
    chart:scaleMax "25000" .

ex:series-8137-1 a chart:Series .

ex:dp-8137-1-1 a chart:DataPoint ;
    chart:series ex:series-8137-1 ;
    chart:xVal "2006" ;
    chart:yVal "24000"^^xsd:decimal ;
    chart:value "24000"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-8137-1-2 a chart:DataPoint ;
    chart:series ex:series-8137-1 ;
    chart:xVal "2007" ;
    chart:yVal "24000"^^xsd:decimal ;
    chart:value "24000"^^xsd:decimal ;
    chart:valueEstimated "true" .

