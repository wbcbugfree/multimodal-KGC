@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-8230 a chart:Chart ;
    chart:chartType "line" ;
    chart:title "Reported cases of rubella worldwide from 1999 to 2018 , by region" ;
    chart:xAxis ex:x-8230 ;
    chart:yAxis ex:y-8230 .

ex:x-8230 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "1999" ;
    chart:scaleMax "2018" .

ex:y-8230 a chart:Axis ;
    chart:label "Americas" ;
    chart:scaleMin "0" ;
    chart:scaleMax "60000" .

ex:series-8230-1 a chart:Series ;
    chart:seriesName "Americas" .

ex:dp-8230-1-1 a chart:DataPoint ;
    chart:series ex:series-8230-1 ;
    chart:xVal "1999" ;
    chart:yVal "59000"^^xsd:decimal ;
    chart:value "59000"^^xsd:decimal ;
    chart:valueEstimated "true" .

