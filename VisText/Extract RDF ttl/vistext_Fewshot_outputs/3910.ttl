@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-3910 a chart:Chart ;
    chart:chartType "area" ;
    chart:title "Population of the Riverside-San Bernardino-Ontario metro area in the United States from 2010 to 2019" ;
    chart:xAxis ex:x-3910 ;
    chart:yAxis ex:y-3910 .

ex:x-3910 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2010" ;
    chart:scaleMax "2019" .

ex:y-3910 a chart:Axis ;
    chart:label "Number of residents" ;
    chart:scaleMin "0" ;
    chart:scaleMax "5,000,000" .

ex:series-3910-1 a chart:Series .

ex:dp-3910-1-1 a chart:DataPoint ;
    chart:series ex:series-3910-1 ;
    chart:xVal "2010" ;
    chart:yVal "4300000"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-3910-1-2 a chart:DataPoint ;
    chart:series ex:series-3910-1 ;
    chart:xVal "2012" ;
    chart:yVal "4400000"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-3910-1-3 a chart:DataPoint ;
    chart:series ex:series-3910-1 ;
    chart:xVal "2014" ;
    chart:yVal "4500000"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-3910-1-4 a chart:DataPoint ;
    chart:series ex:series-3910-1 ;
    chart:xVal "2016" ;
    chart:yVal "4600000"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-3910-1-5 a chart:DataPoint ;
    chart:series ex:series-3910-1 ;
    chart:xVal "2018" ;
    chart:yVal "4700000"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-3910-1-6 a chart:DataPoint ;
    chart:series ex:series-3910-1 ;
    chart:xVal "2019" ;
    chart:yVal "4750000"^^xsd:decimal ;
    chart:valueEstimated "true" .
