    chart:series ex:series-8309-1 ;
    chart:category "Automation" ;
    chart:value "0.25"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-8309-1-5 a chart:DataPoint ;
    chart:series ex:series-8309-1 ;
    chart:category "Blockchain" ;
    chart:value "0.46"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-8309-1-6 a chart:DataPoint ;
