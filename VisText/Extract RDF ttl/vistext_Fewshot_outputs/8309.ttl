    chart:value "0.15"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-8309-1-7 a chart:DataPoint ;
    chart:series ex:series-8309-1 ;
    chart:category "Edge computing" ;
    chart:value "0.38"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-8309-1-8 a chart:DataPoint ;
