@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-8309 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "How do you expect COVID-19 to impact your spending for any of the following ?" ;
    chart:xAxis ex:x-8309 ;
    chart:yAxis ex:y-8309 .

ex:x-8309 a chart:Axis ;
    chart:label "Stay the same" ;
    chart:scaleMin "0.0" ;
    chart:scaleMax "0.5" .

ex:y-8309 a chart:Axis ;
    chart:label "Response" .

ex:series-8309-1 a chart:Series .

ex:dp-8309-1-1 a chart:DataPoint ;
    chart:series ex:series-8309-1 ;
    chart:category "5G" ;
    chart:value "0.42"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-8309-1-2 a chart:DataPoint ;
    chart:series ex:series-8309-1 ;
    chart:category "AI" ;
    chart:value "0.23"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-8309-1-3 a chart:DataPoint ;
    chart:series ex:series-8309-1 ;
    chart:category "AR/VR" ;
    chart:value "0.35"^^xsd:decimal ;
    chart:valueEstimated "true" .

