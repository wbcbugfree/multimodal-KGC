@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-74 a chart:Chart ;
    chart:chartType "line" ;
    chart:title "The adidas Group 's financial leverage worldwide from 2000 to 2018" ;
    chart:xAxis ex:x-74 ;
    chart:yAxis ex:y-74 .

ex:x-74 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2000" ;
    chart:scaleMax "2018" .

ex:y-74 a chart:Axis ;
    chart:label "Financial leverage" ;
    chart:scaleMin "0.0" ;
    chart:scaleMax "2.0" .

ex:series-74-1 a chart:Series .

ex:dp-74-1-1 a chart:DataPoint ;
    chart:series ex:series-74-1 ;
    chart:xVal "2000" ;
    chart:yVal "1.9"^^xsd:decimal ;
    chart:valueEstimated "true" .

