@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-3786 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Characteristics of a dream woman in China from a male perspective in 2012" ;
    chart:xAxis ex:x-3786 ;
    chart:yAxis ex:y-3786 .

ex:x-3786 a chart:Axis ;
    chart:label "Share of respondents" ;
    chart:scaleMin "0.0" ;
    chart:scaleMax "0.5" .

ex:y-3786 a chart:Axis ;
    chart:label "Response" .

ex:series-3786-1 a chart:Series .

ex:dp-3786-1-1 a chart:DataPoint ;
    chart:series ex:series-3786-1 ;
    chart:category "Good manners and a good cook/h..." ;
    chart:value "0.48"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-3786-1-2 a chart:DataPoint ;
    chart:series ex:series-3786-1 ;
    chart:category "Elegance" ;
    chart:value "0.45"^^xsd:decimal ;
    chart:valueEstimated "true" .

