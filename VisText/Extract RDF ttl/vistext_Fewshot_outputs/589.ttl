@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-589 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Chicago Bulls all-time assists leaders from 1966 to 2020" ;
    chart:xAxis ex:x-589 ;
    chart:yAxis ex:y-589 .

ex:x-589 a chart:Axis ;
    chart:label "Chicago Bulls players" ;
    chart:scaleMin "0" ;
    chart:scaleMax "" .

ex:y-589 a chart:Axis ;
    chart:label "Assists" ;
    chart:scaleMin "0" ;
    chart:scaleMax "5000" .

ex:series-589-1 a chart:Series .

ex:dp-589-1-1 a chart:DataPoint ;
    chart:series ex:series-589-1 ;
    chart:category "Bob Weiss" ;
    chart:value "1600"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-589-1-2 a chart:DataPoint ;
    chart:series ex:series-589-1 ;
    chart:category "Derrick Rose" ;
    chart:value "2100"^^xsd:decimal ;
    chart:valueEstimated "true" .

