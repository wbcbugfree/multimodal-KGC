@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-6426 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Leading countries based on natural gas production in 2014 and 2018 (in billion cubic meters)" ;
    chart:xAxis ex:x-6426 ;
    chart:yAxis ex:y-6426 .

ex:x-6426 a chart:Axis ;
    chart:label "Country" ;
    chart:scaleMin "" ;
    chart:scaleMax "" .

ex:y-6426 a chart:Axis ;
    chart:label "" ;
    chart:scaleMin "0" ;
    chart:scaleMax "800" .

ex:series-6426-1 a chart:Series .

ex:dp-6426-1-1 a chart:DataPoint ;
    chart:series ex:series-6426-1 ;
    chart:category "Algeria" ;
    chart:value "50"^^xsd:decimal ;
    chart:valueEstimated "true" .

