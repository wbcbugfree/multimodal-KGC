@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-6510 a chart:Chart ;
    chart:chartType "line" ;
    chart:title "Lithuania : Distribution of gross domestic product (GDP) across economic sectors from 2009 to 2019" ;
    chart:xAxis ex:x-6510 ;
    chart:yAxis ex:y-6510 .

ex:x-6510 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2009" ;
    chart:scaleMax "2019" .

ex:y-6510 a chart:Axis ;
    chart:label "Agriculture" ;
    chart:scaleMin "0.00" ;
    chart:scaleMax "0.04" .

ex:series-6510-1 a chart:Series ;
    chart:seriesName "Agriculture" .

ex:dp-6510-1-1 a chart:DataPoint ;
    chart:series ex:series-6510-1 ;
    chart:xVal "2009" ;
    chart:yVal "0.025"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-6510-1-2 a chart:DataPoint ;
    chart:series ex:series-6510-1 ;
    chart:xVal "2010" ;
    chart:yVal "0.04"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-6510-1-3 a chart:DataPoint ;
    chart:series ex:series-6510-1 ;
    chart:xVal "2011" ;
    chart:yVal "0.036"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-6510-1-4 a chart:DataPoint ;
    chart:series ex:series-6510-1 ;
    chart:xVal "2012" ;
    chart:yVal "0.035"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-6510-1-5 a chart:DataPoint ;
    chart:series ex:series-6510-1 ;
    chart:xVal "2013" ;
    chart:yVal "0.035"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-6510-1-6 a chart:DataPoint ;
    chart:series ex:series-6510-1 ;
    chart:xVal "2014" ;
    chart:yVal "0.031"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-6510-1-7 a chart:DataPoint ;
    chart:series ex:series-6510-1 ;
    chart:xVal "2015" ;
    chart:yVal "0.036"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-6510-1-8 a chart:DataPoint ;
    chart:series ex:series-6510-1 ;
    chart:xVal "2016" ;
