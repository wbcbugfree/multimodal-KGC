@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-2093 a chart:Chart ;
    chart:chartType "area" ;
    chart:title "Rwanda : Birth rate from 2008 to 2018 (per 1,000 inhabitants)" ;
    chart:xAxis ex:x-2093 ;
    chart:yAxis ex:y-2093 .

ex:x-2093 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2008" ;
    chart:scaleMax "2018" .

ex:y-2093 a chart:Axis ;
    chart:label "Birth rate per thousand population" ;
    chart:scaleMin "0" ;
    chart:scaleMax "40" .

ex:series-2093-1 a chart:Series .

ex:dp-2093-1-1 a chart:DataPoint ;
    chart:series ex:series-2093-1 ;
    chart:xVal "2008" ;
    chart:yVal "36.5"^^xsd:decimal ;
    chart:value "36.5"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-2093-1-2 a chart:DataPoint ;
    chart:series ex:series-2093-1 ;
    chart:xVal "2010" ;
    chart:yVal "35.5"^^xsd:decimal ;
    chart:value "35.5"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-2093-1-3 a chart:DataPoint ;
    chart:series ex:series-2093-1 ;
    chart:xVal "2012" ;
    chart:yVal "34.5"^^xsd:decimal ;
    chart:value "34.5"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-2093-1-4 a chart:DataPoint ;
    chart:series ex:series-2093-1 ;
    chart:xVal "2014" ;
    chart:yVal "33.5"^^xsd:decimal ;
    chart:value "33.5"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-2093-1-5 a chart:DataPoint ;
    chart:series ex:series-2093-1 ;
    chart:xVal "2016" ;
    chart:yVal "32.8"^^xsd:decimal ;
    chart:value "32.8"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-2093-1-6 a chart:DataPoint ;
    chart:series ex:series-2093-1 ;
    chart:xVal "2018" ;
    chart:yVal "32.2"^^xsd:decimal ;
    chart:value "32.2"^^xsd:decimal ;
    chart:valueEstimated "true" .
