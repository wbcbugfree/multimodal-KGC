@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-1150 a chart:Chart ;
    chart:chartType "area" ;
    chart:title "Number of coronavirus (COVID-19) recoveries in Romania as of January 8 , 2021 (in 1,000s)" ;
    chart:xAxis ex:x-1150 ;
    chart:yAxis ex:y-1150 .

ex:x-1150 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "July" ;
    chart:scaleMax "2021" .

ex:y-1150 a chart:Axis ;
    chart:label "Number of people in thousands" ;
    chart:scaleMin "0" ;
    chart:scaleMax "600" .

ex:series-1150-1 a chart:Series .

ex:dp-1150-1-1 a chart:DataPoint ;
    chart:series ex:series-1150-1 ;
    chart:xVal "July" ;
    chart:yVal "0"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-1150-1-2 a chart:DataPoint ;
    chart:series ex:series-1150-1 ;
    chart:xVal "August" ;
    chart:yVal "10"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-1150-1-3 a chart:DataPoint ;
    chart:series ex:series-1150-1 ;
    chart:xVal "September" ;
    chart:yVal "50"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-1150-1-4 a chart:DataPoint ;
    chart:series ex:series-1150-1 ;
    chart:xVal "October" ;
    chart:yVal "100"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-1150-1-5 a chart:DataPoint ;
    chart:series ex:series-1150-1 ;
    chart:xVal "November" ;
    chart:yVal "200"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-1150-1-6 a chart:DataPoint ;
    chart:series ex:series-1150-1 ;
    chart:xVal "December" ;
    chart:yVal "400"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-1150-1-7 a chart:DataPoint ;
    chart:series ex:series-1150-1 ;
    chart:xVal "January 8, 2021" ;
    chart:yVal "590"^^xsd:decimal ;
    chart:valueEstimated "true" .
