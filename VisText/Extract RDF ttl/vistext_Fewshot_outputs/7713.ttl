@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-7713 a chart:Chart ;
    chart:chartType "line" ;
    chart:title "Distribution of U.S. biotech and non-biotech corn acreage from 2006 to 2019 , by type" ;
    chart:xAxis ex:x-7713 ;
    chart:yAxis ex:y-7713 .

ex:x-7713 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2006" ;
    chart:scaleMax "2018" .

ex:y-7713 a chart:Axis ;
    chart:label "Insect resistant" ;
    chart:scaleMin "0.00" ;
    chart:scaleMax "0.25" .

ex:series-7713-1 a chart:Series .

ex:dp-7713-1-1 a chart:DataPoint ;
    chart:series ex:series-7713-1 ;
    chart:xVal "2006" ;
    chart:yVal "0.25"^^xsd:decimal ;
    chart:valueEstimated "false" .

