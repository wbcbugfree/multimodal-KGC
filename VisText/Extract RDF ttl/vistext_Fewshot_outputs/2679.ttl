@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-2679 a chart:Chart ;
    chart:chartType "area" ;
    chart:title "Total opium poppy field area destroyed in Thailand from 1995 to 2013 (in hectares)" ;
    chart:xAxis ex:x-2679 ;
    chart:yAxis ex:y-2679 .

ex:x-2679 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "1995" ;
    chart:scaleMax "2013" .

ex:y-2679 a chart:Axis ;
    chart:label "Area in hectares" ;
    chart:scaleMin "0" ;
    chart:scaleMax "1000" .

ex:series-2679-1 a chart:Series .

ex:dp-2679-1-1 a chart:DataPoint ;
    chart:series ex:series-2679-1 ;
    chart:xVal "1995" ;
    chart:yVal "650"^^xsd:decimal ;
    chart:valueEstimated "true" .

