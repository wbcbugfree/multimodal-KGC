@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-5365 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Estimated gross domestic product (GDP) loss from removal of all illegal immigrant workers from the United States as of September 2016 , by industry (in billion U.S. dollars)" ;
    chart:xAxis ex:x-5365 ;
    chart:yAxis ex:y-5365 .

ex:x-5365 a chart:Axis ;
    chart:label "economic sector" .

ex:y-5365 a chart:Axis ;
    chart:label "GDP loss in billion U.S. dollars" ;
    chart:scaleMin "0" ;
    chart:scaleMax "80" .

ex:series-5365-1 a chart:Series .

ex:dp-5365-1-1 a chart:DataPoint ;
    chart:series ex:series-5365-1 ;
    chart:category "Agriculture, forestry, fishing, and related activities" ;
    chart:value "20"^^xsd:decimal ;
    chart:valueEstimated "true" .

