@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-7516 a chart:Chart ;
    chart:chartType "area" ;
    chart:title "Number of U.S. military and civil satellites\nsent into orbit or deep space from 1980 to\n2008" ;
    chart:xAxis ex:x-7516 ;
    chart:yAxis ex:y-7516 .

ex:x-7516 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "1980" ;
    chart:scaleMax "2008" .

ex:y-7516 a chart:Axis ;
    chart:label "Civil satellites" ;
    chart:scaleMin "0" ;
    chart:scaleMax "80" .

ex:series-7516-1 a chart:Series .

ex:dp-7516-1-1 a chart:DataPoint ;
    chart:series ex:series-7516-1 ;
    chart:xVal "1980" ;
    chart:yVal "8"^^xsd:decimal ;
    chart:valueEstimated "true" .

