@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-8173 a chart:Chart ;
    chart:chartType "area" ;
    chart:title "Breakdown of NASA 's budget and how it was distributed from 2010 to 2020 (in million U.S dollars)" ;
    chart:xAxis ex:x-8173 ;
    chart:yAxis ex:y-8173 .

ex:x-8173 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2010" ;
    chart:scaleMax "2020" .

ex:y-8173 a chart:Axis ;
    chart:label "Inspector General" ;
    chart:scaleMin "0" ;
    chart:scaleMax "40" .

ex:series-8173-1 a chart:Series .

ex:dp-8173-1-1 a chart:DataPoint ;
    chart:series ex:series-8173-1 ;
    chart:xVal "2010" ;
    chart:yVal "37"^^xsd:decimal ;
    chart:value "37"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-8173-1-2 a chart:DataPoint ;
    chart:series ex:series-8173-1 ;
    chart:xVal "2011" ;
    chart:yVal "37"^^xsd:decimal ;
    chart:value "37"^^xsd:decimal ;
    chart:valueEstimated "true" .

