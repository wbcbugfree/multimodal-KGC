@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-7898 a chart:Chart ;
    chart:chartType "area" ;
    chart:title "Average annual salaries for college faculty members in private institutions in the U.S. from 2005 to 2019 (in 1,000 U.S. dollars)" ;
    chart:xAxis ex:x-7898 ;
    chart:yAxis ex:y-7898 .

ex:x-7898 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2005" ;
    chart:scaleMax "2019" .

ex:y-7898 a chart:Axis ;
    chart:label "Professor" ;
    chart:scaleMin "0" ;
    chart:scaleMax "175" .

ex:series-7898-1 a chart:Series .

ex:dp-7898-1-1 a chart:DataPoint ;
    chart:series ex:series-7898-1 ;
    chart:xVal "2005" ;
    chart:yVal "105"^^xsd:decimal ;
    chart:value "105"^^xsd:decimal ;
    chart:valueEstimated "true" .

