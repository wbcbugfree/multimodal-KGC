ex:x-1088 a chart:Axis ;
    chart:label "Response" .

ex:y-1088 a chart:Axis ;
    chart:label "Share of respondents" ;
    chart:scaleMin "0.0" ;
    chart:scaleMax "0.4" .

ex:series-1088-1 a chart:Series .

