@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-99 a chart:Chart ;
    chart:chartType "area" ;
    chart:xAxis ex:x-99 ;
    chart:yAxis ex:y-99 .

ex:x-99 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2006" ;
    chart:scaleMax "2018" .

ex:y-99 a chart:Axis ;
    chart:label "Number of tribal casinos" ;
    chart:scaleMin "0" ;
    chart:scaleMax "500" .

ex:series-99-1 a chart:Series .

ex:dp-99-1-1 a chart:DataPoint ;
    chart:series ex:series-99-1 ;
    chart:xVal "2006" ;
    chart:yVal "400"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-99-1-2 a chart:DataPoint ;
    chart:series ex:series-99-1 ;
    chart:xVal "2007" ;
    chart:yVal "380"^^xsd:decimal ;
    chart:valueEstimated "true" .

