@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-64 a chart:Chart ;
    chart:chartType "area" ;
    chart:xAxis ex:x-64 ;
    chart:yAxis ex:y-64 .

ex:x-64 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2010" ;
    chart:scaleMax "2020" .

ex:y-64 a chart:Axis ;
    chart:label "Price in U.S. dollars per metric ton" ;
    chart:scaleMin "0" ;
    chart:scaleMax "200000" .

ex:series-64-1 a chart:Series .

ex:dp-64-1-1 a chart:DataPoint ;
    chart:series ex:series-64-1 ;
    chart:xVal "2010" ;
    chart:yVal "20000"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-64-1-2 a chart:DataPoint ;
    chart:series ex:series-64-1 ;
    chart:xVal "2011" ;
    chart:yVal "250000"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-64-1-3 a chart:DataPoint ;
    chart:series ex:series-64-1 ;
    chart:xVal "2012" ;
    chart:yVal "150000"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-64-1-4 a chart:DataPoint ;
    chart:series ex:series-64-1 ;
    chart:xVal "2013" ;
    chart:yVal "50000"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-64-1-5 a chart:DataPoint ;
    chart:series ex:series-64-1 ;
    chart:xVal "2014" ;
    chart:yVal "30000"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-64-1-6 a chart:DataPoint ;
    chart:series ex:series-64-1 ;
    chart:xVal "2015" ;
    chart:yVal "40000"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-64-1-7 a chart:DataPoint ;
    chart:series ex:series-64-1 ;
    chart:xVal "2016" ;
    chart:yVal "50000"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-64-1-8 a chart:DataPoint ;
    chart:series ex:series-64-1 ;
    chart:xVal "2017" ;
    chart:yVal "55000"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-64-1-9 a chart:DataPoint ;
    chart:series ex:series-64-1 ;
    chart:xVal "2018" ;
    chart:yVal "60000"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-64-1-10 a chart:DataPoint ;
    chart:series ex:series-64-1 ;
    chart:xVal "2019" ;
    chart:yVal "70000"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-64-1-11 a chart:DataPoint ;
    chart:series ex:series-64-1 ;
    chart:xVal "2020" ;
    chart:yVal "85000"^^xsd:decimal ;
    chart:valueEstimated "true" .
