@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-7283 a chart:Chart ;
    chart:chartType "area" ;
    chart:title "Number of Facebook fans/twitter followers of the Miami Dolphins (NFL) from 2012 to 2020 (in millions)" ;
    chart:xAxis ex:x-7283 ;
    chart:yAxis ex:y-7283 .

ex:x-7283 a chart:Axis ;
    chart:label "Month" ;
    chart:scaleMin "2012" ;
    chart:scaleMax "2020" .

ex:y-7283 a chart:Axis ;
    chart:label "Facebook fans" ;
    chart:scaleMin "0.0" ;
    chart:scaleMax "2.5" .

ex:series-7283-1 a chart:Series .

ex:dp-7283-1-1 a chart:DataPoint ;
    chart:series ex:series-7283-1 ;
    chart:xVal "2012" ;
    chart:yVal "1.25"^^xsd:decimal ;
    chart:value "1.25"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-7283-1-2 a chart:DataPoint ;
    chart:series ex:series-7283-1 ;
    chart:xVal "2013" ;
    chart:yVal "1.35"^^xsd:decimal ;
    chart:value "1.35"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-7283-1-3 a chart:DataPoint ;
    chart:series ex:series-7283-1 ;
    chart:xVal "2014" ;
    chart:yVal "1.45"^^xsd:decimal ;
    chart:value "1.45"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-7283-1-4 a chart:DataPoint ;
    chart:series ex:series-7283-1 ;
    chart:xVal "2015" ;
    chart:yVal "2.1"^^xsd:decimal ;
    chart:value "2.1"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-7283-1-5 a chart:DataPoint ;
    chart:series ex:series-7283-1 ;
    chart:xVal "2016" ;
    chart:yVal "2.05"^^xsd:decimal ;
    chart:value "2.05"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-7283-1-6 a chart:DataPoint ;
    chart:series ex:series-7283-1 ;
    chart:xVal "2017" ;
    chart:yVal "2.15"^^xsd:decimal ;
    chart:value "2.15"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-7283-1-7 a chart:DataPoint ;
    chart:series ex:series-7283-1 ;
    chart:xVal "2018" ;
    chart:yVal "2.2"^^xsd:decimal ;
    chart:value "2.2"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-7283-1-8 a chart:DataPoint ;
    chart:series ex:series-7283-1 ;
    chart:xVal "2019" ;
    chart:yVal "2.18"^^xsd:decimal ;
    chart:value "2.18"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-7283-1-9 a chart:DataPoint ;
    chart:series ex:series-7283-1 ;
    chart:xVal "2020" ;
    chart:yVal "2.25"^^xsd:decimal ;
    chart:value "2.25"^^xsd:decimal ;
    chart:valueEstimated "true" .
