@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-3019 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Weekend box office revenue of the leading 20 movies in France in August 2017 (in U.S. dollars)" ;
    chart:xAxis ex:x-3019 ;
    chart:yAxis ex:y-3019 .

ex:x-3019 a chart:Axis ;
    chart:label "Revenue in U.S. dollars" ;
    chart:scaleMin "0" ;
    chart:scaleMax "12000000" .

ex:y-3019 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "" ;
    chart:scaleMax "" .

ex:series-3019-1 a chart:Series .

ex:dp-3019-1-1 a chart:DataPoint ;
    chart:series ex:series-3019-1 ;
    chart:category "120 Beats Per Minute" ;
    chart:value "2000000"^^xsd:decimal ;
    chart:valueEstimated "true" .

