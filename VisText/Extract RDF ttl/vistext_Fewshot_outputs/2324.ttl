@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-2324 a chart:Chart ;
    chart:chartType "area" ;
    chart:title "Average annual expenditure on other laundry cleaning products per consumer unit in the United States from 2007 to 2019 (in U.S. dollars)" ;
    chart:xAxis ex:x-2324 ;
    chart:yAxis ex:y-2324 .

ex:x-2324 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2007" ;
    chart:scaleMax "2019" .

ex:y-2324 a chart:Axis ;
    chart:label "Average annual expenditure in U.S. dollars" ;
    chart:scaleMin "0" ;
    chart:scaleMax "100" .

ex:series-2324-1 a chart:Series .

ex:dp-2324-1-1 a chart:DataPoint ;
    chart:series ex:series-2324-1 ;
    chart:xVal "2007" ;
    chart:yVal "62"^^xsd:decimal ;
    chart:value "62"^^xsd:decimal ;
    chart:valueEstimated "true" .

