@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-3782 a chart:Chart ;
    chart:chartType "area" ;
    chart:title "U.S. electric capacity resources for the SERC region during the summer peak period between 1998 and 2010 (in megawatts)" ;
    chart:xAxis ex:x-3782 ;
    chart:yAxis ex:y-3782 .

ex:x-3782 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "1998" ;
    chart:scaleMax "2010" .

ex:y-3782 a chart:Axis ;
    chart:label "Capacity resources in megawatts" ;
    chart:scaleMin "0" ;
    chart:scaleMax "250,000" .

ex:series-3782-1 a chart:Series .

ex:dp-3782-1-1 a chart:DataPoint ;
    chart:series ex:series-3782-1 ;
    chart:xVal "1998" ;
    chart:yVal "125000"^^xsd:decimal ;
    chart:value "125000"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-3782-1-2 a chart:DataPoint ;
    chart:series ex:series-3782-1 ;
    chart:xVal "1999" ;
    chart:yVal "130000"^^xsd:decimal ;
    chart:value "130000"^^xsd:decimal ;
    chart:valueEstimated "true" .

