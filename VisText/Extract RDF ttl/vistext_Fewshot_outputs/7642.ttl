@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-7642 a chart:Chart ;
    chart:chartType "area" ;
    chart:title "Total population in Denmark from 2010 to 2020 , by age group (in millions)" ;
    chart:xAxis ex:x-7642 ;
    chart:yAxis ex:y-7642 .

ex:x-7642 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2010" ;
    chart:scaleMax "2020" .

ex:y-7642 a chart:Axis ;
    chart:label "80 years and older" ;
    chart:scaleMin "0.00" ;
    chart:scaleMax "0.25" .

ex:series-7642-1 a chart:Series .

ex:dp-7642-1-1 a chart:DataPoint ;
    chart:series ex:series-7642-1 ;
    chart:xVal "2010" ;
    chart:yVal "0.235"^^xsd:decimal ;
    chart:value "0.235"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-7642-1-2 a chart:DataPoint ;
    chart:series ex:series-7642-1 ;
    chart:xVal "2012" ;
    chart:yVal "0.238"^^xsd:decimal ;
    chart:value "0.238"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-7642-1-3 a chart:DataPoint ;
    chart:series ex:series-7642-1 ;
    chart:xVal "2014" ;
    chart:yVal "0.242"^^xsd:decimal ;
    chart:value "0.242"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-7642-1-4 a chart:DataPoint ;
    chart:series ex:series-7642-1 ;
    chart:xVal "2016" ;
    chart:yVal "0.245"^^xsd:decimal ;
    chart:value "0.245"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-7642-1-5 a chart:DataPoint ;
    chart:series ex:series-7642-1 ;
    chart:xVal "2018" ;
    chart:yVal "0.250"^^xsd:decimal ;
    chart:value "0.250"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-7642-1-6 a chart:DataPoint ;
    chart:series ex:series-7642-1 ;
    chart:xVal "2020" ;
    chart:yVal "0.255"^^xsd:decimal ;
    chart:value "0.255"^^xsd:decimal ;
    chart:valueEstimated "true" .
