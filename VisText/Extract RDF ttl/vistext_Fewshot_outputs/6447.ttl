@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-6447 a chart:Chart ;
    chart:chartType "area" ;
    chart:title "Marital status of the adult population in England and Wales from 2002 to 2019" ;
    chart:xAxis ex:x-6447 ;
    chart:yAxis ex:y-6447 .

ex:x-6447 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2002" ;
    chart:scaleMax "2019" .

ex:y-6447 a chart:Axis ;
    chart:label "Married" ;
    chart:scaleMin "0" ;
    chart:scaleMax "20000000" .

ex:series-6447-1 a chart:Series .

ex:dp-6447-1-1 a chart:DataPoint ;
    chart:series ex:series-6447-1 ;
    chart:xVal "2002" ;
    chart:yVal "18000000"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-6447-1-2 a chart:DataPoint ;
    chart:series ex:series-6447-1 ;
    chart:xVal "2005" ;
    chart:yVal "18500000"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-6447-1-3 a chart:DataPoint ;
    chart:series ex:series-6447-1 ;
    chart:xVal "2010" ;
    chart:yVal "19000000"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-6447-1-4 a chart:DataPoint ;
    chart:series ex:series-6447-1 ;
    chart:xVal "2015" ;
    chart:yVal "19500000"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-6447-1-5 a chart:DataPoint ;
    chart:series ex:series-6447-1 ;
    chart:xVal "2019" ;
    chart:yVal "20000000"^^xsd:decimal ;
    chart:valueEstimated "true" .
