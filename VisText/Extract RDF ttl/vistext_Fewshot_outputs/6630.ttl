@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-6630 a chart:Chart ;
    chart:chartType "line" ;
    chart:title "Median hourly earnings for full-time employees in the United Kingdom from 2004 to 2020 , by age group (in GBP)" ;
    chart:xAxis ex:x-6630 ;
    chart:yAxis ex:y-6630 .

ex:x-6630 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2004" ;
    chart:scaleMax "2020" .

ex:y-6630 a chart:Axis ;
    chart:label "22 to 29" ;
    chart:scaleMin "0" ;
    chart:scaleMax "12" .

ex:series-6630-1 a chart:Series .

ex:dp-6630-1-1 a chart:DataPoint ;
    chart:series ex:series-6630-1 ;
    chart:xVal "2004" ;
    chart:yVal "8.5"^^xsd:decimal ;
    chart:value "8.5"^^xsd:decimal ;
    chart:valueEstimated "true" .

