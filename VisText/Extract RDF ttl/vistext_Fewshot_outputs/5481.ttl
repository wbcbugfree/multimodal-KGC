@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-5481 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Oldest living Academy Award winners as of July 2020" ;
    chart:xAxis ex:x-5481 ;
    chart:yAxis ex:y-5481 .

ex:x-5481 a chart:Axis ;
    chart:label "Academy Award winners" .

ex:y-5481 a chart:Axis ;
    chart:label "Age" ;
    chart:scaleMin "0" ;
    chart:scaleMax "100" .

ex:series-5481-1 a chart:Series .

ex:mark-5481-1-1 a chart:DataPoint ;
    chart:series ex:series-5481-1 ;
    chart:category "Alan Bergman" ;
    chart:value "95"^^xsd:decimal ;
    chart:valueEstimated "true" .

