@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-2466 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Top ten dark money spenders in the 2016 U.S. election cycle as of August 2016" ;
    chart:xAxis ex:x-2466 ;
    chart:yAxis ex:y-2466 .

ex:x-2466 a chart:Axis ;
    chart:label "Money spent in U.S. dollars" ;
    chart:scaleMin "0" ;
    chart:scaleMax "20000000" .

ex:y-2466 a chart:Axis ;
    chart:label "dark money spenders" .

ex:series-2466-1 a chart:Series .

ex:dp-2466-1-1 a chart:DataPoint ;
    chart:series ex:series-2466-1 ;
    chart:category "American Future Fund" ;
    chart:value "12000000"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-2466-1-2 a chart:DataPoint ;
    chart:series ex:series-2466-1 ;
    chart:category "Americans for Prosperity" ;
    chart:value "2000000"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-2466-1-3 a chart:DataPoint ;
    chart:series ex:series-2466-1 ;
    chart:category "Club for Growth" ;
    chart:value "4000000"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-2466-1-4 a chart:DataPoint ;
    chart:series ex:series-2466-1 ;
    chart:category "Ending Spending" ;
    chart:value "1000000"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-2466-1-5 a chart:DataPoint ;
    chart:series ex:series-2466-1 ;
    chart:category "Environmental Defense Action Fund" ;
    chart:value "1000000"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-2466-1-6 a chart:DataPoint ;
    chart:series ex:series-2466-1 ;
    chart:category "League of Conservation Voters" ;
    chart:value "3000000"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-2466-1-7 a chart:DataPoint ;
    chart:series ex:series-2466-1 ;
    chart:category "Majority Forward" ;
    chart:value "4000000"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-2466-1-8 a chart:DataPoint ;
    chart:series ex:series-2466-1 ;
    chart:category "Planned Parenthood Action Fund" ;
    chart:value "1000000"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-2466-1-9 a chart:DataPoint ;
    chart:series ex:series-2466-1 ;
    chart:category "US Chamber of Commerce" ;
    chart:value "18000000"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-2466-1-10 a chart:DataPoint ;
