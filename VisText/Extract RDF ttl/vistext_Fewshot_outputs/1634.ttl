@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-1634 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Apprehensions by the U.S. border patrol for fiscal year 2019 , sorted by sector" ;
    chart:xAxis ex:x-1634 ;
    chart:yAxis ex:y-1634 .

ex:x-1634 a chart:Axis ;
    chart:label "city of the United States" .

ex:y-1634 a chart:Axis ;
    chart:label "Number of apprehensions" ;
    chart:scaleMin "0" ;
    chart:scaleMax "800000" .

ex:series-1634-1 a chart:Series .

ex:dp-1634-1-1 a chart:DataPoint ;
    chart:series ex:series-1634-1 ;
    chart:category "Big Bend, formerly Marfa" ;
    chart:value "10000"^^xsd:decimal ;
    chart:valueEstimated "true" .

