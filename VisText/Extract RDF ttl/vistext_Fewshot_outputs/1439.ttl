@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-1439 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Apparent steel consumption per capita in Mexico from 2003 to 2018 (in kilograms of finished steel products)" ;
    chart:xAxis ex:x-1439 ;
    chart:yAxis ex:y-1439 .

ex:x-1439 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2003" ;
    chart:scaleMax "2018" .

ex:y-1439 a chart:Axis ;
    chart:label "Per capita use in kilograms" ;
    chart:scaleMin "0" ;
    chart:scaleMax "200" .

ex:series-1439-1 a chart:Series .

ex:dp-1439-1-1 a chart:DataPoint ;
    chart:series ex:series-1439-1 ;
    chart:category "2003" ;
    chart:value "145"^^xsd:decimal ;
    chart:valueEstimated "true" .

