@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-7187 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Distribution of Florida Power and Light 's operating revenue from FY 2007 to FY 2019 , by customer class" ;
    chart:xAxis ex:x-7187 ;
    chart:yAxis ex:y-7187 .

ex:x-7187 a chart:Axis ;
    chart:label "Other*" ;
    chart:scaleMin "0.00" ;
    chart:scaleMax "0.08" .

ex:y-7187 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "" ;
    chart:scaleMax "" .

ex:series-7187-1 a chart:Series .

ex:dp-7187-1-1 a chart:DataPoint ;
