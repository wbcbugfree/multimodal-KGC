@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-1415 a chart:Chart ;
    chart:chartType "line" ;
    chart:title "Number of deaths in the United Kingdom (UK) from 2000 to 2018 (in 1,000s)" ;
    chart:xAxis ex:x-1415 ;
    chart:yAxis ex:y-1415 .

ex:x-1415 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2000" ;
    chart:scaleMax "2018" .

ex:y-1415 a chart:Axis ;
    chart:label "Number of deaths (in 1,000s)" ;
    chart:scaleMin "0" ;
    chart:scaleMax "600" .

ex:series-1415-1 a chart:Series .

ex:dp-1415-1-1 a chart:DataPoint ;
    chart:series ex:series-1415-1 ;
    chart:xVal "2000" ;
    chart:yVal "620"^^xsd:decimal ;
    chart:valueEstimated "true" .

