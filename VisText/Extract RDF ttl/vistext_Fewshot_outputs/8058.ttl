    chart:series ex:series-8058-1 ;
    chart:category "Dao Dao" ;
    chart:value "0.08"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-8058-1-5 a chart:DataPoint ;
    chart:series ex:series-8058-1 ;
    chart:category "Dian Ping" ;
    chart:value "0.02"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-8058-1-6 a chart:DataPoint ;
    chart:series ex:series-8058-1 ;
    chart:category "Other" ;
    chart:value "0.16"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-8058-1-7 a chart:DataPoint ;
    chart:series ex:series-8058-1 ;
    chart:category "Qunar" ;
    chart:value "0.03"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-8058-1-8 a chart:DataPoint ;
