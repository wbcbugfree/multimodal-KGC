@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-8058 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Most popular luxury hotel review sites worldwide as of April 2014 , by region" ;
    chart:xAxis ex:x-8058 ;
    chart:yAxis ex:y-8058 .

ex:x-8058 a chart:Axis ;
    chart:label "Response" .

ex:y-8058 a chart:Axis ;
    chart:label "Global" ;
    chart:scaleMin "0.0" ;
    chart:scaleMax "0.4" .

ex:series-8058-1 a chart:Series .

ex:dp-8058-1-1 a chart:DataPoint ;
    chart:series ex:series-8058-1 ;
    chart:category "Agoda" ;
    chart:value "0.02"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-8058-1-2 a chart:DataPoint ;
    chart:series ex:series-8058-1 ;
    chart:category "Booking.com" ;
    chart:value "0.06"^^xsd:decimal ;
    chart:valueEstimated "true" .

