@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-6835 a chart:Chart ;
    chart:chartType "area" ;
    chart:title "Population in Sweden from 2009 to 2019 , by age group (in 1,000s)" ;
    chart:xAxis ex:x-6835 ;
    chart:yAxis ex:y-6835 .

ex:x-6835 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2009" ;
    chart:scaleMax "2019" .

ex:y-6835 a chart:Axis ;
    chart:label "85-94 years" ;
    chart:scaleMin "0" ;
    chart:scaleMax "250" .

ex:series-6835-1 a chart:Series .

ex:dp-6835-1-1 a chart:DataPoint ;
    chart:series ex:series-6835-1 ;
    chart:xVal "2009" ;
    chart:yVal "225"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-6835-1-2 a chart:DataPoint ;
    chart:series ex:series-6835-1 ;
    chart:xVal "2010" ;
    chart:yVal "227"^^xsd:decimal ;
    chart:valueEstimated "true" .

