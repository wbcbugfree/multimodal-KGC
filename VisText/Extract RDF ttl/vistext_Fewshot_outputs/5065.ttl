@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-5065 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Argentina : Ratio of government expenditure to gross domestic product (GDP) from 2014 to 2024" ;
    chart:xAxis ex:x-5065 ;
    chart:yAxis ex:y-5065 .

ex:x-5065 a chart:Axis ;
    chart:label "Ratio of government expenditure to GDP" ;
    chart:scaleMin "0.0" ;
    chart:scaleMax "0.4" .

ex:y-5065 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "" ;
    chart:scaleMax "" .

ex:series-5065-1 a chart:Series .

ex:dp-5065-1-1 a chart:DataPoint ;
    chart:series ex:series-5065-1 ;
    chart:category "2014" ;
    chart:value "0.38"^^xsd:decimal ;
    chart:valueEstimated "true" .

