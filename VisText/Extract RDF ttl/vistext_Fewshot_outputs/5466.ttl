@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-5466 a chart:Chart ;
    chart:chartType "bar" ;
    chart:xAxis ex:x-5466 ;
    chart:yAxis ex:y-5466 .

ex:x-5466 a chart:Axis ;
    chart:label "Quarter" ;
    chart:scaleMin "" ;
    chart:scaleMax "" .

ex:y-5466 a chart:Axis ;
    chart:label "Users in millions" ;
    chart:scaleMin "0" ;
    chart:scaleMax "40" .

ex:series-5466-1 a chart:Series .

ex:dp-5466-1-1 a chart:DataPoint ;
    chart:series ex:series-5466-1 ;
    chart:category "Q1 2014" ;
    chart:value "32"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-5466-1-2 a chart:DataPoint ;
    chart:series ex:series-5466-1 ;
    chart:category "Q1 2015" ;
    chart:value "38"^^xsd:decimal ;
