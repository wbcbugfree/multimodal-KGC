@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-6024 a chart:Chart ;
    chart:chartType "line" ;
    chart:xAxis ex:x-6024 ;
    chart:yAxis ex:y-6024 .

ex:x-6024 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "1930" ;
    chart:scaleMax "2020" .

ex:y-6024 a chart:Axis ;
    chart:label "Real GDP**" ;
    chart:scaleMin "0" ;
    chart:scaleMax "20000" .

ex:series-6024-1 a chart:Series .

ex:dp-6024-1-1 a chart:DataPoint ;
    chart:series ex:series-6024-1 ;
    chart:xVal "1935" ;
    chart:yVal "1000"^^xsd:decimal ;
    chart:valueEstimated "true" .

