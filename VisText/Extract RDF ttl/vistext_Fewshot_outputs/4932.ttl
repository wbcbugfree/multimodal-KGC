@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-4932 a chart:Chart ;
    chart:chartType "bar" ;
    chart:xAxis ex:x-4932 ;
    chart:yAxis ex:y-4932 .

ex:x-4932 a chart:Axis ;
    chart:label "Number of vehicles in millions" ;
    chart:scaleMin "0" ;
    chart:scaleMax "10" .

ex:y-4932 a chart:Axis ;
    chart:label "year" .

ex:series-4932-1 a chart:Series .

ex:dp-4932-1-1 a chart:DataPoint ;
    chart:series ex:series-4932-1 ;
    chart:category "FY 2007" ;
    chart:value "3.5"^^xsd:decimal ;
    chart:valueEstimated "true" .

