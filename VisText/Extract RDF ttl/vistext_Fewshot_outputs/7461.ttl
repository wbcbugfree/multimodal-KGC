@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-7461 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Distribution of individuals who made online purchases in Luxembourg from 2009 to 2019" ;
    chart:xAxis ex:x-7461 ;
    chart:yAxis ex:y-7461 .

ex:x-7461 a chart:Axis ;
    chart:label "More than a year ago" ;
    chart:scaleMin "0.00" ;
    chart:scaleMax "0.15" .

ex:y-7461 a chart:Axis ;
    chart:label "Within the first trimester of the reference year" ;
    chart:scaleMin "" ;
    chart:scaleMax "" .

ex:series-7461-1 a chart:Series .

ex:dp-7461-1-1 a chart:DataPoint ;
    chart:series ex:series-7461-1 ;
    chart:category "0.51" ;
    chart:value "0.04"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-7461-1-2 a chart:DataPoint ;
    chart:series ex:series-7461-1 ;
    chart:category "0.52" ;
    chart:value "0.06"^^xsd:decimal ;
    chart:valueEstimated "true" .

