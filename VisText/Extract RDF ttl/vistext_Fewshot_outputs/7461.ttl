    chart:series ex:series-7461-1 ;
    chart:category "0.61" ;
    chart:value "0.05"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-7461-1-5 a chart:DataPoint ;
    chart:series ex:series-7461-1 ;
    chart:category "0.62" ;
    chart:value "0.12"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-7461-1-6 a chart:DataPoint ;
    chart:series ex:series-7461-1 ;
