@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-6971 a chart:Chart ;
    chart:chartType "line" ;
    chart:title "El Salvador : Distribution of employment by economic sector from 2010 to 2020" ;
    chart:xAxis ex:x-6971 ;
    chart:yAxis ex:y-6971 .

ex:x-6971 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2010" ;
    chart:scaleMax "2020" .

ex:y-6971 a chart:Axis ;
    chart:label "Industry" ;
    chart:scaleMin "0.00" ;
    chart:scaleMax "0.25" .

ex:series-6971-1 a chart:Series .

ex:dp-6971-1-1 a chart:DataPoint ;
    chart:series ex:series-6971-1 ;
    chart:xVal "2010" ;
    chart:yVal "0.205"^^xsd:decimal ;
    chart:value "0.205"^^xsd:decimal ;
    chart:valueEstimated "true" .

