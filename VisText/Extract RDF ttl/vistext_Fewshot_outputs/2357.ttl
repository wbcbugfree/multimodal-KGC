@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-2357 a chart:Chart ;
    chart:chartType "line" ;
    chart:title "Djibouti : Infant mortality rate from 2009 to 2019 (in deaths per 1,000 live births)" ;
    chart:xAxis ex:x-2357 ;
    chart:yAxis ex:y-2357 .

ex:x-2357 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2009" ;
    chart:scaleMax "2019" .

ex:y-2357 a chart:Axis ;
    chart:label "Deaths per 1,000 live births" ;
    chart:scaleMin "0" ;
    chart:scaleMax "60" .

ex:series-2357-1 a chart:Series .

ex:dp-2357-1-1 a chart:DataPoint ;
    chart:series ex:series-2357-1 ;
    chart:xVal "2009" ;
    chart:yVal "63"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-2357-1-2 a chart:DataPoint ;
    chart:series ex:series-2357-1 ;
    chart:xVal "2010" ;
    chart:yVal "62"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-2357-1-3 a chart:DataPoint ;
    chart:series ex:series-2357-1 ;
    chart:xVal "2011" ;
    chart:yVal "61"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-2357-1-4 a chart:DataPoint ;
    chart:series ex:series-2357-1 ;
    chart:xVal "2012" ;
    chart:yVal "60"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-2357-1-5 a chart:DataPoint ;
    chart:series ex:series-2357-1 ;
    chart:xVal "2013" ;
    chart:yVal "59"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-2357-1-6 a chart:DataPoint ;
    chart:series ex:series-2357-1 ;
    chart:xVal "2014" ;
    chart:yVal "58"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-2357-1-7 a chart:DataPoint ;
    chart:series ex:series-2357-1 ;
    chart:xVal "2015" ;
    chart:yVal "57"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-2357-1-8 a chart:DataPoint ;
    chart:series ex:series-2357-1 ;
    chart:xVal "2016" ;
    chart:yVal "56"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-2357-1-9 a chart:DataPoint ;
    chart:series ex:series-2357-1 ;
    chart:xVal "2017" ;
    chart:yVal "55"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-2357-1-10 a chart:DataPoint ;
    chart:series ex:series-2357-1 ;
    chart:xVal "2018" ;
    chart:yVal "53"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-2357-1-11 a chart:DataPoint ;
    chart:series ex:series-2357-1 ;
    chart:xVal "2019" ;
    chart:yVal "51"^^xsd:decimal ;
    chart:valueEstimated "true" .
