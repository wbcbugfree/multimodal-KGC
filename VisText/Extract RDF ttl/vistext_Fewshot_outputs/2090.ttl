@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-2090 a chart:Chart ;
    chart:chartType "area" ;
    chart:title "Number of drug-related deaths due to benzodiazepine use in England and Wales from 1993 to 2019" ;
    chart:xAxis ex:x-2090 ;
    chart:yAxis ex:y-2090 .

ex:x-2090 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "1993" ;
    chart:scaleMax "2019" .

ex:y-2090 a chart:Axis ;
    chart:label "Number of deaths" ;
    chart:scaleMin "0" ;
    chart:scaleMax "400" .

ex:series-2090-1 a chart:Series .

ex:dp-2090-1-1 a chart:DataPoint ;
    chart:series ex:series-2090-1 ;
    chart:xVal "1993" ;
    chart:yVal "275"^^xsd:decimal ;
    chart:valueEstimated "true" .

