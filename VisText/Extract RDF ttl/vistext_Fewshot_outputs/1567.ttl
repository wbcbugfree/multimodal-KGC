@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-1567 a chart:Chart ;
    chart:chartType "area" ;
    chart:title "Number of Toyota cars sold in France from 2009 to 2018" ;
    chart:xAxis ex:x-1567 ;
    chart:yAxis ex:y-1567 .

ex:x-1567 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2009" ;
    chart:scaleMax "2018" .

ex:y-1567 a chart:Axis ;
    chart:label "Units sold" ;
    chart:scaleMin "0" ;
    chart:scaleMax "100000" .

ex:series-1567-1 a chart:Series .

ex:dp-1567-1-1 a chart:DataPoint ;
    chart:series ex:series-1567-1 ;
    chart:xVal "2009" ;
    chart:yVal "88000"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-1567-1-2 a chart:DataPoint ;
    chart:series ex:series-1567-1 ;
    chart:xVal "2010" ;
    chart:yVal "65000"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-1567-1-3 a chart:DataPoint ;
    chart:series ex:series-1567-1 ;
    chart:xVal "2011" ;
    chart:yVal "68000"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-1567-1-4 a chart:DataPoint ;
    chart:series ex:series-1567-1 ;
    chart:xVal "2012" ;
    chart:yVal "70000"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-1567-1-5 a chart:DataPoint ;
    chart:series ex:series-1567-1 ;
    chart:xVal "2013" ;
    chart:yVal "73000"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-1567-1-6 a chart:DataPoint ;
    chart:series ex:series-1567-1 ;
    chart:xVal "2014" ;
    chart:yVal "67000"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-1567-1-7 a chart:DataPoint ;
    chart:series ex:series-1567-1 ;
    chart:xVal "2015" ;
    chart:yVal "76000"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-1567-1-8 a chart:DataPoint ;
    chart:series ex:series-1567-1 ;
    chart:xVal "2016" ;
    chart:yVal "80000"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-1567-1-9 a chart:DataPoint ;
    chart:series ex:series-1567-1 ;
    chart:xVal "2017" ;
    chart:yVal "90000"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-1567-1-10 a chart:DataPoint ;
    chart:series ex:series-1567-1 ;
    chart:xVal "2018" ;
    chart:yVal "98000"^^xsd:decimal ;
    chart:valueEstimated "true" .
