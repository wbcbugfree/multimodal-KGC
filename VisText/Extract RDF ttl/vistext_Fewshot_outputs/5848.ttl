@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-5848 a chart:Chart ;
    chart:chartType "area" ;
    chart:title "Number of employees at Intel from 2004 to 2019 (in 1,000s)" ;
    chart:xAxis ex:x-5848 ;
    chart:yAxis ex:y-5848 .

ex:x-5848 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2004" ;
    chart:scaleMax "2019" .

ex:y-5848 a chart:Axis ;
    chart:label "Number of employees in thousands" ;
    chart:scaleMin "0" ;
    chart:scaleMax "120" .

ex:series-5848-1 a chart:Series .

ex:dp-5848-1-1 a chart:DataPoint ;
    chart:series ex:series-5848-1 ;
    chart:xVal "2004" ;
    chart:yVal "85"^^xsd:decimal ;
    chart:value "85"^^xsd:decimal ;
    chart:valueEstimated "true" .

