@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-1350 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "How did you hear about the Summer X Games ?" ;
    chart:xAxis ex:x-1350 ;
    chart:yAxis ex:y-1350 .

ex:x-1350 a chart:Axis ;
    chart:label "Share of respondents" ;
    chart:scaleMin "0.0" ;
    chart:scaleMax "0.5" .

ex:y-1350 a chart:Axis ;
    chart:label "" .

ex:series-1350-1 a chart:Series .

ex:dp-1350-1-1 a chart:DataPoint ;
    chart:series ex:series-1350-1 ;
    chart:category "Xgames.com or ESPN.com/action" ;
    chart:value "0.32"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-1350-1-2 a chart:DataPoint ;
    chart:series ex:series-1350-1 ;
    chart:category "Word of mouth" ;
    chart:value "0.39"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-1350-1-3 a chart:DataPoint ;
    chart:series ex:series-1350-1 ;
    chart:category "Sponsor promotions" ;
    chart:value "0.08"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-1350-1-4 a chart:DataPoint ;
    chart:series ex:series-1350-1 ;
    chart:category "Other national radio" ;
    chart:value "0.12"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-1350-1-5 a chart:DataPoint ;
    chart:series ex:series-1350-1 ;
    chart:category "National print ads" ;
    chart:value "0.28"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-1350-1-6 a chart:DataPoint ;
    chart:series ex:series-1350-1 ;
    chart:category "National radio or print)" ;
    chart:value "0.22"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-1350-1-7 a chart:DataPoint ;
    chart:series ex:series-1350-1 ;
    chart:category "Internet" ;
    chart:value "0.35"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-1350-1-8 a chart:DataPoint ;
    chart:series ex:series-1350-1 ;
    chart:category "ESPN 2" ;
    chart:value "0.40"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-1350-1-9 a chart:DataPoint ;
    chart:series ex:series-1350-1 ;
    chart:category "ESPN" ;
    chart:value "0.02"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-1350-1-10 a chart:DataPoint ;
    chart:series ex:series-1350-1 ;
    chart:category "Local media (TV, radio or print)" ;
    chart:value "0.005"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-1350-1-11 a char:DataPoint ;
