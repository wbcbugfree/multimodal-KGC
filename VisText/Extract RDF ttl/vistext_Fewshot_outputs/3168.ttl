@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-3168 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Factor weighted gender pay gap in selected countries in Latin America and the Caribbean in 2016" ;
    chart:xAxis ex:x-3168 ;
    chart:yAxis ex:y-3168 .

ex:x-3168 a chart:Axis ;
    chart:label "Gender pay gap" ;
    chart:scaleMin "0.00" ;
    chart:scaleMax "0.25" .

ex:y-3168 a chart:Axis ;
    chart:label "Country" ;
    chart:scaleMin "" ;
    chart:scaleMax "" .

ex:series-3168-1 a chart:Series .

ex:dp-3168-1-1 a chart:DataPoint ;
    chart:series ex:series-3168-1 ;
    chart:category "Argentina" ;
    chart:value "0.04"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-3168-1-2 a chart:DataPoint ;
    chart:series ex:series-3168-1 ;
    chart:category "Brazil" ;
    chart:value "0.24"^^xsd:decimal ;
    chart:valueEstimated "true" .

