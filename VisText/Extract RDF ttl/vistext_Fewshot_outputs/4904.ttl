@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-4904 a chart:Chart ;
    chart:chartType "area" ;
    chart:title "Number of daily confirmed cases of the novel coronavirus infection COVID-19 in Malaysia as of January 6 , 2021" ;
    chart:xAxis ex:x-4904 ;
    chart:yAxis ex:y-4904 .

ex:x-4904 a chart:Axis ;
    chart:label "Month" ;
    chart:scaleMin "2005" ;
    chart:scaleMax "2020" .

ex:y-4904 a chart:Axis ;
    chart:label "Number of cases" ;
    chart:scaleMin "0" ;
    chart:scaleMax "2500" .

ex:series-4904-1 a chart:Series .

ex:dp-4904-1-1 a chart:DataPoint ;
    chart:series ex:series-4904-1 ;
    chart:xVal "2005" ;
    chart:yVal "50"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-4904-1-2 a chart:DataPoint ;
    chart:series ex:series-4904-1 ;
    chart:xVal "2010" ;
    chart:yVal "100"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-4904-1-3 a chart:DataPoint ;
    chart:series ex:series-4904-1 ;
    chart:xVal "2015" ;
    chart:yVal "200"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-4904-1-4 a chart:DataPoint ;
    chart:series ex:series-4904-1 ;
    chart:xVal "2020" ;
    chart:yVal "2400"^^xsd:decimal ;
    chart:valueEstimated "true" .
