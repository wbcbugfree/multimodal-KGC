@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-7037 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Do you use a smartphone for any of the following ?" ;
    chart:xAxis ex:x-7037 ;
    chart:yAxis ex:y-7037 .

ex:x-7037 a chart:Axis ;
    chart:label "Activities" ;
    chart:scaleMin "0.0" ;
    chart:scaleMax "0.8" .

ex:y-7037 a chart:Axis ;
    chart:label "" ;
    chart:scaleMin "" ;
    chart:scaleMax "" .

ex:series-7037-1 a chart:Series .

ex:dp-7037-1-1 a chart:DataPoint ;
    chart:series ex:series-7037-1 ;
    chart:category "Browsing online" ;
    chart:value "0.48"^^xsd:decimal ;
    chart:valueEstimated "true" .

