    chart:series ex:series-4786-1 ;
    chart:category "2008/09" ;
    chart:value "42"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-4786-1-4 a chart:DataPoint ;
    chart:series ex:series-4786-1 ;
    chart:category "2009/10" ;
    chart:value "38"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-4786-1-5 a chart:DataPoint ;
    chart:series ex:series-4786-1 ;
    chart:category "2010/11" ;
    chart:value "34"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-4786-1-6 a chart:DataPoint ;
    chart:series ex:series-4786-1 ;
    chart:category "2011/12" ;
    chart:value "32"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-4786-1-7 a chart:DataPoint ;
    chart:series ex:series-4786-1 ;
    chart:category "2012/13*" ;
    chart:value "52"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-4786-1-8 a chart:DataPoint ;
    chart:series ex:series-4786-1 ;
    chart:category "2013/14" ;
    chart:value "58"^^xsd:decimal ;
