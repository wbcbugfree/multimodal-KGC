@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-4786 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Average ticket price Brooklyn Nets games of the NBA from 2006/07 to 2015/16 (in U.S. dollars)" ;
    chart:xAxis ex:x-4786 ;
    chart:yAxis ex:y-4786 .

ex:x-4786 a chart:Axis ;
    chart:label "Average ticket price in U.S. dollars" ;
    chart:scaleMin "0" ;
    chart:scaleMax "70" .

ex:y-4786 a chart:Axis ;
    chart:label "Year" .

ex:series-4786-1 a chart:Series .

ex:dp-4786-1-1 a chart:DataPoint ;
    chart:series ex:series-4786-1 ;
    chart:category "2006/07" ;
    chart:value "65"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-4786-1-2 a chart:DataPoint ;
    chart:series ex:series-4786-1 ;
    chart:category "2007/08" ;
    chart:value "53"^^xsd:decimal ;
    chart:valueEstimated "true" .

