@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-7497 a chart:Chart ;
    chart:chartType "bar" ;
    chart:xAxis ex:x-7497 ;
    chart:yAxis ex:y-7497 .

ex:x-7497 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2008" ;
    chart:scaleMax "2016" .

ex:y-7497 a chart:Axis ;
    chart:label "Total" ;
    chart:scaleMin "0" ;
    chart:scaleMax "300" .

ex:series-7497-1 a chart:Series .

ex:dp-7497-1-1 a chart:DataPoint ;
    chart:series ex:series-7497-1 ;
    chart:category "2008" ;
    chart:value "280"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-7497-1-2 a chart:DataPoint ;
    chart:series ex:series-7497-1 ;
    chart:category "2012" ;
    chart:value "290"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-7497-1-3 a chart:DataPoint ;
    chart:series ex:series-7497-1 ;
    chart:category "2016" ;
    chart:value "300"^^xsd:decimal ;
    chart:valueEstimated "true" .
