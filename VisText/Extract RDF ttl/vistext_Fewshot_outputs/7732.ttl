@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-7732 a chart:Chart ;
    chart:chartType "area" ;
    chart:title "U.S. war costs in Iraq and Afghanistan from 2003 to 2015 (in billion U.S. dollars)" ;
    chart:xAxis ex:x-7732 ;
    chart:yAxis ex:y-7732 .

ex:x-7732 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2004" ;
    chart:scaleMax "2014" .

ex:y-7732 a chart:Axis ;
    chart:label "" ;
    chart:scaleMin "0" ;
    chart:scaleMax "150" .

ex:series-7732-1 a chart:Series .

ex:dp-7732-1-1 a chart:DataPoint ;
    chart:series ex:series-7732-1 ;
    chart:xVal "2004" ;
    chart:yVal "60"^^xsd:decimal ;
    chart:value "60"^^xsd:decimal ;
    chart:valueEstimated "true" .

