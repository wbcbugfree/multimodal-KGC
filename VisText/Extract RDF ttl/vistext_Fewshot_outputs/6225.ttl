@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-6225 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Average price of diesel fuel in France between January 2013 and December 2018 (in euros per liter)" ;
    chart:xAxis ex:x-6225 ;
    chart:yAxis ex:y-6225 .

ex:x-6225 a chart:Axis ;
    chart:label "2016" ;
    chart:scaleMin "0.0" ;
    chart:scaleMax "1.2" .

ex:y-6225 a chart:Axis ;
    chart:label "Month" ;
    chart:scaleMin "" ;
    chart:scaleMax "" .

ex:series-6225-1 a chart:Series .

ex:dp-6225-1-1 a chart:DataPoint ;
    chart:series ex:series-6225-1 ;
    chart:category "Apr" ;
    chart:value "1.18"^^xsd:decimal ;
    chart:valueEstimated "true" .

