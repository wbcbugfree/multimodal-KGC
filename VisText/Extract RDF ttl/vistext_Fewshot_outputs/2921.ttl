@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-2921 a chart:Chart ;
    chart:chartType "line" ;
    chart:title "Number of employees of toy manufacturer Ravensburger worldwide from 2004 to 2018 (in 1,000s)" ;
    chart:xAxis ex:x-2921 ;
    chart:yAxis ex:y-2921 .

ex:x-2921 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2004" ;
    chart:scaleMax "2018" .

ex:y-2921 a chart:Axis ;
    chart:label "Number of employees in thousands" ;
    chart:scaleMin "0" ;
    chart:scaleMax "2000" .

ex:series-2921-1 a chart:Series .

ex:dp-2921-1-1 a chart:DataPoint ;
    chart:series ex:series-2921-1 ;
    chart:xVal "2004" ;
    chart:yVal "1450"^^xsd:decimal ;
    chart:value "1450"^^xsd:decimal ;
    chart:valueEstimated "true" .

