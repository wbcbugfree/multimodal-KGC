@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-5523 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Number of people affected by the world 's major volcanic eruptions from 1900 to 2016" ;
    chart:xAxis ex:x-5523 ;
    chart:yAxis ex:y-5523 .

ex:x-5523 a chart:Axis ;
    chart:label "volcanic eruption and date" ;
    chart:scaleMin "" ;
    chart:scaleMax "" .

ex:y-5523 a chart:Axis ;
    chart:label "Number of victims" ;
    chart:scaleMin "0" ;
    chart:scaleMax "1000000" .

ex:series-5523-1 a chart:Series .

ex:dp-5523-1-1 a chart:DataPoint ;
    chart:series ex:series-5523-1 ;
    chart:category "Volcanic eruption in Comoros..." ;
    chart:value "230000"^^xsd:decimal ;
    chart:valueEstimated "true" .

