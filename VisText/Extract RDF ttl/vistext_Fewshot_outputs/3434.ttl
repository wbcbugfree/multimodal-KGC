    chart:category "June" ;
    chart:value "240"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-3434-1-8 a chart:DataPoint ;
    chart:series ex:series-3434-1 ;
    chart:category "March" ;
    chart:value "190"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-3434-1-9 a chart:DataPoint ;
