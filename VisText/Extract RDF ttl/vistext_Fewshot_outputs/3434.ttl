@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-3434 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Retail price index of potato in India from January to December 2019" ;
    chart:xAxis ex:x-3434 ;
    chart:yAxis ex:y-3434 .

ex:x-3434 a chart:Axis ;
    chart:label "Month" ;
    chart:scaleMin "" ;
    chart:scaleMax "" .

ex:y-3434 a chart:Axis ;
    chart:label "Retail price index" ;
    chart:scaleMin "0" ;
    chart:scaleMax "400" .

ex:series-3434-1 a chart:Series .

ex:dp-3434-1-1 a chart:DataPoint ;
    chart:series ex:series-3434-1 ;
    chart:category "April" ;
    chart:value "205"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-3434-1-2 a chart:DataPoint ;
    chart:series ex:series-3434-1 ;
    chart:category "August" ;
    chart:value "250"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-3434-1-3 a chart:DataPoint ;
    chart:series ex:series-3434-1 ;
    chart:category "December" ;
    chart:value "345"^^xsd:decimal ;
    chart:valueEstimated "true" .

