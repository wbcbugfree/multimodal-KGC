@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-2069 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Number of Christmas markets in Europe in 2014 , by country" ;
    chart:xAxis ex:x-2069 ;
    chart:yAxis ex:y-2069 .

ex:x-2069 a chart:Axis ;
    chart:label "Number of markets" ;
    chart:scaleMin "0" ;
    chart:scaleMax "2000" .

ex:y-2069 a chart:Axis ;
    chart:label "Country" ;
    chart:scaleMin "" ;
    chart:scaleMax "" .

ex:series-2069-1 a chart:Series .

ex:dp-2069-1-1 a chart:DataPoint ;
    chart:series ex:series-2069-1 ;
    chart:category "Austria" ;
    chart:value "10"^^xsd:decimal ;
    chart:valueEstimated "true" .

