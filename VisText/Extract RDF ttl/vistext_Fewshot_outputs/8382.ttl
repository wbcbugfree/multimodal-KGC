    chart:title "Number of sexual assaults of British (UK) residents in selected countries from April 2012 to March 2014" ;
    chart:xAxis ex:x-8382 ;
    chart:yAxis ex:y-8382 .

ex:x-8382 a chart:Axis ;
    chart:label "Country" .

ex:y-8382 a chart:Axis ;
    chart:label "2012/2013" ;
    chart:scaleMin "0" ;
    chart:scaleMax "40" .

ex:series-8382-1 a chart:Series .

