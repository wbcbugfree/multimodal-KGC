@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-7706 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "How do you think each of the following US Presidents will go down in history ?" ;
    chart:xAxis ex:x-7706 ;
    chart:yAxis ex:y-7706 .

ex:x-7706 a chart:Axis ;
    chart:label "Outstanding / above average" ;
    chart:scaleMin "0.0" ;
    chart:scaleMax "0.8" .

ex:y-7706 a chart:Axis ;
    chart:label "" ;
    chart:scaleMin "" ;
    chart:scaleMax "" .

ex:series-7706-1 a chart:Series .

ex:dp-7706-1-1 a chart:DataPoint ;
    chart:series ex:series-7706-1 ;
    chart:category "Barack Obama" ;
    chart:value "0.25"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-7706-1-2 a chart:DataPoint ;
    chart:series ex:series-7706-1 ;
    chart:category "Bill Clinton" ;
    chart:value "0.53"^^xsd:decimal ;
    chart:valueEstimated "true" .

