@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-2633 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Ireland : National debt in relation to gross domestic product (GDP) from 2015 to 2025" ;
    chart:xAxis ex:x-2633 ;
    chart:yAxis ex:y-2633 .

ex:x-2633 a chart:Axis ;
    chart:label "Year" .

ex:y-2633 a chart:Axis ;
    chart:label "National debt to GDP ratio" ;
    chart:scaleMin "0.0" ;
    chart:scaleMax "0.8" .

ex:series-2633-1 a chart:Series .

ex:dp-2633-1-1 a chart:DataPoint ;
    chart:series ex:series-2633-1 ;
    chart:category "2015" ;
    chart:value "0.77"^^xsd:decimal ;
    chart:valueEstimated "true" .

