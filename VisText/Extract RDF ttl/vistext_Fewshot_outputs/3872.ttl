@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-3872 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Number of deaths from unintentional carbon monoxide poisoning in the United Kingdom (UK) from 1995 to 2019 , by age" ;
    chart:xAxis ex:x-3872 ;
    chart:yAxis ex:y-3872 .

ex:x-3872 a chart:Axis ;
    chart:label "Age in years" ;
    chart:scaleMin "0" ;
    chart:scaleMax "120" .

ex:y-3872 a chart:Axis ;
    chart:label "Number of deaths" ;
    chart:scaleMin "0" ;
    chart:scaleMax "120" .

ex:series-3872-1 a chart:Series .

ex:dp-3872-1-1 a chart:DataPoint ;
    chart:series ex:series-3872-1 ;
    chart:category "0-10" ;
    chart:value "20"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-3872-1-2 a chart:DataPoint ;
    chart:series ex:series-3872-1 ;
    chart:category "11-20" ;
    chart:value "44"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-3872-1-3 a chart:DataPoint ;
    chart:series ex:series-3872-1 ;
    chart:category "21-30" ;
    chart:value "62"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-3872-1-4 a chart:DataPoint ;
    chart:series ex:series-3872-1 ;
    chart:category "31-40" ;
    chart:value "78"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-3872-1-5 a chart:DataPoint ;
    chart:series ex:series-3872-1 ;
    chart:category "41-50" ;
    chart:value "92"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-3872-1-6 a chart:DataPoint ;
    chart:series ex:series-3872-1 ;
    chart:category "51-60" ;
    chart:value "96"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-3872-1-7 a chart:DataPoint ;
    chart:series ex:series-3872-1 ;
    chart:category "61-70" ;
    chart:value "94"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-3872-1-8 a chart:DataPoint ;
    chart:series ex:series-3872-1 ;
    chart:category "71-80" ;
    chart:value "118"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-3872-1-9 a chart:DataPoint ;
    chart:series ex:series-3872-1 ;
    chart:category "81-90" ;
    chart:value "92"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-3872-1-10 a chart:DataPoint ;
    chart:series ex:series-3872-1 ;
    chart:category "91 and over" ;
    chart:value "12"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-3872-1-11 a chart:DataPoint ;
    chart:series ex:series-3872-1 ;
    chart:category "Not known" ;
    chart:value "2"^^xsd:decimal ;
    chart:valueEstimated "true" .
