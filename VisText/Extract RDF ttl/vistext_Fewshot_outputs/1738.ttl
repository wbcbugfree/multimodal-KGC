@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-1738 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Average ticket price New York Islanders games (NHL) from 2005/06 to 2014/15 (in U.S. dollars)" ;
    chart:xAxis ex:x-1738 ;
    chart:yAxis ex:y-1738 .

ex:x-1738 a chart:Axis ;
    chart:label "Average ticket price in U.S. dollars" ;
    chart:scaleMin "0" ;
    chart:scaleMax "70" .

ex:y-1738 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "" ;
    chart:scaleMax "" .

ex:series-1738-1 a chart:Series .

ex:dp-1738-1-1 a chart:DataPoint ;
    chart:series ex:series-1738-1 ;
    chart:category "2005/06" ;
    chart:value "40"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-1738-1-2 a chart:DataPoint ;
    chart:series ex:series-1738-1 ;
    chart:category "2006/07" ;
    chart:value "42"^^xsd:decimal ;
    chart:valueEstimated "true" .

