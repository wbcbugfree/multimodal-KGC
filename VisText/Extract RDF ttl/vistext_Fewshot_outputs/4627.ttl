@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-4627 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Circulation of selected large daily newspapers in Finland in 2019" ;
    chart:xAxis ex:x-4627 ;
    chart:yAxis ex:y-4627 .

ex:x-4627 a chart:Axis ;
    chart:label "Number of copies" ;
    chart:scaleMin "0" ;
    chart:scaleMax "300000" .

ex:y-4627 a chart:Axis ;
    chart:label "newspaper" .

ex:series-4627-1 a chart:Series .

ex:dp-4627-1-1 a chart:DataPoint ;
    chart:series ex:series-4627-1 ;
    chart:category "Etelä-Saimaa" ;
    chart:value "20000"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-4627-1-2 a chart:DataPoint ;
    chart:series ex:series-4627-1 ;
    chart:category "Etelä-Suomen Sanomat" ;
    chart:value "40000"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-4627-1-3 a chart:DataPoint ;
    chart:series ex:series-4627-1 ;
    chart:category "Helsingin Sanomat" ;
    chart:value "300000"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-4627-1-4 a chart:DataPoint ;
    chart:series ex:series-4627-1 ;
    chart:category "Hufvudstadsbladet" ;
    chart:value "40000"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-4627-1-5 a chart:DataPoint ;
    chart:series ex:series-4627-1 ;
    chart:category "Ilkka" ;
    chart:value "40000"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-4627-1-6 a chart:DataPoint ;
    chart:series ex:series-4627-1 ;
    chart:category "Karjalainen" ;
    chart:value "40000"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-4627-1-7 a chart:DataPoint ;
    chart:series ex:series-4627-1 ;
    chart:category "Keskisuomalainen" ;
    chart:value "90000"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-4627-1-8 a chart:DataPoint ;
    chart:series ex:series-4627-1 ;
    chart:category "Kouvolan Sanomat" ;
    chart:value "20000"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-4627-1-9 a chart:DataPoint ;
    chart:series ex:series-4627-1 ;
    chart:category "Savon Sanomat" ;
    chart:value "70000"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-4627-1-10 a chart:DataPoint ;
