@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-2773 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Syria : Budget balance between 2000 and 2010 in relation to GDP" ;
    chart:xAxis ex:x-2773 ;
    chart:yAxis ex:y-2773 .

ex:x-2773 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2000" ;
    chart:scaleMax "2010*" .

ex:y-2773 a chart:Axis ;
    chart:label "" ;
    chart:scaleMin "-0.08" ;
    chart:scaleMax "0.02" .

ex:series-2773-1 a chart:Series .

ex:dp-2773-1-1 a chart:DataPoint ;
    chart:series ex:series-2773-1 ;
    chart:category "2000" ;
    chart:value "-0.01"^^xsd:decimal ;
    chart:valueEstimated "true" .

