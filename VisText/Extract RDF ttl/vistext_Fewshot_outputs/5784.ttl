@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-5784 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Top ten horse racing meeting attendances in Britain in 2012" ;
    chart:xAxis ex:x-5784 ;
    chart:yAxis ex:y-5784 .

ex:x-5784 a chart:Axis ;
    chart:label "horse racing venue" .

ex:y-5784 a chart:Axis ;
    chart:label "Number of attendees" ;
    chart:scaleMin "0" ;
    chart:scaleMax "300000" .

ex:series-5784-1 a chart:Series .

ex:dp-5784-1-1 a chart:DataPoint ;
    chart:series ex:series-5784-1 ;
    chart:category "Aintree Grand National" ;
    chart:value "190000"^^xsd:decimal ;
    chart:valueEstimated "true" .

