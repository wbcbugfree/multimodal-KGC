@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-4475 a chart:Chart ;
    chart:chartType "area" ;
    chart:xAxis ex:x-4475 ;
    chart:yAxis ex:y-4475 .

ex:x-4475 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2008" ;
    chart:scaleMax "2018" .

ex:y-4475 a chart:Axis ;
    chart:label "Revenues in billion U.S. dollars" ;
    chart:scaleMin "0" ;
    chart:scaleMax "80" .

ex:series-4475-1 a chart:Series .

ex:dp-4475-1-1 a chart:DataPoint ;
    chart:series ex:series-4475-1 ;
    chart:xVal "2008" ;
    chart:yVal "49"^^xsd:decimal ;
    chart:value "49"^^xsd:decimal ;
    chart:valueEstimated "true" .

