@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-8200 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Products and services people spend more than usual on due to the COVID-19 / coronavirus pandemic in the United States , United Kingdom and Germany 2020 (as of May 31)" ;
    chart:xAxis ex:x-8200 ;
    chart:yAxis ex:y-8200 .

ex:x-8200 a chart:Axis ;
    chart:label "Response" .

ex:y-8200 a chart:Axis ;
    chart:label "United States" ;
    chart:scaleMin "0.0" ;
    chart:scaleMax "0.4" .

ex:series-8200-1 a chart:Series .

ex:dp-8200-1-1 a chart:DataPoint ;
    chart:series ex:series-8200-1 ;
    chart:category "Childcare" ;
    chart:value "0.04"^^xsd:decimal ;
