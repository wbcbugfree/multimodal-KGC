@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-2282 a chart:Chart ;
    chart:chartType "line" ;
    chart:title "Annual number of deaths as a result of breast cancer in Spain from 2005 to 2018" ;
    chart:xAxis ex:x-2282 ;
    chart:yAxis ex:y-2282 .

ex:x-2282 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2005" ;
    chart:scaleMax "2018" .

ex:y-2282 a chart:Axis ;
    chart:label "Number of deaths" ;
    chart:scaleMin "0" ;
    chart:scaleMax "6000" .

ex:series-2282-1 a chart:Series .

ex:dp-2282-1-1 a chart:DataPoint ;
    chart:series ex:series-2282-1 ;
    chart:xVal "2005" ;
    chart:yVal "5500"^^xsd:decimal ;
    chart:value "5500"^^xsd:decimal ;
    chart:valueEstimated "true" .

