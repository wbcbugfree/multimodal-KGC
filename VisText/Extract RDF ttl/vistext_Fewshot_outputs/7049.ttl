@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-7049 a chart:Chart ;
    chart:chartType "area" ;
    chart:xAxis ex:x-7049 ;
    chart:yAxis ex:y-7049 .

ex:x-7049 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2008" ;
    chart:scaleMax "2016" .

ex:y-7049 a chart:Axis ;
    chart:label "Managed hotels" ;
    chart:scaleMin "0" ;
    chart:scaleMax "600" .

ex:series-7049-1 a chart:Series .

ex:dp-7049-1-1 a chart:DataPoint ;
    chart:series ex:series-7049-1 ;
    chart:xVal "2008" ;
    chart:yVal "420"^^xsd:decimal ;
    chart:value "420"^^xsd:decimal ;
    chart:valueEstimated "true" .

