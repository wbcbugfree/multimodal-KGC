@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-4563 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "How did bullying impact you ?" ;
    chart:xAxis ex:x-4563 ;
    chart:yAxis ex:y-4563 .

ex:x-4563 a chart:Axis ;
    chart:label "Response" ;
    chart:scaleMin "" ;
    chart:scaleMax "" .

ex:y-4563 a chart:Axis ;
    chart:label "Share of respondents" ;
    chart:scaleMin "0.0" ;
    chart:scaleMax "0.4" .

ex:series-4563-1 a chart:Series .

ex:dp-4563-1-1 a chart:DataPoint ;
    chart:series ex:series-4563-1 ;
    chart:category "Developed an eating disorder" ;
    chart:value "0.13"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-4563-1-2 a chart:DataPoint ;
    chart:series ex:series-4563-1 ;
    chart:category "Developed depression" ;
    chart:value "0.44"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-4563-1-3 a chart:DataPoint ;
    chart:series ex:series-4563-1 ;
    chart:category "Developed social anxiety" ;
    chart:value "0.41"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-4563-1-4 a chart:DataPoint ;
    chart:series ex:series-4563-1 ;
    chart:category "Have abused drugs and/or alcohol" ;
    chart:value "0.07"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-4563-1-5 a chart:DataPoint ;
    chart:series ex:series-4563-1 ;
    chart:category "Have developed anti-social behavior" ;
    chart:value "0.14"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-4563-1-6 a chart:DataPoint ;
    chart:series ex:series-4563-1 ;
    chart:category "Have engaged in risky social behavior" ;
    chart:value "0.04"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-4563-1-7 a chart:DataPoint ;
    chart:series ex:series-4563-1 ;
    chart:category "Have had suicidal thoughts" ;
    chart:value "0.33"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-4563-1-8 a chart:DataPoint ;
    chart:series ex:series-4563-1 ;
    chart:category "Have self-harmed" ;
    chart:value "0.26"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-4563-1-9 a chart:DataPoint ;
    chart:series ex:series-4563-1 ;
    chart:category "Have truanted from school of college" ;
    chart:value "0.20"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-4563-1-10 a chart:DataPoint ;
    chart:series ex:series-4563-1 ;
    chart:category "Ran away from home" ;
    chart:value "0.09"^^xsd:decimal ;
    chart:valueEstimated "true" .
