@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-81 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Rakuten Ichiba 's sales from 1st quarter 2013 to 2nd quarter 2015 (in billion yen)" ;
    chart:xAxis ex:x-81 ;
    chart:yAxis ex:y-81 .

ex:x-81 a chart:Axis ;
    chart:label "Value in billion yen" ;
    chart:scaleMin "0" ;
    chart:scaleMax "40" .

ex:y-81 a chart:Axis ;
    chart:label "Quarter" ;
    chart:scaleMin "" ;
    chart:scaleMax "" .

ex:series-81-1 a chart:Series .

ex:dp-81-1-1 a chart:DataPoint ;
    chart:series ex:series-81-1 ;
    chart:category "Q1 '13" ;
    chart:value "25"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-81-1-2 a chart:DataPoint ;
    chart:series ex:series-81-1 ;
    chart:category "Q1 '14" ;
    chart:value "30"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-81-1-3 a chart:DataPoint ;
    chart:series ex:series-81-1 ;
    chart:category "Q1 '15" ;
    chart:value "35"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-81-1-4 a chart:DataPoint ;
    chart:series ex:series-81-1 ;
    chart:category "Q2 '13" ;
    chart:value "28"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-81-1-5 a chart:DataPoint ;
    chart:series ex:series-81-1 ;
    chart:category "Q2 '14" ;
    chart:value "33"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-81-1-6 a chart:DataPoint ;
    chart:series ex:series-81-1 ;
    chart:category "Q2 '15" ;
    chart:value "38"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-81-1-7 a chart:DataPoint ;
    chart:series ex:series-81-1 ;
    chart:category "Q3 '13" ;
    chart:value "32"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-81-1-8 a chart:DataPoint ;
    chart:series ex:series-81-1 ;
    chart:category "Q3 '14" ;
    chart:value "37"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-81-1-9 a chart:DataPoint ;
    chart:series ex:series-81-1 ;
    chart:category "Q4 '13" ;
    chart:value "36"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-81-1-10 a chart:DataPoint ;
    chart:series ex:series-81-1 ;
    chart:category "Q4 '14" ;
    chart:value "40"^^xsd:decimal ;
    chart:valueEstimated "true" .
