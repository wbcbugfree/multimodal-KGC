@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-6402 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Number of U.S. high schools with athletics programs for girls from 2009/10 to 2018/19 , by sport" ;
    chart:xAxis ex:x-6402 ;
    chart:yAxis ex:y-6402 .

ex:x-6402 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2009/10" ;
    chart:scaleMax "2018/19" .

ex:y-6402 a chart:Axis ;
    chart:label "" ;
    chart:scaleMin "0" ;
    chart:scaleMax "8000" .

ex:series-6402-1 a chart:Series ;
    chart:seriesName "Swimming and Diving" .

ex:dp-6402-1-1 a chart:DataPoint ;
    chart:series ex:series-6402-1 ;
    chart:category "2009/10" ;
    chart:value "6400"^^xsd:decimal ;
    chart:valueEstimated "true" .

