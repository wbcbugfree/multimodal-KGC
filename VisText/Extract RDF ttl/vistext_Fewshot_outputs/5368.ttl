@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-5368 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Leading trends in ethnic cuisines on restaurant menus in the United States in 2015" ;
    chart:xAxis ex:x-5368 ;
    chart:yAxis ex:y-5368 .

ex:x-5368 a chart:Axis ;
    chart:label "Share of respondents" ;
    chart:scaleMin "0.0" ;
    chart:scaleMax "0.6" .

ex:y-5368 a chart:Axis ;
    chart:label "Response" .

ex:series-5368-1 a chart:Series .

ex:dp-5368-1-1 a chart:DataPoint ;
    chart:series ex:series-5368-1 ;
    chart:category "Southeast Asian cuisine (e.g. Thai, Vietnamese, Indian)" ;
    chart:value "0.52"^^xsd:decimal ;
    chart:valueEstimated "true" .

