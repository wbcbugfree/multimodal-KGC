@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-336 a chart:Chart ;
    chart:chartType "area" ;
    chart:title "Ecolab 's net income from 2009 to 2019 (in million U.S. dollars)" ;
    chart:xAxis ex:x-336 ;
    chart:yAxis ex:y-336 .

ex:x-336 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2009" ;
    chart:scaleMax "2019" .

ex:y-336 a chart:Axis ;
    chart:label "Net income in million U.S. dollars" ;
    chart:scaleMin "0" ;
    chart:scaleMax "1500" .

ex:series-336-1 a chart:Series .

ex:dp-336-1-1 a chart:DataPoint ;
    chart:series ex:series-336-1 ;
    chart:xVal "2009" ;
    chart:yVal "400"^^xsd:decimal ;
    chart:value "400"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-336-1-2 a chart:DataPoint ;
    chart:series ex:series-336-1 ;
    chart:xVal "2010" ;
    chart:yVal "500"^^xsd:decimal ;
    chart:value "500"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-336-1-3 a chart:DataPoint ;
    chart:series ex:series-336-1 ;
    chart:xVal "2011" ;
    chart:yVal "350"^^xsd:decimal ;
    chart:value "350"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-336-1-4 a chart:DataPoint ;
    chart:series ex:series-336-1 ;
    chart:xVal "2012" ;
    chart:yVal "600"^^xsd:decimal ;
    chart:value "600"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-336-1-5 a chart:DataPoint ;
    chart:series ex:series-336-1 ;
    chart:xVal "2013" ;
    chart:yVal "900"^^xsd:decimal ;
    chart:value "900"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-336-1-6 a chart:DataPoint ;
    chart:series ex:series-336-1 ;
    chart:xVal "2014" ;
    chart:yVal "1150"^^xsd:decimal ;
    chart:value "1150"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-336-1-7 a chart:DataPoint ;
    chart:series ex:series-336-1 ;
    chart:xVal "2015" ;
    chart:yVal "1000"^^xsd:decimal ;
    chart:value "1000"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-336-1-8 a chart:DataPoint ;
    chart:series ex:series-336-1 ;
    chart:xVal "2016" ;
    chart:yVal "1300"^^xsd:decimal ;
    chart:value "1300"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-336-1-9 a chart:DataPoint ;
    chart:series ex:series-336-1 ;
    chart:xVal "2017" ;
    chart:yVal "1450"^^xsd:decimal ;
    chart:value "1450"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-336-1-10 a chart:DataPoint ;
    chart:series ex:series-336-1 ;
    chart:xVal "2018" ;
    chart:yVal "1600"^^xsd:decimal ;
    chart:value "1600"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-336-1-11 a chart:DataPoint ;
    chart:series ex:series-336-1 ;
    chart:xVal "2019" ;
    chart:yVal "1700"^^xsd:decimal ;
    chart:value "1700"^^xsd:decimal ;
    chart:valueEstimated "true" .
