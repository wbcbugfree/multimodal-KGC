@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-4821 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Per capita personal income in Texas from 2000 to 2019 (in current U.S. dollars)" ;
    chart:xAxis ex:x-4821 ;
    chart:yAxis ex:y-4821 .

ex:x-4821 a chart:Axis ;
    chart:label "year" ;
    chart:scaleMin "2000" ;
    chart:scaleMax "2019" .

ex:y-4821 a chart:Axis ;
    chart:label "Income in U.S. dollars" ;
    chart:scaleMin "0" ;
    chart:scaleMax "50000" .

ex:series-4821-1 a chart:Series .

ex:dp-4821-1-1 a chart:DataPoint ;
