@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-3262 a chart:Chart ;
    chart:chartType "line" ;
    chart:title "Consumer price index for non-food in Ethiopia from 2019 to 2020" ;
    chart:xAxis ex:x-3262 ;
    chart:yAxis ex:y-3262 .

ex:x-3262 a chart:Axis ;
    chart:label "Month" ;
    chart:scaleMin "2019 April" ;
    chart:scaleMax "2020 April" .

ex:y-3262 a chart:Axis ;
    chart:label "CPI non-food (Dec=2016)" ;
    chart:scaleMin "0" ;
    chart:scaleMax "150" .

ex:series-3262-1 a chart:Series .

ex:dp-3262-1-1 a chart:DataPoint ;
    chart:series ex:series-3262-1 ;
    chart:xVal "2019 April" ;
    chart:yVal "118"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-3262-1-2 a chart:DataPoint ;
    chart:series ex:series-3262-1 ;
    chart:xVal "2019 May" ;
    chart:yVal "119"^^xsd:decimal ;
    chart:valueEstimated "true" .

