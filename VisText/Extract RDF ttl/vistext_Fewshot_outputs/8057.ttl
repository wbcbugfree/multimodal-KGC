@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-8057 a chart:Chart ;
    chart:chartType "area" ;
    chart:title "Monthly number of visitor arrivals in Kenya from January 2019 to August 2020 , by airport" ;
    chart:xAxis ex:x-8057 ;
    chart:yAxis ex:y-8057 .

ex:x-8057 a chart:Axis ;
    chart:label "Month" ;
    chart:scaleMin "2019" ;
    chart:scaleMax "2020" .

ex:y-8057 a chart:Axis ;
    chart:label "MIA" ;
    chart:scaleMin "0" ;
    chart:scaleMax "15000" .

ex:series-8057-1 a chart:Series .

ex:dp-8057-1-1 a chart:DataPoint ;
    chart:series ex:series-8057-1 ;
    chart:xVal "2019" ;
    chart:yVal "15000"^^xsd:decimal ;
    chart:value "15000"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-8057-1-2 a chart:DataPoint ;
    chart:series ex:series-8057-1 ;
    chart:xVal "April" ;
    chart:yVal "2500"^^xsd:decimal ;
    chart:value "2500"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-8057-1-3 a chart:DataPoint ;
    chart:series ex:series-8057-1 ;
    chart:xVal "July" ;
    chart:yVal "9500"^^xsd:decimal ;
    chart:value "9500"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-8057-1-4 a chart:DataPoint ;
    chart:series ex:series-8057-1 ;
    chart:xVal "October" ;
    chart:yVal "10500"^^xsd:decimal ;
    chart:value "10500"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-8057-1-5 a chart:DataPoint ;
    chart:series ex:series-8057-1 ;
    chart:xVal "2020" ;
    chart:yVal "11000"^^xsd:decimal ;
    chart:value "11000"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-8057-1-6 a chart:DataPoint ;
    chart:series ex:series-8057-1 ;
    chart:xVal "April" ;
    chart:yVal "9000"^^xsd:decimal ;
    chart:value "9000"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-8057-1-7 a chart:DataPoint ;
    chart:series ex:series-8057-1 ;
    chart:xVal "July" ;
    chart:yVal "0"^^xsd:decimal ;
    chart:value "0"^^xsd:decimal ;
    chart:valueEstimated "true" .
