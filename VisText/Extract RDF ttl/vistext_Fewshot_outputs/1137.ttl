@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-1137 a chart:Chart ;
    chart:chartType "area" ;
    chart:title "Libya : Youth unemployment rate from 1999 to 2020" ;
    chart:xAxis ex:x-1137 ;
    chart:yAxis ex:y-1137 .

ex:x-1137 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2000" ;
    chart:scaleMax "2015" .

ex:y-1137 a chart:Axis ;
    chart:label "Youth unemployment rate" ;
    chart:scaleMin "0.0" ;
    chart:scaleMax "0.5" .

ex:series-1137-1 a chart:Series .

ex:dp-1137-1-1 a chart:DataPoint ;
    chart:series ex:series-1137-1 ;
    chart:xVal "2000" ;
    chart:yVal "0.46"^^xsd:decimal ;
    chart:valueEstimated "true" .

