@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-2739 a chart:Chart ;
    chart:chartType "area" ;
    chart:title "Machinery and equipment price index in Canada from 2006 to 2016" ;
    chart:xAxis ex:x-2739 ;
    chart:yAxis ex:y-2739 .

ex:x-2739 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2006" ;
    chart:scaleMax "2016" .

ex:y-2739 a chart:Axis ;
    chart:label "Price index" ;
    chart:scaleMin "0" ;
    chart:scaleMax "120" .

ex:series-2739-1 a chart:Series .

ex:dp-2739-1-1 a chart:DataPoint ;
    chart:series ex:series-2739-1 ;
    chart:xVal "2006" ;
    chart:yVal "102"^^xsd:decimal ;
    chart:value "102"^^xsd:decimal ;
    chart:valueEstimated "true" .

