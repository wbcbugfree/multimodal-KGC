@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-1330 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Libya : Total population from 2015 to 2025\n(in million inhabitants)" ;
    chart:xAxis ex:x-1330 ;
    chart:yAxis ex:y-1330 .

ex:x-1330 a chart:Axis ;
    chart:label "Inhabitants in millions" ;
    chart:scaleMin "0" ;
    chart:scaleMax "7" .

ex:y-1330 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "" ;
    chart:scaleMax "" .

ex:series-1330-1 a chart:Series .

ex:dp-1330-1-1 a chart:DataPoint ;
    chart:series ex:series-1330-1 ;
    chart:category "2015" ;
    chart:value "6.8"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-1330-1-2 a chart:DataPoint ;
    chart:series ex:series-1330-1 ;
    chart:category "2016" ;
    chart:value "6.9"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-1330-1-3 a chart:DataPoint ;
    chart:series ex:series-1330-1 ;
    chart:category "2017" ;
    chart:value "7.0"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-1330-1-4 a chart:DataPoint ;
    chart:series ex:series-1330-1 ;
    chart:category "2018" ;
    chart:value "7.1"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-1330-1-5 a chart:DataPoint ;
    chart:series ex:series-1330-1 ;
    chart:category "2019" ;
    chart:value "7.2"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-1330-1-6 a chart:DataPoint ;
    chart:series ex:series-1330-1 ;
    chart:category "2020*" ;
    chart:value "7.3"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-1330-1-7 a chart:DataPoint ;
    chart:series ex:series-1330-1 ;
    chart:category "2021*" ;
    chart:value "7.4"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-1330-1-8 a chart:DataPoint ;
    chart:series ex:series-1330-1 ;
    chart:category "2022*" ;
    chart:value "7.5"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-1330-1-9 a chart:DataPoint ;
    chart:series ex:series-1330-1 ;
    chart:category "2023*" ;
    chart:value "7.6"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-1330-1-10 a chart:DataPoint ;
    chart:series ex:series-1330-1 ;
    chart:category "2024*" ;
    chart:value "7.7"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-1330-1-11 a chart:DataPoint ;
    chart:series ex:series-1330-1 ;
    chart:category "2025*" ;
    chart:value "7.8"^^xsd:decimal ;
    chart:valueEstimated "true" .
