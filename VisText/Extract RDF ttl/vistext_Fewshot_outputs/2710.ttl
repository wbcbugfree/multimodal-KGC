@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-2710 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Percentage of adults in the U.S. who were prone to select symptoms as of 2017" ;
    chart:xAxis ex:x-2710 ;
    chart:yAxis ex:y-2710 .

ex:x-2710 a chart:Axis ;
    chart:label "Response" .

ex:y-2710 a chart:Axis ;
    chart:label "Share of respondents" ;
    chart:scaleMin "0.0" ;
    chart:scaleMax "0.5" .

ex:series-2710-1 a chart:Series .

ex:dp-2710-1-1 a chart:DataPoint ;
    chart:series ex:series-2710-1 ;
    chart:category "Back pain" ;
    chart:value "0.49"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-2710-1-2 a chart:DataPoint ;
    chart:series ex:series-2710-1 ;
    chart:category "Concentration difficulties" ;
    chart:value "0.17"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-2710-1-3 a chart:DataPoint ;
    chart:series ex:series-2710-1 ;
    chart:category "Depression" ;
    chart:value "0.26"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-2710-1-4 a char:DataPoint ;
    chart:series ex:series-2710-1 ;
    chart:category "Gastrointestinal complaints" ;
    chart:value "0.22"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-2710-1-5 a chart:DataPoint ;
    chart:series ex:series-2710-1 ;
    chart:category "Headache" ;
    chart:value "0.44"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-2710-1-6 a chart:DataPoint ;
    chart:series ex:series-2710-1 ;
    chart:category "Lack of appetite" ;
    chart:value "0.09"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-2710-1-7 a chart:DataPoint ;
    chart:series ex:series-2710-1 ;
    chart:category "Lightheadedness" ;
    chart:value "0.17"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-2710-1-8 a chart:DataPoint ;
    chart:series ex:series-2710-1 ;
    chart:category "None of the above" ;
    chart:value "0.19"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-2710-1-9 a chart:DataPoint ;
    chart:series ex:series-2710-1 ;
    chart:category "Poor circulation" ;
    chart:value "0.12"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-2710-1-10 a chart:DataPoint ;
    chart:series ex:series-2710-1 ;
    chart:category "Prefer not to answer" ;
    chart:value "0.03"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-2710-1-11 a chart:DataPoint ;
    chart:series ex:series-2710-1 ;
    chart:category "Skin rashes" ;
    chart:value "0.13"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-2710-1-12 a chart:DataPoint ;
    chart:series ex:series-2710-1 ;
    chart:category "Sleep problems" ;
    chart:value "0.42"^^xsd:decimal ;
    chart:valueEstimated "true" .
