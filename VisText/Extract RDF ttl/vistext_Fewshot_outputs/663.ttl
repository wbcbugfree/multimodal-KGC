@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-663 a chart:Chart ;
    chart:chartType "area" ;
    chart:title "Gross domestic product of Northwest Territories , Canada from 2000 to 2019 (in million chained 2012 Canadian dollars)" ;
    chart:xAxis ex:x-663 ;
    chart:yAxis ex:y-663 .

ex:x-663 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2000" ;
    chart:scaleMax "2019" .

ex:y-663 a chart:Axis ;
    chart:label "GDP in million chained 2012 Canadian dollars" ;
    chart:scaleMin "0" ;
    chart:scaleMax "6000" .

ex:series-663-1 a chart:Series .

ex:dp-663-1-1 a chart:DataPoint ;
    chart:series ex:series-663-1 ;
    chart:xVal "2000" ;
    chart:yVal "4100"^^xsd:decimal ;
    chart:value "4100"^^xsd:decimal ;
    chart:valueEstimated "true" .

