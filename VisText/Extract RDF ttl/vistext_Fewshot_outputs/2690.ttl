@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-2690 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Leading companies in the bakery category in Canada in 2011 , by market share" ;
    chart:xAxis ex:x-2690 ;
    chart:yAxis ex:y-2690 .

ex:x-2690 a chart:Axis ;
    chart:label "Company" .

ex:y-2690 a chart:Axis ;
    chart:label "Market share" ;
    chart:scaleMin "0.00" ;
    chart:scaleMax "0.30" .

ex:series-2690-1 a chart:Series .

