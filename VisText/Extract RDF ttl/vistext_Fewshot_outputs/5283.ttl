@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-5283 a chart:Chart ;
    chart:chartType "line" ;
    chart:title "Median household income in Wisconsin from 1990 to 2019 (in current U.S. dollars)" ;
    chart:xAxis ex:x-5283 ;
    chart:yAxis ex:y-5283 .

ex:x-5283 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "1990" ;
    chart:scaleMax "2019" .

ex:y-5283 a chart:Axis ;
    chart:label "Household income in current U.S. dollars" ;
    chart:scaleMin "0" ;
    chart:scaleMax "70000" .

ex:series-5283-1 a chart:Series .

ex:dp-5283-1-1 a chart:DataPoint ;
    chart:series ex:series-5283-1 ;
    chart:xVal "1990" ;
    chart:yVal "31000"^^xsd:decimal ;
    chart:valueEstimated "true" .

