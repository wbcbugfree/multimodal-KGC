@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-8370 a chart:Chart ;
    chart:chartType "line" ;
    chart:title "Percentage change of food and organic food sales in Italy from 2007 to 2020" ;
    chart:xAxis ex:x-8370 ;
    chart:yAxis ex:y-8370 .

ex:x-8370 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2007" ;
    chart:scaleMax "2020" .

ex:y-8370 a chart:Axis ;
    chart:label "Organic food sales" ;
    chart:scaleMin "0.00" ;
    chart:scaleMax "0.20" .

ex:series-8370-1 a chart:Series .

ex:dp-8370-1-1 a chart:DataPoint ;
    chart:series ex:series-8370-1 ;
    chart:xVal "2007" ;
    chart:yVal "0.00"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-8370-1-2 a chart:DataPoint ;
    chart:series ex:series-8370-1 ;
    chart:xVal "2008" ;
    chart:yVal "0.10"^^xsd:decimal ;
