@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-8579 a chart:Chart ;
    chart:chartType "area" ;
    chart:title "United States : Employee engagement 2002 to 2012" ;
    chart:xAxis ex:x-8579 ;
    chart:yAxis ex:y-8579 .

ex:x-8579 a chart:Axis ;
    chart:label "Response" ;
    chart:scaleMin "2002" ;
    chart:scaleMax "2012" .

ex:y-8579 a chart:Axis ;
    chart:label "Engaged" ;
    chart:scaleMin "0.00" ;
    chart:scaleMax "0.30" .

ex:series-8579-1 a chart:Series .

ex:dp-8579-1-1 a chart:DataPoint ;
    chart:series ex:series-8579-1 ;
    chart:xVal "2002" ;
    chart:yVal "0.30"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-8579-1-2 a chart:DataPoint ;
    chart:series ex:series-8579-1 ;
    chart:xVal "2004" ;
    chart:yVal "0.28"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-8579-1-3 a chart:DataPoint ;
    chart:series ex:series-8579-1 ;
    chart:xVal "2006" ;
    chart:yVal "0.29"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-8579-1-4 a chart:DataPoint ;
    chart:series ex:series-8579-1 ;
    chart:xVal "2008" ;
    chart:yVal "0.27"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-8579-1-5 a chart:DataPoint ;
    chart:series ex:series-8579-1 ;
    chart:xVal "2010" ;
    chart:yVal "0.29"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-8579-1-6 a chart:DataPoint ;
    chart:series ex:series-8579-1 ;
    chart:xVal "2012" ;
    chart:yVal "0.30"^^xsd:decimal ;
    chart:valueEstimated "true" .
