@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-2460 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Most valuable food brands in the United Kingdom (UK) in 2015 (in million U.S. dollars)" ;
    chart:xAxis ex:x-2460 ;
    chart:yAxis ex:y-2460 .

ex:x-2460 a chart:Axis ;
    chart:label "food brand" .

ex:y-2460 a chart:Axis ;
    chart:label "Brand value in million U.S. dollars" ;
    chart:scaleMin "0" ;
    chart:scaleMax "12000" .

ex:series-2460-1 a chart:Series .

ex:dp-2460-1-1 a chart:DataPoint ;
    chart:series ex:series-2460-1 ;
    chart:category "Booker Group" ;
    chart:value "1300"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-2460-1-2 a chart:DataPoint ;
    chart:series ex:series-2460-1 ;
    chart:category "John Lewis" ;
    chart:value "1600"^^xsd:decimal ;
    chart:valueEstimated "true" .

