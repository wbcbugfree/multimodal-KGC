@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-6145 a chart:Chart ;
    chart:chartType "line" ;
    chart:title "Uganda : Distribution of gross domestic product (GDP) across economic sectors from 2009 to 2019" ;
    chart:xAxis ex:x-6145 ;
    chart:yAxis ex:y-6145 .

ex:x-6145 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2009" ;
    chart:scaleMax "2019" .

ex:y-6145 a chart:Axis ;
    chart:label "Agriculture, forestry, and fishing" ;
    chart:scaleMin "0.00" ;
    chart:scaleMax "0.35" .

ex:series-6145-1 a chart:Series .

ex:dp-6145-1-1 a chart:DataPoint ;
    chart:series ex:series-6145-1 ;
    chart:xVal "2009" ;
    chart:yVal "0.34"^^xsd:decimal ;
    chart:value "0.34"^^xsd:decimal ;
    chart:valueEstimated "true" .

