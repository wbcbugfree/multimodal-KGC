@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-6211 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Growth in weekly sales of FMCG products due to coronavirus (COVID-19) outbreak in Poland between January and March 2020 , by type of products" ;
    chart:xAxis ex:x-6211 ;
    chart:yAxis ex:y-6211 .

ex:x-6211 a chart:Axis ;
    chart:label "type of FMCG products" .

ex:y-6211 a chart:Axis ;
    chart:label "Toilet paper" ;
    chart:scaleMin "-0.1" ;
    chart:scaleMax "0.6" .

ex:series-6211-1 a chart:Series .

ex:dp-6211-1-1 a chart:DataPoint ;
    chart:series ex:series-6211-1 ;
    chart:category "W01" ;
    chart:value "0.13"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-6211-1-2 a chart:DataPoint ;
    chart:series ex:series-6211-1 ;
    chart:category "W02" ;
    chart:value "0.02"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-6211-1-3 a chart:DataPoint ;
    chart:series ex:series-6211-1 ;
    chart:category "W03" ;
    chart:value "0.02"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-6211-1-4 a chart:DataPoint ;
    chart:series ex:series-6211-1 ;
    chart:category "W04" ;
    chart:value "0.11"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-6211-1-5 a chart:DataPoint ;
    chart:series ex:series-6211-1 ;
    chart:category "W05" ;
    chart:value "-0.07"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-6211-1-6 a chart:DataPoint ;
    chart:series ex:series-6211-1 ;
    chart:category "W06" ;
    chart:value "0.05"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-6211-1-7 a chart:DataPoint ;
    chart:series ex:series-6211-1 ;
    chart:category "W07" ;
    chart:value "0.05"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-6211-1-8 a chart:DataPoint ;
    chart:series ex:series-6211-1 ;
    chart:category "W08" ;
    chart:value "0.04"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-6211-1-9 a chart:DataPoint ;
    chart:series ex:series-6211-1 ;
    chart:category "W09" ;
    chart:value "0.23"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-6211-1-10 a chart:DataPoint ;
    chart:series ex:series-6211-1 ;
    chart:category "W10" ;
    chart:value "0.55"^^xsd:decimal ;
    chart:valueEstimated "true" .
