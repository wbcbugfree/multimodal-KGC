@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-4222 a chart:Chart ;
    chart:chartType "line" ;
    chart:xAxis ex:x-4222 ;
    chart:yAxis ex:y-4222 .

ex:x-4222 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2000" ;
    chart:scaleMax "2014" .

ex:y-4222 a chart:Axis ;
    chart:label "Volume in thousand litres" ;
    chart:scaleMin "0" ;
    chart:scaleMax "400000" .

ex:series-4222-1 a chart:Series .

ex:dp-4222-1-1 a chart:DataPoint ;
    chart:series ex:series-4222-1 ;
    chart:xVal "2000" ;
    chart:yVal "350000"^^xsd:decimal ;
    chart:value "350000"^^xsd:decimal ;
    chart:valueEstimated "true" .

