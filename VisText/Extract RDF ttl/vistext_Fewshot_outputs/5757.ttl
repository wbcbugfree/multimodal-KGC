@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-5757 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Change in carbon dioxide emissions in selected countries between 1990 and 2017" ;
    chart:xAxis ex:x-5757 ;
    chart:yAxis ex:y-5757 .

ex:x-5757 a chart:Axis ;
    chart:label "Change in CO2 emissions" ;
    chart:scaleMin "-0.5" ;
    chart:scaleMax "3.5" .

ex:y-5757 a chart:Axis ;
    chart:label "Country" .

ex:series-5757-1 a chart:Series .

ex:dp-5757-1-1 a chart:DataPoint ;
    chart:series ex:series-5757-1 ;
    chart:category "Australia" ;
    chart:value "0.2"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-5757-1-2 a chart:DataPoint ;
    chart:series ex:series-5757-1 ;
    chart:category "Austria" ;
    chart:value "0.1"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-5757-1-3 a chart:DataPoint ;
    chart:series ex:series-5757-1 ;
    chart:category "Canada" ;
    chart:value "0.3"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-5757-1-4 a chart:DataPoint ;
    chart:series ex:series-5757-1 ;
    chart:category "China (including Hong Kong)" ;
    chart:value "3.2"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-5757-1-5 a chart:DataPoint ;
    chart:series ex:series-5757-1 ;
    chart:category "Denmark" ;
    chart:value "-0.4"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-5757-1-6 a chart:DataPoint ;
    chart:series ex:series-5757-1 ;
    chart:category "France*" ;
    chart:value "0.05"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-5757-1-7 a chart:DataPoint ;
    chart:series ex:series-5757-1 ;
    chart:category "Germany" ;
    chart:value "0.2"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-5757-1-8 a chart:DataPoint ;
    chart:series ex:series-5757-1 ;
    chart:category "Japan" ;
    chart:value "-0.1"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-5757-1-9 a chart:DataPoint ;
    chart:series ex:series-5757-1 ;
    chart:category "Russia" ;
    chart:value "-0.3"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-5757-1-10 a chart:DataPoint ;
    chart:series ex:series-5757-1 ;
    chart:category "Spain" ;
    chart:value "0.4"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-5757-1-11 a chart:DataPoint ;
    chart:series ex:series-5757-1 ;
    chart:category "United Kingdom" ;
    chart:value "-0.3"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-5757-1-12 a chart:DataPoint ;
    chart:series ex:series-5757-1 ;
    chart:category "United States" ;
    chart:value "0.0"^^xsd:decimal ;
    chart:valueEstimated "true" .
