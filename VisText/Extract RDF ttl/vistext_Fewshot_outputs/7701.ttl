@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-7701 a chart:Chart ;
    chart:chartType "line" ;
    chart:title "Population of Finland from 2009 to 2019 , by language (in thousands)" ;
    chart:xAxis ex:x-7701 ;
    chart:yAxis ex:y-7701 .

ex:x-7701 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2009" ;
    chart:scaleMax "2019" .

ex:y-7701 a chart:Axis ;
    chart:label "Other" ;
    chart:scaleMin "0" ;
    chart:scaleMax "400" .

ex:series-7701-1 a chart:Series .

ex:dp-7701-1-1 a chart:DataPoint ;
    chart:series ex:series-7701-1 ;
    chart:xVal "2009" ;
    chart:yVal "210"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-7701-1-2 a chart:DataPoint ;
    chart:series ex:series-7701-1 ;
    chart:xVal "2010" ;
    chart:yVal "220"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-7701-1-3 a chart:DataPoint ;
    chart:series ex:series-7701-1 ;
    chart:xVal "2011" ;
    chart:yVal "240"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-7701-1-4 a chart:DataPoint ;
    chart:series ex:series-7701-1 ;
    chart:xVal "2012" ;
    chart:yVal "260"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-7701-1-5 a chart:DataPoint ;
    chart:series ex:series-7701-1 ;
    chart:xVal "2013" ;
    chart:yVal "280"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-7701-1-6 a chart:DataPoint ;
    chart:series ex:series-7701-1 ;
    chart:xVal "2014" ;
    chart:yVal "300"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-7701-1-7 a chart:DataPoint ;
    chart:series ex:series-7701-1 ;
    chart:xVal "2015" ;
    chart:yVal "320"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-7701-1-8 a chart:DataPoint ;
    chart:series ex:series-7701-1 ;
    chart:xVal "2016" ;
    chart:yVal "340"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-7701-1-9 a chart:DataPoint ;
    chart:series ex:series-7701-1 ;
    chart:xVal "2017" ;
    chart:yVal "360"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-7701-1-10 a chart:DataPoint ;
    chart:series ex:series-7701-1 ;
    chart:xVal "2018" ;
    chart:yVal "380"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-7701-1-11 a chart:DataPoint ;
    chart:series ex:series-7701-1 ;
    chart:xVal "2019" ;
    chart:yVal "400"^^xsd:decimal ;
    chart:valueEstimated "true" .
