@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-5472 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Tobacco production value worldwide in 2016 , by country (in million U.S. dollars)" ;
    chart:xAxis ex:x-5472 ;
    chart:yAxis ex:y-5472 .

ex:x-5472 a chart:Axis ;
    chart:label "Production value in million U.S. dollars**" ;
    chart:scaleMin "0" ;
    chart:scaleMax "3500" .

ex:y-5472 a chart:Axis ;
    chart:label "Country" .

ex:series-5472-1 a chart:Series .

ex:dp-5472-1-1 a chart:DataPoint ;
    chart:series ex:series-5472-1 ;
    chart:category "Brazil" ;
    chart:value "250"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-5472-1-2 a chart:DataPoint ;
    chart:series ex:series-5472-1 ;
    chart:category "China, mainland" ;
    chart:value "3000"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-5472-1-3 a chart:DataPoint ;
    chart:series ex:series-5472-1 ;
    chart:category "India" ;
    chart:value "800"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-5472-1-4 a chart:DataPoint ;
    chart:series ex:series-5472-1 ;
    chart:category "Indonesia" ;
    chart:value "200"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-5472-1-5 a chart:DataPoint ;
    chart:series ex:series-5472-1 ;
    chart:category "Italy" ;
    chart:value "150"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-5472-1-6 a chart:DataPoint ;
    chart:series ex:series-5472-1 ;
    chart:category "Japan" ;
    chart:value "400"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-5472-1-7 a chart:DataPoint ;
    chart:series ex:series-5472-1 ;
    chart:category "Mozambique" ;
    chart:value "100"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-5472-1-8 a chart:DataPoint ;
    chart:series ex:series-5472-1 ;
    chart:category "Republic of Korea" ;
    chart:value "250"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-5472-1-9 a chart:DataPoint ;
