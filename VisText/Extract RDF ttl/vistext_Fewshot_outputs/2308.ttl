@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-2308 a chart:Chart ;
    chart:chartType "line" ;
    chart:title "Soybean oil for biodiesel production in the U.S. from 2010 to 2025 (in 1,000 metric tons)" ;
    chart:xAxis ex:x-2308 ;
    chart:yAxis ex:y-2308 .

ex:x-2308 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2010" ;
    chart:scaleMax "2025" .

ex:y-2308 a chart:Axis ;
    chart:label "Soybean oil in thousand metric tons" ;
    chart:scaleMin "0" ;
    chart:scaleMax "1500" .

ex:series-2308-1 a chart:Series .

ex:dp-2308-1-1 a chart:DataPoint ;
    chart:series ex:series-2308-1 ;
    chart:xVal "2010" ;
    chart:yVal "700"^^xsd:decimal ;
    chart:valueEstimated "true" .

