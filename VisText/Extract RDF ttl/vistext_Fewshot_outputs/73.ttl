@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-73 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Share of households with internet access in Romania from 2007 to 2018" ;
    chart:xAxis ex:x-73 ;
    chart:yAxis ex:y-73 .

ex:x-73 a chart:Axis ;
    chart:label "Response" ;
    chart:scaleMin "2007" ;
    chart:scaleMax "2018" .

ex:y-73 a chart:Axis ;
    chart:label "Share of households" ;
    chart:scaleMin "0.0" ;
    chart:scaleMax "0.8" .

ex:series-73-1 a chart:Series .

ex:dp-73-1-1 a chart:DataPoint ;
    chart:series ex:series-73-1 ;
    chart:category "2007" ;
    chart:value "0.22"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-73-1-2 a chart:DataPoint ;
    chart:series ex:series-73-1 ;
    chart:category "2008" ;
    chart:value "0.3"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-73-1-3 a chart:DataPoint ;
    chart:series ex:series-73-1 ;
    chart:category "2009" ;
    chart:value "0.38"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-73-1-4 a chart:DataPoint ;
    chart:series ex:series-73-1 ;
    chart:category "2010" ;
    chart:value "0.42"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-73-1-5 a chart:DataPoint ;
    chart:series ex:series-73-1 ;
    chart:category "2011" ;
    chart:value "0.47"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-73-1-6 a chart:DataPoint ;
    chart:series ex:series-73-1 ;
    chart:category "2012" ;
    chart:value "0.55"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-73-1-7 a chart:DataPoint ;
    chart:series ex:series-73-1 ;
    chart:category "2013" ;
    chart:value "0.59"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-73-1-8 a chart:DataPoint ;
    chart:series ex:series-73-1 ;
    chart:category "2014*" ;
    chart:value "0.62"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-73-1-9 a chart:DataPoint ;
    chart:series ex:series-73-1 ;
    chart:category "2015" ;
    chart:value "0.66"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-73-1-10 a chart:DataPoint ;
    chart:series ex:series-73-1 ;
    chart:category "2016" ;
    chart:value "0.72"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-73-1-11 a chart:DataPoint ;
    chart:series ex:series-73-1 ;
    chart:category "2017" ;
    chart:value "0.77"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-73-1-12 a chart:DataPoint ;
    chart:series ex:series-73-1 ;
    chart:category "2018" ;
    chart:value "0.81"^^xsd:decimal ;
    chart:valueEstimated "true" .
