@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-1616 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Average number of persons employed at Vodafone in Germany from financial year 2007/08 to 2019/20 (in 1,000)" ;
    chart:xAxis ex:x-1616 ;
    chart:yAxis ex:y-1616 .

ex:x-1616 a chart:Axis ;
    chart:label "Employees in thousands" ;
    chart:scaleMin "0" ;
    chart:scaleMax "15" .

ex:y-1616 a chart:Axis ;
    chart:label "Business years" .

ex:series-1616-1 a chart:Series .

ex:dp-1616-1-1 a chart:DataPoint ;
    chart:series ex:series-1616-1 ;
    chart:category "2007/08" ;
    chart:value "14.5"^^xsd:decimal ;
    chart:valueEstimated "true" .

