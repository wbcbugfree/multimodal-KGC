@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-617 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Operating costs for buses in Great Britain excluding London from 2004/05 to 2018/19 (in million GBP)" ;
    chart:xAxis ex:x-617 ;
    chart:yAxis ex:y-617 .

ex:x-617 a chart:Axis ;
    chart:label "Costs in million British pounds***" ;
    chart:scaleMin "0" ;
    chart:scaleMax "4000" .

ex:y-617 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2004/05" ;
    chart:scaleMax "2018/19" .

ex:series-617-1 a chart:Series .

ex:dp-617-1-1 a chart:DataPoint ;
    chart:series ex:series-617-1 ;
    chart:category "2004/05" ;
    chart:value "1300"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-617-1-2 a chart:DataPoint ;
    chart:series ex:series-617-1 ;
    chart:category "2005/06" ;
    chart:value "1400"^^xsd:decimal ;
    chart:valueEstimated "true" .

