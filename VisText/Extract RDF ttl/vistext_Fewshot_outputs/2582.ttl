@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-2582 a chart:Chart ;
    chart:chartType "line" ;
    chart:title "Direct investment position of the United States in Central and South America from 2000 to 2019 (in billion U.S. dollars , on a historical-cost basis)" ;
    chart:xAxis ex:x-2582 ;
    chart:yAxis ex:y-2582 .

ex:x-2582 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2000" ;
    chart:scaleMax "2019" .

ex:y-2582 a chart:Axis ;
    chart:label "Direct investments in billion U.S. dollars" ;
    chart:scaleMin "0" ;
    chart:scaleMax "250" .

ex:series-2582-1 a chart:Series .

ex:dp-2582-1-1 a chart:DataPoint ;
    chart:series ex:series-2582-1 ;
    chart:xVal "2000" ;
    chart:yVal "150"^^xsd:decimal ;
    chart:value "150"^^xsd:decimal ;
    chart:valueEstimated "true" .

