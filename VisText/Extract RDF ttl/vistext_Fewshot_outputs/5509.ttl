@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-5509 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Coronavirus impact on online traffic of selected industries worldwide as of October 2020" ;
    chart:xAxis ex:x-5509 ;
    chart:yAxis ex:y-5509 .

ex:x-5509 a chart:Axis ;
    chart:label "industry" ;
    chart:scaleMin "" ;
    chart:scaleMax "" .

ex:y-5509 a chart:Axis ;
    chart:label "Change in traffic" ;
    chart:scaleMin "-0.4" ;
    chart:scaleMax "0.4" .

ex:series-5509-1 a chart:Series .

ex:dp-5509-1-1 a chart:DataPoint ;
    chart:series ex:series-5509-1 ;
    chart:category "Bank / insurance" ;
    chart:value "0.01"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-5509-1-2 a chart:DataPoint ;
    chart:series ex:series-5509-1 ;
    chart:category "Cosmetics" ;
    chart:value "0.02"^^xsd:decimal ;
    chart:valueEstimated "true" .

