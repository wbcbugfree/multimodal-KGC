@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-702 a chart:Chart ;
    chart:chartType "line" ;
    chart:xAxis ex:x-702 ;
    chart:yAxis ex:y-702 .

ex:x-702 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "1950" ;
    chart:scaleMax "2020" .

ex:y-702 a chart:Axis ;
    chart:label "Deaths per 1,000 live births" ;
    chart:scaleMin "0" ;
    chart:scaleMax "200" .

ex:series-702-1 a chart:Series .

ex:dp-702-1-1 a chart:DataPoint ;
    chart:series ex:series-702-1 ;
    chart:xVal "1950" ;
    chart:yVal "195"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-702-1-2 a chart:DataPoint ;
    chart:series ex:series-702-1 ;
    chart:xVal "1955" ;
    chart:yVal "130"^^xsd:decimal ;
    chart:valueEstimated "true" .

