@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-1886 a chart:Chart ;
    chart:chartType "line" ;
    chart:title "Import volume of candles to the European Union (EU 28) from 2009 to 2018 (in tons)" ;
    chart:xAxis ex:x-1886 ;
    chart:yAxis ex:y-1886 .

ex:x-1886 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2008" ;
    chart:scaleMax "2018" .

ex:y-1886 a chart:Axis ;
    chart:label "Imports in tons" ;
    chart:scaleMin "0" ;
    chart:scaleMax "200,000" .

ex:series-1886-1 a chart:Series .

ex:dp-1886-1-1 a chart:DataPoint ;
    chart:series ex:series-1886-1 ;
    chart:xVal "2009" ;
    chart:yVal "190000"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-1886-1-2 a chart:DataPoint ;
    chart:series ex:series-1886-1 ;
    chart:xVal "2010" ;
    chart:yVal "75000"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-1886-1-3 a chart:DataPoint ;
    chart:series ex:series-1886-1 ;
    chart:xVal "2011" ;
    chart:yVal "90000"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-1886-1-4 a chart:DataPoint ;
    chart:series ex:series-1886-1 ;
    chart:xVal "2012" ;
    chart:yVal "70000"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-1886-1-5 a chart:DataPoint ;
    chart:series ex:series-1886-1 ;
    chart:xVal "2013" ;
    chart:yVal "70000"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-1886-1-6 a chart:DataPoint ;
    chart:series ex:series-1886-1 ;
    chart:xVal "2014" ;
    chart:yVal "95000"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-1886-1-7 a chart:DataPoint ;
    chart:series ex:series-1886-1 ;
    chart:xVal "2015" ;
    chart:yVal "100000"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-1886-1-8 a chart:DataPoint ;
    chart:series ex:series-1886-1 ;
    chart:xVal "2016" ;
    chart:yVal "105000"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-1886-1-9 a chart:DataPoint ;
    chart:series ex:series-1886-1 ;
    chart:xVal "2017" ;
    chart:yVal "105000"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-1886-1-10 a chart:DataPoint ;
    chart:series ex:series-1886-1 ;
    chart:xVal "2018" ;
    chart:yVal "100000"^^xsd:decimal ;
    chart:valueEstimated "true" .
