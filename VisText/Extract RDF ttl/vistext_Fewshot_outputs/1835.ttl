@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-1835 a chart:Chart ;
    chart:chartType "line" ;
    chart:title "Forecast of the number of single-parent households in the Netherlands from 2019 to 2060" ;
    chart:xAxis ex:x-1835 ;
    chart:yAxis ex:y-1835 .

ex:x-1835 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2020" ;
    chart:scaleMax "2050" .

ex:y-1835 a chart:Axis ;
    chart:label "Number of households" ;
    chart:scaleMin "0" ;
    chart:scaleMax "600000" .

ex:series-1835-1 a chart:Series .

ex:dp-1835-1-1 a chart:DataPoint ;
    chart:series ex:series-1835-1 ;
    chart:xVal "2020" ;
    chart:yVal "520000"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-1835-1-2 a chart:DataPoint ;
    chart:series ex:series-1835-1 ;
    chart:xVal "2030" ;
    chart:yVal "550000"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-1835-1-3 a chart:DataPoint ;
    chart:series ex:series-1835-1 ;
    chart:xVal "2040" ;
    chart:yVal "570000"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-1835-1-4 a chart:DataPoint ;
    chart:series ex:series-1835-1 ;
    chart:xVal "2050" ;
    chart:yVal "580000"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-1835-1-5 a chart:DataPoint ;
    chart:series ex:series-1835-1 ;
    chart:xVal "2060" ;
    chart:yVal "590000"^^xsd:decimal ;
    chart:valueEstimated "true" .
