@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-6083 a chart:Chart ;
    chart:chartType "line" ;
    chart:title "Afghanistan : Age structure from 2009 to 2019" ;
    chart:xAxis ex:x-6083 ;
    chart:yAxis ex:y-6083 .

ex:x-6083 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2009" ;
    chart:scaleMax "2019" .

ex:y-6083 a chart:Axis ;
    chart:label "" ;
    chart:scaleMin "0.000" ;
    chart:scaleMax "0.025" .

ex:series-6083-1 a chart:Series ;
    chart:seriesName "65 and older" .

ex:dp-6083-1-1 a chart:DataPoint ;
    chart:series ex:series-6083-1 ;
    chart:xVal "2009" ;
    chart:yVal "0.024"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-6083-1-2 a chart:DataPoint ;
    chart:series ex:series-6083-1 ;
    chart:xVal "2010" ;
    chart:yVal "0.0245"^^xsd:decimal ;
    chart:valueEstimated "true" .

