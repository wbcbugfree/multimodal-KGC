@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-5615 a chart:Chart ;
    chart:chartType "line" ;
    chart:title "Total number of canoes sold in the U.S. from 2000 to 2013" ;
    chart:xAxis ex:x-5615 ;
    chart:yAxis ex:y-5615 .

ex:x-5615 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2000" ;
    chart:scaleMax "2012" .

ex:y-5615 a chart:Axis ;
    chart:label "Canoes sold" ;
    chart:scaleMin "0" ;
    chart:scaleMax "120000" .

ex:series-5615-1 a chart:Series .

ex:dp-5615-1-1 a chart:DataPoint ;
    chart:series ex:series-5615-1 ;
    chart:xVal "2000" ;
    chart:yVal "110000"^^xsd:decimal ;
    chart:value "110000"^^xsd:decimal ;
    chart:valueEstimated "true" .

