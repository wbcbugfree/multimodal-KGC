@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-568 a chart:Chart ;
    chart:chartType "line" ;
    chart:title "Number of motor vehicles produced by Fiat worldwide from 2006 to 2016 (in 1,000s units)" ;
    chart:xAxis ex:x-568 ;
    chart:yAxis ex:y-568 .

ex:x-568 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2006" ;
    chart:scaleMax "2014" .

ex:y-568 a chart:Axis ;
    chart:label "Production in thousand units" ;
    chart:scaleMin "0" ;
    chart:scaleMax "5000" .

ex:series-568-1 a chart:Series .

ex:dp-568-1-1 a chart:DataPoint ;
    chart:series ex:series-568-1 ;
    chart:xVal "2006" ;
    chart:yVal "2700"^^xsd:decimal ;
    chart:value "2700"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-568-1-2 a chart:DataPoint ;
    chart:series ex:series-568-1 ;
    chart:xVal "2008" ;
    chart:yVal "3100"^^xsd:decimal ;
    chart:value "3100"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-568-1-3 a chart:DataPoint ;
    chart:series ex:series-568-1 ;
    chart:xVal "2010" ;
    chart:yVal "2900"^^xsd:decimal ;
    chart:value "2900"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-568-1-4 a chart:DataPoint ;
    chart:series ex:series-568-1 ;
    chart:xVal "2012" ;
    chart:yVal "2500"^^xsd:decimal ;
    chart:value "2500"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-568-1-5 a chart:DataPoint ;
    chart:series ex:series-568-1 ;
    chart:xVal "2014" ;
    chart:yVal "5100"^^xsd:decimal ;
    chart:value "5100"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-568-1-6 a chart:DataPoint ;
    chart:series ex:series-568-1 ;
    chart:xVal "2016" ;
    chart:yVal "5300"^^xsd:decimal ;
    chart:value "5300"^^xsd:decimal ;
    chart:valueEstimated "true" .
