@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-7852 a chart:Chart ;
    chart:chartType "area" ;
    chart:title "Number of permanent resident refugees admitted in Canada from 2008 to 2017 , by origin area" ;
    chart:xAxis ex:x-7852 ;
    chart:yAxis ex:y-7852 .

ex:x-7852 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2008" ;
    chart:scaleMax "2017" .

ex:y-7852 a chart:Axis ;
    chart:label "Source area not stated" ;
    chart:scaleMin "0" ;
    chart:scaleMax "60" .

ex:series-7852-1 a chart:Series .

ex:dp-7852-1-1 a chart:DataPoint ;
    chart:series ex:series-7852-1 ;
    chart:xVal "2008" ;
    chart:yVal "9"^^xsd:decimal ;
    chart:value "9"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-7852-1-2 a chart:DataPoint ;
    chart:series ex:series-7852-1 ;
    chart:xVal "2009" ;
    chart:yVal "4"^^xsd:decimal ;
    chart:value "4"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-7852-1-3 a chart:DataPoint ;
    chart:series ex:series-7852-1 ;
    chart:xVal "2010" ;
    chart:yVal "12"^^xsd:decimal ;
    chart:value "12"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-7852-1-4 a chart:DataPoint ;
    chart:series ex:series-7852-1 ;
    chart:xVal "2011" ;
    chart:yVal "14"^^xsd:decimal ;
    chart:value "14"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-7852-1-5 a chart:DataPoint ;
    chart:series ex:series-7852-1 ;
    chart:xVal "2012" ;
    chart:yVal "38"^^xsd:decimal ;
    chart:value "38"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-7852-1-6 a chart:DataPoint ;
    chart:series ex:series-7852-1 ;
    chart:xVal "2013" ;
    chart:yVal "5"^^xsd:decimal ;
    chart:value "5"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-7852-1-7 a chart:DataPoint ;
    chart:series ex:series-7852-1 ;
    chart:xVal "2014" ;
    chart:yVal "6"^^xsd:decimal ;
    chart:value "6"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-7852-1-8 a chart:DataPoint ;
