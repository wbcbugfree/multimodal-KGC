@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-2105 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Volume of almonds imported to Canada from 2010/11 to 2020/21 (in 1,000 metric tons)" ;
    chart:xAxis ex:x-2105 ;
    chart:yAxis ex:y-2105 .

ex:x-2105 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2010/11" ;
    chart:scaleMax "2020/21*" .

ex:y-2105 a chart:Axis ;
    chart:label "Import volume in thousand metric tons" ;
    chart:scaleMin "0" ;
    chart:scaleMax "40" .

ex:series-2105-1 a chart:Series .

ex:dp-2105-1-1 a chart:DataPoint ;
    chart:series ex:series-2105-1 ;
    chart:category "2010/11" ;
    chart:value "28"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-2105-1-2 a chart:DataPoint ;
    chart:series ex:series-2105-1 ;
    chart:category "2011/12" ;
    chart:value "29"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-2105-1-3 a chart:DataPoint ;
    chart:series ex:series-2105-1 ;
    chart:category "2012/13" ;
    chart:value "31"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-2105-1-4 a chart:DataPoint ;
    chart:series ex:series-2105-1 ;
    chart:category "2013/14" ;
    chart:value "33"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-2105-1-5 a chart:DataPoint ;
    chart:series ex:series-2105-1 ;
    chart:category "2014/15" ;
    chart:value "34"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-2105-1-6 a chart:DataPoint ;
    chart:series ex:series-2105-1 ;
    chart:category "2015/16" ;
    chart:value "35"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-2105-1-7 a chart:DataPoint ;
    chart:series ex:series-2105-1 ;
    chart:category "2016/17" ;
    chart:value "32"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-2105-1-8 a chart:DataPoint ;
    chart:series ex:series-2105-1 ;
    chart:category "2017/18" ;
    chart:value "34"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-2105-1-9 a chart:DataPoint ;
    chart:series ex:series-2105-1 ;
    chart:category "2018/19" ;
    chart:value "30"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-2105-1-10 a chart:DataPoint ;
    chart:series ex:series-2105-1 ;
    chart:category "2019/20" ;
    chart:value "30"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-2105-1-11 a chart:DataPoint ;
    chart:series ex:series-2105-1 ;
    chart:category "2020/21*" ;
    chart:value "34"^^xsd:decimal ;
    chart:valueEstimated "true" .
