@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-1509 a chart:Chart ;
    chart:chartType "area" ;
    chart:title "Suncor Energy 's earnings per share from 2010 to 2019 (in Canadian dollars)" ;
    chart:xAxis ex:x-1509 ;
    chart:yAxis ex:y-1509 .

ex:x-1509 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2010" ;
    chart:scaleMax "2019" .

ex:y-1509 a chart:Axis ;
    chart:label "Earnings per share in Canadian dollars" ;
    chart:scaleMin "-1" ;
    chart:scaleMax "3" .

ex:series-1509-1 a chart:Series .

ex:dp-1509-1-1 a chart:DataPoint ;
    chart:series ex:series-1509-1 ;
    chart:xVal "2010" ;
    chart:yVal "2.4"^^xsd:decimal ;
    chart:value "2.4"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-1509-1-2 a chart:DataPoint ;
    chart:series ex:series-1509-1 ;
    chart:xVal "2011" ;
    chart:yVal "2.6"^^xsd:decimal ;
    chart:value "2.6"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-1509-1-3 a chart:DataPoint ;
    chart:series ex:series-1509-1 ;
    chart:xVal "2012" ;
    chart:yVal "1.8"^^xsd:decimal ;
    chart:value "1.8"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-1509-1-4 a chart:DataPoint ;
    chart:series ex:series-1509-1 ;
    chart:xVal "2013" ;
    chart:yVal "2.5"^^xsd:decimal ;
    chart:value "2.5"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-1509-1-5 a chart:DataPoint ;
    chart:series ex:series-1509-1 ;
    chart:xVal "2014" ;
    chart:yVal "0.0"^^xsd:decimal ;
    chart:value "0.0"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-1509-1-6 a chart:DataPoint ;
    chart:series ex:series-1509-1 ;
    chart:xVal "2015" ;
    chart:yVal "-0.8"^^xsd:decimal ;
    chart:value "-0.8"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-1509-1-7 a chart:DataPoint ;
    chart:series ex:series-1509-1 ;
    chart:xVal "2016" ;
    chart:yVal "0.0"^^xsd:decimal ;
    chart:value "0.0"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-1509-1-8 a chart:DataPoint ;
    chart:series ex:series-1509-1 ;
    chart:xVal "2017" ;
    chart:yVal "2.6"^^xsd:decimal ;
    chart:value "2.6"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-1509-1-9 a chart:DataPoint ;
    chart:series ex:series-1509-1 ;
    chart:xVal "2018" ;
    chart:yVal "1.9"^^xsd:decimal ;
    chart:value "1.9"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-1509-1-10 a chart:DataPoint ;
