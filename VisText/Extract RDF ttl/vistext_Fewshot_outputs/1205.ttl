@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-1205 a chart:Chart ;
    chart:chartType "line" ;
    chart:title "Infant mortality rate in Luxembourg from 2008 to 2019 (per 1,000 live births)" ;
    chart:xAxis ex:x-1205 ;
    chart:yAxis ex:y-1205 .

ex:x-1205 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2008" ;
    chart:scaleMax "2019" .

ex:y-1205 a chart:Axis ;
    chart:label "Infant mortality rate per thousand live births" ;
    chart:scaleMin "0" ;
    chart:scaleMax "5" .

ex:series-1205-1 a chart:Series .

ex:dp-1205-1-1 a chart:DataPoint ;
    chart:series ex:series-1205-1 ;
    chart:xVal "2008" ;
    chart:yVal "2.6"^^xsd:decimal ;
    chart:value "2.6"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-1205-1-2 a chart:DataPoint ;
    chart:series ex:series-1205-1 ;
    chart:xVal "2009" ;
    chart:yVal "4.3"^^xsd:decimal ;
    chart:value "4.3"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-1205-1-3 a chart:DataPoint ;
    chart:series ex:series-1205-1 ;
    chart:xVal "2010" ;
    chart:yVal "3.6"^^xsd:decimal ;
    chart:value "3.6"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-1205-1-4 a chart:DataPoint ;
    chart:series ex:series-1205-1 ;
    chart:xVal "2011" ;
    chart:yVal "3.0"^^xsd:decimal ;
    chart:value "3.0"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-1205-1-5 a chart:DataPoint ;
    chart:series ex:series-1205-1 ;
    chart:xVal "2012" ;
    chart:yVal "1.7"^^xsd:decimal ;
    chart:value "1.7"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-1205-1-6 a chart:DataPoint ;
    chart:series ex:series-1205-1 ;
    chart:xVal "2013" ;
    chart:yVal "1.7"^^xsd:decimal ;
    chart:value "1.7"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-1205-1-7 a chart:DataPoint ;
    chart:series ex:series-1205-1 ;
    chart:xVal "2014" ;
    chart:yVal "2.5"^^xsd:decimal ;
    chart:value "2.5"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-1205-1-8 a chart:DataPoint ;
    chart:series ex:series-1205-1 ;
    chart:xVal "2015" ;
    chart:yVal "2.6"^^xsd:decimal ;
    chart:value "2.6"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-1205-1-9 a chart:DataPoint ;
    chart:series ex:series-1205-1 ;
    chart:xVal "2016" ;
    chart:yVal "3.8"^^xsd:decimal ;
    chart:value "3.8"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-1205-1-10 a chart:DataPoint ;
    chart:series ex:series-1205-1 ;
    chart:xVal "2017" ;
    chart:yVal "3.1"^^xsd:decimal ;
    chart:value "3.1"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-1205-1-11 a chart:DataPoint ;
    chart:series ex:series-1205-1 ;
