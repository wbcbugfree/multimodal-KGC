@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-6847 a chart:Chart ;
    chart:chartType "line" ;
    chart:title "Average annual income in Belgium from 2006 to 2017 , by region (in euros)" ;
    chart:xAxis ex:x-6847 ;
    chart:yAxis ex:y-6847 .

ex:x-6847 a chart:Axis ;
    chart:label "Response" ;
    chart:scaleMin "2006" ;
    chart:scaleMax "2016" .

ex:y-6847 a chart:Axis ;
    chart:label "Walloon Region" ;
    chart:scaleMin "0" ;
    chart:scaleMax "15000" .

ex:series-6847-1 a chart:Series .

ex:dp-6847-1-1 a chart:DataPoint ;
    chart:series ex:series-6847-1 ;
    chart:xVal "2006" ;
    chart:yVal "12000"^^xsd:decimal ;
    chart:value "12000"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-6847-1-2 a chart:DataPoint ;
    chart:series ex:series-6847-1 ;
    chart:xVal "2008" ;
    chart:yVal "12500"^^xsd:decimal ;
    chart:value "12500"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-6847-1-3 a chart:DataPoint ;
    chart:series ex:series-6847-1 ;
    chart:xVal "2010" ;
    chart:yVal "13000"^^xsd:decimal ;
    chart:value "13000"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-6847-1-4 a chart:DataPoint ;
    chart:series ex:series-6847-1 ;
    chart:xVal "2012" ;
    chart:yVal "13500"^^xsd:decimal ;
    chart:value "13500"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-6847-1-5 a chart:DataPoint ;
    chart:series ex:series-6847-1 ;
    chart:xVal "2014" ;
    chart:yVal "14000"^^xsd:decimal ;
    chart:value "14000"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-6847-1-6 a chart:DataPoint ;
    chart:series ex:series-6847-1 ;
    chart:xVal "2016" ;
    chart:yVal "14500"^^xsd:decimal ;
    chart:value "14500"^^xsd:decimal ;
    chart:valueEstimated "true" .
