@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-3993 a chart:Chart ;
    chart:chartType "line" ;
    chart:title "Number of Subaru cars sold in Norway from 2009 to 2018" ;
    chart:xAxis ex:x-3993 ;
    chart:yAxis ex:y-3993 .

ex:x-3993 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2009" ;
    chart:scaleMax "2018" .

ex:y-3993 a chart:Axis ;
    chart:label "Units sold" ;
    chart:scaleMin "0" ;
    chart:scaleMax "4000" .

ex:series-3993-1 a chart:Series .

ex:dp-3993-1-1 a chart:DataPoint ;
    chart:series ex:series-3993-1 ;
    chart:xVal "2009" ;
    chart:yVal "2700"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-3993-1-2 a chart:DataPoint ;
    chart:series ex:series-3993-1 ;
    chart:xVal "2010" ;
    chart:yVal "3050"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-3993-1-3 a chart:DataPoint ;
    chart:series ex:series-3993-1 ;
    chart:xVal "2011" ;
    chart:yVal "2400"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-3993-1-4 a chart:DataPoint ;
    chart:series ex:series-3993-1 ;
    chart:xVal "2012" ;
    chart:yVal "3500"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-3993-1-5 a chart:DataPoint ;
    chart:series ex:series-3993-1 ;
    chart:xVal "2013" ;
    chart:yVal "3250"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-3993-1-6 a chart:DataPoint ;
    chart:series ex:series-3993-1 ;
    chart:xVal "2014" ;
    chart:yVal "2600"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-3993-1-7 a chart:DataPoint ;
    chart:series ex:series-3993-1 ;
    chart:xVal "2015" ;
    chart:yVal "3750"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-3993-1-8 a chart:DataPoint ;
    chart:series ex:series-3993-1 ;
    chart:xVal "2016" ;
    chart:yVal "2800"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-3993-1-9 a chart:DataPoint ;
    chart:series ex:series-3993-1 ;
    chart:xVal "2017" ;
    chart:yVal "2100"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-3993-1-10 a chart:DataPoint ;
    chart:series ex:series-3993-1 ;
    chart:xVal "2018" ;
    chart:yVal "1800"^^xsd:decimal ;
    chart:valueEstimated "true" .
