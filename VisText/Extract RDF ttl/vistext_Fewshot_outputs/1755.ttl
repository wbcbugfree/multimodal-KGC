    chart:series ex:series-1755-1 ;
    chart:xVal "2011" ;
    chart:yVal "10.3"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-1755-1-4 a chart:DataPoint ;
    chart:series ex:series-1755-1 ;
    chart:xVal "2012" ;
    chart:yVal "10.2"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-1755-1-5 a chart:DataPoint ;
    chart:series ex:series-1755-1 ;
    chart:xVal "2013" ;
    chart:yVal "10.2"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-1755-1-6 a chart:DataPoint ;
    chart:series ex:series-1755-1 ;
    chart:xVal "2014" ;
    chart:yVal "10.1"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-1755-1-7 a chart:DataPoint ;
    chart:series ex:series-1755-1 ;
    chart:xVal "2015" ;
    chart:yVal "10.0"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-1755-1-8 a chart:DataPoint ;
    chart:series ex:series-1755-1 ;
    chart:xVal "2016" ;
    chart:yVal "9.8"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-1755-1-9 a chart:DataPoint ;
