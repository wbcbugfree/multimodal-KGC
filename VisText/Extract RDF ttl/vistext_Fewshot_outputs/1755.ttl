@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-1755 a chart:Chart ;
    chart:chartType "line" ;
    chart:title "Proved crude oil reserves in Mexico from 2009 to 2019 (in billion barrels)" ;
    chart:xAxis ex:x-1755 ;
    chart:yAxis ex:y-1755 .

ex:x-1755 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2009" ;
    chart:scaleMax "2019" .

ex:y-1755 a chart:Axis ;
    chart:label "Oil reserves in billion barrels" ;
    chart:scaleMin "0" ;
    chart:scaleMax "11" .

ex:series-1755-1 a chart:Series .

ex:dp-1755-1-1 a chart:DataPoint ;
    chart:series ex:series-1755-1 ;
    chart:xVal "2009" ;
    chart:yVal "10.3"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-1755-1-2 a chart:DataPoint ;
    chart:series ex:series-1755-1 ;
    chart:xVal "2010" ;
    chart:yVal "10.3"^^xsd:decimal ;
    chart:valueEstimated "true" .

