@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-4052 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Net sales growth of the world 's leading 10 consumer products companies in 2013" ;
    chart:xAxis ex:x-4052 ;
    chart:yAxis ex:y-4052 .

ex:x-4052 a chart:Axis ;
    chart:label "Company (Country of origin)" ;
    chart:scaleMin "" ;
    chart:scaleMax "" .

ex:y-4052 a chart:Axis ;
    chart:label "Net sales growth" ;
    chart:scaleMin "0.00" ;
    chart:scaleMax "0.20" .

ex:series-4052-1 a chart:Series .

ex:dp-4052-1-1 a chart:DataPoint ;
    chart:series ex:series-4052-1 ;
    chart:category "Apple (United States)" ;
    chart:value "0.09"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-4052-1-2 a chart:DataPoint ;
    chart:series ex:series-4052-1 ;
    chart:category "JBS S.A. (Brazil)" ;
    chart:value "0.23"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-4052-1-3 a chart:DataPoint ;
    chart:series ex:series-4052-1 ;
    chart:category "LG Electronics" ;
    chart:value "0.14"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-4052-1-4 a chart:DataPoint ;
    chart:series ex:series-4052-1 ;
    chart:category "Nestle (Brazil)" ;
    chart:value "0.03"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-4052-1-5 a chart:DataPoint ;
    chart:series ex:series-4052-1 ;
    chart:category "PepsiCo (United States)" ;
    chart:value "0.02"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-4052-1-6 a chart:DataPoint ;
    chart:series ex:series-4052-1 ;
    chart:category "Procter & Gamble (United States)" ;
    chart:value "-0.02"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-4052-1-7 a chart:DataPoint ;
    chart:series ex:series-4052-1 ;
    chart:category "Samsung Electronics (South Korea)" ;
    chart:value "0.14"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-4052-1-8 a chart:DataPoint ;
    chart:series ex:series-4052-1 ;
    chart:category "Sony (Japan)" ;
    chart:value "0.17"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-4052-1-9 a chart:DataPoint ;
    chart:series ex:series-4052-1 ;
    chart:category "The Coca-Cola Company (United States)" ;
    chart:value "-0.02"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-4052-1-10 a chart:DataPoint ;
    chart:series ex:series-4052-1 ;
    chart:category "Unilever (Netherlands and U.K.)" ;
    chart:value "-0.02"^^xsd:decimal ;
