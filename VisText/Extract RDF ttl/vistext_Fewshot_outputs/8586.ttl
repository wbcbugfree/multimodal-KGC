@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-8586 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Monthly import value of animal feed in Canada from 2015 to 2020 (in million Canadian dollars)" ;
    chart:xAxis ex:x-8586 ;
    chart:yAxis ex:y-8586 .

ex:x-8586 a chart:Axis ;
    chart:label "Month" ;
    chart:scaleMin "" ;
    chart:scaleMax "" .

ex:y-8586 a chart:Axis ;
    chart:label "2018" ;
    chart:scaleMin "0" ;
    chart:scaleMax "150" .

ex:series-8586-1 a chart:Series .

ex:dp-8586-1-1 a chart:DataPoint ;
    chart:series ex:series-8586-1 ;
    chart:category "Apr" ;
    chart:value "145"^^xsd:decimal ;
    chart:valueEstimated "true" .

