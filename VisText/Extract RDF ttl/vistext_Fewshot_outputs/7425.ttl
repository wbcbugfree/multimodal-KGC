@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-7425 a chart:Chart ;
    chart:chartType "area" ;
    chart:title "Georgia : Age structure from 2009 to 2019" ;
    chart:xAxis ex:x-7425 ;
    chart:yAxis ex:y-7425 .

ex:x-7425 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2009" ;
    chart:scaleMax "2019" .

ex:y-7425 a chart:Axis ;
    chart:label "65 years and older" ;
    chart:scaleMin "0.00" ;
    chart:scaleMax "0.16" .

ex:series-7425-1 a chart:Series .

ex:dp-7425-1-1 a chart:DataPoint ;
    chart:series ex:series-7425-1 ;
    chart:xVal "2009" ;
    chart:yVal "0.145"^^xsd:decimal ;
    chart:value "0.145"^^xsd:decimal ;
    chart:valueEstimated "true" .

