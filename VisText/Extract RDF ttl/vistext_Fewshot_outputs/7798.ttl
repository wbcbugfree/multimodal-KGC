@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-7798 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Percentage of dedicated biotech companies in selected countries in 2014 , by application" ;
    chart:xAxis ex:x-7798 ;
    chart:yAxis ex:y-7798 .

ex:x-7798 a chart:Axis ;
    chart:label "Country" .

ex:y-7798 a chart:Axis ;
    chart:label "Natural resources" ;
    chart:scaleMin "0.00" ;
    chart:scaleMax "0.08" .

ex:series-7798-1 a chart:Series .

ex:dp-7798-1-1 a chart:DataPoint ;
    chart:series ex:series-7798-1 ;
    chart:category "Austria" ;
    chart:value "0.00"^^xsd:decimal ;
    chart:valueEstimated "true" .

