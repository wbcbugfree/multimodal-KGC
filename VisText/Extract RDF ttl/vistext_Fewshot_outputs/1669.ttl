@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-1669 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Utah Jazz all-time points leaders from 1974 to 2020" ;
    chart:xAxis ex:x-1669 ;
    chart:yAxis ex:y-1669 .

ex:x-1669 a chart:Axis ;
    chart:label "Points scored" ;
    chart:scaleMin "0" ;
    chart:scaleMax "40000" .

ex:y-1669 a chart:Axis ;
    chart:label "Jazz Player" .

ex:series-1669-1 a chart:Series .

