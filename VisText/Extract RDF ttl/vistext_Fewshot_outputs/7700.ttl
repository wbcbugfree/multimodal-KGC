@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-7700 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Population of Finland from 2009 to 2019 , by language (in thousands)" ;
    chart:xAxis ex:x-7700 ;
    chart:yAxis ex:y-7700 .

ex:x-7700 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2010" ;
    chart:scaleMax "2018" .

ex:y-7700 a chart:Axis ;
    chart:label "Swedish" ;
    chart:scaleMin "0" ;
    chart:scaleMax "300" .

ex:series-7700-1 a chart:Series .

ex:dp-7700-1-1 a chart:DataPoint ;
    chart:series ex:series-7700-1 ;
    chart:category "2010" ;
    chart:value "300"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-7700-1-2 a chart:DataPoint ;
    chart:series ex:series-7700-1 ;
    chart:category "2012" ;
    chart:value "300"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-7700-1-3 a chart:DataPoint ;
    chart:series ex:series-7700-1 ;
    chart:category "2014" ;
    chart:value "300"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-7700-1-4 a chart:DataPoint ;
    chart:series ex:series-7700-1 ;
    chart:category "2016" ;
    chart:value "300"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-7700-1-5 a chart:DataPoint ;
    chart:series ex:series-7700-1 ;
    chart:category "2018" ;
    chart:value "300"^^xsd:decimal ;
    chart:valueEstimated "true" .
