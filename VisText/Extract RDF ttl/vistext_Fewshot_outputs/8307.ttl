@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-8307 a chart:Chart ;
    chart:chartType "line" ;
    chart:title "Forecast of population growth in Iceland from 2020 to 2030 , by age group" ;
    chart:xAxis ex:x-8307 ;
    chart:yAxis ex:y-8307 .

ex:x-8307 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2020" ;
    chart:scaleMax "2030" .

ex:y-8307 a chart:Axis ;
    chart:label "" ;
    chart:scaleMin "0" ;
    chart:scaleMax "20000" .

ex:series-8307-1 a chart:Series ;
    chart:seriesName "80 years and older" .

ex:dp-8307-1-1 a chart:DataPoint ;
    chart:series ex:series-8307-1 ;
    chart:xVal "2020" ;
    chart:yVal "11000"^^xsd:decimal ;
    chart:value "11000"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-8307-1-2 a chart:DataPoint ;
    chart:series ex:series-8307-1 ;
    chart:xVal "2022" ;
    chart:yVal "11500"^^xsd:decimal ;
    chart:value "11500"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-8307-1-3 a chart:DataPoint ;
    chart:series ex:series-8307-1 ;
    chart:xVal "2024" ;
    chart:yVal "12200"^^xsd:decimal ;
    chart:value "12200"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-8307-1-4 a chart:DataPoint ;
    chart:series ex:series-8307-1 ;
    chart:xVal "2026" ;
    chart:yVal "13200"^^xsd:decimal ;
    chart:value "13200"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-8307-1-5 a chart:DataPoint ;
    chart:series ex:series-8307-1 ;
    chart:xVal "2028" ;
    chart:yVal "14500"^^xsd:decimal ;
    chart:value "14500"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-8307-1-6 a chart:DataPoint ;
    chart:series ex:series-8307-1 ;
    chart:xVal "2030" ;
    chart:yVal "16000"^^xsd:decimal ;
    chart:value "16000"^^xsd:decimal ;
    chart:valueEstimated "true" .
