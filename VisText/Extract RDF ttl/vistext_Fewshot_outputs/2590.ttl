@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-2590 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "King 's net income from 1st quarter 2012 to 4th quarter 2015 (in million U.S. dollars)" ;
    chart:xAxis ex:x-2590 ;
    chart:yAxis ex:y-2590 .

ex:x-2590 a chart:Axis ;
    chart:label "Quarter" ;
    chart:scaleMin "" ;
    chart:scaleMax "" .

ex:y-2590 a chart:Axis ;
    chart:label "Net profit/loss in million U.S. dollars" ;
    chart:scaleMin "0" ;
    chart:scaleMax "250" .

ex:series-2590-1 a chart:Series .

ex:dp-2590-1-1 a chart:DataPoint ;
    chart:series ex:series-2590-1 ;
    chart:category "Q1 '12" ;
    chart:value "0"^^xsd:decimal ;
    chart:valueEstimated "true" .

