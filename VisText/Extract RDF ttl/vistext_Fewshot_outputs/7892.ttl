@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-7892 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Interactive kiosk market revenue in the United States from 2014 to 2025 , by component (in billion U.S. dollars)" ;
    chart:xAxis ex:x-7892 ;
    chart:yAxis ex:y-7892 .

ex:x-7892 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2014" ;
    chart:scaleMax "2025*" .

ex:y-7892 a chart:Axis ;
    chart:label "Software" ;
    chart:scaleMin "0" ;
    chart:scaleMax "4" .

ex:series-7892-1 a chart:Series .

ex:dp-7892-1-1 a chart:DataPoint ;
    chart:series ex:series-7892-1 ;
    chart:category "2014" ;
    chart:value "1.4"^^xsd:decimal ;
    chart:valueEstimated "true" .

