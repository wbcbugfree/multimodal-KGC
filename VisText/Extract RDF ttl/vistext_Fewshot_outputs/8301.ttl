@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-8301 a chart:Chart ;
    chart:chartType "area" ;
    chart:title "Average age at widow (er) hood in the Netherlands from 2008 to 2018 , by gender (in years)" ;
    chart:xAxis ex:x-8301 ;
    chart:yAxis ex:y-8301 .

ex:x-8301 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2008" ;
    chart:scaleMax "2018" .

ex:y-8301 a chart:Axis ;
    chart:label "Men" ;
    chart:scaleMin "0" ;
    chart:scaleMax "80" .

ex:series-8301-1 a chart:Series ;
    chart:seriesName "Men" .

ex:dp-8301-1-1 a chart:DataPoint ;
    chart:series ex:series-8301-1 ;
    chart:xVal "2008" ;
    chart:yVal "72.5"^^xsd:decimal ;
    chart:value "72.5"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-8301-1-2 a chart:DataPoint ;
    chart:series ex:series-8301-1 ;
    chart:xVal "2010" ;
    chart:yVal "73.0"^^xsd:decimal ;
    chart:value "73.0"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-8301-1-3 a chart:DataPoint ;
    chart:series ex:series-8301-1 ;
    chart:xVal "2012" ;
    chart:yVal "73.5"^^xsd:decimal ;
    chart:value "73.5"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-8301-1-4 a chart:DataPoint ;
    chart:series ex:series-8301-1 ;
    chart:xVal "2014" ;
    chart:yVal "74.0"^^xsd:decimal ;
    chart:value "74.0"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-8301-1-5 a chart:DataPoint ;
    chart:series ex:series-8301-1 ;
    chart:xVal "2016" ;
    chart:yVal "74.5"^^xsd:decimal ;
    chart:value "74.5"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-8301-1-6 a chart:DataPoint ;
    chart:series ex:series-8301-1 ;
    chart:xVal "2018" ;
    chart:yVal "75.0"^^xsd:decimal ;
    chart:value "75.0"^^xsd:decimal ;
    chart:valueEstimated "true" .
