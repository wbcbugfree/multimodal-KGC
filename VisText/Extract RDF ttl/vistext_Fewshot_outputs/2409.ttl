@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-2409 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Most trusted institutions to tell the truth about the coronavirus (COVID-19) in Brazil in March 2020" ;
    chart:xAxis ex:x-2409 ;
    chart:yAxis ex:y-2409 .

ex:x-2409 a chart:Axis ;
    chart:label "Share of respondents" ;
    chart:scaleMin "0.0" ;
    chart:scaleMax "1.0" .

ex:y-2409 a chart:Axis ;
    chart:label "Response" .

ex:series-2409-1 a chart:Series .

ex:dp-2409-1-1 a chart:DataPoint ;
    chart:series ex:series-2409-1 ;
    chart:category "A person like yourself" ;
    chart:value "0.48"^^xsd:decimal ;
    chart:valueEstimated "true" .

