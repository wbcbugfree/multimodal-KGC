@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-3777 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Chicago White Sox all-time home run leaders as of October 2020" ;
    chart:xAxis ex:x-3777 ;
    chart:yAxis ex:y-3777 .

ex:x-3777 a chart:Axis ;
    chart:label "Home run leader" .

ex:y-3777 a chart:Axis ;
    chart:label "Number of home runs" ;
    chart:scaleMin "0" ;
    chart:scaleMax "400" .

ex:series-3777-1 a chart:Series .

ex:dp-3777-1-1 a chart:DataPoint ;
    chart:series ex:series-3777-1 ;
    chart:category "Bill Melton" ;
    chart:value "160"^^xsd:decimal ;
    chart:valueEstimated "true" .

