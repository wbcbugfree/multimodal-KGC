@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-6798 a chart:Chart ;
    chart:chartType "line" ;
    chart:title "Total population of Argentina from 2008 to 2018 , by gender (in million inhabitants)" ;
    chart:xAxis ex:x-6798 ;
    chart:yAxis ex:y-6798 .

ex:x-6798 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2008" ;
    chart:scaleMax "2018" .

ex:y-6798 a chart:Axis ;
    chart:label "Total" ;
    chart:scaleMin "0" ;
    chart:scaleMax "40" .

ex:series-6798-1 a chart:Series .

ex:dp-6798-1-1 a chart:DataPoint ;
    chart:series ex:series-6798-1 ;
    chart:xVal "2008" ;
    chart:yVal "40.5"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-6798-1-2 a chart:DataPoint ;
    chart:series ex:series-6798-1 ;
    chart:xVal "2010" ;
    chart:yVal "41.2"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-6798-1-3 a chart:DataPoint ;
    chart:series ex:series-6798-1 ;
    chart:xVal "2012" ;
    chart:yVal "42.0"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-6798-1-4 a chart:DataPoint ;
    chart:series ex:series-6798-1 ;
    chart:xVal "2014" ;
    chart:yVal "42.8"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-6798-1-5 a chart:DataPoint ;
    chart:series ex:series-6798-1 ;
    chart:xVal "2016" ;
    chart:yVal "43.5"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-6798-1-6 a chart:DataPoint ;
    chart:series ex:series-6798-1 ;
    chart:xVal "2018" ;
    chart:yVal "44.2"^^xsd:decimal ;
    chart:valueEstimated "true" .
