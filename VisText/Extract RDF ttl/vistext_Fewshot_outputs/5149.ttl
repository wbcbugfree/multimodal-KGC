@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-5149 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Leading cotton producing countries worldwide in 2019/2020 (in 1,000 metric tons)" ;
    chart:xAxis ex:x-5149 ;
    chart:yAxis ex:y-5149 .

ex:x-5149 a chart:Axis ;
    chart:label "Production in thousand metric tons" ;
    chart:scaleMin "0" ;
    chart:scaleMax "6000" .

ex:y-5149 a chart:Axis ;
    chart:label "Country" ;
    chart:scaleMin "" ;
    chart:scaleMax "" .

ex:series-5149-1 a chart:Series .

ex:dp-5149-1-1 a chart:DataPoint ;
    chart:series ex:series-5149-1 ;
    chart:category "Argentina" ;
    chart:value "250"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-5149-1-2 a chart:DataPoint ;
    chart:series ex:series-5149-1 ;
    chart:category "Brazil" ;
    chart:value "1200"^^xsd:decimal ;
    chart:valueEstimated "true" .

