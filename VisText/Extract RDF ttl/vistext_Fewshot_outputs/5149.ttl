    chart:series ex:series-5149-1 ;
    chart:category "Greece" ;
    chart:value "350"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-5149-1-5 a chart:DataPoint ;
    chart:series ex:series-5149-1 ;
    chart:category "India" ;
    chart:value "6100"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-5149-1-6 a chart:DataPoint ;
