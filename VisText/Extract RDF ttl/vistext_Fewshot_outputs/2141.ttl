@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-2141 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "B2C e-commerce as percentage of GDP in Japan from 2009 to 2018" ;
    chart:xAxis ex:x-2141 ;
    chart:yAxis ex:y-2141 .

ex:x-2141 a chart:Axis ;
    chart:label "Percentage of gross domestic product" ;
    chart:scaleMin "0.000" ;
    chart:scaleMax "0.015" .

ex:y-2141 a chart:Axis ;
    chart:label "Response" ;
    chart:scaleMin "" ;
    chart:scaleMax "" .

ex:series-2141-1 a chart:Series .

ex:dp-2141-1-1 a chart:DataPoint ;
    chart:series ex:series-2141-1 ;
    chart:category "2018*" ;
    chart:value "0.017"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-2141-1-2 a chart:DataPoint ;
    chart:series ex:series-2141-1 ;
    chart:category "2017*" ;
    chart:value "0.0155"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-2141-1-3 a chart:DataPoint ;
    chart:series ex:series-2141-1 ;
    chart:category "2016*" ;
    chart:value "0.013"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-2141-1-4 a chart:DataPoint ;
    chart:series ex:series-2141-1 ;
    chart:category "2015*" ;
    chart:value "0.0115"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-2141-1-5 a chart:DataPoint ;
    chart:series ex:series-2141-1 ;
    chart:category "2014*" ;
    chart:value "0.0095"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-2141-1-6 a chart:DataPoint ;
    chart:series ex:series-2141-1 ;
    chart:category "2013" ;
    chart:value "0.0075"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-2141-1-7 a chart:DataPoint ;
    chart:series ex:series-2141-1 ;
    chart:category "2012" ;
    chart:value "0.0065"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-2141-1-8 a chart:DataPoint ;
    chart:series ex:series-2141-1 ;
    chart:category "2011" ;
    chart:value "0.0055"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-2141-1-9 a chart:DataPoint ;
    chart:series ex:series-2141-1 ;
    chart:category "2010" ;
    chart:value "0.0045"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-2141-1-10 a chart:DataPoint ;
    chart:series ex:series-2141-1 ;
    chart:category "2009" ;
    chart:value "0.0035"^^xsd:decimal ;
    chart:valueEstimated "true" .
