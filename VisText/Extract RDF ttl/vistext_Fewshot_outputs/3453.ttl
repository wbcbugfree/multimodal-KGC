    chart:scaleMin "" ;
    chart:scaleMax "" .

ex:y-3453 a chart:Axis ;
    chart:label "Rushing yards" ;
    chart:scaleMin "0" ;
    chart:scaleMax "10000" .

ex:series-3453-1 a chart:Series .

