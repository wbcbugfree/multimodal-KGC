@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-3028 a chart:Chart ;
    chart:chartType "line" ;
    chart:title "Electricity generation from coal in the United States from 2008 to 2019 (in million megawatt hours)" ;
    chart:xAxis ex:x-3028 ;
    chart:yAxis ex:y-3028 .

ex:x-3028 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2008" ;
    chart:scaleMax "2019" .

ex:y-3028 a chart:Axis ;
    chart:label "Net generation in million megawatt hours" ;
    chart:scaleMin "0" ;
    chart:scaleMax "2000" .

ex:series-3028-1 a chart:Series .

ex:dp-3028-1-1 a chart:DataPoint ;
    chart:series ex:series-3028-1 ;
    chart:xVal "2008" ;
    chart:yVal "1980"^^xsd:decimal ;
    chart:value "1980"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-3028-1-2 a chart:DataPoint ;
    chart:series ex:series-3028-1 ;
    chart:xVal "2009" ;
    chart:yVal "1850"^^xsd:decimal ;
    chart:value "1850"^^xsd:decimal ;
    chart:valueEstimated "true" .

