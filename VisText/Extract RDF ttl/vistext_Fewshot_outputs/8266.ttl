@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-8266 a chart:Chart ;
    chart:chartType "line" ;
    chart:title "Selected sawtimber stumpage prices in the U.S. from 2002 to 2015 , by species in U.S. dollars per 1,000 board feet)" ;
    chart:xAxis ex:x-8266 ;
    chart:yAxis ex:y-8266 .

ex:x-8266 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2004" ;
    chart:scaleMax "2014" .

ex:y-8266 a chart:Axis ;
    chart:label "Oak, white, red ad black" ;
    chart:scaleMin "0" ;
    chart:scaleMax "400" .

ex:series-8266-1 a chart:Series .

ex:dp-8266-1-1 a chart:DataPoint ;
    chart:series ex:series-8266-1 ;
    chart:xVal "2004" ;
    chart:yVal "300"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-8266-1-2 a chart:DataPoint ;
    chart:series ex:series-8266-1 ;
    chart:xVal "2005" ;
    chart:yVal "330"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-8266-1-3 a chart:DataPoint ;
    chart:series ex:series-8266-1 ;
    chart:xVal "2006" ;
    chart:yVal "190"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-8266-1-4 a chart:DataPoint ;
    chart:series ex:series-8266-1 ;
    chart:xVal "2007" ;
    chart:yVal "220"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-8266-1-5 a chart:DataPoint ;
    chart:series ex:series-8266-1 ;
    chart:xVal "2008" ;
    chart:yVal "160"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-8266-1-6 a chart:DataPoint ;
    chart:series ex:series-8266-1 ;
    chart:xVal "2009" ;
    chart:yVal "120"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-8266-1-7 a chart:DataPoint ;
    chart:series ex:series-8266-1 ;
    chart:xVal "2010" ;
    chart:yVal "220"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-8266-1-8 a chart:DataPoint ;
    chart:series ex:series-8266-1 ;
    chart:xVal "2011" ;
    chart:yVal "100"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-8266-1-9 a chart:DataPoint ;
    chart:series ex:series-8266-1 ;
    chart:xVal "2012" ;
    chart:yVal "390"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-8266-1-10 a chart:DataPoint ;
