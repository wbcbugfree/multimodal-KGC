@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-1830 a chart:Chart ;
    chart:chartType "area" ;
    chart:title "Total sales floor space of Fast Retailing worldwide from fiscal year 2010 to 2019 (in square-meters)" ;
    chart:xAxis ex:x-1830 ;
    chart:yAxis ex:y-1830 .

ex:x-1830 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2010" ;
    chart:scaleMax "2019" .

ex:y-1830 a chart:Axis ;
    chart:label "Sales floor space in n square-meters" ;
    chart:scaleMin "0" ;
    chart:scaleMax "3000000" .

ex:series-1830-1 a chart:Series .

ex:dp-1830-1-1 a chart:DataPoint ;
    chart:series ex:series-1830-1 ;
    chart:xVal "2010" ;
    chart:yVal "700000"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-1830-1-2 a chart:DataPoint ;
    chart:series ex:series-1830-1 ;
    chart:xVal "2011" ;
    chart:yVal "900000"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-1830-1-3 a chart:DataPoint ;
    chart:series ex:series-1830-1 ;
    chart:xVal "2012" ;
    chart:yVal "1000000"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-1830-1-4 a chart:DataPoint ;
    chart:series ex:series-1830-1 ;
    chart:xVal "2013" ;
    chart:yVal "1200000"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-1830-1-5 a chart:DataPoint ;
    chart:series ex:series-1830-1 ;
    chart:xVal "2014" ;
    chart:yVal "1900000"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-1830-1-6 a chart:DataPoint ;
    chart:series ex:series-1830-1 ;
    chart:xVal "2015" ;
    chart:yVal "2100000"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-1830-1-7 a chart:DataPoint ;
    chart:series ex:series-1830-1 ;
    chart:xVal "2016" ;
    chart:yVal "2200000"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-1830-1-8 a chart:DataPoint ;
    chart:series ex:series-1830-1 ;
    chart:xVal "2017" ;
    chart:yVal "2400000"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-1830-1-9 a chart:DataPoint ;
    chart:series ex:series-1830-1 ;
    chart:xVal "2018" ;
    chart:yVal "2700000"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-1830-1-10 a chart:DataPoint ;
    chart:series ex:series-1830-1 ;
    chart:xVal "2019" ;
    chart:yVal "2900000"^^xsd:decimal ;
    chart:valueEstimated "true" .
