@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-6244 a chart:Chart ;
    chart:chartType "line" ;
    chart:title "Mobility in selected cities between March 3 , 2020 and December 7 , 2020 , compared with movement prior to the coronavirus outbreak" ;
    chart:xAxis ex:x-6244 ;
    chart:yAxis ex:y-6244 .

ex:x-6244 a chart:Axis ;
    chart:label "Response" ;
    chart:scaleMin "April" ;
    chart:scaleMax "October" .

ex:y-6244 a chart:Axis ;
    chart:label "Moscow" ;
    chart:scaleMin "0.0" ;
    chart:scaleMax "1.2" .

ex:series-6244-1 a chart:Series .

ex:dp-6244-1-1 a chart:DataPoint ;
    chart:series ex:series-6244-1 ;
    chart:xVal "April" ;
    chart:yVal "1.18"^^xsd:decimal ;
    chart:valueEstimated "true" .

