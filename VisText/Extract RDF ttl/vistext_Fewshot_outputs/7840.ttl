@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-7840 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Preferred number of TV show episodes to watch in one binge watching session among Millennials in the United Kingdom (UK) in December 2016" ;
    chart:xAxis ex:x-7840 ;
    chart:yAxis ex:y-7840 .

ex:x-7840 a chart:Axis ;
    chart:label "Response" .

ex:y-7840 a chart:Axis ;
    chart:label "25-39 years" ;
    chart:scaleMin "0.00" ;
    chart:scaleMax "0.15" .

ex:series-7840-1 a chart:Series .

ex:dp-7840-1-1 a chart:DataPoint ;
    chart:series ex:series-7840-1 ;
    chart:category "1 episode" ;
    chart:value "0.025"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-7840-1-2 a chart:DataPoint ;
    chart:series ex:series-7840-1 ;
    chart:category "10 episodes" ;
    chart:value "0.035"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-7840-1-3 a chart:DataPoint ;
    chart:series ex:series-7840-1 ;
    chart:category "2 episodes" ;
    chart:value "0.06"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-7840-1-4 a chart:DataPoint ;
    chart:series ex:series-7840-1 ;
    chart:category "3 episodes" ;
    chart:value "0.165"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-7840-1-5 a chart:DataPoint ;
    chart:series ex:series-7840-1 ;
    chart:category "4 episodes" ;
    chart:value "0.155"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-7840-1-6 a chart:DataPoint ;
    chart:series ex:series-7840-1 ;
    chart:category "5 episodes" ;
    chart:value "0.145"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-7840-1-7 a chart:DataPoint ;
    chart:series ex:series-7840-1 ;
    chart:category "6 episodes" ;
    chart:value "0.085"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-7840-1-8 a chart:DataPoint ;
    chart:series ex:series-7840-1 ;
    chart:category "7 episodes" ;
    chart:value "0.025"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-7840-1-9 a chart:DataPoint ;
    chart:series ex:series-7840-1 ;
    chart:category "8 episodes" ;
    chart:value "0.05"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-7840-1-10 a chart:DataPoint ;
    chart:series ex:series-7840-1 ;
    chart:category "9 episodes" ;
    chart:value "0.01"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-7840-1-11 a chart:DataPoint ;
