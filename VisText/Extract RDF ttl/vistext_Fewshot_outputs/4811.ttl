@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-4811 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Length of the average working week of all employees in the United States in November 2020 , by industry" ;
    chart:xAxis ex:x-4811 ;
    chart:yAxis ex:y-4811 .

ex:x-4811 a chart:Axis ;
    chart:label "Hours of work" ;
    chart:scaleMin "0" ;
    chart:scaleMax "40" .

ex:y-4811 a chart:Axis ;
    chart:label "industry" .

ex:series-4811-1 a chart:Series .

ex:dp-4811-1-1 a chart:DataPoint ;
    chart:series ex:series-4811-1 ;
    chart:category "Construction" ;
    chart:value "39.5"^^xsd:decimal ;
    chart:valueEstimated "true" .

