@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-796 a chart:Chart ;
    chart:chartType "line" ;
    chart:title "Iran : Fertility rate from 2008 to 2018" ;
    chart:xAxis ex:x-796 ;
    chart:yAxis ex:y-796 .

ex:x-796 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2008" ;
    chart:scaleMax "2018" .

ex:y-796 a chart:Axis ;
    chart:label "Fertility rate" ;
    chart:scaleMin "0.000" ;
    chart:scaleMax "0.020" .

ex:series-796-1 a chart:Series .

ex:dp-796-1-1 a chart:DataPoint ;
    chart:series ex:series-796-1 ;
    chart:xVal "2008" ;
    chart:yVal "0.0175"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-796-1-2 a chart:DataPoint ;
    chart:series ex:series-796-1 ;
    chart:xVal "2010" ;
    chart:yVal "0.018"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-796-1-3 a chart:DataPoint ;
    chart:series ex:series-796-1 ;
    chart:xVal "2012" ;
    chart:yVal "0.0185"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-796-1-4 a chart:DataPoint ;
    chart:series ex:series-796-1 ;
    chart:xVal "2014" ;
    chart:yVal "0.019"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-796-1-5 a chart:DataPoint ;
    chart:series ex:series-796-1 ;
    chart:xVal "2016" ;
    chart:yVal "0.0195"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-796-1-6 a chart:DataPoint ;
    chart:series ex:series-796-1 ;
    chart:xVal "2018" ;
    chart:yVal "0.020"^^xsd:decimal ;
    chart:valueEstimated "true" .
