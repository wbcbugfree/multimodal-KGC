@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-4245 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Leading video gaming markets in Africa in 2018 , by revenue (in million U.S. dollars)" ;
    chart:xAxis ex:x-4245 ;
    chart:yAxis ex:y-4245 .

ex:x-4245 a chart:Axis ;
    chart:label "Country" .

ex:y-4245 a chart:Axis ;
    chart:label "Revenue in million U.S. dollars" ;
    chart:scaleMin "0" ;
    chart:scaleMax "300" .

ex:series-4245-1 a chart:Series .

ex:dp-4245-1-1 a chart:DataPoint ;
    chart:series ex:series-4245-1 ;
    chart:category "Algeria" ;
    chart:value "102"^^xsd:decimal ;
    chart:valueEstimated "true" .

