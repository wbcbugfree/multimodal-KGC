@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-3102 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Number of persons with migration background in Germany in 2019 , by gender (in 1,000)" ;
    chart:xAxis ex:x-3102 ;
    chart:yAxis ex:y-3102 .

ex:x-3102 a chart:Axis ;
    chart:label "Number of persons in thousands" ;
    chart:scaleMin "0" ;
    chart:scaleMax "12000" .

ex:y-3102 a chart:Axis ;
    chart:label "Migration Background" .

ex:series-3102-1 a chart:Series .

ex:mark-3102-1-1 a chart:DataPoint ;
    chart:series ex:series-3102-1 ;
    chart:category "Among these: foreign men with o..." ;
    chart:value "4000"^^xsd:decimal ;
    chart:valueEstimated "true" .

