@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-4699 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Regional crime rate in Germany in 2019 (per 100,000 people)" ;
    chart:xAxis ex:x-4699 ;
    chart:yAxis ex:y-4699 .

ex:x-4699 a chart:Axis ;
    chart:label "Crime rate per 100 thousand people" ;
    chart:scaleMin "0" ;
    chart:scaleMax "14000" .

ex:y-4699 a chart:Axis ;
    chart:label "Country" ;
    chart:scaleMin "" ;
    chart:scaleMax "" .

ex:series-4699-1 a chart:Series .

ex:dp-4699-1-1 a chart:DataPoint ;
    chart:series ex:series-4699-1 ;
    chart:category "Baden-Württemberg" ;
    chart:value "5000"^^xsd:decimal ;
    chart:valueEstimated "true" .

