@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-5972 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Average turnaround time across major ports in India from financial year 1991 to 2019 (in days)" ;
    chart:xAxis ex:x-5972 ;
    chart:yAxis ex:y-5972 .

ex:x-5972 a chart:Axis ;
    chart:label "military budget" ;
    chart:scaleMin "" ;
    chart:scaleMax "" .

ex:y-5972 a chart:Axis ;
    chart:label "Average turnaround time in days" ;
    chart:scaleMin "0" ;
    chart:scaleMax "8" .

ex:series-5972-1 a chart:Series .

ex:dp-5972-1-1 a chart:DataPoint ;
    chart:series ex:series-5972-1 ;
    chart:category "FY 1991" ;
    chart:value "8.1"^^xsd:decimal ;
    chart:valueEstimated "true" .

