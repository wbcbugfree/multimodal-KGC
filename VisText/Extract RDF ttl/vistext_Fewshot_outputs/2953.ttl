@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-2953 a chart:Chart ;
    chart:chartType "line" ;
    chart:title "Number of cumulative cases of coronavirus (COVID-19) worldwide from January 22 , 2020 to January 5 , 2021 , by day" ;
    chart:xAxis ex:x-2953 ;
    chart:yAxis ex:y-2953 .

ex:x-2953 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2020-01-22" ;
    chart:scaleMax "2021-01-05" .

ex:y-2953 a chart:Axis ;
    chart:label "Number of cumulative cases" ;
    chart:scaleMin "0" ;
    chart:scaleMax "80000000" .

ex:series-2953-1 a chart:Series .

ex:dp-2953-1-1 a chart:DataPoint ;
    chart:series ex:series-2953-1 ;
    chart:xVal "2020-01-22" ;
    chart:yVal "0"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:dp-2953-1-2 a chart:DataPoint ;
    chart:series ex:series-2953-1 ;
    chart:xVal "2020-04-01" ;
    chart:yVal "1000000"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:dp-2953-1-3 a chart:DataPoint ;
    chart:series ex:series-2953-1 ;
    chart:xVal "2020-07-01" ;
    chart:yVal "10000000"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:dp-2953-1-4 a chart:DataPoint ;
    chart:series ex:series-2953-1 ;
    chart:xVal "2020-10-01" ;
    chart:yVal "40000000"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:dp-2953-1-5 a chart:DataPoint ;
    chart:series ex:series-2953-1 ;
    chart:xVal "2021-01-01" ;
    chart:yVal "80000000"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:dp-2953-1-6 a chart:DataPoint ;
    chart:series ex:series-2953-1 ;
    chart:xVal "2021-01-05" ;
    chart:yVal "83000000"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .
