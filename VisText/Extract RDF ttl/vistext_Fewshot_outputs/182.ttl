@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-182 a chart:Chart ;
    chart:chartType "area" ;
    chart:title "Number of students enrolled in colleges in Canada from 2000 to 2018" ;
    chart:xAxis ex:x-182 ;
    chart:yAxis ex:y-182 .

ex:x-182 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2000" ;
    chart:scaleMax "2018" .

ex:y-182 a chart:Axis ;
    chart:label "Number of students" ;
    chart:scaleMin "0" ;
    chart:scaleMax "800000" .

ex:series-182-1 a chart:Series .

ex:dp-182-1-1 a chart:DataPoint ;
    chart:series ex:series-182-1 ;
    chart:xVal "2000" ;
    chart:yVal "530000"^^xsd:decimal ;
    chart:valueEstimated "true" .

