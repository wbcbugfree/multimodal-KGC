@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-8207 a chart:Chart ;
    chart:chartType "area" ;
    chart:title "Liberia : Age structure from 2009 to 2019" ;
    chart:xAxis ex:x-8207 ;
    chart:yAxis ex:y-8207 .

ex:x-8207 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2009" ;
    chart:scaleMax "2019" .

ex:y-8207 a chart:Axis ;
    chart:label "15-64 years" ;
    chart:scaleMin "0.0" ;
    chart:scaleMax "0.6" .

ex:series-8207-1 a chart:Series .

ex:dp-8207-1-1 a chart:DataPoint ;
    chart:series ex:series-8207-1 ;
    chart:xVal "2009" ;
    chart:yVal "0.53"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-8207-1-2 a chart:DataPoint ;
    chart:series ex:series-8207-1 ;
    chart:xVal "2011" ;
    chart:yVal "0.535"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-8207-1-3 a chart:DataPoint ;
    chart:series ex:series-8207-1 ;
    chart:xVal "2013" ;
    chart:yVal "0.54"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-8207-1-4 a chart:DataPoint ;
    chart:series ex:series-8207-1 ;
    chart:xVal "2015" ;
    chart:yVal "0.545"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-8207-1-5 a chart:DataPoint ;
    chart:series ex:series-8207-1 ;
    chart:xVal "2017" ;
    chart:yVal "0.55"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-8207-1-6 a chart:DataPoint ;
    chart:series ex:series-8207-1 ;
    chart:xVal "2019" ;
    chart:yVal "0.555"^^xsd:decimal ;
    chart:valueEstimated "true" .
