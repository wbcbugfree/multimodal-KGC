@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-8541 a chart:Chart ;
    chart:chartType "line" ;
    chart:title "Global box office revenue from 2004 to 2019 , by region (in billion U.S. dollars)" ;
    chart:xAxis ex:x-8541 ;
    chart:yAxis ex:y-8541 .

ex:x-8541 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2004" ;
    chart:scaleMax "2019" .

ex:y-8541 a chart:Axis ;
    chart:label "Asia Pacific" ;
    chart:scaleMin "0" ;
    chart:scaleMax "20" .

ex:series-8541-1 a chart:Series .

ex:dp-8541-1-1 a chart:DataPoint ;
    chart:series ex:series-8541-1 ;
    chart:xVal "2004" ;
    chart:yVal "8.5"^^xsd:decimal ;
    chart:value "8.5"^^xsd:decimal ;
    chart:valueEstimated "true" .

