@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-4691 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Ranking the 20 countries with the most murders per 100,000 inhabitants in 2017" ;
    chart:xAxis ex:x-4691 ;
    chart:yAxis ex:y-4691 .

ex:x-4691 a chart:Axis ;
    chart:label "Country" ;
    chart:scaleMin "" ;
    chart:scaleMax "" .

ex:y-4691 a chart:Axis ;
    chart:label "Average number of murders per 100,000 inhabitants" ;
    chart:scaleMin "0" ;
    chart:scaleMax "60" .

ex:series-4691-1 a chart:Series .

