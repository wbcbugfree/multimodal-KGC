@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-8492 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Total circulation of community newspapers in Canada from 2013 to 2019 , by province and territory (in 1,000s)" ;
    chart:xAxis ex:x-8492 ;
    chart:yAxis ex:y-8492 .

ex:x-8492 a chart:Axis ;
    chart:label "2015" ;
    chart:scaleMin "0" ;
    chart:scaleMax "9000" .

ex:y-8492 a chart:Axis ;
    chart:label "province of Canada" ;
    chart:scaleMin "" ;
    chart:scaleMax "" .

ex:series-8492-1 a chart:Series .

ex:dp-8492-1-1 a chart:DataPoint ;
    chart:series ex:series-8492-1 ;
    chart:category "Alberta" ;
    chart:value "1500"^^xsd:decimal ;
    chart:valueEstimated "true" .

