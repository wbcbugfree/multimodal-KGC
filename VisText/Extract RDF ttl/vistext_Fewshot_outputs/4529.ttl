@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-4529 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Most in-demand professions in Spain in 2019, by category" ;
    chart:xAxis ex:x-4529 ;
    chart:yAxis ex:y-4529 .

ex:x-4529 a chart:Axis ;
    chart:label "Share of jobs offered" ;
    chart:scaleMin "0.000" ;
    chart:scaleMax "0.030" .

ex:y-4529 a chart:Axis ;
    chart:label "Response" .

ex:series-4529-1 a chart:Series .

ex:dp-4529-1-1 a chart:DataPoint ;
    chart:series ex:series-4529-1 ;
    chart:category "Accounting technician" ;
    chart:value "0.013"^^xsd:decimal ;
