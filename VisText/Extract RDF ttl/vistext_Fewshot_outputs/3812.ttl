@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-3812 a chart:Chart ;
    chart:chartType "line" ;
    chart:xAxis ex:x-3812 ;
    chart:yAxis ex:y-3812 .

ex:x-3812 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2010" ;
    chart:scaleMax "2018" .

ex:y-3812 a chart:Axis ;
    chart:label "Deaths per 1,000 live births" ;
    chart:scaleMin "0" ;
    chart:scaleMax "80" .

ex:series-3812-1 a chart:Series .

ex:dp-3812-1-1 a chart:DataPoint ;
    chart:series ex:series-3812-1 ;
    chart:xVal "2010" ;
    chart:yVal "70"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-3812-1-2 a chart:DataPoint ;
    chart:series ex:series-3812-1 ;
    chart:xVal "2012" ;
    chart:yVal "67"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-3812-1-3 a chart:DataPoint ;
    chart:series ex:series-3812-1 ;
    chart:xVal "2014" ;
    chart:yVal "64"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-3812-1-4 a chart:DataPoint ;
    chart:series ex:series-3812-1 ;
    chart:xVal "2016" ;
    chart:yVal "61"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-3812-1-5 a chart:DataPoint ;
    chart:series ex:series-3812-1 ;
    chart:xVal "2018" ;
    chart:yVal "58"^^xsd:decimal ;
    chart:valueEstimated "true" .
