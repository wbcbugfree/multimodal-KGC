@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-5285 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Most viewed movie trailers on YouTube in 2014 (in millions)" ;
    chart:xAxis ex:x-5285 ;
    chart:yAxis ex:y-5285 .

ex:x-5285 a chart:Axis ;
    chart:label "Number of YouTube views in millions" ;
    chart:scaleMin "0" ;
    chart:scaleMax "70" .

ex:y-5285 a chart:Axis ;
    chart:label "film" .

ex:series-5285-1 a chart:Series .

ex:dp-5285-1-1 a chart:DataPoint ;
    chart:series ex:series-5285-1 ;
    chart:category "Fifty Shades Of Grey - Official Trai..." ;
    chart:value "67"^^xsd:decimal ;
