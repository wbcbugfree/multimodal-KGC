@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-4737 a chart:Chart ;
    chart:chartType "bar" ;
    chart:xAxis ex:x-4737 ;
    chart:yAxis ex:y-4737 .

ex:x-4737 a chart:Axis ;
    chart:label "airline" ;
    chart:scaleMin "0" ;
    chart:scaleMax "100000" .

ex:y-4737 a chart:Axis ;
    chart:label "Advertising and promotion costs in thousand GBP" ;
    chart:scaleMin "" ;
    chart:scaleMax "" .

ex:series-4737-1 a chart:Series .

ex:dp-4737-1-1 a chart:DataPoint ;
    chart:series ex:series-4737-1 ;
    chart:category "Atlantic Airlines Ltd" ;
    chart:value "75000"^^xsd:decimal ;
    chart:valueEstimated "true" .

