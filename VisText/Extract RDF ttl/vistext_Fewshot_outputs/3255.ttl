@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-3255 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Number of births in Ontario , Canada from 2001 to 2020" ;
    chart:xAxis ex:x-3255 ;
    chart:yAxis ex:y-3255 .

ex:x-3255 a chart:Axis ;
    chart:label "Number of births" ;
    chart:scaleMin "0" ;
    chart:scaleMax "150,000" .

ex:y-3255 a chart:Axis ;
    chart:label "Year" .

ex:series-3255-1 a chart:Series .

ex:dp-3255-1-1 a chart:DataPoint ;
    chart:series ex:series-3255-1 ;
    chart:category "2000-2001" ;
    chart:value "125000"^^xsd:decimal ;
    chart:valueEstimated "true" .

