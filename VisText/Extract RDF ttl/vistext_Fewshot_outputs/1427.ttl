@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-1427 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "E-Government Development Index (EGDI) in selected Latin American countries in 2018 (index rating)" ;
    chart:xAxis ex:x-1427 ;
    chart:yAxis ex:y-1427 .

ex:x-1427 a chart:Axis ;
    chart:label "Index score" ;
    chart:scaleMin "0.0" ;
    chart:scaleMax "0.8" .

ex:y-1427 a chart:Axis ;
    chart:label "Country" ;
    chart:scaleMin "" ;
