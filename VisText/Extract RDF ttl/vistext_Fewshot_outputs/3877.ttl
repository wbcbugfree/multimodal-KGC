@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-3877 a chart:Chart ;
    chart:chartType "line" ;
    chart:title "Rate of prevalent cases of end-stage renal disease (ESRD) in the U.S. from 1980 to 2016 (per million population)" ;
    chart:xAxis ex:x-3877 ;
    chart:yAxis ex:y-3877 .

ex:x-3877 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "1980" ;
    chart:scaleMax "2016" .

ex:y-3877 a chart:Axis ;
    chart:label "Number of cases per million population" ;
    chart:scaleMin "0" ;
    chart:scaleMax "2000" .

ex:series-3877-1 a chart:Series .

ex:dp-3877-1-1 a chart:DataPoint ;
    chart:series ex:series-3877-1 ;
    chart:xVal "1980" ;
    chart:yVal "100"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-3877-1-2 a chart:DataPoint ;
    chart:series ex:series-3877-1 ;
    chart:xVal "1985" ;
    chart:yVal "250"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-3877-1-3 a chart:DataPoint ;
    chart:series ex:series-3877-1 ;
    chart:xVal "1990" ;
    chart:yVal "400"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-3877-1-4 a chart:DataPoint ;
    chart:series ex:series-3877-1 ;
    chart:xVal "1995" ;
    chart:yVal "700"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-3877-1-5 a chart:DataPoint ;
    chart:series ex:series-3877-1 ;
    chart:xVal "2000" ;
    chart:yVal "1200"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-3877-1-6 a chart:DataPoint ;
    chart:series ex:series-3877-1 ;
    chart:xVal "2005" ;
    chart:yVal "1600"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-3877-1-7 a chart:DataPoint ;
    chart:series ex:series-3877-1 ;
    chart:xVal "2010" ;
    chart:yVal "1800"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-3877-1-8 a chart:DataPoint ;
    chart:series ex:series-3877-1 ;
    chart:xVal "2015" ;
    chart:yVal "1950"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-3877-1-9 a chart:DataPoint ;
    chart:series ex:series-3877-1 ;
    chart:xVal "2016" ;
    chart:yVal "2000"^^xsd:decimal ;
    chart:valueEstimated "true" .
