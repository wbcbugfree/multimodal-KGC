@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-5712 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Cambodia : Ratio of government expenditure to gross domestic product (GDP) from 2015 to 2025" ;
    chart:xAxis ex:x-5712 ;
    chart:yAxis ex:y-5712 .

ex:x-5712 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2015" ;
    chart:scaleMax "2025*" .

ex:y-5712 a chart:Axis ;
    chart:label "" ;
    chart:scaleMin "0.00" ;
    chart:scaleMax "0.25" .

ex:series-5712-1 a chart:Series .

ex:dp-5712-1-1 a chart:DataPoint ;
    chart:series ex:series-5712-1 ;
    chart:category "2015" ;
    chart:value "0.20"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-5712-1-2 a chart:DataPoint ;
    chart:series ex:series-5712-1 ;
    chart:category "2016" ;
    chart:value "0.21"^^xsd:decimal ;
    chart:valueEstimated "true" .

