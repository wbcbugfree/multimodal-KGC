@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-6602 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Growth in bankruptcies after the coronavirus outbreak in Sweden from February to November 2020 , by industry (compared to the previous year)" ;
    chart:xAxis ex:x-6602 ;
    chart:yAxis ex:y-6602 .

ex:x-6602 a chart:Axis ;
    chart:label "Nov" ;
    chart:scaleMin "-0.4" ;
    chart:scaleMax "0.4" .

ex:y-6602 a chart:Axis ;
    chart:label "industry" .

ex:series-6602-1 a chart:Series .

ex:dp-6602-1-1 a chart:DataPoint ;
    chart:series ex:series-6602-1 ;
    chart:category "Construction" ;
    chart:value "-0.02"^^xsd:decimal ;
    chart:valueEstimated "true" .

