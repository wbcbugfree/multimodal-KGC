@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-4559 a chart:Chart ;
    chart:chartType "line" ;
    chart:title "Economic damage caused by tornadoes in the U.S. from 1995 to 2019 (in million U.S. dollars)" ;
    chart:xAxis ex:x-4559 ;
    chart:yAxis ex:y-4559 .

ex:x-4559 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "1995" ;
    chart:scaleMax "2019" .

ex:y-4559 a chart:Axis ;
    chart:label "Damage in million U.S. dollars" ;
    chart:scaleMin "0" ;
    chart:scaleMax "10000" .

ex:series-4559-1 a chart:Series .

ex:dp-4559-1-1 a chart:DataPoint ;
    chart:series ex:series-4559-1 ;
    chart:xVal "1995" ;
    chart:yVal "200"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-4559-1-2 a chart:DataPoint ;
    chart:series ex:series-4559-1 ;
    chart:xVal "2000" ;
    chart:yVal "200"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-4559-1-3 a chart:DataPoint ;
    chart:series ex:series-4559-1 ;
    chart:xVal "2005" ;
    chart:yVal "1400"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-4559-1-4 a chart:DataPoint ;
    chart:series ex:series-4559-1 ;
    chart:xVal "2010" ;
    chart:yVal "9500"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-4559-1-5 a chart:DataPoint ;
    chart:series ex:series-4559-1 ;
    chart:xVal "2015" ;
    chart:yVal "500"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-4559-1-6 a chart:DataPoint ;
    chart:series ex:series-4559-1 ;
    chart:xVal "2019" ;
    chart:yVal "2800"^^xsd:decimal ;
    chart:valueEstimated "true" .
