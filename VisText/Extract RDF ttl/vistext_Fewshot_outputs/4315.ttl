@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-4315 a chart:Chart ;
    chart:chartType "line" ;
    chart:title "New York Giants revenue from 2001 to 2019 (in million U.S. dollars)" ;
    chart:xAxis ex:x-4315 ;
    chart:yAxis ex:y-4315 .

ex:x-4315 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2001" ;
    chart:scaleMax "2019" .

ex:y-4315 a chart:Axis ;
    chart:label "Revenue in million U.S. dollars" ;
    chart:scaleMin "0" ;
    chart:scaleMax "500" .

ex:series-4315-1 a chart:Series .

ex:dp-4315-1-1 a chart:DataPoint ;
    chart:series ex:series-4315-1 ;
    chart:xVal "2001" ;
    chart:yVal "140"^^xsd:decimal ;
    chart:valueEstimated "true" .

