@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-8704 a chart:Chart ;
    chart:chartType "area" ;
    chart:title "Population in Norway from 2010 to 2020 , by age group (in millions)" ;
    chart:xAxis ex:x-8704 ;
    chart:yAxis ex:y-8704 .

ex:x-8704 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2010" ;
    chart:scaleMax "2020" .

ex:y-8704 a chart:Axis ;
    chart:label "35-44 years" ;
    chart:scaleMin "0.0" ;
    chart:scaleMax "0.8" .

ex:series-8704-1 a chart:Series .

ex:dp-8704-1-1 a chart:DataPoint ;
    chart:series ex:series-8704-1 ;
    chart:xVal "2010" ;
    chart:yVal "0.73"^^xsd:decimal ;
    chart:value "0.73"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-8704-1-2 a chart:DataPoint ;
    chart:series ex:series-8704-1 ;
    chart:xVal "2012" ;
    chart:yVal "0.73"^^xsd:decimal ;
    chart:value "0.73"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-8704-1-3 a chart:DataPoint ;
    chart:series ex:series-8704-1 ;
    chart:xVal "2014" ;
    chart:yVal "0.72"^^xsd:decimal ;
    chart:value "0.72"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-8704-1-4 a chart:DataPoint ;
    chart:series ex:series-8704-1 ;
    chart:xVal "2016" ;
    chart:yVal "0.71"^^xsd:decimal ;
    chart:value "0.71"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-8704-1-5 a chart:DataPoint ;
    chart:series ex:series-8704-1 ;
    chart:xVal "2018" ;
    chart:yVal "0.70"^^xsd:decimal ;
    chart:value "0.70"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-8704-1-6 a chart:DataPoint ;
    chart:series ex:series-8704-1 ;
    chart:xVal "2020" ;
    chart:yVal "0.70"^^xsd:decimal ;
    chart:value "0.70"^^xsd:decimal ;
    chart:valueEstimated "true" .
