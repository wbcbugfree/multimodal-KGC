@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-6635 a chart:Chart ;
    chart:chartType "area" ;
    chart:title "Jordan : Age structure from 2009 to 2019" ;
    chart:xAxis ex:x-6635 ;
    chart:yAxis ex:y-6635 .

ex:x-6635 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2010" ;
    chart:scaleMax "2018" .

ex:y-6635 a chart:Axis ;
    chart:label "0-14 years" ;
    chart:scaleMin "0.0" ;
    chart:scaleMax "0.4" .

ex:series-6635-1 a chart:Series .

ex:dp-6635-1-1 a chart:DataPoint ;
    chart:series ex:series-6635-1 ;
    chart:xVal "2010" ;
    chart:yVal "0.38"^^xsd:decimal ;
    chart:value "0.38"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-6635-1-2 a chart:DataPoint ;
    chart:series ex:series-6635-1 ;
    chart:xVal "2012" ;
    chart:yVal "0.37"^^xsd:decimal ;
    chart:value "0.37"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-6635-1-3 a chart:DataPoint ;
    chart:series ex:series-6635-1 ;
    chart:xVal "2014" ;
    chart:yVal "0.36"^^xsd:decimal ;
    chart:value "0.36"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-6635-1-4 a chart:DataPoint ;
    chart:series ex:series-6635-1 ;
    chart:xVal "2016" ;
    chart:yVal "0.35"^^xsd:decimal ;
    chart:value "0.35"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-6635-1-5 a chart:DataPoint ;
    chart:series ex:series-6635-1 ;
    chart:xVal "2018" ;
    chart:yVal "0.34"^^xsd:decimal ;
    chart:value "0.34"^^xsd:decimal ;
    chart:valueEstimated "true" .
