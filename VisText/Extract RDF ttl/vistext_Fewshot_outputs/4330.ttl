@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-4330 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "How do you typically use your mobile phone to find inspiration or ideas on where to travel ?" ;
    chart:xAxis ex:x-4330 ;
    chart:yAxis ex:y-4330 .

ex:x-4330 a chart:Axis ;
    chart:label "Response" .

ex:y-4330 a chart:Axis ;
    chart:label "Share of respondents" ;
    chart:scaleMin "0.0" ;
    chart:scaleMax "0.7" .

ex:series-4330-1 a chart:Series .

ex:dp-4330-1-1 a chart:DataPoint ;
    chart:series ex:series-4330-1 ;
    chart:category "Airbnb.com" ;
    chart:value "0.25"^^xsd:decimal ;
