@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-3232 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Pittsburgh Pirates all-time hits leaders as of October 2020" ;
    chart:xAxis ex:x-3232 ;
    chart:yAxis ex:y-3232 .

ex:x-3232 a chart:Axis ;
    chart:label "Number of hits" ;
    chart:scaleMin "0" ;
    chart:scaleMax "3000" .

ex:y-3232 a chart:Axis ;
    chart:label "Pittsburgh Pirates all-time hits leaders" .

ex:series-3232-1 a chart:Series .

ex:dp-3232-1-1 a chart:DataPoint ;
    chart:series ex:series-3232-1 ;
    chart:category "Arky Vaughan" ;
    chart:value "1400"^^xsd:decimal ;
    chart:valueEstimated "true" .

