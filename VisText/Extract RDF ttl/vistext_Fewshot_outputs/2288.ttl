@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-2288 a chart:Chart ;
    chart:chartType "line" ;
    chart:title "Per capita consumption of processed vegetables in the United States from 2003 to 2019 (in pounds)" ;
    chart:xAxis ex:x-2288 ;
    chart:yAxis ex:y-2288 .

ex:x-2288 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2003" ;
    chart:scaleMax "2019" .

ex:y-2288 a chart:Axis ;
    chart:label "Utilization in pounds" ;
    chart:scaleMin "0" ;
    chart:scaleMax "120" .

ex:series-2288-1 a chart:Series .

ex:dp-2288-1-1 a chart:DataPoint ;
    chart:series ex:series-2288-1 ;
    chart:xVal "2004" ;
    chart:yVal "120"^^xsd:decimal ;
    chart:valueEstimated "true" .

