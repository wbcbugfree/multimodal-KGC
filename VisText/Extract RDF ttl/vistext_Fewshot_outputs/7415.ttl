@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-7415 a chart:Chart ;
    chart:chartType "area" ;
    chart:title "Revenue of HermÃ\"s worldwide from 2010 to 2019 , by geographical region (in million euros)" ;
    chart:xAxis ex:x-7415 ;
    chart:yAxis ex:y-7415 .

ex:x-7415 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2010" ;
    chart:scaleMax "2019" .

ex:y-7415 a chart:Axis ;
    chart:label "Americas" ;
    chart:scaleMin "0" ;
    chart:scaleMax "1200" .

ex:series-7415-1 a chart:Series .

ex:dp-7415-1-1 a chart:DataPoint ;
    chart:series ex:series-7415-1 ;
    chart:xVal "2010" ;
    chart:yVal "420"^^xsd:decimal ;
    chart:value "420"^^xsd:decimal ;
    chart:valueEstimated "true" .

