@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-6275 a chart:Chart ;
    chart:chartType "area" ;
    chart:title "Mean earnings in the United States from 2005 to 2019 , by highest educational degree earned" ;
    chart:xAxis ex:x-6275 ;
    chart:yAxis ex:y-6275 .

ex:x-6275 a chart:Axis ;
    chart:label "Level of Education" ;
    chart:scaleMin "2005" ;
    chart:scaleMax "2019" .

ex:y-6275 a chart:Axis ;
    chart:label "Professional Degree" ;
    chart:scaleMin "0" ;
    chart:scaleMax "150000" .

ex:series-6275-1 a chart:Series .

ex:dp-6275-1-1 a chart:DataPoint ;
    chart:series ex:series-6275-1 ;
    chart:xVal "2006" ;
    chart:yVal "120000"^^xsd:decimal ;
    chart:value "120000"^^xsd:decimal ;
    chart:valueEstimated "true" .

