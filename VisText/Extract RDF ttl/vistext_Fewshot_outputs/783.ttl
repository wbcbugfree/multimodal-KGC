@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-783 a chart:Chart ;
    chart:chartType "area" ;
    chart:title "Piaggio Vespa registered motorcycle numbers in Great Britain from 2000 to 2018" ;
    chart:xAxis ex:x-783 ;
    chart:yAxis ex:y-783 .

ex:x-783 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2000" ;
    chart:scaleMax "2018" .

ex:y-783 a chart:Axis ;
    chart:label "Number of registered motorcycles" ;
    chart:scaleMin "0" ;
    chart:scaleMax "25000" .

ex:series-783-1 a chart:Series .

ex:dp-783-1-1 a chart:DataPoint ;
    chart:series ex:series-783-1 ;
    chart:xVal "2000" ;
    chart:yVal "5000"^^xsd:decimal ;
    chart:value "5000"^^xsd:decimal ;
    chart:valueEstimated "true" .

