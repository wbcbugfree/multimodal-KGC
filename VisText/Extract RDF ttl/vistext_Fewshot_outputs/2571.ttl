@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-2571 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Number of onshore wind energy sites in Germany from 2000 to 2018" ;
    chart:xAxis ex:x-2571 ;
    chart:yAxis ex:y-2571 .

ex:x-2571 a chart:Axis ;
    chart:label "Number of wind energy sites" ;
    chart:scaleMin "0" ;
    chart:scaleMax "30000" .

ex:y-2571 a chart:Axis ;
    chart:label "year" ;
    chart:scaleMin "" ;
    chart:scaleMax "" .

ex:series-2571-1 a chart:Series .

ex:dp-2571-1-1 a chart:DataPoint ;
    chart:series ex:series-2571-1 ;
    chart:category "'00" ;
    chart:value "5000"^^xsd:decimal ;
    chart:valueEstimated "true" .

