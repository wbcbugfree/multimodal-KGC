@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-4345 a chart:Chart ;
    chart:chartType "area" ;
    chart:xAxis ex:x-4345 ;
    chart:yAxis ex:y-4345 .

ex:x-4345 a chart:Axis ;
    chart:label "Fiscal years" ;
    chart:scaleMin "2006" ;
    chart:scaleMax "2014" .

ex:y-4345 a chart:Axis ;
    chart:label "Number of stores" ;
    chart:scaleMin "0" ;
    chart:scaleMax "400" .

ex:series-4345-1 a chart:Series .

ex:dp-4345-1-1 a chart:DataPoint ;
    chart:series ex:series-4345-1 ;
    chart:xVal "2006" ;
    chart:yVal "120"^^xsd:decimal ;
    chart:value "120"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-4345-1-2 a chart:DataPoint ;
    chart:series ex:series-4345-1 ;
    chart:xVal "2008" ;
    chart:yVal "220"^^xsd:decimal ;
    chart:value "220"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-4345-1-3 a chart:DataPoint ;
    chart:series ex:series-4345-1 ;
    chart:xVal "2010" ;
    chart:yVal "300"^^xsd:decimal ;
    chart:value "300"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-4345-1-4 a chart:DataPoint ;
    chart:series ex:series-4345-1 ;
    chart:xVal "2012" ;
    chart:yVal "370"^^xsd:decimal ;
    chart:value "370"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-4345-1-5 a chart:DataPoint ;
    chart:series ex:series-4345-1 ;
    chart:xVal "2014" ;
    chart:yVal "420"^^xsd:decimal ;
    chart:value "420"^^xsd:decimal ;
    chart:valueEstimated "true" .
