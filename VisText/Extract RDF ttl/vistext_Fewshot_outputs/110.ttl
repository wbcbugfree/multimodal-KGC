@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-110 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Market cap of leading online marketplaces worldwide as of September 2020 (in million U.S. dollars)" ;
    chart:xAxis ex:x-110 ;
    chart:yAxis ex:y-110 .

ex:x-110 a chart:Axis ;
    chart:label "Market cap in million U.S. dollars" ;
    chart:scaleMin "0" ;
    chart:scaleMax "60000" .

ex:y-110 a chart:Axis ;
    chart:label "business" ;
    chart:scaleMin "" ;
    chart:scaleMax "" .

ex:series-110-1 a chart:Series .

ex:dp-110-1-1 a chart:DataPoint ;
    chart:series ex:series-110-1 ;
    chart:category "CarGurus (United States)" ;
    chart:value "15000"^^xsd:decimal ;
    chart:valueEstimated "true" .

