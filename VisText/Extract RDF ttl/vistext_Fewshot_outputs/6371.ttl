@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-6371 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Number of Burger King restaurants in the Asia Pacific region from 2012 to 2013 , by country or region" ;
    chart:xAxis ex:x-6371 ;
    chart:yAxis ex:y-6371 .

ex:x-6371 a chart:Axis ;
    chart:label "Country" ;
    chart:scaleMin "" ;
    chart:scaleMax "" .

ex:y-6371 a chart:Axis ;
    chart:label "2013" ;
    chart:scaleMin "0" ;
    chart:scaleMax "400" .

ex:series-6371-1 a chart:Series .

ex:dp-6371-1-1 a chart:DataPoint ;
    chart:series ex:series-6371-1 ;
    chart:category "Australia" ;
    chart:value "360"^^xsd:decimal ;
    chart:valueEstimated "true" .

