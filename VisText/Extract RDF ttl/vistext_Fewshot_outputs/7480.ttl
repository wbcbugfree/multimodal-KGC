@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-7480 a chart:Chart ;
    chart:chartType "area" ;
    chart:title "Honduras : Share of economic sectors in the gross domestic product (GDP) from 2009 to 2019" ;
    chart:xAxis ex:x-7480 ;
    chart:yAxis ex:y-7480 .

ex:x-7480 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2009" ;
    chart:scaleMax "2019" .

ex:y-7480 a chart:Axis ;
    chart:label "Industry" ;
    chart:scaleMin "0.00" ;
    chart:scaleMax "0.30" .

ex:series-7480-1 a chart:Series .

ex:dp-7480-1-1 a chart:DataPoint ;
    chart:series ex:series-7480-1 ;
    chart:xVal "2009" ;
    chart:yVal "0.25"^^xsd:decimal ;
    chart:value "0.25"^^xsd:decimal ;
    chart:valueEstimated "true" .

