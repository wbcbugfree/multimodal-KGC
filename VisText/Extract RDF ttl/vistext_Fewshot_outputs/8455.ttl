@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-8455 a chart:Chart ;
    chart:chartType "line" ;
    chart:xAxis ex:x-8455 ;
    chart:yAxis ex:y-8455 .

ex:x-8455 a chart:Axis ;
    chart:label "Response" ;
    chart:scaleMin "2009" ;
    chart:scaleMax "2020" .

ex:y-8455 a chart:Axis ;
    chart:label "Trying occasionally" ;
    chart:scaleMin "0.0" ;
    chart:scaleMax "0.4" .

ex:series-8455-1 a chart:Series .

ex:dp-8455-1-1 a chart:DataPoint ;
    chart:series ex:series-8455-1 ;
    chart:xVal "2009" ;
    chart:yVal "0.4"^^xsd:decimal ;
    chart:value "0.4"^^xsd:decimal ;
    chart:valueEstimated "true" .

