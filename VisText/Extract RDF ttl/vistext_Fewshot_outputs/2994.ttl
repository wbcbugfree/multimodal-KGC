@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-2994 a chart:Chart ;
    chart:chartType "bar" ;
    chart:xAxis ex:x-2994 ;
    chart:yAxis ex:y-2994 .

ex:x-2994 a chart:Axis ;
    chart:label "Country" ;
    chart:scaleMin "" ;
    chart:scaleMax "" .

ex:y-2994 a chart:Axis ;
    chart:label "Number of casinos" ;
    chart:scaleMin "0" ;
    chart:scaleMax "1700" .

ex:series-2994-1 a chart:Series .

ex:dp-2994-1-1 a chart:DataPoint ;
    chart:series ex:series-2994-1 ;
    chart:category "Africa" ;
    chart:value "200"^^xsd:decimal ;
    chart:valueEstimated "true" .

