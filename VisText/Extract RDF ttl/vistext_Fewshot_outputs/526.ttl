@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-526 a chart:Chart ;
    chart:chartType "line" ;
    chart:xAxis ex:x-526 ;
    chart:yAxis ex:y-526 .

ex:x-526 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2000" ;
    chart:scaleMax "2020" .

ex:y-526 a chart:Axis ;
    chart:label "Average annual wages in euros" ;
    chart:scaleMin "0" ;
    chart:scaleMax "30000" .

ex:series-526-1 a chart:Series .

ex:dp-526-1-1 a chart:DataPoint ;
    chart:series ex:series-526-1 ;
    chart:xVal "2002" ;
    chart:yVal "17500"^^xsd:decimal ;
    chart:value "17500"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-526-1-2 a chart:DataPoint ;
    chart:series ex:series-526-1 ;
    chart:xVal "2004" ;
    chart:yVal "19000"^^xsd:decimal ;
    chart:value "19000"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-526-1-3 a chart:DataPoint ;
    chart:series ex:series-526-1 ;
    chart:xVal "2006" ;
    chart:yVal "20000"^^xsd:decimal ;
    chart:value "20000"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-526-1-4 a chart:DataPoint ;
    chart:series ex:series-526-1 ;
    chart:xVal "2008" ;
    chart:yVal "21000"^^xsd:decimal ;
    chart:value "21000"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-526-1-5 a chart:DataPoint ;
    chart:series ex:series-526-1 ;
    chart:xVal "2010" ;
    chart:yVal "21500"^^xsd:decimal ;
    chart:value "21500"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-526-1-6 a chart:DataPoint ;
    chart:series ex:series-526-1 ;
    chart:xVal "2012" ;
    chart:yVal "22000"^^xsd:decimal ;
    chart:value "22000"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-526-1-7 a chart:DataPoint ;
    chart:series ex:series-526-1 ;
    chart:xVal "2014" ;
    chart:yVal "23000"^^xsd:decimal ;
    chart:value "23000"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-526-1-8 a chart:DataPoint ;
    chart:series ex:series-526-1 ;
    chart:xVal "2016" ;
    chart:yVal "24000"^^xsd:decimal ;
    chart:value "24000"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-526-1-9 a chart:DataPoint ;
    chart:series ex:series-526-1 ;
    chart:xVal "2018" ;
    chart:yVal "25000"^^xsd:decimal ;
    chart:value "25000"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-526-1-10 a chart:DataPoint ;
