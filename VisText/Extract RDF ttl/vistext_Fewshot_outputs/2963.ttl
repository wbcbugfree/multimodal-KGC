@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-2963 a chart:Chart ;
    chart:chartType "line" ;
    chart:title "Average monthly number of calls per mobile subscription in Sweden from 2007 to 2019" ;
    chart:xAxis ex:x-2963 ;
    chart:yAxis ex:y-2963 .

ex:x-2963 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2007" ;
    chart:scaleMax "2019" .

ex:y-2963 a chart:Axis ;
    chart:label "Average number of calls per mobile subscription" ;
    chart:scaleMin "0" ;
    chart:scaleMax "70" .

ex:series-2963-1 a chart:Series .

ex:dp-2963-1-1 a chart:DataPoint ;
    chart:series ex:series-2963-1 ;
    chart:xVal "2007" ;
    chart:yVal "61"^^xsd:decimal ;
    chart:value "61"^^xsd:decimal ;
    chart:valueEstimated "true" .

