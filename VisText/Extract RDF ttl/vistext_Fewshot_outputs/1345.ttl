@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-1345 a chart:Chart ;
    chart:chartType "area" ;
    chart:title "Number of international students enrolled in postsecondary institutions in Canada from 2000 to 2018" ;
    chart:xAxis ex:x-1345 ;
    chart:yAxis ex:y-1345 .

ex:x-1345 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2000" ;
    chart:scaleMax "2018" .

ex:y-1345 a chart:Axis ;
    chart:label "Number of international students" ;
    chart:scaleMin "0" ;
    chart:scaleMax "300000" .

ex:series-1345-1 a chart:Series .

ex:dp-1345-1-1 a chart:DataPoint ;
    chart:series ex:series-1345-1 ;
    chart:xVal "2000" ;
    chart:yVal "50000"^^xsd:decimal ;
    chart:valueEstimated "true" .

