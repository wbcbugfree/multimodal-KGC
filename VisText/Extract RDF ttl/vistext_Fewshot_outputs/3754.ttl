@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-3754 a chart:Chart ;
    chart:chartType "area" ;
    chart:title "Mattel operating income from 2006 to 2019 (in million U.S. dollars)" ;
    chart:xAxis ex:x-3754 ;
    chart:yAxis ex:y-3754 .

ex:x-3754 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2006" ;
    chart:scaleMax "2018" .

ex:y-3754 a chart:Axis ;
    chart:label "Operating income in million U.S. dollars" ;
    chart:scaleMin "0" ;
    chart:scaleMax "1000" .

ex:series-3754-1 a chart:Series .

ex:dp-3754-1-1 a chart:DataPoint ;
    chart:series ex:series-3754-1 ;
    chart:xVal "2006" ;
    chart:yVal "600"^^xsd:decimal ;
    chart:value "600"^^xsd:decimal ;
    chart:valueEstimated "true" .

