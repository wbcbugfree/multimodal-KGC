@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-2951 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Leading ten analgesic drugs dispensed in England in 2019 , by number of items (in 1,000s)" ;
    chart:xAxis ex:x-2951 ;
    chart:yAxis ex:y-2951 .

ex:x-2951 a chart:Axis ;
    chart:label "Analgesic Drug" .

ex:y-2951 a chart:Axis ;
    chart:label "Items in thousands" ;
    chart:scaleMin "0" ;
    chart:scaleMax "20000" .

ex:series-2951-1 a chart:Series .

ex:dp-2951-1-1 a chart:DataPoint ;
    chart:series ex:series-2951-1 ;
    chart:category "Buprenorphine" ;
    chart:value "3500"^^xsd:decimal ;
    chart:valueEstimated "true" .

