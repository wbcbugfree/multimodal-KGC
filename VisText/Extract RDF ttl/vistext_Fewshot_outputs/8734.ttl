@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-8734 a chart:Chart ;
    chart:chartType "line" ;
    chart:title "Poland : Distribution of employment by economic sector from 2010 to 2020" ;
    chart:xAxis ex:x-8734 ;
    chart:yAxis ex:y-8734 .

ex:x-8734 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2010" ;
    chart:scaleMax "2020" .

ex:y-8734 a chart:Axis ;
    chart:label "Services" ;
    chart:scaleMin "0.0" ;
    chart:scaleMax "0.6" .

ex:series-8734-1 a chart:Series .

ex:dp-8734-1-1 a chart:DataPoint ;
    chart:series ex:series-8734-1 ;
    chart:xVal "2010" ;
    chart:yVal "0.55"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-8734-1-2 a chart:DataPoint ;
    chart:series ex:series-8734-1 ;
    chart:xVal "2012" ;
    chart:yVal "0.56"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-8734-1-3 a chart:DataPoint ;
    chart:series ex:series-8734-1 ;
    chart:xVal "2014" ;
    chart:yVal "0.57"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-8734-1-4 a chart:DataPoint ;
    chart:series ex:series-8734-1 ;
    chart:xVal "2016" ;
    chart:yVal "0.58"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-8734-1-5 a chart:DataPoint ;
    chart:series ex:series-8734-1 ;
    chart:xVal "2018" ;
    chart:yVal "0.59"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-8734-1-6 a chart:DataPoint ;
    chart:series ex:series-8734-1 ;
    chart:xVal "2020" ;
    chart:yVal "0.60"^^xsd:decimal ;
    chart:valueEstimated "true" .
