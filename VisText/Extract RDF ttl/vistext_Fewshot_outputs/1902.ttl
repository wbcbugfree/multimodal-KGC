@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-1902 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Number of permanent resident refugees in Canada admitted in 2019 , by province or territory" ;
    chart:xAxis ex:x-1902 ;
    chart:yAxis ex:y-1902 .

ex:x-1902 a chart:Axis ;
    chart:label "province of Canada" .

ex:y-1902 a chart:Axis ;
    chart:label "Number of resident refugees" ;
    chart:scaleMin "0" ;
    chart:scaleMax "25000" .

ex:series-1902-1 a chart:Series .

ex:dp-1902-1-1 a chart:DataPoint ;
    chart:series ex:series-1902-1 ;
    chart:category "Alberta" ;
    chart:value "5000"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-1902-1-2 a chart:DataPoint ;
    chart:series ex:series-1902-1 ;
    chart:category "British Columbia" ;
    chart:value "3000"^^xsd:decimal ;
    chart:valueEstimated "true" .

