@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-6247 a chart:Chart ;
    chart:chartType "line" ;
    chart:title "Mobility in selected cities between March 3 , 2020 and December 7 , 2020 , compared with movement prior to the coronavirus outbreak" ;
    chart:xAxis ex:x-6247 ;
    chart:yAxis ex:y-6247 .

ex:x-6247 a chart:Axis ;
    chart:label "Response" ;
    chart:scaleMin "0.0" ;
    chart:scaleMax "1.0" .

ex:y-6247 a chart:Axis ;
    chart:label "Stockholm" ;
    chart:scaleMin "0.0" ;
    chart:scaleMax "1.0" .

ex:series-6247-1 a chart:Series .

ex:dp-6247-1-1 a chart:DataPoint ;
    chart:series ex:series-6247-1 ;
    chart:xVal "March" ;
    chart:yVal "0.97"^^xsd:decimal ;
    chart:value "0.97"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-6247-1-2 a chart:DataPoint ;
    chart:series ex:series-6247-1 ;
    chart:xVal "April" ;
    chart:yVal "0.35"^^xsd:decimal ;
    chart:value "0.35"^^xsd:decimal ;
    chart:valueEstimated "true" .

