@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-1887 a chart:Chart ;
    chart:chartType "bar" ;
    chart:xAxis ex:x-1887 ;
    chart:yAxis ex:y-1887 .

ex:x-1887 a chart:Axis ;
    chart:label "Year" .

ex:y-1887 a chart:Axis ;
    chart:label "Import volume in 1,000 metric tons" ;
    chart:scaleMin "0" ;
    chart:scaleMax "200" .

ex:series-1887-1 a chart:Series .

ex:dp-1887-1-1 a chart:DataPoint ;
    chart:series ex:series-1887-1 ;
    chart:category "2010/11" ;
    chart:value "185"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-1887-1-2 a chart:DataPoint ;
    chart:series ex:series-1887-1 ;
    chart:category "2011/12" ;
    chart:value "165"^^xsd:decimal ;
    chart:valueEstimated "true" .

