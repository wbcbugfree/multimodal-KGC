@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-3768 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Number of bakery product manufacturing establishments in Canada as of December 2019 , by region" ;
    chart:xAxis ex:x-3768 ;
    chart:yAxis ex:y-3768 .

ex:x-3768 a chart:Axis ;
    chart:label "region of Canada" .

ex:y-3768 a chart:Axis ;
    chart:label "Number of establishments" ;
    chart:scaleMin "0" ;
    chart:scaleMax "900" .

ex:series-3768-1 a chart:Series .

ex:mark-3768-1-1 a chart:DataPoint ;
    chart:series ex:series-3768-1 ;
    chart:category "Alberta" ;
    chart:value "175"^^xsd:decimal ;
    chart:valueEstimated "true" .

