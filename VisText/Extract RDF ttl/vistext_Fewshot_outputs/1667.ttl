@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-1667 a chart:Chart ;
    chart:chartType "line" ;
    chart:title "Number of Saab cars sold in Sweden from 2008 to 2018" ;
    chart:xAxis ex:x-1667 ;
    chart:yAxis ex:y-1667 .

ex:x-1667 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2008" ;
    chart:scaleMax "2018" .

ex:y-1667 a chart:Axis ;
    chart:label "Units sold" ;
    chart:scaleMin "0" ;
    chart:scaleMax "20000" .

ex:series-1667-1 a chart:Series .

ex:dp-1667-1-1 a chart:DataPoint ;
    chart:series ex:series-1667-1 ;
    chart:xVal "2008" ;
    chart:yVal "20000"^^xsd:decimal ;
    chart:valueEstimated "false" .

ex:dp-1667-1-2 a chart:DataPoint ;
    chart:series ex:series-1667-1 ;
    chart:xVal "2009" ;
    chart:yVal "7000"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-1667-1-3 a chart:DataPoint ;
    chart:series ex:series-1667-1 ;
    chart:xVal "2010" ;
    chart:yVal "8500"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-1667-1-4 a chart:DataPoint ;
    chart:series ex:series-1667-1 ;
    chart:xVal "2011" ;
    chart:yVal "3500"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-1667-1-5 a chart:DataPoint ;
    chart:series ex:series-1667-1 ;
    chart:xVal "2012" ;
    chart:yVal "1500"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-1667-1-6 a chart:DataPoint ;
    chart:series ex:series-1667-1 ;
    chart:xVal "2013" ;
    chart:yVal "500"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-1667-1-7 a chart:DataPoint ;
    chart:series ex:series-1667-1 ;
    chart:xVal "2014" ;
    chart:yVal "500"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-1667-1-8 a chart:DataPoint ;
    chart:series ex:series-1667-1 ;
    chart:xVal "2015" ;
    chart:yVal "200"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-1667-1-9 a chart:DataPoint ;
    chart:series ex:series-1667-1 ;
    chart:xVal "2016" ;
    chart:yVal "200"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-1667-1-10 a chart:DataPoint ;
    chart:series ex:series-1667-1 ;
    chart:xVal "2017" ;
    chart:yVal "100"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-1667-1-11 a chart:DataPoint ;
    chart:series ex:series-1667-1 ;
    chart:xVal "2018" ;
    chart:yVal "100"^^xsd:decimal ;
    chart:valueEstimated "true" .
