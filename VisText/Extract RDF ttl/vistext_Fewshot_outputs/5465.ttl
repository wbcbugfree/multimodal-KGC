@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-5465 a chart:Chart ;
    chart:chartType "line" ;
    chart:title "Average annual food away-from-home expenditures of United States households from 2010 to 2019 (in U.S. dollars)" ;
    chart:xAxis ex:x-5465 ;
    chart:yAxis ex:y-5465 .

ex:x-5465 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2010" ;
    chart:scaleMax "2019" .

ex:y-5465 a chart:Axis ;
    chart:label "Expenditure in U.S. dollars" ;
    chart:scaleMin "0" ;
    chart:scaleMax "4000" .

ex:series-5465-1 a chart:Series .

ex:dp-5465-1-1 a chart:DataPoint ;
    chart:series ex:series-5465-1 ;
    chart:xVal "2010" ;
    chart:yVal "2500"^^xsd:decimal ;
    chart:value "2500"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-5465-1-2 a chart:DataPoint ;
    chart:series ex:series-5465-1 ;
    chart:xVal "2011" ;
    chart:yVal "2600"^^xsd:decimal ;
    chart:value "2600"^^xsd:decimal ;
    chart:valueEstimated "true" .

