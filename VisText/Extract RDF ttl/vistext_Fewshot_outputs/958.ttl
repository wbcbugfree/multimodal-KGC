@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-958 a chart:Chart ;
    chart:chartType "line" ;
    chart:title "France : Life expectancy at birth from 2008 to 2018" ;
    chart:xAxis ex:x-958 ;
    chart:yAxis ex:y-958 .

ex:x-958 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2008" ;
    chart:scaleMax "2018" .

ex:y-958 a chart:Axis ;
    chart:label "Live expectancy at birth in years" ;
    chart:scaleMin "0" ;
    chart:scaleMax "100" .

ex:series-958-1 a chart:Series .

ex:dp-958-1-1 a chart:DataPoint ;
    chart:series ex:series-958-1 ;
    chart:xVal "2008" ;
    chart:yVal "81.0"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-958-1-2 a chart:DataPoint ;
    chart:series ex:series-958-1 ;
    chart:xVal "2009" ;
    chart:yVal "81.2"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-958-1-3 a chart:DataPoint ;
    chart:series ex:series-958-1 ;
    chart:xVal "2010" ;
    chart:yVal "81.4"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-958-1-4 a chart:DataPoint ;
    chart:series ex:series-958-1 ;
    chart:xVal "2011" ;
    chart:yVal "81.6"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-958-1-5 a chart:DataPoint ;
    chart:series ex:series-958-1 ;
    chart:xVal "2012" ;
    chart:yVal "81.7"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-958-1-6 a chart:DataPoint ;
    chart:series ex:series-958-1 ;
    chart:xVal "2013" ;
    chart:yVal "81.8"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-958-1-7 a chart:DataPoint ;
    chart:series ex:series-958-1 ;
    chart:xVal "2014" ;
    chart:yVal "81.9"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-958-1-8 a chart:DataPoint ;
    chart:series ex:series-958-1 ;
    chart:xVal "2015" ;
    chart:yVal "82.0"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-958-1-9 a chart:DataPoint ;
    chart:series ex:series-958-1 ;
    chart:xVal "2016" ;
    chart:yVal "82.1"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-958-1-10 a chart:DataPoint ;
    chart:series ex:series-958-1 ;
    chart:xVal "2017" ;
    chart:yVal "82.2"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-958-1-11 a chart:DataPoint ;
    chart:series ex:series-958-1 ;
    chart:xVal "2018" ;
    chart:yVal "82.3"^^xsd:decimal ;
    chart:valueEstimated "true" .
