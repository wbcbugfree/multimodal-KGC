@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-7902 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Transport of passengers during the coronavirus (COVID-19) epidemic in Poland from January to October 2020 , by type of transport (in 1,000s)" ;
    chart:xAxis ex:x-7902 ;
    chart:yAxis ex:y-7902 .

ex:x-7902 a chart:Axis ;
    chart:label "Month" ;
    chart:scaleMin "" ;
    chart:scaleMax "" .

ex:y-7902 a chart:Axis ;
    chart:label "Air**" ;
    chart:scaleMin "0" ;
    chart:scaleMax "1000" .

ex:series-7902-1 a chart:Series .

ex:dp-7902-1-1 a chart:DataPoint ;
    chart:series ex:series-7902-1 ;
    chart:category "April" ;
    chart:value "0"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-7902-1-2 a chart:DataPoint ;
    chart:series ex:series-7902-1 ;
    chart:category "August" ;
    chart:value "540"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-7902-1-3 a chart:DataPoint ;
    chart:series ex:series-7902-1 ;
    chart:category "February" ;
    chart:value "820"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-7902-1-4 a chart:DataPoint ;
    chart:series ex:series-7902-1 ;
    chart:category "January" ;
    chart:value "900"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-7902-1-5 a chart:DataPoint ;
    chart:series ex:series-7902-1 ;
    chart:category "July" ;
    chart:value "330"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-7902-1-6 a chart:DataPoint ;
    chart:series ex:series-7902-1 ;
    chart:category "June" ;
    chart:value "10"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-7902-1-7 a chart:DataPoint ;
    chart:series ex:series-7902-1 ;
    chart:category "March" ;
    chart:value "390"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-7902-1-8 a chart:DataPoint ;
    chart:series ex:series-7902-1 ;
    chart:category "May" ;
    chart:value "200"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-7902-1-9 a chart:DataPoint ;
    chart:series ex:series-7902-1 ;
    chart:category "October" ;
    chart:value "190"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-7902-1-10 a chart:DataPoint ;
    chart:series ex:series-7902-1 ;
    chart:category "September" ;
    chart:value "360"^^xsd:decimal ;
    chart:valueEstimated "true" .
