@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-4491 a chart:Chart ;
    chart:chartType "line" ;
    chart:title "Worldwide number of automobiles sold by Honda Group from FY 2002 to FY 2020 (in 1,000 units)" ;
    chart:xAxis ex:x-4491 ;
    chart:yAxis ex:y-4491 .

ex:x-4491 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2002" ;
    chart:scaleMax "2020" .

ex:y-4491 a chart:Axis ;
    chart:label "Automobile sales in thousand units" ;
    chart:scaleMin "0" ;
    chart:scaleMax "5000" .

ex:series-4491-1 a chart:Series .

ex:dp-4491-1-1 a chart:DataPoint ;
    chart:series ex:series-4491-1 ;
    chart:xVal "2002" ;
    chart:yVal "3000"^^xsd:decimal ;
    chart:value "3000"^^xsd:decimal ;
    chart:valueEstimated "true" .

