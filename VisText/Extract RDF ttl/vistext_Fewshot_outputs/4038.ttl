@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-4038 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Cincinnati Reds all-time wins leaders as of October 2020" ;
    chart:xAxis ex:x-4038 ;
    chart:yAxis ex:y-4038 .

ex:x-4038 a chart:Axis ;
    chart:label "Number of games won" ;
    chart:scaleMin "0" ;
    chart:scaleMax "150" .

ex:y-4038 a chart:Axis ;
    chart:label "Cincinnati Reds all-time wins leaders" ;
    chart:scaleMin "" ;
    chart:scaleMax "" .

ex:series-4038-1 a chart:Series .

