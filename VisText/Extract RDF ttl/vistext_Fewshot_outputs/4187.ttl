@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-4187 a chart:Chart ;
    chart:chartType "line" ;
    chart:title "Average sales price of new homes sold in the U.S. from 1965 to 2019 (in 1,000 U.S. dollars)" ;
    chart:xAxis ex:x-4187 ;
    chart:yAxis ex:y-4187 .

ex:x-4187 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "1965" ;
    chart:scaleMax "2019" .

ex:y-4187 a chart:Axis ;
    chart:label "Sales price in thousand U.S. dollars" ;
    chart:scaleMin "0" ;
    chart:scaleMax "400" .

ex:series-4187-1 a chart:Series .

ex:dp-4187-1-1 a chart:DataPoint ;
    chart:series ex:series-4187-1 ;
    chart:xVal "1970" ;
    chart:yVal "25"^^xsd:decimal ;
    chart:value "25"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-4187-1-2 a chart:DataPoint ;
    chart:series ex:series-4187-1 ;
    chart:xVal "1975" ;
    chart:yVal "45"^^xsd:decimal ;
    chart:value "45"^^xsd:decimal ;
    chart:valueEstimated "true" .

