@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-4988 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Italy : Budget balance from 2014 to 2024\n(in billion euros)" ;
    chart:xAxis ex:x-4988 ;
    chart:yAxis ex:y-4988 .

ex:x-4988 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2014" ;
    chart:scaleMax "2024*" .

ex:y-4988 a chart:Axis ;
    chart:label "Budget balance in billion euros" ;
    chart:scaleMin "-50" ;
    chart:scaleMax "0" .

ex:series-4988-1 a chart:Series .

ex:dp-4988-1-1 a chart:DataPoint ;
    chart:series ex:series-4988-1 ;
    chart:category "2014" ;
    chart:value "-49"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-4988-1-2 a chart:DataPoint ;
    chart:series ex:series-4988-1 ;
    chart:category "2015" ;
    chart:value "-41"^^xsd:decimal ;
    chart:valueEstimated "true" .

