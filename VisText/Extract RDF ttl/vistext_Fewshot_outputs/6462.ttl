@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-6462 a chart:Chart ;
    chart:chartType "line" ;
    chart:title "Israel : Distribution of employment by economic sector from 2010 to 2020" ;
    chart:xAxis ex:x-6462 ;
    chart:yAxis ex:y-6462 .

ex:x-6462 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2010" ;
    chart:scaleMax "2020" .

ex:y-6462 a chart:Axis ;
    chart:label "Services" ;
    chart:scaleMin "0.0" ;
    chart:scaleMax "1.0" .

ex:series-6462-1 a chart:Series ;
    chart:seriesName "Services" .

ex:dp-6462-1-1 a chart:DataPoint ;
    chart:series ex:series-6462-1 ;
    chart:xVal "2010" ;
    chart:yVal "0.80"^^xsd:decimal ;
    chart:value "0.80"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-6462-1-2 a chart:DataPoint ;
    chart:series ex:series-6462-1 ;
    chart:xVal "2012" ;
    chart:yVal "0.81"^^xsd:decimal ;
    chart:value "0.81"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-6462-1-3 a chart:DataPoint ;
    chart:series ex:series-6462-1 ;
    chart:xVal "2014" ;
    chart:yVal "0.81"^^xsd:decimal ;
    chart:value "0.81"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-6462-1-4 a chart:DataPoint ;
    chart:series ex:series-6462-1 ;
    chart:xVal "2016" ;
    chart:yVal "0.82"^^xsd:decimal ;
    chart:value "0.82"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-6462-1-5 a chart:DataPoint ;
    chart:series ex:series-6462-1 ;
    chart:xVal "2018" ;
    chart:yVal "0.82"^^xsd:decimal ;
    chart:value "0.82"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-6462-1-6 a chart:DataPoint ;
    chart:series ex:series-6462-1 ;
    chart:xVal "2020" ;
    chart:yVal "0.83"^^xsd:decimal ;
    chart:value "0.83"^^xsd:decimal ;
    chart:valueEstimated "true" .
