@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-480 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Outbound travel and tourism expenditure in leading countries worldwide in 2019 (in billion U.S. dollars)" ;
    chart:xAxis ex:x-480 ;
    chart:yAxis ex:y-480 .

ex:x-480 a chart:Axis ;
    chart:label "Internal consumption in billion U.S. dollars" ;
    chart:scaleMin "0" ;
    chart:scaleMax "250" .

ex:y-480 a chart:Axis ;
    chart:label "Country" ;
    chart:scaleMin "" ;
    chart:scaleMax "" .

ex:series-480-1 a chart:Series .

ex:dp-480-1-1 a chart:DataPoint ;
    chart:series ex:series-480-1 ;
    chart:category "Australia" ;
    chart:value "25"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-480-1-2 a chart:DataPoint ;
    chart:series ex:series-480-1 ;
    chart:category "Canada" ;
    chart:value "30"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-480-1-3 a chart:DataPoint ;
    chart:series ex:series-480-1 ;
    chart:category "China" ;
    chart:value "250"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-480-1-4 a chart:DataPoint ;
    chart:series ex:series-480-1 ;
    chart:category "France" ;
    chart:value "45"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-480-1-5 a chart:DataPoint ;
    chart:series ex:series-480-1 ;
    chart:category "Germany" ;
    chart:value "100"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-480-1-6 a chart:DataPoint ;
    chart:series ex:series-480-1 ;
    chart:category "Italy" ;
    chart:value "35"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-480-1-7 a chart:DataPoint ;
    chart:series ex:series-480-1 ;
    chart:category "South Korea" ;
    chart:value "40"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-480-1-8 a chart:DataPoint ;
    chart:series ex:series-480-1 ;
    chart:category "Spain" ;
    chart:value "45"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-480-1-9 a chart:DataPoint ;
    chart:series ex:series-480-1 ;
    chart:category "United Kingdom" ;
    chart:value "100"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-480-1-10 a chart:DataPoint ;
    chart:series ex:series-480-1 ;
    chart:category "United States" ;
    chart:value "180"^^xsd:decimal ;
    chart:valueEstimated "true" .
