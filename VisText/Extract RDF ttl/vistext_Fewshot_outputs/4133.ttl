@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-4133 a chart:Chart ;
    chart:chartType "line" ;
    chart:title "Estimated aggregate revenue of the U.S. advertising , public relations , and related service industry from 2004 to 2018 (in billion U.S. dollars)" ;
    chart:xAxis ex:x-4133 ;
    chart:yAxis ex:y-4133 .

ex:x-4133 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2004" ;
    chart:scaleMax "2018" .

ex:y-4133 a chart:Axis ;
    chart:label "Estimated revenue in billion U.S. dollars" ;
    chart:scaleMin "0" ;
    chart:scaleMax "120" .

ex:series-4133-1 a chart:Series .

ex:dp-4133-1-1 a chart:DataPoint ;
    chart:series ex:series-4133-1 ;
    chart:xVal "2004" ;
    chart:yVal "64"^^xsd:decimal ;
    chart:value "64"^^xsd:decimal ;
    chart:valueEstimated "true" .

