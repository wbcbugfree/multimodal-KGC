@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-2182 a chart:Chart ;
    chart:chartType "line" ;
    chart:title "Sales of potted plants in Canada from 2010 to 2019 (in million Canadian dollars)" ;
    chart:xAxis ex:x-2182 ;
    chart:yAxis ex:y-2182 .

ex:x-2182 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2010" ;
    chart:scaleMax "2019" .

ex:y-2182 a chart:Axis ;
    chart:label "Sales in million Canadian dollars" ;
    chart:scaleMin "0" ;
    chart:scaleMax "1000" .

ex:series-2182-1 a chart:Series .

ex:dp-2182-1-1 a chart:DataPoint ;
    chart:series ex:series-2182-1 ;
    chart:xVal "2010" ;
    chart:yVal "730"^^xsd:decimal ;
    chart:value "730"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-2182-1-2 a chart:DataPoint ;
    chart:series ex:series-2182-1 ;
    chart:xVal "2011" ;
    chart:yVal "670"^^xsd:decimal ;
    chart:value "670"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-2182-1-3 a chart:DataPoint ;
    chart:series ex:series-2182-1 ;
    chart:xVal "2012" ;
    chart:yVal "690"^^xsd:decimal ;
    chart:value "690"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-2182-1-4 a chart:DataPoint ;
    chart:series ex:series-2182-1 ;
    chart:xVal "2013" ;
    chart:yVal "720"^^xsd:decimal ;
    chart:value "720"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-2182-1-5 a chart:DataPoint ;
    chart:series ex:series-2182-1 ;
    chart:xVal "2014" ;
    chart:yVal "760"^^xsd:decimal ;
    chart:value "760"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-2182-1-6 a chart:DataPoint ;
    chart:series ex:series-2182-1 ;
    chart:xVal "2015" ;
    chart:yVal "810"^^xsd:decimal ;
    chart:value "810"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-2182-1-7 a chart:DataPoint ;
    chart:series ex:series-2182-1 ;
    chart:xVal "2016" ;
    chart:yVal "820"^^xsd:decimal ;
    chart:value "820"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-2182-1-8 a chart:DataPoint ;
    chart:series ex:series-2182-1 ;
    chart:xVal "2017" ;
    chart:yVal "800"^^xsd:decimal ;
    chart:value "800"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-2182-1-9 a chart:DataPoint ;
    chart:series ex:series-2182-1 ;
    chart:xVal "2018" ;
    chart:yVal "840"^^xsd:decimal ;
    chart:value "840"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-2182-1-10 a chart:DataPoint ;
