@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-8529 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Volume of freight on board reported by airports in Poland from 2017 to 2019 (in 1,000 kg)" ;
    chart:xAxis ex:x-8529 ;
    chart:yAxis ex:y-8529 .

ex:x-8529 a chart:Axis ;
    chart:label "2017" ;
    chart:scaleMin "0" ;
    chart:scaleMax "80,000" .

ex:y-8529 a chart:Axis ;
    chart:label "airports in Poland" .

ex:series-8529-1 a chart:Series .

ex:dp-8529-1-1 a chart:DataPoint ;
    chart:series ex:series-8529-1 ;
    chart:category "Bydgoszcz-Szwedrowo" ;
    chart:value "0"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-8529-1-2 a chart:DataPoint ;
    chart:series ex:series-8529-1 ;
    chart:category "Gdańsk Lech Wałęsa Airport" ;
    chart:value "2000"^^xsd:decimal ;
    chart:valueEstimated "true" .

