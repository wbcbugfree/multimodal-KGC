@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-6022 a chart:Chart ;
    chart:chartType "line" ;
    chart:title "Are people born gay or lesbian or does this develop due to upbringing and environmental factors ?" ;
    chart:xAxis ex:x-6022 ;
    chart:yAxis ex:y-6022 .

ex:x-6022 a chart:Axis ;
    chart:label "Response" ;
    chart:scaleMin "1980" ;
    chart:scaleMax "2010" .

ex:y-6022 a chart:Axis ;
    chart:label "Upbringing/environment" ;
    chart:scaleMin "0.0" ;
    chart:scaleMax "0.6" .

ex:series-6022-1 a chart:Series .

ex:dp-6022-1-1 a chart:DataPoint ;
    chart:series ex:series-6022-1 ;
    chart:xVal "1980" ;
    chart:yVal "0.56"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-6022-1-2 a chart:DataPoint ;
    chart:series ex:series-6022-1 ;
    chart:xVal "1985" ;
    chart:yVal "0.52"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-6022-1-3 a chart:DataPoint ;
    chart:series ex:series-6022-1 ;
    chart:xVal "1990" ;
    chart:yVal "0.48"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-6022-1-4 a chart:DataPoint ;
    chart:series ex:series-6022-1 ;
    chart:xVal "1995" ;
    chart:yVal "0.40"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-6022-1-5 a chart:DataPoint ;
    chart:series ex:series-6022-1 ;
    chart:xVal "2000" ;
    chart:yVal "0.44"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-6022-1-6 a chart:DataPoint ;
    chart:series ex:series-6022-1 ;
    chart:xVal "2005" ;
    chart:yVal "0.38"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-6022-1-7 a chart:DataPoint ;
    chart:series ex:series-6022-1 ;
    chart:xVal "2010" ;
    chart:yVal "0.32"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-6022-1-8 a chart:DataPoint ;
    chart:series ex:series-6022-1 ;
    chart:xVal "2015" ;
    chart:yVal "0.30"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-6022-1-9 a chart:DataPoint ;
    chart:series ex:series-6022-1 ;
    chart:xVal "2018" ;
    chart:yVal "0.29"^^xsd:decimal ;
    chart:valueEstimated "true" .
