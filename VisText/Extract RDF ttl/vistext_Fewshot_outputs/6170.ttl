@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-6170 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "NFL players ranked by salary and endorsement income in 2020 (in million U.S. dollars)" ;
    chart:xAxis ex:x-6170 ;
    chart:yAxis ex:y-6170 .

ex:x-6170 a chart:Axis ;
    chart:label "" ;
    chart:scaleMin "" ;
    chart:scaleMax "" .

ex:y-6170 a chart:Axis ;
    chart:label "Salary/Bonuses" ;
    chart:scaleMin "0" ;
    chart:scaleMax "40" .

ex:series-6170-1 a chart:Series .

ex:dp-6170-1-1 a chart:DataPoint ;
    chart:series ex:series-6170-1 ;
    chart:category "Aaron Rodgers" ;
    chart:value "21.5"^^xsd:decimal ;
    chart:valueEstimated "true" .

