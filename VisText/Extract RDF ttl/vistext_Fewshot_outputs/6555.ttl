@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-6555 a chart:Chart ;
    chart:chartType "area" ;
    chart:title "Luxembourg : Distribution of employment by economic sector from 2010 to 2020" ;
    chart:xAxis ex:x-6555 ;
    chart:yAxis ex:y-6555 .

ex:x-6555 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2010" ;
    chart:scaleMax "2020" .

ex:y-6555 a chart:Axis ;
    chart:label "Agriculture" ;
    chart:scaleMin "0.000" ;
    chart:scaleMax "0.015" .

ex:series-6555-1 a chart:Series .

ex:dp-6555-1-1 a chart:DataPoint ;
    chart:series ex:series-6555-1 ;
    chart:xVal "2010" ;
    chart:yVal "0.008"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-6555-1-2 a chart:DataPoint ;
    chart:series ex:series-6555-1 ;
    chart:xVal "2011" ;
    chart:yVal "0.010"^^xsd:decimal ;
    chart:valueEstimated "true" .

