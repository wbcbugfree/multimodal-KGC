@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-6518 a chart:Chart ;
    chart:chartType "area" ;
    chart:title "Honduras : Distribution of employment by economic sector from 2010 to 2020" ;
    chart:xAxis ex:x-6518 ;
    chart:yAxis ex:y-6518 .

ex:x-6518 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2010" ;
    chart:scaleMax "2020" .

ex:y-6518 a chart:Axis ;
    chart:label "" ;
    chart:scaleMin "0.00" ;
    chart:scaleMax "0.25" .

ex:series-6518-1 a chart:Series ;
    chart:seriesName "Industry" .

ex:dp-6518-1-1 a chart:DataPoint ;
    chart:series ex:series-6518-1 ;
    chart:xVal "2010" ;
    chart:yVal "0.18"^^xsd:decimal ;
    chart:value "0.18"^^xsd:decimal ;
    chart:valueEstimated "true" .

