@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-8603 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Impact of coronavirus (COVID-19) on monthly retail sales development in the United States 2020 , by retail sector" ;
    chart:xAxis ex:x-8603 ;
    chart:yAxis ex:y-8603 .

ex:x-8603 a chart:Axis ;
    chart:label "July to August" ;
    chart:scaleMin "-0.06" ;
    chart:scaleMax "0.02" .

ex:y-8603 a chart:Axis ;
    chart:label "retail sector" .

ex:series-8603-1 a chart:Series .

ex:dp-8603-1-1 a chart:DataPoint ;
    chart:series ex:series-8603-1 ;
    chart:category "Building material & garden ..." ;
    chart:value "0.015"^^xsd:decimal ;
    chart:valueEstimated "true" .

