@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-5901 a chart:Chart ;
    chart:chartType "area" ;
    chart:title "Value added of U.S. motor vehicle and parts manufacturing as a percentage of GDP between 2005 and 2017" ;
    chart:xAxis ex:x-5901 ;
    chart:yAxis ex:y-5901 .

ex:x-5901 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2005" ;
    chart:scaleMax "2017" .

ex:y-5901 a chart:Axis ;
    chart:label "Value added as a percentage of GDP" ;
    chart:scaleMin "0.000" ;
    chart:scaleMax "0.010" .

ex:series-5901-1 a chart:Series .

ex:dp-5901-1-1 a chart:DataPoint ;
    chart:series ex:series-5901-1 ;
    chart:xVal "2005" ;
    chart:yVal "0.010"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

