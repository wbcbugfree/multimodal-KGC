@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-3445 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Romania : Budget balance between 2015 to 2025 in relation to GDP" ;
    chart:xAxis ex:x-3445 ;
    chart:yAxis ex:y-3445 .

ex:x-3445 a chart:Axis ;
    chart:label "Budget balance in relation to GDP" ;
    chart:scaleMin "-0.10" ;
    chart:scaleMax "0.00" .

ex:y-3445 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2015" ;
    chart:scaleMax "2025*" .

ex:series-3445-1 a chart:Series .

ex:dp-3445-1-1 a chart:DataPoint ;
    chart:series ex:series-3445-1 ;
    chart:category "2015" ;
    chart:value "-0.01"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-3445-1-2 a chart:DataPoint ;
    chart:series ex:series-3445-1 ;
    chart:category "2016" ;
    chart:value "-0.01"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-3445-1-3 a chart:DataPoint ;
    chart:series ex:series-3445-1 ;
    chart:category "2017" ;
    chart:value "-0.02"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-3445-1-4 a chart:DataPoint ;
    chart:series ex:series-3445-1 ;
    chart:category "2018" ;
    chart:value "-0.03"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-3445-1-5 a chart:DataPoint ;
    chart:series ex:series-3445-1 ;
    chart:category "2019" ;
    chart:value "-0.045"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-3445-1-6 a chart:DataPoint ;
    chart:series ex:series-3445-1 ;
    chart:category "2020*" ;
    chart:value "-0.08"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-3445-1-7 a chart:DataPoint ;
    chart:series ex:series-3445-1 ;
    chart:category "2021*" ;
    chart:value "-0.07"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-3445-1-8 a chart:DataPoint ;
    chart:series ex:series-3445-1 ;
    chart:category "2022*" ;
    chart:value "-0.075"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-3445-1-9 a chart:DataPoint ;
    chart:series ex:series-3445-1 ;
    chart:category "2023*" ;
    chart:value "-0.08"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-3445-1-10 a chart:DataPoint ;
    chart:series ex:series-3445-1 ;
    chart:category "2024*" ;
    chart:value "-0.085"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-3445-1-11 a chart:DataPoint ;
