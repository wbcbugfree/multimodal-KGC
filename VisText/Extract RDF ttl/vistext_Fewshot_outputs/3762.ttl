@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-3762 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Number of enterprises in the manufacture of leather and related products industry in Denmark from 2008 to 2017" ;
    chart:xAxis ex:x-3762 ;
    chart:yAxis ex:y-3762 .

ex:x-3762 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2008" ;
    chart:scaleMax "2017*" .

ex:y-3762 a chart:Axis ;
    chart:label "Number of enterprises" ;
    chart:scaleMin "0" ;
    chart:scaleMax "70" .

ex:series-3762-1 a chart:Series .

ex:dp-3762-1-1 a chart:DataPoint ;
    chart:series ex:series-3762-1 ;
    chart:category "2008" ;
    chart:value "64"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-3762-1-2 a chart:DataPoint ;
    chart:series ex:series-3762-1 ;
    chart:category "2009" ;
    chart:value "59"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-3762-1-3 a chart:DataPoint ;
    chart:series ex:series-3762-1 ;
    chart:category "2010" ;
    chart:value "61"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-3762-1-4 a chart:DataPoint ;
    chart:series ex:series-3762-1 ;
    chart:category "2011" ;
    chart:value "61"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-3762-1-5 a chart:DataPoint ;
    chart:series ex:series-3762-1 ;
    chart:category "2012" ;
    chart:value "64"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-3762-1-6 a char:DataPoint ;
    chart:series ex:series-3762-1 ;
    chart:category "2013" ;
    chart:value "60"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-3762-1-7 a chart:DataPoint ;
    chart:series ex:series-3762-1 ;
    chart:category "2014" ;
    chart:value "59"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-3762-1-8 a chart:DataPoint ;
    chart:series ex:series-3762-1 ;
    chart:category "2015" ;
    chart:value "62"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-3762-1-9 a chart:DataPoint ;
    chart:series ex:series-3762-1 ;
    chart:category "2016" ;
    chart:value "64"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-3762-1-10 a chart:DataPoint ;
    chart:series ex:series-3762-1 ;
    chart:category "2017*" ;
    chart:value "68"^^xsd:decimal ;
    chart:valueEstimated "true" .
