@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-2628 a chart:Chart ;
    chart:chartType "area" ;
    chart:title "Number of new COVID-19 confirmed cases in Australia March to September 2020" ;
    chart:xAxis ex:x-2628 ;
    chart:yAxis ex:y-2628 .

ex:x-2628 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "March" ;
    chart:scaleMax "September" .

ex:y-2628 a chart:Axis ;
    chart:label "Number of new confirmed cases" ;
    chart:scaleMin "0" ;
    chart:scaleMax "800" .

ex:series-2628-1 a chart:Series .

ex:dp-2628-1-1 a chart:DataPoint ;
    chart:series ex:series-2628-1 ;
    chart:xVal "March" ;
    chart:yVal "100"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-2628-1-2 a chart:DataPoint ;
    chart:series ex:series-2628-1 ;
    chart:xVal "April" ;
    chart:yVal "400"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-2628-1-3 a chart:DataPoint ;
    chart:series ex:series-2628-1 ;
    chart:xVal "May" ;
    chart:yVal "50"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-2628-1-4 a chart:DataPoint ;
    chart:series ex:series-2628-1 ;
    chart:xVal "June" ;
    chart:yVal "150"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-2628-1-5 a chart:DataPoint ;
    chart:series ex:series-2628-1 ;
    chart:xVal "July" ;
    chart:yVal "550"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-2628-1-6 a chart:DataPoint ;
    chart:series ex:series-2628-1 ;
    chart:xVal "August" ;
    chart:yVal "300"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-2628-1-7 a chart:DataPoint ;
    chart:series ex:series-2628-1 ;
    chart:xVal "September" ;
    chart:yVal "100"^^xsd:decimal ;
    chart:valueEstimated "true" .
