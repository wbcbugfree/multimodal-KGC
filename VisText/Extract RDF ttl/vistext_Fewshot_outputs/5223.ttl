@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-5223 a chart:Chart ;
    chart:chartType "line" ;
    chart:title "Pig production in Malaysia from 2005 to 2018 (in million heads)" ;
    chart:xAxis ex:x-5223 ;
    chart:yAxis ex:y-5223 .

ex:x-5223 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2005" ;
    chart:scaleMax "2018" .

ex:y-5223 a chart:Axis ;
    chart:label "Production in million heads" ;
    chart:scaleMin "0.0" ;
    chart:scaleMax "2.0" .

ex:series-5223-1 a chart:Series .

ex:dp-5223-1-1 a chart:DataPoint ;
    chart:series ex:series-5223-1 ;
    chart:xVal "2005" ;
    chart:yVal "2.05"^^xsd:decimal ;
    chart:valueEstimated "true" .

