@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-335 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Cities with the largest number of ball diamonds per 10,000 residents in the United States in 2019" ;
    chart:xAxis ex:x-335 ;
    chart:yAxis ex:y-335 .

ex:x-335 a chart:Axis ;
    chart:label "Ball diamonds per 10,000 residents" ;
    chart:scaleMin "0" ;
    chart:scaleMax "5" .

ex:y-335 a chart:Axis ;
    chart:label "city of the United States" .

ex:series-335-1 a chart:Series .

ex:dp-335-1-1 a chart:DataPoint ;
    chart:series ex:series-335-1 ;
    chart:category "Baltimore, MD" ;
    chart:value "2.5"^^xsd:decimal ;
    chart:valueEstimated "true" .

