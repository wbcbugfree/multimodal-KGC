@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-6061 a chart:Chart ;
    chart:chartType "area" ;
    chart:title "Portugal : Share of economic sectors in gross domestic product (GDP) from 2009 to 2019" ;
    chart:xAxis ex:x-6061 ;
    chart:yAxis ex:y-6061 .

ex:x-6061 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2009" ;
    chart:scaleMax "2019" .

ex:y-6061 a chart:Axis ;
    chart:label "Agriculture" ;
    chart:scaleMin "0.000" ;
    chart:scaleMax "0.020" .

ex:series-6061-1 a chart:Series .

ex:dp-6061-1-1 a chart:DataPoint ;
    chart:series ex:series-6061-1 ;
    chart:xVal "2009" ;
    chart:yVal "0.0195"^^xsd:decimal ;
    chart:valueEstimated "true" .

