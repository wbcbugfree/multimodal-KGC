@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-8496 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Number of book readers in Italy in 2019 , by occupation and number of books read (in 1,000 readers)" ;
    chart:xAxis ex:x-8496 ;
    chart:yAxis ex:y-8496 .

ex:x-8496 a chart:Axis ;
    chart:label "occupation" .

ex:y-8496 a chart:Axis ;
    chart:label "From 1 to 3 books" ;
    chart:scaleMin "0" ;
    chart:scaleMax "2000" .

ex:series-8496-1 a chart:Series .

ex:dp-8496-1-1 a chart:DataPoint ;
    chart:series ex:series-8496-1 ;
    chart:category "Blue collar, apprentice" ;
    chart:value "1300"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-8496-1-2 a chart:DataPoint ;
    chart:series ex:series-8496-1 ;
    chart:category "Executive, employer, professional" ;
    chart:value "650"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-8496-1-3 a chart:DataPoint ;
    chart:series ex:series-8496-1 ;
    chart:category "Middle management, white collar" ;
    chart:value "1100"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-8496-1-4 a chart:DataPoint ;
    chart:series ex:series-8496-1 ;
    chart:category "Housewife" ;
    chart:value "2200"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-8496-1-5 a chart:DataPoint ;
    chart:series ex:series-8496-1 ;
    chart:category "Other condition" ;
    chart:value "200"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-8496-1-6 a chart:DataPoint ;
    chart:series ex:series-8496-1 ;
    chart:category "Retired" ;
    chart:value "1500"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-8496-1-7 a chart:DataPoint ;
    chart:series ex:series-8496-1 ;
    chart:category "Self-employed, family worker" ;
    chart:value "550"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-8496-1-8 a chart:DataPoint ;
    chart:series ex:series-8496-1 ;
    chart:category "Student" ;
    chart:value "1250"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-8496-1-9 a chart:DataPoint ;
    chart:series ex:series-8496-1 ;
    chart:category "Unemployed person with work ex..." ;
    chart:value "750"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-8496-1-10 a chart:DataPoint ;
    chart:series ex:series-8496-1 ;
    chart:category "Unemployed person without work ..." ;
    chart:value "250"^^xsd:decimal ;
    chart:valueEstimated "true" .
