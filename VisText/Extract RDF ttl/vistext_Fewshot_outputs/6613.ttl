@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-6613 a chart:Chart ;
    chart:chartType "line" ;
    chart:title "Latvia : Distribution of employment by economic sector from 2010 to 2020" ;
    chart:xAxis ex:x-6613 ;
    chart:yAxis ex:y-6613 .

ex:x-6613 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2010" ;
    chart:scaleMax "2020" .

ex:y-6613 a chart:Axis ;
    chart:label "" ;
    chart:scaleMin "0.00" ;
    chart:scaleMax "0.09" .

ex:series-6613-1 a chart:Series ;
    chart:seriesName "Agriculture" .

ex:dp-6613-1-1 a chart:DataPoint ;
    chart:series ex:series-6613-1 ;
    chart:xVal "2010" ;
    chart:yVal "0.083"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-6613-1-2 a chart:DataPoint ;
    chart:series ex:series-6613-1 ;
    chart:xVal "2011" ;
    chart:yVal "0.085"^^xsd:decimal ;
    chart:valueEstimated "true" .

