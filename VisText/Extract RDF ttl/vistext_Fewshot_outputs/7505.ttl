@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-7505 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Confirmed cases and deaths of major virus outbreaks worldwide in the last 50 years as of 2020" ;
    chart:xAxis ex:x-7505 ;
    chart:yAxis ex:y-7505 .

ex:x-7505 a chart:Axis ;
    chart:label "Virus (year identified)" ;
    chart:scaleMin "" ;
    chart:scaleMax "" .

ex:y-7505 a chart:Axis ;
    chart:label "Deaths" ;
    chart:scaleMin "0" ;
    chart:scaleMax "300,000" .

ex:series-7505-1 a chart:Series .

ex:dp-7505-1-1 a chart:DataPoint ;
    chart:series ex:series-7505-1 ;
    chart:category "2019-nCoV* (2020)" ;
    chart:value "10000"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-7505-1-2 a chart:DataPoint ;
    chart:series ex:series-7505-1 ;
    chart:category "Ebola* (1976)" ;
    chart:value "2000"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-7505-1-3 a chart:DataPoint ;
    chart:series ex:series-7505-1 ;
    chart:category "H1N1** (2009)" ;
    chart:value "250000"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-7505-1-4 a chart:DataPoint ;
    chart:series ex:series-7505-1 ;
    chart:category "H5N1 Bird Flu (1997)" ;
    chart:value "0"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-7505-1-5 a chart:DataPoint ;
    chart:series ex:series-7505-1 ;
    chart:category "H7N9 Bird Flu (2013)" ;
    chart:value "0"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-7505-1-6 a chart:DataPoint ;
    chart:series ex:series-7505-1 ;
    chart:category "Hendra (1994)" ;
    chart:value "0"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-7505-1-7 a chart:DataPoint ;
    chart:series ex:series-7505-1 ;
    chart:category "MERS*** (2012)" ;
    chart:value "0"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-7505-1-8 a chart:DataPoint ;
    chart:series ex:series-7505-1 ;
    chart:category "Marberg (1967)" ;
    chart:value "0"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-7505-1-9 a chart:DataPoint ;
    chart:series ex:series-7505-1 ;
    chart:category "Nipah (1998)" ;
    chart:value "0"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-7505-1-10 a chart:DataPoint ;
    chart:series ex:series-7505-1 ;
    chart:category "SARS (2002)" ;
    chart:value "0"^^xsd:decimal ;
    chart:valueEstimated "true" .
