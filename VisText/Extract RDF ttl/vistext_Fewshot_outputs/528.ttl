    chart:series ex:series-528-1 ;
    chart:category "Ed Kranepool" ;
    chart:value "1400"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-528-1-6 a chart:DataPoint ;
    chart:series ex:series-528-1 ;
