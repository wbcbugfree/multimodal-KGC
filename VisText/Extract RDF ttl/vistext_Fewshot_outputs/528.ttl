@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-528 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "New York Mets all-time RBI (runs batted in) leaders as of October 2020" ;
    chart:xAxis ex:x-528 ;
    chart:yAxis ex:y-528 .

ex:x-528 a chart:Axis ;
    chart:label "Number of home runs" ;
    chart:scaleMin "0" ;
    chart:scaleMax "1000" .

ex:y-528 a chart:Axis ;
    chart:label "all-time RBI leaders" ;
    chart:scaleMin "" ;
    chart:scaleMax "" .

ex:series-528-1 a chart:Series .

ex:dp-528-1-1 a chart:DataPoint ;
    chart:series ex:series-528-1 ;
    chart:category "Carlos Beltran" ;
    chart:value "570"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-528-1-2 a chart:DataPoint ;
    chart:series ex:series-528-1 ;
    chart:category "Cleon Jones" ;
    chart:value "490"^^xsd:decimal ;
    chart:valueEstimated "true" .

