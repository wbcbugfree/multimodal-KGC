    chart:valueEstimated "true" .

ex:dp-528-1-7 a chart:DataPoint ;
    chart:series ex:series-528-1 ;
    chart:category "Howard Johnson" ;
    chart:value "500"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-528-1-8 a chart:DataPoint ;
    chart:series ex:series-528-1 ;
    chart:category "Jose Reyes" ;
    chart:value "550"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-528-1-9 a chart:DataPoint ;
