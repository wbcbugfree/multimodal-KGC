@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-3105 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Largest export commodities of the United Kingdom (UK) in 2019 (in billion GBP)" ;
    chart:xAxis ex:x-3105 ;
    chart:yAxis ex:y-3105 .

ex:x-3105 a chart:Axis ;
    chart:label "Value of exports in billion GBP" ;
    chart:scaleMin "0" ;
    chart:scaleMax "150" .

ex:y-3105 a chart:Axis ;
    chart:label "Export commodity" .

ex:series-3105-1 a chart:Series .

ex:dp-3105-1-1 a chart:DataPoint ;
    chart:series ex:series-3105-1 ;
    chart:category "Animal, vegetable oils and fats" ;
    chart:value "2"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-3105-1-2 a chart:DataPoint ;
    chart:series ex:series-3105-1 ;
    chart:category "Beverages and tobacco" ;
    chart:value "2"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-3105-1-3 a chart:DataPoint ;
    chart:series ex:series-3105-1 ;
    chart:category "Chemicals" ;
    chart:value "30"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-3105-1-4 a chart:DataPoint ;
    chart:series ex:series-3105-1 ;
    chart:category "Crude Materials" ;
    chart:value "2"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-3105-1-5 a chart:DataPoint ;
    chart:series ex:series-3105-1 ;
    chart:category "Food and live animals" ;
    chart:value "7"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-3105-1-6 a chart:DataPoint ;
    chart:series ex:series-3105-1 ;
    chart:category "Fuels" ;
    chart:value "25"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-3105-1-7 a chart:DataPoint ;
    chart:series ex:series-3105-1 ;
    chart:category "Machinery and transport equipment" ;
    chart:value "155"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-3105-1-8 a chart:DataPoint ;
    chart:series ex:series-3105-1 ;
    chart:category "Material Manufactures" ;
    chart:value "30"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-3105-1-9 a chart:DataPoint ;
    chart:series ex:series-3105-1 ;
    chart:category "Miscellanueous manufactures" ;
    chart:value "45"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-3105-1-10 a chart:DataPoint ;
    chart:series ex:series-3105-1 ;
    chart:category "Unspecified goods" ;
    chart:value "7"^^xsd:decimal ;
    chart:valueEstimated "true" .
