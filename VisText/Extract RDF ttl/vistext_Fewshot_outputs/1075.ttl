@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-1075 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Number of hospital beds in Czechia from 2000 to 2018" ;
    chart:xAxis ex:x-1075 ;
    chart:yAxis ex:y-1075 .

ex:x-1075 a chart:Axis ;
    chart:label "Number of hospital beds" ;
    chart:scaleMin "0" ;
    chart:scaleMax "80000" .

ex:y-1075 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "" ;
    chart:scaleMax "" .

ex:series-1075-1 a chart:Series .

ex:dp-1075-1-1 a chart:DataPoint ;
    chart:series ex:series-1075-1 ;
    chart:category "2000*" ;
    chart:value "77000"^^xsd:decimal ;
    chart:valueEstimated "true" .

