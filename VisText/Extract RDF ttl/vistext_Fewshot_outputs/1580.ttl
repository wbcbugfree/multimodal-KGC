@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-1580 a chart:Chart ;
    chart:chartType "line" ;
    chart:title "Argentina \'s MERVAL stock exchange index from January 2 to October 15 , 2020 (in Argentine pesos)" ;
    chart:xAxis ex:x-1580 ;
    chart:yAxis ex:y-1580 .

ex:x-1580 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "January" ;
    chart:scaleMax "October" .

ex:y-1580 a chart:Axis ;
    chart:label "MERVAL in Argentine pesos" ;
    chart:scaleMin "0" ;
    chart:scaleMax "50000" .

ex:series-1580-1 a chart:Series .

ex:dp-1580-1-1 a chart:DataPoint ;
    chart:series ex:series-1580-1 ;
    chart:xVal "January" ;
    chart:yVal "42000"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-1580-1-2 a chart:DataPoint ;
    chart:series ex:series-1580-1 ;
    chart:xVal "February" ;
    chart:yVal "41000"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-1580-1-3 a chart:DataPoint ;
    chart:series ex:series-1580-1 ;
    chart:xVal "March" ;
    chart:yVal "25000"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-1580-1-4 a chart:DataPoint ;
    chart:series ex:series-1580-1 ;
    chart:xVal "April" ;
    chart:yVal "28000"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-1580-1-5 a chart:DataPoint ;
    chart:series ex:series-1580-1 ;
    chart:xVal "May" ;
    chart:yVal "32000"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-1580-1-6 a chart:DataPoint ;
    chart:series ex:series-1580-1 ;
    chart:xVal "June" ;
    chart:yVal "38000"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-1580-1-7 a chart:DataPoint ;
    chart:series ex:series-1580-1 ;
    chart:xVal "July" ;
    chart:yVal "45000"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-1580-1-8 a chart:DataPoint ;
    chart:series ex:series-1580-1 ;
    chart:xVal "August" ;
    chart:yVal "48000"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-1580-1-9 a chart:DataPoint ;
    chart:series ex:series-1580-1 ;
    chart:xVal "September" ;
    chart:yVal "51000"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-1580-1-10 a chart:DataPoint ;
    chart:series ex:series-1580-1 ;
    chart:xVal "October" ;
    chart:yVal "48000"^^xsd:decimal ;
    chart:valueEstimated "true" .
