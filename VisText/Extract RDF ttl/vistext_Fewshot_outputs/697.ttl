@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-697 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Gross monthly salary of Congress members in Latin America in 2018 , by country (in U.S. dollars)" ;
    chart:xAxis ex:x-697 ;
    chart:yAxis ex:y-697 .

ex:x-697 a chart:Axis ;
    chart:label "Monthly salary in U.S. dollars" ;
    chart:scaleMin "0" ;
    chart:scaleMax "20000" .

ex:y-697 a chart:Axis ;
    chart:label "Country" .

ex:series-697-1 a chart:Series .

ex:dp-697-1-1 a chart:DataPoint ;
    chart:series ex:series-697-1 ;
    chart:category "Argentina" ;
    chart:value "7000"^^xsd:decimal ;
    chart:valueEstimated "true" .

