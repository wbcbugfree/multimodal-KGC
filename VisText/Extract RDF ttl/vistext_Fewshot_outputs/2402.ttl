@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-2402 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Number of tax filers in Canada in 2018 , by province" ;
    chart:xAxis ex:x-2402 ;
    chart:yAxis ex:y-2402 .

ex:x-2402 a chart:Axis ;
    chart:label "province of Canada" ;
    chart:scaleMin "" ;
    chart:scaleMax "" .

ex:y-2402 a chart:Axis ;
    chart:label "Number of taxfilers" ;
    chart:scaleMin "0" ;
    chart:scaleMax "10000000" .

ex:series-2402-1 a chart:Series .

ex:dp-2402-1-1 a chart:DataPoint ;
    chart:series ex:series-2402-1 ;
    chart:category "Alberta" ;
    chart:value "4200000"^^xsd:decimal ;
    chart:valueEstimated "true" .

