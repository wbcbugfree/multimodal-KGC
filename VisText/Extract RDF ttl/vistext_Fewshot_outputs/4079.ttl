@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-4079 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Contribution of travel and tourism to GDP in the United States from 2008 to 2028 (in trillion U.S. dollars)" ;
    chart:xAxis ex:x-4079 ;
    chart:yAxis ex:y-4079 .

ex:x-4079 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2008" ;
    chart:scaleMax "2028" .

ex:y-4079 a chart:Axis ;
    chart:label "Contribution in trillion U.S. dollars" ;
    chart:scaleMin "0.0" ;
    chart:scaleMax "2.0" .

ex:series-4079-1 a chart:Series .

ex:dp-4079-1-1 a chart:DataPoint ;
    chart:series ex:series-4079-1 ;
    chart:category "2008" ;
    chart:value "1.28"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-4079-1-2 a chart:DataPoint ;
    chart:series ex:series-4079-1 ;
    chart:category "2009" ;
    chart:value "1.12"^^xsd:decimal ;
    chart:valueEstimated "true" .

