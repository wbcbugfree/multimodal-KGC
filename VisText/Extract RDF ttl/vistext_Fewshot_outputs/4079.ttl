    chart:valueEstimated "true" .

ex:dp-4079-1-7 a chart:DataPoint ;
    chart:series ex:series-4079-1 ;
    chart:category "2014" ;
    chart:value "1.34"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-4079-1-8 a chart:DataPoint ;
    chart:series ex:series-4079-1 ;
    chart:category "2015" ;
    chart:value "1.37"^^xsd:decimal ;
