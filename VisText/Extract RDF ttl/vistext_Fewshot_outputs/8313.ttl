@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-8313 a chart:Chart ;
    chart:chartType "area" ;
    chart:title "Percentage of people who identify with a political party in Great Britain (GB) from 1997 to 2012 , by party" ;
    chart:xAxis ex:x-8313 ;
    chart:yAxis ex:y-8313 .

ex:x-8313 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "1997" ;
    chart:scaleMax "2012" .

ex:y-8313 a chart:Axis ;
    chart:label "Conservative" ;
    chart:scaleMin "0.00" ;
    chart:scaleMax "0.35" .

ex:series-8313-1 a chart:Series ;
    chart:seriesName "Conservative" .

ex:dp-8313-1-1 a chart:DataPoint ;
    chart:series ex:series-8313-1 ;
    chart:xVal "1997" ;
    chart:yVal "0.27"^^xsd:decimal ;
    chart:value "0.27"^^xsd:decimal ;
    chart:valueEstimated "true" .

