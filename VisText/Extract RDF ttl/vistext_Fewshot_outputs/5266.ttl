@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-5266 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Leading Cricket Twenty20 World Cup wicket-takers as of September 2020" ;
    chart:xAxis ex:x-5266 ;
    chart:yAxis ex:y-5266 .

ex:x-5266 a chart:Axis ;
    chart:label "Number of wickets taken" ;
    chart:scaleMin "0" ;
    chart:scaleMax "40" .

ex:y-5266 a chart:Axis ;
    chart:label "player name" .

ex:series-5266-1 a chart:Series .

ex:dp-5266-1-1 a chart:DataPoint ;
    chart:series ex:series-5266-1 ;
    chart:category "BAW Mendis (SL)" ;
    chart:value "38"^^xsd:decimal ;
    chart:valueEstimated "true" .

