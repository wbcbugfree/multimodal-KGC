    chart:value "0.37"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-3674-1-7 a chart:DataPoint ;
    chart:series ex:series-3674-1 ;
    chart:category "2021*" ;
    chart:value "0.375"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-3674-1-8 a chart:DataPoint ;
