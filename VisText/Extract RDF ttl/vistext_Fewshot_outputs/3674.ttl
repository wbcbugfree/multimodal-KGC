    chart:series ex:series-3674-1 ;
    chart:category "2018" ;
    chart:value "0.36"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-3674-1-5 a chart:DataPoint ;
    chart:series ex:series-3674-1 ;
    chart:category "2019*" ;
    chart:value "0.365"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-3674-1-6 a chart:DataPoint ;
    chart:series ex:series-3674-1 ;
