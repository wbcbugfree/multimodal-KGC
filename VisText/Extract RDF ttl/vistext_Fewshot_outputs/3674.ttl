@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-3674 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "The Bahamas : Total population from 2015 to 2025 (in million inhabitants)" ;
    chart:xAxis ex:x-3674 ;
    chart:yAxis ex:y-3674 .

ex:x-3674 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2015" ;
    chart:scaleMax "2025*" .

ex:y-3674 a chart:Axis ;
    chart:label "Inhabitants in millions" ;
    chart:scaleMin "0.0" ;
    chart:scaleMax "0.4" .

ex:series-3674-1 a chart:Series .

ex:dp-3674-1-1 a chart:DataPoint ;
    chart:series ex:series-3674-1 ;
    chart:category "2015" ;
    chart:value "0.34"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-3674-1-2 a chart:DataPoint ;
    chart:series ex:series-3674-1 ;
    chart:category "2016" ;
    chart:value "0.35"^^xsd:decimal ;
    chart:valueEstimated "true" .

