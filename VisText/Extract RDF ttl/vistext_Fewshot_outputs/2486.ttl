@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-2486 a chart:Chart ;
    chart:chartType "area" ;
    chart:xAxis ex:x-2486 ;
    chart:yAxis ex:y-2486 .

ex:x-2486 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2010" ;
    chart:scaleMax "2018" .

ex:y-2486 a chart:Axis ;
    chart:label "Consumption in billion U.S. dollars*" ;
    chart:scaleMin "0" ;
    chart:scaleMax "4" .

ex:series-2486-1 a chart:Series .

ex:dp-2486-1-1 a chart:DataPoint ;
    chart:series ex:series-2486-1 ;
    chart:xVal "2010" ;
    chart:yVal "3.9"^^xsd:decimal ;
    chart:value "3.9"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-2486-1-2 a chart:DataPoint ;
    chart:series ex:series-2486-1 ;
    chart:xVal "2012" ;
    chart:yVal "3.5"^^xsd:decimal ;
    chart:value "3.5"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-2486-1-3 a chart:DataPoint ;
    chart:series ex:series-2486-1 ;
    chart:xVal "2014" ;
    chart:yVal "3.9"^^xsd:decimal ;
    chart:value "3.9"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-2486-1-4 a chart:DataPoint ;
    chart:series ex:series-2486-1 ;
    chart:xVal "2016" ;
    chart:yVal "3.7"^^xsd:decimal ;
    chart:value "3.7"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-2486-1-5 a chart:DataPoint ;
    chart:series ex:series-2486-1 ;
    chart:xVal "2018" ;
    chart:yVal "3.9"^^xsd:decimal ;
    chart:value "3.9"^^xsd:decimal ;
    chart:valueEstimated "true" .
