@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-2872 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Most valuable Swiss watch brands worldwide in 2016 (in million CHF)" ;
    chart:xAxis ex:x-2872 ;
    chart:yAxis ex:y-2872 .

ex:x-2872 a chart:Axis ;
    chart:label "Brand" .

ex:y-2872 a chart:Axis ;
    chart:label "Brand value in million CHF" ;
    chart:scaleMin "0" ;
    chart:scaleMax "8000" .

ex:series-2872-1 a chart:Series .

ex:dp-2872-1-1 a chart:DataPoint ;
    chart:series ex:series-2872-1 ;
    chart:category "Audemars Piguet" ;
    chart:value "900"^^xsd:decimal ;
    chart:valueEstimated "true" .

