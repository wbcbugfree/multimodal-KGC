@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-8444 a chart:Chart ;
    chart:chartType "line" ;
    chart:xAxis ex:x-8444 ;
    chart:yAxis ex:y-8444 .

ex:x-8444 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "1970" ;
    chart:scaleMax "2020" .

ex:y-8444 a chart:Axis ;
    chart:label "White" ;
    chart:scaleMin "0" ;
    chart:scaleMax "2000" .

ex:series-8444-1 a chart:Series .

ex:dp-8444-1-1 a chart:DataPoint ;
    chart:series ex:series-8444-1 ;
    chart:xVal "1978" ;
    chart:yVal "1100"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-8444-1-2 a chart:DataPoint ;
    chart:series ex:series-8444-1 ;
    chart:xVal "1988" ;
    chart:yVal "1200"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-8444-1-3 a chart:DataPoint ;
    chart:series ex:series-8444-1 ;
    chart:xVal "1998" ;
    chart:yVal "1300"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-8444-1-4 a chart:DataPoint ;
    chart:series ex:series-8444-1 ;
    chart:xVal "2000" ;
    chart:yVal "1400"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-8444-1-5 a chart:DataPoint ;
    chart:series ex:series-8444-1 ;
    chart:xVal "2005" ;
    chart:yVal "1550"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-8444-1-6 a chart:DataPoint ;
    chart:series ex:series-8444-1 ;
    chart:xVal "2008" ;
    chart:yVal "1500"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-8444-1-7 a chart:DataPoint ;
    chart:series ex:series-8444-1 ;
    chart:xVal "2010" ;
    chart:yVal "1480"^^xsd:decimal ;
    chart:valueEstimated "true" .
