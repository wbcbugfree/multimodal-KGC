    chart:series ex:series-1621-1 ;
    chart:xVal "2011" ;
    chart:yVal "35000"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-1621-1-5 a chart:DataPoint ;
    chart:series ex:series-1621-1 ;
    chart:xVal "2012" ;
