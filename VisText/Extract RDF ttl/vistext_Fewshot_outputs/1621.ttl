@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-1621 a chart:Chart ;
    chart:chartType "area" ;
    chart:title "Registered number of bike thefts in Belgium from 2008 to 2019" ;
    chart:xAxis ex:x-1621 ;
    chart:yAxis ex:y-1621 .

ex:x-1621 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2008" ;
    chart:scaleMax "2019" .

ex:y-1621 a chart:Axis ;
    chart:label "Number of bike thefts" ;
    chart:scaleMin "0" ;
    chart:scaleMax "40000" .

ex:series-1621-1 a chart:Series .

ex:dp-1621-1-1 a chart:DataPoint ;
    chart:series ex:series-1621-1 ;
    chart:xVal "2008" ;
    chart:yVal "37000"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-1621-1-2 a chart:DataPoint ;
    chart:series ex:series-1621-1 ;
    chart:xVal "2009" ;
    chart:yVal "39000"^^xsd:decimal ;
    chart:valueEstimated "true" .

