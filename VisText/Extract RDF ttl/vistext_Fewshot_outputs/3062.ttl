@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-3062 a chart:Chart ;
    chart:chartType "line" ;
    chart:xAxis ex:x-3062 ;
    chart:yAxis ex:y-3062 .

ex:x-3062 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "1800" ;
    chart:scaleMax "2000" .

ex:y-3062 a chart:Axis ;
    chart:label "Population in millions" ;
    chart:scaleMin "0" ;
    chart:scaleMax "20" .

ex:series-3062-1 a chart:Series .

ex:dp-3062-1-1 a chart:DataPoint ;
    chart:series ex:series-3062-1 ;
    chart:xVal "1800" ;
    chart:yVal "0.1"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-3062-1-2 a chart:DataPoint ;
    chart:series ex:series-3062-1 ;
    chart:xVal "1850" ;
    chart:yVal "0.2"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-3062-1-3 a chart:DataPoint ;
    chart:series ex:series-3062-1 ;
    chart:xVal "1900" ;
    chart:yVal "1.0"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-3062-1-4 a chart:DataPoint ;
    chart:series ex:series-3062-1 ;
    chart:xVal "1950" ;
    chart:yVal "5.0"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-3062-1-5 a chart:DataPoint ;
    chart:series ex:series-3062-1 ;
    chart:xVal "1975" ;
    chart:yVal "10.0"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-3062-1-6 a chart:DataPoint ;
    chart:series ex:series-3062-1 ;
    chart:xVal "2000" ;
    chart:yVal "20.0"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-3062-1-7 a chart:DataPoint ;
    chart:series ex:series-3062-1 ;
    chart:xVal "2010" ;
    chart:yVal "25.0"^^xsd:decimal ;
    chart:valueEstimated "true" .
