@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-2056 a chart:Chart ;
    chart:chartType "line" ;
    chart:title "Economic damage caused by North Atlantic tropical cyclones in the U.S. from 1995 to 2019 (in million U.S. dollars)" ;
    chart:xAxis ex:x-2056 ;
    chart:yAxis ex:y-2056 .

ex:x-2056 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "1995" ;
    chart:scaleMax "2019" .

ex:y-2056 a chart:Axis ;
    chart:label "Damage in million U.S. dollars" ;
    chart:scaleMin "0" ;
    chart:scaleMax "100000" .

ex:series-2056-1 a chart:Series .

ex:dp-2056-1-1 a chart:DataPoint ;
    chart:series ex:series-2056-1 ;
    chart:xVal "1995" ;
    chart:yVal "5000"^^xsd:decimal ;
    chart:valueEstimated "true" .

