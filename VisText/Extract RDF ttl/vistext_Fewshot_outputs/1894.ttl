@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-1894 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Share of people using the internet to pay bills or shop something in the past year in Singapore in 2017 , by type of population" ;
    chart:xAxis ex:x-1894 ;
    chart:yAxis ex:y-1894 .

ex:x-1894 a chart:Axis ;
    chart:label "Share of respondents" ;
    chart:scaleMin "0.0" ;
    chart:scaleMax "0.8" .

ex:y-1894 a chart:Axis ;
    chart:label "Response" ;
    chart:scaleMin "" ;
    chart:scaleMax "" .

ex:series-1894-1 a chart:Series .

ex:dp-1894-1-1 a chart:DataPoint ;
    chart:series ex:series-1894-1 ;
    chart:category "Adults (25 years and older)" ;
    chart:value "0.75"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-1894-1-2 a chart:DataPoint ;
    chart:series ex:series-1894-1 ;
    chart:category "In labor" ;
    chart:value "0.70"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-1894-1-3 a chart:DataPoint ;
    chart:series ex:series-1894-1 ;
    chart:category "Men" ;
    chart:value "0.65"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-1894-1-4 a chart:DataPoint ;
    chart:series ex:series-1894-1 ;
    chart:category "Out of labor" ;
    chart:value "0.18"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-1894-1-5 a chart:DataPoint ;
    chart:series ex:series-1894-1 ;
    chart:category "Poorest 40% (income)" ;
    chart:value "0.15"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-1894-1-6 a chart:DataPoint ;
    chart:series ex:series-1894-1 ;
    chart:category "Primary education or less" ;
    chart:value "0.68"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-1894-1-7 a chart:DataPoint ;
    chart:series ex:series-1894-1 ;
    chart:category "Richest 60% (income)" ;
    chart:value "0.60"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-1894-1-8 a chart:DataPoint ;
    chart:series ex:series-1894-1 ;
    chart:category "Secondary education or less" ;
    chart:value "0.55"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-1894-1-9 a chart:DataPoint ;
    chart:series ex:series-1894-1 ;
    chart:category "Total" ;
    chart:value "0.65"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-1894-1-10 a chart:DataPoint ;
    chart:series ex:series-1894-1 ;
    chart:category "Women" ;
    chart:value "0.45"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-1894-1-11 a chart:DataPoint ;
    chart:series ex:series-1894-1 ;
    chart:category "Young adults (15-24 years)" ;
    chart:value "0.60"^^xsd:decimal ;
    chart:valueEstimated "true" .
