@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-7051 a chart:Chart ;
    chart:chartType "line" ;
    chart:title "Percentage of households in the U.S. from 1990 to 2020 , by type" ;
    chart:xAxis ex:x-7051 ;
    chart:yAxis ex:y-7051 .

ex:x-7051 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "1990" ;
    chart:scaleMax "2020" .

ex:y-7051 a chart:Axis ;
    chart:label "Female householder, no spouse present" ;
    chart:scaleMin "0.00" ;
    chart:scaleMax "0.14" .

ex:series-7051-1 a chart:Series .

ex:dp-7051-1-1 a chart:DataPoint ;
    chart:series ex:series-7051-1 ;
    chart:xVal "1990" ;
    chart:yVal "0.12"^^xsd:decimal ;
    chart:value "0.12"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-7051-1-2 a chart:DataPoint ;
    chart:series ex:series-7051-1 ;
    chart:xVal "1995" ;
    chart:yVal "0.125"^^xsd:decimal ;
    chart:value "0.125"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-7051-1-3 a chart:DataPoint ;
    chart:series ex:series-7051-1 ;
    chart:xVal "2000" ;
    chart:yVal "0.128"^^xsd:decimal ;
    chart:value "0.128"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-7051-1-4 a chart:DataPoint ;
    chart:series ex:series-7051-1 ;
    chart:xVal "2005" ;
    chart:yVal "0.132"^^xsd:decimal ;
    chart:value "0.132"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-7051-1-5 a chart:DataPoint ;
    chart:series ex:series-7051-1 ;
    chart:xVal "2010" ;
    chart:yVal "0.134"^^xsd:decimal ;
    chart:value "0.134"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-7051-1-6 a chart:DataPoint ;
    chart:series ex:series-7051-1 ;
    chart:xVal "2015" ;
    chart:yVal "0.128"^^xsd:decimal ;
    chart:value "0.128"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-7051-1-7 a chart:DataPoint ;
    chart:series ex:series-7051-1 ;
    chart:xVal "2020" ;
    chart:yVal "0.122"^^xsd:decimal ;
    chart:value "0.122"^^xsd:decimal ;
    chart:valueEstimated "true" .
