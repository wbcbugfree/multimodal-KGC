@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-8522 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Estimated change in GDP in selected countries due to economic crisis in percent" ;
    chart:xAxis ex:x-8522 ;
    chart:yAxis ex:y-8522 .

ex:x-8522 a chart:Axis ;
    chart:label "2009 *" ;
    chart:scaleMin "-8" ;
    chart:scaleMax "0" .

ex:y-8522 a chart:Axis ;
    chart:label "Country" ;
    chart:scaleMin "" ;
    chart:scaleMax "" .

ex:series-8522-1 a chart:Series .

ex:dp-8522-1-1 a chart:DataPoint ;
    chart:series ex:series-8522-1 ;
    chart:category "Austria" ;
    chart:value "-0.5"^^xsd:decimal ;
    chart:valueEstimated "true" .

