@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-8775 a chart:Chart ;
    chart:chartType "bar" ;
    chart:xAxis ex:x-8775 ;
    chart:yAxis ex:y-8775 .

ex:x-8775 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2010" ;
    chart:scaleMax "2018" .

ex:y-8775 a chart:Axis ;
    chart:label "15-64 years" ;
    chart:scaleMin "0.0" ;
    chart:scaleMax "0.6" .

ex:series-8775-1 a chart:Series .

ex:mark-8775-1-1 a chart:DataPoint ;
    chart:series ex:series-8775-1 ;
    chart:category "2010" ;
    chart:value "0.62"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:mark-8775-1-2 a chart:DataPoint ;
    chart:series ex:series-8775-1 ;
    chart:category "2012" ;
    chart:value "0.62"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:mark-8775-1-3 a chart:DataPoint ;
    chart:series ex:series-8775-1 ;
    chart:category "2014" ;
    chart:value "0.62"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:mark-8775-1-4 a chart:DataPoint ;
    chart:series ex:series-8775-1 ;
    chart:category "2016" ;
    chart:value "0.62"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:mark-8775-1-5 a chart:DataPoint ;
    chart:series ex:series-8775-1 ;
    chart:category "2018" ;
    chart:value "0.62"^^xsd:decimal ;
    chart:valueEstimated "true" .
