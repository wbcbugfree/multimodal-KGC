@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-4755 a chart:Chart ;
    chart:chartType "line" ;
    chart:title "Revenue from music streaming in the United States from 2010 to 2019 (in billion U.S. dollars)" ;
    chart:xAxis ex:x-4755 ;
    chart:yAxis ex:y-4755 .

ex:x-4755 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2010" ;
    chart:scaleMax "2019" .

ex:y-4755 a chart:Axis ;
    chart:label "Revenue in billion U.S. dollars" ;
    chart:scaleMin "0" ;
    chart:scaleMax "10" .

ex:series-4755-1 a chart:Series .

ex:dp-4755-1-1 a chart:DataPoint ;
    chart:series ex:series-4755-1 ;
    chart:xVal "2010" ;
    chart:yVal "0.5"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-4755-1-2 a chart:DataPoint ;
    chart:series ex:series-4755-1 ;
    chart:xVal "2012" ;
    chart:yVal "1.0"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-4755-1-3 a chart:DataPoint ;
    chart:series ex:series-4755-1 ;
    chart:xVal "2014" ;
    chart:yVal "2.2"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-4755-1-4 a chart:DataPoint ;
    chart:series ex:series-4755-1 ;
    chart:xVal "2016" ;
    chart:yVal "4.0"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-4755-1-5 a chart:DataPoint ;
    chart:series ex:series-4755-1 ;
    chart:xVal "2018" ;
    chart:yVal "8.0"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-4755-1-6 a chart:DataPoint ;
    chart:series ex:series-4755-1 ;
    chart:xVal "2019" ;
    chart:yVal "9.7"^^xsd:decimal ;
    chart:valueEstimated "true" .
