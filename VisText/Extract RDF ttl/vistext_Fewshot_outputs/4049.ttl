@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-4049 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Leading U.S. states based on value of barley production in 2018 (in 1,000 U.S. dollars)" ;
    chart:xAxis ex:x-4049 ;
    chart:yAxis ex:y-4049 .

ex:x-4049 a chart:Axis ;
    chart:label "Production value in thousand U.S. dollars" ;
    chart:scaleMin "0" ;
    chart:scaleMax "250000" .

ex:y-4049 a chart:Axis ;
    chart:label "State" ;
    chart:scaleMin "" ;
    chart:scaleMax "" .

ex:series-4049-1 a chart:Series .

ex:dp-4049-1-1 a chart:DataPoint ;
    chart:series ex:series-4049-1 ;
    chart:category "Arizona" ;
    chart:value "2000"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-4049-1-2 a chart:DataPoint ;
    chart:series ex:series-4049-1 ;
    chart:category "California" ;
    chart:value "5000"^^xsd:decimal ;
    chart:valueEstimated "true" .

