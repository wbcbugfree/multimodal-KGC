@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-7809 a chart:Chart ;
    chart:chartType "bar" ;
    chart:xAxis ex:x-7809 ;
    chart:yAxis ex:y-7809 .

ex:x-7809 a chart:Axis ;
    chart:label "Male" ;
    chart:scaleMin "0.0" ;
    chart:scaleMax "0.4" .

ex:y-7809 a chart:Axis ;
