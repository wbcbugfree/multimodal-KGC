@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-2289 a chart:Chart ;
    chart:chartType "line" ;
    chart:title "Average annual expenditure on delivery services per consumer unit in the United States from 2007 to 2019 (in U.S. dollars)" ;
    chart:xAxis ex:x-2289 ;
    chart:yAxis ex:y-2289 .

ex:x-2289 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2007" ;
    chart:scaleMax "2019" .

ex:y-2289 a chart:Axis ;
    chart:label "Average annual expenditure in U.S. dollars" ;
    chart:scaleMin "0" ;
    chart:scaleMax "10" .

ex:series-2289-1 a chart:Series .

ex:dp-2289-1-1 a chart:DataPoint ;
    chart:series ex:series-2289-1 ;
    chart:xVal "2007" ;
    chart:yVal "3.0"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-2289-1-2 a chart:DataPoint ;
    chart:series ex:series-2289-1 ;
    chart:xVal "2008" ;
    chart:yVal "4.2"^^xsd:decimal ;
    chart:valueEstimated "true" .

