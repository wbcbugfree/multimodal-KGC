@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-5072 a chart:Chart ;
    chart:chartType "area" ;
    chart:title "Divorce rate in Luxembourg from 2008 to 2019 (per 1,000 inhabitants)" ;
    chart:xAxis ex:x-5072 ;
    chart:yAxis ex:y-5072 .

ex:x-5072 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2008" ;
    chart:scaleMax "2019" .

ex:y-5072 a chart:Axis ;
    chart:label "Divorce rate per thousand inhabitants" ;
    chart:scaleMin "0.0" ;
    chart:scaleMax "3.5" .

ex:series-5072-1 a chart:Series .

ex:dp-5072-1-1 a chart:DataPoint ;
    chart:series ex:series-5072-1 ;
    chart:xVal "2008" ;
    chart:yVal "2.1"^^xsd:decimal ;
    chart:value "2.1"^^xsd:decimal ;
    chart:valueEstimated "true" .

