@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-389 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Leading 10 U.S. companies based on medical device revenue in 2019 (in billion U.S. dollars)" ;
    chart:xAxis ex:x-389 ;
    chart:yAxis ex:y-389 .

ex:x-389 a chart:Axis ;
    chart:label "Revenue in billion U.S. dollars" ;
    chart:scaleMin "0" ;
    chart:scaleMax "35" .

ex:y-389 a chart:Axis ;
    chart:label "companies based on medical device" .

ex:series-389-1 a chart:Series .

ex:dp-389-1-1 a chart:DataPoint ;
    chart:series ex:series-389-1 ;
    chart:category "Abbott Laboratories" ;
    chart:value "8"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-389-1-2 a chart:DataPoint ;
    chart:series ex:series-389-1 ;
    chart:category "Baxter International Inc." ;
    chart:value "7"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-389-1-3 a chart:DataPoint ;
    chart:series ex:series-389-1 ;
    chart:category "Becton Dickinson & Co." ;
    chart:value "7.5"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-389-1-4 a chart:DataPoint ;
    chart:series ex:series-389-1 ;
    chart:category "Boston Scientific Corp." ;
    chart:value "5.5"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-389-1-5 a chart:DataPoint ;
    chart:series ex:series-389-1 ;
    chart:category "Cardinal Health" ;
    chart:value "12"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-389-1-6 a chart:DataPoint ;
    chart:series ex:series-389-1 ;
    chart:category "General Electric Healthcare**" ;
    chart:value "19"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-389-1-7 a chart:DataPoint ;
    chart:series ex:series-389-1 ;
    chart:category "Johnson & Johnson Medical Device..." ;
    chart:value "28"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-389-1-8 a chart:DataPoint ;
    chart:series ex:series-389-1 ;
    chart:category "Medtronic Inc.*" ;
    chart:value "30"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-389-1-9 a chart:DataPoint ;
    chart:series ex:series-389-1 ;
    chart:category "Stryker Corp." ;
    chart:value "14"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-389-1-10 a chart:DataPoint ;
    chart:series ex:series-389-1 ;
    chart:category "Zimmer Biomet" ;
    chart:value "7"^^xsd:decimal ;
    chart:valueEstimated "true" .
