@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-5129 a chart:Chart ;
    chart:chartType "line" ;
    chart:title "Annual solar module production globally from 2000 to 2018 (in megawatts)" ;
    chart:xAxis ex:x-5129 ;
    chart:yAxis ex:y-5129 .

ex:x-5129 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2000" ;
    chart:scaleMax "2018" .

ex:y-5129 a chart:Axis ;
    chart:label "Production in megawatts" ;
    chart:scaleMin "0" ;
    chart:scaleMax "120000" .

ex:series-5129-1 a chart:Series .

ex:dp-5129-1-1 a chart:DataPoint ;
    chart:series ex:series-5129-1 ;
    chart:xVal "2000" ;
    chart:yVal "1000"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-5129-1-2 a chart:DataPoint ;
    chart:series ex:series-5129-1 ;
    chart:xVal "2002" ;
    chart:yVal "2000"^^xsd:decimal ;
    chart:valueEstimated "true" .

