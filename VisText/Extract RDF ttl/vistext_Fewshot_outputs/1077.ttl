@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-1077 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Coffee consumption in Canada from 2010 to 2021 (in million 60-kilogram bags)" ;
    chart:xAxis ex:x-1077 ;
    chart:yAxis ex:y-1077 .

ex:x-1077 a chart:Axis ;
    chart:label "Year" .

ex:y-1077 a chart:Axis ;
    chart:label "Consumption in million 60-kilogram bags" ;
    chart:scaleMin "0" ;
    chart:scaleMax "5" .

ex:series-1077-1 a chart:Series .

ex:dp-1077-1-1 a chart:DataPoint ;
    chart:series ex:series-1077-1 ;
    chart:category "2010/11" ;
    chart:value "4.2"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-1077-1-2 a chart:DataPoint ;
    chart:series ex:series-1077-1 ;
    chart:category "2011/12" ;
    chart:value "4.1"^^xsd:decimal ;
    chart:valueEstimated "true" .

