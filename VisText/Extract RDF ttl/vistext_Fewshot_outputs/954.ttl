@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-954 a chart:Chart ;
    chart:chartType "area" ;
    chart:title "Kenya : Birth rate from 2008 to 2018 (per 1,000 inhabitants)" ;
    chart:xAxis ex:x-954 ;
    chart:yAxis ex:y-954 .

ex:x-954 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2008" ;
    chart:scaleMax "2018" .

ex:y-954 a chart:Axis ;
    chart:label "Birth rate per thousand population" ;
    chart:scaleMin "0" ;
    chart:scaleMax "40" .

ex:series-954-1 a chart:Series .

ex:dp-954-1-1 a chart:DataPoint ;
    chart:series ex:series-954-1 ;
    chart:xVal "2008" ;
    chart:yVal "36.5"^^xsd:decimal ;
    chart:value "36.5"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-954-1-2 a chart:DataPoint ;
    chart:series ex:series-954-1 ;
    chart:xVal "2010" ;
    chart:yVal "35.0"^^xsd:decimal ;
    chart:value "35.0"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-954-1-3 a chart:DataPoint ;
    chart:series ex:series-954-1 ;
    chart:xVal "2012" ;
    chart:yVal "33.0"^^xsd:decimal ;
    chart:value "33.0"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-954-1-4 a chart:DataPoint ;
    chart:series ex:series-954-1 ;
    chart:xVal "2014" ;
    chart:yVal "31.5"^^xsd:decimal ;
    chart:value "31.5"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-954-1-5 a chart:DataPoint ;
    chart:series ex:series-954-1 ;
    chart:xVal "2016" ;
    chart:yVal "30.0"^^xsd:decimal ;
    chart:value "30.0"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-954-1-6 a chart:DataPoint ;
    chart:series ex:series-954-1 ;
    chart:xVal "2018" ;
    chart:yVal "29.0"^^xsd:decimal ;
    chart:value "29.0"^^xsd:decimal ;
    chart:valueEstimated "true" .
