@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-6913 a chart:Chart ;
    chart:chartType "area" ;
    chart:title "Consumer Price Index of pan , tobacco , and intoxicants across urban and rural India from March 2019 to March 2020 , by month" ;
    chart:xAxis ex:x-6913 ;
    chart:yAxis ex:y-6913 .

ex:x-6913 a chart:Axis ;
    chart:label "Month" ;
    chart:scaleMin "March 2019" ;
    chart:scaleMax "March 2020" .

ex:y-6913 a chart:Axis ;
    chart:label "Urban" ;
    chart:scaleMin "0" ;
    chart:scaleMax "175" .

ex:series-6913-1 a chart:Series ;
    chart:seriesName "Urban" .

ex:dp-6913-1-1 a chart:DataPoint ;
    chart:series ex:series-6913-1 ;
    chart:category "March 2019" ;
    chart:value "160"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-6913-1-2 a chart:DataPoint ;
    chart:series ex:series-6913-1 ;
    chart:category "April" ;
    chart:value "162"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-6913-1-3 a chart:DataPoint ;
    chart:series ex:series-6913-1 ;
    chart:category "July" ;
    chart:value "165"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-6913-1-4 a chart:DataPoint ;
    chart:series ex:series-6913-1 ;
    chart:category "October" ;
    chart:value "168"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-6913-1-5 a chart:DataPoint ;
    chart:series ex:series-6913-1 ;
    chart:category "2020" ;
    chart:value "170"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-6913-1-6 a chart:DataPoint ;
    chart:series ex:series-6913-1 ;
    chart:category "March 2020" ;
    chart:value "172"^^xsd:decimal ;
    chart:valueEstimated "true" .
