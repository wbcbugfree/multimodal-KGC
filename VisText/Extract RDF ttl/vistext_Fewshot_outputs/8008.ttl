@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-8008 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Preferred number of TV show episodes to watch in one binge watching session among Generation X and Baby Boomers in the United Kingdom (UK) in December 2016" ;
    chart:xAxis ex:x-8008 ;
    chart:yAxis ex:y-8008 .

ex:x-8008 a chart:Axis ;
    chart:label "60 years and older" ;
    chart:scaleMin "0.00" ;
    chart:scaleMax "0.25" .

ex:y-8008 a chart:Axis ;
    chart:label "Response" .

ex:series-8008-1 a chart:Series .

ex:mark-8008-1-1 a chart:DataPoint ;
    chart:series ex:series-8008-1 ;
    chart:category "1 episode" ;
    chart:value "0.02"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:mark-8008-1-2 a chart:DataPoint ;
    chart:series ex:series-8008-1 ;
    chart:category "10 episodes" ;
    chart:value "0.13"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:mark-8008-1-3 a chart:DataPoint ;
    chart:series ex:series-8008-1 ;
    chart:category "2 episodes" ;
    chart:value "0.12"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:mark-8008-1-4 a chart:DataPoint ;
    chart:series ex:series-8008-1 ;
    chart:category "3 episodes" ;
    chart:value "0.06"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:mark-8008-1-5 a chart:DataPoint ;
    chart:series ex:series-8008-1 ;
    chart:category "4 episodes" ;
    chart:value "0.05"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:mark-8008-1-6 a chart:DataPoint ;
    chart:series ex:series-8008-1 ;
    chart:category "5 episodes" ;
    chart:value "0.02"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:mark-8008-1-7 a chart:DataPoint ;
    chart:series ex:series-8008-1 ;
    chart:category "6 episodes" ;
    chart:value "0.01"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:mark-8008-1-8 a chart:DataPoint ;
    chart:series ex:series-8008-1 ;
    chart:category "7 episodes" ;
    chart:value "0.00"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:mark-8008-1-9 a chart:DataPoint ;
    chart:series ex:series-8008-1 ;
    chart:category "8 episodes" ;
    chart:value "0.22"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:mark-8008-1-10 a chart:DataPoint ;
    chart:series ex:series-8008-1 ;
    chart:category "9 episodes" ;
    chart:value "0.02"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:mark-8008-1-11 a chart:DataPoint ;
    chart:series ex:series-8008-1 ;
    chart:category "Don't know" ;
    chart:value "0.00"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:mark-8008-1-12 a chart:DataPoint ;
    chart:series ex:series-8008-1 ;
    chart:category "More than 10 episodes" ;
    chart:value "0.00"^^xsd:decimal ;
    chart:valueEstimated "true" .
