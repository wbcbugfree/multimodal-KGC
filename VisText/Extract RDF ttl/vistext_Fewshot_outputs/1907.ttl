@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-1907 a chart:Chart ;
    chart:chartType "area" ;
    chart:title "Infant mortality rate (under one year old) in Germany from 1840 to 2020" ;
    chart:xAxis ex:x-1907 ;
    chart:yAxis ex:y-1907 .

ex:x-1907 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "1840" ;
    chart:scaleMax "2020" .

ex:y-1907 a chart:Axis ;
    chart:label "Deaths per 1,000 live births" ;
    chart:scaleMin "0" ;
    chart:scaleMax "350" .

ex:series-1907-1 a chart:Series .

ex:dp-1907-1-1 a chart:DataPoint ;
    chart:series ex:series-1907-1 ;
    chart:xVal "1840" ;
    chart:yVal "295"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-1907-1-2 a chart:DataPoint ;
    chart:series ex:series-1907-1 ;
    chart:xVal "1850" ;
    chart:yVal "300"^^xsd:decimal ;
    chart:valueEstimated "true" .

