@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-2272 a chart:Chart ;
    chart:chartType "area" ;
    chart:title "Production area of pineapples worldwide from 2002 to 2018 (in 1,000 hectares)" ;
    chart:xAxis ex:x-2272 ;
    chart:yAxis ex:y-2272 .

ex:x-2272 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2002" ;
    chart:scaleMax "2018" .

ex:y-2272 a chart:Axis ;
    chart:label "Area in thousand hectares" ;
    chart:scaleMin "0" ;
    chart:scaleMax "1200" .

ex:series-2272-1 a chart:Series .

ex:dp-2272-1-1 a chart:DataPoint ;
    chart:series ex:series-2272-1 ;
    chart:xVal "2002" ;
    chart:yVal "650"^^xsd:decimal ;
    chart:valueEstimated "true" .

