@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-5979 a chart:Chart ;
    chart:chartType "line" ;
    chart:title "Share of Google in the mobile search engine market across India from April 2019 to May 2020" ;
    chart:xAxis ex:x-5979 ;
    chart:yAxis ex:y-5979 .

ex:x-5979 a chart:Axis ;
    chart:label "Month" ;
    chart:scaleMin "April 2019" ;
    chart:scaleMax "May 2020" .

ex:y-5979 a chart:Axis ;
    chart:label "Market share" ;
    chart:scaleMin "0.0" ;
    chart:scaleMax "1.0" .

ex:series-5979-1 a chart:Series ;
    chart:seriesName "Google Market Share" .

ex:dp-5979-1-1 a chart:DataPoint ;
    chart:series ex:series-5979-1 ;
    chart:xVal "April 2019" ;
    chart:yVal "0.98"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-5979-1-2 a chart:DataPoint ;
    chart:series ex:series-5979-1 ;
    chart:xVal "July 2019" ;
    chart:yVal "0.98"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-5979-1-3 a chart:DataPoint ;
    chart:series ex:series-5979-1 ;
    chart:xVal "October 2019" ;
    chart:yVal "0.98"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-5979-1-4 a chart:DataPoint ;
    chart:series ex:series-5979-1 ;
    chart:xVal "April 2020" ;
    chart:yVal "0.98"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-5979-1-5 a chart:DataPoint ;
    chart:series ex:series-5979-1 ;
    chart:xVal "May 2020" ;
    chart:yVal "0.98"^^xsd:decimal ;
    chart:valueEstimated "true" .
