@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-7362 a chart:Chart ;
    chart:chartType "area" ;
    chart:title "U.S. e-commerce value of household appliances and electrical goods wholesale trade from 2007 to 2018 (in million U.S. dollars)" ;
    chart:xAxis ex:x-7362 ;
    chart:yAxis ex:y-7362 .

ex:x-7362 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2007" ;
    chart:scaleMax "2018" .

ex:y-7362 a chart:Axis ;
    chart:label "Total" ;
    chart:scaleMin "0" ;
    chart:scaleMax "800000" .

ex:series-7362-1 a chart:Series .

ex:dp-7362-1-1 a chart:DataPoint ;
    chart:series ex:series-7362-1 ;
    chart:xVal "2007" ;
    chart:yVal "400000"^^xsd:decimal ;
    chart:value "400000"^^xsd:decimal ;
    chart:valueEstimated "true" .

