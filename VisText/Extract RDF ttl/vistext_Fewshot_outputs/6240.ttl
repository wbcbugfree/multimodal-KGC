@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-6240 a chart:Chart ;
    chart:chartType "area" ;
    chart:title "Total U.S. domestic use of corn from 2001 to 2019 (in million bushels)" ;
    chart:xAxis ex:x-6240 ;
    chart:yAxis ex:y-6240 .

ex:x-6240 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2001" ;
    chart:scaleMax "2019" .

ex:y-6240 a chart:Axis ;
    chart:label "Feed and residual" ;
    chart:scaleMin "0" ;
    chart:scaleMax "6000" .

ex:series-6240-1 a chart:Series .

ex:dp-6240-1-1 a chart:DataPoint ;
    chart:series ex:series-6240-1 ;
    chart:xVal "2001" ;
    chart:yVal "6100"^^xsd:decimal ;
    chart:value "6100"^^xsd:decimal ;
    chart:valueEstimated "true" .

