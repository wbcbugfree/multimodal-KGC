@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-1263 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Minnesota Twins all-time games played leaders as of October 2020" ;
    chart:xAxis ex:x-1263 ;
    chart:yAxis ex:y-1263 .

ex:x-1263 a chart:Axis ;
    chart:label "Number of games played" ;
    chart:scaleMin "0" ;
    chart:scaleMax "2500" .

ex:y-1263 a chart:Axis ;
    chart:label "Player" .

ex:series-1263-1 a chart:Series .

ex:dp-1263-1-1 a chart:DataPoint ;
    chart:series ex:series-1263-1 ;
    chart:category "Clyde Milan" ;
    chart:value "1700"^^xsd:decimal ;
    chart:valueEstimated "true" .

