@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-1447 a chart:Chart ;
    chart:chartType "line" ;
    chart:title "Average viewers of Dota 2 on Twitch worldwide from January 2018 to November 2020 (in 1,000s)" ;
    chart:xAxis ex:x-1447 ;
    chart:yAxis ex:y-1447 .

ex:x-1447 a chart:Axis ;
    chart:label "Month" ;
    chart:scaleMin "2018" ;
    chart:scaleMax "2020" .

ex:y-1447 a chart:Axis ;
    chart:label "Number of viewers in thousands" ;
    chart:scaleMin "0" ;
    chart:scaleMax "100" .

ex:series-1447-1 a chart:Series .

