@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-867 a chart:Chart ;
    chart:chartType "area" ;
    chart:title "Number of participants in roller hockey in the United States from 2006 to 2017 (in millions)" ;
    chart:xAxis ex:x-867 ;
    chart:yAxis ex:y-867 .

ex:x-867 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2006" ;
    chart:scaleMax "2017" .

ex:y-867 a chart:Axis ;
    chart:label "Number of participants in millions" ;
    chart:scaleMin "0.0" ;
    chart:scaleMax "2.0" .

ex:series-867-1 a chart:Series .

ex:dp-867-1-1 a chart:DataPoint ;
    chart:series ex:series-867-1 ;
    chart:xVal "2006" ;
    chart:yVal "1.4"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-867-1-2 a chart:DataPoint ;
    chart:series ex:series-867-1 ;
    chart:xVal "2007" ;
    chart:yVal "1.8"^^xsd:decimal ;
    chart:valueEstimated "true" .

