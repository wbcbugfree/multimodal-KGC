@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-8066 a chart:Chart ;
    chart:chartType "area" ;
    chart:title "Is casino gaming in the U.S. acceptable for yourself and others ?" ;
    chart:xAxis ex:x-8066 ;
    chart:yAxis ex:y-8066 .

ex:x-8066 a chart:Axis ;
    chart:label "Response" ;
    chart:scaleMin "2002" ;
    chart:scaleMax "2012" .

ex:y-8066 a chart:Axis ;
    chart:label "Acceptable for you and others**" ;
    chart:scaleMin "0.0" ;
    chart:scaleMax "0.6" .

ex:series-8066-1 a chart:Series .

ex:dp-8066-1-1 a chart:DataPoint ;
    chart:series ex:series-8066-1 ;
    chart:xVal "2002" ;
    chart:yVal "0.53"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-8066-1-2 a chart:DataPoint ;
    chart:series ex:series-8066-1 ;
    chart:xVal "2004" ;
    chart:yVal "0.56"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-8066-1-3 a chart:DataPoint ;
    chart:series ex:series-8066-1 ;
    chart:xVal "2006" ;
    chart:yVal "0.54"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-8066-1-4 a chart:DataPoint ;
    chart:series ex:series-8066-1 ;
    chart:xVal "2008" ;
    chart:yVal "0.52"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-8066-1-5 a chart:DataPoint ;
    chart:series ex:series-8066-1 ;
    chart:xVal "2010" ;
    chart:yVal "0.47"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-8066-1-6 a chart:DataPoint ;
    chart:series ex:series-8066-1 ;
    chart:xVal "2012" ;
    chart:yVal "0.49"^^xsd:decimal ;
    chart:valueEstimated "true" .
