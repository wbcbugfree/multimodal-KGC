@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-170 a chart:Chart ;
    chart:chartType "area" ;
    chart:title "Laos : Infant mortality rate from 2009 to 2019 (in deaths per 1,000 live births)" ;
    chart:xAxis ex:x-170 ;
    chart:yAxis ex:y-170 .

ex:x-170 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2009" ;
    chart:scaleMax "2019" .

ex:y-170 a chart:Axis ;
    chart:label "Deaths per 1,000 live births" ;
    chart:scaleMin "0" ;
    chart:scaleMax "50" .

ex:series-170-1 a chart:Series .

ex:dp-170-1-1 a chart:DataPoint ;
    chart:series ex:series-170-1 ;
    chart:xVal "2010" ;
    chart:yVal "52.5"^^xsd:decimal ;
    chart:value "52.5"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-170-1-2 a chart:DataPoint ;
    chart:series ex:series-170-1 ;
    chart:xVal "2012" ;
    chart:yVal "47.5"^^xsd:decimal ;
    chart:value "47.5"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-170-1-3 a chart:DataPoint ;
    chart:series ex:series-170-1 ;
    chart:xVal "2014" ;
    chart:yVal "42.5"^^xsd:decimal ;
    chart:value "42.5"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-170-1-4 a chart:DataPoint ;
    chart:series ex:series-170-1 ;
    chart:xVal "2016" ;
    chart:yVal "37.5"^^xsd:decimal ;
    chart:value "37.5"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-170-1-5 a chart:DataPoint ;
    chart:series ex:series-170-1 ;
    chart:xVal "2018" ;
    chart:yVal "32.5"^^xsd:decimal ;
    chart:value "32.5"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-170-1-6 a chart:DataPoint ;
    chart:series ex:series-170-1 ;
    chart:xVal "2019" ;
    chart:yVal "30.0"^^xsd:decimal ;
    chart:value "30.0"^^xsd:decimal ;
    chart:valueEstimated "true" .
