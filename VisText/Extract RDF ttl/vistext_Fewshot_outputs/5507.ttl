@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-5507 a chart:Chart ;
    chart:chartType "area" ;
    chart:title "Per capita consumption of fresh fruit in the United States from 2000 to 2019 (in pounds)" ;
    chart:xAxis ex:x-5507 ;
    chart:yAxis ex:y-5507 .

ex:x-5507 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2000" ;
    chart:scaleMax "2019" .

ex:y-5507 a chart:Axis ;
    chart:label "Per capita consumption in pounds" ;
    chart:scaleMin "0" ;
    chart:scaleMax "120" .

ex:series-5507-1 a chart:Series .

ex:dp-5507-1-1 a chart:DataPoint ;
    chart:series ex:series-5507-1 ;
    chart:xVal "2000" ;
    chart:yVal "100"^^xsd:decimal ;
    chart:value "100"^^xsd:decimal ;
    chart:valueEstimated "true" .

