@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-3246 a chart:Chart ;
    chart:chartType "area" ;
    chart:title "ExxonMobil 's research and development costs from 2001 to 2019 (in million U.S. dollars)" ;
    chart:xAxis ex:x-3246 ;
    chart:yAxis ex:y-3246 .

ex:x-3246 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2001" ;
    chart:scaleMax "2019" .

ex:y-3246 a chart:Axis ;
    chart:label "Costs in million U.S. dollars" ;
    chart:scaleMin "0" ;
    chart:scaleMax "1200" .

ex:series-3246-1 a chart:Series .

ex:dp-3246-1-1 a chart:DataPoint ;
    chart:series ex:series-3246-1 ;
    chart:xVal "2001" ;
    chart:yVal "600"^^xsd:decimal ;
    chart:value "600"^^xsd:decimal ;
    chart:valueEstimated "true" .

