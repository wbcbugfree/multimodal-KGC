@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-5597 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Most popular payment methods for everyday transactions according to internet users worldwide as of June 2018" ;
    chart:xAxis ex:x-5597 ;
    chart:yAxis ex:y-5597 .

ex:x-5597 a chart:Axis ;
    chart:label "Response" .

ex:y-5597 a chart:Axis ;
    chart:label "Share of respondents" ;
    chart:scaleMin "0.0" ;
    chart:scaleMax "0.4" .

ex:series-5597-1 a chart:Series .

ex:mark-5597-1-1 a chart:DataPoint ;
    chart:series ex:series-5597-1 ;
    chart:category "Buy buttons" ;
    chart:value "0.08"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:mark-5597-1-2 a chart:DataPoint ;
    chart:series ex:series-5597-1 ;
    chart:category "In-store" ;
    chart:value "0.41"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:mark-5597-1-3 a chart:DataPoint ;
    chart:series ex:series-5597-1 ;
    chart:category "Mobile messenger apps" ;
    chart:value "0.07"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:mark-5597-1-4 a chart:DataPoint ;
    chart:series ex:series-5597-1 ;
    chart:category "Other" ;
    chart:value "0.02"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:mark-5597-1-5 a chart:DataPoint ;
    chart:series ex:series-5597-1 ;
    chart:category "Other in-app payments" ;
    chart:value "0.04"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:mark-5597-1-6 a chart:DataPoint ;
    chart:series ex:series-5597-1 ;
    chart:category "Other mobile transfers" ;
    chart:value "0.07"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:mark-5597-1-7 a chart:DataPoint ;
    chart:series ex:series-5597-1 ;
    chart:category "Other online" ;
    chart:value "0.12"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:mark-5597-1-8 a chart:DataPoint ;
