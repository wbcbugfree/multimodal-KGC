@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-1279 a chart:Chart ;
    chart:chartType "line" ;
    chart:title "Canada : Birth rate from 2008 to 2018 (per 1,000 inhabitants)" ;
    chart:xAxis ex:x-1279 ;
    chart:yAxis ex:y-1279 .

ex:x-1279 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2008" ;
    chart:scaleMax "2018" .

ex:y-1279 a chart:Axis ;
    chart:label "Birth rate per thousand population" ;
    chart:scaleMin "0" ;
    chart:scaleMax "12" .

ex:series-1279-1 a chart:Series .

ex:dp-1279-1-1 a chart:DataPoint ;
    chart:series ex:series-1279-1 ;
    chart:xVal "2008" ;
    chart:yVal "11.3"^^xsd:decimal ;
    chart:value "11.3"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-1279-1-2 a chart:DataPoint ;
    chart:series ex:series-1279-1 ;
    chart:xVal "2010" ;
    chart:yVal "10.9"^^xsd:decimal ;
    chart:value "10.9"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-1279-1-3 a chart:DataPoint ;
    chart:series ex:series-1279-1 ;
    chart:xVal "2012" ;
    chart:yVal "10.7"^^xsd:decimal ;
    chart:value "10.7"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-1279-1-4 a chart:DataPoint ;
    chart:series ex:series-1279-1 ;
    chart:xVal "2014" ;
    chart:yVal "10.6"^^xsd:decimal ;
    chart:value "10.6"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-1279-1-5 a chart:DataPoint ;
    chart:series ex:series-1279-1 ;
    chart:xVal "2016" ;
    chart:yVal "10.5"^^xsd:decimal ;
    chart:value "10.5"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-1279-1-6 a chart:DataPoint ;
    chart:series ex:series-1279-1 ;
    chart:xVal "2018" ;
    chart:yVal "10.3"^^xsd:decimal ;
    chart:value "10.3"^^xsd:decimal ;
    chart:valueEstimated "true" .
