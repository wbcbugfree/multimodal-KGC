@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-5624 a chart:Chart ;
    chart:chartType "line" ;
    chart:title "Djibouti : Unemployment rate from 1999 to 2020" ;
    chart:xAxis ex:x-5624 ;
    chart:yAxis ex:y-5624 .

ex:x-5624 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2000" ;
    chart:scaleMax "2020" .

ex:y-5624 a chart:Axis ;
    chart:label "Unemployment rate" ;
    chart:scaleMin "0.00" ;
    chart:scaleMax "0.12" .

ex:series-5624-1 a chart:Series .

