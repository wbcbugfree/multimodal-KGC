@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-4593 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Ghana : National debt in relation to gross domestic product (GDP) from 2015 to 2025" ;
    chart:xAxis ex:x-4593 ;
    chart:yAxis ex:y-4593 .

ex:x-4593 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2015" ;
    chart:scaleMax "2025" .

ex:y-4593 a chart:Axis ;
    chart:label "National debt in relation to GDP" ;
    chart:scaleMin "0.0" ;
    chart:scaleMax "0.8" .

ex:series-4593-1 a chart:Series .

ex:dp-4593-1-1 a chart:DataPoint ;
    chart:series ex:series-4593-1 ;
    chart:category "2015" ;
    chart:value "0.55"^^xsd:decimal ;
    chart:valueEstimated "true" .

