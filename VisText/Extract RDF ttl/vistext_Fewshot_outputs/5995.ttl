@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-5995 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Share of American women who have given oral sex to a female in their lifetime , by age group" ;
    chart:xAxis ex:x-5995 ;
    chart:yAxis ex:y-5995 .

ex:x-5995 a chart:Axis ;
    chart:label "Age group" ;
    chart:scaleMin "" ;
    chart:scaleMax "" .

ex:y-5995 a chart:Axis ;
    chart:label "Share of respondents" ;
    chart:scaleMin "0.00" ;
    chart:scaleMax "0.15" .

ex:series-5995-1 a chart:Series .

ex:dp-5995-1-1 a chart:DataPoint ;
    chart:series ex:series-5995-1 ;
    chart:category "14-15" ;
    chart:value "0.053"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-5995-1-2 a chart:DataPoint ;
    chart:series ex:series-5995-1 ;
    chart:category "16-17" ;
    chart:value "0.092"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-5995-1-3 a chart:DataPoint ;
    chart:series ex:series-5995-1 ;
    chart:category "18-19" ;
    chart:value "0.085"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-5995-1-4 a chart:DataPoint ;
    chart:series ex:series-5995-1 ;
    chart:category "20-24" ;
    chart:value "0.145"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-5995-1-5 a chart:DataPoint ;
    chart:series ex:series-5995-1 ;
    chart:category "25-29" ;
    chart:value "0.100"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-5995-1-6 a chart:DataPoint ;
    chart:series ex:series-5995-1 ;
    chart:category "30-39" ;
    chart:value "0.145"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-5995-1-7 a chart:DataPoint ;
    chart:series ex:series-5995-1 ;
    chart:category "40-49" ;
    chart:value "0.120"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-5995-1-8 a chart:DataPoint ;
    chart:series ex:series-5995-1 ;
    chart:category "50-59" ;
    chart:value "0.075"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-5995-1-9 a chart:DataPoint ;
    chart:series ex:series-5995-1 ;
    chart:category "60-69" ;
    chart:value "0.035"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-5995-1-10 a chart:DataPoint ;
    chart:series ex:series-5995-1 ;
    chart:category "70 and older" ;
    chart:value "0.025"^^xsd:decimal ;
    chart:valueEstimated "true" .
