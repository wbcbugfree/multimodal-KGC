@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-6375 a chart:Chart ;
    chart:chartType "area" ;
    chart:title "Ivory Coast : Share of economic sectors in the gross domestic product (GDP) from 2009 to 2019" ;
    chart:xAxis ex:x-6375 ;
    chart:yAxis ex:y-6375 .

ex:x-6375 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2009" ;
    chart:scaleMax "2019" .

ex:y-6375 a chart:Axis ;
    chart:label "Agriculture" ;
    chart:scaleMin "0.00" ;
    chart:scaleMax "0.25" .

ex:series-6375-1 a chart:Series .

ex:dp-6375-1-1 a chart:DataPoint ;
    chart:series ex:series-6375-1 ;
    chart:xVal "2009" ;
    chart:yVal "0.25"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-6375-1-2 a chart:DataPoint ;
    chart:series ex:series-6375-1 ;
    chart:xVal "2010" ;
    chart:yVal "0.25"^^xsd:decimal ;
