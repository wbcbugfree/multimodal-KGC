@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-1854 a chart:Chart ;
    chart:chartType "line" ;
    chart:title "Hasbro operating profit from 2006 to 2019\n(in million U.S. dollars)" ;
    chart:xAxis ex:x-1854 ;
    chart:yAxis ex:y-1854 .

ex:x-1854 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2006" ;
    chart:scaleMax "2018" .

ex:y-1854 a chart:Axis ;
    chart:label "Operating profit (in million U.S. dollars)" ;
    chart:scaleMin "0" ;
    chart:scaleMax "900" .

ex:series-1854-1 a chart:Series .

ex:dp-1854-1-1 a chart:DataPoint ;
    chart:series ex:series-1854-1 ;
    chart:xVal "2006" ;
    chart:yVal "400"^^xsd:decimal ;
    chart:value "400"^^xsd:decimal ;
    chart:valueEstimated "true" .

