@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-1305 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "El Salvador : National debt from 2014 to 2024 (in billion U.S. dollars)" ;
    chart:xAxis ex:x-1305 ;
    chart:yAxis ex:y-1305 .

ex:x-1305 a chart:Axis ;
    chart:label "National debt in billion U.S. dollars" ;
    chart:scaleMin "0" ;
    chart:scaleMax "25" .

ex:y-1305 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "" ;
    chart:scaleMax "" .

ex:series-1305-1 a chart:Series .

ex:dp-1305-1-1 a chart:DataPoint ;
    chart:series ex:series-1305-1 ;
    chart:category "2014" ;
    chart:value "14.5"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-1305-1-2 a chart:DataPoint ;
    chart:series ex:series-1305-1 ;
    chart:category "2015" ;
    chart:value "15.0"^^xsd:decimal ;
    chart:valueEstimated "true" .

