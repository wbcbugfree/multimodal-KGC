@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-1690 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Botswana : National debt from 2015 to 2025 in relation to gross domestic product (GDP)" ;
    chart:xAxis ex:x-1690 ;
    chart:yAxis ex:y-1690 .

ex:x-1690 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2015" ;
    chart:scaleMax "2025" .

ex:y-1690 a chart:Axis ;
    chart:label "National debt in relation to GDP" ;
    chart:scaleMin "0.00" ;
    chart:scaleMax "0.35" .

ex:series-1690-1 a chart:Series .

ex:dp-1690-1-1 a chart:DataPoint ;
    chart:series ex:series-1690-1 ;
    chart:category "2015" ;
    chart:value "0.17"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-1690-1-2 a chart:DataPoint ;
    chart:series ex:series-1690-1 ;
    chart:category "2016" ;
    chart:value "0.155"^^xsd:decimal ;
    chart:valueEstimated "true" .

