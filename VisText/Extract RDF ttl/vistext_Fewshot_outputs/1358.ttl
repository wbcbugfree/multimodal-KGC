@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-1358 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Israel : Total population from 2015 to 2025 (in million inhabitants)" ;
    chart:xAxis ex:x-1358 ;
    chart:yAxis ex:y-1358 .

ex:x-1358 a chart:Axis ;
    chart:label "Inhabitants in millions" ;
    chart:scaleMin "0" ;
    chart:scaleMax "10" .

ex:y-1358 a chart:Axis ;
    chart:label "Year" .

ex:series-1358-1 a chart:Series .

ex:dp-1358-1-1 a chart:DataPoint ;
    chart:series ex:series-1358-1 ;
    chart:category "2015" ;
    chart:value "8.5"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-1358-1-2 a chart:DataPoint ;
    chart:series ex:series-1358-1 ;
    chart:category "2016" ;
    chart:value "8.6"^^xsd:decimal ;
    chart:valueEstimated "true" .

