@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-2554 a chart:Chart ;
    chart:chartType "area" ;
    chart:title "Gross domestic product (GDP) per capita at current prices in Denmark from 2009 to 2019 (in thousand DKK)" ;
    chart:xAxis ex:x-2554 ;
    chart:yAxis ex:y-2554 .

ex:x-2554 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2009" ;
    chart:scaleMax "2019" .

ex:y-2554 a chart:Axis ;
    chart:label "GDP in thousand DKK" ;
    chart:scaleMin "0" ;
    chart:scaleMax "400" .

ex:series-2554-1 a chart:Series .

ex:dp-2554-1-1 a chart:DataPoint ;
    chart:series ex:series-2554-1 ;
    chart:xVal "2009" ;
    chart:yVal "320"^^xsd:decimal ;
    chart:value "320"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-2554-1-2 a chart:DataPoint ;
    chart:series ex:series-2554-1 ;
    chart:xVal "2010" ;
    chart:yVal "325"^^xsd:decimal ;
    chart:value "325"^^xsd:decimal ;
    chart:valueEstimated "true" .

