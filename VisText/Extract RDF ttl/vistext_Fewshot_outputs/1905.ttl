@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-1905 a chart:Chart ;
    chart:chartType "area" ;
    chart:title "Population of the Tampa-St. Petersburg-Clearwater metro area in the United States from 2010 to 2019" ;
    chart:xAxis ex:x-1905 ;
    chart:yAxis ex:y-1905 .

ex:x-1905 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2010" ;
    chart:scaleMax "2019" .

ex:y-1905 a chart:Axis ;
    chart:label "Number of residents" ;
    chart:scaleMin "0" ;
    chart:scaleMax "3000000" .

ex:series-1905-1 a chart:Series .

ex:dp-1905-1-1 a chart:DataPoint ;
    chart:series ex:series-1905-1 ;
    chart:xVal "2010" ;
    chart:yVal "2200000"^^xsd:decimal ;
    chart:value "2200000"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-1905-1-2 a chart:DataPoint ;
    chart:series ex:series-1905-1 ;
    chart:xVal "2012" ;
    chart:yVal "2250000"^^xsd:decimal ;
    chart:value "2250000"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-1905-1-3 a chart:DataPoint ;
    chart:series ex:series-1905-1 ;
    chart:xVal "2014" ;
    chart:yVal "2350000"^^xsd:decimal ;
    chart:value "2350000"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-1905-1-4 a chart:DataPoint ;
    chart:series ex:series-1905-1 ;
    chart:xVal "2016" ;
    chart:yVal "2500000"^^xsd:decimal ;
    chart:value "2500000"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-1905-1-5 a chart:DataPoint ;
    chart:series ex:series-1905-1 ;
    chart:xVal "2018" ;
    chart:yVal "2700000"^^xsd:decimal ;
    chart:value "2700000"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-1905-1-6 a chart:DataPoint ;
    chart:series ex:series-1905-1 ;
    chart:xVal "2019" ;
    chart:yVal "2800000"^^xsd:decimal ;
    chart:value "2800000"^^xsd:decimal ;
    chart:valueEstimated "true" .
