@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-2875 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Cities with the highest local purchasing power in Latin America and the Caribbean in 2020 (based on index score)" ;
    chart:xAxis ex:x-2875 ;
    chart:yAxis ex:y-2875 .

ex:x-2875 a chart:Axis ;
    chart:label "city" ;
    chart:scaleMin "" ;
    chart:scaleMax "" .

ex:y-2875 a chart:Axis ;
    chart:label "Index score*" ;
    chart:scaleMin "0" ;
    chart:scaleMax "60" .

ex:series-2875-1 a chart:Series .

ex:dp-2875-1-1 a chart:DataPoint ;
    chart:series ex:series-2875-1 ;
    chart:category "Brasília (Brazil)" ;
    chart:value "50"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-2875-1-2 a chart:DataPoint ;
    chart:series ex:series-2875-1 ;
    chart:category "Buenos Aires (Argentina)" ;
    chart:value "44"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-2875-1-3 a chart:DataPoint ;
    chart:series ex:series-2875-1 ;
    chart:category "Guadalajara (Mexico)" ;
    chart:value "40"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-2875-1-4 a chart:DataPoint ;
    chart:series ex:series-2875-1 ;
    chart:category "Mexico City (Mexico)" ;
    chart:value "39"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-2875-1-5 a chart:DataPoint ;
    chart:series ex:series-2875-1 ;
    chart:category "Monterrey (Mexico)" ;
    chart:value "53"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-2875-1-6 a chart:DataPoint ;
    chart:series ex:series-2875-1 ;
    chart:category "Nassau (Bahamas)" ;
    chart:value "45"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-2875-1-7 a chart:DataPoint ;
    chart:series ex:series-2875-1 ;
    chart:category "Port of Spain (Trinidad & Tobago)" ;
    chart:value "41"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-2875-1-8 a chart:DataPoint ;
    chart:series ex:series-2875-1 ;
    chart:category "Querétaro (Mexico)" ;
    chart:value "41"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-2875-1-9 a chart:DataPoint ;
    chart:series ex:series-2875-1 ;
    chart:category "San Juan (Puerto Rico)" ;
    chart:value "64"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-2875-1-10 a chart:DataPoint ;
    chart:series ex:series-2875-1 ;
    chart:category "Tijuana (Mexico)" ;
    chart:value "38"^^xsd:decimal ;
    chart:valueEstimated "true" .
