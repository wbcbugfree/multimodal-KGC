@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-1372 a chart:Chart ;
    chart:chartType "area" ;
    chart:title "Per capita consumption of American cheese in the United States from 2000 to 2019 (in pounds)" ;
    chart:xAxis ex:x-1372 ;
    chart:yAxis ex:y-1372 .

ex:x-1372 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2000" ;
    chart:scaleMax "2019" .

ex:y-1372 a chart:Axis ;
    chart:label "Per capita consumption in pounds" ;
    chart:scaleMin "0" ;
    chart:scaleMax "15" .

ex:series-1372-1 a chart:Series .

ex:dp-1372-1-1 a chart:DataPoint ;
    chart:series ex:series-1372-1 ;
    chart:xVal "2000" ;
    chart:yVal "12.5"^^xsd:decimal ;
