@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-835 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Annual volume of pineapple sold in the United Kingdom (UK) from 2008 to 2018 (in 1,000 tonnes)" ;
    chart:xAxis ex:x-835 ;
    chart:yAxis ex:y-835 .

ex:x-835 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2008" ;
    chart:scaleMax "2018" .

ex:y-835 a chart:Axis ;
    chart:label "Sales volume in thousand tonnes" ;
    chart:scaleMin "0" ;
    chart:scaleMax "40" .

ex:series-835-1 a chart:Series .

ex:dp-835-1-1 a chart:DataPoint ;
    chart:series ex:series-835-1 ;
    chart:category "2008" ;
    chart:value "41"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-835-1-2 a chart:DataPoint ;
    chart:series ex:series-835-1 ;
    chart:category "2009" ;
    chart:value "42"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-835-1-3 a chart:DataPoint ;
    chart:series ex:series-835-1 ;
    chart:category "2010" ;
    chart:value "41"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-835-1-4 a chart:DataPoint ;
    chart:series ex:series-835-1 ;
    chart:category "2011" ;
    chart:value "40"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-835-1-5 a chart:DataPoint ;
    chart:series ex:series-835-1 ;
    chart:category "2012" ;
    chart:value "39"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-835-1-6 a chart:DataPoint ;
    chart:series ex:series-835-1 ;
    chart:category "2013" ;
    chart:value "38"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-835-1-7 a chart:DataPoint ;
    chart:series ex:series-835-1 ;
    chart:category "2014 *" ;
    chart:value "37"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-835-1-8 a chart:DataPoint ;
    chart:series ex:series-835-1 ;
    chart:category "2015 *" ;
    chart:value "36"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-835-1-9 a chart:DataPoint ;
    chart:series ex:series-835-1 ;
    chart:category "2016 *" ;
    chart:value "34"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-835-1-10 a chart:DataPoint ;
    chart:series ex:series-835-1 ;
    chart:category "2017 *" ;
    chart:value "32"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-835-1-11 a chart:DataPoint ;
    chart:series ex:series-835-1 ;
    chart:category "2018 *" ;
    chart:value "31"^^xsd:decimal ;
    chart:valueEstimated "true" .
