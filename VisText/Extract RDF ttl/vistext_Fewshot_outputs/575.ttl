@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-575 a chart:Chart ;
    chart:chartType "line" ;
    chart:title "Number of recreational visitors to the Grand Canyon National Park in the United States from 2008 to 2019 (in millions)" ;
    chart:xAxis ex:x-575 ;
    chart:yAxis ex:y-575 .

ex:x-575 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2008" ;
    chart:scaleMax "2019" .

ex:y-575 a chart:Axis ;
    chart:label "Number of visitors in millions" ;
    chart:scaleMin "0" ;
    chart:scaleMax "6" .

ex:series-575-1 a chart:Series .

ex:dp-575-1-1 a chart:DataPoint ;
    chart:series ex:series-575-1 ;
    chart:xVal "2008" ;
    chart:yVal "4.4"^^xsd:decimal ;
    chart:value "4.4"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-575-1-2 a chart:DataPoint ;
    chart:series ex:series-575-1 ;
    chart:xVal "2009" ;
    chart:yVal "4.3"^^xsd:decimal ;
    chart:value "4.3"^^xsd:decimal ;
    chart:valueEstimated "true" .

