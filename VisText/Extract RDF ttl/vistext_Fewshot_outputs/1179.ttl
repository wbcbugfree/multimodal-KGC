@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-1179 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Consumption volume of cement in India from financial year 2009 to 2018 with an estimate for financial year 2019 (in million metric tons)" ;
    chart:xAxis ex:x-1179 ;
    chart:yAxis ex:y-1179 .

ex:x-1179 a chart:Axis ;
    chart:label "Consumption in million metric tons" ;
    chart:scaleMin "0" ;
    chart:scaleMax "350" .

ex:y-1179 a chart:Axis ;
    chart:label "Financial year" .

ex:series-1179-1 a chart:Series .

ex:dp-1179-1-1 a chart:DataPoint ;
    chart:series ex:series-1179-1 ;
    chart:category "FY 2009" ;
    chart:value "200"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-1179-1-2 a chart:DataPoint ;
    chart:series ex:series-1179-1 ;
    chart:category "FY 2010" ;
    chart:value "220"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-1179-1-3 a chart:DataPoint ;
    chart:series ex:series-1179-1 ;
    chart:category "FY 2011" ;
    chart:value "170"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-1179-1-4 a chart:DataPoint ;
    chart:series ex:series-1179-1 ;
    chart:category "FY 2012" ;
    chart:value "220"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-1179-1-5 a chart:DataPoint ;
    chart:series ex:series-1179-1 ;
    chart:category "FY 2013" ;
    chart:value "240"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-1179-1-6 a chart:DataPoint ;
    chart:series ex:series-1179-1 ;
    chart:category "FY 2014" ;
    chart:value "250"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-1179-1-7 a chart:DataPoint ;
    chart:series ex:series-1179-1 ;
    chart:category "FY 2015" ;
    chart:value "260"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-1179-1-8 a chart:DataPoint ;
    chart:series ex:series-1179-1 ;
    chart:category "FY 2016" ;
    chart:value "270"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-1179-1-9 a chart:DataPoint ;
    chart:series ex:series-1179-1 ;
    chart:category "FY 2017" ;
    chart:value "280"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-1179-1-10 a chart:DataPoint ;
    chart:series ex:series-1179-1 ;
    chart:category "FY 2018" ;
    chart:value "310"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-1179-1-11 a chart:DataPoint ;
    chart:series ex:series-1179-1 ;
    chart:category "FY 2019" ;
    chart:value "340"^^xsd:decimal ;
    chart:valueEstimated "true" .
