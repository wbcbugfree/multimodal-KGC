@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-7634 a chart:Chart ;
    chart:chartType "area" ;
    chart:title "Kenya : Share of economic sectors in the gross domestic product (GDP) from 2009 to 2019" ;
    chart:xAxis ex:x-7634 ;
    chart:yAxis ex:y-7634 .

ex:x-7634 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2009" ;
    chart:scaleMax "2019" .

ex:y-7634 a chart:Axis ;
    chart:label "Agriculture" ;
    chart:scaleMin "0.00" ;
    chart:scaleMax "0.35" .

ex:series-7634-1 a chart:Series ;
    chart:seriesName "Agriculture" .

ex:dp-7634-1-1 a chart:DataPoint ;
    chart:series ex:series-7634-1 ;
    chart:xVal "2010" ;
    chart:yVal "0.23"^^xsd:decimal ;
    chart:value "0.23"^^xsd:decimal ;
    chart:valueEstimated "true" .

