@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-2013 a chart:Chart ;
    chart:chartType "line" ;
    chart:title "Number of Nyrstar employees from 2009 to 2018" ;
    chart:xAxis ex:x-2013 ;
    chart:yAxis ex:y-2013 .

ex:x-2013 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2009" ;
    chart:scaleMax "2018" .

ex:y-2013 a chart:Axis ;
    chart:label "Number of employees" ;
    chart:scaleMin "0" ;
    chart:scaleMax "8000" .

ex:series-2013-1 a chart:Series .

ex:dp-2013-1-1 a chart:DataPoint ;
    chart:series ex:series-2013-1 ;
    chart:xVal "2009" ;
    chart:yVal "2800"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-2013-1-2 a chart:DataPoint ;
    chart:series ex:series-2013-1 ;
    chart:xVal "2010" ;
    chart:yVal "6400"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-2013-1-3 a chart:DataPoint ;
    chart:series ex:series-2013-1 ;
    chart:xVal "2011" ;
    chart:yVal "6600"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-2013-1-4 a chart:DataPoint ;
    chart:series ex:series-2013-1 ;
    chart:xVal "2012" ;
    chart:yVal "6400"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-2013-1-5 a chart:DataPoint ;
    chart:series ex:series-2013-1 ;
    chart:xVal "2013" ;
    chart:yVal "6200"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-2013-1-6 a chart:DataPoint ;
    chart:series ex:series-2013-1 ;
    chart:xVal "2014" ;
    chart:yVal "4400"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-2013-1-7 a chart:DataPoint ;
    chart:series ex:series-2013-1 ;
    chart:xVal "2015" ;
    chart:yVal "3800"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-2013-1-8 a chart:DataPoint ;
    chart:series ex:series-2013-1 ;
    chart:xVal "2016" ;
    chart:yVal "3600"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-2013-1-9 a chart:DataPoint ;
    chart:series ex:series-2013-1 ;
    chart:xVal "2017" ;
    chart:yVal "3600"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-2013-1-10 a chart:DataPoint ;
    chart:series ex:series-2013-1 ;
    chart:xVal "2018" ;
    chart:yVal "3400"^^xsd:decimal ;
    chart:valueEstimated "true" .
