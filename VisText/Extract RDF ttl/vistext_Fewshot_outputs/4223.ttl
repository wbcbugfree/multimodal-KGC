    chart:series ex:series-4223-1 ;
    chart:category "Karnataka" ;
    chart:value "9.5"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-4223-1-5 a chart:DataPoint ;
    chart:series ex:series-4223-1 ;
    chart:category "Manipur" ;
    chart:value "0.5"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-4223-1-6 a chart:DataPoint ;
    chart:series ex:series-4223-1 ;
    chart:category "Meghalaya" ;
    chart:value "0.8"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-4223-1-7 a chart:DataPoint ;
