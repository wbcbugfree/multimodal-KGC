@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-4223 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Volume of raw silk produced in India in financial year 2017 , by state (in 1,000 metric tons)" ;
    chart:xAxis ex:x-4223 ;
    chart:yAxis ex:y-4223 .

ex:x-4223 a chart:Axis ;
    chart:label "state of India" .

ex:y-4223 a chart:Axis ;
    chart:label "Raw silk production in thousand metric tons" ;
    chart:scaleMin "0" ;
    chart:scaleMax "10" .

ex:series-4223-1 a chart:Series .

ex:dp-4223-1-1 a chart:DataPoint ;
    chart:series ex:series-4223-1 ;
    chart:category "Andhra Pradesh" ;
    chart:value "6"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-4223-1-2 a chart:DataPoint ;
    chart:series ex:series-4223-1 ;
    chart:category "Assam" ;
    chart:value "3.9"^^xsd:decimal ;
    chart:valueEstimated "true" .

