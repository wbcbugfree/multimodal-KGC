@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-6239 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Monthly retail sales of clothing stores in Canada from 2015 to 2020 (in billion Canadian dollars)" ;
    chart:xAxis ex:x-6239 ;
    chart:yAxis ex:y-6239 .

ex:x-6239 a chart:Axis ;
    chart:label "Month" ;
    chart:scaleMin "Apr" ;
    chart:scaleMax "May" .

ex:y-6239 a chart:Axis ;
    chart:label "2020" ;
    chart:scaleMin "0.0" ;
    chart:scaleMax "2.5" .

ex:series-6239-1 a chart:Series .

ex:dp-6239-1-1 a chart:DataPoint ;
    chart:series ex:series-6239-1 ;
    chart:category "Apr" ;
    chart:value "0.45"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-6239-1-2 a chart:DataPoint ;
    chart:series ex:series-6239-1 ;
    chart:category "Aug" ;
    chart:value "2.05"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-6239-1-3 a chart:DataPoint ;
    chart:series ex:series-6239-1 ;
    chart:category "Feb" ;
    chart:value "2.35"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-6239-1-4 a chart:DataPoint ;
    chart:series ex:series-6239-1 ;
    chart:category "Jan" ;
    chart:value "2.35"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-6239-1-5 a chart:DataPoint ;
    chart:series ex:series-6239-1 ;
    chart:category "Jul" ;
    chart:value "2.05"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-6239-1-6 a chart:DataPoint ;
    chart:series ex:series-6239-1 ;
    chart:category "Jun" ;
    chart:value "1.80"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-6239-1-7 a chart:DataPoint ;
    chart:series ex:series-6239-1 ;
    chart:category "Mar" ;
    chart:value "1.20"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-6239-1-8 a chart:DataPoint ;
    chart:series ex:series-6239-1 ;
    chart:category "May" ;
    chart:value "0.80"^^xsd:decimal ;
    chart:valueEstimated "true" .
