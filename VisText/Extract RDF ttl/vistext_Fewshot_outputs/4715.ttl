@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-4715 a chart:Chart ;
    chart:chartType "line" ;
    chart:title "Cameroon : Unemployment rate from 1999 to 2020" ;
    chart:xAxis ex:x-4715 ;
    chart:yAxis ex:y-4715 .

ex:x-4715 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "1999" ;
    chart:scaleMax "2020" .

ex:y-4715 a chart:Axis ;
    chart:label "Unemployment rate" ;
    chart:scaleMin "0.00" ;
    chart:scaleMax "0.08" .

ex:series-4715-1 a chart:Series .

