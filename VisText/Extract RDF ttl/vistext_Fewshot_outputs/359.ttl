@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-359 a chart:Chart ;
    chart:chartType "line" ;
    chart:title "Sales turnover of shops for do-it-yourself articles in the Netherlands from 2008 to 2019 (as value index)" ;
    chart:xAxis ex:x-359 ;
    chart:yAxis ex:y-359 .

ex:x-359 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2008" ;
    chart:scaleMax "2019" .

ex:y-359 a chart:Axis ;
    chart:label "Turnover value index (2015=100)" ;
    chart:scaleMin "0" ;
    chart:scaleMax "140" .

ex:series-359-1 a chart:Series .

ex:dp-359-1-1 a chart:DataPoint ;
    chart:series ex:series-359-1 ;
    chart:xVal "2008" ;
    chart:yVal "135"^^xsd:decimal ;
    chart:value "135"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-359-1-2 a chart:DataPoint ;
    chart:series ex:series-359-1 ;
    chart:xVal "2009" ;
    chart:yVal "118"^^xsd:decimal ;
    chart:value "118"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-359-1-3 a chart:DataPoint ;
    chart:series ex:series-359-1 ;
    chart:xVal "2010" ;
    chart:yVal "115"^^xsd:decimal ;
    chart:value "115"^^xsd:decimal ;
    chart:valueEstimated "true" .

