@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-2167 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Largest companies in Dalarna county , Sweden as of December 2020 , by turnover (in million SEK)" ;
    chart:xAxis ex:x-2167 ;
    chart:yAxis ex:y-2167 .

ex:x-2167 a chart:Axis ;
    chart:label "business" .

ex:y-2167 a chart:Axis ;
    chart:label "Turnover in million SEK" ;
    chart:scaleMin "0" ;
    chart:scaleMax "15000" .

ex:series-2167-1 a chart:Series .

