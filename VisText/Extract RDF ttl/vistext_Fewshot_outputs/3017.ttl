@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-3017 a chart:Chart ;
    chart:chartType "line" ;
    chart:title "Registered cases of fraud in Belgium from 2008 to 2019" ;
    chart:xAxis ex:x-3017 ;
    chart:yAxis ex:y-3017 .

ex:x-3017 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2008" ;
    chart:scaleMax "2019" .

ex:y-3017 a chart:Axis ;
    chart:label "Cases of fraud" ;
    chart:scaleMin "0" ;
    chart:scaleMax "30000" .

ex:series-3017-1 a chart:Series .

ex:dp-3017-1-1 a chart:DataPoint ;
    chart:series ex:series-3017-1 ;
    chart:xVal "2008" ;
    chart:yVal "8000"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-3017-1-2 a chart:DataPoint ;
    chart:series ex:series-3017-1 ;
    chart:xVal "2009" ;
    chart:yVal "9500"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-3017-1-3 a chart:DataPoint ;
    chart:series ex:series-3017-1 ;
    chart:xVal "2010" ;
    chart:yVal "9500"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-3017-1-4 a chart:DataPoint ;
    chart:series ex:series-3017-1 ;
    chart:xVal "2011" ;
    chart:yVal "12000"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-3017-1-5 a chart:DataPoint ;
    chart:series ex:series-3017-1 ;
    chart:xVal "2012" ;
    chart:yVal "17000"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-3017-1-6 a chart:DataPoint ;
