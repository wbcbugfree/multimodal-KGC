    chart:yVal "16000"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-3017-1-7 a chart:DataPoint ;
    chart:series ex:series-3017-1 ;
    chart:xVal "2014" ;
    chart:yVal "17500"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-3017-1-8 a chart:DataPoint ;
