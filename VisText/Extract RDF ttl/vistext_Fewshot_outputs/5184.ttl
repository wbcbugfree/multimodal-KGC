@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-5184 a chart:Chart ;
    chart:chartType "area" ;
    chart:title "Japan : Infant mortality from 2009 to 2019\n(in deaths per 1,000 live births)" ;
    chart:xAxis ex:x-5184 ;
    chart:yAxis ex:y-5184 .

ex:x-5184 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2009" ;
    chart:scaleMax "2019" .

ex:y-5184 a chart:Axis ;
    chart:label "Deaths per 1,000 live births" ;
    chart:scaleMin "0.0" ;
    chart:scaleMax "2.5" .

ex:series-5184-1 a chart:Series .

ex:dp-5184-1-1 a chart:DataPoint ;
    chart:series ex:series-5184-1 ;
    chart:xVal "2009" ;
    chart:yVal "2.4"^^xsd:decimal ;
    chart:value "2.4"^^xsd:decimal ;
    chart:valueEstimated "true" .

