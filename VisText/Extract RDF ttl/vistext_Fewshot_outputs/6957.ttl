@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-6957 a chart:Chart ;
    chart:chartType "line" ;
    chart:title "Revenue of Ipsos worldwide from 2010 to 2019 , by geographic region (in million euros)" ;
    chart:xAxis ex:x-6957 ;
    chart:yAxis ex:y-6957 .

ex:x-6957 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2010" ;
    chart:scaleMax "2019" .

ex:y-6957 a chart:Axis ;
    chart:label "Europe, Middle East and Africa" ;
    chart:scaleMin "0" ;
    chart:scaleMax "800" .

ex:series-6957-1 a chart:Series .

ex:dp-6957-1-1 a chart:DataPoint ;
    chart:series ex:series-6957-1 ;
    chart:xVal "2010" ;
    chart:yVal "450"^^xsd:decimal ;
    chart:value "450"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-6957-1-2 a chart:DataPoint ;
    chart:series ex:series-6957-1 ;
    chart:xVal "2011" ;
    chart:yVal "580"^^xsd:decimal ;
    chart:value "580"^^xsd:decimal ;
    chart:valueEstimated "true" .

