@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-6809 a chart:Chart ;
    chart:chartType "area" ;
    chart:title "Cuba : Age structure from 2009 to 2019" ;
    chart:xAxis ex:x-6809 ;
    chart:yAxis ex:y-6809 .

ex:x-6809 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2009" ;
    chart:scaleMax "2019" .

ex:y-6809 a chart:Axis ;
    chart:label "0-14 years" ;
    chart:scaleMin "0.00" ;
    chart:scaleMax "0.18" .

ex:series-6809-1 a chart:Series .

ex:dp-6809-1-1 a chart:DataPoint ;
    chart:series ex:series-6809-1 ;
    chart:xVal "2009" ;
    chart:yVal "0.17"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-6809-1-2 a chart:DataPoint ;
    chart:series ex:series-6809-1 ;
    chart:xVal "2010" ;
    chart:yVal "0.168"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-6809-1-3 a chart:DataPoint ;
    chart:series ex:series-6809-1 ;
    chart:xVal "2011" ;
    chart:yVal "0.166"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-6809-1-4 a chart:DataPoint ;
    chart:series ex:series-6809-1 ;
    chart:xVal "2012" ;
    chart:yVal "0.164"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-6809-1-5 a chart:DataPoint ;
    chart:series ex:series-6809-1 ;
    chart:xVal "2013" ;
    chart:yVal "0.162"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-6809-1-6 a chart:DataPoint ;
    chart:series ex:series-6809-1 ;
    chart:xVal "2014" ;
    chart:yVal "0.16"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-6809-1-7 a chart:DataPoint ;
    chart:series ex:series-6809-1 ;
    chart:xVal "2015" ;
    chart:yVal "0.158"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-6809-1-8 a chart:DataPoint ;
    chart:series ex:series-6809-1 ;
    chart:xVal "2016" ;
    chart:yVal "0.156"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-6809-1-9 a chart:DataPoint ;
    chart:series ex:series-6809-1 ;
    chart:xVal "2017" ;
    chart:yVal "0.154"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-6809-1-10 a chart:DataPoint ;
    chart:series ex:series-6809-1 ;
    chart:xVal "2018" ;
    chart:yVal "0.152"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-6809-1-11 a chart:DataPoint ;
    chart:series ex:series-6809-1 ;
    chart:xVal "2019" ;
