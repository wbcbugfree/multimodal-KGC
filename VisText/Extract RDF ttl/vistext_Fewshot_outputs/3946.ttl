@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-3946 a chart:Chart ;
    chart:chartType "area" ;
    chart:xAxis ex:x-3946 ;
    chart:yAxis ex:y-3946 .

ex:x-3946 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "1990" ;
    chart:scaleMax "2015" .

ex:y-3946 a chart:Axis ;
    chart:label "Average haul length in kilometres" ;
    chart:scaleMin "0" ;
    chart:scaleMax "100" .

ex:series-3946-1 a chart:Series .

ex:dp-3946-1-1 a chart:DataPoint ;
    chart:series ex:series-3946-1 ;
    chart:xVal "1990" ;
    chart:yVal "70"^^xsd:decimal ;
    chart:value "70"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-3946-1-2 a chart:DataPoint ;
    chart:series ex:series-3946-1 ;
    chart:xVal "1995" ;
    chart:yVal "85"^^xsd:decimal ;
    chart:value "85"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-3946-1-3 a chart:DataPoint ;
    chart:series ex:series-3946-1 ;
    chart:xVal "2000" ;
    chart:yVal "95"^^xsd:decimal ;
    chart:value "95"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-3946-1-4 a chart:DataPoint ;
    chart:series ex:series-3946-1 ;
    chart:xVal "2005" ;
    chart:yVal "90"^^xsd:decimal ;
    chart:value "90"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-3946-1-5 a chart:DataPoint ;
    chart:series ex:series-3946-1 ;
    chart:xVal "2010" ;
    chart:yVal "98"^^xsd:decimal ;
    chart:value "98"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-3946-1-6 a chart:DataPoint ;
    chart:series ex:series-3946-1 ;
    chart:xVal "2015" ;
    chart:yVal "102"^^xsd:decimal ;
    chart:value "102"^^xsd:decimal ;
    chart:valueEstimated "true" .
