@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-8702 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Number of coronavirus (COVID-19) cases , recoveries , and deaths among the most impacted countries worldwide as of December 22 , 2020" ;
    chart:xAxis ex:x-8702 ;
    chart:yAxis ex:y-8702 .

ex:x-8702 a chart:Axis ;
    chart:label "Recoveries" ;
    chart:scaleMin "0" ;
    chart:scaleMax "50000000" .

ex:y-8702 a chart:Axis ;
    chart:label "Country" ;
    chart:scaleMin "" ;
    chart:scaleMax "" .

ex:series-8702-1 a chart:Series .

ex:dp-8702-1-1 a chart:DataPoint ;
    chart:series ex:series-8702-1 ;
    chart:category "Argentina" ;
    chart:value "1000000"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-8702-1-2 a chart:DataPoint ;
    chart:series ex:series-8702-1 ;
    chart:category "Brazil" ;
    chart:value "7000000"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-8702-1-3 a chart:DataPoint ;
    chart:series ex:series-8702-1 ;
    chart:category "France" ;
    chart:value "2000000"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-8702-1-4 a chart:DataPoint ;
    chart:series ex:series-8702-1 ;
    chart:category "India" ;
    chart:value "9500000"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-8702-1-5 a chart:DataPoint ;
    chart:series ex:series-8702-1 ;
    chart:category "Italy" ;
    chart:value "1500000"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-8702-1-6 a chart:DataPoint ;
    chart:series ex:series-8702-1 ;
    chart:category "Russia" ;
    chart:value "2500000"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-8702-1-7 a chart:DataPoint ;
    chart:series ex:series-8702-1 ;
    chart:category "Turkey" ;
    chart:value "1500000"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-8702-1-8 a chart:DataPoint ;
    chart:series ex:series-8702-1 ;
    chart:category "USA" ;
    chart:value "12000000"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-8702-1-9 a chart:DataPoint ;
    chart:series ex:series-8702-1 ;
    chart:category "World" ;
    chart:value "50000000"^^xsd:decimal ;
    chart:valueEstimated "true" .
