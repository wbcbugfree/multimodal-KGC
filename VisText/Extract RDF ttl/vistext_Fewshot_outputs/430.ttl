@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-430 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Cancer mortality rate among men in selected countries worldwide between 2003 and 2007 (per 100,000 population)" ;
    chart:xAxis ex:x-430 ;
    chart:yAxis ex:y-430 .

ex:x-430 a chart:Axis ;
    chart:label "Mortality rate per 100,000 population" ;
    chart:scaleMin "0" ;
    chart:scaleMax "200" .

ex:y-430 a chart:Axis ;
    chart:label "Country" ;
    chart:scaleMin "" ;
    chart:scaleMax "" .

ex:series-430-1 a chart:Series .

ex:dp-430-1-1 a chart:DataPoint ;
    chart:series ex:series-430-1 ;
    chart:category "Australia" ;
    chart:value "130"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-430-1-2 a chart:DataPoint ;
    chart:series ex:series-430-1 ;
    chart:category "China" ;
    chart:value "135"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-430-1-3 a chart:DataPoint ;
    chart:series ex:series-430-1 ;
    chart:category "Colombia" ;
    chart:value "95"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-430-1-4 a chart:DataPoint ;
    chart:series ex:series-430-1 ;
    chart:category "Costa Rica" ;
    chart:value "155"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-430-1-5 a chart:DataPoint ;
    chart:series ex:series-430-1 ;
    chart:category "Denmark" ;
    chart:value "125"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-430-1-6 a chart:DataPoint ;
    chart:series ex:series-430-1 ;
    chart:category "Japan" ;
    chart:value "175"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-430-1-7 a chart:DataPoint ;
    chart:series ex:series-430-1 ;
    chart:category "Slovakia" ;
    chart:value "155"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-430-1-8 a chart:DataPoint ;
    chart:series ex:series-430-1 ;
    chart:category "Spain" ;
    chart:value "170"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-430-1-9 a chart:DataPoint ;
    chart:series ex:series-430-1 ;
    chart:category "USA: Black" ;
    chart:value "135"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-430-1-10 a chart:DataPoint ;
    chart:series ex:series-430-1 ;
    chart:category "USA: White" ;
    chart:value "110"^^xsd:decimal ;
    chart:valueEstimated "true" .
