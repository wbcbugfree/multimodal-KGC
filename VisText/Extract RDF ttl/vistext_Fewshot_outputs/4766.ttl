@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-4766 a chart:Chart ;
    chart:chartType "line" ;
    chart:title "Norway : Urbanization from 2009 to 2019" ;
    chart:xAxis ex:x-4766 ;
    chart:yAxis ex:y-4766 .

ex:x-4766 a chart:Axis ;
    chart:label "Response" ;
    chart:scaleMin "2009" ;
    chart:scaleMax "2019" .

ex:y-4766 a chart:Axis ;
    chart:label "Share of urban population in total population" ;
    chart:scaleMin "0.0" ;
    chart:scaleMax "1.0" .

ex:series-4766-1 a chart:Series .

ex:dp-4766-1-1 a chart:DataPoint ;
    chart:series ex:series-4766-1 ;
    chart:xVal "2009" ;
    chart:yVal "0.8"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-4766-1-2 a chart:DataPoint ;
    chart:series ex:series-4766-1 ;
    chart:xVal "2010" ;
    chart:yVal "0.803"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-4766-1-3 a chart:DataPoint ;
    chart:series ex:series-4766-1 ;
    chart:xVal "2011" ;
    chart:yVal "0.806"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-4766-1-4 a chart:DataPoint ;
    chart:series ex:series-4766-1 ;
    chart:xVal "2012" ;
    chart:yVal "0.809"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-4766-1-5 a chart:DataPoint ;
    chart:series ex:series-4766-1 ;
    chart:xVal "2013" ;
    chart:yVal "0.812"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-4766-1-6 a chart:DataPoint ;
    chart:series ex:series-4766-1 ;
    chart:xVal "2014" ;
    chart:yVal "0.815"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-4766-1-7 a chart:DataPoint ;
    chart:series ex:series-4766-1 ;
    chart:xVal "2015" ;
    chart:yVal "0.818"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-4766-1-8 a chart:DataPoint ;
    chart:series ex:series-4766-1 ;
    chart:xVal "2016" ;
    chart:yVal "0.821"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-4766-1-9 a chart:DataPoint ;
    chart:series ex:series-4766-1 ;
    chart:xVal "2017" ;
    chart:yVal "0.824"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-4766-1-10 a chart:DataPoint ;
    chart:series ex:series-4766-1 ;
    chart:xVal "2018" ;
    chart:yVal "0.827"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-4766-1-11 a chart:DataPoint ;
    chart:series ex:series-4766-1 ;
    chart:xVal "2019" ;
    chart:yVal "0.83"^^xsd:decimal ;
    chart:valueEstimated "true" .
