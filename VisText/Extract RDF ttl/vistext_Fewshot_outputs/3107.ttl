ex:dp-3107-1-7 a chart:DataPoint ;
    chart:series ex:series-3107-1 ;
    chart:category "Music" ;
    chart:value "0.15"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-3107-1-8 a chart:DataPoint ;
