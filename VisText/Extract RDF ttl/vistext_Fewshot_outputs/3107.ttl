@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-3107 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Most viewed YouTube video categories of male Millennial users in the United States as of April 2016" ;
    chart:xAxis ex:x-3107 ;
    chart:yAxis ex:y-3107 .

ex:x-3107 a chart:Axis ;
    chart:label "Response" .

ex:y-3107 a chart:Axis ;
    chart:label "Share of views" ;
    chart:scaleMin "0.0" ;
    chart:scaleMax "0.5" .

ex:series-3107-1 a chart:Series .

ex:dp-3107-1-1 a chart:DataPoint ;
    chart:series ex:series-3107-1 ;
    chart:category "Comedy" ;
    chart:value "0.02"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-3107-1-2 a chart:DataPoint ;
    chart:series ex:series-3107-1 ;
    chart:category "Education and reference" ;
    chart:value "0.02"^^xsd:decimal ;
    chart:valueEstimated "true" .

