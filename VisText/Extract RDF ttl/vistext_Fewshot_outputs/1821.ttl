@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-1821 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Top 10 specialty therapy drugs in the U.S. by per-member-per-year (PMPY) spending in 2016 (in U.S. dollars)" ;
    chart:xAxis ex:x-1821 ;
    chart:yAxis ex:y-1821 .

ex:x-1821 a chart:Axis ;
    chart:label "Therapy Drug Type" .

ex:y-1821 a chart:Axis ;
    chart:label "PMPY spending in U.S. dollars" ;
    chart:scaleMin "0" ;
    chart:scaleMax "50" .

ex:series-1821-1 a chart:Series .

ex:dp-1821-1-1 a chart:DataPoint ;
    chart:series ex:series-1821-1 ;
    chart:category "Copaxone (glatiramer)" ;
    chart:value "12"^^xsd:decimal ;
    chart:valueEstimated "true" .

