@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-4117 a chart:Chart ;
    chart:chartType "line" ;
    chart:title "Number of births in Italy from 2010 to 2019" ;
    chart:xAxis ex:x-4117 ;
    chart:yAxis ex:y-4117 .

ex:x-4117 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2010" ;
    chart:scaleMax "2019" .

ex:y-4117 a chart:Axis ;
    chart:label "Number of births" ;
    chart:scaleMin "0" ;
    chart:scaleMax "400000" .

ex:series-4117-1 a chart:Series .

ex:dp-4117-1-1 a chart:DataPoint ;
    chart:series ex:series-4117-1 ;
    chart:xVal "2010" ;
    chart:yVal "485000"^^xsd:decimal ;
    chart:value "485000"^^xsd:decimal ;
    chart:valueEstimated "true" .

