@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-6525 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Comparing the way the UK government has handled the Coronavirus pandemic with the way other countries have handled it , would you say the UK government has handled things better or worse than these other countries did ?" ;
    chart:xAxis ex:x-6525 ;
    chart:yAxis ex:y-6525 .

ex:x-6525 a chart:Axis ;
    chart:label "A little worse" ;
    chart:scaleMin "0.00" ;
    chart:scaleMax "0.20" .

ex:y-6525 a chart:Axis ;
    chart:label "Response" .

ex:series-6525-1 a chart:Series .

ex:dp-6525-1-1 a chart:DataPoint ;
    chart:series ex:series-6525-1 ;
    chart:category "Australia" ;
    chart:value "0.20"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-6525-1-2 a chart:DataPoint ;
    chart:series ex:series-6525-1 ;
    chart:category "China" ;
    chart:value "0.18"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-6525-1-3 a chart:DataPoint ;
    chart:series ex:series-6525-1 ;
    chart:category "France" ;
    chart:value "0.19"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-6525-1-4 a chart:DataPoint ;
    chart:series ex:series-6525-1 ;
    chart:category "Germany" ;
    chart:value "0.20"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-6525-1-5 a chart:DataPoint ;
    chart:series ex:series-6525-1 ;
    chart:category "Italy" ;
    chart:value "0.17"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-6525-1-6 a chart:DataPoint ;
    chart:series ex:series-6525-1 ;
    chart:category "Japan" ;
    chart:value "0.17"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-6525-1-7 a chart:DataPoint ;
    chart:series ex:series-6525-1 ;
    chart:category "South Korea" ;
    chart:value "0.18"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-6525-1-8 a chart:DataPoint ;
    chart:series ex:series-6525-1 ;
    chart:category "Spain" ;
    chart:value "0.19"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-6525-1-9 a chart:DataPoint ;
