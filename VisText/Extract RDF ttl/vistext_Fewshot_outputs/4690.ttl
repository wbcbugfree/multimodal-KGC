@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-4690 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Population in Italy in 2019 , by age group" ;
    chart:xAxis ex:x-4690 ;
    chart:yAxis ex:y-4690 .

ex:x-4690 a chart:Axis ;
    chart:label "Number of individuals" ;
    chart:scaleMin "0" ;
    chart:scaleMax "10000000" .

ex:y-4690 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "" ;
    chart:scaleMax "" .

ex:series-4690-1 a chart:Series .

ex:dp-4690-1-1 a chart:DataPoint ;
    chart:series ex:series-4690-1 ;
    chart:category "0 to 2 years" ;
    chart:value "1500000"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-4690-1-2 a chart:DataPoint ;
    chart:series ex:series-4690-1 ;
    chart:category "12 to 17 years" ;
    chart:value "2500000"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-4690-1-3 a chart:DataPoint ;
    chart:series ex:series-4690-1 ;
    chart:category "18 to 24 years" ;
    chart:value "3500000"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-4690-1-4 a chart:DataPoint ;
    chart:series ex:series-4690-1 ;
    chart:category "25 to 34 years" ;
    chart:value "4500000"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-4690-1-5 a chart:DataPoint ;
    chart:series ex:series-4690-1 ;
    chart:category "35 to 44 years" ;
    chart:value "8500000"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-4690-1-6 a chart:DataPoint ;
    chart:series ex:series-4690-1 ;
    chart:category "45 to 54 years" ;
    chart:value "2000000"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-4690-1-7 a chart:DataPoint ;
    chart:series ex:series-4690-1 ;
    chart:category "55 to 64 years" ;
    chart:value "8000000"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-4690-1-8 a chart:DataPoint ;
    chart:series ex:series-4690-1 ;
    chart:category "65 to 74 years" ;
    chart:value "8500000"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-4690-1-9 a chart:DataPoint ;
    chart:series ex:series-4690-1 ;
    chart:category "75 years and more" ;
    chart:value "6500000"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-4690-1-10 a chart:DataPoint ;
    chart:series ex:series-4690-1 ;
    chart:category "6 to 11 years" ;
    chart:value "4000000"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-4690-1-11 a chart:DataPoint ;
    chart:series ex:series-4690-1 ;
    chart:category "54 years" ;
    chart:value "8000000"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-4690-1-12 a chart:DataPoint ;
    chart:series ex:series-4690-1 ;
    chart:category "64 years" ;
    chart:value "8000000"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-4690-1-13 a chart:DataPoint ;
    chart:series ex:series-4690-1 ;
    chart:category "74 years" ;
    chart:value "4000000"^^xsd:decimal ;
    chart:valueEstimated "true" .
