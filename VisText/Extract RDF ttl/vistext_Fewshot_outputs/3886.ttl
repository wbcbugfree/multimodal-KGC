@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-3886 a chart:Chart ;
    chart:chartType "area" ;
    chart:title "Electricity export volume from the United States between 1999 and 2019 (in gigawatt hours)" ;
    chart:xAxis ex:x-3886 ;
    chart:yAxis ex:y-3886 .

ex:x-3886 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "1999" ;
    chart:scaleMax "2019" .

ex:y-3886 a chart:Axis ;
    chart:label "Exports in thousand gigawatt hours" ;
    chart:scaleMin "0" ;
    chart:scaleMax "20000" .

ex:series-3886-1 a chart:Series .

ex:dp-3886-1-1 a chart:DataPoint ;
    chart:series ex:series-3886-1 ;
    chart:xVal "1999" ;
    chart:yVal "14500"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-3886-1-2 a chart:DataPoint ;
    chart:series ex:series-3886-1 ;
    chart:xVal "2000" ;
    chart:yVal "15000"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-3886-1-3 a chart:DataPoint ;
    chart:series ex:series-3886-1 ;
    chart:xVal "2005" ;
    chart:yVal "19000"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-3886-1-4 a chart:DataPoint ;
    chart:series ex:series-3886-1 ;
    chart:xVal "2010" ;
    chart:yVal "19000"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-3886-1-5 a chart:DataPoint ;
    chart:series ex:series-3886-1 ;
    chart:xVal "2012" ;
    chart:yVal "11500"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-3886-1-6 a chart:DataPoint ;
    chart:series ex:series-3886-1 ;
    chart:xVal "2014" ;
    chart:yVal "13000"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-3886-1-7 a chart:DataPoint ;
    chart:series ex:series-3886-1 ;
    chart:xVal "2015" ;
    chart:yVal "6500"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-3886-1-8 a chart:DataPoint ;
    chart:series ex:series-3886-1 ;
    chart:xVal "2017" ;
    chart:yVal "10500"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-3886-1-9 a chart:DataPoint ;
    chart:series ex:series-3886-1 ;
    chart:xVal "2019" ;
    chart:yVal "20000"^^xsd:decimal ;
    chart:valueEstimated "true" .
