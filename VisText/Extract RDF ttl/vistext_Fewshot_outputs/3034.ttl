@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-3034 a chart:Chart ;
    chart:chartType "area" ;
    chart:title "Number of enterprises in the manufacture of soft drinks , production of mineral waters and other bottled waters industry in Bulgaria from 2008 to 2018" ;
    chart:xAxis ex:x-3034 ;
    chart:yAxis ex:y-3034 .

ex:x-3034 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2008" ;
    chart:scaleMax "2018" .

ex:y-3034 a chart:Axis ;
    chart:label "Number of enterprises" ;
    chart:scaleMin "0" ;
    chart:scaleMax "250" .

ex:series-3034-1 a chart:Series .

ex:dp-3034-1-1 a chart:DataPoint ;
    chart:series ex:series-3034-1 ;
    chart:xVal "2008" ;
    chart:yVal "250"^^xsd:decimal ;
    chart:value "250"^^xsd:decimal ;
    chart:valueEstimated "true" .

