@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-1046 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Main import partners of Sweden in 2019 , by import value (in million SEK)" ;
    chart:xAxis ex:x-1046 ;
    chart:yAxis ex:y-1046 .

ex:x-1046 a chart:Axis ;
    chart:label "Country" ;
    chart:scaleMin "" ;
    chart:scaleMax "" .

ex:y-1046 a chart:Axis ;
    chart:label "Import value million SEK" ;
    chart:scaleMin "0" ;
    chart:scaleMax "250000" .

ex:series-1046-1 a chart:Series .

ex:dp-1046-1-1 a chart:DataPoint ;
    chart:series ex:series-1046-1 ;
    chart:category "Austria" ;
    chart:value "10000"^^xsd:decimal ;
    chart:valueEstimated "true" .

