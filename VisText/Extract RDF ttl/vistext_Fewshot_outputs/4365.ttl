@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-4365 a chart:Chart ;
    chart:chartType "line" ;
    chart:title "Average regular season home attendance of the Los Angeles Dodgers from 2009 to 2019" ;
    chart:xAxis ex:x-4365 ;
    chart:yAxis ex:y-4365 .

ex:x-4365 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2009" ;
    chart:scaleMax "2019" .

ex:y-4365 a chart:Axis ;
    chart:label "Average attendance" ;
    chart:scaleMin "0" ;
    chart:scaleMax "50000" .

ex:series-4365-1 a chart:Series .

ex:dp-4365-1-1 a chart:DataPoint ;
    chart:series ex:series-4365-1 ;
    chart:xVal "2009" ;
    chart:yVal "51000"^^xsd:decimal ;
    chart:value "51000"^^xsd:decimal ;
    chart:valueEstimated "true" .

