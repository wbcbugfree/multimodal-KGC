@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-963 a chart:Chart ;
    chart:chartType "area" ;
    chart:title "Total fertility rate in Japan from 1800 to 2020" ;
    chart:xAxis ex:x-963 ;
    chart:yAxis ex:y-963 .

ex:x-963 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "1800" ;
    chart:scaleMax "2020" .

ex:y-963 a chart:Axis ;
    chart:label "Fertility rate" ;
    chart:scaleMin "0" ;
    chart:scaleMax "5" .

ex:series-963-1 a chart:Series .

ex:dp-963-1-1 a chart:DataPoint ;
    chart:series ex:series-963-1 ;
    chart:xVal "1800" ;
    chart:yVal "4.0"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-963-1-2 a chart:DataPoint ;
    chart:series ex:series-963-1 ;
    chart:xVal "1825" ;
    chart:yVal "4.3"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-963-1-3 a chart:DataPoint ;
    chart:series ex:series-963-1 ;
    chart:xVal "1850" ;
    chart:yVal "4.5"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-963-1-4 a chart:DataPoint ;
    chart:series ex:series-963-1 ;
    chart:xVal "1875" ;
    chart:yVal "4.7"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-963-1-5 a chart:DataPoint ;
    chart:series ex:series-963-1 ;
    chart:xVal "1900" ;
    chart:yVal "4.5"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-963-1-6 a chart:DataPoint ;
    chart:series ex:series-963-1 ;
    chart:xVal "1925" ;
    chart:yVal "4.0"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-963-1-7 a chart:DataPoint ;
    chart:series ex:series-963-1 ;
    chart:xVal "1950" ;
    chart:yVal "2.0"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-963-1-8 a chart:DataPoint ;
    chart:series ex:series-963-1 ;
    chart:xVal "1975" ;
    chart:yVal "1.8"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-963-1-9 a chart:DataPoint ;
    chart:series ex:series-963-1 ;
    chart:xVal "2000" ;
    chart:yVal "1.3"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-963-1-10 a chart:DataPoint ;
    chart:series ex:series-963-1 ;
    chart:xVal "2020" ;
    chart:yVal "1.3"^^xsd:decimal ;
    chart:valueEstimated "true" .
