@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-768 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Indoor venue exhibition space available worldwide in 2011 , by country (in million square meters)" ;
    chart:xAxis ex:x-768 ;
    chart:yAxis ex:y-768 .

ex:x-768 a chart:Axis ;
    chart:label "Exhibition space in million square meters" ;
    chart:scaleMin "0" ;
    chart:scaleMax "7" .

ex:y-768 a chart:Axis ;
    chart:label "Country" ;
    chart:scaleMin "" ;
    chart:scaleMax "" .

ex:series-768-1 a chart:Series .

ex:dp-768-1-1 a chart:DataPoint ;
    chart:series ex:series-768-1 ;
    chart:category "Belgium" ;
    chart:value "0.2"^^xsd:decimal ;
    chart:valueEstimated "true" .

