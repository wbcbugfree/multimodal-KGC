@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-5251 a chart:Chart ;
    chart:chartType "area" ;
    chart:title "The Coca-Cola Company \'s net operating revenues worldwide from 2007 to 2019 (in billion U.S. dollars)" ;
    chart:xAxis ex:x-5251 ;
    chart:yAxis ex:y-5251 .

ex:x-5251 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2007" ;
    chart:scaleMax "2019" .

ex:y-5251 a chart:Axis ;
    chart:label "Revenues in billion U.S. dollars" ;
    chart:scaleMin "0" ;
    chart:scaleMax "50" .

ex:series-5251-1 a chart:Series .

ex:dp-5251-1-1 a chart:DataPoint ;
    chart:series ex:series-5251-1 ;
    chart:xVal "2007" ;
    chart:yVal "29.0"^^xsd:decimal ;
    chart:value "29.0"^^xsd:decimal ;
    chart:valueEstimated "true" .

