@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-3219 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Most popular TV shows on Facebook as of August 2014 , by number of likes (in millions)" ;
    chart:xAxis ex:x-3219 ;
    chart:yAxis ex:y-3219 .

ex:x-3219 a chart:Axis ;
    chart:label "Number of likes in millions" ;
    chart:scaleMin "0" ;
    chart:scaleMax "80" .

ex:y-3219 a chart:Axis ;
    chart:label "Most popular TV shows on Facebook" ;
    chart:scaleMin "" ;
    chart:scaleMax "" .

ex:series-3219-1 a chart:Series .

ex:dp-3219-1-1 a chart:DataPoint ;
    chart:series ex:series-3219-1 ;
    chart:category "Family Guy" ;
    chart:value "68"^^xsd:decimal ;
    chart:valueEstimated "true" .

