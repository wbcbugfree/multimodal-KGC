@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-3260 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "States with the highest femicide rate in Mexico in 2019 (number of femicides per 100,000 women)" ;
    chart:xAxis ex:x-3260 ;
    chart:yAxis ex:y-3260 .

ex:x-3260 a chart:Axis ;
    chart:label "States" ;
    chart:scaleMin "" ;
    chart:scaleMax "" .

ex:y-3260 a chart:Axis ;
    chart:label "Femicide rate" ;
    chart:scaleMin "0" ;
    chart:scaleMax "4" .

ex:series-3260-1 a chart:Series .

ex:dp-3260-1-1 a chart:DataPoint ;
    chart:series ex:series-3260-1 ;
    chart:category "Chihuahua" ;
    chart:value "1.5"^^xsd:decimal ;
    chart:valueEstimated "true" .

