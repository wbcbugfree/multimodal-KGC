@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-7592 a chart:Chart ;
    chart:chartType "area" ;
    chart:title "Domestic and foreign revenue of the German analysis , bio , and laboratory technologies industry from 2010 to 2019 (in billion euros)" ;
    chart:xAxis ex:x-7592 ;
    chart:yAxis ex:y-7592 .

ex:x-7592 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2010" ;
    chart:scaleMax "2019" .

ex:y-7592 a chart:Axis ;
    chart:label "Foreign revenue" ;
    chart:scaleMin "0" ;
    chart:scaleMax "5" .

ex:series-7592-1 a chart:Series .

ex:dp-7592-1-1 a chart:DataPoint ;
    chart:series ex:series-7592-1 ;
    chart:xVal "2010" ;
    chart:yVal "3.3"^^xsd:decimal ;
    chart:value "3.3"^^xsd:decimal ;
    chart:valueEstimated "true" .

