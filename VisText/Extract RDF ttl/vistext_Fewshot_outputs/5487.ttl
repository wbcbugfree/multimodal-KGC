@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-5487 a chart:Chart ;
    chart:chartType "area" ;
    chart:title "Bhutan : Urbanization from 2009 to 2019" ;
    chart:xAxis ex:x-5487 ;
    chart:yAxis ex:y-5487 .

ex:x-5487 a chart:Axis ;
    chart:label "Response" ;
    chart:scaleMin "2010" ;
    chart:scaleMax "2018" .

ex:y-5487 a chart:Axis ;
    chart:label "Share of urban population in total population" ;
    chart:scaleMin "0.0" ;
    chart:scaleMax "0.4" .

ex:series-5487-1 a chart:Series .

ex:dp-5487-1-1 a chart:DataPoint ;
    chart:series ex:series-5487-1 ;
    chart:xVal "2010" ;
    chart:yVal "0.34"^^xsd:decimal ;
    chart:value "0.34"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-5487-1-2 a chart:DataPoint ;
    chart:series ex:series-5487-1 ;
    chart:xVal "2012" ;
    chart:yVal "0.35"^^xsd:decimal ;
    chart:value "0.35"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-5487-1-3 a chart:DataPoint ;
    chart:series ex:series-5487-1 ;
    chart:xVal "2014" ;
    chart:yVal "0.36"^^xsd:decimal ;
    chart:value "0.36"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-5487-1-4 a chart:DataPoint ;
    chart:series ex:series-5487-1 ;
    chart:xVal "2016" ;
    chart:yVal "0.37"^^xsd:decimal ;
    chart:value "0.37"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-5487-1-5 a chart:DataPoint ;
    chart:series ex:series-5487-1 ;
    chart:xVal "2018" ;
    chart:yVal "0.38"^^xsd:decimal ;
    chart:value "0.38"^^xsd:decimal ;
    chart:valueEstimated "true" .
