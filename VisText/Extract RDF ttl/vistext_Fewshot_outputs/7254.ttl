@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-7254 a chart:Chart ;
    chart:chartType "area" ;
    chart:xAxis ex:x-7254 ;
    chart:yAxis ex:y-7254 .

ex:x-7254 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2010" ;
    chart:scaleMax "2018" .

ex:y-7254 a chart:Axis ;
    chart:label "65 and above" ;
    chart:scaleMin "0.00" ;
    chart:scaleMax "0.15" .

ex:series-7254-1 a chart:Series .

ex:dp-7254-1-1 a chart:DataPoint ;
    chart:series ex:series-7254-1 ;
    chart:xVal "2010" ;
    chart:yVal "0.13"^^xsd:decimal ;
    chart:value "0.13"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-7254-1-2 a chart:DataPoint ;
    chart:series ex:series-7254-1 ;
    chart:xVal "2012" ;
    chart:yVal "0.135"^^xsd:decimal ;
    chart:value "0.135"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-7254-1-3 a chart:DataPoint ;
    chart:series ex:series-7254-1 ;
    chart:xVal "2014" ;
    chart:yVal "0.14"^^xsd:decimal ;
    chart:value "0.14"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-7254-1-4 a chart:DataPoint ;
    chart:series ex:series-7254-1 ;
    chart:xVal "2016" ;
    chart:yVal "0.145"^^xsd:decimal ;
    chart:value "0.145"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-7254-1-5 a chart:DataPoint ;
    chart:series ex:series-7254-1 ;
    chart:xVal "2018" ;
    chart:yVal "0.15"^^xsd:decimal ;
    chart:value "0.15"^^xsd:decimal ;
    chart:valueEstimated "true" .
