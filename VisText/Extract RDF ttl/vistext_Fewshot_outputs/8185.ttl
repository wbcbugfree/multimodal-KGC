@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-8185 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Week-on-week change in global flight bookings to Brussels after terrorist attacks in March 2016" ;
    chart:xAxis ex:x-8185 ;
    chart:yAxis ex:y-8185 .

ex:x-8185 a chart:Axis ;
    chart:label "Flight searches" ;
    chart:scaleMin "-0.5" ;
    chart:scaleMax "0.0" .

ex:y-8185 a chart:Axis ;
    chart:label "Month" .

ex:series-8185-1 a chart:Series .

ex:mark-8185-1-1 a chart:DataPoint ;
    chart:series ex:series-8185-1 ;
    chart:category "March 16" ;
    chart:value "-0.07"^^xsd:decimal ;
    chart:valueEstimated "true" .

