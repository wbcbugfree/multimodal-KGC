@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-6368 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Monthly export value of canola in Canada from 2015 to 2020 (in million Canadian dollars)" ;
    chart:xAxis ex:x-6368 ;
    chart:yAxis ex:y-6368 .

ex:x-6368 a chart:Axis ;
    chart:label "Month" ;
    chart:scaleMin "" ;
    chart:scaleMax "" .

ex:y-6368 a chart:Axis ;
    chart:label "2018" ;
    chart:scaleMin "0" ;
    chart:scaleMax "600" .

ex:series-6368-1 a chart:Series .

ex:dp-6368-1-1 a chart:DataPoint ;
