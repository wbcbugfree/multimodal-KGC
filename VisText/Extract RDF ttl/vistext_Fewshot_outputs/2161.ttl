@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-2161 a chart:Chart ;
    chart:chartType "area" ;
    chart:title "Sales price of ice cream per ton manufactured in the United Kingdom (UK) from 2009 to 2019 (in GBP)" ;
    chart:xAxis ex:x-2161 ;
    chart:yAxis ex:y-2161 .

ex:x-2161 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2009" ;
    chart:scaleMax "2019" .

ex:y-2161 a chart:Axis ;
    chart:label "Price per litre in British pounds" ;
    chart:scaleMin "0.0" ;
    chart:scaleMax "1.75" .

ex:series-2161-1 a chart:Series .

ex:dp-2161-1-1 a chart:DataPoint ;
    chart:series ex:series-2161-1 ;
    chart:xVal "2009" ;
    chart:yVal "1.25"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-2161-1-2 a chart:DataPoint ;
    chart:series ex:series-2161-1 ;
    chart:xVal "2010" ;
    chart:yVal "1.35"^^xsd:decimal ;
    chart:valueEstimated "true" .

