    chart:valueEstimated "true" .

ex:dp-2161-1-7 a chart:DataPoint ;
    chart:series ex:series-2161-1 ;
    chart:xVal "2015" ;
    chart:yVal "1.45"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-2161-1-8 a chart:DataPoint ;
