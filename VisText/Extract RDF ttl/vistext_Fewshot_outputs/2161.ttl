    chart:series ex:series-2161-1 ;
    chart:xVal "2012" ;
    chart:yVal "1.45"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-2161-1-5 a chart:DataPoint ;
    chart:series ex:series-2161-1 ;
    chart:xVal "2013" ;
    chart:yVal "1.20"^^xsd:decimal ;
    chart:valueEstimated "true" .

