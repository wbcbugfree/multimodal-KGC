@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-8339 a chart:Chart ;
    chart:chartType "area" ;
    chart:title "Occupancy rate of Marriott International hotels worldwide from 2010 to 2019 , by region" ;
    chart:xAxis ex:x-8339 ;
    chart:yAxis ex:y-8339 .

ex:x-8339 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2010" ;
    chart:scaleMax "2019" .

ex:y-8339 a chart:Axis ;
    chart:label "" ;
    chart:scaleMin "0.0" ;
    chart:scaleMax "0.8" .

ex:series-8339-1 a chart:Series ;
    chart:seriesName "North America" .

ex:dp-8339-1-1 a chart:DataPoint ;
    chart:series ex:series-8339-1 ;
    chart:xVal "2010" ;
    chart:yVal "0.69"^^xsd:decimal ;
    chart:value "0.69"^^xsd:decimal ;
    chart:valueEstimated "true" .

