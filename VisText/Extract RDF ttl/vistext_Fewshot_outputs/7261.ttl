@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-7261 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Japan : Distribution of the workforce across economic sectors from 2010 to 2020" ;
    chart:xAxis ex:x-7261 ;
    chart:yAxis ex:y-7261 .

ex:x-7261 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2010" ;
    chart:scaleMax "2020" .

ex:y-7261 a chart:Axis ;
    chart:label "" ;
    chart:scaleMin "0.0" ;
    chart:scaleMax "0.8" .

ex:series-7261-1 a chart:Series ;
    chart:seriesName "Services" .

ex:dp-7261-1-1 a chart:DataPoint ;
    chart:series ex:series-7261-1 ;
    chart:category "2010" ;
    chart:value "0.71"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-7261-1-2 a chart:DataPoint ;
    chart:series ex:series-7261-1 ;
    chart:category "2014" ;
    chart:value "0.73"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-7261-1-3 a chart:DataPoint ;
    chart:series ex:series-7261-1 ;
    chart:category "2018" ;
    chart:value "0.75"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-7261-1-4 a chart:DataPoint ;
    chart:series ex:series-7261-1 ;
    chart:category "2020" ;
    chart:value "0.76"^^xsd:decimal ;
    chart:valueEstimated "true" .
