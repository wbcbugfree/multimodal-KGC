@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-3120 a chart:Chart ;
    chart:chartType "bar" ;
    chart:xAxis ex:x-3120 ;
    chart:yAxis ex:y-3120 .

ex:x-3120 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2008" ;
    chart:scaleMax "2018*" .

ex:y-3120 a chart:Axis ;
    chart:label "Annual turnover in million euros" ;
    chart:scaleMin "0" ;
    chart:scaleMax "800" .

ex:series-3120-1 a chart:Series .

ex:dp-3120-1-1 a chart:DataPoint ;
    chart:series ex:series-3120-1 ;
    chart:category "2008" ;
    chart:value "600"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-3120-1-2 a chart:DataPoint ;
    chart:series ex:series-3120-1 ;
    chart:category "2009" ;
    chart:value "300"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-3120-1-3 a chart:DataPoint ;
    chart:series ex:series-3120-1 ;
    chart:category "2010" ;
    chart:value "250"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-3120-1-4 a chart:DataPoint ;
    chart:series ex:series-3120-1 ;
    chart:category "2011" ;
    chart:value "350"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-3120-1-5 a chart:DataPoint ;
    chart:series ex:series-3120-1 ;
    chart:category "2012" ;
    chart:value "650"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-3120-1-6 a chart:DataPoint ;
    chart:series ex:series-3120-1 ;
    chart:category "2013" ;
    chart:value "700"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-3120-1-7 a chart:DataPoint ;
    chart:series ex:series-3120-1 ;
    chart:category "2014" ;
    chart:value "650"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-3120-1-8 a chart:DataPoint ;
    chart:series ex:series-3120-1 ;
    chart:category "2015" ;
    chart:value "620"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-3120-1-9 a chart:DataPoint ;
    chart:series ex:series-3120-1 ;
    chart:category "2016" ;
    chart:value "580"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-3120-1-10 a chart:DataPoint ;
    chart:series ex:series-3120-1 ;
    chart:category "2017" ;
    chart:value "560"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-3120-1-11 a chart:DataPoint ;
    chart:series ex:series-3120-1 ;
    chart:category "2018*" ;
    chart:value "570"^^xsd:decimal ;
    chart:valueEstimated "true" .
