@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-6936 a chart:Chart ;
    chart:chartType "area" ;
    chart:title "Rate of unemployment in Catalonia from 2006 to 2019 , by age group" ;
    chart:xAxis ex:x-6936 ;
    chart:yAxis ex:y-6936 .

ex:x-6936 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2006" ;
    chart:scaleMax "2019" .

ex:y-6936 a chart:Axis ;
    chart:label "55 years and over" ;
    chart:scaleMin "0.00" ;
    chart:scaleMax "0.20" .

ex:series-6936-1 a chart:Series .

ex:dp-6936-1-1 a chart:DataPoint ;
    chart:series ex:series-6936-1 ;
    chart:xVal "2006" ;
    chart:yVal "0.04"^^xsd:decimal ;
    chart:value "0.04"^^xsd:decimal ;
    chart:valueEstimated "true" .

