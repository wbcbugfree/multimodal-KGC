@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-1296 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Per capita personal income in Ohio from 2000 to 2019 (in current U.S. dollars)" ;
    chart:xAxis ex:x-1296 ;
    chart:yAxis ex:y-1296 .

ex:x-1296 a chart:Axis ;
    chart:label "leap year" ;
    chart:scaleMin "2000" ;
    chart:scaleMax "2019" .

ex:y-1296 a chart:Axis ;
    chart:label "Income in U.S. dollars" ;
    chart:scaleMin "0" ;
    chart:scaleMax "50000" .

ex:series-1296-1 a chart:Series .

ex:dp-1296-1-1 a chart:DataPoint ;
    chart:series ex:series-1296-1 ;
    chart:category "00" ;
    chart:value "24000"^^xsd:decimal ;
    chart:valueEstimated "true" .

