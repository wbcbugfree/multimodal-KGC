@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-5463 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Canada : Budget balance from 2015 to 2025 in relation to gross domestic product (GDP)" ;
    chart:xAxis ex:x-5463 ;
    chart:yAxis ex:y-5463 .

ex:x-5463 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2015" ;
    chart:scaleMax "2025" .

ex:y-5463 a chart:Axis ;
    chart:label "Budget balance to GDP ratio" ;
    chart:scaleMin "-0.20" ;
    chart:scaleMax "0.00" .

ex:series-5463-1 a chart:Series .

ex:dp-5463-1-1 a chart:DataPoint ;
    chart:series ex:series-5463-1 ;
    chart:category "2015" ;
    chart:value "-0.005"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-5463-1-2 a chart:DataPoint ;
    chart:series ex:series-5463-1 ;
    chart:category "2016" ;
    chart:value "-0.008"^^xsd:decimal ;
    chart:valueEstimated "true" .

