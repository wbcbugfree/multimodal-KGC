@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-4815 a chart:Chart ;
    chart:chartType "area" ;
    chart:title "Migration balance (immigrants minus emigrants) in Belgium from 2010 to 2019" ;
    chart:xAxis ex:x-4815 ;
    chart:yAxis ex:y-4815 .

ex:x-4815 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2010" ;
    chart:scaleMax "2019" .

ex:y-4815 a chart:Axis ;
    chart:label "Migration balance" ;
    chart:scaleMin "0" ;
    chart:scaleMax "100000" .

ex:series-4815-1 a chart:Series .

ex:dp-4815-1-1 a chart:DataPoint ;
    chart:series ex:series-4815-1 ;
    chart:xVal "2010" ;
    chart:yVal "85000"^^xsd:decimal ;
    chart:value "85000"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-4815-1-2 a chart:DataPoint ;
    chart:series ex:series-4815-1 ;
    chart:xVal "2011" ;
    chart:yVal "50000"^^xsd:decimal ;
    chart:value "50000"^^xsd:decimal ;
    chart:valueEstimated "true" .

