@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-3607 a chart:Chart ;
    chart:chartType "area" ;
    chart:title "External debt as percentage of gross domestic product in Haiti from 2000 to 2018" ;
    chart:xAxis ex:x-3607 ;
    chart:yAxis ex:y-3607 .

ex:x-3607 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2000" ;
    chart:scaleMax "2018" .

ex:y-3607 a chart:Axis ;
    chart:label "Foreign debt as share of GDP" ;
    chart:scaleMin "0.0" ;
    chart:scaleMax "0.4" .

ex:series-3607-1 a chart:Series .

ex:dp-3607-1-1 a chart:DataPoint ;
    chart:series ex:series-3607-1 ;
    chart:xVal "2000" ;
    chart:yVal "0.17"^^xsd:decimal ;
    chart:valueEstimated "true" .

