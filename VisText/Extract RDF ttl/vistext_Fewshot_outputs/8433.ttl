@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-8433 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Retail volume of bakery products market forecast in the European Union (EU) in 2015 and 2019 , by country (in 1,000 tonnes)" ;
    chart:xAxis ex:x-8433 ;
    chart:yAxis ex:y-8433 .

ex:x-8433 a chart:Axis ;
    chart:label "Country" .

ex:y-8433 a chart:Axis ;
    chart:label "" ;
    chart:scaleMin "0" ;
    chart:scaleMax "6000" .

ex:series-8433-1 a chart:Series .

ex:dp-8433-1-1 a chart:DataPoint ;
    chart:series ex:series-8433-1 ;
    chart:category "Belgium" ;
    chart:value "1000"^^xsd:decimal ;
    chart:valueEstimated "true" .

