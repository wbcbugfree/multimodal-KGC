@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-6891 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Crime rate per 1,000 population in the United Kingdom from 2002/03 to 2019/20 , by country" ;
    chart:xAxis ex:x-6891 ;
    chart:yAxis ex:y-6891 .

ex:x-6891 a chart:Axis ;
    chart:label "United Kingdom" ;
    chart:scaleMin "0" ;
    chart:scaleMax "120" .

ex:y-6891 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "" ;
    chart:scaleMax "" .

ex:series-6891-1 a chart:Series .

ex:dp-6891-1-1 a chart:DataPoint ;
