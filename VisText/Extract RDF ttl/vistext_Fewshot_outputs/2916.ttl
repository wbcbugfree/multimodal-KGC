@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-2916 a chart:Chart ;
    chart:chartType "area" ;
    chart:title "Production value of breaded shrimp in the United States from 2000 to 2018 (in 1,000 U.S. dollars)" ;
    chart:xAxis ex:x-2916 ;
    chart:yAxis ex:y-2916 .

ex:x-2916 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2000" ;
    chart:scaleMax "2018" .

ex:y-2916 a chart:Axis ;
    chart:label "Production value in thousand U.S. dollars" ;
    chart:scaleMin "0" ;
    chart:scaleMax "600,000" .

ex:series-2916-1 a chart:Series .

ex:dp-2916-1-1 a chart:DataPoint ;
    chart:series ex:series-2916-1 ;
    chart:xVal "2000" ;
    chart:yVal "580000"^^xsd:decimal ;
    chart:valueEstimated "true" .

