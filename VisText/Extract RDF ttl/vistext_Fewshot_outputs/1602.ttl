@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-1602 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Total number of biotechnology firms in selected European countries in 2018" ;
    chart:xAxis ex:x-1602 ;
    chart:yAxis ex:y-1602 .

ex:x-1602 a chart:Axis ;
    chart:label "Number of companies" ;
    chart:scaleMin "0" ;
    chart:scaleMax "2000" .

ex:y-1602 a chart:Axis ;
    chart:label "Country" .

ex:series-1602-1 a chart:Series .

ex:dp-1602-1-1 a chart:DataPoint ;
    chart:series ex:series-1602-1 ;
    chart:category "Austria" ;
    chart:value "200"^^xsd:decimal ;
    chart:valueEstimated "true" .

