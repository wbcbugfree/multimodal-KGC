@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-3735 a chart:Chart ;
    chart:chartType "area" ;
    chart:title "Liechtenstein : Gross domestic product (GDP) in current prices from 2007 to 2017 (in billion U.S. dollars)" ;
    chart:xAxis ex:x-3735 ;
    chart:yAxis ex:y-3735 .

ex:x-3735 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2007" ;
    chart:scaleMax "2017" .

ex:y-3735 a chart:Axis ;
    chart:label "Gross domestic product in billion U.S. dollars" ;
    chart:scaleMin "0" ;
    chart:scaleMax "7" .

ex:series-3735-1 a chart:Series .

ex:dp-3735-1-1 a chart:DataPoint ;
    chart:series ex:series-3735-1 ;
    chart:xVal "2007" ;
    chart:yVal "4.7"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-3735-1-2 a chart:DataPoint ;
    chart:series ex:series-3735-1 ;
    chart:xVal "2008" ;
    chart:yVal "5.0"^^xsd:decimal ;
    chart:valueEstimated "true" .

