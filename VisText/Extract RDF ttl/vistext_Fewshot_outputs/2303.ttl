@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-2303 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Installed power capacity across Rajasthan in India from financial year 2005 to 2018 (in megawatts)" ;
    chart:xAxis ex:x-2303 ;
    chart:yAxis ex:y-2303 .

ex:x-2303 a chart:Axis ;
    chart:label "Installed power capacity in megawatts" ;
    chart:scaleMin "0" ;
    chart:scaleMax "20000" .

ex:y-2303 a chart:Axis ;
    chart:label "year" ;
    chart:scaleMin "" ;
    chart:scaleMax "" .

ex:series-2303-1 a chart:Series .

ex:dp-2303-1-1 a chart:DataPoint ;
    chart:series ex:series-2303-1 ;
    chart:category "FY 2005" ;
    chart:value "5000"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-2303-1-2 a chart:DataPoint ;
    chart:series ex:series-2303-1 ;
    chart:category "FY 2006" ;
    chart:value "7500"^^xsd:decimal ;
    chart:valueEstimated "true" .

