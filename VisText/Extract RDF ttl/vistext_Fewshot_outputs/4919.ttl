@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-4919 a chart:Chart ;
    chart:chartType "area" ;
    chart:title "Value of consumer credit outstanding in the United States from 2000 to 2019 (in billion U.S. dollars)" ;
    chart:xAxis ex:x-4919 ;
    chart:yAxis ex:y-4919 .

ex:x-4919 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2000" ;
    chart:scaleMax "2019" .

ex:y-4919 a chart:Axis ;
    chart:label "Consumer credit in billion U.S. dollars" ;
    chart:scaleMin "0" ;
    chart:scaleMax "4000" .

ex:series-4919-1 a chart:Series .

ex:dp-4919-1-1 a chart:DataPoint ;
    chart:series ex:series-4919-1 ;
    chart:xVal "2000" ;
    chart:yVal "1500"^^xsd:decimal ;
    chart:value "1500"^^xsd:decimal ;
    chart:valueEstimated "true" .

