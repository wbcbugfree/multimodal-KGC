@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-4650 a chart:Chart ;
    chart:chartType "area" ;
    chart:title "American customer satisfaction index scores of Kentucky Fried Chicken restaurants in the United States from 2000 to 2020" ;
    chart:xAxis ex:x-4650 ;
    chart:yAxis ex:y-4650 .

ex:x-4650 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2000" ;
    chart:scaleMax "2020" .

ex:y-4650 a chart:Axis ;
    chart:label "ACSI score" ;
    chart:scaleMin "0" ;
    chart:scaleMax "100" .

ex:series-4650-1 a chart:Series .

ex:dp-4650-1-1 a chart:DataPoint ;
    chart:series ex:series-4650-1 ;
    chart:xVal "2000" ;
    chart:yVal "64"^^xsd:decimal ;
    chart:valueEstimated "true" .

