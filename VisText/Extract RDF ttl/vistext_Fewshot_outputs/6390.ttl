    chart:series ex:series-6390-1 ;
    chart:xVal "2010" ;
    chart:yVal "425"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-6390-1-5 a chart:DataPoint ;
    chart:series ex:series-6390-1 ;
    chart:xVal "2011" ;
    chart:yVal "415"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-6390-1-6 a chart:DataPoint ;
    chart:series ex:series-6390-1 ;
    chart:xVal "2012" ;
    chart:yVal "405"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-6390-1-7 a chart:DataPoint ;
    chart:series ex:series-6390-1 ;
    chart:xVal "2013" ;
    chart:yVal "375"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-6390-1-8 a chart:DataPoint ;
    chart:series ex:series-6390-1 ;
    chart:xVal "2014" ;
    chart:yVal "345"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-6390-1-9 a chart:DataPoint ;
    chart:series ex:series-6390-1 ;
    chart:xVal "2015" ;
    chart:yVal "330"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-6390-1-10 a chart:DataPoint ;
    chart:series ex:series-6390-1 ;
    chart:xVal "2016" ;
