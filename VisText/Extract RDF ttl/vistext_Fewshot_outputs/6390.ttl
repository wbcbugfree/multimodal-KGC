@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-6390 a chart:Chart ;
    chart:chartType "line" ;
    chart:title "Total number of suicides in Finland from 2007 to 2018 , by age" ;
    chart:xAxis ex:x-6390 ;
    chart:yAxis ex:y-6390 .

ex:x-6390 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2007" ;
    chart:scaleMax "2018" .

ex:y-6390 a chart:Axis ;
    chart:label "" ;
    chart:scaleMin "0" ;
    chart:scaleMax "500" .

ex:series-6390-1 a chart:Series ;
    chart:seriesName "40-64 years" .

ex:dp-6390-1-1 a chart:DataPoint ;
    chart:series ex:series-6390-1 ;
    chart:xVal "2007" ;
    chart:yVal "520"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-6390-1-2 a chart:DataPoint ;
    chart:series ex:series-6390-1 ;
    chart:xVal "2008" ;
    chart:yVal "510"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-6390-1-3 a chart:DataPoint ;
    chart:series ex:series-6390-1 ;
    chart:xVal "2009" ;
    chart:yVal "445"^^xsd:decimal ;
    chart:valueEstimated "true" .

