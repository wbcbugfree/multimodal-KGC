@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-4013 a chart:Chart ;
    chart:chartType "line" ;
    chart:title "Boehringer Ingelheim 's expenditure on research and development as a percentage of revenue from 2004 to 2019" ;
    chart:xAxis ex:x-4013 ;
    chart:yAxis ex:y-4013 .

ex:x-4013 a chart:Axis ;
    chart:label "Response" ;
    chart:scaleMin "2004" ;
    chart:scaleMax "2019" .

ex:y-4013 a chart:Axis ;
    chart:label "Percentage of revenue" ;
    chart:scaleMin "0.00" ;
    chart:scaleMax "0.20" .

ex:series-4013-1 a chart:Series .

ex:dp-4013-1-1 a chart:DataPoint ;
    chart:series ex:series-4013-1 ;
    chart:xVal "2004" ;
    chart:yVal "0.15"^^xsd:decimal ;
    chart:valueEstimated "true" .

