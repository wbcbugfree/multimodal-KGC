@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-1159 a chart:Chart ;
    chart:chartType "area" ;
    chart:title "Euro (EUR) to Polish zloty (PLN) annual average exchange rate from 1999 to 2018" ;
    chart:xAxis ex:x-1159 ;
    chart:yAxis ex:y-1159 .

ex:x-1159 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "1999" ;
    chart:scaleMax "2018" .

ex:y-1159 a chart:Axis ;
    chart:label "Exchange rate" ;
    chart:scaleMin "0" ;
    chart:scaleMax "5" .

ex:series-1159-1 a chart:Series .

ex:dp-1159-1-1 a chart:DataPoint ;
    chart:series ex:series-1159-1 ;
    chart:xVal "2000" ;
    chart:yVal "4.05"^^xsd:decimal ;
    chart:valueEstimated "true" .

