@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-5045 a chart:Chart ;
    chart:chartType "area" ;
    chart:title "Global number of permanent nuclear reactor shutdowns from 2005 to 2020" ;
    chart:xAxis ex:x-5045 ;
    chart:yAxis ex:y-5045 .

ex:x-5045 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2005" ;
    chart:scaleMax "2020" .

ex:y-5045 a chart:Axis ;
    chart:label "Number of shutdowns" ;
    chart:scaleMin "0" ;
    chart:scaleMax "12" .

ex:series-5045-1 a chart:Series .

ex:dp-5045-1-1 a chart:DataPoint ;
    chart:series ex:series-5045-1 ;
    chart:xVal "2006" ;
    chart:yVal "8"^^xsd:decimal ;
    chart:value "8"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-5045-1-2 a chart:DataPoint ;
    chart:series ex:series-5045-1 ;
    chart:xVal "2007" ;
    chart:yVal "1.5"^^xsd:decimal ;
    chart:value "1.5"^^xsd:decimal ;
    chart:valueEstimated "true" .

