@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-4298 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Japan 's largest chemical companies 2009 , by revenue (in million U.S. dollars)" ;
    chart:xAxis ex:x-4298 ;
    chart:yAxis ex:y-4298 .

ex:x-4298 a chart:Axis ;
    chart:label "Chemical company" .

ex:y-4298 a chart:Axis ;
    chart:label "Revenue (in million U.S. dollars)" ;
    chart:scaleMin "0" ;
    chart:scaleMax "30000" .

ex:series-4298-1 a chart:Series .

ex:dp-4298-1-1 a chart:DataPoint ;
    chart:series ex:series-4298-1 ;
    chart:category "Asahi Kasei" ;
    chart:value "17500"^^xsd:decimal ;
    chart:valueEstimated "true" .

