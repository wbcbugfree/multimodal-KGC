@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-7727 a chart:Chart ;
    chart:chartType "area" ;
    chart:title "Merchandise sales of Dollar General in the United States from 2009 to 2019 , by product category (in million U.S. dollars)" ;
    chart:xAxis ex:x-7727 ;
    chart:yAxis ex:y-7727 .

ex:x-7727 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2009" ;
    chart:scaleMax "2019" .

ex:y-7727 a chart:Axis ;
    chart:label "Home products" ;
    chart:scaleMin "0" ;
    chart:scaleMax "1700" .

ex:series-7727-1 a chart:Series .

ex:dp-7727-1-1 a chart:DataPoint ;
    chart:series ex:series-7727-1 ;
    chart:xVal "2009" ;
    chart:yVal "850"^^xsd:decimal ;
    chart:value "850"^^xsd:decimal ;
    chart:valueEstimated "true" .

