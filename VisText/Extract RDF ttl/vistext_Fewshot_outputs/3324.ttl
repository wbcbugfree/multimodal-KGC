@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-3324 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Los Angeles Angels all-time home run leaders as of October 2020" ;
    chart:xAxis ex:x-3324 ;
    chart:yAxis ex:y-3324 .

ex:x-3324 a chart:Axis ;
    chart:label "Home run leaders" .

ex:y-3324 a chart:Axis ;
    chart:label "Number of home runs" ;
    chart:scaleMin "0" ;
    chart:scaleMax "350" .

ex:series-3324-1 a chart:Series .

ex:dp-3324-1-1 a chart:DataPoint ;
    chart:series ex:series-3324-1 ;
    chart:category "Albert Pujols" ;
    chart:value "222"^^xsd:decimal ;
    chart:valueEstimated "true" .

