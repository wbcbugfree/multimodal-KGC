@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-1198 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Forecast volume of rice imported to the European Union (EU 27) from 2015 to 2029 (in 1,000 tonnes)" ;
    chart:xAxis ex:x-1198 ;
    chart:yAxis ex:y-1198 .

ex:x-1198 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2015" ;
    chart:scaleMax "2029" .

ex:y-1198 a chart:Axis ;
    chart:label "Volume in thousand tonnes" ;
    chart:scaleMin "0" ;
    chart:scaleMax "1500" .

ex:series-1198-1 a chart:Series .

ex:dp-1198-1-1 a chart:DataPoint ;
    chart:series ex:series-1198-1 ;
    chart:category "2015" ;
    chart:value "1300"^^xsd:decimal ;
    chart:valueEstimated "true" .

