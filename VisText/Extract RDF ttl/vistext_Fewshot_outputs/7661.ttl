@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-7661 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Migration figures of Spanish people leaving or returning to Spain from 2010 to 2019" ;
    chart:xAxis ex:x-7661 ;
    chart:yAxis ex:y-7661 .

ex:x-7661 a chart:Axis ;
    chart:label "Inflow" ;
    chart:scaleMin "0" ;
    chart:scaleMax "80000" .

ex:y-7661 a chart:Axis ;
    chart:label "Year" .

ex:series-7661-1 a chart:Series .

ex:dp-7661-1-1 a chart:DataPoint ;
    chart:series ex:series-7661-1 ;
    chart:category "2010" ;
    chart:value "25000"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-7661-1-2 a chart:DataPoint ;
    chart:series ex:series-7661-1 ;
    chart:category "2011" ;
    chart:value "30000"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-7661-1-3 a chart:DataPoint ;
    chart:series ex:series-7661-1 ;
    chart:category "2012" ;
    chart:value "25000"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-7661-1-4 a chart:DataPoint ;
    chart:series ex:series-7661-1 ;
    chart:category "2013" ;
    chart:value "30000"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-7661-1-5 a chart:DataPoint ;
    chart:series ex:series-7661-1 ;
    chart:category "2014" ;
    chart:value "40000"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-7661-1-6 a chart:DataPoint ;
    chart:series ex:series-7661-1 ;
    chart:category "2015" ;
    chart:value "48000"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-7661-1-7 a chart:DataPoint ;
    chart:series ex:series-7661-1 ;
    chart:category "2016" ;
    chart:value "58000"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-7661-1-8 a chart:DataPoint ;
    chart:series ex:series-7661-1 ;
    chart:category "2017" ;
    chart:value "75000"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-7661-1-9 a chart:DataPoint ;
    chart:series ex:series-7661-1 ;
    chart:category "2018" ;
    chart:value "78000"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-7661-1-10 a chart:DataPoint ;
    chart:series ex:series-7661-1 ;
    chart:category "2019*" ;
    chart:value "40000"^^xsd:decimal ;
    chart:valueEstimated "true" .
