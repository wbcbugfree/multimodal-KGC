@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-4739 a chart:Chart ;
    chart:chartType "line" ;
    chart:title "Revenue of the Tampa Bay Rays (MLB) from 2001 to 2019 (in million U.S. dollars)" ;
    chart:xAxis ex:x-4739 ;
    chart:yAxis ex:y-4739 .

ex:x-4739 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2001" ;
    chart:scaleMax "2019" .

ex:y-4739 a chart:Axis ;
    chart:label "Revenue in million U.S. dollars" ;
    chart:scaleMin "0" ;
    chart:scaleMax "300" .

ex:series-4739-1 a chart:Series .

ex:dp-4739-1-1 a chart:DataPoint ;
    chart:series ex:series-4739-1 ;
    chart:xVal "2001" ;
    chart:yVal "95"^^xsd:decimal ;
    chart:valueEstimated "true" .

