@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-3061 a chart:Chart ;
    chart:chartType "bar" ;
    chart:xAxis ex:x-3061 ;
    chart:yAxis ex:y-3061 .

ex:x-3061 a chart:Axis ;
    chart:label "Share of total volume imported" ;
    chart:scaleMin "0.00" ;
    chart:scaleMax "0.15" .

ex:y-3061 a chart:Axis ;
    chart:label "Response" .

ex:series-3061-1 a chart:Series .

ex:dp-3061-1-1 a chart:DataPoint ;
    chart:series ex:series-3061-1 ;
    chart:category "Ecuador" ;
    chart:value "0.13"^^xsd:decimal ;
    chart:valueEstimated "true" .

