@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-3999 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Value of gems and jewelry exported from India between financial year 2009 and 2020 (in billion U.S. dollars)" ;
    chart:xAxis ex:x-3999 ;
    chart:yAxis ex:y-3999 .

ex:x-3999 a chart:Axis ;
    chart:label "year" ;
    chart:scaleMin "FY 2009" ;
    chart:scaleMax "FY 2020" .

ex:y-3999 a chart:Axis ;
    chart:label "Export value in billion U.S. dollars" ;
    chart:scaleMin "0" ;
    chart:scaleMax "50" .

ex:series-3999-1 a chart:Series .

ex:dp-3999-1-1 a chart:DataPoint ;
    chart:series ex:series-3999-1 ;
    chart:category "FY 2009" ;
    chart:value "26"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-3999-1-2 a chart:DataPoint ;
    chart:series ex:series-3999-1 ;
    chart:category "FY 2010" ;
    chart:value "31"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-3999-1-3 a chart:DataPoint ;
    chart:series ex:series-3999-1 ;
    chart:category "FY 2011" ;
    chart:value "46"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-3999-1-4 a chart:DataPoint ;
    chart:series ex:series-3999-1 ;
    chart:category "FY 2012" ;
    chart:value "48"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-3999-1-5 a chart:DataPoint ;
    chart:series ex:series-3999-1 ;
    chart:category "FY 2013" ;
    chart:value "44"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-3999-1-6 a chart:DataPoint ;
    chart:series ex:series-3999-1 ;
    chart:category "FY 2014" ;
    chart:value "41"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-3999-1-7 a chart:DataPoint ;
    chart:series ex:series-3999-1 ;
    chart:category "FY 2015" ;
    chart:value "41"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-3999-1-8 a chart:DataPoint ;
    chart:series ex:series-3999-1 ;
    chart:category "FY 2016" ;
    chart:value "40"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-3999-1-9 a chart:DataPoint ;
    chart:series ex:series-3999-1 ;
    chart:category "FY 2017" ;
    chart:value "44"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-3999-1-10 a chart:DataPoint ;
    chart:series ex:series-3999-1 ;
    chart:category "FY 2018" ;
    chart:value "43"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-3999-1-11 a chart:DataPoint ;
    chart:series ex:series-3999-1 ;
