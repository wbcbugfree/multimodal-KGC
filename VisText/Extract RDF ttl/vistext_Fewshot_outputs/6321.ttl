@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-6321 a chart:Chart ;
    chart:chartType "area" ;
    chart:xAxis ex:x-6321 ;
    chart:yAxis ex:y-6321 .

ex:x-6321 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2010" ;
    chart:scaleMax "2018" .

ex:y-6321 a chart:Axis ;
    chart:label "Services" ;
    chart:scaleMin "0.0" ;
    chart:scaleMax "0.4" .

ex:series-6321-1 a chart:Series .

ex:dp-6321-1-1 a chart:DataPoint ;
    chart:series ex:series-6321-1 ;
    chart:xVal "2010" ;
    chart:yVal "0.39"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-6321-1-2 a chart:DataPoint ;
    chart:series ex:series-6321-1 ;
    chart:xVal "2011" ;
    chart:yVal "0.38"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-6321-1-3 a chart:DataPoint ;
    chart:series ex:series-6321-1 ;
    chart:xVal "2012" ;
    chart:yVal "0.39"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-6321-1-4 a chart:DataPoint ;
    chart:series ex:series-6321-1 ;
    chart:xVal "2013" ;
    chart:yVal "0.40"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-6321-1-5 a chart:DataPoint ;
    chart:series ex:series-6321-1 ;
    chart:xVal "2014" ;
    chart:yVal "0.41"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-6321-1-6 a chart:DataPoint ;
    chart:series ex:series-6321-1 ;
    chart:xVal "2015" ;
    chart:yVal "0.43"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-6321-1-7 a chart:DataPoint ;
    chart:series ex:series-6321-1 ;
    chart:xVal "2016" ;
    chart:yVal "0.45"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-6321-1-8 a chart:DataPoint ;
    chart:series ex:series-6321-1 ;
    chart:xVal "2017" ;
    chart:yVal "0.44"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-6321-1-9 a chart:DataPoint ;
