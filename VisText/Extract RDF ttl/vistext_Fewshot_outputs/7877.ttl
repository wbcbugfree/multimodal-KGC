@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-7877 a chart:Chart ;
    chart:chartType "area" ;
    chart:title "Net revenue of Williams-Sonoma worldwide from 2009 to 2019 , by brand (in million U.S. dollars)" ;
    chart:xAxis ex:x-7877 ;
    chart:yAxis ex:y-7877 .

ex:x-7877 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2009" ;
    chart:scaleMax "2019" .

ex:y-7877 a chart:Axis ;
    chart:label "Other*" ;
    chart:scaleMin "0" ;
    chart:scaleMax "250" .

ex:series-7877-1 a chart:Series .

ex:dp-7877-1-1 a chart:DataPoint ;
    chart:series ex:series-7877-1 ;
    chart:xVal "2009" ;
    chart:yVal "30"^^xsd:decimal ;
    chart:value "30"^^xsd:decimal ;
    chart:valueEstimated "true" .

