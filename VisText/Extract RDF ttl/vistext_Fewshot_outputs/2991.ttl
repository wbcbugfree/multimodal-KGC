@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-2991 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Number of births in Yukon , Canada from 2001 to 2020" ;
    chart:xAxis ex:x-2991 ;
    chart:yAxis ex:y-2991 .

ex:x-2991 a chart:Axis ;
    chart:label "Number of births" ;
    chart:scaleMin "0" ;
    chart:scaleMax "500" .

ex:y-2991 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "" ;
    chart:scaleMax "" .

ex:series-2991-1 a chart:Series .

ex:dp-2991-1-1 a chart:DataPoint ;
    chart:series ex:series-2991-1 ;
    chart:category "2000-2001" ;
    chart:value "450"^^xsd:decimal ;
    chart:valueEstimated "true" .

