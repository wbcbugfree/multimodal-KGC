@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-2863 a chart:Chart ;
    chart:chartType "area" ;
    chart:title "Trade union density : percentage of employees that were members of a trade union in Norway from 2000 to 2013" ;
    chart:xAxis ex:x-2863 ;
    chart:yAxis ex:y-2863 .

ex:x-2863 a chart:Axis ;
    chart:label "Response" ;
    chart:scaleMin "2000" ;
    chart:scaleMax "2013" .

ex:y-2863 a chart:Axis ;
    chart:label "Percentage of employees" ;
    chart:scaleMin "0.0" ;
    chart:scaleMax "0.6" .

ex:series-2863-1 a chart:Series .

ex:dp-2863-1-1 a chart:DataPoint ;
    chart:series ex:series-2863-1 ;
    chart:xVal "2000" ;
    chart:yVal "0.53"^^xsd:decimal ;
    chart:value "0.53"^^xsd:decimal ;
    chart:valueEstimated "true" .

