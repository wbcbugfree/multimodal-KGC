@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-7547 a chart:Chart ;
    chart:chartType "area" ;
    chart:title "Average monthly income in Belgium from 2007 to 2017 , by level of education (in euros)" ;
    chart:xAxis ex:x-7547 ;
    chart:yAxis ex:y-7547 .

ex:x-7547 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2007" ;
    chart:scaleMax "2017" .

ex:y-7547 a chart:Axis ;
    chart:label "Higher education - Bachelor" ;
    chart:scaleMin "0" ;
    chart:scaleMax "4000" .

ex:series-7547-1 a chart:Series .

ex:dp-7547-1-1 a chart:DataPoint ;
    chart:series ex:series-7547-1 ;
    chart:xVal "2007" ;
    chart:yVal "2900"^^xsd:decimal ;
    chart:value "2900"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-7547-1-2 a chart:DataPoint ;
    chart:series ex:series-7547-1 ;
    chart:xVal "2008" ;
    chart:yVal "2950"^^xsd:decimal ;
    chart:value "2950"^^xsd:decimal ;
    chart:valueEstimated "true" .

