@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-8221 a chart:Chart ;
    chart:chartType "area" ;
    chart:title "Honduras : Age structure from 2009 to 2019" ;
    chart:xAxis ex:x-8221 ;
    chart:yAxis ex:y-8221 .

ex:x-8221 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2009" ;
    chart:scaleMax "2019" .

ex:y-8221 a chart:Axis ;
    chart:label "15-64 years" ;
    chart:scaleMin "0.0" ;
    chart:scaleMax "0.6" .

ex:series-8221-1 a chart:Series .

ex:dp-8221-1-1 a chart:DataPoint ;
    chart:series ex:series-8221-1 ;
    chart:xVal "2009" ;
    chart:yVal "0.55"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-8221-1-2 a chart:DataPoint ;
    chart:series ex:series-8221-1 ;
    chart:xVal "2010" ;
    chart:yVal "0.555"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-8221-1-3 a chart:DataPoint ;
    chart:series ex:series-8221-1 ;
    chart:xVal "2011" ;
    chart:yVal "0.56"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-8221-1-4 a chart:DataPoint ;
    chart:series ex:series-8221-1 ;
    chart:xVal "2012" ;
    chart:yVal "0.565"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-8221-1-5 a chart:DataPoint ;
    chart:series ex:series-8221-1 ;
    chart:xVal "2013" ;
    chart:yVal "0.57"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-8221-1-6 a chart:DataPoint ;
    chart:series ex:series-8221-1 ;
    chart:xVal "2014" ;
    chart:yVal "0.575"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-8221-1-7 a chart:DataPoint ;
    chart:series ex:series-8221-1 ;
    chart:xVal "2015" ;
    chart:yVal "0.58"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-8221-1-8 a chart:DataPoint ;
    chart:series ex:series-8221-1 ;
    chart:xVal "2016" ;
    chart:yVal "0.585"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-8221-1-9 a chart:DataPoint ;
    chart:series ex:series-8221-1 ;
    chart:xVal "2017" ;
    chart:yVal "0.59"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-8221-1-10 a chart:DataPoint ;
    chart:series ex:series-8221-1 ;
    chart:xVal "2018" ;
    chart:yVal "0.595"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-8221-1-11 a chart:DataPoint ;
    chart:series ex:series-8221-1 ;
    chart:xVal "2019" ;
