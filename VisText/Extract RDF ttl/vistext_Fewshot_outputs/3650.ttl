    chart:series ex:series-3650-1 ;
    chart:category "Milano" ;
    chart:value "0.33"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:mark-3650-1-6 a chart:DataPoint ;
    chart:series ex:series-3650-1 ;
    chart:category "Napoli" ;
    chart:value "0.17"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:mark-3650-1-7 a chart:DataPoint ;
    chart:series ex:series-3650-1 ;
    chart:category "Palermo" ;
    chart:value "0.15"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:mark-3650-1-8 a chart:DataPoint ;
    chart:series ex:series-3650-1 ;
    chart:category "Roma" ;
    chart:value "0.26"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:mark-3650-1-9 a chart:DataPoint ;
