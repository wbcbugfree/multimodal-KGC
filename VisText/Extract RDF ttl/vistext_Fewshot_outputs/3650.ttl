@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-3650 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Average value of CPC (cost per click) of online advertising campaigns in the real estate sector in Italy in 2018 , by city (in euros)" ;
    chart:xAxis ex:x-3650 ;
    chart:yAxis ex:y-3650 .

ex:x-3650 a chart:Axis ;
    chart:label "CPC in euros" ;
    chart:scaleMin "0.00" ;
    chart:scaleMax "0.35" .

ex:y-3650 a chart:Axis ;
    chart:label "city of Italy" .

ex:series-3650-1 a chart:Series .

ex:mark-3650-1-1 a chart:DataPoint ;
    chart:series ex:series-3650-1 ;
    chart:category "Bari" ;
    chart:value "0.12"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:mark-3650-1-2 a chart:DataPoint ;
    chart:series ex:series-3650-1 ;
    chart:category "Bologna" ;
    chart:value "0.17"^^xsd:decimal ;
    chart:valueEstimated "true" .

