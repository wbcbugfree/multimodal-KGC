@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-3707 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Population of Spain in 2020 , by autonomous community" ;
    chart:xAxis ex:x-3707 ;
    chart:yAxis ex:y-3707 .

ex:x-3707 a chart:Axis ;
    chart:label "Population" ;
    chart:scaleMin "0" ;
    chart:scaleMax "8000000" .

ex:y-3707 a chart:Axis ;
    chart:label "autonomous community of Spain" ;
    chart:scaleMin "" ;
    chart:scaleMax "" .

ex:series-3707-1 a chart:Series .

ex:dp-3707-1-1 a chart:DataPoint ;
