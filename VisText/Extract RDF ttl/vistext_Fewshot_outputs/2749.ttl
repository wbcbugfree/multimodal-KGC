@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-2749 a chart:Chart ;
    chart:chartType "line" ;
    chart:title "Amount of money invested in rail transport infrastructure in Denmark from 2004 to 2016\n(in million euros)" ;
    chart:xAxis ex:x-2749 ;
    chart:yAxis ex:y-2749 .

ex:x-2749 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2004" ;
    chart:scaleMax "2016" .

ex:y-2749 a chart:Axis ;
    chart:label "Millions of euros invested" ;
    chart:scaleMin "0" ;
    chart:scaleMax "1400" .

ex:series-2749-1 a chart:Series .

ex:dp-2749-1-1 a chart:DataPoint ;
    chart:series ex:series-2749-1 ;
    chart:xVal "2004" ;
    chart:yVal "300"^^xsd:decimal ;
    chart:value "300"^^xsd:decimal ;
    chart:valueEstimated "true" .

