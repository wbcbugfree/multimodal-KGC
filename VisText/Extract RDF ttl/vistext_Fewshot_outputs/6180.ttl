@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-6180 a chart:Chart ;
    chart:chartType "area" ;
    chart:xAxis ex:x-6180 ;
    chart:yAxis ex:y-6180 .

ex:x-6180 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "1990" ;
    chart:scaleMax "2018" .

ex:y-6180 a chart:Axis ;
    chart:label "Private use" ;
    chart:scaleMin "0" ;
    chart:scaleMax "15000" .

ex:series-6180-1 a chart:Series .

ex:dp-6180-1-1 a chart:DataPoint ;
    chart:series ex:series-6180-1 ;
    chart:xVal "1990" ;
    chart:yVal "12000"^^xsd:decimal ;
    chart:value "12000"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-6180-1-2 a chart:DataPoint ;
    chart:series ex:series-6180-1 ;
    chart:xVal "1995" ;
    chart:yVal "13000"^^xsd:decimal ;
    chart:value "13000"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-6180-1-3 a chart:DataPoint ;
    chart:series ex:series-6180-1 ;
    chart:xVal "2000" ;
    chart:yVal "14000"^^xsd:decimal ;
    chart:value "14000"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-6180-1-4 a chart:DataPoint ;
    chart:series ex:series-6180-1 ;
    chart:xVal "2005" ;
    chart:yVal "14500"^^xsd:decimal ;
    chart:value "14500"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-6180-1-5 a chart:DataPoint ;
    chart:series ex:series-6180-1 ;
    chart:xVal "2010" ;
    chart:yVal "14000"^^xsd:decimal ;
    chart:value "14000"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-6180-1-6 a chart:DataPoint ;
    chart:series ex:series-6180-1 ;
    chart:xVal "2015" ;
    chart:yVal "14200"^^xsd:decimal ;
    chart:value "14200"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-6180-1-7 a chart:DataPoint ;
    chart:series ex:series-6180-1 ;
    chart:xVal "2018" ;
    chart:yVal "14400"^^xsd:decimal ;
    chart:value "14400"^^xsd:decimal ;
    chart:valueEstimated "true" .
