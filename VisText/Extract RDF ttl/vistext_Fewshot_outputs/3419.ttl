@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-3419 a chart:Chart ;
    chart:chartType "area" ;
    chart:title "Consumption of coal energy for electricity generation in the United States from 1950 to 2019 (in million short tons)" ;
    chart:xAxis ex:x-3419 ;
    chart:yAxis ex:y-3419 .

ex:x-3419 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "1950" ;
    chart:scaleMax "2019" .

ex:y-3419 a chart:Axis ;
    chart:label "Consumption in million short tons" ;
    chart:scaleMin "0" ;
    chart:scaleMax "1000" .

ex:series-3419-1 a chart:Series .

ex:dp-3419-1-1 a chart:DataPoint ;
    chart:series ex:series-3419-1 ;
    chart:xVal "1950" ;
    chart:yVal "100"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-3419-1-2 a chart:DataPoint ;
    chart:series ex:series-3419-1 ;
    chart:xVal "1960" ;
    chart:yVal "300"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-3419-1-3 a chart:DataPoint ;
    chart:series ex:series-3419-1 ;
    chart:xVal "1970" ;
    chart:yVal "600"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-3419-1-4 a chart:DataPoint ;
    chart:series ex:series-3419-1 ;
    chart:xVal "1980" ;
    chart:yVal "800"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-3419-1-5 a chart:DataPoint ;
    chart:series ex:series-3419-1 ;
    chart:xVal "1990" ;
    chart:yVal "950"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-3419-1-6 a chart:DataPoint ;
    chart:series ex:series-3419-1 ;
    chart:xVal "2000" ;
    chart:yVal "1050"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-3419-1-7 a chart:DataPoint ;
    chart:series ex:series-3419-1 ;
    chart:xVal "2010" ;
    chart:yVal "700"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-3419-1-8 a chart:DataPoint ;
    chart:series ex:series-3419-1 ;
    chart:xVal "2019" ;
    chart:yVal "450"^^xsd:decimal ;
    chart:valueEstimated "true" .
