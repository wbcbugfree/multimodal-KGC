@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-1241 a chart:Chart ;
    chart:chartType "line" ;
    chart:title "Total amount of investment of private equity firms in Bulgaria from 2007 to 2016 (in million euros)" ;
    chart:xAxis ex:x-1241 ;
    chart:yAxis ex:y-1241 .

ex:x-1241 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2007" ;
    chart:scaleMax "2016" .

ex:y-1241 a chart:Axis ;
    chart:label "Total investment in million euros" ;
    chart:scaleMin "0" ;
    chart:scaleMax "70" .

ex:series-1241-1 a chart:Series .

ex:dp-1241-1-1 a chart:DataPoint ;
    chart:series ex:series-1241-1 ;
    chart:xVal "2007" ;
    chart:yVal "7"^^xsd:decimal ;
    chart:value "7"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-1241-1-2 a chart:DataPoint ;
    chart:series ex:series-1241-1 ;
    chart:xVal "2008" ;
    chart:yVal "12"^^xsd:decimal ;
    chart:value "12"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-1241-1-3 a chart:DataPoint ;
    chart:series ex:series-1241-1 ;
    chart:xVal "2009" ;
    chart:yVal "5"^^xsd:decimal ;
    chart:value "5"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-1241-1-4 a chart:DataPoint ;
    chart:series ex:series-1241-1 ;
    chart:xVal "2010" ;
    chart:yVal "2"^^xsd:decimal ;
    chart:value "2"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-1241-1-5 a chart:DataPoint ;
    chart:series ex:series-1241-1 ;
    chart:xVal "2011" ;
    chart:yVal "10"^^xsd:decimal ;
    chart:value "10"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-1241-1-6 a chart:DataPoint ;
    chart:series ex:series-1241-1 ;
    chart:xVal "2012" ;
    chart:yVal "65"^^xsd:decimal ;
    chart:value "65"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-1241-1-7 a chart:DataPoint ;
    chart:series ex:series-1241-1 ;
    chart:xVal "2013" ;
    chart:yVal "3"^^xsd:decimal ;
    chart:value "3"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-1241-1-8 a chart:DataPoint ;
    chart:series ex:series-1241-1 ;
    chart:xVal "2014" ;
    chart:yVal "3"^^xsd:decimal ;
    chart:value "3"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-1241-1-9 a chart:DataPoint ;
    chart:series ex:series-1241-1 ;
    chart:xVal "2015" ;
    chart:yVal "21"^^xsd:decimal ;
    chart:value "21"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-1241-1-10 a chart:DataPoint ;
    chart:series ex:series-1241-1 ;
    chart:xVal "2016" ;
