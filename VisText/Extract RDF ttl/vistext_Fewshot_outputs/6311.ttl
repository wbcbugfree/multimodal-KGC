@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-6311 a chart:Chart ;
    chart:chartType "bar" ;
    chart:xAxis ex:x-6311 ;
    chart:yAxis ex:y-6311 .

ex:x-6311 a chart:Axis ;
    chart:label "quarter" ;
    chart:scaleMin "" ;
    chart:scaleMax "" .

ex:y-6311 a chart:Axis ;
    chart:label "Component" ;
    chart:scaleMin "0.0" ;
    chart:scaleMax "0.2" .

ex:series-6311-1 a chart:Series .

ex:dp-6311-1-1 a chart:DataPoint ;
    chart:series ex:series-6311-1 ;
    chart:category "1Q '16" ;
    chart:value "0.14"^^xsd:decimal ;
    chart:valueEstimated "true" .

