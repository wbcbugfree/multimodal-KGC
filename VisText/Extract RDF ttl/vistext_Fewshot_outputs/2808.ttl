@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-2808 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Coronavirus (COVID-19) death rate in Italy as of December 29 , 2020 , by age group" ;
    chart:xAxis ex:x-2808 ;
    chart:yAxis ex:y-2808 .

ex:x-2808 a chart:Axis ;
    chart:label "Mortality rate" ;
    chart:scaleMin "0.00" ;
    chart:scaleMax "0.25" .

ex:y-2808 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "" ;
    chart:scaleMax "" .

ex:series-2808-1 a chart:Series .

ex:dp-2808-1-1 a chart:DataPoint ;
    chart:series ex:series-2808-1 ;
    chart:category "0-9 years" ;
    chart:value "0.00"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-2808-1-2 a chart:DataPoint ;
    chart:series ex:series-2808-1 ;
    chart:category "10-19 years" ;
    chart:value "0.00"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-2808-1-3 a chart:DataPoint ;
    chart:series ex:series-2808-1 ;
    chart:category "20-29 years" ;
    chart:value "0.00"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-2808-1-4 a chart:DataPoint ;
    chart:series ex:series-2808-1 ;
    chart:category "30-39 years" ;
    chart:value "0.00"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-2808-1-5 a chart:DataPoint ;
    chart:series ex:series-2808-1 ;
    chart:category "40-49 years" ;
    chart:value "0.00"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-2808-1-6 a chart:DataPoint ;
    chart:series ex:series-2808-1 ;
    chart:category "50-59 years" ;
    chart:value "0.00"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-2808-1-7 a chart:DataPoint ;
    chart:series ex:series-2808-1 ;
    chart:category "60-69 years" ;
    chart:value "0.01"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-2808-1-8 a chart:DataPoint ;
    chart:series ex:series-2808-1 ;
    chart:category "70-79 years" ;
    chart:value "0.03"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-2808-1-9 a chart:DataPoint ;
    chart:series ex:series-2808-1 ;
    chart:category "80-89 years" ;
    chart:value "0.11"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-2808-1-10 a chart:DataPoint ;
    chart:series ex:series-2808-1 ;
    chart:category "90 years and older" ;
    chart:value "0.24"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-2808-1-11 a chart:DataPoint ;
    chart:series ex:series-2808-1 ;
    chart:category "Total" ;
    chart:value "0.04"^^xsd:decimal ;
    chart:valueEstimated "true" .
