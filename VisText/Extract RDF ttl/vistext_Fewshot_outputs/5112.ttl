@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-5112 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Earthquakes of magnitude 3.6 and over in Italy between January and May 2020 , by magnitude" ;
    chart:xAxis ex:x-5112 ;
    chart:yAxis ex:y-5112 .

ex:x-5112 a chart:Axis ;
    chart:label "Magnitude" ;
    chart:scaleMin "0" ;
    chart:scaleMax "4" .

ex:y-5112 a chart:Axis ;
    chart:label "region of Italy" .

ex:series-5112-1 a chart:Series .

