@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-845 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Leading countries in primary energy consumption worldwide in 2019 (in exajoules)" ;
    chart:xAxis ex:x-845 ;
    chart:yAxis ex:y-845 .

ex:x-845 a chart:Axis ;
    chart:label "Country" ;
    chart:scaleMin "" ;
    chart:scaleMax "" .

ex:y-845 a chart:Axis ;
    chart:label "Consumption in exajoules" ;
    chart:scaleMin "0" ;
    chart:scaleMax "150" .

ex:series-845-1 a chart:Series .

ex:dp-845-1-1 a chart:DataPoint ;
    chart:series ex:series-845-1 ;
    chart:category "Australia" ;
    chart:value "10"^^xsd:decimal ;
    chart:valueEstimated "true" .

