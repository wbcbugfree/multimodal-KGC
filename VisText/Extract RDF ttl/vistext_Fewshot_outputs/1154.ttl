@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-1154 a chart:Chart ;
    chart:chartType "area" ;
    chart:title "Operating revenue of Endeavor Air from 2004 to 2019 (in million U.S. dollars)" ;
    chart:xAxis ex:x-1154 ;
    chart:yAxis ex:y-1154 .

ex:x-1154 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2004" ;
    chart:scaleMax "2019" .

ex:y-1154 a chart:Axis ;
    chart:label "Revenue in million U.S. dollars" ;
    chart:scaleMin "0" ;
    chart:scaleMax "900" .

ex:series-1154-1 a chart:Series .

ex:dp-1154-1-1 a chart:DataPoint ;
    chart:series ex:series-1154-1 ;
    chart:xVal "2004" ;
    chart:yVal "820"^^xsd:decimal ;
    chart:valueEstimated "true" .

