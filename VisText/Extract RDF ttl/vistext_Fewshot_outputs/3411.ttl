@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-3411 a chart:Chart ;
    chart:chartType "area" ;
    chart:title "Number of people receiving unemployment benefits in Great Britain from 2000 to 2019 (in 1,000s)" ;
    chart:xAxis ex:x-3411 ;
    chart:yAxis ex:y-3411 .

ex:x-3411 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2000" ;
    chart:scaleMax "2019" .

ex:y-3411 a chart:Axis ;
    chart:label "Claimants in thousands" ;
    chart:scaleMin "0" ;
    chart:scaleMax "1500" .

ex:series-3411-1 a chart:Series .

ex:dp-3411-1-1 a chart:DataPoint ;
    chart:series ex:series-3411-1 ;
    chart:xVal "2000" ;
    chart:yVal "1000"^^xsd:decimal ;
    chart:valueEstimated "true" .

