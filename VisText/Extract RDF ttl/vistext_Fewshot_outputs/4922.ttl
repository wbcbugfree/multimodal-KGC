@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-4922 a chart:Chart ;
    chart:chartType "area" ;
    chart:title "Active Duty U.S. Air Force personnel numbers from 1995 to 2019" ;
    chart:xAxis ex:x-4922 ;
    chart:yAxis ex:y-4922 .

ex:x-4922 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "1995" ;
    chart:scaleMax "2015" .

ex:y-4922 a chart:Axis ;
    chart:label "Number of Air Force personnel" ;
    chart:scaleMin "0" ;
    chart:scaleMax "400,000" .

ex:series-4922-1 a chart:Series .

ex:dp-4922-1-1 a chart:DataPoint ;
    chart:series ex:series-4922-1 ;
    chart:xVal "1995" ;
    chart:yVal "410000"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-4922-1-2 a chart:DataPoint ;
    chart:series ex:series-4922-1 ;
    chart:xVal "2000" ;
    chart:yVal "390000"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-4922-1-3 a chart:DataPoint ;
    chart:series ex:series-4922-1 ;
    chart:xVal "2005" ;
    chart:yVal "370000"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-4922-1-4 a chart:DataPoint ;
    chart:series ex:series-4922-1 ;
    chart:xVal "2010" ;
    chart:yVal "350000"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-4922-1-5 a chart:DataPoint ;
    chart:series ex:series-4922-1 ;
    chart:xVal "2015" ;
    chart:yVal "360000"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-4922-1-6 a chart:DataPoint ;
    chart:series ex:series-4922-1 ;
    chart:xVal "2019" ;
    chart:yVal "340000"^^xsd:decimal ;
    chart:valueEstimated "true" .
