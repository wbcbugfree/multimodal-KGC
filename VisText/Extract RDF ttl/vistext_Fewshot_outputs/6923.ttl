@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-6923 a chart:Chart ;
    chart:chartType "area" ;
    chart:title "Bangladesh : Share of economic sectors in the gross domestic product (GDP) from 2009 to 2019" ;
    chart:xAxis ex:x-6923 ;
    chart:yAxis ex:y-6923 .

ex:x-6923 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2009" ;
    chart:scaleMax "2019" .

ex:y-6923 a chart:Axis ;
    chart:label "Agriculture" ;
    chart:scaleMin "0.00" ;
    chart:scaleMax "0.18" .

ex:series-6923-1 a chart:Series .

ex:dp-6923-1-1 a chart:DataPoint ;
    chart:series ex:series-6923-1 ;
    chart:xVal "2009" ;
    chart:yVal "0.165"^^xsd:decimal ;
    chart:value "0.165"^^xsd:decimal ;
    chart:valueEstimated "true" .

