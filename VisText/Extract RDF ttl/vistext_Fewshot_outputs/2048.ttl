@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-2048 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Leading life insurance companies ranked by total gross premium income in Ireland in 2018 (in 1,000 euros)" ;
    chart:xAxis ex:x-2048 ;
    chart:yAxis ex:y-2048 .

ex:x-2048 a chart:Axis ;
    chart:label "Gross premium income in thousand euros" ;
    chart:scaleMin "0" ;
    chart:scaleMax "4000000" .

ex:y-2048 a chart:Axis ;
    chart:label "Life Insurance Company" ;
    chart:scaleMin "" ;
    chart:scaleMax "" .

ex:series-2048-1 a chart:Series .

ex:dp-2048-1-1 a chart:DataPoint ;
    chart:series ex:series-2048-1 ;
    chart:category "Acorn Life" ;
    chart:value "100000"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-2048-1-2 a chart:DataPoint ;
    chart:series ex:series-2048-1 ;
    chart:category "Ark Life" ;
    chart:value "50000"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-2048-1-3 a chart:DataPoint ;
    chart:series ex:series-2048-1 ;
    chart:category "Aviva Life & Pensions" ;
    chart:value "300000"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-2048-1-4 a chart:DataPoint ;
    chart:series ex:series-2048-1 ;
    chart:category "Friends First Life" ;
    chart:value "250000"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-2048-1-5 a chart:DataPoint ;
    chart:series ex:series-2048-1 ;
    chart:category "Irish Life" ;
    chart:value "4500000"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-2048-1-6 a chart:DataPoint ;
    chart:series ex:series-2048-1 ;
    chart:category "London General Life" ;
    chart:value "100000"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-2048-1-7 a chart:DataPoint ;
    chart:series ex:series-2048-1 ;
    chart:category "New Ireland" ;
    chart:value "2500000"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-2048-1-8 a chart:DataPoint ;
    chart:series ex:series-2048-1 ;
    chart:category "Royal London*" ;
    chart:value "100000"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-2048-1-9 a chart:DataPoint ;
    chart:series ex:series-2048-1 ;
    chart:category "Standard Life" ;
    chart:value "300000"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-2048-1-10 a chart:DataPoint ;
    chart:series ex:series-2048-1 ;
    chart:category "Zurich Life" ;
    chart:value "4000000"^^xsd:decimal ;
    chart:valueEstimated "true" .
