@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-6709 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Average retail price for peanut butter in Canada from January 2015 to June 2020 (in Canadian dollars per 500 grams)" ;
    chart:xAxis ex:x-6709 ;
    chart:yAxis ex:y-6709 .

ex:x-6709 a chart:Axis ;
    chart:label "Month" ;
    chart:scaleMin "" ;
    chart:scaleMax "" .

ex:y-6709 a chart:Axis ;
    chart:label "2016" ;
    chart:scaleMin "0" ;
    chart:scaleMax "4" .

ex:series-6709-1 a chart:Series .

ex:dp-6709-1-1 a chart:DataPoint ;
    chart:series ex:series-6709-1 ;
    chart:category "Apr" ;
    chart:value "3.5"^^xsd:decimal ;
    chart:valueEstimated "true" .

