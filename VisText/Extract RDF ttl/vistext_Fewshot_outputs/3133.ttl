@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-3133 a chart:Chart ;
    chart:chartType "bar" ;
    chart:xAxis ex:x-3133 ;
    chart:yAxis ex:y-3133 .

ex:x-3133 a chart:Axis ;
    chart:label "Share of deceased COVID-19 patients" ;
    chart:scaleMin "0.0" ;
    chart:scaleMax "0.6" .

ex:y-3133 a chart:Axis ;
    chart:label "Response" .

ex:series-3133-1 a chart:Series .

ex:dp-3133-1-1 a chart:DataPoint ;
    chart:series ex:series-3133-1 ;
    chart:category "Active cancer in the last 5 ..." ;
    chart:value "0.28"^^xsd:decimal ;
    chart:valueEstimated "true" .

