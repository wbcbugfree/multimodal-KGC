@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-8296 a chart:Chart ;
    chart:chartType "area" ;
    chart:title "Number of Facebook fans/twitter followers of the Houston Texans (NFL) from 2012 to 2020 (in millions)" ;
    chart:xAxis ex:x-8296 ;
    chart:yAxis ex:y-8296 .

ex:x-8296 a chart:Axis ;
    chart:label "Month" ;
    chart:scaleMin "2012" ;
    chart:scaleMax "2020" .

ex:y-8296 a chart:Axis ;
    chart:label "Twitter followers" ;
    chart:scaleMin "0.0" ;
    chart:scaleMax "2.0" .

ex:series-8296-1 a chart:Series .

ex:dp-8296-1-1 a chart:DataPoint ;
    chart:series ex:series-8296-1 ;
    chart:xVal "2012" ;
    chart:yVal "0.15"^^xsd:decimal ;
    chart:value "0.15"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-8296-1-2 a chart:DataPoint ;
    chart:series ex:series-8296-1 ;
    chart:xVal "2013" ;
    chart:yVal "0.25"^^xsd:decimal ;
    chart:value "0.25"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-8296-1-3 a chart:DataPoint ;
    chart:series ex:series-8296-1 ;
    chart:xVal "2014" ;
    chart:yVal "0.4"^^xsd:decimal ;
    chart:value "0.4"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-8296-1-4 a chart:DataPoint ;
    chart:series ex:series-8296-1 ;
    chart:xVal "2015" ;
    chart:yVal "0.65"^^xsd:decimal ;
    chart:value "0.65"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-8296-1-5 a chart:DataPoint ;
    chart:series ex:series-8296-1 ;
    chart:xVal "2016" ;
    chart:yVal "1.0"^^xsd:decimal ;
    chart:value "1.0"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-8296-1-6 a chart:DataPoint ;
    chart:series ex:series-8296-1 ;
    chart:xVal "2017" ;
    chart:yVal "1.3"^^xsd:decimal ;
    chart:value "1.3"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-8296-1-7 a chart:DataPoint ;
    chart:series ex:series-8296-1 ;
    chart:xVal "2018" ;
    chart:yVal "1.8"^^xsd:decimal ;
    chart:value "1.8"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-8296-1-8 a chart:DataPoint ;
    chart:series ex:series-8296-1 ;
    chart:xVal "2019" ;
    chart:yVal "1.95"^^xsd:decimal ;
    chart:value "1.95"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-8296-1-9 a chart:DataPoint ;
    chart:series ex:series-8296-1 ;
    chart:xVal "2020" ;
    chart:yVal "2.0"^^xsd:decimal ;
    chart:value "2.0"^^xsd:decimal ;
    chart:valueEstimated "true" .
