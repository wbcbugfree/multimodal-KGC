@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-5866 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Leading producers of fresh vegetables worldwide in 2018 (in million metric tons)" ;
    chart:xAxis ex:x-5866 ;
    chart:yAxis ex:y-5866 .

ex:x-5866 a chart:Axis ;
    chart:label "Production in million metric tons" ;
    chart:scaleMin "0" ;
    chart:scaleMax "500" .

ex:y-5866 a chart:Axis ;
    chart:label "" .

ex:series-5866-1 a chart:Series .

ex:dp-5866-1-1 a chart:DataPoint ;
    chart:series ex:series-5866-1 ;
    chart:category "China, Country" ;
    chart:value "510"^^xsd:decimal ;
    chart:valueEstimated "true" .

