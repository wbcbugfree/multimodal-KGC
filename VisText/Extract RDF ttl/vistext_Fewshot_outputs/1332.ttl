@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-1332 a chart:Chart ;
    chart:chartType "area" ;
    chart:title "Per capita real Gross Domestic Product of Wisconsin from 2000 to 2019 (in chained 2012 U.S. dollars)" ;
    chart:xAxis ex:x-1332 ;
    chart:yAxis ex:y-1332 .

ex:x-1332 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2000" ;
    chart:scaleMax "2019" .

ex:y-1332 a chart:Axis ;
    chart:label "Per capita real GDP in chained 2012 U.S. dollars" ;
    chart:scaleMin "0" ;
    chart:scaleMax "50000" .

ex:series-1332-1 a chart:Series .

ex:dp-1332-1-1 a chart:DataPoint ;
    chart:series ex:series-1332-1 ;
    chart:xVal "2000" ;
    chart:yVal "42000"^^xsd:decimal ;
    chart:value "42000"^^xsd:decimal ;
    chart:valueEstimated "true" .

