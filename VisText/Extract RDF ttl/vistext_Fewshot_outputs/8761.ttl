@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-8761 a chart:Chart ;
    chart:chartType "area" ;
    chart:title "Total net electricity generation in the United States from 1990 to 2019 , by fuel (in billion kilowatt hours)" ;
    chart:xAxis ex:x-8761 ;
    chart:yAxis ex:y-8761 .

ex:x-8761 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "1990" ;
    chart:scaleMax "2015" .

ex:y-8761 a chart:Axis ;
    chart:label "Hydroelectric pumped storage" ;
    chart:scaleMin "-7" ;
    chart:scaleMax "0" .

ex:series-8761-1 a chart:Series .

ex:dp-8761-1-1 a chart:DataPoint ;
    chart:series ex:series-8761-1 ;
    chart:xVal "1990" ;
    chart:yVal "-3.5"^^xsd:decimal ;
    chart:value "-3.5"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-8761-1-2 a chart:DataPoint ;
    chart:series ex:series-8761-1 ;
    chart:xVal "1995" ;
    chart:yVal "-3.0"^^xsd:decimal ;
    chart:value "-3.0"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-8761-1-3 a chart:DataPoint ;
    chart:series ex:series-8761-1 ;
    chart:xVal "2000" ;
    chart:yVal "-6.0"^^xsd:decimal ;
    chart:value "-6.0"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-8761-1-4 a chart:DataPoint ;
    chart:series ex:series-8761-1 ;
    chart:xVal "2005" ;
    chart:yVal "-7.0"^^xsd:decimal ;
    chart:value "-7.0"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-8761-1-5 a chart:DataPoint ;
    chart:series ex:series-8761-1 ;
    chart:xVal "2010" ;
    chart:yVal "-5.5"^^xsd:decimal ;
    chart:value "-5.5"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-8761-1-6 a chart:DataPoint ;
    chart:series ex:series-8761-1 ;
    chart:xVal "2015" ;
    chart:yVal "-6.5"^^xsd:decimal ;
    chart:value "-6.5"^^xsd:decimal ;
    chart:valueEstimated "true" .
