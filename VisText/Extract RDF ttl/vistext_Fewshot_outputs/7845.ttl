@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-7845 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Number of McColl 's stores in the United Kingdom (UK) as of 2019 , by type and region" ;
    chart:xAxis ex:x-7845 ;
    chart:yAxis ex:y-7845 .

ex:x-7845 a chart:Axis ;
    chart:label "Newsagent" ;
    chart:scaleMin "0" ;
    chart:scaleMax "60" .

ex:y-7845 a chart:Axis ;
    chart:label "region of the United Kingdom" .

ex:series-7845-1 a chart:Series .

ex:dp-7845-1-1 a chart:DataPoint ;
    chart:series ex:series-7845-1 ;
    chart:category "East Midlands" ;
    chart:value "10"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-7845-1-2 a chart:DataPoint ;
    chart:series ex:series-7845-1 ;
    chart:category "East of England" ;
    chart:value "58"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-7845-1-3 a chart:DataPoint ;
    chart:series ex:series-7845-1 ;
    chart:category "London" ;
    chart:value "5"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-7845-1-4 a chart:DataPoint ;
    chart:series ex:series-7845-1 ;
    chart:category "North East" ;
    chart:value "15"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-7845-1-5 a chart:DataPoint ;
    chart:series ex:series-7845-1 ;
    chart:category "North West" ;
    chart:value "22"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-7845-1-6 a chart:DataPoint ;
    chart:series ex:series-7845-1 ;
    chart:category "Scotland" ;
    chart:value "28"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-7845-1-7 a chart:DataPoint ;
    chart:series ex:series-7845-1 ;
    chart:category "South East" ;
    chart:value "42"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-7845-1-8 a chart:DataPoint ;
    chart:series ex:series-7845-1 ;
    chart:category "South West" ;
    chart:value "24"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-7845-1-9 a chart:DataPoint ;
    chart:series ex:series-7845-1 ;
    chart:category "Wales" ;
    chart:value "7"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-7845-1-10 a chart:DataPoint ;
    chart:series ex:series-7845-1 ;
    chart:category "West Midlands" ;
    chart:value "29"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-7845-1-11 a chart:DataPoint ;
    chart:series ex:series-7845-1 ;
    chart:category "Yorkshire and the Humber" ;
    chart:value "15"^^xsd:decimal ;
    chart:valueEstimated "true" .
