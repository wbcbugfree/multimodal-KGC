@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-3912 a chart:Chart ;
    chart:chartType "line" ;
    chart:title "Annual volume of carbon dioxide (CO2) emissions from transport sector 's energy consumption in Taiwan from 2006 to 2017 (in million metric tons)" ;
    chart:xAxis ex:x-3912 ;
    chart:yAxis ex:y-3912 .

ex:x-3912 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2006" ;
    chart:scaleMax "2017" .

ex:y-3912 a chart:Axis ;
    chart:label "Emission volume in million metric tons" ;
    chart:scaleMin "0" ;
    chart:scaleMax "40" .

ex:series-3912-1 a chart:Series .

ex:dp-3912-1-1 a chart:DataPoint ;
    chart:series ex:series-3912-1 ;
    chart:xVal "2006" ;
    chart:yVal "37.0"^^xsd:decimal ;
    chart:value "37.0"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-3912-1-2 a chart:DataPoint ;
    chart:series ex:series-3912-1 ;
    chart:xVal "2007" ;
    chart:yVal "35.5"^^xsd:decimal ;
    chart:value "35.5"^^xsd:decimal ;
    chart:valueEstimated "true" .

