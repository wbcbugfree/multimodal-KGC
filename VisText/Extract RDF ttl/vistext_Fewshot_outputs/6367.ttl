@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-6367 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Monthly export value of canola in Canada from 2015 to 2020 (in million Canadian dollars)" ;
    chart:xAxis ex:x-6367 ;
    chart:yAxis ex:y-6367 .

ex:x-6367 a chart:Axis ;
    chart:label "Month" ;
    chart:scaleMin "" ;
    chart:scaleMax "" .

ex:y-6367 a chart:Axis ;
    chart:label "" ;
    chart:scaleMin "0" ;
    chart:scaleMax "500" .

ex:series-6367-1 a chart:Series .

ex:dp-6367-1-1 a chart:DataPoint ;
    chart:series ex:series-6367-1 ;
    chart:category "Apr" ;
    chart:value "470"^^xsd:decimal ;
    chart:valueEstimated "true" .

