@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-3152 a chart:Chart ;
    chart:chartType "line" ;
    chart:title "Number of PwC employees worldwide from 2010 to 2020" ;
    chart:xAxis ex:x-3152 ;
    chart:yAxis ex:y-3152 .

ex:x-3152 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2010" ;
    chart:scaleMax "2020" .

ex:y-3152 a chart:Axis ;
    chart:label "Number of employees" ;
    chart:scaleMin "0" ;
    chart:scaleMax "300000" .

ex:series-3152-1 a chart:Series .

ex:dp-3152-1-1 a chart:DataPoint ;
    chart:series ex:series-3152-1 ;
    chart:xVal "2010" ;
    chart:yVal "160000"^^xsd:decimal ;
    chart:value "160000"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-3152-1-2 a chart:DataPoint ;
    chart:series ex:series-3152-1 ;
    chart:xVal "2011" ;
    chart:yVal "165000"^^xsd:decimal ;
    chart:value "165000"^^xsd:decimal ;
    chart:valueEstimated "true" .

