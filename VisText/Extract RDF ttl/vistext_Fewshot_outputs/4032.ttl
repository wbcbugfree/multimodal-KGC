@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-4032 a chart:Chart ;
    chart:chartType "line" ;
    chart:title "Number of foreign prisoners in custody in Italy from 2000 to 2020" ;
    chart:xAxis ex:x-4032 ;
    chart:yAxis ex:y-4032 .

ex:x-4032 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2000" ;
    chart:scaleMax "2020" .

ex:y-4032 a chart:Axis ;
    chart:label "Number of prisoners" ;
    chart:scaleMin "0" ;
    chart:scaleMax "25000" .

ex:series-4032-1 a chart:Series .

ex:dp-4032-1-1 a chart:DataPoint ;
    chart:series ex:series-4032-1 ;
    chart:xVal "2000" ;
    chart:yVal "17500"^^xsd:decimal ;
    chart:value "17500"^^xsd:decimal ;
    chart:valueEstimated "true" .

