@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-7112 a chart:Chart ;
    chart:chartType "line" ;
    chart:title "Puerto Rico : Distribution of gross domestic product (GDP) across economic sectors from 2008 to 2018" ;
    chart:xAxis ex:x-7112 ;
    chart:yAxis ex:y-7112 .

ex:x-7112 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2008" ;
    chart:scaleMax "2018" .

ex:y-7112 a chart:Axis ;
    chart:label "Industry" ;
    chart:scaleMin "0.0" ;
    chart:scaleMax "0.6" .

ex:series-7112-1 a chart:Series .

ex:dp-7112-1-1 a chart:DataPoint ;
    chart:series ex:series-7112-1 ;
    chart:xVal "2008" ;
    chart:yVal "0.48"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-7112-1-2 a chart:DataPoint ;
    chart:series ex:series-7112-1 ;
    chart:xVal "2009" ;
    chart:yVal "0.51"^^xsd:decimal ;
    chart:valueEstimated "true" .

