@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-7695 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "K-12 public school enrollment numbers in the United States from 2000 to 2017 , by ethnicity (in 1,000s)" ;
    chart:xAxis ex:x-7695 ;
    chart:yAxis ex:y-7695 .

ex:x-7695 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2000" ;
    chart:scaleMax "2017" .

ex:y-7695 a chart:Axis ;
    chart:label "Black" ;
    chart:scaleMin "0" ;
    chart:scaleMax "9000" .

ex:series-7695-1 a chart:Series .

ex:dp-7695-1-1 a chart:DataPoint ;
    chart:series ex:series-7695-1 ;
    chart:category "2000" ;
    chart:value "8300"^^xsd:decimal ;
    chart:valueEstimated "true" .

