@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-5351 a chart:Chart ;
    chart:chartType "line" ;
    chart:title "Number of families with a single father in the U.S. from 1990 to 2019 (in 1,000s)" ;
    chart:xAxis ex:x-5351 ;
    chart:yAxis ex:y-5351 .

ex:x-5351 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "1990" ;
    chart:scaleMax "2019" .

ex:y-5351 a chart:Axis ;
    chart:label "Number of families in thousands" ;
    chart:scaleMin "0" ;
    chart:scaleMax "7000" .

ex:series-5351-1 a chart:Series .

ex:dp-5351-1-1 a chart:DataPoint ;
    chart:series ex:series-5351-1 ;
    chart:xVal "1990" ;
    chart:yVal "3200"^^xsd:decimal ;
    chart:value "3200"^^xsd:decimal ;
    chart:valueEstimated "true" .

