@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-935 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Argentina : Fertility rate from 2008 to 2018" ;
    chart:xAxis ex:x-935 ;
    chart:yAxis ex:y-935 .

ex:x-935 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2008" ;
    chart:scaleMax "2018" .

ex:y-935 a chart:Axis ;
    chart:label "Number of children born per woman" ;
    chart:scaleMin "0.0" ;
    chart:scaleMax "2.5" .

ex:series-935-1 a chart:Series .

ex:dp-935-1-1 a chart:DataPoint ;
    chart:series ex:series-935-1 ;
    chart:category "2008" ;
    chart:value "2.2"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-935-1-2 a chart:DataPoint ;
    chart:series ex:series-935-1 ;
    chart:category "2010" ;
    chart:value "2.15"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-935-1-3 a chart:DataPoint ;
    chart:series ex:series-935-1 ;
    chart:category "2012" ;
    chart:value "2.1"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-935-1-4 a chart:DataPoint ;
    chart:series ex:series-935-1 ;
    chart:category "2014" ;
    chart:value "2.05"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-935-1-5 a chart:DataPoint ;
    chart:series ex:series-935-1 ;
    chart:category "2016" ;
    chart:value "2.0"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-935-1-6 a chart:DataPoint ;
    chart:series ex:series-935-1 ;
    chart:category "2018" ;
    chart:value "1.95"^^xsd:decimal ;
    chart:valueEstimated "true" .
