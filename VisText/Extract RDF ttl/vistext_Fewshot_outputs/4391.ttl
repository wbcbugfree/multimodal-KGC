@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-4391 a chart:Chart ;
    chart:chartType "line" ;
    chart:title "Birth rate in the United States from 1990 to 2018 (per 1,000 of population)" ;
    chart:xAxis ex:x-4391 ;
    chart:yAxis ex:y-4391 .

ex:x-4391 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "1990" ;
    chart:scaleMax "2018" .

ex:y-4391 a chart:Axis ;
    chart:label "Birth rate per 1,000 of population" ;
    chart:scaleMin "0" ;
    chart:scaleMax "20" .

ex:series-4391-1 a chart:Series .

ex:dp-4391-1-1 a chart:DataPoint ;
    chart:series ex:series-4391-1 ;
    chart:xVal "1990" ;
    chart:yVal "16.7"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-4391-1-2 a chart:DataPoint ;
    chart:series ex:series-4391-1 ;
    chart:xVal "1995" ;
    chart:yVal "15.7"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-4391-1-3 a chart:DataPoint ;
    chart:series ex:series-4391-1 ;
    chart:xVal "2000" ;
    chart:yVal "14.7"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-4391-1-4 a chart:DataPoint ;
    chart:series ex:series-4391-1 ;
    chart:xVal "2005" ;
    chart:yVal "14.0"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-4391-1-5 a chart:DataPoint ;
    chart:series ex:series-4391-1 ;
    chart:xVal "2010" ;
    chart:yVal "13.2"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-4391-1-6 a chart:DataPoint ;
    chart:series ex:series-4391-1 ;
    chart:xVal "2015" ;
    chart:yVal "12.4"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-4391-1-7 a chart:DataPoint ;
    chart:series ex:series-4391-1 ;
    chart:xVal "2018" ;
    chart:yVal "11.8"^^xsd:decimal ;
    chart:valueEstimated "true" .
