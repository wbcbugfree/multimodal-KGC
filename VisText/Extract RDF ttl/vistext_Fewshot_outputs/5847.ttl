@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-5847 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Average undergraduate tuition fees for Canadian citizens in Canada from 2006 to 2020 (in Canadian dollars)" ;
    chart:xAxis ex:x-5847 ;
    chart:yAxis ex:y-5847 .

ex:x-5847 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2006 / 2007" ;
    chart:scaleMax "2020 / 2021*" .

ex:y-5847 a chart:Axis ;
    chart:label "Tuition in Canadian dollars" ;
    chart:scaleMin "0" ;
    chart:scaleMax "7000" .

ex:series-5847-1 a chart:Series .

ex:dp-5847-1-1 a chart:DataPoint ;
    chart:series ex:series-5847-1 ;
    chart:category "2006 / 2007" ;
    chart:value "4300"^^xsd:decimal ;
    chart:valueEstimated "true" .

