@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-7978 a chart:Chart ;
    chart:chartType "area" ;
    chart:title "Distribution of postsecondary enrollment in the United States from 1980 to 2018 , by race" ;
    chart:xAxis ex:x-7978 ;
    chart:yAxis ex:y-7978 .

ex:x-7978 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "1980" ;
    chart:scaleMax "2010" .

ex:y-7978 a chart:Axis ;
    chart:label "" ;
    chart:scaleMin "0.000" ;
    chart:scaleMax "0.010" .

ex:series-7978-1 a chart:Series ;
    chart:seriesName "American Indian / Alaska Native" .

ex:dp-7978-1-1 a chart:DataPoint ;
    chart:series ex:series-7978-1 ;
    chart:xVal "1980" ;
    chart:yVal "0.0068"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-7978-1-2 a chart:DataPoint ;
    chart:series ex:series-7978-1 ;
    chart:xVal "1990" ;
    chart:yVal "0.0078"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-7978-1-3 a chart:DataPoint ;
    chart:series ex:series-7978-1 ;
    chart:xVal "2000" ;
    chart:yVal "0.0095"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-7978-1-4 a chart:DataPoint ;
    chart:series ex:series-7978-1 ;
    chart:xVal "2010" ;
    chart:yVal "0.0075"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-7978-1-5 a chart:DataPoint ;
    chart:series ex:series-7978-1 ;
    chart:xVal "2018" ;
    chart:yVal "0.0070"^^xsd:decimal ;
    chart:valueEstimated "true" .
