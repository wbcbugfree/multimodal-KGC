@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-2656 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Number of arriving and departing local passengers in the leading French airports in 2016" ;
    chart:xAxis ex:x-2656 ;
    chart:yAxis ex:y-2656 .

ex:x-2656 a chart:Axis ;
    chart:label "Number of local passengers" ;
    chart:scaleMin "0" ;
    chart:scaleMax "60000000" .

ex:y-2656 a chart:Axis ;
    chart:label "airport" ;
    chart:scaleMin "" ;
    chart:scaleMax "" .

ex:series-2656-1 a chart:Series .

ex:dp-2656-1-1 a chart:DataPoint ;
    chart:series ex:series-2656-1 ;
    chart:category "Ajaccio-Napoléon-Bonaparte" ;
    chart:value "1000000"^^xsd:decimal ;
    chart:valueEstimated "true" .

