    chart:series ex:series-940-1 ;
    chart:category "Globalscope Partners" ;
    chart:value "22"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-940-1-5 a chart:DataPoint ;
    chart:series ex:series-940-1 ;
    chart:category "Goldman Sachs" ;
    chart:value "24"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-940-1-6 a chart:DataPoint ;
