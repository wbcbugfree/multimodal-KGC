ex:dp-940-1-7 a chart:DataPoint ;
    chart:series ex:series-940-1 ;
    chart:category "KPMG" ;
    chart:value "29"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-940-1-8 a chart:DataPoint ;
    chart:series ex:series-940-1 ;
    chart:category "Lincoln International" ;
    chart:value "28"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-940-1-9 a chart:DataPoint ;
