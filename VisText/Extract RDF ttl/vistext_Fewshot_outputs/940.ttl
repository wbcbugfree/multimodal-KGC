@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-940 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Leading financial advisors to German M & A in 2016 , by deal count" ;
    chart:xAxis ex:x-940 ;
    chart:yAxis ex:y-940 .

ex:x-940 a chart:Axis ;
    chart:label "M&A deal count" ;
    chart:scaleMin "0" ;
    chart:scaleMax "40" .

ex:y-940 a chart:Axis ;
    chart:label "Financial advisory firms" ;
    chart:scaleMin "" ;
    chart:scaleMax "" .

ex:series-940-1 a chart:Series .

ex:dp-940-1-1 a chart:DataPoint ;
    chart:series ex:series-940-1 ;
    chart:category "Deloitte" ;
    chart:value "26"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-940-1-2 a chart:DataPoint ;
    chart:series ex:series-940-1 ;
    chart:category "Deutsche Bank" ;
    chart:value "28"^^xsd:decimal ;
    chart:valueEstimated "true" .

