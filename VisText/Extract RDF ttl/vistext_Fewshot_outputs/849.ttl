@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-849 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Miami Marlins all-time home run leaders as of October 2020" ;
    chart:xAxis ex:x-849 ;
    chart:yAxis ex:y-849 .

ex:x-849 a chart:Axis ;
    chart:label "" ;
    chart:scaleMin "" ;
    chart:scaleMax "" .

ex:y-849 a chart:Axis ;
    chart:label "Number of home runs" ;
    chart:scaleMin "0" ;
    chart:scaleMax "250" .

ex:series-849-1 a chart:Series .

