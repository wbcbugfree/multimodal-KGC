@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-5286 a chart:Chart ;
    chart:chartType "area" ;
    chart:title "Market capitalization of the Puma Group worldwide from 1993 to 2019 (in million euros)" ;
    chart:xAxis ex:x-5286 ;
    chart:yAxis ex:y-5286 .

ex:x-5286 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "1993" ;
    chart:scaleMax "2019" .

ex:y-5286 a chart:Axis ;
    chart:label "Market capitalization in million euros" ;
    chart:scaleMin "0" ;
    chart:scaleMax "10000" .

ex:series-5286-1 a chart:Series .

ex:dp-5286-1-1 a chart:DataPoint ;
    chart:series ex:series-5286-1 ;
    chart:xVal "1993" ;
    chart:yVal "100"^^xsd:decimal ;
    chart:value "100"^^xsd:decimal ;
    chart:valueEstimated "true" .

