@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-4916 a chart:Chart ;
    chart:chartType "line" ;
    chart:title "Chicago Bears franchise value from 2002 to 2020 (in million U.S. dollars)" ;
    chart:xAxis ex:x-4916 ;
    chart:yAxis ex:y-4916 .

ex:x-4916 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2002" ;
    chart:scaleMax "2020" .

ex:y-4916 a chart:Axis ;
    chart:label "Franchise value in million U.S. dollars" ;
    chart:scaleMin "0" ;
    chart:scaleMax "4000" .

ex:series-4916-1 a chart:Series .

ex:dp-4916-1-1 a chart:DataPoint ;
    chart:series ex:series-4916-1 ;
    chart:xVal "2002" ;
    chart:yVal "400"^^xsd:decimal ;
    chart:value "400"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-4916-1-2 a chart:DataPoint ;
    chart:series ex:series-4916-1 ;
    chart:xVal "2005" ;
    chart:yVal "700"^^xsd:decimal ;
    chart:value "700"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-4916-1-3 a chart:DataPoint ;
    chart:series ex:series-4916-1 ;
    chart:xVal "2008" ;
    chart:yVal "1000"^^xsd:decimal ;
    chart:value "1000"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-4916-1-4 a chart:DataPoint ;
    chart:series ex:series-4916-1 ;
    chart:xVal "2011" ;
    chart:yVal "1100"^^xsd:decimal ;
    chart:value "1100"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-4916-1-5 a chart:DataPoint ;
    chart:series ex:series-4916-1 ;
    chart:xVal "2014" ;
    chart:yVal "1200"^^xsd:decimal ;
    chart:value "1200"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-4916-1-6 a chart:DataPoint ;
    chart:series ex:series-4916-1 ;
    chart:xVal "2017" ;
    chart:yVal "2500"^^xsd:decimal ;
    chart:value "2500"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-4916-1-7 a chart:DataPoint ;
    chart:series ex:series-4916-1 ;
    chart:xVal "2020" ;
    chart:yVal "3500"^^xsd:decimal ;
    chart:value "3500"^^xsd:decimal ;
    chart:valueEstimated "true" .
