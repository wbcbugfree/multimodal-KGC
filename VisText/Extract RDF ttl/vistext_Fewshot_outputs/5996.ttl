@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-5996 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Most expensive cities to drink a cold beer worldwide as of June 2016 , based on beer price index (in U.S. dollars)" ;
    chart:xAxis ex:x-5996 ;
    chart:yAxis ex:y-5996 .

ex:x-5996 a chart:Axis ;
    chart:label "Beer price in U.S. dollars" ;
    chart:scaleMin "0" ;
    chart:scaleMax "10" .

ex:y-5996 a chart:Axis ;
    chart:label "Country" .

ex:series-5996-1 a chart:Series .

ex:dp-5996-1-1 a chart:DataPoint ;
    chart:series ex:series-5996-1 ;
    chart:category "Abu Dhabi" ;
    chart:value "3.5"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-5996-1-2 a chart:DataPoint ;
    chart:series ex:series-5996-1 ;
    chart:category "Hong Kong" ;
    chart:value "3.8"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-5996-1-3 a chart:DataPoint ;
    chart:series ex:series-5996-1 ;
    chart:category "Lausanne" ;
    chart:value "8.0"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-5996-1-4 a chart:DataPoint ;
    chart:series ex:series-5996-1 ;
    chart:category "New York" ;
    chart:value "5.5"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-5996-1-5 a chart:DataPoint ;
    chart:series ex:series-5996-1 ;
    chart:category "Oslo" ;
    chart:value "5.5"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-5996-1-6 a chart:DataPoint ;
    chart:series ex:series-5996-1 ;
    chart:category "Paris" ;
    chart:value "5.0"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-5996-1-7 a chart:DataPoint ;
    chart:series ex:series-5996-1 ;
    chart:category "Singapore" ;
    chart:value "5.0"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-5996-1-8 a chart:DataPoint ;
    chart:series ex:series-5996-1 ;
    chart:category "Tel Aviv" ;
    chart:value "4.5"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-5996-1-9 a chart:DataPoint ;
    chart:series ex:series-5996-1 ;
    chart:category "Tokyo" ;
    chart:value "4.5"^^xsd:decimal ;
