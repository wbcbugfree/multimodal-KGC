@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-4844 a chart:Chart ;
    chart:chartType "bar" ;
    chart:xAxis ex:x-4844 ;
    chart:yAxis ex:y-4844 .

ex:x-4844 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2000*" ;
    chart:scaleMax "2014*" .

ex:y-4844 a chart:Axis ;
    chart:label "Number of scanners" ;
    chart:scaleMin "0" ;
    chart:scaleMax "400" .

ex:series-4844-1 a chart:Series .

ex:dp-4844-1-1 a chart:DataPoint ;
    chart:series ex:series-4844-1 ;
    chart:category "2000*" ;
    chart:value "350"^^xsd:decimal ;
    chart:valueEstimated "true" .

