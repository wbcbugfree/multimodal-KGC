@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-6081 a chart:Chart ;
    chart:chartType "line" ;
    chart:title "Number of Volkswagen shares from FY 2010 to FY 2019 , by type (in millions)" ;
    chart:xAxis ex:x-6081 ;
    chart:yAxis ex:y-6081 .

ex:x-6081 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2010" ;
    chart:scaleMax "2019" .

ex:y-6081 a chart:Axis ;
    chart:label "Ordinary shares" ;
    chart:scaleMin "0" ;
    chart:scaleMax "80" .

ex:series-6081-1 a chart:Series .

ex:dp-6081-1-1 a chart:DataPoint ;
    chart:series ex:series-6081-1 ;
    chart:xVal "2010" ;
    chart:yVal "78"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-6081-1-2 a chart:DataPoint ;
    chart:series ex:series-6081-1 ;
    chart:xVal "2011" ;
    chart:yVal "55"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-6081-1-3 a chart:DataPoint ;
    chart:series ex:series-6081-1 ;
    chart:xVal "2012" ;
    chart:yVal "28"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-6081-1-4 a chart:DataPoint ;
    chart:series ex:series-6081-1 ;
    chart:xVal "2013" ;
    chart:yVal "22"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-6081-1-5 a chart:DataPoint ;
    chart:series ex:series-6081-1 ;
    chart:xVal "2014" ;
    chart:yVal "20"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-6081-1-6 a chart:DataPoint ;
    chart:series ex:series-6081-1 ;
    chart:xVal "2015" ;
    chart:yVal "47"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-6081-1-7 a chart:DataPoint ;
    chart:series ex:series-6081-1 ;
    chart:xVal "2016" ;
    chart:yVal "27"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-6081-1-8 a chart:DataPoint ;
    chart:series ex:series-6081-1 ;
    chart:xVal "2017" ;
    chart:yVal "25"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-6081-1-9 a chart:DataPoint ;
    chart:series ex:series-6081-1 ;
    chart:xVal "2018" ;
    chart:yVal "30"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-6081-1-10 a chart:DataPoint ;
    chart:series ex:series-6081-1 ;
    chart:xVal "2019" ;
    chart:yVal "23"^^xsd:decimal ;
    chart:valueEstimated "true" .
