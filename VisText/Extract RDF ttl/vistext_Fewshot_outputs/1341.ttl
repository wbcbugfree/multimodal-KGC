    chart:series ex:series-1341-1 ;
    chart:xVal "2008" ;
    chart:yVal "0.96"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-1341-1-5 a chart:DataPoint ;
    chart:series ex:series-1341-1 ;
    chart:xVal "2009" ;
    chart:yVal "0.96"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-1341-1-6 a chart:DataPoint ;
