    chart:valueEstimated "true" .

ex:dp-1341-1-7 a chart:DataPoint ;
    chart:series ex:series-1341-1 ;
    chart:xVal "2011" ;
    chart:yVal "0.92"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-1341-1-8 a chart:DataPoint ;
    chart:series ex:series-1341-1 ;
    chart:xVal "2012" ;
    chart:yVal "0.87"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-1341-1-9 a chart:DataPoint ;
