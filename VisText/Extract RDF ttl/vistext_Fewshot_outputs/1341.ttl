@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-1341 a chart:Chart ;
    chart:chartType "line" ;
    chart:title "Female to male ratio in tertiary education in Vietnam from 2005 to 2016" ;
    chart:xAxis ex:x-1341 ;
    chart:yAxis ex:y-1341 .

ex:x-1341 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2005" ;
    chart:scaleMax "2016" .

ex:y-1341 a chart:Axis ;
    chart:label "Ratio in females per one male" ;
    chart:scaleMin "0.0" ;
    chart:scaleMax "1.2" .

ex:series-1341-1 a chart:Series .

ex:dp-1341-1-1 a chart:DataPoint ;
    chart:series ex:series-1341-1 ;
    chart:xVal "2005" ;
    chart:yVal "0.7"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-1341-1-2 a chart:DataPoint ;
    chart:series ex:series-1341-1 ;
    chart:xVal "2006" ;
    chart:yVal "0.93"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-1341-1-3 a chart:DataPoint ;
    chart:series ex:series-1341-1 ;
    chart:xVal "2007" ;
    chart:yVal "0.97"^^xsd:decimal ;
    chart:valueEstimated "true" .

