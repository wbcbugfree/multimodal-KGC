@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-1286 a chart:Chart ;
    chart:chartType "area" ;
    chart:title "Number of jobs in the travel and tourism sector in Cuba from 2010 to 2019 (in 1,000s)" ;
    chart:xAxis ex:x-1286 ;
    chart:yAxis ex:y-1286 .

ex:x-1286 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2010" ;
    chart:scaleMax "2019" .

ex:y-1286 a chart:Axis ;
    chart:label "Number of jobs in thousands" ;
    chart:scaleMin "0" ;
    chart:scaleMax "600" .

ex:series-1286-1 a chart:Series .

ex:dp-1286-1-1 a chart:DataPoint ;
    chart:series ex:series-1286-1 ;
    chart:xVal "2010" ;
    chart:yVal "510"^^xsd:decimal ;
    chart:value "510"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-1286-1-2 a chart:DataPoint ;
    chart:series ex:series-1286-1 ;
    chart:xVal "2011" ;
    chart:yVal "505"^^xsd:decimal ;
    chart:value "505"^^xsd:decimal ;
    chart:valueEstimated "true" .

