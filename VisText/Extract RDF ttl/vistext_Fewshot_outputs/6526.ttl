@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-6526 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Monthly sales of over-the-counter (OTC) drugs , vitamins , herbal remedies and other health supplements at large retailers in Canada from January 2015 to April 2019 (in million Canadian dollars)" ;
    chart:xAxis ex:x-6526 ;
    chart:yAxis ex:y-6526 .

ex:x-6526 a chart:Axis ;
    chart:label "Month" ;
    chart:scaleMin "" ;
    chart:scaleMax "" .

ex:y-6526 a chart:Axis ;
    chart:label "" ;
    chart:scaleMin "0" ;
    chart:scaleMax "200" .

ex:series-6526-1 a chart:Series .

ex:dp-6526-1-1 a chart:DataPoint ;
    chart:series ex:series-6526-1 ;
    chart:category "Apr" ;
    chart:value "158"^^xsd:decimal ;
    chart:valueEstimated "true" .

