@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-574 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Annual volume of cranberries and blueberries sold in the United Kingdom (UK) from 2008 to 2018 (in 1,000 tonnes)" ;
    chart:xAxis ex:x-574 ;
    chart:yAxis ex:y-574 .

ex:x-574 a chart:Axis ;
    chart:label "Sales volume in thousand tonnes" ;
    chart:scaleMin "0" ;
    chart:scaleMax "25" .

ex:y-574 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2008" ;
    chart:scaleMax "2018" .

ex:series-574-1 a chart:Series .

ex:dp-574-1-1 a chart:DataPoint ;
    chart:series ex:series-574-1 ;
    chart:category "2008" ;
    chart:value "4"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-574-1-2 a chart:DataPoint ;
    chart:series ex:series-574-1 ;
    chart:category "2009" ;
    chart:value "5"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-574-1-3 a chart:DataPoint ;
    chart:series ex:series-574-1 ;
    chart:category "2010" ;
    chart:value "7"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-574-1-4 a chart:DataPoint ;
    chart:series ex:series-574-1 ;
    chart:category "2011" ;
    chart:value "9"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-574-1-5 a chart:DataPoint ;
    chart:series ex:series-574-1 ;
    chart:category "2012" ;
    chart:value "11"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-574-1-6 a chart:DataPoint ;
    chart:series ex:series-574-1 ;
    chart:category "2013" ;
    chart:value "13"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-574-1-7 a chart:DataPoint ;
    chart:series ex:series-574-1 ;
    chart:category "2014*" ;
    chart:value "15"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-574-1-8 a chart:DataPoint ;
    chart:series ex:series-574-1 ;
    chart:category "2015*" ;
    chart:value "16"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-574-1-9 a chart:DataPoint ;
    chart:series ex:series-574-1 ;
    chart:category "2016*" ;
    chart:value "18"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-574-1-10 a chart:DataPoint ;
    chart:series ex:series-574-1 ;
    chart:category "2017*" ;
    chart:value "22"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-574-1-11 a chart:DataPoint ;
    chart:series ex:series-574-1 ;
    chart:category "2018*" ;
    chart:value "25"^^xsd:decimal ;
    chart:valueEstimated "true" .
