@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-240 a chart:Chart ;
    chart:chartType "line" ;
    chart:title "Budget expenditure of the central government in Norway from 2010 to 2020 (in billion NOK)" ;
    chart:xAxis ex:x-240 ;
    chart:yAxis ex:y-240 .

ex:x-240 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2010" ;
    chart:scaleMax "2020" .

ex:y-240 a chart:Axis ;
    chart:label "Expenditure in billion NOK" ;
    chart:scaleMin "0" ;
    chart:scaleMax "1500" .

ex:series-240-1 a chart:Series .

ex:dp-240-1-1 a chart:DataPoint ;
    chart:series ex:series-240-1 ;
    chart:xVal "2010" ;
    chart:yVal "850"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-240-1-2 a chart:DataPoint ;
    chart:series ex:series-240-1 ;
    chart:xVal "2011" ;
    chart:yVal "900"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-240-1-3 a chart:DataPoint ;
    chart:series ex:series-240-1 ;
    chart:xVal "2012" ;
    chart:yVal "950"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-240-1-4 a chart:DataPoint ;
    chart:series ex:series-240-1 ;
    chart:xVal "2013" ;
    chart:yVal "1000"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-240-1-5 a chart:DataPoint ;
    chart:series ex:series-240-1 ;
    chart:xVal "2014" ;
    chart:yVal "1050"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-240-1-6 a chart:DataPoint ;
    chart:series ex:series-240-1 ;
    chart:xVal "2015" ;
    chart:yVal "1100"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-240-1-7 a chart:DataPoint ;
    chart:series ex:series-240-1 ;
    chart:xVal "2016" ;
    chart:yVal "1150"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-240-1-8 a chart:DataPoint ;
    chart:series ex:series-240-1 ;
    chart:xVal "2017" ;
    chart:yVal "1200"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-240-1-9 a chart:DataPoint ;
    chart:series ex:series-240-1 ;
    chart:xVal "2018" ;
    chart:yVal "1250"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-240-1-10 a chart:DataPoint ;
    chart:series ex:series-240-1 ;
    chart:xVal "2019" ;
    chart:yVal "1300"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-240-1-11 a chart:DataPoint ;
    chart:series ex:series-240-1 ;
    chart:xVal "2020" ;
    chart:yVal "1350"^^xsd:decimal ;
    chart:valueEstimated "true" .
