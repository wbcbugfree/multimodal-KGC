@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-477 a chart:Chart ;
    chart:chartType "area" ;
    chart:title "Honduras : Urbanization from 2009 to 2019" ;
    chart:xAxis ex:x-477 ;
    chart:yAxis ex:y-477 .

ex:x-477 a chart:Axis ;
    chart:label "Response" ;
    chart:scaleMin "2010" ;
    chart:scaleMax "2018" .

ex:y-477 a chart:Axis ;
    chart:label "Share of urban population in total population" ;
    chart:scaleMin "0.0" ;
    chart:scaleMax "0.6" .

ex:series-477-1 a chart:Series .

ex:dp-477-1-1 a chart:DataPoint ;
    chart:series ex:series-477-1 ;
    chart:xVal "2010" ;
    chart:yVal "0.505"^^xsd:decimal ;
    chart:value "0.505"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-477-1-2 a chart:DataPoint ;
    chart:series ex:series-477-1 ;
    chart:xVal "2012" ;
    chart:yVal "0.515"^^xsd:decimal ;
    chart:value "0.515"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-477-1-3 a chart:DataPoint ;
    chart:series ex:series-477-1 ;
    chart:xVal "2014" ;
    chart:yVal "0.525"^^xsd:decimal ;
    chart:value "0.525"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-477-1-4 a chart:DataPoint ;
    chart:series ex:series-477-1 ;
    chart:xVal "2016" ;
    chart:yVal "0.535"^^xsd:decimal ;
    chart:value "0.535"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-477-1-5 a chart:DataPoint ;
    chart:series ex:series-477-1 ;
    chart:xVal "2018" ;
    chart:yVal "0.545"^^xsd:decimal ;
    chart:value "0.545"^^xsd:decimal ;
    chart:valueEstimated "true" .
