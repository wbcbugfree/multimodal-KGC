@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-7621 a chart:Chart ;
    chart:chartType "line" ;
    chart:title "Philippines : Distribution of employment by economic sector from 2010 to 2020" ;
    chart:xAxis ex:x-7621 ;
    chart:yAxis ex:y-7621 .

ex:x-7621 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2010" ;
    chart:scaleMax "2020" .

ex:y-7621 a chart:Axis ;
    chart:label "Industry" ;
    chart:scaleMin "0.00" ;
    chart:scaleMax "0.20" .

ex:series-7621-1 a chart:Series .

ex:dp-7621-1-1 a chart:DataPoint ;
    chart:series ex:series-7621-1 ;
    chart:xVal "2010" ;
    chart:yVal "0.155"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-7621-1-2 a chart:DataPoint ;
    chart:series ex:series-7621-1 ;
    chart:xVal "2012" ;
    chart:yVal "0.153"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-7621-1-3 a chart:DataPoint ;
    chart:series ex:series-7621-1 ;
    chart:xVal "2014" ;
    chart:yVal "0.158"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-7621-1-4 a chart:DataPoint ;
    chart:series ex:series-7621-1 ;
    chart:xVal "2016" ;
    chart:yVal "0.165"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-7621-1-5 a chart:DataPoint ;
    chart:series ex:series-7621-1 ;
    chart:xVal "2018" ;
    chart:yVal "0.175"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-7621-1-6 a chart:DataPoint ;
    chart:series ex:series-7621-1 ;
    chart:xVal "2020" ;
    chart:yVal "0.185"^^xsd:decimal ;
    chart:valueEstimated "true" .
