@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-5410 a chart:Chart ;
    chart:chartType "bar" ;
    chart:xAxis ex:x-5410 ;
    chart:yAxis ex:y-5410 .

ex:x-5410 a chart:Axis ;
    chart:label "Volume in thousand kilograms" ;
    chart:scaleMin "0" ;
    chart:scaleMax "400000" .

ex:y-5410 a chart:Axis ;
    chart:label "Year" .

ex:series-5410-1 a chart:Series .

ex:dp-5410-1-1 a chart:DataPoint ;
    chart:series ex:series-5410-1 ;
    chart:category "2008" ;
    chart:value "350000"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-5410-1-2 a chart:DataPoint ;
    chart:series ex:series-5410-1 ;
    chart:category "2009" ;
    chart:value "300000"^^xsd:decimal ;
