@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-1361 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Boston Celtics operating income from 2001/02 to 2018/19 (in million U.S. dollars)" ;
    chart:xAxis ex:x-1361 ;
    chart:yAxis ex:y-1361 .

ex:x-1361 a chart:Axis ;
    chart:label "Operating income in million U.S. dollars" ;
    chart:scaleMin "0" ;
    chart:scaleMax "100" .

ex:y-1361 a chart:Axis ;
    chart:label "Year" .

ex:series-1361-1 a chart:Series .

ex:dp-1361-1-1 a chart:DataPoint ;
    chart:series ex:series-1361-1 ;
    chart:category "01/02" ;
    chart:value "15"^^xsd:decimal ;
    chart:valueEstimated "true" .

