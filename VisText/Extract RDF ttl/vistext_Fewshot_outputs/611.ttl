@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-611 a chart:Chart ;
    chart:chartType "area" ;
    chart:xAxis ex:x-611 ;
    chart:yAxis ex:y-611 .

ex:x-611 a chart:Axis ;
    chart:label "Response" ;
    chart:scaleMin "2000" ;
    chart:scaleMax "2015" .

ex:y-611 a chart:Axis ;
    chart:label "Percentage of population" ;
    chart:scaleMin "0.00" ;
    chart:scaleMax "0.18" .

ex:series-611-1 a chart:Series .

ex:dp-611-1-1 a chart:DataPoint ;
    chart:series ex:series-611-1 ;
    chart:xVal "2000" ;
    chart:yVal "0.15"^^xsd:decimal ;
    chart:valueEstimated "true" .

