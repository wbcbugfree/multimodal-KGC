@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-2854 a chart:Chart ;
    chart:chartType "line" ;
    chart:title "China \'s cotton mill use from 1990 to 2017 (in 1,000 bales)" ;
    chart:xAxis ex:x-2854 ;
    chart:yAxis ex:y-2854 .

ex:x-2854 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "1990" ;
    chart:scaleMax "2017" .

ex:y-2854 a chart:Axis ;
    chart:label "Mill use in thousand 480-pound bales" ;
    chart:scaleMin "0" ;
    chart:scaleMax "50000" .

ex:series-2854-1 a chart:Series .

ex:dp-2854-1-1 a chart:DataPoint ;
    chart:series ex:series-2854-1 ;
    chart:xVal "1990" ;
    chart:yVal "15000"^^xsd:decimal ;
    chart:value "15000"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-2854-1-2 a chart:DataPoint ;
    chart:series ex:series-2854-1 ;
    chart:xVal "1995" ;
    chart:yVal "14000"^^xsd:decimal ;
    chart:value "14000"^^xsd:decimal ;
    chart:valueEstimated "true" .

