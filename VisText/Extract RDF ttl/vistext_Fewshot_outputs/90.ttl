@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-90 a chart:Chart ;
    chart:chartType "line" ;
    chart:title "Sales of cut flowers in Canada from 2010 to 2019 (in million Canadian dollars)" ;
    chart:xAxis ex:x-90 ;
    chart:yAxis ex:y-90 .

ex:x-90 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2010" ;
    chart:scaleMax "2019" .

ex:y-90 a chart:Axis ;
    chart:label "Sales in million Canadian dollars" ;
    chart:scaleMin "0" ;
    chart:scaleMax "150" .

ex:series-90-1 a chart:Series .

ex:dp-90-1-1 a chart:DataPoint ;
    chart:series ex:series-90-1 ;
    chart:xVal "2010" ;
    chart:yVal "135"^^xsd:decimal ;
    chart:value "135"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-90-1-2 a chart:DataPoint ;
    chart:series ex:series-90-1 ;
    chart:xVal "2011" ;
    chart:yVal "142"^^xsd:decimal ;
    chart:value "142"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-90-1-3 a chart:DataPoint ;
    chart:series ex:series-90-1 ;
    chart:xVal "2012" ;
    chart:yVal "147"^^xsd:decimal ;
    chart:value "147"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-90-1-4 a chart:DataPoint ;
    chart:series ex:series-90-1 ;
    chart:xVal "2013" ;
    chart:yVal "150"^^xsd:decimal ;
    chart:value "150"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-90-1-5 a chart:DataPoint ;
    chart:series ex:series-90-1 ;
    chart:xVal "2014" ;
    chart:yVal "151"^^xsd:decimal ;
    chart:value "151"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-90-1-6 a chart:DataPoint ;
    chart:series ex:series-90-1 ;
    chart:xVal "2015" ;
    chart:yVal "149"^^xsd:decimal ;
    chart:value "149"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-90-1-7 a chart:DataPoint ;
    chart:series ex:series-90-1 ;
    chart:xVal "2016" ;
    chart:yVal "145"^^xsd:decimal ;
    chart:value "145"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-90-1-8 a chart:DataPoint ;
    chart:series ex:series-90-1 ;
    chart:xVal "2017" ;
    chart:yVal "130"^^xsd:decimal ;
    chart:value "130"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-90-1-9 a chart:DataPoint ;
    chart:series ex:series-90-1 ;
    chart:xVal "2018" ;
    chart:yVal "135"^^xsd:decimal ;
    chart:value "135"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-90-1-10 a chart:DataPoint ;
    chart:series ex:series-90-1 ;
    chart:xVal "2019" ;
    chart:yVal "140"^^xsd:decimal ;
    chart:value "140"^^xsd:decimal ;
    chart:valueEstimated "true" .
