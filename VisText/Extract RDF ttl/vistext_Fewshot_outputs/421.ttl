@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-421 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Most popular tourist attractions worldwide on Instagram as of September 2018 , by number of posts (in millions)" ;
    chart:xAxis ex:x-421 ;
    chart:yAxis ex:y-421 .

ex:x-421 a chart:Axis ;
    chart:label "Number of hashtgged posts in millions" ;
    chart:scaleMin "0" ;
    chart:scaleMax "6" .

ex:y-421 a chart:Axis ;
    chart:label "tourist attraction" ;
    chart:scaleMin "" ;
    chart:scaleMax "" .

ex:series-421-1 a chart:Series .

ex:dp-421-1-1 a chart:DataPoint ;
    chart:series ex:series-421-1 ;
    chart:category "Angor Wat, Cambodia" ;
    chart:value "1.0"^^xsd:decimal ;
    chart:valueEstimated "true" .

