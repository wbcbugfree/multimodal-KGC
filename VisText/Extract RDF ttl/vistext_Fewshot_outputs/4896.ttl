@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-4896 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Number of doping cases in international sports between 2000 and 2010 , by sport" ;
    chart:xAxis ex:x-4896 ;
    chart:yAxis ex:y-4896 .

ex:x-4896 a chart:Axis ;
    chart:label "Number of doping cases" ;
    chart:scaleMin "0" ;
    chart:scaleMax "1000" .

ex:y-4896 a chart:Axis ;
    chart:label "type of sport" .

ex:series-4896-1 a chart:Series .

ex:mark-4896-1-1 a chart:DataPoint ;
    chart:series ex:series-4896-1 ;
    chart:category "American sports" ;
    chart:value "250"^^xsd:decimal ;
    chart:valueEstimated "true" .

