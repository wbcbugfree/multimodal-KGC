@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-8041 a chart:Chart ;
    chart:chartType "area" ;
    chart:title "Consumer satisfaction with select online news brands in the United States from 2007 to 2019 (index score)" ;
    chart:xAxis ex:x-8041 ;
    chart:yAxis ex:y-8041 .

ex:x-8041 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2007" ;
    chart:scaleMax "2019" .

ex:y-8041 a chart:Axis ;
    chart:label "USATODAY.com" ;
    chart:scaleMin "0" ;
    chart:scaleMax "80" .

ex:series-8041-1 a chart:Series .

ex:dp-8041-1-1 a chart:DataPoint ;
    chart:series ex:series-8041-1 ;
    chart:xVal "2007" ;
    chart:yVal "72"^^xsd:decimal ;
    chart:value "72"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-8041-1-2 a chart:DataPoint ;
    chart:series ex:series-8041-1 ;
    chart:xVal "2008" ;
    chart:yVal "74"^^xsd:decimal ;
    chart:value "74"^^xsd:decimal ;
    chart:valueEstimated "true" .

