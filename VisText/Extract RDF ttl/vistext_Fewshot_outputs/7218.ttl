@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-7218 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Liverpool FC revenue by stream from 2008/09 to 2018/19 (in million euros)" ;
    chart:xAxis ex:x-7218 ;
    chart:yAxis ex:y-7218 .

ex:x-7218 a chart:Axis ;
    chart:label "Matchday" ;
    chart:scaleMin "0" ;
    chart:scaleMax "100" .

ex:y-7218 a chart:Axis ;
    chart:label "Season" .

ex:series-7218-1 a chart:Series .

ex:dp-7218-1-1 a chart:DataPoint ;
    chart:series ex:series-7218-1 ;
    chart:category "2008/09" ;
    chart:value "45"^^xsd:decimal ;
    chart:valueEstimated "true" .

