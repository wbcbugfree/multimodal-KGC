@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-694 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Leading 10 causes of death in lower-middle income countries worldwide in 2016 (in deaths per 100,000 population)" ;
    chart:xAxis ex:x-694 ;
    chart:yAxis ex:y-694 .

ex:x-694 a chart:Axis ;
    chart:label "Deaths per 100,000 population" ;
    chart:scaleMin "0" ;
    chart:scaleMax "120" .

ex:y-694 a chart:Axis ;
    chart:label "causes of death" .

ex:series-694-1 a chart:Series .

ex:dp-694-1-1 a chart:DataPoint ;
    chart:series ex:series-694-1 ;
    chart:category "Chronic obstructive pulmonary dis..." ;
    chart:value "30"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-694-1-2 a chart:DataPoint ;
    chart:series ex:series-694-1 ;
    chart:category "Cirrhosis of the liver" ;
    chart:value "20"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-694-1-3 a chart:DataPoint ;
    chart:series ex:series-694-1 ;
    chart:category "Diabetes mellitus" ;
    chart:value "20"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-694-1-4 a chart:DataPoint ;
    chart:series ex:series-694-1 ;
    chart:category "Diarrhoeal diseases" ;
    chart:value "30"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-694-1-5 a chart:DataPoint ;
    chart:series ex:series-694-1 ;
    chart:category "Ischaemic heart disease" ;
    chart:value "115"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-694-1-6 a chart:DataPoint ;
    chart:series ex:series-694-1 ;
    chart:category "Lower respiratory infections" ;
    chart:value "45"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-694-1-7 a chart:DataPoint ;
    chart:series ex:series-694-1 ;
    chart:category "Preterm birth complications" ;
    chart:value "20"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-694-1-8 a chart:DataPoint ;
    chart:series ex:series-694-1 ;
    chart:category "Road injury" ;
    chart:value "15"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-694-1-9 a chart:DataPoint ;
    chart:series ex:series-694-1 ;
    chart:category "Stroke" ;
    chart:value "55"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-694-1-10 a chart:DataPoint ;
    chart:series ex:series-694-1 ;
    chart:category "Tuberculosis" ;
    chart:value "25"^^xsd:decimal ;
    chart:valueEstimated "true" .
