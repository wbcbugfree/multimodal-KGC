@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-3683 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Percentage of respondents worldwide who felt COVID-19 posed a high level of threat to their job or business as of March 14 , 2020 , by country" ;
    chart:xAxis ex:x-3683 ;
    chart:yAxis ex:y-3683 .

ex:x-3683 a chart:Axis ;
    chart:label "Percentage of respondents" ;
    chart:scaleMin "0.0" ;
    chart:scaleMax "0.6" .

ex:y-3683 a chart:Axis ;
    chart:label "Response" ;
    chart:scaleMin "" ;
    chart:scaleMax "" .

ex:series-3683-1 a chart:Series .

ex:dp-3683-1-1 a chart:DataPoint ;
    chart:series ex:series-3683-1 ;
    chart:category "Australia" ;
    chart:value "0.25"^^xsd:decimal ;
    chart:valueEstimated "true" .

