@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-6995 a chart:Chart ;
    chart:chartType "area" ;
    chart:title "Average annual wages in major developed countries from 2008 to 2019 (in U.S. dollars)" ;
    chart:xAxis ex:x-6995 ;
    chart:yAxis ex:y-6995 .

ex:x-6995 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2008" ;
    chart:scaleMax "2019" .

ex:y-6995 a chart:Axis ;
    chart:label "Japan" ;
    chart:scaleMin "0" ;
    chart:scaleMax "40000" .

ex:series-6995-1 a chart:Series .

ex:dp-6995-1-1 a chart:DataPoint ;
    chart:series ex:series-6995-1 ;
    chart:xVal "2008" ;
    chart:yVal "37000"^^xsd:decimal ;
    chart:value "37000"^^xsd:decimal ;
    chart:valueEstimated "true" .

