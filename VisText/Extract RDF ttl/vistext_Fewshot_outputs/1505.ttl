    chart:series ex:series-1505-1 ;
    chart:xVal "1985" ;
    chart:yVal "97"^^xsd:decimal ;
    chart:value "97"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-1505-1-4 a chart:DataPoint ;
    chart:series ex:series-1505-1 ;
    chart:xVal "1990" ;
