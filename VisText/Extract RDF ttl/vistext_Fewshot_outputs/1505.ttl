@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-1505 a chart:Chart ;
    chart:chartType "area" ;
    chart:title "Total number of wage and salary workers in the United States from 1979 to 2019 (in millions)" ;
    chart:xAxis ex:x-1505 ;
    chart:yAxis ex:y-1505 .

ex:x-1505 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "1979" ;
    chart:scaleMax "2019" .

ex:y-1505 a chart:Axis ;
    chart:label "Number of workers in millions" ;
    chart:scaleMin "0" ;
    chart:scaleMax "150" .

ex:series-1505-1 a chart:Series .

ex:dp-1505-1-1 a chart:DataPoint ;
    chart:series ex:series-1505-1 ;
    chart:xVal "1979" ;
    chart:yVal "88"^^xsd:decimal ;
    chart:value "88"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-1505-1-2 a chart:DataPoint ;
    chart:series ex:series-1505-1 ;
    chart:xVal "1980" ;
    chart:yVal "89"^^xsd:decimal ;
    chart:value "89"^^xsd:decimal ;
    chart:valueEstimated "true" .

