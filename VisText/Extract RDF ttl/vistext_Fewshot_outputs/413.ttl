@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-413 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "World leaders with the most Twitter followers as of June 2020" ;
    chart:xAxis ex:x-413 ;
    chart:yAxis ex:y-413 .

ex:x-413 a chart:Axis ;
    chart:label "Twitter followers in millions" ;
    chart:scaleMin "0" ;
    chart:scaleMax "80" .

ex:y-413 a chart:Axis ;
    chart:label "World leader" .

ex:series-413-1 a chart:Series .

ex:dp-413-1-1 a chart:DataPoint ;
    chart:series ex:series-413-1 ;
    chart:category "Donald J. Trump, United States @..." ;
    chart:value "88"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-413-1-2 a chart:DataPoint ;
    chart:series ex:series-413-1 ;
    chart:category "Imran Khan, Pakistan @imrankha..." ;
    chart:value "3.5"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-413-1-3 a chart:DataPoint ;
    chart:series ex:series-413-1 ;
    chart:category "Joko Widodo, Indonesia @Jokowi" ;
    chart:value "4.5"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-413-1-4 a chart:DataPoint ;
    chart:series ex:series-413-1 ;
    chart:category "Narendra Modi, India @Narendra..." ;
    chart:value "55"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-413-1-5 a chart:DataPoint ;
    chart:series ex:series-413-1 ;
    chart:category "Narendra Modi, India @PMOIndia ..." ;
    chart:value "35"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-413-1-6 a char:DataPoint ;
    chart:series ex:series-413-1 ;
    chart:category "Pope Francis, Vatican @Pontifex*" ;
    chart:value "50"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-413-1-7 a chart:DataPoint ;
    chart:series ex:series-413-1 ;
    chart:category "President Trump, United States @..." ;
    chart:value "30"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-413-1-8 a chart:DataPoint ;
    chart:series ex:series-413-1 ;
    chart:category "Queen Rania, Jordan @QueenRania" ;
    chart:value "7"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-413-1-9 a chart:DataPoint ;
    chart:series ex:series-413-1 ;
    chart:category "Recep Tayyip Erdoğan, Turkey @R..." ;
    chart:value "10"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-413-1-10 a chart:DataPoint ;
    chart:series ex:series-413-1 ;
    chart:category "The White House, United States @..." ;
    chart:value "25"^^xsd:decimal ;
    chart:valueEstimated "true" .
