@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-7217 a chart:Chart ;
    chart:chartType "line" ;
    chart:title "El Salvador : Share of economic sectors in the gross domestic product (GDP) from 2009 to 2019" ;
    chart:xAxis ex:x-7217 ;
    chart:yAxis ex:y-7217 .

ex:x-7217 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2009" ;
    chart:scaleMax "2019" .

ex:y-7217 a chart:Axis ;
    chart:label "Services" ;
    chart:scaleMin "0.0" ;
    chart:scaleMax "0.6" .

ex:series-7217-1 a chart:Series .

ex:dp-7217-1-1 a chart:DataPoint ;
    chart:series ex:series-7217-1 ;
    chart:xVal "2009" ;
    chart:yVal "0.59"^^xsd:decimal ;
    chart:value "0.59"^^xsd:decimal ;
    chart:valueEstimated "true" .

