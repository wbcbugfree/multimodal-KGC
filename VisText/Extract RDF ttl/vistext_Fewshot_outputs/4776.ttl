@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-4776 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Number of heterosexual marriages in Spain from 2006 to 2019" ;
    chart:xAxis ex:x-4776 ;
    chart:yAxis ex:y-4776 .

ex:x-4776 a chart:Axis ;
    chart:label "Number of marriages" ;
    chart:scaleMin "0" ;
    chart:scaleMax "200000" .

ex:y-4776 a chart:Axis ;
    chart:label "Year" .

ex:series-4776-1 a chart:Series .

ex:dp-4776-1-1 a chart:DataPoint ;
    chart:series ex:series-4776-1 ;
    chart:category "2006" ;
    chart:value "165000"^^xsd:decimal ;
    chart:valueEstimated "true" .

