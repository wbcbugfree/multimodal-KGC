@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-2433 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Democratic Republic of the Congo : Budget balance between 2015 to 2025 in relation to GDP" ;
    chart:xAxis ex:x-2433 ;
    chart:yAxis ex:y-2433 .

ex:x-2433 a chart:Axis ;
    chart:label "Budget balance in relation to GDP" ;
    chart:scaleMin "-0.02" ;
    chart:scaleMax "0.01" .

ex:y-2433 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2015" ;
    chart:scaleMax "2025" .

ex:series-2433-1 a chart:Series .

ex:dp-2433-1-1 a chart:DataPoint ;
    chart:series ex:series-2433-1 ;
    chart:category "2015" ;
    chart:value "0.005"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-2433-1-2 a chart:DataPoint ;
    chart:series ex:series-2433-1 ;
    chart:category "2016" ;
    chart:value "-0.005"^^xsd:decimal ;
    chart:valueEstimated "true" .

