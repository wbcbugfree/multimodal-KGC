@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-1002 a chart:Chart ;
    chart:chartType "bar" ;
    chart:xAxis ex:x-1002 ;
    chart:yAxis ex:y-1002 .

ex:x-1002 a chart:Axis ;
    chart:label "Share of respondents" ;
    chart:scaleMin "0.0" ;
    chart:scaleMax "0.2" .

ex:y-1002 a chart:Axis ;
    chart:label "Response" .

ex:series-1002-1 a chart:Series .

ex:dp-1002-1-1 a chart:DataPoint ;
    chart:series ex:series-1002-1 ;
    chart:category "1 - Not influential at all" ;
    chart:value "0.02"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-1002-1-2 a chart:DataPoint ;
    chart:series ex:series-1002-1 ;
    chart:category "10 - Very influential" ;
    chart:value "0.06"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-1002-1-3 a chart:DataPoint ;
    chart:series ex:series-1002-1 ;
    chart:category "2" ;
    chart:value "0.03"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-1002-1-4 a chart:DataPoint ;
    chart:series ex:series-1002-1 ;
    chart:category "3" ;
    chart:value "0.06"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-1002-1-5 a chart:DataPoint ;
    chart:series ex:series-1002-1 ;
    chart:category "4" ;
    chart:value "0.12"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-1002-1-6 a chart:DataPoint ;
    chart:series ex:series-1002-1 ;
    chart:category "5" ;
    chart:value "0.18"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-1002-1-7 a chart:DataPoint ;
    chart:series ex:series-1002-1 ;
    chart:category "6" ;
    chart:value "0.17"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-1002-1-8 a chart:DataPoint ;
    chart:series ex:series-1002-1 ;
    chart:category "7" ;
    chart:value "0.20"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-1002-1-9 a chart:DataPoint ;
    chart:series ex:series-1002-1 ;
    chart:category "8" ;
    chart:value "0.15"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-1002-1-10 a chart:DataPoint ;
    chart:series ex:series-1002-1 ;
    chart:category "9" ;
    chart:value "0.11"^^xsd:decimal ;
    chart:valueEstimated "true" .
