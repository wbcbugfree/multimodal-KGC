@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-2906 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Number of VAT and/or PAYE based enterprises in the United Kingdom (UK) in 2020 , by turnover size band (in 1,000s)" ;
    chart:xAxis ex:x-2906 ;
    chart:yAxis ex:y-2906 .

ex:x-2906 a chart:Axis ;
    chart:label "Year" .

ex:y-2906 a chart:Axis ;
    chart:label "Number of enterprises in thousand" ;
    chart:scaleMin "0" ;
    chart:scaleMax "1000" .

ex:series-2906-1 a chart:Series .

ex:dp-2906-1-1 a chart:DataPoint ;
    chart:series ex:series-2906-1 ;
    chart:category "0 - 49,999 GBP" ;
    chart:value "410"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-2906-1-2 a chart:DataPoint ;
    chart:series ex:series-2906-1 ;
    chart:category "1 billion - 4.999 billion GBP" ;
    chart:value "20"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-2906-1-3 a chart:DataPoint ;
    chart:series ex:series-2906-1 ;
    chart:category "1 million - 1.999 million GBP" ;
    chart:value "130"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-2906-1-4 a chart:DataPoint ;
    chart:series ex:series-2906-1 ;
    chart:category "100,000 - 249,999 GBP" ;
    chart:value "880"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-2906-1-5 a chart:DataPoint ;
    chart:series ex:series-2906-1 ;
    chart:category "2 million - 4.999 million GBP" ;
    chart:value "70"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-2906-1-6 a chart:DataPoint ;
    chart:series ex:series-2906-1 ;
    chart:category "250,000 - 499,999 GBP" ;
    chart:value "470"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-2906-1-7 a chart:DataPoint ;
    chart:series ex:series-2906-1 ;
    chart:category "5 billion GBP and over" ;
    chart:value "10"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-2906-1-8 a chart:DataPoint ;
    chart:series ex:series-2906-1 ;
    chart:category "5 million - 9.999 million GBP" ;
    chart:value "620"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-2906-1-9 a chart:DataPoint ;
    chart:series ex:series-2906-1 ;
    chart:category "50,000 - 99,999 GBP" ;
    chart:value "210"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-2906-1-10 a chart:DataPoint ;
    chart:series ex:series-2906-1 ;
    chart:category "500,000 - 999,999 GBP" ;
    chart:value "200"^^xsd:decimal ;
    chart:valueEstimated "true" .
