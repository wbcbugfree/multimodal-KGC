@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-1791 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "The leading law firms in China in 2019 , by gross revenue (in million U.S. dollars)" ;
    chart:xAxis ex:x-1791 ;
    chart:yAxis ex:y-1791 .

ex:x-1791 a chart:Axis ;
    chart:label "Gross revenue in million U.S. dollars" ;
    chart:scaleMin "0" ;
    chart:scaleMax "3000" .

ex:y-1791 a chart:Axis ;
    chart:label "law firm" ;
    chart:scaleMin "" ;
    chart:scaleMax "" .

ex:series-1791-1 a chart:Series .

ex:mark-1791-1-1 a chart:DataPoint ;
    chart:series ex:series-1791-1 ;
    chart:category "Allbright" ;
    chart:value "300"^^xsd:decimal ;
    chart:valueEstimated "true" .

