@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-3220 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Total number of Novartis AG 's full-time employees from 2009 to 2019" ;
    chart:xAxis ex:x-3220 ;
    chart:yAxis ex:y-3220 .

ex:x-3220 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "" ;
    chart:scaleMax "" .

ex:y-3220 a chart:Axis ;
    chart:label "Number of employees (full time)" ;
    chart:scaleMin "0" ;
    chart:scaleMax "140000" .

ex:series-3220-1 a chart:Series .

ex:dp-3220-1-1 a chart:DataPoint ;
    chart:series ex:series-3220-1 ;
    chart:category "2009" ;
    chart:value "100000"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-3220-1-2 a chart:DataPoint ;
    chart:series ex:series-3220-1 ;
    chart:category "2010" ;
    chart:value "120000"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-3220-1-3 a chart:DataPoint ;
    chart:series ex:series-3220-1 ;
    chart:category "2011" ;
    chart:value "110000"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-3220-1-4 a chart:DataPoint ;
    chart:series ex:series-3220-1 ;
    chart:category "2012" ;
    chart:value "112000"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-3220-1-5 a chart:DataPoint ;
    chart:series ex:series-3220-1 ;
    chart:category "2013" ;
    chart:value "114000"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-3220-1-6 a chart:DataPoint ;
    chart:series ex:series-3220-1 ;
    chart:category "2014" ;
    chart:value "115000"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-3220-1-7 a chart:DataPoint ;
    chart:series ex:series-3220-1 ;
    chart:category "2015**" ;
    chart:value "116000"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-3220-1-8 a chart:DataPoint ;
    chart:series ex:series-3220-1 ;
    chart:category "2016" ;
    chart:value "117000"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-3220-1-9 a chart:DataPoint ;
    chart:series ex:series-3220-1 ;
    chart:category "2017" ;
    chart:value "118000"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-3220-1-10 a chart:DataPoint ;
    chart:series ex:series-3220-1 ;
    chart:category "2018" ;
    chart:value "120000"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-3220-1-11 a chart:DataPoint ;
    chart:series ex:series-3220-1 ;
    chart:category "2019***" ;
    chart:value "102000"^^xsd:decimal ;
    chart:valueEstimated "true" .
