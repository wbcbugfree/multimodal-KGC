@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-2755 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Value of newsprint imported into India from financial year 2011 to 2019 , with an estimate for 2020 (in billion Indian rupees)" ;
    chart:xAxis ex:x-2755 ;
    chart:yAxis ex:y-2755 .

ex:x-2755 a chart:Axis ;
    chart:label "Import value in billion Indian rupees" ;
    chart:scaleMin "0" ;
    chart:scaleMax "70" .

ex:y-2755 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "" ;
    chart:scaleMax "" .

ex:series-2755-1 a chart:Series .

ex:dp-2755-1-1 a chart:DataPoint ;
    chart:series ex:series-2755-1 ;
    chart:category "FY 2011" ;
    chart:value "23"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-2755-1-2 a chart:DataPoint ;
    chart:series ex:series-2755-1 ;
    chart:category "FY 2012" ;
    chart:value "30"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-2755-1-3 a chart:DataPoint ;
    chart:series ex:series-2755-1 ;
    chart:category "FY 2013" ;
    chart:value "40"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-2755-1-4 a chart:DataPoint ;
    chart:series ex:series-2755-1 ;
    chart:category "FY 2014" ;
    chart:value "45"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-2755-1-5 a chart:DataPoint ;
    chart:series ex:series-2755-1 ;
    chart:category "FY 2015" ;
    chart:value "48"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-2755-1-6 a chart:DataPoint ;
    chart:series ex:series-2755-1 ;
    chart:category "FY 2016" ;
    chart:value "50"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-2755-1-7 a chart:DataPoint ;
    chart:series ex:series-2755-1 ;
    chart:category "FY 2017" ;
    chart:value "55"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-2755-1-8 a chart:DataPoint ;
    chart:series ex:series-2755-1 ;
    chart:category "FY 2018" ;
    chart:value "50"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-2755-1-9 a chart:DataPoint ;
    chart:series ex:series-2755-1 ;
    chart:category "FY 2019" ;
    chart:value "65"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-2755-1-10 a chart:DataPoint ;
    chart:series ex:series-2755-1 ;
    chart:category "FY 2020" ;
    chart:value "50"^^xsd:decimal ;
    chart:valueEstimated "true" .
