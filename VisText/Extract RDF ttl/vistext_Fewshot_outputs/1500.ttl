@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-1500 a chart:Chart ;
    chart:chartType "line" ;
    chart:title "Annual net income of Telus Corporation from 2010 to 2019 (in million Canadian dollars)" ;
    chart:xAxis ex:x-1500 ;
    chart:yAxis ex:y-1500 .

ex:x-1500 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2010" ;
    chart:scaleMax "2018" .

ex:y-1500 a chart:Axis ;
    chart:label "Net income in billion Canadian dollars" ;
    chart:scaleMin "0" ;
    chart:scaleMax "1500" .

ex:series-1500-1 a chart:Series .

ex:dp-1500-1-1 a chart:DataPoint ;
    chart:series ex:series-1500-1 ;
    chart:xVal "2010" ;
    chart:yVal "1000"^^xsd:decimal ;
    chart:value "1000"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-1500-1-2 a chart:DataPoint ;
    chart:series ex:series-1500-1 ;
    chart:xVal "2011" ;
    chart:yVal "1100"^^xsd:decimal ;
    chart:value "1100"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-1500-1-3 a chart:DataPoint ;
    chart:series ex:series-1500-1 ;
    chart:xVal "2012" ;
    chart:yVal "1200"^^xsd:decimal ;
    chart:value "1200"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-1500-1-4 a chart:DataPoint ;
    chart:series ex:series-1500-1 ;
    chart:xVal "2013" ;
    chart:yVal "1300"^^xsd:decimal ;
    chart:value "1300"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-1500-1-5 a chart:DataPoint ;
    chart:series ex:series-1500-1 ;
    chart:xVal "2014" ;
    chart:yVal "1450"^^xsd:decimal ;
    chart:value "1450"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-1500-1-6 a chart:DataPoint ;
    chart:series ex:series-1500-1 ;
    chart:xVal "2015" ;
    chart:yVal "1200"^^xsd:decimal ;
    chart:value "1200"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-1500-1-7 a chart:DataPoint ;
    chart:series ex:series-1500-1 ;
    chart:xVal "2016" ;
    chart:yVal "1350"^^xsd:decimal ;
    chart:value "1350"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-1500-1-8 a chart:DataPoint ;
    chart:series ex:series-1500-1 ;
    chart:xVal "2017" ;
    chart:yVal "1500"^^xsd:decimal ;
    chart:value "1500"^^xsd:decimal ;
    chart:valueEstimated "true" .

ex:dp-1500-1-9 a chart:DataPoint ;
    chart:series ex:series-1500-1 ;
    chart:xVal "2018" ;
    chart:yVal "1600"^^xsd:decimal ;
    chart:value "1600"^^xsd:decimal ;
    chart:valueEstimated "true" .
