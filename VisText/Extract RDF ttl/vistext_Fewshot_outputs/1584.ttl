@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-1584 a chart:Chart ;
    chart:chartType "area" ;
    chart:title "Joe Gibbs Racing team (NASCAR) revenue from 2006 to 2017 (in million U.S. dollars)" ;
    chart:xAxis ex:x-1584 ;
    chart:yAxis ex:y-1584 .

ex:x-1584 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2006" ;
    chart:scaleMax "2017" .

ex:y-1584 a chart:Axis ;
    chart:label "Revenue in million U.S. dollars" ;
    chart:scaleMin "0" ;
    chart:scaleMax "150" .

ex:series-1584-1 a chart:Series .

ex:dp-1584-1-1 a chart:DataPoint ;
    chart:series ex:series-1584-1 ;
    chart:xVal "2006" ;
    chart:yVal "110"^^xsd:decimal ;
    chart:value "110"^^xsd:decimal ;
    chart:valueEstimated "true" .

