ex:chart-1569 a chart:Chart ;
    chart:chartType "line" ;
    chart:title "Liberia : Life expectancy at birth from 2008 to 2018" ;
    chart:xAxis ex:x-1569 ;
    chart:yAxis ex:y-1569 .

ex:x-1569 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2008" ;
    chart:scaleMax "2018" .

ex:y-1569 a chart:Axis ;
    chart:label "Life expectancy at birth in years" ;
    chart:scaleMin "0" ;
    chart:scaleMax "60" .

ex:series-1569-1 a chart:Series .

ex:point-1569-1-1 a chart:Point ;
    chart:series ex:series-1569-1 ;
    chart:xVal "2008" ;
    chart:yVal "58"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-1569-1-2 a chart:Point ;
    chart:series ex:series-1569-1 ;
    chart:xVal "2010" ;
    chart:yVal "59"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-1569-1-3 a chart:Point ;
    chart:series ex:series-1569-1 ;
    chart:xVal "2012" ;
    chart:yVal "60"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-1569-1-4 a chart:Point ;
    chart:series ex:series-1569-1 ;
    chart:xVal "2014" ;
    chart:yVal "61"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-1569-1-5 a chart:Point ;
    chart:series ex:series-1569-1 ;
    chart:xVal "2016" ;
    chart:yVal "62"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-1569-1-6 a chart:Point ;
