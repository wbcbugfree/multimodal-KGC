@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-1588 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Monthly export price of high-density polyethylene in the United States from January 2017 to October 2017 (in U.S. dollars per ton)" ;
    chart:xAxis ex:x-1588 ;
    chart:yAxis ex:y-1588 .

ex:x-1588 a chart:Axis ;
    chart:label "Month" ;
    chart:scaleMin "" ;
    chart:scaleMax "" .

ex:y-1588 a chart:Axis ;
    chart:label "Price in U.S. dollars per ton" ;
    chart:scaleMin "0" ;
    chart:scaleMax "1200" .

ex:series-1588-1 a chart:Series .

ex:mark-1588-1-1 a chart:Bar ;
    chart:series ex:series-1588-1 ;
    chart:category "April" ;
    chart:value "1150"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:mark-1588-1-2 a chart:Bar ;
    chart:series ex:series-1588-1 ;
    chart:category "August" ;
    chart:value "1150"^^xsd:decimal ;
