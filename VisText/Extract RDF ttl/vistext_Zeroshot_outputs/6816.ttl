@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-6816 a chart:Chart ;
    chart:chartType "line" ;
    chart:title "Life expectancy at birth in the Netherlands" ;
    chart:subtitle "from 1950 to 2018 , by gender" ;
    chart:xAxis ex:x-6816 ;
    chart:yAxis ex:y-6816 .

ex:x-6816 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "1950" ;
    chart:scaleMax "2010" .

ex:y-6816 a chart:Axis ;
    chart:label "" ;
    chart:scaleMin "0" ;
    chart:scaleMax "100" .

ex:series-6816-1 a chart:Series ;
    chart:seriesName "Men" .

ex:point-6816-1-1 a chart:Point ;
    chart:series ex:series-6816-1 ;
    chart:xVal "1950" ;
    chart:yVal "72.0"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-6816-1-2 a chart:Point ;
    chart:series ex:series-6816-1 ;
    chart:xVal "1960" ;
    chart:yVal "73.0"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-6816-1-3 a chart:Point ;
    chart:series ex:series-6816-1 ;
    chart:xVal "1970" ;
    chart:yVal "73.0"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-6816-1-4 a chart:Point ;
    chart:series ex:series-6816-1 ;
    chart:xVal "1980" ;
    chart:yVal "74.0"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-6816-1-5 a chart:Point ;
    chart:series ex:series-6816-1 ;
    chart:xVal "1990" ;
    chart:yVal "76.0"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-6816-1-6 a chart:Point ;
    chart:series ex:series-6816-1 ;
    chart:xVal "2000" ;
    chart:yVal "78.0"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-6816-1-7 a chart:Point ;
    chart:series ex:series-6816-1 ;
    chart:xVal "2010" ;
    chart:yVal "80.0"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .
