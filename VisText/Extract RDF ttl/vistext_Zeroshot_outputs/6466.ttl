@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-6466 a chart:Chart ;
    chart:chartType "area" ;
    chart:title "Revenue of Johnson & Johnson 's pharmaceuticals segment worldwide from 2012 to 2024 , by product category (in billion U.S. dollars)" ;
    chart:xAxis ex:x-6466 ;
    chart:yAxis ex:y-6466 .

ex:x-6466 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2012" ;
    chart:scaleMax "2024" .

ex:y-6466 a chart:Axis ;
    chart:label "Anti-infectives" ;
    chart:scaleMin "0" ;
    chart:scaleMax "6" .

ex:series-6466-1 a chart:Series ;
    chart:seriesName "Anti-infectives" .

ex:point-6466-1-1 a chart:Point ;
    chart:series ex:series-6466-1 ;
    chart:xVal "2012" ;
    chart:yVal "2.5"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

