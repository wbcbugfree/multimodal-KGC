@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-1170 a chart:Chart ;
    chart:chartType "bar" ;
    chart:xAxis ex:x-1170 ;
    chart:yAxis ex:y-1170 ;
    chart:title "Donations made to charity in the U.S. from 2011 to 2013 , by channel used" .

ex:x-1170 a chart:Axis ;
    chart:label "Share of respondents" ;
    chart:scaleMin "0.0" ;
    chart:scaleMax "0.5" .

ex:y-1170 a chart:Axis ;
    chart:label "Channel" ;
    chart:scaleMin "" ;
    chart:scaleMax "" .

ex:series-1170-1 a chart:Series .

ex:mark-1170-1-1 a chart:Bar ;
    chart:series ex:series-1170-1 ;
    chart:category "Will/planned gift." ;
    chart:value "0.05"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

