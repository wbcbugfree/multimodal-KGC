ex:chart-5450 a chart:Chart ;
    chart:chartType "line" ;
    chart:title "Number of jobs in the wind energy industry worldwide from 2009 to 2019 (in 1,000s)" ;
    chart:xAxis ex:x-5450 ;
    chart:yAxis ex:y-5450 .

ex:x-5450 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2009" ;
    chart:scaleMax "2019" .

ex:y-5450 a chart:Axis ;
    chart:label "Number of jobs in thousands" ;
    chart:scaleMin "0" ;
    chart:scaleMax "1200" .

ex:series-5450-1 a chart:Series .

ex:point-5450-1-1 a chart:Point ;
    chart:series ex:series-5450-1 ;
    chart:xVal "2009" ;
    chart:yVal "400"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

