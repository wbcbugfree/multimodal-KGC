@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-262 a chart:Chart ;
    chart:chartType "area" ;
    chart:title "Share of respondents who had set up their own social network profile in the United Kingdom (UK) from 2007 to 2019" ;
    chart:xAxis ex:x-262 ;
    chart:yAxis ex:y-262 .

ex:x-262 a chart:Axis ;
    chart:label "Response" ;
    chart:scaleMin "2007" ;
    chart:scaleMax "2019" .

ex:y-262 a chart:Axis ;
    chart:label "Share of respondents" ;
    chart:scaleMin "0.0" ;
    chart:scaleMax "0.9" .

ex:series-262-1 a chart:Series .

ex:point-262-1-1 a chart:Point ;
    chart:series ex:series-262-1 ;
    chart:xVal "2007" ;
    chart:yVal "0.2"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-262-1-2 a chart:Point ;
    chart:series ex:series-262-1 ;
    chart:xVal "2008" ;
    chart:yVal "0.3"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-262-1-3 a chart:Point ;
    chart:series ex:series-262-1 ;
    chart:xVal "2009" ;
    chart:yVal "0.4"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

