ex:chart-4401 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "India : National debt from 2014 to 2024" ;
    chart:subtitle "(in billion U.S. dollars)" ;
    chart:xAxis ex:x-4401 ;
    chart:yAxis ex:y-4401 .

ex:x-4401 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2014" ;
    chart:scaleMax "2024*" .

ex:y-4401 a chart:Axis ;
