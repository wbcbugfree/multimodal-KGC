@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-4565 a chart:Chart ;
    chart:chartType "bar" ;
    chart:xAxis ex:x-4565 ;
    chart:yAxis ex:y-4565 ;
    chart:title "U.S. states with the lowest cancer incidence rates in 2016 (per 100,000 population)" .

ex:x-4565 a chart:Axis ;
    chart:label "Cancer incidence per 100,000 population" ;
    chart:scaleMin "0" ;
    chart:scaleMax "400" .

ex:y-4565 a chart:Axis ;
    chart:label "State" ;
    chart:scaleMin "" ;
    chart:scaleMax "" .

ex:series-4565-1 a chart:Series .

ex:mark-4565-1-1 a chart:Bar ;
    chart:series ex:series-4565-1 ;
    chart:category "Arizona" ;
    chart:value "370"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

