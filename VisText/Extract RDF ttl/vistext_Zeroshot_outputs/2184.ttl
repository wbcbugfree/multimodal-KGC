@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-2184 a chart:Chart ;
    chart:chartType "area" ;
    chart:title "Angola : Birth rate from 2008 to 2018 (per 1,000 inhabitants)" ;
    chart:xAxis ex:x-2184 ;
    chart:yAxis ex:y-2184 .

ex:x-2184 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2008" ;
    chart:scaleMax "2018" .

ex:y-2184 a chart:Axis ;
    chart:label "Birth rate per thousand population" ;
    chart:scaleMin "0" ;
    chart:scaleMax "50" .

ex:series-2184-1 a chart:Series .

ex:point-2184-1-1 a chart:Point ;
    chart:series ex:series-2184-1 ;
    chart:xVal "2008" ;
    chart:yVal "47.0"^^xsd:decimal ;
    chart:valueEstimated "false"^^xsd:boolean .

ex:point-2184-1-2 a chart:Point ;
    chart:series ex:series-2184-1 ;
    chart:xVal "2010" ;
    chart:yVal "46.0"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-2184-1-3 a chart:Point ;
    chart:series ex:series-2184-1 ;
    chart:xVal "2012" ;
    chart:yVal "45.0"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-2184-1-4 a chart:Point ;
    chart:series ex:series-2184-1 ;
    chart:xVal "2014" ;
    chart:yVal "44.0"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-2184-1-5 a chart:Point ;
    chart:series ex:series-2184-1 ;
    chart:xVal "2016" ;
    chart:yVal "43.0"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-2184-1-6 a chart:Point ;
    chart:series ex:series-2184-1 ;
    chart:xVal "2018" ;
    chart:yVal "42.0"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .
