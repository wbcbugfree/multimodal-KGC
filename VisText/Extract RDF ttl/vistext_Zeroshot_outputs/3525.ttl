@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-3525 a chart:Chart ;
    chart:chartType "bar" ;
    chart:xAxis ex:x-3525 ;
    chart:yAxis ex:y-3525 ;
    chart:title "Change in U.S. commercial air carriers ' revenue passenger miles (RPM) for Atlantic flights from 2011 to 2040" .

ex:x-3525 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "" ;
    chart:scaleMax "" .

ex:y-3525 a chart:Axis ;
    chart:label "Annual growth" ;
    chart:scaleMin "-0.04" ;
    chart:scaleMax "0.08" .

ex:series-3525-1 a chart:Series .

ex:mark-3525-1-1 a chart:Bar ;
    chart:series ex:series-3525-1 ;
    chart:category "2011" ;
    chart:value "0.028"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

