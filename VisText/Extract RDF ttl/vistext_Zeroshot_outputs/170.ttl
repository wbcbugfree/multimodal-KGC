@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-170 a chart:Chart ;
    chart:chartType "area" ;
    chart:title "Laos : Infant mortality rate from 2009 to 2019 (in deaths per 1,000 live births)" ;
    chart:xAxis ex:x-170 ;
    chart:yAxis ex:y-170 .

ex:x-170 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2010" ;
    chart:scaleMax "2018" .

ex:y-170 a chart:Axis ;
    chart:label "Deaths per 1,000 live births" ;
    chart:scaleMin "0" ;
    chart:scaleMax "50" .

ex:series-170-1 a chart:Series .

ex:point-170-1-1 a chart:Point ;
    chart:series ex:series-170-1 ;
    chart:xVal "2010" ;
    chart:yVal "52"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-170-1-2 a chart:Point ;
    chart:series ex:series-170-1 ;
    chart:xVal "2012" ;
    chart:yVal "47"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-170-1-3 a chart:Point ;
    chart:series ex:series-170-1 ;
    chart:xVal "2014" ;
    chart:yVal "43"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-170-1-4 a chart:Point ;
    chart:series ex:series-170-1 ;
    chart:xVal "2016" ;
    chart:yVal "40"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-170-1-5 a chart:Point ;
    chart:series ex:series-170-1 ;
    chart:xVal "2018" ;
    chart:yVal "37"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .
