@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-1550 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Costa Rica : National debt from 2015 to 2025 in relation to gross domestic product (GDP)" ;
    chart:xAxis ex:x-1550 ;
    chart:yAxis ex:y-1550 .

ex:x-1550 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2015" ;
    chart:scaleMax "2025*" .

ex:y-1550 a chart:Axis ;
    chart:label "National debt in relation to GDP" ;
    chart:scaleMin "0.0" ;
    chart:scaleMax "0.8" .

ex:series-1550-1 a chart:Series .

ex:mark-1550-1-1 a chart:Bar ;
    chart:series ex:series-1550-1 ;
    chart:category "2015" ;
    chart:value "0.4"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:mark-1550-1-2 a chart:Bar ;
    chart:series ex:series-1550-1 ;
    chart:category "2016" ;
    chart:value "0.43"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

