ex:chart-1515 a chart:Chart ;
    chart:chartType "bar" ;
    chart:xAxis ex:x-1515 ;
    chart:yAxis ex:y-1515 ;
    chart:title "Average expenditure per person per week on food and drink in the United Kingdom (UK) from 2006 to 2018/2019 (in pence)" .

ex:x-1515 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2006" ;
    chart:scaleMax "2018/2019" .

ex:y-1515 a chart:Axis ;
    chart:label "Average expenditure in British pence sterling" ;
    chart:scaleMin "0" ;
    chart:scaleMax "5,000" .

ex:series-1515-1 a chart:Series .

