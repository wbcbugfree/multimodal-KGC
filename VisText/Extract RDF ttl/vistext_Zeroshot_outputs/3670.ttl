ex:chart-3670 a chart:Chart ;
    chart:chartType "line" ;
    chart:title "Value of alcoholic beverage exports from Sweden from 2009 to 2019 (in 1,000 SEK)" ;
    chart:xAxis ex:x-3670 ;
    chart:yAxis ex:y-3670 .

ex:x-3670 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2008" ;
    chart:scaleMax "2020" .

ex:y-3670 a chart:Axis ;
    chart:label "Export value in thousand SEK" ;
    chart:scaleMin "0" ;
    chart:scaleMax "7000000" .

ex:series-3670-1 a chart:Series ;
    chart:seriesName "Export value" .

ex:point-3670-1-1 a chart:Point ;
    chart:series ex:series-3670-1 ;
    chart:xVal "2009" ;
    chart:yVal "6500000"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

