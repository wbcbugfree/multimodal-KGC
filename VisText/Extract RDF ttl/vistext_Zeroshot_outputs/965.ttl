@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-965 a chart:Chart ;
    chart:chartType "line" ;
    chart:title "Anaheim Ducks franchise value from 2006 to 2019 (in million U.S. dollars)" ;
    chart:subtitle "Franchise value in million U.S. dollars" ;
    chart:xAxis ex:x-965 ;
    chart:yAxis ex:y-965 .

ex:x-965 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2006" ;
    chart:scaleMax "2018" .

ex:y-965 a chart:Axis ;
    chart:label "Franchise value in million U.S. dollars" ;
    chart:scaleMin "0" ;
    chart:scaleMax "500" .

ex:series-965-1 a chart:Series .

ex:point-965-1-1 a chart:Point ;
    chart:series ex:series-965-1 ;
    chart:xVal "2006" ;
    chart:yVal "150"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

