ex:chart-1314 a chart:Chart ;
    chart:chartType "line" ;
    chart:xAxis ex:x-1314 ;
    chart:yAxis ex:y-1314 ;
    chart:title "Number of Volkswagen Golf registered cars in Great Britain from 2000 to 2018" .

ex:x-1314 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2000" ;
    chart:scaleMax "2018" .

ex:y-1314 a chart:Axis ;
    chart:label "Number of registered cars" ;
    chart:scaleMin "0" ;
    chart:scaleMax "1000000" .

ex:series-1314-1 a chart:Series .

