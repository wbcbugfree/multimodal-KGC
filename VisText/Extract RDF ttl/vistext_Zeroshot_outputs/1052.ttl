@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-1052 a chart:Chart ;
    chart:chartType "line" ;
    chart:xAxis ex:x-1052 ;
    chart:yAxis ex:y-1052 ;
    chart:title "Commercial vehicle sales in Canada from 2005 to 2019 (in 1,000 units)" .

ex:x-1052 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2005" ;
    chart:scaleMax "2019" .

ex:y-1052 a chart:Axis ;
    chart:label "Commercial vehicle sales in thousand units" ;
    chart:scaleMin "0" ;
    chart:scaleMax "1500" .

ex:series-1052-1 a chart:Series .

ex:point-1052-1-1 a chart:Point ;
    chart:series ex:series-1052-1 ;
    chart:xVal "2005" ;
    chart:yVal "750"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

