@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-8105 a chart:Chart ;
    chart:chartType "bar" ;
    chart:xAxis ex:x-8105 ;
    chart:yAxis ex:y-8105 ;
    chart:title "Monthly year-over-year retail sales development in the United States from 2019 to 2020 ," ;
    chart:subtitle "by sector" .

ex:x-8105 a chart:Axis ;
    chart:label "Month" ;
    chart:scaleMin "Apr19" ;
    chart:scaleMax "Oct20" .

ex:y-8105 a chart:Axis ;
    chart:label "Sporting goods stores" ;
    chart:scaleMin "-0.4" ;
    chart:scaleMax "0.2" .

ex:series-8105-1 a chart:Series .

ex:mark-8105-1-1 a chart:Bar ;
    chart:series ex:series-8105-1 ;
    chart:category "Apr19" ;
    chart:value "-0.05"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

