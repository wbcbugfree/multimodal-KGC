@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-4843 a chart:Chart ;
    chart:chartType "line" ;
    chart:title "Average consumer spending on Super Bowl Sunday in the United States from 2011 to 2020 (in U.S. dollars)" ;
    chart:xAxis ex:x-4843 ;
    chart:yAxis ex:y-4843 .

ex:x-4843 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2011" ;
    chart:scaleMax "2020" .

ex:y-4843 a chart:Axis ;
    chart:label "Planned spending in U.S. dollars" ;
    chart:scaleMin "0" ;
    chart:scaleMax "100" .

ex:series-4843-1 a chart:Series .

ex:point-4843-1-1 a chart:Point ;
    chart:series ex:series-4843-1 ;
    chart:xVal "2011" ;
    chart:yVal "72"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-4843-1-2 a chart:Point ;
    chart:series ex:series-4843-1 ;
    chart:xVal "2012" ;
    chart:yVal "80"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

