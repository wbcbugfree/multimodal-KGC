ex:chart-2696 a chart:Chart ;
    chart:chartType "area" ;
    chart:xAxis ex:x-2696 ;
    chart:yAxis ex:y-2696 ;
    chart:title "Laos : Fertility rate from 2008 to 2018" .

ex:x-2696 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2008" ;
    chart:scaleMax "2018" .

ex:y-2696 a chart:Axis ;
    chart:label "Number of children born per woman" ;
    chart:scaleMin "0.0" ;
    chart:scaleMax "3.5" .

ex:series-2696-1 a chart:Series .

ex:point-2696-1-1 a chart:Point ;
    chart:series ex:series-2696-1 ;
    chart:xVal "2008" ;
    chart:yVal "3.3"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-2696-1-2 a chart:Point ;
    chart:series ex:series-2696-1 ;
    chart:xVal "2010" ;
    chart:yVal "3.2"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-2696-1-3 a chart:Point ;
    chart:series ex:series-2696-1 ;
    chart:xVal "2012" ;
    chart:yVal "3.1"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-2696-1-4 a chart:Point ;
    chart:series ex:series-2696-1 ;
    chart:xVal "2014" ;
    chart:yVal "3.0"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-2696-1-5 a chart:Point ;
    chart:series ex:series-2696-1 ;
    chart:xVal "2016" ;
    chart:yVal "2.9"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-2696-1-6 a chart:Point ;
    chart:series ex:series-2696-1 ;
    chart:xVal "2018" ;
    chart:yVal "2.8"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .
