@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-7048 a chart:Chart ;
    chart:chartType "area" ;
    chart:title "Revenue of the InterContinental Hotels Group (IHG) from 2008 to 2019 , by hotel ownership type (in million U.S. dollars)" ;
    chart:xAxis ex:x-7048 ;
    chart:yAxis ex:y-7048 .

ex:x-7048 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2008" ;
    chart:scaleMax "2018" .

ex:y-7048 a chart:Axis ;
    chart:label "Franchised hotels" ;
    chart:scaleMin "0" ;
    chart:scaleMax "1000" .

ex:series-7048-1 a chart:Series .

ex:point-7048-1-1 a chart:Point ;
    chart:series ex:series-7048-1 ;
    chart:xVal "2008" ;
    chart:yVal "620"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-7048-1-2 a chart:Point ;
    chart:series ex:series-7048-1 ;
    chart:xVal "2010" ;
    chart:yVal "550"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-7048-1-3 a chart:Point ;
    chart:series ex:series-7048-1 ;
    chart:xVal "2012" ;
    chart:yVal "600"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-7048-1-4 a chart:Point ;
    chart:series ex:series-7048-1 ;
    chart:xVal "2014" ;
    chart:yVal "700"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-7048-1-5 a chart:Point ;
    chart:series ex:series-7048-1 ;
    chart:xVal "2016" ;
    chart:yVal "820"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-7048-1-6 a chart:Point ;
    chart:series ex:series-7048-1 ;
    chart:xVal "2018" ;
    chart:yVal "920"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .
