@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-2853 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Percentage of underweight adolescent girls in selected countries in 2011" ;
    chart:xAxis ex:x-2853 ;
    chart:yAxis ex:y-2853 .

ex:x-2853 a chart:Axis ;
    chart:label "Percentage of adolescent girls" ;
    chart:scaleMin "0.0" ;
    chart:scaleMax "0.5" .

ex:y-2853 a chart:Axis ;
    chart:label "Response" ;
    chart:scaleMin "" ;
    chart:scaleMax "" .

ex:series-2853-1 a chart:Series .

ex:mark-2853-1-1 a chart:Bar ;
    chart:series ex:series-2853-1 ;
    chart:category "Timor-Leste" ;
    chart:value "0.33"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

