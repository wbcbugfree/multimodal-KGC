ex:chart-1358 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Israel : Total population from 2015 to 2025" ;
    chart:subtitle "(in million inhabitants)" ;
    chart:xAxis ex:x-1358 ;
    chart:yAxis ex:y-1358 .

ex:x-1358 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2015" ;
    chart:scaleMax "2025*" .

ex:y-1358 a chart:Axis ;
    chart:label "Inhabitants in millions" ;
    chart:scaleMin "0" ;
    chart:scaleMax "10" .

