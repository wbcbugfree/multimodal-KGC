@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-4407 a chart:Chart ;
    chart:chartType "area" ;
    chart:title "Denver Broncos average regular season home attendance from 2008 to 2019" ;
    chart:xAxis ex:x-4407 ;
    chart:yAxis ex:y-4407 .

ex:x-4407 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2008" ;
    chart:scaleMax "2018" .

ex:y-4407 a chart:Axis ;
    chart:label "Average attendance" ;
    chart:scaleMin "0" ;
    chart:scaleMax "80000" .

ex:series-4407-1 a chart:Series .

ex:point-4407-1-1 a chart:Point ;
    chart:series ex:series-4407-1 ;
    chart:xVal "2008" ;
    chart:yVal "76000"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

