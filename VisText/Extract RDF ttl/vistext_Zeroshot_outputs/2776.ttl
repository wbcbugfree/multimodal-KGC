@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-2776 a chart:Chart ;
    chart:chartType "line" ;
    chart:xAxis ex:x-2776 ;
    chart:yAxis ex:y-2776 ;
    chart:title "Value of fresh or chilled cabbages and cauliflowers exported by the United Kingdom (UK) from 2001 to 2019 (in 1,000 GBP)" .

ex:x-2776 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2001" ;
    chart:scaleMax "2019" .

ex:y-2776 a chart:Axis ;
    chart:label "Export value in thousand GBP" ;
    chart:scaleMin "0" ;
    chart:scaleMax "15,000" .

ex:series-2776-1 a chart:Series .

ex:point-2776-1-1 a chart:Point ;
    chart:series ex:series-2776-1 ;
    chart:xVal "2001" ;
    chart:yVal "3500"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

