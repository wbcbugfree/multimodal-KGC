@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-749 a chart:Chart ;
    chart:chartType "line" ;
    chart:xAxis ex:x-749 ;
    chart:yAxis ex:y-749 .

ex:x-749 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2010" ;
    chart:scaleMax "2018" .

ex:y-749 a chart:Axis ;
    chart:label "Deaths per 1,000 live births" ;
    chart:scaleMin "0" ;
    chart:scaleMax "30" .

ex:series-749-1 a chart:Series .

ex:point-749-1-1 a chart:Point ;
    chart:series ex:series-749-1 ;
    chart:xVal "2010" ;
    chart:yVal "31.5"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-749-1-2 a chart:Point ;
    chart:series ex:series-749-1 ;
    chart:xVal "2012" ;
    chart:yVal "28.0"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-749-1-3 a chart:Point ;
    chart:series ex:series-749-1 ;
    chart:xVal "2014" ;
    chart:yVal "24.5"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-749-1-4 a chart:Point ;
    chart:series ex:series-749-1 ;
    chart:xVal "2016" ;
    chart:yVal "21.0"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-749-1-5 a chart:Point ;
    chart:series ex:series-749-1 ;
    chart:xVal "2018" ;
    chart:yVal "18.0"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .
