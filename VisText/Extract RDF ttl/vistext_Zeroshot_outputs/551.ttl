@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-551 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "The Complete University Guide 's top twenty universities in the United Kingdom in 2021 , by overall score" ;
    chart:xAxis ex:x-551 ;
    chart:yAxis ex:y-551 .

ex:x-551 a chart:Axis ;
    chart:label "Complete University Guide score" ;
    chart:scaleMin "0.0" ;
    chart:scaleMax "1.0" .

ex:y-551 a chart:Axis ;
    chart:label "higher education institution" ;
    chart:scaleMin "" ;
    chart:scaleMax "" .

ex:series-551-1 a chart:Series .

ex:mark-551-1-1 a chart:Bar ;
    chart:series ex:series-551-1 ;
    chart:category "Durham University" ;
    chart:value "0.93"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

