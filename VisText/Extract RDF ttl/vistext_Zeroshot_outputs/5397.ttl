@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-5397 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Philippines : Total population from 2015 to 2025 (in million inhabitants)" ;
    chart:xAxis ex:x-5397 ;
    chart:yAxis ex:y-5397 .

ex:x-5397 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2015" ;
    chart:scaleMax "2025*" .

ex:y-5397 a chart:Axis ;
    chart:label "Inhabitants in millions" ;
    chart:scaleMin "0" ;
    chart:scaleMax "120" .

ex:series-5397-1 a chart:Series .

ex:mark-5397-1-1 a chart:Bar ;
    chart:series ex:series-5397-1 ;
    chart:category "2015" ;
    chart:value "101.5"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

