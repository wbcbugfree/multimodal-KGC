@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-1746 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "How many of each of the following products or devices , in working order , do you have in your household ?" ;
    chart:xAxis ex:x-1746 ;
    chart:yAxis ex:y-1746 .

ex:x-1746 a chart:Axis ;
    chart:label "Household Device" ;
    chart:scaleMin "" ;
    chart:scaleMax "" .

ex:y-1746 a chart:Axis ;
    chart:label "Average number of devices**" ;
    chart:scaleMin "0" ;
    chart:scaleMax "4" .

ex:series-1746-1 a chart:Series .

ex:mark-1746-1-1 a chart:Bar ;
    chart:series ex:series-1746-1 ;
    chart:category "Audio/Hi-fi system" ;
    chart:value "1"^^xsd:decimal ;
    chart:valueEstimated "false"^^xsd:boolean .

ex:mark-1746-1-2 a chart:Bar ;
    chart:series ex:series-1746-1 ;
    chart:category "Camera/camcorder" ;
    chart:value "0.7"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:mark-1746-1-3 a chart:Bar ;
    chart:series ex:series-1746-1 ;
    chart:category "Cleaning appliances" ;
    chart:value "2.9"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:mark-1746-1-4 a chart:Bar ;
    chart:series ex:series-1746-1 ;
    chart:category "Cooking appliances" ;
    chart:value "3.5"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:mark-1746-1-5 a chart:Bar ;
    chart:series ex:series-1746-1 ;
    chart:category "Games console" ;
    chart:value "1.3"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:mark-1746-1-6 a chart:Bar ;
    chart:series ex:series-1746-1 ;
    chart:category "Mobile phone" ;
    chart:value "2.6"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:mark-1746-1-7 a chart:Bar ;
    chart:series ex:series-1746-1 ;
    chart:category "PC/laptop" ;
    chart:value "2"^^xsd:decimal ;
    chart:valueEstimated "false"^^xsd:boolean .

ex:mark-1746-1-8 a chart:Bar ;
    chart:series ex:series-1746-1 ;
    chart:category "Printer" ;
    chart:value "2.3"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:mark-1746-1-9 a chart:Bar ;
    chart:series ex:series-1746-1 ;
    chart:category "TV" ;
    chart:value "1"^^xsd:decimal ;
    chart:valueEstimated "false"^^xsd:boolean .

ex:mark-1746-1-10 a chart:Bar ;
    chart:series ex:series-1746-1 ;
    chart:category "Tablet device" ;
    chart:value "0.9"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:mark-1746-1-11 a chart:Bar ;
    chart:series ex:series-1746-1 ;
    chart:category "Video player" ;
    chart:value "1.2"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .
