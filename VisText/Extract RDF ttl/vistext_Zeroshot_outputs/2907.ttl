@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-2907 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Annual consumption volume of tomatoes in Austria from 2008/09 to 2017/18 (in tonnes)" ;
    chart:xAxis ex:x-2907 ;
    chart:yAxis ex:y-2907 .

ex:x-2907 a chart:Axis ;
    chart:label "Consumption volume in tonnes" ;
    chart:scaleMin "0" ;
    chart:scaleMax "250000" .

ex:y-2907 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "" ;
    chart:scaleMax "" .

ex:series-2907-1 a chart:Series .

ex:mark-2907-1-1 a chart:Bar ;
    chart:series ex:series-2907-1 ;
    chart:category "2017/18" ;
    chart:value "220000"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

