@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-6044 a chart:Chart ;
    chart:chartType "bar" ;
    chart:xAxis ex:x-6044 ;
    chart:yAxis ex:y-6044 ;
    chart:title "Amount of U.S. tea imports from selected countries of origin in 2018 (in 1,000 metric tons)" .

ex:x-6044 a chart:Axis ;
    chart:label "2018" ;
    chart:scaleMin "0" ;
    chart:scaleMax "40,000" .

ex:y-6044 a chart:Axis ;
    chart:label "Country" ;
    chart:scaleMin "" ;
    chart:scaleMax "" .

ex:series-6044-1 a chart:Series .

ex:mark-6044-1-1 a chart:Bar ;
    chart:series ex:series-6044-1 ;
    chart:category "Argentina" ;
    chart:value "47000"^^xsd:decimal ;
    chart:valueEstimated "false"^^xsd:boolean .

