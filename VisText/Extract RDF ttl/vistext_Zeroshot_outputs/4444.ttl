ex:chart-4444 a chart:Chart ;
    chart:chartType "line" ;
    chart:title "Number of arrivals in tourist accommodation" ;
    chart:subtitle "in Hungary from 2006 to 2017 (in millions)" ;
    chart:xAxis ex:x-4444 ;
    chart:yAxis ex:y-4444 .

ex:x-4444 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2006" ;
    chart:scaleMax "2017" .

ex:y-4444 a chart:Axis ;
    chart:label "Number of arrivals in millions" ;
    chart:scaleMin "0" ;
    chart:scaleMax "12" .

ex:series-4444-1 a chart:Series ;
    chart:seriesName "Number of arrivals" .

ex:point-4444-1-1 a chart:Point ;
    chart:series ex:series-4444-1 ;
    chart:xVal "2006" ;
    chart:yVal "7.2"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

