@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-1673 a chart:Chart ;
    chart:chartType "area" ;
    chart:xAxis ex:x-1673 ;
    chart:yAxis ex:y-1673 ;
    chart:title "Property insurance gross written premiums" ;
    chart:subtitle "in the United Kingdom (UK) from 2004 to 2018" .

ex:x-1673 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2004" ;
    chart:scaleMax "2016" .

ex:y-1673 a chart:Axis ;
    chart:label "Gross written premiums in million euros*" ;
    chart:scaleMin "0" ;
    chart:scaleMax "25000" .

ex:series-1673-1 a chart:Series .

ex:point-1673-1-1 a chart:Point ;
    chart:series ex:series-1673-1 ;
    chart:xVal "2004" ;
    chart:yVal "19500"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

