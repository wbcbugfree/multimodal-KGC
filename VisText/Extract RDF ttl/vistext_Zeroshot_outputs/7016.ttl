@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-7016 a chart:Chart ;
    chart:chartType "bar" ;
    chart:xAxis ex:x-7016 ;
    chart:yAxis ex:y-7016 ;
    chart:title "Monthly sales of cookies , confectionery and snack foods at large retailers in Canada from January 2015 to April 2019 (in million Canadian dollars)" .

ex:x-7016 a chart:Axis ;
    chart:label "2016" ;
    chart:scaleMin "0" ;
    chart:scaleMax "500" .

ex:y-7016 a chart:Axis ;
    chart:label "Month" ;
    chart:scaleMin "" ;
    chart:scaleMax "" .

ex:series-7016-1 a chart:Series .

ex:mark-7016-1-1 a chart:Bar ;
    chart:series ex:series-7016-1 ;
    chart:category "Apr" ;
    chart:value "350"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

