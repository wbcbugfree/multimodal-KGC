@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-4070 a chart:Chart ;
    chart:chartType "area" ;
    chart:title "New York Knicks franchise value from 2003 to 2020 (in million U.S. dollars)" ;
    chart:xAxis ex:x-4070 ;
    chart:yAxis ex:y-4070 .

ex:x-4070 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2003" ;
    chart:scaleMax "2020" .

ex:y-4070 a chart:Axis ;
    chart:label "Franchise value in million U.S. dollars" ;
    chart:scaleMin "0" ;
    chart:scaleMax "5000" .

ex:series-4070-1 a chart:Series .

ex:point-4070-1-1 a chart:Point ;
    chart:series ex:series-4070-1 ;
    chart:xVal "2003" ;
    chart:yVal "350"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-4070-1-2 a chart:Point ;
    chart:series ex:series-4070-1 ;
    chart:xVal "2005" ;
    chart:yVal "450"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

