    chart:scaleMin "1999" ;
    chart:scaleMax "2020" .

ex:y-4980 a chart:Axis ;
    chart:label "Unemployment rate" ;
    chart:scaleMin "0.00" ;
    chart:scaleMax "0.04" .

ex:series-4980-1 a chart:Series .

