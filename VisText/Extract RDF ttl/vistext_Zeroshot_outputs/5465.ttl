ex:chart-5465 a chart:Chart ;
    chart:chartType "line" ;
    chart:xAxis ex:x-5465 ;
    chart:yAxis ex:y-5465 ;
    chart:title "Average annual food away-from-home expenditures of United States households from 2010 to 2019 (in U.S. dollars)" .

ex:x-5465 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2010" ;
    chart:scaleMax "2018" .

ex:y-5465 a chart:Axis ;
    chart:label "Expenditure in U.S. dollars" ;
    chart:scaleMin "0" ;
    chart:scaleMax "4000" .

ex:series-5465-1 a chart:Series .

