@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-297 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Natural gas prices for households in the Netherlands from 2010 to 2018 , semi-annually" ;
    chart:subtitle "(in euro cents per kilowatt-hour)" ;
    chart:xAxis ex:x-297 ;
    chart:yAxis ex:y-297 .

ex:x-297 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "" ;
    chart:scaleMax "" .

ex:y-297 a chart:Axis ;
    chart:label "Euro cents per kilowatt-hour" ;
    chart:scaleMin "0" ;
    chart:scaleMax "9" .

ex:series-297-1 a chart:Series .

ex:mark-297-1-1 a chart:Bar ;
    chart:series ex:series-297-1 ;
    chart:category "2010 S1" ;
    chart:value "6.3"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

