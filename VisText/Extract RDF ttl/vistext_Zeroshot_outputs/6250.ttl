@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-6250 a chart:Chart ;
    chart:chartType "bar" ;
    chart:xAxis ex:x-6250 ;
    chart:yAxis ex:y-6250 ;
    chart:title "Gross gambling yield (GGY) of the gambling industry in Great Britain (GB) from 2009 to 2019 , by sector (in million GBP)" .

ex:x-6250 a chart:Axis ;
    chart:label "Month" ;
    chart:scaleMin "" ;
    chart:scaleMax "" .

ex:y-6250 a chart:Axis ;
    chart:label "Bingo" ;
    chart:scaleMin "0" ;
    chart:scaleMax "800" .

ex:series-6250-1 a chart:Series .

ex:mark-6250-1-1 a chart:Bar ;
    chart:series ex:series-6250-1 ;
    chart:category "Apr 09 - Mar 10" ;
    chart:value "608"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

