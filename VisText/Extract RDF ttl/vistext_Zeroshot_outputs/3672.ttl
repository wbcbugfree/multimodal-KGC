@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-3672 a chart:Chart ;
    chart:chartType "area" ;
    chart:title "Greenhouse gas emissions of the agricultural sector in Finland in selected years from 1990 to 2017 (in million tons of CO2 equivalent)" ;
    chart:subtitle "Emissions in million tons of CO2" ;
    chart:xAxis ex:x-3672 ;
    chart:yAxis ex:y-3672 .

ex:x-3672 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "1990" ;
    chart:scaleMax "2017" .

ex:y-3672 a chart:Axis ;
    chart:label "Emissions in million tons of CO2" ;
    chart:scaleMin "0" ;
    chart:scaleMax "8" .

ex:series-3672-1 a chart:Series .

ex:point-3672-1-1 a chart:Point ;
    chart:series ex:series-3672-1 ;
    chart:xVal "1990" ;
    chart:yVal "7.3"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-3672-1-2 a chart:Point ;
    chart:series ex:series-3672-1 ;
    chart:xVal "2000" ;
    chart:yVal "6.4"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-3672-1-3 a chart:Point ;
    chart:series ex:series-3672-1 ;
    chart:xVal "2010" ;
    chart:yVal "6.4"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-3672-1-4 a chart:Point ;
    chart:series ex:series-3672-1 ;
    chart:xVal "2017" ;
    chart:yVal "6.4"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .
