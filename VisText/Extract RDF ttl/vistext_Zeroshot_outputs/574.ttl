    chart:valueEstimated "true"^^xsd:boolean .

ex:mark-574-1-7 a chart:Bar ;
    chart:series ex:series-574-1 ;
    chart:category "2014 *" ;
    chart:value "15"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:mark-574-1-8 a chart:Bar ;
    chart:series ex:series-574-1 ;
    chart:category "2015 *" ;
