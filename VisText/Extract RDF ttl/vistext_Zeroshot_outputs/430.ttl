ex:chart-430 a chart:Chart ;
    chart:chartType "bar" ;
    chart:xAxis ex:x-430 ;
    chart:yAxis ex:y-430 ;
    chart:title "Cancer mortality rate among men in selected countries worldwide between 2003 and 2007 (per 100,000 population)" .

ex:x-430 a chart:Axis ;
    chart:label "Mortality rate per 100,000 population" ;
    chart:scaleMin "0" ;
    chart:scaleMax "200" .

ex:y-430 a chart:Axis ;
    chart:label "Country" ;
    chart:scaleMin "" ;
    chart:scaleMax "" .

ex:series-430-1 a chart:Series ;
    chart:seriesName "Cancer mortality rate" .

ex:mark-430-1-1 a chart:Bar ;
    chart:series ex:series-430-1 ;
    chart:category "Australia" ;
    chart:value "130"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

