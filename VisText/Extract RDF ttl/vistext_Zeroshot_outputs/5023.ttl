@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-5023 a chart:Chart ;
    chart:chartType "bar" ;
    chart:xAxis ex:x-5023 ;
    chart:yAxis ex:y-5023 ;
    chart:title "Sponsorship worth of professional tennis players worldwide as of July 2019 (in million U.S. dollars)" .

ex:x-5023 a chart:Axis ;
    chart:label "Sponsorship worth in million U.S. dollars" ;
    chart:scaleMin "0" ;
    chart:scaleMax "90" .

ex:y-5023 a chart:Axis ;
    chart:label "player" ;
    chart:scaleMin "" ;
    chart:scaleMax "" .

ex:series-5023-1 a chart:Series ;
    chart:seriesName "player" .

ex:mark-5023-1-1 a chart:Bar ;
    chart:series ex:series-5023-1 ;
    chart:category "Angelique Kerber" ;
    chart:value "3"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

