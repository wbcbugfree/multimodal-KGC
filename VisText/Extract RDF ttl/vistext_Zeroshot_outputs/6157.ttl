@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-6157 a chart:Chart ;
    chart:chartType "line" ;
    chart:title "Unit shipments of electric/gas cooking appliances in the U.S. from 2007 to 2017 (in 1,000s)" ;
    chart:xAxis ex:x-6157 ;
    chart:yAxis ex:y-6157 .

ex:x-6157 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2007" ;
    chart:scaleMax "2017" .

ex:y-6157 a chart:Axis ;
    chart:label "" ;
    chart:scaleMin "0" ;
    chart:scaleMax "800" .

ex:series-6157-1 a chart:Series ;
    chart:seriesName "Electric ovens" .

ex:point-6157-1-1 a chart:Point ;
    chart:series ex:series-6157-1 ;
    chart:xVal "2007" ;
    chart:yVal "820"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-6157-1-2 a chart:Point ;
    chart:series ex:series-6157-1 ;
    chart:xVal "2008" ;
    chart:yVal "500"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

