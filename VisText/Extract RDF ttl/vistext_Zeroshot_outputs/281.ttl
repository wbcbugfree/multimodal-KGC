@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-281 a chart:Chart ;
    chart:chartType "bar" ;
    chart:xAxis ex:x-281 ;
    chart:yAxis ex:y-281 .

ex:x-281 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2006" ;
    chart:scaleMax "2019" .

ex:y-281 a chart:Axis ;
    chart:label "Home attendance" ;
    chart:scaleMin "0" ;
    chart:scaleMax "600000" .

ex:series-281-1 a chart:Series .

ex:mark-281-1-1 a chart:Bar ;
    chart:series ex:series-281-1 ;
    chart:category "2006" ;
    chart:value "580000"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

