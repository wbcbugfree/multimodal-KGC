    chart:xAxis ex:x-5957 ;
    chart:yAxis ex:y-5957 ;
    chart:title "Average ticket price Denver Nuggets games of the NBA from 2006/07 to 2015/16 (in U.S. dollars)" .

ex:x-5957 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "" ;
    chart:scaleMax "" .

ex:y-5957 a chart:Axis ;
    chart:label "Average ticket price in U.S. dollars" ;
    chart:scaleMin "0" ;
    chart:scaleMax "60" .

ex:series-5957-1 a chart:Series .

