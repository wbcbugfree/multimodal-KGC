@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-3824 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Many people have concerns or fears for their retirement . Which , if any , of the following concerns or fears do you have ?" ;
    chart:xAxis ex:x-3824 ;
    chart:yAxis ex:y-3824 .

ex:x-3824 a chart:Axis ;
    chart:label "Fears and concerns" ;
    chart:scaleMin "" ;
    chart:scaleMax "" .

ex:y-3824 a chart:Axis ;
    chart:label "Share of respondents" ;
    chart:scaleMin "0.0" ;
    chart:scaleMax "0.6" .

ex:series-3824-1 a chart:Series .

ex:mark-3824-1-1 a chart:Bar ;
    chart:series ex:series-3824-1 ;
    chart:category "Boredom" ;
    chart:value "0.25"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

