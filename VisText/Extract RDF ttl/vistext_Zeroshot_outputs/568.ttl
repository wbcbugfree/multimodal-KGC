@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-568 a chart:Chart ;
    chart:chartType "line" ;
    chart:title "Number of motor vehicles produced by Fiat worldwide from 2006 to 2016 (in 1,000s units)" ;
    chart:subtitle "Production in thousand units" ;
    chart:xAxis ex:x-568 ;
    chart:yAxis ex:y-568 .

ex:x-568 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2006" ;
    chart:scaleMax "2014" .

ex:y-568 a chart:Axis ;
    chart:label "" ;
    chart:scaleMin "0" ;
    chart:scaleMax "5000" .

ex:series-568-1 a chart:Series .

ex:point-568-1-1 a chart:Point ;
    chart:series ex:series-568-1 ;
    chart:xVal "2006" ;
    chart:yVal "2700"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-568-1-2 a chart:Point ;
    chart:series ex:series-568-1 ;
    chart:xVal "2008" ;
    chart:yVal "3100"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-568-1-3 a chart:Point ;
    chart:series ex:series-568-1 ;
    chart:xVal "2009" ;
    chart:yVal "2950"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-568-1-4 a chart:Point ;
    chart:series ex:series-568-1 ;
    chart:xVal "2010" ;
    chart:yVal "2850"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-568-1-5 a chart:Point ;
    chart:series ex:series-568-1 ;
    chart:xVal "2011" ;
    chart:yVal "2750"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-568-1-6 a chart:Point ;
    chart:series ex:series-568-1 ;
    chart:xVal "2012" ;
    chart:yVal "2350"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-568-1-7 a chart:Point ;
    chart:series ex:series-568-1 ;
    chart:xVal "2013" ;
    chart:yVal "5100"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-568-1-8 a chart:Point ;
    chart:series ex:series-568-1 ;
    chart:xVal "2014" ;
    chart:yVal "5250"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-568-1-9 a chart:Point ;
    chart:series ex:series-568-1 ;
    chart:xVal "2015" ;
    chart:yVal "5200"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-568-1-10 a chart:Point ;
    chart:series ex:series-568-1 ;
    chart:xVal "2016" ;
    chart:yVal "5150"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .
