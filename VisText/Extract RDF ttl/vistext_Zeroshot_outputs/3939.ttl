@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-3939 a chart:Chart ;
    chart:chartType "line" ;
    chart:title "Combined desktop and mobile visits to Walmart.com" ;
    chart:subtitle "from May 2019 to September 2020 (in millions)" ;
    chart:xAxis ex:x-3939 ;
    chart:yAxis ex:y-3939 .

ex:x-3939 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "July" ;
    chart:scaleMax "July" .

ex:y-3939 a chart:Axis ;
    chart:label "Number of visits in millions" ;
    chart:scaleMin "0" ;
    chart:scaleMax "500" .

ex:series-3939-1 a chart:Series .

ex:point-3939-1-1 a chart:Point ;
    chart:series ex:series-3939-1 ;
    chart:xVal "July" ;
    chart:yVal "315"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-3939-1-2 a chart:Point ;
    chart:series ex:series-3939-1 ;
    chart:xVal "October" ;
    chart:yVal "325"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

