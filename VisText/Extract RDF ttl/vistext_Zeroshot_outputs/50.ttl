@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-50 a chart:Chart ;
    chart:chartType "line" ;
    chart:title "Number of hospital beds in Spain from 2010 to 2020" ;
    chart:xAxis ex:x-50 ;
    chart:yAxis ex:y-50 .

ex:x-50 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2010" ;
    chart:scaleMax "2020" .

ex:y-50 a chart:Axis ;
    chart:label "Number of hospital beds" ;
    chart:scaleMin "0" ;
    chart:scaleMax "150000" .

ex:series-50-1 a chart:Series .

ex:point-50-1-1 a chart:Point ;
    chart:series ex:series-50-1 ;
    chart:xVal "2010" ;
    chart:yVal "150000"^^xsd:decimal ;
    chart:valueEstimated "false"^^xsd:boolean .

ex:point-50-1-2 a chart:Point ;
    chart:series ex:series-50-1 ;
    chart:xVal "2012" ;
    chart:yVal "151000"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-50-1-3 a chart:Point ;
    chart:series ex:series-50-1 ;
    chart:xVal "2014" ;
    chart:yVal "150000"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-50-1-4 a chart:Point ;
    chart:series ex:series-50-1 ;
    chart:xVal "2016" ;
    chart:yVal "149000"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-50-1-5 a chart:Point ;
    chart:series ex:series-50-1 ;
    chart:xVal "2018" ;
    chart:yVal "148000"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-50-1-6 a chart:Point ;
    chart:series ex:series-50-1 ;
    chart:xVal "2020" ;
    chart:yVal "147000"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .
