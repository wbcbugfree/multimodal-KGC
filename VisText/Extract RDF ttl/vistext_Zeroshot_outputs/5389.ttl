@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-5389 a chart:Chart ;
    chart:chartType "line" ;
    chart:title "Average issue readership of FourFourTwo magazine in the United Kingdom (UK) from 2006 to 2016 (in 1,000 readers)" ;
    chart:xAxis ex:x-5389 ;
    chart:yAxis ex:y-5389 .

ex:x-5389 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2006" ;
    chart:scaleMax "2014" .

ex:y-5389 a chart:Axis ;
    chart:label "AIR in thousands*" ;
    chart:scaleMin "0" ;
    chart:scaleMax "700" .

ex:series-5389-1 a chart:Series .

ex:point-5389-1-1 a chart:Point ;
    chart:series ex:series-5389-1 ;
    chart:xVal "2006" ;
    chart:yVal "540"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-5389-1-2 a chart:Point ;
    chart:series ex:series-5389-1 ;
    chart:xVal "2007" ;
    chart:yVal "580"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

