@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-3450 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "United States direct investments in the European Union , by industry in 2019 (in billion U.S. dollars)" ;
    chart:xAxis ex:x-3450 ;
    chart:yAxis ex:y-3450 .

ex:x-3450 a chart:Axis ;
    chart:label "industry" ;
    chart:scaleMin "" ;
    chart:scaleMax "" .

ex:y-3450 a chart:Axis ;
    chart:label "Direct investments in billion U.S. dollars" ;
    chart:scaleMin "0" ;
    chart:scaleMax "2000" .

ex:series-3450-1 a chart:Series .

