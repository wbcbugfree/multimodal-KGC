@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-525 a chart:Chart ;
    chart:chartType "bar" ;
    chart:xAxis ex:x-525 ;
    chart:yAxis ex:y-525 ;
    chart:title "Chile : National debt from 2015 to 2025" ;
    chart:subtitle "in relation to gross domestic product (GDP)" .

ex:x-525 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2015" ;
    chart:scaleMax "2025*" .

ex:y-525 a chart:Axis ;
    chart:label "National debt in relation to GDP" ;
    chart:scaleMin "0.0" ;
    chart:scaleMax "0.5" .

ex:series-525-1 a chart:Series .

ex:mark-525-1-1 a chart:Bar ;
    chart:series ex:series-525-1 ;
    chart:category "2015" ;
    chart:value "0.17"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:mark-525-1-2 a chart:Bar ;
    chart:series ex:series-525-1 ;
    chart:category "2016" ;
    chart:value "0.22"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

