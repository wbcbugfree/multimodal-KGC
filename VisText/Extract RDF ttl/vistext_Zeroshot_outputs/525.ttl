    chart:category "2020*" ;
    chart:value "0.37"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:mark-525-1-7 a chart:Bar ;
    chart:series ex:series-525-1 ;
    chart:category "2021*" ;
    chart:value "0.42"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:mark-525-1-8 a chart:Bar ;
