@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-6385 a chart:Chart ;
    chart:chartType "line" ;
    chart:title "Number of TUI AG employees worldwide from 2011 to 2020 , by geographical region" ;
    chart:subtitle "Spain" ;
    chart:xAxis ex:x-6385 ;
    chart:yAxis ex:y-6385 .

ex:x-6385 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2011" ;
    chart:scaleMax "2020" .

ex:y-6385 a chart:Axis ;
    chart:label "" ;
    chart:scaleMin "0" ;
    chart:scaleMax "10000" .

ex:series-6385-1 a chart:Series ;
    chart:seriesName "Spain" .

ex:point-6385-1-1 a chart:Point ;
    chart:series ex:series-6385-1 ;
    chart:xVal "2011" ;
    chart:yVal "9900"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-6385-1-2 a chart:Point ;
    chart:series ex:series-6385-1 ;
    chart:xVal "2012" ;
    chart:yVal "9700"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

