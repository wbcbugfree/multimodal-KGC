@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-1150 a chart:Chart ;
    chart:chartType "area" ;
    chart:xAxis ex:x-1150 ;
    chart:yAxis ex:y-1150 ;
    chart:title "Number of coronavirus (COVID-19) recoveries in Romania as of January 8 , 2021 (in 1,000s)" .

ex:x-1150 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "July" ;
    chart:scaleMax "2021" .

ex:y-1150 a chart:Axis ;
    chart:label "Number of people in thousands" ;
    chart:scaleMin "0" ;
    chart:scaleMax "600" .

ex:series-1150-1 a chart:Series .

ex:point-1150-1-1 a chart:Point ;
    chart:series ex:series-1150-1 ;
    chart:xVal "July" ;
    chart:yVal "0"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-1150-1-2 a chart:Point ;
    chart:series ex:series-1150-1 ;
    chart:xVal "August" ;
    chart:yVal "10"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-1150-1-3 a chart:Point ;
    chart:series ex:series-1150-1 ;
    chart:xVal "September" ;
    chart:yVal "70"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-1150-1-4 a chart:Point ;
    chart:series ex:series-1150-1 ;
    chart:xVal "October" ;
    chart:yVal "100"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-1150-1-5 a chart:Point ;
    chart:series ex:series-1150-1 ;
    chart:xVal "November" ;
    chart:yVal "150"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-1150-1-6 a chart:Point ;
    chart:series ex:series-1150-1 ;
    chart:xVal "December" ;
    chart:yVal "300"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-1150-1-7 a chart:Point ;
    chart:series ex:series-1150-1 ;
    chart:xVal "2021" ;
    chart:yVal "580"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .
