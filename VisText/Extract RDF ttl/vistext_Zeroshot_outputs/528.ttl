ex:chart-528 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "New York Mets all-time RBI (runs batted in) leaders as of October 2020" ;
    chart:xAxis ex:x-528 ;
    chart:yAxis ex:y-528 .

ex:x-528 a chart:Axis ;
    chart:label "Number of home runs" ;
    chart:scaleMin "0" ;
    chart:scaleMax "1000" .

