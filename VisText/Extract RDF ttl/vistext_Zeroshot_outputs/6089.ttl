@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-6089 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Which , if any , of the following measures have you taken in the past 2 weeks specifically to protect yourself from the Coronavirus (COVID-19) ?" ;
    chart:xAxis ex:x-6089 ;
    chart:yAxis ex:y-6089 .

ex:x-6089 a chart:Axis ;
    chart:label "Response" ;
    chart:scaleMin "" ;
    chart:scaleMax "" .

ex:y-6089 a chart:Axis ;
    chart:label "" ;
    chart:scaleMin "0.0" ;
    chart:scaleMax "0.5" .

ex:series-6089-1 a chart:Series .

ex:mark-6089-1-1 a chart:Bar ;
    chart:series ex:series-6089-1 ;
    chart:category "Avoid consumption of raw or unco..." ;
    chart:value "0.05"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:mark-6089-1-2 a chart:Bar ;
    chart:series ex:series-6089-1 ;
    chart:category "Avoid crowded public places" ;
    chart:value "0.12"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:mark-6089-1-3 a chart:Bar ;
    chart:series ex:series-6089-1 ;
    chart:category "Avoid going to work" ;
    chart:value "0.05"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:mark-6089-1-4 a chart:Bar ;
    chart:series ex:series-6089-1 ;
    chart:category "Avoid physical contact with tour..." ;
    chart:value "0.12"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:mark-6089-1-5 a chart:Bar ;
    chart:series ex:series-6089-1 ;
    chart:category "Improve personal hygiene to work" ;
    chart:value "0.33"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:mark-6089-1-6 a chart:Bar ;
    chart:series ex:series-6089-1 ;
    chart:category "No measures taken" ;
    chart:value "0.50"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:mark-6089-1-7 a chart:Bar ;
    chart:series ex:series-6089-1 ;
    chart:category "Refrain from touching objects in p..." ;
    chart:value "0.12"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:mark-6089-1-8 a chart:Bar ;
    chart:series ex:series-6089-1 ;
    chart:category "Wear a face mask in public places" ;
    chart:value "0.05"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .
