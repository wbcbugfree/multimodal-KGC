@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-3570 a chart:Chart ;
    chart:chartType "line" ;
    chart:title "Development of the fertility rate in Germany" ;
    chart:subtitle "from 1990 to 2019" ;
    chart:xAxis ex:x-3570 ;
    chart:yAxis ex:y-3570 .

ex:x-3570 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "1990" ;
    chart:scaleMax "2015" .

ex:y-3570 a chart:Axis ;
    chart:label "Number of children per woman" ;
    chart:scaleMin "0.0" ;
    chart:scaleMax "1.5" .

ex:series-3570-1 a chart:Series .

ex:point-3570-1-1 a chart:Point ;
    chart:series ex:series-3570-1 ;
    chart:xVal "1990" ;
    chart:yVal 1.45 ;
    chart:valueEstimated "false"^^xsd:boolean .

