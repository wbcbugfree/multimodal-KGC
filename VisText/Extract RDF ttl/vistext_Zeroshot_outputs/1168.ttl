@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-1168 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Installed power capacity across Tamil Nadu in India from financial year 2005 to 2018" ;
    chart:subtitle "(in megawatts)" ;
    chart:xAxis ex:x-1168 ;
    chart:yAxis ex:y-1168 .

ex:x-1168 a chart:Axis ;
    chart:label "Financial Year" ;
    chart:scaleMin "FY 2005" ;
    chart:scaleMax "FY 2018" .

ex:y-1168 a chart:Axis ;
    chart:label "Installed power capacity in megawatts" ;
    chart:scaleMin "0" ;
    chart:scaleMax "30,000" .

ex:series-1168-1 a chart:Series .

ex:mark-1168-1-1 a chart:Bar ;
    chart:series ex:series-1168-1 ;
    chart:category "FY 2005" ;
    chart:value "13000"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:mark-1168-1-2 a chart:Bar ;
    chart:series ex:series-1168-1 ;
    chart:category "FY 2006" ;
    chart:value "14000"^^xsd:decimal ;
