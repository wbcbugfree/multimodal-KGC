ex:chart-331 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "U.S. grapefruit production from 1999/2000" ;
    chart:subtitle "to 2018/2019 (in 1,000 boxes)" ;
    chart:xAxis ex:x-331 ;
    chart:yAxis ex:y-331 .

ex:x-331 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "1999/2000" ;
    chart:scaleMax "2018/2019" .

ex:y-331 a chart:Axis ;
    chart:label "Production in thousand boxes" ;
    chart:scaleMin "0" ;
    chart:scaleMax "60,000" .

ex:series-331-1 a chart:Series .

ex:mark-331-1-1 a chart:Bar ;
    chart:series ex:series-331-1 ;
    chart:category "1999/2000" ;
    chart:value "63000"^^xsd:decimal ;
    chart:valueEstimated "false"^^xsd:boolean .

