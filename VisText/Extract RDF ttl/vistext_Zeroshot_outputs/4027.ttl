@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-4027 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Leading countries for mHealth app publication in Europe 2015" ;
    chart:xAxis ex:x-4027 ;
    chart:yAxis ex:y-4027 .

ex:x-4027 a chart:Axis ;
    chart:label "Share of mHealth app publishers" ;
    chart:scaleMin "0.0" ;
    chart:scaleMax "0.5" .

ex:y-4027 a chart:Axis ;
    chart:label "Response" ;
    chart:scaleMin "" ;
    chart:scaleMax "" .

ex:series-4027-1 a chart:Series .

ex:mark-4027-1-1 a chart:Bar ;
    chart:series ex:series-4027-1 ;
    chart:category "Austria" ;
    chart:value "0.05"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

