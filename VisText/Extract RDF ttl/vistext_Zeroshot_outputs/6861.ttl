ex:chart-6861 a chart:Chart ;
    chart:chartType "area" ;
    chart:xAxis ex:x-6861 ;
    chart:yAxis ex:y-6861 ;
    chart:title "Imagine the State Duma elections are taking place next Sunday . Which party would you vote for ?"@en .

ex:x-6861 a chart:Axis ;
    chart:label "Response"@en ;
    chart:scaleMin "April" ;
    chart:scaleMax "October" .

ex:y-6861 a chart:Axis ;
    chart:label "LDPR Liberal-Democratic Party of Russia"@en ;
    chart:scaleMin "0.00" ;
    chart:scaleMax "0.12" .

ex:series-6861-1 a chart:Series .

