ex:chart-575 a chart:Chart ;
    chart:chartType "line" ;
    chart:title "Number of recreational visitors to the Grand Canyon National Park in the United States from 2008 to 2019 (in millions)" ;
    chart:xAxis ex:x-575 ;
    chart:yAxis ex:y-575 .

ex:x-575 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2008" ;
    chart:scaleMax "2018" .

ex:y-575 a chart:Axis ;
    chart:label "Number of visitors in millions" ;
    chart:scaleMin "0" ;
    chart:scaleMax "6" .

ex:series-575-1 a chart:Series .

ex:point-575-1-1 a chart:Point ;
    chart:series ex:series-575-1 ;
    chart:xVal "2008" ;
    chart:yVal 4.4 ;
    chart:valueEstimated "false"^^xsd:boolean .

