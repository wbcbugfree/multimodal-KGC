ex:chart-6497 a chart:Chart ;
    chart:chartType "area" ;
    chart:title "Year-on-year change of weekly flight frequency of global airlines from January 6 to December 22 , 2020 , by country" ;
    chart:xAxis ex:x-6497 ;
    chart:yAxis ex:y-6497 .

ex:x-6497 a chart:Axis ;
    chart:label "Week starting on" ;
    chart:scaleMin "" ;
    chart:scaleMax "" .

ex:y-6497 a chart:Axis ;
    chart:label "Global" ;
    chart:scaleMin "-0.7" ;
    chart:scaleMax "0.1" .

ex:series-6497-1 a chart:Series .

