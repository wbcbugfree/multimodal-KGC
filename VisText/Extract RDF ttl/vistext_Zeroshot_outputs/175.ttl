ex:chart-175 a chart:Chart ;
    chart:chartType "line" ;
    chart:xAxis ex:x-175 ;
    chart:yAxis ex:y-175 ;
    chart:title "Number of Merck & Co. 's common shares outstanding from 2009 to 2019 (in millions)" .

ex:x-175 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2009" ;
    chart:scaleMax "2019" .

ex:y-175 a chart:Axis ;
    chart:label "Number of shares in millions" ;
    chart:scaleMin "0" ;
    chart:scaleMax "3500" .

ex:series-175-1 a chart:Series .

ex:point-175-1-1 a chart:Point ;
    chart:series ex:series-175-1 ;
    chart:xVal "2009" ;
    chart:yVal "2300"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

