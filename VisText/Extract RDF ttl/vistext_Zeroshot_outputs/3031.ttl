ex:chart-3031 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Total number of acquired hospitals in U.S. hospital transactions from 2007 to 2017" ;
    chart:xAxis ex:x-3031 ;
    chart:yAxis ex:y-3031 .

ex:x-3031 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2007" ;
    chart:scaleMax "2017" .

ex:y-3031 a chart:Axis ;
    chart:label "Number of acquired hospitals" ;
    chart:scaleMin "0" ;
    chart:scaleMax "300" .

ex:series-3031-1 a chart:Series .

ex:mark-3031-1-1 a chart:Bar ;
    chart:series ex:series-3031-1 ;
    chart:category "2007" ;
    chart:value "150"^^xsd:decimal ;
    chart:valueEstimated "false"^^xsd:boolean .

