@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-4081 a chart:Chart ;
    chart:chartType "line" ;
    chart:xAxis ex:x-4081 ;
    chart:yAxis ex:y-4081 ;
    chart:title "Monsanto 's research and development (R & D) expenditure from 2008 to 2017 (in million U.S. dollars)" .

ex:x-4081 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2008" ;
    chart:scaleMax "2016" .

ex:y-4081 a chart:Axis ;
    chart:label "Expenditure in million U.S. dollars" ;
    chart:scaleMin "0" ;
    chart:scaleMax "1500" .

ex:series-4081-1 a chart:Series .

ex:point-4081-1-1 a chart:Point ;
    chart:series ex:series-4081-1 ;
    chart:xVal "2008" ;
    chart:yVal "875"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-4081-1-2 a chart:Point ;
    chart:series ex:series-4081-1 ;
    chart:xVal "2009" ;
    chart:yVal "1050"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-4081-1-3 a chart:Point ;
    chart:series ex:series-4081-1 ;
    chart:xVal "2010" ;
    chart:yVal "1150"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-4081-1-4 a chart:Point ;
    chart:series ex:series-4081-1 ;
    chart:xVal "2011" ;
    chart:yVal "1400"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-4081-1-5 a chart:Point ;
    chart:series ex:series-4081-1 ;
    chart:xVal "2012" ;
    chart:yVal "1450"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-4081-1-6 a chart:Point ;
    chart:series ex:series-4081-1 ;
    chart:xVal "2013" ;
    chart:yVal "1575"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-4081-1-7 a chart:Point ;
    chart:series ex:series-4081-1 ;
    chart:xVal "2014" ;
    chart:yVal "1475"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-4081-1-8 a chart:Point ;
