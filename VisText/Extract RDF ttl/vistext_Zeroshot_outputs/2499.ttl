ex:chart-2499 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Number of road traffic fatalities in Greece" ;
    chart:subtitle "from 2006 to 2019" ;
    chart:xAxis ex:x-2499 ;
    chart:yAxis ex:y-2499 .

ex:x-2499 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2006" ;
    chart:scaleMax "2019*" .

ex:y-2499 a chart:Axis ;
    chart:label "Number of fatalities" ;
    chart:scaleMin "0" ;
    chart:scaleMax "1750" .

ex:series-2499-1 a chart:Series .

