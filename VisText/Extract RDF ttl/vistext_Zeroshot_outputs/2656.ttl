    chart:title "Number of arriving and departing local passengers in the leading French airports in 2016" ;
    chart:xAxis ex:x-2656 ;
    chart:yAxis ex:y-2656 .

ex:x-2656 a chart:Axis ;
    chart:label "Number of local passengers" ;
    chart:scaleMin "0" ;
    chart:scaleMax "60,000,000" .

ex:y-2656 a chart:Axis ;
