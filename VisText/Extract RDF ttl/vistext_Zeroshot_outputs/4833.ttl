@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-4833 a chart:Chart ;
    chart:chartType "line" ;
    chart:title "Annual revenue of Yandex from 2007 to 2019" ;
    chart:subtitle "(in billion Russian rubles)" ;
    chart:xAxis ex:x-4833 ;
    chart:yAxis ex:y-4833 .

ex:x-4833 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2007" ;
    chart:scaleMax "2019" .

ex:y-4833 a chart:Axis ;
    chart:label "Revenue in billion Russian rubles" ;
    chart:scaleMin "0" ;
    chart:scaleMax "150" .

ex:series-4833-1 a chart:Series .

ex:point-4833-1-1 a chart:Point ;
    chart:series ex:series-4833-1 ;
    chart:xVal "2007" ;
    chart:yVal "5"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-4833-1-2 a chart:Point ;
    chart:series ex:series-4833-1 ;
    chart:xVal "2008" ;
    chart:yVal "10"^^xsd:decimal ;
