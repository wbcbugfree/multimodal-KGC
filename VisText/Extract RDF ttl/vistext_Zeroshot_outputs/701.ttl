ex:chart-701 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Top 10 therapeutic categories worldwide by number of R & D products in 2020" ;
    chart:xAxis ex:x-701 ;
    chart:yAxis ex:y-701 .

ex:x-701 a chart:Axis ;
    chart:label "Therapeutic category" ;
    chart:scaleMin "" ;
    chart:scaleMax "" .

ex:y-701 a chart:Axis ;
    chart:label "Number of R&D products" ;
    chart:scaleMin "0" ;
    chart:scaleMax "3500" .

ex:series-701-1 a chart:Series .

ex:mark-701-1-1 a chart:Bar ;
    chart:series ex:series-701-1 ;
    chart:category "Anti-inflammatory" ;
    chart:value "450"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

