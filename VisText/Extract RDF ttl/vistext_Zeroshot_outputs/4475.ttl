@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-4475 a chart:Chart ;
    chart:chartType "area" ;
    chart:xAxis ex:x-4475 ;
    chart:yAxis ex:y-4475 .

ex:x-4475 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2008" ;
    chart:scaleMax "2016" .

ex:y-4475 a chart:Axis ;
    chart:label "Revenues in billion U.S. dollars" ;
    chart:scaleMin "0" ;
    chart:scaleMax "80" .

ex:series-4475-1 a chart:Series .

ex:point-4475-1-1 a chart:Point ;
    chart:series ex:series-4475-1 ;
    chart:xVal "2008" ;
    chart:yVal 49.0 ;
    chart:valueEstimated "false"^^xsd:boolean .

ex:point-4475-1-2 a chart:Point ;
    chart:series ex:series-4475-1 ;
    chart:xVal "2009" ;
    chart:yVal 41.0 ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-4475-1-3 a chart:Point ;
    chart:series ex:series-4475-1 ;
    chart:xVal "2010" ;
    chart:yVal 55.0 ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-4475-1-4 a chart:Point ;
    chart:series ex:series-4475-1 ;
    chart:xVal "2011" ;
    chart:yVal 70.0 ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-4475-1-5 a chart:Point ;
    chart:series ex:series-4475-1 ;
    chart:xVal "2012" ;
    chart:yVal 67.0 ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-4475-1-6 a chart:Point ;
    chart:series ex:series-4475-1 ;
    chart:xVal "2013" ;
    chart:yVal 61.0 ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-4475-1-7 a chart:Point ;
    chart:series ex:series-4475-1 ;
    chart:xVal "2014" ;
    chart:yVal 62.0 ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-4475-1-8 a chart:Point ;
    chart:series ex:series-4475-1 ;
    chart:xVal "2015" ;
    chart:yVal 65.0 ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-4475-1-9 a chart:Point ;
    chart:series ex:series-4475-1 ;
    chart:xVal "2016" ;
    chart:yVal 70.0 ;
    chart:valueEstimated "true"^^xsd:boolean .
