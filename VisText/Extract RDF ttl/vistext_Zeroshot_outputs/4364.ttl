@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-4364 a chart:Chart ;
    chart:chartType "area" ;
    chart:title "Total employment in the United States mining industry from 1998 to 2019 (in 1,000)" ;
    chart:xAxis ex:x-4364 ;
    chart:yAxis ex:y-4364 .

ex:x-4364 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "" ;
    chart:scaleMax "" .

ex:y-4364 a chart:Axis ;
    chart:label "Number of employees in thousands" ;
    chart:scaleMin "0" ;
    chart:scaleMax "900" .

ex:series-4364-1 a chart:Series .

ex:point-4364-1-1 a chart:Point ;
    chart:series ex:series-4364-1 ;
    chart:xVal "1998" ;
    chart:yVal "560"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

