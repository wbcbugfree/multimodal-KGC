ex:chart-1134 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Average game attendance in the Football\nLeague Championship in the United Kingdom\n(UK) from season 2010/2011 to season 2019/2020" ;
    chart:xAxis ex:x-1134 ;
    chart:yAxis ex:y-1134 .

ex:x-1134 a chart:Axis ;
    chart:label "Average attendance" ;
    chart:scaleMin "0" ;
    chart:scaleMax "20000" .

ex:y-1134 a chart:Axis ;
    chart:label "Season" ;
    chart:scaleMin "" ;
    chart:scaleMax "" .

ex:series-1134-1 a chart:Series .

