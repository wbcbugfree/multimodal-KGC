@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-141 a chart:Chart ;
    chart:chartType "bar" ;
    chart:xAxis ex:x-141 ;
    chart:yAxis ex:y-141 ;
    chart:title "Most common baby names of boys in Norway in 2019" .

ex:x-141 a chart:Axis ;
    chart:label "baby names" ;
    chart:scaleMin "" ;
    chart:scaleMax "" .

ex:y-141 a chart:Axis ;
    chart:label "Number of individuals" ;
    chart:scaleMin "0" ;
    chart:scaleMax "400" .

ex:series-141-1 a chart:Series .

ex:mark-141-1-1 a chart:Bar ;
    chart:series ex:series-141-1 ;
    chart:category "Aksel/Axel" ;
    chart:value "300"^^xsd:decimal ;
    chart:valueEstimated "false"^^xsd:boolean .

ex:mark-141-1-2 a chart:Bar ;
    chart:series ex:series-141-1 ;
    chart:category "Emil" ;
    chart:value "330"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:mark-141-1-3 a chart:Bar ;
    chart:series ex:series-141-1 ;
    chart:category "Filip" ;
    chart:value "360"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

