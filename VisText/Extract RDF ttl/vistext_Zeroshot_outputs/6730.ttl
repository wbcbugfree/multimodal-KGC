@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-6730 a chart:Chart ;
    chart:chartType "area" ;
    chart:title "Public concern about air pollution in the United States from 1989 to 2019" ;
    chart:xAxis ex:x-6730 ;
    chart:yAxis ex:y-6730 .

ex:x-6730 a chart:Axis ;
    chart:label "Response" ;
    chart:scaleMin "1989" ;
    chart:scaleMax "2019" .

ex:y-6730 a chart:Axis ;
    chart:label "Not at all" ;
    chart:scaleMin "0.00" ;
    chart:scaleMax "0.10" .

ex:series-6730-1 a chart:Series .

ex:point-6730-1-1 a chart:Point ;
    chart:series ex:series-6730-1 ;
    chart:xVal "1989" ;
    chart:yVal 0.04 ;
    chart:valueEstimated "false"^^xsd:boolean .

