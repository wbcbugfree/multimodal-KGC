ex:chart-1024 a chart:Chart ;
    chart:chartType "line" ;
    chart:title "Share of IT leaders worldwide who expect outsourcing spending increases from 2005 to 2019" ;
    chart:xAxis ex:x-1024 ;
    chart:yAxis ex:y-1024 .

ex:x-1024 a chart:Axis ;
    chart:label "Response" ;
    chart:scaleMin "2005" ;
    chart:scaleMax "2019" .

ex:y-1024 a chart:Axis ;
    chart:label "Share of respondents" ;
    chart:scaleMin "0.0" ;
    chart:scaleMax "0.5" .

ex:series-1024-1 a chart:Series .

ex:point-1024-1-1 a chart:Point ;
    chart:series ex:series-1024-1 ;
    chart:xVal "2005" ;
    chart:yVal "0.47"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

