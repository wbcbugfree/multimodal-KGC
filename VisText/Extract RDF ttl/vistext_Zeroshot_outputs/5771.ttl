@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-5771 a chart:Chart ;
    chart:chartType "line" ;
    chart:title "High-technology exports from the United States from 1990 to 2018 , as a percentage of total manufactured exports" ;
    chart:xAxis ex:x-5771 ;
    chart:yAxis ex:y-5771 .

ex:x-5771 a chart:Axis ;
    chart:label "Response" ;
    chart:scaleMin "1990" ;
    chart:scaleMax "2015" .

ex:y-5771 a chart:Axis ;
    chart:label "Percentage of high-tech exports" ;
    chart:scaleMin "0.00" ;
    chart:scaleMax "0.35" .

ex:series-5771-1 a chart:Series .

ex:point-5771-1-1 a chart:Point ;
