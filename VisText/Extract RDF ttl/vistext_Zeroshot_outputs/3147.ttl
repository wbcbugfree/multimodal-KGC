@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-3147 a chart:Chart ;
    chart:chartType "bar" ;
    chart:xAxis ex:x-3147 ;
    chart:yAxis ex:y-3147 ;
    chart:title "Number of animal food manufacturing establishments in Canada as of December in 2019 , by region" .

ex:x-3147 a chart:Axis ;
    chart:label "Number of establishments" ;
    chart:scaleMin "0" ;
    chart:scaleMax "120" .

ex:y-3147 a chart:Axis ;
    chart:label "province of Canada" ;
    chart:scaleMin "" ;
    chart:scaleMax "" .

ex:series-3147-1 a chart:Series .

ex:mark-3147-1-1 a chart:Bar ;
    chart:series ex:series-3147-1 ;
    chart:category "Alberta" ;
    chart:value "130"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

