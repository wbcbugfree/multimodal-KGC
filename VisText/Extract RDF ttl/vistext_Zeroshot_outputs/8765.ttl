@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-8765 a chart:Chart ;
    chart:chartType "bar" ;
    chart:xAxis ex:x-8765 ;
    chart:yAxis ex:y-8765 ;
    chart:title "Clinker capacity in selected countries from 2016 to 2019 (in million metric tons)" .

ex:x-8765 a chart:Axis ;
    chart:label "2016" ;
    chart:scaleMin "0" ;
    chart:scaleMax "2000" .

ex:y-8765 a chart:Axis ;
    chart:label "Country" ;
    chart:scaleMin "" ;
    chart:scaleMax "" .

ex:series-8765-1 a chart:Series .

ex:mark-8765-1-1 a chart:Bar ;
    chart:series ex:series-8765-1 ;
    chart:category "Brazil" ;
    chart:value "100"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

