@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-668 a chart:Chart ;
    chart:chartType "area" ;
    chart:title "Share of children in total population in Indonesia from 2005 to 2019" ;
    chart:xAxis ex:x-668 ;
    chart:yAxis ex:y-668 .

ex:x-668 a chart:Axis ;
    chart:label "Response" ;
    chart:scaleMin "2005" ;
    chart:scaleMax "2019" .

ex:y-668 a chart:Axis ;
    chart:label "Percentage of total population" ;
    chart:scaleMin "0.00" ;
    chart:scaleMax "0.30" .

ex:series-668-1 a chart:Series ;
    chart:seriesName "Share of children" .

ex:point-668-1-1 a chart:Point ;
    chart:series ex:series-668-1 ;
    chart:xVal "2005" ;
    chart:yVal 0.30 ;
    chart:valueEstimated "false"^^xsd:boolean .

ex:point-668-1-2 a chart:Point ;
    chart:series ex:series-668-1 ;
    chart:xVal "2006" ;
    chart:yVal 0.30 ;
    chart:valueEstimated "false"^^xsd:boolean .

