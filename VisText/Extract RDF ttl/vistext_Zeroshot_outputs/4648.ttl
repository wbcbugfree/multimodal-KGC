@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-4648 a chart:Chart ;
    chart:chartType "area" ;
    chart:title "Revenue generated by Becton , Dickinson , and Company from 2011 to 2020 (in billion U.S. dollars)" ;
    chart:xAxis ex:x-4648 ;
    chart:yAxis ex:y-4648 .

ex:x-4648 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2011" ;
    chart:scaleMax "2020" .

ex:y-4648 a chart:Axis ;
    chart:label "Annual revenue in billion U.S. dollars" ;
    chart:scaleMin "0" ;
    chart:scaleMax "16" .

ex:series-4648-1 a chart:Series .

ex:point-4648-1-1 a chart:Point ;
    chart:series ex:series-4648-1 ;
    chart:xVal "2011" ;
    chart:yVal "6.5"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-4648-1-2 a chart:Point ;
    chart:series ex:series-4648-1 ;
    chart:xVal "2012" ;
    chart:yVal "7.0"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-4648-1-3 a chart:Point ;
    chart:series ex:series-4648-1 ;
    chart:xVal "2013" ;
    chart:yVal "7.5"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-4648-1-4 a chart:Point ;
    chart:series ex:series-4648-1 ;
    chart:xVal "2014" ;
    chart:yVal "8.0"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-4648-1-5 a chart:Point ;
    chart:series ex:series-4648-1 ;
    chart:xVal "2015" ;
    chart:yVal "9.5"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-4648-1-6 a chart:Point ;
    chart:series ex:series-4648-1 ;
    chart:xVal "2016" ;
    chart:yVal "11.5"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-4648-1-7 a chart:Point ;
    chart:series ex:series-4648-1 ;
    chart:xVal "2017" ;
    chart:yVal "13.5"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-4648-1-8 a chart:Point ;
    chart:series ex:series-4648-1 ;
    chart:xVal "2018" ;
    chart:yVal "15.0"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-4648-1-9 a chart:Point ;
    chart:series ex:series-4648-1 ;
    chart:xVal "2019" ;
    chart:yVal "15.5"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-4648-1-10 a chart:Point ;
    chart:series ex:series-4648-1 ;
    chart:xVal "2020" ;
