@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-6360 a chart:Chart ;
    chart:chartType "area" ;
    chart:title "Monthly number of passenger visitors at Sydney Airport compared with the previous year in Australia from February to October 2020 , by passenger type (in 1,000s)" ;
    chart:xAxis ex:x-6360 ;
    chart:yAxis ex:y-6360 .

ex:x-6360 a chart:Axis ;
    chart:label "Month" ;
    chart:scaleMin "" ;
    chart:scaleMax "" .

ex:y-6360 a chart:Axis ;
    chart:label "Domestic" ;
    chart:scaleMin "0" ;
    chart:scaleMax "2500" .

ex:series-6360-1 a chart:Series .

ex:point-6360-1-1 a chart:Point ;
    chart:series ex:series-6360-1 ;
    chart:xVal "February" ;
    chart:yVal "2200"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-6360-1-2 a chart:Point ;
    chart:series ex:series-6360-1 ;
    chart:xVal "March" ;
    chart:yVal "2450"^^xsd:decimal ;
