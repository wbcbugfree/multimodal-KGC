ex:chart-246 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "U.S. wheat supply projection from 2010/2011 to 2027/2028 (in million bushels)" ;
    chart:xAxis ex:x-246 ;
    chart:yAxis ex:y-246 .

ex:x-246 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "10/11" ;
    chart:scaleMax "27/28" .

ex:y-246 a chart:Axis ;
    chart:label "Production in million bushels" ;
    chart:scaleMin "0" ;
    chart:scaleMax "3500" .

ex:series-246-1 a chart:Series .

