@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-2676 a chart:Chart ;
    chart:chartType "area" ;
    chart:title "Value added of U.S. machinery manufacturing between 2008 and 2018 (in billion U.S. dollars)" ;
    chart:xAxis ex:x-2676 ;
    chart:yAxis ex:y-2676 .

ex:x-2676 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2008" ;
    chart:scaleMax "2018" .

ex:y-2676 a chart:Axis ;
    chart:label "Value added in billion U.S. dollars" ;
    chart:scaleMin "0" ;
    chart:scaleMax "175" .

ex:series-2676-1 a chart:Series .

ex:point-2676-1-1 a chart:Point ;
    chart:series ex:series-2676-1 ;
    chart:xVal "2008" ;
    chart:yVal "130"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-2676-1-2 a chart:Point ;
    chart:series ex:series-2676-1 ;
    chart:xVal "2009" ;
    chart:yVal "120"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

