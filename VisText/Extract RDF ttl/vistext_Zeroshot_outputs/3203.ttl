@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-3203 a chart:Chart ;
    chart:chartType "line" ;
    chart:title "Central African Republic : Life expectancy at birth from 2008 to 2018" ;
    chart:xAxis ex:x-3203 ;
    chart:yAxis ex:y-3203 .

ex:x-3203 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2008" ;
    chart:scaleMax "2018" .

ex:y-3203 a chart:Axis ;
    chart:label "Life expectancy at birth in years" ;
    chart:scaleMin "0" ;
    chart:scaleMax "50" .

ex:series-3203-1 a chart:Series ;
    chart:seriesName "Life expectancy" .

ex:point-3203-1-1 a chart:Point ;
    chart:series ex:series-3203-1 ;
    chart:xVal "2008" ;
    chart:yVal "47.0"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-3203-1-2 a chart:Point ;
    chart:series ex:series-3203-1 ;
    chart:xVal "2010" ;
    chart:yVal "48.5"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-3203-1-3 a chart:Point ;
    chart:series ex:series-3203-1 ;
    chart:xVal "2012" ;
    chart:yVal "49.5"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-3203-1-4 a chart:Point ;
    chart:series ex:series-3203-1 ;
    chart:xVal "2014" ;
    chart:yVal "50.0"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-3203-1-5 a chart:Point ;
    chart:series ex:series-3203-1 ;
    chart:xVal "2016" ;
    chart:yVal "50.5"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-3203-1-6 a chart:Point ;
    chart:series ex:series-3203-1 ;
    chart:xVal "2018" ;
    chart:yVal "51.0"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .
