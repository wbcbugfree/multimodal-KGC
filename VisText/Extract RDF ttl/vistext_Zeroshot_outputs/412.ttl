@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-412 a chart:Chart ;
    chart:chartType "area" ;
    chart:title "Direct investment position of the United States in the Middle East from 2000 to 2019" ;
    chart:subtitle "(in billion U.S. dollars , on a historical-cost basis)" ;
    chart:xAxis ex:x-412 ;
    chart:yAxis ex:y-412 .

ex:x-412 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2000" ;
    chart:scaleMax "2019" .

ex:y-412 a chart:Axis ;
    chart:label "Direct investments in billion U.S. dollars" ;
    chart:scaleMin "0" ;
    chart:scaleMax "80" .

ex:series-412-1 a chart:Series .

ex:point-412-1-1 a chart:Point ;
    chart:series ex:series-412-1 ;
    chart:xVal "2000" ;
    chart:yVal "10"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-412-1-2 a chart:Point ;
    chart:series ex:series-412-1 ;
    chart:xVal "2002" ;
    chart:yVal "15"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-412-1-3 a chart:Point ;
    chart:series ex:series-412-1 ;
    chart:xVal "2004" ;
    chart:yVal "20"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-412-1-4 a chart:Point ;
    chart:series ex:series-412-1 ;
    chart:xVal "2006" ;
    chart:yVal "25"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-412-1-5 a chart:Point ;
    chart:series ex:series-412-1 ;
    chart:xVal "2008" ;
    chart:yVal "30"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-412-1-6 a chart:Point ;
    chart:series ex:series-412-1 ;
    chart:xVal "2010" ;
    chart:yVal "35"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-412-1-7 a chart:Point ;
    chart:series ex:series-412-1 ;
    chart:xVal "2012" ;
    chart:yVal "40"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-412-1-8 a chart:Point ;
    chart:series ex:series-412-1 ;
    chart:xVal "2014" ;
    chart:yVal "50"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-412-1-9 a chart:Point ;
    chart:series ex:series-412-1 ;
    chart:xVal "2016" ;
    chart:yVal "55"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-412-1-10 a chart:Point ;
    chart:series ex:series-412-1 ;
    chart:xVal "2018" ;
    chart:yVal "75"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-412-1-11 a chart:Point ;
