@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-7674 a chart:Chart ;
    chart:chartType "bar" ;
    chart:xAxis ex:x-7674 ;
    chart:yAxis ex:y-7674 ;
    chart:title "Consumer spending expectations for the following six months on consumer products due to the coronavirus in the United States as of March 9 , 2020" .

ex:x-7674 a chart:Axis ;
    chart:label "About the same" ;
    chart:scaleMin "0.0" ;
    chart:scaleMax "0.8" .

ex:y-7674 a chart:Axis ;
    chart:label "consumer products" ;
    chart:scaleMin "" ;
    chart:scaleMax "" .

ex:series-7674-1 a chart:Series .

ex:mark-7674-1-1 a chart:Bar ;
    chart:series ex:series-7674-1 ;
    chart:category "Cars/automobiles" ;
    chart:value "0.55"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

