@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-7402 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "American customer satisfaction index scores for internet travel companies in the United States from 2002 to 2019" ;
    chart:xAxis ex:x-7402 ;
    chart:yAxis ex:y-7402 .

ex:x-7402 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2002" ;
    chart:scaleMax "2019" .

ex:y-7402 a chart:Axis ;
    chart:label "Travelocity (Expedia)" ;
    chart:scaleMin "0" ;
    chart:scaleMax "80" .

ex:series-7402-1 a chart:Series .

ex:mark-7402-1-1 a chart:Bar ;
    chart:series ex:series-7402-1 ;
    chart:category "2002" ;
    chart:value "77"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

