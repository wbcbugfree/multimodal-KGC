@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-6607 a chart:Chart ;
    chart:chartType "area" ;
    chart:title "Estimated median age of Americans at their first wedding in the United States from 1998 to 2019 , by sex" ;
    chart:xAxis ex:x-6607 ;
    chart:yAxis ex:y-6607 .

ex:x-6607 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "1998" ;
    chart:scaleMax "2019" .

ex:y-6607 a chart:Axis ;
    chart:label "Women" ;
    chart:scaleMin "0" ;
    chart:scaleMax "30" .

ex:series-6607-1 a chart:Series ;
    chart:seriesName "Women" .

ex:point-6607-1-1 a chart:Point ;
    chart:series ex:series-6607-1 ;
    chart:xVal "1998" ;
    chart:yVal "25.0"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

