@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-7396 a chart:Chart ;
    chart:chartType "line" ;
    chart:title "Number of state and federal prisoners in private facilities in the United States from 2000 to 2018 , by prison location" ;
    chart:xAxis ex:x-7396 ;
    chart:yAxis ex:y-7396 .

ex:x-7396 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2000" ;
    chart:scaleMax "2018" .

ex:y-7396 a chart:Axis ;
    chart:label "Out-of-state private prisons" ;
    chart:scaleMin "0" ;
    chart:scaleMax "40000" .

ex:series-7396-1 a chart:Series .

ex:point-7396-1-1 a chart:Point ;
    chart:series ex:series-7396-1 ;
    chart:xVal "2000" ;
    chart:yVal "23000"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

