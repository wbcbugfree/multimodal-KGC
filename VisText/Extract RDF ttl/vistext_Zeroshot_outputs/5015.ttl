@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-5015 a chart:Chart ;
    chart:chartType "line" ;
    chart:xAxis ex:x-5015 ;
    chart:yAxis ex:y-5015 ;
    chart:title "Greece : Infant mortality rate from 2009 to 2019 (in deaths per 1,000 live births)" .

ex:x-5015 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2009" ;
    chart:scaleMax "2019" .

ex:y-5015 a chart:Axis ;
    chart:label "Deaths per 1,000 live births" ;
    chart:scaleMin "0" ;
    chart:scaleMax "4" .

ex:series-5015-1 a chart:Series .

ex:point-5015-1-1 a chart:Point ;
    chart:series ex:series-5015-1 ;
    chart:xVal "2009" ;
    chart:yVal "3.5"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-5015-1-2 a chart:Point ;
    chart:series ex:series-5015-1 ;
    chart:xVal "2010" ;
    chart:yVal "3.4"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

