@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-7757 a chart:Chart ;
    chart:chartType "area" ;
    chart:title "Number of establishments in the music industry in the United States from 2007 to 2017 ," ;
    chart:subtitle "by sector" ;
    chart:xAxis ex:x-7757 ;
    chart:yAxis ex:y-7757 .

ex:x-7757 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2007" ;
    chart:scaleMax "2017" .

ex:y-7757 a chart:Axis ;
    chart:label "Integrated record production/distribution" ;
    chart:scaleMin "0" ;
    chart:scaleMax "500" .

ex:series-7757-1 a chart:Series ;
    chart:seriesName "Integrated record production/distribution" .

ex:point-7757-1-1 a chart:Point ;
    chart:series ex:series-7757-1 ;
    chart:xVal "2007" ;
    chart:yVal "480"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-7757-1-2 a chart:Point ;
    chart:series ex:series-7757-1 ;
    chart:xVal "2008" ;
    chart:yVal "450"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

