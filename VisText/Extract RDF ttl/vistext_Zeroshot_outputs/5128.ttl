@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-5128 a chart:Chart ;
    chart:chartType "area" ;
    chart:title "Real Gross Domestic Product (GDP) of the federal state of Michigan from 2000 to 2019" ;
    chart:subtitle "(in billion U.S. dollars)" ;
    chart:xAxis ex:x-5128 ;
    chart:yAxis ex:y-5128 .

ex:x-5128 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "" ;
    chart:scaleMax "" .

ex:y-5128 a chart:Axis ;
    chart:label "Real GDP in billion U.S. dollars" ;
    chart:scaleMin "0" ;
    chart:scaleMax "500" .

ex:series-5128-1 a chart:Series .

ex:point-5128-1-1 a chart:Point ;
    chart:series ex:series-5128-1 ;
    chart:xVal "2000" ;
    chart:yVal "430"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

