@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-7322 a chart:Chart ;
    chart:chartType "line" ;
    chart:title "Number of Facebook fans/twitter followers of the Carolina Panthers (NFL) from 2012 to 2020 (in millions)" ;
    chart:xAxis ex:x-7322 ;
    chart:yAxis ex:y-7322 .

ex:x-7322 a chart:Axis ;
    chart:label "Month" ;
    chart:scaleMin "2012" ;
    chart:scaleMax "2020" .

ex:y-7322 a chart:Axis ;
    chart:label "Twitter followers" ;
    chart:scaleMin "0.0" ;
    chart:scaleMax "3.5" .

ex:series-7322-1 a chart:Series ;
    chart:seriesName "Facebook fans/twitter followers" .

ex:point-7322-1-1 a chart:Point ;
    chart:series ex:series-7322-1 ;
    chart:xVal "2012" ;
    chart:yVal "0.1"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-7322-1-2 a chart:Point ;
    chart:series ex:series-7322-1 ;
    chart:xVal "2013" ;
    chart:yVal "0.2"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-7322-1-3 a chart:Point ;
    chart:series ex:series-7322-1 ;
    chart:xVal "2014" ;
    chart:yVal "0.3"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-7322-1-4 a chart:Point ;
    chart:series ex:series-7322-1 ;
    chart:xVal "2015" ;
    chart:yVal "0.45"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-7322-1-5 a chart:Point ;
    chart:series ex:series-7322-1 ;
    chart:xVal "2016" ;
    chart:yVal "1.25"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-7322-1-6 a chart:Point ;
    chart:series ex:series-7322-1 ;
    chart:xVal "2017" ;
    chart:yVal "2.25"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-7322-1-7 a chart:Point ;
    chart:series ex:series-7322-1 ;
    chart:xVal "2018" ;
    chart:yVal "2.8"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-7322-1-8 a chart:Point ;
