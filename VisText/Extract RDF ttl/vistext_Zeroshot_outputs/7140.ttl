    chart:title "Distribution of lubricant demand in Africa and Middle East in 2007 and 2014 , by country" ;
    chart:xAxis ex:x-7140 ;
    chart:yAxis ex:y-7140 .

ex:x-7140 a chart:Axis ;
    chart:label "2007" ;
    chart:scaleMin "0.00" ;
    chart:scaleMax "0.20" .

ex:y-7140 a chart:Axis ;
    chart:label "Country" ;
    chart:scaleMin "" ;
    chart:scaleMax "" .

ex:series-7140-1 a chart:Series ;
