@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-6103 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Most popular Brazilian soccer clubs as of June 2020, by number of social media followers (in 1,000s)" ;
    chart:xAxis ex:x-6103 ;
    chart:yAxis ex:y-6103 .

ex:x-6103 a chart:Axis ;
    chart:label "Soccer clubs" ;
    chart:scaleMin "" ;
    chart:scaleMax "" .

ex:y-6103 a chart:Axis ;
    chart:label "TikTok" ;
    chart:scaleMin "0" ;
    chart:scaleMax "1000" .

ex:series-6103-1 a chart:Series .

ex:mark-6103-1-1 a chart:Bar ;
    chart:series ex:series-6103-1 ;
    chart:category "Atlético Minas Gerais" ;
    chart:value "50"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

