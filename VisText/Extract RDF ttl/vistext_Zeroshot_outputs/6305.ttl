@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-6305 a chart:Chart ;
    chart:chartType "line" ;
    chart:title "Projected population in Russia from 2020 to 2036 , by scenario (in 1,000s)" ;
    chart:xAxis ex:x-6305 ;
    chart:yAxis ex:y-6305 .

ex:x-6305 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2020" ;
    chart:scaleMax "2035" .

ex:y-6305 a chart:Axis ;
    chart:label "Low expectation" ;
    chart:scaleMin "0" ;
    chart:scaleMax "150000" .

ex:series-6305-1 a chart:Series ;
    chart:seriesName "Low expectation" .

ex:point-6305-1-1 a chart:Point ;
    chart:series ex:series-6305-1 ;
    chart:xVal "2020" ;
    chart:yVal "150000"^^xsd:decimal ;
    chart:valueEstimated "false"^^xsd:boolean .

ex:point-6305-1-2 a chart:Point ;
    chart:series ex:series-6305-1 ;
    chart:xVal "2025" ;
    chart:yVal "148000"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-6305-1-3 a chart:Point ;
    chart:series ex:series-6305-1 ;
    chart:xVal "2030" ;
    chart:yVal "145000"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-6305-1-4 a chart:Point ;
    chart:series ex:series-6305-1 ;
    chart:xVal "2035" ;
    chart:yVal "142000"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .
