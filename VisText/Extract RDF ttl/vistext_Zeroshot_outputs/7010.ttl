@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-7010 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Length of time respondents think the coronavirus (COVID-19) outbreak will last in their country , worldwide as of March 12 , 2020 , by country" ;
    chart:xAxis ex:x-7010 ;
    chart:yAxis ex:y-7010 .

ex:x-7010 a chart:Axis ;
    chart:label "Longer than a year" ;
    chart:scaleMin "0.01" ;
    chart:scaleMax "0.14" .

ex:y-7010 a chart:Axis ;
    chart:label "4-5 months" ;
    chart:scaleMin "0.0" ;
    chart:scaleMax "0.4" .

ex:series-7010-1 a chart:Series .

ex:mark-7010-1-1 a chart:Bar ;
    chart:series ex:series-7010-1 ;
    chart:category "0.01" ;
    chart:value "0.06"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:mark-7010-1-2 a chart:Bar ;
    chart:series ex:series-7010-1 ;
    chart:category "0.02" ;
    chart:value "0.26"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

