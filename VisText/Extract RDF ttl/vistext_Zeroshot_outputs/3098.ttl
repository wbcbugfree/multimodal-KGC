ex:chart-3098 a chart:Chart ;
    chart:chartType "line" ;
    chart:title "Number of passengers boarded by the major Canadian air carriers from 1990 to 2019 (in 1,000s)" ;
    chart:xAxis ex:x-3098 ;
    chart:yAxis ex:y-3098 .

ex:x-3098 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "1990" ;
    chart:scaleMax "2015" .

ex:y-3098 a chart:Axis ;
    chart:label "Number of passengers boarded in thousands" ;
    chart:scaleMin "0" ;
    chart:scaleMax "100000" .

ex:series-3098-1 a chart:Series .

ex:point-3098-1-1 a chart:Point ;
    chart:series ex:series-3098-1 ;
    chart:xVal "1990" ;
    chart:yVal "21000"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-3098-1-2 a chart:Point ;
    chart:series ex:series-3098-1 ;
    chart:xVal "1995" ;
    chart:yVal "22000"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-3098-1-3 a chart:Point ;
    chart:series ex:series-3098-1 ;
    chart:xVal "2000" ;
    chart:yVal "25000"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-3098-1-4 a chart:Point ;
    chart:series ex:series-3098-1 ;
    chart:xVal "2005" ;
    chart:yVal "35000"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-3098-1-5 a chart:Point ;
    chart:series ex:series-3098-1 ;
    chart:xVal "2010" ;
    chart:yVal "39000"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-3098-1-6 a chart:Point ;
    chart:series ex:series-3098-1 ;
    chart:xVal "2015" ;
    chart:yVal "78000"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-3098-1-7 a chart:Point ;
    chart:series ex:series-3098-1 ;
    chart:xVal "2019" ;
    chart:yVal "88000"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .
