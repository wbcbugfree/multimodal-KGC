@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-8473 a chart:Chart ;
    chart:chartType "line" ;
    chart:title "Market share held by the leading internet browsers in Europe from 2009 to 2019" ;
    chart:xAxis ex:x-8473 ;
    chart:yAxis ex:y-8473 .

ex:x-8473 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2009" ;
    chart:scaleMax "2019" .

ex:y-8473 a chart:Axis ;
    chart:label "Chrome" ;
    chart:scaleMin "0.0" ;
    chart:scaleMax "0.6" .

ex:series-8473-1 a chart:Series ;
    chart:seriesName "Chrome" .

ex:point-8473-1-1 a chart:Point ;
    chart:series ex:series-8473-1 ;
    chart:xVal "2009" ;
    chart:yVal "0.05"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

