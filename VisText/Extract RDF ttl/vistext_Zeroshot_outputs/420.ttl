@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-420 a chart:Chart ;
    chart:chartType "bar" ;
    chart:xAxis ex:x-420 ;
    chart:yAxis ex:y-420 ;
    chart:title "Average consumer price for natural gas in the United States from winter of 2005/06 to winter of 2020/21 (in U.S. dollars per 1,000 cubic feet)" .

ex:x-420 a chart:Axis ;
    chart:label "Price in U.S. dollars per thousand cubic feet" ;
    chart:scaleMin "0" ;
    chart:scaleMax "15" .

ex:y-420 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2005/06" ;
    chart:scaleMax "2020/21**" .

ex:series-420-1 a chart:Series .

ex:mark-420-1-1 a chart:Bar ;
    chart:series ex:series-420-1 ;
    chart:category "2005/06" ;
    chart:value "15.5"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:mark-420-1-2 a chart:Bar ;
    chart:series ex:series-420-1 ;
    chart:category "2006/07" ;
    chart:value "13.5"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

