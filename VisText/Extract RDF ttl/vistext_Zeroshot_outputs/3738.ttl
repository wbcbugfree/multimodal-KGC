@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-3738 a chart:Chart ;
    chart:chartType "area" ;
    chart:title "Violent crime severity index in Canada from 2000 to 2019" ;
    chart:xAxis ex:x-3738 ;
    chart:yAxis ex:y-3738 .

ex:x-3738 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2000" ;
    chart:scaleMax "2019" .

ex:y-3738 a chart:Axis ;
    chart:label "Violent crime severity index" ;
    chart:scaleMin "0" ;
    chart:scaleMax "100" .

ex:series-3738-1 a chart:Series .

