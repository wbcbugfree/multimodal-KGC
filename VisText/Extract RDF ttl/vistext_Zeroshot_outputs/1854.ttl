ex:chart-1854 a chart:Chart ;
    chart:chartType "line" ;
    chart:title "Hasbro operating profit from 2006 to 2019" ;
    chart:subtitle "(in million U.S. dollars)" ;
    chart:xAxis ex:x-1854 ;
    chart:yAxis ex:y-1854 .

