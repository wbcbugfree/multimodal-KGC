    chart:label "Year" ;
    chart:scaleMin "2006" ;
    chart:scaleMax "2018" .

ex:y-1854 a chart:Axis ;
    chart:label "Operating profit (in million U.S. dollars)" ;
    chart:scaleMin "0" ;
    chart:scaleMax "900" .

