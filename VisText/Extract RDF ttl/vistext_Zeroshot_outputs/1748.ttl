    chart:xVal "2013" ;
    chart:yVal "0.75"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-1748-1-7 a chart:Point ;
    chart:series ex:series-1748-1 ;
    chart:xVal "2014" ;
