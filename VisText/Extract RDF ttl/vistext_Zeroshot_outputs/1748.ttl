    chart:series ex:series-1748-1 ;
    chart:xVal "2011" ;
    chart:yVal "0.70"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-1748-1-5 a chart:Point ;
    chart:series ex:series-1748-1 ;
    chart:xVal "2012" ;
    chart:yVal "0.73"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

