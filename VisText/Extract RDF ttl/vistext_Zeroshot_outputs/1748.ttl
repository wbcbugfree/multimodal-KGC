@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-1748 a chart:Chart ;
    chart:chartType "area" ;
    chart:xAxis ex:x-1748 ;
    chart:yAxis ex:y-1748 ;
    chart:title "Dependency rate on energy imports in Turkey" ;
    chart:subtitle "from 2008 to 2017" .

ex:x-1748 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2008" ;
    chart:scaleMax "2017" .

ex:y-1748 a chart:Axis ;
    chart:label "Energy imports dependency rate" ;
    chart:scaleMin "0.0" ;
    chart:scaleMax "0.8" .

ex:series-1748-1 a chart:Series .

ex:point-1748-1-1 a chart:Point ;
    chart:series ex:series-1748-1 ;
    chart:xVal "2008" ;
    chart:yVal "0.71"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-1748-1-2 a chart:Point ;
    chart:series ex:series-1748-1 ;
    chart:xVal "2009" ;
    chart:yVal "0.69"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

