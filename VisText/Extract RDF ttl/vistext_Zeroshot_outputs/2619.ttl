ex:chart-2619 a chart:Chart ;
    chart:chartType "area" ;
    chart:title "Sales volume of sparkling wine from fresh grapes manufactured in the United Kingdom (UK) from 2009 to 2019 (in liters of pure alcohol)" ;
    chart:xAxis ex:x-2619 ;
    chart:yAxis ex:y-2619 .

ex:x-2619 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2009" ;
    chart:scaleMax "2019" .

ex:y-2619 a chart:Axis ;
    chart:label "Sales volume in liters" ;
    chart:scaleMin "0" ;
    chart:scaleMax "1000000" .

ex:series-2619-1 a chart:Series .

ex:point-2619-1-1 a chart:Point ;
    chart:series ex:series-2619-1 ;
    chart:xVal "2009" ;
    chart:yVal "240000"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

