@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-8444 a chart:Chart ;
    chart:chartType "line" ;
    chart:xAxis ex:x-8444 ;
    chart:yAxis ex:y-8444 .

ex:x-8444 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "1970" ;
    chart:scaleMax "2020" .

ex:y-8444 a chart:Axis ;
    chart:label "White" ;
    chart:scaleMin "0" ;
    chart:scaleMax "2000" .

ex:series-8444-1 a chart:Series ;
    chart:seriesName "White" .

ex:point-8444-1-1 a chart:Point ;
    chart:series ex:series-8444-1 ;
    chart:xVal "1975" ;
    chart:yVal "1100"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-8444-1-2 a chart:Point ;
    chart:series ex:series-8444-1 ;
    chart:xVal "1980" ;
    chart:yVal "1150"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

