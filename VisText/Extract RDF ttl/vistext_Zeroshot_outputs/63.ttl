@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-63 a chart:Chart ;
    chart:chartType "line" ;
    chart:title "Indiana Pacers franchise value from 2003 to 2020 (in million U.S. dollars)" ;
    chart:xAxis ex:x-63 ;
    chart:yAxis ex:y-63 .

ex:x-63 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2003" ;
    chart:scaleMax "2020" .

ex:y-63 a chart:Axis ;
    chart:label "Franchise value in million U.S. dollars" ;
    chart:scaleMin "0" ;
    chart:scaleMax "1500" .

ex:series-63-1 a chart:Series .

ex:point-63-1-1 a chart:Point ;
    chart:series ex:series-63-1 ;
    chart:xVal "2003" ;
    chart:yVal "250"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-63-1-2 a chart:Point ;
    chart:series ex:series-63-1 ;
    chart:xVal "2005" ;
    chart:yVal "275"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-63-1-3 a chart:Point ;
    chart:series ex:series-63-1 ;
    chart:xVal "2007" ;
    chart:yVal "300"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-63-1-4 a chart:Point ;
    chart:series ex:series-63-1 ;
    chart:xVal "2009" ;
    chart:yVal "275"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-63-1-5 a chart:Point ;
    chart:series ex:series-63-1 ;
    chart:xVal "2011" ;
    chart:yVal "250"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-63-1-6 a chart:Point ;
    chart:series ex:series-63-1 ;
    chart:xVal "2013" ;
    chart:yVal "475"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-63-1-7 a chart:Point ;
    chart:series ex:series-63-1 ;
    chart:xVal "2015" ;
    chart:yVal "750"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-63-1-8 a chart:Point ;
    chart:series ex:series-63-1 ;
    chart:xVal "2017" ;
    chart:yVal "900"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-63-1-9 a chart:Point ;
    chart:series ex:series-63-1 ;
    chart:xVal "2019" ;
    chart:yVal "1300"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-63-1-10 a chart:Point ;
    chart:series ex:series-63-1 ;
    chart:xVal "2020" ;
    chart:yVal "1500"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .
