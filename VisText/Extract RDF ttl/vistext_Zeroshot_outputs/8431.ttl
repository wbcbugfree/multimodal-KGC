ex:chart-8431 a chart:Chart ;
    chart:chartType "area" ;
    chart:title "Share of votes in general elections in the United Kingdom from 1918 to 2019 , by political party" ;
    chart:xAxis ex:x-8431 ;
    chart:yAxis ex:y-8431 .

ex:x-8431 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "1918" ;
    chart:scaleMax "2019" .

