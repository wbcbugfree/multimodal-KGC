@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-5697 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Novartis AG 's net income from 2007 to 2019" ;
    chart:subtitle "(in billion U.S. dollars)" ;
    chart:xAxis ex:x-5697 ;
    chart:yAxis ex:y-5697 .

ex:x-5697 a chart:Axis ;
    chart:label "Net income in billion U.S. dollars" ;
    chart:scaleMin "0" ;
    chart:scaleMax "15" .

ex:y-5697 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "" ;
    chart:scaleMax "" .

ex:series-5697-1 a chart:Series .

ex:mark-5697-1-1 a chart:Bar ;
    chart:series ex:series-5697-1 ;
    chart:category "2007" ;
    chart:value "3.0"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

