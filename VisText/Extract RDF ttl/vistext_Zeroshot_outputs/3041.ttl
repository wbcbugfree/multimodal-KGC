@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-3041 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Reach of leading social networking sites used by those aged 26 - 35 in the United Kingdom (UK) as of 3rd quarter 2020" ;
    chart:xAxis ex:x-3041 ;
    chart:yAxis ex:y-3041 .

ex:x-3041 a chart:Axis ;
    chart:label "Share of respondents" ;
    chart:scaleMin "0.0" ;
    chart:scaleMax "0.8" .

ex:y-3041 a chart:Axis ;
    chart:label "Response" ;
    chart:scaleMin "" ;
    chart:scaleMax "" .

ex:series-3041-1 a chart:Series .

ex:mark-3041-1-1 a chart:Bar ;
