ex:chart-7173 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Number of billionaires worldwide from 2001" ;
    chart:subtitle "to 2012 , by region" ;
    chart:xAxis ex:x-7173 ;
    chart:yAxis ex:y-7173 .

ex:x-7173 a chart:Axis ;
    chart:label "year" ;
    chart:scaleMin "2001" ;
    chart:scaleMax "2012" .

ex:y-7173 a chart:Axis ;
    chart:label "Europe" ;
    chart:scaleMin "0" ;
    chart:scaleMax "350" .

ex:series-7173-1 a chart:Series .

