ex:chart-6581 a chart:Chart ;
    chart:chartType "line" ;
    chart:xAxis ex:x-6581 ;
    chart:yAxis ex:y-6581 ;
    chart:title "Iraq : Distribution of employment by economic sector from 2010 to 2020" .

ex:x-6581 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2010" ;
    chart:scaleMax "2020" .

ex:y-6581 a chart:Axis ;
    chart:label "Services" ;
    chart:scaleMin "0.0" ;
    chart:scaleMax "0.6" .

ex:series-6581-1 a chart:Series ;
    chart:seriesName "Services" .

ex:point-6581-1-1 a chart:Point ;
    chart:series ex:series-6581-1 ;
    chart:xVal "2010" ;
    chart:yVal "0.55"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

