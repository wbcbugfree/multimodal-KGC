@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-6244 a chart:Chart ;
    chart:chartType "line" ;
    chart:title "Mobility in selected cities between March\n3 , 2020 and December 7 , 2020 , compared\nwith movement prior to the coronavirus outbreak" ;
    chart:xAxis ex:x-6244 ;
    chart:yAxis ex:y-6244 .

ex:x-6244 a chart:Axis ;
    chart:label "Response" ;
    chart:scaleMin "" ;
    chart:scaleMax "" .

ex:y-6244 a chart:Axis ;
    chart:label "Moscow" ;
    chart:scaleMin "0.0" ;
    chart:scaleMax "1.2" .

ex:series-6244-1 a chart:Series .

ex:point-6244-1-1 a chart:Point ;
    chart:series ex:series-6244-1 ;
    chart:xVal "April" ;
    chart:yVal 1.18 ;
    chart:valueEstimated "false"^^xsd:boolean .

ex:point-6244-1-2 a chart:Point ;
    chart:series ex:series-6244-1 ;
    chart:xVal "April" ;
    chart:yVal 0.18 ;
    chart:valueEstimated "true"^^xsd:boolean .

