@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-8267 a chart:Chart ;
    chart:chartType "area" ;
    chart:xAxis ex:x-8267 ;
    chart:yAxis ex:y-8267 .

ex:x-8267 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2010" ;
    chart:scaleMax "2020" .

ex:y-8267 a chart:Axis ;
    chart:label "20-39 years" ;
    chart:scaleMin "0" ;
    chart:scaleMax "100000" .

ex:series-8267-1 a chart:Series .

ex:point-8267-1-1 a chart:Point ;
    chart:series ex:series-8267-1 ;
    chart:xVal "2010" ;
    chart:yVal "70000"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-8267-1-2 a chart:Point ;
    chart:series ex:series-8267-1 ;
    chart:xVal "2012" ;
    chart:yVal "72000"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-8267-1-3 a chart:Point ;
    chart:series ex:series-8267-1 ;
    chart:xVal "2014" ;
    chart:yVal "75000"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-8267-1-4 a chart:Point ;
    chart:series ex:series-8267-1 ;
    chart:xVal "2016" ;
    chart:yVal "80000"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-8267-1-5 a chart:Point ;
    chart:series ex:series-8267-1 ;
    chart:xVal "2018" ;
    chart:yVal "90000"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-8267-1-6 a chart:Point ;
    chart:series ex:series-8267-1 ;
    chart:xVal "2020" ;
    chart:yVal "100000"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .
