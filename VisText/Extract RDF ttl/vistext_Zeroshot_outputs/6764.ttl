@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-6764 a chart:Chart ;
    chart:chartType "area" ;
    chart:title "Australia : distribution of gross domestic product (GDP) across economic sectors from 2009 to 2019" ;
    chart:xAxis ex:x-6764 ;
    chart:yAxis ex:y-6764 .

ex:x-6764 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2009" ;
    chart:scaleMax "2019" .

ex:y-6764 a chart:Axis ;
    chart:label "Agriculture" ;
    chart:scaleMin "0.000" ;
    chart:scaleMax "0.025" .

ex:series-6764-1 a chart:Series ;
    chart:seriesName "Agriculture" .

ex:point-6764-1-1 a chart:Point ;
    chart:series ex:series-6764-1 ;
    chart:xVal "2009" ;
    chart:yVal "0.022"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-6764-1-2 a chart:Point ;
    chart:series ex:series-6764-1 ;
    chart:xVal "2010" ;
    chart:yVal "0.021"^^xsd:decimal ;
