@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-2854 a chart:Chart ;
    chart:chartType "line" ;
    chart:title "China \'s cotton mill use from 1990 to 2017" ;
    chart:subtitle "(in 1,000 bales)" ;
    chart:xAxis ex:x-2854 ;
    chart:yAxis ex:y-2854 .

ex:x-2854 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "1990" ;
    chart:scaleMax "2015" .

ex:y-2854 a chart:Axis ;
    chart:label "Mill use in thousand 480-pound bales" ;
    chart:scaleMin "0" ;
    chart:scaleMax "50000" .

ex:series-2854-1 a chart:Series .

ex:point-2854-1-1 a chart:Point ;
    chart:series ex:series-2854-1 ;
    chart:xVal "1990" ;
    chart:yVal "16000"^^xsd:decimal ;
    chart:valueEstimated "false"^^xsd:boolean .

ex:point-2854-1-2 a chart:Point ;
    chart:series ex:series-2854-1 ;
    chart:xVal "1995" ;
    chart:yVal "15000"^^xsd:decimal ;
    chart:valueEstimated "false"^^xsd:boolean .

ex:point-2854-1-3 a chart:Point ;
    chart:series ex:series-2854-1 ;
    chart:xVal "2000" ;
    chart:yVal "19000"^^xsd:decimal ;
    chart:valueEstimated "false"^^xsd:boolean .

ex:point-2854-1-4 a chart:Point ;
    chart:series ex:series-2854-1 ;
    chart:xVal "2005" ;
    chart:yVal "47000"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-2854-1-5 a chart:Point ;
    chart:series ex:series-2854-1 ;
    chart:xVal "2007" ;
    chart:yVal "50000"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-2854-1-6 a chart:Point ;
    chart:series ex:series-2854-1 ;
    chart:xVal "2009" ;
    chart:yVal "45000"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-2854-1-7 a chart:Point ;
    chart:series ex:series-2854-1 ;
    chart:xVal "2010" ;
    chart:yVal "35000"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-2854-1-8 a chart:Point ;
    chart:series ex:series-2854-1 ;
    chart:xVal "2012" ;
    chart:yVal "32000"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-2854-1-9 a chart:Point ;
    chart:series ex:series-2854-1 ;
    chart:xVal "2015" ;
    chart:yVal "38000"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .
