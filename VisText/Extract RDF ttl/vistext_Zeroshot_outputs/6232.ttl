@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-6232 a chart:Chart ;
    chart:chartType "bar" ;
    chart:xAxis ex:x-6232 ;
    chart:yAxis ex:y-6232 ;
    chart:title "Monthly average daily temperatures in the United Kingdom (UK) from 2015 to 2020 (in degrees Celsius)" .

ex:x-6232 a chart:Axis ;
    chart:label "2020" ;
    chart:scaleMin "0" ;
    chart:scaleMax "15" .

ex:y-6232 a chart:Axis ;
    chart:label "Month" ;
    chart:scaleMin "" ;
    chart:scaleMax "" .

ex:series-6232-1 a chart:Series .

ex:mark-6232-1-1 a chart:Bar ;
    chart:series   ex:series-6232-1 ;
    chart:category "Apr" ;
    chart:value "12"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:mark-6232-1-2 a chart:Bar ;
    chart:series   ex:series-6232-1 ;
    chart:category "Aug" ;
    chart:value "15"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:mark-6232-1-3 a chart:Bar ;
    chart:series   ex:series-6232-1 ;
    chart:category "Feb" ;
    chart:value "4"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:mark-6232-1-4 a chart:Bar ;
    chart:series   ex:series-6232-1 ;
    chart:category "Jan" ;
    chart:value "4"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:mark-6232-1-5 a chart:Bar ;
    chart:series   ex:series-6232-1 ;
    chart:category "Jul" ;
    chart:value "14"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:mark-6232-1-6 a chart:Bar ;
    chart:series   ex:series-6232-1 ;
    chart:category "Jun" ;
    chart:value "13"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:mark-6232-1-7 a chart:Bar ;
    chart:series   ex:series-6232-1 ;
    chart:category "Mar" ;
    chart:value "6"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:mark-6232-1-8 a chart:Bar ;
    chart:series   ex:series-6232-1 ;
    chart:category "May" ;
    chart:value "10"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .
