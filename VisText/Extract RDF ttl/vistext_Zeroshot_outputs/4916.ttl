@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-4916 a chart:Chart ;
    chart:chartType "line" ;
    chart:xAxis ex:x-4916 ;
    chart:yAxis ex:y-4916 ;
    chart:title "Chicago Bears franchise value from 2002 to 2020 (in million U.S. dollars)" .

ex:x-4916 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2002" ;
    chart:scaleMax "2020" .

ex:y-4916 a chart:Axis ;
    chart:label "Franchise value in million U.S. dollars" ;
    chart:scaleMin "0" ;
    chart:scaleMax "4000" .

ex:series-4916-1 a chart:Series .

ex:point-4916-1-1 a chart:Point ;
