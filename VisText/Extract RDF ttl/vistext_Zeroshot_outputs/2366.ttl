ex:mark-2366-1-9 a chart:Bar ;
    chart:series ex:series-2366-1 ;
    chart:category "Urban problems (traffic jams, poll..." ;
    chart:value "0.18"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:mark-2366-1-10 a chart:Bar ;
    chart:series ex:series-2366-1 ;
    chart:category "Water pollution (seas, rivers, lakes..." ;
