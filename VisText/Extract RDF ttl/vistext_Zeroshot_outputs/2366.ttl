@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-2366 a chart:Chart ;
    chart:chartType "bar" ;
    chart:xAxis ex:x-2366 ;
    chart:yAxis ex:y-2366 ;
    chart:title "From the following list , please pick the five main environmental issues that you are worried about ." .

ex:x-2366 a chart:Axis ;
    chart:label "Share of respondents" ;
    chart:scaleMin "0.0" ;
    chart:scaleMax "0.6" .

ex:y-2366 a chart:Axis ;
    chart:label "Response" ;
    chart:scaleMin "" ;
    chart:scaleMax "" .

ex:series-2366-1 a chart:Series .

ex:mark-2366-1-1 a chart:Bar ;
    chart:series ex:series-2366-1 ;
    chart:category "Agricultural pollution (use of pesticides...)" ;
    chart:value "0.25"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:mark-2366-1-2 a chart:Bar ;
    chart:series ex:series-2366-1 ;
    chart:category "Air pollution" ;
    chart:value "0.45"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

