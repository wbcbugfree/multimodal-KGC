@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-3778 a chart:Chart ;
    chart:chartType "bar" ;
    chart:xAxis ex:x-3778 ;
    chart:yAxis ex:y-3778 .

ex:x-3778 a chart:Axis ;
    chart:label "city" ;
    chart:scaleMin "" ;
    chart:scaleMax "" .

ex:y-3778 a chart:Axis ;
    chart:label "Number of workforce jobs in thousands" ;
    chart:scaleMin "0" ;
    chart:scaleMax "800" .

ex:series-3778-1 a chart:Series .

ex:mark-3778-1-1 a chart:Bar ;
    chart:series ex:series-3778-1 ;
    chart:category "East Midlands" ;
    chart:value "400"^^xsd:decimal ;
    chart:valueEstimated "false"^^xsd:boolean .

