ex:chart-1875 a chart:Chart ;
    chart:chartType "line" ;
    chart:title "Number of hate groups in the United States" ;
    chart:subtitle "from 1999 to 2019" ;
    chart:xAxis ex:x-1875 ;
    chart:yAxis ex:y-1875 .

ex:x-1875 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2000" ;
    chart:scaleMax "2019" .

ex:y-1875 a chart:Axis ;
    chart:label "Number of hate groups" ;
    chart:scaleMin "0" ;
    chart:scaleMax "1000" .

ex:series-1875-1 a chart:Series .

