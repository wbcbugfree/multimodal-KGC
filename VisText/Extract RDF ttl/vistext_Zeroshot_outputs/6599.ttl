@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-6599 a chart:Chart ;
    chart:chartType "bar" ;
    chart:xAxis ex:x-6599 ;
    chart:yAxis ex:y-6599 ;
    chart:title "Growth in bankruptcies after the coronavirus outbreak in Sweden from February to November 2020 , by industry (compared to the previous year)" .

ex:x-6599 a chart:Axis ;
    chart:label "Jul" ;
    chart:scaleMin "-0.4" ;
    chart:scaleMax "0.8" .

ex:y-6599 a chart:Axis ;
    chart:label "industry" ;
    chart:scaleMin "" ;
    chart:scaleMax "" .

ex:series-6599-1 a chart:Series .

