@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-8276 a chart:Chart ;
    chart:chartType "area" ;
    chart:title "Public concern about the extinction of plant and animal species in the United States from 2000 to 2012" ;
    chart:xAxis ex:x-8276 ;
    chart:yAxis ex:y-8276 .

ex:x-8276 a chart:Axis ;
    chart:label "Response" ;
    chart:scaleMin "2000" ;
    chart:scaleMax "2012" .

ex:y-8276 a chart:Axis ;
    chart:label "Fair amount" ;
    chart:scaleMin "0.00" ;
    chart:scaleMax "0.35" .

ex:series-8276-1 a chart:Series .

ex:point-8276-1-1 a chart:Point ;
    chart:series ex:series-8276-1 ;
    chart:xVal "2000" ;
    chart:yVal 0.32 ;
    chart:valueEstimated "false"^^xsd:boolean .

ex:point-8276-1-2 a chart:Point ;
    chart:series ex:series-8276-1 ;
    chart:xVal "2002" ;
    chart:yVal 0.30 ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-8276-1-3 a chart:Point ;
    chart:series ex:series-8276-1 ;
    chart:xVal "2004" ;
    chart:yVal 0.31 ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-8276-1-4 a chart:Point ;
    chart:series ex:series-8276-1 ;
    chart:xVal "2006" ;
    chart:yVal 0.26 ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-8276-1-5 a chart:Point ;
    chart:series ex:series-8276-1 ;
    chart:xVal "2008" ;
    chart:yVal 0.31 ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-8276-1-6 a chart:Point ;
    chart:series ex:series-8276-1 ;
    chart:xVal "2010" ;
    chart:yVal 0.29 ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-8276-1-7 a chart:Point ;
    chart:series ex:series-8276-1 ;
    chart:xVal "2012" ;
    chart:yVal 0.29 ;
    chart:valueEstimated "true"^^xsd:boolean .
