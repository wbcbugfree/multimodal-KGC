@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-1412 a chart:Chart ;
    chart:chartType "bar" ;
    chart:xAxis ex:x-1412 ;
    chart:yAxis ex:y-1412 ;
    chart:title "Encounter rate trends for the locations with the most computers reporting malware detections as of 2nd quarter 2016" .

ex:x-1412 a chart:Axis ;
    chart:label "Encounter and detection rate" ;
    chart:scaleMin "0.00" ;
    chart:scaleMax "0.30" .

ex:y-1412 a chart:Axis ;
    chart:label "Country" ;
    chart:scaleMin "" ;
    chart:scaleMax "" .

ex:series-1412-1 a chart:Series .

ex:mark-1412-1-1 a chart:Bar ;
    chart:series ex:series-1412-1 ;
    chart:category "Brazil" ;
    chart:value "0.25"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

