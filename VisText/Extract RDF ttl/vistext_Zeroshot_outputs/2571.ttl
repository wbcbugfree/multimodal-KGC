ex:chart-2571 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Number of onshore wind energy sites in Germany" ;
    chart:subtitle "from 2000 to 2018" ;
    chart:xAxis ex:x-2571 ;
    chart:yAxis ex:y-2571 .

ex:x-2571 a chart:Axis ;
    chart:label "Number of wind energy sites" ;
    chart:scaleMin "0" ;
    chart:scaleMax "30000" .

ex:y-2571 a chart:Axis ;
    chart:label "year" ;
    chart:scaleMin "00" ;
    chart:scaleMax "18" .

