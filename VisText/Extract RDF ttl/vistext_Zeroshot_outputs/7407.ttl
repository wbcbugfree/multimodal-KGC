@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-7407 a chart:Chart ;
    chart:chartType "line" ;
    chart:title "Indonesia : Distribution of employment by economic sector from 2010 to 2020" ;
    chart:xAxis ex:x-7407 ;
    chart:yAxis ex:y-7407 .

ex:x-7407 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2010" ;
    chart:scaleMax "2018" .

ex:y-7407 a chart:Axis ;
    chart:label "Agriculture" ;
    chart:scaleMin "0.0" ;
    chart:scaleMax "0.4" .

ex:series-7407-1 a chart:Series ;
    chart:seriesName "Agriculture" .

ex:point-7407-1-1 a chart:Point ;
    chart:series ex:series-7407-1 ;
    chart:xVal "2010" ;
    chart:yVal "0.395"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-7407-1-2 a chart:Point ;
    chart:series ex:series-7407-1 ;
    chart:xVal "2011" ;
    chart:yVal "0.38"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

