    chart:series ex:series-7407-1 ;
    chart:xVal "2012" ;
    chart:yVal "0.37"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-7407-1-4 a chart:Point ;
    chart:series ex:series-7407-1 ;
    chart:xVal "2013" ;
    chart:yVal "0.36"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-7407-1-5 a chart:Point ;
    chart:series ex:series-7407-1 ;
    chart:xVal "2014" ;
    chart:yVal "0.35"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-7407-1-6 a chart:Point ;
