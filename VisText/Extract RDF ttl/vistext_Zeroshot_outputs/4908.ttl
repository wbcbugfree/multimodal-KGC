@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-4908 a chart:Chart ;
    chart:chartType "line" ;
    chart:title "Number of employees of Allianz Group from 2005 to 2019 (in 1,000s)" ;
    chart:xAxis ex:x-4908 ;
    chart:yAxis ex:y-4908 .

ex:x-4908 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2006" ;
    chart:scaleMax "2018" .

ex:y-4908 a chart:Axis ;
    chart:label "Number of employees in thousands" ;
    chart:scaleMin "0" ;
    chart:scaleMax "200" .

ex:series-4908-1 a chart:Series .

ex:point-4908-1-1 a chart:Point ;
    chart:series ex:series-4908-1 ;
    chart:xVal "2006" ;
    chart:yVal "175"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

