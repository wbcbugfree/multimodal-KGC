@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-8791 a chart:Chart ;
    chart:chartType "area" ;
    chart:title "Greece : Distribution of the workforce across economic sectors from 2010 to 2020" ;
    chart:xAxis ex:x-8791 ;
    chart:yAxis ex:y-8791 .

ex:x-8791 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2010" ;
    chart:scaleMax "2020" .

ex:y-8791 a chart:Axis ;
    chart:label "Agriculture" ;
    chart:scaleMin "0.00" ;
    chart:scaleMax "0.14" .

ex:series-8791-1 a chart:Series .

ex:point-8791-1-1 a chart:Point ;
    chart:series ex:series-8791-1 ;
    chart:xVal "2010" ;
    chart:yVal "0.122"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

