@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-564 a chart:Chart ;
    chart:chartType "area" ;
    chart:xAxis ex:x-564 ;
    chart:yAxis ex:y-564 ;
    chart:title "Operating profit of the Roche Group from 2007 to 2019 (in million Swiss francs)" .

ex:x-564 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2007" ;
    chart:scaleMax "2019" .

ex:y-564 a chart:Axis ;
    chart:label "Operating profit in million Swiss francs" ;
    chart:scaleMin "0" ;
    chart:scaleMax "25000" .

ex:series-564-1 a chart:Series .

ex:point-564-1-1 a chart:Point ;
    chart:series ex:series-564-1 ;
    chart:xVal "2007" ;
    chart:yVal "16000"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-564-1-2 a chart:Point ;
    chart:series ex:series-564-1 ;
    chart:xVal "2008" ;
    chart:yVal "17500"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

