@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-5257 a chart:Chart ;
    chart:chartType "bar" ;
    chart:xAxis ex:x-5257 ;
    chart:yAxis ex:y-5257 ;
    chart:title "Ukraine : national debt from 2010 to 2024 in relation to gross domestic product (GDP)" .

ex:x-5257 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "" ;
    chart:scaleMax "" .

ex:y-5257 a chart:Axis ;
    chart:label "National debt as percent of GDP" ;
    chart:scaleMin "0.0" ;
    chart:scaleMax "0.8" .

ex:series-5257-1 a chart:Series .

ex:mark-5257-1-1 a chart:Bar ;
    chart:series ex:series-5257-1 ;
    chart:category "2010" ;
    chart:value "0.41"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

