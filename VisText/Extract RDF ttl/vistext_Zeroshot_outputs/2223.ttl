@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-2223 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Leading direct selling markets in Europe in 2019 (in billion U.S. dollars)" ;
    chart:subtitle "Value of retail sales in billion U.S. dollars" ;
    chart:xAxis ex:x-2223 ;
    chart:yAxis ex:y-2223 .

ex:x-2223 a chart:Axis ;
    chart:label "Country" ;
    chart:scaleMin "" ;
    chart:scaleMax "" .

ex:y-2223 a chart:Axis ;
    chart:label "" ;
    chart:scaleMin "0" ;
    chart:scaleMax "20" .

ex:series-2223-1 a chart:Series .

ex:mark-2223-1-1 a chart:Bar ;
    chart:series ex:series-2223-1 ;
    chart:category "France" ;
    chart:value "5.1"^^xsd:decimal ;
