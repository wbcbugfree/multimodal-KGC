@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-4906 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Advertising spending in Vietnam from 2004 to 2018 (in million U.S. dollars)" ;
    chart:xAxis ex:x-4906 ;
    chart:yAxis ex:y-4906 .

ex:x-4906 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2004" ;
    chart:scaleMax "2018" .

ex:y-4906 a chart:Axis ;
    chart:label "Spending in million U.S. dollars" ;
    chart:scaleMin "0" ;
    chart:scaleMax "1500" .

ex:series-4906-1 a chart:Series .

ex:mark-4906-1-1 a chart:Bar ;
    chart:series ex:series-4906-1 ;
    chart:category "2004" ;
    chart:value "250"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

