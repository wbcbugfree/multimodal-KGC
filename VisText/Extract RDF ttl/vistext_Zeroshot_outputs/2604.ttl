ex:chart-2604 a chart:Chart ;
    chart:chartType "bar" ;
    chart:xAxis ex:x-2604 ;
    chart:yAxis ex:y-2604 ;
    chart:title "Installed power capacity across Uttarakhand in India from financial year 2005 to 2018" ;
    chart:subtitle "(in megawatts)" .

ex:x-2604 a chart:Axis ;
    chart:label "Installed power capacity in megawatts" ;
    chart:scaleMin "0" ;
    chart:scaleMax "3500" .

ex:y-2604 a chart:Axis ;
    chart:label "year" ;
    chart:scaleMin "FY 2005" ;
    chart:scaleMax "FY 2018" .

ex:series-2604-1 a chart:Series .

ex:mark-2604-1-1 a chart:Bar ;
    chart:series ex:series-2604-1 ;
    chart:category "FY 2005" ;
    chart:value "500"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

