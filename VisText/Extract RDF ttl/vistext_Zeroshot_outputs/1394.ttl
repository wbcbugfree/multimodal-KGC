@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-1394 a chart:Chart ;
    chart:chartType "area" ;
    chart:title "Number of wage and salary workers in the United States paid hourly rates at the prevailing Federal minimum wage from 1979 to 2019 (in 1,000s)" ;
    chart:xAxis ex:x-1394 ;
    chart:yAxis ex:y-1394 .

ex:x-1394 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "1979" ;
    chart:scaleMax "2019" .

ex:y-1394 a chart:Axis ;
    chart:label "Number of workers in thousands" ;
    chart:scaleMin "0" ;
    chart:scaleMax "5000" .

ex:series-1394-1 a chart:Series .

