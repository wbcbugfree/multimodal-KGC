@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-5225 a chart:Chart ;
    chart:chartType "bar" ;
    chart:xAxis ex:x-5225 ;
    chart:yAxis ex:y-5225 .

ex:x-5225 a chart:Axis ;
    chart:label "Prize money pool in million U.S. dollars" ;
    chart:scaleMin "0" ;
    chart:scaleMax "1000" .

ex:y-5225 a chart:Axis ;
    chart:label "Sporting event" ;
    chart:scaleMin "" ;
    chart:scaleMax "" .

ex:series-5225-1 a chart:Series .

ex:mark-5225-1-1 a chart:Bar ;
    chart:series ex:series-5225-1 ;
    chart:category "European Championship*" ;
    chart:value "250"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:mark-5225-1-2 a chart:Bar ;
    chart:series ex:series-5225-1 ;
    chart:category "FIFA World Cup" ;
    chart:value "600"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

