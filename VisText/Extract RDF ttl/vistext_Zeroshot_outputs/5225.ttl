    chart:series ex:series-5225-1 ;
    chart:category "Formula 1" ;
    chart:value "400"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:mark-5225-1-5 a chart:Bar ;
    chart:series ex:series-5225-1 ;
    chart:category "UEFA Champions League" ;
    chart:value "1200"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:mark-5225-1-6 a chart:Bar ;
