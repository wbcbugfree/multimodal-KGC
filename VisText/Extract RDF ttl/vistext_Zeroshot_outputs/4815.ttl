ex:chart-4815 a chart:Chart ;
    chart:chartType "area" ;
    chart:title "Migration balance (immigrants minus emigrants)" ;
    chart:subtitle "in Belgium from 2010 to 2019" ;
    chart:xAxis ex:x-4815 ;
    chart:yAxis ex:y-4815 .

ex:x-4815 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2010" ;
    chart:scaleMax "2018" .

ex:y-4815 a chart:Axis ;
    chart:label "Migration balance" ;
    chart:scaleMin "0" ;
    chart:scaleMax "80000" .

ex:series-4815-1 a chart:Series ;
    chart:seriesName "Migration balance" .

ex:point-4815-1-1 a chart:Point ;
    chart:series ex:series-4815-1 ;
    chart:xVal "2010" ;
    chart:yVal "82000"^^xsd:decimal ;
    chart:valueEstimated "false"^^xsd:boolean .

