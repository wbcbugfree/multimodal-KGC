@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-5592 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Import volume of leather products and substitutes in Italy between January and October 2019 , by import country (in tons)" ;
    chart:xAxis ex:x-5592 ;
    chart:yAxis ex:y-5592 .

ex:x-5592 a chart:Axis ;
    chart:label "Import volume in tons" ;
    chart:scaleMin "0" ;
    chart:scaleMax "80000" .

ex:y-5592 a chart:Axis ;
    chart:label "Country" ;
    chart:scaleMin "" ;
    chart:scaleMax "" .

ex:series-5592-1 a chart:Series .

ex:mark-5592-1-1 a chart:Bar ;
