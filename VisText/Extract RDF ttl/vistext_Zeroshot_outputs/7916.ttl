@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-7916 a chart:Chart ;
    chart:chartType "line" ;
    chart:title "Projected penalty payments under the Affordable Care Act from 2015 to 2025 (in billion U.S. dollars)" ;
    chart:xAxis ex:x-7916 ;
    chart:yAxis ex:y-7916 .

ex:x-7916 a chart:Axis ;
    chart:label "Fiscal year" ;
    chart:scaleMin "2016" ;
    chart:scaleMax "2024" .

ex:y-7916 a chart:Axis ;
    chart:label "By employers*" ;
    chart:scaleMin "0" ;
    chart:scaleMax "20" .

ex:series-7916-1 a chart:Series .

ex:point-7916-1-1 a chart:Point ;
    chart:series ex:series-7916-1 ;
    chart:xVal "2016" ;
    chart:yVal "0"^^xsd:decimal ;
    chart:valueEstimated "false"^^xsd:boolean .

ex:point-7916-1-2 a chart:Point ;
    chart:series ex:series-7916-1 ;
    chart:xVal "2016" ;
    chart:yVal "6"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-7916-1-3 a chart:Point ;
    chart:series ex:series-7916-1 ;
    chart:xVal "2017" ;
    chart:yVal "11"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

