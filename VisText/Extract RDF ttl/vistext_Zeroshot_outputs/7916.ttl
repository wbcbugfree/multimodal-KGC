    chart:series ex:series-7916-1 ;
    chart:xVal "2018" ;
    chart:yVal "12"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-7916-1-5 a chart:Point ;
    chart:series ex:series-7916-1 ;
    chart:xVal "2019" ;
    chart:yVal "15"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

