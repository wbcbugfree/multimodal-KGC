@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-1680 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Number of single-woman households in Denmark in 2020 , by age group" ;
    chart:xAxis ex:x-1680 ;
    chart:yAxis ex:y-1680 .

ex:x-1680 a chart:Axis ;
    chart:label "Number of single-women households" ;
    chart:scaleMin "0" ;
    chart:scaleMax "140000" .

ex:y-1680 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "" ;
    chart:scaleMax "" .

ex:series-1680-1 a chart:Series .

ex:mark-1680-1-1 a chart:Bar ;
    chart:series ex:series-1680-1 ;
    chart:category "100 years and more" ;
    chart:value "10000"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:mark-1680-1-2 a chart:Bar ;
    chart:series ex:series-1680-1 ;
    chart:category "20-29 years" ;
    chart:value "65000"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:mark-1680-1-3 a chart:Bar ;
    chart:series ex:series-1680-1 ;
    chart:category "30-39 years" ;
    chart:value "55000"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:mark-1680-1-4 a chart:Bar ;
    chart:series ex:series-1680-1 ;
    chart:category "40-49 years" ;
    chart:value "70000"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:mark-1680-1-5 a chart:Bar ;
    chart:series ex:series-1680-1 ;
    chart:category "50-59 years" ;
    chart:value "105000"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:mark-1680-1-6 a chart:Bar ;
    chart:series ex:series-1680-1 ;
    chart:category "60-69 years" ;
    chart:value "100000"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:mark-1680-1-7 a chart:Bar ;
    chart:series ex:series-1680-1 ;
    chart:category "70-79 years" ;
    chart:value "125000"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:mark-1680-1-8 a chart:Bar ;
    chart:series ex:series-1680-1 ;
    chart:category "80-89 years" ;
    chart:value "90000"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:mark-1680-1-9 a chart:Bar ;
    chart:series ex:series-1680-1 ;
    chart:category "90-99 years" ;
    chart:value "30000"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:mark-1680-1-10 a chart:Bar ;
    chart:series ex:series-1680-1 ;
    chart:category "Under 20 years" ;
    chart:value "5000"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .
