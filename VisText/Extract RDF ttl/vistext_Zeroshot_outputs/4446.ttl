@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-4446 a chart:Chart ;
    chart:chartType "line" ;
    chart:title "Carolina Panthers revenue from 2001 to 2019" ;
    chart:subtitle "(in million U.S. dollars)" ;
    chart:xAxis ex:x-4446 ;
    chart:yAxis ex:y-4446 .

ex:x-4446 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2001" ;
    chart:scaleMax "2019" .

ex:y-4446 a chart:Axis ;
    chart:label "Revenue in million U.S. dollars" ;
    chart:scaleMin "0" ;
    chart:scaleMax "400" .

ex:series-4446-1 a chart:Series ;
    chart:seriesName "Revenue" .

ex:point-4446-1-1 a chart:Point ;
    chart:series ex:series-4446-1 ;
    chart:xVal "2001" ;
    chart:yVal "150"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

