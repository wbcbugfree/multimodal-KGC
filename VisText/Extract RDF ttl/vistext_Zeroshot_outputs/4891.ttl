@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-4891 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Leading fashion brands with the most Facebook fans as of October 2020 (in millions)" ;
    chart:xAxis ex:x-4891 ;
    chart:yAxis ex:y-4891 .

ex:x-4891 a chart:Axis ;
    chart:label "brand" ;
    chart:scaleMin "" ;
    chart:scaleMax "" .

ex:y-4891 a chart:Axis ;
    chart:label "Number of fans in millions" ;
    chart:scaleMin "0" ;
    chart:scaleMax "25" .

ex:series-4891-1 a chart:Series .

ex:mark-4891-1-1 a chart:Bar ;
    chart:series ex:series-4891-1 ;
    chart:category "Amore Mio" ;
    chart:value "6.5"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

