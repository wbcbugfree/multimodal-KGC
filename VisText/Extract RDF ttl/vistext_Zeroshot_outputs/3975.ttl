@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-3975 a chart:Chart ;
    chart:chartType "area" ;
    chart:title "Stock price of Unilever at Euronext Amsterdam from August 2019 to January 2021 (in euros)" ;
    chart:xAxis ex:x-3975 ;
    chart:yAxis ex:y-3975 .

ex:x-3975 a chart:Axis ;
    chart:label "Month" ;
    chart:scaleMin "" ;
    chart:scaleMax "" .

ex:y-3975 a chart:Axis ;
    chart:label "Stock price in euros" ;
    chart:scaleMin "0" ;
    chart:scaleMax "60" .

ex:series-3975-1 a chart:Series .

ex:point-3975-1-1 a chart:Point ;
    chart:series ex:series-3975-1 ;
    chart:xVal "October" ;
    chart:yVal "52.5"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-3975-1-2 a chart:Point ;
    chart:series ex:series-3975-1 ;
    chart:xVal "2020" ;
    chart:yVal "52.0"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-3975-1-3 a chart:Point ;
    chart:series ex:series-3975-1 ;
    chart:xVal "April" ;
    chart:yVal "40.0"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-3975-1-4 a chart:Point ;
    chart:series ex:series-3975-1 ;
    chart:xVal "July" ;
    chart:yVal "47.0"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-3975-1-5 a chart:Point ;
    chart:series ex:series-3975-1 ;
    chart:xVal "October" ;
    chart:yVal "50.0"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-3975-1-6 a chart:Point ;
    chart:series ex:series-3975-1 ;
    chart:xVal "2021" ;
    chart:yVal "50.0"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .
