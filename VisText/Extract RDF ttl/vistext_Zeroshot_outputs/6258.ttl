ex:chart-6258 a chart:Chart ;
    chart:chartType "line" ;
    chart:title "Voter turnout rates among selected age groups in U.S. presidential elections from 1964 to 2016" ;
    chart:xAxis ex:x-6258 ;
    chart:yAxis ex:y-6258 .

ex:x-6258 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "1964" ;
    chart:scaleMax "2016" .

ex:y-6258 a chart:Axis ;
    chart:label "18-24**" ;
    chart:scaleMin "0.0" ;
    chart:scaleMax "0.5" .

ex:series-6258-1 a chart:Series .

