@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-1928 a chart:Chart ;
    chart:chartType "line" ;
    chart:xAxis ex:x-1928 ;
    chart:yAxis ex:y-1928 ;
    chart:title "Statutory health insurances spending for medical treatment in Germany from 2000 to 2019 (in billion euros)" .

ex:x-1928 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2000" ;
    chart:scaleMax "2015" .

ex:y-1928 a chart:Axis ;
    chart:label "Spending in billion euros" ;
    chart:scaleMin "0" ;
    chart:scaleMax "40" .

ex:series-1928-1 a chart:Series .

ex:point-1928-1-1 a chart:Point ;
    chart:series ex:series-1928-1 ;
    chart:xVal "2000" ;
    chart:yVal "22.0"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

