@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-5007 a chart:Chart ;
    chart:chartType "bar" ;
    chart:xAxis ex:x-5007 ;
    chart:yAxis ex:y-5007 ;
    chart:title "Public sector expenditure on unemployment benefits in the United Kingdom (UK) from 2009/10 to 2019/20 (in billion GBP)" .

ex:x-5007 a chart:Axis ;
    chart:label "Expenditure in billion GBP" ;
    chart:scaleMin "0" ;
    chart:scaleMax "6" .

ex:y-5007 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2009/10" ;
    chart:scaleMax "2019/20" .

ex:series-5007-1 a chart:Series .

ex:mark-5007-1-1 a chart:Bar ;
    chart:series ex:series-5007-1 ;
    chart:category "2009/10" ;
    chart:value "5.5"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:mark-5007-1-2 a chart:Bar ;
    chart:series ex:series-5007-1 ;
    chart:category "2010/11" ;
    chart:value "5.2"^^xsd:decimal ;
