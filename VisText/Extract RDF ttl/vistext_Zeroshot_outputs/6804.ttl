@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-6804 a chart:Chart ;
    chart:chartType "line" ;
    chart:xAxis ex:x-6804 ;
    chart:yAxis ex:y-6804 ;
    chart:title "Wood production in the United States from 2003 to 2014 , by type (in million cubic meters)" .

ex:x-6804 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2004" ;
    chart:scaleMax "2012" .

ex:y-6804 a chart:Axis ;
    chart:label "Sawnwood production" ;
    chart:scaleMin "0" ;
    chart:scaleMax "100" .

ex:series-6804-1 a chart:Series ;
    chart:seriesName "Wood production" .

ex:point-6804-1-1 a chart:Point ;
    chart:series ex:series-6804-1 ;
    chart:xVal "2004" ;
    chart:yVal "84"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-6804-1-2 a chart:Point ;
    chart:series ex:series-6804-1 ;
    chart:xVal "2005" ;
    chart:yVal "90"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-6804-1-3 a chart:Point ;
    chart:series ex:series-6804-1 ;
    chart:xVal "2006" ;
    chart:yVal "94"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-6804-1-4 a chart:Point ;
    chart:series ex:series-6804-1 ;
    chart:xVal "2007" ;
    chart:yVal "90"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-6804-1-5 a chart:Point ;
    chart:series ex:series-6804-1 ;
    chart:xVal "2008" ;
    chart:yVal "82"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-6804-1-6 a chart:Point ;
