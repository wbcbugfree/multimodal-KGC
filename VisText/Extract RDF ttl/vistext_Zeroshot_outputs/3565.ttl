@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-3565 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Number of passenger cars registered in Finland in 2019 , by model" ;
    chart:xAxis ex:x-3565 ;
    chart:yAxis ex:y-3565 .

ex:x-3565 a chart:Axis ;
    chart:label "automobile model series" ;
    chart:scaleMin "" ;
    chart:scaleMax "" .

ex:y-3565 a chart:Axis ;
    chart:label "Number of cars" ;
    chart:scaleMin "0" ;
    chart:scaleMax "6000" .

ex:series-3565-1 a chart:Series .

ex:mark-3565-1-1 a chart:Bar ;
    chart:series ex:series-3565-1 ;
    chart:category "Ford Fiesta" ;
    chart:value "2400"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

