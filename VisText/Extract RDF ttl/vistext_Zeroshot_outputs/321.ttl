@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-321 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Distribution of Amazon Dash button sales as of February 2016 , by brand" ;
    chart:xAxis ex:x-321 ;
    chart:yAxis ex:y-321 .

ex:x-321 a chart:Axis ;
    chart:label "Response" ;
    chart:scaleMin "" ;
    chart:scaleMax "" .

ex:y-321 a chart:Axis ;
    chart:label "Share of Amazon Dash Button sales" ;
    chart:scaleMin "0.00" ;
    chart:scaleMax "0.20" .

ex:series-321-1 a chart:Series .

ex:mark-321-1-1 a chart:Bar ;
    chart:series ex:series-321-1 ;
    chart:category "Bounty" ;
    chart:value "0.17"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:mark-321-1-2 a chart:Bar ;
    chart:series ex:series-321-1 ;
    chart:category "Cottonelle" ;
    chart:value "0.21"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:mark-321-1-3 a chart:Bar ;
    chart:series ex:series-321-1 ;
    chart:category "Gatorade" ;
    chart:value "0.07"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:mark-321-1-4 a chart:Bar ;
    chart:series ex:series-321-1 ;
    chart:category "Gillette" ;
    chart:value "0.05"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:mark-321-1-5 a chart:Bar ;
    chart:series ex:series-321-1 ;
    chart:category "Glad" ;
    chart:value "0.12"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:mark-321-1-6 a chart:Bar ;
    chart:series ex:series-321-1 ;
    chart:category "Huggies" ;
    chart:value "0.035"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:mark-321-1-7 a chart:Bar ;
    chart:series ex:series-321-1 ;
    chart:category "Mrs. Meyer's" ;
    chart:value "0.055"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:mark-321-1-8 a chart:Bar ;
    chart:series ex:series-321-1 ;
    chart:category "Smartwaiter" ;
    chart:value "0.045"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:mark-321-1-9 a chart:Bar ;
    chart:series ex:series-321-1 ;
    chart:category "Tide" ;
    chart:value "0.22"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:mark-321-1-10 a chart:Bar ;
    chart:series ex:series-321-1 ;
    chart:category "Ziploc" ;
    chart:value "0.04"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .
