@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-1068 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Most annoying hotel guest behavior according to fellow travelers in the United States" ;
    chart:subtitle "as of September 2014" ;
    chart:xAxis ex:x-1068 ;
    chart:yAxis ex:y-1068 .

ex:x-1068 a chart:Axis ;
    chart:label "Response" ;
    chart:scaleMin "" ;
    chart:scaleMax "" .

ex:y-1068 a chart:Axis ;
    chart:label "Share of respondents" ;
    chart:scaleMin "0.0" ;
    chart:scaleMax "0.6" .

ex:series-1068-1 a chart:Series .

ex:mark-1068-1-1 a chart:Bar ;
    chart:series ex:series-1068-1 ;
    chart:category "Guests that are rude to hotel staff" ;
    chart:value "0.55"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

