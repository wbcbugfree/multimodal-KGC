@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-358 a chart:Chart ;
    chart:chartType "line" ;
    chart:title "Poverty rate for families in the United" ;
    chart:subtitle "States from 1990 to 2019" ;
    chart:xAxis ex:x-358 ;
    chart:yAxis ex:y-358 .

ex:x-358 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "1990" ;
    chart:scaleMax "2019" .

ex:y-358 a chart:Axis ;
    chart:label "Poverty rate" ;
    chart:scaleMin "0.00" ;
    chart:scaleMax "0.12" .

ex:series-358-1 a chart:Series ;
    chart:seriesName "Poverty rate" .

ex:point-358-1-1 a chart:Point ;
    chart:series ex:series-358-1 ;
    chart:xVal "1990" ;
    chart:yVal "0.11"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

