@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-7781 a chart:Chart ;
    chart:chartType "area" ;
    chart:title "How many hours in a typical week would you say you use the internet ?" ;
    chart:xAxis ex:x-7781 ;
    chart:yAxis ex:y-7781 .

ex:x-7781 a chart:Axis ;
    chart:label "Response" ;
    chart:scaleMin "" ;
    chart:scaleMax "" .

ex:y-7781 a chart:Axis ;
    chart:label "At home" ;
    chart:scaleMin "0" ;
    chart:scaleMax "15" .

ex:series-7781-1 a chart:Series ;
    chart:seriesName "At home" .

ex:point-7781-1-1 a chart:Point ;
    chart:series ex:series-7781-1 ;
    chart:xVal "2006" ;
    chart:yVal 6.5 ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-7781-1-2 a chart:Point ;
    chart:series ex:series-7781-1 ;
    chart:xVal "2008" ;
    chart:yVal 7.5 ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-7781-1-3 a chart:Point ;
    chart:series ex:series-7781-1 ;
    chart:xVal "2010" ;
    chart:yVal 9.5 ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-7781-1-4 a chart:Point ;
    chart:series ex:series-7781-1 ;
    chart:xVal "2012" ;
    chart:yVal 10.5 ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-7781-1-5 a chart:Point ;
    chart:series ex:series-7781-1 ;
    chart:xVal "2014" ;
    chart:yVal 13.5 ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-7781-1-6 a chart:Point ;
    chart:series ex:series-7781-1 ;
    chart:xVal "2016" ;
    chart:yVal 14.5 ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-7781-1-7 a chart:Point ;
    chart:series ex:series-7781-1 ;
    chart:xVal "2018" ;
    chart:yVal 15.5 ;
    chart:valueEstimated "true"^^xsd:boolean .
