@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-2718 a chart:Chart ;
    chart:chartType "line" ;
    chart:title "EOG Resources ' total assets from 2009 to 2019 (in million U.S. dollars)" ;
    chart:xAxis ex:x-2718 ;
    chart:yAxis ex:y-2718 .

ex:x-2718 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2009" ;
    chart:scaleMax "2019" .

ex:y-2718 a chart:Axis ;
    chart:label "Total assets in million U.S. dollars" ;
    chart:scaleMin "0" ;
    chart:scaleMax "40000" .

ex:series-2718-1 a chart:Series .

ex:point-2718-1-1 a chart:Point ;
    chart:series ex:series-2718-1 ;
    chart:xVal "2009" ;
    chart:yVal "13000"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

