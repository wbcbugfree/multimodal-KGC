    chart:valueEstimated "true"^^xsd:boolean .

ex:point-3782-1-7 a chart:Point ;
    chart:series ex:series-3782-1 ;
    chart:xVal "2010" ;
    chart:yVal "175000"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .
