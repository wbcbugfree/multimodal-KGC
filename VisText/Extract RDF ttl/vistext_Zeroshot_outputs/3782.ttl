ex:chart-3782 a chart:Chart ;
    chart:chartType "area" ;
    chart:title "U.S. electric capacity resources for the SERC region during the summer peak period between 1998 and 2010 (in megawatts)" ;
    chart:xAxis ex:x-3782 ;
    chart:yAxis ex:y-3782 .

ex:x-3782 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "1998" ;
    chart:scaleMax "2010" .

ex:y-3782 a chart:Axis ;
    chart:label "Capacity resources in megawatts" ;
    chart:scaleMin "0" ;
    chart:scaleMax "250,000" .

ex:series-3782-1 a chart:Series .

ex:point-3782-1-1 a chart:Point ;
    chart:series ex:series-3782-1 ;
    chart:xVal "1998" ;
    chart:yVal "125000"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-3782-1-2 a chart:Point ;
    chart:series ex:series-3782-1 ;
    chart:xVal "2000" ;
    chart:yVal "135000"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-3782-1-3 a chart:Point ;
    chart:series ex:series-3782-1 ;
    chart:xVal "2002" ;
    chart:yVal "145000"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-3782-1-4 a chart:Point ;
    chart:series ex:series-3782-1 ;
    chart:xVal "2004" ;
    chart:yVal "170000"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-3782-1-5 a chart:Point ;
    chart:series ex:series-3782-1 ;
    chart:xVal "2006" ;
    chart:yVal "195000"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-3782-1-6 a chart:Point ;
