@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-7425 a chart:Chart ;
    chart:chartType "area" ;
    chart:title "Georgia : Age structure from 2009 to 2019" ;
    chart:xAxis ex:x-7425 ;
    chart:yAxis ex:y-7425 .

ex:x-7425 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2009" ;
    chart:scaleMax "2019" .

ex:y-7425 a chart:Axis ;
    chart:label "65 years and older" ;
    chart:scaleMin "0.00" ;
    chart:scaleMax "0.15" .

ex:series-7425-1 a chart:Series ;
    chart:seriesName "65 years and older" .

ex:point-7425-1-1 a chart:Point ;
    chart:series ex:series-7425-1 ;
    chart:xVal "2009" ;
    chart:yVal "0.145"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-7425-1-2 a chart:Point ;
    chart:series ex:series-7425-1 ;
    chart:xVal "2010" ;
    chart:yVal "0.146"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-7425-1-3 a chart:Point ;
    chart:series ex:series-7425-1 ;
    chart:xVal "2012" ;
    chart:yVal "0.147"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-7425-1-4 a chart:Point ;
    chart:series ex:series-7425-1 ;
    chart:xVal "2014" ;
    chart:yVal "0.148"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-7425-1-5 a chart:Point ;
    chart:series ex:series-7425-1 ;
    chart:xVal "2016" ;
    chart:yVal "0.149"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-7425-1-6 a chart:Point ;
    chart:series ex:series-7425-1 ;
    chart:xVal "2018" ;
    chart:yVal "0.150"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-7425-1-7 a chart:Point ;
    chart:series ex:series-7425-1 ;
    chart:xVal "2019" ;
    chart:yVal "0.151"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .
