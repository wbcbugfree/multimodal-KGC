@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-485 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "The richest self-made women billionaires in the United States in 2017 (in billion U.S. dollars)" ;
    chart:xAxis ex:x-485 ;
    chart:yAxis ex:y-485 .

ex:x-485 a chart:Axis ;
    chart:label "self-made women billionaires" ;
    chart:scaleMin "" ;
    chart:scaleMax "" .

ex:y-485 a chart:Axis ;
    chart:label "Net worth in billion U.S.dollars" ;
    chart:scaleMin "0" ;
    chart:scaleMax "5" .

ex:series-485-1 a chart:Series .

ex:mark-485-1-1 a chart:Bar ;
    chart:series ex:series-485-1 ;
    chart:category "Diane Hendricks" ;
    chart:value "4.9"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

