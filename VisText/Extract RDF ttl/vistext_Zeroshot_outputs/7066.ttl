    chart:label "computer occupations" ;
    chart:scaleMin "" ;
    chart:scaleMax "" .

ex:y-7066 a chart:Axis ;
    chart:label "Asian" ;
    chart:scaleMin "0.0" ;
    chart:scaleMax "0.4" .

ex:series-7066-1 a chart:Series .

