@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-3056 a chart:Chart ;
    chart:chartType "bar" ;
    chart:xAxis ex:x-3056 ;
    chart:yAxis ex:y-3056 ;
    chart:title "Criminal use of explosives in Canada in 2014 , by incident" .

ex:x-3056 a chart:Axis ;
    chart:label "Number of incidents involving explosives" ;
    chart:scaleMin "0" ;
    chart:scaleMax "60" .

ex:y-3056 a chart:Axis ;
    chart:label "Incident" ;
    chart:scaleMin "" ;
    chart:scaleMax "" .

ex:series-3056-1 a chart:Series .

ex:mark-3056-1-1 a chart:Bar ;
    chart:series ex:series-3056-1 ;
    chart:category "Accidental explosion" ;
    chart:value "2"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:mark-3056-1-2 a chart:Bar ;
    chart:series ex:series-3056-1 ;
    chart:category "Attempted bombing" ;
    chart:value "4"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:mark-3056-1-3 a chart:Bar ;
    chart:series ex:series-3056-1 ;
    chart:category "Bombing" ;
    chart:value "3"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:mark-3056-1-4 a chart:Bar ;
    chart:series ex:series-3056-1 ;
    chart:category "CBRN incidents" ;
    chart:value "1"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:mark-3056-1-5 a chart:Bar ;
    chart:series ex:series-3056-1 ;
    chart:category "Death" ;
    chart:value "15"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:mark-3056-1-6 a chart:Bar ;
    chart:series ex:series-3056-1 ;
    chart:category "Hoax device" ;
    chart:value "25"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:mark-3056-1-7 a chart:Bar ;
    chart:series ex:series-3056-1 ;
    chart:category "Injured" ;
    chart:value "58"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:mark-3056-1-8 a chart:Bar ;
    chart:series ex:series-3056-1 ;
    chart:category "Recovery of IED & HME" ;
    chart:value "12"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:mark-3056-1-9 a chart:Bar ;
    chart:series ex:series-3056-1 ;
    chart:category "Recovery of commercial & militar..." ;
    chart:value "2"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:mark-3056-1-10 a chart:Bar ;
    chart:series ex:series-3056-1 ;
    chart:category "Recovery of inert military ordnance" ;
    chart:value "1"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:mark-3056-1-11 a chart:Bar ;
    chart:series ex:series-3056-1 ;
    chart:category "Theft of explosives" ;
    chart:value "0"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .
