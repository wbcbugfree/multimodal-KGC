@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-1231 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Average number of search terms for online search queries in Canada as of January 2020" ;
    chart:xAxis ex:x-1231 ;
    chart:yAxis ex:y-1231 .

ex:x-1231 a chart:Axis ;
    chart:label "Response" ;
    chart:scaleMin "" ;
    chart:scaleMax "" .

ex:y-1231 a chart:Axis ;
    chart:label "Share of searches" ;
    chart:scaleMin "0.0" ;
    chart:scaleMax "0.5" .

ex:series-1231-1 a chart:Series .

ex:mark-1231-1-1 a chart:Bar ;
    chart:series ex:series-1231-1 ;
    chart:category "Eight words" ;
    chart:value "0.01"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:mark-1231-1-2 a chart:Bar ;
    chart:series ex:series-1231-1 ;
    chart:category "Five words" ;
    chart:value "0.05"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:mark-1231-1-3 a chart:Bar ;
    chart:series ex:series-1231-1 ;
    chart:category "Four words" ;
    chart:value "0.06"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:mark-1231-1-4 a chart:Bar ;
    chart:series ex:series-1231-1 ;
    chart:category "Nine words" ;
    chart:value "0.1"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:mark-1231-1-5 a chart:Bar ;
    chart:series ex:series-1231-1 ;
    chart:category "One word" ;
    chart:value "0.21"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:mark-1231-1-6 a chart:Bar ;
    chart:series ex:series-1231-1 ;
    chart:category "Seven words" ;
    chart:value "0.02"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:mark-1231-1-7 a chart:Bar ;
    chart:series ex:series-1231-1 ;
    chart:category "Six words" ;
    chart:value "0.03"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:mark-1231-1-8 a chart:Bar ;
    chart:series ex:series-1231-1 ;
    chart:category "Ten or more words" ;
    chart:value "0.02"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:mark-1231-1-9 a chart:Bar ;
    chart:series ex:series-1231-1 ;
    chart:category "Three words" ;
    chart:value "0.24"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:mark-1231-1-10 a chart:Bar ;
    chart:series ex:series-1231-1 ;
    chart:category "Two words" ;
    chart:value "0.47"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .
