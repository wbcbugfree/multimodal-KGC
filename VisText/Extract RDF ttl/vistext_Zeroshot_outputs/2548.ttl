@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-2548 a chart:Chart ;
    chart:chartType "bar" ;
    chart:xAxis ex:x-2548 ;
    chart:yAxis ex:y-2548 ;
    chart:title "Average prices for palm oil worldwide from 2014 to 2025 (in nominal U.S. dollars per mt)" .

ex:x-2548 a chart:Axis ;
    chart:label "Price in nominal U.S. dollars per metric ton" ;
    chart:scaleMin "0" ;
    chart:scaleMax "800" .

ex:y-2548 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2014" ;
    chart:scaleMax "2025*" .

ex:series-2548-1 a chart:Series .

ex:mark-2548-1-1 a chart:Bar ;
    chart:series ex:series-2548-1 ;
    chart:category "2014" ;
    chart:value "770"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

