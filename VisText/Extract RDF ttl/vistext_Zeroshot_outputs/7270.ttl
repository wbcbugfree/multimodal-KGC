@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-7270 a chart:Chart ;
    chart:chartType "line" ;
    chart:title "Swaziland : Distribution of gross domestic product (GDP) across economic sectors from 2009 to 2019" ;
    chart:xAxis ex:x-7270 ;
    chart:yAxis ex:y-7270 .

ex:x-7270 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2009" ;
    chart:scaleMax "2019" .

ex:y-7270 a chart:Axis ;
    chart:label "Agriculture" ;
    chart:scaleMin "0.00" ;
    chart:scaleMax "0.10" .

ex:series-7270-1 a chart:Series ;
    chart:seriesName "Agriculture" .

ex:point-7270-1-1 a chart:Point ;
    chart:series ex:series-7270-1 ;
    chart:xVal "2009" ;
    chart:yVal "0.092"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-7270-1-2 a chart:Point ;
    chart:series ex:series-7270-1 ;
    chart:xVal "2010" ;
    chart:yVal "0.097"^^xsd:decimal ;
