@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-835 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Annual volume of pineapple sold in the United Kingdom (UK) from 2008 to 2018 (in 1,000 tonnes)" ;
    chart:subtitle "Sales volume in thousand tonnes" ;
    chart:xAxis ex:x-835 ;
    chart:yAxis ex:y-835 .

ex:x-835 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "" ;
    chart:scaleMax "" .

ex:y-835 a chart:Axis ;
    chart:label "Sales volume in thousand tonnes" ;
    chart:scaleMin "0" ;
    chart:scaleMax "40" .

ex:series-835-1 a chart:Series .

ex:mark-835-1-1 a chart:Bar ;
    chart:series   ex:series-835-1 ;
    chart:category "2008" ;
    chart:value    "41.5"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:mark-835-1-2 a chart:Bar ;
    chart:series   ex:series-835-1 ;
    chart:category "2009" ;
    chart:value    "42.0"^^xsd:decimal ;
