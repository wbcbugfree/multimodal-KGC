@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-2427 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Cities around the world with the highest fatality rates from terrorism in 2014" ;
    chart:xAxis ex:x-2427 ;
    chart:yAxis ex:y-2427 .

ex:x-2427 a chart:Axis ;
    chart:label "Rate per 100,000 population" ;
    chart:scaleMin "0" ;
    chart:scaleMax "40" .

ex:y-2427 a chart:Axis ;
    chart:label "city" ;
    chart:scaleMin "" ;
    chart:scaleMax "" .

ex:series-2427-1 a chart:Series .

ex:mark-2427-1-1 a chart:Bar ;
    chart:series ex:series-2427-1 ;
    chart:category "Baghdad" ;
    chart:value "42"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

