@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-8063 a chart:Chart ;
    chart:chartType "line" ;
    chart:xAxis ex:x-8063 ;
    chart:yAxis ex:y-8063 ;
    chart:title "Egypt : Distribution of gross domestic product (GDP) across economic sectors from 2009 to 2019" .

ex:x-8063 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2009" ;
    chart:scaleMax "2019" .

ex:y-8063 a chart:Axis ;
    chart:label "Agriculture" ;
    chart:scaleMin "0.00" ;
    chart:scaleMax "0.14" .

ex:series-8063-1 a chart:Series .

ex:point-8063-1-1 a chart:Point ;
    chart:series ex:series-8063-1 ;
    chart:xVal "2009" ;
    chart:yVal 0.132 ;
    chart:valueEstimated "true"^^xsd:boolean .

