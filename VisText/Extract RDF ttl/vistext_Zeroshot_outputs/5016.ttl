@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-5016 a chart:Chart ;
    chart:chartType "area" ;
    chart:title "Number of employees of Penguin Random House" ;
    chart:subtitle "from 2005 to 2019" ;
    chart:xAxis ex:x-5016 ;
    chart:yAxis ex:y-5016 .

ex:x-5016 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2005" ;
    chart:scaleMax "2019" .

ex:y-5016 a chart:Axis ;
    chart:label "Number of employees" ;
    chart:scaleMin "0" ;
    chart:scaleMax "12000" .

ex:series-5016-1 a chart:Series .

ex:point-5016-1-1 a chart:Point ;
    chart:series ex:series-5016-1 ;
    chart:xVal "2005" ;
    chart:yVal "6500"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

