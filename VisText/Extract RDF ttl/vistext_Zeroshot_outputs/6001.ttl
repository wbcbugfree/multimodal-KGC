@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-6001 a chart:Chart ;
    chart:chartType "area" ;
    chart:title "Plant load factor (PLF) of combined cycle gas turbine stations in the United Kingdom (UK) , from 2010 to 2019 (percentage)" ;
    chart:xAxis ex:x-6001 ;
    chart:yAxis ex:y-6001 .

ex:x-6001 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2010" ;
    chart:scaleMax "2019" .

ex:y-6001 a chart:Axis ;
    chart:label "Plant load factor as a percentage" ;
    chart:scaleMin "0.0" ;
    chart:scaleMax "0.6" .

ex:series-6001-1 a chart:Series .

ex:point-6001-1-1 a chart:Point ;
    chart:series ex:series-6001-1 ;
    chart:xVal "2010" ;
    chart:yVal 0.6 ;
    chart:valueEstimated "false"^^xsd:boolean .

ex:point-6001-1-2 a chart:Point ;
    chart:series ex:series-6001-1 ;
    chart:xVal "2011" ;
    chart:yVal 0.27 ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-6001-1-3 a chart:Point ;
    chart:series ex:series-6001-1 ;
    chart:xVal "2012" ;
    chart:yVal 0.25 ;
    chart:valueEstimated "false"^^xsd:boolean .

ex:point-6001-1-4 a chart:Point ;
    chart:series ex:series-6001-1 ;
    chart:xVal "2013" ;
    chart:yVal 0.28 ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-6001-1-5 a chart:Point ;
    chart:series ex:series-6001-1 ;
    chart:xVal "2014" ;
    chart:yVal 0.31 ;
    chart:valueEstimated "false"^^xsd:boolean .

ex:point-6001-1-6 a chart:Point ;
    chart:series ex:series-6001-1 ;
    chart:xVal "2015" ;
    chart:yVal 0.48 ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-6001-1-7 a chart:Point ;
    chart:series ex:series-6001-1 ;
    chart:xVal "2016" ;
    chart:yVal 0.47 ;
    chart:valueEstimated "false"^^xsd:boolean .

ex:point-6001-1-8 a chart:Point ;
    chart:series ex:series-6001-1 ;
    chart:xVal "2017" ;
    chart:yVal 0.43 ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-6001-1-9 a chart:Point ;
    chart:series ex:series-6001-1 ;
    chart:xVal "2018" ;
    chart:yVal 0.42 ;
    chart:valueEstimated "false"^^xsd:boolean .

ex:point-6001-1-10 a chart:Point ;
    chart:series ex:series-6001-1 ;
    chart:xVal "2019" ;
    chart:yVal 0.42 ;
    chart:valueEstimated "true"^^xsd:boolean .
