ex:chart-1755 a chart:Chart ;
    chart:chartType "line" ;
    chart:xAxis ex:x-1755 ;
    chart:yAxis ex:y-1755 ;
    chart:title "Proved crude oil reserves in Mexico from 2009 to 2019 (in billion barrels)" .

ex:x-1755 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2009" ;
    chart:scaleMax "2019" .

ex:y-1755 a chart:Axis ;
    chart:label "Oil reserves in billion barrels" ;
    chart:scaleMin "0" ;
    chart:scaleMax "12" .

ex:series-1755-1 a chart:Series .

