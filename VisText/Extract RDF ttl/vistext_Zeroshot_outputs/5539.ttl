@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-5539 a chart:Chart ;
    chart:chartType "line" ;
    chart:title "Average ticket price for Detroit Lions home games from 2006 to 2019 (in U.S. dollars)" ;
    chart:xAxis ex:x-5539 ;
    chart:yAxis ex:y-5539 .

ex:x-5539 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2006" ;
    chart:scaleMax "2018" .

ex:y-5539 a chart:Axis ;
    chart:label "Average ticket price in U.S. dollars" ;
    chart:scaleMin "0" ;
    chart:scaleMax "100" .

ex:series-5539-1 a chart:Series .

ex:point-5539-1-1 a chart:Point ;
    chart:series ex:series-5539-1 ;
    chart:xVal "2006" ;
    chart:yVal "60"^^xsd:decimal ;
    chart:valueEstimated "false"^^xsd:boolean .

ex:point-5539-1-2 a chart:Point ;
    chart:series ex:series-5539-1 ;
    chart:xVal "2008" ;
    chart:yVal "62"^^xsd:decimal ;
    chart:valueEstimated "false"^^xsd:boolean .

ex:point-5539-1-3 a chart:Point ;
    chart:series ex:series-5539-1 ;
    chart:xVal "2010" ;
    chart:yVal "65"^^xsd:decimal ;
    chart:valueEstimated "false"^^xsd:boolean .

ex:point-5539-1-4 a chart:Point ;
    chart:series ex:series-5539-1 ;
    chart:xVal "2012" ;
    chart:yVal "63"^^xsd:decimal ;
    chart:valueEstimated "false"^^xsd:boolean .

ex:point-5539-1-5 a chart:Point ;
    chart:series ex:series-5539-1 ;
    chart:xVal "2014" ;
    chart:yVal "64"^^xsd:decimal ;
    chart:valueEstimated "false"^^xsd:boolean .

ex:point-5539-1-6 a chart:Point ;
    chart:series ex:series-5539-1 ;
    chart:xVal "2016" ;
    chart:yVal "70"^^xsd:decimal ;
    chart:valueEstimated "false"^^xsd:boolean .

ex:point-5539-1-7 a chart:Point ;
    chart:series ex:series-5539-1 ;
    chart:xVal "2018" ;
    chart:yVal "72"^^xsd:decimal ;
    chart:valueEstimated "false"^^xsd:boolean .
