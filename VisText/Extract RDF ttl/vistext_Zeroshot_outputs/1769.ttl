@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-1769 a chart:Chart ;
    chart:chartType "line" ;
    chart:title "Turkey : Fertility rate from 2008 to 2018" ;
    chart:subtitle "Children born per woman" ;
    chart:xAxis ex:x-1769 ;
    chart:yAxis ex:y-1769 .

ex:x-1769 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2008" ;
    chart:scaleMax "2016" .

ex:y-1769 a chart:Axis ;
    chart:label "Children born per woman" ;
    chart:scaleMin "0.0" ;
    chart:scaleMax "2.5" .

ex:series-1769-1 a chart:Series ;
    chart:seriesName "Fertility Rate" .

ex:point-1769-1-1 a chart:Point ;
    chart:series ex:series-1769-1 ;
    chart:xVal "2008" ;
    chart:yVal "2.1"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-1769-1-2 a chart:Point ;
    chart:series ex:series-1769-1 ;
    chart:xVal "2010" ;
    chart:yVal "2.08"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-1769-1-3 a chart:Point ;
    chart:series ex:series-1769-1 ;
    chart:xVal "2012" ;
    chart:yVal "2.07"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-1769-1-4 a chart:Point ;
    chart:series ex:series-1769-1 ;
    chart:xVal "2014" ;
    chart:yVal "2.05"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-1769-1-5 a chart:Point ;
    chart:series ex:series-1769-1 ;
    chart:xVal "2016" ;
    chart:yVal "2.03"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .
