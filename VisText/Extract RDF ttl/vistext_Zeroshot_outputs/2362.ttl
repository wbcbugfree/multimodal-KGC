ex:chart-2362 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Average number of civilian deaths per day from gunfire and executions in Iraq war from 2003 to 2013" ;
    chart:subtitle "Average number of civilian deaths per day" ;
    chart:xAxis ex:x-2362 ;
    chart:yAxis ex:y-2362 .

ex:x-2362 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2003" ;
    chart:scaleMax "2013*" .

ex:y-2362 a chart:Axis ;
    chart:label "Average number of civilian deaths per day" ;
    chart:scaleMin "0" ;
    chart:scaleMax "60" .

ex:series-2362-1 a chart:Series .

