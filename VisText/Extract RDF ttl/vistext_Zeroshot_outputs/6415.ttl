    chart:series ex:series-6415-1 ;
    chart:category "Buses do not go to/go directly to p..." ;
    chart:value "0.01"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:mark-6415-1-5 a chart:Bar ;
    chart:series ex:series-6415-1 ;
    chart:category "Buses do not know what bus services ar..." ;
    chart:value "0.005"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:mark-6415-1-6 a chart:Bar ;
    chart:series ex:series-6415-1 ;
    chart:category "I do not know what bus services ar..." ;
    chart:value "0.06"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:mark-6415-1-7 a chart:Bar ;
    chart:series ex:series-6415-1 ;
    chart:category "I have difficulty getting to the bus ..." ;
    chart:value "0.04"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:mark-6415-1-8 a chart:Bar ;
    chart:series ex:series-6415-1 ;
    chart:category "I have difficulty getting to the bus ..." ;
    chart:value "0.005"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:mark-6415-1-9 a chart:Bar ;
    chart:series ex:series-6415-1 ;
    chart:category "I prefer to walk/cycle" ;
    chart:value "0.47"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:mark-6415-1-10 a chart:Bar ;
