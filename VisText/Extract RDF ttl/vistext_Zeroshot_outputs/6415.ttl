@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-6415 a chart:Chart ;
    chart:chartType "bar" ;
    chart:xAxis ex:x-6415 ;
    chart:yAxis ex:y-6415 ;
    chart:title "Why do n't you use / what is the main reason you do n't use local bus services (more often) ?" .

ex:x-6415 a chart:Axis ;
    chart:label "Main reason" ;
    chart:scaleMin "0.0" ;
    chart:scaleMax "0.5" .

ex:y-6415 a chart:Axis ;
    chart:label "Response" ;
    chart:scaleMin "" ;
    chart:scaleMax "" .

ex:series-6415-1 a chart:Series .

ex:mark-6415-1-1 a chart:Bar ;
    chart:series ex:series-6415-1 ;
    chart:category "Bus fares are too high" ;
    chart:value "0.03"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:mark-6415-1-2 a chart:Bar ;
    chart:series ex:series-6415-1 ;
    chart:category "Buses are not frequent enough/do ..." ;
    chart:value "0.06"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:mark-6415-1-3 a chart:Bar ;
    chart:series ex:series-6415-1 ;
    chart:category "Buses are not reliable enough" ;
    chart:value "0.03"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

