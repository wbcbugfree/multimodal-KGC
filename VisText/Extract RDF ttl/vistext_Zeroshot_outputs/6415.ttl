    chart:category "It is cheaper by car" ;
    chart:value "0.09"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:mark-6415-1-11 a chart:Bar ;
    chart:series ex:series-6415-1 ;
    chart:category "It is easier/more convenient by car" ;
    chart:value "0.08"^^xsd:decimal ;
