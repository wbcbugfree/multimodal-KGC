@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-646 a chart:Chart ;
    chart:chartType "line" ;
    chart:xAxis ex:x-646 ;
    chart:yAxis ex:y-646 .

ex:x-646 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "1980" ;
    chart:scaleMax "2010" .

ex:y-646 a chart:Axis ;
    chart:label "Revenue in billion U.S. dollars" ;
    chart:scaleMin "0" ;
    chart:scaleMax "400" .

ex:series-646-1 a chart:Series .

ex:point-646-1-1 a chart:Point ;
    chart:series ex:series-646-1 ;
    chart:xVal "1980" ;
    chart:yVal "50"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-646-1-2 a chart:Point ;
    chart:series ex:series-646-1 ;
    chart:xVal "1985" ;
    chart:yVal "80"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-646-1-3 a chart:Point ;
    chart:series ex:series-646-1 ;
    chart:xVal "1990" ;
    chart:yVal "130"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-646-1-4 a chart:Point ;
    chart:series ex:series-646-1 ;
    chart:xVal "1995" ;
    chart:yVal "200"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-646-1-5 a chart:Point ;
    chart:series ex:series-646-1 ;
    chart:xVal "2000" ;
    chart:yVal "270"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-646-1-6 a chart:Point ;
    chart:series ex:series-646-1 ;
    chart:xVal "2005" ;
    chart:yVal "350"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-646-1-7 a chart:Point ;
    chart:series ex:series-646-1 ;
    chart:xVal "2010" ;
    chart:yVal "450"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .
