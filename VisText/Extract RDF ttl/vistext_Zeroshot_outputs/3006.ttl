@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-3006 a chart:Chart ;
    chart:chartType "bar" ;
    chart:xAxis ex:x-3006 ;
    chart:yAxis ex:y-3006 ;
    chart:title "Number of Dollarama stores in Canada as of January 2020 , by province" ;
    chart:subtitle "Number of stores" .

ex:x-3006 a chart:Axis ;
    chart:label "province of Canada" ;
    chart:scaleMin "" ;
    chart:scaleMax "" .

ex:y-3006 a chart:Axis ;
    chart:label "" ;
    chart:scaleMin "0" ;
    chart:scaleMax "500" .

ex:series-3006-1 a chart:Series .

ex:mark-3006-1-1 a chart:Bar ;
    chart:series ex:series-3006-1 ;
    chart:category "Alberta" ;
    chart:value "110"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

