@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-3592 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Number of tourist arrivals from the United Kingdom (UK) in Lanzarote in 2014 , by region of origin" ;
    chart:xAxis ex:x-3592 ;
    chart:yAxis ex:y-3592 .

ex:x-3592 a chart:Axis ;
    chart:label "region of England" ;
    chart:scaleMin "" ;
    chart:scaleMax "" .

ex:y-3592 a chart:Axis ;
    chart:label "Number of arrivals" ;
    chart:scaleMin "0" ;
    chart:scaleMax "150000" .

ex:series-3592-1 a chart:Series .

ex:mark-3592-1-1 a chart:Bar ;
    chart:series   ex:series-3592-1 ;
    chart:category "East Midlands" ;
    chart:value    "80000"^^xsd:decimal ;
