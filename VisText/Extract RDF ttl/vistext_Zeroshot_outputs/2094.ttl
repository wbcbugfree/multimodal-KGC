ex:chart-2094 a chart:Chart ;
    chart:chartType "line" ;
    chart:xAxis ex:x-2094 ;
    chart:yAxis ex:y-2094 ;
    chart:title "Number of direct deaths from eating disorders in the U.S. from 1990 to 2017" ;
    chart:subtitle "Number of deaths" .

ex:x-2094 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "1990" ;
    chart:scaleMax "2015" .

ex:y-2094 a chart:Axis ;
    chart:label "" ;
    chart:scaleMin "0" ;
    chart:scaleMax "40" .

ex:series-2094-1 a chart:Series .

ex:point-2094-1-1 a chart:Point ;
    chart:series ex:series-2094-1 ;
    chart:xVal "1990" ;
    chart:yVal "22"^^xsd:decimal ;
    chart:valueEstimated "false"^^xsd:boolean .

ex:point-2094-1-2 a chart:Point ;
    chart:series ex:series-2094-1 ;
    chart:xVal "1995" ;
    chart:yVal "28"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

