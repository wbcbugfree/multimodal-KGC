ex:chart-6768 a chart:Chart ;
    chart:chartType "area" ;
    chart:title "Total population of Haiti from 2008 to 2018" ;
    chart:subtitle ", by gender (in million inhabitants)" ;
    chart:xAxis ex:x-6768 ;
    chart:yAxis ex:y-6768 .

ex:x-6768 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2008" ;
    chart:scaleMax "2018" .

ex:y-6768 a chart:Axis ;
    chart:label "Total" ;
    chart:scaleMin "0" ;
    chart:scaleMax "12" .

ex:series-6768-1 a chart:Series .

ex:point-6768-1-1 a chart:Point ;
    chart:series ex:series-6768-1 ;
    chart:xVal "2008" ;
    chart:yVal "9.7"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-6768-1-2 a chart:Point ;
    chart:series ex:series-6768-1 ;
    chart:xVal "2012" ;
    chart:yVal "10.3"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-6768-1-3 a chart:Point ;
    chart:series ex:series-6768-1 ;
    chart:xVal "2016" ;
    chart:yVal "10.7"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-6768-1-4 a chart:Point ;
    chart:series ex:series-6768-1 ;
    chart:xVal "2018" ;
    chart:yVal "11.0"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .
