@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-872 a chart:Chart ;
    chart:chartType "line" ;
    chart:title "Largest one-day point gains of the Dow Jones Index from 1987 to June 2020" ;
    chart:xAxis ex:x-872 ;
    chart:yAxis ex:y-872 .

ex:x-872 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2008" ;
    chart:scaleMax "2020" .

ex:y-872 a chart:Axis ;
    chart:label "Change in index points within one day" ;
    chart:scaleMin "0" ;
    chart:scaleMax "2200" .

ex:series-872-1 a chart:Series .

ex:point-872-1-1 a chart:Point ;
    chart:series ex:series-872-1 ;
    chart:xVal "2009" ;
    chart:yVal "900"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-872-1-2 a chart:Point ;
    chart:series ex:series-872-1 ;
    chart:xVal "2010" ;
    chart:yVal "850"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

