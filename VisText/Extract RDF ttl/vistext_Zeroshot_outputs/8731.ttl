@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-8731 a chart:Chart ;
    chart:chartType "area" ;
    chart:title "Zambia : Share of economic sectors in the gross domestic product (GDP) from 2009 to 2019" ;
    chart:xAxis ex:x-8731 ;
    chart:yAxis ex:y-8731 .

ex:x-8731 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2009" ;
    chart:scaleMax "2019" .

ex:y-8731 a chart:Axis ;
    chart:label "Services" ;
    chart:scaleMin "0.0" ;
    chart:scaleMax "0.6" .

ex:series-8731-1 a chart:Series .

ex:point-8731-1-1 a chart:Point ;
    chart:series ex:series-8731-1 ;
    chart:xVal "2009" ;
    chart:yVal "0.52"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

