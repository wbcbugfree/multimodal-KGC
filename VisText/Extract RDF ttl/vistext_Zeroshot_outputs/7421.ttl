@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-7421 a chart:Chart ;
    chart:chartType "area" ;
    chart:title "Projected energy consumption worldwide from 1990 to 2040 , by energy source (in million metric tons of oil equivalent)" ;
    chart:xAxis ex:x-7421 ;
    chart:yAxis ex:y-7421 .

ex:x-7421 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "" ;
    chart:scaleMax "" .

ex:y-7421 a chart:Axis ;
    chart:label "Nuclear energy" ;
    chart:scaleMin "0" ;
    chart:scaleMax "800" .

ex:series-7421-1 a chart:Series ;
    chart:seriesName "Nuclear energy" .

ex:point-7421-1-1 a chart:Point ;
    chart:series ex:series-7421-1 ;
    chart:xVal "1990" ;
    chart:yVal "400"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-7421-1-2 a chart:Point ;
    chart:series ex:series-7421-1 ;
    chart:xVal "2000" ;
    chart:yVal "550"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-7421-1-3 a chart:Point ;
    chart:series ex:series-7421-1 ;
    chart:xVal "2010" ;
    chart:yVal "580"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-7421-1-4 a chart:Point ;
    chart:series ex:series-7421-1 ;
    chart:xVal "2020" ;
    chart:yVal "550"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-7421-1-5 a chart:Point ;
    chart:series ex:series-7421-1 ;
    chart:xVal "2030" ;
    chart:yVal "650"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-7421-1-6 a chart:Point ;
    chart:series ex:series-7421-1 ;
    chart:xVal "2040" ;
    chart:yVal "750"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .
