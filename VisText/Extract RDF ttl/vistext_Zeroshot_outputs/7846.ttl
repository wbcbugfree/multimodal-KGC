@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-7846 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Tanzania : Age structure from 2009 to 2019" ;
    chart:subtitle "0-14 years" ;
    chart:xAxis ex:x-7846 ;
    chart:yAxis ex:y-7846 .

ex:x-7846 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2010" ;
    chart:scaleMax "2018" .

ex:y-7846 a chart:Axis ;
    chart:label "" ;
    chart:scaleMin "0.0" ;
    chart:scaleMax "0.4" .

ex:series-7846-1 a chart:Series .

ex:mark-7846-1-1 a chart:Bar ;
    chart:series ex:series-7846-1 ;
    chart:category "2010" ;
    chart:value "0.45"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:mark-7846-1-2 a chart:Bar ;
    chart:series ex:series-7846-1 ;
    chart:category "2012" ;
    chart:value "0.45"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:mark-7846-1-3 a chart:Bar ;
    chart:series ex:series-7846-1 ;
    chart:category "2014" ;
    chart:value "0.45"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:mark-7846-1-4 a chart:Bar ;
    chart:series ex:series-7846-1 ;
    chart:category "2016" ;
    chart:value "0.45"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:mark-7846-1-5 a chart:Bar ;
    chart:series ex:series-7846-1 ;
    chart:category "2018" ;
    chart:value "0.45"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .
