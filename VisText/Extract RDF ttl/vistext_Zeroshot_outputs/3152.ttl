@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-3152 a chart:Chart ;
    chart:chartType "line" ;
    chart:xAxis ex:x-3152 ;
    chart:yAxis ex:y-3152 ;
    chart:title "Number of PwС employees worldwide from 2010 to 2020" .

ex:x-3152 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2010" ;
    chart:scaleMax "2020" .

ex:y-3152 a chart:Axis ;
    chart:label "Number of employees" ;
    chart:scaleMin "0" ;
    chart:scaleMax "300,000" .

ex:series-3152-1 a chart:Series .

ex:point-3152-1-1 a chart:Point ;
    chart:series ex:series-3152-1 ;
    chart:xVal "2010" ;
    chart:yVal "165000"^^xsd:decimal ;
    chart:valueEstimated "false"^^xsd:boolean .

ex:point-3152-1-2 a chart:Point ;
    chart:series ex:series-3152-1 ;
    chart:xVal "2011" ;
    chart:yVal "170000"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-3152-1-3 a chart:Point ;
    chart:series ex:series-3152-1 ;
    chart:xVal "2012" ;
    chart:yVal "180000"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-3152-1-4 a chart:Point ;
    chart:series ex:series-3152-1 ;
    chart:xVal "2013" ;
    chart:yVal "185000"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-3152-1-5 a chart:Point ;
    chart:series ex:series-3152-1 ;
    chart:xVal "2014" ;
    chart:yVal "195000"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-3152-1-6 a chart:Point ;
    chart:series ex:series-3152-1 ;
    chart:xVal "2015" ;
    chart:yVal "190000"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-3152-1-7 a chart:Point ;
    chart:series ex:series-3152-1 ;
    chart:xVal "2016" ;
    chart:yVal "205000"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-3152-1-8 a chart:Point ;
    chart:series ex:series-3152-1 ;
    chart:xVal "2017" ;
    chart:yVal "220000"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-3152-1-9 a chart:Point ;
    chart:series ex:series-3152-1 ;
    chart:xVal "2018" ;
    chart:yVal "250000"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-3152-1-10 a chart:Point ;
    chart:series ex:series-3152-1 ;
    chart:xVal "2019" ;
    chart:yVal "270000"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-3152-1-11 a chart:Point ;
    chart:series ex:series-3152-1 ;
    chart:xVal "2020" ;
    chart:yVal "285000"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .
