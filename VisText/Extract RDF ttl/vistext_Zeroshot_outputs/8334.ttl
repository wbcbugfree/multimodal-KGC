@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-8334 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Anticipated time of booking summer holiday in selected European countries in 2019" ;
    chart:xAxis ex:x-8334 ;
    chart:yAxis ex:y-8334 .

ex:x-8334 a chart:Axis ;
    chart:label "One month or more in advance" ;
    chart:scaleMin "0.0" ;
    chart:scaleMax "0.8" .

ex:y-8334 a chart:Axis ;
    chart:label "Response" ;
    chart:scaleMin "" ;
    chart:scaleMax "" .

ex:series-8334-1 a chart:Series ;
    chart:seriesName "Percentage" .

ex:mark-8334-1-1 a chart:Bar ;
    chart:series ex:series-8334-1 ;
    chart:category "Austria" ;
    chart:value "0.85"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

