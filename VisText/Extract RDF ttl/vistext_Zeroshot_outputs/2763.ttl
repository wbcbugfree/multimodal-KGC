@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-2763 a chart:Chart ;
    chart:chartType "line" ;
    chart:title "Percentage of homicides by firearm in the United States from 2006 to 2019" ;
    chart:xAxis ex:x-2763 ;
    chart:yAxis ex:y-2763 .

ex:x-2763 a chart:Axis ;
    chart:label "Response" ;
    chart:scaleMin "2006" ;
    chart:scaleMax "2018" .

ex:y-2763 a chart:Axis ;
    chart:label "Percentage of homicides" ;
    chart:scaleMin "0.0" ;
    chart:scaleMax "0.8" .

ex:series-2763-1 a chart:Series ;
    chart:seriesName "Percentage of homicides" .

ex:point-2763-1-1 a chart:Point ;
    chart:series ex:series-2763-1 ;
    chart:xVal "2006" ;
    chart:yVal 0.69 ;
    chart:valueEstimated "true"^^xsd:boolean .

