@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-4612 a chart:Chart ;
    chart:chartType "line" ;
    chart:title "Number of Hispanic families with a single mother in the U.S. from 1990 to 2019 (in 1,000s)" ;
    chart:xAxis ex:x-4612 ;
    chart:yAxis ex:y-4612 .

ex:x-4612 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "1990" ;
    chart:scaleMax "2019" .

ex:y-4612 a chart:Axis ;
    chart:label "Families in thousands" ;
    chart:scaleMin "0" ;
    chart:scaleMax "3500" .

ex:series-4612-1 a chart:Series .

ex:point-4612-1-1 a chart:Point ;
    chart:series ex:series-4612-1 ;
    chart:xVal "1990" ;
    chart:yVal "1200"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

