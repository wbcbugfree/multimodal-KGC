@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-4640 a chart:Chart ;
    chart:chartType "line" ;
    chart:title "Syria : Unemployment rate from 1999 to 2020" ;
    chart:xAxis ex:x-4640 ;
    chart:yAxis ex:y-4640 .

ex:x-4640 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2000" ;
    chart:scaleMax "2020" .

ex:y-4640 a chart:Axis ;
    chart:label "Unemployment rate" ;
    chart:scaleMin "0.00" ;
    chart:scaleMax "0.12" .

ex:series-4640-1 a chart:Series .

ex:point-4640-1-1 a chart:Point ;
    chart:series ex:series-4640-1 ;
    chart:xVal "2000" ;
    chart:yVal 0.078 ;
    chart:valueEstimated "false"^^xsd:boolean .

