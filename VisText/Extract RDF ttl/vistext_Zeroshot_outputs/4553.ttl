@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-4553 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Average price of coffee in independent coffee shops in selected European cities in 2016" ;
    chart:xAxis ex:x-4553 ;
    chart:yAxis ex:y-4553 .

ex:x-4553 a chart:Axis ;
    chart:label "Average price in euros" ;
    chart:scaleMin "0" ;
    chart:scaleMax "5" .

ex:y-4553 a chart:Axis ;
    chart:label "city" ;
    chart:scaleMin "" ;
    chart:scaleMax "" .

ex:series-4553-1 a chart:Series .

