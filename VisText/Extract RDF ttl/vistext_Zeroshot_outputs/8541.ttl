@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-8541 a chart:Chart ;
    chart:chartType "line" ;
    chart:xAxis ex:x-8541 ;
    chart:yAxis ex:y-8541 ;
    chart:title "Global box office revenue from 2004 to 2019 , by region (in billion U.S. dollars)" .

ex:x-8541 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2004" ;
    chart:scaleMax "2016" .

ex:y-8541 a chart:Axis ;
    chart:label "Asia Pacific" ;
    chart:scaleMin "0" ;
    chart:scaleMax "15" .

ex:series-8541-1 a chart:Series ;
    chart:seriesName "Asia Pacific" .

ex:point-8541-1-1 a chart:Point ;
    chart:series ex:series-8541-1 ;
    chart:xVal "2004" ;
    chart:yVal 8.5 ;
    chart:valueEstimated "false"^^xsd:boolean .

ex:point-8541-1-2 a chart:Point ;
    chart:series ex:series-8541-1 ;
    chart:xVal "2005" ;
    chart:yVal 7.0 ;
    chart:valueEstimated "true"^^xsd:boolean .

