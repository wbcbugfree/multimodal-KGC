ex:chart-8515 a chart:Chart ;
    chart:chartType "area" ;
    chart:title "Greenhouse gas emissions volume in the European Union from 1990 to 2017 , by sector (in kilotonnes of CO2-equivalent)" ;
    chart:xAxis ex:x-8515 ;
    chart:yAxis ex:y-8515 .

ex:x-8515 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "1990" ;
    chart:scaleMax "2015" .

ex:y-8515 a chart:Axis ;
    chart:label "Waste" ;
    chart:scaleMin "0" ;
    chart:scaleMax "250,000" .

ex:series-8515-1 a chart:Series .

ex:point-8515-1-1 a chart:Point ;
    chart:series ex:series-8515-1 ;
    chart:xVal "1990" ;
    chart:yVal "240000"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-8515-1-2 a chart:Point ;
    chart:series ex:series-8515-1 ;
    chart:xVal "1995" ;
    chart:yVal "248000"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-8515-1-3 a chart:Point ;
    chart:series ex:series-8515-1 ;
    chart:xVal "2000" ;
    chart:yVal "240000"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-8515-1-4 a chart:Point ;
    chart:series ex:series-8515-1 ;
    chart:xVal "2005" ;
    chart:yVal "215000"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-8515-1-5 a chart:Point ;
    chart:series ex:series-8515-1 ;
    chart:xVal "2010" ;
    chart:yVal "175000"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-8515-1-6 a chart:Point ;
    chart:series ex:series-8515-1 ;
    chart:xVal "2015" ;
    chart:yVal "145000"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .
