ex:chart-862 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Number of hours of sunshine in France in 2018 , by city" ;
    chart:xAxis ex:x-862 ;
    chart:yAxis ex:y-862 .

ex:x-862 a chart:Axis ;
    chart:label "city in france" ;
    chart:scaleMin "" ;
    chart:scaleMax "" .

ex:y-862 a chart:Axis ;
    chart:label "Hours of sunshine" ;
    chart:scaleMin "0" ;
    chart:scaleMax "2500" .

ex:series-862-1 a chart:Series .

