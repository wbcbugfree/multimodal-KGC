@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-4127 a chart:Chart ;
    chart:chartType "area" ;
    chart:title "Revenue of Sonic Corporation in the United States from 2009 to 2018 (in million U.S. dollars)" ;
    chart:xAxis ex:x-4127 ;
    chart:yAxis ex:y-4127 .

ex:x-4127 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2009" ;
    chart:scaleMax "2018" .

ex:y-4127 a chart:Axis ;
    chart:label "Revenue in million U.S. dollars" ;
    chart:scaleMin "0" ;
    chart:scaleMax "800" .

ex:series-4127-1 a chart:Series .

ex:point-4127-1-1 a chart:Point ;
    chart:series ex:series-4127-1 ;
    chart:xVal "2009" ;
    chart:yVal "680"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-4127-1-2 a chart:Point ;
    chart:series ex:series-4127-1 ;
    chart:xVal "2010" ;
    chart:yVal "560"^^xsd:decimal ;
