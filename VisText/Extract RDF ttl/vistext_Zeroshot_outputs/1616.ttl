ex:chart-1616 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Average number of persons employed at Vodafone in Germany from financial year 2007/08 to 2019/20 (in 1,000)" ;
    chart:xAxis ex:x-1616 ;
    chart:yAxis ex:y-1616 .

ex:x-1616 a chart:Axis ;
    chart:label "Employees in thousands" ;
    chart:scaleMin "0" ;
    chart:scaleMax "15" .

ex:y-1616 a chart:Axis ;
    chart:label "Business years" ;
    chart:scaleMin "2019/20" ;
    chart:scaleMax "2007/08" .

