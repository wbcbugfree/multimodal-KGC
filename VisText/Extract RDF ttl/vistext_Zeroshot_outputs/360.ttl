ex:chart-360 a chart:Chart ;
    chart:chartType "line" ;
    chart:title "Number of road traffic fatalities in Slovenia\nfrom 2006 to 2019" ;
    chart:xAxis ex:x-360 ;
    chart:yAxis ex:y-360 .

ex:x-360 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2006" ;
    chart:scaleMax "2018" .

ex:y-360 a chart:Axis ;
    chart:label "Number of fatalities" ;
    chart:scaleMin "0" ;
    chart:scaleMax "300" .

ex:series-360-1 a chart:Series .

ex:point-360-1-1 a chart:Point ;
    chart:series ex:series-360-1 ;
    chart:xVal "2006" ;
    chart:yVal "260"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-360-1-2 a chart:Point ;
    chart:series ex:series-360-1 ;
    chart:xVal "2008" ;
    chart:yVal "300"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-360-1-3 a chart:Point ;
    chart:series ex:series-360-1 ;
    chart:xVal "2010" ;
    chart:yVal "140"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-360-1-4 a chart:Point ;
    chart:series ex:series-360-1 ;
    chart:xVal "2012" ;
    chart:yVal "135"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-360-1-5 a chart:Point ;
    chart:series ex:series-360-1 ;
    chart:xVal "2014" ;
    chart:yVal "115"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-360-1-6 a chart:Point ;
    chart:series ex:series-360-1 ;
    chart:xVal "2016" ;
    chart:yVal "135"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-360-1-7 a chart:Point ;
    chart:series ex:series-360-1 ;
    chart:xVal "2018" ;
    chart:yVal "100"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-360-1-8 a chart:Point ;
    chart:series ex:series-360-1 ;
    chart:xVal "2019" ;
    chart:yVal "110"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .
