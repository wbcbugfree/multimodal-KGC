@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-4744 a chart:Chart ;
    chart:chartType "line" ;
    chart:title "Cumulative number of positive cases of COVID-19 in New York State from March 4 , 2020 to January 5 , 2021 , by day" ;
    chart:xAxis ex:x-4744 ;
    chart:yAxis ex:y-4744 .

ex:x-4744 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "April" ;
    chart:scaleMax "2021" .

ex:y-4744 a chart:Axis ;
    chart:label "Cumulative number of positive cases" ;
    chart:scaleMin "0" ;
    chart:scaleMax "1,000,000" .

ex:series-4744-1 a chart:Series .

ex:point-4744-1-1 a chart:Point ;
    chart:series ex:series-4744-1 ;
    chart:xVal "April" ;
    chart:yVal "0"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-4744-1-2 a chart:Point ;
    chart:series ex:series-4744-1 ;
    chart:xVal "April" ;
    chart:yVal "100000"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-4744-1-3 a chart:Point ;
    chart:series ex:series-4744-1 ;
    chart:xVal "July" ;
    chart:yVal "450000"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-4744-1-4 a chart:Point ;
    chart:series ex:series-4744-1 ;
    chart:xVal "October" ;
    chart:yVal "500000"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-4744-1-5 a chart:Point ;
    chart:series ex:series-4744-1 ;
    chart:xVal "2021" ;
    chart:yVal "1000000"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .
