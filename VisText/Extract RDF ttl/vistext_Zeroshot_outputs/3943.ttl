ex:chart-3943 a chart:Chart ;
    chart:chartType "line" ;
    chart:xAxis ex:x-3943 ;
    chart:yAxis ex:y-3943 .

ex:x-3943 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2008" ;
    chart:scaleMax "2016" .

ex:y-3943 a chart:Axis ;
    chart:label "Number of born children per woman" ;
    chart:scaleMin "0" ;
    chart:scaleMax "2" .

ex:series-3943-1 a chart:Series ;
    chart:seriesName "Total Fertility Rate" .

ex:point-3943-1-1 a chart:Point ;
    chart:series ex:series-3943-1 ;
    chart:xVal "2008" ;
    chart:yVal "2.05"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-3943-1-2 a chart:Point ;
    chart:series ex:series-3943-1 ;
    chart:xVal "2010" ;
    chart:yVal "2.03"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-3943-1-3 a chart:Point ;
    chart:series ex:series-3943-1 ;
    chart:xVal "2012" ;
    chart:yVal "2.02"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-3943-1-4 a chart:Point ;
    chart:series ex:series-3943-1 ;
    chart:xVal "2014" ;
    chart:yVal "2.01"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-3943-1-5 a chart:Point ;
