    chart:label "merger and acquisition advisor" ;
    chart:scaleMin "" ;
    chart:scaleMax "" .

ex:y-4626 a chart:Axis ;
    chart:label "Value in billion U.S. dollars" ;
    chart:scaleMin "0" ;
    chart:scaleMax "150" .

ex:series-4626-1 a chart:Series .

