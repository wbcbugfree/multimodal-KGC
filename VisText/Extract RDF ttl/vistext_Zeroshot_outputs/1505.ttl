@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-1505 a chart:Chart ;
    chart:chartType "area" ;
    chart:title "Total number of wage and salary workers" ;
    chart:subtitle "in the United States from 1979 to 2019 (in millions)" ;
    chart:xAxis ex:x-1505 ;
    chart:yAxis ex:y-1505 .

ex:x-1505 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "1979" ;
    chart:scaleMax "2019" .

ex:y-1505 a chart:Axis ;
    chart:label "Number of workers in millions" ;
    chart:scaleMin "0" ;
    chart:scaleMax "150" .

ex:series-1505-1 a chart:Series .

ex:point-1505-1-1 a chart:Point ;
    chart:series ex:series-1505-1 ;
    chart:xVal "1979" ;
    chart:yVal "87.0"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-1505-1-2 a chart:Point ;
    chart:series ex:series-1505-1 ;
    chart:xVal "1980" ;
    chart:yVal "88.0"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-1505-1-3 a chart:Point ;
    chart:series ex:series-1505-1 ;
    chart:xVal "1985" ;
    chart:yVal "95.0"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-1505-1-4 a chart:Point ;
    chart:series ex:series-1505-1 ;
    chart:xVal "1990" ;
    chart:yVal "102.0"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-1505-1-5 a chart:Point ;
    chart:series ex:series-1505-1 ;
    chart:xVal "1995" ;
    chart:yVal "110.0"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-1505-1-6 a chart:Point ;
    chart:series ex:series-1505-1 ;
    chart:xVal "2000" ;
    chart:yVal "122.0"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-1505-1-7 a chart:Point ;
    chart:series ex:series-1505-1 ;
    chart:xVal "2005" ;
    chart:yVal "127.0"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-1505-1-8 a chart:Point ;
    chart:series ex:series-1505-1 ;
    chart:xVal "2010" ;
    chart:yVal "135.0"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-1505-1-9 a chart:Point ;
    chart:series ex:series-1505-1 ;
    chart:xVal "2015" ;
    chart:yVal "142.0"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-1505-1-10 a chart:Point ;
    chart:series ex:series-1505-1 ;
    chart:xVal "2019" ;
    chart:yVal "148.0"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .
