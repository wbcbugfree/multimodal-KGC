@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-2607 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Share of consumers who pay for news publications in the United States as of March 2017 , by type" ;
    chart:xAxis ex:x-2607 ;
    chart:yAxis ex:y-2607 .

ex:x-2607 a chart:Axis ;
    chart:label "Response" ;
    chart:scaleMin "" ;
    chart:scaleMax "" .

ex:y-2607 a chart:Axis ;
    chart:label "Share of respondents" ;
    chart:scaleMin "0.00" ;
    chart:scaleMax "0.35" .

ex:series-2607-1 a chart:Series .

ex:mark-2607-1-1 a chart:Bar ;
    chart:series   ex:series-2607-1 ;
    chart:category "Both a print and a digital version ..." ;
    chart:value    "0.09"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

