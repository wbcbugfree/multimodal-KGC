@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-7341 a chart:Chart ;
    chart:chartType "line" ;
    chart:title "Number of single-person households in the Netherlands from 2009 to 2019 , by gender" ;
    chart:subtitle "Men" ;
    chart:xAxis ex:x-7341 ;
    chart:yAxis ex:y-7341 .

ex:x-7341 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2010" ;
    chart:scaleMax "2018" .

ex:y-7341 a chart:Axis ;
    chart:label "" ;
    chart:scaleMin "0" ;
    chart:scaleMax "1500000" .

ex:series-7341-1 a chart:Series ;
    chart:seriesName "Men" .

ex:point-7341-1-1 a chart:Point ;
    chart:series ex:series-7341-1 ;
    chart:xVal "2010" ;
    chart:yVal "1250000"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-7341-1-2 a chart:Point ;
    chart:series ex:series-7341-1 ;
    chart:xVal "2012" ;
    chart:yVal "1300000"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-7341-1-3 a chart:Point ;
    chart:series ex:series-7341-1 ;
    chart:xVal "2014" ;
    chart:yVal "1350000"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-7341-1-4 a chart:Point ;
    chart:series ex:series-7341-1 ;
    chart:xVal "2016" ;
    chart:yVal "1400000"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-7341-1-5 a chart:Point ;
    chart:series ex:series-7341-1 ;
    chart:xVal "2018" ;
    chart:yVal "1450000"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .
