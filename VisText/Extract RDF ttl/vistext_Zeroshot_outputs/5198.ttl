@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-5198 a chart:Chart ;
    chart:chartType "line" ;
    chart:title "Per capita consumption of oat products in the United States from 2000 to 2018 (in pounds)" ;
    chart:xAxis ex:x-5198 ;
    chart:yAxis ex:y-5198 .

ex:x-5198 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2000" ;
    chart:scaleMax "2018" .

ex:y-5198 a chart:Axis ;
    chart:label "Per capita consumption in pounds" ;
    chart:scaleMin "0" ;
    chart:scaleMax "5" .

ex:series-5198-1 a chart:Series .

ex:point-5198-1-1 a chart:Point ;
    chart:series ex:series-5198-1 ;
    chart:xVal "2000" ;
    chart:yVal "4.5"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

