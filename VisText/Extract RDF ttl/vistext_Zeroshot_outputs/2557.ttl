@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-2557 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Average undergraduate tuition fees for international students in Canada from 2006 to 2020 (in Canadian dollars)" ;
    chart:xAxis ex:x-2557 ;
    chart:yAxis ex:y-2557 .

ex:x-2557 a chart:Axis ;
    chart:label "Tuition in Canadian dollars" ;
    chart:scaleMin "0" ;
    chart:scaleMax "35000" .

ex:y-2557 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2006 / 2007" ;
    chart:scaleMax "2020 / 2021*" .

ex:series-2557-1 a chart:Series .

ex:mark-2557-1-1 a chart:Bar ;
    chart:series ex:series-2557-1 ;
    chart:category "2006 / 2007" ;
    chart:value "15000"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

