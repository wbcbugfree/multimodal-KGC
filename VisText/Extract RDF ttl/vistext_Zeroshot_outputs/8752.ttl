@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-8752 a chart:Chart ;
    chart:chartType "area" ;
    chart:title "Number of Papa John 's restaurants in the United States from 2007 to 2019 , by mode of operation" ;
    chart:xAxis ex:x-8752 ;
    chart:yAxis ex:y-8752 .

ex:x-8752 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2008" ;
    chart:scaleMax "2018" .

ex:y-8752 a chart:Axis ;
    chart:label "Company-owned" ;
    chart:scaleMin "0" ;
    chart:scaleMax "800" .

ex:series-8752-1 a chart:Series .

ex:point-8752-1-1 a chart:Point ;
    chart:series ex:series-8752-1 ;
    chart:xVal "2008" ;
    chart:yVal "600"^^xsd:decimal ;
    chart:valueEstimated "false"^^xsd:boolean .

ex:point-8752-1-2 a chart:Point ;
    chart:series ex:series-8752-1 ;
    chart:xVal "2009" ;
    chart:yVal "580"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

