ex:chart-757 a chart:Chart ;
    chart:chartType "line" ;
    chart:title "Toronto Blue Jays average ticket price from 2006 to 2019 (in U.S. dollars)" ;
    chart:subtitle "Average ticket price in U.S. dollars" ;
    chart:xAxis ex:x-757 ;
    chart:yAxis ex:y-757 .

ex:x-757 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2006" ;
    chart:scaleMax "2018" .

ex:y-757 a chart:Axis ;
    chart:label "" ;
    chart:scaleMin "0" ;
    chart:scaleMax "35" .

ex:series-757-1 a chart:Series .

ex:point-757-1-1 a chart:Point ;
    chart:series ex:series-757-1 ;
    chart:xVal "2006" ;
    chart:yVal "23"^^xsd:decimal ;
    chart:valueEstimated "false"^^xsd:boolean .

