@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-4000 a chart:Chart ;
    chart:chartType "area" ;
    chart:xAxis ex:x-4000 ;
    chart:yAxis ex:y-4000 ;
    chart:title "Participation rate in sports activities in Flanders (Belgium) from 2008 to 2018" .

ex:x-4000 a chart:Axis ;
    chart:label "Response" ;
    chart:scaleMin "2008" ;
    chart:scaleMax "2018" .

ex:y-4000 a chart:Axis ;
    chart:label "Share of the Flemish citizens" ;
    chart:scaleMin "0.0" ;
    chart:scaleMax "0.7" .

ex:series-4000-1 a chart:Series .

ex:point-4000-1-1 a chart:Point ;
    chart:series ex:series-4000-1 ;
    chart:xVal "2008" ;
    chart:yVal 0.55 ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-4000-1-2 a chart:Point ;
    chart:series ex:series-4000-1 ;
    chart:xVal "2009" ;
    chart:yVal 0.52 ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-4000-1-3 a chart:Point ;
    chart:series ex:series-4000-1 ;
    chart:xVal "2010" ;
    chart:yVal 0.51 ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-4000-1-4 a chart:Point ;
    chart:series ex:series-4000-1 ;
    chart:xVal "2011" ;
    chart:yVal 0.50 ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-4000-1-5 a chart:Point ;
    chart:series ex:series-4000-1 ;
    chart:xVal "2012" ;
    chart:yVal 0.56 ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-4000-1-6 a chart:Point ;
    chart:series ex:series-4000-1 ;
    chart:xVal "2013" ;
    chart:yVal 0.57 ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-4000-1-7 a chart:Point ;
    chart:series ex:series-4000-1 ;
    chart:xVal "2014" ;
    chart:yVal 0.60 ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-4000-1-8 a chart:Point ;
    chart:series ex:series-4000-1 ;
    chart:xVal "2015" ;
    chart:yVal 0.63 ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-4000-1-9 a chart:Point ;
    chart:series ex:series-4000-1 ;
    chart:xVal "2016" ;
    chart:yVal 0.66 ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-4000-1-10 a chart:Point ;
    chart:series ex:series-4000-1 ;
    chart:xVal "2017" ;
    chart:yVal 0.68 ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-4000-1-11 a chart:Point ;
    chart:series ex:series-4000-1 ;
    chart:xVal "2018" ;
    chart:yVal 0.67 ;
    chart:valueEstimated "true"^^xsd:boolean .
