@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-5202 a chart:Chart ;
    chart:chartType "line" ;
    chart:title "India : Youth unemployment rate from 1999 to 2020" ;
    chart:xAxis ex:x-5202 ;
    chart:yAxis ex:y-5202 .

ex:x-5202 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2000" ;
    chart:scaleMax "2020" .

ex:y-5202 a chart:Axis ;
    chart:label "Youth unemployment rate" ;
    chart:scaleMin "0.00" ;
    chart:scaleMax "0.25" .

ex:series-5202-1 a chart:Series .

ex:point-5202-1-1 a chart:Point ;
    chart:series ex:series-5202-1 ;
    chart:xVal "2000" ;
    chart:yVal 0.175 ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-5202-1-2 a chart:Point ;
    chart:series ex:series-5202-1 ;
    chart:xVal "2002" ;
    chart:yVal 0.178 ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-5202-1-3 a chart:Point ;
    chart:series ex:series-5202-1 ;
    chart:xVal "2004" ;
    chart:yVal 0.179 ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-5202-1-4 a chart:Point ;
    chart:series ex:series-5202-1 ;
    chart:xVal "2006" ;
    chart:yVal 0.180 ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-5202-1-5 a chart:Point ;
    chart:series ex:series-5202-1 ;
    chart:xVal "2008" ;
    chart:yVal 0.185 ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-5202-1-6 a chart:Point ;
    chart:series ex:series-5202-1 ;
    chart:xVal "2010" ;
    chart:yVal 0.190 ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-5202-1-7 a chart:Point ;
    chart:series ex:series-5202-1 ;
    chart:xVal "2012" ;
    chart:yVal 0.198 ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-5202-1-8 a chart:Point ;
    chart:series ex:series-5202-1 ;
    chart:xVal "2014" ;
    chart:yVal 0.205 ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-5202-1-9 a chart:Point ;
    chart:series ex:series-5202-1 ;
    chart:xVal "2016" ;
    chart:yVal 0.210 ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-5202-1-10 a chart:Point ;
    chart:series ex:series-5202-1 ;
    chart:xVal "2018" ;
    chart:yVal 0.215 ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-5202-1-11 a chart:Point ;
