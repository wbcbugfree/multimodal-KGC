@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-7045 a chart:Chart ;
    chart:chartType "area" ;
    chart:title "Unemployment rate of high school graduates and dropouts not enrolled in school in the United States from 2000 to 2019" ;
    chart:xAxis ex:x-7045 ;
    chart:yAxis ex:y-7045 .

ex:x-7045 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2000" ;
    chart:scaleMax "2019" .

ex:y-7045 a chart:Axis ;
    chart:label "Graduates" ;
    chart:scaleMin "0.00" ;
    chart:scaleMax "0.30" .

ex:series-7045-1 a chart:Series .

ex:point-7045-1-1 a chart:Point ;
    chart:series ex:series-7045-1 ;
    chart:xVal "2000" ;
    chart:yVal "0.10"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

