@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-8544 a chart:Chart ;
    chart:chartType "bar" ;
    chart:xAxis ex:x-8544 ;
    chart:yAxis ex:y-8544 ;
    chart:title "Total rate of COVID-19 deaths compared to deaths among long-term care residents in select countries worldwide as of May 2020 (per million population)" .

ex:x-8544 a chart:Axis ;
    chart:label "Number of LTC deaths per million population" ;
    chart:scaleMin "0" ;
    chart:scaleMax "400" .

ex:y-8544 a chart:Axis ;
    chart:label "Country" ;
    chart:scaleMin "" ;
    chart:scaleMax "" .

ex:series-8544-1 a chart:Series .

ex:mark-8544-1-1 a chart:Bar ;
