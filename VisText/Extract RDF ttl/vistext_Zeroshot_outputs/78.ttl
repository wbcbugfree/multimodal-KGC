ex:chart-78 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Value of Indian trade with ASEAN countries in FY 2019 , by country (in million U.S. dollars)" ;
    chart:xAxis ex:x-78 ;
    chart:yAxis ex:y-78 .

ex:x-78 a chart:Axis ;
    chart:label "Country" ;
    chart:scaleMin "" ;
    chart:scaleMax "" .

ex:y-78 a chart:Axis ;
    chart:label "Trade value in million U.S. dollars" ;
    chart:scaleMin "0" ;
    chart:scaleMax "25000" .

ex:series-78-1 a chart:Series .

ex:mark-78-1-1 a chart:Bar ;
    chart:series ex:series-78-1 ;
    chart:category "Brunei" ;
    chart:value "1500"^^xsd:decimal ;
