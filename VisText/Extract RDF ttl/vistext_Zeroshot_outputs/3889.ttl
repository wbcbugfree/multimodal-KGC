@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-3889 a chart:Chart ;
    chart:chartType "line" ;
    chart:title "Average price of home heating oil in the Canadian city of Yellowknife from 1990 to 2011 (in Canadian cents per litre)" ;
    chart:xAxis ex:x-3889 ;
    chart:yAxis ex:y-3889 .

ex:x-3889 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "1990" ;
    chart:scaleMax "2010" .

ex:y-3889 a chart:Axis ;
    chart:label "Price in Canadian cents per litre" ;
    chart:scaleMin "0" ;
    chart:scaleMax "120" .

ex:series-3889-1 a chart:Series .

ex:point-3889-1-1 a chart:Point ;
    chart:series ex:series-3889-1 ;
    chart:xVal "1990" ;
    chart:yVal "38"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-3889-1-2 a chart:Point ;
    chart:series ex:series-3889-1 ;
    chart:xVal "1995" ;
    chart:yVal "39"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-3889-1-3 a chart:Point ;
    chart:series ex:series-3889-1 ;
    chart:xVal "2000" ;
    chart:yVal "52"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-3889-1-4 a chart:Point ;
    chart:series ex:series-3889-1 ;
    chart:xVal "2005" ;
    chart:yVal "60"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-3889-1-5 a chart:Point ;
    chart:series ex:series-3889-1 ;
    chart:xVal "2010" ;
    chart:yVal "90"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-3889-1-6 a chart:Point ;
    chart:series ex:series-3889-1 ;
    chart:xVal "2011" ;
    chart:yVal "120"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .
