@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-1566 a chart:Chart ;
    chart:chartType "line" ;
    chart:title "Total net written premiums of the general business insurance market in the United Kingdom (UK) from 2007 to 2018 (in million GBP)" ;
    chart:xAxis ex:x-1566 ;
    chart:yAxis ex:y-1566 .

ex:x-1566 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2007" ;
    chart:scaleMax "2018" .

ex:y-1566 a chart:Axis ;
    chart:label "Amount in million GBP" ;
    chart:scaleMin "0" ;
    chart:scaleMax "40000" .

ex:series-1566-1 a chart:Series .

ex:point-1566-1-1 a chart:Point ;
    chart:series ex:series-1566-1 ;
    chart:xVal "2007" ;
    chart:yVal "34000"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-1566-1-2 a chart:Point ;
    chart:series ex:series-1566-1 ;
    chart:xVal "2008" ;
    chart:yVal "35500"^^xsd:decimal ;
