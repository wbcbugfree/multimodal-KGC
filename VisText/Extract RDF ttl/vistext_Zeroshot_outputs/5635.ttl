@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-5635 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Monthly number of unemployed persons in the U.S. from November 2019 to November 2020" ;
    chart:subtitle "(in millions , adjusted)" ;
    chart:xAxis ex:x-5635 ;
    chart:yAxis ex:y-5635 .

ex:x-5635 a chart:Axis ;
    chart:label "Month" ;
    chart:scaleMin "" ;
    chart:scaleMax "" .

ex:y-5635 a chart:Axis ;
    chart:label "Number in millions" ;
    chart:scaleMin "0" ;
    chart:scaleMax "20" .

ex:series-5635-1 a chart:Series .

ex:mark-5635-1-1 a chart:Bar ;
    chart:series ex:series-5635-1 ;
    chart:category "Apr '20" ;
    chart:value "21.5"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

