    chart:title "Forecast volume of rice imported to the European Union (EU 27) from 2015 to 2029" ;
    chart:subtitle "(in 1,000 tonnes)" ;
    chart:xAxis ex:x-1198 ;
    chart:yAxis ex:y-1198 .

ex:x-1198 a chart:Axis ;
