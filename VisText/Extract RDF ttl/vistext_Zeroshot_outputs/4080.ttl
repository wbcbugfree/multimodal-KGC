@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-4080 a chart:Chart ;
    chart:chartType "line" ;
    chart:xAxis ex:x-4080 ;
    chart:yAxis ex:y-4080 ;
    chart:title "Aggregated gross revenues of PwC 2006 to 2020 (in billion U.S. dollars)" .

ex:x-4080 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2006" ;
    chart:scaleMax "2018" .

ex:y-4080 a chart:Axis ;
    chart:label "Revenue in billion U.S. dollars" ;
    chart:scaleMin "0" ;
    chart:scaleMax "40" .

ex:series-4080-1 a chart:Series .

ex:point-4080-1-1 a chart:Point ;
    chart:series ex:series-4080-1 ;
    chart:xVal "2006" ;
    chart:yVal "23"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-4080-1-2 a chart:Point ;
    chart:series ex:series-4080-1 ;
    chart:xVal "2007" ;
    chart:yVal "25"^^xsd:decimal ;
