@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-8404 a chart:Chart ;
    chart:chartType "line" ;
    chart:xAxis ex:x-8404 ;
    chart:yAxis ex:y-8404 .

ex:x-8404 a chart:Axis ;
    chart:label "Month" ;
    chart:scaleMin "July" ;
    chart:scaleMax "April" .

ex:y-8404 a chart:Axis ;
    chart:label "All India" ;
    chart:scaleMin "0" ;
    chart:scaleMax "150" .

ex:series-8404-1 a chart:Series .

ex:point-8404-1-1 a chart:Point ;
    chart:series ex:series-8404-1 ;
    chart:xVal "July" ;
    chart:yVal "140"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-8404-1-2 a chart:Point ;
    chart:series ex:series-8404-1 ;
    chart:xVal "October" ;
    chart:yVal "145"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-8404-1-3 a chart:Point ;
    chart:series ex:series-8404-1 ;
    chart:xVal "2020" ;
    chart:yVal "148"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-8404-1-4 a chart:Point ;
    chart:series ex:series-8404-1 ;
    chart:xVal "April" ;
    chart:yVal "150"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .
