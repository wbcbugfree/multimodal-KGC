ex:chart-456 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Forecast volume of wheat consumed in the European Union (EU 27) from 2016 to 2029" ;
    chart:subtitle "(in 1,000 tonnes)" ;
    chart:xAxis ex:x-456 ;
    chart:yAxis ex:y-456 .

ex:x-456 a chart:Axis ;
    chart:label "Volume in thousand tonnes" ;
    chart:scaleMin "0" ;
    chart:scaleMax "120000" .

ex:y-456 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2016" ;
    chart:scaleMax "2029*" .

ex:series-456-1 a chart:Series .

ex:mark-456-1-1 a chart:Bar ;
    chart:series ex:series-456-1 ;
    chart:category "2016" ;
    chart:value "110000"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

