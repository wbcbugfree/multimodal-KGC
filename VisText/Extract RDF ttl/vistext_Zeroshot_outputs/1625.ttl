@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-1625 a chart:Chart ;
    chart:chartType "line" ;
    chart:xAxis ex:x-1625 ;
    chart:yAxis ex:y-1625 ;
    chart:title "Green Bay Packers player expenses (payroll)" ;
    chart:subtitle "from 2001 to 2019 (in million U.S. dollars)" .

ex:x-1625 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2001" ;
    chart:scaleMax "2019" .

ex:y-1625 a chart:Axis ;
    chart:label "Player expenses in million U.S. dollars" ;
    chart:scaleMin "0" ;
    chart:scaleMax "250" .

ex:series-1625-1 a chart:Series .

ex:point-1625-1-1 a chart:Point ;
    chart:series ex:series-1625-1 ;
    chart:xVal "2001" ;
    chart:yVal "85"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

