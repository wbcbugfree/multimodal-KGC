ex:chart-74 a chart:Chart ;
    chart:chartType "line" ;
    chart:xAxis ex:x-74 ;
    chart:yAxis ex:y-74 ;
    chart:title "The adidas Group 's financial leverage worldwide" ;
    chart:subtitle "from 2000 to 2018" .

ex:x-74 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2000" ;
    chart:scaleMax "2018" .

ex:y-74 a chart:Axis ;
    chart:label "Financial leverage" ;
    chart:scaleMin "0.0" ;
    chart:scaleMax "2.0" .

ex:series-74-1 a chart:Series ;
    chart:seriesName "Financial leverage" .

ex:point-74-1-1 a chart:Point ;
    chart:series ex:series-74-1 ;
    chart:xVal "2000" ;
    chart:yVal "2.0"^^xsd:decimal ;
    chart:valueEstimated "false"^^xsd:boolean .

