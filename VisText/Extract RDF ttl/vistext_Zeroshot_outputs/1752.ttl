@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-1752 a chart:Chart ;
    chart:chartType "bar" ;
    chart:xAxis ex:x-1752 ;
    chart:yAxis ex:y-1752 ;
    chart:title "Share of traditional quantitative methods used in the market research industry worldwide in Q3 and Q4 2018" .

ex:x-1752 a chart:Axis ;
    chart:label "Share of respondents" ;
    chart:scaleMin "0.0" ;
    chart:scaleMax "0.8" .

ex:y-1752 a chart:Axis ;
    chart:label "Response" ;
    chart:scaleMin "" ;
    chart:scaleMax "" .

ex:series-1752-1 a chart:Series .

ex:mark-1752-1-1 a chart:Bar ;
    chart:series ex:series-1752-1 ;
    chart:category "Other quantitative techniques" ;
    chart:value "0.02"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

