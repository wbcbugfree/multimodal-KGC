@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-4184 a chart:Chart ;
    chart:chartType "line" ;
    chart:title "Number of employees at Total S.A. from 2008" ;
    chart:subtitle "to 2019" ;
    chart:xAxis ex:x-4184 ;
    chart:yAxis ex:y-4184 .

ex:x-4184 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2008" ;
    chart:scaleMax "2018" .

ex:y-4184 a chart:Axis ;
    chart:label "Number of employees" ;
    chart:scaleMin "0" ;
    chart:scaleMax "100000" .

ex:series-4184-1 a chart:Series ;
    chart:seriesName "Number of employees" .

ex:point-4184-1-1 a chart:Point ;
    chart:series ex:series-4184-1 ;
    chart:xVal "2008" ;
    chart:yVal "90000"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-4184-1-2 a chart:Point ;
    chart:series ex:series-4184-1 ;
    chart:xVal "2009" ;
    chart:yVal "87000"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

