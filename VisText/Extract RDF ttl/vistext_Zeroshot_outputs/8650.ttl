ex:chart-8650 a chart:Chart ;
    chart:chartType "area" ;
    chart:title "Internet penetration rate in the Middle@East compared to the global internet penetration@rate from 2009 to 2019" ;
    chart:xAxis ex:x-8650 ;
    chart:yAxis ex:y-8650 .

ex:x-8650 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2009" ;
    chart:scaleMax "2019" .

ex:y-8650 a chart:Axis ;
    chart:label "Rest of the World" ;
    chart:scaleMin "0.0" ;
    chart:scaleMax "0.6" .

ex:series-8650-1 a chart:Series ;
    chart:seriesName "Rest of the World" .

ex:point-8650-1-1 a chart:Point ;
    chart:series ex:series-8650-1 ;
    chart:xVal "2009" ;
    chart:yVal 0.25 ;
    chart:valueEstimated "true"^^xsd:boolean .

