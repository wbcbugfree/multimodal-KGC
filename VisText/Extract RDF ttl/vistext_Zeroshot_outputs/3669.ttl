    chart:valueEstimated "true"^^xsd:boolean .

ex:point-3669-1-7 a chart:Point ;
    chart:series ex:series-3669-1 ;
    chart:xVal "2014" ;
    chart:yVal "1.95"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-3669-1-8 a chart:Point ;
