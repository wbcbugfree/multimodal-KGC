@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-3669 a chart:Chart ;
    chart:chartType "line" ;
    chart:xAxis ex:x-3669 ;
    chart:yAxis ex:y-3669 ;
    chart:title "Azerbaijan : Fertility rate from 2008 to 2018" .

ex:x-3669 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2008" ;
    chart:scaleMax "2016" .

ex:y-3669 a chart:Axis ;
    chart:label "Number of children born per woman" ;
    chart:scaleMin "0.0" ;
    chart:scaleMax "2.0" .

ex:series-3669-1 a chart:Series ;
    chart:seriesName "Fertility rate" .

ex:point-3669-1-1 a chart:Point ;
    chart:series ex:series-3669-1 ;
    chart:xVal "2008" ;
    chart:yVal "1.85"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-3669-1-2 a chart:Point ;
    chart:series ex:series-3669-1 ;
    chart:xVal "2009" ;
    chart:yVal "1.75"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

