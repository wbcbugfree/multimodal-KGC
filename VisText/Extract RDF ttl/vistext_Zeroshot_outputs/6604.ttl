@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-6604 a chart:Chart ;
    chart:chartType "area" ;
    chart:title "Direct and total contribution of travel and tourism to GDP from 2006 to 2019 (in billion U.S. dollars)" ;
    chart:xAxis ex:x-6604 ;
    chart:yAxis ex:y-6604 .

ex:x-6604 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2006" ;
    chart:scaleMax "2018" .

ex:y-6604 a chart:Axis ;
    chart:label "" ;
    chart:scaleMin "0" ;
    chart:scaleMax "10000" .

ex:series-6604-1 a chart:Series ;
    chart:seriesName "Total contribution" .

ex:point-6604-1-1 a chart:Point ;
    chart:series ex:series-6604-1 ;
    chart:xVal "2006" ;
    chart:yVal "5000"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-6604-1-2 a chart:Point ;
    chart:series ex:series-6604-1 ;
    chart:xVal "2007" ;
    chart:yVal "5500"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

