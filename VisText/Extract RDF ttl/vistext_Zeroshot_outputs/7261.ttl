@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-7261 a chart:Chart ;
    chart:chartType "area" ;
    chart:title "Japan : Distribution of the workforce across economic sectors from 2010 to 2020" ;
    chart:xAxis ex:x-7261 ;
    chart:yAxis ex:y-7261 .

ex:x-7261 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2010" ;
    chart:scaleMax "2018" .

ex:y-7261 a chart:Axis ;
    chart:label "" ;
    chart:scaleMin "0.0" ;
    chart:scaleMax "0.8" .

ex:series-7261-1 a chart:Series ;
    chart:seriesName "Services" .

ex:point-7261-1-1 a chart:Point ;
    chart:series ex:series-7261-1 ;
    chart:xVal "2010" ;
    chart:yVal "0.69"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-7261-1-2 a chart:Point ;
    chart:series ex:series-7261-1 ;
    chart:xVal "2014" ;
    chart:yVal "0.72"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-7261-1-3 a chart:Point ;
    chart:series ex:series-7261-1 ;
    chart:xVal "2018" ;
    chart:yVal "0.74"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .
