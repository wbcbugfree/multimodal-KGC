ex:chart-3877 a chart:Chart ;
    chart:chartType "line" ;
    chart:title "Rate of prevalent cases of end-stage renal disease (ESRD) in the U.S. from 1980 to 2016\n(per million population)" ;
    chart:xAxis ex:x-3877 ;
    chart:yAxis ex:y-3877 .

ex:x-3877 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "1980" ;
    chart:scaleMax "2016" .

ex:y-3877 a chart:Axis ;
    chart:label "Number of cases per million population" ;
    chart:scaleMin "0" ;
    chart:scaleMax "2000" .

ex:series-3877-1 a chart:Series .

ex:point-3877-1-1 a chart:Point ;
    chart:series ex:series-3877-1 ;
    chart:xVal "1980" ;
    chart:yVal "100"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

