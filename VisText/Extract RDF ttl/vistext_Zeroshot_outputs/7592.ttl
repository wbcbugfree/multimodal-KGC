@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-7592 a chart:Chart ;
    chart:chartType "area" ;
    chart:title "Domestic and foreign revenue of the German analysis , bio , and laboratory technologies industry from 2010 to 2019 (in billion euros)" ;
    chart:xAxis ex:x-7592 ;
    chart:yAxis ex:y-7592 .

ex:x-7592 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2010" ;
    chart:scaleMax "2018" .

ex:y-7592 a chart:Axis ;
    chart:label "Foreign revenue" ;
    chart:scaleMin "0" ;
    chart:scaleMax "5" .

ex:series-7592-1 a chart:Series .

ex:point-7592-1-1 a chart:Point ;
    chart:series ex:series-7592-1 ;
    chart:xVal "2010" ;
    chart:yVal 3.3 ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-7592-1-2 a chart:Point ;
    chart:series ex:series-7592-1 ;
    chart:xVal "2011" ;
    chart:yVal 3.4 ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-7592-1-3 a chart:Point ;
    chart:series ex:series-7592-1 ;
    chart:xVal "2012" ;
    chart:yVal 3.5 ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-7592-1-4 a chart:Point ;
    chart:series ex:series-7592-1 ;
    chart:xVal "2013" ;
    chart:yVal 3.6 ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-7592-1-5 a chart:Point ;
    chart:series ex:series-7592-1 ;
    chart:xVal "2014" ;
    chart:yVal 3.8 ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-7592-1-6 a chart:Point ;
    chart:series ex:series-7592-1 ;
    chart:xVal "2015" ;
    chart:yVal 4.0 ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-7592-1-7 a chart:Point ;
    chart:series ex:series-7592-1 ;
    chart:xVal "2016" ;
    chart:yVal 4.2 ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-7592-1-8 a chart:Point ;
    chart:series ex:series-7592-1 ;
    chart:xVal "2017" ;
    chart:yVal 4.5 ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-7592-1-9 a chart:Point ;
