@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-4780 a chart:Chart ;
    chart:chartType "area" ;
    chart:title "Old-age dependency ratio in Singapore from 2010 to 2019" ;
    chart:xAxis ex:x-4780 ;
    chart:yAxis ex:y-4780 .

ex:x-4780 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2010" ;
    chart:scaleMax "2019" .

ex:y-4780 a chart:Axis ;
    chart:label "Old-age dependency ratio" ;
    chart:scaleMin "0" ;
    chart:scaleMax "25" .

ex:series-4780-1 a chart:Series .

ex:point-4780-1-1 a chart:Point ;
    chart:series ex:series-4780-1 ;
    chart:xVal "2010" ;
    chart:yVal "12.5"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-4780-1-2 a chart:Point ;
    chart:series ex:series-4780-1 ;
    chart:xVal "2012" ;
    chart:yVal "13.5"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-4780-1-3 a chart:Point ;
    chart:series ex:series-4780-1 ;
    chart:xVal "2014" ;
    chart:yVal "14.5"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-4780-1-4 a chart:Point ;
    chart:series ex:series-4780-1 ;
    chart:xVal "2016" ;
    chart:yVal "16.5"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-4780-1-5 a chart:Point ;
    chart:series ex:series-4780-1 ;
    chart:xVal "2018" ;
    chart:yVal "18.5"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-4780-1-6 a chart:Point ;
    chart:series ex:series-4780-1 ;
    chart:xVal "2019" ;
    chart:yVal "20.0"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .
