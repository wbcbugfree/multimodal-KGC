ex:chart-5738 a chart:Chart ;
    chart:chartType "area" ;
    chart:title "Military expenditure in Norway from 2009 to 2019 (in million NOK)" ;
    chart:xAxis ex:x-5738 ;
    chart:yAxis ex:y-5738 .

ex:x-5738 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2009" ;
    chart:scaleMax "2019" .

ex:y-5738 a chart:Axis ;
    chart:label "Expenditure in million NOK" ;
    chart:scaleMin "0" ;
    chart:scaleMax "60,000" .

ex:series-5738-1 a chart:Series ;
    chart:seriesName "Expenditure" .

