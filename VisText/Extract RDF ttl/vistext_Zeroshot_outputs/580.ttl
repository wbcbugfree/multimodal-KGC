@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-580 a chart:Chart ;
    chart:chartType "line" ;
    chart:title "U.S. sweet potato production value from 2000 to 2019 (in 1,000 U.S. dollars)" ;
    chart:xAxis ex:x-580 ;
    chart:yAxis ex:y-580 .

ex:x-580 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2000" ;
    chart:scaleMax "2019" .

ex:y-580 a chart:Axis ;
    chart:label "Production value in thousand U.S. dollars" ;
    chart:scaleMin "0" ;
    chart:scaleMax "800,000" .

ex:series-580-1 a chart:Series .

ex:point-580-1-1 a chart:Point ;
    chart:series ex:series-580-1 ;
    chart:xVal "2000" ;
    chart:yVal "230000"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

