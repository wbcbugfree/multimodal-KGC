ex:chart-4766 a chart:Chart ;
    chart:chartType "line" ;
    chart:xAxis ex:x-4766 ;
    chart:yAxis ex:y-4766 ;
    chart:title "Norway : Urbanization from 2009 to 2019" .

ex:x-4766 a chart:Axis ;
    chart:label "Response" ;
    chart:scaleMin "2009" ;
    chart:scaleMax "2019" .

ex:y-4766 a chart:Axis ;
    chart:label "Share of urban population in total population" ;
    chart:scaleMin "0.0" ;
    chart:scaleMax "1.0" .

ex:series-4766-1 a chart:Series ;
    chart:seriesName "Urbanization" .

ex:point-4766-1-1 a chart:Point ;
    chart:series ex:series-4766-1 ;
    chart:xVal "2009" ;
    chart:yVal "0.8"^^xsd:decimal ;
    chart:valueEstimated "false"^^xsd:boolean .

ex:point-4766-1-2 a chart:Point ;
    chart:series ex:series-4766-1 ;
    chart:xVal "2010" ;
    chart:yVal "0.80"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-4766-1-3 a chart:Point ;
    chart:series ex:series-4766-1 ;
    chart:xVal "2012" ;
    chart:yVal "0.805"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-4766-1-4 a chart:Point ;
    chart:series ex:series-4766-1 ;
    chart:xVal "2014" ;
    chart:yVal "0.81"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-4766-1-5 a chart:Point ;
    chart:series ex:series-4766-1 ;
    chart:xVal "2016" ;
    chart:yVal "0.815"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-4766-1-6 a chart:Point ;
