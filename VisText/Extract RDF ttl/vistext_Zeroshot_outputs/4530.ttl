@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-4530 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Greece : National debt from 2014 to 2024" ;
    chart:subtitle "(in billion U.S. dollars)" ;
    chart:xAxis ex:x-4530 ;
    chart:yAxis ex:y-4530 .

ex:x-4530 a chart:Axis ;
    chart:label "National debt in billion U.S. dollars" ;
    chart:scaleMin "0" ;
    chart:scaleMax "400" .

ex:y-4530 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "" ;
    chart:scaleMax "" .

ex:series-4530-1 a chart:Series .

ex:mark-4530-1-1 a chart:Bar ;
    chart:series ex:series-4530-1 ;
    chart:category "2014" ;
    chart:value "350"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

