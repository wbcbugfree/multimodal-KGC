@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-3340 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Forecast volume of molasses imported to the European Union (EU 27) from 2015 to 2028" ;
    chart:subtitle "(in 1,000 tonnes)" ;
    chart:xAxis ex:x-3340 ;
    chart:yAxis ex:y-3340 .

ex:x-3340 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "" ;
    chart:scaleMax "" .

ex:y-3340 a chart:Axis ;
    chart:label "Volume in thousand tonnes" ;
    chart:scaleMin "0" ;
    chart:scaleMax "1400" .

ex:series-3340-1 a chart:Series .

ex:mark-3340-1-1 a chart:Bar ;
    chart:series ex:series-3340-1 ;
    chart:category "2015" ;
    chart:value "1180"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

