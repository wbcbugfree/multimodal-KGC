ex:chart-8727 a chart:Chart ;
    chart:chartType "area" ;
    chart:title "Cumulative number of coronavirus (COVID-19) cases , active cases , recoveries , and deaths in Russia as of December 26 , 2020 , by date of report" ;
    chart:xAxis ex:x-8727 ;
    chart:yAxis ex:y-8727 .

ex:x-8727 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "" ;
    chart:scaleMax "" .

ex:y-8727 a chart:Axis ;
    chart:label "Active cases" ;
    chart:scaleMin "0" ;
    chart:scaleMax "500,000" .

ex:series-8727-1 a chart:Series .

ex:point-8727-1-1 a chart:Point ;
    chart:series ex:series-8727-1 ;
    chart:xVal "April" ;
    chart:yVal "0"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-8727-1-2 a chart:Point ;
    chart:series ex:series-8727-1 ;
    chart:xVal "July" ;
    chart:yVal "180000"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-8727-1-3 a chart:Point ;
    chart:series ex:series-8727-1 ;
    chart:xVal "October" ;
    chart:yVal "150000"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-8727-1-4 a chart:Point ;
    chart:series ex:series-8727-1 ;
    chart:xVal "December 26" ;
    chart:yVal "530000"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .
