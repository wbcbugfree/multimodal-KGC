ex:chart-8349 a chart:Chart ;
    chart:chartType "line" ;
    chart:title "Number of deaths in Belgium from 2006 to 2016 , by cause of death" ;
    chart:xAxis ex:x-8349 ;
    chart:yAxis ex:y-8349 .

ex:x-8349 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2006" ;
    chart:scaleMax "2016" .

ex:y-8349 a chart:Axis ;
    chart:label "Death by natural causes" ;
    chart:scaleMin "0" ;
    chart:scaleMax "100000" .

ex:series-8349-1 a chart:Series .

