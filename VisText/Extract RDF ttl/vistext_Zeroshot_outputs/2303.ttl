ex:chart-2303 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Installed power capacity across Rajasthan\nin India from financial year 2005 to 2018\n(in megawatts)" ;
    chart:xAxis ex:x-2303 ;
    chart:yAxis ex:y-2303 .

ex:x-2303 a chart:Axis ;
    chart:label "Installed power capacity in megawatts" ;
    chart:scaleMin "0" ;
    chart:scaleMax "20000" .

ex:y-2303 a chart:Axis ;
    chart:label "year" ;
    chart:scaleMin "" ;
    chart:scaleMax "" .

ex:series-2303-1 a chart:Series .

ex:mark-2303-1-1 a chart:Bar ;
    chart:series ex:series-2303-1 ;
    chart:category "FY 2005" ;
    chart:value "4000"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

