    chart:series ex:series-8136-1 ;
    chart:xVal "2013" ;
    chart:yVal "52000"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-8136-1-5 a chart:Point ;
    chart:series ex:series-8136-1 ;
    chart:xVal "2014" ;
    chart:yVal "54000"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-8136-1-6 a chart:Point ;
