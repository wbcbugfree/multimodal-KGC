    chart:xVal "2015" ;
    chart:yVal "55000"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-8136-1-7 a chart:Point ;
    chart:series ex:series-8136-1 ;
    chart:xVal "2016" ;
    chart:yVal "56000"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-8136-1-8 a chart:Point ;
