@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-8136 a chart:Chart ;
    chart:chartType "area" ;
    chart:title "Migration flow in Belgium from 2010 to 2019" ;
    chart:xAxis ex:x-8136 ;
    chart:yAxis ex:y-8136 .

ex:x-8136 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2010" ;
    chart:scaleMax "2019" .

ex:y-8136 a chart:Axis ;
    chart:label "Emigration" ;
    chart:scaleMin "0" ;
    chart:scaleMax "60000" .

ex:series-8136-1 a chart:Series .

ex:point-8136-1-1 a chart:Point ;
    chart:series ex:series-8136-1 ;
    chart:xVal "2010" ;
    chart:yVal "45000"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-8136-1-2 a chart:Point ;
    chart:series ex:series-8136-1 ;
    chart:xVal "2011" ;
    chart:yVal "48000"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-8136-1-3 a chart:Point ;
    chart:series ex:series-8136-1 ;
    chart:xVal "2012" ;
    chart:yVal "50000"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

