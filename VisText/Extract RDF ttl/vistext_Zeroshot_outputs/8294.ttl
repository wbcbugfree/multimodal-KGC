@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-8294 a chart:Chart ;
    chart:chartType "line" ;
    chart:xAxis ex:x-8294 ;
    chart:yAxis ex:y-8294 ;
    chart:title "Number of Facebook fans/twitter followers of Orlando Magic (NBA) from 2012 to 2020" ;
    chart:subtitle "(in millions)" .

ex:x-8294 a chart:Axis ;
    chart:label "Month" ;
    chart:scaleMin "2012" ;
    chart:scaleMax "2020" .

ex:y-8294 a chart:Axis ;
    chart:label "Facebook fans" ;
    chart:scaleMin "0.0" ;
    chart:scaleMax "3.0" .

ex:series-8294-1 a chart:Series .

ex:point-8294-1-1 a chart:Point ;
    chart:series ex:series-8294-1 ;
    chart:xVal "2012" ;
    chart:yVal "1.5"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-8294-1-2 a chart:Point ;
    chart:series ex:series-8294-1 ;
    chart:xVal "2013" ;
    chart:yVal "1.75"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-8294-1-3 a chart:Point ;
    chart:series ex:series-8294-1 ;
    chart:xVal "2014" ;
    chart:yVal "1.9"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-8294-1-4 a chart:Point ;
    chart:series ex:series-8294-1 ;
    chart:xVal "2015" ;
    chart:yVal "2.4"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-8294-1-5 a chart:Point ;
    chart:series ex:series-8294-1 ;
    chart:xVal "2016" ;
    chart:yVal "2.6"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-8294-1-6 a chart:Point ;
    chart:series ex:series-8294-1 ;
    chart:xVal "2017" ;
    chart:yVal "2.7"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-8294-1-7 a chart:Point ;
    chart:series ex:series-8294-1 ;
    chart:xVal "2018" ;
    chart:yVal "2.75"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-8294-1-8 a chart:Point ;
    chart:series ex:series-8294-1 ;
    chart:xVal "2019" ;
    chart:yVal "2.75"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-8294-1-9 a chart:Point ;
    chart:series ex:series-8294-1 ;
    chart:xVal "2020" ;
