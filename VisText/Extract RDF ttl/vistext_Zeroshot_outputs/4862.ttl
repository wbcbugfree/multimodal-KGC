@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-4862 a chart:Chart ;
    chart:chartType "bar" ;
    chart:xAxis ex:x-4862 ;
    chart:yAxis ex:y-4862 ;
    chart:title "Sugar production in the United States from 2009/2010 to 2019/2020 (in million metric tons)" .

ex:x-4862 a chart:Axis ;
    chart:label "Production in million metric tons" ;
    chart:scaleMin "0" ;
    chart:scaleMax "8" .

ex:y-4862 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "" ;
    chart:scaleMax "" .

ex:series-4862-1 a chart:Series .

ex:mark-4862-1-1 a chart:Bar ;
    chart:series ex:series-4862-1 ;
    chart:category "2009/2010" ;
    chart:value "7.8"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

