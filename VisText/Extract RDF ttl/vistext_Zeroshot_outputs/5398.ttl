@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-5398 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Value of the leading merchandise exporters worldwide in 2019 , by exporting nation (in billion U.S. dollars)" ;
    chart:xAxis ex:x-5398 ;
    chart:yAxis ex:y-5398 .

ex:x-5398 a chart:Axis ;
    chart:label "Export value in billion U.S. dollars" ;
    chart:scaleMin "0" ;
    chart:scaleMax "2500" .

ex:y-5398 a chart:Axis ;
    chart:label "Exporting nation" .

ex:series-5398-1 a chart:Series .

ex:mark-5398-1-1 a chart:Bar ;
    chart:series ex:series-5398-1 ;
    chart:category "Canada" ;
    chart:value "250"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

