ex:chart-7700 a chart:Chart ;
    chart:chartType "bar" ;
    chart:xAxis ex:x-7700 ;
    chart:yAxis ex:y-7700 ;
    chart:title "Population of Finland from 2009 to 2019" ;
    chart:subtitle ", by language (in thousands)" .

ex:x-7700 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2010" ;
    chart:scaleMax "2018" .

ex:y-7700 a chart:Axis ;
    chart:label "Swedish" ;
    chart:scaleMin "0" ;
    chart:scaleMax "300" .

ex:series-7700-1 a chart:Series ;
    chart:seriesName "Swedish" .

ex:mark-7700-1-1 a chart:Bar ;
    chart:series ex:series-7700-1 ;
    chart:category "2010" ;
    chart:value "300"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:mark-7700-1-2 a chart:Bar ;
    chart:series ex:series-7700-1 ;
    chart:category "2012" ;
    chart:value "300"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:mark-7700-1-3 a chart:Bar ;
    chart:series ex:series-7700-1 ;
    chart:category "2014" ;
    chart:value "300"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:mark-7700-1-4 a chart:Bar ;
    chart:series ex:series-7700-1 ;
    chart:category "2016" ;
    chart:value "300"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:mark-7700-1-5 a chart:Bar ;
