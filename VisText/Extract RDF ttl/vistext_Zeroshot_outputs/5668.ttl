@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-5668 a chart:Chart ;
    chart:chartType "area" ;
    chart:title "Homeowner vacancy rates in the United States" ;
    chart:subtitle "from 1990 to 2019" ;
    chart:xAxis ex:x-5668 ;
    chart:yAxis ex:y-5668 .

ex:x-5668 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "1990" ;
    chart:scaleMax "2015" .

ex:y-5668 a chart:Axis ;
    chart:label "Homeowner vacancy rate" ;
    chart:scaleMin "0.000" ;
    chart:scaleMax "0.025" .

ex:series-5668-1 a chart:Series .

ex:point-5668-1-1 a chart:Point ;
    chart:series ex:series-5668-1 ;
    chart:xVal "1990" ;
    chart:yVal "0.017"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-5668-1-2 a chart:Point ;
    chart:series ex:series-5668-1 ;
    chart:xVal "1995" ;
    chart:yVal "0.016"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-5668-1-3 a chart:Point ;
    chart:series ex:series-5668-1 ;
    chart:xVal "2000" ;
    chart:yVal "0.017"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-5668-1-4 a chart:Point ;
    chart:series ex:series-5668-1 ;
    chart:xVal "2005" ;
    chart:yVal "0.025"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-5668-1-5 a chart:Point ;
    chart:series ex:series-5668-1 ;
    chart:xVal "2010" ;
    chart:yVal "0.021"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-5668-1-6 a chart:Point ;
    chart:series ex:series-5668-1 ;
    chart:xVal "2015" ;
    chart:yVal "0.015"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .
