@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-7663 a chart:Chart ;
    chart:chartType "area" ;
    chart:title "Median total income of senior couple families in Canada from 2000 to 2018 , by age group (in Canadian dollars)" ;
    chart:xAxis ex:x-7663 ;
    chart:yAxis ex:y-7663 .

ex:x-7663 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2000" ;
    chart:scaleMax "2018" .

ex:y-7663 a chart:Axis ;
    chart:label "55 to 64 years" ;
    chart:scaleMin "0" ;
    chart:scaleMax "120000" .

ex:series-7663-1 a chart:Series ;
    chart:seriesName "Median total income" .

ex:point-7663-1-1 a chart:Point ;
    chart:series ex:series-7663-1 ;
    chart:xVal "2000" ;
    chart:yVal "60000"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-7663-1-2 a chart:Point ;
    chart:series ex:series-7663-1 ;
    chart:xVal "2002" ;
    chart:yVal "62000"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-7663-1-3 a chart:Point ;
    chart:series ex:series-7663-1 ;
    chart:xVal "2004" ;
    chart:yVal "66000"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

