@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-3052 a chart:Chart ;
    chart:chartType "line" ;
    chart:title "Number of Nissan cars sold in Sweden from 2009 to 2019" ;
    chart:xAxis ex:x-3052 ;
    chart:yAxis ex:y-3052 .

ex:x-3052 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2009" ;
    chart:scaleMax "2019" .

ex:y-3052 a chart:Axis ;
    chart:label "Units sold" ;
    chart:scaleMin "0" ;
    chart:scaleMax "10000" .

ex:series-3052-1 a chart:Series ;
    chart:seriesName "Nissan cars sold" .

ex:point-3052-1-1 a chart:Point ;
    chart:series ex:series-3052-1 ;
    chart:xVal "2009" ;
    chart:yVal "2800"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-3052-1-2 a chart:Point ;
    chart:series ex:series-3052-1 ;
    chart:xVal "2010" ;
    chart:yVal "6500"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-3052-1-3 a chart:Point ;
    chart:series ex:series-3052-1 ;
    chart:xVal "2011" ;
    chart:yVal "5800"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

