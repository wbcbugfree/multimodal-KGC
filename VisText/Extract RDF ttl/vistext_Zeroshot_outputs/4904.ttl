ex:chart-4904 a chart:Chart ;
    chart:chartType "area" ;
    chart:title "Number of daily confirmed cases of the novel\ncoronavirus infection COVID-19 in Malaysia\nas of January 6 , 2021" ;
    chart:xAxis ex:x-4904 ;
    chart:yAxis ex:y-4904 .

ex:x-4904 a chart:Axis ;
    chart:label "Month" ;
    chart:scaleMin "2000" ;
    chart:scaleMax "2020" .

ex:y-4904 a chart:Axis ;
    chart:label "Number of cases" ;
    chart:scaleMin "0" ;
    chart:scaleMax "2500" .

ex:series-4904-1 a chart:Series .

ex:point-4904-1-1 a chart:Point ;
    chart:series ex:series-4904-1 ;
    chart:xVal "2000" ;
    chart:yVal "0"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-4904-1-2 a chart:Point ;
    chart:series ex:series-4904-1 ;
    chart:xVal "2005" ;
    chart:yVal "0"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-4904-1-3 a chart:Point ;
    chart:series ex:series-4904-1 ;
    chart:xVal "2010" ;
    chart:yVal "0"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-4904-1-4 a chart:Point ;
    chart:series ex:series-4904-1 ;
    chart:xVal "2015" ;
    chart:yVal "0"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-4904-1-5 a chart:Point ;
    chart:series ex:series-4904-1 ;
    chart:xVal "2020" ;
    chart:yVal "2500"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .
