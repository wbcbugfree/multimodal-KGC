    chart:yAxis ex:y-7284 .

ex:x-7284 a chart:Axis ;
    chart:label "faith tradition" ;
    chart:scaleMin "" ;
    chart:scaleMax "" .

ex:y-7284 a chart:Axis ;
    chart:label "Men" ;
    chart:scaleMin "0.0" ;
    chart:scaleMax "0.7" .

ex:series-7284-1 a chart:Series .

