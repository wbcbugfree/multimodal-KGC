@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-4658 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Symbol groups ranked by number of convenience stores in the United Kingdom (UK) in 2014" ;
    chart:xAxis ex:x-4658 ;
    chart:yAxis ex:y-4658 .

ex:x-4658 a chart:Axis ;
    chart:label "symbol group" ;
    chart:scaleMin "" ;
    chart:scaleMax "" .

ex:y-4658 a chart:Axis ;
    chart:label "Number of stores" ;
    chart:scaleMin "0" ;
    chart:scaleMax "3000" .

ex:series-4658-1 a chart:Series .

ex:mark-4658-1-1 a chart:Bar ;
    chart:series ex:series-4658-1 ;
    chart:category "Best-one" ;
    chart:value "2900"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

