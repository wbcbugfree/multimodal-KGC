@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-5709 a chart:Chart ;
    chart:chartType "area" ;
    chart:xAxis ex:x-5709 ;
    chart:yAxis ex:y-5709 ;
    chart:title "Number of U.S. air strikes in Pakistan from 2004 to 2018" .

ex:x-5709 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2004" ;
    chart:scaleMax "2018" .

ex:y-5709 a chart:Axis ;
    chart:label "Number of air strikes" ;
    chart:scaleMin "0" ;
    chart:scaleMax "120" .

ex:series-5709-1 a chart:Series .

ex:point-5709-1-1 a chart:Point ;
    chart:series ex:series-5709-1 ;
    chart:xVal "2004" ;
    chart:yVal "2"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

