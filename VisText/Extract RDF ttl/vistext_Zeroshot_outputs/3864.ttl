@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-3864 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Most-affected countries and territories of explosive violence worldwide in 2013 , ranked by average civilian casualties per incident" ;
    chart:xAxis ex:x-3864 ;
    chart:yAxis ex:y-3864 .

ex:x-3864 a chart:Axis ;
    chart:label "Country" ;
    chart:scaleMin "" ;
    chart:scaleMax "" .

ex:y-3864 a chart:Axis ;
    chart:label "Civilian casualties per incident" ;
    chart:scaleMin "0" ;
    chart:scaleMax "70" .

ex:series-3864-1 a chart:Series .

ex:mark-3864-1-1 a chart:Bar ;
    chart:series ex:series-3864-1 ;
    chart:category "Afghanistan" ;
    chart:value "4"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

