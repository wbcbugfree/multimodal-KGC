@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-4560 a chart:Chart ;
    chart:chartType "line" ;
    chart:title "Percentage of elderly population in Italy" ;
    chart:subtitle "from 2009 to 2020" ;
    chart:xAxis ex:x-4560 ;
    chart:yAxis ex:y-4560 .

ex:x-4560 a chart:Axis ;
    chart:label "Response" ;
    chart:scaleMin "2009" ;
    chart:scaleMax "2020" .

ex:y-4560 a chart:Axis ;
    chart:label "Share of elderly people" ;
    chart:scaleMin "0.00" ;
    chart:scaleMax "0.25" .

ex:series-4560-1 a chart:Series ;
    chart:seriesName "Share of elderly people" .

ex:point-4560-1-1 a chart:Point ;
    chart:series ex:series-4560-1 ;
    chart:xVal "2009" ;
    chart:yVal "0.205"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-4560-1-2 a chart:Point ;
    chart:series ex:series-4560-1 ;
    chart:xVal "2010" ;
    chart:yVal "0.207"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

