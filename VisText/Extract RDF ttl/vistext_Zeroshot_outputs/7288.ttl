@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-7288 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Share of businesses using social media in the United Kingdom (UK) from 2013 to 2018 , by industry sector" ;
    chart:xAxis ex:x-7288 ;
    chart:yAxis ex:y-7288 .

ex:x-7288 a chart:Axis ;
    chart:label "industry sector" ;
    chart:scaleMin "" ;
    chart:scaleMax "" .

ex:y-7288 a chart:Axis ;
    chart:label "2015" ;
    chart:scaleMin "0.0" ;
    chart:scaleMax "0.8" .

ex:series-7288-1 a chart:Series .

ex:mark-7288-1-1 a chart:Bar ;
