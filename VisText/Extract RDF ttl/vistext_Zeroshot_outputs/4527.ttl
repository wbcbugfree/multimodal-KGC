@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-4527 a chart:Chart ;
    chart:chartType "line" ;
    chart:title "Median hourly earnings for full-time employees in the United Kingdom from 1997 to 2020 (in GBP)" ;
    chart:xAxis ex:x-4527 ;
    chart:yAxis ex:y-4527 .

ex:x-4527 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "1997" ;
    chart:scaleMax "2020" .

ex:y-4527 a chart:Axis ;
    chart:label "Hourly pay in GBP" ;
    chart:scaleMin "0" ;
    chart:scaleMax "15" .

ex:series-4527-1 a chart:Series .

ex:point-4527-1-1 a chart:Point ;
    chart:series ex:series-4527-1 ;
    chart:xVal "1997" ;
    chart:yVal "7.5"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-4527-1-2 a chart:Point ;
    chart:series ex:series-4527-1 ;
    chart:xVal "2000" ;
    chart:yVal "8.5"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-4527-1-3 a chart:Point ;
    chart:series ex:series-4527-1 ;
    chart:xVal "2005" ;
    chart:yVal "10.0"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-4527-1-4 a chart:Point ;
    chart:series ex:series-4527-1 ;
    chart:xVal "2010" ;
    chart:yVal "11.5"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-4527-1-5 a chart:Point ;
    chart:series ex:series-4527-1 ;
    chart:xVal "2015" ;
    chart:yVal "13.0"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-4527-1-6 a chart:Point ;
    chart:series ex:series-4527-1 ;
    chart:xVal "2020" ;
    chart:yVal "15.0"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .
