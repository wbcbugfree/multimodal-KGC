@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-6183 a chart:Chart ;
    chart:chartType "line" ;
    chart:title "Net revenue of Polo Ralph Lauren from FY2007 to FY2019 , by region (in million U.S. dollars)" ;
    chart:xAxis ex:x-6183 ;
    chart:yAxis ex:y-6183 .

ex:x-6183 a chart:Axis ;
    chart:label "Region" ;
    chart:scaleMin "2007" ;
    chart:scaleMax "2019" .

ex:y-6183 a chart:Axis ;
    chart:label "Asia*" ;
    chart:scaleMin "0" ;
    chart:scaleMax "1000" .

ex:series-6183-1 a chart:Series ;
    chart:seriesName "Asia*" .

ex:point-6183-1-1 a chart:Point ;
    chart:series ex:series-6183-1 ;
    chart:xVal "2007" ;
    chart:yVal "80"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

