@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-2501 a chart:Chart ;
    chart:chartType "area" ;
    chart:title "Number of shopping malls in the United States with more than 1 million sq . feet of gross leasable area from 1986 to 2010" ;
    chart:xAxis ex:x-2501 ;
    chart:yAxis ex:y-2501 .

ex:x-2501 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "1986" ;
    chart:scaleMax "2010" .

ex:y-2501 a chart:Axis ;
    chart:label "Number of shopping malls" ;
    chart:scaleMin "0" ;
    chart:scaleMax "500" .

ex:series-2501-1 a chart:Series .

ex:point-2501-1-1 a chart:Point ;
    chart:series ex:series-2501-1 ;
    chart:xVal "1986" ;
    chart:yVal "330"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-2501-1-2 a chart:Point ;
    chart:series ex:series-2501-1 ;
    chart:xVal "1990" ;
    chart:yVal "350"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-2501-1-3 a chart:Point ;
    chart:series ex:series-2501-1 ;
    chart:xVal "1995" ;
    chart:yVal "390"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-2501-1-4 a chart:Point ;
    chart:series ex:series-2501-1 ;
    chart:xVal "2000" ;
    chart:yVal "430"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-2501-1-5 a chart:Point ;
    chart:series ex:series-2501-1 ;
    chart:xVal "2005" ;
    chart:yVal "470"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-2501-1-6 a chart:Point ;
    chart:series ex:series-2501-1 ;
    chart:xVal "2010" ;
    chart:yVal "500"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .
