@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-2551 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Leading brands for best customer experience online , ranked by consumers in the United Kingdom (UK) in 2014" ;
    chart:xAxis ex:x-2551 ;
    chart:yAxis ex:y-2551 .

ex:x-2551 a chart:Axis ;
    chart:label "Response" ;
    chart:scaleMin "" ;
    chart:scaleMax "" .

ex:y-2551 a chart:Axis ;
    chart:label "Share of respondents" ;
    chart:scaleMin "0.0" ;
    chart:scaleMax "0.8" .

ex:series-2551-1 a chart:Series .

ex:mark-2551-1-1 a chart:Bar ;
    chart:series ex:series-2551-1 ;
    chart:category "Amazon (.co.uk)" ;
    chart:value "0.75"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

