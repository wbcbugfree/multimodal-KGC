@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-8762 a chart:Chart ;
    chart:chartType "area" ;
    chart:title "Number of employees at The Cheesecake Factory from 2009 to 2019 , by segment" ;
    chart:xAxis ex:x-8762 ;
    chart:yAxis ex:y-8762 .

ex:x-8762 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2009" ;
    chart:scaleMax "2019" .

ex:y-8762 a chart:Axis ;
    chart:label "Restaurant workers" ;
    chart:scaleMin "0" ;
    chart:scaleMax "40000" .

ex:series-8762-1 a chart:Series .

ex:point-8762-1-1 a chart:Point ;
    chart:series ex:series-8762-1 ;
    chart:xVal "2009" ;
    chart:yVal "32000"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-8762-1-2 a chart:Point ;
    chart:series ex:series-8762-1 ;
    chart:xVal "2010" ;
    chart:yVal "33000"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

