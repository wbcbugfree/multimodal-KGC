@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-526 a chart:Chart ;
    chart:chartType "line" ;
    chart:xAxis ex:x-526 ;
    chart:yAxis ex:y-526 .

ex:x-526 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2000" ;
    chart:scaleMax "2015" .

ex:y-526 a chart:Axis ;
    chart:label "Average annual wages in euros" ;
    chart:scaleMin "0" ;
    chart:scaleMax "25000" .

ex:series-526-1 a chart:Series .

ex:point-526-1-1 a chart:Point ;
    chart:series ex:series-526-1 ;
    chart:xVal "2000" ;
    chart:yVal "17000"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

