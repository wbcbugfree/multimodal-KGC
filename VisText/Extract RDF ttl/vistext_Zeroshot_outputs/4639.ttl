@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-4639 a chart:Chart ;
    chart:chartType "area" ;
    chart:title "Average Comex spot price of silver from 1975 to 2019 (in U.S. dollars per ounce)" ;
    chart:xAxis ex:x-4639 ;
    chart:yAxis ex:y-4639 .

ex:x-4639 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "1975" ;
    chart:scaleMax "2019" .

ex:y-4639 a chart:Axis ;
    chart:label "Price in U.S. dollars per ounce" ;
    chart:scaleMin "0" ;
    chart:scaleMax "40" .

ex:series-4639-1 a chart:Series .

ex:point-4639-1-1 a chart:Point ;
    chart:series ex:series-4639-1 ;
    chart:xVal "1975" ;
    chart:yVal "2.0"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-4639-1-2 a chart:Point ;
    chart:series ex:series-4639-1 ;
    chart:xVal "1980" ;
    chart:yVal "20.0"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

