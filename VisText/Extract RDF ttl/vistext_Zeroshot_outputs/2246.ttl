@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-2246 a chart:Chart ;
    chart:chartType "line" ;
    chart:title "Average discount rate of the Federal Reserve Bank of New York from 1990 to 2019" ;
    chart:xAxis ex:x-2246 ;
    chart:yAxis ex:y-2246 .

ex:x-2246 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "1990" ;
    chart:scaleMax "2019" .

ex:y-2246 a chart:Axis ;
    chart:label "Rate" ;
    chart:scaleMin "0.00" ;
    chart:scaleMax "0.07" .

ex:series-2246-1 a chart:Series .

ex:point-2246-1-1 a chart:Point ;
    chart:series ex:series-2246-1 ;
    chart:xVal "1990" ;
    chart:yVal "0.07"^^xsd:decimal ;
    chart:valueEstimated "false"^^xsd:boolean .

ex:point-2246-1-2 a chart:Point ;
    chart:series ex:series-2246-1 ;
    chart:xVal "1992" ;
    chart:yVal "0.053"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

