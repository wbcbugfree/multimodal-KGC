@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-1649 a chart:Chart ;
    chart:chartType "line" ;
    chart:title "Average duration of marriages in Belgium from 2008 to 2018 (in years)" ;
    chart:xAxis ex:x-1649 ;
    chart:yAxis ex:y-1649 .

ex:x-1649 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2008" ;
    chart:scaleMax "2018" .

ex:y-1649 a chart:Axis ;
    chart:label "Average duration in years" ;
    chart:scaleMin "0" ;
    chart:scaleMax "15" .

ex:series-1649-1 a chart:Series .

ex:point-1649-1-1 a chart:Point ;
    chart:series ex:series-1649-1 ;
    chart:xVal "2008" ;
    chart:yVal "15.0"^^xsd:decimal ;
    chart:valueEstimated "false"^^xsd:boolean .

ex:point-1649-1-2 a chart:Point ;
    chart:series ex:series-1649-1 ;
    chart:xVal "2009" ;
    chart:yVal "14.8"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

