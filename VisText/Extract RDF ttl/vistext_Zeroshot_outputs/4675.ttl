@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-4675 a chart:Chart ;
    chart:chartType "area" ;
    chart:title "Annual growth of gross domestic product (GDP) of Canada from 2000 to 2018" ;
    chart:xAxis ex:x-4675 ;
    chart:yAxis ex:y-4675 .

ex:x-4675 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2000" ;
    chart:scaleMax "2018" .

ex:y-4675 a chart:Axis ;
    chart:label "Annual gross domestic product growth" ;
    chart:scaleMin "-0.02" ;
    chart:scaleMax "0.06" .

ex:series-4675-1 a chart:Series .

ex:point-4675-1-1 a chart:Point ;
    chart:series ex:series-4675-1 ;
    chart:xVal "2000" ;
    chart:yVal 0.04 ;
    chart:valueEstimated "false"^^xsd:boolean .

