@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-2524 a chart:Chart ;
    chart:chartType "line" ;
    chart:title "U.S. producer price index of insulation materials from 1990 to 2018" ;
    chart:xAxis ex:x-2524 ;
    chart:yAxis ex:y-2524 .

ex:x-2524 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "1990" ;
    chart:scaleMax "2018" .

ex:y-2524 a chart:Axis ;
    chart:label "Price index" ;
    chart:scaleMin "0" ;
    chart:scaleMax "200" .

ex:series-2524-1 a chart:Series .

ex:point-2524-1-1 a chart:Point ;
    chart:series ex:series-2524-1 ;
    chart:xVal "1990" ;
    chart:yVal "110"^^xsd:decimal ;
    chart:valueEstimated "false"^^xsd:boolean .

ex:point-2524-1-2 a chart:Point ;
    chart:series ex:series-2524-1 ;
    chart:xVal "1995" ;
    chart:yVal "125"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-2524-1-3 a chart:Point ;
    chart:series ex:series-2524-1 ;
    chart:xVal "2000" ;
    chart:yVal "135"^^xsd:decimal ;
    chart:valueEstimated "false"^^xsd:boolean .

ex:point-2524-1-4 a chart:Point ;
    chart:series ex:series-2524-1 ;
    chart:xVal "2005" ;
    chart:yVal "140"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-2524-1-5 a chart:Point ;
    chart:series ex:series-2524-1 ;
    chart:xVal "2010" ;
    chart:yVal "150"^^xsd:decimal ;
    chart:valueEstimated "false"^^xsd:boolean .

ex:point-2524-1-6 a chart:Point ;
    chart:series ex:series-2524-1 ;
    chart:xVal "2015" ;
    chart:yVal "170"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-2524-1-7 a chart:Point ;
    chart:series ex:series-2524-1 ;
    chart:xVal "2018" ;
    chart:yVal "185"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .
