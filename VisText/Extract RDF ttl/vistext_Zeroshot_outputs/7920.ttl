@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-7920 a chart:Chart ;
    chart:chartType "line" ;
    chart:xAxis ex:x-7920 ;
    chart:yAxis ex:y-7920 ;
    chart:title "Annual revenue generated by Activision Blizzard from 2007 to 2019 , by region (in million U.S. dollars)" .

ex:x-7920 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2007" ;
    chart:scaleMax "2019" .

ex:y-7920 a chart:Axis ;
    chart:label "Asia Pacific" ;
    chart:scaleMin "0" ;
    chart:scaleMax "1000" .

ex:series-7920-1 a chart:Series ;
    chart:seriesName "Asia Pacific" .

ex:point-7920-1-1 a chart:Point ;
    chart:series ex:series-7920-1 ;
    chart:xVal "2007" ;
    chart:yVal "190"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

