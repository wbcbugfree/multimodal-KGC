@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-8771 a chart:Chart ;
    chart:chartType "area" ;
    chart:title "Distribution of Garmin 's revenue from 2009 to 2019 , by segment" ;
    chart:xAxis ex:x-8771 ;
    chart:yAxis ex:y-8771 .

ex:x-8771 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2009" ;
    chart:scaleMax "2019" .

ex:y-8771 a chart:Axis ;
    chart:label "Aviation" ;
    chart:scaleMin "0.00" ;
    chart:scaleMax "0.20" .

ex:series-8771-1 a chart:Series ;
    chart:seriesName "Aviation" .

ex:point-8771-1-1 a chart:Point ;
    chart:series ex:series-8771-1 ;
    chart:xVal "2009" ;
    chart:yVal "0.07"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-8771-1-2 a chart:Point ;
    chart:series ex:series-8771-1 ;
    chart:xVal "2010" ;
    chart:yVal "0.09"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

