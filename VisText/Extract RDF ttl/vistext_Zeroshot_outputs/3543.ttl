@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-3543 a chart:Chart ;
    chart:chartType "line" ;
    chart:xAxis ex:x-3543 ;
    chart:yAxis ex:y-3543 .

ex:x-3543 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2010" ;
    chart:scaleMax "2018" .

ex:y-3543 a chart:Axis ;
    chart:label "Earnings per share in U.S. dollars" ;
    chart:scaleMin "0" ;
    chart:scaleMax "2" .

ex:series-3543-1 a chart:Series .

ex:point-3543-1-1 a chart:Point ;
    chart:series ex:series-3543-1 ;
    chart:xVal "2010" ;
    chart:yVal "1.7"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-3543-1-2 a chart:Point ;
    chart:series ex:series-3543-1 ;
    chart:xVal "2011" ;
    chart:yVal "2.0"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-3543-1-3 a chart:Point ;
    chart:series ex:series-3543-1 ;
    chart:xVal "2012" ;
    chart:yVal "1.5"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-3543-1-4 a chart:Point ;
    chart:series ex:series-3543-1 ;
    chart:xVal "2013" ;
    chart:yVal "1.2"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-3543-1-5 a chart:Point ;
    chart:series ex:series-3543-1 ;
    chart:xVal "2014" ;
    chart:yVal "0.2"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-3543-1-6 a chart:Point ;
    chart:series ex:series-3543-1 ;
    chart:xVal "2015" ;
    chart:yVal "0.6"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-3543-1-7 a chart:Point ;
    chart:series ex:series-3543-1 ;
    chart:xVal "2016" ;
    chart:yVal "1.0"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-3543-1-8 a chart:Point ;
    chart:series ex:series-3543-1 ;
    chart:xVal "2017" ;
    chart:yVal "1.3"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-3543-1-9 a chart:Point ;
    chart:series ex:series-3543-1 ;
    chart:xVal "2018" ;
    chart:yVal "1.6"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .
