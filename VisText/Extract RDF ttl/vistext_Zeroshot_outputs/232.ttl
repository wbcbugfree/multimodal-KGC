ex:chart-232 a chart:Chart ;
    chart:chartType "line" ;
    chart:title "Registered cases of murder and manslaughter\nin Belgium from 2008 to 2019" ;
    chart:xAxis ex:x-232 ;
    chart:yAxis ex:y-232 .

ex:x-232 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2008" ;
    chart:scaleMax "2019" .

ex:y-232 a chart:Axis ;
    chart:label "Cases of murder and manslaughter" ;
    chart:scaleMin "0" ;
    chart:scaleMax "1200" .

ex:series-232-1 a chart:Series .

ex:point-232-1-1 a chart:Point ;
    chart:series ex:series-232-1 ;
    chart:xVal "2008" ;
    chart:yVal "850"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

