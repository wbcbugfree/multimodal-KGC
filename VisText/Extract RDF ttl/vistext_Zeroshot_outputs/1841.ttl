@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-1841 a chart:Chart ;
    chart:chartType "bar" ;
    chart:xAxis ex:x-1841 ;
    chart:yAxis ex:y-1841 ;
    chart:title "Number of people with bleeding disorders in Canada in 2019 , by disorder type" .

ex:x-1841 a chart:Axis ;
    chart:label "Number of people" ;
    chart:scaleMin "0" ;
    chart:scaleMax "5000" .

ex:y-1841 a chart:Axis ;
    chart:label "Bleeding Disorder Type" ;
    chart:scaleMin "" ;
    chart:scaleMax "" .

ex:series-1841-1 a chart:Series .

ex:mark-1841-1-1 a chart:Bar ;
    chart:series ex:series-1841-1 ;
    chart:category "Bernard Soulier" ;
    chart:value "100"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

