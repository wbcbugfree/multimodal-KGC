@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-8503 a chart:Chart ;
    chart:chartType "area" ;
    chart:title "Total number of births , deaths and birth excess in the Netherlands from 2008 to 2018" ;
    chart:xAxis ex:x-8503 ;
    chart:yAxis ex:y-8503 .

ex:x-8503 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2008" ;
    chart:scaleMax "2018" .

ex:y-8503 a chart:Axis ;
    chart:label "Deaths" ;
    chart:scaleMin "0" ;
    chart:scaleMax "150000" .

ex:series-8503-1 a chart:Series ;
    chart:seriesName "Deaths" .

ex:series-8503-2 a chart:Series ;
    chart:seriesName "Births" .

ex:series-8503-3 a chart:Series ;
    chart:seriesName "Birth Excess" .

ex:point-8503-1-1 a chart:Point ;
    chart:series ex:series-8503-1 ;
    chart:xVal "2008" ;
    chart:yVal "130000"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-8503-1-2 a chart:Point ;
    chart:series ex:series-8503-1 ;
    chart:xVal "2010" ;
    chart:yVal "132000"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

