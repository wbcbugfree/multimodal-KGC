ex:chart-2921 a chart:Chart ;
    chart:chartType "line" ;
    chart:title "Number of employees of toy manufacturer Ravensburger worldwide from 2004 to 2018" ;
    chart:subtitle "(in 1,000s)" ;
    chart:xAxis ex:x-2921 ;
    chart:yAxis ex:y-2921 .

ex:x-2921 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2004" ;
    chart:scaleMax "2018" .

ex:y-2921 a chart:Axis ;
    chart:label "Number of employees in thousands" ;
    chart:scaleMin "0" ;
    chart:scaleMax "2000" .

ex:series-2921-1 a chart:Series .

ex:point-2921-1-1 a chart:Point ;
    chart:series ex:series-2921-1 ;
    chart:xVal "2004" ;
    chart:yVal "1450"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

