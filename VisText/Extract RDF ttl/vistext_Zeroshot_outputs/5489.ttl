@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-5489 a chart:Chart ;
    chart:chartType "area" ;
    chart:title "Worldwide number of Airbus aircraft deliveries from 2002 to 2019 (in units)" ;
    chart:xAxis ex:x-5489 ;
    chart:yAxis ex:y-5489 .

ex:x-5489 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2002" ;
    chart:scaleMax "2019" .

ex:y-5489 a chart:Axis ;
    chart:label "Number of aircraft deliveries" ;
    chart:scaleMin "0" ;
    chart:scaleMax "800" .

ex:series-5489-1 a chart:Series .

ex:point-5489-1-1 a chart:Point ;
    chart:series ex:series-5489-1 ;
    chart:xVal "2002" ;
    chart:yVal "240"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

