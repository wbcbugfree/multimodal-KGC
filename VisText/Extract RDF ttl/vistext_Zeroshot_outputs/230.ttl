ex:chart-230 a chart:Chart ;
    chart:chartType "line" ;
    chart:title "Electricity generation worldwide from 1990 to 2018 (in terawatt hours)" ;
    chart:xAxis ex:x-230 ;
    chart:yAxis ex:y-230 .

ex:x-230 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "1990" ;
    chart:scaleMax "2018" .

ex:y-230 a chart:Axis ;
    chart:label "Electricity generation in terawatt hours" ;
    chart:scaleMin "0" ;
    chart:scaleMax "25000" .

ex:series-230-1 a chart:Series .

ex:point-230-1-1 a chart:Point ;
    chart:series ex:series-230-1 ;
    chart:xVal "1990" ;
    chart:yVal "11700"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-230-1-2 a chart:Point ;
    chart:series ex:series-230-1 ;
    chart:xVal "1995" ;
    chart:yVal "13000"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-230-1-3 a chart:Point ;
    chart:series ex:series-230-1 ;
    chart:xVal "2000" ;
    chart:yVal "15200"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-230-1-4 a chart:Point ;
    chart:series ex:series-230-1 ;
    chart:xVal "2005" ;
    chart:yVal "18000"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-230-1-5 a chart:Point ;
    chart:series ex:series-230-1 ;
    chart:xVal "2010" ;
    chart:yVal "20500"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-230-1-6 a chart:Point ;
    chart:series ex:series-230-1 ;
    chart:xVal "2015" ;
    chart:yVal "23500"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-230-1-7 a chart:Point ;
    chart:series ex:series-230-1 ;
    chart:xVal "2018" ;
    chart:yVal "25500"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .
