@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-3532 a chart:Chart ;
    chart:chartType "area" ;
    chart:title "Number of researchers in the research & development sector per million inhabitants in China from 2009 to 2018" ;
    chart:xAxis ex:x-3532 ;
    chart:yAxis ex:y-3532 .

ex:x-3532 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2009" ;
    chart:scaleMax "2018" .

ex:y-3532 a chart:Axis ;
    chart:label "Number per million inhabitants" ;
    chart:scaleMin "0" ;
    chart:scaleMax "1400" .

ex:series-3532-1 a chart:Series .

ex:point-3532-1-1 a chart:Point ;
    chart:series ex:series-3532-1 ;
    chart:xVal "2009" ;
    chart:yVal "840"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

