ex:chart-1002 a chart:Chart ;
    chart:chartType "bar" ;
    chart:xAxis ex:x-1002 ;
    chart:yAxis ex:y-1002 .

ex:x-1002 a chart:Axis ;
    chart:label "Share of respondents" ;
    chart:scaleMin "0.0" ;
    chart:scaleMax "0.2" .

ex:y-1002 a chart:Axis ;
    chart:label "Response" ;
    chart:scaleMin "1" ;
    chart:scaleMax "10" .

ex:series-1002-1 a chart:Series .

ex:mark-1002-1-1 a chart:Bar ;
    chart:series ex:series-1002-1 ;
    chart:category "1 - Not influential at all" ;
    chart:value "0.02"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

