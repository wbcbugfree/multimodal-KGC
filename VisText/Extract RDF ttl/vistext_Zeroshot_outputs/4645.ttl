    chart:title "Top 15 most frequently visited websites" ;
    chart:subtitle "in Sweden as of March 2017" ;
    chart:xAxis ex:x-4645 ;
    chart:yAxis ex:y-4645 .

ex:x-4645 a chart:Axis ;
    chart:label "website" ;
    chart:scaleMin "" ;
    chart:scaleMax "" .

ex:y-4645 a chart:Axis ;
    chart:label "Weekly reach" ;
    chart:scaleMin "0.0" ;
    chart:scaleMax "0.9" .

ex:series-4645-1 a chart:Series .

