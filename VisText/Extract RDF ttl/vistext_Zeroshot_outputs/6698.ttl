@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-6698 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Number of bankruptcies after the coronavirus outbreak in Sweden from February to November 2020 , by industry" ;
    chart:xAxis ex:x-6698 ;
    chart:yAxis ex:y-6698 .

ex:x-6698 a chart:Axis ;
    chart:label "Construction" ;
    chart:scaleMin "0" ;
    chart:scaleMax "120" .

ex:y-6698 a chart:Axis ;
    chart:label "Month" ;
    chart:scaleMin "" ;
    chart:scaleMax "" .

ex:series-6698-1 a chart:Series .

ex:mark-6698-1-1 a chart:Bar ;
    chart:series ex:series-6698-1 ;
    chart:category "Apr" ;
    chart:value "120"^^xsd:decimal ;
    chart:valueEstimated "false"^^xsd:boolean .

ex:mark-6698-1-2 a chart:Bar ;
    chart:series ex:series-6698-1 ;
    chart:category "Aug" ;
    chart:value "70"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

