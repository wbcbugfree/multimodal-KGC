@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-1221 a chart:Chart ;
    chart:chartType "bar" ;
    chart:xAxis ex:x-1221 ;
    chart:yAxis ex:y-1221 ;
    chart:title "Box office revenue of the highest grossing movies in North America in 2019 (in million U.S. dollars)" .

ex:x-1221 a chart:Axis ;
    chart:label "Box office gross in million U.S. dollars" ;
    chart:scaleMin "0" ;
    chart:scaleMax "800" .

ex:y-1221 a chart:Axis ;
    chart:label "film" ;
    chart:scaleMin "" ;
    chart:scaleMax "" .

ex:series-1221-1 a chart:Series .

