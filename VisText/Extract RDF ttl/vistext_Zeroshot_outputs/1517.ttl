@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-1517 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Total number of marriages in France from 2004 to 2019" ;
    chart:xAxis ex:x-1517 ;
    chart:yAxis ex:y-1517 .

ex:x-1517 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "" ;
    chart:scaleMax "" .

ex:y-1517 a chart:Axis ;
    chart:label "Number of marriages" ;
    chart:scaleMin "0" ;
    chart:scaleMax "300000" .

ex:series-1517-1 a chart:Series .

ex:mark-1517-1-1 a chart:Bar ;
    chart:series ex:series-1517-1 ;
    chart:category "2004" ;
    chart:value "298000"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

