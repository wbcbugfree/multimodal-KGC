@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-4104 a chart:Chart ;
    chart:chartType "bar" ;
    chart:xAxis ex:x-4104 ;
    chart:yAxis ex:y-4104 ;
    chart:title "Leading gaming content on Twitch worldwide" ;
    chart:subtitle "from January 1 , 2019 to June 30 , 2019 ," ;
    chart:source "by hours watched (in millions)" .

ex:x-4104 a chart:Axis ;
    chart:label "Number of hours watched" ;
    chart:scaleMin "0" ;
    chart:scaleMax "500" .

ex:y-4104 a chart:Axis ;
    chart:label "gaming content" ;
    chart:scaleMin "" ;
    chart:scaleMax "" .

ex:series-4104-1 a chart:Series ;
    chart:seriesName "Hours Watched (in millions)" .

ex:mark-4104-1-1 a chart:Bar ;
    chart:series ex:series-4104-1 ;
    chart:category "Apex Legends" ;
    chart:value "150"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:mark-4104-1-2 a chart:Bar ;
    chart:series ex:series-4104-1 ;
    chart:category "Counter-Strike: Global Offensive" ;
    chart:value "150"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

