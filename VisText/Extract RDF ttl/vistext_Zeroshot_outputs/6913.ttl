@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-6913 a chart:Chart ;
    chart:chartType "area" ;
    chart:xAxis ex:x-6913 ;
    chart:yAxis ex:y-6913 ;
    chart:title "Consumer Price Index of pan , tobacco , and intoxicants across urban and rural India from March 2019 to March 2020 , by month" .

ex:x-6913 a chart:Axis ;
    chart:label "Month" ;
    chart:scaleMin "April" ;
    chart:scaleMax "2020" .

ex:y-6913 a chart:Axis ;
    chart:label "Urban" ;
    chart:scaleMin "0" ;
    chart:scaleMax "150" .

ex:series-6913-1 a chart:Series .

ex:point-6913-1-1 a chart:Point ;
    chart:series ex:series-6913-1 ;
    chart:xVal "April" ;
    chart:yVal "160"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-6913-1-2 a chart:Point ;
    chart:series ex:series-6913-1 ;
    chart:xVal "July" ;
    chart:yVal "162"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-6913-1-3 a chart:Point ;
    chart:series ex:series-6913-1 ;
    chart:xVal "October" ;
    chart:yVal "165"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-6913-1-4 a chart:Point ;
    chart:series ex:series-6913-1 ;
    chart:xVal "2020" ;
    chart:yVal "168"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .
