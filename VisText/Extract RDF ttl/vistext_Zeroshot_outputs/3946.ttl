ex:chart-3946 a chart:Chart ;
    chart:chartType "area" ;
    chart:xAxis ex:x-3946 ;
    chart:yAxis ex:y-3946 .

ex:x-3946 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "1990" ;
    chart:scaleMax "2015" .

ex:y-3946 a chart:Axis ;
    chart:label "Average haul length in kilometres" ;
    chart:scaleMin "0" ;
    chart:scaleMax "100" .

ex:series-3946-1 a chart:Series ;
    chart:seriesName "Average haul length" .

ex:point-3946-1-1 a chart:Point ;
    chart:series ex:series-3946-1 ;
    chart:xVal "1990" ;
    chart:yVal "70"^^xsd:decimal ;
    chart:valueEstimated "false"^^xsd:boolean .

ex:point-3946-1-2 a chart:Point ;
    chart:series ex:series-3946-1 ;
    chart:xVal "1995" ;
    chart:yVal "85"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

