@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-5891 a chart:Chart ;
    chart:chartType "area" ;
    chart:title "Russia : Unemployment rate from 1999 to 2020" ;
    chart:xAxis ex:x-5891 ;
    chart:yAxis ex:y-5891 .

ex:x-5891 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "1999" ;
    chart:scaleMax "2020" .

ex:y-5891 a chart:Axis ;
    chart:label "Unemployment rate" ;
    chart:scaleMin "0.00" ;
    chart:scaleMax "0.14" .

ex:series-5891-1 a chart:Series .

ex:point-5891-1-1 a chart:Point ;
    chart:series ex:series-5891-1 ;
    chart:xVal "1999" ;
    chart:yVal 0.135 ;
    chart:valueEstimated "true"^^xsd:boolean .

