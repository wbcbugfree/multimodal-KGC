    chart:title "Share of discretionary mandate and investment fund assets under management in Europe in the end of 2015 , by country" ;
    chart:xAxis ex:x-8344 ;
    chart:yAxis ex:y-8344 .

ex:x-8344 a chart:Axis ;
    chart:label "Country" ;
    chart:scaleMin "" ;
    chart:scaleMax "" .

ex:y-8344 a chart:Axis ;
    chart:label "Discretionary mandates" ;
    chart:scaleMin "0.0" ;
    chart:scaleMax "0.8" .

ex:series-8344-1 a chart:Series .

