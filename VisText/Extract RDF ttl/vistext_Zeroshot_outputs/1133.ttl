@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-1133 a chart:Chart ;
    chart:chartType "line" ;
    chart:xAxis ex:x-1133 ;
    chart:yAxis ex:y-1133 .

ex:x-1133 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2008" ;
    chart:scaleMax "2016" .

ex:y-1133 a chart:Axis ;
    chart:label "Number of enterprises" ;
    chart:scaleMin "0" ;
    chart:scaleMax "400" .

ex:series-1133-1 a chart:Series .

ex:point-1133-1-1 a chart:Point ;
    chart:series ex:series-1133-1 ;
    chart:xVal "2008" ;
    chart:yVal "350"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-1133-1-2 a chart:Point ;
    chart:series ex:series-1133-1 ;
    chart:xVal "2009" ;
    chart:yVal "340"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-1133-1-3 a chart:Point ;
    chart:series ex:series-1133-1 ;
    chart:xVal "2010" ;
    chart:yVal "335"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-1133-1-4 a chart:Point ;
    chart:series ex:series-1133-1 ;
    chart:xVal "2011" ;
    chart:yVal "330"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-1133-1-5 a chart:Point ;
    chart:series ex:series-1133-1 ;
    chart:xVal "2012" ;
    chart:yVal "330"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-1133-1-6 a chart:Point ;
    chart:series ex:series-1133-1 ;
    chart:xVal "2013" ;
    chart:yVal "325"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-1133-1-7 a chart:Point ;
    chart:series ex:series-1133-1 ;
    chart:xVal "2014" ;
    chart:yVal "320"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-1133-1-8 a chart:Point ;
    chart:series ex:series-1133-1 ;
    chart:xVal "2015" ;
    chart:yVal "310"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-1133-1-9 a chart:Point ;
