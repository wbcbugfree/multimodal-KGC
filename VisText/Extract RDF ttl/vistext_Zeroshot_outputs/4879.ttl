@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-4879 a chart:Chart ;
    chart:chartType "area" ;
    chart:title "Number of branches of Deutsche Bank worldwide" ;
    chart:subtitle "from 2010 to 2019" ;
    chart:xAxis ex:x-4879 ;
    chart:yAxis ex:y-4879 .

ex:x-4879 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2010" ;
    chart:scaleMax "2018" .

ex:y-4879 a chart:Axis ;
    chart:label "Number of branches" ;
    chart:scaleMin "0" ;
    chart:scaleMax "3500" .

ex:series-4879-1 a chart:Series .

ex:point-4879-1-1 a chart:Point ;
    chart:series ex:series-4879-1 ;
    chart:xVal "2010" ;
    chart:yVal "3250"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-4879-1-2 a chart:Point ;
    chart:series ex:series-4879-1 ;
    chart:xVal "2011" ;
    chart:yVal "3150"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

