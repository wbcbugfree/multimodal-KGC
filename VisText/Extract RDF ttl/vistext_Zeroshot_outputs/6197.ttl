@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-6197 a chart:Chart ;
    chart:chartType "line" ;
    chart:title "Sri Lanka : Age structure from 2009 to 2019" ;
    chart:xAxis ex:x-6197 ;
    chart:yAxis ex:y-6197 .

ex:x-6197 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2009" ;
    chart:scaleMax "2019" .

ex:y-6197 a chart:Axis ;
    chart:label "65 years and older" ;
    chart:scaleMin "0.00" ;
    chart:scaleMax "0.10" .

ex:series-6197-1 a chart:Series .

ex:point-6197-1-1 a chart:Point ;
    chart:series ex:series-6197-1 ;
    chart:xVal "2009" ;
    chart:yVal "0.07"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-6197-1-2 a chart:Point ;
    chart:series ex:series-6197-1 ;
    chart:xVal "2010" ;
    chart:yVal "0.072"^^xsd:decimal ;
