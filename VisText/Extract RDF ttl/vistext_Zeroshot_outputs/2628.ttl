ex:chart-2628 a chart:Chart ;
    chart:chartType "area" ;
    chart:xAxis ex:x-2628 ;
    chart:yAxis ex:y-2628 ;
    chart:title "Number of new COVID-19 confirmed cases in Australia March to September 2020" .

ex:x-2628 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "" ;
    chart:scaleMax "" .

ex:y-2628 a chart:Axis ;
    chart:label "Number of new confirmed cases" ;
    chart:scaleMin "0" ;
    chart:scaleMax "800" .

ex:series-2628-1 a chart:Series .

ex:point-2628-1-1 a chart:Point ;
    chart:series ex:series-2628-1 ;
    chart:xVal "March" ;
    chart:yVal "100"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-2628-1-2 a chart:Point ;
    chart:series ex:series-2628-1 ;
    chart:xVal "April" ;
    chart:yVal "400"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

