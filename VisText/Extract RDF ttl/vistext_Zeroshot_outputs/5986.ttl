@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-5986 a chart:Chart ;
    chart:chartType "bar" ;
    chart:xAxis ex:x-5986 ;
    chart:yAxis ex:y-5986 ;
    chart:title "U.S. whole cattle hide exports by top 10 destination countries in 2017 (in pieces)" .

ex:x-5986 a chart:Axis ;
    chart:label "Export in number of pieces" ;
    chart:scaleMin "0" ;
    chart:scaleMax "12000000" .

ex:y-5986 a chart:Axis ;
    chart:label "Country" ;
    chart:scaleMin "" ;
    chart:scaleMax "" .

ex:series-5986-1 a chart:Series .

ex:mark-5986-1-1 a chart:Bar ;
    chart:series ex:series-5986-1 ;
    chart:category "Bosnia and Herzegovina" ;
    chart:value "11000000"^^xsd:decimal ;
    chart:valueEstimated "false"^^xsd:boolean .

