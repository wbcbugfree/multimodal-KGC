ex:chart-8057 a chart:Chart ;
    chart:chartType "area" ;
    chart:title "Monthly number of visitor arrivals in Kenya from January 2019 to August 2020 , by airport" ;
    chart:xAxis ex:x-8057 ;
    chart:yAxis ex:y-8057 .

ex:x-8057 a chart:Axis ;
    chart:label "Month" ;
    chart:scaleMin "" ;
    chart:scaleMax "" .

ex:y-8057 a chart:Axis ;
    chart:label "MIA" ;
    chart:scaleMin "0" ;
    chart:scaleMax "15000" .

ex:series-8057-1 a chart:Series .

ex:point-8057-1-1 a chart:Point ;
    chart:series ex:series-8057-1 ;
    chart:xVal "2019" ;
    chart:yVal "15000"^^xsd:decimal ;
    chart:valueEstimated "false"^^xsd:boolean .

ex:point-8057-1-2 a chart:Point ;
    chart:series ex:series-8057-1 ;
    chart:xVal "April" ;
    chart:yVal "2500"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-8057-1-3 a chart:Point ;
    chart:series ex:series-8057-1 ;
    chart:xVal "July" ;
    chart:yVal "9500"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-8057-1-4 a chart:Point ;
    chart:series ex:series-8057-1 ;
    chart:xVal "October" ;
    chart:yVal "7500"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-8057-1-5 a chart:Point ;
    chart:series ex:series-8057-1 ;
    chart:xVal "2020" ;
    chart:yVal "10500"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-8057-1-6 a chart:Point ;
    chart:series ex:series-8057-1 ;
    chart:xVal "April" ;
    chart:yVal "10000"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-8057-1-7 a chart:Point ;
    chart:series ex:series-8057-1 ;
    chart:xVal "July" ;
    chart:yVal "0"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .
