@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-2258 a chart:Chart ;
    chart:chartType "area" ;
    chart:title "Comparable sales growth of Sam 's Club in the United States from fiscal year 2006 to 2020" ;
    chart:xAxis ex:x-2258 ;
    chart:yAxis ex:y-2258 .

ex:x-2258 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "-0.04" ;
    chart:scaleMax "2020" .

ex:y-2258 a chart:Axis ;
    chart:label "Comparable sales growth" ;
    chart:scaleMin "-0.04" ;
    chart:scaleMax "0.08" .

ex:series-2258-1 a chart:Series .

ex:point-2258-1-1 a chart:Point ;
    chart:series ex:series-2258-1 ;
    chart:xVal "2006" ;
    chart:yVal 0.045 ;
    chart:valueEstimated "true"^^xsd:boolean .

