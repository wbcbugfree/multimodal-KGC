@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-6018 a chart:Chart ;
    chart:chartType "area" ;
    chart:title "Colombia : Distribution of employment by economic sector from 2010 to 2020" ;
    chart:xAxis ex:x-6018 ;
    chart:yAxis ex:y-6018 .

ex:x-6018 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2010" ;
    chart:scaleMax "2020" .

ex:y-6018 a chart:Axis ;
    chart:label "Agriculture" ;
    chart:scaleMin "0.00" ;
    chart:scaleMax "0.20" .

ex:series-6018-1 a chart:Series .

ex:point-6018-1-1 a chart:Point ;
    chart:series ex:series-6018-1 ;
    chart:xVal "2010" ;
    chart:yVal "0.18"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-6018-1-2 a chart:Point ;
    chart:series ex:series-6018-1 ;
    chart:xVal "2012" ;
    chart:yVal "0.17"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-6018-1-3 a chart:Point ;
    chart:series ex:series-6018-1 ;
    chart:xVal "2014" ;
    chart:yVal "0.165"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-6018-1-4 a chart:Point ;
    chart:series ex:series-6018-1 ;
    chart:xVal "2016" ;
    chart:yVal "0.168"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-6018-1-5 a chart:Point ;
    chart:series ex:series-6018-1 ;
    chart:xVal "2018" ;
    chart:yVal "0.167"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-6018-1-6 a chart:Point ;
    chart:series ex:series-6018-1 ;
    chart:xVal "2020" ;
    chart:yVal "0.165"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .
