ex:chart-4542 a chart:Chart ;
    chart:chartType "line" ;
    chart:title "Annual expenditure on footwear in the United Kingdom (UK) from 2005 to 2019 , based on volume (in million GBP)" ;
    chart:xAxis ex:x-4542 ;
    chart:yAxis ex:y-4542 .

ex:x-4542 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2005" ;
    chart:scaleMax "2019" .

ex:y-4542 a chart:Axis ;
    chart:label "Expenditure in million GBP" ;
    chart:scaleMin "0" ;
    chart:scaleMax "12000" .

ex:series-4542-1 a chart:Series .

