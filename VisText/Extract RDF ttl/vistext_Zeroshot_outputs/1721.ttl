@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-1721 a chart:Chart ;
    chart:chartType "bar" ;
    chart:xAxis ex:x-1721 ;
    chart:yAxis ex:y-1721 ;
    chart:title "Ranking of the most successful films at cinemas in Sweden in 2019 , by number of admissions" .

ex:x-1721 a chart:Axis ;
    chart:label "Number of admissions" ;
    chart:scaleMin "0" ;
    chart:scaleMax "1200000" .

ex:y-1721 a chart:Axis ;
    chart:label "film" ;
    chart:scaleMin "" ;
    chart:scaleMax "" .

ex:series-1721-1 a chart:Series .

ex:mark-1721-1-1 a chart:Bar ;
    chart:series ex:series-1721-1 ;
    chart:category "The Lion King" ;
    chart:value "1200000"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

