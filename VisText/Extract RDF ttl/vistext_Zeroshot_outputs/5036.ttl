@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-5036 a chart:Chart ;
    chart:chartType "line" ;
    chart:title "Number of deaths caused by coronavirus (COVID-19) in Romania from May 2020 to January 2021 , by day of report" ;
    chart:xAxis ex:x-5036 ;
    chart:yAxis ex:y-5036 .

ex:x-5036 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "" ;
    chart:scaleMax "" .

ex:y-5036 a chart:Axis ;
    chart:label "Number of deaths" ;
    chart:scaleMin "0" ;
    chart:scaleMax "200" .

ex:series-5036-1 a chart:Series .

ex:point-5036-1-1 a chart:Point ;
    chart:series ex:series-5036-1 ;
    chart:xVal "June" ;
    chart:yVal "10"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-5036-1-2 a chart:Point ;
    chart:series ex:series-5036-1 ;
    chart:xVal "June" ;
    chart:yVal "15"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

