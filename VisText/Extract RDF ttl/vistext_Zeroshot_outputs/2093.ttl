ex:chart-2093 a chart:Chart ;
    chart:chartType "area" ;
    chart:title "Rwanda : Birth rate from 2008 to 2018 (per 1,000 inhabitants)" ;
    chart:xAxis ex:x-2093 ;
    chart:yAxis ex:y-2093 .

ex:x-2093 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2008" ;
    chart:scaleMax "2018" .

ex:y-2093 a chart:Axis ;
    chart:label "Birth rate per thousand population" ;
    chart:scaleMin "0" ;
    chart:scaleMax "40" .

ex:series-2093-1 a chart:Series .

ex:point-2093-1-1 a chart:Point ;
    chart:series ex:series-2093-1 ;
    chart:xVal "2008" ;
    chart:yVal "37.0"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-2093-1-2 a chart:Point ;
    chart:series ex:series-2093-1 ;
    chart:xVal "2010" ;
    chart:yVal "36.0"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-2093-1-3 a chart:Point ;
    chart:series ex:series-2093-1 ;
    chart:xVal "2012" ;
    chart:yVal "35.0"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-2093-1-4 a chart:Point ;
    chart:series ex:series-2093-1 ;
    chart:xVal "2014" ;
    chart:yVal "34.0"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-2093-1-5 a chart:Point ;
    chart:series ex:series-2093-1 ;
    chart:xVal "2016" ;
    chart:yVal "33.0"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-2093-1-6 a chart:Point ;
    chart:series ex:series-2093-1 ;
    chart:xVal "2018" ;
    chart:yVal "32.5"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .
