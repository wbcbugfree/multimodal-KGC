ex:chart-1672 a chart:Chart ;
    chart:chartType "area" ;
    chart:title "Number of internet users in the United States" ;
    chart:subtitle "from 2000 to 2019 (in millions)" ;
    chart:xAxis ex:x-1672 ;
    chart:yAxis ex:y-1672 .

ex:x-1672 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2000" ;
    chart:scaleMax "2019" .

ex:y-1672 a chart:Axis ;
    chart:label "Number of internet users in millions" ;
    chart:scaleMin "0" ;
    chart:scaleMax "350" .

ex:series-1672-1 a chart:Series .

