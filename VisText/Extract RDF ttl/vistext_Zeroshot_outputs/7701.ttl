@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-7701 a chart:Chart ;
    chart:chartType "line" ;
    chart:title "Population of Finland from 2009 to 2019 , by language (in thousands)" ;
    chart:xAxis ex:x-7701 ;
    chart:yAxis ex:y-7701 .

ex:x-7701 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2010" ;
    chart:scaleMax "2018" .

ex:y-7701 a chart:Axis ;
    chart:label "Other" ;
    chart:scaleMin "0" ;
    chart:scaleMax "400" .

ex:series-7701-1 a chart:Series ;
    chart:seriesName "Other" .

ex:point-7701-1-1 a chart:Point ;
    chart:series ex:series-7701-1 ;
    chart:xVal "2010" ;
    chart:yVal "210"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-7701-1-2 a chart:Point ;
    chart:series ex:series-7701-1 ;
    chart:xVal "2011" ;
    chart:yVal "230"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-7701-1-3 a chart:Point ;
    chart:series ex:series-7701-1 ;
    chart:xVal "2012" ;
    chart:yVal "250"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-7701-1-4 a chart:Point ;
    chart:series ex:series-7701-1 ;
    chart:xVal "2013" ;
    chart:yVal "275"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-7701-1-5 a chart:Point ;
    chart:series ex:series-7701-1 ;
    chart:xVal "2014" ;
    chart:yVal "300"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-7701-1-6 a chart:Point ;
    chart:series ex:series-7701-1 ;
    chart:xVal "2015" ;
    chart:yVal "325"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-7701-1-7 a chart:Point ;
    chart:series ex:series-7701-1 ;
    chart:xVal "2016" ;
    chart:yVal "350"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-7701-1-8 a chart:Point ;
    chart:series ex:series-7701-1 ;
    chart:xVal "2017" ;
    chart:yVal "375"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-7701-1-9 a chart:Point ;
