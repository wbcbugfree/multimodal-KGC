ex:chart-5150 a chart:Chart ;
    chart:chartType "line" ;
    chart:title "Guatemala : Unemployment rate from 1999 to 2020" ;
    chart:xAxis ex:x-5150 ;
    chart:yAxis ex:y-5150 .

ex:x-5150 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2000" ;
    chart:scaleMax "2020" .

ex:y-5150 a chart:Axis ;
    chart:label "Unemployment rate" ;
    chart:scaleMin "0.00" ;
    chart:scaleMax "0.04" .

ex:series-5150-1 a chart:Series .

