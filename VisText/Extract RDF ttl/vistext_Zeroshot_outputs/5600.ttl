ex:chart-5600 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Number of Distance Selling/Mail Order pharmacies in England from 2008/09 to 2018/19" ;
    chart:xAxis ex:x-5600 ;
    chart:yAxis ex:y-5600 .

ex:x-5600 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2008-09" ;
    chart:scaleMax "2018-19" .

ex:y-5600 a chart:Axis ;
    chart:label "Number of pharmacies" ;
    chart:scaleMin "0" ;
    chart:scaleMax "350" .

