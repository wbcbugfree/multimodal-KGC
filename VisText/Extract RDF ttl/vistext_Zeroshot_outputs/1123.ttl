ex:chart-1123 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Domestic tourism expenditure in Italy from 2014 to 2029 (in billion euros)" ;
    chart:xAxis ex:x-1123 ;
    chart:yAxis ex:y-1123 .

ex:x-1123 a chart:Axis ;
    chart:label "Domestic spending in billion euros" ;
    chart:scaleMin "0" ;
    chart:scaleMax "200" .

ex:y-1123 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2014" ;
    chart:scaleMax "2029*" .

ex:series-1123-1 a chart:Series .

ex:mark-1123-1-1 a chart:Bar ;
    chart:series ex:series-1123-1 ;
    chart:category "2014" ;
    chart:value "120"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

