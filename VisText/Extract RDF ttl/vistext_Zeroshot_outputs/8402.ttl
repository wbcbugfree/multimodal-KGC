ex:chart-8402 a chart:Chart ;
    chart:chartType "line" ;
    chart:xAxis ex:x-8402 ;
    chart:yAxis ex:y-8402 .

ex:x-8402 a chart:Axis ;
    chart:label "Month" ;
    chart:scaleMin "July" ;
    chart:scaleMax "April" .

ex:y-8402 a chart:Axis ;
    chart:label "Rural" ;
    chart:scaleMin "0" ;
    chart:scaleMax "150" .

ex:series-8402-1 a chart:Series .

ex:point-8402-1-1 a chart:Point ;
    chart:series ex:series-8402-1 ;
    chart:xVal "July" ;
    chart:yVal "147"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-8402-1-2 a chart:Point ;
    chart:series ex:series-8402-1 ;
    chart:xVal "October" ;
    chart:yVal "148"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-8402-1-3 a chart:Point ;
    chart:series ex:series-8402-1 ;
    chart:xVal "2020" ;
    chart:yVal "149"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-8402-1-4 a chart:Point ;
    chart:series ex:series-8402-1 ;
    chart:xVal "April" ;
    chart:yVal "150"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .
