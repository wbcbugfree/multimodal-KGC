ex:chart-4365 a chart:Chart ;
    chart:chartType "line" ;
    chart:title "Average regular season home attendance of the Los Angeles Dodgers from 2009 to 2019" ;
    chart:xAxis ex:x-4365 ;
    chart:yAxis ex:y-4365 .

ex:x-4365 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2009" ;
    chart:scaleMax "2019" .

ex:y-4365 a chart:Axis ;
    chart:label "Average attendance" ;
    chart:scaleMin "0" ;
    chart:scaleMax "50000" .

ex:series-4365-1 a chart:Series .

ex:point-4365-1-1 a chart:Point ;
    chart:series ex:series-4365-1 ;
    chart:xVal "2009" ;
    chart:yVal "50500"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

