ex:chart-6447 a chart:Chart ;
    chart:chartType "area" ;
    chart:xAxis ex:x-6447 ;
    chart:yAxis ex:y-6447 ;
    chart:title "Marital status of the adult population in England and Wales from 2002 to 2019" .

ex:x-6447 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2002" ;
    chart:scaleMax "2019" .

ex:y-6447 a chart:Axis ;
    chart:label "Married" ;
    chart:scaleMin "0" ;
    chart:scaleMax "20000000" .

ex:series-6447-1 a chart:Series ;
    chart:seriesName "Married" .

ex:point-6447-1-1 a chart:Point ;
    chart:series ex:series-6447-1 ;
    chart:xVal "2002" ;
    chart:yVal "18000000"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

