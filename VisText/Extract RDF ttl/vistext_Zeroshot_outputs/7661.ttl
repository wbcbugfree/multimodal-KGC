    chart:series ex:series-7661-1 ;
    chart:category "2013" ;
    chart:value "32000"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:mark-7661-1-5 a chart:Bar ;
    chart:series ex:series-7661-1 ;
    chart:category "2014" ;
    chart:value "45000"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

