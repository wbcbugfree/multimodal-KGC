@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-1208 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Number of registered players in the Korean Basketball League (KBL) in South Korea for the 20/21 season , by team" ;
    chart:xAxis ex:x-1208 ;
    chart:yAxis ex:y-1208 .

ex:x-1208 a chart:Axis ;
    chart:label "basketball team" ;
    chart:scaleMin "" ;
    chart:scaleMax "" .

ex:y-1208 a chart:Axis ;
    chart:label "Number of registered players" ;
    chart:scaleMin "0" ;
    chart:scaleMax "18" .

ex:series-1208-1 a chart:Series .

ex:mark-1208-1-1 a chart:Bar ;
    chart:series ex:series-1208-1 ;
    chart:category "Anyang KGC" ;
    chart:value "15"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

