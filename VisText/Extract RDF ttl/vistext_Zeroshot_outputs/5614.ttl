@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-5614 a chart:Chart ;
    chart:chartType "bar" ;
    chart:xAxis ex:x-5614 ;
    chart:yAxis ex:y-5614 ;
    chart:title "Sales of the leading hair conditioner/creme rinse brands in the United States in 2018" ;
    chart:subtitle "(in million U.S. dollars)" .

ex:x-5614 a chart:Axis ;
    chart:label "Sales in million U.S. dollars" ;
    chart:scaleMin "0" ;
    chart:scaleMax "140" .

ex:y-5614 a chart:Axis ;
    chart:label "Brand" ;
    chart:scaleMin "" ;
    chart:scaleMax "" .

ex:series-5614-1 a chart:Series ;
    chart:seriesName "Sales" .

ex:mark-5614-1-1 a chart:Bar ;
    chart:series ex:series-5614-1 ;
    chart:category "Dove Nutritive Solutions" ;
    chart:value "25"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

