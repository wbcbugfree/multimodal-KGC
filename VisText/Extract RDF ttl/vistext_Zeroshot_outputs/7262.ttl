ex:chart-7262 a chart:Chart ;
    chart:chartType "line" ;
    chart:title "Share of workers paid hourly rates at or below prevailing federal minimum wage in the United States from 1980 to 2019 , by gender" ;
    chart:xAxis ex:x-7262 ;
    chart:yAxis ex:y-7262 .

ex:x-7262 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "1980" ;
    chart:scaleMax "2019" .

ex:y-7262 a chart:Axis ;
    chart:label "Men" ;
    chart:scaleMin "0.00" ;
    chart:scaleMax "0.10" .

ex:series-7262-1 a chart:Series ;
    chart:seriesName "Men" .

