@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-556 a chart:Chart ;
    chart:chartType "area" ;
    chart:title "Worldwide exports of railway track material from 2007 to 2019 (in million metric tons of crude steel production)" ;
    chart:xAxis ex:x-556 ;
    chart:yAxis ex:y-556 .

ex:x-556 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2007" ;
    chart:scaleMax "2019" .

ex:y-556 a chart:Axis ;
    chart:label "Exports in million metric tons" ;
    chart:scaleMin "0.0" ;
    chart:scaleMax "3.5" .

ex:series-556-1 a chart:Series .

ex:point-556-1-1 a chart:Point ;
    chart:series ex:series-556-1 ;
    chart:xVal "2007" ;
    chart:yVal "3.2"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-556-1-2 a chart:Point ;
    chart:series ex:series-556-1 ;
    chart:xVal "2008" ;
    chart:yVal "2.9"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

