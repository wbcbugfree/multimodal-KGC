@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-4682 a chart:Chart ;
    chart:chartType "line" ;
    chart:title "Monthly Federal funds effective rate in the United States from January 2000 to December 2020" ;
    chart:xAxis ex:x-4682 ;
    chart:yAxis ex:y-4682 .

ex:x-4682 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2000" ;
    chart:scaleMax "2020" .

ex:y-4682 a chart:Axis ;
    chart:label "Effective rate" ;
    chart:scaleMin "0.00" ;
    chart:scaleMax "0.07" .

ex:series-4682-1 a chart:Series .

ex:point-4682-1-1 a chart:Point ;
    chart:series ex:series-4682-1 ;
    chart:xVal "2000" ;
    chart:yVal "0.065"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

