@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-8384 a chart:Chart ;
    chart:chartType "bar" ;
    chart:xAxis ex:x-8384 ;
    chart:yAxis ex:y-8384 ;
    chart:title "Per capita consumption of wine and sparkling wine in Germany from 2008 to 2019 (in liters)" .

ex:x-8384 a chart:Axis ;
    chart:label "Sparkling wine" ;
    chart:scaleMin "0" ;
    chart:scaleMax "10" .

ex:y-8384 a chart:Axis ;
    chart:label "Wine" ;
    chart:scaleMin "20.1" ;
    chart:scaleMax "21.1" .

ex:series-8384-1 a chart:Series ;
    chart:seriesName "Sparkling wine" .

ex:mark-8384-1-1 a chart:Bar ;
    chart:series ex:series-8384-1 ;
    chart:category "20.1" ;
    chart:value "7.5"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:mark-8384-1-2 a chart:Bar ;
    chart:series ex:series-8384-1 ;
    chart:category "20.5" ;
    chart:value "7.8"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:mark-8384-1-3 a chart:Bar ;
    chart:series ex:series-8384-1 ;
    chart:category "20.6" ;
    chart:value "3.8"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:mark-8384-1-4 a chart:Bar ;
    chart:series ex:series-8384-1 ;
    chart:category "20.7" ;
    chart:value "7.8"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:mark-8384-1-5 a chart:Bar ;
    chart:series ex:series-8384-1 ;
    chart:category "20.8" ;
    chart:value "4.0"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:mark-8384-1-6 a chart:Bar ;
    chart:series ex:series-8384-1 ;
    chart:category "20.9" ;
    chart:value "3.8"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:mark-8384-1-7 a chart:Bar ;
    chart:series ex:series-8384-1 ;
    chart:category "21.1" ;
    chart:value "7.8"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .
