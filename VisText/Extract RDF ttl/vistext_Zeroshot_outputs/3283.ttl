@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-3283 a chart:Chart ;
    chart:chartType "area" ;
    chart:title "Registered number of armed robberies in\nBelgium from 2008 to 2019" ;
    chart:xAxis ex:x-3283 ;
    chart:yAxis ex:y-3283 .

ex:x-3283 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2008" ;
    chart:scaleMax "2018" .

ex:y-3283 a chart:Axis ;
    chart:label "Number of armed robberies" ;
    chart:scaleMin "0" ;
    chart:scaleMax "6000" .

ex:series-3283-1 a chart:Series .

ex:point-3283-1-1 a chart:Point ;
    chart:series ex:series-3283-1 ;
    chart:xVal "2008" ;
    chart:yVal "5700"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

