@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-7222 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Number of LTE subscriptions worldwide from 2012 to 2024 , by region (in millions)" ;
    chart:xAxis ex:x-7222 ;
    chart:yAxis ex:y-7222 .

ex:x-7222 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "" ;
    chart:scaleMax "" .

ex:y-7222 a chart:Axis ;
    chart:label "Asia Pacific" ;
    chart:scaleMin "0" ;
    chart:scaleMax "3500" .

ex:series-7222-1 a chart:Series .

ex:mark-7222-1-1 a chart:Bar ;
    chart:series ex:series-7222-1 ;
    chart:category "2012" ;
    chart:value "0"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

