@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-7209 a chart:Chart ;
    chart:chartType "area" ;
    chart:title "Number of governors in the U.S. by political party affiliation from 1990 to 2019" ;
    chart:xAxis ex:x-7209 ;
    chart:yAxis ex:y-7209 .

ex:x-7209 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "1990" ;
    chart:scaleMax "2019" .

ex:y-7209 a chart:Axis ;
    chart:label "Republican" ;
    chart:scaleMin "0" ;
    chart:scaleMax "35" .

ex:series-7209-1 a chart:Series .

ex:point-7209-1-1 a chart:Point ;
    chart:series ex:series-7209-1 ;
    chart:xVal "1990" ;
    chart:yVal "21"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

