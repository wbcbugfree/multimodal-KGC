@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-759 a chart:Chart ;
    chart:chartType "line" ;
    chart:title "Carbon dioxide (CO2) emissions in India" ;
    chart:subtitle "from 2001 to 2016 (in metric tons per capita)" ;
    chart:xAxis ex:x-759 ;
    chart:yAxis ex:y-759 .

ex:x-759 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "" ;
    chart:scaleMax "" .

ex:y-759 a chart:Axis ;
    chart:label "CO2 emissions in metric tons per capita" ;
    chart:scaleMin "0.0" ;
    chart:scaleMax "2.0" .

ex:series-759-1 a chart:Series .

ex:point-759-1-1 a chart:Point ;
    chart:series ex:series-759-1 ;
    chart:xVal "2001" ;
    chart:yVal "1.1"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-759-1-2 a chart:Point ;
    chart:series ex:series-759-1 ;
    chart:xVal "2002" ;
    chart:yVal "1.1"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

