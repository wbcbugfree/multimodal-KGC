@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-2974 a chart:Chart ;
    chart:chartType "line" ;
    chart:xAxis ex:x-2974 ;
    chart:yAxis ex:y-2974 ;
    chart:title "Number of fixed broadband subscriptions per 100 inhabitants in Mexico from 2000 to 2019" .

ex:x-2974 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2000" ;
    chart:scaleMax "2019" .

ex:y-2974 a chart:Axis ;
    chart:label "Number of subscriptions per 100 inhabitants" ;
    chart:scaleMin "0" ;
    chart:scaleMax "15" .

ex:series-2974-1 a chart:Series .

ex:point-2974-1-1 a chart:Point ;
    chart:series ex:series-2974-1 ;
    chart:xVal "2000" ;
    chart:yVal "0.2"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

