ex:chart-64 a chart:Chart ;
    chart:chartType "area" ;
    chart:xAxis ex:x-64 ;
    chart:yAxis ex:y-64 .

ex:x-64 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2010" ;
    chart:scaleMax "2020" .

ex:y-64 a chart:Axis ;
    chart:label "Price in U.S. dollars per metric ton" ;
    chart:scaleMin "0" ;
    chart:scaleMax "200000" .

ex:series-64-1 a chart:Series .

ex:point-64-1-1 a chart:Point ;
    chart:series ex:series-64-1 ;
    chart:xVal "2010" ;
    chart:yVal "10000"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-64-1-2 a chart:Point ;
    chart:series ex:series-64-1 ;
    chart:xVal "2011" ;
    chart:yVal "250000"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-64-1-3 a chart:Point ;
    chart:series ex:series-64-1 ;
    chart:xVal "2013" ;
    chart:yVal "50000"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-64-1-4 a chart:Point ;
    chart:series ex:series-64-1 ;
    chart:xVal "2015" ;
    chart:yVal "30000"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-64-1-5 a chart:Point ;
    chart:series ex:series-64-1 ;
    chart:xVal "2017" ;
    chart:yVal "50000"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-64-1-6 a chart:Point ;
    chart:series ex:series-64-1 ;
    chart:xVal "2018" ;
    chart:yVal "45000"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-64-1-7 a chart:Point ;
