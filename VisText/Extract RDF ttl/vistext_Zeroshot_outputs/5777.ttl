@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-5777 a chart:Chart ;
    chart:chartType "line" ;
    chart:xAxis ex:x-5777 ;
    chart:yAxis ex:y-5777 ;
    chart:title "Median household income in Minnesota from 1990 to 2019 (in current U.S. dollars)" .

ex:x-5777 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "1990" ;
    chart:scaleMax "2019" .

ex:y-5777 a chart:Axis ;
    chart:label "Household income in current U.S. dollars" ;
    chart:scaleMin "0" ;
    chart:scaleMax "80000" .

ex:series-5777-1 a chart:Series .

ex:point-5777-1-1 a chart:Point ;
    chart:series ex:series-5777-1 ;
    chart:xVal "1990" ;
    chart:yVal "30000"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

