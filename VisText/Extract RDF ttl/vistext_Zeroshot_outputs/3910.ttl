ex:chart-3910 a chart:Chart ;
    chart:chartType "area" ;
    chart:title "Population of the Riverside-San Bernardino-Ontario metro area in the United States from 2010 to 2019" ;
    chart:xAxis ex:x-3910 ;
    chart:yAxis ex:y-3910 .

ex:x-3910 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2010" ;
    chart:scaleMax "2019" .

ex:y-3910 a chart:Axis ;
    chart:label "Number of residents" ;
    chart:scaleMin "0" ;
    chart:scaleMax "5,000,000" .

ex:series-3910-1 a chart:Series .

ex:point-3910-1-1 a chart:Point ;
    chart:series ex:series-3910-1 ;
    chart:xVal "2010" ;
    chart:yVal "4,300,000"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-3910-1-2 a chart:Point ;
    chart:series ex:series-3910-1 ;
    chart:xVal "2012" ;
    chart:yVal "4,400,000"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-3910-1-3 a chart:Point ;
    chart:series ex:series-3910-1 ;
    chart:xVal "2014" ;
    chart:yVal "4,500,000"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-3910-1-4 a chart:Point ;
    chart:series ex:series-3910-1 ;
    chart:xVal "2016" ;
    chart:yVal "4,600,000"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-3910-1-5 a chart:Point ;
    chart:series ex:series-3910-1 ;
    chart:xVal "2018" ;
    chart:yVal "4,700,000"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-3910-1-6 a chart:Point ;
    chart:series ex:series-3910-1 ;
    chart:xVal "2019" ;
    chart:yVal "4,750,000"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .
