ex:chart-5152 a chart:Chart ;
    chart:chartType "area" ;
    chart:title "Annual performance of CAC 40 index as of year-end value from 1995 to 2019" ;
    chart:xAxis ex:x-5152 ;
    chart:yAxis ex:y-5152 .

ex:x-5152 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "1995" ;
    chart:scaleMax "2015" .

ex:y-5152 a chart:Axis ;
    chart:label "Index points" ;
    chart:scaleMin "0" ;
    chart:scaleMax "6,000" .

ex:series-5152-1 a chart:Series .

ex:point-5152-1-1 a chart:Point ;
    chart:series ex:series-5152-1 ;
    chart:xVal "1995" ;
    chart:yVal "1000"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-5152-1-2 a chart:Point ;
    chart:series ex:series-5152-1 ;
    chart:xVal "2000" ;
    chart:yVal "5500"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-5152-1-3 a chart:Point ;
    chart:series ex:series-5152-1 ;
    chart:xVal "2005" ;
    chart:yVal "5000"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-5152-1-4 a chart:Point ;
    chart:series ex:series-5152-1 ;
    chart:xVal "2010" ;
    chart:yVal "4500"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-5152-1-5 a chart:Point ;
    chart:series ex:series-5152-1 ;
    chart:xVal "2015" ;
    chart:yVal "5000"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-5152-1-6 a chart:Point ;
    chart:series ex:series-5152-1 ;
    chart:xVal "2019" ;
    chart:yVal "5800"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .
