@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-4808 a chart:Chart ;
    chart:chartType "area" ;
    chart:title "Number of road traffic fatalities in Iceland" ;
    chart:subtitle "from 2006 to 2019" ;
    chart:xAxis ex:x-4808 ;
    chart:yAxis ex:y-4808 .

ex:x-4808 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2006" ;
    chart:scaleMax "2019" .

ex:y-4808 a chart:Axis ;
    chart:label "Number of fatalities" ;
    chart:scaleMin "0" ;
    chart:scaleMax "35" .

ex:series-4808-1 a chart:Series .

ex:point-4808-1-1 a chart:Point ;
    chart:series ex:series-4808-1 ;
    chart:xVal "2006" ;
    chart:yVal 30.0 ;
    chart:valueEstimated "false"^^xsd:boolean .

ex:point-4808-1-2 a chart:Point ;
    chart:series ex:series-4808-1 ;
    chart:xVal "2007" ;
    chart:yVal 15.0 ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-4808-1-3 a chart:Point ;
    chart:series ex:series-4808-1 ;
    chart:xVal "2008" ;
    chart:yVal 12.0 ;
    chart:valueEstimated "true"^^xsd:boolean .

