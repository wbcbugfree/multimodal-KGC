@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-3136 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Quarterly percent change in nonfarm business sector real hourly compensation in the United States from 2017 to 2020" ;
    chart:xAxis ex:x-3136 ;
    chart:yAxis ex:y-3136 .

ex:x-3136 a chart:Axis ;
    chart:label "Percent change from preceding quarter" ;
    chart:scaleMin "-0.10" ;
    chart:scaleMax "0.25" .

ex:y-3136 a chart:Axis ;
    chart:label "Quarter" ;
    chart:scaleMin "" ;
    chart:scaleMax "" .

ex:series-3136-1 a chart:Series .

ex:mark-3136-1-1 a chart:Bar ;
    chart:series ex:series-3136-1 ;
    chart:category "Q1 '17" ;
    chart:value "0.00"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

