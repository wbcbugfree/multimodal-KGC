ex:chart-3752 a chart:Chart ;
    chart:chartType "line" ;
    chart:xAxis ex:x-3752 ;
    chart:yAxis ex:y-3752 ;
    chart:title "Consumer price index (CPI) of actual rentals for housing in South Africa from March 2019 to March 2020" .

ex:x-3752 a chart:Axis ;
    chart:label "Month" ;
    chart:scaleMin "April" ;
    chart:scaleMax "2020" .

ex:y-3752 a chart:Axis ;
    chart:label "Consumer price index (Dec 2016 = 100)" ;
    chart:scaleMin "0" ;
    chart:scaleMax "120" .

ex:series-3752-1 a chart:Series .

ex:point-3752-1-1 a chart:Point ;
    chart:series ex:series-3752-1 ;
    chart:xVal "April" ;
    chart:yVal "112.0"^^xsd:decimal ;
    chart:valueEstimated "false"^^xsd:boolean .

ex:point-3752-1-2 a chart:Point ;
    chart:series ex:series-3752-1 ;
    chart:xVal "July" ;
    chart:yVal "112.5"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-3752-1-3 a chart:Point ;
    chart:series ex:series-3752-1 ;
    chart:xVal "October" ;
    chart:yVal "113.0"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-3752-1-4 a chart:Point ;
    chart:series ex:series-3752-1 ;
    chart:xVal "2020" ;
    chart:yVal "113.5"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .
