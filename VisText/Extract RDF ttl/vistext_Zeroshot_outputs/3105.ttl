@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-3105 a chart:Chart ;
    chart:chartType "bar" ;
    chart:xAxis ex:x-3105 ;
    chart:yAxis ex:y-3105 ;
    chart:title "Largest export commodities of the United Kingdom (UK) in 2019 (in billion GBP)" .

ex:x-3105 a chart:Axis ;
    chart:label "Value of exports in billion GBP" ;
    chart:scaleMin "0" ;
    chart:scaleMax "150" .

ex:y-3105 a chart:Axis ;
    chart:label "Export commodity" ;
    chart:scaleMin "" ;
    chart:scaleMax "" .

ex:series-3105-1 a chart:Series .

ex:mark-3105-1-1 a chart:Bar ;
    chart:series ex:series-3105-1 ;
    chart:category "Animal, vegetable oils and fats" ;
    chart:value "1.0"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:mark-3105-1-2 a chart:Bar ;
    chart:series ex:series-3105-1 ;
    chart:category "Beverages and tobacco" ;
    chart:value "2.0"^^xsd:decimal ;
