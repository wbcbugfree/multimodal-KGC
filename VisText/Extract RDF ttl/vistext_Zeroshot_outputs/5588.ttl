@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-5588 a chart:Chart ;
    chart:chartType "area" ;
    chart:title "Total contribution of travel and tourism to the GDP in Southeast Asia from 2010 to 2019 (in billion U.S. dollars)" ;
    chart:xAxis ex:x-5588 ;
    chart:yAxis ex:y-5588 .

ex:x-5588 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2010" ;
    chart:scaleMax "2019" .

ex:y-5588 a chart:Axis ;
    chart:label "GDP contribution in billion U.S. dollars" ;
    chart:scaleMin "0" ;
    chart:scaleMax "400" .

ex:series-5588-1 a chart:Series .

ex:point-5588-1-1 a chart:Point ;
    chart:series ex:series-5588-1 ;
    chart:xVal "2010" ;
    chart:yVal "200"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-5588-1-2 a chart:Point ;
    chart:series ex:series-5588-1 ;
    chart:xVal "2011" ;
    chart:yVal "220"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

