@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-1460 a chart:Chart ;
    chart:chartType "area" ;
    chart:title "Real Gross Domestic Product (GDP) of the federal state of Oklahoma from 2000 to 2019 (in billion U.S. dollars)" ;
    chart:xAxis ex:x-1460 ;
    chart:yAxis ex:y-1460 .

ex:x-1460 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2000" ;
    chart:scaleMax "2019" .

ex:y-1460 a chart:Axis ;
    chart:label "Real GDP in billion U.S. dollars" ;
    chart:scaleMin "0" ;
    chart:scaleMax "200" .

ex:series-1460-1 a chart:Series .

ex:point-1460-1-1 a chart:Point ;
    chart:series ex:series-1460-1 ;
    chart:xVal "2000" ;
    chart:yVal "125"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-1460-1-2 a chart:Point ;
    chart:series ex:series-1460-1 ;
    chart:xVal "2002" ;
    chart:yVal "135"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

