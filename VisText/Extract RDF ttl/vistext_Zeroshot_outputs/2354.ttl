@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-2354 a chart:Chart ;
    chart:chartType "area" ;
    chart:title "Consumer price index (CPI) of fruit juice and vegetable juice monthly in the Netherlands from January 2018 to May 2020" ;
    chart:subtitle "Consumer price index (2015 = 100)" ;
    chart:xAxis ex:x-2354 ;
    chart:yAxis ex:y-2354 .

ex:x-2354 a chart:Axis ;
    chart:label "Month" ;
    chart:scaleMin "2018" ;
    chart:scaleMax "2020" .

ex:y-2354 a chart:Axis ;
    chart:label "" ;
    chart:scaleMin "0" ;
    chart:scaleMax "120" .

ex:series-2354-1 a chart:Series ;
    chart:seriesName "Consumer price index" .

ex:point-2354-1-1 a chart:Point ;
    chart:series ex:series-2354-1 ;
    chart:xVal "2018-01" ;
    chart:yVal "107.0"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

