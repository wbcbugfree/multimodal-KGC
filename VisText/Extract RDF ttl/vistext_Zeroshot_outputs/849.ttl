    chart:yAxis ex:y-849 .

ex:x-849 a chart:Axis ;
    chart:label "Player Name" ;
    chart:scaleMin "" ;
    chart:scaleMax "" .

ex:y-849 a chart:Axis ;
    chart:label "Number of home runs" ;
    chart:scaleMin "0" ;
    chart:scaleMax "250" .

ex:series-849-1 a chart:Series .

