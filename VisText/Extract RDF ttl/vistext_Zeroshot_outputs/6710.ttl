@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-6710 a chart:Chart ;
    chart:chartType "bar" ;
    chart:xAxis ex:x-6710 ;
    chart:yAxis ex:y-6710 ;
    chart:title "Average retail price for peanut butter in Canada from January 2015 to June 2020 (in Canadian dollars per 500 grams)" .

ex:x-6710 a chart:Axis ;
    chart:label "Month" ;
    chart:scaleMin "Apr" ;
    chart:scaleMax "Sep" .

ex:y-6710 a chart:Axis ;
    chart:label "2017" ;
    chart:scaleMin "0.0" ;
    chart:scaleMax "3.5" .

ex:series-6710-1 a chart:Series .

ex:mark-6710-1-1 a chart:Bar ;
    chart:series ex:series-6710-1 ;
    chart:category "Apr" ;
    chart:value "3.4"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

