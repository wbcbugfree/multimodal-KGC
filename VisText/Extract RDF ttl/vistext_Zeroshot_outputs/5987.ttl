@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-5987 a chart:Chart ;
    chart:chartType "area" ;
    chart:title "Consumer spending on food and non-alcoholic drinks in the United Kingdom from 2005 to 2019 (in million GBP)" ;
    chart:xAxis ex:x-5987 ;
    chart:yAxis ex:y-5987 .

ex:x-5987 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2006" ;
    chart:scaleMax "2018" .

ex:y-5987 a chart:Axis ;
    chart:label "Expenditure in million GBP" ;
    chart:scaleMin "0" ;
    chart:scaleMax "100,000" .

ex:series-5987-1 a chart:Series .

ex:point-5987-1-1 a chart:Point ;
    chart:series ex:series-5987-1 ;
    chart:xVal "2006" ;
    chart:yVal "66000"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

