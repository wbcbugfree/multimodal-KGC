ex:chart-298 a chart:Chart ;
    chart:chartType "line" ;
    chart:title "Hungary : Infant mortality rate from 2009 to 2019 (in deaths per 1,000 live births)" ;
    chart:xAxis ex:x-298 ;
    chart:yAxis ex:y-298 .

ex:x-298 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2009" ;
    chart:scaleMax "2019" .

ex:y-298 a chart:Axis ;
    chart:label "Deaths per 1,000 live births" ;
    chart:scaleMin "0" ;
    chart:scaleMax "5.5" .

ex:series-298-1 a chart:Series ;
    chart:seriesName "Infant mortality rate" .

ex:point-298-1-1 a chart:Point ;
    chart:series ex:series-298-1 ;
    chart:xVal "2009" ;
    chart:yVal 5.2 ;
    chart:valueEstimated "false"^^xsd:boolean .

ex:point-298-1-2 a chart:Point ;
    chart:series ex:series-298-1 ;
    chart:xVal "2010" ;
    chart:yVal 5.1 ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-298-1-3 a chart:Point ;
    chart:series ex:series-298-1 ;
    chart:xVal "2011" ;
    chart:yVal 4.9 ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-298-1-4 a chart:Point ;
    chart:series ex:series-298-1 ;
    chart:xVal "2012" ;
    chart:yVal 4.8 ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-298-1-5 a chart:Point ;
    chart:series ex:series-298-1 ;
    chart:xVal "2013" ;
    chart:yVal 4.6 ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-298-1-6 a chart:Point ;
    chart:series ex:series-298-1 ;
    chart:xVal "2014" ;
    chart:yVal 4.4 ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-298-1-7 a chart:Point ;
    chart:series ex:series-298-1 ;
    chart:xVal "2015" ;
    chart:yVal 4.2 ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-298-1-8 a chart:Point ;
    chart:series ex:series-298-1 ;
    chart:xVal "2016" ;
    chart:yVal 4.0 ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-298-1-9 a chart:Point ;
    chart:series ex:series-298-1 ;
    chart:xVal "2017" ;
    chart:yVal 3.5 ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-298-1-10 a chart:Point ;
    chart:series ex:series-298-1 ;
    chart:xVal "2018" ;
    chart:yVal 3.1 ;
    chart:valueEstimated "true"^^xsd:boolean .

ex:point-298-1-11 a chart:Point ;
    chart:series ex:series-298-1 ;
    chart:xVal "2019" ;
    chart:yVal 3.0 ;
    chart:valueEstimated "true"^^xsd:boolean .
