ex:chart-3957 a chart:Chart ;
    chart:chartType "line" ;
    chart:title "Total number of farms in Denmark from 2010" ;
    chart:subtitle "to 2019" ;
    chart:xAxis ex:x-3957 ;
    chart:yAxis ex:y-3957 .

ex:x-3957 a chart:Axis ;
    chart:label "Year" ;
    chart:scaleMin "2010" ;
    chart:scaleMax "2018" .

ex:y-3957 a chart:Axis ;
    chart:label "Number of farms" ;
    chart:scaleMin "0" ;
    chart:scaleMax "40,000" .

ex:series-3957-1 a chart:Series ;
    chart:seriesName "Number of farms" .

ex:point-3957-1-1 a chart:Point ;
    chart:series ex:series-3957-1 ;
    chart:xVal "2010" ;
    chart:yVal "42000"^^xsd:decimal ;
    chart:valueEstimated "true"^^xsd:boolean .

