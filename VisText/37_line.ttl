@prefix :    <http://example.org/chart-data> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

:chart-37 a chart:Chart ;
    chart:chartType "line" ;
    chart:title "Real value of U.S. fossil fuel imports from 1960 to 2011 (in billion U.S. dollars)" ;
    chart:xAxis :x-37 ;
    chart:yAxis :y-37 .

:x-37 a chart:Axis ;
    chart:label "Year" .

:y-37 a chart:Axis ;
    chart:label "Real value in billion U.S. dollars" .

:DataPoint1 a chart:DataPoint ;
    chart:xValue "Dec 31, 1959" ;
    chart:yValue "8.91" ;
    chart:belongsTo :chart-37 .

