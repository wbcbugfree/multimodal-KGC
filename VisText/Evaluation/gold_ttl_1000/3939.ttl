@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-3939 a chart:Chart ;
    chart:chartType "line" ;
    chart:title "Combined desktop and mobile visits to Walmart.com from May 2019 to September 2020 (in millions)" ;
    chart:xAxis ex:x-3939 ;
    chart:yAxis ex:y-3939 .

ex:x-3939 a chart:Axis ;
    chart:label "Year" .

ex:y-3939 a chart:Axis ;
    chart:label "" .

ex:series-3939-1 a chart:Series .

ex:mark-3939-1-1 a chart:DataPoint ;
    chart:series ex:series-3939-1 ;
    chart:category "Number of visits in millions Apr" ;
    chart:value "30"^^xsd:decimal .

