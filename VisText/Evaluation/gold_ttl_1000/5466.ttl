@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-5466 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Number of mobile internet users in the United Kingdom (UK) from third quarter 2013 to second quarter 2016 (in million users)" ;
    chart:xAxis ex:x-5466 ;
    chart:yAxis ex:y-5466 .

ex:x-5466 a chart:Axis ;
    chart:label "Quarter" .

ex:y-5466 a chart:Axis ;
    chart:label "" .

ex:series-5466-1 a chart:Series .

ex:mark-5466-1-1 a chart:DataPoint ;
    chart:series ex:series-5466-1 ;
    chart:category "Users in millions Q2 2016*" ;
    chart:value "42.77"^^xsd:decimal .

