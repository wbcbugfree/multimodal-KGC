@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-4517 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Most popular leisure activities among Baby Boomers in the United States as of September 2013" ;
    chart:xAxis ex:x-4517 ;
    chart:yAxis ex:y-4517 .

ex:x-4517 a chart:Axis ;
    chart:label "Response" .

ex:y-4517 a chart:Axis ;
    chart:label "" .

ex:series-4517-1 a chart:Series .

ex:mark-4517-1-1 a chart:DataPoint ;
    chart:series ex:series-4517-1 ;
    chart:category "Share of respondents Watch TV" ;
    chart:value "0.42"^^xsd:decimal .

ex:mark-4517-1-2 a chart:DataPoint ;
    chart:series ex:series-4517-1 ;
    chart:category "Reading" ;
    chart:value "0.4"^^xsd:decimal .

ex:mark-4517-1-3 a chart:DataPoint ;
    chart:series ex:series-4517-1 ;
    chart:category "Computer/internet" ;
    chart:value "0.21"^^xsd:decimal .

ex:mark-4517-1-4 a chart:DataPoint ;
    chart:series ex:series-4517-1 ;
    chart:category "Spending time with family and friends" ;
    chart:value "0.17"^^xsd:decimal .

ex:mark-4517-1-5 a chart:DataPoint ;
    chart:series ex:series-4517-1 ;
    chart:category "Walking/running/jogging" ;
    chart:value "0.11"^^xsd:decimal .

ex:mark-4517-1-6 a chart:DataPoint ;
    chart:series ex:series-4517-1 ;
    chart:category "Gardening" ;
    chart:value "0.11"^^xsd:decimal .

ex:mark-4517-1-7 a chart:DataPoint ;
    chart:series ex:series-4517-1 ;
    chart:category "Watching/going to the movies" ;
    chart:value "0.1"^^xsd:decimal .

ex:mark-4517-1-8 a chart:DataPoint ;
    chart:series ex:series-4517-1 ;
    chart:category "Playing video games and computer/internet games" ;
    chart:value "0.08"^^xsd:decimal .

ex:mark-4517-1-9 a chart:DataPoint ;
    chart:series ex:series-4517-1 ;
    chart:category "Exercise/working out" ;
    chart:value "0.07"^^xsd:decimal .

ex:mark-4517-1-10 a chart:DataPoint ;
    chart:series ex:series-4517-1 ;
    chart:category "Concerts/listening to/playing music" ;
    chart:value "0.07"^^xsd:decimal .
