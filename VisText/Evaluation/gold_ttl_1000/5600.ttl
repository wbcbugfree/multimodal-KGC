@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-5600 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Number of Distance Selling/Mail Order pharmacies in England from 2008/09 to 2018/19" ;
    chart:xAxis ex:x-5600 ;
    chart:yAxis ex:y-5600 .

ex:x-5600 a chart:Axis ;
    chart:label "Year" .

ex:y-5600 a chart:Axis ;
    chart:label "Number of pharmacies" .

ex:series-5600-1 a chart:Series .

ex:mark-5600-1-1 a chart:DataPoint ;
    chart:series ex:series-5600-1 ;
    chart:category "2018-19" ;
    chart:value "349"^^xsd:decimal .

