@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-1415 a chart:Chart ;
    chart:chartType "area" ;
    chart:title "Number of deaths in the United Kingdom (UK) from 2000 to 2018 (in 1,000s)" ;
    chart:xAxis ex:x-1415 ;
    chart:yAxis ex:y-1415 .

ex:x-1415 a chart:Axis ;
    chart:label "Year with linear scale with a minimum of 2000 and a maximum of 2015 while the y-axis shows Number of deaths (in 1,000s) with linear scale with a minimum of 0 and a maximum of 600" .

ex:y-1415 a chart:Axis ;
    chart:label "Number of deaths (in 1,000s)" .

ex:series-1415-1 a chart:Series .

ex:mark-1415-1-1 a chart:DataPoint ;
    chart:series ex:series-1415-1 ;
    chart:category "Dec" ;
    chart:value "31"^^xsd:decimal .

