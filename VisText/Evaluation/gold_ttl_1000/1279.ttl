@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-1279 a chart:Chart ;
    chart:chartType "line" ;
    chart:title "Canada : Birth rate from 2008 to 2018 (per 1,000 inhabitants)" ;
    chart:xAxis ex:x-1279 ;
    chart:yAxis ex:y-1279 .

ex:x-1279 a chart:Axis ;
    chart:label "Year" .

ex:y-1279 a chart:Axis ;
    chart:label "Birth rate per thousand population while the x-axis measures Year" .

ex:series-1279-1 a chart:Series .

ex:mark-1279-1-1 a chart:DataPoint ;
    chart:series ex:series-1279-1 ;
    chart:category "Birth rate per thousand population Dec" ;
    chart:value "31"^^xsd:decimal .

