@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-1769 a chart:Chart ;
    chart:chartType "line" ;
    chart:title "Turkey : Fertility rate from 2008 to 2018" ;
    chart:xAxis ex:x-1769 ;
    chart:yAxis ex:y-1769 .

ex:x-1769 a chart:Axis ;
    chart:label "Year" .

ex:y-1769 a chart:Axis ;
    chart:label "" .

ex:series-1769-1 a chart:Series .

ex:mark-1769-1-1 a chart:DataPoint ;
    chart:series ex:series-1769-1 ;
    chart:category "Children born per woman Dec" ;
    chart:value "31"^^xsd:decimal .

