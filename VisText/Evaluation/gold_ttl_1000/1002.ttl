@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-1002 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "How much influence , if any , does society have on your future happiness ?" ;
    chart:xAxis ex:x-1002 ;
    chart:yAxis ex:y-1002 .

ex:x-1002 a chart:Axis ;
    chart:label "Share" .

ex:y-1002 a chart:Axis ;
    chart:label "" .

ex:series-1002-1 a chart:Series .

ex:mark-1002-1-1 a chart:DataPoint ;
    chart:series ex:series-1002-1 ;
    chart:category "of respondents Response" ;
    chart:value "0.02"^^xsd:decimal .

ex:mark-1002-1-2 a chart:DataPoint ;
    chart:series ex:series-1002-1 ;
    chart:category "- Not influential at all" ;
    chart:value "0.02"^^xsd:decimal .
