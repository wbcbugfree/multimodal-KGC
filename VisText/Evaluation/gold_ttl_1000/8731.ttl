@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-8731 a chart:Chart ;
    chart:chartType "area" ;
    chart:title "Zambia : Share of economic sectors in the gross domestic product (GDP) from 2009 to 2019" ;
    chart:xAxis ex:x-8731 ;
    chart:yAxis ex:y-8731 .

ex:x-8731 a chart:Axis ;
    chart:label "Year with linear scale of range 2010 to 2018 while the y-axis plots Services" .

ex:y-8731 a chart:Axis ;
    chart:label "" .

ex:series-8731-1 a chart:Series .

ex:mark-8731-1-1 a chart:DataPoint ;
    chart:series ex:series-8731-1 ;
    chart:category "Services Dec" ;
    chart:value "31"^^xsd:decimal .

