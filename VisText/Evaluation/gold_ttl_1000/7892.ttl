    chart:series ex:series-7892-1 ;
    chart:category "2022*" ;
    chart:value "3.03"^^xsd:decimal .

ex:mark-7892-1-5 a chart:DataPoint ;
    chart:series ex:series-7892-1 ;
    chart:category "2021*" ;
    chart:value "2.7"^^xsd:decimal .

ex:mark-7892-1-6 a chart:DataPoint ;
