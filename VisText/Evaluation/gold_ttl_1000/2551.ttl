@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-2551 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Leading brands for best customer experience online , ranked by consumers in the United Kingdom (UK) in 2014" ;
    chart:xAxis ex:x-2551 ;
    chart:yAxis ex:y-2551 .

ex:x-2551 a chart:Axis ;
    chart:label "Response" .

ex:y-2551 a chart:Axis ;
    chart:label "" .

ex:series-2551-1 a chart:Series .

ex:mark-2551-1-1 a chart:DataPoint ;
    chart:series ex:series-2551-1 ;
    chart:category "Share of respondents Amazon (.co.uk)" ;
    chart:value "0.759"^^xsd:decimal .

