@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-3841 a chart:Chart ;
    chart:chartType "line" ;
    chart:title "Median total family income in Nunavut from 2000 to 2018 (in Canadian dollars)" ;
    chart:xAxis ex:x-3841 ;
    chart:yAxis ex:y-3841 .

ex:x-3841 a chart:Axis ;
    chart:label "Year" .

ex:y-3841 a chart:Axis ;
    chart:label "Income in Canadian dollars" .

ex:series-3841-1 a chart:Series .

ex:mark-3841-1-1 a chart:DataPoint ;
    chart:series ex:series-3841-1 ;
    chart:category "Dec" ;
    chart:value "31"^^xsd:decimal .

