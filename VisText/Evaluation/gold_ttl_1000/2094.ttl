@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-2094 a chart:Chart ;
    chart:chartType "line" ;
    chart:title "Number of direct deaths from eating disorders in the U.S. from 1990 to 2017" ;
    chart:xAxis ex:x-2094 ;
    chart:yAxis ex:y-2094 .

ex:x-2094 a chart:Axis ;
    chart:label "Year" .

ex:y-2094 a chart:Axis ;
    chart:label "" .

ex:series-2094-1 a chart:Series .

ex:mark-2094-1-1 a chart:DataPoint ;
    chart:series ex:series-2094-1 ;
    chart:category "Number of deaths Dec" ;
    chart:value "31"^^xsd:decimal .

