@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-3438 a chart:Chart ;
    chart:chartType "area" ;
    chart:title "Infant mortality rate (under one year old) in Portugal from 1910 to 2020" ;
    chart:xAxis ex:x-3438 ;
    chart:yAxis ex:y-3438 .

ex:x-3438 a chart:Axis ;
    chart:label "Year" .

ex:y-3438 a chart:Axis ;
    chart:label "" .

ex:series-3438-1 a chart:Series .

ex:mark-3438-1-1 a chart:DataPoint ;
    chart:series ex:series-3438-1 ;
    chart:category "Deaths per" ;
    chart:value "1000"^^xsd:decimal .

