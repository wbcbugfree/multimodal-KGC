@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-5614 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Sales of the leading hair conditioner/creme rinse brands in the United States in 2018 (in million U.S. dollars)" ;
    chart:xAxis ex:x-5614 ;
    chart:yAxis ex:y-5614 .

ex:x-5614 a chart:Axis ;
    chart:label "Sales in million U" .

ex:y-5614 a chart:Axis ;
    chart:label "Brand while the x-axis shows Sales in million U" .

ex:series-5614-1 a chart:Series .

ex:mark-5614-1-1 a chart:DataPoint ;
