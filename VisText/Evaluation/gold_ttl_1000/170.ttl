@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-170 a chart:Chart ;
    chart:chartType "area" ;
    chart:title "Laos : Infant mortality rate from 2009 to 2019 (in deaths per 1,000 live births)" ;
    chart:xAxis ex:x-170 ;
    chart:yAxis ex:y-170 .

ex:x-170 a chart:Axis ;
    chart:label "Year" .

ex:y-170 a chart:Axis ;
    chart:label "" .

ex:series-170-1 a chart:Series .

ex:mark-170-1-1 a chart:DataPoint ;
    chart:series ex:series-170-1 ;
    chart:category "Deaths per" ;
    chart:value "1000"^^xsd:decimal .

ex:mark-170-1-2 a chart:DataPoint ;
    chart:series ex:series-170-1 ;
    chart:category "live births Dec" ;
    chart:value "31"^^xsd:decimal .

ex:mark-170-1-3 a chart:DataPoint ;
    chart:series ex:series-170-1 ;
    chart:category "Dec" ;
    chart:value "31"^^xsd:decimal .

