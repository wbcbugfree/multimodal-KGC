@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-430 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Cancer mortality rate among men in selected countries worldwide between 2003 and 2007 (per 100,000 population)" ;
    chart:xAxis ex:x-430 ;
    chart:yAxis ex:y-430 .

ex:x-430 a chart:Axis ;
    chart:label "Mortality" .

ex:y-430 a chart:Axis ;
    chart:label "" .

ex:series-430-1 a chart:Series .

ex:mark-430-1-1 a chart:DataPoint ;
    chart:series ex:series-430-1 ;
    chart:category "rate per" ;
    chart:value "100000"^^xsd:decimal .

ex:mark-430-1-2 a chart:DataPoint ;
    chart:series ex:series-430-1 ;
    chart:category "population Country" ;
    chart:value "202.6"^^xsd:decimal .

ex:mark-430-1-3 a chart:DataPoint ;
    chart:series ex:series-430-1 ;
    chart:category "Slovakia" ;
    chart:value "174.7"^^xsd:decimal .

ex:mark-430-1-4 a chart:DataPoint ;
    chart:series ex:series-430-1 ;
    chart:category "USA: Black" ;
    chart:value "154.2"^^xsd:decimal .

ex:mark-430-1-5 a chart:DataPoint ;
    chart:series ex:series-430-1 ;
    chart:category "Denmark" ;
    chart:value "153.9"^^xsd:decimal .

ex:mark-430-1-6 a chart:DataPoint ;
    chart:series ex:series-430-1 ;
    chart:category "Spain" ;
    chart:value "151.4"^^xsd:decimal .

ex:mark-430-1-7 a chart:DataPoint ;
    chart:series ex:series-430-1 ;
    chart:category "China" ;
    chart:value "136.7"^^xsd:decimal .

ex:mark-430-1-8 a chart:DataPoint ;
    chart:series ex:series-430-1 ;
    chart:category "Japan" ;
    chart:value "134.7"^^xsd:decimal .

ex:mark-430-1-9 a chart:DataPoint ;
    chart:series ex:series-430-1 ;
    chart:category "Australia" ;
    chart:value "126.8"^^xsd:decimal .

ex:mark-430-1-10 a chart:DataPoint ;
    chart:series ex:series-430-1 ;
    chart:category "USA: White" ;
    chart:value "100"^^xsd:decimal .

ex:mark-430-1-11 a chart:DataPoint ;
    chart:series ex:series-430-1 ;
    chart:category "Colombia" ;
    chart:value "99.3"^^xsd:decimal .
