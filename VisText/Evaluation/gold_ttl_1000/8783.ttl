@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-8783 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Number of international visitor arrivals in Finland from January to July 2020 , by country of origin" ;
    chart:xAxis ex:x-8783 ;
    chart:yAxis ex:y-8783 .

ex:x-8783 a chart:Axis ;
    chart:label "January* while the y-axis measures Country" .

ex:y-8783 a chart:Axis ;
    chart:label "Country" .

ex:series-8783-1 a chart:Series .

