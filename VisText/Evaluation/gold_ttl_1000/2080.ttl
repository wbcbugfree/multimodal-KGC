@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-2080 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Average ticket price Dallas Stars (NHL) games from 2005/06 to 2014/15 (in U.S. dollars)" ;
    chart:xAxis ex:x-2080 ;
    chart:yAxis ex:y-2080 .

ex:x-2080 a chart:Axis ;
    chart:label "Average ticket price in U" .

ex:y-2080 a chart:Axis ;
    chart:label "" .

ex:series-2080-1 a chart:Series .

ex:mark-2080-1-1 a chart:DataPoint ;
    chart:series ex:series-2080-1 ;
    chart:category "ticket price in U.S. dollars Year" ;
    chart:value "37.28"^^xsd:decimal .

