@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-480 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Outbound travel and tourism expenditure in leading countries worldwide in 2019 (in billion U.S. dollars)" ;
    chart:xAxis ex:x-480 ;
    chart:yAxis ex:y-480 .

ex:x-480 a chart:Axis ;
    chart:label "Internal" .

ex:y-480 a chart:Axis ;
    chart:label "" .

ex:series-480-1 a chart:Series .

ex:mark-480-1-1 a chart:DataPoint ;
    chart:series ex:series-480-1 ;
    chart:category "consumption in billion U.S. dollars Country" ;
    chart:value "262.1"^^xsd:decimal .

ex:mark-480-1-2 a chart:DataPoint ;
    chart:series ex:series-480-1 ;
    chart:category "China" ;
    chart:value "184.2"^^xsd:decimal .

ex:mark-480-1-3 a chart:DataPoint ;
    chart:series ex:series-480-1 ;
    chart:category "United States" ;
    chart:value "104.8"^^xsd:decimal .

ex:mark-480-1-4 a chart:DataPoint ;
    chart:series ex:series-480-1 ;
    chart:category "Germany" ;
    chart:value "90.2"^^xsd:decimal .

ex:mark-480-1-5 a chart:DataPoint ;
    chart:series ex:series-480-1 ;
    chart:category "United Kingdom" ;
    chart:value "56.2"^^xsd:decimal .

ex:mark-480-1-6 a chart:DataPoint ;
    chart:series ex:series-480-1 ;
    chart:category "France" ;
    chart:value "43.8"^^xsd:decimal .

ex:mark-480-1-7 a chart:DataPoint ;
    chart:series ex:series-480-1 ;
    chart:category "Australia" ;
    chart:value "42.2"^^xsd:decimal .

ex:mark-480-1-8 a chart:DataPoint ;
    chart:series ex:series-480-1 ;
    chart:category "Canada" ;
    chart:value "36.7"^^xsd:decimal .

ex:mark-480-1-9 a chart:DataPoint ;
    chart:series ex:series-480-1 ;
    chart:category "Spain" ;
    chart:value "36.4"^^xsd:decimal .

ex:mark-480-1-10 a chart:DataPoint ;
    chart:series ex:series-480-1 ;
    chart:category "Italy" ;
