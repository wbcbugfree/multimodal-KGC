@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-3330 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Which sites or services have you used in the past three months to stream/access , or share music tracks or albums through the internet ?" ;
    chart:xAxis ex:x-3330 ;
    chart:yAxis ex:y-3330 .

ex:x-3330 a chart:Axis ;
    chart:label "Share of respondents" .

ex:y-3330 a chart:Axis ;
    chart:label "Response while the x-axis shows Share of respondents" .

ex:series-3330-1 a chart:Series .

ex:mark-3330-1-1 a chart:DataPoint ;
    chart:series ex:series-3330-1 ;
    chart:category "of respondents Response" ;
    chart:value "0.62"^^xsd:decimal .

