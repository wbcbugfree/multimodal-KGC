@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-5302 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Total number of employees of the Richemont Group worldwide from FY2011 to FY2020" ;
    chart:xAxis ex:x-5302 ;
    chart:yAxis ex:y-5302 .

ex:x-5302 a chart:Axis ;
    chart:label "Number" .

ex:y-5302 a chart:Axis ;
    chart:label "" .

ex:series-5302-1 a chart:Series .

ex:mark-5302-1-1 a chart:DataPoint ;
    chart:series ex:series-5302-1 ;
    chart:category "of employees Year" ;
    chart:value "35657"^^xsd:decimal .

ex:mark-5302-1-2 a chart:DataPoint ;
    chart:series ex:series-5302-1 ;
    chart:category "2014*" ;
    chart:value "27666"^^xsd:decimal .
