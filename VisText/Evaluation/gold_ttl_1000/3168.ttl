@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-3168 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Factor weighted gender pay gap in selected countries in Latin America and the Caribbean in 2016" ;
    chart:xAxis ex:x-3168 ;
    chart:yAxis ex:y-3168 .

ex:x-3168 a chart:Axis ;
    chart:label "Gender pay gap while the y-axis shows Country" .

ex:y-3168 a chart:Axis ;
    chart:label "Country" .

ex:series-3168-1 a chart:Series .

ex:mark-3168-1-1 a chart:DataPoint ;
    chart:series ex:series-3168-1 ;
    chart:category "Brazil" ;
    chart:value "0.237"^^xsd:decimal .

ex:mark-3168-1-2 a chart:DataPoint ;
    chart:series ex:series-3168-1 ;
    chart:category "Chile" ;
    chart:value "0.173"^^xsd:decimal .

ex:mark-3168-1-3 a chart:DataPoint ;
    chart:series ex:series-3168-1 ;
    chart:category "Uruguay" ;
    chart:value "0.169"^^xsd:decimal .

ex:mark-3168-1-4 a chart:DataPoint ;
    chart:series ex:series-3168-1 ;
    chart:category "Paraguay" ;
    chart:value "0.162"^^xsd:decimal .

ex:mark-3168-1-5 a chart:DataPoint ;
    chart:series ex:series-3168-1 ;
    chart:category "Peru" ;
    chart:value "0.16"^^xsd:decimal .

ex:mark-3168-1-6 a chart:DataPoint ;
    chart:series ex:series-3168-1 ;
    chart:category "El Salvador" ;
    chart:value "0.156"^^xsd:decimal .

ex:mark-3168-1-7 a chart:DataPoint ;
    chart:series ex:series-3168-1 ;
    chart:category "Mexico" ;
    chart:value "0.13"^^xsd:decimal .

ex:mark-3168-1-8 a chart:DataPoint ;
    chart:series ex:series-3168-1 ;
    chart:category "Argentina" ;
    chart:value "0.123"^^xsd:decimal .

ex:mark-3168-1-9 a chart:DataPoint ;
    chart:series ex:series-3168-1 ;
    chart:category "Costa Rica" ;
    chart:value "0.119"^^xsd:decimal .

ex:mark-3168-1-10 a chart:DataPoint ;
    chart:series ex:series-3168-1 ;
    chart:category "Ecuador" ;
    chart:value "0.11"^^xsd:decimal .
