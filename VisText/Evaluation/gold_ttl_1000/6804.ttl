@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-6804 a chart:Chart ;
    chart:chartType "line" ;
    chart:title "Wood production in the United States from 2003 to 2014 , by type (in million cubic meters)" ;
    chart:xAxis ex:x-6804 ;
    chart:yAxis ex:y-6804 .

ex:x-6804 a chart:Axis ;
    chart:label "Year" .

ex:y-6804 a chart:Axis ;
    chart:label "Sawnwood production" .

ex:series-6804-1 a chart:Series .

ex:mark-6804-1-1 a chart:DataPoint ;
    chart:series ex:series-6804-1 ;
    chart:category "Dec" ;
    chart:value "31"^^xsd:decimal .

