@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-2654 a chart:Chart ;
    chart:chartType "line" ;
    chart:title "Pemex 's natural gas production from 2008 to 2019 (in million cubic feet per day)" ;
    chart:xAxis ex:x-2654 ;
    chart:yAxis ex:y-2654 .

ex:x-2654 a chart:Axis ;
    chart:label "Year" .

ex:y-2654 a chart:Axis ;
    chart:label "Production in million cubic feet per day" .

ex:series-2654-1 a chart:Series .

ex:mark-2654-1-1 a chart:DataPoint ;
    chart:series ex:series-2654-1 ;
    chart:category "Dec" ;
    chart:value "31"^^xsd:decimal .

