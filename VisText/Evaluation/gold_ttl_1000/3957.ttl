@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-3957 a chart:Chart ;
    chart:chartType "line" ;
    chart:title "Total number of farms in Denmark from 2010 to 2019" ;
    chart:xAxis ex:x-3957 ;
    chart:yAxis ex:y-3957 .

ex:x-3957 a chart:Axis ;
    chart:label "Year" .

ex:y-3957 a chart:Axis ;
    chart:label "Number of farms" .

ex:series-3957-1 a chart:Series .

ex:mark-3957-1-1 a chart:DataPoint ;
    chart:series ex:series-3957-1 ;
    chart:category "Dec" ;
    chart:value "31"^^xsd:decimal .

