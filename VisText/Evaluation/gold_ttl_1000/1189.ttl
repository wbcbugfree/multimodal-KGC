@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-1189 a chart:Chart ;
    chart:chartType "line" ;
    chart:title "Median annual income in Canada from 2000 to 2018 (in Canadian dollars)" ;
    chart:xAxis ex:x-1189 ;
    chart:yAxis ex:y-1189 .

ex:x-1189 a chart:Axis ;
    chart:label "Year" .

ex:y-1189 a chart:Axis ;
    chart:label "Earnings in Canadian dollars" .

ex:series-1189-1 a chart:Series .

ex:mark-1189-1-1 a chart:DataPoint ;
    chart:series ex:series-1189-1 ;
    chart:category "Dec" ;
    chart:value "31"^^xsd:decimal .

