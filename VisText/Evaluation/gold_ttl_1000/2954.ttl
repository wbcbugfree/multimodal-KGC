@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-2954 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Year-on-year change in sales turnover of the retail trade in the Netherlands from 2005 to 2019" ;
    chart:xAxis ex:x-2954 ;
    chart:yAxis ex:y-2954 .

ex:x-2954 a chart:Axis ;
    chart:label "Year-on-year" .

ex:y-2954 a chart:Axis ;
    chart:label "" .

ex:series-2954-1 a chart:Series .

ex:mark-2954-1-1 a chart:DataPoint ;
    chart:series ex:series-2954-1 ;
    chart:category "percentage change Year" ;
    chart:value "0.033"^^xsd:decimal .

ex:mark-2954-1-2 a chart:DataPoint ;
    chart:series ex:series-2954-1 ;
    chart:category "2019*" ;
    chart:value "0.034"^^xsd:decimal .

ex:mark-2954-1-3 a chart:DataPoint ;
    chart:series ex:series-2954-1 ;
    chart:category "−0.021" ;
    chart:value "2013"^^xsd:decimal .

ex:mark-2954-1-4 a chart:DataPoint ;
    chart:series ex:series-2954-1 ;
    chart:category "−0.014" ;
    chart:value "2012"^^xsd:decimal .

ex:mark-2954-1-5 a chart:DataPoint ;
    chart:series ex:series-2954-1 ;
    chart:category "−0.005" ;
    chart:value "2010"^^xsd:decimal .

ex:mark-2954-1-6 a chart:DataPoint ;
    chart:series ex:series-2954-1 ;
    chart:category "−0.043" ;
    chart:value "2009"^^xsd:decimal .

ex:mark-2954-1-7 a chart:DataPoint ;
    chart:series ex:series-2954-1 ;
    chart:category "−0.002" ;
    chart:value "2005"^^xsd:decimal .
