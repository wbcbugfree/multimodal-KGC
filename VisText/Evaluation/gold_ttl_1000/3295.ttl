@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-3295 a chart:Chart ;
    chart:chartType "area" ;
    chart:title "Producer price index of metal cutting machine tools in the U.S. from 1990 to 2010" ;
    chart:xAxis ex:x-3295 ;
    chart:yAxis ex:y-3295 .

ex:x-3295 a chart:Axis ;
    chart:label "Year while the y-axis measures Producer price index" .

ex:y-3295 a chart:Axis ;
    chart:label "Producer price index" .

ex:series-3295-1 a chart:Series .

ex:mark-3295-1-1 a chart:DataPoint ;
    chart:series ex:series-3295-1 ;
    chart:category "Dec" ;
    chart:value "31"^^xsd:decimal .

