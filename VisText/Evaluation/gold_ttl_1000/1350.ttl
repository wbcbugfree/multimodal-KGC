@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-1350 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "How did you hear about the Summer X Games ?" ;
    chart:xAxis ex:x-1350 ;
    chart:yAxis ex:y-1350 .

ex:x-1350 a chart:Axis ;
    chart:label "Share of respondents" .

ex:y-1350 a chart:Axis ;
    chart:label "Response" .

ex:series-1350-1 a chart:Series .

ex:mark-1350-1-1 a chart:DataPoint ;
    chart:series ex:series-1350-1 ;
    chart:category "ESPN" ;
    chart:value "0.4"^^xsd:decimal .

ex:mark-1350-1-2 a chart:DataPoint ;
    chart:series ex:series-1350-1 ;
    chart:category "Internet" ;
    chart:value "0.39"^^xsd:decimal .

ex:mark-1350-1-3 a chart:DataPoint ;
    chart:series ex:series-1350-1 ;
    chart:category "Word of mouth" ;
    chart:value "0.33"^^xsd:decimal .

ex:mark-1350-1-4 a chart:DataPoint ;
    chart:series ex:series-1350-1 ;
    chart:category "Local media (TV, radio or print)" ;
    chart:value "0.3"^^xsd:decimal .

ex:mark-1350-1-5 a chart:DataPoint ;
    chart:series ex:series-1350-1 ;
    chart:category "Xgames.com or ESPN.com/action" ;
    chart:value "0.28"^^xsd:decimal .

ex:mark-1350-1-6 a chart:DataPoint ;
    chart:series ex:series-1350-1 ;
    chart:category "ESPN" ;
    chart:value "2"^^xsd:decimal .

ex:mark-1350-1-7 a chart:DataPoint ;
    chart:series ex:series-1350-1 ;
    chart:category "Social media (Facebook, Twitter, YouTube)" ;
    chart:value "0.1"^^xsd:decimal .

ex:mark-1350-1-8 a chart:DataPoint ;
    chart:series ex:series-1350-1 ;
    chart:category "Other national TV" ;
    chart:value "0.09"^^xsd:decimal .

ex:mark-1350-1-9 a chart:DataPoint ;
    chart:series ex:series-1350-1 ;
    chart:category "National radio" ;
    chart:value "0.09"^^xsd:decimal .

ex:mark-1350-1-10 a chart:DataPoint ;
    chart:series ex:series-1350-1 ;
    chart:category "National print ads" ;
    chart:value "0.07"^^xsd:decimal .

ex:mark-1350-1-11 a chart:DataPoint ;
    chart:series ex:series-1350-1 ;
    chart:category "Sponsor promotions" ;
    chart:value "0.01"^^xsd:decimal .

ex:mark-1350-1-12 a chart:DataPoint ;
    chart:series ex:series-1350-1 ;
    chart:category "Chamber of commerce" ;
    chart:value "0.06"^^xsd:decimal .
