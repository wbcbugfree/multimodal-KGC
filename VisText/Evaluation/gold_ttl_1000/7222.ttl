@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-7222 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Number of LTE subscriptions worldwide from 2012 to 2024 , by region (in millions)" ;
    chart:xAxis ex:x-7222 ;
    chart:yAxis ex:y-7222 .

ex:x-7222 a chart:Axis ;
    chart:label "Year" .

ex:y-7222 a chart:Axis ;
    chart:label "" .

ex:series-7222-1 a chart:Series .

ex:mark-7222-1-1 a chart:DataPoint ;
    chart:series ex:series-7222-1 ;
    chart:category "Asia Pacific 2024*" ;
    chart:value "3480.08"^^xsd:decimal .

ex:mark-7222-1-2 a chart:DataPoint ;
    chart:series ex:series-7222-1 ;
    chart:category "2023*" ;
    chart:value "3213.61"^^xsd:decimal .

ex:mark-7222-1-3 a chart:DataPoint ;
    chart:series ex:series-7222-1 ;
    chart:category "2022*" ;
    chart:value "2875.44"^^xsd:decimal .

ex:mark-7222-1-4 a chart:DataPoint ;
    chart:series ex:series-7222-1 ;
    chart:category "2021*" ;
    chart:value "2469.71"^^xsd:decimal .

ex:mark-7222-1-5 a chart:DataPoint ;
    chart:series ex:series-7222-1 ;
    chart:category "2020*" ;
    chart:value "1972.4"^^xsd:decimal .

ex:mark-7222-1-6 a chart:DataPoint ;
    chart:series ex:series-7222-1 ;
    chart:category "2019*" ;
    chart:value "1456.65"^^xsd:decimal .
