@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-796 a chart:Chart ;
    chart:chartType "line" ;
    chart:title "Iran : Fertility rate from 2008 to 2018" ;
    chart:xAxis ex:x-796 ;
    chart:yAxis ex:y-796 .

ex:x-796 a chart:Axis ;
    chart:label "Year" .

ex:y-796 a chart:Axis ;
    chart:label "Fertility rate while the x-axis plots Year" .

ex:series-796-1 a chart:Series .

ex:mark-796-1-1 a chart:DataPoint ;
    chart:series ex:series-796-1 ;
    chart:category "Fertility rate Dec" ;
    chart:value "31"^^xsd:decimal .

ex:mark-796-1-2 a chart:DataPoint ;
    chart:series ex:series-796-1 ;
    chart:category "Dec" ;
    chart:value "31"^^xsd:decimal .

