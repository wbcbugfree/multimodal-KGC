@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-8638 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Percentage of global population accessing the internet from 2005 to 2019 , by market maturity" ;
    chart:xAxis ex:x-8638 ;
    chart:yAxis ex:y-8638 .

ex:x-8638 a chart:Axis ;
    chart:label "World" .

ex:y-8638 a chart:Axis ;
    chart:label "" .

ex:series-8638-1 a chart:Series .

ex:mark-8638-1-1 a chart:DataPoint ;
    chart:series ex:series-8638-1 ;
    chart:category "Year" ;
    chart:value "0.536"^^xsd:decimal .

ex:mark-8638-1-2 a chart:DataPoint ;
    chart:series ex:series-8638-1 ;
    chart:category "2019*" ;
    chart:value "0.514"^^xsd:decimal .
