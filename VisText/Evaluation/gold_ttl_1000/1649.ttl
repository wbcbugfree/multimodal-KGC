@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-1649 a chart:Chart ;
    chart:chartType "line" ;
    chart:title "Average duration of marriages in Belgium from 2008 to 2018 (in years)" ;
    chart:xAxis ex:x-1649 ;
    chart:yAxis ex:y-1649 .

ex:x-1649 a chart:Axis ;
    chart:label "Year" .

ex:y-1649 a chart:Axis ;
    chart:label "" .

ex:series-1649-1 a chart:Series .

ex:mark-1649-1-1 a chart:DataPoint ;
    chart:series ex:series-1649-1 ;
    chart:category "Average duration in years Dec" ;
    chart:value "31"^^xsd:decimal .

