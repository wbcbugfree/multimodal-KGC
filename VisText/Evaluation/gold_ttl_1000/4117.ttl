@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-4117 a chart:Chart ;
    chart:chartType "line" ;
    chart:title "Number of births in Italy from 2010 to 2019" ;
    chart:xAxis ex:x-4117 ;
    chart:yAxis ex:y-4117 .

ex:x-4117 a chart:Axis ;
    chart:label "Year" .

ex:y-4117 a chart:Axis ;
    chart:label "" .

ex:series-4117-1 a chart:Series .

ex:mark-4117-1-1 a chart:DataPoint ;
    chart:series ex:series-4117-1 ;
    chart:category "Number of births Dec" ;
    chart:value "31"^^xsd:decimal .

