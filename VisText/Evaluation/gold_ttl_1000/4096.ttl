@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-4096 a chart:Chart ;
    chart:chartType "line" ;
    chart:title "Number of participants in surfing in the United States from 2006 to 2017 (in millions)" ;
    chart:xAxis ex:x-4096 ;
    chart:yAxis ex:y-4096 .

ex:x-4096 a chart:Axis ;
    chart:label "Year" .

ex:y-4096 a chart:Axis ;
    chart:label "" .

ex:series-4096-1 a chart:Series .

ex:mark-4096-1-1 a chart:DataPoint ;
    chart:series ex:series-4096-1 ;
    chart:category "Number of participants in millions Dec" ;
    chart:value "31"^^xsd:decimal .

