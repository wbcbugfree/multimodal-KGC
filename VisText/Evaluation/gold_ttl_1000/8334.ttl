@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-8334 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Anticipated time of booking summer holiday in selected European countries in 2019" ;
    chart:xAxis ex:x-8334 ;
    chart:yAxis ex:y-8334 .

ex:x-8334 a chart:Axis ;
    chart:label "One month or more in advance" .

ex:y-8334 a chart:Axis ;
    chart:label "" .

ex:series-8334-1 a chart:Series .

ex:mark-8334-1-1 a chart:DataPoint ;
    chart:series ex:series-8334-1 ;
    chart:category "month or more in advance Response" ;
    chart:value "0.82"^^xsd:decimal .

ex:mark-8334-1-2 a chart:DataPoint ;
    chart:series ex:series-8334-1 ;
    chart:category "United Kingdom" ;
    chart:value "0.81"^^xsd:decimal .

