    chart:series ex:series-8334-1 ;
    chart:category "Austria" ;
    chart:value "0.79"^^xsd:decimal .

ex:mark-8334-1-6 a chart:DataPoint ;
    chart:series ex:series-8334-1 ;
    chart:category "Switzerland" ;
    chart:value "0.78"^^xsd:decimal .

ex:mark-8334-1-7 a chart:DataPoint ;
    chart:series ex:series-8334-1 ;
