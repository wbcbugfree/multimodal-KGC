@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-4389 a chart:Chart ;
    chart:chartType "area" ;
    chart:title "New York Mets average ticket price from 2006 to 2019 (in U.S. dollars)" ;
    chart:xAxis ex:x-4389 ;
    chart:yAxis ex:y-4389 .

