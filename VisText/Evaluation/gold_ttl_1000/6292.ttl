@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-6292 a chart:Chart ;
    chart:chartType "line" ;
    chart:title "What is your religious preference : Protestant , Roman Catholic , Jewish , another religion , or no religion ?" ;
    chart:xAxis ex:x-6292 ;
    chart:yAxis ex:y-6292 .

ex:x-6292 a chart:Axis ;
    chart:label "Response" .

ex:y-6292 a chart:Axis ;
    chart:label "" .

ex:series-6292-1 a chart:Series .

ex:mark-6292-1-1 a chart:DataPoint ;
    chart:series ex:series-6292-1 ;
    chart:category "Catholic Dec" ;
    chart:value "31"^^xsd:decimal .

