@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-6462 a chart:Chart ;
    chart:chartType "line" ;
    chart:title "Israel : Distribution of employment by economic sector from 2010 to 2020" ;
    chart:xAxis ex:x-6462 ;
    chart:yAxis ex:y-6462 .

ex:x-6462 a chart:Axis ;
    chart:label "Year" .

ex:y-6462 a chart:Axis ;
    chart:label "" .

ex:series-6462-1 a chart:Series .

ex:mark-6462-1-1 a chart:DataPoint ;
    chart:series ex:series-6462-1 ;
    chart:category "Services Dec" ;
    chart:value "31"^^xsd:decimal .

