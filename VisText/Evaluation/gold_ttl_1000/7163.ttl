@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-7163 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Proportion of young people reading various media outside of class in the United Kingdom (UK) from 2014 to 2019" ;
    chart:xAxis ex:x-7163 ;
    chart:yAxis ex:y-7163 .

ex:x-7163 a chart:Axis ;
    chart:label "media read by young people" .

ex:y-7163 a chart:Axis ;
    chart:label "" .

ex:series-7163-1 a chart:Series .

ex:mark-7163-1-1 a chart:DataPoint ;
    chart:series ex:series-7163-1 ;
    chart:category "read by young people 2017/18 Text messages" ;
    chart:value "0.888"^^xsd:decimal .

ex:mark-7163-1-2 a chart:DataPoint ;
    chart:series ex:series-7163-1 ;
    chart:category "Instant messages" ;
    chart:value "0.79"^^xsd:decimal .

