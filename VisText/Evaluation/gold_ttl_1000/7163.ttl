    chart:series ex:series-7163-1 ;
    chart:category "Lyrics" ;
    chart:value "0.478"^^xsd:decimal .

ex:mark-7163-1-5 a chart:DataPoint ;
    chart:series ex:series-7163-1 ;
    chart:category "Fiction" ;
    chart:value "0.549"^^xsd:decimal .

ex:mark-7163-1-6 a chart:DataPoint ;
    chart:series ex:series-7163-1 ;
    chart:category "Non-fiction" ;
    chart:value "0.485"^^xsd:decimal .

ex:mark-7163-1-7 a chart:DataPoint ;
    chart:series ex:series-7163-1 ;
    chart:category "Newspapers" ;
    chart:value "0.307"^^xsd:decimal .

ex:mark-7163-1-8 a chart:DataPoint ;
