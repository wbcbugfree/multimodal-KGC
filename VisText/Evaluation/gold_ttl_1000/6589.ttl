@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-6589 a chart:Chart ;
    chart:chartType "area" ;
    chart:title "Number of employees in the gambling industry in the United Kingdom from 2009 to 2019 , by sector" ;
    chart:xAxis ex:x-6589 ;
    chart:yAxis ex:y-6589 .

ex:x-6589 a chart:Axis ;
    chart:label "year while the y-axis plots Bingo" .

ex:y-6589 a chart:Axis ;
    chart:label "" .

ex:series-6589-1 a chart:Series .

ex:mark-6589-1-1 a chart:DataPoint ;
    chart:series ex:series-6589-1 ;
    chart:category "Bingo Mar" ;
    chart:value "30"^^xsd:decimal .

