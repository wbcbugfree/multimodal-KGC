@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-6447 a chart:Chart ;
    chart:chartType "area" ;
    chart:title "Marital status of the adult population in England and Wales from 2002 to 2019" ;
    chart:xAxis ex:x-6447 ;
    chart:yAxis ex:y-6447 .

ex:x-6447 a chart:Axis ;
    chart:label "Year" .

ex:y-6447 a chart:Axis ;
    chart:label "" .

ex:series-6447-1 a chart:Series .

ex:mark-6447-1-1 a chart:DataPoint ;
    chart:series ex:series-6447-1 ;
    chart:category "Married Dec" ;
    chart:value "31"^^xsd:decimal .

