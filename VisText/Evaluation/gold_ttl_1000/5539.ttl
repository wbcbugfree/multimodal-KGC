@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-5539 a chart:Chart ;
    chart:chartType "line" ;
    chart:title "Average ticket price for Detroit Lions home games from 2006 to 2019 (in U.S. dollars)" ;
    chart:xAxis ex:x-5539 ;
    chart:yAxis ex:y-5539 .

ex:x-5539 a chart:Axis ;
    chart:label "Year while the y-axis shows Average ticket price in U" .

ex:y-5539 a chart:Axis ;
    chart:label "Average ticket price in U" .

ex:series-5539-1 a chart:Series .

ex:mark-5539-1-1 a chart:DataPoint ;
    chart:series ex:series-5539-1 ;
    chart:category "Average ticket price in U.S. dollars Dec" ;
    chart:value "31"^^xsd:decimal .

