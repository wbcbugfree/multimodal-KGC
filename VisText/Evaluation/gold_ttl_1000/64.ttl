@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-64 a chart:Chart ;
    chart:chartType "area" ;
    chart:title "Neodymium oxide price worldwide from 2009 to 2025 (in U.S. dollars per metric ton)" ;
    chart:xAxis ex:x-64 ;
    chart:yAxis ex:y-64 .

ex:x-64 a chart:Axis ;
    chart:label "Year" .

ex:y-64 a chart:Axis ;
    chart:label "" .

ex:series-64-1 a chart:Series .

ex:mark-64-1-1 a chart:DataPoint ;
    chart:series ex:series-64-1 ;
    chart:category "Price in U.S. dollars per metric ton Dec" ;
    chart:value "31"^^xsd:decimal .

ex:mark-64-1-2 a chart:DataPoint ;
    chart:series ex:series-64-1 ;
    chart:category "Dec" ;
    chart:value "31"^^xsd:decimal .

