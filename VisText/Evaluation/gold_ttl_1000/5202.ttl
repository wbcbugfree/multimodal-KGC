@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-5202 a chart:Chart ;
    chart:chartType "line" ;
    chart:title "India : Youth unemployment rate from 1999 to 2020" ;
    chart:xAxis ex:x-5202 ;
    chart:yAxis ex:y-5202 .

ex:x-5202 a chart:Axis ;
    chart:label "Year with a linear scale from 2000 to 2015" .

ex:y-5202 a chart:Axis ;
    chart:label "" .

ex:series-5202-1 a chart:Series .

ex:mark-5202-1-1 a chart:DataPoint ;
    chart:series ex:series-5202-1 ;
    chart:category "Youth unemployment rate Dec" ;
    chart:value "31"^^xsd:decimal .

