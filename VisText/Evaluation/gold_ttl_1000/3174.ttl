@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-3174 a chart:Chart ;
    chart:chartType "area" ;
    chart:title "Number of state and federal prisoners in local jail facilities in the United States from 2000 to 2018" ;
    chart:xAxis ex:x-3174 ;
    chart:yAxis ex:y-3174 .

ex:x-3174 a chart:Axis ;
    chart:label "Year" .

ex:y-3174 a chart:Axis ;
    chart:label "" .

