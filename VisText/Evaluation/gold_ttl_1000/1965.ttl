@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-1965 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Installed power capacity across Jammu and Kashmir in India from financial year 2005 to 2018 (in megawatts)" ;
    chart:xAxis ex:x-1965 ;
    chart:yAxis ex:y-1965 .

ex:x-1965 a chart:Axis ;
    chart:label "Year" .

ex:y-1965 a chart:Axis ;
    chart:label "" .

ex:series-1965-1 a chart:Series .

ex:mark-1965-1-1 a chart:DataPoint ;
    chart:series ex:series-1965-1 ;
    chart:category "Installed power capacity in megawatts FY" ;
    chart:value "2018"^^xsd:decimal .

ex:mark-1965-1-2 a chart:DataPoint ;
    chart:series ex:series-1965-1 ;
    chart:category "FY" ;
    chart:value "2017"^^xsd:decimal .

