@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-1033 a chart:Chart ;
    chart:chartType "area" ;
    chart:title "Poverty rate in Maryland from 2000 to 2019" ;
    chart:xAxis ex:x-1033 ;
    chart:yAxis ex:y-1033 .

ex:x-1033 a chart:Axis ;
    chart:label "Response" .

ex:y-1033 a chart:Axis ;
    chart:label "Percentage of population" .

ex:series-1033-1 a chart:Series .

ex:mark-1033-1-1 a chart:DataPoint ;
    chart:series ex:series-1033-1 ;
    chart:category "Dec" ;
    chart:value "31"^^xsd:decimal .

