@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-940 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Leading financial advisors to German M & A in 2016 , by deal count" ;
    chart:xAxis ex:x-940 ;
    chart:yAxis ex:y-940 .

ex:x-940 a chart:Axis ;
    chart:label "M&A deal count" .

ex:y-940 a chart:Axis ;
    chart:label "Financial advisory firms" .

ex:series-940-1 a chart:Series .

ex:mark-940-1-1 a chart:DataPoint ;
    chart:series ex:series-940-1 ;
    chart:category "Rothschild" ;
    chart:value "40"^^xsd:decimal .

ex:mark-940-1-2 a chart:DataPoint ;
    chart:series ex:series-940-1 ;
    chart:category "KPMG" ;
    chart:value "35"^^xsd:decimal .

ex:mark-940-1-3 a chart:DataPoint ;
    chart:series ex:series-940-1 ;
    chart:category "Deloitte" ;
    chart:value "31"^^xsd:decimal .

ex:mark-940-1-4 a chart:DataPoint ;
    chart:series ex:series-940-1 ;
    chart:category "EY" ;
    chart:value "29"^^xsd:decimal .

ex:mark-940-1-5 a chart:DataPoint ;
    chart:series ex:series-940-1 ;
    chart:category "PwC" ;
    chart:value "28"^^xsd:decimal .

ex:mark-940-1-6 a chart:DataPoint ;
    chart:series ex:series-940-1 ;
    chart:category "Globalscope Partners" ;
    chart:value "28"^^xsd:decimal .

ex:mark-940-1-7 a chart:DataPoint ;
    chart:series ex:series-940-1 ;
    chart:category "Lincoln International" ;
    chart:value "23"^^xsd:decimal .

ex:mark-940-1-8 a chart:DataPoint ;
    chart:series ex:series-940-1 ;
    chart:category "JPMorgan" ;
    chart:value "20"^^xsd:decimal .

ex:mark-940-1-9 a chart:DataPoint ;
    chart:series ex:series-940-1 ;
    chart:category "Goldman Sachs" ;
    chart:value "20"^^xsd:decimal .
