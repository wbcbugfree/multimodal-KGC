@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-8734 a chart:Chart ;
    chart:chartType "line" ;
    chart:title "Poland : Distribution of employment by economic sector from 2010 to 2020" ;
    chart:xAxis ex:x-8734 ;
    chart:yAxis ex:y-8734 .

ex:x-8734 a chart:Axis ;
    chart:label "Year while the y-axis measures Services" .

ex:y-8734 a chart:Axis ;
    chart:label "Services" .

ex:series-8734-1 a chart:Series .

ex:mark-8734-1-1 a chart:DataPoint ;
    chart:series ex:series-8734-1 ;
    chart:category "Dec" ;
    chart:value "31"^^xsd:decimal .

