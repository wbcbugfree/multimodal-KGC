@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-1241 a chart:Chart ;
    chart:chartType "line" ;
    chart:title "Total amount of investment of private equity firms in Bulgaria from 2007 to 2016 (in million euros)" ;
    chart:xAxis ex:x-1241 ;
    chart:yAxis ex:y-1241 .

ex:x-1241 a chart:Axis ;
    chart:label "Year with linear scale with a minimum of 2008 and a maximum of 2014" .

ex:y-1241 a chart:Axis ;
    chart:label "Total investment in million euros" .

ex:series-1241-1 a chart:Series .

ex:mark-1241-1-1 a chart:DataPoint ;
    chart:series ex:series-1241-1 ;
    chart:category "Dec" ;
    chart:value "31"^^xsd:decimal .

