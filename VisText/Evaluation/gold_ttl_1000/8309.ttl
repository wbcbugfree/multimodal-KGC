@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-8309 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "How do you expect COVID-19 to impact your spending for any of the following ?" ;
    chart:xAxis ex:x-8309 ;
    chart:yAxis ex:y-8309 .

ex:x-8309 a chart:Axis ;
    chart:label "Stay" .

ex:y-8309 a chart:Axis ;
    chart:label "" .

ex:series-8309-1 a chart:Series .

ex:mark-8309-1-1 a chart:DataPoint ;
    chart:series ex:series-8309-1 ;
    chart:category "the same Response" ;
    chart:value "0.13"^^xsd:decimal .

