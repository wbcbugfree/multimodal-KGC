@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-3674 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "The Bahamas : Total population from 2015 to 2025 (in million inhabitants)" ;
    chart:xAxis ex:x-3674 ;
    chart:yAxis ex:y-3674 .

ex:x-3674 a chart:Axis ;
    chart:label "Year" .

ex:y-3674 a chart:Axis ;
    chart:label "Inhabitants in millions" .

ex:series-3674-1 a chart:Series .

ex:mark-3674-1-1 a chart:DataPoint ;
    chart:series ex:series-3674-1 ;
    chart:category "2025*" ;
    chart:value "0.41"^^xsd:decimal .

ex:mark-3674-1-2 a chart:DataPoint ;
    chart:series ex:series-3674-1 ;
    chart:category "2024*" ;
    chart:value "0.4"^^xsd:decimal .

ex:mark-3674-1-3 a chart:DataPoint ;
    chart:series ex:series-3674-1 ;
    chart:category "2023*" ;
    chart:value "0.4"^^xsd:decimal .

ex:mark-3674-1-4 a chart:DataPoint ;
    chart:series ex:series-3674-1 ;
    chart:category "2022*" ;
    chart:value "0.39"^^xsd:decimal .

ex:mark-3674-1-5 a chart:DataPoint ;
    chart:series ex:series-3674-1 ;
    chart:category "2021*" ;
    chart:value "0.39"^^xsd:decimal .

ex:mark-3674-1-6 a chart:DataPoint ;
    chart:series ex:series-3674-1 ;
    chart:category "2020*" ;
    chart:value "0.39"^^xsd:decimal .

ex:mark-3674-1-7 a chart:DataPoint ;
    chart:series ex:series-3674-1 ;
    chart:category "2019*" ;
    chart:value "0.38"^^xsd:decimal .
