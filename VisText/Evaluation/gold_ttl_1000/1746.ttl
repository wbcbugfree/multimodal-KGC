@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-1746 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "How many of each of the following products or devices , in working order , do you have in your household ?" ;
    chart:xAxis ex:x-1746 ;
    chart:yAxis ex:y-1746 .

ex:x-1746 a chart:Axis ;
    chart:label "Household" .

ex:y-1746 a chart:Axis ;
    chart:label "" .

ex:series-1746-1 a chart:Series .

