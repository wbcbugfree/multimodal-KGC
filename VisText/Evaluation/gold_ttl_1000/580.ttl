@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-580 a chart:Chart ;
    chart:chartType "line" ;
    chart:title "U.S. sweet potato production value from 2000 to 2019 (in 1,000 U.S. dollars)" ;
    chart:xAxis ex:x-580 ;
    chart:yAxis ex:y-580 .

ex:x-580 a chart:Axis ;
    chart:label "Year" .

ex:y-580 a chart:Axis ;
    chart:label "" .

ex:series-580-1 a chart:Series .

ex:mark-580-1-1 a chart:DataPoint ;
    chart:series ex:series-580-1 ;
    chart:category "Production value in thousand U.S. dollars Dec" ;
    chart:value "31"^^xsd:decimal .

