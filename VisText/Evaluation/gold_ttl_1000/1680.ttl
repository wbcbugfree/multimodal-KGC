@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-1680 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Number of single-woman households in Denmark in 2020 , by age group" ;
    chart:xAxis ex:x-1680 ;
    chart:yAxis ex:y-1680 .

ex:x-1680 a chart:Axis ;
    chart:label "Number of single-women households" .

ex:y-1680 a chart:Axis ;
    chart:label "" .

ex:series-1680-1 a chart:Series .

ex:mark-1680-1-1 a chart:DataPoint ;
    chart:series ex:series-1680-1 ;
    chart:category "of single-women households Year" ;
    chart:value "3971"^^xsd:decimal .

ex:mark-1680-1-2 a chart:DataPoint ;
    chart:series ex:series-1680-1 ;
    chart:category "Under" ;
    chart:value "20"^^xsd:decimal .

ex:mark-1680-1-3 a chart:DataPoint ;
    chart:series ex:series-1680-1 ;
    chart:category "years" ;
    chart:value "81919"^^xsd:decimal .

ex:mark-1680-1-4 a chart:DataPoint ;
    chart:series ex:series-1680-1 ;
    chart:category "20-29 years" ;
    chart:value "67568"^^xsd:decimal .

ex:mark-1680-1-5 a chart:DataPoint ;
    chart:series ex:series-1680-1 ;
    chart:category "30-39 years" ;
    chart:value "93175"^^xsd:decimal .

ex:mark-1680-1-6 a chart:DataPoint ;
    chart:series ex:series-1680-1 ;
    chart:category "40-49 years" ;
    chart:value "102124"^^xsd:decimal .

ex:mark-1680-1-7 a chart:DataPoint ;
    chart:series ex:series-1680-1 ;
    chart:category "50-59 years" ;
    chart:value "98651"^^xsd:decimal .

ex:mark-1680-1-8 a chart:DataPoint ;
    chart:series ex:series-1680-1 ;
    chart:category "60-69 years" ;
    chart:value "122470"^^xsd:decimal .

ex:mark-1680-1-9 a chart:DataPoint ;
    chart:series ex:series-1680-1 ;
    chart:category "70-79 years" ;
    chart:value "91788"^^xsd:decimal .

ex:mark-1680-1-10 a chart:DataPoint ;
