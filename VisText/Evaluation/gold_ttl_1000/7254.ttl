@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-7254 a chart:Chart ;
    chart:chartType "area" ;
    chart:title "Australia : Age distribution from 2009 to 2019" ;
    chart:xAxis ex:x-7254 ;
    chart:yAxis ex:y-7254 .

ex:x-7254 a chart:Axis ;
    chart:label "Year" .

ex:y-7254 a chart:Axis ;
    chart:label "" .

ex:series-7254-1 a chart:Series .

ex:mark-7254-1-1 a chart:DataPoint ;
    chart:series ex:series-7254-1 ;
    chart:category "and above Dec" ;
    chart:value "31"^^xsd:decimal .

