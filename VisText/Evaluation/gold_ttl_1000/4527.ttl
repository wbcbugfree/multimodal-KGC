@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-4527 a chart:Chart ;
    chart:chartType "line" ;
    chart:title "Median hourly earnings for full-time employees in the United Kingdom from 1997 to 2020 (in GBP)" ;
    chart:xAxis ex:x-4527 ;
    chart:yAxis ex:y-4527 .

ex:x-4527 a chart:Axis ;
    chart:label "Year" .

