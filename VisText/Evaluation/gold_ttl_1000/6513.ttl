@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-6513 a chart:Chart ;
    chart:chartType "area" ;
    chart:title "Kuwait : Share of economic sectors in the gross domestic product (GDP) from 2010 to 2019" ;
    chart:xAxis ex:x-6513 ;
    chart:yAxis ex:y-6513 .

ex:x-6513 a chart:Axis ;
    chart:label "Year" .

