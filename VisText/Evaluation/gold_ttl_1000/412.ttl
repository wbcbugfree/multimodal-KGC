@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-412 a chart:Chart ;
    chart:chartType "area" ;
    chart:title "Direct investment position of the United States in the Middle East from 2000 to 2019 (in billion U.S. dollars , on a historical-cost basis)" ;
    chart:xAxis ex:x-412 ;
    chart:yAxis ex:y-412 .

ex:x-412 a chart:Axis ;
    chart:label "Year" .

ex:y-412 a chart:Axis ;
    chart:label "Direct investments in billion U" .

ex:series-412-1 a chart:Series .

