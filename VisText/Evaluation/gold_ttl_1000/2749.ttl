@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-2749 a chart:Chart ;
    chart:chartType "line" ;
    chart:title "Amount of money invested in rail transport infrastructure in Denmark from 2004 to 2016 (in million euros)" ;
    chart:xAxis ex:x-2749 ;
    chart:yAxis ex:y-2749 .

ex:x-2749 a chart:Axis ;
    chart:label "Year" .

ex:y-2749 a chart:Axis ;
    chart:label "" .

ex:series-2749-1 a chart:Series .

