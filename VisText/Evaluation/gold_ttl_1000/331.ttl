@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-331 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "U.S. grapefruit production from 1999/2000 to 2018/2019 (in 1,000 boxes)" ;
    chart:xAxis ex:x-331 ;
    chart:yAxis ex:y-331 .

ex:x-331 a chart:Axis ;
    chart:label "Year" .

ex:y-331 a chart:Axis ;
    chart:label "" .

ex:series-331-1 a chart:Series .

ex:mark-331-1-1 a chart:DataPoint ;
    chart:series ex:series-331-1 ;
    chart:category "Production in thousand boxes 1999/2000" ;
    chart:value "66980"^^xsd:decimal .

