@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-4563 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "How did bullying impact you ?" ;
    chart:xAxis ex:x-4563 ;
    chart:yAxis ex:y-4563 .

ex:x-4563 a chart:Axis ;
    chart:label "Response" .

ex:y-4563 a chart:Axis ;
    chart:label "" .

ex:series-4563-1 a chart:Series .

ex:mark-4563-1-1 a chart:DataPoint ;
    chart:series ex:series-4563-1 ;
    chart:category "Share of respondents Developed depression" ;
    chart:value "0.45"^^xsd:decimal .

ex:mark-4563-1-2 a chart:DataPoint ;
    chart:series ex:series-4563-1 ;
    chart:category "Developed social anxiety" ;
    chart:value "0.41"^^xsd:decimal .

ex:mark-4563-1-3 a chart:DataPoint ;
    chart:series ex:series-4563-1 ;
    chart:category "Have had suicidal thoughts" ;
    chart:value "0.33"^^xsd:decimal .

ex:mark-4563-1-4 a chart:DataPoint ;
    chart:series ex:series-4563-1 ;
    chart:category "Have self-harmed" ;
    chart:value "0.26"^^xsd:decimal .

ex:mark-4563-1-5 a chart:DataPoint ;
    chart:series ex:series-4563-1 ;
    chart:category "Have truanted from school of college" ;
    chart:value "0.2"^^xsd:decimal .

ex:mark-4563-1-6 a chart:DataPoint ;
    chart:series ex:series-4563-1 ;
    chart:category "Have developed anti-social behaviors" ;
    chart:value "0.13"^^xsd:decimal .

ex:mark-4563-1-7 a chart:DataPoint ;
    chart:series ex:series-4563-1 ;
    chart:category "Developed an eating disorder" ;
    chart:value "0.12"^^xsd:decimal .

ex:mark-4563-1-8 a chart:DataPoint ;
    chart:series ex:series-4563-1 ;
    chart:category "Ran away from home" ;
    chart:value "0.09"^^xsd:decimal .

ex:mark-4563-1-9 a chart:DataPoint ;
    chart:series ex:series-4563-1 ;
    chart:category "Have abused drugs and/or alcohol" ;
    chart:value "0.06"^^xsd:decimal .

ex:mark-4563-1-10 a chart:DataPoint ;
    chart:series ex:series-4563-1 ;
    chart:category "Have engaged in risky social behaviour" ;
    chart:value "0.04"^^xsd:decimal .
