@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-5189 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Ranking of countries with the highest share of alcohol-related deaths in 2012" ;
    chart:xAxis ex:x-5189 ;
    chart:yAxis ex:y-5189 .

ex:x-5189 a chart:Axis ;
    chart:label "Response" .

ex:y-5189 a chart:Axis ;
    chart:label "Share of alcohol-attributable deaths while the x-axis plots Response" .

ex:series-5189-1 a chart:Series .

ex:mark-5189-1-1 a chart:DataPoint ;
    chart:series ex:series-5189-1 ;
    chart:category "Share of alcohol-attributable deaths Belarus" ;
    chart:value "0.347"^^xsd:decimal .

