@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-5671 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Number of employees from the leading travel agencies worldwide in 2016" ;
    chart:xAxis ex:x-5671 ;
    chart:yAxis ex:y-5671 .

ex:x-5671 a chart:Axis ;
    chart:label "travel agencies" .

ex:y-5671 a chart:Axis ;
    chart:label "Number of employees while the x-axis shows travel agencies" .

ex:series-5671-1 a chart:Series .

ex:mark-5671-1-1 a chart:DataPoint ;
    chart:series ex:series-5671-1 ;
    chart:category "agencies Number of employees Expedia Inc.*" ;
    chart:value "20000"^^xsd:decimal .

