@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-6232 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Monthly average daily temperatures in the United Kingdom (UK) from 2015 to 2020 (in degrees Celsius)" ;
    chart:xAxis ex:x-6232 ;
    chart:yAxis ex:y-6232 .

ex:x-6232 a chart:Axis ;
    chart:label "2020" .

ex:y-6232 a chart:Axis ;
    chart:label "Month" .

ex:series-6232-1 a chart:Series .

ex:mark-6232-1-1 a chart:DataPoint ;
    chart:series ex:series-6232-1 ;
    chart:category "Aug" ;
    chart:value "15.7"^^xsd:decimal .

ex:mark-6232-1-2 a chart:DataPoint ;
    chart:series ex:series-6232-1 ;
    chart:category "Jul" ;
    chart:value "15.1"^^xsd:decimal .

ex:mark-6232-1-3 a chart:DataPoint ;
    chart:series ex:series-6232-1 ;
    chart:category "Jun" ;
    chart:value "12.6"^^xsd:decimal .

ex:mark-6232-1-4 a chart:DataPoint ;
    chart:series ex:series-6232-1 ;
    chart:category "May" ;
    chart:value "10.3"^^xsd:decimal .

ex:mark-6232-1-5 a chart:DataPoint ;
    chart:series ex:series-6232-1 ;
    chart:category "Apr" ;
    chart:value "6.8"^^xsd:decimal .

ex:mark-6232-1-6 a chart:DataPoint ;
    chart:series ex:series-6232-1 ;
    chart:category "Mar" ;
    chart:value "6.4"^^xsd:decimal .

ex:mark-6232-1-7 a chart:DataPoint ;
    chart:series ex:series-6232-1 ;
    chart:category "Feb" ;
    chart:value "6.7"^^xsd:decimal .
