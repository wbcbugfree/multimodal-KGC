@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-5139 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Revenue of the Brooklyn Nets from 2001/02 to 2018/19 (in million U.S. dollars)" ;
    chart:xAxis ex:x-5139 ;
    chart:yAxis ex:y-5139 .

ex:x-5139 a chart:Axis ;
    chart:label "Revenue in million U" .

ex:y-5139 a chart:Axis ;
    chart:label "Year while the x-axis measures Revenue in million U" .

ex:series-5139-1 a chart:Series .

