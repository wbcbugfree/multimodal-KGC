@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-4049 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Leading U.S. states based on value of barley production in 2018 (in 1,000 U.S. dollars)" ;
    chart:xAxis ex:x-4049 ;
    chart:yAxis ex:y-4049 .

