@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-7700 a chart:Chart ;
    chart:chartType "area" ;
    chart:title "Population of Finland from 2009 to 2019 , by language (in thousands)" ;
    chart:xAxis ex:x-7700 ;
    chart:yAxis ex:y-7700 .

ex:x-7700 a chart:Axis ;
    chart:label "Year" .

ex:y-7700 a chart:Axis ;
    chart:label "Swedish" .

ex:series-7700-1 a chart:Series .

ex:mark-7700-1-1 a chart:DataPoint ;
    chart:series ex:series-7700-1 ;
    chart:category "Dec" ;
    chart:value "31"^^xsd:decimal .

