@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-1205 a chart:Chart ;
    chart:chartType "line" ;
    chart:title "Infant mortality rate in Luxembourg from 2008 to 2019 (per 1,000 live births)" ;
    chart:xAxis ex:x-1205 ;
    chart:yAxis ex:y-1205 .

ex:x-1205 a chart:Axis ;
    chart:label "Year while the y-axis plots Infant mortality rate per thousand live births" .

ex:y-1205 a chart:Axis ;
    chart:label "" .

ex:series-1205-1 a chart:Series .

ex:mark-1205-1-1 a chart:DataPoint ;
    chart:series ex:series-1205-1 ;
    chart:category "Infant mortality rate per thousand live births Dec" ;
    chart:value "31"^^xsd:decimal .

ex:mark-1205-1-2 a chart:DataPoint ;
    chart:series ex:series-1205-1 ;
    chart:category "Dec" ;
    chart:value "31"^^xsd:decimal .

