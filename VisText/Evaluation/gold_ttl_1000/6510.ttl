@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-6510 a chart:Chart ;
    chart:chartType "line" ;
    chart:title "Lithuania : Distribution of gross domestic product (GDP) across economic sectors from 2009 to 2019" ;
    chart:xAxis ex:x-6510 ;
    chart:yAxis ex:y-6510 .

ex:x-6510 a chart:Axis ;
    chart:label "Year" .

ex:y-6510 a chart:Axis ;
    chart:label "" .

ex:series-6510-1 a chart:Series .

ex:mark-6510-1-1 a chart:DataPoint ;
    chart:series ex:series-6510-1 ;
    chart:category "Agriculture Dec" ;
    chart:value "31"^^xsd:decimal .

