@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-2433 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Democratic Republic of the Congo : Budget balance between 2015 to 2025 in relation to GDP" ;
    chart:xAxis ex:x-2433 ;
    chart:yAxis ex:y-2433 .

ex:x-2433 a chart:Axis ;
    chart:label "Budget balance in relation to GDP" .

ex:y-2433 a chart:Axis ;
    chart:label "Year" .

ex:series-2433-1 a chart:Series .

ex:mark-2433-1-1 a chart:DataPoint ;
    chart:series ex:series-2433-1 ;
    chart:category "−0.0088 2025* −0.0092 2024* −0.0067 2023* −0.0027 ..." ;
    chart:value "2019"^^xsd:decimal .

ex:mark-2433-1-2 a chart:DataPoint ;
    chart:series ex:series-2433-1 ;
    chart:category "−0.0005" ;
    chart:value "2018"^^xsd:decimal .

ex:mark-2433-1-3 a chart:DataPoint ;
    chart:series ex:series-2433-1 ;
    chart:category "−0.005" ;
    chart:value "2016"^^xsd:decimal .

ex:mark-2433-1-4 a chart:DataPoint ;
    chart:series ex:series-2433-1 ;
    chart:category "−0.0041" ;
    chart:value "2015"^^xsd:decimal .
