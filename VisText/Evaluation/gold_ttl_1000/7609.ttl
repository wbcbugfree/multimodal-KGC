@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-7609 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Average spending per consumer on selected music activities in the United States as of July 2018" ;
    chart:xAxis ex:x-7609 ;
    chart:yAxis ex:y-7609 .

ex:x-7609 a chart:Axis ;
    chart:label "Response" .

ex:y-7609 a chart:Axis ;
    chart:label "" .

ex:series-7609-1 a chart:Series .

ex:mark-7609-1-1 a chart:DataPoint ;
    chart:series ex:series-7609-1 ;
    chart:category "$40 to $99.99 Tickets for music concerts/gigs" ;
    chart:value "0.31"^^xsd:decimal .

ex:mark-7609-1-2 a chart:DataPoint ;
    chart:series ex:series-7609-1 ;
    chart:category "Tickets for festivals" ;
    chart:value "0.35"^^xsd:decimal .

