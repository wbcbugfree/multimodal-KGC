@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-3864 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Most-affected countries and territories of explosive violence worldwide in 2013 , ranked by average civilian casualties per incident" ;
    chart:xAxis ex:x-3864 ;
    chart:yAxis ex:y-3864 .

