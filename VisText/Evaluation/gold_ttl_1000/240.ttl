@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-240 a chart:Chart ;
    chart:chartType "line" ;
    chart:title "Budget expenditure of the central government in Norway from 2010 to 2020 (in billion NOK)" ;
    chart:xAxis ex:x-240 ;
    chart:yAxis ex:y-240 .

ex:x-240 a chart:Axis ;
    chart:label "Year while the y-axis plots Expenditure in billion NOK" .

ex:y-240 a chart:Axis ;
    chart:label "" .

ex:series-240-1 a chart:Series .

ex:mark-240-1-1 a chart:DataPoint ;
    chart:series ex:series-240-1 ;
    chart:category "Expenditure in billion NOK Dec" ;
    chart:value "31"^^xsd:decimal .

ex:mark-240-1-2 a chart:DataPoint ;
    chart:series ex:series-240-1 ;
    chart:category "Dec" ;
    chart:value "31"^^xsd:decimal .

