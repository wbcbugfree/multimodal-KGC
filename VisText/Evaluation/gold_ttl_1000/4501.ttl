@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-4501 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Leading markets based on Tinder iOS revenue in 3rd quarter 2020 (in million U.S. dollars)" ;
    chart:xAxis ex:x-4501 ;
    chart:yAxis ex:y-4501 .

ex:x-4501 a chart:Axis ;
    chart:label "Country" .

ex:y-4501 a chart:Axis ;
    chart:label "" .

ex:series-4501-1 a chart:Series .

ex:mark-4501-1-1 a chart:DataPoint ;
    chart:series ex:series-4501-1 ;
    chart:category "Revenue in million U.S. dollars United States" ;
    chart:value "11.07"^^xsd:decimal .

