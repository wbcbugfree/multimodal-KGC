@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-7903 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Most popular Google Play app store categories from 1st quarter 2016 to 1st quarter 2020 , by number of downloads (in millions)" ;
    chart:xAxis ex:x-7903 ;
    chart:yAxis ex:y-7903 .

ex:x-7903 a chart:Axis ;
    chart:label "Quarter" .

ex:y-7903 a chart:Axis ;
    chart:label "Communication" .

ex:series-7903-1 a chart:Series .

