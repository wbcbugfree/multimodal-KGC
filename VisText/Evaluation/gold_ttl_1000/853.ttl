@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-853 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Denver Broncos all-time leaders number of touchdowns scored from 1960 to 2020" ;
    chart:xAxis ex:x-853 ;
    chart:yAxis ex:y-853 .

ex:x-853 a chart:Axis ;
    chart:label "Touchdowns scored while the y-axis measures Denver Broncos all-time leaders" .

ex:y-853 a chart:Axis ;
    chart:label "Denver Broncos all-time leaders" .

