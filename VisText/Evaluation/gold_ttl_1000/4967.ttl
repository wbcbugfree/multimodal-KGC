@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-4967 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Leading ten national and international DIY retailers in Italy as of June 2020 , by number of stores" ;
    chart:xAxis ex:x-4967 ;
    chart:yAxis ex:y-4967 .

ex:x-4967 a chart:Axis ;
    chart:label "Number of stores" .

ex:y-4967 a chart:Axis ;
    chart:label "DIY retailers" .

ex:series-4967-1 a chart:Series .

