@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-8511 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Employment rate in major developed countries from Q2 2016 to Q2 2020" ;
    chart:xAxis ex:x-8511 ;
    chart:yAxis ex:y-8511 .

ex:x-8511 a chart:Axis ;
    chart:label "United States" .

ex:y-8511 a chart:Axis ;
    chart:label "Quarter" .

ex:series-8511-1 a chart:Series .

ex:mark-8511-1-1 a chart:DataPoint ;
    chart:series ex:series-8511-1 ;
    chart:category "Q2" ;
    chart:value "2020"^^xsd:decimal .

