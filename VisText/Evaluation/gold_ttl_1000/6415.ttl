ex:mark-6415-1-5 a chart:DataPoint ;
    chart:series ex:series-6415-1 ;
    chart:category "I prefer to walk/cycle" ;
    chart:value "0.06"^^xsd:decimal .

ex:mark-6415-1-6 a chart:DataPoint ;
    chart:series ex:series-6415-1 ;
    chart:category "Buses are not frequent enough/do not run when I ne..." ;
    chart:value "0.05"^^xsd:decimal .

ex:mark-6415-1-7 a chart:DataPoint ;
    chart:series ex:series-6415-1 ;
    chart:category "Buses do not go to/go directly to places where I w..." ;
    chart:value "0.04"^^xsd:decimal .

ex:mark-6415-1-8 a chart:DataPoint ;
    chart:series ex:series-6415-1 ;
    chart:category "Bus fares are too high" ;
    chart:value "0.03"^^xsd:decimal .

ex:mark-6415-1-9 a chart:DataPoint ;
    chart:series ex:series-6415-1 ;
    chart:category "Journeys take too long by bus" ;
    chart:value "0.02"^^xsd:decimal .

ex:mark-6415-1-10 a chart:DataPoint ;
    chart:series ex:series-6415-1 ;
    chart:category "I have difficulty getting on and off buses" ;
    chart:value "0.02"^^xsd:decimal .

ex:mark-6415-1-11 a chart:DataPoint ;
    chart:series ex:series-6415-1 ;
    chart:category "The nearest bus stop is too far away" ;
    chart:value "0.02"^^xsd:decimal .

ex:mark-6415-1-12 a chart:DataPoint ;
    chart:series ex:series-6415-1 ;
    chart:category "It is cheaper by car" ;
