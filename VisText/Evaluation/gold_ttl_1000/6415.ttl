@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-6415 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Why do n't you use / what is the main reason you do n't use local bus services (more often) ?" ;
    chart:xAxis ex:x-6415 ;
    chart:yAxis ex:y-6415 .

ex:x-6415 a chart:Axis ;
    chart:label "Main" .

ex:y-6415 a chart:Axis ;
    chart:label "" .

ex:series-6415-1 a chart:Series .

ex:mark-6415-1-1 a chart:DataPoint ;
    chart:series ex:series-6415-1 ;
    chart:category "reason Response" ;
    chart:value "0.46"^^xsd:decimal .

ex:mark-6415-1-2 a chart:DataPoint ;
    chart:series ex:series-6415-1 ;
    chart:category "It is easier/more convenient by car" ;
    chart:value "0.11"^^xsd:decimal .

ex:mark-6415-1-3 a chart:DataPoint ;
