@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-3008 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Public sector expenditure on water supply in the United Kingdom (UK) from 2009/10 to 2019/20 (in million GBP)" ;
    chart:xAxis ex:x-3008 ;
    chart:yAxis ex:y-3008 .

ex:x-3008 a chart:Axis ;
    chart:label "Expenditure in million GBP" .

ex:y-3008 a chart:Axis ;
    chart:label "" .

ex:series-3008-1 a chart:Series .

ex:mark-3008-1-1 a chart:DataPoint ;
    chart:series ex:series-3008-1 ;
    chart:category "in million GBP Year" ;
    chart:value "798"^^xsd:decimal .

