@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-2181 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Top ten cities worldwide with the largest share of billionaires who inherited their wealth in 2015" ;
    chart:xAxis ex:x-2181 ;
    chart:yAxis ex:y-2181 .

ex:x-2181 a chart:Axis ;
    chart:label "Response" .

ex:y-2181 a chart:Axis ;
    chart:label "Share of billionaires who inherited while the x-axis plots Response" .

ex:series-2181-1 a chart:Series .

ex:mark-2181-1-1 a chart:DataPoint ;
    chart:series ex:series-2181-1 ;
    chart:category "Share of billionaires who inherited Bielefeld-Detm..." ;
    chart:value "0.82"^^xsd:decimal .

ex:mark-2181-1-2 a chart:DataPoint ;
    chart:series ex:series-2181-1 ;
    chart:category "Nice, Monaco" ;
    chart:value "0.8"^^xsd:decimal .

ex:mark-2181-1-3 a chart:DataPoint ;
    chart:series ex:series-2181-1 ;
    chart:category "Sao Paulo" ;
    chart:value "0.74"^^xsd:decimal .

ex:mark-2181-1-4 a chart:DataPoint ;
    chart:series ex:series-2181-1 ;
    chart:category "Seoul" ;
    chart:value "0.72"^^xsd:decimal .

ex:mark-2181-1-5 a chart:DataPoint ;
    chart:series ex:series-2181-1 ;
    chart:category "Delhi" ;
    chart:value "0.71"^^xsd:decimal .

ex:mark-2181-1-6 a chart:DataPoint ;
    chart:series ex:series-2181-1 ;
    chart:category "Stockholm" ;
    chart:value "0.7"^^xsd:decimal .

ex:mark-2181-1-7 a chart:DataPoint ;
    chart:series ex:series-2181-1 ;
    chart:category "Mumbai" ;
    chart:value "0.67"^^xsd:decimal .

ex:mark-2181-1-8 a chart:DataPoint ;
    chart:series ex:series-2181-1 ;
    chart:category "Zurich" ;
    chart:value "0.67"^^xsd:decimal .

ex:mark-2181-1-9 a chart:DataPoint ;
    chart:series ex:series-2181-1 ;
    chart:category "Santiago" ;
    chart:value "0.67"^^xsd:decimal .

ex:mark-2181-1-10 a chart:DataPoint ;
    chart:series ex:series-2181-1 ;
    chart:category "Paris" ;
    chart:value "0.63"^^xsd:decimal .
