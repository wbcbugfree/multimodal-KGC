    chart:series ex:series-5003-1 ;
    chart:category "BMW" ;
    chart:value "5.3"^^xsd:decimal .

ex:mark-5003-1-6 a chart:DataPoint ;
    chart:series ex:series-5003-1 ;
    chart:category "Mercedes-Benz" ;
    chart:value "5.2"^^xsd:decimal .

ex:mark-5003-1-7 a chart:DataPoint ;
