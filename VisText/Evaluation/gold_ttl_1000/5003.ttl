@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-5003 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Most popular car brands among U.S. physicians as of 2012" ;
    chart:xAxis ex:x-5003 ;
    chart:yAxis ex:y-5003 .

ex:x-5003 a chart:Axis ;
    chart:label "Percentage of respondents" .

ex:y-5003 a chart:Axis ;
    chart:label "" .

ex:series-5003-1 a chart:Series .

ex:mark-5003-1-1 a chart:DataPoint ;
    chart:series ex:series-5003-1 ;
    chart:category "of respondents Response" ;
    chart:value "16.8"^^xsd:decimal .

ex:mark-5003-1-2 a chart:DataPoint ;
    chart:series ex:series-5003-1 ;
    chart:category "Toyota" ;
    chart:value "14.9"^^xsd:decimal .

