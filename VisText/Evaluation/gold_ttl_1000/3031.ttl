@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-3031 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Total number of acquired hospitals in U.S. hospital transactions from 2007 to 2017" ;
    chart:xAxis ex:x-3031 ;
    chart:yAxis ex:y-3031 .

ex:x-3031 a chart:Axis ;
    chart:label "Year" .

ex:y-3031 a chart:Axis ;
    chart:label "" .

ex:series-3031-1 a chart:Series .

ex:mark-3031-1-1 a chart:DataPoint ;
    chart:series ex:series-3031-1 ;
    chart:category "Number of acquired hospitals" ;
    chart:value "2017"^^xsd:decimal .

ex:mark-3031-1-2 a chart:DataPoint ;
    chart:series ex:series-3031-1 ;
    chart:category "2013*" ;
    chart:value "292"^^xsd:decimal .
