@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-5848 a chart:Chart ;
    chart:chartType "area" ;
    chart:title "Number of employees at Intel from 2004 to 2019 (in 1,000s)" ;
    chart:xAxis ex:x-5848 ;
    chart:yAxis ex:y-5848 .

ex:x-5848 a chart:Axis ;
    chart:label "Year" .

ex:y-5848 a chart:Axis ;
    chart:label "" .

ex:series-5848-1 a chart:Series .

ex:mark-5848-1-1 a chart:DataPoint ;
    chart:series ex:series-5848-1 ;
    chart:category "Number of employees in thousands Dec" ;
    chart:value "31"^^xsd:decimal .

