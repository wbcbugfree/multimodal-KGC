@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-1567 a chart:Chart ;
    chart:chartType "area" ;
    chart:title "Number of Toyota cars sold in France from 2009 to 2018" ;
    chart:xAxis ex:x-1567 ;
    chart:yAxis ex:y-1567 .

ex:x-1567 a chart:Axis ;
    chart:label "Year with linear scale with a minimum of 2010 and a maximum of 2016 while the y-axis plots Units sold" .

ex:y-1567 a chart:Axis ;
    chart:label "" .

ex:series-1567-1 a chart:Series .

ex:mark-1567-1-1 a chart:DataPoint ;
    chart:series ex:series-1567-1 ;
    chart:category "Units sold Dec" ;
    chart:value "31"^^xsd:decimal .

ex:mark-1567-1-2 a chart:DataPoint ;
    chart:series ex:series-1567-1 ;
    chart:category "Dec" ;
    chart:value "31"^^xsd:decimal .

