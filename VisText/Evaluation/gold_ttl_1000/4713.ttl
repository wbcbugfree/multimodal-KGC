ex:chart-4713 a chart:Chart ;
    chart:chartType "line" ;
    chart:title "Per capita consumption of fresh berries in the United States from 2000 to 2015 (in pounds)" ;
    chart:xAxis ex:x-4713 ;
    chart:yAxis ex:y-4713 .

