@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-7612 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Regional distribution of BBC network TV programming spending in the United Kingdom (UK) from 2012 to 2019" ;
    chart:xAxis ex:x-7612 ;
    chart:yAxis ex:y-7612 .

ex:x-7612 a chart:Axis ;
    chart:label "2014" .

ex:y-7612 a chart:Axis ;
    chart:label "geographic region" .

ex:series-7612-1 a chart:Series .

ex:mark-7612-1-1 a chart:DataPoint ;
    chart:series ex:series-7612-1 ;
    chart:category "Total nations and regions" ;
    chart:value "0.467"^^xsd:decimal .

ex:mark-7612-1-2 a chart:DataPoint ;
    chart:series ex:series-7612-1 ;
    chart:category "London" ;
    chart:value "0.352"^^xsd:decimal .

ex:mark-7612-1-3 a chart:DataPoint ;
    chart:series ex:series-7612-1 ;
    chart:category "Total regions excl. London" ;
    chart:value "0.231"^^xsd:decimal .

ex:mark-7612-1-4 a chart:DataPoint ;
    chart:series ex:series-7612-1 ;
    chart:category "North of England" ;
    chart:value "0.181"^^xsd:decimal .

ex:mark-7612-1-5 a chart:DataPoint ;
    chart:series ex:series-7612-1 ;
    chart:category "Total nations" ;
    chart:value "0.092"^^xsd:decimal .

ex:mark-7612-1-6 a chart:DataPoint ;
    chart:series ex:series-7612-1 ;
    chart:category "Scotland" ;
    chart:value "0.076"^^xsd:decimal .

ex:mark-7612-1-7 a chart:DataPoint ;
    chart:series ex:series-7612-1 ;
    chart:category "South of England" ;
    chart:value "0.065"^^xsd:decimal .

ex:mark-7612-1-8 a chart:DataPoint ;
    chart:series ex:series-7612-1 ;
    chart:category "Wales" ;
    chart:value "0.028"^^xsd:decimal .

ex:mark-7612-1-9 a chart:DataPoint ;
    chart:series ex:series-7612-1 ;
    chart:category "Multi-region**" ;
    chart:value "0.025"^^xsd:decimal .

ex:mark-7612-1-10 a chart:DataPoint ;
    chart:series ex:series-7612-1 ;
    chart:category "Northern Ireland" ;
    chart:value "0.017"^^xsd:decimal .
