@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-321 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Distribution of Amazon Dash button sales as of February 2016 , by brand" ;
    chart:xAxis ex:x-321 ;
    chart:yAxis ex:y-321 .

ex:x-321 a chart:Axis ;
    chart:label "Response with a categorical scale starting with Bounty and ending with Ziploc" .

ex:y-321 a chart:Axis ;
    chart:label "" .

ex:series-321-1 a chart:Series .

ex:mark-321-1-1 a chart:DataPoint ;
    chart:series ex:series-321-1 ;
    chart:category "Share of Amazon Dash Button sales Tide" ;
    chart:value "0.216"^^xsd:decimal .

ex:mark-321-1-2 a chart:DataPoint ;
    chart:series ex:series-321-1 ;
    chart:category "Cottonelle" ;
    chart:value "0.203"^^xsd:decimal .

ex:mark-321-1-3 a chart:DataPoint ;
    chart:series ex:series-321-1 ;
    chart:category "Bounty" ;
    chart:value "0.166"^^xsd:decimal .

ex:mark-321-1-4 a chart:DataPoint ;
    chart:series ex:series-321-1 ;
    chart:category "Glad" ;
    chart:value "0.12"^^xsd:decimal .

ex:mark-321-1-5 a chart:DataPoint ;
    chart:series ex:series-321-1 ;
    chart:category "Gatorade" ;
    chart:value "0.069"^^xsd:decimal .

ex:mark-321-1-6 a chart:DataPoint ;
    chart:series ex:series-321-1 ;
    chart:category "Mrs. Meyer's" ;
    chart:value "0.056"^^xsd:decimal .

ex:mark-321-1-7 a chart:DataPoint ;
    chart:series ex:series-321-1 ;
    chart:category "Gilette" ;
    chart:value "0.049"^^xsd:decimal .

ex:mark-321-1-8 a chart:DataPoint ;
    chart:series ex:series-321-1 ;
    chart:category "Smartwaiter" ;
    chart:value "0.046"^^xsd:decimal .

ex:mark-321-1-9 a chart:DataPoint ;
    chart:series ex:series-321-1 ;
    chart:category "Ziploc" ;
    chart:value "0.042"^^xsd:decimal .

ex:mark-321-1-10 a chart:DataPoint ;
    chart:series ex:series-321-1 ;
    chart:category "Huggies" ;
    chart:value "0.033"^^xsd:decimal .
