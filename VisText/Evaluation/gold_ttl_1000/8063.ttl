@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-8063 a chart:Chart ;
    chart:chartType "line" ;
    chart:title "Egypt : Distribution of gross domestic product (GDP) across economic sectors from 2009 to 2019" ;
    chart:xAxis ex:x-8063 ;
    chart:yAxis ex:y-8063 .

ex:x-8063 a chart:Axis ;
    chart:label "Year with linear scale from 2010 to 2018" .

ex:y-8063 a chart:Axis ;
    chart:label "Agriculture" .

ex:series-8063-1 a chart:Series .

ex:mark-8063-1-1 a chart:DataPoint ;
    chart:series ex:series-8063-1 ;
    chart:category "Dec" ;
    chart:value "31"^^xsd:decimal .

