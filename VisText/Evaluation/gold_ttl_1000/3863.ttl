@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-3863 a chart:Chart ;
    chart:chartType "line" ;
    chart:title "Turnover from retail sale of newspapers and periodicals in the United Kingdom (UK) from 2008 to 2018 (in million GBP)" ;
    chart:xAxis ex:x-3863 ;
    chart:yAxis ex:y-3863 .

ex:x-3863 a chart:Axis ;
    chart:label "Year" .

ex:y-3863 a chart:Axis ;
    chart:label "Turnover in million GBP" .

ex:series-3863-1 a chart:Series .

ex:mark-3863-1-1 a chart:DataPoint ;
    chart:series ex:series-3863-1 ;
    chart:category "Dec" ;
    chart:value "31"^^xsd:decimal .

