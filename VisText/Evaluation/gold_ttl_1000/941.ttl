@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-941 a chart:Chart ;
    chart:chartType "line" ;
    chart:title "Number of deaths from drug poisoning by codeine in England and Wales from 1993 to 2019" ;
    chart:xAxis ex:x-941 ;
    chart:yAxis ex:y-941 .

ex:x-941 a chart:Axis ;
    chart:label "Year" .

ex:y-941 a chart:Axis ;
    chart:label "" .

ex:series-941-1 a chart:Series .

ex:mark-941-1-1 a chart:DataPoint ;
    chart:series ex:series-941-1 ;
    chart:category "Number of deaths Dec" ;
    chart:value "31"^^xsd:decimal .

