@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-1667 a chart:Chart ;
    chart:chartType "line" ;
    chart:title "Number of Saab cars sold in Sweden from 2008 to 2018" ;
    chart:xAxis ex:x-1667 ;
    chart:yAxis ex:y-1667 .

ex:x-1667 a chart:Axis ;
    chart:label "Year with linear scale of range 2008 to 2016" .

ex:y-1667 a chart:Axis ;
    chart:label "Units sold" .

ex:series-1667-1 a chart:Series .

ex:mark-1667-1-1 a chart:DataPoint ;
    chart:series ex:series-1667-1 ;
    chart:category "Dec" ;
    chart:value "31"^^xsd:decimal .

