@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-8041 a chart:Chart ;
    chart:chartType "area" ;
    chart:title "Consumer satisfaction with select online news brands in the United States from 2007 to 2019 (index score)" ;
    chart:xAxis ex:x-8041 ;
    chart:yAxis ex:y-8041 .

ex:x-8041 a chart:Axis ;
    chart:label "Year" .

ex:y-8041 a chart:Axis ;
    chart:label "" .

ex:series-8041-1 a chart:Series .

ex:mark-8041-1-1 a chart:DataPoint ;
    chart:series ex:series-8041-1 ;
    chart:category "USATODAY.com Dec" ;
    chart:value "31"^^xsd:decimal .

