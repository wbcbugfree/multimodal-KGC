@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-5995 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Share of American women who have given oral sex to a female in their lifetime , by age group" ;
    chart:xAxis ex:x-5995 ;
    chart:yAxis ex:y-5995 .

ex:x-5995 a chart:Axis ;
    chart:label "Age group" .

ex:y-5995 a chart:Axis ;
    chart:label "" .

ex:series-5995-1 a chart:Series .

ex:mark-5995-1-1 a chart:DataPoint ;
    chart:series ex:series-5995-1 ;
    chart:category "group Share of respondents 14-15" ;
    chart:value "0.054"^^xsd:decimal .

ex:mark-5995-1-2 a chart:DataPoint ;
    chart:series ex:series-5995-1 ;
    chart:category "16-17" ;
    chart:value "0.09"^^xsd:decimal .

ex:mark-5995-1-3 a chart:DataPoint ;
    chart:series ex:series-5995-1 ;
    chart:category "18-19" ;
    chart:value "0.08"^^xsd:decimal .

ex:mark-5995-1-4 a chart:DataPoint ;
    chart:series ex:series-5995-1 ;
    chart:category "20-24" ;
    chart:value "0.14"^^xsd:decimal .

ex:mark-5995-1-5 a chart:DataPoint ;
    chart:series ex:series-5995-1 ;
    chart:category "25-29" ;
    chart:value "0.1"^^xsd:decimal .

ex:mark-5995-1-6 a chart:DataPoint ;
    chart:series ex:series-5995-1 ;
    chart:category "30-39" ;
    chart:value "0.14"^^xsd:decimal .

ex:mark-5995-1-7 a chart:DataPoint ;
    chart:series ex:series-5995-1 ;
    chart:category "40-49" ;
    chart:value "0.12"^^xsd:decimal .

ex:mark-5995-1-8 a chart:DataPoint ;
    chart:series ex:series-5995-1 ;
    chart:category "50-59" ;
    chart:value "0.07"^^xsd:decimal .

ex:mark-5995-1-9 a chart:DataPoint ;
    chart:series ex:series-5995-1 ;
    chart:category "60-69" ;
    chart:value "0.03"^^xsd:decimal .

ex:mark-5995-1-10 a chart:DataPoint ;
    chart:series ex:series-5995-1 ;
    chart:category "and older" ;
    chart:value "0.02"^^xsd:decimal .
