@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-4565 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "U.S. states with the lowest cancer incidence rates in 2016 (per 100,000 population)" ;
    chart:xAxis ex:x-4565 ;
    chart:yAxis ex:y-4565 .

ex:x-4565 a chart:Axis ;
    chart:label "Cancer incidence per 100,000 population" .

ex:y-4565 a chart:Axis ;
    chart:label "State while the x-axis plots Cancer incidence per 100,000 population" .

ex:series-4565-1 a chart:Series .

ex:mark-4565-1-1 a chart:DataPoint ;
    chart:series ex:series-4565-1 ;
    chart:category "incidence per" ;
    chart:value "100000"^^xsd:decimal .

ex:mark-4565-1-2 a chart:DataPoint ;
    chart:series ex:series-4565-1 ;
    chart:category "population State" ;
    chart:value "359.4"^^xsd:decimal .

ex:mark-4565-1-3 a chart:DataPoint ;
    chart:series ex:series-4565-1 ;
    chart:category "New Mexico" ;
    chart:value "376.3"^^xsd:decimal .

ex:mark-4565-1-4 a chart:DataPoint ;
    chart:series ex:series-4565-1 ;
    chart:category "Arizona" ;
    chart:value "378.3"^^xsd:decimal .

ex:mark-4565-1-5 a chart:DataPoint ;
    chart:series ex:series-4565-1 ;
    chart:category "District of Columbia" ;
    chart:value "385"^^xsd:decimal .

ex:mark-4565-1-6 a chart:DataPoint ;
    chart:series ex:series-4565-1 ;
    chart:category "Nevada" ;
    chart:value "385.6"^^xsd:decimal .

ex:mark-4565-1-7 a chart:DataPoint ;
    chart:series ex:series-4565-1 ;
    chart:category "California" ;
    chart:value "388.8"^^xsd:decimal .

ex:mark-4565-1-8 a chart:DataPoint ;
    chart:series ex:series-4565-1 ;
    chart:category "Colorado" ;
    chart:value "390.6"^^xsd:decimal .

ex:mark-4565-1-9 a chart:DataPoint ;
    chart:series ex:series-4565-1 ;
    chart:category "Utah" ;
    chart:value "391.8"^^xsd:decimal .

ex:mark-4565-1-10 a chart:DataPoint ;
    chart:series ex:series-4565-1 ;
    chart:category "Texas" ;
    chart:value "402.3"^^xsd:decimal .

ex:mark-4565-1-11 a chart:DataPoint ;
