@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-1073 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "What keeps you from joining a health club now ?" ;
    chart:xAxis ex:x-1073 ;
    chart:yAxis ex:y-1073 .

ex:x-1073 a chart:Axis ;
    chart:label "Percentage of respondents with a linear scale with a minimum of 0" .

ex:y-1073 a chart:Axis ;
    chart:label "" .

ex:series-1073-1 a chart:Series .

ex:mark-1073-1-1 a chart:DataPoint ;
    chart:series ex:series-1073-1 ;
    chart:category "of respondents Response" ;
    chart:value "0.54"^^xsd:decimal .

ex:mark-1073-1-2 a chart:DataPoint ;
    chart:series ex:series-1073-1 ;
    chart:category "Too expensive / cannot afford it" ;
    chart:value "0.27"^^xsd:decimal .

ex:mark-1073-1-3 a chart:DataPoint ;
    chart:series ex:series-1073-1 ;
    chart:category "I exercise somewhere else for free" ;
    chart:value "0.18"^^xsd:decimal .

ex:mark-1073-1-4 a chart:DataPoint ;
    chart:series ex:series-1073-1 ;
    chart:category "No time" ;
    chart:value "0.18"^^xsd:decimal .

ex:mark-1073-1-5 a chart:DataPoint ;
    chart:series ex:series-1073-1 ;
    chart:category "I do not exercise" ;
    chart:value "0.17"^^xsd:decimal .

ex:mark-1073-1-6 a chart:DataPoint ;
    chart:series ex:series-1073-1 ;
    chart:category "I would feel out of place" ;
    chart:value "0.13"^^xsd:decimal .

ex:mark-1073-1-7 a chart:DataPoint ;
    chart:series ex:series-1073-1 ;
    chart:category "I participate in another type of exercise outside ..." ;
    chart:value "0.12"^^xsd:decimal .

ex:mark-1073-1-8 a chart:DataPoint ;
    chart:series ex:series-1073-1 ;
    chart:category "There is no health club located close to me" ;
    chart:value "0.1"^^xsd:decimal .

ex:mark-1073-1-9 a chart:DataPoint ;
    chart:series ex:series-1073-1 ;
    chart:category "It's too crowded" ;
    chart:value "0.09"^^xsd:decimal .

ex:mark-1073-1-10 a chart:DataPoint ;
    chart:series ex:series-1073-1 ;
    chart:category "Nobody I know goes to a health club" ;
    chart:value "0.09"^^xsd:decimal .

ex:mark-1073-1-11 a chart:DataPoint ;
    chart:series ex:series-1073-1 ;
    chart:category "I don't know what I would do there" ;
    chart:value "0.09"^^xsd:decimal .

ex:mark-1073-1-12 a chart:DataPoint ;
    chart:series ex:series-1073-1 ;
    chart:category "I have an injury / surgery / other condition and t..." ;
    chart:value "0.08"^^xsd:decimal .

ex:mark-1073-1-13 a chart:DataPoint ;
    chart:series ex:series-1073-1 ;
    chart:category "I am too out of shape to even think about it" ;
    chart:value "0.03"^^xsd:decimal .

ex:mark-1073-1-14 a chart:DataPoint ;
    chart:series ex:series-1073-1 ;
    chart:category "I am not sure there is someone there to guide" ;
    chart:value "0.03"^^xsd:decimal .
