@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-2604 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Installed power capacity across Uttarakhand in India from financial year 2005 to 2018 (in megawatts)" ;
    chart:xAxis ex:x-2604 ;
    chart:yAxis ex:y-2604 .

ex:x-2604 a chart:Axis ;
    chart:label "Installed power capacity in megawatts while the y-axis shows year" .

ex:y-2604 a chart:Axis ;
    chart:label "year" .

ex:series-2604-1 a chart:Series .

ex:mark-2604-1-1 a chart:DataPoint ;
    chart:series ex:series-2604-1 ;
    chart:category "FY" ;
    chart:value "2018"^^xsd:decimal .

ex:mark-2604-1-2 a chart:DataPoint ;
    chart:series ex:series-2604-1 ;
    chart:category "FY" ;
    chart:value "2017"^^xsd:decimal .

