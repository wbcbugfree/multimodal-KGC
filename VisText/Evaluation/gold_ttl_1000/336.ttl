@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-336 a chart:Chart ;
    chart:chartType "area" ;
    chart:title "Ecolab 's net income from 2009 to 2019 (in million U.S. dollars)" ;
    chart:xAxis ex:x-336 ;
    chart:yAxis ex:y-336 .

ex:x-336 a chart:Axis ;
    chart:label "Year while the y-axis shows Net income in million U" .

ex:y-336 a chart:Axis ;
    chart:label "Net income in million U" .

ex:series-336-1 a chart:Series .

ex:mark-336-1-1 a chart:DataPoint ;
    chart:series ex:series-336-1 ;
    chart:category "Net income in million U.S. dollars Dec" ;
    chart:value "31"^^xsd:decimal .

ex:mark-336-1-2 a chart:DataPoint ;
    chart:series ex:series-336-1 ;
    chart:category "Dec" ;
    chart:value "31"^^xsd:decimal .

