@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-2696 a chart:Chart ;
    chart:chartType "area" ;
    chart:title "Laos : Fertility rate from 2008 to 2018" ;
    chart:xAxis ex:x-2696 ;
    chart:yAxis ex:y-2696 .

ex:x-2696 a chart:Axis ;
    chart:label "Year" .

ex:y-2696 a chart:Axis ;
    chart:label "" .

ex:series-2696-1 a chart:Series .

ex:mark-2696-1-1 a chart:DataPoint ;
    chart:series ex:series-2696-1 ;
    chart:category "Number of children born per woman Dec" ;
    chart:value "31"^^xsd:decimal .

