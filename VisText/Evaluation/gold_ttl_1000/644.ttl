@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-644 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Estimated year-on-year revenue growth rate of selected major public appare...ilers in the United Kingdom (UK) in the fiscal year 2017 (in million GBP)" ;
    chart:xAxis ex:x-644 ;
    chart:yAxis ex:y-644 .

ex:x-644 a chart:Axis ;
    chart:label "Revenue growth rate" .

ex:y-644 a chart:Axis ;
    chart:label "major public apparel retailers" .

ex:series-644-1 a chart:Series .

ex:mark-644-1-1 a chart:DataPoint ;
    chart:series ex:series-644-1 ;
    chart:category "Boohoo.com" ;
    chart:value "0.241"^^xsd:decimal .

ex:mark-644-1-2 a chart:DataPoint ;
    chart:series ex:series-644-1 ;
    chart:category "ASOS" ;
    chart:value "0.147"^^xsd:decimal .

ex:mark-644-1-3 a chart:DataPoint ;
    chart:series ex:series-644-1 ;
    chart:category "Ted Baker" ;
    chart:value "0.144"^^xsd:decimal .

ex:mark-644-1-4 a chart:DataPoint ;
    chart:series ex:series-644-1 ;
    chart:category "SuperGroup" ;
    chart:value "0.137"^^xsd:decimal .

ex:mark-644-1-5 a chart:DataPoint ;
    chart:series ex:series-644-1 ;
    chart:category "JD Sports" ;
    chart:value "0.121"^^xsd:decimal .

ex:mark-644-1-6 a chart:DataPoint ;
    chart:series ex:series-644-1 ;
    chart:category "Primark UK" ;
    chart:value "0.083"^^xsd:decimal .

ex:mark-644-1-7 a chart:DataPoint ;
    chart:series ex:series-644-1 ;
    chart:category "Sports Direct" ;
    chart:value "0.008"^^xsd:decimal .

ex:mark-644-1-8 a chart:DataPoint ;
    chart:series ex:series-644-1 ;
    chart:category "Bonmarche" ;
    chart:value "0.006"^^xsd:decimal .

ex:mark-644-1-9 a chart:DataPoint ;
    chart:series ex:series-644-1 ;
    chart:category "Debenhams" ;
    chart:value "0.004"^^xsd:decimal .
