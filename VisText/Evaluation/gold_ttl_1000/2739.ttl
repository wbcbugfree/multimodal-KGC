@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-2739 a chart:Chart ;
    chart:chartType "area" ;
    chart:title "Machinery and equipment price index in Canada from 2006 to 2016" ;
    chart:xAxis ex:x-2739 ;
    chart:yAxis ex:y-2739 .

ex:x-2739 a chart:Axis ;
    chart:label "Year while the y-axis measures Price index" .

ex:y-2739 a chart:Axis ;
    chart:label "Price index" .

ex:series-2739-1 a chart:Series .

ex:mark-2739-1-1 a chart:DataPoint ;
    chart:series ex:series-2739-1 ;
    chart:category "Dec" ;
    chart:value "31"^^xsd:decimal .

