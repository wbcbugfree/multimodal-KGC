@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-6835 a chart:Chart ;
    chart:chartType "area" ;
    chart:title "Population in Sweden from 2009 to 2019 , by age group (in 1,000s)" ;
    chart:xAxis ex:x-6835 ;
    chart:yAxis ex:y-6835 .

ex:x-6835 a chart:Axis ;
    chart:label "Year" .

ex:y-6835 a chart:Axis ;
    chart:label "85-94 years while the x-axis measures Year" .

ex:series-6835-1 a chart:Series .

ex:mark-6835-1-1 a chart:DataPoint ;
    chart:series ex:series-6835-1 ;
    chart:category "85-94 years Dec" ;
    chart:value "31"^^xsd:decimal .

