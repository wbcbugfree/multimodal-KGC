@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-2485 a chart:Chart ;
    chart:chartType "area" ;
    chart:title "Number of Abercrombie & Fitch stores worldwide from 1998 to 2019" ;
    chart:xAxis ex:x-2485 ;
    chart:yAxis ex:y-2485 .

ex:x-2485 a chart:Axis ;
    chart:label "Year" .

ex:y-2485 a chart:Axis ;
    chart:label "" .

ex:series-2485-1 a chart:Series .

ex:mark-2485-1-1 a chart:DataPoint ;
    chart:series ex:series-2485-1 ;
    chart:category "Number of stores Dec" ;
    chart:value "31"^^xsd:decimal .

