@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-635 a chart:Chart ;
    chart:chartType "line" ;
    chart:title "Pioneer Natural Resources ' total revenue from 2008 to 2019 (in million U.S. dollars)" ;
    chart:xAxis ex:x-635 ;
    chart:yAxis ex:y-635 .

ex:x-635 a chart:Axis ;
    chart:label "Year" .

ex:y-635 a chart:Axis ;
    chart:label "Revenue in million U" .

ex:series-635-1 a chart:Series .

ex:mark-635-1-1 a chart:DataPoint ;
    chart:series ex:series-635-1 ;
    chart:category "Revenue in million U.S. dollars Dec" ;
    chart:value "31"^^xsd:decimal .

