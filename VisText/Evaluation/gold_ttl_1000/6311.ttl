@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-6311 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Asus quarterly sales share worldwide from 2016 to 2020 , by product type" ;
    chart:xAxis ex:x-6311 ;
    chart:yAxis ex:y-6311 .

ex:x-6311 a chart:Axis ;
    chart:label "quarter" .

ex:y-6311 a chart:Axis ;
    chart:label "" .

ex:series-6311-1 a chart:Series .

ex:mark-6311-1-1 a chart:DataPoint ;
    chart:series ex:series-6311-1 ;
    chart:category "Component 1Q '16" ;
    chart:value "0.14"^^xsd:decimal .

