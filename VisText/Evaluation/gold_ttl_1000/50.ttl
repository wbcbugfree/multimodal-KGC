@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-50 a chart:Chart ;
    chart:chartType "line" ;
    chart:title "Number of hospital beds in Spain from 2010 to 2020" ;
    chart:xAxis ex:x-50 ;
    chart:yAxis ex:y-50 .

ex:x-50 a chart:Axis ;
    chart:label "Year while the y-axis shows Number of hospital beds" .

ex:y-50 a chart:Axis ;
    chart:label "Number of hospital beds" .

ex:series-50-1 a chart:Series .

ex:mark-50-1-1 a chart:DataPoint ;
    chart:series ex:series-50-1 ;
    chart:category "Dec" ;
    chart:value "31"^^xsd:decimal .

ex:mark-50-1-2 a chart:DataPoint ;
    chart:series ex:series-50-1 ;
    chart:category "Dec" ;
    chart:value "31"^^xsd:decimal .

