@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-3120 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Turnover from retail sale of food , beverages and tobacco in specialized stores in Croatia from 2008 to 2018 (in million euros)" ;
    chart:xAxis ex:x-3120 ;
    chart:yAxis ex:y-3120 .

ex:x-3120 a chart:Axis ;
    chart:label "Year" .

ex:y-3120 a chart:Axis ;
    chart:label "" .

ex:series-3120-1 a chart:Series .

ex:mark-3120-1-1 a chart:DataPoint ;
    chart:series ex:series-3120-1 ;
    chart:category "Annual turnover in million euros 2018*" ;
    chart:value "527.8"^^xsd:decimal .
