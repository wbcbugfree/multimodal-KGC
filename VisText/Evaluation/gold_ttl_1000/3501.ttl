@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-3501 a chart:Chart ;
    chart:chartType "line" ;
    chart:title "Number of Asian families with a single father in the U.S. from 2002 to 2019 (in 1,000s)" ;
    chart:xAxis ex:x-3501 ;
    chart:yAxis ex:y-3501 .

ex:x-3501 a chart:Axis ;
    chart:label "Year while the y-axis shows Families in thousands" .

ex:y-3501 a chart:Axis ;
    chart:label "Families in thousands" .

ex:series-3501-1 a chart:Series .

ex:mark-3501-1-1 a chart:DataPoint ;
    chart:series ex:series-3501-1 ;
    chart:category "Dec" ;
    chart:value "31"^^xsd:decimal .

