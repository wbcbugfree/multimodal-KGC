@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-957 a chart:Chart ;
    chart:chartType "line" ;
    chart:title "Number of reported motor vehicle theft cases in the United States from 1990 to 2019" ;
    chart:xAxis ex:x-957 ;
    chart:yAxis ex:y-957 .

ex:x-957 a chart:Axis ;
    chart:label "Year while the y-axis plots Number of reported cases" .

ex:y-957 a chart:Axis ;
    chart:label "" .

ex:series-957-1 a chart:Series .

ex:mark-957-1-1 a chart:DataPoint ;
    chart:series ex:series-957-1 ;
    chart:category "Number of reported cases Dec" ;
    chart:value "31"^^xsd:decimal .

