@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-4081 a chart:Chart ;
    chart:chartType "line" ;
    chart:title "Monsanto 's research and development (R & D) expenditure from 2008 to 2017 (in million U.S. dollars)" ;
    chart:xAxis ex:x-4081 ;
    chart:yAxis ex:y-4081 .

ex:x-4081 a chart:Axis ;
    chart:label "Year" .

ex:y-4081 a chart:Axis ;
    chart:label "" .

ex:series-4081-1 a chart:Series .

ex:mark-4081-1-1 a chart:DataPoint ;
    chart:series ex:series-4081-1 ;
    chart:category "Expenditure in million U.S. dollars Dec" ;
    chart:value "31"^^xsd:decimal .

