@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-2963 a chart:Chart ;
    chart:chartType "line" ;
    chart:title "Average monthly number of calls per mobile subscription in Sweden from 2007 to 2019" ;
    chart:xAxis ex:x-2963 ;
    chart:yAxis ex:y-2963 .

ex:x-2963 a chart:Axis ;
    chart:label "Year" .

ex:y-2963 a chart:Axis ;
    chart:label "Average number of calls per mobile subscription" .

ex:series-2963-1 a chart:Series .

ex:mark-2963-1-1 a chart:DataPoint ;
    chart:series ex:series-2963-1 ;
    chart:category "Dec" ;
    chart:value "31"^^xsd:decimal .

