ex:chart-3062 a chart:Chart ;
    chart:chartType "line" ;
    chart:title "Population of Australia from 1800 to 2020 (in millions)" ;
    chart:xAxis ex:x-3062 ;
    chart:yAxis ex:y-3062 .

ex:x-3062 a chart:Axis ;
    chart:label "Year with linear scale of range 1800 to 2000 while the y-axis shows Population in millions with linear scale of range 0 to 20" .

ex:y-3062 a chart:Axis ;
    chart:label "Population in millions" .

ex:series-3062-1 a chart:Series .

