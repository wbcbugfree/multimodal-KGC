@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-8221 a chart:Chart ;
    chart:chartType "area" ;
    chart:title "Honduras : Age structure from 2009 to 2019" ;
    chart:xAxis ex:x-8221 ;
    chart:yAxis ex:y-8221 .

ex:x-8221 a chart:Axis ;
    chart:label "Year" .

ex:y-8221 a chart:Axis ;
    chart:label "15-64 years" .

ex:series-8221-1 a chart:Series .

ex:mark-8221-1-1 a chart:DataPoint ;
    chart:series ex:series-8221-1 ;
    chart:category "Dec" ;
    chart:value "31"^^xsd:decimal .

