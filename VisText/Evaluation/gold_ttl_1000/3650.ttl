@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-3650 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Average value of CPC (cost per click) of online advertising campaigns in the real estate sector in Italy in 2018 , by city (in euros)" ;
    chart:xAxis ex:x-3650 ;
    chart:yAxis ex:y-3650 .

ex:x-3650 a chart:Axis ;
    chart:label "CPC in euros with scale from 0" .

ex:y-3650 a chart:Axis ;
    chart:label "city of Italy" .

ex:series-3650-1 a chart:Series .

ex:mark-3650-1-1 a chart:DataPoint ;
    chart:series ex:series-3650-1 ;
    chart:category "Milano" ;
    chart:value "0.28"^^xsd:decimal .

ex:mark-3650-1-2 a chart:DataPoint ;
    chart:series ex:series-3650-1 ;
    chart:category "Roma" ;
    chart:value "0.24"^^xsd:decimal .

ex:mark-3650-1-3 a chart:DataPoint ;
    chart:series ex:series-3650-1 ;
    chart:category "Torino" ;
    chart:value "0.22"^^xsd:decimal .

ex:mark-3650-1-4 a chart:DataPoint ;
    chart:series ex:series-3650-1 ;
    chart:category "Firenze" ;
    chart:value "0.18"^^xsd:decimal .

ex:mark-3650-1-5 a chart:DataPoint ;
    chart:series ex:series-3650-1 ;
    chart:category "Bologna" ;
    chart:value "0.18"^^xsd:decimal .

ex:mark-3650-1-6 a chart:DataPoint ;
    chart:series ex:series-3650-1 ;
    chart:category "Genova" ;
    chart:value "0.18"^^xsd:decimal .

ex:mark-3650-1-7 a chart:DataPoint ;
    chart:series ex:series-3650-1 ;
    chart:category "Napoli" ;
    chart:value "0.17"^^xsd:decimal .

ex:mark-3650-1-8 a chart:DataPoint ;
    chart:series ex:series-3650-1 ;
    chart:category "Palermo" ;
    chart:value "0.13"^^xsd:decimal .

ex:mark-3650-1-9 a chart:DataPoint ;
    chart:series ex:series-3650-1 ;
    chart:category "Venezia" ;
    chart:value "0.12"^^xsd:decimal .
