@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-3475 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Number of public pay phones in Germany from 2006 to 2019" ;
    chart:xAxis ex:x-3475 ;
    chart:yAxis ex:y-3475 .

ex:x-3475 a chart:Axis ;
    chart:label "Number" .

ex:y-3475 a chart:Axis ;
    chart:label "" .

ex:series-3475-1 a chart:Series .

ex:mark-3475-1-1 a chart:DataPoint ;
    chart:series ex:series-3475-1 ;
    chart:category "of public pay phones Year" ;
    chart:value "16000"^^xsd:decimal .

ex:mark-3475-1-2 a chart:DataPoint ;
    chart:series ex:series-3475-1 ;
    chart:category "2019*" ;
    chart:value "18000"^^xsd:decimal .
