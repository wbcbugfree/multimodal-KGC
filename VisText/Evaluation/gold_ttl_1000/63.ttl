@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-63 a chart:Chart ;
    chart:chartType "line" ;
    chart:title "Indiana Pacers franchise value from 2003 to 2020 (in million U.S. dollars)" ;
    chart:xAxis ex:x-63 ;
    chart:yAxis ex:y-63 .

ex:x-63 a chart:Axis ;
    chart:label "Year with a linear scale of range 2005 to 2015" .

ex:y-63 a chart:Axis ;
    chart:label "Franchise value in million U" .

ex:series-63-1 a chart:Series .

ex:mark-63-1-1 a chart:DataPoint ;
    chart:series ex:series-63-1 ;
    chart:category "Franchise value in million U.S. dollars Dec" ;
    chart:value "31"^^xsd:decimal .

