@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-3669 a chart:Chart ;
    chart:chartType "line" ;
    chart:title "Azerbaijan : Fertility rate from 2008 to 2018" ;
    chart:xAxis ex:x-3669 ;
    chart:yAxis ex:y-3669 .

ex:x-3669 a chart:Axis ;
    chart:label "Year" .

ex:y-3669 a chart:Axis ;
    chart:label "Number of children born per woman" .

ex:series-3669-1 a chart:Series .

ex:mark-3669-1-1 a chart:DataPoint ;
    chart:series ex:series-3669-1 ;
    chart:category "Dec" ;
    chart:value "31"^^xsd:decimal .

