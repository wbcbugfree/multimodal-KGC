@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-6798 a chart:Chart ;
    chart:chartType "line" ;
    chart:title "Total population of Argentina from 2008 to 2018 , by gender (in million inhabitants)" ;
    chart:xAxis ex:x-6798 ;
    chart:yAxis ex:y-6798 .

ex:x-6798 a chart:Axis ;
    chart:label "Year with linear scale with a minimum of 2008 and a maximum of 2016 while the y-axis plots Total with linear scale of range 0 to 40" .

ex:y-6798 a chart:Axis ;
    chart:label "" .

ex:series-6798-1 a chart:Series .

ex:mark-6798-1-1 a chart:DataPoint ;
    chart:series ex:series-6798-1 ;
    chart:category "Total Dec" ;
    chart:value "31"^^xsd:decimal .

