@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-3434 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Retail price index of potato in India from January to December 2019" ;
    chart:xAxis ex:x-3434 ;
    chart:yAxis ex:y-3434 .

ex:x-3434 a chart:Axis ;
    chart:label "Month" .

ex:y-3434 a chart:Axis ;
    chart:label "" .

ex:series-3434-1 a chart:Series .

ex:mark-3434-1-1 a chart:DataPoint ;
    chart:series ex:series-3434-1 ;
    chart:category "Retail price index December" ;
    chart:value "360.81"^^xsd:decimal .

