@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-3152 a chart:Chart ;
    chart:chartType "line" ;
    chart:title "Number of PwC employees worldwide from 2010 to 2020" ;
    chart:xAxis ex:x-3152 ;
    chart:yAxis ex:y-3152 .

ex:x-3152 a chart:Axis ;
    chart:label "Year" .

ex:y-3152 a chart:Axis ;
    chart:label "" .

ex:series-3152-1 a chart:Series .

ex:mark-3152-1-1 a chart:DataPoint ;
    chart:series ex:series-3152-1 ;
    chart:category "Number of employees Dec" ;
    chart:value "31"^^xsd:decimal .

