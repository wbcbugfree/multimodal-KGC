@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-7425 a chart:Chart ;
    chart:chartType "area" ;
    chart:title "Georgia : Age structure from 2009 to 2019" ;
    chart:xAxis ex:x-7425 ;
    chart:yAxis ex:y-7425 .

ex:x-7425 a chart:Axis ;
    chart:label "Year" .

ex:y-7425 a chart:Axis ;
    chart:label "" .

ex:series-7425-1 a chart:Series .

ex:mark-7425-1-1 a chart:DataPoint ;
    chart:series ex:series-7425-1 ;
    chart:category "years and older Dec" ;
    chart:value "31"^^xsd:decimal .

