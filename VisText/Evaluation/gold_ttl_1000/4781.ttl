@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-4781 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Consumption of tree nuts worldwide in 2018 , by type (in 1,000 metric tons)" ;
    chart:xAxis ex:x-4781 ;
    chart:yAxis ex:y-4781 .

ex:x-4781 a chart:Axis ;
    chart:label "Consumption in thousand metric tons while the y-axis shows type of nut" .

ex:y-4781 a chart:Axis ;
    chart:label "type of nut" .

ex:series-4781-1 a chart:Series .

ex:mark-4781-1-1 a chart:DataPoint ;
    chart:series ex:series-4781-1 ;
    chart:category "Peanut" ;
    chart:value "1188.69"^^xsd:decimal .

ex:mark-4781-1-2 a chart:DataPoint ;
    chart:series ex:series-4781-1 ;
    chart:category "Almond" ;
    chart:value "888.67"^^xsd:decimal .

ex:mark-4781-1-3 a chart:DataPoint ;
    chart:series ex:series-4781-1 ;
    chart:category "Walnut" ;
    chart:value "792.32"^^xsd:decimal .

ex:mark-4781-1-4 a chart:DataPoint ;
    chart:series ex:series-4781-1 ;
    chart:category "Cashew" ;
    chart:value "669.86"^^xsd:decimal .

ex:mark-4781-1-5 a chart:DataPoint ;
    chart:series ex:series-4781-1 ;
    chart:category "Pistachio" ;
    chart:value "424.14"^^xsd:decimal .

ex:mark-4781-1-6 a chart:DataPoint ;
    chart:series ex:series-4781-1 ;
    chart:category "Hazelnut" ;
    chart:value "125.5"^^xsd:decimal .

ex:mark-4781-1-7 a chart:DataPoint ;
    chart:series ex:series-4781-1 ;
    chart:category "Pecan" ;
    chart:value "50.36"^^xsd:decimal .

ex:mark-4781-1-8 a chart:DataPoint ;
    chart:series ex:series-4781-1 ;
    chart:category "Macadamia" ;
    chart:value "26.96"^^xsd:decimal .

ex:mark-4781-1-9 a chart:DataPoint ;
    chart:series ex:series-4781-1 ;
    chart:category "Brazil Nut" ;
    chart:value "21.69"^^xsd:decimal .
