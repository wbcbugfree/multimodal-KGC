@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-99 a chart:Chart ;
    chart:chartType "area" ;
    chart:title "Total number of tribal casinos in the U.S. from 2005 to 2019" ;
    chart:xAxis ex:x-99 ;
    chart:yAxis ex:y-99 .

ex:x-99 a chart:Axis ;
    chart:label "Year" .

ex:y-99 a chart:Axis ;
    chart:label "" .

ex:series-99-1 a chart:Series .

ex:mark-99-1-1 a chart:DataPoint ;
    chart:series ex:series-99-1 ;
    chart:category "Number of tribal casinos Dec" ;
    chart:value "31"^^xsd:decimal .

