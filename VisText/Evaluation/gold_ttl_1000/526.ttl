@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-526 a chart:Chart ;
    chart:chartType "line" ;
    chart:title "Average annual wages in Slovenia from 2000 to 2019 (in euros)" ;
    chart:xAxis ex:x-526 ;
    chart:yAxis ex:y-526 .

ex:x-526 a chart:Axis ;
    chart:label "Year" .

ex:y-526 a chart:Axis ;
    chart:label "" .

ex:series-526-1 a chart:Series .

ex:mark-526-1-1 a chart:DataPoint ;
    chart:series ex:series-526-1 ;
    chart:category "Average annual wages in euros Dec" ;
    chart:value "31"^^xsd:decimal .

