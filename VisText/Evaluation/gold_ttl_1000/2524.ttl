@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-2524 a chart:Chart ;
    chart:chartType "line" ;
    chart:title "U.S. producer price index of insulation materials from 1990 to 2018" ;
    chart:xAxis ex:x-2524 ;
