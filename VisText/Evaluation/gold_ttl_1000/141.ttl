@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-141 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Most common baby names of boys in Norway in 2019" ;
    chart:xAxis ex:x-141 ;
    chart:yAxis ex:y-141 .

ex:x-141 a chart:Axis ;
    chart:label "baby" .

ex:y-141 a chart:Axis ;
    chart:label "" .

ex:series-141-1 a chart:Series .

ex:mark-141-1-1 a chart:DataPoint ;
    chart:series ex:series-141-1 ;
    chart:category "names Number of individuals Jakob/Jacob" ;
    chart:value "423"^^xsd:decimal .

ex:mark-141-1-2 a chart:DataPoint ;
    chart:series ex:series-141-1 ;
    chart:category "Lucas/Lukas" ;
    chart:value "392"^^xsd:decimal .

ex:mark-141-1-3 a chart:DataPoint ;
    chart:series ex:series-141-1 ;
    chart:category "Filip/Fillip/Philip/Phillip" ;
    chart:value "387"^^xsd:decimal .

ex:mark-141-1-4 a chart:DataPoint ;
    chart:series ex:series-141-1 ;
    chart:category "Oskar/Oscar" ;
    chart:value "358"^^xsd:decimal .

ex:mark-141-1-5 a chart:DataPoint ;
    chart:series ex:series-141-1 ;
    chart:category "Oliver" ;
    chart:value "353"^^xsd:decimal .

ex:mark-141-1-6 a chart:DataPoint ;
    chart:series ex:series-141-1 ;
    chart:category "Emil" ;
    chart:value "347"^^xsd:decimal .

ex:mark-141-1-7 a chart:DataPoint ;
    chart:series ex:series-141-1 ;
    chart:category "Henrik" ;
    chart:value "339"^^xsd:decimal .

ex:mark-141-1-8 a chart:DataPoint ;
    chart:series ex:series-141-1 ;
    chart:category "William" ;
    chart:value "333"^^xsd:decimal .

ex:mark-141-1-9 a chart:DataPoint ;
    chart:series ex:series-141-1 ;
    chart:category "Noah/Noa" ;
    chart:value "314"^^xsd:decimal .

ex:mark-141-1-10 a chart:DataPoint ;
    chart:series ex:series-141-1 ;
    chart:category "Aksel/Axel" ;
    chart:value "311"^^xsd:decimal .
