@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-2336 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Peru : National debt in relation to gross domestic product (GDP) from 2015 to 2025" ;
    chart:xAxis ex:x-2336 ;
    chart:yAxis ex:y-2336 .

ex:x-2336 a chart:Axis ;
    chart:label "National" .

ex:y-2336 a chart:Axis ;
    chart:label "" .

ex:series-2336-1 a chart:Series .

ex:mark-2336-1-1 a chart:DataPoint ;
    chart:series ex:series-2336-1 ;
    chart:category "debt in relation to GDP Year" ;
    chart:value "0.378"^^xsd:decimal .

ex:mark-2336-1-2 a chart:DataPoint ;
    chart:series ex:series-2336-1 ;
    chart:category "2025*" ;
    chart:value "0.388"^^xsd:decimal .

