    chart:series ex:series-2336-1 ;
    chart:category "2023*" ;
    chart:value "0.3968"^^xsd:decimal .

ex:mark-2336-1-5 a chart:DataPoint ;
    chart:series ex:series-2336-1 ;
    chart:category "2022*" ;
    chart:value "0.3913"^^xsd:decimal .

ex:mark-2336-1-6 a chart:DataPoint ;
    chart:series ex:series-2336-1 ;
    chart:category "2021*" ;
    chart:value "0.3948"^^xsd:decimal .

ex:mark-2336-1-7 a chart:DataPoint ;
