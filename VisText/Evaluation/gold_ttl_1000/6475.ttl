@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-6475 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Olympic Summer Games 2016 medal tally of the Italian Olympic team , by sport" ;
    chart:xAxis ex:x-6475 ;
    chart:yAxis ex:y-6475 .

ex:x-6475 a chart:Axis ;
    chart:label "Bronze while the y-axis shows type of sport" .

ex:y-6475 a chart:Axis ;
    chart:label "type of sport" .

ex:series-6475-1 a chart:Series .

ex:mark-6475-1-1 a chart:DataPoint ;
    chart:series ex:series-6475-1 ;
    chart:category "Judo" ;
    chart:value "0"^^xsd:decimal .

ex:mark-6475-1-2 a chart:DataPoint ;
    chart:series ex:series-6475-1 ;
    chart:category "Fencing" ;
    chart:value "1"^^xsd:decimal .

