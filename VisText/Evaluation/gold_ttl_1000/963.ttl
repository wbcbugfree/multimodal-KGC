@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-963 a chart:Chart ;
    chart:chartType "area" ;
    chart:title "Total fertility rate in Japan from 1800 to 2020" ;
    chart:xAxis ex:x-963 ;
    chart:yAxis ex:y-963 .

ex:x-963 a chart:Axis ;
    chart:label "Year" .

ex:y-963 a chart:Axis ;
    chart:label "" .

ex:series-963-1 a chart:Series .

ex:mark-963-1-1 a chart:DataPoint ;
    chart:series ex:series-963-1 ;
    chart:category "Fertility rate Dec" ;
    chart:value "31"^^xsd:decimal .

