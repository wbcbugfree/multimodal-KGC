@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-4115 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Average life expectancy of major household appliances as of 2011 (in years)" ;
    chart:xAxis ex:x-4115 ;
    chart:yAxis ex:y-4115 .

ex:x-4115 a chart:Axis ;
    chart:label "Average" .

ex:y-4115 a chart:Axis ;
    chart:label "" .

ex:series-4115-1 a chart:Series .

ex:mark-4115-1-1 a chart:DataPoint ;
    chart:series ex:series-4115-1 ;
    chart:category "life expectancy in years Household appliance" ;
    chart:value "18"^^xsd:decimal .

ex:mark-4115-1-2 a chart:DataPoint ;
    chart:series ex:series-4115-1 ;
    chart:category "Ranges, Gas" ;
    chart:value "16"^^xsd:decimal .

