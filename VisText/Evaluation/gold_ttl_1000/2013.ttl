@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-2013 a chart:Chart ;
    chart:chartType "line" ;
    chart:title "Number of Nyrstar employees from 2009 to 2018" ;
    chart:xAxis ex:x-2013 ;
    chart:yAxis ex:y-2013 .

ex:x-2013 a chart:Axis ;
    chart:label "Year while the y-axis measures Number of employees" .

ex:y-2013 a chart:Axis ;
    chart:label "Number of employees" .

ex:series-2013-1 a chart:Series .

ex:mark-2013-1-1 a chart:DataPoint ;
    chart:series ex:series-2013-1 ;
    chart:category "Dec" ;
    chart:value "31"^^xsd:decimal .

ex:mark-2013-1-2 a chart:DataPoint ;
    chart:series ex:series-2013-1 ;
    chart:category "Dec" ;
    chart:value "31"^^xsd:decimal .

