@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-525 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Chile : National debt from 2015 to 2025 in relation to gross domestic product (GDP)" ;
    chart:xAxis ex:x-525 ;
    chart:yAxis ex:y-525 .

ex:x-525 a chart:Axis ;
    chart:label "Year while the y-axis plots National debt in relation to GDP" .

ex:y-525 a chart:Axis ;
    chart:label "" .

ex:series-525-1 a chart:Series .

ex:mark-525-1-1 a chart:DataPoint ;
    chart:series ex:series-525-1 ;
    chart:category "National debt in relation to GDP 2025*" ;
    chart:value "0.4798"^^xsd:decimal .

ex:mark-525-1-2 a chart:DataPoint ;
    chart:series ex:series-525-1 ;
    chart:category "2024*" ;
    chart:value "0.4774"^^xsd:decimal .

ex:mark-525-1-3 a chart:DataPoint ;
    chart:series ex:series-525-1 ;
    chart:category "2023*" ;
    chart:value "0.4489"^^xsd:decimal .

ex:mark-525-1-4 a chart:DataPoint ;
    chart:series ex:series-525-1 ;
    chart:category "2022*" ;
    chart:value "0.4175"^^xsd:decimal .

ex:mark-525-1-5 a chart:DataPoint ;
    chart:series ex:series-525-1 ;
    chart:category "2021*" ;
    chart:value "0.3751"^^xsd:decimal .

ex:mark-525-1-6 a chart:DataPoint ;
    chart:series ex:series-525-1 ;
    chart:category "2020*" ;
    chart:value "0.3281"^^xsd:decimal .
