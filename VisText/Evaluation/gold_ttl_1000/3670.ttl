@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-3670 a chart:Chart ;
    chart:chartType "line" ;
    chart:title "Value of alcoholic beverage exports from Sweden from 2009 to 2019 (in 1,000 SEK)" ;
    chart:xAxis ex:x-3670 ;
    chart:yAxis ex:y-3670 .

ex:x-3670 a chart:Axis ;
    chart:label "Year" .

ex:y-3670 a chart:Axis ;
    chart:label "" .

ex:series-3670-1 a chart:Series .

ex:mark-3670-1-1 a chart:DataPoint ;
    chart:series ex:series-3670-1 ;
    chart:category "Export value in thousand SEK Dec" ;
    chart:value "31"^^xsd:decimal .

