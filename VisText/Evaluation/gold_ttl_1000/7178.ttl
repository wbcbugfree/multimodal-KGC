@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-7178 a chart:Chart ;
    chart:chartType "area" ;
    chart:title "Average hours per day spent on leisure and sports in the U.S. sorted by ethnicity from 2009 to 2019" ;
    chart:xAxis ex:x-7178 ;
    chart:yAxis ex:y-7178 .

ex:x-7178 a chart:Axis ;
    chart:label "Year with linear scale with a minimum of 2010 and a maximum of 2018 while the y-axis shows Black or African American" .

ex:y-7178 a chart:Axis ;
    chart:label "Black or African American" .

ex:series-7178-1 a chart:Series .

ex:mark-7178-1-1 a chart:DataPoint ;
    chart:series ex:series-7178-1 ;
    chart:category "Dec" ;
    chart:value "31"^^xsd:decimal .

