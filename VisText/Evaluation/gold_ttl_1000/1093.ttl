@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-1093 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Countries with the highest stillbirth rates in 2009 (per 1,000 births)" ;
    chart:xAxis ex:x-1093 ;
    chart:yAxis ex:y-1093 .

