@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-6180 a chart:Chart ;
    chart:chartType "area" ;
    chart:title "Number of public and private airports in the United States from 1990 to 2019" ;
    chart:xAxis ex:x-6180 ;
    chart:yAxis ex:y-6180 .

ex:x-6180 a chart:Axis ;
    chart:label "Year while the y-axis plots Private use" .

ex:y-6180 a chart:Axis ;
    chart:label "" .

ex:series-6180-1 a chart:Series .

ex:mark-6180-1-1 a chart:DataPoint ;
    chart:series ex:series-6180-1 ;
    chart:category "Private use Dec" ;
    chart:value "31"^^xsd:decimal .

