    chart:series ex:series-78-1 ;
    chart:category "Vietnam" ;
    chart:value "13699.64"^^xsd:decimal .

ex:mark-78-1-5 a chart:DataPoint ;
    chart:series ex:series-78-1 ;
    chart:category "Thailand" ;
    chart:value "11875.36"^^xsd:decimal .

ex:mark-78-1-6 a chart:DataPoint ;
    chart:series ex:series-78-1 ;
    chart:category "Philippines" ;
    chart:value "2324.74"^^xsd:decimal .

ex:mark-78-1-7 a chart:DataPoint ;
    chart:series ex:series-78-1 ;
    chart:category "Myanmar" ;
    chart:value "1726.69"^^xsd:decimal .

ex:mark-78-1-8 a chart:DataPoint ;
    chart:series ex:series-78-1 ;
    chart:category "Brunei" ;
    chart:value "647.3"^^xsd:decimal .

ex:mark-78-1-9 a chart:DataPoint ;
    chart:series ex:series-78-1 ;
    chart:category "Cambodia" ;
    chart:value "238.6"^^xsd:decimal .

ex:mark-78-1-10 a chart:DataPoint ;
