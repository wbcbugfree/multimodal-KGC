@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-78 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Value of Indian trade with ASEAN countries in FY 2019 , by country (in million U.S. dollars)" ;
    chart:xAxis ex:x-78 ;
    chart:yAxis ex:y-78 .

ex:x-78 a chart:Axis ;
    chart:label "Country" .

ex:y-78 a chart:Axis ;
    chart:label "" .

ex:series-78-1 a chart:Series .

ex:mark-78-1-1 a chart:DataPoint ;
    chart:series ex:series-78-1 ;
    chart:category "Trade value in million U.S. dollars Singapore" ;
    chart:value "27850.23"^^xsd:decimal .

ex:mark-78-1-2 a chart:DataPoint ;
    chart:series ex:series-78-1 ;
    chart:category "Indonesia" ;
    chart:value "21127.02"^^xsd:decimal .

ex:mark-78-1-3 a chart:DataPoint ;
    chart:series ex:series-78-1 ;
    chart:category "Malaysia" ;
    chart:value "17223.71"^^xsd:decimal .

