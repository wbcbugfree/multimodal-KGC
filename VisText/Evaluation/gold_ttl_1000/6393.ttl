@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-6393 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Average monthly precipitation in Germany from November 2019 to November 2020 (in liters per square meter)" ;
    chart:xAxis ex:x-6393 ;
    chart:yAxis ex:y-6393 .

ex:x-6393 a chart:Axis ;
    chart:label "Month" .

ex:y-6393 a chart:Axis ;
    chart:label "Long-term average" .

ex:series-6393-1 a chart:Series .

ex:mark-6393-1-1 a chart:DataPoint ;
    chart:series ex:series-6393-1 ;
    chart:category "Nov" ;
    chart:value "20"^^xsd:decimal .

