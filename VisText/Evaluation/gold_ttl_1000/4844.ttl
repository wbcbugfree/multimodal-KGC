@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-4844 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Total number of magnetic resonance imaging (MRI) units in the United Kingdom (UK) from 2000 to 2014" ;
    chart:xAxis ex:x-4844 ;
    chart:yAxis ex:y-4844 .

ex:x-4844 a chart:Axis ;
    chart:label "Year" .

ex:y-4844 a chart:Axis ;
    chart:label "" .

ex:series-4844-1 a chart:Series .

ex:mark-4844-1-1 a chart:DataPoint ;
    chart:series ex:series-4844-1 ;
    chart:category "Number of scanners 2014*" ;
    chart:value "467"^^xsd:decimal .

