@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-4079 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Contribution of travel and tourism to GDP in the United States from 2008 to 2028 (in trillion U.S. dollars)" ;
    chart:xAxis ex:x-4079 ;
    chart:yAxis ex:y-4079 .

ex:x-4079 a chart:Axis ;
    chart:label "Year" .

ex:y-4079 a chart:Axis ;
    chart:label "" .

ex:series-4079-1 a chart:Series .

ex:mark-4079-1-1 a chart:DataPoint ;
    chart:series ex:series-4079-1 ;
    chart:category "Contribution in trillion U.S. dollars 2028**" ;
    chart:value "2.4"^^xsd:decimal .

ex:mark-4079-1-2 a chart:DataPoint ;
    chart:series ex:series-4079-1 ;
    chart:category "2018*" ;
    chart:value "1.57"^^xsd:decimal .
