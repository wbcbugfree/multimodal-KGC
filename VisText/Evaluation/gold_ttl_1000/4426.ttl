@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-4426 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Which of the following issues do you think politicians should talk about most between now and the next general election ?" ;
    chart:xAxis ex:x-4426 ;
    chart:yAxis ex:y-4426 .

ex:x-4426 a chart:Axis ;
    chart:label "Response" .

ex:y-4426 a chart:Axis ;
    chart:label "" .

ex:series-4426-1 a chart:Series .

ex:mark-4426-1-1 a chart:DataPoint ;
    chart:series ex:series-4426-1 ;
    chart:category "Share of respondents Immigration" ;
    chart:value "0.5"^^xsd:decimal .

