@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-1208 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Number of registered players in the Korean Basketball League (KBL) in South Korea for the 20/21 season , by team" ;
    chart:xAxis ex:x-1208 ;
    chart:yAxis ex:y-1208 .

ex:x-1208 a chart:Axis ;
    chart:label "basketball team while the y-axis plots Number of registered players" .

ex:y-1208 a chart:Axis ;
    chart:label "" .

ex:series-1208-1 a chart:Series .

ex:mark-1208-1-1 a chart:DataPoint ;
    chart:series ex:series-1208-1 ;
    chart:category "team Number of registered players Seoul SK Knights" ;
    chart:value "18"^^xsd:decimal .

