@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-694 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Leading 10 causes of death in lower-middle income countries worldwide in 2016 (in deaths per 100,000 population)" ;
    chart:xAxis ex:x-694 ;
    chart:yAxis ex:y-694 .

ex:x-694 a chart:Axis ;
    chart:label "Deaths" .

ex:y-694 a chart:Axis ;
    chart:label "" .

ex:series-694-1 a chart:Series .

ex:mark-694-1-1 a chart:DataPoint ;
    chart:series ex:series-694-1 ;
    chart:category "per" ;
    chart:value "100000"^^xsd:decimal .

ex:mark-694-1-2 a chart:DataPoint ;
    chart:series ex:series-694-1 ;
    chart:category "population causes of death" ;
    chart:value "119.4"^^xsd:decimal .

ex:mark-694-1-3 a chart:DataPoint ;
    chart:series ex:series-694-1 ;
    chart:category "Ischaemic heart disease" ;
    chart:value "61.6"^^xsd:decimal .

ex:mark-694-1-4 a chart:DataPoint ;
    chart:series ex:series-694-1 ;
    chart:category "Stroke" ;
    chart:value "48.1"^^xsd:decimal .

ex:mark-694-1-5 a chart:DataPoint ;
    chart:series ex:series-694-1 ;
    chart:category "Lower respiratory infections" ;
    chart:value "39.3"^^xsd:decimal .

ex:mark-694-1-6 a chart:DataPoint ;
    chart:series ex:series-694-1 ;
    chart:category "Chronic obstructive pulmonary disease" ;
    chart:value "31"^^xsd:decimal .

ex:mark-694-1-7 a chart:DataPoint ;
    chart:series ex:series-694-1 ;
    chart:category "Tuberculosis" ;
    chart:value "30.3"^^xsd:decimal .

ex:mark-694-1-8 a chart:DataPoint ;
    chart:series ex:series-694-1 ;
    chart:category "Diarrhoeal diseases" ;
    chart:value "22.9"^^xsd:decimal .

ex:mark-694-1-9 a chart:DataPoint ;
    chart:series ex:series-694-1 ;
    chart:category "Diabetes mellitus" ;
    chart:value "22.7"^^xsd:decimal .

ex:mark-694-1-10 a chart:DataPoint ;
    chart:series ex:series-694-1 ;
    chart:category "Preterm birth complications" ;
    chart:value "22"^^xsd:decimal .

ex:mark-694-1-11 a chart:DataPoint ;
    chart:series ex:series-694-1 ;
    chart:category "Cirrhosis of the liver" ;
    chart:value "19.9"^^xsd:decimal .
