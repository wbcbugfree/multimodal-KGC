@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-7472 a chart:Chart ;
    chart:chartType "line" ;
    chart:title "Total population of the Dominican Republic from 2008 to 2018 , by gender (in million inhabitants)" ;
    chart:xAxis ex:x-7472 ;
    chart:yAxis ex:y-7472 .

ex:x-7472 a chart:Axis ;
    chart:label "Year" .

ex:y-7472 a chart:Axis ;
    chart:label "" .

ex:series-7472-1 a chart:Series .

ex:mark-7472-1-1 a chart:DataPoint ;
    chart:series ex:series-7472-1 ;
    chart:category "Male Dec" ;
    chart:value "31"^^xsd:decimal .

