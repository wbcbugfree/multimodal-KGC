ex:chart-6024 a chart:Chart ;
    chart:chartType "line" ;
    chart:title "Annual Gross Domestic Product and real GDP in the United States from 1930 to 2020 (in billion U.S dollars)" ;
    chart:xAxis ex:x-6024 ;
    chart:yAxis ex:y-6024 .

ex:x-6024 a chart:Axis ;
    chart:label "Year" .

ex:y-6024 a chart:Axis ;
    chart:label "Real GDP** while the x-axis measures Year" .

ex:series-6024-1 a chart:Series .

