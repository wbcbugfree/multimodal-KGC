@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-467 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Number of registered LINE app users in selected countries as of October 2014 (in millions)" ;
    chart:xAxis ex:x-467 ;
    chart:yAxis ex:y-467 .

ex:x-467 a chart:Axis ;
    chart:label "Country" .

ex:y-467 a chart:Axis ;
    chart:label "" .

ex:series-467-1 a chart:Series .

ex:mark-467-1-1 a chart:DataPoint ;
    chart:series ex:series-467-1 ;
    chart:category "Total registered users in millions Japan" ;
    chart:value "54"^^xsd:decimal .

ex:mark-467-1-2 a chart:DataPoint ;
    chart:series ex:series-467-1 ;
    chart:category "Thailand" ;
    chart:value "33"^^xsd:decimal .

ex:mark-467-1-3 a chart:DataPoint ;
    chart:series ex:series-467-1 ;
    chart:category "Indonesia" ;
    chart:value "30"^^xsd:decimal .

ex:mark-467-1-4 a chart:DataPoint ;
    chart:series ex:series-467-1 ;
    chart:category "Spain" ;
    chart:value "18"^^xsd:decimal .

ex:mark-467-1-5 a chart:DataPoint ;
    chart:series ex:series-467-1 ;
    chart:category "India" ;
    chart:value "18"^^xsd:decimal .

ex:mark-467-1-6 a chart:DataPoint ;
    chart:series ex:series-467-1 ;
    chart:category "Taiwan" ;
    chart:value "17"^^xsd:decimal .

ex:mark-467-1-7 a chart:DataPoint ;
    chart:series ex:series-467-1 ;
    chart:category "Mexico" ;
    chart:value "15"^^xsd:decimal .

ex:mark-467-1-8 a chart:DataPoint ;
    chart:series ex:series-467-1 ;
    chart:category "Korea" ;
    chart:value "14"^^xsd:decimal .

ex:mark-467-1-9 a chart:DataPoint ;
    chart:series ex:series-467-1 ;
    chart:category "Columbia" ;
    chart:value "11"^^xsd:decimal .

ex:mark-467-1-10 a chart:DataPoint ;
    chart:series ex:series-467-1 ;
    chart:category "Malaysia" ;
    chart:value "10"^^xsd:decimal .

ex:mark-467-1-11 a chart:DataPoint ;
