@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-3697 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Most popular e-commerce properties in the United States as of September 2018 , by desktop visitors (in millions)" ;
    chart:xAxis ex:x-3697 ;
    chart:yAxis ex:y-3697 .

ex:x-3697 a chart:Axis ;
    chart:label "Most popular e-commerce properties while the y-axis measures Number of desktop visitors in millions" .

ex:y-3697 a chart:Axis ;
    chart:label "Number of desktop visitors in millions" .

ex:series-3697-1 a chart:Series .

ex:mark-3697-1-1 a chart:DataPoint ;
    chart:series ex:series-3697-1 ;
    chart:category "Amazon" ;
    chart:value "122"^^xsd:decimal .

