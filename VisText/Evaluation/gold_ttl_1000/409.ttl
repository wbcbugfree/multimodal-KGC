@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-409 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Size of luxury property that one million dollars could buy in selected cities worldwide in 2019 (in square meters)" ;
    chart:xAxis ex:x-409 ;
    chart:yAxis ex:y-409 .

ex:x-409 a chart:Axis ;
    chart:label "Country with categorical scale starting with Beijing and ending with Tokyo while the y-axis shows Size in square meters" .

ex:y-409 a chart:Axis ;
    chart:label "Size in square meters" .

ex:series-409-1 a chart:Series .

ex:mark-409-1-1 a chart:DataPoint ;
    chart:series ex:series-409-1 ;
    chart:category "Sao Paulo" ;
    chart:value "202"^^xsd:decimal .

