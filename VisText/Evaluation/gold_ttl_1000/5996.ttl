@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-5996 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Most expensive cities to drink a cold beer worldwide as of June 2016 , based on beer price index (in U.S. dollars)" ;
    chart:xAxis ex:x-5996 ;
    chart:yAxis ex:y-5996 .

ex:x-5996 a chart:Axis ;
    chart:label "Beer price in U" .

ex:y-5996 a chart:Axis ;
    chart:label "Country while the x-axis measures Beer price in U" .

ex:series-5996-1 a chart:Series .

ex:mark-5996-1-1 a chart:DataPoint ;
    chart:series ex:series-5996-1 ;
    chart:category "price in U.S. dollars Country" ;
    chart:value "9.51"^^xsd:decimal .

ex:mark-5996-1-2 a chart:DataPoint ;
    chart:series ex:series-5996-1 ;
    chart:category "Lausanne" ;
    chart:value "6.22"^^xsd:decimal .

