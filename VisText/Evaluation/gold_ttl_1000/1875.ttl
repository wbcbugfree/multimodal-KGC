@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-1875 a chart:Chart ;
    chart:chartType "line" ;
    chart:title "Number of hate groups in the United States from 1999 to 2019" ;
    chart:xAxis ex:x-1875 ;
    chart:yAxis ex:y-1875 .

ex:x-1875 a chart:Axis ;
    chart:label "Year" .

ex:y-1875 a chart:Axis ;
    chart:label "" .

ex:series-1875-1 a chart:Series .

ex:mark-1875-1-1 a chart:DataPoint ;
    chart:series ex:series-1875-1 ;
    chart:category "Number of hate groups Dec" ;
    chart:value "31"^^xsd:decimal .

