@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-862 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Number of hours of sunshine in France in 2018 , by city" ;
    chart:xAxis ex:x-862 ;
    chart:yAxis ex:y-862 .

