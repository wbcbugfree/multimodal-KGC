@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-2633 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Ireland : National debt in relation to gross domestic product (GDP) from 2015 to 2025" ;
    chart:xAxis ex:x-2633 ;
    chart:yAxis ex:y-2633 .

ex:x-2633 a chart:Axis ;
    chart:label "Year" .

ex:y-2633 a chart:Axis ;
    chart:label "National debt to GDP ratio while the x-axis measures Year" .

ex:series-2633-1 a chart:Series .

ex:mark-2633-1-1 a chart:DataPoint ;
    chart:series ex:series-2633-1 ;
    chart:category "National debt to GDP ratio 2025*" ;
    chart:value "0.4924"^^xsd:decimal .

ex:mark-2633-1-2 a chart:DataPoint ;
    chart:series ex:series-2633-1 ;
    chart:category "2024*" ;
    chart:value "0.5251"^^xsd:decimal .

ex:mark-2633-1-3 a chart:DataPoint ;
    chart:series ex:series-2633-1 ;
    chart:category "2023*" ;
    chart:value "0.558"^^xsd:decimal .

ex:mark-2633-1-4 a chart:DataPoint ;
    chart:series ex:series-2633-1 ;
    chart:category "2022*" ;
    chart:value "0.5923"^^xsd:decimal .

ex:mark-2633-1-5 a chart:DataPoint ;
    chart:series ex:series-2633-1 ;
    chart:category "2021*" ;
    chart:value "0.6125"^^xsd:decimal .

ex:mark-2633-1-6 a chart:DataPoint ;
    chart:series ex:series-2633-1 ;
    chart:category "2020*" ;
    chart:value "0.6368"^^xsd:decimal .
