@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-1739 a chart:Chart ;
    chart:chartType "area" ;
    chart:title "Number violent crimes in Canada from 2000 to 2019" ;
    chart:xAxis ex:x-1739 ;
    chart:yAxis ex:y-1739 .

ex:x-1739 a chart:Axis ;
    chart:label "Year" .

ex:y-1739 a chart:Axis ;
    chart:label "Number of violent crimes" .

ex:series-1739-1 a chart:Series .

