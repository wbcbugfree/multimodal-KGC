@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-8697 a chart:Chart ;
    chart:chartType "area" ;
    chart:title "Distribution of gross domestic product (GDP) across economic sectors worldwide from 2008 to 2018" ;
    chart:xAxis ex:x-8697 ;
    chart:yAxis ex:y-8697 .

ex:x-8697 a chart:Axis ;
    chart:label "Year" .

ex:y-8697 a chart:Axis ;
    chart:label "" .

ex:series-8697-1 a chart:Series .

ex:mark-8697-1-1 a chart:DataPoint ;
    chart:series ex:series-8697-1 ;
    chart:category "Agriculture Dec" ;
    chart:value "31"^^xsd:decimal .

