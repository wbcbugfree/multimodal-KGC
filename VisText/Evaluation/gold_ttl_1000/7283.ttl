@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-7283 a chart:Chart ;
    chart:chartType "area" ;
    chart:title "Number of Facebook fans/twitter followers of the Miami Dolphins (NFL) from 2012 to 2020 (in millions)" ;
    chart:xAxis ex:x-7283 ;
    chart:yAxis ex:y-7283 .

