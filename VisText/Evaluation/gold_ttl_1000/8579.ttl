@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-8579 a chart:Chart ;
    chart:chartType "area" ;
    chart:title "United States : Employee engagement 2002 to 2012" ;
    chart:xAxis ex:x-8579 ;
    chart:yAxis ex:y-8579 .

ex:x-8579 a chart:Axis ;
    chart:label "Response" .

ex:y-8579 a chart:Axis ;
    chart:label "Engaged while the x-axis measures Response" .

ex:series-8579-1 a chart:Series .

ex:mark-8579-1-1 a chart:DataPoint ;
    chart:series ex:series-8579-1 ;
    chart:category "Engaged Dec" ;
    chart:value "31"^^xsd:decimal .

