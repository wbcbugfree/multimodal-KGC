@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-7048 a chart:Chart ;
    chart:chartType "area" ;
    chart:title "Revenue of the InterContinental Hotels Group (IHG) from 2008 to 2019 , by hotel ownership type (in million U.S. dollars)" ;
    chart:xAxis ex:x-7048 ;
    chart:yAxis ex:y-7048 .

ex:x-7048 a chart:Axis ;
    chart:label "Year" .

ex:y-7048 a chart:Axis ;
    chart:label "Franchised hotels" .

ex:series-7048-1 a chart:Series .

ex:mark-7048-1-1 a chart:DataPoint ;
    chart:series ex:series-7048-1 ;
    chart:category "Dec" ;
    chart:value "31"^^xsd:decimal .

