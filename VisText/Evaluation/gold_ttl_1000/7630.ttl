@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-7630 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Most purchased brands during COVID-19 outbreak in Singapore as of March 2020 , by type of customer" ;
    chart:xAxis ex:x-7630 ;
    chart:yAxis ex:y-7630 .

ex:x-7630 a chart:Axis ;
    chart:label "Response" .

ex:y-7630 a chart:Axis ;
    chart:label "" .

ex:series-7630-1 a chart:Series .

ex:mark-7630-1-1 a chart:DataPoint ;
    chart:series ex:series-7630-1 ;
    chart:category "COVID-19 Worriers McDonald's" ;
    chart:value "0.55"^^xsd:decimal .

