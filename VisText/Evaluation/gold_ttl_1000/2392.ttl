@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-2392 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Route length of railways across Uttar Pradesh in India from financial year 2003 to 2019 (in kilometers)" ;
    chart:xAxis ex:x-2392 ;
    chart:yAxis ex:y-2392 .

ex:x-2392 a chart:Axis ;
    chart:label "Route length in kilometers" .

ex:y-2392 a chart:Axis ;
    chart:label "year while the x-axis plots Route length in kilometers" .

ex:series-2392-1 a chart:Series .

ex:mark-2392-1-1 a chart:DataPoint ;
    chart:series ex:series-2392-1 ;
    chart:category "length in kilometers year" ;
    chart:value "8823"^^xsd:decimal .

