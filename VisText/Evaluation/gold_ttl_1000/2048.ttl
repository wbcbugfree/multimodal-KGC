@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-2048 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Leading life insurance companies ranked by total gross premium income in Ireland in 2018 (in 1,000 euros)" ;
    chart:xAxis ex:x-2048 ;
    chart:yAxis ex:y-2048 .

ex:x-2048 a chart:Axis ;
    chart:label "Gross premium income in thousand euros" .

ex:y-2048 a chart:Axis ;
    chart:label "Life Insurance Company while the x-axis shows Gross premium income in thousand euros" .

ex:series-2048-1 a chart:Series .

ex:mark-2048-1-1 a chart:DataPoint ;
    chart:series ex:series-2048-1 ;
    chart:category "premium income in thousand euros Life Insurance Co..." ;
    chart:value "4108949"^^xsd:decimal .

