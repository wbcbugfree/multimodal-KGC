@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-2258 a chart:Chart ;
    chart:chartType "area" ;
    chart:title "Comparable sales growth of Sam 's Club in the United States from fiscal year 2006 to 2020" ;
    chart:xAxis ex:x-2258 ;
    chart:yAxis ex:y-2258 .

ex:x-2258 a chart:Axis ;
    chart:label "Year with linear scale from 2006 to 2018 while the y-axis measures Comparable sales growth with categorical scale starting at −0" .

ex:y-2258 a chart:Axis ;
    chart:label "Comparable sales growth" .

ex:series-2258-1 a chart:Series .

ex:mark-2258-1-1 a chart:DataPoint ;
    chart:series ex:series-2258-1 ;
    chart:category "Dec" ;
    chart:value "31"^^xsd:decimal .

