@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-1801 a chart:Chart ;
    chart:chartType "area" ;
    chart:title "Madagascar : Fertility rate from 2008 to 2018" ;
    chart:xAxis ex:x-1801 ;
    chart:yAxis ex:y-1801 .

ex:x-1801 a chart:Axis ;
    chart:label "Year" .

ex:y-1801 a chart:Axis ;
    chart:label "" .

ex:series-1801-1 a chart:Series .

ex:mark-1801-1-1 a chart:DataPoint ;
    chart:series ex:series-1801-1 ;
    chart:category "Number of children born per woman Dec" ;
    chart:value "31"^^xsd:decimal .

