@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-1170 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Donations made to charity in the U.S. from 2011 to 2013 , by channel used" ;
    chart:xAxis ex:x-1170 ;
    chart:yAxis ex:y-1170 .

ex:x-1170 a chart:Axis ;
    chart:label "Share of respondents" .

ex:y-1170 a chart:Axis ;
    chart:label "" .

ex:series-1170-1 a chart:Series .

ex:mark-1170-1-1 a chart:DataPoint ;
    chart:series ex:series-1170-1 ;
    chart:category "of respondents Channel" ;
    chart:value "0.5"^^xsd:decimal .

