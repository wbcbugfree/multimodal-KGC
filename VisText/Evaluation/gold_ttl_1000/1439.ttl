@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-1439 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Apparent steel consumption per capita in Mexico from 2003 to 2018 (in kilograms of finished steel products)" ;
    chart:xAxis ex:x-1439 ;
    chart:yAxis ex:y-1439 .

ex:x-1439 a chart:Axis ;
    chart:label "Year" .

ex:y-1439 a chart:Axis ;
    chart:label "" .

ex:series-1439-1 a chart:Series .

ex:mark-1439-1-1 a chart:DataPoint ;
    chart:series ex:series-1439-1 ;
    chart:category "Per capita use in kilograms" ;
    chart:value "2018"^^xsd:decimal .

ex:mark-1439-1-2 a chart:DataPoint ;
    chart:series ex:series-1439-1 ;
    chart:category "2012*" ;
    chart:value "173.1"^^xsd:decimal .
