@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-1179 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Consumption volume of cement in India from financial year 2009 to 2018 with an estimate for financial year 2019 (in million metric tons)" ;
    chart:xAxis ex:x-1179 ;
    chart:yAxis ex:y-1179 .

ex:x-1179 a chart:Axis ;
    chart:label "Consumption in million metric tons with linear scale from 0 to 350 while the y-axis plots Financial year" .

ex:y-1179 a chart:Axis ;
    chart:label "" .

ex:series-1179-1 a chart:Series .

ex:mark-1179-1-1 a chart:DataPoint ;
    chart:series ex:series-1179-1 ;
    chart:category "in million metric tons Financial year" ;
    chart:value "328"^^xsd:decimal .

ex:mark-1179-1-2 a chart:DataPoint ;
    chart:series ex:series-1179-1 ;
    chart:category "FY" ;
    chart:value "2019"^^xsd:decimal .

