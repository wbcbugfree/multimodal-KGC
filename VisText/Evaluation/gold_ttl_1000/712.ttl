@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-712 a chart:Chart ;
    chart:chartType "area" ;
    chart:title "Bangladesh : Unemployment rate from 1999 to 2020" ;
    chart:xAxis ex:x-712 ;
    chart:yAxis ex:y-712 .

ex:x-712 a chart:Axis ;
    chart:label "Year" .

ex:y-712 a chart:Axis ;
    chart:label "" .

ex:series-712-1 a chart:Series .

ex:mark-712-1-1 a chart:DataPoint ;
    chart:series ex:series-712-1 ;
    chart:category "Unemployment rate Dec" ;
    chart:value "31"^^xsd:decimal .

