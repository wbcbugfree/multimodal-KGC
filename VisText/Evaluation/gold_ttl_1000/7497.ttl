@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-7497 a chart:Chart ;
    chart:chartType "area" ;
    chart:title "Total population of Barbados from 2008 to 2018 , by gender (in 1,000 inhabitants)" ;
    chart:xAxis ex:x-7497 ;
    chart:yAxis ex:y-7497 .

ex:x-7497 a chart:Axis ;
    chart:label "Year" .

ex:y-7497 a chart:Axis ;
    chart:label "" .

ex:series-7497-1 a chart:Series .

ex:mark-7497-1-1 a chart:DataPoint ;
    chart:series ex:series-7497-1 ;
    chart:category "Total Dec" ;
    chart:value "31"^^xsd:decimal .

