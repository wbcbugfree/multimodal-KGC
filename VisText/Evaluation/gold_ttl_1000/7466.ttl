@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-7466 a chart:Chart ;
    chart:chartType "line" ;
    chart:title "Average student loan debt on entry to repayment in the United Kingdom (UK) from 2000 to 2020 , by repayment cohort (in 1,000 GBP) by country" ;
    chart:xAxis ex:x-7466 ;
    chart:yAxis ex:y-7466 .

ex:x-7466 a chart:Axis ;
    chart:label "Year while the y-axis shows England" .

ex:y-7466 a chart:Axis ;
    chart:label "England" .

ex:series-7466-1 a chart:Series .

ex:mark-7466-1-1 a chart:DataPoint ;
    chart:series ex:series-7466-1 ;
    chart:category "Dec" ;
    chart:value "31"^^xsd:decimal .

