@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-607 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Average ticket price Buffalo Sabres (NHL) games from 2005/06 to 2014/15 (in U.S. dollars)" ;
    chart:xAxis ex:x-607 ;
    chart:yAxis ex:y-607 .

ex:x-607 a chart:Axis ;
    chart:label "Year" .

ex:y-607 a chart:Axis ;
    chart:label "" .

ex:series-607-1 a chart:Series .

ex:mark-607-1-1 a chart:DataPoint ;
    chart:series ex:series-607-1 ;
    chart:category "Average ticket price in U.S. dollars 14/15" ;
    chart:value "49.72"^^xsd:decimal .

ex:mark-607-1-2 a chart:DataPoint ;
    chart:series ex:series-607-1 ;
    chart:category "13/14" ;
    chart:value "47.94"^^xsd:decimal .

