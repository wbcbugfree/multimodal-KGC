@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-5023 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Sponsorship worth of professional tennis players worldwide as of July 2019 (in million U.S. dollars)" ;
    chart:xAxis ex:x-5023 ;
    chart:yAxis ex:y-5023 .

ex:x-5023 a chart:Axis ;
    chart:label "Sponsorship worth in million U.S. dollars" .

ex:y-5023 a chart:Axis ;
    chart:label "player" .

ex:series-5023-1 a chart:Series .

ex:mark-5023-1-1 a chart:DataPoint ;
    chart:series ex:series-5023-1 ;
    chart:category "Roger Federer" ;
    chart:value "33"^^xsd:decimal .

