    chart:series ex:series-528-1 ;
    chart:category "Ed Kranepool" ;
    chart:value "559"^^xsd:decimal .

ex:mark-528-1-7 a chart:DataPoint ;
    chart:series ex:series-528-1 ;
    chart:category "Carlos Beltran" ;
    chart:value "538"^^xsd:decimal .

ex:mark-528-1-8 a chart:DataPoint ;
    chart:series ex:series-528-1 ;
    chart:category "Edgardo Alfonzo" ;
    chart:value "521"^^xsd:decimal .

