@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-6877 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Number of households in the United States from 1970 to 2020 , by size of household (in millions)" ;
    chart:xAxis ex:x-6877 ;
    chart:yAxis ex:y-6877 .

ex:x-6877 a chart:Axis ;
    chart:label "Three persons while the y-axis measures Five persons" .

ex:y-6877 a chart:Axis ;
    chart:label "Five persons" .

ex:series-6877-1 a chart:Series .
