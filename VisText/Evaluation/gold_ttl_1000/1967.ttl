@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-1967 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Number of doping cases in international sports from 2000 to 2010" ;
    chart:xAxis ex:x-1967 ;
    chart:yAxis ex:y-1967 .

ex:x-1967 a chart:Axis ;
    chart:label "Year" .

ex:y-1967 a chart:Axis ;
    chart:label "Number of cases" .

ex:series-1967-1 a chart:Series .

ex:mark-1967-1-1 a chart:DataPoint ;
    chart:series ex:series-1967-1 ;
    chart:category "2005*" ;
    chart:value "430"^^xsd:decimal .
