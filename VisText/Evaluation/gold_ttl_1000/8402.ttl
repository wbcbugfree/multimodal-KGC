@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-8402 a chart:Chart ;
    chart:chartType "area" ;
    chart:title "Consumer Price Index of cereal and its products across urban and rural India from July 2019 to July 2020" ;
    chart:xAxis ex:x-8402 ;
    chart:yAxis ex:y-8402 .

ex:x-8402 a chart:Axis ;
    chart:label "Month while the y-axis plots Rural" .

ex:y-8402 a chart:Axis ;
    chart:label "" .

ex:series-8402-1 a chart:Series .

ex:mark-8402-1-1 a chart:DataPoint ;
    chart:series ex:series-8402-1 ;
    chart:category "Rural Jun" ;
    chart:value "30"^^xsd:decimal .

