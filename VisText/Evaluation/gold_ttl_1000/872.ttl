@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-872 a chart:Chart ;
    chart:chartType "line" ;
    chart:title "Largest one-day point gains of the Dow Jones Index from 1987 to June 2020" ;
    chart:xAxis ex:x-872 ;
    chart:yAxis ex:y-872 .

ex:x-872 a chart:Axis ;
    chart:label "Year" .

ex:y-872 a chart:Axis ;
    chart:label "Change in index points within one day while the x-axis measures Year" .

ex:series-872-1 a chart:Series .

ex:mark-872-1-1 a chart:DataPoint ;
    chart:series ex:series-872-1 ;
    chart:category "Change in index points within one day Oct" ;
    chart:value "12"^^xsd:decimal .

