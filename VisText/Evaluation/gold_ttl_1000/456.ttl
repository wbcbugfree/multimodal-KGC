@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-456 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Forecast volume of wheat consumed in the European Union (EU 27) from 2016 to 2029 (in 1,000 tonnes)" ;
    chart:xAxis ex:x-456 ;
    chart:yAxis ex:y-456 .

ex:x-456 a chart:Axis ;
    chart:label "Volume in thousand tonnes" .

ex:y-456 a chart:Axis ;
    chart:label "Year while the x-axis plots Volume in thousand tonnes" .

ex:series-456-1 a chart:Series .

ex:mark-456-1-1 a chart:DataPoint ;
    chart:series ex:series-456-1 ;
    chart:category "in thousand tonnes Year" ;
    chart:value "110965"^^xsd:decimal .

ex:mark-456-1-2 a chart:DataPoint ;
    chart:series ex:series-456-1 ;
    chart:category "2029*" ;
    chart:value "110616"^^xsd:decimal .

