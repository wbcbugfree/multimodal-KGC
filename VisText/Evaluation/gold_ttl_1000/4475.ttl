@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-4475 a chart:Chart ;
    chart:chartType "area" ;
    chart:title "Total revenues of MetLife from 2008 to 2019 (in billion U.S. dollars)" ;
    chart:xAxis ex:x-4475 ;
    chart:yAxis ex:y-4475 .

ex:x-4475 a chart:Axis ;
    chart:label "Year" .

ex:y-4475 a chart:Axis ;
