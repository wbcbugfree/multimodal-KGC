@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-1305 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "El Salvador : National debt from 2014 to 2024 (in billion U.S. dollars)" ;
    chart:xAxis ex:x-1305 ;
    chart:yAxis ex:y-1305 .

ex:x-1305 a chart:Axis ;
    chart:label "National" .

ex:y-1305 a chart:Axis ;
    chart:label "" .

ex:series-1305-1 a chart:Series .

ex:mark-1305-1-1 a chart:DataPoint ;
    chart:series ex:series-1305-1 ;
    chart:category "debt in billion U.S. dollars Year" ;
    chart:value "23.09"^^xsd:decimal .

ex:mark-1305-1-2 a chart:DataPoint ;
    chart:series ex:series-1305-1 ;
    chart:category "2024*" ;
    chart:value "22"^^xsd:decimal .

ex:mark-1305-1-3 a chart:DataPoint ;
    chart:series ex:series-1305-1 ;
    chart:category "2023*" ;
    chart:value "21.01"^^xsd:decimal .

ex:mark-1305-1-4 a chart:DataPoint ;
    chart:series ex:series-1305-1 ;
    chart:category "2022*" ;
    chart:value "20.12"^^xsd:decimal .

ex:mark-1305-1-5 a chart:DataPoint ;
    chart:series ex:series-1305-1 ;
    chart:category "2021*" ;
    chart:value "19.29"^^xsd:decimal .

ex:mark-1305-1-6 a chart:DataPoint ;
    chart:series ex:series-1305-1 ;
    chart:category "2020*" ;
    chart:value "18.36"^^xsd:decimal .

ex:mark-1305-1-7 a chart:DataPoint ;
    chart:series ex:series-1305-1 ;
    chart:category "2019*" ;
    chart:value "17.48"^^xsd:decimal .
