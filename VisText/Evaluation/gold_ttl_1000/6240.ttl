@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-6240 a chart:Chart ;
    chart:chartType "area" ;
    chart:title "Total U.S. domestic use of corn from 2001 to 2019 (in million bushels)" ;
    chart:xAxis ex:x-6240 ;
    chart:yAxis ex:y-6240 .

ex:x-6240 a chart:Axis ;
    chart:label "Year" .

ex:y-6240 a chart:Axis ;
    chart:label "" .

ex:series-6240-1 a chart:Series .

ex:mark-6240-1-1 a chart:DataPoint ;
    chart:series ex:series-6240-1 ;
    chart:category "Feed and residual Dec" ;
    chart:value "31"^^xsd:decimal .

