@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-6120 a chart:Chart ;
    chart:chartType "area" ;
    chart:title "CVS Health 's revenue from 2010 to 2019 , by segment (in billion U.S. dollars)" ;
    chart:xAxis ex:x-6120 ;
    chart:yAxis ex:y-6120 .

ex:x-6120 a chart:Axis ;
    chart:label "Year" .

ex:y-6120 a chart:Axis ;
    chart:label "" .

ex:series-6120-1 a chart:Series .

ex:mark-6120-1-1 a chart:DataPoint ;
    chart:series ex:series-6120-1 ;
    chart:category "Pharmacy services Dec" ;
    chart:value "31"^^xsd:decimal .

