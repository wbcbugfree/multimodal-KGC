@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-8307 a chart:Chart ;
    chart:chartType "line" ;
    chart:title "Forecast of population growth in Iceland from 2020 to 2030 , by age group" ;
    chart:xAxis ex:x-8307 ;
    chart:yAxis ex:y-8307 .

ex:x-8307 a chart:Axis ;
    chart:label "Year" .

ex:y-8307 a chart:Axis ;
    chart:label "80 years and older while the x-axis plots Year" .

ex:series-8307-1 a chart:Series .

ex:mark-8307-1-1 a chart:DataPoint ;
    chart:series ex:series-8307-1 ;
    chart:category "years and older Dec" ;
    chart:value "31"^^xsd:decimal .

ex:mark-8307-1-2 a chart:DataPoint ;
    chart:series ex:series-8307-1 ;
    chart:category "Dec" ;
    chart:value "31"^^xsd:decimal .

