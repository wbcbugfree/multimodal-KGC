@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-8339 a chart:Chart ;
    chart:chartType "area" ;
    chart:title "Occupancy rate of Marriott International hotels worldwide from 2010 to 2019 , by region" ;
    chart:xAxis ex:x-8339 ;
    chart:yAxis ex:y-8339 .

ex:x-8339 a chart:Axis ;
    chart:label "Year" .

ex:y-8339 a chart:Axis ;
    chart:label "North America while the x-axis measures Year" .

ex:series-8339-1 a chart:Series .

ex:mark-8339-1-1 a chart:DataPoint ;
    chart:series ex:series-8339-1 ;
    chart:category "North America Dec" ;
    chart:value "31"^^xsd:decimal .

