@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-2090 a chart:Chart ;
    chart:chartType "area" ;
    chart:title "Number of drug-related deaths due to benzodiazepine use in England and Wales from 1993 to 2019" ;
    chart:xAxis ex:x-2090 ;
    chart:yAxis ex:y-2090 .

ex:x-2090 a chart:Axis ;
    chart:label "Year" .

ex:y-2090 a chart:Axis ;
    chart:label "Number of deaths while the x-axis shows Year" .

ex:series-2090-1 a chart:Series .

ex:mark-2090-1-1 a chart:DataPoint ;
    chart:series ex:series-2090-1 ;
    chart:category "Number of deaths Dec" ;
    chart:value "31"^^xsd:decimal .

ex:mark-2090-1-2 a chart:DataPoint ;
    chart:series ex:series-2090-1 ;
    chart:category "Dec" ;
    chart:value "31"^^xsd:decimal .

