@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-4408 a chart:Chart ;
    chart:chartType "line" ;
    chart:title "Number of people living below the poverty line in the United States from 1990 to 2019 (in millions)" ;
    chart:xAxis ex:x-4408 ;
    chart:yAxis ex:y-4408 .

ex:x-4408 a chart:Axis ;
    chart:label "Year" .

ex:y-4408 a chart:Axis ;
    chart:label "" .

ex:series-4408-1 a chart:Series .

ex:mark-4408-1-1 a chart:DataPoint ;
    chart:series ex:series-4408-1 ;
    chart:category "Number of poor people in millions Dec" ;
    chart:value "31"^^xsd:decimal .

