@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-2974 a chart:Chart ;
    chart:chartType "line" ;
    chart:title "Number of fixed broadband subscriptions per 100 inhabitants in Mexico from 2000 to 2019" ;
    chart:xAxis ex:x-2974 ;
    chart:yAxis ex:y-2974 .

ex:x-2974 a chart:Axis ;
    chart:label "Year" .

ex:y-2974 a chart:Axis ;
    chart:label "" .

ex:series-2974-1 a chart:Series .

ex:mark-2974-1-1 a chart:DataPoint ;
    chart:series ex:series-2974-1 ;
    chart:category "Number of subscriptions per" ;
    chart:value "100"^^xsd:decimal .

