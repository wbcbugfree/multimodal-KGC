@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-3052 a chart:Chart ;
    chart:chartType "line" ;
    chart:title "Number of Nissan cars sold in Sweden from 2009 to 2019" ;
    chart:xAxis ex:x-3052 ;
    chart:yAxis ex:y-3052 .

ex:x-3052 a chart:Axis ;
    chart:label "Year" .

ex:y-3052 a chart:Axis ;
    chart:label "" .

ex:series-3052-1 a chart:Series .

ex:mark-3052-1-1 a chart:DataPoint ;
    chart:series ex:series-3052-1 ;
    chart:category "Units sold Dec" ;
    chart:value "31"^^xsd:decimal .

