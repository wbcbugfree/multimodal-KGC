@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-4988 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Italy : Budget balance from 2014 to 2024 (in billion euros)" ;
    chart:xAxis ex:x-4988 ;
    chart:yAxis ex:y-4988 .

ex:x-4988 a chart:Axis ;
    chart:label "Year" .

ex:y-4988 a chart:Axis ;
    chart:label "" .

ex:series-4988-1 a chart:Series .

ex:mark-4988-1-1 a chart:DataPoint ;
    chart:series ex:series-4988-1 ;
    chart:category "Budget balance in billion euros 2024* −51.31 2023*..." ;
    chart:value "2018"^^xsd:decimal .

ex:mark-4988-1-2 a chart:DataPoint ;
    chart:series ex:series-4988-1 ;
    chart:category "−37.51" ;
    chart:value "2017"^^xsd:decimal .

ex:mark-4988-1-3 a chart:DataPoint ;
    chart:series ex:series-4988-1 ;
    chart:category "−41.29" ;
    chart:value "2016"^^xsd:decimal .

ex:mark-4988-1-4 a chart:DataPoint ;
    chart:series ex:series-4988-1 ;
    chart:category "−42.66" ;
    chart:value "2015"^^xsd:decimal .

ex:mark-4988-1-5 a chart:DataPoint ;
