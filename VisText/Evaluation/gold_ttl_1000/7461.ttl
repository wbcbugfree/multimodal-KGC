@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-7461 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Distribution of individuals who made online purchases in Luxembourg from 2009 to 2019" ;
    chart:xAxis ex:x-7461 ;
    chart:yAxis ex:y-7461 .

ex:x-7461 a chart:Axis ;
    chart:label "More" .

ex:y-7461 a chart:Axis ;
    chart:label "" .

ex:series-7461-1 a chart:Series .

ex:mark-7461-1-1 a chart:DataPoint ;
    chart:series ex:series-7461-1 ;
    chart:category "than a year ago Within the first trimester of the ..." ;
    chart:value "0.05"^^xsd:decimal .
