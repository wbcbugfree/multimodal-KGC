    chart:title "How do you typically use your mobile phone to find inspiration or ideas on where to travel ?" ;
    chart:xAxis ex:x-4330 ;
    chart:yAxis ex:y-4330 .

ex:x-4330 a chart:Axis ;
    chart:label "Response" .

ex:y-4330 a chart:Axis ;
    chart:label "Share of respondents while the x-axis plots Response" .

