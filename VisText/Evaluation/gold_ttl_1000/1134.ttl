@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-1134 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Average game attendance in the Football League Championship in the United Kingdom (UK) from season 2010/2011 to season 2019/2020" ;
    chart:xAxis ex:x-1134 ;
    chart:yAxis ex:y-1134 .

ex:x-1134 a chart:Axis ;
    chart:label "Average attendance" .

ex:y-1134 a chart:Axis ;
    chart:label "sports season while the x-axis measures Average attendance" .

ex:series-1134-1 a chart:Series .

ex:mark-1134-1-1 a chart:DataPoint ;
    chart:series ex:series-1134-1 ;
    chart:category "attendance sports season" ;
    chart:value "14949"^^xsd:decimal .

