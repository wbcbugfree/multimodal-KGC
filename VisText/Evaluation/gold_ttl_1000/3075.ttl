@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-3075 a chart:Chart ;
    chart:chartType "line" ;
    chart:title "Total assets of WD-40 Company from 2009 to 2020 (in million U.S. dollars)" ;
    chart:xAxis ex:x-3075 ;
    chart:yAxis ex:y-3075 .

ex:x-3075 a chart:Axis ;
    chart:label "Year with linear scale from 2010 to 2018" .

ex:y-3075 a chart:Axis ;
    chart:label "Total assets in million U" .

ex:series-3075-1 a chart:Series .

ex:mark-3075-1-1 a chart:DataPoint ;
    chart:series ex:series-3075-1 ;
    chart:category "Total assets in million U.S. dollars Dec" ;
    chart:value "31"^^xsd:decimal .

