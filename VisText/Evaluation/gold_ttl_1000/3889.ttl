@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-3889 a chart:Chart ;
    chart:chartType "line" ;
    chart:title "Average price of home heating oil in the Canadian city of Yellowknife from 1990 to 2011 (in Canadian cents per litre)" ;
    chart:xAxis ex:x-3889 ;
    chart:yAxis ex:y-3889 .

ex:x-3889 a chart:Axis ;
    chart:label "Year" .

ex:y-3889 a chart:Axis ;
    chart:label "" .

ex:series-3889-1 a chart:Series .

ex:mark-3889-1-1 a chart:DataPoint ;
    chart:series ex:series-3889-1 ;
    chart:category "Price in Canadian cents per litre Dec" ;
    chart:value "31"^^xsd:decimal .

