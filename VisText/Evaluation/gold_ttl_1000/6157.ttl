@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-6157 a chart:Chart ;
    chart:chartType "line" ;
    chart:title "Unit shipments of electric/gas cooking appliances in the U.S. from 2007 to 2017 (in 1,000s)" ;
    chart:xAxis ex:x-6157 ;
    chart:yAxis ex:y-6157 .

ex:x-6157 a chart:Axis ;
    chart:label "Year" .

ex:y-6157 a chart:Axis ;
    chart:label "Electric ovens while the x-axis plots Year" .

ex:series-6157-1 a chart:Series .

ex:mark-6157-1-1 a chart:DataPoint ;
    chart:series ex:series-6157-1 ;
    chart:category "Electric ovens Dec" ;
    chart:value "31"^^xsd:decimal .

