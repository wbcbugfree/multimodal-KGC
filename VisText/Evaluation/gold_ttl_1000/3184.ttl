@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-3184 a chart:Chart ;
    chart:chartType "area" ;
    chart:title "Total number of betting shops in the gambling industry in Great Britain from March 31 , 2011 to September 30 , 2019 (in 1,000s)" ;
    chart:xAxis ex:x-3184 ;
    chart:yAxis ex:y-3184 .

ex:x-3184 a chart:Axis ;
    chart:label "Time" .

ex:y-3184 a chart:Axis ;
    chart:label "" .

ex:series-3184-1 a chart:Series .

