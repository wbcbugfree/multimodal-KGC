@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-360 a chart:Chart ;
    chart:chartType "line" ;
    chart:title "Number of road traffic fatalities in Slovenia from 2006 to 2019" ;
    chart:xAxis ex:x-360 ;
    chart:yAxis ex:y-360 .

ex:x-360 a chart:Axis ;
    chart:label "Year" .

ex:y-360 a chart:Axis ;
    chart:label "Number of fatalities" .

ex:series-360-1 a chart:Series .

ex:mark-360-1-1 a chart:DataPoint ;
    chart:series ex:series-360-1 ;
    chart:category "Dec" ;
    chart:value "31"^^xsd:decimal .

