@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-7781 a chart:Chart ;
    chart:chartType "area" ;
    chart:title "How many hours in a typical week would you say you use the internet ?" ;
    chart:xAxis ex:x-7781 ;
    chart:yAxis ex:y-7781 .

ex:x-7781 a chart:Axis ;
    chart:label "Response" .

ex:y-7781 a chart:Axis ;
    chart:label "" .

ex:series-7781-1 a chart:Series .

ex:mark-7781-1-1 a chart:DataPoint ;
    chart:series ex:series-7781-1 ;
    chart:category "At home Dec" ;
    chart:value "31"^^xsd:decimal .

