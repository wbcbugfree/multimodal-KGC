@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-359 a chart:Chart ;
    chart:chartType "line" ;
    chart:title "Sales turnover of shops for do-it-yourself articles in the Netherlands from 2008 to 2019 (as value index)" ;
    chart:xAxis ex:x-359 ;
    chart:yAxis ex:y-359 .

ex:x-359 a chart:Axis ;
    chart:label "Year while the y-axis shows Turnover value index (2015=100)" .

ex:y-359 a chart:Axis ;
    chart:label "Turnover value index (2015=100)" .

ex:series-359-1 a chart:Series .

ex:mark-359-1-1 a chart:DataPoint ;
    chart:series ex:series-359-1 ;
    chart:category "Dec" ;
    chart:value "31"^^xsd:decimal .

