@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-242 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Revenue of the Buffalo Sabres from 2005/06 to 2018/19 (in million U.S. dollars)" ;
    chart:xAxis ex:x-242 ;
    chart:yAxis ex:y-242 .

ex:x-242 a chart:Axis ;
    chart:label "Year while the y-axis plots Revenue in million U" .

ex:y-242 a chart:Axis ;
    chart:label "" .

ex:series-242-1 a chart:Series .

ex:mark-242-1-1 a chart:DataPoint ;
    chart:series ex:series-242-1 ;
    chart:category "Revenue in million U.S. dollars 2018/19" ;
    chart:value "135"^^xsd:decimal .

