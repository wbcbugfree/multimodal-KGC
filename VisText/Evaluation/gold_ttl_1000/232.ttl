@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-232 a chart:Chart ;
    chart:chartType "line" ;
    chart:title "Registered cases of murder and manslaughter in Belgium from 2008 to 2019" ;
    chart:xAxis ex:x-232 ;
    chart:yAxis ex:y-232 .

ex:x-232 a chart:Axis ;
    chart:label "Year" .

ex:y-232 a chart:Axis ;
    chart:label "" .

ex:series-232-1 a chart:Series .

ex:mark-232-1-1 a chart:DataPoint ;
    chart:series ex:series-232-1 ;
    chart:category "Cases of murder and manslaughter Dec" ;
    chart:value "31"^^xsd:decimal .

