@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-4755 a chart:Chart ;
    chart:chartType "line" ;
    chart:title "Revenue from music streaming in the United States from 2010 to 2019 (in billion U.S. dollars)" ;
    chart:xAxis ex:x-4755 ;
    chart:yAxis ex:y-4755 .

ex:x-4755 a chart:Axis ;
    chart:label "Year" .

ex:y-4755 a chart:Axis ;
    chart:label "Revenue in billion U" .

ex:series-4755-1 a chart:Series .

ex:mark-4755-1-1 a chart:DataPoint ;
    chart:series ex:series-4755-1 ;
    chart:category "Revenue in billion U.S. dollars Dec" ;
    chart:value "31"^^xsd:decimal .

