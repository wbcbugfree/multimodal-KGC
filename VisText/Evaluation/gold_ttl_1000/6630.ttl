ex:chart-6630 a chart:Chart ;
    chart:chartType "line" ;
    chart:title "Median hourly earnings for full-time employees in the United Kingdom from 2004 to 2020 , by age group (in GBP)" ;
    chart:xAxis ex:x-6630 ;
    chart:yAxis ex:y-6630 .

ex:x-6630 a chart:Axis ;
    chart:label "Year" .

