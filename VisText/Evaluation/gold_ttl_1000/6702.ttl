@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-6702 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Number of bankruptcies after the coronavirus outbreak in Sweden from February to November 2020 , by industry" ;
    chart:xAxis ex:x-6702 ;
    chart:yAxis ex:y-6702 .

ex:x-6702 a chart:Axis ;
    chart:label "Month" .

ex:y-6702 a chart:Axis ;
    chart:label "Transportation while the x-axis plots Month" .

ex:series-6702-1 a chart:Series .

ex:mark-6702-1-1 a chart:DataPoint ;
    chart:series ex:series-6702-1 ;
    chart:category "Transportation Feb" ;
    chart:value "35"^^xsd:decimal .

ex:mark-6702-1-2 a chart:DataPoint ;
    chart:series ex:series-6702-1 ;
    chart:category "Mar" ;
    chart:value "43"^^xsd:decimal .

ex:mark-6702-1-3 a chart:DataPoint ;
    chart:series ex:series-6702-1 ;
    chart:category "Apr" ;
    chart:value "34"^^xsd:decimal .

ex:mark-6702-1-4 a chart:DataPoint ;
    chart:series ex:series-6702-1 ;
    chart:category "May" ;
    chart:value "36"^^xsd:decimal .

ex:mark-6702-1-5 a chart:DataPoint ;
    chart:series ex:series-6702-1 ;
    chart:category "Jun" ;
    chart:value "30"^^xsd:decimal .

ex:mark-6702-1-6 a chart:DataPoint ;
    chart:series ex:series-6702-1 ;
    chart:category "Jul" ;
    chart:value "16"^^xsd:decimal .

ex:mark-6702-1-7 a chart:DataPoint ;
    chart:series ex:series-6702-1 ;
    chart:category "Aug" ;
    chart:value "24"^^xsd:decimal .

ex:mark-6702-1-8 a chart:DataPoint ;
    chart:series ex:series-6702-1 ;
    chart:category "Sep" ;
    chart:value "26"^^xsd:decimal .

ex:mark-6702-1-9 a chart:DataPoint ;
    chart:series ex:series-6702-1 ;
    chart:category "Oct" ;
    chart:value "31"^^xsd:decimal .

ex:mark-6702-1-10 a chart:DataPoint ;
    chart:series ex:series-6702-1 ;
    chart:category "Nov" ;
    chart:value "34"^^xsd:decimal .
