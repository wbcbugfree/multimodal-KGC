@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-1248 a chart:Chart ;
    chart:chartType "area" ;
    chart:title "Audi 's equity ratio from FY 2005 to FY 2019" ;
    chart:xAxis ex:x-1248 ;
    chart:yAxis ex:y-1248 .

ex:x-1248 a chart:Axis ;
    chart:label "Year" .

ex:y-1248 a chart:Axis ;
    chart:label "" .

ex:series-1248-1 a chart:Series .

