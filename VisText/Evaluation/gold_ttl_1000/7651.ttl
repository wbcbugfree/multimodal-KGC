@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-7651 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Which region or country do you believe will witness the most M & A activity in Europe over the next 12 months ?" ;
    chart:xAxis ex:x-7651 ;
    chart:yAxis ex:y-7651 .

ex:x-7651 a chart:Axis ;
    chart:label "Response" .

ex:y-7651 a chart:Axis ;
    chart:label "2nd most active while the x-axis shows Response" .

ex:series-7651-1 a chart:Series .

ex:mark-7651-1-1 a chart:DataPoint ;
    chart:series ex:series-7651-1 ;
    chart:category "2nd most active Germany" ;
    chart:value "0.2"^^xsd:decimal .

ex:mark-7651-1-2 a chart:DataPoint ;
    chart:series ex:series-7651-1 ;
    chart:category "Nordic" ;
    chart:value "0.2"^^xsd:decimal .

ex:mark-7651-1-3 a chart:DataPoint ;
    chart:series ex:series-7651-1 ;
    chart:category "United Kingdom and Ireland" ;
    chart:value "0.13"^^xsd:decimal .

ex:mark-7651-1-4 a chart:DataPoint ;
    chart:series ex:series-7651-1 ;
    chart:category "Austria and Switzerland" ;
    chart:value "0.1"^^xsd:decimal .

ex:mark-7651-1-5 a chart:DataPoint ;
    chart:series ex:series-7651-1 ;
    chart:category "Benelux" ;
    chart:value "0.1"^^xsd:decimal .

ex:mark-7651-1-6 a chart:DataPoint ;
    chart:series ex:series-7651-1 ;
    chart:category "France" ;
    chart:value "0.08"^^xsd:decimal .

ex:mark-7651-1-7 a chart:DataPoint ;
    chart:series ex:series-7651-1 ;
    chart:category "South Eastern Europe" ;
    chart:value "0.05"^^xsd:decimal .

ex:mark-7651-1-8 a chart:DataPoint ;
    chart:series ex:series-7651-1 ;
    chart:category "CEE (excluding Russia and Ukraine)" ;
    chart:value "0.07"^^xsd:decimal .

ex:mark-7651-1-9 a chart:DataPoint ;
    chart:series ex:series-7651-1 ;
    chart:category "Italy" ;
    chart:value "0.03"^^xsd:decimal .

ex:mark-7651-1-10 a chart:DataPoint ;
