@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-5709 a chart:Chart ;
    chart:chartType "area" ;
    chart:title "Number of U.S. air strikes in Pakistan from 2004 to 2018" ;
    chart:xAxis ex:x-5709 ;
    chart:yAxis ex:y-5709 .

ex:x-5709 a chart:Axis ;
    chart:label "Year" .

ex:y-5709 a chart:Axis ;
    chart:label "" .

ex:series-5709-1 a chart:Series .

ex:mark-5709-1-1 a chart:DataPoint ;
    chart:series ex:series-5709-1 ;
    chart:category "Number of air strikes Dec" ;
    chart:value "31"^^xsd:decimal .

