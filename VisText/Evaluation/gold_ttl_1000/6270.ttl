@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-6270 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Portugal : Government revenue and spending from 2014 to 2024 (in billion euros)" ;
    chart:xAxis ex:x-6270 ;
    chart:yAxis ex:y-6270 .

ex:x-6270 a chart:Axis ;
    chart:label "Spending" .

ex:y-6270 a chart:Axis ;
    chart:label "" .

ex:series-6270-1 a chart:Series .

ex:mark-6270-1-1 a chart:DataPoint ;
    chart:series ex:series-6270-1 ;
    chart:category "Year" ;
    chart:value "104.29"^^xsd:decimal .

ex:mark-6270-1-2 a chart:DataPoint ;
    chart:series ex:series-6270-1 ;
    chart:category "2024*" ;
    chart:value "101.61"^^xsd:decimal .

