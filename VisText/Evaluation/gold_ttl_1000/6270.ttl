    chart:series ex:series-6270-1 ;
    chart:category "2022*" ;
    chart:value "96.11"^^xsd:decimal .

ex:mark-6270-1-5 a chart:DataPoint ;
    chart:series ex:series-6270-1 ;
    chart:category "2021*" ;
    chart:value "93.69"^^xsd:decimal .

ex:mark-6270-1-6 a chart:DataPoint ;
    chart:series ex:series-6270-1 ;
    chart:category "2020*" ;
    chart:value "91.39"^^xsd:decimal .

ex:mark-6270-1-7 a chart:DataPoint ;
