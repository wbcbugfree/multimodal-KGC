@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-3711 a chart:Chart ;
    chart:chartType "area" ;
    chart:title "Air conditioners shipments in the U.S. from 2001 to 2019 (in millions)" ;
    chart:xAxis ex:x-3711 ;
    chart:yAxis ex:y-3711 .

ex:x-3711 a chart:Axis ;
    chart:label "Year with a linear scale with a minimum of 2005 and a maximum of 2015" .

ex:y-3711 a chart:Axis ;
    chart:label "" .

ex:series-3711-1 a chart:Series .

ex:mark-3711-1-1 a chart:DataPoint ;
    chart:series ex:series-3711-1 ;
    chart:category "Number of shipments in millions Dec" ;
    chart:value "31"^^xsd:decimal .

