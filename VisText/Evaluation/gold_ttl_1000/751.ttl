@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-751 a chart:Chart ;
    chart:chartType "area" ;
    chart:title "Euro (EUR) to Swiss franc (CHF) average annual exchange rate from 1999 to 2019" ;
    chart:xAxis ex:x-751 ;
    chart:yAxis ex:y-751 .

ex:x-751 a chart:Axis ;
    chart:label "Year" .

ex:y-751 a chart:Axis ;
    chart:label "Exchange rate" .

ex:series-751-1 a chart:Series .

ex:mark-751-1-1 a chart:DataPoint ;
    chart:series ex:series-751-1 ;
    chart:category "Dec" ;
    chart:value "31"^^xsd:decimal .

