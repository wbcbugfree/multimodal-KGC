@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-4530 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Greece : National debt from 2014 to 2024 (in billion U.S. dollars)" ;
    chart:xAxis ex:x-4530 ;
    chart:yAxis ex:y-4530 .

ex:x-4530 a chart:Axis ;
    chart:label "National" .

ex:y-4530 a chart:Axis ;
    chart:label "" .

ex:series-4530-1 a chart:Series .

ex:mark-4530-1-1 a chart:DataPoint ;
    chart:series ex:series-4530-1 ;
    chart:category "debt in billion U.S. dollars Year" ;
    chart:value "373.15"^^xsd:decimal .

ex:mark-4530-1-2 a chart:DataPoint ;
    chart:series ex:series-4530-1 ;
    chart:category "2024*" ;
    chart:value "370.4"^^xsd:decimal .

ex:mark-4530-1-3 a chart:DataPoint ;
    chart:series ex:series-4530-1 ;
    chart:category "2023*" ;
    chart:value "371.07"^^xsd:decimal .

ex:mark-4530-1-4 a chart:DataPoint ;
    chart:series ex:series-4530-1 ;
    chart:category "2022*" ;
    chart:value "372.55"^^xsd:decimal .

ex:mark-4530-1-5 a chart:DataPoint ;
    chart:series ex:series-4530-1 ;
    chart:category "2021*" ;
    chart:value "370.46"^^xsd:decimal .

ex:mark-4530-1-6 a chart:DataPoint ;
    chart:series ex:series-4530-1 ;
    chart:category "2020*" ;
    chart:value "369.35"^^xsd:decimal .

ex:mark-4530-1-7 a chart:DataPoint ;
