@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-7845 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Number of McColl 's stores in the United Kingdom (UK) as of 2019 , by type and region" ;
    chart:xAxis ex:x-7845 ;
    chart:yAxis ex:y-7845 .

ex:x-7845 a chart:Axis ;
    chart:label "Newsagent" .

ex:y-7845 a chart:Axis ;
    chart:label "region of the United Kingdom" .

ex:series-7845-1 a chart:Series .

ex:mark-7845-1-1 a chart:DataPoint ;
    chart:series ex:series-7845-1 ;
    chart:category "Scotland" ;
    chart:value "8"^^xsd:decimal .

ex:mark-7845-1-2 a chart:DataPoint ;
    chart:series ex:series-7845-1 ;
    chart:category "North East" ;
    chart:value "23"^^xsd:decimal .

ex:mark-7845-1-3 a chart:DataPoint ;
    chart:series ex:series-7845-1 ;
    chart:category "North West" ;
    chart:value "10"^^xsd:decimal .

ex:mark-7845-1-4 a chart:DataPoint ;
    chart:series ex:series-7845-1 ;
    chart:category "Yorkshire and the Humber" ;
    chart:value "11"^^xsd:decimal .

ex:mark-7845-1-5 a chart:DataPoint ;
    chart:series ex:series-7845-1 ;
    chart:category "East Midlands" ;
    chart:value "30"^^xsd:decimal .

ex:mark-7845-1-6 a chart:DataPoint ;
    chart:series ex:series-7845-1 ;
    chart:category "West Midlands" ;
    chart:value "4"^^xsd:decimal .

ex:mark-7845-1-7 a chart:DataPoint ;
    chart:series ex:series-7845-1 ;
    chart:category "Wales" ;
    chart:value "62"^^xsd:decimal .

ex:mark-7845-1-8 a chart:DataPoint ;
    chart:series ex:series-7845-1 ;
    chart:category "East of England" ;
    chart:value "4"^^xsd:decimal .

ex:mark-7845-1-9 a chart:DataPoint ;
    chart:series ex:series-7845-1 ;
    chart:category "London" ;
    chart:value "44"^^xsd:decimal .

ex:mark-7845-1-10 a chart:DataPoint ;
