    chart:series ex:series-6871-1 ;
    chart:category "Telecom" ;
    chart:value "0.07"^^xsd:decimal .

ex:mark-6871-1-5 a chart:DataPoint ;
    chart:series ex:series-6871-1 ;
    chart:category "Leisure travel" ;
    chart:value "0.08"^^xsd:decimal .

ex:mark-6871-1-6 a chart:DataPoint ;
    chart:series ex:series-6871-1 ;
    chart:category "Consumer Electronics & Computers" ;
    chart:value "0.07"^^xsd:decimal .

ex:mark-6871-1-7 a chart:DataPoint ;
    chart:series ex:series-6871-1 ;
    chart:category "Consumer packaged goods" ;
    chart:value "0.05"^^xsd:decimal .

ex:mark-6871-1-8 a chart:DataPoint ;
    chart:series ex:series-6871-1 ;
    chart:category "Pharma & healthcare" ;
    chart:value "0.04"^^xsd:decimal .

ex:mark-6871-1-9 a chart:DataPoint ;
    chart:series ex:series-6871-1 ;
    chart:category "Media" ;
    chart:value "0.04"^^xsd:decimal .
