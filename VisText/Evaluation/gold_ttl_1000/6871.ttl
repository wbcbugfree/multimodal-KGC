@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-6871 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Breakdown of U.S. online advertising revenue from 2010 to 2016 , by industry" ;
    chart:xAxis ex:x-6871 ;
    chart:yAxis ex:y-6871 .

ex:x-6871 a chart:Axis ;
    chart:label "2010" .

ex:y-6871 a chart:Axis ;
    chart:label "industry" .

ex:series-6871-1 a chart:Series .

ex:mark-6871-1-1 a chart:DataPoint ;
    chart:series ex:series-6871-1 ;
    chart:category "Retail" ;
    chart:value "0.12"^^xsd:decimal .

ex:mark-6871-1-2 a chart:DataPoint ;
    chart:series ex:series-6871-1 ;
    chart:category "Financial services" ;
    chart:value "0.11"^^xsd:decimal .

