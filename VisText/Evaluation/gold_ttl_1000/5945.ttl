@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-5945 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Monthly chained inflation rate in the United States from November 2019 to November 2020" ;
    chart:xAxis ex:x-5945 ;
    chart:yAxis ex:y-5945 .

ex:x-5945 a chart:Axis ;
    chart:label "Chained inflation rate" .

ex:y-5945 a chart:Axis ;
    chart:label "Month" .

ex:series-5945-1 a chart:Series .

ex:mark-5945-1-1 a chart:DataPoint ;
    chart:series ex:series-5945-1 ;
    chart:category "−0.001 Nov '20" ;
    chart:value "0"^^xsd:decimal .

ex:mark-5945-1-2 a chart:DataPoint ;
    chart:series ex:series-5945-1 ;
    chart:category "Oct '20" ;
    chart:value "0.002"^^xsd:decimal .

ex:mark-5945-1-3 a chart:DataPoint ;
    chart:series ex:series-5945-1 ;
    chart:category "Sep '20" ;
    chart:value "0.003"^^xsd:decimal .

ex:mark-5945-1-4 a chart:DataPoint ;
    chart:series ex:series-5945-1 ;
    chart:category "Aug '20" ;
    chart:value "0.005"^^xsd:decimal .

ex:mark-5945-1-5 a chart:DataPoint ;
    chart:series ex:series-5945-1 ;
    chart:category "Jul '20" ;
    chart:value "0.006"^^xsd:decimal .

ex:mark-5945-1-6 a chart:DataPoint ;
    chart:series ex:series-5945-1 ;
    chart:category "Jun '20" ;
    chart:value "0"^^xsd:decimal .

ex:mark-5945-1-7 a chart:DataPoint ;
    chart:series ex:series-5945-1 ;
    chart:category "May '20 −0.008 Apr '20 −0.003 Mar '20" ;
    chart:value "0.003"^^xsd:decimal .

ex:mark-5945-1-8 a chart:DataPoint ;
    chart:series ex:series-5945-1 ;
    chart:category "Feb '20" ;
    chart:value "0.004"^^xsd:decimal .
