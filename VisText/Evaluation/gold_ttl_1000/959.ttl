@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-959 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Market share of the leading physician-dispensed topical brands in the United States in 2012" ;
    chart:xAxis ex:x-959 ;
    chart:yAxis ex:y-959 .

ex:x-959 a chart:Axis ;
    chart:label "Topical" .

ex:y-959 a chart:Axis ;
    chart:label "" .

ex:series-959-1 a chart:Series .

ex:mark-959-1-1 a chart:DataPoint ;
    chart:series ex:series-959-1 ;
    chart:category "brand Market share Other" ;
    chart:value "0.369"^^xsd:decimal .

