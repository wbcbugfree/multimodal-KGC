@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-2548 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Average prices for palm oil worldwide from 2014 to 2025 (in nominal U.S. dollars per mt)" ;
    chart:xAxis ex:x-2548 ;
    chart:yAxis ex:y-2548 .

ex:x-2548 a chart:Axis ;
    chart:label "Price in nominal U" .

ex:y-2548 a chart:Axis ;
    chart:label "Year" .

ex:series-2548-1 a chart:Series .

ex:mark-2548-1-1 a chart:DataPoint ;
    chart:series ex:series-2548-1 ;
    chart:category "2025*" ;
    chart:value "763"^^xsd:decimal .

ex:mark-2548-1-2 a chart:DataPoint ;
    chart:series ex:series-2548-1 ;
    chart:category "2024*" ;
    chart:value "749"^^xsd:decimal .

ex:mark-2548-1-3 a chart:DataPoint ;
    chart:series ex:series-2548-1 ;
    chart:category "2023*" ;
    chart:value "736"^^xsd:decimal .

ex:mark-2548-1-4 a chart:DataPoint ;
    chart:series ex:series-2548-1 ;
    chart:category "2022*" ;
    chart:value "723"^^xsd:decimal .

ex:mark-2548-1-5 a chart:DataPoint ;
    chart:series ex:series-2548-1 ;
    chart:category "2021*" ;
    chart:value "710"^^xsd:decimal .

ex:mark-2548-1-6 a chart:DataPoint ;
    chart:series ex:series-2548-1 ;
    chart:category "2020*" ;
    chart:value "601"^^xsd:decimal .
