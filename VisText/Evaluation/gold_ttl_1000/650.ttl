    chart:series ex:series-650-1 ;
    chart:category "Backstreet Boys" ;
    chart:value "0.07"^^xsd:decimal .

ex:mark-650-1-6 a chart:DataPoint ;
    chart:series ex:series-650-1 ;
    chart:category "’N Sync" ;
    chart:value "0.06"^^xsd:decimal .

ex:mark-650-1-7 a chart:DataPoint ;
    chart:series ex:series-650-1 ;
    chart:category "New Edition" ;
    chart:value "0.03"^^xsd:decimal .

