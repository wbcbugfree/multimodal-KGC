@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-650 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Which group do you think is the greatest boy band of all time ?" ;
    chart:xAxis ex:x-650 ;
    chart:yAxis ex:y-650 .

ex:x-650 a chart:Axis ;
    chart:label "Response" .

ex:y-650 a chart:Axis ;
    chart:label "" .

ex:series-650-1 a chart:Series .

ex:mark-650-1-1 a chart:DataPoint ;
    chart:series ex:series-650-1 ;
    chart:category "Share of respondents Jackson" ;
    chart:value "5"^^xsd:decimal .

ex:mark-650-1-2 a chart:DataPoint ;
    chart:series ex:series-650-1 ;
    chart:category "The Four Seasons" ;
    chart:value "0.12"^^xsd:decimal .

