@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-7516 a chart:Chart ;
    chart:chartType "area" ;
    chart:title "Number of U.S. military and civil satellites sent into orbit or deep space from 1980 to 2008" ;
    chart:xAxis ex:x-7516 ;
    chart:yAxis ex:y-7516 .

ex:x-7516 a chart:Axis ;
    chart:label "Year" .

ex:y-7516 a chart:Axis ;
    chart:label "" .

ex:series-7516-1 a chart:Series .

ex:mark-7516-1-1 a chart:DataPoint ;
    chart:series ex:series-7516-1 ;
    chart:category "Civil satellites Dec" ;
    chart:value "31"^^xsd:decimal .

