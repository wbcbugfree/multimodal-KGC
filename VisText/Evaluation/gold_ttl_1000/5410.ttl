@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-5410 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Annual volume of concentrated milk produced in the Netherlands from 2008 to 2019 (in 1,000 kilograms)" ;
    chart:xAxis ex:x-5410 ;
    chart:yAxis ex:y-5410 .

ex:x-5410 a chart:Axis ;
    chart:label "Volume in thousand kilograms" .

ex:y-5410 a chart:Axis ;
    chart:label "Year" .

ex:series-5410-1 a chart:Series .

ex:mark-5410-1-1 a chart:DataPoint ;
    chart:series ex:series-5410-1 ;
    chart:category "2019*" ;
    chart:value "343298"^^xsd:decimal .
