@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-564 a chart:Chart ;
    chart:chartType "area" ;
    chart:title "Operating profit of the Roche Group from 2007 to 2019 (in million Swiss francs)" ;
    chart:xAxis ex:x-564 ;
    chart:yAxis ex:y-564 .

ex:x-564 a chart:Axis ;
    chart:label "Year" .

ex:y-564 a chart:Axis ;
    chart:label "" .

ex:series-564-1 a chart:Series .

ex:mark-564-1-1 a chart:DataPoint ;
    chart:series ex:series-564-1 ;
    chart:category "Operating profit in million Swiss francs Dec" ;
    chart:value "31"^^xsd:decimal .

