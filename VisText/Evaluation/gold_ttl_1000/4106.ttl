@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-4106 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Turkey : National debt from 2015 to 2025 in relation to gross domestic product (GDP)" ;
    chart:xAxis ex:x-4106 ;
    chart:yAxis ex:y-4106 .

ex:x-4106 a chart:Axis ;
    chart:label "Year" .

ex:y-4106 a chart:Axis ;
    chart:label "" .

ex:series-4106-1 a chart:Series .

ex:mark-4106-1-1 a chart:DataPoint ;
    chart:series ex:series-4106-1 ;
    chart:category "National debt in relation to GDP 2025*" ;
    chart:value "0.5038"^^xsd:decimal .

ex:mark-4106-1-2 a chart:DataPoint ;
    chart:series ex:series-4106-1 ;
    chart:category "2024*" ;
    chart:value "0.4933"^^xsd:decimal .

ex:mark-4106-1-3 a chart:DataPoint ;
    chart:series ex:series-4106-1 ;
    chart:category "2023*" ;
    chart:value "0.4806"^^xsd:decimal .

ex:mark-4106-1-4 a chart:DataPoint ;
    chart:series ex:series-4106-1 ;
    chart:category "2022*" ;
    chart:value "0.4734"^^xsd:decimal .

ex:mark-4106-1-5 a chart:DataPoint ;
    chart:series ex:series-4106-1 ;
    chart:category "2021*" ;
    chart:value "0.4552"^^xsd:decimal .

ex:mark-4106-1-6 a chart:DataPoint ;
    chart:series ex:series-4106-1 ;
    chart:category "2020*" ;
    chart:value "0.4167"^^xsd:decimal .
