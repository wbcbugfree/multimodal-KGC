@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-62 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Most popular health and fitness apps in the United States as of May 2018 , by reach" ;
    chart:xAxis ex:x-62 ;
    chart:yAxis ex:y-62 .

ex:x-62 a chart:Axis ;
    chart:label "business with categorical scale with Fitbit" .

ex:y-62 a chart:Axis ;
    chart:label "Mobile reach" .

ex:series-62-1 a chart:Series .

ex:mark-62-1-1 a chart:DataPoint ;
    chart:series ex:series-62-1 ;
    chart:category "Fitbit" ;
    chart:value "0.13"^^xsd:decimal .

ex:mark-62-1-2 a chart:DataPoint ;
    chart:series ex:series-62-1 ;
    chart:category "MyFitnessPal" ;
    chart:value "0.09"^^xsd:decimal .

ex:mark-62-1-3 a chart:DataPoint ;
    chart:series ex:series-62-1 ;
    chart:category "S Health (for Samsung)" ;
    chart:value "0.07"^^xsd:decimal .

ex:mark-62-1-4 a chart:DataPoint ;
    chart:series ex:series-62-1 ;
    chart:category "Weight Watchers" ;
    chart:value "0.02"^^xsd:decimal .

ex:mark-62-1-5 a chart:DataPoint ;
    chart:series ex:series-62-1 ;
    chart:category "Google Fit" ;
    chart:value "0.01"^^xsd:decimal .

ex:mark-62-1-6 a chart:DataPoint ;
    chart:series ex:series-62-1 ;
    chart:category "My Calendar - Period Tracker" ;
    chart:value "0.01"^^xsd:decimal .

ex:mark-62-1-7 a chart:DataPoint ;
    chart:series ex:series-62-1 ;
    chart:category "Garmin Connect Mobile" ;
    chart:value "0.01"^^xsd:decimal .

ex:mark-62-1-8 a chart:DataPoint ;
    chart:series ex:series-62-1 ;
    chart:category "Sleep Cycle alarm clock" ;
    chart:value "0.01"^^xsd:decimal .

ex:mark-62-1-9 a chart:DataPoint ;
    chart:series ex:series-62-1 ;
    chart:category "Nike+ Running" ;
    chart:value "0.01"^^xsd:decimal .

ex:mark-62-1-10 a chart:DataPoint ;
    chart:series ex:series-62-1 ;
    chart:category "Walk with Map My Walk GPS Walking" ;
    chart:value "0.01"^^xsd:decimal .
