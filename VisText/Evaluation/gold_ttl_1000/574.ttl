@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-574 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Annual volume of cranberries and blueberries sold in the United Kingdom (UK) from 2008 to 2018 (in 1,000 tonnes)" ;
    chart:xAxis ex:x-574 ;
    chart:yAxis ex:y-574 .

ex:x-574 a chart:Axis ;
    chart:label "Sales volume in thousand tonnes" .

ex:y-574 a chart:Axis ;
    chart:label "Year while the x-axis plots Sales volume in thousand tonnes" .

ex:series-574-1 a chart:Series .

ex:mark-574-1-1 a chart:DataPoint ;
    chart:series ex:series-574-1 ;
    chart:category "volume in thousand tonnes Year" ;
    chart:value "24.2"^^xsd:decimal .

ex:mark-574-1-2 a chart:DataPoint ;
    chart:series ex:series-574-1 ;
    chart:category "2018*" ;
    chart:value "21.2"^^xsd:decimal .

ex:mark-574-1-3 a chart:DataPoint ;
    chart:series ex:series-574-1 ;
    chart:category "2017*" ;
    chart:value "18.8"^^xsd:decimal .

ex:mark-574-1-4 a chart:DataPoint ;
    chart:series ex:series-574-1 ;
    chart:category "2016*" ;
    chart:value "16.8"^^xsd:decimal .

ex:mark-574-1-5 a chart:DataPoint ;
    chart:series ex:series-574-1 ;
    chart:category "*" ;
    chart:value "15.1"^^xsd:decimal .

ex:mark-574-1-6 a chart:DataPoint ;
    chart:series ex:series-574-1 ;
    chart:category "*" ;
    chart:value "13.8"^^xsd:decimal .
