@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-8473 a chart:Chart ;
    chart:chartType "line" ;
    chart:title "Market share held by the leading internet browsers in Europe from 2009 to 2019" ;
    chart:xAxis ex:x-8473 ;
    chart:yAxis ex:y-8473 .

ex:x-8473 a chart:Axis ;
    chart:label "Year" .

ex:y-8473 a chart:Axis ;
    chart:label "" .

ex:series-8473-1 a chart:Series .

ex:mark-8473-1-1 a chart:DataPoint ;
    chart:series ex:series-8473-1 ;
    chart:category "Chrome Dec" ;
    chart:value "31"^^xsd:decimal .

