@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-6635 a chart:Chart ;
    chart:chartType "area" ;
    chart:title "Jordan : Age structure from 2009 to 2019" ;
    chart:xAxis ex:x-6635 ;
    chart:yAxis ex:y-6635 .

ex:x-6635 a chart:Axis ;
    chart:label "Year" .

ex:y-6635 a chart:Axis ;
    chart:label "" .

ex:series-6635-1 a chart:Series .

ex:mark-6635-1-1 a chart:DataPoint ;
    chart:series ex:series-6635-1 ;
    chart:category "0-14 years Dec" ;
    chart:value "31"^^xsd:decimal .

