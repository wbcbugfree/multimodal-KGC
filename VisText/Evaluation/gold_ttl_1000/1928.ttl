@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-1928 a chart:Chart ;
    chart:chartType "line" ;
    chart:title "Statutory health insurances spending for medical treatment in Germany from 2000 to 2019 (in billion euros)" ;
    chart:xAxis ex:x-1928 ;
    chart:yAxis ex:y-1928 .

ex:x-1928 a chart:Axis ;
    chart:label "Year" .

ex:y-1928 a chart:Axis ;
