@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-4932 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Number of registered motor vehicles across Haryana in India from financial year 2007 to 2017 (in millions)" ;
    chart:xAxis ex:x-4932 ;
    chart:yAxis ex:y-4932 .

ex:x-4932 a chart:Axis ;
    chart:label "Number" .

ex:y-4932 a chart:Axis ;
    chart:label "" .

