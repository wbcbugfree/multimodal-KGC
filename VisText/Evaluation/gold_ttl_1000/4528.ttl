@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-4528 a chart:Chart ;
    chart:chartType "line" ;
    chart:title "Namibia : Unemployment rate from 1999 to 2020" ;
    chart:xAxis ex:x-4528 ;
    chart:yAxis ex:y-4528 .

ex:x-4528 a chart:Axis ;
    chart:label "Year while the y-axis measures Unemployment rate" .

ex:y-4528 a chart:Axis ;
    chart:label "Unemployment rate" .

ex:series-4528-1 a chart:Series .

ex:mark-4528-1-1 a chart:DataPoint ;
    chart:series ex:series-4528-1 ;
    chart:category "Dec" ;
    chart:value "31"^^xsd:decimal .

