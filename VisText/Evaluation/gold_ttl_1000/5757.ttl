@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-5757 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Change in carbon dioxide emissions in selected countries between 1990 and 2017" ;
    chart:xAxis ex:x-5757 ;
    chart:yAxis ex:y-5757 .

ex:x-5757 a chart:Axis ;
    chart:label "Change" .

ex:y-5757 a chart:Axis ;
    chart:label "" .

ex:series-5757-1 a chart:Series .

ex:mark-5757-1-1 a chart:DataPoint ;
    chart:series ex:series-5757-1 ;
    chart:category "in CO2 emissions Country" ;
    chart:value "3.383"^^xsd:decimal .

ex:mark-5757-1-2 a chart:DataPoint ;
    chart:series ex:series-5757-1 ;
    chart:category "China (including Hong Kong)" ;
    chart:value "0.481"^^xsd:decimal .

ex:mark-5757-1-3 a chart:DataPoint ;
    chart:series ex:series-5757-1 ;
    chart:category "Australia" ;
    chart:value "0.306"^^xsd:decimal .

ex:mark-5757-1-4 a chart:DataPoint ;
    chart:series ex:series-5757-1 ;
    chart:category "Canada" ;
    chart:value "0.251"^^xsd:decimal .

ex:mark-5757-1-5 a chart:DataPoint ;
    chart:series ex:series-5757-1 ;
    chart:category "Spain" ;
    chart:value "0.154"^^xsd:decimal .

ex:mark-5757-1-6 a chart:DataPoint ;
    chart:series ex:series-5757-1 ;
    chart:category "Austria" ;
    chart:value "0.086"^^xsd:decimal .
