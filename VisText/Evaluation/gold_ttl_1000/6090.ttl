@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-6090 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Which , if any , of the following measures have you taken in the past 2 weeks specifically to protect yourself from the Coronavirus (COVID-19) ?" ;
    chart:xAxis ex:x-6090 ;
    chart:yAxis ex:y-6090 .

ex:x-6090 a chart:Axis ;
    chart:label "Response" .

ex:y-6090 a chart:Axis ;
    chart:label "" .

ex:series-6090-1 a chart:Series .

ex:mark-6090-1-1 a chart:DataPoint ;
    chart:series ex:series-6090-1 ;
    chart:category "Mar" ;
    chart:value "19"^^xsd:decimal .

ex:mark-6090-1-2 a chart:DataPoint ;
    chart:series ex:series-6090-1 ;
    chart:category "to Mar" ;
    chart:value "20"^^xsd:decimal .

ex:mark-6090-1-3 a chart:DataPoint ;
    chart:series ex:series-6090-1 ;
    chart:category "Avoid crowded public places" ;
    chart:value "0.57"^^xsd:decimal .

ex:mark-6090-1-4 a chart:DataPoint ;
    chart:series ex:series-6090-1 ;
    chart:category "Improve personal hygiene (e.g. washing hands more ..." ;
    chart:value "0.7"^^xsd:decimal .

ex:mark-6090-1-5 a chart:DataPoint ;
    chart:series ex:series-6090-1 ;
    chart:category "Avoid travelling" ;
    chart:value "0.36"^^xsd:decimal .

ex:mark-6090-1-6 a chart:DataPoint ;
    chart:series ex:series-6090-1 ;
    chart:category "Avoid public transport" ;
    chart:value "0.37"^^xsd:decimal .

ex:mark-6090-1-7 a chart:DataPoint ;
    chart:series ex:series-6090-1 ;
    chart:category "Refrain from touching objects in public" ;
    chart:value "0.41"^^xsd:decimal .

ex:mark-6090-1-8 a chart:DataPoint ;
    chart:series ex:series-6090-1 ;
    chart:category "Avoid contact with people who have/seem to have fl..." ;
    chart:value "0.41"^^xsd:decimal .

ex:mark-6090-1-9 a chart:DataPoint ;
    chart:series ex:series-6090-1 ;
    chart:category "Avoid going to work" ;
    chart:value "0.2"^^xsd:decimal .

ex:mark-6090-1-10 a chart:DataPoint ;
    chart:series ex:series-6090-1 ;
    chart:category "Avoid physical contact with tourists" ;
    chart:value "0.21"^^xsd:decimal .

ex:mark-6090-1-11 a chart:DataPoint ;
    chart:series ex:series-6090-1 ;
    chart:category "Avoid consumption of raw or uncooked meat" ;
    chart:value "0.09"^^xsd:decimal .

ex:mark-6090-1-12 a chart:DataPoint ;
    chart:series ex:series-6090-1 ;
    chart:category "Wear a face mask in public places" ;
    chart:value "0.02"^^xsd:decimal .

ex:mark-6090-1-13 a chart:DataPoint ;
    chart:series ex:series-6090-1 ;
    chart:category "No measures taken" ;
    chart:value "0.09"^^xsd:decimal .

ex:mark-6090-1-14 a chart:DataPoint ;
    chart:series ex:series-6090-1 ;
    chart:category "Ask doctor for advice" ;
    chart:value "0.04"^^xsd:decimal .
