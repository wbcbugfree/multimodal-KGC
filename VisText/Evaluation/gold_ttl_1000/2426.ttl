@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-2426 a chart:Chart ;
    chart:chartType "area" ;
    chart:title "Annual turnover of textile manufacturing in Hungary from 2008 to 2017 (in million euros)" ;
    chart:xAxis ex:x-2426 ;
    chart:yAxis ex:y-2426 .

ex:x-2426 a chart:Axis ;
    chart:label "Year" .

ex:y-2426 a chart:Axis ;
    chart:label "Annual turnover in million euros" .

ex:series-2426-1 a chart:Series .

ex:mark-2426-1-1 a chart:DataPoint ;
    chart:series ex:series-2426-1 ;
    chart:category "Dec" ;
    chart:value "31"^^xsd:decimal .

