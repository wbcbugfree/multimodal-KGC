@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-6258 a chart:Chart ;
    chart:chartType "line" ;
    chart:title "Voter turnout rates among selected age groups in U.S. presidential elections from 1964 to 2016" ;
    chart:xAxis ex:x-6258 ;
    chart:yAxis ex:y-6258 .

ex:x-6258 a chart:Axis ;
    chart:label "Year" .

ex:y-6258 a chart:Axis ;
    chart:label "18-24** while the x-axis shows Year" .

ex:series-6258-1 a chart:Series .

ex:mark-6258-1-1 a chart:DataPoint ;
    chart:series ex:series-6258-1 ;
    chart:category "18-24** Dec" ;
    chart:value "31"^^xsd:decimal .

