@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-4808 a chart:Chart ;
    chart:chartType "area" ;
    chart:title "Number of road traffic fatalities in Iceland from 2006 to 2019" ;
    chart:xAxis ex:x-4808 ;
    chart:yAxis ex:y-4808 .

ex:x-4808 a chart:Axis ;
    chart:label "Year while the y-axis shows Number of fatalities" .

ex:y-4808 a chart:Axis ;
    chart:label "Number of fatalities" .

ex:series-4808-1 a chart:Series .

ex:mark-4808-1-1 a chart:DataPoint ;
    chart:series ex:series-4808-1 ;
    chart:category "Dec" ;
    chart:value "31"^^xsd:decimal .

