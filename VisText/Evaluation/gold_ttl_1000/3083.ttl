@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-3083 a chart:Chart ;
    chart:chartType "line" ;
    chart:title "Germany : Unemployment rate from 1999 to 2020" ;
    chart:xAxis ex:x-3083 ;
    chart:yAxis ex:y-3083 .

ex:x-3083 a chart:Axis ;
    chart:label "Year while the y-axis plots Unemployment rate" .

ex:y-3083 a chart:Axis ;
    chart:label "" .

ex:series-3083-1 a chart:Series .

ex:mark-3083-1-1 a chart:DataPoint ;
    chart:series ex:series-3083-1 ;
    chart:category "Unemployment rate Dec" ;
    chart:value "31"^^xsd:decimal .

