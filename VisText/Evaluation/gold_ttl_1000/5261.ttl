@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-5261 a chart:Chart ;
    chart:chartType "area" ;
    chart:title "Share of individuals who made purchases online in Great Britain from 2008 to 2020" ;
    chart:xAxis ex:x-5261 ;
    chart:yAxis ex:y-5261 .

ex:x-5261 a chart:Axis ;
    chart:label "Response" .

ex:y-5261 a chart:Axis ;
    chart:label "Share of respondents" .

ex:series-5261-1 a chart:Series .

ex:mark-5261-1-1 a chart:DataPoint ;
    chart:series ex:series-5261-1 ;
    chart:category "Dec" ;
    chart:value "31"^^xsd:decimal .

