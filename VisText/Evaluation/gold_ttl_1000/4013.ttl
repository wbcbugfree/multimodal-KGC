@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-4013 a chart:Chart ;
    chart:chartType "line" ;
    chart:title "Boehringer Ingelheim 's expenditure on research and development as a percentage of revenue from 2004 to 2019" ;
    chart:xAxis ex:x-4013 ;
    chart:yAxis ex:y-4013 .

ex:x-4013 a chart:Axis ;
    chart:label "Response" .

ex:y-4013 a chart:Axis ;
    chart:label "" .

ex:series-4013-1 a chart:Series .

