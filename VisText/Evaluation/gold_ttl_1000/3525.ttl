@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-3525 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Change in U.S. commercial air carriers ' revenue passenger miles (RPM) for Atlantic flights from 2011 to 2040" ;
    chart:xAxis ex:x-3525 ;
    chart:yAxis ex:y-3525 .

ex:x-3525 a chart:Axis ;
    chart:label "Year" .

ex:y-3525 a chart:Axis ;
    chart:label "Annual growth" .

ex:series-3525-1 a chart:Series .

ex:mark-3525-1-1 a chart:DataPoint ;
    chart:series ex:series-3525-1 ;
    chart:category "2020-2040* **" ;
    chart:value "0.025"^^xsd:decimal .

ex:mark-3525-1-2 a chart:DataPoint ;
    chart:series ex:series-3525-1 ;
    chart:category "2019-2039* **" ;
    chart:value "0.026"^^xsd:decimal .

