    chart:series ex:series-3525-1 ;
    chart:category "2015-2036*" ;
    chart:value "0.031"^^xsd:decimal .

ex:mark-3525-1-6 a chart:DataPoint ;
    chart:series ex:series-3525-1 ;
    chart:category "2020* **" ;
    chart:value "0.074"^^xsd:decimal .

ex:mark-3525-1-7 a chart:DataPoint ;
    chart:series ex:series-3525-1 ;
    chart:category "2019* **" ;
    chart:value "0.08"^^xsd:decimal .

ex:mark-3525-1-8 a chart:DataPoint ;
    chart:series ex:series-3525-1 ;
    chart:category "2018*" ;
    chart:value "0.057"^^xsd:decimal .

ex:mark-3525-1-9 a chart:DataPoint ;
