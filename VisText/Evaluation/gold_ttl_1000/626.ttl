@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-626 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Film studio ranking by number of `` Best Picture '' Academy Awards as of 2020" ;
    chart:xAxis ex:x-626 ;
    chart:yAxis ex:y-626 .

ex:x-626 a chart:Axis ;
    chart:label "Year" .

ex:y-626 a chart:Axis ;
    chart:label "" .

ex:series-626-1 a chart:Series .

ex:mark-626-1-1 a chart:DataPoint ;
    chart:series ex:series-626-1 ;
    chart:category "Number of awards Columbia Pictures" ;
    chart:value "12"^^xsd:decimal .

