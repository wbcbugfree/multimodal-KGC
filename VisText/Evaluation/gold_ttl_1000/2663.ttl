@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-2663 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Total net ingredient cost (NIC) for insulins for diabetes in England from 2005/06 to 2018/19 (in millions GBP)" ;
    chart:xAxis ex:x-2663 ;
    chart:yAxis ex:y-2663 .

ex:x-2663 a chart:Axis ;
    chart:label "Year while the y-axis shows Net Ingredient Cost in millions GBP" .

ex:y-2663 a chart:Axis ;
    chart:label "Net Ingredient Cost in millions GBP" .

ex:series-2663-1 a chart:Series .

ex:mark-2663-1-1 a chart:DataPoint ;
