@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-4080 a chart:Chart ;
    chart:chartType "line" ;
    chart:title "Aggregated gross revenues of PwC 2006 to 2020 (in billion U.S. dollars)" ;
    chart:xAxis ex:x-4080 ;
    chart:yAxis ex:y-4080 .

ex:x-4080 a chart:Axis ;
    chart:label "Year with a linear scale from 2006 to 2018" .

ex:y-4080 a chart:Axis ;
    chart:label "" .

ex:series-4080-1 a chart:Series .

ex:mark-4080-1-1 a chart:DataPoint ;
    chart:series ex:series-4080-1 ;
    chart:category "Revenue in billion U.S. dollars Dec" ;
    chart:value "31"^^xsd:decimal .

