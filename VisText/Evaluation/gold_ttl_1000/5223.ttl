@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-5223 a chart:Chart ;
    chart:chartType "line" ;
    chart:title "Pig production in Malaysia from 2005 to 2018 (in million heads)" ;
    chart:xAxis ex:x-5223 ;
    chart:yAxis ex:y-5223 .

ex:x-5223 a chart:Axis ;
    chart:label "Year" .

ex:y-5223 a chart:Axis ;
    chart:label "Production in million heads while the x-axis plots Year" .

ex:series-5223-1 a chart:Series .

ex:mark-5223-1-1 a chart:DataPoint ;
    chart:series ex:series-5223-1 ;
    chart:category "Production in million heads Dec" ;
    chart:value "31"^^xsd:decimal .

