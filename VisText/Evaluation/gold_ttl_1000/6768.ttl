@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-6768 a chart:Chart ;
    chart:chartType "area" ;
    chart:title "Total population of Haiti from 2008 to 2018 , by gender (in million inhabitants)" ;
    chart:xAxis ex:x-6768 ;
    chart:yAxis ex:y-6768 .

ex:x-6768 a chart:Axis ;
    chart:label "Year" .

ex:y-6768 a chart:Axis ;
    chart:label "Total while the x-axis measures Year" .

ex:series-6768-1 a chart:Series .

ex:mark-6768-1-1 a chart:DataPoint ;
    chart:series ex:series-6768-1 ;
    chart:category "Total Dec" ;
    chart:value "31"^^xsd:decimal .

