@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-4648 a chart:Chart ;
    chart:chartType "area" ;
    chart:title "Revenue generated by Becton , Dickinson , and Company from 2011 to 2020 (in billion U.S. dollars)" ;
    chart:xAxis ex:x-4648 ;
    chart:yAxis ex:y-4648 .

ex:x-4648 a chart:Axis ;
    chart:label "Year" .

ex:y-4648 a chart:Axis ;
    chart:label "" .

ex:series-4648-1 a chart:Series .

ex:mark-4648-1-1 a chart:DataPoint ;
    chart:series ex:series-4648-1 ;
    chart:category "Annual revenue in billion U.S. dollars Dec" ;
    chart:value "31"^^xsd:decimal .

