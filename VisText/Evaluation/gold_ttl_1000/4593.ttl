@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-4593 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Ghana : National debt in relation to gross domestic product (GDP) from 2015 to 2025" ;
    chart:xAxis ex:x-4593 ;
    chart:yAxis ex:y-4593 .

