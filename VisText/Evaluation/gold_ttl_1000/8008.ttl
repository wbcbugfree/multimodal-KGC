@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-8008 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Preferred number of TV show episodes to watch in one binge watching sessio...Generation X and Baby Boomers in the United Kingdom (UK) in December 2016" ;
    chart:xAxis ex:x-8008 ;
    chart:yAxis ex:y-8008 .

ex:x-8008 a chart:Axis ;
    chart:label "60 years and older while the y-axis shows Response" .

ex:y-8008 a chart:Axis ;
    chart:label "Response" .

ex:series-8008-1 a chart:Series .

ex:mark-8008-1-1 a chart:DataPoint ;
    chart:series ex:series-8008-1 ;
    chart:category "episode" ;
    chart:value "0.2"^^xsd:decimal .

ex:mark-8008-1-2 a chart:DataPoint ;
    chart:series ex:series-8008-1 ;
    chart:category "episodes" ;
    chart:value "0.2"^^xsd:decimal .

