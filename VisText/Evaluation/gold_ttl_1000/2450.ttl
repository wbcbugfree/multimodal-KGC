@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-2450 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Gross domestic product (GDP) growth rate in Finland from 2005 to 2019 (compared to the previous year)" ;
    chart:xAxis ex:x-2450 ;
    chart:yAxis ex:y-2450 .

ex:x-2450 a chart:Axis ;
    chart:label "GDP growth rate" .

ex:y-2450 a chart:Axis ;
    chart:label "Year" .

ex:series-2450-1 a chart:Series .

ex:mark-2450-1-1 a chart:DataPoint ;
    chart:series ex:series-2450-1 ;
    chart:category "2019*" ;
    chart:value "0.015"^^xsd:decimal .

ex:mark-2450-1-2 a chart:DataPoint ;
    chart:series ex:series-2450-1 ;
    chart:category "2018*" ;
    chart:value "0.033"^^xsd:decimal .

ex:mark-2450-1-3 a chart:DataPoint ;
    chart:series ex:series-2450-1 ;
    chart:category "2017*" ;
    chart:value "0.028"^^xsd:decimal .

ex:mark-2450-1-4 a chart:DataPoint ;
    chart:series ex:series-2450-1 ;
    chart:category "−0.004" ;
    chart:value "2014"^^xsd:decimal .

ex:mark-2450-1-5 a chart:DataPoint ;
    chart:series ex:series-2450-1 ;
    chart:category "−0.009" ;
    chart:value "2013"^^xsd:decimal .

ex:mark-2450-1-6 a chart:DataPoint ;
    chart:series ex:series-2450-1 ;
    chart:category "−0.014" ;
    chart:value "2012"^^xsd:decimal .

ex:mark-2450-1-7 a chart:DataPoint ;
    chart:series ex:series-2450-1 ;
    chart:category "−0.081" ;
    chart:value "2009"^^xsd:decimal .
