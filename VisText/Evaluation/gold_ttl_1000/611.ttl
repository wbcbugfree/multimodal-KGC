@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-611 a chart:Chart ;
    chart:chartType "area" ;
    chart:title "Poverty rate in Oklahoma from 2000 to 2019" ;
    chart:xAxis ex:x-611 ;
    chart:yAxis ex:y-611 .

ex:x-611 a chart:Axis ;
    chart:label "Response" .

ex:y-611 a chart:Axis ;
    chart:label "" .

ex:series-611-1 a chart:Series .

ex:mark-611-1-1 a chart:DataPoint ;
    chart:series ex:series-611-1 ;
    chart:category "Percentage of population Dec" ;
    chart:value "31"^^xsd:decimal .

