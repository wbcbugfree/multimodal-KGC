@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-965 a chart:Chart ;
    chart:chartType "line" ;
    chart:title "Anaheim Ducks franchise value from 2006 to 2019 (in million U.S. dollars)" ;
    chart:xAxis ex:x-965 ;
    chart:yAxis ex:y-965 .

ex:x-965 a chart:Axis ;
    chart:label "Year" .

ex:y-965 a chart:Axis ;
    chart:label "Franchise value in million U" .

ex:series-965-1 a chart:Series .

ex:mark-965-1-1 a chart:DataPoint ;
