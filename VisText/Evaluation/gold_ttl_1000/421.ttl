@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-421 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Most popular tourist attractions worldwide on Instagram as of September 2018 , by number of posts (in millions)" ;
    chart:xAxis ex:x-421 ;
    chart:yAxis ex:y-421 .

ex:x-421 a chart:Axis ;
    chart:label "Number of hashtagged posts in millions" .

ex:y-421 a chart:Axis ;
    chart:label "" .

ex:series-421-1 a chart:Series .

ex:mark-421-1-1 a chart:DataPoint ;
    chart:series ex:series-421-1 ;
    chart:category "of hashtagged posts in millions tourist attraction" ;
    chart:value "6.17"^^xsd:decimal .

