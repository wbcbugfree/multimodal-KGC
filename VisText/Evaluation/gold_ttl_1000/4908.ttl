@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-4908 a chart:Chart ;
    chart:chartType "line" ;
    chart:title "Number of employees of Allianz Group from 2005 to 2019 (in 1,000s)" ;
    chart:xAxis ex:x-4908 ;
    chart:yAxis ex:y-4908 .

ex:x-4908 a chart:Axis ;
    chart:label "Year" .

ex:y-4908 a chart:Axis ;
    chart:label "" .

ex:series-4908-1 a chart:Series .

ex:mark-4908-1-1 a chart:DataPoint ;
    chart:series ex:series-4908-1 ;
    chart:category "Number of employees in thousands Dec" ;
    chart:value "31"^^xsd:decimal .

