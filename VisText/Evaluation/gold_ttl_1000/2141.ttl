@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-2141 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "B2C e-commerce as percentage of GDP in Japan from 2009 to 2018" ;
    chart:xAxis ex:x-2141 ;
    chart:yAxis ex:y-2141 .

ex:x-2141 a chart:Axis ;
    chart:label "Percentage" .

ex:y-2141 a chart:Axis ;
    chart:label "" .

ex:series-2141-1 a chart:Series .

ex:mark-2141-1-1 a chart:DataPoint ;
    chart:series ex:series-2141-1 ;
    chart:category "of gross domestic product Response" ;
    chart:value "0.0172"^^xsd:decimal .

ex:mark-2141-1-2 a chart:DataPoint ;
    chart:series ex:series-2141-1 ;
    chart:category "2018*" ;
    chart:value "0.0159"^^xsd:decimal .

ex:mark-2141-1-3 a chart:DataPoint ;
    chart:series ex:series-2141-1 ;
    chart:category "2017*" ;
    chart:value "0.0145"^^xsd:decimal .

ex:mark-2141-1-4 a chart:DataPoint ;
    chart:series ex:series-2141-1 ;
    chart:category "2016*" ;
    chart:value "0.0123"^^xsd:decimal .

ex:mark-2141-1-5 a chart:DataPoint ;
    chart:series ex:series-2141-1 ;
    chart:category "2015*" ;
    chart:value "0.0105"^^xsd:decimal .

ex:mark-2141-1-6 a chart:DataPoint ;
    chart:series ex:series-2141-1 ;
    chart:category "2014*" ;
    chart:value "0.0101"^^xsd:decimal .
