@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-8267 a chart:Chart ;
    chart:chartType "area" ;
    chart:title "Population of Iceland from 2010 to 2020 , by age group" ;
    chart:xAxis ex:x-8267 ;
    chart:yAxis ex:y-8267 .

ex:x-8267 a chart:Axis ;
    chart:label "Year" .

ex:y-8267 a chart:Axis ;
    chart:label "" .

ex:series-8267-1 a chart:Series .

ex:mark-8267-1-1 a chart:DataPoint ;
    chart:series ex:series-8267-1 ;
    chart:category "20-39 years Dec" ;
    chart:value "31"^^xsd:decimal .

