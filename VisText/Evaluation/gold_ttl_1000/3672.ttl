@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-3672 a chart:Chart ;
    chart:chartType "area" ;
    chart:title "Greenhouse gas emissions of the agricultural sector in Finland in selected years from 1990 to 2017 (in million tons of CO2 equivalent)" ;
    chart:xAxis ex:x-3672 ;
    chart:yAxis ex:y-3672 .

ex:x-3672 a chart:Axis ;
    chart:label "Year" .

ex:y-3672 a chart:Axis ;
    chart:label "Emissions in million tons of CO2 while the x-axis plots Year" .

ex:series-3672-1 a chart:Series .

ex:mark-3672-1-1 a chart:DataPoint ;
    chart:series ex:series-3672-1 ;
    chart:category "Emissions in million tons of CO2 Dec" ;
    chart:value "31"^^xsd:decimal .

ex:mark-3672-1-2 a chart:DataPoint ;
    chart:series ex:series-3672-1 ;
    chart:category "Dec" ;
    chart:value "31"^^xsd:decimal .

