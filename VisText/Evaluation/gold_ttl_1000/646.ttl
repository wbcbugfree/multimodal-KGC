@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-646 a chart:Chart ;
    chart:chartType "line" ;
    chart:title "State and local property tax revenue in the United States from 1977 to 2018 (in billion U.S. dollars)" ;
    chart:xAxis ex:x-646 ;
    chart:yAxis ex:y-646 .

ex:x-646 a chart:Axis ;
    chart:label "Year" .

ex:y-646 a chart:Axis ;
    chart:label "" .

ex:series-646-1 a chart:Series .

ex:mark-646-1-1 a chart:DataPoint ;
    chart:series ex:series-646-1 ;
    chart:category "Revenue in billion U.S. dollars Dec" ;
    chart:value "31"^^xsd:decimal .

