@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-2093 a chart:Chart ;
    chart:chartType "area" ;
    chart:title "Rwanda : Birth rate from 2008 to 2018 (per 1,000 inhabitants)" ;
    chart:xAxis ex:x-2093 ;
    chart:yAxis ex:y-2093 .

ex:x-2093 a chart:Axis ;
    chart:label "Year" .

ex:y-2093 a chart:Axis ;
    chart:label "" .

ex:series-2093-1 a chart:Series .

ex:mark-2093-1-1 a chart:DataPoint ;
    chart:series ex:series-2093-1 ;
    chart:category "Birth rate per thousand population Dec" ;
    chart:value "31"^^xsd:decimal .

