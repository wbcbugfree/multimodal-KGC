@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-2283 a chart:Chart ;
    chart:chartType "line" ;
    chart:title "Noble Energy 's revenue from 2007 to 2019 (in million U.S. dollars)" ;
    chart:xAxis ex:x-2283 ;
    chart:yAxis ex:y-2283 .

ex:x-2283 a chart:Axis ;
    chart:label "Year while the y-axis measures Revenue in million U" .

ex:y-2283 a chart:Axis ;
    chart:label "Revenue in million U" .

ex:series-2283-1 a chart:Series .

