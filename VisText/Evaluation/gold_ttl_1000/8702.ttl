@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-8702 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Number of coronavirus (COVID-19) cases , recoveries , and deaths among the most impacted countries worldwide as of December 22 , 2020" ;
    chart:xAxis ex:x-8702 ;
    chart:yAxis ex:y-8702 .

ex:x-8702 a chart:Axis ;
    chart:label "Recoveries" .

ex:y-8702 a chart:Axis ;
    chart:label "Country while the x-axis plots Recoveries" .

ex:series-8702-1 a chart:Series .

ex:mark-8702-1-1 a chart:DataPoint ;
    chart:series ex:series-8702-1 ;
    chart:category "Country" ;
    chart:value "54786890"^^xsd:decimal .

