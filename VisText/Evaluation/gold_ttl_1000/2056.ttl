@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-2056 a chart:Chart ;
    chart:chartType "line" ;
    chart:title "Economic damage caused by North Atlantic tropical cyclones in the U.S. from 1995 to 2019 (in million U.S. dollars)" ;
    chart:xAxis ex:x-2056 ;
    chart:yAxis ex:y-2056 .

ex:x-2056 a chart:Axis ;
    chart:label "Year" .

ex:y-2056 a chart:Axis ;
    chart:label "Damage in million U" .

ex:series-2056-1 a chart:Series .

ex:mark-2056-1-1 a chart:DataPoint ;
    chart:series ex:series-2056-1 ;
    chart:category "Damage in million U.S. dollars Dec" ;
    chart:value "31"^^xsd:decimal .

