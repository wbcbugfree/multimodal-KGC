@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-2810 a chart:Chart ;
    chart:chartType "area" ;
    chart:title "Share of female primary education teachers in Malaysia from 2009 to 2018" ;
    chart:xAxis ex:x-2810 ;
    chart:yAxis ex:y-2810 .

ex:x-2810 a chart:Axis ;
    chart:label "Response with linear scale of range 2010 to 2016" .

ex:y-2810 a chart:Axis ;
    chart:label "Share of female teachers" .

ex:series-2810-1 a chart:Series .

ex:mark-2810-1-1 a chart:DataPoint ;
    chart:series ex:series-2810-1 ;
    chart:category "Dec" ;
    chart:value "31"^^xsd:decimal .

