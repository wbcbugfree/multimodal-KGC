@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-2465 a chart:Chart ;
    chart:chartType "area" ;
    chart:title "Amount of money invested in road transport infrastructure in Denmark from 2004 to 2018 (in million euros)" ;
    chart:xAxis ex:x-2465 ;
    chart:yAxis ex:y-2465 .

ex:x-2465 a chart:Axis ;
    chart:label "Year" .

ex:y-2465 a chart:Axis ;
    chart:label "Millions of euros invested while the x-axis measures Year" .

ex:series-2465-1 a chart:Series .

ex:mark-2465-1-1 a chart:DataPoint ;
    chart:series ex:series-2465-1 ;
    chart:category "Millions of euros invested Dec" ;
    chart:value "31"^^xsd:decimal .

