@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-1133 a chart:Chart ;
    chart:chartType "line" ;
    chart:title "Number of enterprises in the manufacture of plastics products industry in Norway from 2008 to 2017" ;
    chart:xAxis ex:x-1133 ;
    chart:yAxis ex:y-1133 .

ex:x-1133 a chart:Axis ;
    chart:label "Year" .

ex:y-1133 a chart:Axis ;
    chart:label "Number of enterprises" .

ex:series-1133-1 a chart:Series .

ex:mark-1133-1-1 a chart:DataPoint ;
    chart:series ex:series-1133-1 ;
    chart:category "Dec" ;
    chart:value "31"^^xsd:decimal .

