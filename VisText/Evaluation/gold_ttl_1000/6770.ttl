@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-6770 a chart:Chart ;
    chart:chartType "area" ;
    chart:title "Bunge Limited 's net sales from 2010 to 2019 , by segment (in million U.S. dollars)" ;
    chart:xAxis ex:x-6770 ;
    chart:yAxis ex:y-6770 .

ex:x-6770 a chart:Axis ;
    chart:label "Year with linear scale with a minimum of 2010 and a maximum of 2018" .

ex:y-6770 a chart:Axis ;
    chart:label "Edible Oil Products" .

ex:series-6770-1 a chart:Series .

ex:mark-6770-1-1 a chart:DataPoint ;
    chart:series ex:series-6770-1 ;
    chart:category "Dec" ;
    chart:value "31"^^xsd:decimal .

