@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-6816 a chart:Chart ;
    chart:chartType "line" ;
    chart:title "Life expectancy at birth in the Netherlands from 1950 to 2018 , by gender" ;
    chart:xAxis ex:x-6816 ;
    chart:yAxis ex:y-6816 .

ex:x-6816 a chart:Axis ;
    chart:label "Year" .

ex:y-6816 a chart:Axis ;
    chart:label "" .

ex:series-6816-1 a chart:Series .

ex:mark-6816-1-1 a chart:DataPoint ;
    chart:series ex:series-6816-1 ;
    chart:category "Men Dec" ;
    chart:value "31"^^xsd:decimal .

