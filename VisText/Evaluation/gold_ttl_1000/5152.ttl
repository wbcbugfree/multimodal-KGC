@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-5152 a chart:Chart ;
    chart:chartType "area" ;
    chart:title "Annual performance of CAC 40 index as of year-end value from 1995 to 2019" ;
    chart:xAxis ex:x-5152 ;
    chart:yAxis ex:y-5152 .

ex:x-5152 a chart:Axis ;
    chart:label "Year" .

ex:y-5152 a chart:Axis ;
    chart:label "" .

ex:series-5152-1 a chart:Series .

ex:mark-5152-1-1 a chart:DataPoint ;
    chart:series ex:series-5152-1 ;
    chart:category "Index points Dec" ;
    chart:value "31"^^xsd:decimal .

