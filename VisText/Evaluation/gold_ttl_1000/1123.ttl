    chart:series ex:series-1123-1 ;
    chart:category "2026*" ;
    chart:value "168.7"^^xsd:decimal .

ex:mark-1123-1-5 a chart:DataPoint ;
    chart:series ex:series-1123-1 ;
    chart:category "2025*" ;
    chart:value "163.7"^^xsd:decimal .

ex:mark-1123-1-6 a chart:DataPoint ;
    chart:series ex:series-1123-1 ;
    chart:category "2024*" ;
    chart:value "158.4"^^xsd:decimal .

ex:mark-1123-1-7 a chart:DataPoint ;
    chart:series ex:series-1123-1 ;
