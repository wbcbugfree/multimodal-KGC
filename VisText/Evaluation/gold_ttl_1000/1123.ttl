    chart:value "153.3"^^xsd:decimal .

ex:mark-1123-1-8 a chart:DataPoint ;
    chart:series ex:series-1123-1 ;
    chart:category "2022*" ;
    chart:value "147.2"^^xsd:decimal .

ex:mark-1123-1-9 a chart:DataPoint ;
    chart:series ex:series-1123-1 ;
