@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-5712 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Cambodia : Ratio of government expenditure to gross domestic product (GDP) from 2015 to 2025" ;
    chart:xAxis ex:x-5712 ;
    chart:yAxis ex:y-5712 .

ex:x-5712 a chart:Axis ;
    chart:label "Year" .

ex:y-5712 a chart:Axis ;
    chart:label "Ratio of government expenditure to GDP" .

ex:series-5712-1 a chart:Series .

ex:mark-5712-1-1 a chart:DataPoint ;
    chart:series ex:series-5712-1 ;
    chart:category "2025*" ;
    chart:value "0.2501"^^xsd:decimal .

ex:mark-5712-1-2 a chart:DataPoint ;
    chart:series ex:series-5712-1 ;
    chart:category "2024*" ;
    chart:value "0.251"^^xsd:decimal .

ex:mark-5712-1-3 a chart:DataPoint ;
    chart:series ex:series-5712-1 ;
    chart:category "2023*" ;
    chart:value "0.2454"^^xsd:decimal .

ex:mark-5712-1-4 a chart:DataPoint ;
    chart:series ex:series-5712-1 ;
    chart:category "2022*" ;
    chart:value "0.2415"^^xsd:decimal .

ex:mark-5712-1-5 a chart:DataPoint ;
    chart:series ex:series-5712-1 ;
    chart:category "2021*" ;
    chart:value "0.238"^^xsd:decimal .

ex:mark-5712-1-6 a chart:DataPoint ;
    chart:series ex:series-5712-1 ;
    chart:category "2020*" ;
    chart:value "0.2402"^^xsd:decimal .

ex:mark-5712-1-7 a chart:DataPoint ;
    chart:series ex:series-5712-1 ;
    chart:category "2019*" ;
    chart:value "0.2302"^^xsd:decimal .
