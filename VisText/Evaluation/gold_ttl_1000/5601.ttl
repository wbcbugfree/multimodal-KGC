@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-5601 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Revenue of Vodafone Germany from the financial year 2008/09 to 2019/20 (in billion euros)" ;
    chart:xAxis ex:x-5601 ;
    chart:yAxis ex:y-5601 .

ex:x-5601 a chart:Axis ;
    chart:label "Revenue in billion euros" .

ex:y-5601 a chart:Axis ;
    chart:label "" .

ex:series-5601-1 a chart:Series .

ex:mark-5601-1-1 a chart:DataPoint ;
    chart:series ex:series-5601-1 ;
    chart:category "in billion euros financial years" ;
    chart:value "10.7"^^xsd:decimal .

