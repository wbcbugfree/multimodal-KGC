@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-1286 a chart:Chart ;
    chart:chartType "area" ;
    chart:title "Number of jobs in the travel and tourism sector in Cuba from 2010 to 2019 (in 1,000s)" ;
    chart:xAxis ex:x-1286 ;
    chart:yAxis ex:y-1286 .

ex:x-1286 a chart:Axis ;
    chart:label "Year" .

ex:y-1286 a chart:Axis ;
    chart:label "" .

ex:series-1286-1 a chart:Series .

ex:mark-1286-1-1 a chart:DataPoint ;
    chart:series ex:series-1286-1 ;
    chart:category "Number of jobs in thousands Dec" ;
    chart:value "31"^^xsd:decimal .

