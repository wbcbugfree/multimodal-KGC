@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-7695 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "K-12 public school enrollment numbers in the United States from 2000 to 2017 , by ethnicity (in 1,000s)" ;
    chart:xAxis ex:x-7695 ;
    chart:yAxis ex:y-7695 .

ex:x-7695 a chart:Axis ;
    chart:label "Year while the y-axis measures Black" .

ex:y-7695 a chart:Axis ;
    chart:label "Black" .

ex:series-7695-1 a chart:Series .

ex:mark-7695-1-1 a chart:DataPoint ;
    chart:series ex:series-7695-1 ;
    chart:category "2017*" ;
    chart:value "7709"^^xsd:decimal .

ex:mark-7695-1-2 a chart:DataPoint ;
    chart:series ex:series-7695-1 ;
    chart:category "2016**" ;
    chart:value "7765"^^xsd:decimal .

ex:mark-7695-1-3 a chart:DataPoint ;
    chart:series ex:series-7695-1 ;
    chart:category "2015*" ;
    chart:value "7784"^^xsd:decimal .
