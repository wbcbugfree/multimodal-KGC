@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-5972 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Average turnaround time across major ports in India from financial year 1991 to 2019 (in days)" ;
    chart:xAxis ex:x-5972 ;
    chart:yAxis ex:y-5972 .

ex:x-5972 a chart:Axis ;
    chart:label "military" .

ex:y-5972 a chart:Axis ;
    chart:label "" .

ex:series-5972-1 a chart:Series .

ex:mark-5972-1-1 a chart:DataPoint ;
    chart:series ex:series-5972-1 ;
    chart:category "budget Average turnaround time in days FY" ;
    chart:value "2019"^^xsd:decimal .

