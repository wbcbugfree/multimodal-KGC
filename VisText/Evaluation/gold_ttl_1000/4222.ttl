@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-4222 a chart:Chart ;
    chart:chartType "line" ;
    chart:title "Volume of Scotch whisky produced in Scotland from 2000 to 2015 (in 1,000 litres)" ;
    chart:xAxis ex:x-4222 ;
    chart:yAxis ex:y-4222 .

ex:x-4222 a chart:Axis ;
    chart:label "Year" .

ex:y-4222 a chart:Axis ;
    chart:label "Volume in thousand litres" .

ex:series-4222-1 a chart:Series .

ex:mark-4222-1-1 a chart:DataPoint ;
    chart:series ex:series-4222-1 ;
    chart:category "Dec" ;
    chart:value "31"^^xsd:decimal .

