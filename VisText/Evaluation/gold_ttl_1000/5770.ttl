@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-5770 a chart:Chart ;
    chart:chartType "area" ;
    chart:title "Internet usage rate in South Korea from 2000 to 2019" ;
    chart:xAxis ex:x-5770 ;
    chart:yAxis ex:y-5770 .

