@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-5116 a chart:Chart ;
    chart:chartType "area" ;
    chart:title "American customer satisfaction index scores of Pizza Hut restaurants in the United States from 2000 to 2020" ;
    chart:xAxis ex:x-5116 ;
    chart:yAxis ex:y-5116 .

ex:x-5116 a chart:Axis ;
    chart:label "Year" .

ex:y-5116 a chart:Axis ;
    chart:label "ACSI score" .

ex:series-5116-1 a chart:Series .

ex:mark-5116-1-1 a chart:DataPoint ;
    chart:series ex:series-5116-1 ;
    chart:category "Dec" ;
    chart:value "31"^^xsd:decimal .

