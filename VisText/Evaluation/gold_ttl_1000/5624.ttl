@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-5624 a chart:Chart ;
    chart:chartType "line" ;
    chart:title "Djibouti : Unemployment rate from 1999 to 2020" ;
    chart:xAxis ex:x-5624 ;
    chart:yAxis ex:y-5624 .

ex:x-5624 a chart:Axis ;
    chart:label "Year" .

ex:y-5624 a chart:Axis ;
    chart:label "Unemployment rate while the x-axis plots Year" .

ex:series-5624-1 a chart:Series .

ex:mark-5624-1-1 a chart:DataPoint ;
    chart:series ex:series-5624-1 ;
    chart:category "Unemployment rate Dec" ;
    chart:value "31"^^xsd:decimal .

