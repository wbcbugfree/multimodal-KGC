@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-3133 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Most common comorbidities observed in coronavirus (COVID-19) deceased patients in Italy as of July 22 , 2020" ;
    chart:xAxis ex:x-3133 ;
    chart:yAxis ex:y-3133 .

ex:x-3133 a chart:Axis ;
    chart:label "Share" .

ex:y-3133 a chart:Axis ;
    chart:label "" .

ex:series-3133-1 a chart:Series .

ex:mark-3133-1-1 a chart:DataPoint ;
    chart:series ex:series-3133-1 ;
    chart:category "of deceased COVID-19 patients Response" ;
    chart:value "0.66"^^xsd:decimal .

