ex:chart-7396 a chart:Chart ;
    chart:chartType "line" ;
    chart:title "Number of state and federal prisoners in private facilities in the United States from 2000 to 2018 , by prison location" ;
    chart:xAxis ex:x-7396 ;
    chart:yAxis ex:y-7396 .

ex:x-7396 a chart:Axis ;
    chart:label "Year" .

ex:y-7396 a chart:Axis ;
