@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-6971 a chart:Chart ;
    chart:chartType "line" ;
    chart:title "El Salvador : Distribution of employment by economic sector from 2010 to 2020" ;
    chart:xAxis ex:x-6971 ;
    chart:yAxis ex:y-6971 .

ex:x-6971 a chart:Axis ;
    chart:label "Year" .

ex:y-6971 a chart:Axis ;
    chart:label "Industry while the x-axis measures Year" .

ex:series-6971-1 a chart:Series .

ex:mark-6971-1-1 a chart:DataPoint ;
    chart:series ex:series-6971-1 ;
    chart:category "Industry Dec" ;
    chart:value "31"^^xsd:decimal .

