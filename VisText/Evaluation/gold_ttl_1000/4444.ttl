@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-4444 a chart:Chart ;
    chart:chartType "line" ;
    chart:title "Number of arrivals in tourist accommodation in Hungary from 2006 to 2017 (in millions)" ;
    chart:xAxis ex:x-4444 ;
    chart:yAxis ex:y-4444 .

ex:x-4444 a chart:Axis ;
    chart:label "Year" .

ex:y-4444 a chart:Axis ;
    chart:label "Number of arrivals in millions" .

ex:series-4444-1 a chart:Series .

ex:mark-4444-1-1 a chart:DataPoint ;
    chart:series ex:series-4444-1 ;
    chart:category "Dec" ;
    chart:value "31"^^xsd:decimal .

