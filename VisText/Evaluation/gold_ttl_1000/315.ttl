@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-315 a chart:Chart ;
    chart:chartType "area" ;
    chart:title "Number of operational nuclear reactors worldwide from 1954 to 2019" ;
    chart:xAxis ex:x-315 ;
    chart:yAxis ex:y-315 .

ex:x-315 a chart:Axis ;
    chart:label "Year" .

ex:y-315 a chart:Axis ;
    chart:label "Number of nuclear power plants" .

ex:series-315-1 a chart:Series .

ex:mark-315-1-1 a chart:DataPoint ;
    chart:series ex:series-315-1 ;
    chart:category "Dec" ;
    chart:value "31"^^xsd:decimal .

