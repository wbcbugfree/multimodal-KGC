ex:chart-3453 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Indianapolis Colts all-time rushing leaders from 1953 to 2020 (in yards)" ;
    chart:xAxis ex:x-3453 ;
    chart:yAxis ex:y-3453 .

ex:x-3453 a chart:Axis ;
    chart:label "Indianapolis Colts all-time rushing leaders" .

ex:y-3453 a chart:Axis ;
    chart:label "Rushing yards while the x-axis plots Indianapolis Colts all-time rushing leaders" .

ex:series-3453-1 a chart:Series .

