@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-7246 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "World carbon dioxide emissions from 2009 to 2019 , by region (in million metric tons of carbon dioxide)" ;
    chart:xAxis ex:x-7246 ;
    chart:yAxis ex:y-7246 .

ex:x-7246 a chart:Axis ;
    chart:label "Middle East with scale with a minimum of 1658 and a maximum of 2164" .

ex:y-7246 a chart:Axis ;
    chart:label "Africa" .

ex:series-7246-1 a chart:Series .
