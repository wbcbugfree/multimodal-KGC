@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-6599 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Growth in bankruptcies after the coronavirus outbreak in Sweden from February to November 2020 , by industry (compared to the previous year)" ;
    chart:xAxis ex:x-6599 ;
    chart:yAxis ex:y-6599 .

ex:x-6599 a chart:Axis ;
    chart:label "Jul" .

ex:y-6599 a chart:Axis ;
    chart:label "industry" .

ex:series-6599-1 a chart:Series .

ex:mark-6599-1-1 a chart:DataPoint ;
    chart:series ex:series-6599-1 ;
    chart:category "Trade in motor vehicles (incl. service)" ;
    chart:value "0.22"^^xsd:decimal .

ex:mark-6599-1-2 a chart:DataPoint ;
    chart:series ex:series-6599-1 ;
    chart:category "Restaurant and hotel −0.3 Information and communic..." ;
    chart:value "0.85"^^xsd:decimal .

ex:mark-6599-1-3 a chart:DataPoint ;
    chart:series ex:series-6599-1 ;
    chart:category "Wholesale" ;
    chart:value "0"^^xsd:decimal .

ex:mark-6599-1-4 a chart:DataPoint ;
    chart:series ex:series-6599-1 ;
    chart:category "Transportation −0.21 Surveillance, real estate ser..." ;
    chart:value "0.65"^^xsd:decimal .
