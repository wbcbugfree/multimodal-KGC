@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-6358 a chart:Chart ;
    chart:chartType "area" ;
    chart:title "Peru : Share of economic sectors in the gross domestic product (GDP) from 2008 to 2018" ;
    chart:xAxis ex:x-6358 ;
    chart:yAxis ex:y-6358 .

ex:x-6358 a chart:Axis ;
    chart:label "Year while the y-axis shows Agriculture" .

ex:y-6358 a chart:Axis ;
    chart:label "Agriculture" .

ex:series-6358-1 a chart:Series .

ex:mark-6358-1-1 a chart:DataPoint ;
    chart:series ex:series-6358-1 ;
    chart:category "Dec" ;
    chart:value "31"^^xsd:decimal .

