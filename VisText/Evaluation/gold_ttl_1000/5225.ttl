@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-5225 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Sporting events with highest prize money pool worldwide in 2019 (in million U.S. dollars)" ;
    chart:xAxis ex:x-5225 ;
    chart:yAxis ex:y-5225 .

ex:x-5225 a chart:Axis ;
    chart:label "Prize money pool in million U" .

ex:y-5225 a chart:Axis ;
    chart:label "Sporting event while the x-axis plots Prize money pool in million U" .

ex:series-5225-1 a chart:Series .

ex:mark-5225-1-1 a chart:DataPoint ;
    chart:series ex:series-5225-1 ;
    chart:category "money pool in million U.S. dollars Sporting event" ;
    chart:value "1300"^^xsd:decimal .

