@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-2182 a chart:Chart ;
    chart:chartType "line" ;
    chart:title "Sales of potted plants in Canada from 2010 to 2019 (in million Canadian dollars)" ;
    chart:xAxis ex:x-2182 ;
    chart:yAxis ex:y-2182 .

ex:x-2182 a chart:Axis ;
    chart:label "Year while the y-axis plots Sales in million Canadian dollars" .

ex:y-2182 a chart:Axis ;
    chart:label "" .

ex:series-2182-1 a chart:Series .

ex:mark-2182-1-1 a chart:DataPoint ;
    chart:series ex:series-2182-1 ;
    chart:category "Sales in million Canadian dollars Dec" ;
    chart:value "31"^^xsd:decimal .

