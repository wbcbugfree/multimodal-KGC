@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-8530 a chart:Chart ;
    chart:chartType "area" ;
    chart:title "Spain : Distribution of the workforce across economic sectors from 2010 to 2020" ;
    chart:xAxis ex:x-8530 ;
    chart:yAxis ex:y-8530 .

ex:x-8530 a chart:Axis ;
    chart:label "Year" .

ex:y-8530 a chart:Axis ;
    chart:label "" .

ex:series-8530-1 a chart:Series .

ex:mark-8530-1-1 a chart:DataPoint ;
    chart:series ex:series-8530-1 ;
    chart:category "Agriculture Dec" ;
    chart:value "31"^^xsd:decimal .

