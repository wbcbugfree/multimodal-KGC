@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-4056 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Regardless of your favorite team , who do you think will win the Super Bowl this year ?" ;
    chart:xAxis ex:x-4056 ;
    chart:yAxis ex:y-4056 .

ex:x-4056 a chart:Axis ;
    chart:label "Response" .

