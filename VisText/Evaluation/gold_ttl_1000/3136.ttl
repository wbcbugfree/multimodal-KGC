@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-3136 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Quarterly percent change in nonfarm business sector real hourly compensation in the United States from 2017 to 2020" ;
    chart:xAxis ex:x-3136 ;
    chart:yAxis ex:y-3136 .

ex:x-3136 a chart:Axis ;
    chart:label "Percent change from preceding" .

ex:y-3136 a chart:Axis ;
    chart:label "Quarter" .

ex:series-3136-1 a chart:Series .

ex:mark-3136-1-1 a chart:DataPoint ;
    chart:series ex:series-3136-1 ;
    chart:category "Quarter −0.091 Q3 '20" ;
    chart:value "0.244"^^xsd:decimal .

