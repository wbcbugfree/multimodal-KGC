@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-7051 a chart:Chart ;
    chart:chartType "line" ;
    chart:title "Percentage of households in the U.S. from 1990 to 2020 , by type" ;
    chart:xAxis ex:x-7051 ;
    chart:yAxis ex:y-7051 .

ex:x-7051 a chart:Axis ;
    chart:label "Year" .

ex:y-7051 a chart:Axis ;
    chart:label "" .

ex:series-7051-1 a chart:Series .

ex:mark-7051-1-1 a chart:DataPoint ;
    chart:series ex:series-7051-1 ;
    chart:category "Female householder, no spouse present Dec" ;
    chart:value "31"^^xsd:decimal .

ex:mark-7051-1-2 a chart:DataPoint ;
    chart:series ex:series-7051-1 ;
    chart:category "Dec" ;
    chart:value "31"^^xsd:decimal .

