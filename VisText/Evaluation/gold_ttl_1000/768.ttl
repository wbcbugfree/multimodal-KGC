@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-768 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Indoor venue exhibition space available worldwide in 2011 , by country (in million square meters)" ;
    chart:xAxis ex:x-768 ;
    chart:yAxis ex:y-768 .

ex:x-768 a chart:Axis ;
    chart:label "Exhibition" .

ex:y-768 a chart:Axis ;
    chart:label "" .

ex:series-768-1 a chart:Series .

ex:mark-768-1-1 a chart:DataPoint ;
    chart:series ex:series-768-1 ;
    chart:category "space in million square meters Country" ;
    chart:value "6.71"^^xsd:decimal .

