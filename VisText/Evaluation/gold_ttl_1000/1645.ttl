@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-1645 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Total contribution as a share of GDP of the tourism industry in Italy from 2014 to 2029" ;
    chart:xAxis ex:x-1645 ;
    chart:yAxis ex:y-1645 .

ex:x-1645 a chart:Axis ;
    chart:label "Response" .

ex:y-1645 a chart:Axis ;
    chart:label "Share of GDP" .

ex:series-1645-1 a chart:Series .

ex:mark-1645-1-1 a chart:DataPoint ;
    chart:series ex:series-1645-1 ;
    chart:category "2029*" ;
    chart:value "0.143"^^xsd:decimal .

