@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-2105 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Volume of almonds imported to Canada from 2010/11 to 2020/21 (in 1,000 metric tons)" ;
    chart:xAxis ex:x-2105 ;
    chart:yAxis ex:y-2105 .

ex:x-2105 a chart:Axis ;
    chart:label "Year with categorical scale starting at 2010/11 and ending at 2020/21* while the y-axis plots Import volume in thousand metric tons" .

ex:y-2105 a chart:Axis ;
    chart:label "" .

ex:series-2105-1 a chart:Series .

ex:mark-2105-1-1 a chart:DataPoint ;
    chart:series ex:series-2105-1 ;
    chart:category "Import volume in thousand metric tons 2020/21*" ;
    chart:value "35"^^xsd:decimal .

ex:mark-2105-1-2 a chart:DataPoint ;
    chart:series ex:series-2105-1 ;
    chart:category "2019/20" ;
    chart:value "29.7"^^xsd:decimal .

ex:mark-2105-1-3 a chart:DataPoint ;
    chart:series ex:series-2105-1 ;
    chart:category "2018/19" ;
    chart:value "29.6"^^xsd:decimal .

