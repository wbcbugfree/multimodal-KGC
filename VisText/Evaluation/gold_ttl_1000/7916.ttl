@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-7916 a chart:Chart ;
    chart:chartType "line" ;
    chart:title "Projected penalty payments under the Affordable Care Act from 2015 to 2025 (in billion U.S. dollars)" ;
    chart:xAxis ex:x-7916 ;
    chart:yAxis ex:y-7916 .

ex:x-7916 a chart:Axis ;
    chart:label "Fiscal year" .

ex:y-7916 a chart:Axis ;
    chart:label "By employers*" .

ex:series-7916-1 a chart:Series .

ex:mark-7916-1-1 a chart:DataPoint ;
    chart:series ex:series-7916-1 ;
    chart:category "Dec" ;
    chart:value "31"^^xsd:decimal .

