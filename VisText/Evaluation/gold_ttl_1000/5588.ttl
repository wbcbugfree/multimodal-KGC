@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-5588 a chart:Chart ;
    chart:chartType "area" ;
    chart:title "Total contribution of travel and tourism to the GDP in Southeast Asia from 2010 to 2019 (in billion U.S. dollars)" ;
    chart:xAxis ex:x-5588 ;
    chart:yAxis ex:y-5588 .

ex:x-5588 a chart:Axis ;
    chart:label "Year with linear scale from 2010 to 2018" .

ex:y-5588 a chart:Axis ;
    chart:label "" .

ex:series-5588-1 a chart:Series .

ex:mark-5588-1-1 a chart:DataPoint ;
    chart:series ex:series-5588-1 ;
    chart:category "GDP contribution in billion U.S. dollars Dec" ;
    chart:value "31"^^xsd:decimal .

