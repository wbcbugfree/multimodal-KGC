@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-3803 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Percentage of adverse drug event in U.S. hospitals that are attributed to select medications in 2014 , by drug type" ;
    chart:xAxis ex:x-3803 ;
    chart:yAxis ex:y-3803 .

ex:x-3803 a chart:Axis ;
    chart:label "Percentage" .

ex:y-3803 a chart:Axis ;
    chart:label "" .

ex:series-3803-1 a chart:Series .

ex:mark-3803-1-1 a chart:DataPoint ;
    chart:series ex:series-3803-1 ;
    chart:category "of all ADEs Response" ;
    chart:value "0.216"^^xsd:decimal .

ex:mark-3803-1-2 a chart:DataPoint ;
    chart:series ex:series-3803-1 ;
    chart:category "Antibiotics and anti-infectives" ;
    chart:value "0.144"^^xsd:decimal .

ex:mark-3803-1-3 a chart:DataPoint ;
    chart:series ex:series-3803-1 ;
    chart:category "Nonspecific ADE causes (drug type not specified)" ;
    chart:value "0.135"^^xsd:decimal .

