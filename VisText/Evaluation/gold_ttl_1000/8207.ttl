@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-8207 a chart:Chart ;
    chart:chartType "area" ;
    chart:title "Liberia : Age structure from 2009 to 2019" ;
    chart:xAxis ex:x-8207 ;
    chart:yAxis ex:y-8207 .

ex:x-8207 a chart:Axis ;
    chart:label "Year while the y-axis shows 15-64 years" .

ex:y-8207 a chart:Axis ;
    chart:label "15-64 years" .

ex:series-8207-1 a chart:Series .

ex:mark-8207-1-1 a chart:DataPoint ;
    chart:series ex:series-8207-1 ;
    chart:category "Dec" ;
    chart:value "31"^^xsd:decimal .

