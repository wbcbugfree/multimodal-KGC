@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-4391 a chart:Chart ;
    chart:chartType "line" ;
    chart:title "Birth rate in the United States from 1990 to 2018 (per 1,000 of population)" ;
    chart:xAxis ex:x-4391 ;
    chart:yAxis ex:y-4391 .

ex:x-4391 a chart:Axis ;
    chart:label "Year" .

ex:y-4391 a chart:Axis ;
    chart:label "" .

