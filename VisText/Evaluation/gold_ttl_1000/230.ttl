@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-230 a chart:Chart ;
    chart:chartType "line" ;
    chart:title "Electricity generation worldwide from 1990 to 2018 (in terawatt hours)" ;
    chart:xAxis ex:x-230 ;
    chart:yAxis ex:y-230 .

ex:x-230 a chart:Axis ;
    chart:label "Year" .

ex:y-230 a chart:Axis ;
    chart:label "" .

ex:series-230-1 a chart:Series .

ex:mark-230-1-1 a chart:DataPoint ;
    chart:series ex:series-230-1 ;
    chart:category "Electricity generation in terawatt hours Dec" ;
    chart:value "31"^^xsd:decimal .

