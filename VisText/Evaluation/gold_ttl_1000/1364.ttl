@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-1364 a chart:Chart ;
    chart:chartType "area" ;
    chart:title "Health expenditure as a share of gross domestic product in Indonesia from 2007 to 2017" ;
    chart:xAxis ex:x-1364 ;
    chart:yAxis ex:y-1364 .

ex:x-1364 a chart:Axis ;
    chart:label "Year" .

ex:y-1364 a chart:Axis ;
    chart:label "Health expenditure" .

ex:series-1364-1 a chart:Series .

ex:mark-1364-1-1 a chart:DataPoint ;
    chart:series ex:series-1364-1 ;
    chart:category "as a share of GDP Dec" ;
    chart:value "31"^^xsd:decimal .

