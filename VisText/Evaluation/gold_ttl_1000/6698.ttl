@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-6698 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Number of bankruptcies after the coronavirus outbreak in Sweden from February to November 2020 , by industry" ;
    chart:xAxis ex:x-6698 ;
    chart:yAxis ex:y-6698 .

ex:x-6698 a chart:Axis ;
    chart:label "Construction" .

ex:y-6698 a chart:Axis ;
    chart:label "Month while the x-axis plots Construction" .

ex:series-6698-1 a chart:Series .

ex:mark-6698-1-1 a chart:DataPoint ;
    chart:series ex:series-6698-1 ;
    chart:category "Month" ;
    chart:value "102"^^xsd:decimal .

ex:mark-6698-1-2 a chart:DataPoint ;
    chart:series ex:series-6698-1 ;
    chart:category "Feb" ;
    chart:value "125"^^xsd:decimal .

ex:mark-6698-1-3 a chart:DataPoint ;
    chart:series ex:series-6698-1 ;
    chart:category "Mar" ;
    chart:value "119"^^xsd:decimal .

ex:mark-6698-1-4 a chart:DataPoint ;
    chart:series ex:series-6698-1 ;
    chart:category "Apr" ;
    chart:value "90"^^xsd:decimal .

ex:mark-6698-1-5 a chart:DataPoint ;
    chart:series ex:series-6698-1 ;
    chart:category "May" ;
    chart:value "90"^^xsd:decimal .

ex:mark-6698-1-6 a chart:DataPoint ;
    chart:series ex:series-6698-1 ;
    chart:category "Jun" ;
    chart:value "77"^^xsd:decimal .

ex:mark-6698-1-7 a chart:DataPoint ;
    chart:series ex:series-6698-1 ;
    chart:category "Jul" ;
    chart:value "63"^^xsd:decimal .

ex:mark-6698-1-8 a chart:DataPoint ;
    chart:series ex:series-6698-1 ;
    chart:category "Aug" ;
    chart:value "72"^^xsd:decimal .

ex:mark-6698-1-9 a chart:DataPoint ;
    chart:series ex:series-6698-1 ;
    chart:category "Sep" ;
    chart:value "90"^^xsd:decimal .

ex:mark-6698-1-10 a chart:DataPoint ;
    chart:series ex:series-6698-1 ;
    chart:category "Oct" ;
    chart:value "105"^^xsd:decimal .
