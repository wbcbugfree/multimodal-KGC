@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-1460 a chart:Chart ;
    chart:chartType "area" ;
    chart:title "Real Gross Domestic Product (GDP) of the federal state of Oklahoma from 2000 to 2019 (in billion U.S. dollars)" ;
    chart:xAxis ex:x-1460 ;
    chart:yAxis ex:y-1460 .

ex:x-1460 a chart:Axis ;
    chart:label "Year with linear scale of range 2000 to 2015 while the y-axis measures Real GDP in billion U" .

ex:y-1460 a chart:Axis ;
    chart:label "Real GDP in billion U" .

ex:series-1460-1 a chart:Series .

ex:mark-1460-1-1 a chart:DataPoint ;
    chart:series ex:series-1460-1 ;
    chart:category "Real GDP in billion U.S. dollars Dec" ;
    chart:value "31"^^xsd:decimal .

