@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-701 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Top 10 therapeutic categories worldwide by number of R & D products in 2020" ;
    chart:xAxis ex:x-701 ;
    chart:yAxis ex:y-701 .

ex:x-701 a chart:Axis ;
    chart:label "Therapeutic category" .

ex:y-701 a chart:Axis ;
    chart:label "Number of R&D products" .

ex:series-701-1 a chart:Series .

ex:mark-701-1-1 a chart:DataPoint ;
    chart:series ex:series-701-1 ;
    chart:category "Anticancer, immunological" ;
    chart:value "3434"^^xsd:decimal .

ex:mark-701-1-2 a chart:DataPoint ;
    chart:series ex:series-701-1 ;
    chart:category "Anticancer, other" ;
    chart:value "2510"^^xsd:decimal .

ex:mark-701-1-3 a chart:DataPoint ;
    chart:series ex:series-701-1 ;
    chart:category "Gene therapy" ;
    chart:value "1273"^^xsd:decimal .

ex:mark-701-1-4 a chart:DataPoint ;
    chart:series ex:series-701-1 ;
    chart:category "Monoclonal antibody, other" ;
    chart:value "1009"^^xsd:decimal .

ex:mark-701-1-5 a chart:DataPoint ;
    chart:series ex:series-701-1 ;
    chart:category "Ophthalmological, other" ;
    chart:value "756"^^xsd:decimal .

ex:mark-701-1-6 a chart:DataPoint ;
    chart:series ex:series-701-1 ;
    chart:category "Prophylactic vaccine, anti-infective" ;
    chart:value "698"^^xsd:decimal .

ex:mark-701-1-7 a chart:DataPoint ;
    chart:series ex:series-701-1 ;
    chart:category "Neurological" ;
    chart:value "666"^^xsd:decimal .

ex:mark-701-1-8 a chart:DataPoint ;
    chart:series ex:series-701-1 ;
    chart:category "Antidiabetic" ;
    chart:value "589"^^xsd:decimal .

ex:mark-701-1-9 a chart:DataPoint ;
    chart:series ex:series-701-1 ;
    chart:category "Immunosuppressant" ;
    chart:value "544"^^xsd:decimal .

ex:mark-701-1-10 a chart:DataPoint ;
    chart:series ex:series-701-1 ;
    chart:category "Anti-inflammatory" ;
    chart:value "529"^^xsd:decimal .
