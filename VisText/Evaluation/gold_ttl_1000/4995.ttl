@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-4995 a chart:Chart ;
    chart:chartType "area" ;
    chart:title "North American box office revenue of 20th Century Fox from 2000 to 2019 (in million U.S. dollars)" ;
    chart:xAxis ex:x-4995 ;
    chart:yAxis ex:y-4995 .

ex:x-4995 a chart:Axis ;
    chart:label "Year" .

ex:y-4995 a chart:Axis ;
    chart:label "" .

ex:series-4995-1 a chart:Series .

ex:mark-4995-1-1 a chart:DataPoint ;
    chart:series ex:series-4995-1 ;
    chart:category "Box office revenue in million U.S. dollars Dec" ;
    chart:value "31"^^xsd:decimal .

