@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-3006 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Number of Dollarama stores in Canada as of January 2020 , by province" ;
    chart:xAxis ex:x-3006 ;
    chart:yAxis ex:y-3006 .

ex:x-3006 a chart:Axis ;
    chart:label "province of Canada" .

ex:y-3006 a chart:Axis ;
    chart:label "" .

ex:series-3006-1 a chart:Series .

ex:mark-3006-1-1 a chart:DataPoint ;
    chart:series ex:series-3006-1 ;
    chart:category "of Canada Number of stores Ontario" ;
    chart:value "519"^^xsd:decimal .

ex:mark-3006-1-2 a chart:DataPoint ;
    chart:series ex:series-3006-1 ;
    chart:category "Québec" ;
    chart:value "361"^^xsd:decimal .

ex:mark-3006-1-3 a chart:DataPoint ;
    chart:series ex:series-3006-1 ;
    chart:category "Alberta" ;
    chart:value "119"^^xsd:decimal .

ex:mark-3006-1-4 a chart:DataPoint ;
    chart:series ex:series-3006-1 ;
    chart:category "British Columbia" ;
    chart:value "108"^^xsd:decimal .

ex:mark-3006-1-5 a chart:DataPoint ;
    chart:series ex:series-3006-1 ;
    chart:category "Nova Scotia" ;
    chart:value "39"^^xsd:decimal .

ex:mark-3006-1-6 a chart:DataPoint ;
    chart:series ex:series-3006-1 ;
    chart:category "New Brunswick" ;
    chart:value "40"^^xsd:decimal .

ex:mark-3006-1-7 a chart:DataPoint ;
    chart:series ex:series-3006-1 ;
    chart:category "Manitoba" ;
    chart:value "39"^^xsd:decimal .

ex:mark-3006-1-8 a chart:DataPoint ;
    chart:series ex:series-3006-1 ;
    chart:category "Saskatchewan" ;
    chart:value "38"^^xsd:decimal .

ex:mark-3006-1-9 a chart:DataPoint ;
    chart:series ex:series-3006-1 ;
    chart:category "Newfoundland and Labrador" ;
    chart:value "23"^^xsd:decimal .

ex:mark-3006-1-10 a chart:DataPoint ;
    chart:series ex:series-3006-1 ;
    chart:category "Prince Edward Island" ;
    chart:value "5"^^xsd:decimal .
