@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-5283 a chart:Chart ;
    chart:chartType "line" ;
    chart:title "Median household income in Wisconsin from 1990 to 2019 (in current U.S. dollars)" ;
    chart:xAxis ex:x-5283 ;
    chart:yAxis ex:y-5283 .

ex:x-5283 a chart:Axis ;
    chart:label "Year with linear scale with a minimum of 1990 and a maximum of 2015 while the y-axis plots Household income in current U" .

ex:y-5283 a chart:Axis ;
    chart:label "" .

ex:series-5283-1 a chart:Series .

ex:mark-5283-1-1 a chart:DataPoint ;
    chart:series ex:series-5283-1 ;
    chart:category "Household income in current U.S. dollars Dec" ;
    chart:value "31"^^xsd:decimal .

