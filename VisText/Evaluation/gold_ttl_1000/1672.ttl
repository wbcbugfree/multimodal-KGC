@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-1672 a chart:Chart ;
    chart:chartType "area" ;
    chart:title "Number of internet users in the United States from 2000 to 2019 (in millions)" ;
    chart:xAxis ex:x-1672 ;
    chart:yAxis ex:y-1672 .

ex:x-1672 a chart:Axis ;
    chart:label "Year with linear scale of range 2000 to 2015 while the y-axis plots Number of internet users in millions" .

ex:y-1672 a chart:Axis ;
    chart:label "" .

ex:series-1672-1 a chart:Series .

ex:mark-1672-1-1 a chart:DataPoint ;
    chart:series ex:series-1672-1 ;
    chart:category "Number of internet users in millions Dec" ;
    chart:value "31"^^xsd:decimal .

