@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-835 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Annual volume of pineapple sold in the United Kingdom (UK) from 2008 to 2018 (in 1,000 tonnes)" ;
    chart:xAxis ex:x-835 ;
    chart:yAxis ex:y-835 .

ex:x-835 a chart:Axis ;
    chart:label "Year" .

ex:y-835 a chart:Axis ;
    chart:label "Sales volume in thousand tonnes" .

ex:series-835-1 a chart:Series .

ex:mark-835-1-1 a chart:DataPoint ;
    chart:series ex:series-835-1 ;
    chart:category "2018*" ;
    chart:value "30.9"^^xsd:decimal .

ex:mark-835-1-2 a chart:DataPoint ;
    chart:series ex:series-835-1 ;
    chart:category "2017*" ;
    chart:value "32"^^xsd:decimal .

ex:mark-835-1-3 a chart:DataPoint ;
    chart:series ex:series-835-1 ;
    chart:category "2016*" ;
    chart:value "33.2"^^xsd:decimal .

ex:mark-835-1-4 a chart:DataPoint ;
    chart:series ex:series-835-1 ;
    chart:category "*" ;
    chart:value "34.4"^^xsd:decimal .

ex:mark-835-1-5 a chart:DataPoint ;
    chart:series ex:series-835-1 ;
    chart:category "*" ;
    chart:value "35.7"^^xsd:decimal .
