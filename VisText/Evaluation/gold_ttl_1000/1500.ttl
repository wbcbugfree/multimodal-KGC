@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-1500 a chart:Chart ;
    chart:chartType "line" ;
    chart:title "Annual net income of Telus Corporation from 2010 to 2019 (in million Canadian dollars)" ;
    chart:xAxis ex:x-1500 ;
    chart:yAxis ex:y-1500 .

ex:x-1500 a chart:Axis ;
    chart:label "Year" .

ex:y-1500 a chart:Axis ;
    chart:label "" .

ex:series-1500-1 a chart:Series .

ex:mark-1500-1-1 a chart:DataPoint ;
    chart:series ex:series-1500-1 ;
    chart:category "Net income in billion Canadian dollars Dec" ;
    chart:value "31"^^xsd:decimal .

ex:mark-1500-1-2 a chart:DataPoint ;
    chart:series ex:series-1500-1 ;
    chart:category "Dec" ;
    chart:value "31"^^xsd:decimal .

