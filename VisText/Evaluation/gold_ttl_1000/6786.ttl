@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-6786 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Average fixed internet download and upload speeds in selected cities in the United States between 2nd and 3rd quarter 2018 (in Mbps)" ;
    chart:xAxis ex:x-6786 ;
    chart:yAxis ex:y-6786 .

ex:x-6786 a chart:Axis ;
    chart:label "Upload" .

ex:y-6786 a chart:Axis ;
    chart:label "" .

ex:series-6786-1 a chart:Series .

ex:mark-6786-1-1 a chart:DataPoint ;
    chart:series ex:series-6786-1 ;
    chart:category "city of the United States" ;
    chart:value "127.03"^^xsd:decimal .

