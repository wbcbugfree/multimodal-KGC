@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-4338 a chart:Chart ;
    chart:chartType "line" ;
    chart:title "Malaysia : Unemployment rate from 1999 to 2020" ;
    chart:xAxis ex:x-4338 ;
    chart:yAxis ex:y-4338 .

ex:x-4338 a chart:Axis ;
    chart:label "Year with linear scale of range 2000 to 2015 while the y-axis shows Unemployment rate" .

ex:y-4338 a chart:Axis ;
    chart:label "Unemployment rate" .

ex:series-4338-1 a chart:Series .

ex:mark-4338-1-1 a chart:DataPoint ;
    chart:series ex:series-4338-1 ;
    chart:category "Dec" ;
    chart:value "31"^^xsd:decimal .

