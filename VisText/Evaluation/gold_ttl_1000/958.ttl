@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-958 a chart:Chart ;
    chart:chartType "line" ;
    chart:title "France : Life expectancy at birth from 2008 to 2018" ;
    chart:xAxis ex:x-958 ;
    chart:yAxis ex:y-958 .

ex:x-958 a chart:Axis ;
    chart:label "Year while the y-axis measures Live expectancy at birth in years" .

ex:y-958 a chart:Axis ;
    chart:label "Live expectancy at birth in years" .

ex:series-958-1 a chart:Series .

ex:mark-958-1-1 a chart:DataPoint ;
    chart:series ex:series-958-1 ;
    chart:category "Dec" ;
    chart:value "31"^^xsd:decimal .

