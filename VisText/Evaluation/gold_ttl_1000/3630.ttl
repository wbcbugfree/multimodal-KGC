@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-3630 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Net sales of Gerdau S.A. from FY 2010 to FY 2019 (in million Brazilian reals)" ;
    chart:xAxis ex:x-3630 ;
    chart:yAxis ex:y-3630 .

ex:x-3630 a chart:Axis ;
    chart:label "Net sales in million Brazilian reals" .

ex:y-3630 a chart:Axis ;
    chart:label "Year while the x-axis shows Net sales in million Brazilian reals" .

ex:series-3630-1 a chart:Series .

ex:mark-3630-1-1 a chart:DataPoint ;
    chart:series ex:series-3630-1 ;
    chart:category "sales in million Brazilian reals Year" ;
    chart:value "39644.01"^^xsd:decimal .

ex:mark-3630-1-2 a chart:DataPoint ;
    chart:series ex:series-3630-1 ;
    chart:category "2015*" ;
    chart:value "42546.34"^^xsd:decimal .
