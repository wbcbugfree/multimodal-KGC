@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-1691 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Oil production in the Middle East in 2018 , by country (in 1,000 barrels per day)" ;
    chart:xAxis ex:x-1691 ;
    chart:yAxis ex:y-1691 .

ex:x-1691 a chart:Axis ;
    chart:label "Country while the y-axis shows Oil production in thousand barrels per day" .

ex:y-1691 a chart:Axis ;
    chart:label "Oil production in thousand barrels per day" .

ex:series-1691-1 a chart:Series .

ex:mark-1691-1-1 a chart:DataPoint ;
    chart:series ex:series-1691-1 ;
    chart:category "Saudi Arabia" ;
    chart:value "12287"^^xsd:decimal .

