@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-1830 a chart:Chart ;
    chart:chartType "area" ;
    chart:title "Total sales floor space of Fast Retailing worldwide from fiscal year 2010 to 2019 (in square-meters)" ;
    chart:xAxis ex:x-1830 ;
    chart:yAxis ex:y-1830 .

ex:x-1830 a chart:Axis ;
    chart:label "Year" .

ex:y-1830 a chart:Axis ;
    chart:label "" .

ex:series-1830-1 a chart:Series .

ex:mark-1830-1-1 a chart:DataPoint ;
    chart:series ex:series-1830-1 ;
    chart:category "Sales floor space in n square-meters Dec" ;
    chart:value "31"^^xsd:decimal .

ex:mark-1830-1-2 a chart:DataPoint ;
    chart:series ex:series-1830-1 ;
    chart:category "Dec" ;
    chart:value "31"^^xsd:decimal .

