@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-8444 a chart:Chart ;
    chart:chartType "line" ;
    chart:title "Number of post-baccalaureate students enrolled in the United States from 1976 to 2018 , by ethnicity (in 1,000s)" ;
    chart:xAxis ex:x-8444 ;
    chart:yAxis ex:y-8444 .

ex:x-8444 a chart:Axis ;
    chart:label "Year while the y-axis plots White" .

ex:y-8444 a chart:Axis ;
    chart:label "" .

ex:series-8444-1 a chart:Series .

ex:mark-8444-1-1 a chart:DataPoint ;
    chart:series ex:series-8444-1 ;
    chart:category "White Dec" ;
    chart:value "31"^^xsd:decimal .

