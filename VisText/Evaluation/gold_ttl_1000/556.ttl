@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-556 a chart:Chart ;
    chart:chartType "area" ;
    chart:title "Worldwide exports of railway track material from 2007 to 2019 (in million metric tons of crude steel production)" ;
    chart:xAxis ex:x-556 ;
    chart:yAxis ex:y-556 .

ex:x-556 a chart:Axis ;
    chart:label "Year" .

ex:y-556 a chart:Axis ;
    chart:label "" .

ex:series-556-1 a chart:Series .

ex:mark-556-1-1 a chart:DataPoint ;
    chart:series ex:series-556-1 ;
    chart:category "Exports in million metric tons Dec" ;
    chart:value "31"^^xsd:decimal .

