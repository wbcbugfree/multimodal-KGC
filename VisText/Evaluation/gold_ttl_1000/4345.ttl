@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-4345 a chart:Chart ;
    chart:chartType "area" ;
    chart:title "Number of Apple stores worldwide from 2005 to 2015" ;
    chart:xAxis ex:x-4345 ;
    chart:yAxis ex:y-4345 .

ex:x-4345 a chart:Axis ;
    chart:label "Fiscal years" .

ex:y-4345 a chart:Axis ;
    chart:label "Number of stores" .

ex:series-4345-1 a chart:Series .

ex:mark-4345-1-1 a chart:DataPoint ;
    chart:series ex:series-4345-1 ;
    chart:category "Dec" ;
    chart:value "31"^^xsd:decimal .

