@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-8651 a chart:Chart ;
    chart:chartType "area" ;
    chart:title "Manchester United revenue by segment from 2009 to 2020 (in million U.S. dollars)" ;
    chart:xAxis ex:x-8651 ;
    chart:yAxis ex:y-8651 .

ex:x-8651 a chart:Axis ;
    chart:label "Year with linear scale from 2010 to 2018 while the y-axis shows Broadcasting" .

ex:y-8651 a chart:Axis ;
    chart:label "Broadcasting" .

ex:series-8651-1 a chart:Series .

ex:mark-8651-1-1 a chart:DataPoint ;
    chart:series ex:series-8651-1 ;
    chart:category "Dec" ;
    chart:value "31"^^xsd:decimal .

