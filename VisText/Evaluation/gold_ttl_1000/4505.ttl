@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-4505 a chart:Chart ;
    chart:chartType "line" ;
    chart:title "Peru : Unemployment rate from 1999 to 2020" ;
    chart:xAxis ex:x-4505 ;
    chart:yAxis ex:y-4505 .

ex:x-4505 a chart:Axis ;
    chart:label "Year" .

ex:y-4505 a chart:Axis ;
    chart:label "" .

ex:series-4505-1 a chart:Series .

ex:mark-4505-1-1 a chart:DataPoint ;
    chart:series ex:series-4505-1 ;
    chart:category "Unemployment rate Dec" ;
    chart:value "31"^^xsd:decimal .

