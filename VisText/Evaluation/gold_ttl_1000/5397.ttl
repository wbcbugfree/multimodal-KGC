@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-5397 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Philippines : Total population from 2015 to 2025 (in million inhabitants)" ;
    chart:xAxis ex:x-5397 ;
    chart:yAxis ex:y-5397 .

ex:x-5397 a chart:Axis ;
    chart:label "Year" .

ex:y-5397 a chart:Axis ;
    chart:label "Inhabitants in millions" .

ex:series-5397-1 a chart:Series .

ex:mark-5397-1-1 a chart:DataPoint ;
    chart:series ex:series-5397-1 ;
    chart:category "2025*" ;
    chart:value "117.5"^^xsd:decimal .

ex:mark-5397-1-2 a chart:DataPoint ;
    chart:series ex:series-5397-1 ;
    chart:category "2024*" ;
    chart:value "115.73"^^xsd:decimal .

ex:mark-5397-1-3 a chart:DataPoint ;
    chart:series ex:series-5397-1 ;
    chart:category "2023*" ;
    chart:value "113.99"^^xsd:decimal .

ex:mark-5397-1-4 a chart:DataPoint ;
    chart:series ex:series-5397-1 ;
    chart:category "2022*" ;
    chart:value "112.28"^^xsd:decimal .

ex:mark-5397-1-5 a chart:DataPoint ;
    chart:series ex:series-5397-1 ;
    chart:category "2021*" ;
    chart:value "110.59"^^xsd:decimal .

ex:mark-5397-1-6 a chart:DataPoint ;
    chart:series ex:series-5397-1 ;
    chart:category "2020*" ;
    chart:value "108.93"^^xsd:decimal .
