@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-1231 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Average number of search terms for online search queries in Canada as of January 2020" ;
    chart:xAxis ex:x-1231 ;
    chart:yAxis ex:y-1231 .

ex:x-1231 a chart:Axis ;
    chart:label "Response while the y-axis measures Share of searches" .

ex:y-1231 a chart:Axis ;
    chart:label "Share of searches" .

ex:series-1231-1 a chart:Series .

ex:mark-1231-1-1 a chart:DataPoint ;
    chart:series ex:series-1231-1 ;
    chart:category "One word" ;
    chart:value "0.191"^^xsd:decimal .

ex:mark-1231-1-2 a chart:DataPoint ;
    chart:series ex:series-1231-1 ;
    chart:category "Two words" ;
    chart:value "0.4562"^^xsd:decimal .

ex:mark-1231-1-3 a chart:DataPoint ;
    chart:series ex:series-1231-1 ;
    chart:category "Three words" ;
    chart:value "0.2184"^^xsd:decimal .

ex:mark-1231-1-4 a chart:DataPoint ;
    chart:series ex:series-1231-1 ;
    chart:category "Four words" ;
    chart:value "0.072"^^xsd:decimal .

ex:mark-1231-1-5 a chart:DataPoint ;
    chart:series ex:series-1231-1 ;
    chart:category "Five words" ;
    chart:value "0.0318"^^xsd:decimal .

ex:mark-1231-1-6 a chart:DataPoint ;
    chart:series ex:series-1231-1 ;
    chart:category "Six words" ;
    chart:value "0.0146"^^xsd:decimal .

ex:mark-1231-1-7 a chart:DataPoint ;
    chart:series ex:series-1231-1 ;
    chart:category "Seven words" ;
    chart:value "0.0073"^^xsd:decimal .

ex:mark-1231-1-8 a chart:DataPoint ;
    chart:series ex:series-1231-1 ;
    chart:category "Eight words" ;
    chart:value "0.0039"^^xsd:decimal .

ex:mark-1231-1-9 a chart:DataPoint ;
    chart:series ex:series-1231-1 ;
    chart:category "Nine words" ;
    chart:value "0.0021"^^xsd:decimal .

ex:mark-1231-1-10 a chart:DataPoint ;
    chart:series ex:series-1231-1 ;
    chart:category "Ten or more words" ;
    chart:value "0.0027"^^xsd:decimal .
