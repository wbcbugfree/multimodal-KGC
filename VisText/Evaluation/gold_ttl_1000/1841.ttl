@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-1841 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Number of people with bleeding disorders in Canada in 2019 , by disorder type" ;
    chart:xAxis ex:x-1841 ;
    chart:yAxis ex:y-1841 .

ex:x-1841 a chart:Axis ;
    chart:label "Number of people" .

ex:y-1841 a chart:Axis ;
    chart:label "Bleeding Disorder Type while the x-axis plots Number of people" .

ex:series-1841-1 a chart:Series .

ex:mark-1841-1-1 a chart:DataPoint ;
    chart:series ex:series-1841-1 ;
    chart:category "of people Bleeding Disorder Type" ;
    chart:value "3127"^^xsd:decimal .

ex:mark-1841-1-2 a chart:DataPoint ;
    chart:series ex:series-1841-1 ;
    chart:category "Hemophilia A" ;
    chart:value "683"^^xsd:decimal .

