@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-5257 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Ukraine : national debt from 2010 to 2024 in relation to gross domestic product (GDP)" ;
    chart:xAxis ex:x-5257 ;
    chart:yAxis ex:y-5257 .

ex:x-5257 a chart:Axis ;
    chart:label "Year" .

ex:y-5257 a chart:Axis ;
    chart:label "" .

ex:series-5257-1 a chart:Series .

ex:mark-5257-1-1 a chart:DataPoint ;
    chart:series ex:series-5257-1 ;
    chart:category "National debt as percent of GDP 2024*" ;
    chart:value "0.4465"^^xsd:decimal .

ex:mark-5257-1-2 a chart:DataPoint ;
    chart:series ex:series-5257-1 ;
    chart:category "2023*" ;
    chart:value "0.4655"^^xsd:decimal .

ex:mark-5257-1-3 a chart:DataPoint ;
    chart:series ex:series-5257-1 ;
    chart:category "2022*" ;
    chart:value "0.4928"^^xsd:decimal .

ex:mark-5257-1-4 a chart:DataPoint ;
    chart:series ex:series-5257-1 ;
    chart:category "2021*" ;
    chart:value "0.5184"^^xsd:decimal .

ex:mark-5257-1-5 a chart:DataPoint ;
    chart:series ex:series-5257-1 ;
    chart:category "2020*" ;
    chart:value "0.543"^^xsd:decimal .

ex:mark-5257-1-6 a chart:DataPoint ;
    chart:series ex:series-5257-1 ;
    chart:category "2019*" ;
    chart:value "0.5695"^^xsd:decimal .

ex:mark-5257-1-7 a chart:DataPoint ;
    chart:series ex:series-5257-1 ;
    chart:category "2018*" ;
    chart:value "0.6021"^^xsd:decimal .
