@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-5842 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Total sports gate revenues in North America from 2006 to 2023 (in billion U.S. dollars)" ;
    chart:xAxis ex:x-5842 ;
    chart:yAxis ex:y-5842 .

ex:x-5842 a chart:Axis ;
    chart:label "Gate revenues in billion U" .

ex:y-5842 a chart:Axis ;
    chart:label "Year while the x-axis plots Gate revenues in billion U" .

ex:series-5842-1 a chart:Series .

ex:mark-5842-1-1 a chart:DataPoint ;
    chart:series ex:series-5842-1 ;
    chart:category "revenues in billion U.S. dollars Year" ;
    chart:value "21.76"^^xsd:decimal .

ex:mark-5842-1-2 a chart:DataPoint ;
    chart:series ex:series-5842-1 ;
    chart:category "2023**" ;
    chart:value "21.26"^^xsd:decimal .

ex:mark-5842-1-3 a chart:DataPoint ;
    chart:series ex:series-5842-1 ;
    chart:category "2022**" ;
    chart:value "20.76"^^xsd:decimal .

ex:mark-5842-1-4 a chart:DataPoint ;
    chart:series ex:series-5842-1 ;
    chart:category "2021**" ;
    chart:value "20.2"^^xsd:decimal .

ex:mark-5842-1-5 a chart:DataPoint ;
    chart:series ex:series-5842-1 ;
    chart:category "2020**" ;
    chart:value "19.55"^^xsd:decimal .

ex:mark-5842-1-6 a chart:DataPoint ;
    chart:series ex:series-5842-1 ;
    chart:category "2019**" ;
    chart:value "19.19"^^xsd:decimal .
