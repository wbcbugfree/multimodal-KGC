@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-1548 a chart:Chart ;
    chart:chartType "area" ;
    chart:title "Number of multichannel television homes in the United Kingdom (UK) from January 2000 to January 2019 (in million homes)" ;
    chart:xAxis ex:x-1548 ;
    chart:yAxis ex:y-1548 .

ex:x-1548 a chart:Axis ;
    chart:label "January" .

ex:y-1548 a chart:Axis ;
    chart:label "Homes in millions" .

ex:series-1548-1 a chart:Series .

ex:mark-1548-1-1 a chart:DataPoint ;
    chart:series ex:series-1548-1 ;
    chart:category "Dec" ;
    chart:value "31"^^xsd:decimal .

