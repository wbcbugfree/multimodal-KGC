@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-5016 a chart:Chart ;
    chart:chartType "area" ;
    chart:title "Number of employees of Penguin Random House from 2005 to 2019" ;
    chart:xAxis ex:x-5016 ;
    chart:yAxis ex:y-5016 .

ex:x-5016 a chart:Axis ;
    chart:label "Year" .

ex:y-5016 a chart:Axis ;
    chart:label "Number of employees" .

ex:series-5016-1 a chart:Series .

ex:mark-5016-1-1 a chart:DataPoint ;
    chart:series ex:series-5016-1 ;
    chart:category "Dec" ;
    chart:value "31"^^xsd:decimal .

