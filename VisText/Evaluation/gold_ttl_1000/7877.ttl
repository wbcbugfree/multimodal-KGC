@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-7877 a chart:Chart ;
    chart:chartType "area" ;
    chart:title "Net revenue of Williams-Sonoma worldwide from 2009 to 2019 , by brand (in million U.S. dollars)" ;
    chart:xAxis ex:x-7877 ;
    chart:yAxis ex:y-7877 .

ex:x-7877 a chart:Axis ;
    chart:label "Year" .

ex:y-7877 a chart:Axis ;
    chart:label "Other*" .

ex:series-7877-1 a chart:Series .

ex:mark-7877-1-1 a chart:DataPoint ;
    chart:series ex:series-7877-1 ;
    chart:category "Dec" ;
    chart:value "31"^^xsd:decimal .

