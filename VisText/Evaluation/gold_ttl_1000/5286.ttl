@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-5286 a chart:Chart ;
    chart:chartType "area" ;
    chart:title "Market capitalization of the Puma Group worldwide from 1993 to 2019 (in million euros)" ;
    chart:xAxis ex:x-5286 ;
    chart:yAxis ex:y-5286 .

ex:x-5286 a chart:Axis ;
    chart:label "Year" .

ex:y-5286 a chart:Axis ;
    chart:label "Market capitalization in million euros while the x-axis shows Year" .

ex:series-5286-1 a chart:Series .

ex:mark-5286-1-1 a chart:DataPoint ;
    chart:series ex:series-5286-1 ;
    chart:category "Market capitalization in million euros Dec" ;
    chart:value "31"^^xsd:decimal .

