@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-6305 a chart:Chart ;
    chart:chartType "line" ;
    chart:title "Projected population in Russia from 2020 to 2036 , by scenario (in 1,000s)" ;
    chart:xAxis ex:x-6305 ;
    chart:yAxis ex:y-6305 .

ex:x-6305 a chart:Axis ;
    chart:label "Year" .

ex:y-6305 a chart:Axis ;
    chart:label "Low expectation" .

ex:series-6305-1 a chart:Series .

ex:mark-6305-1-1 a chart:DataPoint ;
    chart:series ex:series-6305-1 ;
    chart:category "Dec" ;
    chart:value "31"^^xsd:decimal .

