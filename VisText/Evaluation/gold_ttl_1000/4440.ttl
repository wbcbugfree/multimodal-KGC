@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-4440 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Latin American passports with the most visa free access to other countries as of July 2020 (visa free score)" ;
    chart:xAxis ex:x-4440 ;
    chart:yAxis ex:y-4440 .

ex:x-4440 a chart:Axis ;
    chart:label "Visa" .

ex:y-4440 a chart:Axis ;
    chart:label "" .

ex:series-4440-1 a chart:Series .

ex:mark-4440-1-1 a chart:DataPoint ;
    chart:series ex:series-4440-1 ;
    chart:category "free score* Country" ;
    chart:value "174"^^xsd:decimal .

