@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-1905 a chart:Chart ;
    chart:chartType "area" ;
    chart:title "Population of the Tampa-St. Petersburg-Clearwater metro area in the United States from 2010 to 2019" ;
    chart:xAxis ex:x-1905 ;
    chart:yAxis ex:y-1905 .

ex:x-1905 a chart:Axis ;
    chart:label "Year" .

ex:y-1905 a chart:Axis ;
    chart:label "" .

ex:series-1905-1 a chart:Series .

ex:mark-1905-1-1 a chart:DataPoint ;
    chart:series ex:series-1905-1 ;
    chart:category "Number of residents Dec" ;
    chart:value "31"^^xsd:decimal .

