@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-5331 a chart:Chart ;
    chart:chartType "line" ;
    chart:title "Costa Rica : Infant mortality rate from 2009 to 2019 (in deaths per 1,000 live births)" ;
    chart:xAxis ex:x-5331 ;
    chart:yAxis ex:y-5331 .

ex:x-5331 a chart:Axis ;
    chart:label "Year" .

ex:y-5331 a chart:Axis ;
    chart:label "Deaths per 1,000 live births" .

ex:series-5331-1 a chart:Series .

ex:mark-5331-1-1 a chart:DataPoint ;
    chart:series ex:series-5331-1 ;
    chart:category "Dec" ;
    chart:value "31"^^xsd:decimal .

