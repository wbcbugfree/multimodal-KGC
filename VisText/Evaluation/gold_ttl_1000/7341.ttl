@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-7341 a chart:Chart ;
    chart:chartType "line" ;
    chart:title "Number of single-person households in the Netherlands from 2009 to 2019 , by gender" ;
    chart:xAxis ex:x-7341 ;
    chart:yAxis ex:y-7341 .

ex:x-7341 a chart:Axis ;
    chart:label "Year" .

ex:y-7341 a chart:Axis ;
    chart:label "Men while the x-axis shows Year" .

ex:series-7341-1 a chart:Series .

ex:mark-7341-1-1 a chart:DataPoint ;
    chart:series ex:series-7341-1 ;
    chart:category "Men Dec" ;
    chart:value "31"^^xsd:decimal .

