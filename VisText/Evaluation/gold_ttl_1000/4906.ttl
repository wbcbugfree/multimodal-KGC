@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-4906 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Advertising spending in Vietnam from 2004 to 2018 (in million U.S. dollars)" ;
    chart:xAxis ex:x-4906 ;
    chart:yAxis ex:y-4906 .

ex:x-4906 a chart:Axis ;
    chart:label "Year" .

ex:y-4906 a chart:Axis ;
    chart:label "" .

ex:series-4906-1 a chart:Series .

ex:mark-4906-1-1 a chart:DataPoint ;
    chart:series ex:series-4906-1 ;
    chart:category "Spending in million U.S. dollars 2018**" ;
    chart:value "1457.5"^^xsd:decimal .

ex:mark-4906-1-2 a chart:DataPoint ;
    chart:series ex:series-4906-1 ;
    chart:category "2017**" ;
    chart:value "1331.4"^^xsd:decimal .

ex:mark-4906-1-3 a chart:DataPoint ;
    chart:series ex:series-4906-1 ;
    chart:category "2016**" ;
    chart:value "1216.5"^^xsd:decimal .

ex:mark-4906-1-4 a chart:DataPoint ;
    chart:series ex:series-4906-1 ;
    chart:category "2015*" ;
    chart:value "1107.6"^^xsd:decimal .

ex:mark-4906-1-5 a chart:DataPoint ;
    chart:series ex:series-4906-1 ;
    chart:category "2014*" ;
    chart:value "1000.8"^^xsd:decimal .
