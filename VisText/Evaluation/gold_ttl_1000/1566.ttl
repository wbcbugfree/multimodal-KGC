@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-1566 a chart:Chart ;
    chart:chartType "line" ;
    chart:title "Total net written premiums of the general business insurance market in the United Kingdom (UK) from 2007 to 2018 (in million GBP)" ;
    chart:xAxis ex:x-1566 ;
    chart:yAxis ex:y-1566 .

ex:x-1566 a chart:Axis ;
    chart:label "Year" .

ex:y-1566 a chart:Axis ;
    chart:label "" .

ex:series-1566-1 a chart:Series .

ex:mark-1566-1-1 a chart:DataPoint ;
    chart:series ex:series-1566-1 ;
    chart:category "Amount in million GBP Dec" ;
    chart:value "31"^^xsd:decimal .

