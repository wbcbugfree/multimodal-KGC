@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-1168 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Installed power capacity across Tamil Nadu in India from financial year 2005 to 2018 (in megawatts)" ;
    chart:xAxis ex:x-1168 ;
    chart:yAxis ex:y-1168 .

ex:x-1168 a chart:Axis ;
    chart:label "Financial Year while the y-axis shows Installed power capacity in megawatts" .

ex:y-1168 a chart:Axis ;
    chart:label "Installed power capacity in megawatts" .

ex:series-1168-1 a chart:Series .

ex:mark-1168-1-1 a chart:DataPoint ;
    chart:series ex:series-1168-1 ;
    chart:category "FY" ;
    chart:value "2018"^^xsd:decimal .

