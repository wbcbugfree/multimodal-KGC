@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-1673 a chart:Chart ;
    chart:chartType "area" ;
    chart:title "Property insurance gross written premiums in the United Kingdom (UK) from 2004 to 2018 (in million euros)" ;
    chart:xAxis ex:x-1673 ;
    chart:yAxis ex:y-1673 .

ex:x-1673 a chart:Axis ;
    chart:label "Year with linear scale from 2004 to 2016 while the y-axis shows Gross written premiums in million euros*" .

ex:y-1673 a chart:Axis ;
    chart:label "Gross written premiums in million euros*" .

ex:series-1673-1 a chart:Series .

ex:mark-1673-1-1 a chart:DataPoint ;
    chart:series ex:series-1673-1 ;
    chart:category "Dec" ;
    chart:value "31"^^xsd:decimal .

