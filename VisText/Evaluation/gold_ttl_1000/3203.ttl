@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-3203 a chart:Chart ;
    chart:chartType "line" ;
    chart:title "Central African Republic : Life expectancy at birth from 2008 to 2018" ;
    chart:xAxis ex:x-3203 ;
    chart:yAxis ex:y-3203 .

ex:x-3203 a chart:Axis ;
    chart:label "Year with a linear scale with a minimum of 2008 and a maximum of 2016" .

ex:y-3203 a chart:Axis ;
    chart:label "" .

ex:series-3203-1 a chart:Series .

ex:mark-3203-1-1 a chart:DataPoint ;
    chart:series ex:series-3203-1 ;
    chart:category "Life expectancy at birth in years Dec" ;
    chart:value "31"^^xsd:decimal .

ex:mark-3203-1-2 a chart:DataPoint ;
    chart:series ex:series-3203-1 ;
    chart:category "Dec" ;
    chart:value "31"^^xsd:decimal .

