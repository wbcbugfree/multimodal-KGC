@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-8515 a chart:Chart ;
    chart:chartType "area" ;
    chart:title "Greenhouse gas emissions volume in the European Union from 1990 to 2017 , by sector (in kilotonnes of CO2-equivalent)" ;
    chart:xAxis ex:x-8515 ;
    chart:yAxis ex:y-8515 .

ex:x-8515 a chart:Axis ;
    chart:label "Year" .

ex:y-8515 a chart:Axis ;
    chart:label "" .

ex:series-8515-1 a chart:Series .

ex:mark-8515-1-1 a chart:DataPoint ;
    chart:series ex:series-8515-1 ;
    chart:category "Waste Dec" ;
    chart:value "31"^^xsd:decimal .

