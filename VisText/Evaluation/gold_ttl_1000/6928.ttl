@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-6928 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Length of life and cause of death of United States Presidents from 1799 to November 20 , 2020" ;
    chart:xAxis ex:x-6928 ;
    chart:yAxis ex:y-6928 .

ex:x-6928 a chart:Axis ;
    chart:label "Cancer" .

ex:y-6928 a chart:Axis ;
    chart:label "" .

ex:series-6928-1 a chart:Series .

ex:mark-6928-1-1 a chart:DataPoint ;
    chart:series ex:series-6928-1 ;
    chart:category "United States Presidents" ;
    chart:value "90.19"^^xsd:decimal .

ex:mark-6928-1-2 a chart:DataPoint ;
    chart:series ex:series-6928-1 ;
    chart:category "Herbert Hoover" ;
    chart:value "63.24"^^xsd:decimal .
