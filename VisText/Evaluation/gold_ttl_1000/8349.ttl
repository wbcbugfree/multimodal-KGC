@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-8349 a chart:Chart ;
    chart:chartType "line" ;
    chart:title "Number of deaths in Belgium from 2006 to 2016 , by cause of death" ;
    chart:xAxis ex:x-8349 ;
    chart:yAxis ex:y-8349 .

ex:x-8349 a chart:Axis ;
    chart:label "Year" .

ex:y-8349 a chart:Axis ;
    chart:label "" .

ex:series-8349-1 a chart:Series .

ex:mark-8349-1-1 a chart:DataPoint ;
    chart:series ex:series-8349-1 ;
    chart:category "Death by natural causes Dec" ;
    chart:value "31"^^xsd:decimal .

