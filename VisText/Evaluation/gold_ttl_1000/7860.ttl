@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-7860 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Crime clearance rate in the United States in 2019 , by region" ;
    chart:xAxis ex:x-7860 ;
    chart:yAxis ex:y-7860 .

ex:x-7860 a chart:Axis ;
    chart:label "West" .

ex:y-7860 a chart:Axis ;
    chart:label "" .

ex:series-7860-1 a chart:Series .

ex:mark-7860-1-1 a chart:DataPoint ;
    chart:series ex:series-7860-1 ;
    chart:category "crimes" ;
    chart:value "0.461"^^xsd:decimal .

