    chart:series ex:series-7098-1 ;
    chart:category "2022*" ;
    chart:value "92.87"^^xsd:decimal .

ex:mark-7098-1-5 a chart:DataPoint ;
    chart:series ex:series-7098-1 ;
    chart:category "2021*" ;
    chart:value "91.31"^^xsd:decimal .

ex:mark-7098-1-6 a chart:DataPoint ;
