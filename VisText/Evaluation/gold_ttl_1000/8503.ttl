@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-8503 a chart:Chart ;
    chart:chartType "area" ;
    chart:title "Total number of births , deaths and birth excess in the Netherlands from 2008 to 2018" ;
    chart:xAxis ex:x-8503 ;
    chart:yAxis ex:y-8503 .

ex:x-8503 a chart:Axis ;
    chart:label "Year" .

ex:y-8503 a chart:Axis ;
    chart:label "" .

ex:series-8503-1 a chart:Series .

ex:mark-8503-1-1 a chart:DataPoint ;
    chart:series ex:series-8503-1 ;
    chart:category "Deaths Dec" ;
    chart:value "31"^^xsd:decimal .

