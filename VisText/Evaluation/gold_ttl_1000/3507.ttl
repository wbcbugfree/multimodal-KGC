@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-3507 a chart:Chart ;
    chart:chartType "line" ;
    chart:title "Number of journalists and media workers murdered in Mexico from 2005 to 2018" ;
    chart:xAxis ex:x-3507 ;
    chart:yAxis ex:y-3507 .

ex:x-3507 a chart:Axis ;
    chart:label "Year" .

ex:y-3507 a chart:Axis ;
    chart:label "Number of victims" .

ex:series-3507-1 a chart:Series .

ex:mark-3507-1-1 a chart:DataPoint ;
    chart:series ex:series-3507-1 ;
    chart:category "Dec" ;
    chart:value "31"^^xsd:decimal .

