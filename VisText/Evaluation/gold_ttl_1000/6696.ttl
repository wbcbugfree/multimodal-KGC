@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-6696 a chart:Chart ;
    chart:chartType "area" ;
    chart:title "Wine production in the United States and in California from 2006 to 2017 (in million gallons)" ;
    chart:xAxis ex:x-6696 ;
    chart:yAxis ex:y-6696 .

ex:x-6696 a chart:Axis ;
    chart:label "Year" .

ex:y-6696 a chart:Axis ;
    chart:label "" .

ex:series-6696-1 a chart:Series .

ex:mark-6696-1-1 a chart:DataPoint ;
    chart:series ex:series-6696-1 ;
    chart:category "United States Dec" ;
    chart:value "31"^^xsd:decimal .

