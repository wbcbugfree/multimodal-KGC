@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-7049 a chart:Chart ;
    chart:chartType "area" ;
    chart:title "Revenue of the InterContinental Hotels Group (IHG) from 2008 to 2019 , by hotel ownership type (in million U.S. dollars)" ;
    chart:xAxis ex:x-7049 ;
    chart:yAxis ex:y-7049 .

ex:x-7049 a chart:Axis ;
    chart:label "Year while the y-axis plots Managed hotels" .

ex:y-7049 a chart:Axis ;
    chart:label "" .

ex:series-7049-1 a chart:Series .

ex:mark-7049-1-1 a chart:DataPoint ;
    chart:series ex:series-7049-1 ;
    chart:category "Managed hotels Dec" ;
    chart:value "31"^^xsd:decimal .

