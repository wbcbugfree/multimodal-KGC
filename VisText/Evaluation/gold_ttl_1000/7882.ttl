@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-7882 a chart:Chart ;
    chart:chartType "line" ;
    chart:title "Number of suspects arrested for terrorism offences in the European Union (EU) from 2010 to 2019 , by affiliation" ;
    chart:xAxis ex:x-7882 ;
    chart:yAxis ex:y-7882 .

ex:x-7882 a chart:Axis ;
    chart:label "Year" .

ex:y-7882 a chart:Axis ;
    chart:label "" .

