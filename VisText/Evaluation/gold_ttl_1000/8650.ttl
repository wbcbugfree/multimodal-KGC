@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-8650 a chart:Chart ;
    chart:chartType "area" ;
    chart:title "Internet penetration rate in the Middle East compared to the global internet penetration rate from 2009 to 2019" ;
    chart:xAxis ex:x-8650 ;
    chart:yAxis ex:y-8650 .

ex:x-8650 a chart:Axis ;
    chart:label "Year" .

ex:y-8650 a chart:Axis ;
    chart:label "Rest of the World while the x-axis shows Year" .

ex:series-8650-1 a chart:Series .

ex:mark-8650-1-1 a chart:DataPoint ;
    chart:series ex:series-8650-1 ;
    chart:category "Rest of the World Dec" ;
    chart:value "31"^^xsd:decimal .

ex:mark-8650-1-2 a chart:DataPoint ;
    chart:series ex:series-8650-1 ;
    chart:category "Dec" ;
    chart:value "31"^^xsd:decimal .

