@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-759 a chart:Chart ;
    chart:chartType "line" ;
    chart:title "Carbon dioxide (CO2) emissions in India from 2001 to 2016 (in metric tons per capita)" ;
    chart:xAxis ex:x-759 ;
    chart:yAxis ex:y-759 .

ex:x-759 a chart:Axis ;
    chart:label "Year" .

ex:y-759 a chart:Axis ;
    chart:label "" .

ex:series-759-1 a chart:Series .

ex:mark-759-1-1 a chart:DataPoint ;
    chart:series ex:series-759-1 ;
    chart:category "CO2 emissions in metric tons per capita Dec" ;
    chart:value "31"^^xsd:decimal .

