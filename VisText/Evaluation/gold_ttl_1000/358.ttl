@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-358 a chart:Chart ;
    chart:chartType "line" ;
    chart:title "Poverty rate for families in the United States from 1990 to 2019" ;
    chart:xAxis ex:x-358 ;
    chart:yAxis ex:y-358 .

ex:x-358 a chart:Axis ;
    chart:label "Year" .

ex:y-358 a chart:Axis ;
    chart:label "" .

ex:series-358-1 a chart:Series .

ex:mark-358-1-1 a chart:DataPoint ;
    chart:series ex:series-358-1 ;
    chart:category "Poverty rate Dec" ;
    chart:value "31"^^xsd:decimal .

