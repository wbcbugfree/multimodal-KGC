@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-954 a chart:Chart ;
    chart:chartType "area" ;
    chart:title "Kenya : Birth rate from 2008 to 2018 (per 1,000 inhabitants)" ;
    chart:xAxis ex:x-954 ;
    chart:yAxis ex:y-954 .

ex:x-954 a chart:Axis ;
    chart:label "Year while the y-axis plots Birth rate per thousand population" .

ex:y-954 a chart:Axis ;
    chart:label "" .

ex:series-954-1 a chart:Series .

ex:mark-954-1-1 a chart:DataPoint ;
    chart:series ex:series-954-1 ;
    chart:category "Birth rate per thousand population Dec" ;
    chart:value "31"^^xsd:decimal .

ex:mark-954-1-2 a chart:DataPoint ;
    chart:series ex:series-954-1 ;
    chart:category "Dec" ;
    chart:value "31"^^xsd:decimal .

