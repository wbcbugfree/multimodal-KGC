@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-4446 a chart:Chart ;
    chart:chartType "line" ;
    chart:title "Carolina Panthers revenue from 2001 to 2019 (in million U.S. dollars)" ;
    chart:xAxis ex:x-4446 ;
    chart:yAxis ex:y-4446 .

ex:x-4446 a chart:Axis ;
    chart:label "Year while the y-axis shows Revenue in million U" .

ex:y-4446 a chart:Axis ;
    chart:label "Revenue in million U" .

ex:series-4446-1 a chart:Series .

ex:mark-4446-1-1 a chart:DataPoint ;
    chart:series ex:series-4446-1 ;
    chart:category "Revenue in million U.S. dollars Dec" ;
    chart:value "31"^^xsd:decimal .

