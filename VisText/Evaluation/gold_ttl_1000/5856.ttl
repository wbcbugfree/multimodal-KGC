@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-5856 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Weekend box office revenue of the leading movies in Germany in January 2020 (in 1,000 U.S. dollars)" ;
