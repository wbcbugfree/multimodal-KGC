@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-7846 a chart:Chart ;
    chart:chartType "area" ;
    chart:title "Tanzania : Age structure from 2009 to 2019" ;
    chart:xAxis ex:x-7846 ;
    chart:yAxis ex:y-7846 .

ex:x-7846 a chart:Axis ;
    chart:label "Year with linear scale of range 2010 to 2018 while the y-axis shows 0-14 years" .

ex:y-7846 a chart:Axis ;
    chart:label "0-14 years" .

ex:series-7846-1 a chart:Series .

ex:mark-7846-1-1 a chart:DataPoint ;
    chart:series ex:series-7846-1 ;
    chart:category "Dec" ;
    chart:value "31"^^xsd:decimal .

