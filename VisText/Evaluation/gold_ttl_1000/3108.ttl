@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-3108 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Percentage of students to obtain a graduate degree in the United States in 2013 , by major group" ;
    chart:xAxis ex:x-3108 ;
    chart:yAxis ex:y-3108 .

ex:x-3108 a chart:Axis ;
    chart:label "Share of U" .

ex:y-3108 a chart:Axis ;
    chart:label "Response while the x-axis shows Share of U" .

ex:series-3108-1 a chart:Series .

