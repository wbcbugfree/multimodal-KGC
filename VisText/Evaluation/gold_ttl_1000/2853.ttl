@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-2853 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Percentage of underweight adolescent girls in selected countries in 2011" ;
    chart:xAxis ex:x-2853 ;
    chart:yAxis ex:y-2853 .

ex:x-2853 a chart:Axis ;
    chart:label "Percentage of adolescent girls" .

ex:y-2853 a chart:Axis ;
    chart:label "Response while the x-axis measures Percentage of adolescent girls" .

ex:series-2853-1 a chart:Series .

ex:mark-2853-1-1 a chart:DataPoint ;
    chart:series ex:series-2853-1 ;
    chart:category "of adolescent girls Response" ;
    chart:value "0.47"^^xsd:decimal .

ex:mark-2853-1-2 a chart:DataPoint ;
    chart:series ex:series-2853-1 ;
    chart:category "India" ;
    chart:value "0.35"^^xsd:decimal .

