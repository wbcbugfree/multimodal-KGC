@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-2428 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Average spending of adults in the United States on selected sharing companies or services as of January 2016 (in U.S. dollars)" ;
    chart:xAxis ex:x-2428 ;
    chart:yAxis ex:y-2428 .

ex:x-2428 a chart:Axis ;
    chart:label "company or service while the y-axis measures Average amunt spent in U" .

ex:y-2428 a chart:Axis ;
    chart:label "Average amunt spent in U" .

ex:series-2428-1 a chart:Series .

ex:mark-2428-1-1 a chart:DataPoint ;
    chart:series ex:series-2428-1 ;
    chart:category "or service Average amunt spent in U.S. dollars Air..." ;
    chart:value "114"^^xsd:decimal .

