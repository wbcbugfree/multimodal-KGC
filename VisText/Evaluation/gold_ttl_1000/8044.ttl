@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-8044 a chart:Chart ;
    chart:chartType "area" ;
    chart:title "Average daily cigarette consumption in Great Britain from 2000 to 2016 , by gender (in cigarettes per day)" ;
    chart:xAxis ex:x-8044 ;
    chart:yAxis ex:y-8044 .

ex:x-8044 a chart:Axis ;
    chart:label "Year" .

ex:y-8044 a chart:Axis ;
    chart:label "" .

ex:series-8044-1 a chart:Series .

ex:mark-8044-1-1 a chart:DataPoint ;
    chart:series ex:series-8044-1 ;
    chart:category "Women Dec" ;
    chart:value "31"^^xsd:decimal .

