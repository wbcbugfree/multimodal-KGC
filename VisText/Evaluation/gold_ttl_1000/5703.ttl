@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-5703 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Which social media could teen and young adult users in the United Kingdom (UK) least do without as of 3rd quarter 2019 ?" ;
    chart:xAxis ex:x-5703 ;
    chart:yAxis ex:y-5703 .

ex:x-5703 a chart:Axis ;
    chart:label "Response" .

ex:y-5703 a chart:Axis ;
    chart:label "Share of respondents" .

ex:series-5703-1 a chart:Series .

ex:mark-5703-1-1 a chart:DataPoint ;
    chart:series ex:series-5703-1 ;
    chart:category "YouTube" ;
    chart:value "0.232"^^xsd:decimal .

