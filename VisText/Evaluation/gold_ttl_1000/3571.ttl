@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-3571 a chart:Chart ;
    chart:chartType "line" ;
    chart:title "U.S. production of breaded shrimp from 2000 to 2018 (in metric tons)" ;
    chart:xAxis ex:x-3571 ;
    chart:yAxis ex:y-3571 .

ex:x-3571 a chart:Axis ;
    chart:label "Year" .

ex:y-3571 a chart:Axis ;
    chart:label "Production of breaded shrimp in metric tons while the x-axis measures Year" .

ex:series-3571-1 a chart:Series .

ex:mark-3571-1-1 a chart:DataPoint ;
    chart:series ex:series-3571-1 ;
    chart:category "Production of breaded shrimp in metric tons Dec" ;
    chart:value "31"^^xsd:decimal .

