@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-1068 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Most annoying hotel guest behavior according to fellow travelers in the United States as of September 2014" ;
    chart:xAxis ex:x-1068 ;
    chart:yAxis ex:y-1068 .

