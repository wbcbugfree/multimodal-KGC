@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-2854 a chart:Chart ;
    chart:chartType "line" ;
    chart:title "China 's cotton mill use from 1990 to 2017 (in 1,000 bales)" ;
    chart:xAxis ex:x-2854 ;
    chart:yAxis ex:y-2854 .

ex:x-2854 a chart:Axis ;
    chart:label "Year" .

ex:y-2854 a chart:Axis ;
    chart:label "" .

ex:series-2854-1 a chart:Series .

ex:mark-2854-1-1 a chart:DataPoint ;
    chart:series ex:series-2854-1 ;
    chart:category "Mill use in thousand 480-pound bales Dec" ;
    chart:value "31"^^xsd:decimal .

