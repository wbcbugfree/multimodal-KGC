@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-6089 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Which , if any , of the following measures have you taken in the past 2 weeks specifically to protect yourself from the Coronavirus (COVID-19) ?" ;
    chart:xAxis ex:x-6089 ;
    chart:yAxis ex:y-6089 .

ex:x-6089 a chart:Axis ;
    chart:label "Feb 29 to Mar 1 while the y-axis shows Response" .

ex:y-6089 a chart:Axis ;
    chart:label "Response" .

ex:series-6089-1 a chart:Series .

ex:mark-6089-1-1 a chart:DataPoint ;
    chart:series ex:series-6089-1 ;
    chart:category "Avoid crowded public places" ;
    chart:value "0.35"^^xsd:decimal .

ex:mark-6089-1-2 a chart:DataPoint ;
    chart:series ex:series-6089-1 ;
    chart:category "Improve personal hygiene (e.g. washing hands more ..." ;
    chart:value "0.14"^^xsd:decimal .

ex:mark-6089-1-3 a chart:DataPoint ;
    chart:series ex:series-6089-1 ;
    chart:category "Refrain from touching objects in public" ;
    chart:value "0.02"^^xsd:decimal .

ex:mark-6089-1-4 a chart:DataPoint ;
    chart:series ex:series-6089-1 ;
    chart:category "Avoid going to work" ;
    chart:value "0.09"^^xsd:decimal .

ex:mark-6089-1-5 a chart:DataPoint ;
    chart:series ex:series-6089-1 ;
    chart:category "Avoid physical contact with tourists" ;
    chart:value "0.06"^^xsd:decimal .

ex:mark-6089-1-6 a chart:DataPoint ;
    chart:series ex:series-6089-1 ;
    chart:category "Avoid consumption of raw or uncooked meat" ;
    chart:value "0.01"^^xsd:decimal .

ex:mark-6089-1-7 a chart:DataPoint ;
    chart:series ex:series-6089-1 ;
    chart:category "Wear a face mask in public places" ;
    chart:value "0.54"^^xsd:decimal .
