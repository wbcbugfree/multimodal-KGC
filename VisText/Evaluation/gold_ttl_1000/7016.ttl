@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-7016 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Monthly sales of cookies , confectionery and snack foods at large retailers in Canada from January 2015 to April 2019 (in million Canadian dollars)" ;
