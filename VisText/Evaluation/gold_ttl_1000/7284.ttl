@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-7284 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Gender distribution of religious groups in the United States in 2017 , by faith tradition" ;
    chart:xAxis ex:x-7284 ;
    chart:yAxis ex:y-7284 .

ex:x-7284 a chart:Axis ;
    chart:label "faith tradition" .

ex:y-7284 a chart:Axis ;
    chart:label "Men" .

ex:series-7284-1 a chart:Series .

