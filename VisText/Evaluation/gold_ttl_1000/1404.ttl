@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-1404 a chart:Chart ;
    chart:chartType "line" ;
    chart:title "Ukraine : Youth unemployment rate from 1999 to 2020" ;
    chart:xAxis ex:x-1404 ;
    chart:yAxis ex:y-1404 .

ex:x-1404 a chart:Axis ;
    chart:label "Year" .

ex:y-1404 a chart:Axis ;
    chart:label "" .

