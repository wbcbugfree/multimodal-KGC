@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-5440 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Economic loss due to major droughts worldwide from 1900 to 2016 (in billion U.S. dollars)" ;
    chart:xAxis ex:x-5440 ;
    chart:yAxis ex:y-5440 .

ex:x-5440 a chart:Axis ;
    chart:label "Economic loss in billion U" .

ex:y-5440 a chart:Axis ;
    chart:label "Drought" .

ex:series-5440-1 a chart:Series .

ex:mark-5440-1-1 a chart:DataPoint ;
    chart:series ex:series-5440-1 ;
    chart:category "United States, June" ;
    chart:value "2012"^^xsd:decimal .

