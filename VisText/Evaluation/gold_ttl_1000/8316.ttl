@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-8316 a chart:Chart ;
    chart:chartType "line" ;
    chart:title "Percentage of people who identify with a political party in Great Britain (GB) from 1997 to 2012 , by party" ;
    chart:xAxis ex:x-8316 ;
    chart:yAxis ex:y-8316 .

ex:x-8316 a chart:Axis ;
    chart:label "Year" .

ex:y-8316 a chart:Axis ;
    chart:label "" .

ex:series-8316-1 a chart:Series .

ex:mark-8316-1-1 a chart:DataPoint ;
    chart:series ex:series-8316-1 ;
    chart:category "Any party Dec" ;
    chart:value "31"^^xsd:decimal .

