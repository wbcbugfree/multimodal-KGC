    chart:series ex:series-5924-1 ;
    chart:category "S Health (for Samsung)" ;
    chart:value "3.7"^^xsd:decimal .

ex:mark-5924-1-5 a chart:DataPoint ;
    chart:series ex:series-5924-1 ;
    chart:category "Weight Watchers" ;
    chart:value "2.6"^^xsd:decimal .

ex:mark-5924-1-6 a chart:DataPoint ;
    chart:series ex:series-5924-1 ;
    chart:category "Google Fit" ;
    chart:value "1.9"^^xsd:decimal .

ex:mark-5924-1-7 a chart:DataPoint ;
