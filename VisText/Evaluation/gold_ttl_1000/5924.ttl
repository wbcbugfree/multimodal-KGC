@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-5924 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Most popular health and fitness apps in the United States as of May 2018 , by monthly active users (in millions)" ;
    chart:xAxis ex:x-5924 ;
    chart:yAxis ex:y-5924 .

ex:x-5924 a chart:Axis ;
    chart:label "Number of monthly unique users in millions while the y-axis plots Health and fitness apps" .

ex:y-5924 a chart:Axis ;
    chart:label "" .

ex:series-5924-1 a chart:Series .

ex:mark-5924-1-1 a chart:DataPoint ;
    chart:series ex:series-5924-1 ;
    chart:category "of monthly unique users in millions Health and fit..." ;
    chart:value "27.4"^^xsd:decimal .

ex:mark-5924-1-2 a chart:DataPoint ;
    chart:series ex:series-5924-1 ;
    chart:category "Fitbit" ;
    chart:value "19.1"^^xsd:decimal .

