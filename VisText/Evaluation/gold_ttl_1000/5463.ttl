@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-5463 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Canada : Budget balance from 2015 to 2025 in relation to gross domestic product (GDP)" ;
    chart:xAxis ex:x-5463 ;
    chart:yAxis ex:y-5463 .

ex:x-5463 a chart:Axis ;
    chart:label "Year" .

ex:y-5463 a chart:Axis ;
    chart:label "" .

ex:series-5463-1 a chart:Series .

ex:mark-5463-1-1 a chart:DataPoint ;
    chart:series ex:series-5463-1 ;
    chart:category "Budget balance to GDP ratio 2025* −0.0027 2024* −0..." ;
    chart:value "2019"^^xsd:decimal .

ex:mark-5463-1-2 a chart:DataPoint ;
    chart:series ex:series-5463-1 ;
    chart:category "−0.0035" ;
    chart:value "2018"^^xsd:decimal .

ex:mark-5463-1-3 a chart:DataPoint ;
    chart:series ex:series-5463-1 ;
    chart:category "−0.004" ;
    chart:value "2017"^^xsd:decimal .

ex:mark-5463-1-4 a chart:DataPoint ;
    chart:series ex:series-5463-1 ;
    chart:category "−0.0013" ;
    chart:value "2016"^^xsd:decimal .

ex:mark-5463-1-5 a chart:DataPoint ;
    chart:series ex:series-5463-1 ;
    chart:category "−0.0045" ;
    chart:value "2015"^^xsd:decimal .
