@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-5973 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Average number of people per family in Canada in 2018 , by province" ;
    chart:xAxis ex:x-5973 ;
    chart:yAxis ex:y-5973 .

ex:x-5973 a chart:Axis ;
    chart:label "Average number of people" .

ex:y-5973 a chart:Axis ;
    chart:label "administrative territorial entity of Canada" .

