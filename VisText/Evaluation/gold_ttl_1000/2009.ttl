    chart:series ex:series-2009-1 ;
    chart:category "Dec" ;
    chart:value "31"^^xsd:decimal .

ex:mark-2009-1-6 a chart:DataPoint ;
    chart:series ex:series-2009-1 ;
    chart:category "Dec" ;
    chart:value "31"^^xsd:decimal .

ex:mark-2009-1-7 a chart:DataPoint ;
    chart:series ex:series-2009-1 ;
    chart:category "Dec" ;
