@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-2009 a chart:Chart ;
    chart:chartType "line" ;
    chart:title "Forecast of the life expectancy at birth in the Netherlands from 2015 to 2060 (in years)" ;
    chart:xAxis ex:x-2009 ;
    chart:yAxis ex:y-2009 .

ex:x-2009 a chart:Axis ;
    chart:label "Year" .

ex:y-2009 a chart:Axis ;
    chart:label "" .

ex:series-2009-1 a chart:Series .

ex:mark-2009-1-1 a chart:DataPoint ;
    chart:series ex:series-2009-1 ;
    chart:category "Life expectancy in years Dec" ;
    chart:value "31"^^xsd:decimal .

ex:mark-2009-1-2 a chart:DataPoint ;
    chart:series ex:series-2009-1 ;
    chart:category "Dec" ;
    chart:value "31"^^xsd:decimal .

ex:mark-2009-1-3 a chart:DataPoint ;
    chart:series ex:series-2009-1 ;
    chart:category "Dec" ;
    chart:value "31"^^xsd:decimal .

