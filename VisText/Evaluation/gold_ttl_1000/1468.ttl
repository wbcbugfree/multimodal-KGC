@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-1468 a chart:Chart ;
    chart:chartType "line" ;
    chart:title "Annual percent change in the real GDP in Indiana from 2000 to 2019" ;
    chart:xAxis ex:x-1468 ;
    chart:yAxis ex:y-1468 .

ex:x-1468 a chart:Axis ;
    chart:label "Year while the y-axis measures Percent change compared to preceding period" .

ex:y-1468 a chart:Axis ;
    chart:label "Percent change compared to preceding period" .

ex:series-1468-1 a chart:Series .

ex:mark-1468-1-1 a chart:DataPoint ;
