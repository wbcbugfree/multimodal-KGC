@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-4184 a chart:Chart ;
    chart:chartType "line" ;
    chart:title "Number of employees at Total S.A. from 2008 to 2019" ;
    chart:xAxis ex:x-4184 ;
    chart:yAxis ex:y-4184 .

ex:x-4184 a chart:Axis ;
    chart:label "Year" .

ex:y-4184 a chart:Axis ;
    chart:label "Number of employees" .

ex:series-4184-1 a chart:Series .

ex:mark-4184-1-1 a chart:DataPoint ;
    chart:series ex:series-4184-1 ;
    chart:category "Dec" ;
    chart:value "31"^^xsd:decimal .

