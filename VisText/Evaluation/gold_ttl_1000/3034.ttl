@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-3034 a chart:Chart ;
    chart:chartType "area" ;
    chart:title "Number of enterprises in the manufacture of soft drinks , production of mineral waters and other bottled waters industry in Bulgaria from 2008 to 2018" ;
    chart:xAxis ex:x-3034 ;
    chart:yAxis ex:y-3034 .

ex:x-3034 a chart:Axis ;
    chart:label "Year" .

ex:y-3034 a chart:Axis ;
    chart:label "" .

ex:series-3034-1 a chart:Series .

ex:mark-3034-1-1 a chart:DataPoint ;
    chart:series ex:series-3034-1 ;
    chart:category "Number of enterprises Dec" ;
    chart:value "31"^^xsd:decimal .

