@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-6423 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Average payroll of Major League Baseball teams from 2002 to 2012 (in million U.S. dollars)" ;
    chart:xAxis ex:x-6423 ;
    chart:yAxis ex:y-6423 .

ex:x-6423 a chart:Axis ;
    chart:label "Year" .

ex:y-6423 a chart:Axis ;
    chart:label "" .

ex:series-6423-1 a chart:Series .

ex:mark-6423-1-1 a chart:DataPoint ;
    chart:series ex:series-6423-1 ;
    chart:category "All teams 2012*" ;
    chart:value "98.02"^^xsd:decimal .
