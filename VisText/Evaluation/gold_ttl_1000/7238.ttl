@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-7238 a chart:Chart ;
    chart:chartType "line" ;
    chart:title "Ghana : Distribution of employment by economic sector from 2010 to 2020" ;
    chart:xAxis ex:x-7238 ;
    chart:yAxis ex:y-7238 .

ex:x-7238 a chart:Axis ;
    chart:label "Year while the y-axis plots Services" .

ex:y-7238 a chart:Axis ;
    chart:label "" .

ex:series-7238-1 a chart:Series .

ex:mark-7238-1-1 a chart:DataPoint ;
    chart:series ex:series-7238-1 ;
    chart:category "Services Dec" ;
    chart:value "31"^^xsd:decimal .

