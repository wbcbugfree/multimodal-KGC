@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-5613 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Yamaha YZF R1 registered motorcycle numbers in Great Britain from 2000 to 2019" ;
    chart:xAxis ex:x-5613 ;
    chart:yAxis ex:y-5613 .

ex:x-5613 a chart:Axis ;
    chart:label "Number of registered motorcycles while the y-axis shows Year" .

ex:y-5613 a chart:Axis ;
    chart:label "Year" .

ex:series-5613-1 a chart:Series .

ex:mark-5613-1-1 a chart:DataPoint ;
    chart:series ex:series-5613-1 ;
    chart:category "2014*" ;
    chart:value "17395"^^xsd:decimal .
