@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-4786 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Average ticket price Brooklyn Nets games of the NBA from 2006/07 to 2015/16 (in U.S. dollars)" ;
    chart:xAxis ex:x-4786 ;
    chart:yAxis ex:y-4786 .

ex:x-4786 a chart:Axis ;
    chart:label "Average ticket price in U.S. dollars" .

ex:y-4786 a chart:Axis ;
    chart:label "Year" .

ex:series-4786-1 a chart:Series .

