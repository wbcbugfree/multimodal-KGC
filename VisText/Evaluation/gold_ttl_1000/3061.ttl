@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-3061 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Distribution of top importers of tuna in the United Kingdom (UK) in 2017 , by share of total volume imported" ;
    chart:xAxis ex:x-3061 ;
    chart:yAxis ex:y-3061 .

ex:x-3061 a chart:Axis ;
    chart:label "Share of total volume imported" .

ex:y-3061 a chart:Axis ;
    chart:label "Response" .

ex:series-3061-1 a chart:Series .

