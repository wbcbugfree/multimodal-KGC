@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-785 a chart:Chart ;
    chart:chartType "area" ;
    chart:title "Nigeria : Unemployment rate from 1999 to 2020" ;
    chart:xAxis ex:x-785 ;
    chart:yAxis ex:y-785 .

ex:x-785 a chart:Axis ;
    chart:label "Year" .

ex:y-785 a chart:Axis ;
    chart:label "" .

ex:series-785-1 a chart:Series .

ex:mark-785-1-1 a chart:DataPoint ;
    chart:series ex:series-785-1 ;
    chart:category "Unemployment rate Dec" ;
    chart:value "31"^^xsd:decimal .

