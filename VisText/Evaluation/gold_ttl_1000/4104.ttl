@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-4104 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Leading gaming content on Twitch worldwide from January 1 , 2019 to June 30 , 2019 , by hours watched (in millions)" ;
    chart:xAxis ex:x-4104 ;
    chart:yAxis ex:y-4104 .

ex:x-4104 a chart:Axis ;
    chart:label "Number" .

ex:y-4104 a chart:Axis ;
    chart:label "" .

ex:series-4104-1 a chart:Series .

ex:mark-4104-1-1 a chart:DataPoint ;
    chart:series ex:series-4104-1 ;
    chart:category "of hours watched gaming content" ;
    chart:value "512.3"^^xsd:decimal .

