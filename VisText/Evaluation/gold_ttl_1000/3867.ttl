@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-3867 a chart:Chart ;
    chart:chartType "area" ;
    chart:title "Amount of money invested in road transport infrastructure in Norway from 2004 to 2017 (in million euros)" ;
    chart:xAxis ex:x-3867 ;
    chart:yAxis ex:y-3867 .

ex:x-3867 a chart:Axis ;
    chart:label "Year" .

ex:y-3867 a chart:Axis ;
    chart:label "" .

