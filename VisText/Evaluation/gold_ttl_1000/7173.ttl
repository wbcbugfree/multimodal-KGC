@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-7173 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Number of billionaires worldwide from 2001 to 2012 , by region" ;
    chart:xAxis ex:x-7173 ;
    chart:yAxis ex:y-7173 .

ex:x-7173 a chart:Axis ;
    chart:label "year while the y-axis measures Europe" .

ex:y-7173 a chart:Axis ;
    chart:label "Europe" .

ex:series-7173-1 a chart:Series .

ex:mark-7173-1-1 a chart:DataPoint ;
    chart:series ex:series-7173-1 ;
    chart:category "'12" ;
    chart:value "310"^^xsd:decimal .

