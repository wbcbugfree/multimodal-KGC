@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-74 a chart:Chart ;
    chart:chartType "line" ;
    chart:title "The adidas Group 's financial leverage worldwide from 2000 to 2018" ;
    chart:xAxis ex:x-74 ;
    chart:yAxis ex:y-74 .

ex:x-74 a chart:Axis ;
    chart:label "Year" .

ex:y-74 a chart:Axis ;
    chart:label "" .

ex:series-74-1 a chart:Series .

ex:mark-74-1-1 a chart:DataPoint ;
    chart:series ex:series-74-1 ;
    chart:category "Financial leverage Dec" ;
    chart:value "31"^^xsd:decimal .

