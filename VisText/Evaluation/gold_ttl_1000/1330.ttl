@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-1330 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Libya : Total population from 2015 to 2025 (in million inhabitants)" ;
    chart:xAxis ex:x-1330 ;
    chart:yAxis ex:y-1330 .

ex:x-1330 a chart:Axis ;
    chart:label "Inhabitants in millions" .

ex:y-1330 a chart:Axis ;
    chart:label "" .

ex:series-1330-1 a chart:Series .

ex:mark-1330-1-1 a chart:DataPoint ;
    chart:series ex:series-1330-1 ;
    chart:category "in millions Year" ;
    chart:value "6.98"^^xsd:decimal .

ex:mark-1330-1-2 a chart:DataPoint ;
    chart:series ex:series-1330-1 ;
    chart:category "2025*" ;
    chart:value "6.91"^^xsd:decimal .

ex:mark-1330-1-3 a chart:DataPoint ;
    chart:series ex:series-1330-1 ;
    chart:category "2024*" ;
    chart:value "6.85"^^xsd:decimal .

ex:mark-1330-1-4 a chart:DataPoint ;
    chart:series ex:series-1330-1 ;
    chart:category "2023*" ;
    chart:value "6.78"^^xsd:decimal .

ex:mark-1330-1-5 a chart:DataPoint ;
    chart:series ex:series-1330-1 ;
    chart:category "2022*" ;
    chart:value "6.71"^^xsd:decimal .

ex:mark-1330-1-6 a chart:DataPoint ;
    chart:series ex:series-1330-1 ;
    chart:category "2021*" ;
    chart:value "6.64"^^xsd:decimal .

ex:mark-1330-1-7 a chart:DataPoint ;
    chart:series ex:series-1330-1 ;
    chart:category "2020*" ;
    chart:value "6.58"^^xsd:decimal .
