@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-4725 a chart:Chart ;
    chart:chartType "line" ;
    chart:title "Per capita consumption of fresh mushrooms in the United States from 2009 to 2019 (in pounds)" ;
    chart:xAxis ex:x-4725 ;
    chart:yAxis ex:y-4725 .

ex:x-4725 a chart:Axis ;
    chart:label "Year while the y-axis plots Per capita consumption in pounds" .

ex:y-4725 a chart:Axis ;
    chart:label "" .

ex:series-4725-1 a chart:Series .

ex:mark-4725-1-1 a chart:DataPoint ;
    chart:series ex:series-4725-1 ;
    chart:category "Per capita consumption in pounds Dec" ;
    chart:value "31"^^xsd:decimal .

