    chart:series ex:series-2886-1 ;
    chart:category "Alberta" ;
    chart:value "19"^^xsd:decimal .

ex:mark-2886-1-5 a chart:DataPoint ;
    chart:series ex:series-2886-1 ;
    chart:category "Manitoba" ;
    chart:value "14"^^xsd:decimal .

ex:mark-2886-1-6 a chart:DataPoint ;
    chart:series ex:series-2886-1 ;
    chart:category "Nova Scotia" ;
    chart:value "12"^^xsd:decimal .

