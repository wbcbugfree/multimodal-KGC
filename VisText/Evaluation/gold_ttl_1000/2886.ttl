@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-2886 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Number of soft drink and ice manufacturing establishments in Canada as of December 2019 , by region" ;
    chart:xAxis ex:x-2886 ;
    chart:yAxis ex:y-2886 .

ex:x-2886 a chart:Axis ;
    chart:label "province of Canada with categorical scale from Alberta to" .

ex:y-2886 a chart:Axis ;
    chart:label "Number of establishments" .

ex:series-2886-1 a chart:Series .

ex:mark-2886-1-1 a chart:DataPoint ;
    chart:series ex:series-2886-1 ;
    chart:category "Ontario" ;
    chart:value "53"^^xsd:decimal .

ex:mark-2886-1-2 a chart:DataPoint ;
    chart:series ex:series-2886-1 ;
    chart:category "British Columbia" ;
    chart:value "51"^^xsd:decimal .

