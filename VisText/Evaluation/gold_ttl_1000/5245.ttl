@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-5245 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Most centuries scored in international test match cricket as of September 2020 , by player" ;
    chart:xAxis ex:x-5245 ;
    chart:yAxis ex:y-5245 .

ex:x-5245 a chart:Axis ;
    chart:label "Number" .

ex:y-5245 a chart:Axis ;
    chart:label "" .

ex:series-5245-1 a chart:Series .

ex:mark-5245-1-1 a chart:DataPoint ;
    chart:series ex:series-5245-1 ;
    chart:category "of centuries scored player name" ;
    chart:value "51"^^xsd:decimal .

