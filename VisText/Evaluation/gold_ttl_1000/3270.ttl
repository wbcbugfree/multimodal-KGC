@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-3270 a chart:Chart ;
    chart:chartType "line" ;
    chart:title "Consumer price index (CPI) of non-alcoholic beverages in the United Kingdom (UK) from 2003 to 2019" ;
    chart:xAxis ex:x-3270 ;
    chart:yAxis ex:y-3270 .

ex:x-3270 a chart:Axis ;
    chart:label "Year with a linear scale with a minimum of 2005 and a maximum of 2015" .

ex:y-3270 a chart:Axis ;
    chart:label "" .

ex:series-3270-1 a chart:Series .

ex:mark-3270-1-1 a chart:DataPoint ;
    chart:series ex:series-3270-1 ;
    chart:category "Consumer price index* Dec" ;
    chart:value "31"^^xsd:decimal .

