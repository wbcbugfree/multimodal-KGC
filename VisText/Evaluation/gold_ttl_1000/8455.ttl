@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-8455 a chart:Chart ;
    chart:chartType "line" ;
    chart:title "Percentage of U.S. students in grade 12 that perceived trying Adderall as being a great risk for harm from 2010 to 2019" ;
    chart:xAxis ex:x-8455 ;
    chart:yAxis ex:y-8455 .

ex:x-8455 a chart:Axis ;
    chart:label "Response" .

ex:y-8455 a chart:Axis ;
    chart:label "" .

ex:series-8455-1 a chart:Series .

ex:mark-8455-1-1 a chart:DataPoint ;
    chart:series ex:series-8455-1 ;
    chart:category "Trying occasionally Dec" ;
    chart:value "31"^^xsd:decimal .

