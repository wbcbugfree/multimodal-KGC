@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-7092 a chart:Chart ;
    chart:chartType "area" ;
    chart:title "Average hours per day spent on leisure and sports in the U.S. sorted by educational attainment from 2009 to 2019" ;
    chart:xAxis ex:x-7092 ;
    chart:yAxis ex:y-7092 .

ex:x-7092 a chart:Axis ;
    chart:label "Year" .

ex:y-7092 a chart:Axis ;
    chart:label "" .

ex:series-7092-1 a chart:Series .

