@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-3872 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Number of deaths from unintentional carbon monoxide poisoning in the United Kingdom (UK) from 1995 to 2019 , by age" ;
    chart:xAxis ex:x-3872 ;
    chart:yAxis ex:y-3872 .

ex:x-3872 a chart:Axis ;
    chart:label "Age in years" .

ex:y-3872 a chart:Axis ;
    chart:label "" .

ex:series-3872-1 a chart:Series .

ex:mark-3872-1-1 a chart:DataPoint ;
    chart:series ex:series-3872-1 ;
    chart:category "in years Number of deaths Not known" ;
    chart:value "3"^^xsd:decimal .

ex:mark-3872-1-2 a chart:DataPoint ;
    chart:series ex:series-3872-1 ;
    chart:category "and over" ;
    chart:value "13"^^xsd:decimal .

ex:mark-3872-1-3 a chart:DataPoint ;
    chart:series ex:series-3872-1 ;
    chart:category "81-90" ;
    chart:value "94"^^xsd:decimal .

ex:mark-3872-1-4 a chart:DataPoint ;
    chart:series ex:series-3872-1 ;
    chart:category "71-80" ;
    chart:value "119"^^xsd:decimal .

ex:mark-3872-1-5 a chart:DataPoint ;
    chart:series ex:series-3872-1 ;
    chart:category "61-70" ;
    chart:value "93"^^xsd:decimal .

ex:mark-3872-1-6 a chart:DataPoint ;
    chart:series ex:series-3872-1 ;
    chart:category "51-60" ;
    chart:value "95"^^xsd:decimal .

ex:mark-3872-1-7 a chart:DataPoint ;
    chart:series ex:series-3872-1 ;
    chart:category "41-50" ;
    chart:value "93"^^xsd:decimal .

ex:mark-3872-1-8 a chart:DataPoint ;
