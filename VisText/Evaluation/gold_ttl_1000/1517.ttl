@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-1517 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Total number of marriages in France from 2004 to 2019" ;
    chart:xAxis ex:x-1517 ;
    chart:yAxis ex:y-1517 .

ex:x-1517 a chart:Axis ;
    chart:label "Year while the y-axis plots Number of marriages" .

ex:y-1517 a chart:Axis ;
    chart:label "" .

ex:series-1517-1 a chart:Series .

ex:mark-1517-1-1 a chart:DataPoint ;
    chart:series ex:series-1517-1 ;
    chart:category "Number of marriages" ;
    chart:value "2004"^^xsd:decimal .

ex:mark-1517-1-2 a chart:DataPoint ;
    chart:series ex:series-1517-1 ;
    chart:category "2017*" ;
    chart:value "226700"^^xsd:decimal .

ex:mark-1517-1-3 a chart:DataPoint ;
    chart:series ex:series-1517-1 ;
    chart:category "2018*" ;
    chart:value "228300"^^xsd:decimal .

ex:mark-1517-1-4 a chart:DataPoint ;
    chart:series ex:series-1517-1 ;
    chart:category "2019*" ;
    chart:value "221000"^^xsd:decimal .
