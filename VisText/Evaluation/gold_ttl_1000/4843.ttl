@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-4843 a chart:Chart ;
    chart:chartType "line" ;
    chart:title "Average consumer spending on Super Bowl Sunday in the United States from 2011 to 2020 (in U.S. dollars)" ;
    chart:xAxis ex:x-4843 ;
    chart:yAxis ex:y-4843 .

ex:x-4843 a chart:Axis ;
    chart:label "Year" .

ex:y-4843 a chart:Axis ;
    chart:label "" .

ex:series-4843-1 a chart:Series .

ex:mark-4843-1-1 a chart:DataPoint ;
    chart:series ex:series-4843-1 ;
    chart:category "Planned spending in U.S. dollars Dec" ;
    chart:value "31"^^xsd:decimal .

