@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-4766 a chart:Chart ;
    chart:chartType "line" ;
    chart:title "Norway : Urbanization from 2009 to 2019" ;
    chart:xAxis ex:x-4766 ;
    chart:yAxis ex:y-4766 .

ex:x-4766 a chart:Axis ;
    chart:label "Response while the y-axis measures Share of urban population in total population" .

ex:y-4766 a chart:Axis ;
    chart:label "Share of urban population in total population" .

ex:series-4766-1 a chart:Series .

ex:mark-4766-1-1 a chart:DataPoint ;
    chart:series ex:series-4766-1 ;
    chart:category "Dec" ;
    chart:value "31"^^xsd:decimal .

