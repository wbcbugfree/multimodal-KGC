@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-1887 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Import volume of grapes in Canada from 2010/11 to 2019/20 (in 1,000 metric tons)" ;
    chart:xAxis ex:x-1887 ;
    chart:yAxis ex:y-1887 .

ex:x-1887 a chart:Axis ;
    chart:label "Year" .

ex:y-1887 a chart:Axis ;
    chart:label "Import volume in 1,000 metric tons" .

ex:series-1887-1 a chart:Series .

ex:mark-1887-1-1 a chart:DataPoint ;
    chart:series ex:series-1887-1 ;
    chart:category "2019/20*" ;
    chart:value "188"^^xsd:decimal .

ex:mark-1887-1-2 a chart:DataPoint ;
    chart:series ex:series-1887-1 ;
    chart:category "2018/19" ;
    chart:value "180"^^xsd:decimal .

ex:mark-1887-1-3 a chart:DataPoint ;
    chart:series ex:series-1887-1 ;
    chart:category "2017/18" ;
    chart:value "180"^^xsd:decimal .

ex:mark-1887-1-4 a chart:DataPoint ;
    chart:series ex:series-1887-1 ;
    chart:category "2016/17" ;
    chart:value "176"^^xsd:decimal .

ex:mark-1887-1-5 a chart:DataPoint ;
    chart:series ex:series-1887-1 ;
    chart:category "2015/16" ;
    chart:value "170"^^xsd:decimal .

ex:mark-1887-1-6 a chart:DataPoint ;
    chart:series ex:series-1887-1 ;
    chart:category "2014/15" ;
    chart:value "175"^^xsd:decimal .

ex:mark-1887-1-7 a chart:DataPoint ;
    chart:series ex:series-1887-1 ;
    chart:category "2013/14" ;
    chart:value "180"^^xsd:decimal .

ex:mark-1887-1-8 a chart:DataPoint ;
    chart:series ex:series-1887-1 ;
    chart:category "2012/13" ;
    chart:value "176"^^xsd:decimal .

ex:mark-1887-1-9 a chart:DataPoint ;
    chart:series ex:series-1887-1 ;
