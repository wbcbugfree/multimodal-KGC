@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-159 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Revenue of the San Jose Sharks from 2005/06 to 2018/19 (in million U.S. dollars)" ;
    chart:xAxis ex:x-159 ;
    chart:yAxis ex:y-159 .

ex:x-159 a chart:Axis ;
    chart:label "Year" .

ex:y-159 a chart:Axis ;
    chart:label "Revenue in million U" .

ex:series-159-1 a chart:Series .

ex:mark-159-1-1 a chart:DataPoint ;
    chart:series ex:series-159-1 ;
    chart:category "Revenue in million U.S. dollars 2018/19" ;
    chart:value "164"^^xsd:decimal .

