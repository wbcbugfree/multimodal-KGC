@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-90 a chart:Chart ;
    chart:chartType "line" ;
    chart:title "Sales of cut flowers in Canada from 2010 to 2019 (in million Canadian dollars)" ;
    chart:xAxis ex:x-90 ;
    chart:yAxis ex:y-90 .

ex:x-90 a chart:Axis ;
    chart:label "Year" .

ex:y-90 a chart:Axis ;
    chart:label "Sales in million Canadian dollars" .

ex:series-90-1 a chart:Series .

ex:mark-90-1-1 a chart:DataPoint ;
    chart:series ex:series-90-1 ;
    chart:category "Dec" ;
    chart:value "31"^^xsd:decimal .

ex:mark-90-1-2 a chart:DataPoint ;
    chart:series ex:series-90-1 ;
    chart:category "Dec" ;
    chart:value "31"^^xsd:decimal .

