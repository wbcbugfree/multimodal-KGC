@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-6604 a chart:Chart ;
    chart:chartType "area" ;
    chart:title "Direct and total contribution of travel and tourism to GDP from 2006 to 2019 (in billion U.S. dollars)" ;
    chart:xAxis ex:x-6604 ;
    chart:yAxis ex:y-6604 .

ex:x-6604 a chart:Axis ;
    chart:label "Year" .

ex:y-6604 a chart:Axis ;
    chart:label "Total contribution" .

ex:series-6604-1 a chart:Series .

ex:mark-6604-1-1 a chart:DataPoint ;
    chart:series ex:series-6604-1 ;
    chart:category "Dec" ;
    chart:value "31"^^xsd:decimal .

