@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-5065 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Argentina : Ratio of government expenditure to gross domestic product (GDP) from 2014 to 2024" ;
    chart:xAxis ex:x-5065 ;
    chart:yAxis ex:y-5065 .

ex:x-5065 a chart:Axis ;
    chart:label "Ratio of government expenditure to GDP while the y-axis plots Year" .

ex:y-5065 a chart:Axis ;
    chart:label "" .

ex:series-5065-1 a chart:Series .

ex:mark-5065-1-1 a chart:DataPoint ;
    chart:series ex:series-5065-1 ;
    chart:category "of government expenditure to GDP Year" ;
    chart:value "0.3828"^^xsd:decimal .

ex:mark-5065-1-2 a chart:DataPoint ;
    chart:series ex:series-5065-1 ;
    chart:category "2024*" ;
    chart:value "0.3774"^^xsd:decimal .

ex:mark-5065-1-3 a chart:DataPoint ;
    chart:series ex:series-5065-1 ;
    chart:category "2023*" ;
    chart:value "0.3728"^^xsd:decimal .

ex:mark-5065-1-4 a chart:DataPoint ;
    chart:series ex:series-5065-1 ;
    chart:category "2022*" ;
    chart:value "0.3704"^^xsd:decimal .

ex:mark-5065-1-5 a chart:DataPoint ;
    chart:series ex:series-5065-1 ;
    chart:category "2021*" ;
    chart:value "0.3686"^^xsd:decimal .

ex:mark-5065-1-6 a chart:DataPoint ;
    chart:series ex:series-5065-1 ;
    chart:category "2020*" ;
    chart:value "0.3756"^^xsd:decimal .

ex:mark-5065-1-7 a chart:DataPoint ;
    chart:series ex:series-5065-1 ;
    chart:category "2019*" ;
    chart:value "0.389"^^xsd:decimal .
