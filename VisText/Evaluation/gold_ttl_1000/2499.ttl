@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-2499 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Number of road traffic fatalities in Greece from 2006 to 2019" ;
    chart:xAxis ex:x-2499 ;
    chart:yAxis ex:y-2499 .

ex:x-2499 a chart:Axis ;
    chart:label "Year" .

ex:y-2499 a chart:Axis ;
    chart:label "" .

ex:series-2499-1 a chart:Series .

ex:mark-2499-1-1 a chart:DataPoint ;
    chart:series ex:series-2499-1 ;
    chart:category "Number of fatalities 2019*" ;
    chart:value "696"^^xsd:decimal .
