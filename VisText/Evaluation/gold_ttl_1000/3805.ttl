@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-3805 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Investment in travel and tourism in selected countries in the Caribbean in 2017 (in billion U.S. dollars)" ;
    chart:xAxis ex:x-3805 ;
    chart:yAxis ex:y-3805 .

ex:x-3805 a chart:Axis ;
    chart:label "Country" .

ex:y-3805 a chart:Axis ;
    chart:label "Investment in billion U" .

ex:series-3805-1 a chart:Series .

ex:mark-3805-1-1 a chart:DataPoint ;
    chart:series ex:series-3805-1 ;
    chart:category "Investment in billion U.S. dollars Bahamas" ;
    chart:value "0.4"^^xsd:decimal .

