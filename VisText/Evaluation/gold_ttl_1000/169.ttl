@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-169 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Number of people immigrating to Iceland in 2019 , by country of origin" ;
    chart:xAxis ex:x-169 ;
    chart:yAxis ex:y-169 .

ex:x-169 a chart:Axis ;
    chart:label "Number of immigrants while the y-axis shows Country" .

ex:y-169 a chart:Axis ;
    chart:label "Country" .

ex:series-169-1 a chart:Series .

ex:mark-169-1-1 a chart:DataPoint ;
    chart:series ex:series-169-1 ;
    chart:category "Poland" ;
    chart:value "865"^^xsd:decimal .

