@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-5450 a chart:Chart ;
    chart:chartType "line" ;
    chart:title "Number of jobs in the wind energy industry worldwide from 2009 to 2019 (in 1,000s)" ;
    chart:xAxis ex:x-5450 ;
    chart:yAxis ex:y-5450 .

ex:x-5450 a chart:Axis ;
    chart:label "Year" .

ex:y-5450 a chart:Axis ;
    chart:label "Number of jobs in thousands while the x-axis plots Year" .

ex:series-5450-1 a chart:Series .

ex:mark-5450-1-1 a chart:DataPoint ;
    chart:series ex:series-5450-1 ;
    chart:category "Number of jobs in thousands Dec" ;
    chart:value "31"^^xsd:decimal .

ex:mark-5450-1-2 a chart:DataPoint ;
    chart:series ex:series-5450-1 ;
    chart:category "Dec" ;
    chart:value "31"^^xsd:decimal .

