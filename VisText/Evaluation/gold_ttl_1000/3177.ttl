@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-3177 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Stress symptoms during the past month reported by U.S. teeneagers in 2013" ;
    chart:xAxis ex:x-3177 ;
    chart:yAxis ex:y-3177 .

ex:x-3177 a chart:Axis ;
    chart:label "Response" .

ex:y-3177 a chart:Axis ;
    chart:label "" .

ex:series-3177-1 a chart:Series .

ex:mark-3177-1-1 a chart:DataPoint ;
    chart:series ex:series-3177-1 ;
    chart:category "Percentage of respondents Feeling irritable or ang..." ;
    chart:value "0.4"^^xsd:decimal .

ex:mark-3177-1-2 a chart:DataPoint ;
    chart:series ex:series-3177-1 ;
    chart:category "Feeling nervous or anxious" ;
    chart:value "0.36"^^xsd:decimal .

ex:mark-3177-1-3 a chart:DataPoint ;
    chart:series ex:series-3177-1 ;
    chart:category "Fatigue/feeling tired" ;
    chart:value "0.36"^^xsd:decimal .

ex:mark-3177-1-4 a chart:DataPoint ;
    chart:series ex:series-3177-1 ;
    chart:category "Lying awake at night" ;
    chart:value "0.35"^^xsd:decimal .

ex:mark-3177-1-5 a chart:DataPoint ;
    chart:series ex:series-3177-1 ;
    chart:category "Headaches" ;
    chart:value "0.32"^^xsd:decimal .

ex:mark-3177-1-6 a chart:DataPoint ;
    chart:series ex:series-3177-1 ;
    chart:category "Feeling as though I could cry" ;
    chart:value "0.32"^^xsd:decimal .

ex:mark-3177-1-7 a chart:DataPoint ;
    chart:series ex:series-3177-1 ;
    chart:category "Feeling overwhelmed" ;
    chart:value "0.31"^^xsd:decimal .

ex:mark-3177-1-8 a chart:DataPoint ;
    chart:series ex:series-3177-1 ;
    chart:category "Feeling depressed or sad" ;
    chart:value "0.3"^^xsd:decimal .

ex:mark-3177-1-9 a chart:DataPoint ;
    chart:series ex:series-3177-1 ;
    chart:category "Changes in sleeping habits" ;
    chart:value "0.26"^^xsd:decimal .

ex:mark-3177-1-10 a chart:DataPoint ;
    chart:series ex:series-3177-1 ;
    chart:category "Skipping a meal" ;
    chart:value "0.23"^^xsd:decimal .

ex:mark-3177-1-11 a chart:DataPoint ;
    chart:series ex:series-3177-1 ;
    chart:category "Upset stomach or indigestion" ;
    chart:value "0.21"^^xsd:decimal .
