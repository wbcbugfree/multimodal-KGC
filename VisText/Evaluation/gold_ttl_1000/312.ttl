@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-312 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "U.S. states with the biggest share of eBay sellers as of June 2020" ;
    chart:xAxis ex:x-312 ;
    chart:yAxis ex:y-312 .

ex:x-312 a chart:Axis ;
    chart:label "State" .

ex:y-312 a chart:Axis ;
    chart:label "" .

ex:series-312-1 a chart:Series .

ex:mark-312-1-1 a chart:DataPoint ;
    chart:series ex:series-312-1 ;
    chart:category "Percent of U.S. sellers California" ;
    chart:value "0.15"^^xsd:decimal .

ex:mark-312-1-2 a chart:DataPoint ;
    chart:series ex:series-312-1 ;
    chart:category "Florida" ;
    chart:value "0.08"^^xsd:decimal .

ex:mark-312-1-3 a chart:DataPoint ;
    chart:series ex:series-312-1 ;
    chart:category "New York" ;
    chart:value "0.08"^^xsd:decimal .

ex:mark-312-1-4 a chart:DataPoint ;
    chart:series ex:series-312-1 ;
    chart:category "Texas" ;
    chart:value "0.06"^^xsd:decimal .

ex:mark-312-1-5 a chart:DataPoint ;
    chart:series ex:series-312-1 ;
    chart:category "Pennsylvania" ;
    chart:value "0.05"^^xsd:decimal .

ex:mark-312-1-6 a chart:DataPoint ;
    chart:series ex:series-312-1 ;
    chart:category "Illinois" ;
    chart:value "0.04"^^xsd:decimal .

ex:mark-312-1-7 a chart:DataPoint ;
    chart:series ex:series-312-1 ;
    chart:category "New Jersey" ;
    chart:value "0.04"^^xsd:decimal .

ex:mark-312-1-8 a chart:DataPoint ;
    chart:series ex:series-312-1 ;
    chart:category "Ohio" ;
    chart:value "0.04"^^xsd:decimal .

ex:mark-312-1-9 a chart:DataPoint ;
    chart:series ex:series-312-1 ;
    chart:category "Michigan" ;
    chart:value "0.03"^^xsd:decimal .

ex:mark-312-1-10 a chart:DataPoint ;
    chart:series ex:series-312-1 ;
    chart:category "Georgia" ;
    chart:value "0.03"^^xsd:decimal .
