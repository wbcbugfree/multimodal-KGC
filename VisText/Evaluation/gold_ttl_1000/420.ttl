@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-420 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Average consumer price for natural gas in the United States from winter of 2005/06 to winter of 2020/21 (in U.S. dollars per 1,000 cubic feet)" ;
    chart:xAxis ex:x-420 ;
    chart:yAxis ex:y-420 .

ex:x-420 a chart:Axis ;
    chart:label "Price in U" .

ex:y-420 a chart:Axis ;
    chart:label "Year" .

ex:series-420-1 a chart:Series .

ex:mark-420-1-1 a chart:DataPoint ;
    chart:series ex:series-420-1 ;
    chart:category "2020/21**" ;
    chart:value "9.73"^^xsd:decimal .

ex:mark-420-1-2 a chart:DataPoint ;
    chart:series ex:series-420-1 ;
    chart:category "2019/20" ;
    chart:value "9.72"^^xsd:decimal .

