@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-3943 a chart:Chart ;
    chart:chartType "line" ;
    chart:title "Uruguay : Fertility rate from 2008 to 2018" ;
    chart:xAxis ex:x-3943 ;
    chart:yAxis ex:y-3943 .

ex:x-3943 a chart:Axis ;
    chart:label "Year" .

ex:y-3943 a chart:Axis ;
    chart:label "" .

ex:series-3943-1 a chart:Series .

ex:mark-3943-1-1 a chart:DataPoint ;
    chart:series ex:series-3943-1 ;
    chart:category "Number of born children per woman Dec" ;
    chart:value "31"^^xsd:decimal .

