@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-1840 a chart:Chart ;
    chart:chartType "line" ;
    chart:title "Debt of the Ford Motor Company from FY 2007 to FY 2019 (in million U.S. dollars)" ;
    chart:xAxis ex:x-1840 ;
    chart:yAxis ex:y-1840 .

ex:x-1840 a chart:Axis ;
    chart:label "Year" .

ex:y-1840 a chart:Axis ;
    chart:label "" .

ex:series-1840-1 a chart:Series .

ex:mark-1840-1-1 a chart:DataPoint ;
    chart:series ex:series-1840-1 ;
    chart:category "Net income in million U.S. dollars Dec" ;
    chart:value "31"^^xsd:decimal .

