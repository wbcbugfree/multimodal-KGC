@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-413 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "World leaders with the most Twitter followers as of June 2020" ;
    chart:xAxis ex:x-413 ;
    chart:yAxis ex:y-413 .

ex:x-413 a chart:Axis ;
    chart:label "Twitter" .

ex:y-413 a chart:Axis ;
    chart:label "" .

ex:series-413-1 a chart:Series .

ex:mark-413-1-1 a chart:DataPoint ;
    chart:series ex:series-413-1 ;
    chart:category "followers in millions World leader" ;
    chart:value "81.1"^^xsd:decimal .

