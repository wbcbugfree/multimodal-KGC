@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-8715 a chart:Chart ;
    chart:chartType "area" ;
    chart:title "Pfizer 's revenues in global submarkets from 2010 to 2019 (in million U.S. dollars)" ;
    chart:xAxis ex:x-8715 ;
    chart:yAxis ex:y-8715 .

ex:x-8715 a chart:Axis ;
    chart:label "Year" .

ex:y-8715 a chart:Axis ;
    chart:label "Developed Europe while the x-axis shows Year" .

ex:series-8715-1 a chart:Series .

ex:mark-8715-1-1 a chart:DataPoint ;
    chart:series ex:series-8715-1 ;
    chart:category "Developed Europe Dec" ;
    chart:value "31"^^xsd:decimal .

