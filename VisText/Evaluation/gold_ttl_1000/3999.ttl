@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-3999 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Value of gems and jewelry exported from India between financial year 2009 and 2020 (in billion U.S. dollars)" ;
    chart:xAxis ex:x-3999 ;
    chart:yAxis ex:y-3999 .

ex:x-3999 a chart:Axis ;
    chart:label "year" .

ex:y-3999 a chart:Axis ;
    chart:label "" .

ex:series-3999-1 a chart:Series .

ex:mark-3999-1-1 a chart:DataPoint ;
    chart:series ex:series-3999-1 ;
    chart:category "Export value in billion U.S. dollars FY" ;
    chart:value "2020"^^xsd:decimal .

ex:mark-3999-1-2 a chart:DataPoint ;
    chart:series ex:series-3999-1 ;
    chart:category "FY" ;
    chart:value "2019"^^xsd:decimal .

ex:mark-3999-1-3 a chart:DataPoint ;
    chart:series ex:series-3999-1 ;
    chart:category "FY" ;
    chart:value "2018"^^xsd:decimal .

ex:mark-3999-1-4 a chart:DataPoint ;
    chart:series ex:series-3999-1 ;
    chart:category "FY" ;
    chart:value "2017"^^xsd:decimal .

ex:mark-3999-1-5 a chart:DataPoint ;
    chart:series ex:series-3999-1 ;
    chart:category "FY" ;
    chart:value "2016"^^xsd:decimal .

ex:mark-3999-1-6 a chart:DataPoint ;
    chart:series ex:series-3999-1 ;
    chart:category "FY" ;
    chart:value "2015"^^xsd:decimal .

ex:mark-3999-1-7 a chart:DataPoint ;
    chart:series ex:series-3999-1 ;
    chart:category "FY" ;
    chart:value "2014"^^xsd:decimal .

ex:mark-3999-1-8 a chart:DataPoint ;
    chart:series ex:series-3999-1 ;
    chart:category "FY" ;
    chart:value "2013"^^xsd:decimal .

ex:mark-3999-1-9 a chart:DataPoint ;
    chart:series ex:series-3999-1 ;
    chart:category "FY" ;
    chart:value "2012"^^xsd:decimal .

ex:mark-3999-1-10 a chart:DataPoint ;
    chart:series ex:series-3999-1 ;
    chart:category "FY" ;
    chart:value "2011"^^xsd:decimal .

ex:mark-3999-1-11 a chart:DataPoint ;
    chart:series ex:series-3999-1 ;
    chart:category "FY" ;
    chart:value "2010"^^xsd:decimal .

ex:mark-3999-1-12 a chart:DataPoint ;
    chart:series ex:series-3999-1 ;
    chart:category "FY" ;
    chart:value "2009"^^xsd:decimal .
