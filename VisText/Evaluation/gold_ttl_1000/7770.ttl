@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-7770 a chart:Chart ;
    chart:chartType "area" ;
    chart:title "South Africa : Distribution of employment by economic sector from 2010 to 2020" ;
    chart:xAxis ex:x-7770 ;
    chart:yAxis ex:y-7770 .

ex:x-7770 a chart:Axis ;
    chart:label "Year" .

ex:y-7770 a chart:Axis ;
    chart:label "Industry while the x-axis shows Year" .

ex:series-7770-1 a chart:Series .

ex:mark-7770-1-1 a chart:DataPoint ;
    chart:series ex:series-7770-1 ;
    chart:category "Industry Dec" ;
    chart:value "31"^^xsd:decimal .

