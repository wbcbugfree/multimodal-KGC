@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-6019 a chart:Chart ;
    chart:chartType "line" ;
    chart:title "Number of households in Denmark from 2010 to 2020 , by type of household" ;
    chart:xAxis ex:x-6019 ;
    chart:yAxis ex:y-6019 .

ex:x-6019 a chart:Axis ;
    chart:label "Year" .

ex:y-6019 a chart:Axis ;
    chart:label "" .

ex:series-6019-1 a chart:Series .

ex:mark-6019-1-1 a chart:DataPoint ;
    chart:series ex:series-6019-1 ;
    chart:category "Single men Dec" ;
    chart:value "31"^^xsd:decimal .

