@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-2486 a chart:Chart ;
    chart:chartType "area" ;
    chart:title "Internal consumption of travel and tourism in Guatemala from 2010 to 2019 (in billion U.S. dollars)" ;
    chart:xAxis ex:x-2486 ;
