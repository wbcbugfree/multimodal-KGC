@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-2994 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Number of casinos worldwide in 2011 , by region" ;
    chart:xAxis ex:x-2994 ;
    chart:yAxis ex:y-2994 .

ex:x-2994 a chart:Axis ;
    chart:label "Country with categorical scale with Africa" .

ex:y-2994 a chart:Axis ;
    chart:label "Number of casinos" .

ex:series-2994-1 a chart:Series .

ex:mark-2994-1-1 a chart:DataPoint ;
    chart:series ex:series-2994-1 ;
    chart:category "North America" ;
    chart:value "1623"^^xsd:decimal .

