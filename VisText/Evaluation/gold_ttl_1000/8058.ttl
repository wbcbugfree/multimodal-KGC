    chart:series ex:series-8058-1 ;
    chart:category "Qunar" ;
    chart:value "0.031"^^xsd:decimal .

ex:mark-8058-1-6 a chart:DataPoint ;
    chart:series ex:series-8058-1 ;
    chart:category "eLong" ;
    chart:value "0.022"^^xsd:decimal .

