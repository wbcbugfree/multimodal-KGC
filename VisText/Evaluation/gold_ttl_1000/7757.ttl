@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-7757 a chart:Chart ;
    chart:chartType "area" ;
    chart:title "Number of establishments in the music industry in the United States from 2007 to 2017 , by sector" ;
    chart:xAxis ex:x-7757 ;
    chart:yAxis ex:y-7757 .

ex:x-7757 a chart:Axis ;
    chart:label "Year" .

ex:y-7757 a chart:Axis ;
    chart:label "Integrated record production/distribution while the x-axis plots Year" .

ex:series-7757-1 a chart:Series .

ex:mark-7757-1-1 a chart:DataPoint ;
    chart:series ex:series-7757-1 ;
    chart:category "Integrated record production/distribution Dec" ;
    chart:value "31"^^xsd:decimal .

