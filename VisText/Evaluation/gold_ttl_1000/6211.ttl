@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-6211 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Growth in weekly sales of FMCG products due to coronavirus (COVID-19) outbreak in Poland between January and March 2020 , by type of products" ;
    chart:xAxis ex:x-6211 ;
    chart:yAxis ex:y-6211 .

ex:x-6211 a chart:Axis ;
    chart:label "type" .

ex:y-6211 a chart:Axis ;
    chart:label "" .

ex:series-6211-1 a chart:Series .

ex:mark-6211-1-1 a chart:DataPoint ;
    chart:series ex:series-6211-1 ;
    chart:category "of FMCG products Toilet paper W01" ;
    chart:value "0.14"^^xsd:decimal .

ex:mark-6211-1-2 a chart:DataPoint ;
    chart:series ex:series-6211-1 ;
    chart:category "W02" ;
    chart:value "0"^^xsd:decimal .

ex:mark-6211-1-3 a chart:DataPoint ;
    chart:series ex:series-6211-1 ;
    chart:category "W03" ;
    chart:value "0.04"^^xsd:decimal .

ex:mark-6211-1-4 a chart:DataPoint ;
    chart:series ex:series-6211-1 ;
    chart:category "W04" ;
    chart:value "0.12"^^xsd:decimal .

ex:mark-6211-1-5 a chart:DataPoint ;
    chart:series ex:series-6211-1 ;
    chart:category "W05 −0.06 W06" ;
    chart:value "0.06"^^xsd:decimal .

ex:mark-6211-1-6 a chart:DataPoint ;
    chart:series ex:series-6211-1 ;
    chart:category "W07" ;
    chart:value "0.06"^^xsd:decimal .

ex:mark-6211-1-7 a chart:DataPoint ;
    chart:series ex:series-6211-1 ;
    chart:category "W08" ;
    chart:value "0.05"^^xsd:decimal .

ex:mark-6211-1-8 a chart:DataPoint ;
    chart:series ex:series-6211-1 ;
    chart:category "W09" ;
    chart:value "0.24"^^xsd:decimal .

ex:mark-6211-1-9 a chart:DataPoint ;
    chart:series ex:series-6211-1 ;
    chart:category "W10" ;
    chart:value "0.56"^^xsd:decimal .
