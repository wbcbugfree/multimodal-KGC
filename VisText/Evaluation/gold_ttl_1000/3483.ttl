    chart:series ex:series-3483-1 ;
    chart:category "Radio and telecommunications equipment installers ..." ;
    chart:value "25.68"^^xsd:decimal .

ex:mark-3483-1-5 a chart:DataPoint ;
    chart:series ex:series-3483-1 ;
    chart:category "News analysts, reporters and journalists" ;
    chart:value "25.17"^^xsd:decimal .

ex:mark-3483-1-6 a chart:DataPoint ;
    chart:series ex:series-3483-1 ;
    chart:category "Camera operators, television, video and film" ;
    chart:value "22.66"^^xsd:decimal .

ex:mark-3483-1-7 a chart:DataPoint ;
