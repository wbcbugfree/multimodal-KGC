@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-3483 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Median hourly wages of selected occupations in radio and TV broadcasting as of May 2019 (in U.S. dollars)" ;
    chart:xAxis ex:x-3483 ;
    chart:yAxis ex:y-3483 .

ex:x-3483 a chart:Axis ;
    chart:label "Median" .

ex:y-3483 a chart:Axis ;
    chart:label "" .

ex:series-3483-1 a chart:Series .

ex:mark-3483-1-1 a chart:DataPoint ;
    chart:series ex:series-3483-1 ;
    chart:category "hourly wage in U.S. dollars Occupation" ;
    chart:value "52.6"^^xsd:decimal .

ex:mark-3483-1-2 a chart:DataPoint ;
    chart:series ex:series-3483-1 ;
    chart:category "General and operations managers" ;
    chart:value "30.78"^^xsd:decimal .

