@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-4624 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Ratio of government expenditure to gross domestic product (GDP) in the United States from 2015 to 2025" ;
    chart:xAxis ex:x-4624 ;
    chart:yAxis ex:y-4624 .

ex:x-4624 a chart:Axis ;
    chart:label "Year" .

ex:y-4624 a chart:Axis ;
    chart:label "" .

ex:series-4624-1 a chart:Series .

ex:mark-4624-1-1 a chart:DataPoint ;
    chart:series ex:series-4624-1 ;
    chart:category "Ratio of government expenditure to GDP 2025*" ;
    chart:value "0.3591"^^xsd:decimal .

ex:mark-4624-1-2 a chart:DataPoint ;
    chart:series ex:series-4624-1 ;
    chart:category "2024*" ;
    chart:value "0.3569"^^xsd:decimal .

ex:mark-4624-1-3 a chart:DataPoint ;
    chart:series ex:series-4624-1 ;
    chart:category "2023*" ;
    chart:value "0.3586"^^xsd:decimal .

ex:mark-4624-1-4 a chart:DataPoint ;
    chart:series ex:series-4624-1 ;
    chart:category "2022*" ;
    chart:value "0.3652"^^xsd:decimal .

ex:mark-4624-1-5 a chart:DataPoint ;
    chart:series ex:series-4624-1 ;
    chart:category "2021*" ;
    chart:value "0.3745"^^xsd:decimal .

ex:mark-4624-1-6 a chart:DataPoint ;
    chart:series ex:series-4624-1 ;
    chart:category "2020*" ;
    chart:value "0.4719"^^xsd:decimal .
