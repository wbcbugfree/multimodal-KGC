@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-1143 a chart:Chart ;
    chart:chartType "area" ;
    chart:title "Georgia : Infant mortality rate from 2009 to 2019 (in deaths per 1,000 live births)" ;
    chart:xAxis ex:x-1143 ;
    chart:yAxis ex:y-1143 .

ex:x-1143 a chart:Axis ;
    chart:label "Year while the y-axis plots Deaths per 1,000 live births" .

ex:y-1143 a chart:Axis ;
    chart:label "" .

ex:series-1143-1 a chart:Series .

ex:mark-1143-1-1 a chart:DataPoint ;
    chart:series ex:series-1143-1 ;
    chart:category "Deaths per" ;
    chart:value "1000"^^xsd:decimal .

ex:mark-1143-1-2 a chart:DataPoint ;
    chart:series ex:series-1143-1 ;
    chart:category "live births Dec" ;
    chart:value "31"^^xsd:decimal .

