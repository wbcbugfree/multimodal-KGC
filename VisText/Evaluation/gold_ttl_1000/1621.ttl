@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-1621 a chart:Chart ;
    chart:chartType "area" ;
    chart:title "Registered number of bike thefts in Belgium from 2008 to 2019" ;
    chart:xAxis ex:x-1621 ;
    chart:yAxis ex:y-1621 .

ex:x-1621 a chart:Axis ;
    chart:label "Year" .

ex:y-1621 a chart:Axis ;
    chart:label "Number of bike thefts while the x-axis plots Year" .

ex:series-1621-1 a chart:Series .

ex:mark-1621-1-1 a chart:DataPoint ;
    chart:series ex:series-1621-1 ;
    chart:category "Number of bike thefts Dec" ;
    chart:value "31"^^xsd:decimal .

