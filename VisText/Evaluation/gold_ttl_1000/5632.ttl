@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-5632 a chart:Chart ;
    chart:chartType "line" ;
    chart:title "Number of arrivals in tourist accommodation in Lithuania from 2006 to 2018 (in millions)" ;
    chart:xAxis ex:x-5632 ;
    chart:yAxis ex:y-5632 .

ex:x-5632 a chart:Axis ;
    chart:label "Year with linear scale of range 2006 to 2016 while the y-axis shows Number of arrivals in millions" .

ex:y-5632 a chart:Axis ;
    chart:label "Number of arrivals in millions" .

ex:series-5632-1 a chart:Series .

ex:mark-5632-1-1 a chart:DataPoint ;
    chart:series ex:series-5632-1 ;
    chart:category "Dec" ;
    chart:value "31"^^xsd:decimal .

