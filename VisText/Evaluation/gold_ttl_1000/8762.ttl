@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-8762 a chart:Chart ;
    chart:chartType "area" ;
    chart:title "Number of employees at The Cheesecake Factory from 2009 to 2019 , by segment" ;
    chart:xAxis ex:x-8762 ;
    chart:yAxis ex:y-8762 .

ex:x-8762 a chart:Axis ;
    chart:label "Year" .

ex:y-8762 a chart:Axis ;
    chart:label "" .

ex:series-8762-1 a chart:Series .

ex:mark-8762-1-1 a chart:DataPoint ;
    chart:series ex:series-8762-1 ;
    chart:category "Restaurant workers Dec" ;
    chart:value "31"^^xsd:decimal .

