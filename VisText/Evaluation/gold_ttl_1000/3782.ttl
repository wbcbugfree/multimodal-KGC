@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-3782 a chart:Chart ;
    chart:chartType "area" ;
    chart:title "U.S. electric capacity resources for the SERC region during the summer peak period between 1998 and 2010 (in megawatts)" ;
    chart:xAxis ex:x-3782 ;
    chart:yAxis ex:y-3782 .

ex:x-3782 a chart:Axis ;
    chart:label "Year" .

ex:y-3782 a chart:Axis ;
    chart:label "" .

ex:series-3782-1 a chart:Series .

