@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-1550 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Costa Rica : National debt from 2015 to 2025 in relation to gross domestic product (GDP)" ;
    chart:xAxis ex:x-1550 ;
    chart:yAxis ex:y-1550 .

ex:x-1550 a chart:Axis ;
    chart:label "Year" .

ex:y-1550 a chart:Axis ;
    chart:label "National debt in relation to GDP while the x-axis shows Year" .

ex:series-1550-1 a chart:Series .

ex:mark-1550-1-1 a chart:DataPoint ;
    chart:series ex:series-1550-1 ;
    chart:category "National debt in relation to GDP 2025*" ;
    chart:value "0.7416"^^xsd:decimal .

ex:mark-1550-1-2 a chart:DataPoint ;
    chart:series ex:series-1550-1 ;
    chart:category "2024*" ;
    chart:value "0.7631"^^xsd:decimal .

ex:mark-1550-1-3 a chart:DataPoint ;
    chart:series ex:series-1550-1 ;
    chart:category "2023*" ;
    chart:value "0.7717"^^xsd:decimal .

ex:mark-1550-1-4 a chart:DataPoint ;
    chart:series ex:series-1550-1 ;
    chart:category "2022*" ;
    chart:value "0.7676"^^xsd:decimal .

ex:mark-1550-1-5 a chart:DataPoint ;
    chart:series ex:series-1550-1 ;
    chart:category "2021*" ;
    chart:value "0.7476"^^xsd:decimal .

ex:mark-1550-1-6 a chart:DataPoint ;
    chart:series ex:series-1550-1 ;
    chart:category "2020*" ;
    chart:value "0.7005"^^xsd:decimal .
