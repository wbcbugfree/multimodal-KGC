@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-3445 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Romania : Budget balance between 2015 to 2025 in relation to GDP" ;
    chart:xAxis ex:x-3445 ;
    chart:yAxis ex:y-3445 .

ex:x-3445 a chart:Axis ;
    chart:label "Budget balance in relation to GDP" .

ex:y-3445 a chart:Axis ;
    chart:label "Year" .

ex:series-3445-1 a chart:Series .

ex:mark-3445-1-1 a chart:DataPoint ;
    chart:series ex:series-3445-1 ;
    chart:category "−0.0705 2025* −0.0744 2024* −0.0772 2023* −0.0806 ..." ;
    chart:value "2019"^^xsd:decimal .

ex:mark-3445-1-2 a chart:DataPoint ;
    chart:series ex:series-3445-1 ;
    chart:category "−0.0282" ;
    chart:value "2018"^^xsd:decimal .

ex:mark-3445-1-3 a chart:DataPoint ;
    chart:series ex:series-3445-1 ;
    chart:category "−0.0283" ;
    chart:value "2017"^^xsd:decimal .

ex:mark-3445-1-4 a chart:DataPoint ;
    chart:series ex:series-3445-1 ;
    chart:category "−0.0239" ;
    chart:value "2016"^^xsd:decimal .

ex:mark-3445-1-5 a chart:DataPoint ;
    chart:series ex:series-3445-1 ;
    chart:category "−0.0135" ;
    chart:value "2015"^^xsd:decimal .
