@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-3607 a chart:Chart ;
    chart:chartType "area" ;
    chart:title "External debt as percentage of gross domestic product in Haiti from 2000 to 2018" ;
    chart:xAxis ex:x-3607 ;
    chart:yAxis ex:y-3607 .

ex:x-3607 a chart:Axis ;
    chart:label "Year with linear scale from 2000 to 2015" .

ex:y-3607 a chart:Axis ;
    chart:label "Foreign debt" .

ex:series-3607-1 a chart:Series .

ex:mark-3607-1-1 a chart:DataPoint ;
    chart:series ex:series-3607-1 ;
    chart:category "as share of GDP Dec" ;
    chart:value "31"^^xsd:decimal .

