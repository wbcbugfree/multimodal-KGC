@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-2755 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Value of newsprint imported into India from financial year 2011 to 2019 , with an estimate for 2020 (in billion Indian rupees)" ;
    chart:xAxis ex:x-2755 ;
    chart:yAxis ex:y-2755 .

ex:x-2755 a chart:Axis ;
    chart:label "Import value in billion Indian rupees while the y-axis measures Year" .

ex:y-2755 a chart:Axis ;
    chart:label "Year" .

ex:series-2755-1 a chart:Series .

ex:mark-2755-1-1 a chart:DataPoint ;
    chart:series ex:series-2755-1 ;
    chart:category "FY" ;
    chart:value "2020"^^xsd:decimal .

ex:mark-2755-1-2 a chart:DataPoint ;
    chart:series ex:series-2755-1 ;
    chart:category "FY" ;
    chart:value "2019"^^xsd:decimal .

ex:mark-2755-1-3 a chart:DataPoint ;
    chart:series ex:series-2755-1 ;
    chart:category "FY" ;
    chart:value "2018"^^xsd:decimal .

ex:mark-2755-1-4 a chart:DataPoint ;
    chart:series ex:series-2755-1 ;
    chart:category "FY" ;
    chart:value "2017"^^xsd:decimal .

ex:mark-2755-1-5 a chart:DataPoint ;
    chart:series ex:series-2755-1 ;
    chart:category "FY" ;
    chart:value "2016"^^xsd:decimal .

ex:mark-2755-1-6 a chart:DataPoint ;
    chart:series ex:series-2755-1 ;
    chart:category "FY" ;
    chart:value "2015"^^xsd:decimal .

ex:mark-2755-1-7 a chart:DataPoint ;
    chart:series ex:series-2755-1 ;
    chart:category "FY" ;
    chart:value "2014"^^xsd:decimal .

ex:mark-2755-1-8 a chart:DataPoint ;
    chart:series ex:series-2755-1 ;
    chart:category "FY" ;
    chart:value "2013"^^xsd:decimal .

ex:mark-2755-1-9 a chart:DataPoint ;
    chart:series ex:series-2755-1 ;
    chart:category "FY" ;
    chart:value "2012"^^xsd:decimal .

ex:mark-2755-1-10 a chart:DataPoint ;
    chart:series ex:series-2755-1 ;
    chart:category "FY" ;
    chart:value "2011"^^xsd:decimal .
