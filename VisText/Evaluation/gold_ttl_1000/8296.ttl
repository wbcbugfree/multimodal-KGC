@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-8296 a chart:Chart ;
    chart:chartType "area" ;
    chart:title "Number of Facebook fans/twitter followers of the Houston Texans (NFL) from 2012 to 2020 (in millions)" ;
