@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-1358 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Israel : Total population from 2015 to 2025 (in million inhabitants)" ;
    chart:xAxis ex:x-1358 ;
    chart:yAxis ex:y-1358 .

ex:x-1358 a chart:Axis ;
    chart:label "Inhabitants" .

ex:y-1358 a chart:Axis ;
    chart:label "" .

ex:series-1358-1 a chart:Series .

ex:mark-1358-1-1 a chart:DataPoint ;
    chart:series ex:series-1358-1 ;
    chart:category "in millions Year" ;
    chart:value "10.15"^^xsd:decimal .

ex:mark-1358-1-2 a chart:DataPoint ;
    chart:series ex:series-1358-1 ;
    chart:category "2025*" ;
    chart:value "9.96"^^xsd:decimal .

ex:mark-1358-1-3 a chart:DataPoint ;
    chart:series ex:series-1358-1 ;
    chart:category "2024*" ;
    chart:value "9.77"^^xsd:decimal .

ex:mark-1358-1-4 a chart:DataPoint ;
    chart:series ex:series-1358-1 ;
    chart:category "2023*" ;
    chart:value "9.59"^^xsd:decimal .

ex:mark-1358-1-5 a chart:DataPoint ;
    chart:series ex:series-1358-1 ;
    chart:category "2022*" ;
    chart:value "9.4"^^xsd:decimal .

ex:mark-1358-1-6 a chart:DataPoint ;
    chart:series ex:series-1358-1 ;
    chart:category "2021*" ;
    chart:value "9.23"^^xsd:decimal .

ex:mark-1358-1-7 a chart:DataPoint ;
    chart:series ex:series-1358-1 ;
    chart:category "2020*" ;
    chart:value "9.05"^^xsd:decimal .
