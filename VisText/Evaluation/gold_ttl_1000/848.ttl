@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-848 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Top digital health deals worldwide based on invested funding in 2019 , by receiving company (in million U.S. dollars)" ;
    chart:xAxis ex:x-848 ;
    chart:yAxis ex:y-848 .

ex:x-848 a chart:Axis ;
    chart:label "Company (subsector)" .

ex:y-848 a chart:Axis ;
    chart:label "Received funding in million U" .

ex:series-848-1 a chart:Series .

ex:mark-848-1-1 a chart:DataPoint ;
    chart:series ex:series-848-1 ;
    chart:category "(subsector) Received funding in million U.S. dolla..." ;
    chart:value "635"^^xsd:decimal .

