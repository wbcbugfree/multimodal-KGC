@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-297 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Natural gas prices for households in the Netherlands from 2010 to 2018 , semi-annually (in euro cents per kilowatt-hour)" ;
    chart:xAxis ex:x-297 ;
    chart:yAxis ex:y-297 .

ex:x-297 a chart:Axis ;
    chart:label "Year" .

ex:y-297 a chart:Axis ;
    chart:label "Euro cents per kilowatt-hour" .

ex:series-297-1 a chart:Series .

ex:mark-297-1-1 a chart:DataPoint ;
    chart:series ex:series-297-1 ;
    chart:category "S2" ;
    chart:value "8.6"^^xsd:decimal .

