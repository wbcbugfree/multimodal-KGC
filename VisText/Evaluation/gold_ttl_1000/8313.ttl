@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-8313 a chart:Chart ;
    chart:chartType "area" ;
    chart:title "Percentage of people who identify with a political party in Great Britain (GB) from 1997 to 2012 , by party" ;
    chart:xAxis ex:x-8313 ;
    chart:yAxis ex:y-8313 .

ex:x-8313 a chart:Axis ;
    chart:label "Year" .

ex:y-8313 a chart:Axis ;
    chart:label "" .

