@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-3946 a chart:Chart ;
    chart:chartType "area" ;
    chart:title "Average length of haul for all heavy goods vehicles in the United Kingdom between 1990 and 2016 (in kilometres)" ;
    chart:xAxis ex:x-3946 ;
    chart:yAxis ex:y-3946 .

ex:x-3946 a chart:Axis ;
    chart:label "Year" .

ex:y-3946 a chart:Axis ;
    chart:label "" .

