@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-6197 a chart:Chart ;
    chart:chartType "line" ;
    chart:title "Sri Lanka : Age structure from 2009 to 2019" ;
    chart:xAxis ex:x-6197 ;
    chart:yAxis ex:y-6197 .

ex:x-6197 a chart:Axis ;
    chart:label "Year" .

ex:y-6197 a chart:Axis ;
    chart:label "" .

ex:series-6197-1 a chart:Series .

ex:mark-6197-1-1 a chart:DataPoint ;
    chart:series ex:series-6197-1 ;
    chart:category "years and older Dec" ;
    chart:value "31"^^xsd:decimal .

