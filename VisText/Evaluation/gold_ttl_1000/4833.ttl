@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-4833 a chart:Chart ;
    chart:chartType "line" ;
    chart:title "Annual revenue of Yandex from 2007 to 2019 (in billion Russian rubles)" ;
    chart:xAxis ex:x-4833 ;
    chart:yAxis ex:y-4833 .

ex:x-4833 a chart:Axis ;
    chart:label "Year" .

