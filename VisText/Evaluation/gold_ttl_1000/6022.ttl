@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-6022 a chart:Chart ;
    chart:chartType "line" ;
    chart:title "Are people born gay or lesbian or does this develop due to upbringing and environmental factors ?" ;
    chart:xAxis ex:x-6022 ;
    chart:yAxis ex:y-6022 .

ex:x-6022 a chart:Axis ;
    chart:label "Response" .

ex:y-6022 a chart:Axis ;
    chart:label "Upbringing/environment" .

ex:series-6022-1 a chart:Series .

ex:mark-6022-1-1 a chart:DataPoint ;
    chart:series ex:series-6022-1 ;
    chart:category "Dec" ;
