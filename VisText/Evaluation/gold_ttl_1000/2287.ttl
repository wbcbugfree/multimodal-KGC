@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-2287 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Gay and Lesbian Americans : Who lives in your household ?" ;
    chart:xAxis ex:x-2287 ;
    chart:yAxis ex:y-2287 .

ex:x-2287 a chart:Axis ;
    chart:label "Response" .

ex:y-2287 a chart:Axis ;
    chart:label "" .

ex:series-2287-1 a chart:Series .

ex:mark-2287-1-1 a chart:DataPoint ;
    chart:series ex:series-2287-1 ;
    chart:category "Share of respondents I live with a spouse, partner..." ;
    chart:value "0.463"^^xsd:decimal .

ex:mark-2287-1-2 a chart:DataPoint ;
    chart:series ex:series-2287-1 ;
    chart:category "I live alone" ;
    chart:value "0.293"^^xsd:decimal .

ex:mark-2287-1-3 a chart:DataPoint ;
    chart:series ex:series-2287-1 ;
    chart:category "I live with a dog" ;
    chart:value "0.273"^^xsd:decimal .

ex:mark-2287-1-4 a chart:DataPoint ;
    chart:series ex:series-2287-1 ;
    chart:category "I live with a cat" ;
    chart:value "0.232"^^xsd:decimal .

ex:mark-2287-1-5 a chart:DataPoint ;
    chart:series ex:series-2287-1 ;
    chart:category "I live with one or more roommates" ;
    chart:value "0.123"^^xsd:decimal .

ex:mark-2287-1-6 a chart:DataPoint ;
    chart:series ex:series-2287-1 ;
    chart:category "I live with one or more parents" ;
    chart:value "0.066"^^xsd:decimal .

ex:mark-2287-1-7 a chart:DataPoint ;
    chart:series ex:series-2287-1 ;
    chart:category "I live with one or more child(ren) under" ;
    chart:value "18"^^xsd:decimal .

ex:mark-2287-1-8 a chart:DataPoint ;
    chart:series ex:series-2287-1 ;
    chart:category "I live with another type of pet (not dog or cat)" ;
    chart:value "0.063"^^xsd:decimal .

ex:mark-2287-1-9 a chart:DataPoint ;
    chart:series ex:series-2287-1 ;
    chart:category "I live with one or more brother(s) or sister(s)" ;
    chart:value "0.029"^^xsd:decimal .

ex:mark-2287-1-10 a chart:DataPoint ;
    chart:series ex:series-2287-1 ;
    chart:category "I live with one or more child(ren) over" ;
    chart:value "18"^^xsd:decimal .
