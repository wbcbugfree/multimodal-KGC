@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-1835 a chart:Chart ;
    chart:chartType "line" ;
    chart:title "Forecast of the number of single-parent households in the Netherlands from 2019 to 2060" ;
    chart:xAxis ex:x-1835 ;
    chart:yAxis ex:y-1835 .

ex:x-1835 a chart:Axis ;
    chart:label "Year with linear scale of range 2020 to 2050" .

ex:y-1835 a chart:Axis ;
    chart:label "Number of households" .

ex:series-1835-1 a chart:Series .

ex:mark-1835-1-1 a chart:DataPoint ;
    chart:series ex:series-1835-1 ;
    chart:category "Dec" ;
    chart:value "31"^^xsd:decimal .

