@prefix :    <http://example.org/chart-data> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

:chart-22 a chart:Chart ;
    chart:chartType "area" ;
    chart:title "Number of hospitals in Germany from 2000 to 2017" ;
    chart:xAxis :x-22 ;
    chart:yAxis :y-22 .

:x-22 a chart:Axis ;
    chart:label "Year" .

:y-22 a chart:Axis ;
    chart:label "Number of hospitals" .

:DataPoint1 a chart:DataPoint ;
    chart:xValue "Dec 31, 1999" ;
    chart:yValue "3635" ;
    chart:belongsTo :chart-22 .

