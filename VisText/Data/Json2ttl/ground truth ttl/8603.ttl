@prefix : <http://example.org/chart-data/8603/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <https://schema.org/> .

:Chart1 a schema:BarChart ;
    schema:title "Impact of coronavirus (COVID-19) on monthly retail sales development in the United States 2020 , by retail sector" ;
    :hasXAxisLabel "July" ;
    :hasYAxisLabel "y" .

:DataPoint1 a :July ;
    rdfs:label "Building material & garden equipmen..." ;
    :y "0.008"^^xsd:decimal ;
    :belongsToChart :Chart1 .

:DataPoint2 a :July ;
    rdfs:label "Clothing & clothing accessories sto..." ;
    :y "0"^^xsd:decimal ;
    :belongsToChart :Chart1 .

:DataPoint3 a :July ;
    rdfs:label "Electronics & appliance stores" ;
    :y "0.02"^^xsd:decimal ;
    :belongsToChart :Chart1 .

:DataPoint4 a :July ;
    rdfs:label "Furniture & home furniture stores" ;
    :y "0.008"^^xsd:decimal ;
    :belongsToChart :Chart1 .

:DataPoint5 a :July ;
    rdfs:label "Gasoline stations" ;
    :y "0.029"^^xsd:decimal ;
    :belongsToChart :Chart1 .

:DataPoint6 a :July ;
    rdfs:label "Health & personal care stores" ;
    :y "0.004"^^xsd:decimal ;
    :belongsToChart :Chart1 .

:DataPoint7 a :July ;
    rdfs:label "Motor vehicle & parts dealers" ;
    :y "0.021"^^xsd:decimal ;
    :belongsToChart :Chart1 .

:DataPoint8 a :July ;
    rdfs:label "Nonstore retailers" ;
    :y "0.006"^^xsd:decimal ;
    :belongsToChart :Chart1 .

:DataPoint9 a :July ;
    rdfs:label "to August retail sector" ;
    :y "0.002"^^xsd:decimal ;
    :belongsToChart :Chart1 .
