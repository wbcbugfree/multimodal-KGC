@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Impact of coronavirus (COVID-19) on monthly retail sales development in the United States 2020 , by retail sector" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "July to August" .

:YAxis a :Axis ;
    :title "retail sector" .

:DataPoint1 a :DataPoint ;
    :xValue "0.002" ;
    :yValue "Motor vehicle & parts dealers" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "0.021" ;
    :yValue "Furniture & home furniture stores" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "0.008" ;
    :yValue "Electronics & appliance stores" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "0.02" ;
    :yValue "Building material & garden equipment & supplies de..." ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "-0.012" ;
    :yValue "Food & beverage stores" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "0.008" ;
    :yValue "Health & personal care stores" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "0.004" ;
    :yValue "Gasoline stations" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "0.029" ;
    :yValue "Clothing & clothing accessories stores" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "-0.057" ;
    :yValue "Sporting goods, hobby, musical instrument, & book ..." ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "-0.004" ;
    :yValue "General merchandise stores" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "-0.002" ;
    :yValue "Miscellaneous store retailers" ;
    :belongsTo :Chart .

:DataPoint12 a :DataPoint ;
    :xValue "0" ;
    :yValue "Nonstore retailers" ;
    :belongsTo :Chart .

:DataPoint13 a :DataPoint ;
    :xValue "0.006" ;
    :yValue "Total retail" ;
    :belongsTo :Chart .
