@prefix : <http://example.org/chart-data/5709/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <https://schema.org/> .

:Chart1 a schema:LineChart ;
    schema:title "Number of U.S. air strikes in Pakistan from 2004 to 2018" ;
    :hasXAxisLabel "Year" ;
    :hasYAxisLabel "Number of air strikes" .

:DataPoint1 a :Year ;
    rdfs:label "Dec" ;
    :numberOfAirStrikes "31"^^xsd:decimal ;
    :belongsToChart :Chart1 .

