@prefix : <http://example.org/chart-data/8704/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <https://schema.org/> .

:Chart1 a schema:LineChart ;
    schema:title "Population in Norway from 2010 to 2020 , by age group (in millions)" ;
    :hasXAxisLabel "Year" ;
    :hasYAxisLabel "35-44 years" .

:DataPoint1 a :Year ;
    rdfs:label "Dec" ;
    :3544Years "31"^^xsd:decimal ;
    :belongsToChart :Chart1 .

