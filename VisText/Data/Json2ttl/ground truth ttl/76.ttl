@prefix : <http://example.org/chart-data/76/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <https://schema.org/> .

:Chart1 a schema:BarChart ;
    schema:title "Non-English main home languages ranked by number of speakers in Welsh schools in 2020" ;
    :hasXAxisLabel "geographic" ;
    :hasYAxisLabel "y" .

:DataPoint1 a :Geographic ;
    rdfs:label "Arabic" ;
    :y "3484"^^xsd:decimal ;
    :belongsToChart :Chart1 .

:DataPoint2 a :Geographic ;
    rdfs:label "Bengali" ;
    :y "3019"^^xsd:decimal ;
    :belongsToChart :Chart1 .

:DataPoint3 a :Geographic ;
    rdfs:label "Chinese" ;
    :y "1466"^^xsd:decimal ;
    :belongsToChart :Chart1 .

:DataPoint4 a :Geographic ;
    rdfs:label "Panjabi" ;
    :y "1242"^^xsd:decimal ;
    :belongsToChart :Chart1 .

:DataPoint5 a :Geographic ;
    rdfs:label "Portuguese" ;
    :y "846"^^xsd:decimal ;
    :belongsToChart :Chart1 .

:DataPoint6 a :Geographic ;
    rdfs:label "region Number of speakers Polish" ;
    :y "4961"^^xsd:decimal ;
    :belongsToChart :Chart1 .

:DataPoint7 a :Geographic ;
    rdfs:label "Romanian" ;
    :y "1091"^^xsd:decimal ;
    :belongsToChart :Chart1 .

:DataPoint8 a :Geographic ;
    rdfs:label "Somali" ;
    :y "852"^^xsd:decimal ;
    :belongsToChart :Chart1 .

:DataPoint9 a :Geographic ;
    rdfs:label "Tagalog/Filipino" ;
    :y "830"^^xsd:decimal ;
    :belongsToChart :Chart1 .

:DataPoint10 a :Geographic ;
    rdfs:label "Urdu" ;
    :y "1508"^^xsd:decimal ;
    :belongsToChart :Chart1 .
