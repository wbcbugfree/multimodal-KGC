@prefix : <http://example.org/chart-data/8313/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <https://schema.org/> .

:Chart1 a schema:BarChart ;
    schema:title "Percentage of people who identify with a political party in Great Britain (GB) from 1997 to 2012 , by party" ;
    :hasXAxisLabel "Year" ;
    :hasYAxisLabel "y" .

:DataPoint1 a :Year ;
    rdfs:label "Conservative Dec" ;
    :y "31"^^xsd:decimal ;
    :belongsToChart :Chart1 .

