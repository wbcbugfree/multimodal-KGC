@prefix : <http://example.org/chart-data/867/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <https://schema.org/> .

:Chart1 a schema:LineChart ;
    schema:title "Number of participants in roller hockey in the United States from 2006 to 2017 (in millions)" ;
    :hasXAxisLabel "Year" ;
    :hasYAxisLabel "y" .

:DataPoint1 a :Year ;
    rdfs:label "Dec" ;
    :y "31"^^xsd:decimal ;
    :belongsToChart :Chart1 .

