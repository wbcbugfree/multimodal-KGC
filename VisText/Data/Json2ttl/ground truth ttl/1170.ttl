    rdfs:label "Honor/tribute gift" ;
    :y "0.32"^^xsd:decimal ;
    :belongsToChart :Chart1 .

:DataPoint5 a :Share ;
    rdfs:label "Mailed check/credit card*" ;
    :y "0.25"^^xsd:decimal ;
    :belongsToChart :Chart1 .

:DataPoint6 a :Share ;
    rdfs:label "Mobile text" ;
    :y "0.06"^^xsd:decimal ;
    :belongsToChart :Chart1 .

:DataPoint7 a :Share ;
    rdfs:label "of respondents Channel" ;
    :y "0.5"^^xsd:decimal ;
    :belongsToChart :Chart1 .

:DataPoint8 a :Share ;
    rdfs:label "Online ad*" ;
    :y "0.05"^^xsd:decimal ;
    :belongsToChart :Chart1 .

:DataPoint9 a :Share ;
    rdfs:label "Online donation" ;
    :y "0.35"^^xsd:decimal ;
    :belongsToChart :Chart1 .

:DataPoint10 a :Share ;
    rdfs:label "Phone" ;
    :y "0.08"^^xsd:decimal ;
    :belongsToChart :Chart1 .

:DataPoint11 a :Share ;
    rdfs:label "Pledge" ;
    :y "0.32"^^xsd:decimal ;
    :belongsToChart :Chart1 .

:DataPoint12 a :Share ;
    rdfs:label "Purchase of proceeds" ;
    :y "0.39"^^xsd:decimal ;
    :belongsToChart :Chart1 .

:DataPoint13 a :Share ;
    rdfs:label "Radio/TV*" ;
    :y "0.02"^^xsd:decimal ;
    :belongsToChart :Chart1 .

:DataPoint14 a :Share ;
    rdfs:label "Social netowrking site" ;
    :y "0.06"^^xsd:decimal ;
