@prefix : <http://example.org/chart-data/1170/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <https://schema.org/> .

:Chart1 a schema:BarChart ;
    schema:title "Donations made to charity in the U.S. from 2011 to 2013 , by channel used" ;
    :hasXAxisLabel "Share" ;
    :hasYAxisLabel "y" .

:DataPoint1 a :Share ;
    rdfs:label "Checkout donations" ;
    :y "0.4"^^xsd:decimal ;
    :belongsToChart :Chart1 .

:DataPoint2 a :Share ;
    rdfs:label "Door to door*" ;
    :y "0.08"^^xsd:decimal ;
    :belongsToChart :Chart1 .

