@prefix : <http://example.org/chart-data/7163/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <https://schema.org/> .

:Chart1 a schema:BarChart ;
    schema:title "Proportion of young people reading various media outside of class in the United Kingdom (UK) from 2014 to 2019" ;
    :hasXAxisLabel "media read by young people" ;
    :hasYAxisLabel "2017/18" .

:DataPoint1 a :MediaReadByYoungPeople ;
    rdfs:label "Comics" ;
    :201718 "0.399"^^xsd:decimal ;
    :belongsToChart :Chart1 .

