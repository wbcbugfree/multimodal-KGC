@prefix : <http://example.org/chart-data/7270/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <https://schema.org/> .

:Chart1 a schema:LineChart ;
    schema:title "Swaziland : Distribution of gross domestic product (GDP) across economic sectors from 2009 to 2019" ;
    :hasXAxisLabel "Year" ;
    :hasYAxisLabel "y" .

:DataPoint1 a :Year ;
    rdfs:label "Agriculture Dec" ;
    :y "31"^^xsd:decimal ;
    :belongsToChart :Chart1 .

