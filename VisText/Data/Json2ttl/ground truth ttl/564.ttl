@prefix : <http://example.org/chart-data/564/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <https://schema.org/> .

:Chart1 a schema:BarChart ;
    schema:title "Operating profit of the Roche Group from 2007 to 2019 (in million Swiss francs)" ;
    :hasXAxisLabel "Year" ;
    :hasYAxisLabel "y" .

:DataPoint1 a :Year ;
    rdfs:label "Dec" ;
    :y "31"^^xsd:decimal ;
    :belongsToChart :Chart1 .

