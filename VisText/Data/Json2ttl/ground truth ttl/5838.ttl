@prefix : <http://example.org/chart-data/5838/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <https://schema.org/> .

:Chart1 a schema:LineChart ;
    schema:title "Auction price of tea per kilogram in Kenya from January 2019 to September 2020 (in U.S. dollars)" ;
    :hasXAxisLabel "Month" ;
    :hasYAxisLabel "y" .

:DataPoint1 a :Month ;
    rdfs:label "Apr" ;
    :y "30"^^xsd:decimal ;
    :belongsToChart :Chart1 .

