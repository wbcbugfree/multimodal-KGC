@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "South Africa : National debt in relation to gross domestic product (GDP) from 2015 to 2025" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "National debt in relation to GDP" .

:YAxis a :Axis ;
    :title "Year" .

:DataPoint1 a :DataPoint ;
    :xValue "0.8517" ;
    :yValue "2025*" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "0.8692" ;
    :yValue "2024*" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "0.8728" ;
    :yValue "2023*" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "0.8568" ;
    :yValue "2022*" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "0.8276" ;
    :yValue "2021*" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "0.7882" ;
    :yValue "2020*" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "0.6215" ;
    :yValue "2019" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "0.5671" ;
    :yValue "2018" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "0.5302" ;
    :yValue "2017" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "0.5147" ;
    :yValue "2016" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "0.4934" ;
    :yValue "2015" ;
    :belongsTo :Chart .
