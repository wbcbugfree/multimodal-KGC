@prefix : <http://example.org/chart-data/5995/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <https://schema.org/> .

:Chart1 a schema:BarChart ;
    schema:title "Share of American women who have given oral sex to a female in their lifetime , by age group" ;
    :hasXAxisLabel "Age" ;
    :hasYAxisLabel "y" .

:DataPoint1 a :Age ;
    rdfs:label "16-17" ;
    :y "0.09"^^xsd:decimal ;
    :belongsToChart :Chart1 .

:DataPoint2 a :Age ;
    rdfs:label "18-19" ;
    :y "0.08"^^xsd:decimal ;
    :belongsToChart :Chart1 .

:DataPoint3 a :Age ;
    rdfs:label "20-24" ;
    :y "0.14"^^xsd:decimal ;
    :belongsToChart :Chart1 .

:DataPoint4 a :Age ;
    rdfs:label "25-29" ;
    :y "0.1"^^xsd:decimal ;
    :belongsToChart :Chart1 .

:DataPoint5 a :Age ;
    rdfs:label "30-39" ;
    :y "0.14"^^xsd:decimal ;
    :belongsToChart :Chart1 .

:DataPoint6 a :Age ;
    rdfs:label "40-49" ;
    :y "0.12"^^xsd:decimal ;
    :belongsToChart :Chart1 .

:DataPoint7 a :Age ;
    rdfs:label "50-59" ;
    :y "0.07"^^xsd:decimal ;
    :belongsToChart :Chart1 .

:DataPoint8 a :Age ;
    rdfs:label "60-69" ;
    :y "0.03"^^xsd:decimal ;
    :belongsToChart :Chart1 .

:DataPoint9 a :Age ;
    rdfs:label "and older" ;
    :y "0.02"^^xsd:decimal ;
    :belongsToChart :Chart1 .

:DataPoint10 a :Age ;
    rdfs:label "group Share of respondents 14-15" ;
    :y "0.054"^^xsd:decimal ;
    :belongsToChart :Chart1 .
