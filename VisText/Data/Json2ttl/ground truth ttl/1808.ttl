@prefix : <http://example.org/chart-data/1808/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <https://schema.org/> .

:Chart1 a schema:BarChart ;
    schema:title "Degree of internet freedom in Middle East and North Africa...o the Freedom House Index 2019 , by country (index points)" ;
    :hasXAxisLabel "Country" ;
    :hasYAxisLabel "y" .

:DataPoint1 a :Country ;
    rdfs:label "Bahrain" ;
    :y "29"^^xsd:decimal ;
    :belongsToChart :Chart1 .

