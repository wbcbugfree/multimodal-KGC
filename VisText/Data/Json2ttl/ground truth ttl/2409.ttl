@prefix : <http://example.org/chart-data/2409/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <https://schema.org/> .

:Chart1 a schema:BarChart ;
    schema:title "Most trusted institutions to tell the truth about the coronavirus (COVID-19) in Brazil in March 2020" ;
    :hasXAxisLabel "Share" ;
    :hasYAxisLabel "y" .

:DataPoint1 a :Share ;
    rdfs:label "A person like yourself" ;
    :y "0.74"^^xsd:decimal ;
    :belongsToChart :Chart1 .

:DataPoint2 a :Share ;
    rdfs:label "Countries most affected" ;
    :y "0.64"^^xsd:decimal ;
    :belongsToChart :Chart1 .

