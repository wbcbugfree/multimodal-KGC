@prefix : <http://example.org/chart-data/957/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <https://schema.org/> .

:Chart1 a schema:LineChart ;
    schema:title "Number of reported motor vehicle theft cases in the United States from 1990 to 2019" ;
    :hasXAxisLabel "Year" ;
    :hasYAxisLabel "y" .

:DataPoint1 a :Year ;
    rdfs:label "Dec" ;
    :y "31"^^xsd:decimal ;
    :belongsToChart :Chart1 .

