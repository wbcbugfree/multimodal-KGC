@prefix : <http://example.org/> .

:Chart a :AreaChart ;
    :title "Number of road traffic fatalities in Switzerland from 2006 to 2019" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Number of fatalities" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2005" ;
    :yValue "370" ;
    :belongsTo :Chart .

