    :belongsToChart :Chart1 .

:DataPoint6 a :Response ;
    rdfs:label "Music merchandise items" ;
    :y "0.34"^^xsd:decimal ;
    :belongsToChart :Chart1 .

:DataPoint7 a :Response ;
    rdfs:label "Music streaming subscription gift c..." ;
