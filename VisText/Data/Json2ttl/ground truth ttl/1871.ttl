@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Number of overnight stays in travel accommodation in Croatia between 2007 and 2019 (in millions)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Number of nights in millions" .

:DataPoint1 a :DataPoint ;
    :xValue "2019" ;
    :yValue "91.18" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "2018" ;
    :yValue "89.57" ;
    :belongsTo :Chart .

