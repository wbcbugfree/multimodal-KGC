@prefix : <http://example.org/chart-data/3957/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <https://schema.org/> .

:Chart1 a schema:LineChart ;
    schema:title "Total number of farms in Denmark from 2010 to 2019" ;
    :hasXAxisLabel "Year is measured" ;
    :hasYAxisLabel "y" .

:DataPoint1 a :YearIsMeasured ;
    rdfs:label "Dec" ;
    :y "31"^^xsd:decimal ;
    :belongsToChart :Chart1 .

