@prefix : <http://example.org/chart-data/8541/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <https://schema.org/> .

:Chart1 a schema:LineChart ;
    schema:title "Global box office revenue from 2004 to 2019 , by region (in billion U.S. dollars)" ;
    :hasXAxisLabel "Year" ;
    :hasYAxisLabel "y" .

