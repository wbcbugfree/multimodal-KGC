@prefix : <http://example.org/chart-data/5198/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <https://schema.org/> .

:Chart1 a schema:LineChart ;
    schema:title "Per capita consumption of oat products in the United States from 2000 to 2018 (in pounds)" ;
    :hasXAxisLabel "Year" ;
    :hasYAxisLabel "y" .

