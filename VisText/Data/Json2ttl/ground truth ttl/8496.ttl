@prefix : <http://example.org/chart-data/8496/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <https://schema.org/> .

:Chart1 a schema:BarChart ;
    schema:title "Number of book readers in Italy in 2019 , by occupation and number of books read (in 1,000 readers)" ;
    :hasXAxisLabel "labeled occupation" ;
    :hasYAxisLabel "y" .

:DataPoint1 a :LabeledOccupation ;
    rdfs:label "Blue collar, apprentice" ;
    :y "1206"^^xsd:decimal ;
    :belongsToChart :Chart1 .

