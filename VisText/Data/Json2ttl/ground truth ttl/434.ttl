@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "How long do you think the social distancing instructions in the UK will be in place ?" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "Share of respondents" .

:DataPoint1 a :DataPoint ;
    :xValue "Until beginning of June" ;
    :yValue "0.02" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Until mid June" ;
    :yValue "0.03" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "Until end of June" ;
    :yValue "0.07" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "Until mid July" ;
    :yValue "0.05" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "Until end of July" ;
    :yValue "0.11" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Until mid August" ;
    :yValue "0.04" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Until end of August" ;
    :yValue "0.09" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Until mid September" ;
    :yValue "0.05" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "Until end of September" ;
    :yValue "0.06" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "Until mid October" ;
    :yValue "0.03" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "Until end of October" ;
    :yValue "0.05" ;
    :belongsTo :Chart .

:DataPoint12 a :DataPoint ;
    :xValue "Until mid November" ;
    :yValue "0.02" ;
    :belongsTo :Chart .

:DataPoint13 a :DataPoint ;
    :xValue "Until end of November" ;
    :yValue "0.02" ;
    :belongsTo :Chart .

:DataPoint14 a :DataPoint ;
    :xValue "Until mid December" ;
    :yValue "0.01" ;
    :belongsTo :Chart .

:DataPoint15 a :DataPoint ;
    :xValue "Until end of December" ;
    :yValue "0.04" ;
    :belongsTo :Chart .

:DataPoint16 a :DataPoint ;
    :xValue "Until after December" ;
    :yValue "2020" ;
    :belongsTo :Chart .
