@prefix : <http://example.org/chart-data/2357/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <https://schema.org/> .

:Chart1 a schema:LineChart ;
    schema:title "Djibouti : Infant mortality rate from 2009 to 2019 (in deaths per 1,000 live births)" ;
    :hasXAxisLabel "marked Year" ;
    :hasYAxisLabel "Deaths per 1,000 live births" .

:DataPoint1 a :MarkedYear ;
    rdfs:label "Dec" ;
    :deathsPer1000LiveBirths "31"^^xsd:decimal ;
    :belongsToChart :Chart1 .

