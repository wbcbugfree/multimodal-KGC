@prefix : <http://example.org/> .

:Chart a :AreaChart ;
    :title "Public concern about the extinction of plant and animal species in the United States from 2000 to 2012" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "Fair amount" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 1999" ;
    :yValue "0.33" ;
    :belongsTo :Chart .

