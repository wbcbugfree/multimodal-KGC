@prefix : <http://example.org/> .

:Chart a :LineChart ;
    :title "Number of participants in surfing in the United States from 2006 to 2017 (in millions)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Number of participants in millions" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2005" ;
    :yValue "2.17" ;
    :belongsTo :Chart .

