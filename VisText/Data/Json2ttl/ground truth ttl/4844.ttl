@prefix : <http://example.org/chart-data/4844/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <https://schema.org/> .

:Chart1 a schema:BarChart ;
    schema:title "Total number of magnetic resonance imaging (MRI) units in the United Kingdom (UK) from 2000 to 2014" ;
    :hasXAxisLabel "Year is drawn with a categorical scale from 2000* to" ;
    :hasYAxisLabel "y" .

:DataPoint1 a :YearIsDrawnWithACategoricalScaleFrom2000To ;
    rdfs:label "*" ;
    :y "411"^^xsd:decimal ;
    :belongsToChart :Chart1 .

