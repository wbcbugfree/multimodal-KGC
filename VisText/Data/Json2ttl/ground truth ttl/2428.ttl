    rdfs:label "Instacart*" ;
    :y "65"^^xsd:decimal ;
    :belongsToChart :Chart1 .

:DataPoint4 a :Company ;
    rdfs:label "Lyft" ;
    :y "24"^^xsd:decimal ;
    :belongsToChart :Chart1 .

:DataPoint5 a :Company ;
    rdfs:label "or service Average amunt spent in U..." ;
    :y "114"^^xsd:decimal ;
    :belongsToChart :Chart1 .

:DataPoint6 a :Company ;
    rdfs:label "Post Mates*" ;
    :y "34"^^xsd:decimal ;
    :belongsToChart :Chart1 .

:DataPoint7 a :Company ;
    rdfs:label "Shyp*" ;
    :y "12"^^xsd:decimal ;
    :belongsToChart :Chart1 .

:DataPoint8 a :Company ;
    rdfs:label "Task Rabbit*" ;
    :y "83"^^xsd:decimal ;
    :belongsToChart :Chart1 .

:DataPoint9 a :Company ;
    rdfs:label "Turo*" ;
    :y "39"^^xsd:decimal ;
    :belongsToChart :Chart1 .

:DataPoint10 a :Company ;
    rdfs:label "Uber" ;
    :y "32"^^xsd:decimal ;
    :belongsToChart :Chart1 .
