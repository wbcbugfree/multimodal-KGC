@prefix : <http://example.org/chart-data/2428/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <https://schema.org/> .

:Chart1 a schema:BarChart ;
    schema:title "Average spending of adults in the United States on selected...companies or services as of January 2016 (in U.S. dollars)" ;
    :hasXAxisLabel "company" ;
    :hasYAxisLabel "y" .

:DataPoint1 a :Company ;
    rdfs:label "DogVacay*" ;
    :y "42"^^xsd:decimal ;
    :belongsToChart :Chart1 .

:DataPoint2 a :Company ;
    rdfs:label "Etsy" ;
    :y "37"^^xsd:decimal ;
    :belongsToChart :Chart1 .

