@prefix : <http://example.org/chart-data/1404/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <https://schema.org/> .

:Chart1 a schema:LineChart ;
    schema:title "Ukraine : Youth unemployment rate from 1999 to 2020" ;
    :hasXAxisLabel "labeled Year" ;
    :hasYAxisLabel "y" .

:DataPoint1 a :LabeledYear ;
