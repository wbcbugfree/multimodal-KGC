@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Number of individuals with asthma in Great Britain in 2015 , by region" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "region in UK" .

:YAxis a :Axis ;
    :title "Number of individuals" .

:DataPoint1 a :DataPoint ;
    :xValue "North West" ;
    :yValue "778290" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "South East" ;
    :yValue "687892" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "London" ;
    :yValue "588172" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "East of England" ;
    :yValue "564416" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "Scotland" ;
    :yValue "554306" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Yorkshire and the Humber" ;
    :yValue "535547" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "South West" ;
    :yValue "530775" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "West Midlands" ;
    :yValue "440651" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "East Midlands" ;
    :yValue "385520" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "Wales" ;
