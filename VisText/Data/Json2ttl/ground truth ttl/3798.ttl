@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Average number of civilian deaths per day by car bombs and suicide attacks in Iraq war from 2003 to 2013" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Average number of civilian deaths per day" .

:DataPoint1 a :DataPoint ;
    :xValue "2013*" ;
    :yValue "6.4" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "2012" ;
    :yValue "7.3" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "2011" ;
    :yValue "6.6" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "2010" ;
    :yValue "7.3" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "2009" ;
    :yValue "8.4" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "2008" ;
    :yValue "10" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "2007" ;
    :yValue "22" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "2006" ;
    :yValue "16" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "2005" ;
    :yValue "10" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "2004" ;
    :yValue "5.4" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "2003" ;
    :yValue "1.5" ;
    :belongsTo :Chart .
