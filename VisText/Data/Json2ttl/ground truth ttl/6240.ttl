@prefix : <http://example.org/chart-data/6240/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <https://schema.org/> .

:Chart1 a schema:LineChart ;
    schema:title "Total U.S. domestic use of corn from 2001 to 2019 (in million bushels)" ;
    :hasXAxisLabel "marked Year" ;
    :hasYAxisLabel "y" .

:DataPoint1 a :MarkedYear ;
    rdfs:label "Dec" ;
    :y "31"^^xsd:decimal ;
    :belongsToChart :Chart1 .

