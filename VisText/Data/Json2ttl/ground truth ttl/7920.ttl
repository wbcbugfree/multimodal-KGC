@prefix : <http://example.org/chart-data/7920/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <https://schema.org/> .

:Chart1 a schema:LineChart ;
    schema:title "Annual revenue generated by Activision Blizzard from 2007 to 2019 , by region (in million U.S. dollars)" ;
    :hasXAxisLabel "Year" ;
    :hasYAxisLabel "y" .

:DataPoint1 a :Year ;
    rdfs:label "Asia Pacific Dec" ;
    :y "31"^^xsd:decimal ;
    :belongsToChart :Chart1 .

