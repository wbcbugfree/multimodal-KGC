@prefix : <http://example.org/> .

:Chart a :LineChart ;
    :title "Registered cases of fraud in Belgium from 2008 to 2019" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Cases of fraud" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2007" ;
    :yValue "11190" ;
    :belongsTo :Chart .

