@prefix : <http://example.org/chart-data/6447/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <https://schema.org/> .

:Chart1 a schema:LineChart ;
    schema:title "Marital status of the adult population in England and Wales from 2002 to 2019" ;
    :hasXAxisLabel "labeled Year" ;
    :hasYAxisLabel "y" .

