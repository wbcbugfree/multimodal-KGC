@prefix : <http://example.org/chart-data/845/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <https://schema.org/> .

:Chart1 a schema:BarChart ;
    schema:title "Leading countries in primary energy consumption worldwide in 2019 (in exajoules)" ;
    :hasXAxisLabel "Country" ;
    :hasYAxisLabel "y" .

:DataPoint1 a :Country ;
    rdfs:label "Australia" ;
    :y "6.41"^^xsd:decimal ;
    :belongsToChart :Chart1 .

