@prefix : <http://example.org/chart-data/3786/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <https://schema.org/> .

:Chart1 a schema:BarChart ;
    schema:title "Characteristics of a dream woman in China from a male perspective in 2012" ;
    :hasXAxisLabel "Share" ;
    :hasYAxisLabel "y" .

:DataPoint1 a :Share ;
    rdfs:label "Elegance" ;
    :y "0.38"^^xsd:decimal ;
    :belongsToChart :Chart1 .

:DataPoint2 a :Share ;
    rdfs:label "Good looks" ;
    :y "0.11"^^xsd:decimal ;
    :belongsToChart :Chart1 .

:DataPoint3 a :Share ;
    rdfs:label "Good manners and a good cook/housew..." ;
    :y "0.46"^^xsd:decimal ;
    :belongsToChart :Chart1 .

:DataPoint4 a :Share ;
    rdfs:label "Monogamous" ;
    :y "0.47"^^xsd:decimal ;
    :belongsToChart :Chart1 .

:DataPoint5 a :Share ;
    rdfs:label "of respondents Response" ;
    :y "0.55"^^xsd:decimal ;
    :belongsToChart :Chart1 .

:DataPoint6 a :Share ;
    rdfs:label "Sense of responsibility" ;
    :y "0.2"^^xsd:decimal ;
    :belongsToChart :Chart1 .

:DataPoint7 a :Share ;
    rdfs:label "Sexy body" ;
    :y "0.09"^^xsd:decimal ;
    :belongsToChart :Chart1 .

:DataPoint8 a :Share ;
    rdfs:label "Well off financially" ;
