@prefix : <http://example.org/chart-data/1168/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <https://schema.org/> .

:Chart1 a schema:BarChart ;
    schema:title "Installed power capacity across Tamil Nadu in India from financial year 2005 to 2018 (in megawatts)" ;
    :hasXAxisLabel "Financial" ;
    :hasYAxisLabel "y" .

:DataPoint1 a :Financial ;
    rdfs:label "FY" ;
    :y "2017"^^xsd:decimal ;
    :belongsToChart :Chart1 .

:DataPoint2 a :Financial ;
    rdfs:label "FY" ;
    :y "2016"^^xsd:decimal ;
    :belongsToChart :Chart1 .

:DataPoint3 a :Financial ;
    rdfs:label "FY" ;
    :y "2015"^^xsd:decimal ;
    :belongsToChart :Chart1 .

:DataPoint4 a :Financial ;
    rdfs:label "FY" ;
    :y "2014"^^xsd:decimal ;
    :belongsToChart :Chart1 .

:DataPoint5 a :Financial ;
    rdfs:label "FY" ;
    :y "2013"^^xsd:decimal ;
    :belongsToChart :Chart1 .

:DataPoint6 a :Financial ;
    rdfs:label "FY" ;
    :y "2012"^^xsd:decimal ;
    :belongsToChart :Chart1 .

:DataPoint7 a :Financial ;
    rdfs:label "FY" ;
    :y "2011"^^xsd:decimal ;
    :belongsToChart :Chart1 .

:DataPoint8 a :Financial ;
    rdfs:label "FY" ;
    :y "2010"^^xsd:decimal ;
    :belongsToChart :Chart1 .

:DataPoint9 a :Financial ;
    rdfs:label "FY" ;
    :y "2009"^^xsd:decimal ;
    :belongsToChart :Chart1 .

:DataPoint10 a :Financial ;
    rdfs:label "FY" ;
    :y "2008"^^xsd:decimal ;
    :belongsToChart :Chart1 .

:DataPoint11 a :Financial ;
    rdfs:label "FY" ;
    :y "2007"^^xsd:decimal ;
    :belongsToChart :Chart1 .

:DataPoint12 a :Financial ;
    rdfs:label "FY" ;
    :y "2006"^^xsd:decimal ;
    :belongsToChart :Chart1 .

:DataPoint13 a :Financial ;
    rdfs:label "FY" ;
    :y "2005"^^xsd:decimal ;
    :belongsToChart :Chart1 .

:DataPoint14 a :Financial ;
    rdfs:label "Year Installed power capacity in me..." ;
    :y "2018"^^xsd:decimal ;
    :belongsToChart :Chart1 .
