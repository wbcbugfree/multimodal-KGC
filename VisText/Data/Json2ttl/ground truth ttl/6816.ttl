@prefix : <http://example.org/chart-data/6816/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <https://schema.org/> .

:Chart1 a schema:LineChart ;
    schema:title "Life expectancy at birth in the Netherlands from 1950 to 2018 , by gender" ;
    :hasXAxisLabel "labeled Year" ;
    :hasYAxisLabel "Men" .

:DataPoint1 a :LabeledYear ;
    rdfs:label "Dec" ;
    :men "31"^^xsd:decimal ;
    :belongsToChart :Chart1 .

