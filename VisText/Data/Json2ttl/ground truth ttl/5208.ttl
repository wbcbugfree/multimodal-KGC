@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Average consumer price for heating oil in the United States from winter of 2005/06 to winter of 2020/21 (in U.S. dollars per gallon)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Price in U.S. dollars per gallon" .

:YAxis a :Axis ;
    :title "Year" .

:DataPoint1 a :DataPoint ;
    :xValue "2.35" ;
    :yValue "2020/21**" ;
    :belongsTo :Chart .

