@prefix : <http://example.org/chart-data/1093/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <https://schema.org/> .

:Chart1 a schema:BarChart ;
    schema:title "Countries with the highest stillbirth rates in 2009 (per 1,000 births)" ;
    :hasXAxisLabel "Country" ;
    :hasYAxisLabel "y" .

:DataPoint1 a :Country ;
    rdfs:label "Afghanistan" ;
    :y "29"^^xsd:decimal ;
    :belongsToChart :Chart1 .

