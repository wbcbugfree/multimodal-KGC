@prefix : <http://example.org/chart-data/2392/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <https://schema.org/> .

:Chart1 a schema:BarChart ;
    schema:title "Route length of railways across Uttar Pradesh in India from financial year 2003 to 2019 (in kilometers)" ;
    :hasXAxisLabel "Route" ;
    :hasYAxisLabel "y" .

:DataPoint1 a :Route ;
    rdfs:label "FY" ;
    :y "2019"^^xsd:decimal ;
    :belongsToChart :Chart1 .

