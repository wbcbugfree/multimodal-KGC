@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Current , binge , and heavy alcohol use in the United States in 2019 , by age group" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Heavy alcohol use" .

:YAxis a :Axis ;
    :title "Year" .

:DataPoint1 a :DataPoint ;
    :xValue "0.005" ;
    :yValue "14-15 years" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "0.02" ;
    :yValue "16-17 years" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "0.047" ;
    :yValue "18-20 years" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "0.108" ;
    :yValue "21-25 years" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "0.095" ;
    :yValue "26-29 years" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "0.081" ;
    :yValue "30-34 years" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "0.074" ;
    :yValue "35-39 years" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "0.067" ;
    :yValue "40-44 years" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "0.07" ;
    :yValue "45-49 years" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "0.077" ;
    :yValue "50-54 years" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "0.057" ;
    :yValue "55-59 years" ;
    :belongsTo :Chart .

:DataPoint12 a :DataPoint ;
    :xValue "0.045" ;
    :yValue "60-64 years" ;
    :belongsTo :Chart .

:DataPoint13 a :DataPoint ;
    :xValue "0.028" ;
    :yValue "65+ years" ;
    :belongsTo :Chart .
