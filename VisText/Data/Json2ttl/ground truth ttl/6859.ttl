@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Breakdown of confirmed cases of COVID-19 in Singapore as of March 2020 , by mode of transmission" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Local cases" .

:YAxis a :Axis ;
    :title "Month" .

:DataPoint1 a :DataPoint ;
    :xValue "6" ;
    :yValue "Mar 23" ;
    :belongsTo :Chart .

