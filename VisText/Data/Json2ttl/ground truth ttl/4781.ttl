@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Consumption of tree nuts worldwide in 2018 , by type (in 1,000 metric tons)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Consumption in thousand metric tons" .

:YAxis a :Axis ;
    :title "type of nut" .

:DataPoint1 a :DataPoint ;
    :xValue "42596" ;
    :yValue "Peanut" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "1188.69" ;
    :yValue "Almond" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "888.67" ;
    :yValue "Walnut" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "792.32" ;
    :yValue "Cashew" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "669.86" ;
    :yValue "Pistachio" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "424.14" ;
    :yValue "Hazelnut" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "125.5" ;
    :yValue "Pecan" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "50.36" ;
    :yValue "Macadamia" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "26.96" ;
    :yValue "Brazil Nut" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "21.69" ;
    :yValue "Pine Nut" ;
    :belongsTo :Chart .
