    :xValue "Alberta" ;
    :yValue "43749" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "Nova Scotia" ;
    :yValue "15411" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Manitoba" ;
    :yValue "13275" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Saskatchewan" ;
    :yValue "11199" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "New Brunswick" ;
    :yValue "8193" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "Newfoundland and Labrador" ;
    :yValue "6576" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "Prince Edward Island" ;
    :yValue "2037" ;
