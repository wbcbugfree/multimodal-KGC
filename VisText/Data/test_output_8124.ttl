@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Most popular products purchased in online stores during the coronavirus (C...LIK transactions between February and April 2020 , by e-commerce category" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "e-commerce category" .

:YAxis a :Axis ;
    :title "April to February 2020" .

:DataPoint1 a :DataPoint ;
    :xValue "Household appliances and electronics" ;
    :yValue "5.42" ;
    :belongsTo :Chart .

