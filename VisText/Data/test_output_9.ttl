@prefix ex:    <http://example.org/> .
@prefix chart: <http://example.org/chart#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:chart-9 a chart:Chart ;
    chart:chartType "bar" ;
    chart:title "Number of car registrations in Europe in 2019 , by segment (in 1,000s)" ;
    chart:xAxis ex:x-9 ;
    chart:yAxis ex:y-9 .

ex:x-9 a chart:Axis ;
    chart:label "New registrations in thousands" .

ex:y-9 a chart:Axis ;
    chart:label "programming language" .

ex:series-9-1 a chart:Series .

ex:mark-9-1-1 a chart:DataPoint ;
    chart:series ex:series-9-1 ;
    chart:category "Small" ;
    chart:value "2163.77"^^xsd:decimal .

ex:mark-9-1-2 a chart:DataPoint ;
    chart:series ex:series-9-1 ;
    chart:category "Compact" ;
    chart:value "2090.17"^^xsd:decimal .

ex:mark-9-1-3 a chart:DataPoint ;
    chart:series ex:series-9-1 ;
    chart:category "Compact SUV & crossover" ;
    chart:value "1922.69"^^xsd:decimal .

ex:mark-9-1-4 a chart:DataPoint ;
    chart:series ex:series-9-1 ;
    chart:category "Small SUV & crossover" ;
    chart:value "1101.78"^^xsd:decimal .

ex:mark-9-1-5 a chart:DataPoint ;
    chart:series ex:series-9-1 ;
    chart:category "Minicar" ;
    chart:value "746.61"^^xsd:decimal .

ex:mark-9-1-6 a chart:DataPoint ;
    chart:series ex:series-9-1 ;
    chart:category "Compact premium" ;
    chart:value "614.35"^^xsd:decimal .

ex:mark-9-1-7 a chart:DataPoint ;
    chart:series ex:series-9-1 ;
    chart:category "Premium compact SUV & crossover" ;
    chart:value "540.17"^^xsd:decimal .

ex:mark-9-1-8 a chart:DataPoint ;
    chart:series ex:series-9-1 ;
    chart:category "Midsize premium" ;
    chart:value "515.16"^^xsd:decimal .

ex:mark-9-1-9 a chart:DataPoint ;
    chart:series ex:series-9-1 ;
    chart:category "Premium midsize SUV & crossover" ;
    chart:value "403.92"^^xsd:decimal .
