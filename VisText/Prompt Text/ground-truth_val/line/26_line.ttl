@prefix : <http://example.org/vistext#> .

:chart-26 a :Chart ;
    :chartType "line" ;
    :title "Number of Vivendi 's employees from 2006 to 2019 (in thousands)" ;
    :xAxis :x-26 ;
    :yAxis :y-26 .

:x-26 a :Axis ;
    :label "Year" .

:y-26 a :Axis ;
    :label "Number of employees in thousands" .

:DataPoint1 a :DataPoint ;
    chart:independentVariable "Dec 31, 2005" ;
    chart:value "34.69" ;
    :belongsTo :chart-26 .

