@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Number of Vivendi 's employees from 2006 to 2019 (in thousands)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Number of employees in thousands" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2005" ;
    :yValue "34.69" ;
    :belongsTo :Chart .

