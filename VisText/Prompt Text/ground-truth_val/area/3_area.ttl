@prefix : <http://example.org/vistext#> .
@prefix chart: <http://example.org/chart#> .

:chart-3 a :Chart ;
    :chartType "area" ;
    :title "Worldwide number of Michelin 's full-time employees from 2006 to 2019" ;
    :xAxis :x-3 ;
    :yAxis :y-3 .

:x-3 a :Axis ;
    :label "Year" .

:y-3 a :Axis ;
    :label "Number of employees" .

:DataPoint1 a :DataPoint ;
    chart:independentVariable "Dec 31, 2005" ;
    chart:value "123975" ;
    :belongsTo :chart-3 .

:DataPoint2 a :DataPoint ;
    chart:independentVariable "Dec 31, 2006" ;
    chart:value "121356" ;
    :belongsTo :chart-3 .

