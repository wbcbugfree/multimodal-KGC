@prefix : <http://example.org/vistext#> .

:chart-18 a :Chart ;
    :chartType "bar" ;
    :title "Top 10 U.S. metro areas by plastic surgeon density as of 2016 (per 100,000 residents)" ;
    :xAxis :x-18 ;
    :yAxis :y-18 .

:x-18 a :Axis ;
    :label "Number of surgeons per 100,000 residents" .

:y-18 a :Axis ;
    :label "city of the United States" .

:DataPoint1 a :DataPoint ;
    chart:value "3.9" ;
    chart:independentVariable "Miami, FL" ;
    :belongsTo :chart-18 .

:DataPoint2 a :DataPoint ;
    chart:value "3.12" ;
    chart:independentVariable "Salt Lake City, UT" ;
    :belongsTo :chart-18 .

:DataPoint3 a :DataPoint ;
    chart:value "2.98" ;
    chart:independentVariable "Los Angeles, CA" ;
    :belongsTo :chart-18 .

:DataPoint4 a :DataPoint ;
    chart:value "2.82" ;
    chart:independentVariable "San Jose, CA" ;
    :belongsTo :chart-18 .

:DataPoint5 a :DataPoint ;
    chart:value "2.78" ;
    chart:independentVariable "Austin, TX" ;
    :belongsTo :chart-18 .

:DataPoint6 a :DataPoint ;
    chart:value "2.74" ;
    chart:independentVariable "San Francisco, CA" ;
    :belongsTo :chart-18 .

:DataPoint7 a :DataPoint ;
    chart:value "2.72" ;
    chart:independentVariable "Grand Rapids, MI" ;
    :belongsTo :chart-18 .

:DataPoint8 a :DataPoint ;
    chart:value "2.61" ;
    chart:independentVariable "New York, NY" ;
    :belongsTo :chart-18 .

:DataPoint9 a :DataPoint ;
    chart:value "2.5" ;
    chart:independentVariable "Tampa, FL" ;
    :belongsTo :chart-18 .

:DataPoint10 a :DataPoint ;
    chart:value "2.48" ;
    chart:independentVariable "Baltimore, MD" ;
    :belongsTo :chart-18 .
