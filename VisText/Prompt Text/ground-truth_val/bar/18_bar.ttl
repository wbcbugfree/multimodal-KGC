@prefix : <http://example.org/vistext#> .

:chart-18 a :Chart ;
    :chartType "bar" ;
    :title "Top 10 U.S. metro areas by plastic surgeon density as of 2016 (per 100,000 residents)" ;
    :xAxis :x-18 ;
    :yAxis :y-18 .

:x-18 a :Axis ;
    :label "Number of surgeons per 100,000 residents" .

:y-18 a :Axis ;
    :label "city of the United States" .

:DataPoint1 a :DataPoint ;
    :xValue "3.9" ;
    :yValue "Miami, FL" ;
    :belongsTo :chart-18 .

