@prefix soil: <http://example.org/soil-health/ontology/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

soil:SocietalNeed rdfs:subClassOf rdf:Class ;
    rdfs:label "Societal Need" .

soil:SoilFunction rdfs:subClassOf rdf:Class ;
    rdfs:label "Soil Function" .

soil:hasSoilFunction rdf:type rdf:Property ;
    rdfs:label "has soil function" ;
    rdfs:domain soil:SocietalNeed ;
    rdfs:range soil:SoilFunction .

soil:Biomass rdf:type soil:SocietalNeed ;
    skos:prefLabel "Biomass" .

soil:Water rdf:type soil:SocietalNeed ;
    skos:prefLabel "Water" .

soil:Climate rdf:type soil:SocietalNeed ;
    skos:prefLabel "Climate" .

soil:Biodiversity rdf:type soil:SocietalNeed ;
    skos:prefLabel "Biodiversity" .

soil:Infrastructure rdf:type soil:SocietalNeed ;
    skos:prefLabel "Infrastructure" .

soil:WoodAndFibreProduction rdf:type soil:SoilFunction ;
    skos:prefLabel "Wood and fibre production" .

soil:GrowthOfCrops rdf:type soil:SoilFunction ;
    skos:prefLabel "Growth of crops" .

soil:FilteringOfContaminants rdf:type soil:SoilFunction ;
    skos:prefLabel "Filtering of contaminants" .

soil:WaterStorage rdf:type soil:SoilFunction ;
    skos:prefLabel "Water storage" .

soil:CarbonStorage rdf:type soil:SoilFunction ;
    skos:prefLabel "Carbon storage" .

soil:HabitatForPlantsInsectsMicrobesFungi rdf:type soil:SoilFunction ;
    skos:prefLabel "Habitat for plants, insects, microbes, fungi" .

soil:PlatformForInfrastructure rdf:type soil:SoilFunction ;
    skos:prefLabel "Platform for infrastructure" .

soil:StorageOfGeologicalMaterial rdf:type soil:SoilFunction ;
    skos:prefLabel "Storage of geological material" .

soil:Biomass soil:hasSoilFunction soil:WoodAndFibreProduction .
soil:Biomass soil:hasSoilFunction soil:GrowthOfCrops .
soil:Water soil:hasSoilFunction soil:FilteringOfContaminants .
soil:Water soil:hasSoilFunction soil:WaterStorage .
soil:Climate soil:hasSoilFunction soil:CarbonStorage .
soil:Biodiversity soil:hasSoilFunction soil:HabitatForPlantsInsectsMicrobesFungi .
soil:Infrastructure soil:hasSoilFunction soil:PlatformForInfrastructure .
soil:Infrastructure soil:hasSoilFunction soil:StorageOfGeologicalMaterial .