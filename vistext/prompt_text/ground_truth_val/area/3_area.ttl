@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Worldwide number of Michelin 's full-time employees from 2006 to 2019" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Number of employees" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2005" ;
    :yValue "123975" ;
    :belongsTo :Chart .

