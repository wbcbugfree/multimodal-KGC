@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Switzerland : Number of employed persons from 2010 to 2020 (in millions)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Employed persons in millions" .

:dataPoint1 a :dataPoint ;
    :xValue "2020*" ;
    :yValue "5.02" ;
    :belongsTo :Chart .

:dataPoint2 a :dataPoint ;
    :xValue "2019*" ;
    :yValue "4.97" ;
    :belongsTo :Chart .

:dataPoint3 a :dataPoint ;
    :xValue "2018" ;
    :yValue "5.06" ;
    :belongsTo :Chart .

:dataPoint4 a :dataPoint ;
    :xValue "2017" ;
    :yValue "5.01" ;
    :belongsTo :Chart .

:dataPoint5 a :dataPoint ;
    :xValue "2016" ;
    :yValue "4.96" ;
    :belongsTo :Chart .

:dataPoint6 a :dataPoint ;
    :xValue "2015" ;
    :yValue "4.9" ;
    :belongsTo :Chart .

:dataPoint7 a :dataPoint ;
    :xValue "2014" ;
    :yValue "4.82" ;
    :belongsTo :Chart .

:dataPoint8 a :dataPoint ;
    :xValue "2013" ;
    :yValue "4.73" ;
    :belongsTo :Chart .

:dataPoint9 a :dataPoint ;
    :xValue "2012" ;
    :yValue "4.67" ;
    :belongsTo :Chart .

:dataPoint10 a :dataPoint ;
    :xValue "2011" ;
    :yValue "4.66" ;
    :belongsTo :Chart .

:dataPoint11 a :dataPoint ;
    :xValue "2010" ;
    :yValue "4.56" ;
    :belongsTo :Chart .
