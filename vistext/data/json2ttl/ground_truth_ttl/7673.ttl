@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Consumer spending expectations for the following six months on consumer products due to the coronavirus in the United States as of March 9 , 2020" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "consumer products" .

:YAxis a :Axis ;
    :title "Somewhat less" .

:dataPoint1 a :dataPoint ;
    :xValue "Fresh and organic goods" ;
    :yValue "0.06" ;
    :belongsTo :Chart .

:dataPoint2 a :dataPoint ;
    :xValue "Vitamins, minerals, herbs, or supplements" ;
    :yValue "0.08" ;
    :belongsTo :Chart .

:dataPoint3 a :dataPoint ;
    :xValue "Home furniture and décor" ;
    :yValue "0.13" ;
    :belongsTo :Chart .

:dataPoint4 a :dataPoint ;
    :xValue "Nonmobile consumer electronics and appliances" ;
    :yValue "0.12" ;
    :belongsTo :Chart .

:dataPoint5 a :dataPoint ;
    :xValue "Cars/automobiles" ;
    :yValue "0.05" ;
    :belongsTo :Chart .

:dataPoint6 a :dataPoint ;
    :xValue "Mobile electronics" ;
    :yValue "0.12" ;
    :belongsTo :Chart .

:dataPoint7 a :dataPoint ;
    :xValue "Toys and games" ;
    :yValue "0.12" ;
    :belongsTo :Chart .

:dataPoint8 a :dataPoint ;
    :xValue "Luxury/fashion" ;
    :yValue "0.13" ;
    :belongsTo :Chart .

:dataPoint9 a :dataPoint ;
    :xValue "Tobacco and smoking products" ;
    :yValue "0.17" ;
    :belongsTo :Chart .

:dataPoint10 a :dataPoint ;
    :xValue "Outerwear/jackets/coats" ;
    :yValue "0.18" ;
    :belongsTo :Chart .
