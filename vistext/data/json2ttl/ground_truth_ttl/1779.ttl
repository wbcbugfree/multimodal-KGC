@prefix : <http://example.org/> .

:Chart a :AreaChart ;
    :title "Number of employees of Polo Ralph Lauren worldwide from 2009 to 2020" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Number of employees" .

:dataPoint1 a :dataPoint ;
    :xValue "Dec 31, 2008" ;
    :yValue "17000" ;
    :belongsTo :Chart .

