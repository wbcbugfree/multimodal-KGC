@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Daily newspaper circulation in Canada in 2016 , by province (in 1,000s)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "province of Canada" .

:YAxis a :Axis ;
    :title "Weekly circulation" .

:dataPoint1 a :dataPoint ;
    :xValue "Ontario" ;
    :yValue "14740" ;
    :belongsTo :Chart .

:dataPoint2 a :dataPoint ;
    :xValue "Quebec" ;
    :yValue "8010" ;
    :belongsTo :Chart .

:dataPoint3 a :dataPoint ;
    :xValue "British Columbia" ;
    :yValue "3110" ;
    :belongsTo :Chart .

:dataPoint4 a :dataPoint ;
    :xValue "Alberta" ;
    :yValue "2500" ;
    :belongsTo :Chart .

:dataPoint5 a :dataPoint ;
    :xValue "Manitoba" ;
    :yValue "1190" ;
    :belongsTo :Chart .

:dataPoint6 a :dataPoint ;
    :xValue "Nova Scotia" ;
    :yValue "650" ;
    :belongsTo :Chart .

:dataPoint7 a :dataPoint ;
    :xValue "New Brunswick" ;
    :yValue "540" ;
    :belongsTo :Chart .

:dataPoint8 a :dataPoint ;
    :xValue "Saskatchewan" ;
    :yValue "530" ;
    :belongsTo :Chart .

:dataPoint9 a :dataPoint ;
    :xValue "Newfoundland and Labrador" ;
    :yValue "160" ;
    :belongsTo :Chart .

:dataPoint10 a :dataPoint ;
    :xValue "Prince Edward Island" ;
    :yValue "110" ;
    :belongsTo :Chart .

:dataPoint11 a :dataPoint ;
    :xValue "Yukon Territories" ;
    :yValue "7" ;
    :belongsTo :Chart .
