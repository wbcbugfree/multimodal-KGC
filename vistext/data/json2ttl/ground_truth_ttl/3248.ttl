@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Alternative finance market value in France in 2017 , by selected platforms (in million euros)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Market size in million euros" .

:YAxis a :Axis ;
    :title "selected platforms" .

:dataPoint1 a :dataPoint ;
    :xValue "293" ;
    :yValue "P2P Consumer Lending" ;
    :belongsTo :Chart .

:dataPoint2 a :dataPoint ;
    :xValue "87.7" ;
    :yValue "P2P Business lending" ;
    :belongsTo :Chart .

:dataPoint3 a :dataPoint ;
    :xValue "67.5" ;
    :yValue "Real estate crowdfunding" ;
    :belongsTo :Chart .

:dataPoint4 a :dataPoint ;
    :xValue "48.4" ;
    :yValue "Equity-based crowdfunding" ;
    :belongsTo :Chart .

:dataPoint5 a :dataPoint ;
    :xValue "46.8" ;
    :yValue "Reward-based crowdfunding" ;
    :belongsTo :Chart .

:dataPoint6 a :dataPoint ;
    :xValue "39.4" ;
    :yValue "Debt based securities" ;
    :belongsTo :Chart .

:dataPoint7 a :dataPoint ;
    :xValue "30" ;
    :yValue "Invoice trading" ;
    :belongsTo :Chart .

:dataPoint8 a :dataPoint ;
    :xValue "30" ;
    :yValue "Balance sheet business lending" ;
    :belongsTo :Chart .

:dataPoint9 a :dataPoint ;
    :xValue "8.7" ;
    :yValue "Donation-based crowdfunding" ;
    :belongsTo :Chart .

:dataPoint10 a :dataPoint ;
    :xValue "8.6" ;
    :yValue "Mini bonds" ;
    :belongsTo :Chart .

:dataPoint11 a :dataPoint ;
    :xValue "0.7" ;
    :yValue "Other" ;
    :belongsTo :Chart .

:dataPoint12 a :dataPoint ;
    :xValue "0.5" ;
    :yValue "Profit sharing" ;
    :belongsTo :Chart .
