@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Total cost of violence to the U.S. economy in 2010 , by static and dynamic indicators (in million U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Economic effect in million U.S. dollars" .

:YAxis a :Axis ;
    :title "Static and dynamic indicators" .

:dataPoint1 a :dataPoint ;
    :xValue "178427.1" ;
    :yValue "Assault, lost productivity (dynamic)" ;
    :belongsTo :Chart .

:dataPoint2 a :dataPoint ;
    :xValue "71009.66" ;
    :yValue "Incarceration, lost work (dynamic)" ;
    :belongsTo :Chart .

:dataPoint3 a :dataPoint ;
    :xValue "56394.99" ;
    :yValue "Police, wages (static)" ;
    :belongsTo :Chart .

:dataPoint4 a :dataPoint ;
    :xValue "48555.81" ;
    :yValue "Homicide, lost productivity (dynamic)" ;
    :belongsTo :Chart .

:dataPoint5 a :dataPoint ;
    :xValue "41684.1" ;
    :yValue "Incarceration, government costs (static)" ;
    :belongsTo :Chart .

:dataPoint6 a :dataPoint ;
    :xValue "37976.99" ;
    :yValue "Assault, medical costs (static)" ;
    :belongsTo :Chart .

:dataPoint7 a :dataPoint ;
    :xValue "20498.53" ;
    :yValue "Rape, lost productivity (dynamic)" ;
    :belongsTo :Chart .

:dataPoint8 a :dataPoint ;
    :xValue "5702.21" ;
    :yValue "Legal and judicial, government costs (static)" ;
    :belongsTo :Chart .

:dataPoint9 a :dataPoint ;
    :xValue "489.95" ;
    :yValue "Robbery, property damage (static)" ;
    :belongsTo :Chart .

:dataPoint10 a :dataPoint ;
    :xValue "91.62" ;
    :yValue "Homicide, medical costs (static)" ;
    :belongsTo :Chart .
