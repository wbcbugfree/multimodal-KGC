@prefix : <http://example.org/> .

:Chart a :AreaChart ;
    :title "Income of Polo Ralph Lauren worldwide from 2007 to 2016 , by business segment (in million U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Wholesale" .

:dataPoint1 a :dataPoint ;
    :xValue "Dec 31, 2006" ;
    :yValue "477.8" ;
    :belongsTo :Chart .

