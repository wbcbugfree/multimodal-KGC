@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Ratio of government expenditure to gross domestic product (GDP) in the United States from 2015 to 2025" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Ratio of government expenditure to GDP" .

:dataPoint1 a :dataPoint ;
    :xValue "2025*" ;
    :yValue "0.3591" ;
    :belongsTo :Chart .

:dataPoint2 a :dataPoint ;
    :xValue "2024*" ;
    :yValue "0.3569" ;
    :belongsTo :Chart .

:dataPoint3 a :dataPoint ;
    :xValue "2023*" ;
    :yValue "0.3586" ;
    :belongsTo :Chart .

:dataPoint4 a :dataPoint ;
    :xValue "2022*" ;
    :yValue "0.3652" ;
    :belongsTo :Chart .

:dataPoint5 a :dataPoint ;
    :xValue "2021*" ;
    :yValue "0.3745" ;
    :belongsTo :Chart .

:dataPoint6 a :dataPoint ;
    :xValue "2020*" ;
    :yValue "0.4719" ;
    :belongsTo :Chart .

:dataPoint7 a :dataPoint ;
    :xValue "2019" ;
    :yValue "0.3574" ;
    :belongsTo :Chart .

:dataPoint8 a :dataPoint ;
    :xValue "2018" ;
    :yValue "0.3537" ;
    :belongsTo :Chart .

:dataPoint9 a :dataPoint ;
    :xValue "2017" ;
