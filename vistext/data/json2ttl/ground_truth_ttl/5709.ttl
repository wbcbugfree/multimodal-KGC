@prefix : <http://example.org/> .

:Chart a :AreaChart ;
    :title "Number of U.S. air strikes in Pakistan from 2004 to 2018" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Number of air strikes" .

:dataPoint1 a :dataPoint ;
    :xValue "Dec 31, 2003" ;
    :yValue "1" ;
    :belongsTo :Chart .

