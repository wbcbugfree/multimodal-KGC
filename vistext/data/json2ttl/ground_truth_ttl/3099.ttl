@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Distribution of population in Italy in 2019 , by age group" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "Share of population" .

:dataPoint1 a :dataPoint ;
    :xValue "0 to 2 years" ;
    :yValue "0.022" ;
    :belongsTo :Chart .

:dataPoint2 a :dataPoint ;
    :xValue "3 to 5 years" ;
    :yValue "0.0245" ;
    :belongsTo :Chart .

:dataPoint3 a :dataPoint ;
    :xValue "6 to 11 years" ;
    :yValue "0.0548" ;
    :belongsTo :Chart .

:dataPoint4 a :dataPoint ;
    :xValue "12 to 17 years" ;
    :yValue "0.0572" ;
    :belongsTo :Chart .

:dataPoint5 a :dataPoint ;
    :xValue "18 to 24 years" ;
    :yValue "0.0692" ;
    :belongsTo :Chart .

:dataPoint6 a :dataPoint ;
    :xValue "25 to 34 years" ;
    :yValue "0.1079" ;
    :belongsTo :Chart .

:dataPoint7 a :dataPoint ;
    :xValue "35 to 44 years" ;
    :yValue "0.1305" ;
    :belongsTo :Chart .

:dataPoint8 a :dataPoint ;
    :xValue "45 to 54 years" ;
    :yValue "0.1614" ;
    :belongsTo :Chart .

:dataPoint9 a :dataPoint ;
    :xValue "55 to 64 years" ;
    :yValue "0.1412" ;
    :belongsTo :Chart .

:dataPoint10 a :dataPoint ;
    :xValue "65 to 74 years" ;
    :yValue "0.1136" ;
    :belongsTo :Chart .

:dataPoint11 a :dataPoint ;
    :xValue "75 years and more" ;
    :yValue "0.1179" ;
    :belongsTo :Chart .
