@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Bahrain : Budget balance between 2015 to 2025 in relation to GDP" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Budget balance in relation to GDP" .

:YAxis a :Axis ;
    :title "Year" .

:dataPoint1 a :dataPoint ;
    :xValue "-0.0768" ;
    :yValue "2025*" ;
    :belongsTo :Chart .

:dataPoint2 a :dataPoint ;
    :xValue "-0.0787" ;
    :yValue "2024*" ;
    :belongsTo :Chart .

:dataPoint3 a :dataPoint ;
    :xValue "-0.0805" ;
    :yValue "2023*" ;
    :belongsTo :Chart .

:dataPoint4 a :dataPoint ;
    :xValue "-0.0838" ;
    :yValue "2022*" ;
    :belongsTo :Chart .

:dataPoint5 a :dataPoint ;
    :xValue "-0.0923" ;
    :yValue "2021*" ;
    :belongsTo :Chart .

:dataPoint6 a :dataPoint ;
    :xValue "-0.1312" ;
    :yValue "2020*" ;
    :belongsTo :Chart .

:dataPoint7 a :dataPoint ;
    :xValue "-0.1061" ;
    :yValue "2019" ;
    :belongsTo :Chart .

:dataPoint8 a :dataPoint ;
    :xValue "-0.1194" ;
    :yValue "2018" ;
    :belongsTo :Chart .

:dataPoint9 a :dataPoint ;
    :xValue "-0.1422" ;
    :yValue "2017" ;
    :belongsTo :Chart .

:dataPoint10 a :dataPoint ;
    :xValue "-0.1756" ;
    :yValue "2016" ;
    :belongsTo :Chart .

:dataPoint11 a :dataPoint ;
    :xValue "-0.1844" ;
    :yValue "2015" ;
    :belongsTo :Chart .
