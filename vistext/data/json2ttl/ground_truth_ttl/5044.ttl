@prefix : <http://example.org/> .

:Chart a :AreaChart ;
    :title "Gross domestic product (GDP) growth rate in Sweden from 2008 to 2018" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "GDP growth rate" .

:DataPoint1 a :DataPoint ;
    :xValue "-0.005" ;
    :yValue "Dec 31, 2008" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "-0.043" ;
    :yValue "Dec 31, 2009" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "0.06" ;
    :yValue "Dec 31, 2010" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "0.032" ;
    :yValue "Dec 31, 2011" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "-0.006" ;
    :yValue "Dec 31, 2012" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "0.012" ;
    :yValue "Dec 31, 2013" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "0.027" ;
    :yValue "Dec 31, 2014" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "0.045" ;
    :yValue "Dec 31, 2015" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "0.021" ;
    :yValue "Dec 31, 2016" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "0.026" ;
    :yValue "Dec 31, 2017" ;
    :belongsTo :Chart .
