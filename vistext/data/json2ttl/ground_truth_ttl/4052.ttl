@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Net sales growth of the world 's leading 10 consumer products companies in 2013" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Company (Country of origin)" .

:YAxis a :Axis ;
    :title "Net sales growth" .

:dataPoint1 a :dataPoint ;
    :xValue "Samsung Electronics (South Korea)" ;
    :yValue "0.137" ;
    :belongsTo :Chart .

:dataPoint2 a :dataPoint ;
    :xValue "Apple (United States)" ;
    :yValue "0.092" ;
    :belongsTo :Chart .

:dataPoint3 a :dataPoint ;
    :xValue "Nestlé (Switzerland)" ;
    :yValue "0.027" ;
    :belongsTo :Chart .

:dataPoint4 a :dataPoint ;
    :xValue "Procter & Gamble (United States)" ;
    :yValue "-0.013" ;
    :belongsTo :Chart .

:dataPoint5 a :dataPoint ;
    :xValue "Sony (Japan)" ;
    :yValue "0.174" ;
    :belongsTo :Chart .

:dataPoint6 a :dataPoint ;
    :xValue "PepsiCo (United States)" ;
    :yValue "0.014" ;
    :belongsTo :Chart .

:dataPoint7 a :dataPoint ;
    :xValue "Unilever (Netherlands and U.K.)" ;
    :yValue "-0.03" ;
    :belongsTo :Chart .

:dataPoint8 a :dataPoint ;
    :xValue "LG Electronics" ;
    :yValue "0.141" ;
    :belongsTo :Chart .

:dataPoint9 a :dataPoint ;
    :xValue "The Coca-Cola Company (United States)" ;
    :yValue "-0.024" ;
    :belongsTo :Chart .

:dataPoint10 a :dataPoint ;
    :xValue "JBS S.A. (Brazil)" ;
    :yValue "0.227" ;
    :belongsTo :Chart .
