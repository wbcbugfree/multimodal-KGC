@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "B2C e-commerce as percentage of GDP in Japan from 2009 to 2018" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Percentage of gross domestic product" .

:YAxis a :Axis ;
    :title "Response" .

:dataPoint1 a :dataPoint ;
    :xValue "0.0172" ;
    :yValue "2018*" ;
    :belongsTo :Chart .

:dataPoint2 a :dataPoint ;
    :xValue "0.0159" ;
    :yValue "2017*" ;
    :belongsTo :Chart .

:dataPoint3 a :dataPoint ;
    :xValue "0.0145" ;
    :yValue "2016*" ;
    :belongsTo :Chart .

:dataPoint4 a :dataPoint ;
    :xValue "0.0123" ;
    :yValue "2015*" ;
    :belongsTo :Chart .

:dataPoint5 a :dataPoint ;
    :xValue "0.0105" ;
    :yValue "2014*" ;
    :belongsTo :Chart .

:dataPoint6 a :dataPoint ;
    :xValue "0.0101" ;
    :yValue "2013" ;
    :belongsTo :Chart .

:dataPoint7 a :dataPoint ;
    :xValue "0.0086" ;
    :yValue "2012" ;
    :belongsTo :Chart .

:dataPoint8 a :dataPoint ;
    :xValue "0.008" ;
    :yValue "2011" ;
    :belongsTo :Chart .

:dataPoint9 a :dataPoint ;
    :xValue "0.0071" ;
    :yValue "2010" ;
    :belongsTo :Chart .

:dataPoint10 a :dataPoint ;
    :xValue "0.0064" ;
    :yValue "2009" ;
    :belongsTo :Chart .
