@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Sales-to-assets ratio of top 20 pharmaceutical companies worldwide in 2019" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Sales to assets ratio" .

:YAxis a :Axis ;
    :title "business" .

:dataPoint1 a :dataPoint ;
    :xValue "1" ;
    :yValue "Novo Nordisk" ;
    :belongsTo :Chart .

