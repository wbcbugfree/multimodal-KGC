@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Average spending per consumer on selected music activities in the United States as of July 2018" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "$40 to $99.99" .

:dataPoint1 a :dataPoint ;
    :xValue "Tickets for music concerts/gigs" ;
    :yValue "0.31" ;
    :belongsTo :Chart .

:dataPoint2 a :dataPoint ;
    :xValue "Tickets for festivals" ;
    :yValue "0.35" ;
    :belongsTo :Chart .

:dataPoint3 a :dataPoint ;
    :xValue "Music merchandise items" ;
    :yValue "0.34" ;
    :belongsTo :Chart .

:dataPoint4 a :dataPoint ;
    :xValue "Vinyl albums" ;
    :yValue "0.26" ;
    :belongsTo :Chart .

:dataPoint5 a :dataPoint ;
    :xValue "Pre-paid music voucher" ;
    :yValue "0.24" ;
    :belongsTo :Chart .

:dataPoint6 a :dataPoint ;
    :xValue "Music streaming subscription gift cards" ;
    :yValue "0.24" ;
    :belongsTo :Chart .

:dataPoint7 a :dataPoint ;
    :xValue "CD albums/singles" ;
    :yValue "0.16" ;
    :belongsTo :Chart .

:dataPoint8 a :dataPoint ;
    :xValue "Music DVDs" ;
    :yValue "0.14" ;
    :belongsTo :Chart .

:dataPoint9 a :dataPoint ;
    :xValue "MP3/download albums" ;
    :yValue "0.09" ;
    :belongsTo :Chart .

:dataPoint10 a :dataPoint ;
    :xValue "Vinyl singles" ;
    :yValue "0.07" ;
    :belongsTo :Chart .

:dataPoint11 a :dataPoint ;
    :xValue "MP3/download singles/tracks" ;
    :yValue "0.08" ;
    :belongsTo :Chart .
