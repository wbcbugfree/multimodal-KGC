@prefix : <http://example.org/> .

:Chart a :LineChart ;
    :title "Net income (loss) of Virgin Media from 2008 to 2019 (in million GBP)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Net income (loss) in million GBP" .

:DataPoint1 a :DataPoint ;
    :xValue "-920" ;
    :yValue "Dec 31, 2008" ;
    :belongsTo :Chart .

