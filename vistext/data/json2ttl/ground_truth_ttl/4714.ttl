@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Men 's singles US Open tennis tournaments won from 1968 to 2020" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Number of US Open titles" .

:YAxis a :Axis ;
    :title "player" .

:DataPoint1 a :DataPoint ;
    :xValue "5" ;
    :yValue "Jimmy Connors" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "5" ;
    :yValue "Roger Federer" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "5" ;
    :yValue "Pete Sampras" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "4" ;
    :yValue "John McEnroe" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "4" ;
    :yValue "Rafael Nadal" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "3" ;
    :yValue "Ivan Lendl" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "3" ;
    :yValue "Novak Djokovic" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "2" ;
    :yValue "Patrick Rafter" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "2" ;
    :yValue "Stefan Edberg" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "2" ;
    :yValue "Stan Smith" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "2" ;
    :yValue "Arthur Ashe" ;
    :belongsTo :Chart .

:DataPoint12 a :DataPoint ;
    :xValue "2" ;
    :yValue "John Newcombe*" ;
    :belongsTo :Chart .
