@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Men 's singles US Open tennis tournaments won from 1968 to 2020" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Number of US Open titles" .

:YAxis a :Axis ;
    :title "player" .

:dataPoint1 a :dataPoint ;
    :xValue "5" ;
    :yValue "Jimmy Connors" ;
    :belongsTo :Chart .

:dataPoint2 a :dataPoint ;
    :xValue "5" ;
    :yValue "Roger Federer" ;
    :belongsTo :Chart .

:dataPoint3 a :dataPoint ;
    :xValue "5" ;
    :yValue "Pete Sampras" ;
    :belongsTo :Chart .

