    :yValue "Rafael Nadal" ;
    :belongsTo :Chart .

:dataPoint6 a :dataPoint ;
    :xValue "3" ;
    :yValue "Ivan Lendl" ;
    :belongsTo :Chart .

:dataPoint7 a :dataPoint ;
    :xValue "3" ;
    :yValue "Novak Djokovic" ;
    :belongsTo :Chart .

:dataPoint8 a :dataPoint ;
    :xValue "2" ;
