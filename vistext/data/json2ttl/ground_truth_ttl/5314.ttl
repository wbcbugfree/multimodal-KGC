@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Most popular leisure activities among men in the United States as of September 2013" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Share of respondents" .

:YAxis a :Axis ;
    :title "Response" .

:dataPoint1 a :dataPoint ;
    :xValue "0.43" ;
    :yValue "Watch TV" ;
    :belongsTo :Chart .

:dataPoint2 a :dataPoint ;
    :xValue "0.24" ;
    :yValue "Reading" ;
    :belongsTo :Chart .

:dataPoint3 a :dataPoint ;
    :xValue "0.2" ;
    :yValue "Computer/internet" ;
    :belongsTo :Chart .

:dataPoint4 a :dataPoint ;
    :xValue "0.13" ;
    :yValue "Playing video games and computer/internet games" ;
    :belongsTo :Chart .

:dataPoint5 a :dataPoint ;
    :xValue "0.13" ;
    :yValue "Spending time with families and friends" ;
    :belongsTo :Chart .

:dataPoint6 a :dataPoint ;
    :xValue "0.11" ;
    :yValue "Watching/going to the movies" ;
    :belongsTo :Chart .

:dataPoint7 a :dataPoint ;
    :xValue "0.1" ;
    :yValue "Exercise/working out" ;
    :belongsTo :Chart .

:dataPoint8 a :dataPoint ;
    :xValue "0.1" ;
    :yValue "Concerts/listening to/playing music" ;
    :belongsTo :Chart .

:dataPoint9 a :dataPoint ;
    :xValue "0.07" ;
    :yValue "Walking/running/jogging" ;
    :belongsTo :Chart .

:dataPoint10 a :dataPoint ;
    :xValue "0.07" ;
    :yValue "Golf" ;
    :belongsTo :Chart .
