@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Leading crowdfunding platforms in the United States as of May 2017 , by number of offerings" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Country" .

:YAxis a :Axis ;
    :title "Amount of offerings" .

