@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Leading BBC Radio stations ranked by weekly reach in the United Kingdom (UK) as of 1st quarter 2020 (in 1,000 listeners)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Listeners reached in thousands*" .

:YAxis a :Axis ;
    :title "radio station" .

:DataPoint1 a :DataPoint ;
    :xValue "14362" ;
    :yValue "BBC Radio 2" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "11105" ;
    :yValue "BBC Radio 4" ;
    :belongsTo :Chart .

