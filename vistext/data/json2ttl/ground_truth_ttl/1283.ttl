    :xValue "5219" ;
    :yValue "BBC Radio 5 live" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "2556" ;
    :yValue "BBC 6 Music" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "1983" ;
    :yValue "BBC Radio 4 Extra" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "1980" ;
    :yValue "BBC Radio 3" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "1346" ;
    :yValue "BBC World Service" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
