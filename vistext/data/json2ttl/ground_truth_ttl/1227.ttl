@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Swaziland : National debt from 2014 to 2024 (in billion U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "National debt in billion U.S. dollars" .

:dataPoint1 a :dataPoint ;
    :xValue "2024*" ;
    :yValue "3.78" ;
    :belongsTo :Chart .

:dataPoint2 a :dataPoint ;
    :xValue "2023*" ;
    :yValue "3.23" ;
    :belongsTo :Chart .

:dataPoint3 a :dataPoint ;
    :xValue "2022*" ;
    :yValue "2.76" ;
    :belongsTo :Chart .

:dataPoint4 a :dataPoint ;
    :xValue "2021*" ;
    :yValue "2.35" ;
    :belongsTo :Chart .

:dataPoint5 a :dataPoint ;
    :xValue "2020*" ;
    :yValue "2.08" ;
    :belongsTo :Chart .

:dataPoint6 a :dataPoint ;
    :xValue "2019" ;
    :yValue "1.89" ;
    :belongsTo :Chart .

:dataPoint7 a :dataPoint ;
    :xValue "2018" ;
    :yValue "1.53" ;
    :belongsTo :Chart .

:dataPoint8 a :dataPoint ;
    :xValue "2017" ;
    :yValue "1.13" ;
    :belongsTo :Chart .

:dataPoint9 a :dataPoint ;
    :xValue "2016" ;
    :yValue "0.98" ;
    :belongsTo :Chart .

:dataPoint10 a :dataPoint ;
    :xValue "2015" ;
    :yValue "0.65" ;
    :belongsTo :Chart .

:dataPoint11 a :dataPoint ;
    :xValue "2014" ;
    :yValue "0.47" ;
    :belongsTo :Chart .
