@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Monthly ARPU through post-paid mobile subscribers in the United Kingdom (UK) from 2007 to 2020 (in GBP)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Average monthly ARPU in GBP" .

:YAxis a :Axis ;
    :title "Year" .

:dataPoint1 a :dataPoint ;
    :xValue "15.55" ;
    :yValue "2020*" ;
    :belongsTo :Chart .

