@prefix : <http://example.org/> .

:Chart a :LineChart ;
    :title "Peru : Distribution of employment by economic sector from 2010 to 2020" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Services" .

:dataPoint1 a :dataPoint ;
    :xValue "Dec 31, 2009" ;
    :yValue "0.5542" ;
    :belongsTo :Chart .

