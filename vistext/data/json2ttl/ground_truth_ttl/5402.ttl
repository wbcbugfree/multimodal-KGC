@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Number of employees in the United States in November 2020 , by industry (in 1,000s)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Number of employees in thousands" .

:YAxis a :Axis ;
    :title "industry type" .

