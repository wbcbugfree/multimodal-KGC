@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Number of active enterprises in Canada in 2013 , by enterprise size" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Enterprise size in employees" .

:YAxis a :Axis ;
    :title "Number of active enterprises" .

:dataPoint1 a :dataPoint ;
    :xValue "1-4" ;
    :yValue "750180" ;
    :belongsTo :Chart .

:dataPoint2 a :dataPoint ;
    :xValue "5-9" ;
    :yValue "194680" ;
    :belongsTo :Chart .

:dataPoint3 a :dataPoint ;
    :xValue "10-19" ;
    :yValue "105280" ;
    :belongsTo :Chart .

:dataPoint4 a :dataPoint ;
    :xValue "20-49" ;
    :yValue "62850" ;
    :belongsTo :Chart .

:dataPoint5 a :dataPoint ;
    :xValue "50-99" ;
    :yValue "18880" ;
    :belongsTo :Chart .

:dataPoint6 a :dataPoint ;
    :xValue "100-199" ;
    :yValue "7100" ;
    :belongsTo :Chart .

:dataPoint7 a :dataPoint ;
    :xValue "200-249" ;
    :yValue "1060" ;
    :belongsTo :Chart .

:dataPoint8 a :dataPoint ;
    :xValue "250-499" ;
    :yValue "1850" ;
    :belongsTo :Chart .

:dataPoint9 a :dataPoint ;
    :xValue "500-999" ;
    :yValue "790" ;
    :belongsTo :Chart .

:dataPoint10 a :dataPoint ;
    :xValue "or more" ;
    :yValue "750" ;
    :belongsTo :Chart .
