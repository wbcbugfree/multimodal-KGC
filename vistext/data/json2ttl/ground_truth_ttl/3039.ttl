@prefix : <http://example.org/> .

:Chart a :LineChart ;
    :title "Lobbying expenses of Microsoft in the United States from 2009 to 2019 (in million U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Spending in million U.S. dollars" .

:dataPoint1 a :dataPoint ;
    :xValue "Dec 31, 2008" ;
    :yValue "6.72" ;
    :belongsTo :Chart .

