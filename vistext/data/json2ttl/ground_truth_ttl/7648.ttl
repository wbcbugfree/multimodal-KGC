    :xValue "Manitoba" ;
    :yValue "913" ;
    :belongsTo :Chart .

:dataPoint6 a :dataPoint ;
    :xValue "Saskatchewan" ;
    :yValue "1171" ;
    :belongsTo :Chart .

:dataPoint7 a :dataPoint ;
    :xValue "Alberta" ;
    :yValue "2877" ;
    :belongsTo :Chart .

:dataPoint8 a :dataPoint ;
    :xValue "British Columbia" ;
