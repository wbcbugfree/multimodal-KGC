@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Number of Royal Canadian Mounted Police officers in Canada in 2019 , by level of policing and province" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "level of policing and province" .

:YAxis a :Axis ;
    :title "Contract policing *" .

:DataPoint1 a :DataPoint ;
    :xValue "Newfoundland and Labrador" ;
    :yValue "427" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Prince Edward Island" ;
    :yValue "96" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "Nova Scotia" ;
    :yValue "846" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "New Brunswick" ;
    :yValue "703" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "Manitoba" ;
    :yValue "913" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Saskatchewan" ;
    :yValue "1171" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Alberta" ;
    :yValue "2877" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "British Columbia" ;
    :yValue "5972" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "Yukon" ;
    :yValue "120" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "Northwest Territories" ;
