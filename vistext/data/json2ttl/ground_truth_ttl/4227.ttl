@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Leading male tennis players in Italy as of October 12 , 2020 , by ATP score" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "ATP score" .

:YAxis a :Axis ;
    :title "Tennis player" .

:DataPoint1 a :DataPoint ;
    :xValue "3075" ;
    :yValue "Matteo Berrettini" ;
    :belongsTo :Chart .

