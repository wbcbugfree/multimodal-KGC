@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Breakdown of Johnson & Johnson 's revenue worldwide from 2013 to 2021 , by sub-category" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Sub-category" .

:YAxis a :Axis ;
    :title "2019" .

:DataPoint1 a :DataPoint ;
    :xValue "DePuy orthopedics & spine" ;
    :yValue "0.163" ;
    :belongsTo :Chart .

