@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Breakdown of Johnson & Johnson 's revenue worldwide from 2013 to 2021 , by sub-category" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Sub-category" .

:YAxis a :Axis ;
    :title "2019" .

:dataPoint1 a :dataPoint ;
    :xValue "DePuy orthopedics & spine" ;
    :yValue "0.163" ;
    :belongsTo :Chart .

:dataPoint2 a :dataPoint ;
    :xValue "Sub-category: DePuy orthopedics & spine* Surgical devices" ;
    :yValue "0.156" ;
    :belongsTo :Chart .

:dataPoint3 a :dataPoint ;
    :xValue "Sub-category: Surgical devices* Stents, catheters & other medical devices" ;
    :yValue "0.115" ;
    :belongsTo :Chart .

:dataPoint4 a :dataPoint ;
    :xValue "Sub-category: Stents, catheters & other medical devices* Procrit, Velcade & other*" ;
    :yValue "0.121" ;
    :belongsTo :Chart .

:dataPoint5 a :dataPoint ;
    :xValue "Sub-category: Procrit, Velcade & other** Remicade & immunology*" ;
    :yValue "0.11" ;
    :belongsTo :Chart .

:dataPoint6 a :dataPoint ;
    :xValue "Sub-category: Remicade & immunology** Central nervous system*" ;
    :yValue "0.0601" ;
    :belongsTo :Chart .

:dataPoint7 a :dataPoint ;
    :xValue "Sub-category: Central nervous system** Anti-infectives*" ;
    :yValue "0.0603" ;
    :belongsTo :Chart .

:dataPoint8 a :dataPoint ;
    :xValue "Sub-category: Anti-infectives** OTC drugs & nutritionals**" ;
    :yValue "0.0587" ;
    :belongsTo :Chart .

:dataPoint9 a :dataPoint ;
    :xValue "Sub-category: OTC drugs & nutritionals*** Women's health, wound & oral care**" ;
    :yValue "0.0685" ;
    :belongsTo :Chart .

:dataPoint10 a :dataPoint ;
    :xValue "Sub-category: Women's health, wound & oral care*** Neutrogena, Aveena & other skin care**" ;
    :yValue "0.0559" ;
    :belongsTo :Chart .

:dataPoint11 a :dataPoint ;
    :xValue "Sub-category: Neutrogena, Aveena & other skin care*** Baby care**" ;
    :yValue "0.0315" ;
    :belongsTo :Chart .
