@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Countries with the highest mortality rate among children aged under 5 as of 2019 (per 1,000 live births)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Country" .

:YAxis a :Axis ;
    :title "Deaths per thousand live births" .

:DataPoint1 a :DataPoint ;
    :xValue "Nigeria" ;
    :yValue "117.2" ;
    :belongsTo :Chart .

