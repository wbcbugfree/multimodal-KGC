@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Seat distribution for the political groups in the European Parliament of 2019 , by number of MEPs" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "political group" .

:YAxis a :Axis ;
    :title "Number of MEPs" .

:dataPoint1 a :dataPoint ;
    :xValue "Center-right (EPP)" ;
    :yValue "180" ;
    :belongsTo :Chart .

:dataPoint2 a :dataPoint ;
    :xValue "Center-left (S&D)" ;
    :yValue "146" ;
    :belongsTo :Chart .

:dataPoint3 a :dataPoint ;
    :xValue "Liberals (ALDE)" ;
    :yValue "109" ;
    :belongsTo :Chart .

:dataPoint4 a :dataPoint ;
    :xValue "Greens (EFA)" ;
    :yValue "69" ;
    :belongsTo :Chart .

:dataPoint5 a :dataPoint ;
    :xValue "Conservatives (ECR)" ;
    :yValue "62" ;
    :belongsTo :Chart .

:dataPoint6 a :dataPoint ;
    :xValue "Right-wing nationalists (ENF)" ;
    :yValue "58" ;
    :belongsTo :Chart .

:dataPoint7 a :dataPoint ;
    :xValue "Populists (EFDD)" ;
    :yValue "54" ;
    :belongsTo :Chart .

:dataPoint8 a :dataPoint ;
    :xValue "Left (GUE/NGL)" ;
    :yValue "39" ;
    :belongsTo :Chart .

:dataPoint9 a :dataPoint ;
    :xValue "Others" ;
    :yValue "29" ;
    :belongsTo :Chart .

:dataPoint10 a :dataPoint ;
    :xValue "Independent" ;
    :yValue "8" ;
    :belongsTo :Chart .
