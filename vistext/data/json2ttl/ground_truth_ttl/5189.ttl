@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Ranking of countries with the highest share of alcohol-related deaths in 2012" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "Share of alcohol-attributable deaths" .

:dataPoint1 a :dataPoint ;
    :xValue "Belarus" ;
    :yValue "0.347" ;
    :belongsTo :Chart .

:dataPoint2 a :dataPoint ;
    :xValue "Ukraine" ;
    :yValue "0.344" ;
    :belongsTo :Chart .

:dataPoint3 a :dataPoint ;
    :xValue "Moldova" ;
    :yValue "0.331" ;
    :belongsTo :Chart .

:dataPoint4 a :dataPoint ;
    :xValue "Lithuania" ;
    :yValue "0.309" ;
    :belongsTo :Chart .

:dataPoint5 a :dataPoint ;
    :xValue "Russia" ;
    :yValue "0.305" ;
    :belongsTo :Chart .

:dataPoint6 a :dataPoint ;
    :xValue "Latvia" ;
    :yValue "0.244" ;
    :belongsTo :Chart .

:dataPoint7 a :dataPoint ;
    :xValue "Estonia" ;
    :yValue "0.214" ;
    :belongsTo :Chart .

:dataPoint8 a :dataPoint ;
    :xValue "Venezuela" ;
    :yValue "0.108" ;
    :belongsTo :Chart .

:dataPoint9 a :dataPoint ;
    :xValue "Mongolia" ;
