@prefix : <http://example.org/> .

:Chart a :AreaChart ;
    :title "Revenue of Johnson & Johnson 's pharmaceuticals segment worldwide from 2012 to 2024 , by product category (in billion U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Cardiovascular/Metabolism/Other" .

