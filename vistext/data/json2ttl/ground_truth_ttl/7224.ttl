@prefix : <http://example.org/> .

:Chart a :AreaChart ;
    :title "How worried are you about the possibility of future terrorist attacks in the U.S. ?" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "Not at all" .

:dataPoint1 a :dataPoint ;
    :xValue "Mar 03, 2006" ;
    :yValue "0.09" ;
    :belongsTo :Chart .

