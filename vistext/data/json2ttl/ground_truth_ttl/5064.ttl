@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Key euro-zone country contribution to the European Stability Mechanism (ESM)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Percentage of contribution" .

:YAxis a :Axis ;
    :title "Response" .

