@prefix : <http://example.org/> .

:Chart a :LineChart ;
    :title "Total Medicare spending from 1970 to 2019 (in billion U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Total spending in billion U.S. dollars" .

