@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Monthly export value of fish , crustaceans , shellfish and other fishery products in Canada from 2015 to 2020 (in million Canadian dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Month" .

:YAxis a :Axis ;
    :title "2018" .

