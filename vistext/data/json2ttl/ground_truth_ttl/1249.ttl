@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Most popular gaming genres on Kickstarter and Indiegogo as of May 2014 , by funds raised (in million U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Gaming genre" .

:YAxis a :Axis ;
    :title "Successful funding in million U.S. dollars" .

:dataPoint1 a :dataPoint ;
    :xValue "Strategy" ;
    :yValue "9.14" ;
    :belongsTo :Chart .

:dataPoint2 a :dataPoint ;
    :xValue "Action" ;
    :yValue "8.78" ;
    :belongsTo :Chart .

:dataPoint3 a :dataPoint ;
    :xValue "RPG" ;
    :yValue "7.68" ;
    :belongsTo :Chart .

:dataPoint4 a :dataPoint ;
    :xValue "Adventure" ;
    :yValue "5.33" ;
    :belongsTo :Chart .

:dataPoint5 a :dataPoint ;
    :xValue "Simulation" ;
    :yValue "1.86" ;
    :belongsTo :Chart .

:dataPoint6 a :dataPoint ;
    :xValue "Shooter" ;
    :yValue "1.08" ;
    :belongsTo :Chart .

:dataPoint7 a :dataPoint ;
    :xValue "Fighting" ;
    :yValue "0.94" ;
    :belongsTo :Chart .

:dataPoint8 a :dataPoint ;
    :xValue "Platformer" ;
    :yValue "0.8" ;
    :belongsTo :Chart .

:dataPoint9 a :dataPoint ;
    :xValue "Puzzle" ;
    :yValue "0.24" ;
    :belongsTo :Chart .

:dataPoint10 a :dataPoint ;
    :xValue "Racing" ;
    :yValue "0.1" ;
    :belongsTo :Chart .
