@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Leading countries for Italian cosmetic industry exports from 2014 to 2019 (in million euros)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Country" .

:YAxis a :Axis ;
    :title "2019" .

:dataPoint1 a :dataPoint ;
    :xValue "Franc" ;
    :yValue "609" ;
    :belongsTo :Chart .

:dataPoint2 a :dataPoint ;
    :xValue "Country: France German" ;
    :yValue "562" ;
    :belongsTo :Chart .

:dataPoint3 a :dataPoint ;
    :xValue "Country: Germany United State" ;
    :yValue "513" ;
    :belongsTo :Chart .

:dataPoint4 a :dataPoint ;
    :xValue "Country: United States United Kingdo" ;
    :yValue "351" ;
    :belongsTo :Chart .

:dataPoint5 a :dataPoint ;
    :xValue "Country: United Kingdom Spai" ;
    :yValue "294" ;
    :belongsTo :Chart .

:dataPoint6 a :dataPoint ;
    :xValue "Country: Spain Hong Kon" ;
    :yValue "244" ;
    :belongsTo :Chart .

:dataPoint7 a :dataPoint ;
    :xValue "Country: Hong Kong Netherland" ;
    :yValue "171" ;
    :belongsTo :Chart .

:dataPoint8 a :dataPoint ;
    :xValue "Country: Netherlands United Arab Emirate" ;
    :yValue "139" ;
    :belongsTo :Chart .

:dataPoint9 a :dataPoint ;
    :xValue "Country: United Arab Emirates Polan" ;
    :yValue "156" ;
    :belongsTo :Chart .

:dataPoint10 a :dataPoint ;
    :xValue "Country: Poland Belgiu" ;
    :yValue "140" ;
    :belongsTo :Chart .
