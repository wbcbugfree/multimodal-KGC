@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Top ten media markets for the 2016 presidential general election in the United States , as of August 18 , 2016 , by ad airings" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "media market" .

:YAxis a :Axis ;
    :title "Number of ads aired" .

:dataPoint1 a :dataPoint ;
    :xValue "Tampa , FL" ;
    :yValue "6553" ;
    :belongsTo :Chart .

