@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Ranking of religious groups in the United States in 2010 , by county penetration rate" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "Percentage of counties present" .

