@prefix : <http://example.org/> .

:Chart a :AreaChart ;
    :title "Vending machines - total sales volume in the U.S. from 1999 to 2010 (in billion U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Vended volume (in billion U.S. dollars)" .

:dataPoint1 a :dataPoint ;
    :xValue "Dec 31, 1998" ;
    :yValue "36.6" ;
    :belongsTo :Chart .

