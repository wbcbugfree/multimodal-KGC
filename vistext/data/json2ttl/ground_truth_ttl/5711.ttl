@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Vending machines - total sales volume in the U.S. from 1999 to 2010 (in billion U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Vended volume (in billion U.S. dollars)" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 1998" ;
    :yValue "36.6" ;
    :belongsTo :Chart .

