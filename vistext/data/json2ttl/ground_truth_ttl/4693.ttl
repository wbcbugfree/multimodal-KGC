@prefix : <http://example.org/> .

:Chart a :LineChart ;
    :title "Immigration rate in Luxembourg from 2008 to 2019 (per 1,000 inhabitants)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Immigration rate per thousand inhabitants" .

:dataPoint1 a :dataPoint ;
    :xValue "Dec 31, 2007" ;
    :yValue "36.34" ;
    :belongsTo :Chart .

:dataPoint2 a :dataPoint ;
    :xValue "Dec 31, 2008" ;
    :yValue "31.64" ;
    :belongsTo :Chart .

:dataPoint3 a :dataPoint ;
    :xValue "Dec 31, 2009" ;
    :yValue "33.46" ;
    :belongsTo :Chart .

:dataPoint4 a :dataPoint ;
    :xValue "Dec 31, 2010" ;
    :yValue "39.09" ;
    :belongsTo :Chart .

:dataPoint5 a :dataPoint ;
    :xValue "Dec 31, 2011" ;
    :yValue "38.57" ;
    :belongsTo :Chart .

:dataPoint6 a :dataPoint ;
    :xValue "Dec 31, 2012" ;
    :yValue "38.83" ;
    :belongsTo :Chart .

:dataPoint7 a :dataPoint ;
    :xValue "Dec 31, 2013" ;
    :yValue "40.14" ;
    :belongsTo :Chart .

:dataPoint8 a :dataPoint ;
    :xValue "Dec 31, 2014" ;
    :yValue "41.79" ;
    :belongsTo :Chart .

:dataPoint9 a :dataPoint ;
    :xValue "Dec 31, 2015" ;
    :yValue "39.23" ;
    :belongsTo :Chart .

:dataPoint10 a :dataPoint ;
    :xValue "Dec 31, 2016" ;
    :yValue "40.88" ;
    :belongsTo :Chart .

:dataPoint11 a :dataPoint ;
    :xValue "Dec 31, 2017" ;
