@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Number of deaths from stroke in Northern Ireland in 2018 , by gender and age" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Men" .

:YAxis a :Axis ;
    :title "age group" .

:dataPoint1 a :dataPoint ;
    :xValue "1" ;
    :yValue "45-49 years" ;
    :belongsTo :Chart .

:dataPoint2 a :dataPoint ;
    :xValue "0" ;
    :yValue "50-54 years" ;
    :belongsTo :Chart .

:dataPoint3 a :dataPoint ;
    :xValue "0" ;
    :yValue "55-59 years" ;
    :belongsTo :Chart .

:dataPoint4 a :dataPoint ;
    :xValue "3" ;
    :yValue "60-64 years" ;
    :belongsTo :Chart .

:dataPoint5 a :dataPoint ;
    :xValue "4" ;
    :yValue "65-69 years" ;
    :belongsTo :Chart .

:dataPoint6 a :dataPoint ;
    :xValue "24" ;
    :yValue "70-74 years" ;
    :belongsTo :Chart .

:dataPoint7 a :dataPoint ;
    :xValue "24" ;
    :yValue "75-59 years" ;
    :belongsTo :Chart .

:dataPoint8 a :dataPoint ;
    :xValue "43" ;
    :yValue "80-84 years" ;
    :belongsTo :Chart .

:dataPoint9 a :dataPoint ;
    :xValue "34" ;
    :yValue "85-89 years" ;
    :belongsTo :Chart .

:dataPoint10 a :dataPoint ;
    :xValue "90" ;
    :yValue "years and over" ;
    :belongsTo :Chart .
