@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Share of votes in the Brexit referendum of 2016 in the United Kingdom , by region" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "region of the united kingdom" .

:YAxis a :Axis ;
    :title "Leave" .

:dataPoint1 a :dataPoint ;
    :xValue "Scotland" ;
    :yValue "0.38" ;
    :belongsTo :Chart .

:dataPoint2 a :dataPoint ;
    :xValue "London" ;
    :yValue "0.401" ;
    :belongsTo :Chart .

:dataPoint3 a :dataPoint ;
    :xValue "Northern Ireland" ;
    :yValue "0.442" ;
    :belongsTo :Chart .

:dataPoint4 a :dataPoint ;
    :xValue "South East" ;
    :yValue "0.518" ;
    :belongsTo :Chart .

:dataPoint5 a :dataPoint ;
    :xValue "Wales" ;
    :yValue "0.525" ;
    :belongsTo :Chart .

:dataPoint6 a :dataPoint ;
    :xValue "South West" ;
    :yValue "0.526" ;
    :belongsTo :Chart .

:dataPoint7 a :dataPoint ;
    :xValue "North West" ;
    :yValue "0.537" ;
    :belongsTo :Chart .

:dataPoint8 a :dataPoint ;
    :xValue "East" ;
    :yValue "0.565" ;
    :belongsTo :Chart .

:dataPoint9 a :dataPoint ;
    :xValue "Yorkshire and the Humber" ;
    :yValue "0.577" ;
    :belongsTo :Chart .

:dataPoint10 a :dataPoint ;
    :xValue "North East" ;
    :yValue "0.58" ;
    :belongsTo :Chart .

:dataPoint11 a :dataPoint ;
    :xValue "East Midlands" ;
    :yValue "0.588" ;
    :belongsTo :Chart .

:dataPoint12 a :dataPoint ;
    :xValue "West Midlands" ;
    :yValue "0.593" ;
    :belongsTo :Chart .
