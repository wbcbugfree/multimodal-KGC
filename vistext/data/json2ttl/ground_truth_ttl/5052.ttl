@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Most commonly encountered types of malware used in industrial cyber attacks worldwide in 2019" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Share of encounters" .

:YAxis a :Axis ;
    :title "Response" .

:dataPoint1 a :dataPoint ;
    :xValue "0.249" ;
    :yValue "Downloader" ;
    :belongsTo :Chart .

:dataPoint2 a :dataPoint ;
    :xValue "0.155" ;
    :yValue "Remote access trojan" ;
    :belongsTo :Chart .

:dataPoint3 a :dataPoint ;
    :xValue "0.079" ;
    :yValue "Bot" ;
    :belongsTo :Chart .

:dataPoint4 a :dataPoint ;
    :xValue "0.076" ;
    :yValue "Password utility" ;
    :belongsTo :Chart .

:dataPoint5 a :dataPoint ;
    :xValue "0.072" ;
    :yValue "Coin miner" ;
    :belongsTo :Chart .

:dataPoint6 a :dataPoint ;
    :xValue "0.065" ;
    :yValue "Keylogger" ;
    :belongsTo :Chart .

:dataPoint7 a :dataPoint ;
    :xValue "0.051" ;
    :yValue "Web shell" ;
    :belongsTo :Chart .

:dataPoint8 a :dataPoint ;
    :xValue "0.047" ;
    :yValue "Privilege escalation" ;
    :belongsTo :Chart .

:dataPoint9 a :dataPoint ;
    :xValue "0.043" ;
    :yValue "Reverse shell" ;
    :belongsTo :Chart .

:dataPoint10 a :dataPoint ;
    :xValue "0.036" ;
    :yValue "Phishing" ;
    :belongsTo :Chart .

:dataPoint11 a :dataPoint ;
    :xValue "0.036" ;
    :yValue "Worm" ;
    :belongsTo :Chart .
