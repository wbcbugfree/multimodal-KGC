@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Most commonly encountered types of malware used in industrial cyber attacks worldwide in 2019" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Share of encounters" .

:YAxis a :Axis ;
    :title "Response" .

:DataPoint1 a :DataPoint ;
    :xValue "0.249" ;
    :yValue "Downloader" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "0.155" ;
    :yValue "Remote access trojan" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "0.079" ;
    :yValue "Bot" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "0.076" ;
    :yValue "Password utility" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "0.072" ;
    :yValue "Coin miner" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "0.065" ;
    :yValue "Keylogger" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "0.051" ;
    :yValue "Web shell" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "0.047" ;
    :yValue "Privilege escalation" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "0.043" ;
    :yValue "Reverse shell" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "0.036" ;
    :yValue "Phishing" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "0.036" ;
    :yValue "Worm" ;
    :belongsTo :Chart .
