@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Lifetime luxury tax payments of Major League Baseball clubs 1997 - 2012 (in million U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "baseball team" .

:YAxis a :Axis ;
    :title "Luxury tax payments in million U.S. dollars" .

:dataPoint1 a :dataPoint ;
    :xValue "New York Yankees" ;
    :yValue "225.1" ;
    :belongsTo :Chart .

