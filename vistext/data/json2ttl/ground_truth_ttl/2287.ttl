@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Gay and Lesbian Americans : Who lives in your household ?" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "Share of respondents" .

:DataPoint1 a :DataPoint ;
    :xValue "I live with a spouse, partner, lover" ;
    :yValue "0.463" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "I live alone" ;
    :yValue "0.293" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "I live with a dog" ;
    :yValue "0.273" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "I live with a cat" ;
    :yValue "0.232" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "I live with one or more roommates" ;
    :yValue "0.123" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "I live with one or more parents" ;
    :yValue "0.066" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "I live with one or more child(ren) under 18" ;
    :yValue "0.066" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "I live with another type of pet (not dog or cat)" ;
    :yValue "0.063" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "I live with one or more brother(s) or sister(s)" ;
    :yValue "0.029" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "I live with one or more child(ren) over 18" ;
    :yValue "0.025" ;
    :belongsTo :Chart .
