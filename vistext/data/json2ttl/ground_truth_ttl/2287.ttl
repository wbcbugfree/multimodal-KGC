@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Gay and Lesbian Americans : Who lives in your household ?" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "Share of respondents" .

:dataPoint1 a :dataPoint ;
    :xValue "I live with a spouse, partner, lover" ;
    :yValue "0.463" ;
    :belongsTo :Chart .

:dataPoint2 a :dataPoint ;
    :xValue "I live alone" ;
    :yValue "0.293" ;
    :belongsTo :Chart .

:dataPoint3 a :dataPoint ;
    :xValue "I live with a dog" ;
    :yValue "0.273" ;
    :belongsTo :Chart .

:dataPoint4 a :dataPoint ;
    :xValue "I live with a cat" ;
    :yValue "0.232" ;
    :belongsTo :Chart .

:dataPoint5 a :dataPoint ;
    :xValue "I live with one or more roommates" ;
    :yValue "0.123" ;
    :belongsTo :Chart .

:dataPoint6 a :dataPoint ;
    :xValue "I live with one or more parents" ;
    :yValue "0.066" ;
    :belongsTo :Chart .

:dataPoint7 a :dataPoint ;
    :xValue "I live with one or more child(ren) under" ;
    :yValue "18" ;
    :belongsTo :Chart .

:dataPoint8 a :dataPoint ;
    :xValue "I live with another type of pet (not dog or cat)" ;
    :yValue "0.063" ;
    :belongsTo :Chart .

:dataPoint9 a :dataPoint ;
    :xValue "I live with one or more brother(s) or sister(s)" ;
    :yValue "0.029" ;
    :belongsTo :Chart .

:dataPoint10 a :dataPoint ;
    :xValue "I live with one or more child(ren) over" ;
    :yValue "18" ;
    :belongsTo :Chart .
