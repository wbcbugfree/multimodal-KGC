@prefix : <http://example.org/> .

:Chart a :AreaChart ;
    :title "Number of Deloitte employees worldwide from 2010 to 2020 , by level" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Level" .

:YAxis a :Axis ;
    :title "Partners" .

:dataPoint1 a :dataPoint ;
    :xValue "Dec 31, 2009" ;
    :yValue "9538" ;
    :belongsTo :Chart .

