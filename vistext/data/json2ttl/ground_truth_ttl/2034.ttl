    :yValue "15411" ;
    :belongsTo :Chart .

:dataPoint6 a :dataPoint ;
    :xValue "Manitoba" ;
    :yValue "13275" ;
    :belongsTo :Chart .

:dataPoint7 a :dataPoint ;
    :xValue "Saskatchewan" ;
    :yValue "11199" ;
    :belongsTo :Chart .

:dataPoint8 a :dataPoint ;
    :xValue "New Brunswick" ;
    :yValue "8193" ;
    :belongsTo :Chart .

:dataPoint9 a :dataPoint ;
    :xValue "Newfoundland and Labrador" ;
