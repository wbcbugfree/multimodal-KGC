@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Number of students graduated from postsecondary institutions in Canada in 2017 , by province" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Province" .

:YAxis a :Axis ;
    :title "Number of students" .

:dataPoint1 a :dataPoint ;
    :xValue "Ontario" ;
    :yValue "222063" ;
    :belongsTo :Chart .

:dataPoint2 a :dataPoint ;
    :xValue "Quebec" ;
    :yValue "152292" ;
    :belongsTo :Chart .

