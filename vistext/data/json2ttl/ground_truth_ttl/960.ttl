@prefix : <http://example.org/> .

:Chart a :AreaChart ;
    :title "Cambodia : Life expectancy at birth from 2008 to 2018" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Life expectancy at birth in years" .

:dataPoint1 a :dataPoint ;
    :xValue "Dec 31, 2007" ;
    :yValue "65.39" ;
    :belongsTo :Chart .

