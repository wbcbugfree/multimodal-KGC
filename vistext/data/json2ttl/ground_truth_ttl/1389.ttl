@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Latin American and Caribbean countries with the largest number of international tourist arrivals in 2018 (in millions)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Country" .

:YAxis a :Axis ;
    :title "Number of arrivals in millions" .

:dataPoint1 a :dataPoint ;
    :xValue "Mexico" ;
    :yValue "41.45" ;
    :belongsTo :Chart .

