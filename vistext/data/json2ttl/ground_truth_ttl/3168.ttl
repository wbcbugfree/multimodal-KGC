@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Factor weighted gender pay gap in selected countries in Latin America and the Caribbean in 2016" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Gender pay gap" .

:YAxis a :Axis ;
    :title "Country" .

:dataPoint1 a :dataPoint ;
    :xValue "0.264" ;
    :yValue "Brazil" ;
    :belongsTo :Chart .

:dataPoint2 a :dataPoint ;
    :xValue "0.237" ;
    :yValue "Chile" ;
    :belongsTo :Chart .

:dataPoint3 a :dataPoint ;
    :xValue "0.173" ;
    :yValue "Uruguay" ;
    :belongsTo :Chart .

:dataPoint4 a :dataPoint ;
    :xValue "0.169" ;
    :yValue "Paraguay" ;
    :belongsTo :Chart .

:dataPoint5 a :dataPoint ;
    :xValue "0.162" ;
    :yValue "Peru" ;
    :belongsTo :Chart .

:dataPoint6 a :dataPoint ;
    :xValue "0.16" ;
    :yValue "El Salvador" ;
    :belongsTo :Chart .

:dataPoint7 a :dataPoint ;
    :xValue "0.156" ;
    :yValue "Mexico" ;
    :belongsTo :Chart .

:dataPoint8 a :dataPoint ;
    :xValue "0.13" ;
    :yValue "Argentina" ;
    :belongsTo :Chart .

:dataPoint9 a :dataPoint ;
    :xValue "0.123" ;
    :yValue "Costa Rica" ;
    :belongsTo :Chart .

:dataPoint10 a :dataPoint ;
    :xValue "0.119" ;
    :yValue "Ecuador" ;
    :belongsTo :Chart .

:dataPoint11 a :dataPoint ;
    :xValue "0.11" ;
    :yValue "Panama" ;
    :belongsTo :Chart .
