@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Market share of the leading contact lens retailers on JD.com in China as of July 2017 , by brand" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Market share" .

:YAxis a :Axis ;
    :title "leading contact lens retailers" .

:dataPoint1 a :dataPoint ;
    :xValue "0.4267" ;
    :yValue "Bausch & Lomb" ;
    :belongsTo :Chart .

