@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Ranking of the top trading partners of the United States for trade goods in 2019 , by export value (in billion U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Country" .

:YAxis a :Axis ;
    :title "Export value in billion U.S. dollars" .

:DataPoint1 a :DataPoint ;
    :xValue "Canada" ;
    :yValue "292.7" ;
    :belongsTo :Chart .

