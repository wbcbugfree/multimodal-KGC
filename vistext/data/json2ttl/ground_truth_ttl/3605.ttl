@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Reported number of slaves owned by U.S. presidents who served from 1789 to 1877 (throughout their lifetimes)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Number of slaves" .

:YAxis a :Axis ;
    :title "U\\.S\\. president" .

