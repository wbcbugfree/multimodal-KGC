@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Given the current state of the business what are the CEO 's top three priorities for you to help business preserve through the current disruption ?" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "Share of respondents" .

:dataPoint1 a :dataPoint ;
    :xValue "Lead digital buisness/digital transformation activities" ;
    :yValue "0.37" ;
    :belongsTo :Chart .

:dataPoint2 a :dataPoint ;
    :xValue "Improve remote work experiences" ;
    :yValue "0.37" ;
    :belongsTo :Chart .

:dataPoint3 a :dataPoint ;
    :xValue "Upgrade IT and data security to boost corporate resiliency" ;
    :yValue "0.29" ;
    :belongsTo :Chart .

:dataPoint4 a :dataPoint ;
    :xValue "Reduce or rationalize IT spending" ;
    :yValue "0.28" ;
    :belongsTo :Chart .

:dataPoint5 a :dataPoint ;
    :xValue "Help reach specific goal for corporate revenue growth" ;
    :yValue "0.25" ;
    :belongsTo :Chart .

:dataPoint6 a :dataPoint ;
    :xValue "Identify new data-driven business opportunities" ;
    :yValue "0.24" ;
    :belongsTo :Chart .

:dataPoint7 a :dataPoint ;
    :xValue "Enable new plan for customer acquisition & retention" ;
    :yValue "0.23" ;
    :belongsTo :Chart .

:dataPoint8 a :dataPoint ;
    :xValue "Collaborate with business departments om major customer initiative" ;
    :yValue "0.22" ;
    :belongsTo :Chart .

:dataPoint9 a :dataPoint ;
    :xValue "Lead a product innovation effort" ;
    :yValue "0.14" ;
    :belongsTo :Chart .

:dataPoint10 a :dataPoint ;
    :xValue "Increases collaboration with LOB to help streamline technology purchases" ;
    :yValue "0.11" ;
    :belongsTo :Chart .

:dataPoint11 a :dataPoint ;
    :xValue "Lead merger integration or due dilligence on a potential acquisition" ;
    :yValue "0.08" ;
    :belongsTo :Chart .
