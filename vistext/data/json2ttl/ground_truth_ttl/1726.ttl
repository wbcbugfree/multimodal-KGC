@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Monthly number of inactive labor force of the United States from November 2019 to November 2020 (in millions , seasonally adjusted)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Month" .

:YAxis a :Axis ;
    :title "Number of people in millions" .

:dataPoint1 a :dataPoint ;
    :xValue "Nov '20" ;
    :yValue "100.62" ;
    :belongsTo :Chart .

