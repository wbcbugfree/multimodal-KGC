@prefix : <http://example.org/> .

:Chart a :AreaChart ;
    :title "Total amount of investment of private equity companies in Denmark from 2007 to 2016 (in million euros)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Total investment in million euros" .

:dataPoint1 a :dataPoint ;
    :xValue "Dec 31, 2006" ;
    :yValue "1426.88" ;
    :belongsTo :Chart .

