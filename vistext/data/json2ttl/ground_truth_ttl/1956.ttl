@prefix : <http://example.org/> .

:Chart a :LineChart ;
    :title "Peppermint oil production value in the U.S. from 2000 to 2018 (in 1,000 U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Production value in thousand U.S. dollars" .

