@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Proportion of young people reading various media outside of class in the United Kingdom (UK) from 2014 to 2019" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "media read by young people" .

:YAxis a :Axis ;
    :title "2017/18" .

:dataPoint1 a :dataPoint ;
    :xValue "Text messages" ;
    :yValue "0.888" ;
    :belongsTo :Chart .

:dataPoint2 a :dataPoint ;
    :xValue "Instant messages" ;
    :yValue "0.79" ;
    :belongsTo :Chart .

:dataPoint3 a :dataPoint ;
    :xValue "Websites" ;
    :yValue "0.84" ;
    :belongsTo :Chart .

:dataPoint4 a :dataPoint ;
    :xValue "Lyrics" ;
    :yValue "0.478" ;
    :belongsTo :Chart .

:dataPoint5 a :dataPoint ;
    :xValue "Fiction" ;
    :yValue "0.549" ;
    :belongsTo :Chart .

:dataPoint6 a :dataPoint ;
    :xValue "Non-fiction" ;
    :yValue "0.485" ;
    :belongsTo :Chart .

:dataPoint7 a :dataPoint ;
    :xValue "Newspapers" ;
    :yValue "0.307" ;
    :belongsTo :Chart .

:dataPoint8 a :dataPoint ;
    :xValue "Magazines" ;
    :yValue "0.348" ;
    :belongsTo :Chart .

:dataPoint9 a :dataPoint ;
    :xValue "Comics" ;
    :yValue "0.399" ;
    :belongsTo :Chart .

:dataPoint10 a :dataPoint ;
    :xValue "Poems" ;
    :yValue "0.172" ;
    :belongsTo :Chart .
