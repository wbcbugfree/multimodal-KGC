@prefix : <http://example.org/> .

:Chart a :LineChart ;
    :title "Per capita consumption of fresh sweet corn in the United States from 2000 to 2019 (in pounds)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Per capita consumption in pounds" .

