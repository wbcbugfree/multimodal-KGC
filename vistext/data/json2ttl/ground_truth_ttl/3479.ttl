@prefix : <http://example.org/> .

:Chart a :AreaChart ;
    :title "Number of general pediatricians employed in Poland from 2003 to 2017" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Number of employees" .

