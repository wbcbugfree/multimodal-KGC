@prefix : <http://example.org/> .

:Chart a :LineChart ;
    :title "Do you ever play games at home or elsewhere in any of these ways ?" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "Mobile phone" .

:dataPoint1 a :dataPoint ;
    :xValue "Dec 31, 2008" ;
    :yValue "0.06" ;
    :belongsTo :Chart .

