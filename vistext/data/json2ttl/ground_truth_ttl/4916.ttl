@prefix : <http://example.org/> .

:Chart a :LineChart ;
    :title "Chicago Bears franchise value from 2002 to 2020 (in million U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Franchise value in million U.S. dollars" .

