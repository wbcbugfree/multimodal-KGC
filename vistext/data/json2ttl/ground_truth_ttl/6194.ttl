@prefix : <http://example.org/> .

:Chart a :AreaChart ;
    :title "Latin America & Caribbean : Age distribution from 2009 to 2019" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "15-64 years" .

