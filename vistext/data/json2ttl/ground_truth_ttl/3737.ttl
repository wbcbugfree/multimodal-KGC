@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Distribution of annual greenhouse gas emissions worldwide in 2017 , by select country" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "Share of emissions" .

:DataPoint1 a :DataPoint ;
    :xValue "China" ;
    :yValue "0.266" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "United States" ;
    :yValue "0.131" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "India" ;
    :yValue "0.071" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "Russia" ;
    :yValue "0.046" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "Japan" ;
    :yValue "0.029" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Brazil" ;
    :yValue "0.024" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Indonesia" ;
    :yValue "0.018" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Iran" ;
    :yValue "0.018" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "Canada" ;
    :yValue "0.016" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "Mexico" ;
    :yValue "0.015" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "Rest of the world" ;
    :yValue "0.366" ;
    :belongsTo :Chart .
