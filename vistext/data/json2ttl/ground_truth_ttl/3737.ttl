@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Distribution of annual greenhouse gas emissions worldwide in 2017 , by select country" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "Share of emissions" .

:dataPoint1 a :dataPoint ;
    :xValue "China" ;
    :yValue "0.266" ;
    :belongsTo :Chart .

:dataPoint2 a :dataPoint ;
    :xValue "United States" ;
    :yValue "0.131" ;
    :belongsTo :Chart .

:dataPoint3 a :dataPoint ;
    :xValue "India" ;
    :yValue "0.071" ;
    :belongsTo :Chart .

:dataPoint4 a :dataPoint ;
    :xValue "Russia" ;
    :yValue "0.046" ;
    :belongsTo :Chart .

:dataPoint5 a :dataPoint ;
    :xValue "Japan" ;
    :yValue "0.029" ;
    :belongsTo :Chart .

:dataPoint6 a :dataPoint ;
    :xValue "Brazil" ;
    :yValue "0.024" ;
    :belongsTo :Chart .

:dataPoint7 a :dataPoint ;
    :xValue "Indonesia" ;
    :yValue "0.018" ;
    :belongsTo :Chart .

:dataPoint8 a :dataPoint ;
    :xValue "Iran" ;
    :yValue "0.018" ;
    :belongsTo :Chart .

:dataPoint9 a :dataPoint ;
    :xValue "Canada" ;
