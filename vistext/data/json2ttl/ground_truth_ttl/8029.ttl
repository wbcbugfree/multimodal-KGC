    :yValue "0.1401" ;
    :belongsTo :Chart .

:dataPoint6 a :dataPoint ;
    :xValue "Dec 31, 2013" ;
    :yValue "0.1434" ;
    :belongsTo :Chart .

:dataPoint7 a :dataPoint ;
