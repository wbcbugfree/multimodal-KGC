@prefix : <http://example.org/> .

:Chart a :LineChart ;
    :title "Barbados : Age structure from 2009 to 2019" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "65 years and older" .

:dataPoint1 a :dataPoint ;
    :xValue "Dec 31, 2008" ;
    :yValue "0.13" ;
    :belongsTo :Chart .

:dataPoint2 a :dataPoint ;
    :xValue "Dec 31, 2009" ;
    :yValue "0.1325" ;
    :belongsTo :Chart .

