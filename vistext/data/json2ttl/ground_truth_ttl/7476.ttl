@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Denomination of counterfeit euro banknotes withdrawn from circulation in Europe from the 1st half of 2015 to the 2nd half of 2019" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Hundred euro" .

:YAxis a :Axis ;
    :title "half a year" .

:dataPoint1 a :dataPoint ;
    :xValue "0.096" ;
    :yValue "H2 2019" ;
    :belongsTo :Chart .

:dataPoint2 a :dataPoint ;
    :xValue "0.104" ;
    :yValue "H1 2019" ;
    :belongsTo :Chart .

:dataPoint3 a :dataPoint ;
    :xValue "0.09" ;
    :yValue "H2 2018" ;
    :belongsTo :Chart .

:dataPoint4 a :dataPoint ;
    :xValue "0.109" ;
    :yValue "H1 2018" ;
    :belongsTo :Chart .

:dataPoint5 a :dataPoint ;
    :xValue "0.065" ;
    :yValue "H2 2017" ;
    :belongsTo :Chart .

:dataPoint6 a :dataPoint ;
    :xValue "0.09" ;
    :yValue "H1 2017" ;
    :belongsTo :Chart .

:dataPoint7 a :dataPoint ;
    :xValue "0.097" ;
    :yValue "H2 2016" ;
    :belongsTo :Chart .

:dataPoint8 a :dataPoint ;
    :xValue "0.111" ;
    :yValue "H1 2016" ;
    :belongsTo :Chart .

:dataPoint9 a :dataPoint ;
    :xValue "0.101" ;
    :yValue "H2 2015" ;
    :belongsTo :Chart .

:dataPoint10 a :dataPoint ;
    :xValue "0.085" ;
    :yValue "H1 2015" ;
    :belongsTo :Chart .
