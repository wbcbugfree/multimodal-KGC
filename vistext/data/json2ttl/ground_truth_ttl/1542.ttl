@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Top 10 U.S. for-profit hospitals based on the number of beds as of 2015" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Hospital (Location)" .

:YAxis a :Axis ;
    :title "Number of beds" .

:dataPoint1 a :dataPoint ;
    :xValue "Methodist Hospital (San Antonio, Texas)" ;
    :yValue "1561" ;
    :belongsTo :Chart .

:dataPoint2 a :dataPoint ;
    :xValue "Edinburg (Texas) Regional Medical Center" ;
    :yValue "816" ;
    :belongsTo :Chart .

:dataPoint3 a :dataPoint ;
    :xValue "Chippenham Hospital (Richmond, Va.)" ;
    :yValue "793" ;
    :belongsTo :Chart .

:dataPoint4 a :dataPoint ;
    :xValue "North Shore Medical Center (Miami, Fla.)" ;
    :yValue "771" ;
    :belongsTo :Chart .

:dataPoint5 a :dataPoint ;
    :xValue "Henrico Doctor's Hospital (Richmond, Va.)" ;
    :yValue "733" ;
    :belongsTo :Chart .

:dataPoint6 a :dataPoint ;
    :xValue "Oklahoma University Medical Center (Oklahoma City)" ;
    :yValue "690" ;
    :belongsTo :Chart .

:dataPoint7 a :dataPoint ;
    :xValue "Medical City Hospital (Dallas)" ;
    :yValue "668" ;
    :belongsTo :Chart .

:dataPoint8 a :dataPoint ;
    :xValue "TriStar Centennial (Nashville, Tenn.)" ;
    :yValue "657" ;
    :belongsTo :Chart .

:dataPoint9 a :dataPoint ;
    :xValue "Plantation (Fla.) General Hospital" ;
    :yValue "655" ;
    :belongsTo :Chart .

:dataPoint10 a :dataPoint ;
    :xValue "Sunrise Hospital & Medical Center (Las Vegas)" ;
    :yValue "641" ;
    :belongsTo :Chart .
