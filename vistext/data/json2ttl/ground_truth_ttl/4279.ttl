@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Crime clearance rate in the United States in 2019 , by type" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Type of crime" .

:YAxis a :Axis ;
    :title "Percent of offenses cleared by arrest" .

:dataPoint1 a :dataPoint ;
    :xValue "Murder and nonnegligent, manslaughter" ;
    :yValue "0.614" ;
    :belongsTo :Chart .

:dataPoint2 a :dataPoint ;
    :xValue "Aggravated assault" ;
    :yValue "0.523" ;
    :belongsTo :Chart .

:dataPoint3 a :dataPoint ;
    :xValue "Violent crime" ;
    :yValue "0.455" ;
    :belongsTo :Chart .

:dataPoint4 a :dataPoint ;
    :xValue "Rape" ;
    :yValue "0.329" ;
    :belongsTo :Chart .

:dataPoint5 a :dataPoint ;
    :xValue "Robbery" ;
    :yValue "0.305" ;
    :belongsTo :Chart .

:dataPoint6 a :dataPoint ;
    :xValue "Arson" ;
    :yValue "0.238" ;
    :belongsTo :Chart .

:dataPoint7 a :dataPoint ;
    :xValue "Larceny-theft" ;
    :yValue "0.184" ;
    :belongsTo :Chart .

:dataPoint8 a :dataPoint ;
    :xValue "Property crime" ;
    :yValue "0.172" ;
    :belongsTo :Chart .

:dataPoint9 a :dataPoint ;
    :xValue "Burglary" ;
    :yValue "0.141" ;
    :belongsTo :Chart .

:dataPoint10 a :dataPoint ;
    :xValue "Motor vehicle theft" ;
    :yValue "0.138" ;
    :belongsTo :Chart .
