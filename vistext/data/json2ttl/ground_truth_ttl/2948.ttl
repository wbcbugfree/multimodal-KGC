@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Thinking about the people from the UK , from this list , which three , if any , do you think are the best characteristics from the UK as a whole ?" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Share of respondents" .

:YAxis a :Axis ;
    :title "Response" .

:dataPoint1 a :dataPoint ;
    :xValue "0.46" ;
    :yValue "Polite/good manners" ;
    :belongsTo :Chart .

:dataPoint2 a :dataPoint ;
    :xValue "0.37" ;
    :yValue "Educated and skilled" ;
    :belongsTo :Chart .

:dataPoint3 a :dataPoint ;
    :xValue "0.31" ;
    :yValue "Friendly" ;
    :belongsTo :Chart .

:dataPoint4 a :dataPoint ;
    :xValue "0.27" ;
    :yValue "Respect the rule of law" ;
    :belongsTo :Chart .

:dataPoint5 a :dataPoint ;
    :xValue "0.25" ;
    :yValue "Sense of humour" ;
    :belongsTo :Chart .

:dataPoint6 a :dataPoint ;
    :xValue "0.21" ;
    :yValue "Tolerant of people from other countries/with different beliefs" ;
    :belongsTo :Chart .

:dataPoint7 a :dataPoint ;
    :xValue "0.16" ;
    :yValue "Keep themselves to themselves" ;
    :belongsTo :Chart .

:dataPoint8 a :dataPoint ;
    :xValue "0.15" ;
    :yValue "Innovative and creative" ;
    :belongsTo :Chart .

:dataPoint9 a :dataPoint ;
    :xValue "0.15" ;
    :yValue "Patriotism" ;
    :belongsTo :Chart .

:dataPoint10 a :dataPoint ;
    :xValue "0.13" ;
    :yValue "Hard working" ;
    :belongsTo :Chart .
