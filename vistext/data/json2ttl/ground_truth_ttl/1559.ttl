@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Leading Chinese semiconductor companies in 2010 , based on revenue (in million U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Chinese Semiconductor Company" .

:YAxis a :Axis ;
    :title "Revenue in million U.S. dollars" .

:dataPoint1 a :dataPoint ;
    :xValue "HiSilicon Technologies Co., Ltd." ;
    :yValue "652" ;
    :belongsTo :Chart .

