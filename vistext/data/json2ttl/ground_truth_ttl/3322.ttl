@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Costa Rica : Birth rate from 2008 to 2018 (per 1,000 inhabitants)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Birth rate per thousand population" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2007" ;
    :yValue "16.04" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Dec 31, 2008" ;
    :yValue "15.88" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "Dec 31, 2009" ;
    :yValue "15.72" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "Dec 31, 2010" ;
    :yValue "15.55" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "Dec 31, 2011" ;
    :yValue "15.38" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Dec 31, 2012" ;
    :yValue "15.19" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Dec 31, 2013" ;
    :yValue "14.99" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Dec 31, 2014" ;
    :yValue "14.76" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "Dec 31, 2015" ;
    :yValue "14.51" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "Dec 31, 2016" ;
    :yValue "14.25" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "Dec 31, 2017" ;
    :yValue "13.97" ;
    :belongsTo :Chart .
