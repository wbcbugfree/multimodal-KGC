@prefix : <http://example.org/> .

:Chart a :LineChart ;
    :title "Year-on-year change in turnover of furniture manufacturing industry in the Netherlands from 2008 to 2019" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Percentage change in turnover" .

:DataPoint1 a :DataPoint ;
    :xValue "-0.062" ;
    :yValue "Dec 31, 2008" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "-0.168" ;
    :yValue "Dec 31, 2009" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "-0.004" ;
    :yValue "Dec 31, 2010" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "-0.036" ;
    :yValue "Dec 31, 2011" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "-0.003" ;
    :yValue "Dec 31, 2012" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "-0.081" ;
    :yValue "Dec 31, 2013" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "-0.012" ;
    :yValue "Dec 31, 2014" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "0.078" ;
    :yValue "Dec 31, 2015" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "0.037" ;
    :yValue "Dec 31, 2016" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "0.039" ;
    :yValue "Dec 31, 2017" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "0.064" ;
    :yValue "Dec 31, 2018" ;
    :belongsTo :Chart .
