@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Most valuable start-up companies based in New York in 2016 , by estimated value (in billion U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Company" .

:YAxis a :Axis ;
    :title "Estimated value in billion U.S. dollars" .

:dataPoint1 a :dataPoint ;
    :xValue "WeWork" ;
    :yValue "10" ;
    :belongsTo :Chart .

