@prefix : <http://example.org/> .

:Chart a :LineChart ;
    :title "Share of households with internet access in Germany from 2007 to 2019" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "Share of households" .

:dataPoint1 a :dataPoint ;
    :xValue "Dec 31, 2006" ;
    :yValue "0.71" ;
    :belongsTo :Chart .

