@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Leading barriers to implementing mobile marketing in North America in 2017" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Share of respondents" .

:YAxis a :Axis ;
    :title "Response" .

:dataPoint1 a :dataPoint ;
    :xValue "0.4" ;
    :yValue "Metrics and measurement" ;
    :belongsTo :Chart .

:dataPoint2 a :dataPoint ;
    :xValue "0.32" ;
    :yValue "Fragmentation of mobile ecosystem" ;
    :belongsTo :Chart .

:dataPoint3 a :dataPoint ;
    :xValue "0.28" ;
    :yValue "Internal challenges and silos" ;
    :belongsTo :Chart .

:dataPoint4 a :dataPoint ;
    :xValue "0.22" ;
    :yValue "Ad blocking" ;
    :belongsTo :Chart .

:dataPoint5 a :dataPoint ;
    :xValue "0.22" ;
    :yValue "Consumer provacy concerns" ;
    :belongsTo :Chart .

:dataPoint6 a :dataPoint ;
    :xValue "0.21" ;
    :yValue "Content creation for mobile" ;
    :belongsTo :Chart .

:dataPoint7 a :dataPoint ;
    :xValue "0.16" ;
    :yValue "Ad fraud" ;
    :belongsTo :Chart .

:dataPoint8 a :dataPoint ;
    :xValue "0.15" ;
    :yValue "Education" ;
    :belongsTo :Chart .

:dataPoint9 a :dataPoint ;
    :xValue "0.14" ;
    :yValue "Guidelines and best practices" ;
    :belongsTo :Chart .

:dataPoint10 a :dataPoint ;
    :xValue "0.12" ;
    :yValue "Budgets" ;
    :belongsTo :Chart .

:dataPoint11 a :dataPoint ;
    :xValue "0.12" ;
    :yValue "Lack of mobile friendly sites" ;
    :belongsTo :Chart .

:dataPoint12 a :dataPoint ;
    :xValue "0.1" ;
    :yValue "Poor quality mobile apps" ;
    :belongsTo :Chart .

:dataPoint13 a :dataPoint ;
    :xValue "0.08" ;
    :yValue "Skills" ;
    :belongsTo :Chart .

:dataPoint14 a :dataPoint ;
    :xValue "0.06" ;
    :yValue "Data pricing" ;
    :belongsTo :Chart .

:dataPoint15 a :dataPoint ;
    :xValue "0.03" ;
    :yValue "Evangelism" ;
    :belongsTo :Chart .

:dataPoint16 a :dataPoint ;
    :xValue "0.1" ;
    :yValue "Other" ;
    :belongsTo :Chart .
