@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Leading barriers to implementing mobile marketing in North America in 2017" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Share of respondents" .

:YAxis a :Axis ;
    :title "Response" .

:DataPoint1 a :DataPoint ;
    :xValue "0.4" ;
    :yValue "Metrics and measurement" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "0.32" ;
    :yValue "Fragmentation of mobile ecosystem" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "0.28" ;
    :yValue "Internal challenges and silos" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "0.22" ;
    :yValue "Ad blocking" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "0.22" ;
    :yValue "Consumer provacy concerns" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "0.21" ;
    :yValue "Content creation for mobile" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "0.16" ;
    :yValue "Ad fraud" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "0.15" ;
    :yValue "Education" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "0.14" ;
    :yValue "Guidelines and best practices" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "0.12" ;
    :yValue "Budgets" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "0.12" ;
    :yValue "Lack of mobile friendly sites" ;
    :belongsTo :Chart .

:DataPoint12 a :DataPoint ;
    :xValue "0.1" ;
    :yValue "Poor quality mobile apps" ;
    :belongsTo :Chart .

:DataPoint13 a :DataPoint ;
    :xValue "0.08" ;
    :yValue "Skills" ;
    :belongsTo :Chart .

:DataPoint14 a :DataPoint ;
    :xValue "0.06" ;
    :yValue "Data pricing" ;
    :belongsTo :Chart .

:DataPoint15 a :DataPoint ;
    :xValue "0.03" ;
    :yValue "Evangelism" ;
    :belongsTo :Chart .

:DataPoint16 a :DataPoint ;
    :xValue "0.1" ;
    :yValue "Other" ;
    :belongsTo :Chart .
