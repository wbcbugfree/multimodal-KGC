@prefix : <http://example.org/> .

:Chart a :LineChart ;
    :title "What is your overall opinion of Israel and the Palestinian Authority ?" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "Favorable opinion of Israel" .

