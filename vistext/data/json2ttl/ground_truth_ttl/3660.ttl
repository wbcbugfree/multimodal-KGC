@prefix : <http://example.org/> .

:Chart a :AreaChart ;
    :title "Spending on chilled quiches and flans in the United Kingdom from December 2007 to December 2019 (in million GBP)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "day" .

:YAxis a :Axis ;
    :title "Spend in million GBP" .

