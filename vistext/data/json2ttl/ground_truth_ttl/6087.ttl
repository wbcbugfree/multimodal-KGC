@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Age distribution of the population in Italy in 2019 , by region" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "0-14 years" .

:YAxis a :Axis ;
    :title "region of Italy" .

:DataPoint1 a :DataPoint ;
    :xValue "0.111" ;
    :yValue "Liguria" ;
    :belongsTo :Chart .

