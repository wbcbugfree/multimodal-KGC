@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "NFL players ranked by salary and endorsement income in 2020 (in million U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Endorsements" .

:YAxis a :Axis ;
    :title "highest-paid NFL players" .

:dataPoint1 a :dataPoint ;
    :xValue "0.75" ;
    :yValue "Joey Bosa" ;
    :belongsTo :Chart .

:dataPoint2 a :dataPoint ;
    :xValue "4" ;
    :yValue "Carson Wentz" ;
    :belongsTo :Chart .

:dataPoint3 a :dataPoint ;
    :xValue "2.5" ;
    :yValue "Kirk Cousins" ;
    :belongsTo :Chart .

:dataPoint4 a :dataPoint ;
    :xValue "8" ;
    :yValue "Dak Prescott" ;
    :belongsTo :Chart .

:dataPoint5 a :dataPoint ;
    :xValue "14" ;
    :yValue "Drew Brees" ;
    :belongsTo :Chart .

:dataPoint6 a :dataPoint ;
    :xValue "0.3" ;
    :yValue "Ryan Tannehill" ;
    :belongsTo :Chart .

:dataPoint7 a :dataPoint ;
    :xValue "8" ;
    :yValue "Deshaun Watson" ;
    :belongsTo :Chart .

:dataPoint8 a :dataPoint ;
    :xValue "12" ;
    :yValue "Tom Brady" ;
    :belongsTo :Chart .

:dataPoint9 a :dataPoint ;
    :xValue "2" ;
    :yValue "Jared Goff" ;
    :belongsTo :Chart .

:dataPoint10 a :dataPoint ;
    :xValue "9" ;
    :yValue "Aaron Rodgers" ;
    :belongsTo :Chart .
