    :yValue "Pistachio" ;
    :belongsTo :Chart .

:dataPoint6 a :dataPoint ;
    :xValue "424.14" ;
    :yValue "Hazelnut" ;
    :belongsTo :Chart .

:dataPoint7 a :dataPoint ;
