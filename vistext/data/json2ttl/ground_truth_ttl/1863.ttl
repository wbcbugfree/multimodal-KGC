@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Internal consumption of travel and tourism in continental Latin America in 2019 , by country (in billion U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Consumption in billion U.S. dollars*" .

:YAxis a :Axis ;
    :title "Country" .

