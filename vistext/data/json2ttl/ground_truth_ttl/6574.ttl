@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Growth of advertising spending in the Middle East and North Africa (MENA) from 2010 to 2022 , by medium" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Newspapers" .

:YAxis a :Axis ;
    :title "Year" .

:DataPoint1 a :DataPoint ;
    :xValue "-0.173" ;
    :yValue "2022*" ;
    :belongsTo :Chart .

