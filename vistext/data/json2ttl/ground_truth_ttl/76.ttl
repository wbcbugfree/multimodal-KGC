@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Non-English main home languages ranked by number of speakers in Welsh schools in 2020" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "geographic region" .

:YAxis a :Axis ;
    :title "Number of speakers" .

:dataPoint1 a :dataPoint ;
    :xValue "Polish" ;
    :yValue "4961" ;
    :belongsTo :Chart .

:dataPoint2 a :dataPoint ;
    :xValue "Arabic" ;
    :yValue "3484" ;
    :belongsTo :Chart .

:dataPoint3 a :dataPoint ;
    :xValue "Bengali" ;
    :yValue "3019" ;
    :belongsTo :Chart .

:dataPoint4 a :dataPoint ;
    :xValue "Urdu" ;
    :yValue "1508" ;
    :belongsTo :Chart .

:dataPoint5 a :dataPoint ;
    :xValue "Chinese" ;
    :yValue "1466" ;
    :belongsTo :Chart .

:dataPoint6 a :dataPoint ;
    :xValue "Panjabi" ;
    :yValue "1242" ;
    :belongsTo :Chart .

:dataPoint7 a :dataPoint ;
    :xValue "Romanian" ;
    :yValue "1091" ;
    :belongsTo :Chart .

:dataPoint8 a :dataPoint ;
    :xValue "Somali" ;
    :yValue "852" ;
    :belongsTo :Chart .

:dataPoint9 a :dataPoint ;
    :xValue "Portuguese" ;
    :yValue "846" ;
