@prefix : <http://example.org/> .

:Chart a :LineChart ;
    :title "Gross orders of the Boeing 777 from 2004 to 2019" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Number of aircraft" .

