    :xValue "201" ;
    :yValue "Cantineriunite/CIV" ;
    :belongsTo :Chart .

:dataPoint5 a :dataPoint ;
    :xValue "209" ;
    :yValue "Antinori" ;
    :belongsTo :Chart .

:dataPoint6 a :dataPoint ;
    :xValue "183" ;
    :yValue "Zonin" ;
    :belongsTo :Chart .

:dataPoint7 a :dataPoint ;
    :xValue "160" ;
    :yValue "Martini" ;
    :belongsTo :Chart .

:dataPoint8 a :dataPoint ;
    :xValue "175" ;
    :yValue "Mezzacorona" ;
    :belongsTo :Chart .

:dataPoint9 a :dataPoint ;
