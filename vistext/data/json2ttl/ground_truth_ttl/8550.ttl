@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Leading ten Italian wineries in Italy from 2014 to 2018 , by turnover (in million euros)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "2015" .

:YAxis a :Axis ;
    :title "Leading ten Italian wineries" .

:dataPoint1 a :dataPoint ;
    :xValue "559" ;
    :yValue "C.Riunite/CIV/GIV" ;
    :belongsTo :Chart .

:dataPoint2 a :dataPoint ;
    :xValue "358" ;
    :yValue "GIV" ;
    :belongsTo :Chart .

