@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Big data revenue worldwide from 2016 to 2027 , by major segment (in billion U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Hardware" .

:YAxis a :Axis ;
    :title "Year" .

:dataPoint1 a :dataPoint ;
    :xValue "24" ;
    :yValue "2027*" ;
    :belongsTo :Chart .

:dataPoint2 a :dataPoint ;
    :xValue "23" ;
    :yValue "2026*" ;
    :belongsTo :Chart .

:dataPoint3 a :dataPoint ;
    :xValue "22" ;
    :yValue "2025*" ;
    :belongsTo :Chart .

:dataPoint4 a :dataPoint ;
    :xValue "20" ;
    :yValue "2024*" ;
    :belongsTo :Chart .

:dataPoint5 a :dataPoint ;
    :xValue "19" ;
    :yValue "2023*" ;
    :belongsTo :Chart .

:dataPoint6 a :dataPoint ;
    :xValue "18" ;
    :yValue "2022*" ;
    :belongsTo :Chart .

:dataPoint7 a :dataPoint ;
    :xValue "16" ;
    :yValue "2021*" ;
    :belongsTo :Chart .

:dataPoint8 a :dataPoint ;
    :xValue "15" ;
    :yValue "2020*" ;
    :belongsTo :Chart .

:dataPoint9 a :dataPoint ;
    :xValue "14" ;
    :yValue "2019*" ;
    :belongsTo :Chart .

:dataPoint10 a :dataPoint ;
    :xValue "12" ;
    :yValue "2018*" ;
    :belongsTo :Chart .

:dataPoint11 a :dataPoint ;
    :xValue "10" ;
    :yValue "2017" ;
    :belongsTo :Chart .

:dataPoint12 a :dataPoint ;
    :xValue "9" ;
    :yValue "2016" ;
    :belongsTo :Chart .
