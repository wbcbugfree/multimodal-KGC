@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Most popular accommodation choices of luxury travel clients according to travel agents in the United States as of August 2014" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "Share of respondents" .

:dataPoint1 a :dataPoint ;
    :xValue "Cruise ship (luxury)" ;
    :yValue "0.435" ;
    :belongsTo :Chart .

:dataPoint2 a :dataPoint ;
    :xValue "5-star hotels/resorts" ;
    :yValue "0.431" ;
    :belongsTo :Chart .

:dataPoint3 a :dataPoint ;
    :xValue "Boutique hotels" ;
    :yValue "0.405" ;
    :belongsTo :Chart .

:dataPoint4 a :dataPoint ;
    :xValue "4-star hotels/resorts" ;
    :yValue "0.237" ;
    :belongsTo :Chart .

:dataPoint5 a :dataPoint ;
    :xValue "5-star hotels/resorts – suites" ;
    :yValue "0.215" ;
    :belongsTo :Chart .

:dataPoint6 a :dataPoint ;
    :xValue "5-star + (plus) hotels/resorts" ;
    :yValue "0.191" ;
    :belongsTo :Chart .

:dataPoint7 a :dataPoint ;
    :xValue "4-star hotels/resorts – suites" ;
    :yValue "0.19" ;
    :belongsTo :Chart .

:dataPoint8 a :dataPoint ;
    :xValue "Cruise ship (not luxury) in a suite" ;
    :yValue "0.184" ;
    :belongsTo :Chart .

:dataPoint9 a :dataPoint ;
    :xValue "5-star + (plus) hotels/resorts – suites" ;
    :yValue "0.16" ;
    :belongsTo :Chart .

:dataPoint10 a :dataPoint ;
    :xValue "Villa" ;
    :yValue "0.102" ;
    :belongsTo :Chart .
