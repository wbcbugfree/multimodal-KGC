@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Average annual household expenditures in Manitoba , Canada in 2017 (in Canadian dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Average expenditure in Canadian dollars" .

:YAxis a :Axis ;
    :title "industry" .

