    :yValue "71693" ;
    :belongsTo :Chart .

:dataPoint6 a :dataPoint ;
    :xValue "Dec 31, 2013" ;
    :yValue "66774" ;
    :belongsTo :Chart .

:dataPoint7 a :dataPoint ;
    :xValue "Dec 31, 2014" ;
