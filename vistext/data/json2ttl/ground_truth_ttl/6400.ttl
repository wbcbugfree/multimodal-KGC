@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Number of U.S. high schools with athletics programs for girls from 2009/10 to 2018/19 , by sport" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Soccer" .

:YAxis a :Axis ;
    :title "Year" .

:DataPoint1 a :DataPoint ;
    :xValue "10901" ;
    :yValue "2009/10" ;
    :belongsTo :Chart .

