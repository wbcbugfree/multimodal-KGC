@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Cumulative solar photovoltaic capacity globally as of 2019 , by select country (in gigawatts)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Cumulative capacity in gigawatts" .

:YAxis a :Axis ;
    :title "Country" .

:dataPoint1 a :dataPoint ;
    :xValue "204" ;
    :yValue "China" ;
    :belongsTo :Chart .

:dataPoint2 a :dataPoint ;
    :xValue "76" ;
    :yValue "U.S." ;
    :belongsTo :Chart .

:dataPoint3 a :dataPoint ;
    :xValue "63" ;
    :yValue "Japan" ;
    :belongsTo :Chart .

:dataPoint4 a :dataPoint ;
    :xValue "49" ;
    :yValue "Germany" ;
    :belongsTo :Chart .

:dataPoint5 a :dataPoint ;
    :xValue "42.8" ;
    :yValue "India" ;
    :belongsTo :Chart .

:dataPoint6 a :dataPoint ;
    :xValue "20.8" ;
    :yValue "Italy" ;
    :belongsTo :Chart .

:dataPoint7 a :dataPoint ;
    :xValue "14.7" ;
    :yValue "Australia" ;
    :belongsTo :Chart .

:dataPoint8 a :dataPoint ;
    :xValue "13.4" ;
    :yValue "UK" ;
    :belongsTo :Chart .

:dataPoint9 a :dataPoint ;
    :xValue "11.2" ;
    :yValue "Republic of Korea" ;
    :belongsTo :Chart .

:dataPoint10 a :dataPoint ;
