@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Number of owner occupied housing units in the United States from 1975 to 2019 (in millions)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Number of housing units in millions" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 1974" ;
    :yValue "46.87" ;
    :belongsTo :Chart .

