@prefix : <http://example.org/> .

:Chart a :LineChart ;
    :title "Number of movie tickets sold in the United States and Canada from 2001 to 2018 (in millions)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Number of tickets sold in millions" .

