@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Most purchased brands during COVID-19 outbreak in Singapore as of March 2020 , by type of customer" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "COVID-19 Worriers" .

:dataPoint1 a :dataPoint ;
    :xValue "McDonald's" ;
    :yValue "0.55" ;
    :belongsTo :Chart .

:dataPoint2 a :dataPoint ;
    :xValue "KFC" ;
    :yValue "0.36" ;
    :belongsTo :Chart .

:dataPoint3 a :dataPoint ;
    :xValue "Dettol" ;
    :yValue "0.32" ;
    :belongsTo :Chart .

:dataPoint4 a :dataPoint ;
    :xValue "QOO10" ;
    :yValue "0.31" ;
    :belongsTo :Chart .

:dataPoint5 a :dataPoint ;
    :xValue "Shopee" ;
    :yValue "0.19" ;
    :belongsTo :Chart .

:dataPoint6 a :dataPoint ;
    :xValue "Ninja Van" ;
    :yValue "0.17" ;
    :belongsTo :Chart .

:dataPoint7 a :dataPoint ;
    :xValue "L'Oreal" ;
    :yValue "0.13" ;
    :belongsTo :Chart .

:dataPoint8 a :dataPoint ;
    :xValue "Nissin" ;
    :yValue "0.12" ;
    :belongsTo :Chart .

:dataPoint9 a :dataPoint ;
    :xValue "MeWATCH" ;
    :yValue "0.06" ;
    :belongsTo :Chart .

:dataPoint10 a :dataPoint ;
    :xValue "Enfagrow" ;
    :yValue "0.04" ;
    :belongsTo :Chart .
