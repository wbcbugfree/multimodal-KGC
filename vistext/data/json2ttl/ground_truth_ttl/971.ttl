@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Dallas Mavericks all-time points leaders from 1980 to 2020" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Players" .

:YAxis a :Axis ;
    :title "Points scored" .

:dataPoint1 a :dataPoint ;
    :xValue "Dirk Nowitzki" ;
    :yValue "31560" ;
