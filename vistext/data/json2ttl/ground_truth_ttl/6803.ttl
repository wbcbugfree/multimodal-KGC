@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Most searched topics on Google about coronavirus (COVID-19) in Italy in 2020 , by region" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "region of Italy" .

:YAxis a :Axis ;
    :title "Vaccination" .

