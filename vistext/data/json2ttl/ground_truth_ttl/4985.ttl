@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Value of fertilizers imported into India from financial year 2011 to 2020 (in billion Indian rupees)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Import value in billion Indian rupees" .

:YAxis a :Axis ;
    :title "year" .

:dataPoint1 a :dataPoint ;
    :xValue "528.17" ;
    :yValue "FY 2020" ;
    :belongsTo :Chart .

:dataPoint2 a :dataPoint ;
    :xValue "520.95" ;
    :yValue "FY 2019" ;
    :belongsTo :Chart .

:dataPoint3 a :dataPoint ;
    :xValue "346.5" ;
    :yValue "FY 2018" ;
    :belongsTo :Chart .

:dataPoint4 a :dataPoint ;
    :xValue "337.3" ;
    :yValue "FY 2017" ;
    :belongsTo :Chart .

:dataPoint5 a :dataPoint ;
    :xValue "525" ;
    :yValue "FY 2016" ;
    :belongsTo :Chart .

:dataPoint6 a :dataPoint ;
    :xValue "452.95" ;
    :yValue "FY 2015" ;
    :belongsTo :Chart .

:dataPoint7 a :dataPoint ;
    :xValue "381.57" ;
    :yValue "FY 2014" ;
    :belongsTo :Chart .

:dataPoint8 a :dataPoint ;
    :xValue "477.22" ;
    :yValue "FY 2013" ;
    :belongsTo :Chart .

:dataPoint9 a :dataPoint ;
    :xValue "533.11" ;
    :yValue "FY 2012" ;
    :belongsTo :Chart .

:dataPoint10 a :dataPoint ;
    :xValue "315.33" ;
    :yValue "FY 2011" ;
    :belongsTo :Chart .
