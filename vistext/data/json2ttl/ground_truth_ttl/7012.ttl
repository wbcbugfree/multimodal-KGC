@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Length of time respondents think the coronavirus (COVID-19) outbreak will last in their country , worldwide as of March 12 , 2020 , by country" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "4-5 months" .

:DataPoint1 a :DataPoint ;
    :xValue "All" ;
    :yValue "0.11" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Australia" ;
    :yValue "0.14" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "Brazil" ;
    :yValue "0.18" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "China" ;
    :yValue "0.06" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "France" ;
    :yValue "0.12" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Germany" ;
    :yValue "0.14" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Italy" ;
    :yValue "0.16" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Japan" ;
    :yValue "0.18" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "Philippines" ;
    :yValue "0.14" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "Singapore" ;
    :yValue "0.1" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "South Africa" ;
    :yValue "0.13" ;
    :belongsTo :Chart .

:DataPoint12 a :DataPoint ;
    :xValue "Spain" ;
    :yValue "0.16" ;
    :belongsTo :Chart .

:DataPoint13 a :DataPoint ;
    :xValue "United Kingdom" ;
    :yValue "0.13" ;
    :belongsTo :Chart .

:DataPoint14 a :DataPoint ;
    :xValue "United States" ;
    :yValue "0.19" ;
    :belongsTo :Chart .
