@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Length of time respondents think the coronavirus (COVID-19) outbreak will last in their country , worldwide as of March 12 , 2020 , by country" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "4-5 months" .

:dataPoint1 a :dataPoint ;
    :xValue "All" ;
    :yValue "0.11" ;
    :belongsTo :Chart .

:dataPoint2 a :dataPoint ;
    :xValue "Australia" ;
    :yValue "0.14" ;
    :belongsTo :Chart .

:dataPoint3 a :dataPoint ;
    :xValue "Brazil" ;
    :yValue "0.18" ;
    :belongsTo :Chart .

:dataPoint4 a :dataPoint ;
    :xValue "China" ;
    :yValue "0.06" ;
    :belongsTo :Chart .

:dataPoint5 a :dataPoint ;
    :xValue "France" ;
    :yValue "0.12" ;
    :belongsTo :Chart .

:dataPoint6 a :dataPoint ;
    :xValue "Germany" ;
    :yValue "0.14" ;
    :belongsTo :Chart .

:dataPoint7 a :dataPoint ;
    :xValue "Italy" ;
    :yValue "0.16" ;
    :belongsTo :Chart .

:dataPoint8 a :dataPoint ;
    :xValue "Japan" ;
    :yValue "0.18" ;
    :belongsTo :Chart .

:dataPoint9 a :dataPoint ;
    :xValue "Philippines" ;
    :yValue "0.14" ;
    :belongsTo :Chart .

:dataPoint10 a :dataPoint ;
    :xValue "Singapore" ;
    :yValue "0.1" ;
    :belongsTo :Chart .

:dataPoint11 a :dataPoint ;
    :xValue "South Africa" ;
    :yValue "0.13" ;
    :belongsTo :Chart .

:dataPoint12 a :dataPoint ;
    :xValue "Spain" ;
    :yValue "0.16" ;
    :belongsTo :Chart .

:dataPoint13 a :dataPoint ;
    :xValue "United Kingdom" ;
    :yValue "0.13" ;
    :belongsTo :Chart .

:dataPoint14 a :dataPoint ;
    :xValue "United States" ;
    :yValue "0.19" ;
    :belongsTo :Chart .
