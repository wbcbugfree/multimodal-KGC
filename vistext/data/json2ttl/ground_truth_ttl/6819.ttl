@prefix : <http://example.org/> .

:Chart a :LineChart ;
    :title "Generation of selected materials in the U.S. municipal waste stream between 1960 and 2018 (in 1,000 tons)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Textiles" .

