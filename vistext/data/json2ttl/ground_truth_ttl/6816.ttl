@prefix : <http://example.org/> .

:Chart a :LineChart ;
    :title "Life expectancy at birth in the Netherlands from 1950 to 2018 , by gender" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Men" .

