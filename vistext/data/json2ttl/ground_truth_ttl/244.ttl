@prefix : <http://example.org/> .

:Chart a :LineChart ;
    :title "Total number of cash withdrawals from ATMs in the United Kingdom (UK) from 2001 to 2018 (in millions)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Number of cash withdrawals in millions" .

