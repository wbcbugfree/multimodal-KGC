@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Most important features of music streaming services in the United States in the 1st quarter of 2020" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "Share of respondents" .

:DataPoint1 a :DataPoint ;
    :xValue "Quality of sound" ;
    :yValue "0.56" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Price" ;
    :yValue "0.56" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "Ease of making a playlist" ;
    :yValue "0.48" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "Ease of downloading music" ;
    :yValue "0.43" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "Ease of discovering new music" ;
    :yValue "0.36" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Availability of exclusive music" ;
    :yValue "0.24" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Trust in brand" ;
    :yValue "0.19" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Affinity with virtual assistant" ;
    :yValue "0.1" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "Availability of video" ;
    :yValue "0.12" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "Other" ;
    :yValue "0.05" ;
    :belongsTo :Chart .
