@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Most important features of music streaming services in the United States in the 1st quarter of 2020" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "Share of respondents" .

:dataPoint1 a :dataPoint ;
    :xValue "Quality of sound" ;
    :yValue "0.56" ;
    :belongsTo :Chart .

:dataPoint2 a :dataPoint ;
    :xValue "Price" ;
    :yValue "0.56" ;
    :belongsTo :Chart .

:dataPoint3 a :dataPoint ;
    :xValue "Ease of making a playlist" ;
    :yValue "0.48" ;
    :belongsTo :Chart .

:dataPoint4 a :dataPoint ;
    :xValue "Ease of downloading music" ;
    :yValue "0.43" ;
    :belongsTo :Chart .

:dataPoint5 a :dataPoint ;
    :xValue "Ease of discovering new music" ;
    :yValue "0.36" ;
    :belongsTo :Chart .

:dataPoint6 a :dataPoint ;
    :xValue "Availability of exclusive music" ;
    :yValue "0.24" ;
    :belongsTo :Chart .

:dataPoint7 a :dataPoint ;
    :xValue "Trust in brand" ;
    :yValue "0.19" ;
    :belongsTo :Chart .

:dataPoint8 a :dataPoint ;
    :xValue "Affinity with virtual assistant" ;
    :yValue "0.1" ;
    :belongsTo :Chart .

:dataPoint9 a :dataPoint ;
    :xValue "Availability of video" ;
    :yValue "0.12" ;
    :belongsTo :Chart .

:dataPoint10 a :dataPoint ;
    :xValue "Other" ;
    :yValue "0.05" ;
    :belongsTo :Chart .
