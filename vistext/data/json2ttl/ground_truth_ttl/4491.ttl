@prefix : <http://example.org/> .

:Chart a :LineChart ;
    :title "Worldwide number of automobiles sold by Honda Group from FY 2002 to FY 2020 (in 1,000 units)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Automobile sales in thousand units" .

