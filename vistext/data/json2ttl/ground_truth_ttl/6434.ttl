@prefix : <http://example.org/> .

:Chart a :AreaChart ;
    :title "Population in China from 1990 to 2019 , by age group (in millions)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "65 years +" .

:dataPoint1 a :dataPoint ;
    :xValue "Dec 31, 1989" ;
    :yValue "63.68" ;
    :belongsTo :Chart .

