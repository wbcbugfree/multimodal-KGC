@prefix : <http://example.org/> .

:Chart a :LineChart ;
    :title "Spain : Distribution of the workforce across economic sectors from 2010 to 2020" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Services" .

:dataPoint1 a :dataPoint ;
    :xValue "Dec 31, 2009" ;
    :yValue "0.7283" ;
    :belongsTo :Chart .

