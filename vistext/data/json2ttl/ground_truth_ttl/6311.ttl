@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Asus quarterly sales share worldwide from 2016 to 2020 , by product type" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "quarter" .

:YAxis a :Axis ;
    :title "Component" .

:dataPoint1 a :dataPoint ;
    :xValue "1Q '16" ;
    :yValue "0.14" ;
    :belongsTo :Chart .

