@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Regional distribution of BBC network TV programming spending in the United Kingdom (UK) from 2012 to 2019" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "2014" .

:YAxis a :Axis ;
    :title "geographic region" .

:dataPoint1 a :dataPoint ;
    :xValue "0.533" ;
    :yValue "Total nations and regions" ;
    :belongsTo :Chart .

:dataPoint2 a :dataPoint ;
    :xValue "0.467" ;
    :yValue "London" ;
    :belongsTo :Chart .

:dataPoint3 a :dataPoint ;
    :xValue "0.352" ;
    :yValue "Total regions excl. London" ;
    :belongsTo :Chart .

:dataPoint4 a :dataPoint ;
    :xValue "0.231" ;
    :yValue "North of England" ;
    :belongsTo :Chart .

:dataPoint5 a :dataPoint ;
    :xValue "0.181" ;
    :yValue "Total nations" ;
    :belongsTo :Chart .

:dataPoint6 a :dataPoint ;
    :xValue "0.092" ;
    :yValue "Scotland" ;
    :belongsTo :Chart .

:dataPoint7 a :dataPoint ;
    :xValue "0.076" ;
    :yValue "South of England" ;
    :belongsTo :Chart .

:dataPoint8 a :dataPoint ;
    :xValue "0.065" ;
    :yValue "Wales" ;
    :belongsTo :Chart .

:dataPoint9 a :dataPoint ;
    :xValue "0.028" ;
    :yValue "Multi-region**" ;
    :belongsTo :Chart .

:dataPoint10 a :dataPoint ;
    :xValue "0.025" ;
    :yValue "Northern Ireland" ;
    :belongsTo :Chart .

:dataPoint11 a :dataPoint ;
    :xValue "0.017" ;
    :yValue "Midlands" ;
    :belongsTo :Chart .
