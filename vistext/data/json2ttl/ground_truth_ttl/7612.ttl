@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Regional distribution of BBC network TV programming spending in the United Kingdom (UK) from 2012 to 2019" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "2014" .

:YAxis a :Axis ;
    :title "geographic region" .

:DataPoint1 a :DataPoint ;
    :xValue "0.533" ;
    :yValue "Total nations and regions" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "0.467" ;
    :yValue "London" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "0.352" ;
    :yValue "Total regions excl. London" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "0.231" ;
    :yValue "North of England" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "0.181" ;
    :yValue "Total nations" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "0.092" ;
    :yValue "Scotland" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "0.076" ;
    :yValue "South of England" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "0.065" ;
    :yValue "Wales" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "0.028" ;
    :yValue "Multi-region**" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "0.025" ;
    :yValue "Northern Ireland" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "0.017" ;
    :yValue "Midlands" ;
    :belongsTo :Chart .
