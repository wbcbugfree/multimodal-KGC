@prefix : <http://example.org/> .

:Chart a :LineChart ;
    :title "Number of Facebook fans/twitter followers of the Washington Football Team (NFL) from 2012 to 2020 (in millions)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Month" .

:YAxis a :Axis ;
    :title "Facebook fans" .

:dataPoint1 a :dataPoint ;
    :xValue "Jul 31, 2012" ;
    :yValue "0.98" ;
    :belongsTo :Chart .

