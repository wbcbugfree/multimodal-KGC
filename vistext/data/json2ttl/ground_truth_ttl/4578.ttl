@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Share of old age population (65 years and older) in the total U.S. population from 1950 to 2050" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Percentage of total population" .

:YAxis a :Axis ;
    :title "Response" .

:dataPoint1 a :dataPoint ;
    :xValue "0.22" ;
    :yValue "2050*" ;
    :belongsTo :Chart .

:dataPoint2 a :dataPoint ;
    :xValue "0.216" ;
    :yValue "2040*" ;
    :belongsTo :Chart .

:dataPoint3 a :dataPoint ;
    :xValue "0.206" ;
    :yValue "2030*" ;
    :belongsTo :Chart .

:dataPoint4 a :dataPoint ;
    :xValue "0.169" ;
    :yValue "2020*" ;
    :belongsTo :Chart .

:dataPoint5 a :dataPoint ;
    :xValue "0.165" ;
    :yValue "2019" ;
    :belongsTo :Chart .

:dataPoint6 a :dataPoint ;
    :xValue "0.16" ;
    :yValue "2018" ;
    :belongsTo :Chart .

:dataPoint7 a :dataPoint ;
    :xValue "0.131" ;
    :yValue "2010" ;
    :belongsTo :Chart .

:dataPoint8 a :dataPoint ;
    :xValue "0.124" ;
    :yValue "2000" ;
    :belongsTo :Chart .

:dataPoint9 a :dataPoint ;
    :xValue "0.125" ;
    :yValue "1990" ;
    :belongsTo :Chart .

:dataPoint10 a :dataPoint ;
    :xValue "0.113" ;
    :yValue "1980" ;
    :belongsTo :Chart .

:dataPoint11 a :dataPoint ;
    :xValue "0.1" ;
    :yValue "1970" ;
    :belongsTo :Chart .

:dataPoint12 a :dataPoint ;
    :xValue "0.09" ;
    :yValue "1960" ;
    :belongsTo :Chart .

:dataPoint13 a :dataPoint ;
    :xValue "0.08" ;
    :yValue "1950" ;
    :belongsTo :Chart .
