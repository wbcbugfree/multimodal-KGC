@prefix : <http://example.org/> .

:Chart a :AreaChart ;
    :title "Wine production in the United States and in California from 2006 to 2017 (in million gallons)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "United States" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2005" ;
    :yValue "623.26" ;
    :belongsTo :Chart .

