@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "User share of most popular social media among young people in Finland in 2019 , by platform" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Share of respondents" .

:YAxis a :Axis ;
    :title "Response" .

:dataPoint1 a :dataPoint ;
    :xValue "0.89" ;
    :yValue "WhatsApp" ;
    :belongsTo :Chart .

:dataPoint2 a :dataPoint ;
    :xValue "0.88" ;
    :yValue "YouTube" ;
    :belongsTo :Chart .

:dataPoint3 a :dataPoint ;
    :xValue "0.79" ;
    :yValue "Instagram" ;
    :belongsTo :Chart .

:dataPoint4 a :dataPoint ;
    :xValue "0.74" ;
    :yValue "Snapchat" ;
    :belongsTo :Chart .

:dataPoint5 a :dataPoint ;
    :xValue "0.72" ;
    :yValue "Spotify" ;
    :belongsTo :Chart .

:dataPoint6 a :dataPoint ;
    :xValue "0.57" ;
    :yValue "Facebook" ;
    :belongsTo :Chart .

:dataPoint7 a :dataPoint ;
    :xValue "0.32" ;
    :yValue "Facebook Messenger" ;
    :belongsTo :Chart .

:dataPoint8 a :dataPoint ;
    :xValue "0.24" ;
    :yValue "Pinterest" ;
    :belongsTo :Chart .

:dataPoint9 a :dataPoint ;
    :xValue "0.24" ;
    :yValue "Steam" ;
    :belongsTo :Chart .

:dataPoint10 a :dataPoint ;
    :xValue "0.23" ;
    :yValue "Discord" ;
    :belongsTo :Chart .
