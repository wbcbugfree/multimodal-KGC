@prefix : <http://example.org/> .

:Chart a :AreaChart ;
    :title "Average retail price paid for fresh / frozen poultry meat in the United Kingdom (UK) from 2005 to 2015 (in GBP per kilogram)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Average price per kilogram (in GBP)" .

:dataPoint1 a :dataPoint ;
    :xValue "Dec 31, 2004" ;
    :yValue "3.37" ;
    :belongsTo :Chart .

