@prefix : <http://example.org/> .

:Chart a :LineChart ;
    :title "Waste generated by pharmaceutical company Roche from 2007 to 2019 (in metric tons)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Chemical waste" .

:dataPoint1 a :dataPoint ;
    :xValue "Dec 31, 2006" ;
    :yValue "38167" ;
    :belongsTo :Chart .

