@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Number of victims of school shootings in the United States between 1982 and December 2019" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Fatalities" .

:YAxis a :Axis ;
    :title "school shooting" .

:dataPoint1 a :dataPoint ;
    :xValue "33" ;
    :yValue "Virginia Tech massacre (Blacksburg, Virginia," ;
    :belongsTo :Chart .

:dataPoint2 a :dataPoint ;
    :xValue "13" ;
    :yValue "Columbine High School massacre (Littleton, Colorado," ;
    :belongsTo :Chart .

