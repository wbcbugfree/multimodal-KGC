@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Number of victims of school shootings in the United States between 1982 and December 2019" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Fatalities" .

:YAxis a :Axis ;
    :title "school shooting" .

:DataPoint1 a :DataPoint ;
    :xValue "33" ;
    :yValue "Virginia Tech massacre (Blacksburg, Virginia, 2007)" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "13" ;
    :yValue "Columbine High School massacre (Littleton, Colorado, 1999)" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "6" ;
    :yValue "Stockton schoolyard shooting (Stockton, California, 1989)" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "17" ;
    :yValue "Marjory Stoneman Douglas High School shooting (Parkland, Florida, 2018)" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "4" ;
    :yValue "Thurston High School shooting (Springfield, Oregon, 1998)" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "27" ;
    :yValue "Sandy Hook Elementary massacre (Newtown, Connecticut, 2012)" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "5" ;
    :yValue "Northern Illinois University shooting (DeKalb, Illinois, 2008)" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "10" ;
    :yValue "Santa Fe High School shooting (Santa Fe, Texas, 2018)" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "6" ;
    :yValue "Isla Vista mass murder (Santa Barbara, California, 2014)" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "9" ;
    :yValue "Umpqua Community College shooting (Roseburg, OR, 2015)" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "5" ;
    :yValue "Westside Middle School killings (Jonesboro, Arkansas, 1998)" ;
    :belongsTo :Chart .

:DataPoint12 a :DataPoint ;
    :xValue "10" ;
    :yValue "Red Lake massacre (Red Lake, Minnesota, 2005)" ;
    :belongsTo :Chart .

:DataPoint13 a :DataPoint ;
    :xValue "4" ;
    :yValue "Lindhurst High School shooting (Olivehurst, California, 1992)" ;
    :belongsTo :Chart .

:DataPoint14 a :DataPoint ;
    :xValue "6" ;
    :yValue "Amish school shooting (Lancaster County, Pennsylvania, 2006)" ;
    :belongsTo :Chart .

:DataPoint15 a :DataPoint ;
    :xValue "7" ;
    :yValue "Oikos University killings (Oakland, California, 2012)" ;
    :belongsTo :Chart .

:DataPoint16 a :DataPoint ;
    :xValue "6" ;
    :yValue "University of Iowa shooting (Iowa City, Iowa, 1991)" ;
    :belongsTo :Chart .

:DataPoint17 a :DataPoint ;
    :xValue "5" ;
    :yValue "Marysville-Pilchuck High Schoolshooting (Marysville, WA, 2014)" ;
    :belongsTo :Chart .
