@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Germany : Budget balance between 2015 to 2025 in relation to GDP" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Budget balance in relation to GDP" .

:YAxis a :Axis ;
    :title "Year" .

:dataPoint1 a :dataPoint ;
    :xValue "0.0105" ;
    :yValue "2025*" ;
    :belongsTo :Chart .

:dataPoint2 a :dataPoint ;
    :xValue "0.0104" ;
    :yValue "2024*" ;
    :belongsTo :Chart .

:dataPoint3 a :dataPoint ;
    :xValue "0.0084" ;
    :yValue "2023*" ;
    :belongsTo :Chart .

:dataPoint4 a :dataPoint ;
    :xValue "0.0062" ;
    :yValue "2022*" ;
    :belongsTo :Chart .

:dataPoint5 a :dataPoint ;
    :xValue "-0.032" ;
    :yValue "2021*" ;
    :belongsTo :Chart .

:dataPoint6 a :dataPoint ;
    :xValue "-0.0818" ;
    :yValue "2020*" ;
    :belongsTo :Chart .

:dataPoint7 a :dataPoint ;
    :xValue "0.0152" ;
    :yValue "2019" ;
    :belongsTo :Chart .

:dataPoint8 a :dataPoint ;
    :xValue "0.0184" ;
    :yValue "2018" ;
    :belongsTo :Chart .

:dataPoint9 a :dataPoint ;
    :xValue "0.0136" ;
    :yValue "2017" ;
    :belongsTo :Chart .

:dataPoint10 a :dataPoint ;
    :xValue "0.0116" ;
    :yValue "2016" ;
    :belongsTo :Chart .

:dataPoint11 a :dataPoint ;
    :xValue "0.0096" ;
    :yValue "2015" ;
    :belongsTo :Chart .
