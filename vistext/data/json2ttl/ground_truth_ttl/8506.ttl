@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Average retail price for roasted coffee in Canada from January 2015 to June 2020 (in Canadian dollars per 300 grams)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Month" .

:YAxis a :Axis ;
    :title "2019" .

:dataPoint1 a :dataPoint ;
    :xValue "De" ;
    :yValue "5.01" ;
    :belongsTo :Chart .

:dataPoint2 a :dataPoint ;
    :xValue "Month: Dec No" ;
    :yValue "5.02" ;
    :belongsTo :Chart .

:dataPoint3 a :dataPoint ;
    :xValue "Month: Nov Oc" ;
    :yValue "4.91" ;
    :belongsTo :Chart .

:dataPoint4 a :dataPoint ;
    :xValue "Month: Oct Se" ;
    :yValue "4.86" ;
    :belongsTo :Chart .

:dataPoint5 a :dataPoint ;
    :xValue "Month: Sep Au" ;
    :yValue "5.02" ;
    :belongsTo :Chart .

:dataPoint6 a :dataPoint ;
    :xValue "Month: Aug Ju" ;
    :yValue "5.1" ;
    :belongsTo :Chart .

:dataPoint7 a :dataPoint ;
    :xValue "Month: Jul Ju" ;
    :yValue "5.38" ;
    :belongsTo :Chart .

:dataPoint8 a :dataPoint ;
    :xValue "Month: Jun Ma" ;
    :yValue "5.3" ;
    :belongsTo :Chart .

:dataPoint9 a :dataPoint ;
    :xValue "Month: May Ap" ;
    :yValue "5.35" ;
    :belongsTo :Chart .

:dataPoint10 a :dataPoint ;
    :xValue "Month: Apr Ma" ;
    :yValue "5.39" ;
    :belongsTo :Chart .

:dataPoint11 a :dataPoint ;
    :xValue "Month: Mar Fe" ;
    :yValue "5.51" ;
    :belongsTo :Chart .

:dataPoint12 a :dataPoint ;
    :xValue "Month: Feb Ja" ;
    :yValue "5.33" ;
    :belongsTo :Chart .
