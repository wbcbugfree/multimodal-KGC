@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "How much do you plan on spending this year on Christmas presents ?" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Median amount in euros" .

:YAxis a :Axis ;
    :title "Country" .

:dataPoint1 a :dataPoint ;
    :xValue "420" ;
    :yValue "United Kingdom" ;
    :belongsTo :Chart .

