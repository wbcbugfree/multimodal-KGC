@prefix : <http://example.org/> .

:Chart a :AreaChart ;
    :title "Indonesia : Ratio of military spending to gross domestic product (GDP) from 2009 to 2019" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Ratio of military spending to GDP" .

:dataPoint1 a :dataPoint ;
    :xValue "Dec 31, 2008" ;
    :yValue "0.0057" ;
    :belongsTo :Chart .

