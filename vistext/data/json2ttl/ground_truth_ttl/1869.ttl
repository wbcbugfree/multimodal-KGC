@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "B2C e-commerce as percentage of GDP in Russia from 2009 to 2018" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "Percentage of gross domestic product" .

:dataPoint1 a :dataPoint ;
    :xValue "2018*" ;
    :yValue "0.0171" ;
    :belongsTo :Chart .

:dataPoint2 a :dataPoint ;
    :xValue "2017*" ;
    :yValue "0.0139" ;
    :belongsTo :Chart .

:dataPoint3 a :dataPoint ;
    :xValue "2016*" ;
    :yValue "0.011" ;
    :belongsTo :Chart .

:dataPoint4 a :dataPoint ;
    :xValue "2015*" ;
    :yValue "0.009" ;
    :belongsTo :Chart .

:dataPoint5 a :dataPoint ;
    :xValue "2014*" ;
    :yValue "0.0078" ;
    :belongsTo :Chart .

:dataPoint6 a :dataPoint ;
    :xValue "2013" ;
    :yValue "0.0071" ;
    :belongsTo :Chart .

:dataPoint7 a :dataPoint ;
    :xValue "2012" ;
    :yValue "0.006" ;
    :belongsTo :Chart .

:dataPoint8 a :dataPoint ;
    :xValue "2011" ;
    :yValue "0.0051" ;
    :belongsTo :Chart .

:dataPoint9 a :dataPoint ;
    :xValue "2010" ;
    :yValue "0.0042" ;
    :belongsTo :Chart .

:dataPoint10 a :dataPoint ;
    :xValue "2009" ;
    :yValue "0.004" ;
    :belongsTo :Chart .
