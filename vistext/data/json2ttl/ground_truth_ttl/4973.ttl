@prefix : <http://example.org/> .

:Chart a :AreaChart ;
    :title "Finland : Urbanization from 2009 to 2019" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "Share of urban population in total population" .

:dataPoint1 a :dataPoint ;
    :xValue "Dec 31, 2008" ;
    :yValue "0.8343" ;
    :belongsTo :Chart .

