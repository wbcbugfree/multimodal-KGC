@prefix : <http://example.org/> .

:Chart a :LineChart ;
    :title "Gender pay gap full-time employees based on average gross monthly wages in Belgium from 2004 to 2014" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Gender pay gap" .

:dataPoint1 a :dataPoint ;
    :xValue "Dec 31, 2003" ;
    :yValue "0.15" ;
    :belongsTo :Chart .

:dataPoint2 a :dataPoint ;
    :xValue "Dec 31, 2004" ;
    :yValue "0.15" ;
    :belongsTo :Chart .

:dataPoint3 a :dataPoint ;
    :xValue "Dec 31, 2005" ;
    :yValue "0.12" ;
    :belongsTo :Chart .

:dataPoint4 a :dataPoint ;
    :xValue "Dec 31, 2006" ;
    :yValue "0.12" ;
    :belongsTo :Chart .

:dataPoint5 a :dataPoint ;
    :xValue "Dec 31, 2007" ;
    :yValue "0.11" ;
    :belongsTo :Chart .

:dataPoint6 a :dataPoint ;
    :xValue "Dec 31, 2008" ;
    :yValue "0.1" ;
    :belongsTo :Chart .

:dataPoint7 a :dataPoint ;
    :xValue "Dec 31, 2009" ;
    :yValue "0.1" ;
    :belongsTo :Chart .

:dataPoint8 a :dataPoint ;
    :xValue "Dec 31, 2010" ;
    :yValue "0.08" ;
    :belongsTo :Chart .

:dataPoint9 a :dataPoint ;
    :xValue "Dec 31, 2011" ;
    :yValue "0.07" ;
    :belongsTo :Chart .

:dataPoint10 a :dataPoint ;
    :xValue "Dec 31, 2012" ;
    :yValue "0.07" ;
    :belongsTo :Chart .

:dataPoint11 a :dataPoint ;
    :xValue "Dec 31, 2013" ;
    :yValue "0.05" ;
    :belongsTo :Chart .
