@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Which of these trips have you taken in the past ?" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Share of respondents" .

:YAxis a :Axis ;
    :title "Response" .

:DataPoint1 a :DataPoint ;
    :xValue "0.88" ;
    :yValue "Day trip" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "0.84" ;
    :yValue "Weekend getaway" ;
    :belongsTo :Chart .

