@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Leading defense suppliers dependency on Ministry of Defence (MOD) business in the United Kingdom (UK) from 2005/06 to 2019/20" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Ferrovial SA" .

:dataPoint1 a :dataPoint ;
    :xValue "2019/20" ;
    :yValue "0.137" ;
    :belongsTo :Chart .

:dataPoint2 a :dataPoint ;
    :xValue "2018/19" ;
    :yValue "0.119" ;
    :belongsTo :Chart .

:dataPoint3 a :dataPoint ;
    :xValue "2017/18" ;
    :yValue "0.055" ;
    :belongsTo :Chart .

:dataPoint4 a :dataPoint ;
    :xValue "2016/17" ;
    :yValue "0.024" ;
    :belongsTo :Chart .

:dataPoint5 a :dataPoint ;
    :xValue "2015/16" ;
    :yValue "0.021" ;
    :belongsTo :Chart .

:dataPoint6 a :dataPoint ;
    :xValue "2014/15" ;
    :yValue "0.021" ;
    :belongsTo :Chart .

:dataPoint7 a :dataPoint ;
    :xValue "2013/14**" ;
    :yValue "0.011" ;
    :belongsTo :Chart .
