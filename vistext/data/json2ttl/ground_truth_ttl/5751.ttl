@prefix : <http://example.org/> .

:Chart a :AreaChart ;
    :title "Syria : Urbanization from 2009 to 2019" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "Share of urban population in total population" .

