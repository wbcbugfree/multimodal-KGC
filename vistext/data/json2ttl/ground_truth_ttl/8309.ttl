@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "How do you expect COVID-19 to impact your spending for any of the following ?" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Stay the same" .

:YAxis a :Axis ;
    :title "Response" .

:DataPoint1 a :DataPoint ;
    :xValue "0.13" ;
    :yValue "Cybersecurity" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "0.19" ;
    :yValue "Hybrid or multi-cloud" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "0.22" ;
    :yValue "Automation" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "0.27" ;
    :yValue "Smart analytics" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "0.26" ;
    :yValue "AI" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "0.41" ;
    :yValue "5G" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "0.44" ;
    :yValue "Edge computing" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "0.41" ;
    :yValue "IoT" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "0.4" ;
    :yValue "AR/VR" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "0.49" ;
    :yValue "Blockchain" ;
    :belongsTo :Chart .
