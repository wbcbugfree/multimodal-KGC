@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "How do you expect COVID-19 to impact your spending for any of the following ?" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Stay the same" .

:YAxis a :Axis ;
    :title "Response" .

:dataPoint1 a :dataPoint ;
    :xValue "0.13" ;
    :yValue "Cybersecurity" ;
    :belongsTo :Chart .

:dataPoint2 a :dataPoint ;
    :xValue "0.19" ;
    :yValue "Hybrid or multi-cloud" ;
    :belongsTo :Chart .

:dataPoint3 a :dataPoint ;
    :xValue "0.22" ;
    :yValue "Automation" ;
    :belongsTo :Chart .

:dataPoint4 a :dataPoint ;
    :xValue "0.27" ;
    :yValue "Smart analytics" ;
    :belongsTo :Chart .

:dataPoint5 a :dataPoint ;
    :xValue "0.26" ;
    :yValue "AI" ;
    :belongsTo :Chart .

:dataPoint6 a :dataPoint ;
    :xValue "0.41" ;
    :yValue "5G" ;
    :belongsTo :Chart .

:dataPoint7 a :dataPoint ;
    :xValue "0.44" ;
    :yValue "Edge computing" ;
    :belongsTo :Chart .

:dataPoint8 a :dataPoint ;
    :xValue "0.41" ;
    :yValue "IoT" ;
    :belongsTo :Chart .

:dataPoint9 a :dataPoint ;
    :xValue "0.4" ;
    :yValue "AR/VR" ;
    :belongsTo :Chart .

:dataPoint10 a :dataPoint ;
    :xValue "0.49" ;
    :yValue "Blockchain" ;
    :belongsTo :Chart .
