@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Revenue of the Walt Disney Company from 1st quarter 2018 to 4th quarter 2020 , by segment (in million U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Studio entertainment" .

:YAxis a :Axis ;
    :title "Quarter" .

:dataPoint1 a :dataPoint ;
    :xValue "1595" ;
    :yValue "Q4 2020" ;
    :belongsTo :Chart .

:dataPoint2 a :dataPoint ;
    :xValue "1738" ;
    :yValue "Q3 2020" ;
    :belongsTo :Chart .

:dataPoint3 a :dataPoint ;
    :xValue "2539" ;
    :yValue "Q2 2020" ;
    :belongsTo :Chart .

:dataPoint4 a :dataPoint ;
    :xValue "3764" ;
    :yValue "Q1 2020" ;
    :belongsTo :Chart .

:dataPoint5 a :dataPoint ;
    :xValue "3310" ;
    :yValue "Q4 2019" ;
    :belongsTo :Chart .

:dataPoint6 a :dataPoint ;
    :xValue "3836" ;
    :yValue "Q3 2019" ;
    :belongsTo :Chart .

:dataPoint7 a :dataPoint ;
    :xValue "2134" ;
    :yValue "Q2 2019*" ;
    :belongsTo :Chart .

:dataPoint8 a :dataPoint ;
    :xValue "1824" ;
    :yValue "Q1 2019" ;
    :belongsTo :Chart .

:dataPoint9 a :dataPoint ;
    :xValue "2880" ;
    :yValue "Q3 2018" ;
    :belongsTo :Chart .

:dataPoint10 a :dataPoint ;
    :xValue "2499" ;
    :yValue "Q2 2018" ;
    :belongsTo :Chart .

:dataPoint11 a :dataPoint ;
    :xValue "2509" ;
    :yValue "Q1 2018" ;
    :belongsTo :Chart .
