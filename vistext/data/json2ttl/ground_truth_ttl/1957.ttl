@prefix : <http://example.org/> .

:Chart a :AreaChart ;
    :title "Number of arrivals in tourist accommodation in Slovenia from 2006 to 2019 (in millions)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Number of arrivals in millions" .

:dataPoint1 a :dataPoint ;
    :xValue "Dec 31, 2005" ;
    :yValue "2.41" ;
    :belongsTo :Chart .

