@prefix : <http://example.org/> .

:Chart a :LineChart ;
    :title "Total net electricity generation in the United States from 1990 to 2019 , by fuel (in billion kilowatt hours)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Nuclear electric power" .

:dataPoint1 a :dataPoint ;
    :xValue "Dec 31, 1989" ;
    :yValue "576.86" ;
    :belongsTo :Chart .

