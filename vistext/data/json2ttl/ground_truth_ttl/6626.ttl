@prefix : <http://example.org/> .

:Chart a :LineChart ;
    :title "Revenue of the Walt Disney Company from 2010 to 2020 , by region (in million U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Asia Pacific" .

:dataPoint1 a :dataPoint ;
    :xValue "Dec 31, 2009" ;
    :yValue "2320" ;
    :belongsTo :Chart .

