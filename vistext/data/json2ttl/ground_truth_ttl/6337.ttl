@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Busiest London Underground stations by number of passengers in London (UK) 2016 - 2017 (in million entries and exits)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "2017" .

:YAxis a :Axis ;
    :title "busiest Underground stations in London" .

