@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Global search engine market share as of January 2020 , by search query size" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "AOL" .

:YAxis a :Axis ;
    :title "search query size" .

:dataPoint1 a :dataPoint ;
    :xValue "0.0002" ;
    :yValue "Total" ;
    :belongsTo :Chart .

:dataPoint2 a :dataPoint ;
    :xValue "0.0003" ;
    :yValue "One word" ;
    :belongsTo :Chart .

:dataPoint3 a :dataPoint ;
    :xValue "0.0001" ;
    :yValue "Two words" ;
    :belongsTo :Chart .

:dataPoint4 a :dataPoint ;
    :xValue "0.0001" ;
    :yValue "Three words" ;
    :belongsTo :Chart .

:dataPoint5 a :dataPoint ;
    :xValue "0.0001" ;
    :yValue "Four words" ;
    :belongsTo :Chart .

:dataPoint6 a :dataPoint ;
    :xValue "0.0002" ;
    :yValue "Five words" ;
    :belongsTo :Chart .

:dataPoint7 a :dataPoint ;
    :xValue "0.0002" ;
    :yValue "Six words" ;
    :belongsTo :Chart .

:dataPoint8 a :dataPoint ;
    :xValue "0.0002" ;
    :yValue "Seven words" ;
    :belongsTo :Chart .

:dataPoint9 a :dataPoint ;
    :xValue "0.0002" ;
    :yValue "Eight words" ;
    :belongsTo :Chart .

:dataPoint10 a :dataPoint ;
    :xValue "0.0002" ;
    :yValue "Nine words" ;
    :belongsTo :Chart .

:dataPoint11 a :dataPoint ;
    :xValue "0.0002" ;
    :yValue "Ten or more words" ;
    :belongsTo :Chart .
