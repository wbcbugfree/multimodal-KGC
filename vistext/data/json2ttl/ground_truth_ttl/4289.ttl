@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Growth of top 10 pharmaceutical companies in South Africa in 2014 - 2015" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Pharmaceutical company" .

:YAxis a :Axis ;
    :title "Percent growth (PPG)" .

:dataPoint1 a :dataPoint ;
    :xValue "Adcock Ingram" ;
    :yValue "0.116" ;
    :belongsTo :Chart .

:dataPoint2 a :dataPoint ;
    :xValue "Novartis" ;
    :yValue "0.113" ;
    :belongsTo :Chart .

:dataPoint3 a :dataPoint ;
    :xValue "Merck & Co." ;
    :yValue "0.096" ;
    :belongsTo :Chart .

:dataPoint4 a :dataPoint ;
    :xValue "Johnson & Johnson" ;
    :yValue "0.088" ;
    :belongsTo :Chart .

:dataPoint5 a :dataPoint ;
    :xValue "Pfizer" ;
    :yValue "0.088" ;
    :belongsTo :Chart .

:dataPoint6 a :dataPoint ;
    :xValue "Total market" ;
    :yValue "0.075" ;
    :belongsTo :Chart .

:dataPoint7 a :dataPoint ;
    :xValue "Sanofi" ;
    :yValue "0.072" ;
    :belongsTo :Chart .

:dataPoint8 a :dataPoint ;
    :xValue "Bayer" ;
    :yValue "0.071" ;
    :belongsTo :Chart .

:dataPoint9 a :dataPoint ;
    :xValue "Roche" ;
    :yValue "0.069" ;
    :belongsTo :Chart .

:dataPoint10 a :dataPoint ;
    :xValue "Aspen" ;
    :yValue "0.052" ;
    :belongsTo :Chart .

:dataPoint11 a :dataPoint ;
    :xValue "Cipla" ;
    :yValue "0.05" ;
    :belongsTo :Chart .
