@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Forecast volume of poultry meat consumed in the European Union (EU 27) from 2015 to 2028 (in 1,000 metric tons)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Volume in thousand metric tons" .

:DataPoint1 a :DataPoint ;
    :xValue "2028*" ;
    :yValue "12182" ;
    :belongsTo :Chart .

