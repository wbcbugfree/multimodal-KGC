@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Number of electoral votes from Hawaii designated to each party 's candidate in U.S. presidential elections from 1960 to 2020" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year and candidate" .

:YAxis a :Axis ;
    :title "Democrat" .

:dataPoint1 a :dataPoint ;
    :xValue "2020: Joe Biden*" ;
    :yValue "4" ;
    :belongsTo :Chart .

:dataPoint2 a :dataPoint ;
    :xValue "2016: Hillary Clinton" ;
    :yValue "3" ;
    :belongsTo :Chart .

:dataPoint3 a :dataPoint ;
    :xValue "2012: Barack Obama*" ;
    :yValue "4" ;
    :belongsTo :Chart .

:dataPoint4 a :dataPoint ;
    :xValue "2008: Barack Obama*" ;
    :yValue "4" ;
    :belongsTo :Chart .

:dataPoint5 a :dataPoint ;
    :xValue "2004: John Kerry" ;
    :yValue "4" ;
    :belongsTo :Chart .

:dataPoint6 a :dataPoint ;
    :xValue "2000: Al Gore" ;
    :yValue "4" ;
    :belongsTo :Chart .

:dataPoint7 a :dataPoint ;
    :xValue "1996: Bill Clinton*" ;
    :yValue "4" ;
    :belongsTo :Chart .

:dataPoint8 a :dataPoint ;
    :xValue "1992: Bill Clinton*" ;
    :yValue "4" ;
    :belongsTo :Chart .

:dataPoint9 a :dataPoint ;
    :xValue "1988: Michael Dukakis" ;
    :yValue "4" ;
    :belongsTo :Chart .

:dataPoint10 a :dataPoint ;
    :xValue "1980: Jimmy Carter" ;
    :yValue "4" ;
    :belongsTo :Chart .

:dataPoint11 a :dataPoint ;
    :xValue "1976: Jimmy Carter*" ;
    :yValue "4" ;
    :belongsTo :Chart .

:dataPoint12 a :dataPoint ;
    :xValue "1968: Hubert Humphrey" ;
    :yValue "4" ;
    :belongsTo :Chart .

:dataPoint13 a :dataPoint ;
    :xValue "1964: Lyndon B. Johnson*" ;
    :yValue "4" ;
    :belongsTo :Chart .

:dataPoint14 a :dataPoint ;
    :xValue "1960: John F. Kennedy*" ;
    :yValue "3" ;
    :belongsTo :Chart .
