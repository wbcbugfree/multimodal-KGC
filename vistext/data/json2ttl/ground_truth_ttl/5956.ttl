@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Apache Corporation 's revenue from 2007 to 2019 (in million U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Revenue in million U.S. dollars" .

:dataPoint1 a :dataPoint ;
    :xValue "2019" ;
    :yValue "6315" ;
    :belongsTo :Chart .

