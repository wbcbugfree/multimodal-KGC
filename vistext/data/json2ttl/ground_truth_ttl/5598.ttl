@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Total assets of the China Construction Bank from 2008 to 2019 (in billion yuan)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Total assets in billion yuan" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2007" ;
    :yValue "7555.5" ;
    :belongsTo :Chart .

