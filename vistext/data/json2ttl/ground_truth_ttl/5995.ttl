@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Share of American women who have given oral sex to a female in their lifetime , by age group" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Age group" .

:YAxis a :Axis ;
    :title "Share of respondents" .

:dataPoint1 a :dataPoint ;
    :xValue "14-15" ;
    :yValue "0.054" ;
    :belongsTo :Chart .

:dataPoint2 a :dataPoint ;
    :xValue "16-17" ;
    :yValue "0.09" ;
    :belongsTo :Chart .

:dataPoint3 a :dataPoint ;
    :xValue "18-19" ;
    :yValue "0.08" ;
    :belongsTo :Chart .

:dataPoint4 a :dataPoint ;
    :xValue "20-24" ;
    :yValue "0.14" ;
    :belongsTo :Chart .

:dataPoint5 a :dataPoint ;
    :xValue "25-29" ;
    :yValue "0.1" ;
    :belongsTo :Chart .

:dataPoint6 a :dataPoint ;
    :xValue "30-39" ;
    :yValue "0.14" ;
    :belongsTo :Chart .

:dataPoint7 a :dataPoint ;
    :xValue "40-49" ;
    :yValue "0.12" ;
    :belongsTo :Chart .

:dataPoint8 a :dataPoint ;
    :xValue "50-59" ;
    :yValue "0.07" ;
    :belongsTo :Chart .

:dataPoint9 a :dataPoint ;
    :xValue "60-69" ;
    :yValue "0.03" ;
    :belongsTo :Chart .

:dataPoint10 a :dataPoint ;
    :xValue "and older" ;
    :yValue "0.02" ;
    :belongsTo :Chart .
