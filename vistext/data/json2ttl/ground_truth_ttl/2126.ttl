@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Share of families with debt in the United States in 2019 , by type of debt" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "Share of families" .

:dataPoint1 a :dataPoint ;
    :xValue "Installment loans" ;
    :yValue "0.5146" ;
    :belongsTo :Chart .

:dataPoint2 a :dataPoint ;
    :xValue "Credit card balances" ;
    :yValue "0.4539" ;
    :belongsTo :Chart .

:dataPoint3 a :dataPoint ;
    :xValue "Home secured debt" ;
    :yValue "0.4209" ;
    :belongsTo :Chart .

:dataPoint4 a :dataPoint ;
    :xValue "Mortgages & home equity loans" ;
    :yValue "0.4001" ;
    :belongsTo :Chart .

:dataPoint5 a :dataPoint ;
    :xValue "Vehicle installment loans" ;
    :yValue "0.3689" ;
    :belongsTo :Chart .

:dataPoint6 a :dataPoint ;
    :xValue "Education installment loans" ;
    :yValue "0.2137" ;
    :belongsTo :Chart .

:dataPoint7 a :dataPoint ;
    :xValue "Other installment loans" ;
    :yValue "0.1073" ;
    :belongsTo :Chart .

:dataPoint8 a :dataPoint ;
    :xValue "Other debt" ;
    :yValue "0.0523" ;
    :belongsTo :Chart .

:dataPoint9 a :dataPoint ;
    :xValue "Other residential real estate debt" ;
    :yValue "0.0473" ;
    :belongsTo :Chart .

:dataPoint10 a :dataPoint ;
    :xValue "Home equity lines of credit" ;
    :yValue "0.0448" ;
    :belongsTo :Chart .

:dataPoint11 a :dataPoint ;
    :xValue "Other lines of credit" ;
    :yValue "0.0151" ;
    :belongsTo :Chart .
