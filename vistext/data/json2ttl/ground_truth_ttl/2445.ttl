@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Public sector expenditure on pensions in the United Kingdom (UK) from 2009/10 to 2019/20 (in billion GBP)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Expenditure in million GBP" .

:dataPoint1 a :dataPoint ;
    :xValue "2019/20" ;
    :yValue "112.93" ;
    :belongsTo :Chart .

:dataPoint2 a :dataPoint ;
    :xValue "2018/19" ;
    :yValue "116.97" ;
    :belongsTo :Chart .

:dataPoint3 a :dataPoint ;
    :xValue "2017/18" ;
    :yValue "113.74" ;
    :belongsTo :Chart .

:dataPoint4 a :dataPoint ;
    :xValue "2016/17" ;
    :yValue "111.41" ;
    :belongsTo :Chart .

:dataPoint5 a :dataPoint ;
    :xValue "2015/16" ;
    :yValue "110.06" ;
    :belongsTo :Chart .

:dataPoint6 a :dataPoint ;
    :xValue "2014/15" ;
    :yValue "108.02" ;
    :belongsTo :Chart .

:dataPoint7 a :dataPoint ;
    :xValue "2013/14" ;
    :yValue "104.03" ;
    :belongsTo :Chart .

:dataPoint8 a :dataPoint ;
    :xValue "2012/13" ;
    :yValue "102.21" ;
    :belongsTo :Chart .

:dataPoint9 a :dataPoint ;
    :xValue "2011/12" ;
    :yValue "93.73" ;
    :belongsTo :Chart .

:dataPoint10 a :dataPoint ;
    :xValue "2010/11" ;
    :yValue "87.31" ;
    :belongsTo :Chart .

:dataPoint11 a :dataPoint ;
    :xValue "2009/10" ;
    :yValue "83.53" ;
    :belongsTo :Chart .
