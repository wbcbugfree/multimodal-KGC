@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Gross revenue of Bajaj Electricals Limited between financial year 2010 and 2020 (in billion Indian rupees)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Revenue in billion Indian rupees" .

:dataPoint1 a :dataPoint ;
    :xValue "FY 2020" ;
    :yValue "50.3" ;
    :belongsTo :Chart .

:dataPoint2 a :dataPoint ;
    :xValue "FY 2019" ;
    :yValue "67.39" ;
    :belongsTo :Chart .

:dataPoint3 a :dataPoint ;
    :xValue "FY 2018" ;
    :yValue "47.7" ;
    :belongsTo :Chart .

:dataPoint4 a :dataPoint ;
    :xValue "FY 2017" ;
    :yValue "43.34" ;
    :belongsTo :Chart .

:dataPoint5 a :dataPoint ;
    :xValue "FY 2016" ;
    :yValue "46.75" ;
    :belongsTo :Chart .

:dataPoint6 a :dataPoint ;
    :xValue "FY 2015" ;
    :yValue "42.82" ;
    :belongsTo :Chart .

:dataPoint7 a :dataPoint ;
    :xValue "FY 2014" ;
    :yValue "40.59" ;
    :belongsTo :Chart .

:dataPoint8 a :dataPoint ;
    :xValue "FY 2013" ;
    :yValue "33.96" ;
    :belongsTo :Chart .

:dataPoint9 a :dataPoint ;
    :xValue "FY 2012" ;
    :yValue "31.25" ;
    :belongsTo :Chart .

:dataPoint10 a :dataPoint ;
    :xValue "FY 2011" ;
    :yValue "27.63" ;
    :belongsTo :Chart .

:dataPoint11 a :dataPoint ;
    :xValue "FY 2010" ;
    :yValue "22.48" ;
    :belongsTo :Chart .
