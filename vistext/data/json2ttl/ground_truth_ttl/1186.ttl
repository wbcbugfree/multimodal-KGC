@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Saudi Arabia : The ten largest cities in 2010 (in million inhabitants)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "big city" .

:YAxis a :Axis ;
    :title "Inhabitants in millions" .

:dataPoint1 a :dataPoint ;
    :xValue "Ar-Riyad" ;
    :yValue "5.19" ;
    :belongsTo :Chart .

:dataPoint2 a :dataPoint ;
    :xValue "Jiddah" ;
    :yValue "3.43" ;
    :belongsTo :Chart .

:dataPoint3 a :dataPoint ;
    :xValue "Makkah" ;
    :yValue "1.53" ;
    :belongsTo :Chart .

:dataPoint4 a :dataPoint ;
    :xValue "Al-Madinah" ;
    :yValue "1.1" ;
    :belongsTo :Chart .

:dataPoint5 a :dataPoint ;
    :xValue "Ad-Dammam" ;
    :yValue "0.9" ;
    :belongsTo :Chart .

:dataPoint6 a :dataPoint ;
    :xValue "Al-Hufuf & Al-Mubarraz" ;
    :yValue "0.66" ;
    :belongsTo :Chart .

:dataPoint7 a :dataPoint ;
    :xValue "At Ta'if" ;
    :yValue "0.58" ;
    :belongsTo :Chart .

:dataPoint8 a :dataPoint ;
    :xValue "Tabuk" ;
    :yValue "0.51" ;
    :belongsTo :Chart .

:dataPoint9 a :dataPoint ;
    :xValue "Buraydah" ;
    :yValue "0.47" ;
    :belongsTo :Chart .

:dataPoint10 a :dataPoint ;
    :xValue "Khamis Mushayt" ;
    :yValue "0.43" ;
    :belongsTo :Chart .
