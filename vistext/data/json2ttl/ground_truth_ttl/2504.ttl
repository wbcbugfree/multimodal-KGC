@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "German 1 . Bundesliga staff / employees in 2018/19 , by employee status" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Number of staff" .

:YAxis a :Axis ;
    :title "employee status" .

:DataPoint1 a :DataPoint ;
    :xValue "3941" ;
    :yValue "Full-time staff (Licensees)" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "61" ;
    :yValue "Trainees (Licensees)" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "1192" ;
    :yValue "Part-time staff (Licensees)" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "4799" ;
    :yValue "Temporary workers (Licensees)" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "100" ;
    :yValue "Full-time staff (Subsidiaries)" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "27" ;
    :yValue "Trainees (Subsidiaries)" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "583" ;
    :yValue "Part-time staff (Subsidiaries)" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "3137" ;
    :yValue "Temporary workers (Subsidiaries)" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "9188" ;
    :yValue "Security companies (Contractors)" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "9463" ;
    :yValue "Caterers (Contractors)" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "1127" ;
    :yValue "Medical services (Contractors)" ;
    :belongsTo :Chart .

:DataPoint12 a :DataPoint ;
    :xValue "3449" ;
    :yValue "Other (Contractors)" ;
    :belongsTo :Chart .
