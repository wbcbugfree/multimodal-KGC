@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "To what extent are you interested in the following sports ?" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Share of respondents" .

:YAxis a :Axis ;
    :title "Response" .

:dataPoint1 a :dataPoint ;
    :xValue "0.59" ;
    :yValue "Soccer" ;
    :belongsTo :Chart .

