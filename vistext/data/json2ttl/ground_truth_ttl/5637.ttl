@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "ICC Cricket Rankings : Leading test countries worldwide as of September 2020" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Rating" .

:YAxis a :Axis ;
    :title "Country" .

