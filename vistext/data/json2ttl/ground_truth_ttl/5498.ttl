@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "What do you think are the two most important issues facing Sweden at the moment ?" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Share of respondents" .

:YAxis a :Axis ;
    :title "Response" .

:dataPoint1 a :dataPoint ;
    :xValue "0.47" ;
    :yValue "Health and social security" ;
    :belongsTo :Chart .

:dataPoint2 a :dataPoint ;
    :xValue "0.39" ;
    :yValue "The enviroment, climate and energy issues" ;
    :belongsTo :Chart .

:dataPoint3 a :dataPoint ;
    :xValue "0.26" ;
    :yValue "The education system" ;
    :belongsTo :Chart .

:dataPoint4 a :dataPoint ;
    :xValue "0.21" ;
    :yValue "Crime" ;
    :belongsTo :Chart .

:dataPoint5 a :dataPoint ;
    :xValue "0.2" ;
    :yValue "Immigration" ;
    :belongsTo :Chart .

:dataPoint6 a :dataPoint ;
    :xValue "0.11" ;
    :yValue "Housing" ;
    :belongsTo :Chart .

:dataPoint7 a :dataPoint ;
    :xValue "0.1" ;
    :yValue "Economic situation" ;
    :belongsTo :Chart .

:dataPoint8 a :dataPoint ;
    :xValue "0.06" ;
    :yValue "Pensions" ;
    :belongsTo :Chart .

:dataPoint9 a :dataPoint ;
    :xValue "0.04" ;
    :yValue "Unemployment" ;
    :belongsTo :Chart .

:dataPoint10 a :dataPoint ;
    :xValue "0.04" ;
    :yValue "Taxation" ;
    :belongsTo :Chart .

:dataPoint11 a :dataPoint ;
    :xValue "0.03" ;
    :yValue "Rising prices/ inflation/ cost of living" ;
    :belongsTo :Chart .

:dataPoint12 a :dataPoint ;
    :xValue "0.02" ;
    :yValue "Terrorism" ;
    :belongsTo :Chart .

:dataPoint13 a :dataPoint ;
    :xValue "0.01" ;
    :yValue "Government debt" ;
    :belongsTo :Chart .
