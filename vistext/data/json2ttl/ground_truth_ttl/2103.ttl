@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Zinc production value in Canada in 2019 , by province (in 1,000 Canadian dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Production in 1,000 Canadian dollars" .

:YAxis a :Axis ;
    :title "province of Canada" .

:dataPoint1 a :dataPoint ;
    :xValue "0" ;
    :yValue "Newfoundland and Labrador" ;
    :belongsTo :Chart .

