@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Share of indigenous or native language speakers in Latin America in 2018 , by country" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "Share of respondents" .

