@prefix : <http://example.org/> .

:Chart a :AreaChart ;
    :title "Class I rail mileage within the United States 1990 to 2018 (in statute miles)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Length in statute miles" .

