@prefix : <http://example.org/> .

:Chart a :LineChart ;
    :title "Delta Air Lines Inc. 's available seat miles from FY 2008 to FY 2019 (in millions)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Available seat miles (in millions)" .

:dataPoint1 a :dataPoint ;
    :xValue "Dec 31, 2007" ;
    :yValue "165639" ;
    :belongsTo :Chart .

