@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Countries in which travel and tourism holds the largest share of government expenditure worldwide in 2013" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "Share of total expenditures" .

