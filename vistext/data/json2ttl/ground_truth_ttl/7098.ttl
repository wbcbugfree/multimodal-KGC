@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Greece : Government revenue and spending from 2014 to 2024 (in billion euros)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Revenue" .

:YAxis a :Axis ;
    :title "Year" .

:dataPoint1 a :dataPoint ;
    :xValue "96.93" ;
    :yValue "2024*" ;
    :belongsTo :Chart .

:dataPoint2 a :dataPoint ;
    :xValue "96.14" ;
    :yValue "2023*" ;
    :belongsTo :Chart .

:dataPoint3 a :dataPoint ;
    :xValue "94.39" ;
    :yValue "2022*" ;
    :belongsTo :Chart .

:dataPoint4 a :dataPoint ;
    :xValue "92.87" ;
    :yValue "2021*" ;
    :belongsTo :Chart .

:dataPoint5 a :dataPoint ;
    :xValue "91.31" ;
    :yValue "2020*" ;
    :belongsTo :Chart .

:dataPoint6 a :dataPoint ;
    :xValue "90.66" ;
    :yValue "2019*" ;
    :belongsTo :Chart .

:dataPoint7 a :dataPoint ;
    :xValue "88.06" ;
    :yValue "2018" ;
    :belongsTo :Chart .

:dataPoint8 a :dataPoint ;
    :xValue "87.14" ;
    :yValue "2017" ;
    :belongsTo :Chart .

:dataPoint9 a :dataPoint ;
    :xValue "87.28" ;
    :yValue "2016" ;
    :belongsTo :Chart .

:dataPoint10 a :dataPoint ;
    :xValue "84.77" ;
