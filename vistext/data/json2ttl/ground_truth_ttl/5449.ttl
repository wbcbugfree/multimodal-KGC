@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Distribution of the population in France as of January 1 , 2019 , by age group" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Distribution of the population" .

:YAxis a :Axis ;
    :title "Year" .

:dataPoint1 a :dataPoint ;
    :xValue "0.178" ;
    :yValue "Younger than 15 years old" ;
    :belongsTo :Chart .

:dataPoint2 a :dataPoint ;
    :xValue "0.062" ;
    :yValue "15 to 19 years old" ;
    :belongsTo :Chart .

:dataPoint3 a :dataPoint ;
    :xValue "0.056" ;
    :yValue "20 to 24 years old" ;
    :belongsTo :Chart .

:dataPoint4 a :dataPoint ;
    :xValue "0.055" ;
    :yValue "25 to 29 years old" ;
    :belongsTo :Chart .

:dataPoint5 a :dataPoint ;
    :xValue "0.061" ;
    :yValue "30 to 34 years old" ;
    :belongsTo :Chart .

:dataPoint6 a :dataPoint ;
    :xValue "0.063" ;
    :yValue "35 to 39 years old" ;
    :belongsTo :Chart .

:dataPoint7 a :dataPoint ;
    :xValue "0.061" ;
    :yValue "40 to 44 years old" ;
    :belongsTo :Chart .

:dataPoint8 a :dataPoint ;
    :xValue "0.067" ;
    :yValue "45 to 49 years old" ;
    :belongsTo :Chart .

:dataPoint9 a :dataPoint ;
    :xValue "0.066" ;
    :yValue "50 to 54 years old" ;
    :belongsTo :Chart .

:dataPoint10 a :dataPoint ;
    :xValue "0.065" ;
    :yValue "55 to 59 years old" ;
    :belongsTo :Chart .

:dataPoint11 a :dataPoint ;
    :xValue "0.061" ;
    :yValue "60 to 64 years old" ;
    :belongsTo :Chart .

:dataPoint12 a :dataPoint ;
    :xValue "0.058" ;
    :yValue "65 to 69 years old" ;
    :belongsTo :Chart .

:dataPoint13 a :dataPoint ;
    :xValue "0.052" ;
    :yValue "70 to 74 years old" ;
    :belongsTo :Chart .

:dataPoint14 a :dataPoint ;
    :xValue "75" ;
    :yValue "years and older" ;
    :belongsTo :Chart .
