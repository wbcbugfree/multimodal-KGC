@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Leading reasons for male university students in Japan to have not experienced sexual intercourse yet as of December 2017" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Share of respondents" .

:YAxis a :Axis ;
    :title "Response" .

:dataPoint1 a :dataPoint ;
    :xValue "0.719" ;
    :yValue "Lack of a partner" ;
    :belongsTo :Chart .

:dataPoint2 a :dataPoint ;
    :xValue "0.185" ;
    :yValue "Still too young" ;
    :belongsTo :Chart .

:dataPoint3 a :dataPoint ;
    :xValue "0.126" ;
    :yValue "No reason in particular" ;
    :belongsTo :Chart .

:dataPoint4 a :dataPoint ;
    :xValue "0.091" ;
    :yValue "Concerns about sexually transmitted diseases" ;
    :belongsTo :Chart .

:dataPoint5 a :dataPoint ;
    :xValue "0.089" ;
    :yValue "Not sure what to do" ;
    :belongsTo :Chart .

:dataPoint6 a :dataPoint ;
    :xValue "0.087" ;
    :yValue "Too much hassle" ;
    :belongsTo :Chart .

:dataPoint7 a :dataPoint ;
    :xValue "0.087" ;
    :yValue "Concerns about pregnancy" ;
    :belongsTo :Chart .

:dataPoint8 a :dataPoint ;
    :xValue "0.079" ;
    :yValue "Premarital sex is wrong" ;
    :belongsTo :Chart .

:dataPoint9 a :dataPoint ;
    :xValue "0.05" ;
    :yValue "Lack of sexual desire" ;
    :belongsTo :Chart .

:dataPoint10 a :dataPoint ;
    :xValue "0.036" ;
    :yValue "Aversion to sex" ;
    :belongsTo :Chart .

:dataPoint11 a :dataPoint ;
    :xValue "0.024" ;
    :yValue "Other" ;
    :belongsTo :Chart .

:dataPoint12 a :dataPoint ;
    :xValue "0.023" ;
    :yValue "No response" ;
    :belongsTo :Chart .
