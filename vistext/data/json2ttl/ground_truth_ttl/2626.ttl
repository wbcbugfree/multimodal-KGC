@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Leading reasons for male university students in Japan to have not experienced sexual intercourse yet as of December 2017" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Share of respondents" .

:YAxis a :Axis ;
    :title "Response" .

:DataPoint1 a :DataPoint ;
    :xValue "0.719" ;
    :yValue "Lack of a partner" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "0.185" ;
    :yValue "Still too young" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "0.126" ;
    :yValue "No reason in particular" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "0.091" ;
    :yValue "Concerns about sexually transmitted diseases" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "0.089" ;
    :yValue "Not sure what to do" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "0.087" ;
    :yValue "Too much hassle" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "0.087" ;
    :yValue "Concerns about pregnancy" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "0.079" ;
    :yValue "Premarital sex is wrong" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "0.05" ;
    :yValue "Lack of sexual desire" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "0.036" ;
    :yValue "Aversion to sex" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "0.024" ;
    :yValue "Other" ;
    :belongsTo :Chart .

:DataPoint12 a :DataPoint ;
    :xValue "0.023" ;
    :yValue "No response" ;
    :belongsTo :Chart .
