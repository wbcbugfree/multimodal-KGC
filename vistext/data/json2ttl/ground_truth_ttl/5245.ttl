@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Most centuries scored in international test match cricket as of September 2020 , by player" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Number of centuries scored" .

:YAxis a :Axis ;
    :title "player name" .

:DataPoint1 a :DataPoint ;
    :xValue "51" ;
    :yValue "SR Tendulkar (INDIA)" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "45" ;
    :yValue "JH Kallis (ICC/SA)" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "41" ;
    :yValue "RT Ponting (AUS)" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "38" ;
    :yValue "KC Sangakkara (SL)" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "36" ;
    :yValue "R Dravid (ICC/INDIA)" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "34" ;
    :yValue "Younis Khan (PAK)" ;
    :belongsTo :Chart .

