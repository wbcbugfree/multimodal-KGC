@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Most centuries scored in international test match cricket as of September 2020 , by player" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Number of centuries scored" .

:YAxis a :Axis ;
    :title "player name" .

:dataPoint1 a :dataPoint ;
    :xValue "51" ;
    :yValue "SR Tendulkar (INDIA)" ;
    :belongsTo :Chart .

:dataPoint2 a :dataPoint ;
    :xValue "45" ;
    :yValue "JH Kallis (ICC/SA)" ;
    :belongsTo :Chart .

