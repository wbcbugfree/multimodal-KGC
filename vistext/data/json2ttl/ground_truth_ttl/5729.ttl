@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Actions taken in last three years because of security and privacy issues when using the internet according to online users in the United States as of September 2018" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Percentage of respondents" .

:YAxis a :Axis ;
    :title "Response" .

:dataPoint1 a :dataPoint ;
    :xValue "0.44" ;
    :yValue "I am less likely to give personal info on websites" ;
    :belongsTo :Chart .

:dataPoint2 a :dataPoint ;
    :xValue "0.42" ;
    :yValue "I decided to only visit websites I know and trust" ;
    :belongsTo :Chart .

:dataPoint3 a :dataPoint ;
    :xValue "0.42" ;
    :yValue "I only use my own computer" ;
    :belongsTo :Chart .

:dataPoint4 a :dataPoint ;
    :xValue "0.41" ;
    :yValue "I started opening only emails from people I know" ;
    :belongsTo :Chart .

:dataPoint5 a :dataPoint ;
    :xValue "0.37" ;
    :yValue "I started using different passwords" ;
    :belongsTo :Chart .

:dataPoint6 a :dataPoint ;
    :xValue "0.36" ;
    :yValue "I have installed antivirus software" ;
    :belongsTo :Chart .

:dataPoint7 a :dataPoint ;
    :xValue "0.32" ;
    :yValue "I have changed the security settings" ;
    :belongsTo :Chart .

:dataPoint8 a :dataPoint ;
    :xValue "0.24" ;
    :yValue "I started changing my passwords regularly" ;
    :belongsTo :Chart .

:dataPoint9 a :dataPoint ;
    :xValue "0.2" ;
    :yValue "I am less likely to bank online" ;
    :belongsTo :Chart .

:dataPoint10 a :dataPoint ;
    :xValue "0.19" ;
    :yValue "I am less likely to buy goods or services online" ;
    :belongsTo :Chart .

:dataPoint11 a :dataPoint ;
    :xValue "0.09" ;
    :yValue "None" ;
    :belongsTo :Chart .

:dataPoint12 a :dataPoint ;
    :xValue "0.06" ;
    :yValue "I cancelled an online purchase" ;
    :belongsTo :Chart .

:dataPoint13 a :dataPoint ;
    :xValue "0.04" ;
    :yValue "Don't know" ;
    :belongsTo :Chart .

:dataPoint14 a :dataPoint ;
    :xValue "0.01" ;
    :yValue "Other" ;
    :belongsTo :Chart .
