@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Uganda : Total population from 2015 to 2025 (in million inhabitants)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Inhabitants in millions" .

:dataPoint1 a :dataPoint ;
    :xValue "2025*" ;
    :yValue "47.79" ;
    :belongsTo :Chart .

:dataPoint2 a :dataPoint ;
    :xValue "2024*" ;
    :yValue "46.4" ;
    :belongsTo :Chart .

:dataPoint3 a :dataPoint ;
    :xValue "2023*" ;
    :yValue "45.05" ;
    :belongsTo :Chart .

:dataPoint4 a :dataPoint ;
    :xValue "2022*" ;
    :yValue "43.73" ;
    :belongsTo :Chart .

:dataPoint5 a :dataPoint ;
    :xValue "2021*" ;
    :yValue "42.46" ;
    :belongsTo :Chart .

:dataPoint6 a :dataPoint ;
    :xValue "2020*" ;
    :yValue "41.22" ;
    :belongsTo :Chart .

:dataPoint7 a :dataPoint ;
    :xValue "2019*" ;
    :yValue "39.82" ;
    :belongsTo :Chart .

:dataPoint8 a :dataPoint ;
    :xValue "2018*" ;
    :yValue "38.82" ;
    :belongsTo :Chart .

:dataPoint9 a :dataPoint ;
    :xValue "2017*" ;
    :yValue "37.67" ;
    :belongsTo :Chart .

:dataPoint10 a :dataPoint ;
    :xValue "2016" ;
    :yValue "36.56" ;
    :belongsTo :Chart .

:dataPoint11 a :dataPoint ;
    :xValue "2015" ;
    :yValue "35.49" ;
    :belongsTo :Chart .
