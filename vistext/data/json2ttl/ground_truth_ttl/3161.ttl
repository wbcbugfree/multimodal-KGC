@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Number of enterprises in the manufacture of plastics products industry in Spain from 2008 to 2017" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Number of enterprises" .

:YAxis a :Axis ;
    :title "Year" .

:dataPoint1 a :dataPoint ;
    :xValue "3610" ;
    :yValue "2017*" ;
    :belongsTo :Chart .

