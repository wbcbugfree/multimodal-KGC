@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Market share in terms of total loans of the Italian global banking group UniCredit Bank in Europe as of November 2017 , by country" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Country" .

:YAxis a :Axis ;
    :title "Loans market share" .

:dataPoint1 a :dataPoint ;
    :xValue "Croatia*" ;
    :yValue "0.273" ;
    :belongsTo :Chart .

