@prefix : <http://example.org/> .

:Chart a :AreaChart ;
    :title "Fresh banana imports to the United States from 2010 to 2019 (in million pounds)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Import volume in million pounds" .

:dataPoint1 a :dataPoint ;
    :xValue "Dec 31, 2009" ;
    :yValue "9026.06" ;
    :belongsTo :Chart .

