@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Most trusted institutions to tell the truth about the coronavirus (COVID-19) in Brazil in March 2020" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Share of respondents" .

:YAxis a :Axis ;
    :title "Response" .

:dataPoint1 a :dataPoint ;
    :xValue "0.91" ;
    :yValue "Scientists" ;
    :belongsTo :Chart .

:dataPoint2 a :dataPoint ;
    :xValue "0.86" ;
    :yValue "My doctor" ;
    :belongsTo :Chart .

:dataPoint3 a :dataPoint ;
    :xValue "0.82" ;
    :yValue "WHO officials" ;
    :belongsTo :Chart .

:dataPoint4 a :dataPoint ;
    :xValue "0.81" ;
    :yValue "Doctors/health experts online" ;
    :belongsTo :Chart .

:dataPoint5 a :dataPoint ;
    :xValue "0.79" ;
    :yValue "A person like yourself" ;
    :belongsTo :Chart .

:dataPoint6 a :dataPoint ;
    :xValue "0.74" ;
    :yValue "Healthcare authorities" ;
    :belongsTo :Chart .

:dataPoint7 a :dataPoint ;
    :xValue "0.7" ;
    :yValue "NGO representatives" ;
    :belongsTo :Chart .

:dataPoint8 a :dataPoint ;
    :xValue "0.68" ;
    :yValue "Healthcare CEOs" ;
    :belongsTo :Chart .

:dataPoint9 a :dataPoint ;
    :xValue "0.68" ;
    :yValue "My employer CEO" ;
    :belongsTo :Chart .

:dataPoint10 a :dataPoint ;
    :xValue "0.67" ;
    :yValue "Countries most affected" ;
    :belongsTo :Chart .

:dataPoint11 a :dataPoint ;
    :xValue "0.64" ;
    :yValue "My co-workers" ;
    :belongsTo :Chart .

:dataPoint12 a :dataPoint ;
    :xValue "0.6" ;
    :yValue "Journalists" ;
    :belongsTo :Chart .

:dataPoint13 a :dataPoint ;
    :xValue "0.59" ;
    :yValue "The news media" ;
    :belongsTo :Chart .

:dataPoint14 a :dataPoint ;
    :xValue "0.55" ;
    :yValue "My country's leader" ;
    :belongsTo :Chart .

:dataPoint15 a :dataPoint ;
    :xValue "0.53" ;
    :yValue "Governmental officials" ;
    :belongsTo :Chart .
