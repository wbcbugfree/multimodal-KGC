@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Most trusted institutions to tell the truth about the coronavirus (COVID-19) in Brazil in March 2020" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Share of respondents" .

:YAxis a :Axis ;
    :title "Response" .

:DataPoint1 a :DataPoint ;
    :xValue "0.91" ;
    :yValue "Scientists" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "0.86" ;
    :yValue "My doctor" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "0.82" ;
    :yValue "WHO officials" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "0.81" ;
    :yValue "Doctors/health experts online" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "0.79" ;
    :yValue "A person like yourself" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "0.74" ;
    :yValue "Healthcare authorities" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "0.7" ;
    :yValue "NGO representatives" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "0.68" ;
    :yValue "Healthcare CEOs" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "0.68" ;
    :yValue "My employer CEO" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "0.67" ;
    :yValue "Countries most affected" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "0.64" ;
    :yValue "My co-workers" ;
    :belongsTo :Chart .

:DataPoint12 a :DataPoint ;
    :xValue "0.6" ;
    :yValue "Journalists" ;
    :belongsTo :Chart .

:DataPoint13 a :DataPoint ;
    :xValue "0.59" ;
    :yValue "The news media" ;
    :belongsTo :Chart .

:DataPoint14 a :DataPoint ;
    :xValue "0.55" ;
    :yValue "My country's leader" ;
    :belongsTo :Chart .

:DataPoint15 a :DataPoint ;
    :xValue "0.53" ;
    :yValue "Governmental officials" ;
    :belongsTo :Chart .
