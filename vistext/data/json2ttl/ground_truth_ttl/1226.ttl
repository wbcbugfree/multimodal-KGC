@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Georgia : Total population from 2015 to 2025 (in million inhabitants)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Inhabitants in millions" .

:YAxis a :Axis ;
    :title "Year" .

:dataPoint1 a :dataPoint ;
    :xValue "3.7" ;
    :yValue "2025*" ;
    :belongsTo :Chart .

:dataPoint2 a :dataPoint ;
    :xValue "3.71" ;
    :yValue "2024*" ;
    :belongsTo :Chart .

:dataPoint3 a :dataPoint ;
    :xValue "3.71" ;
    :yValue "2023*" ;
    :belongsTo :Chart .

:dataPoint4 a :dataPoint ;
    :xValue "3.71" ;
    :yValue "2022*" ;
    :belongsTo :Chart .

:dataPoint5 a :dataPoint ;
    :xValue "3.71" ;
    :yValue "2021*" ;
    :belongsTo :Chart .

:dataPoint6 a :dataPoint ;
    :xValue "3.7" ;
    :yValue "2020*" ;
    :belongsTo :Chart .

:dataPoint7 a :dataPoint ;
    :xValue "3.72" ;
    :yValue "2019*" ;
    :belongsTo :Chart .

:dataPoint8 a :dataPoint ;
    :xValue "3.73" ;
    :yValue "2018*" ;
    :belongsTo :Chart .

:dataPoint9 a :dataPoint ;
    :xValue "3.73" ;
    :yValue "2017*" ;
    :belongsTo :Chart .

:dataPoint10 a :dataPoint ;
    :xValue "3.73" ;
    :yValue "2016*" ;
    :belongsTo :Chart .

:dataPoint11 a :dataPoint ;
    :xValue "3.72" ;
    :yValue "2015" ;
    :belongsTo :Chart .
