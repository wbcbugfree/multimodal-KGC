@prefix : <http://example.org/> .

:Chart a :AreaChart ;
    :title "Number of aircraft arrivals at Changi Airport in Singapore from 2010 to 2019" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Number of aircraft arrivals" .

:dataPoint1 a :dataPoint ;
    :xValue "Dec 31, 2009" ;
    :yValue "131769" ;
    :belongsTo :Chart .

