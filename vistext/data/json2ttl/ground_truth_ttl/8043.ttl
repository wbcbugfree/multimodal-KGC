@prefix : <http://example.org/> .

:Chart a :LineChart ;
    :title "Average daily cigarette consumption in Great Britain from 2000 to 2016 , by gender (in cigarettes per day)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Men" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 1999" ;
    :yValue "15" ;
    :belongsTo :Chart .

