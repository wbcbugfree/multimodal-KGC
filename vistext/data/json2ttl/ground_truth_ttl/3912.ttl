@prefix : <http://example.org/> .

:Chart a :LineChart ;
    :title "Annual volume of carbon dioxide (CO2) emissions from transport sector 's energy consumption in Taiwan from 2006 to 2017 (in million metric tons)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Emission volume in million metric tons" .

:dataPoint1 a :dataPoint ;
    :xValue "Dec 31, 2005" ;
    :yValue "36.77" ;
    :belongsTo :Chart .

