@prefix : <http://example.org/> .

:Chart a :LineChart ;
    :title "FIFA World Ranking of the Norwegian women 's national football team from 2003 to 2019" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "FIFA World Ranking* position" .

:dataPoint1 a :dataPoint ;
    :xValue "Dec 31, 2002" ;
    :yValue "3" ;
    :belongsTo :Chart .

