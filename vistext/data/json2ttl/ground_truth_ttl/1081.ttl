@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Share of voice on sportsbooks among leading websites in the United States from July to September 2019" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "Share of voice" .

:dataPoint1 a :dataPoint ;
    :xValue "Wikipedia (wikipedia.org)" ;
    :yValue "0.0496" ;
    :belongsTo :Chart .

