@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Highest first week box office grossers from India as of June 2020 , by worldwide revenue (in million Indian rupees)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "film" .

:YAxis a :Axis ;
    :title "Revenue in million Indian rupees" .

