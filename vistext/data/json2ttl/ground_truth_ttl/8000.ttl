@prefix : <http://example.org/> .

:Chart a :LineChart ;
    :title "Value of U.S. imports and exports of goods from 2000 to 2011 (in trillion U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Exports" .

:dataPoint1 a :dataPoint ;
    :xValue "Dec 31, 1999" ;
    :yValue "0.78" ;
    :belongsTo :Chart .

:dataPoint2 a :dataPoint ;
    :xValue "Dec 31, 2000" ;
    :yValue "0.73" ;
    :belongsTo :Chart .

