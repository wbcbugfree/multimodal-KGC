    :xValue "Dec 31, 2003" ;
    :yValue "0.82" ;
    :belongsTo :Chart .

:dataPoint6 a :dataPoint ;
    :xValue "Dec 31, 2004" ;
    :yValue "0.91" ;
    :belongsTo :Chart .

:dataPoint7 a :dataPoint ;
