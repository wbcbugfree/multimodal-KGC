@prefix : <http://example.org/> .

:Chart a :AreaChart ;
    :title "Brunswick number of employees worldwide from 2009 to 2019" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Number of employees" .

