@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Top ten countries of birth for foreign-born people in Canada in 2016" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Number of people residing in Canada" .

:YAxis a :Axis ;
    :title "Country" .

:dataPoint1 a :dataPoint ;
    :xValue "668565" ;
    :yValue "India" ;
    :belongsTo :Chart .

