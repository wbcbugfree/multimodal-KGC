    :xValue "253715" ;
    :yValue "United States" ;
    :belongsTo :Chart .

:dataPoint6 a :dataPoint ;
    :xValue "236640" ;
    :yValue "Italy" ;
    :belongsTo :Chart .

:dataPoint7 a :dataPoint ;
    :xValue "208940" ;
    :yValue "Hong Kong" ;
    :belongsTo :Chart .

:dataPoint8 a :dataPoint ;
    :xValue "202260" ;
