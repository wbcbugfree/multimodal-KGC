@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Contribution to gross domestic product of Indonesia in 2019 , by industry" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Share of gross domestic product" .

:YAxis a :Axis ;
    :title "Response" .

:dataPoint1 a :dataPoint ;
    :xValue "0.197" ;
    :yValue "Manufacturing" ;
    :belongsTo :Chart .

:dataPoint2 a :dataPoint ;
    :xValue "0.13" ;
    :yValue "Wholesale and retail trade, repair of motor vehicles and motorcycles" ;
    :belongsTo :Chart .

