@prefix : <http://example.org/> .

:Chart a :LineChart ;
    :title "Number of cyclists fatalities due to road accidents in Delhi , India from 2004 to 2018" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Number of victims" .

:dataPoint1 a :dataPoint ;
    :xValue "Dec 31, 2003" ;
    :yValue "181" ;
    :belongsTo :Chart .

