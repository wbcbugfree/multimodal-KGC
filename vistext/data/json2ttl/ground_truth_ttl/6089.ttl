@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Which , if any , of the following measures have you taken in the past 2 weeks specifically to protect yourself from the Coronavirus (COVID-19) ?" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Feb 29 to Mar 1" .

:YAxis a :Axis ;
    :title "Response" .

:dataPoint1 a :dataPoint ;
    :xValue "0.14" ;
    :yValue "Avoid crowded public places" ;
    :belongsTo :Chart .

:dataPoint2 a :dataPoint ;
    :xValue "0.35" ;
    :yValue "Improve personal hygiene (e.g. washing hands more frequently, using hand sanitizer)" ;
    :belongsTo :Chart .

:dataPoint3 a :dataPoint ;
    :xValue "0.14" ;
    :yValue "Refrain from touching objects in public" ;
    :belongsTo :Chart .

:dataPoint4 a :dataPoint ;
    :xValue "0.02" ;
    :yValue "Avoid going to work" ;
    :belongsTo :Chart .

:dataPoint5 a :dataPoint ;
    :xValue "0.09" ;
    :yValue "Avoid physical contact with tourists" ;
    :belongsTo :Chart .

:dataPoint6 a :dataPoint ;
    :xValue "0.06" ;
    :yValue "Avoid consumption of raw or uncooked meat" ;
    :belongsTo :Chart .

:dataPoint7 a :dataPoint ;
    :xValue "0.01" ;
    :yValue "Wear a face mask in public places" ;
    :belongsTo :Chart .

:dataPoint8 a :dataPoint ;
    :xValue "0.54" ;
    :yValue "No measures taken" ;
    :belongsTo :Chart .
