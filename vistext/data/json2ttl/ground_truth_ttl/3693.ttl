@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Cancer incidence rates among men in selected countries worldwide between 2003 and 2007 (per 100,000 population)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Incidence rate per 100,000 population" .

:YAxis a :Axis ;
    :title "Country" .

:dataPoint1 a :dataPoint ;
    :xValue "446.1" ;
    :yValue "USA: Black" ;
    :belongsTo :Chart .

