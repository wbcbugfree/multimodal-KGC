@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Average annual boating days by boat type in the U.S. 2013" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Average annual boating days" .

:YAxis a :Axis ;
    :title "Type of boat" .

:dataPoint1 a :dataPoint ;
    :xValue "11.2" ;
    :yValue "Kayak/Canoe" ;
    :belongsTo :Chart .

:dataPoint2 a :dataPoint ;
    :xValue "10.7" ;
    :yValue "Sail Boat" ;
    :belongsTo :Chart .

:dataPoint3 a :dataPoint ;
    :xValue "10.7" ;
    :yValue "Personal Watercraft" ;
    :belongsTo :Chart .

:dataPoint4 a :dataPoint ;
    :xValue "10.3" ;
    :yValue "Deck" ;
    :belongsTo :Chart .

:dataPoint5 a :dataPoint ;
    :xValue "10.2" ;
    :yValue "Bass Boat" ;
    :belongsTo :Chart .

:dataPoint6 a :dataPoint ;
    :xValue "9.3" ;
    :yValue "Sport Fishing Yacht" ;
    :belongsTo :Chart .

:dataPoint7 a :dataPoint ;
    :xValue "9.1" ;
    :yValue "Cruiser" ;
    :belongsTo :Chart .

:dataPoint8 a :dataPoint ;
    :xValue "8.5" ;
    :yValue "Wakeboard/Ski Boat" ;
    :belongsTo :Chart .

:dataPoint9 a :dataPoint ;
    :xValue "8.1" ;
    :yValue "Bowrider/Run About/Jet Boat" ;
    :belongsTo :Chart .

:dataPoint10 a :dataPoint ;
    :xValue "7.9" ;
    :yValue "Multispecies/Other Fish Boat" ;
    :belongsTo :Chart .

:dataPoint11 a :dataPoint ;
    :xValue "7.3" ;
    :yValue "Pontoon" ;
    :belongsTo :Chart .

:dataPoint12 a :dataPoint ;
    :xValue "5.8" ;
    :yValue "High Performance" ;
    :belongsTo :Chart .

:dataPoint13 a :dataPoint ;
    :xValue "5.5" ;
    :yValue "Center Console" ;
