@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Direct contribution of travel and tourism to employment worldwide from 2016 to 2017 , by region (in millions)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "2017" .

:YAxis a :Axis ;
    :title "geographic region" .

:DataPoint1 a :DataPoint ;
    :xValue "30.49" ;
    :yValue "North East Asia" ;
    :belongsTo :Chart .

