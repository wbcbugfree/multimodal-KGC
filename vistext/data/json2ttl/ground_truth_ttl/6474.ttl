@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Direct contribution of travel and tourism to employment worldwide from 2016 to 2017 , by region (in millions)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "2017" .

:YAxis a :Axis ;
    :title "geographic region" .

