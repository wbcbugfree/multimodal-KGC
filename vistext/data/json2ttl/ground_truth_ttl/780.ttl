@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Sales price of bakers ' yeast per ton manufactured in the United Kingdom (UK) from 2008 to 2017 (in GBP)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Price per ton in British pounds" .

:dataPoint1 a :dataPoint ;
    :xValue "2017" ;
    :yValue "555.43" ;
    :belongsTo :Chart .

:dataPoint2 a :dataPoint ;
    :xValue "2014" ;
    :yValue "537.9" ;
    :belongsTo :Chart .

:dataPoint3 a :dataPoint ;
    :xValue "2013" ;
    :yValue "675.8" ;
    :belongsTo :Chart .

:dataPoint4 a :dataPoint ;
    :xValue "2012" ;
    :yValue "534.55" ;
    :belongsTo :Chart .

:dataPoint5 a :dataPoint ;
    :xValue "2011" ;
    :yValue "584.72" ;
    :belongsTo :Chart .

:dataPoint6 a :dataPoint ;
    :xValue "2009" ;
    :yValue "572.24" ;
    :belongsTo :Chart .

:dataPoint7 a :dataPoint ;
    :xValue "2008" ;
    :yValue "521.79" ;
    :belongsTo :Chart .
