@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Countries with the highest stillbirth rates in 2009 (per 1,000 births)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Country" .

:YAxis a :Axis ;
    :title "Rate per 1,000 births" .

:dataPoint1 a :dataPoint ;
    :xValue "Pakistan" ;
    :yValue "47" ;
    :belongsTo :Chart .

