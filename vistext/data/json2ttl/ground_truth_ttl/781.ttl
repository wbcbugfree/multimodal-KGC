@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Production of cotton fabric in India from financial year 2008 to 2018 (in billion square meters)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Production in billion square meters" .

:YAxis a :Axis ;
    :title "Fiscal years" .

:dataPoint1 a :dataPoint ;
    :xValue "39.89" ;
    :yValue "FY 2018*" ;
    :belongsTo :Chart .

:dataPoint2 a :dataPoint ;
    :xValue "38.84" ;
    :yValue "FY 2017" ;
    :belongsTo :Chart .

:dataPoint3 a :dataPoint ;
    :xValue "38.44" ;
    :yValue "FY 2016" ;
    :belongsTo :Chart .

:dataPoint4 a :dataPoint ;
    :xValue "36.96" ;
    :yValue "FY 2015" ;
    :belongsTo :Chart .

:dataPoint5 a :dataPoint ;
    :xValue "35.51" ;
    :yValue "FY 2014" ;
    :belongsTo :Chart .

:dataPoint6 a :dataPoint ;
    :xValue "33.87" ;
    :yValue "FY 2013" ;
    :belongsTo :Chart .

:dataPoint7 a :dataPoint ;
    :xValue "30.57" ;
    :yValue "FY 2012" ;
    :belongsTo :Chart .

:dataPoint8 a :dataPoint ;
    :xValue "31.72" ;
    :yValue "FY 2011" ;
    :belongsTo :Chart .

:dataPoint9 a :dataPoint ;
    :xValue "28.91" ;
    :yValue "FY 2010" ;
    :belongsTo :Chart .

:dataPoint10 a :dataPoint ;
    :xValue "26.9" ;
    :yValue "FY 2009" ;
    :belongsTo :Chart .

:dataPoint11 a :dataPoint ;
    :xValue "27.2" ;
    :yValue "FY 2008" ;
    :belongsTo :Chart .
