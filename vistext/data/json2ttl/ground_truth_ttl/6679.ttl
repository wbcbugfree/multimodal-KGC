@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "U.S. natural gas consumption between 2005 and 2019 , by sector (in billion cubic feet)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Electric power**" .

:YAxis a :Axis ;
    :title "Year" .

:DataPoint1 a :DataPoint ;
    :xValue "11307" ;
    :yValue "2019***" ;
    :belongsTo :Chart .

