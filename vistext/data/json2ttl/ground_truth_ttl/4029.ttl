@prefix : <http://example.org/> .

:Chart a :AreaChart ;
    :title "Annual revenue of Baidu from 2008 to 2019 (in billion U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Revenue in billion U.S. dollars" .

:dataPoint1 a :dataPoint ;
    :xValue "Dec 31, 2007" ;
    :yValue "0.46" ;
    :belongsTo :Chart .

