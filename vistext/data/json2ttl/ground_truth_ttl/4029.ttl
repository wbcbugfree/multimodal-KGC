    :xValue "Dec 31, 2012" ;
    :yValue "5.25" ;
    :belongsTo :Chart .

:dataPoint7 a :dataPoint ;
    :xValue "Dec 31, 2013" ;
    :yValue "7.91" ;
    :belongsTo :Chart .

:dataPoint8 a :dataPoint ;
