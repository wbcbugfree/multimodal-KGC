@prefix : <http://example.org/> .

:Chart a :AreaChart ;
    :title "Annual prevalence of use of Adderall for grades 8 , 10 and 12 from 2009 to 2019" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "12th grade" .

:dataPoint1 a :dataPoint ;
    :xValue "Dec 31, 2008" ;
    :yValue "0.054" ;
    :belongsTo :Chart .

