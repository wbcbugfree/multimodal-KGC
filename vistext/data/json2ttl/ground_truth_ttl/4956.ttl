    :xValue "Malaysia" ;
    :yValue "200" ;
    :belongsTo :Chart .

:dataPoint5 a :dataPoint ;
    :xValue "India & West Asia**" ;
    :yValue "145" ;
    :belongsTo :Chart .

:dataPoint6 a :dataPoint ;
    :xValue "Indonesia" ;
    :yValue "80" ;
    :belongsTo :Chart .

:dataPoint7 a :dataPoint ;
    :xValue "China & Macau" ;
    :yValue "50" ;
    :belongsTo :Chart .

:dataPoint8 a :dataPoint ;
    :xValue "South Korea" ;
    :yValue "40" ;
    :belongsTo :Chart .

:dataPoint9 a :dataPoint ;
    :xValue "Burma" ;
    :yValue "40" ;
