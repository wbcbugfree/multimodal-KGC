@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Value of Premier League TV broadcasting deals in Asia in the time period from 2013 to 2016 (in million U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Country" .

:YAxis a :Axis ;
    :title "TV deal value in million U.S. dollars" .

:dataPoint1 a :dataPoint ;
    :xValue "Thailand*" ;
    :yValue "320" ;
    :belongsTo :Chart .

:dataPoint2 a :dataPoint ;
    :xValue "Singapore" ;
    :yValue "297" ;
    :belongsTo :Chart .

:dataPoint3 a :dataPoint ;
    :xValue "Hong Kong" ;
    :yValue "200" ;
    :belongsTo :Chart .

