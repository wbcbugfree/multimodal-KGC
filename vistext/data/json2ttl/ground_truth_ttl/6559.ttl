    :yValue "0.1394" ;
    :belongsTo :Chart .

:dataPoint6 a :dataPoint ;
    :xValue "Dec 31, 2013" ;
    :yValue "0.143" ;
    :belongsTo :Chart .

:dataPoint7 a :dataPoint ;
