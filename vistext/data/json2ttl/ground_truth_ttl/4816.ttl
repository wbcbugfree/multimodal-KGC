    :xValue "10.53" ;
    :yValue "South East" ;
    :belongsTo :Chart .

:dataPoint4 a :dataPoint ;
    :xValue "9.47" ;
    :yValue "Yorkshire and the Humber" ;
    :belongsTo :Chart .

:dataPoint5 a :dataPoint ;
    :xValue "8.11" ;
    :yValue "West Midlands" ;
    :belongsTo :Chart .

:dataPoint6 a :dataPoint ;
    :xValue "6.71" ;
    :yValue "East of England" ;
    :belongsTo :Chart .

:dataPoint7 a :dataPoint ;
    :xValue "4.86" ;
    :yValue "South West" ;
    :belongsTo :Chart .

:dataPoint8 a :dataPoint ;
    :xValue "4.81" ;
    :yValue "East Midlands" ;
    :belongsTo :Chart .

:dataPoint9 a :dataPoint ;
    :xValue "3.07" ;
