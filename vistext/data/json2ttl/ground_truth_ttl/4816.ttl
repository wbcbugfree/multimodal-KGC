@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Number of racially motivated hate crimes in England and Wales from April 2019 to March 2020 , by region" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Number of hate crimes*" .

:YAxis a :Axis ;
    :title "region" .

:dataPoint1 a :dataPoint ;
    :xValue "17.6" ;
    :yValue "London" ;
    :belongsTo :Chart .

:dataPoint2 a :dataPoint ;
    :xValue "5.47" ;
    :yValue "North West" ;
    :belongsTo :Chart .

