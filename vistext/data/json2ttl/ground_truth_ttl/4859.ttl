@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Most popular Facebook games as of May 2019 , based on number of daily active users (in millions)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Facebook game" .

:YAxis a :Axis ;
    :title "Number of daily active users in millions" .

:DataPoint1 a :DataPoint ;
    :xValue "8" ;
    :yValue "Ball Pool" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "10" ;
    :yValue "Candy Crush Saga" ;
    :belongsTo :Chart .

