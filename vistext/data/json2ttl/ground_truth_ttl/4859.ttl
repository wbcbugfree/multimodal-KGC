@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Most popular Facebook games as of May 2019 , based on number of daily active users (in millions)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Facebook game" .

:YAxis a :Axis ;
    :title "Number of daily active users in millions" .

:dataPoint1 a :dataPoint ;
    :xValue "8" ;
    :yValue "Ball Pool" ;
    :belongsTo :Chart .

:dataPoint2 a :dataPoint ;
    :xValue "10" ;
    :yValue "Candy Crush Saga" ;
    :belongsTo :Chart .

