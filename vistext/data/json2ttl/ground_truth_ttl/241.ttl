@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Main coronavirus (COVID-19) -related issues affecting the agriculture in Italy in 2020" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "Share of respondents" .

:dataPoint1 a :dataPoint ;
    :xValue "Lower sales" ;
    :yValue "0.57" ;
    :belongsTo :Chart .

:dataPoint2 a :dataPoint ;
    :xValue "Outsourcing of external services (logistics)" ;
    :yValue "0.23" ;
    :belongsTo :Chart .

:dataPoint3 a :dataPoint ;
    :xValue "Sourcing of raw materials" ;
    :yValue "0.14" ;
    :belongsTo :Chart .

:dataPoint4 a :dataPoint ;
    :xValue "Absent employees" ;
    :yValue "0.13" ;
    :belongsTo :Chart .

:dataPoint5 a :dataPoint ;
    :xValue "Canceled trade fairs" ;
    :yValue "0.12" ;
    :belongsTo :Chart .

:dataPoint6 a :dataPoint ;
    :xValue "Pick up of raw material from manufacturers" ;
    :yValue "0.08" ;
    :belongsTo :Chart .

:dataPoint7 a :dataPoint ;
    :xValue "Prevention in workplace" ;
    :yValue "0.05" ;
    :belongsTo :Chart .

:dataPoint8 a :dataPoint ;
    :xValue "Request to lower prices" ;
    :yValue "0.04" ;
    :belongsTo :Chart .

:dataPoint9 a :dataPoint ;
    :xValue "Protesting among the employees" ;
    :yValue "0.01" ;
    :belongsTo :Chart .

:dataPoint10 a :dataPoint ;
    :xValue "Higher demand" ;
    :yValue "0.01" ;
    :belongsTo :Chart .
