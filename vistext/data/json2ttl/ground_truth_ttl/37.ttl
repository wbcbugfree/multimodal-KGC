@prefix : <http://example.org/> .

:Chart a :LineChart ;
    :title "Real value of U.S. fossil fuel imports from 1960 to 2011 (in billion U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Real value in billion U.S. dollars" .

:dataPoint1 a :dataPoint ;
    :xValue "Dec 31, 1959" ;
    :yValue "8.91" ;
    :belongsTo :Chart .

