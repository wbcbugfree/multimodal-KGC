@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Most common types of dietary changes or restrictions in Poland in 2019" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Share of respondents" .

:YAxis a :Axis ;
    :title "Response" .

:dataPoint1 a :dataPoint ;
    :xValue "0.19" ;
    :yValue "Low-carb diet" ;
    :belongsTo :Chart .

:dataPoint2 a :dataPoint ;
    :xValue "0.14" ;
    :yValue "Low-calorie diet" ;
    :belongsTo :Chart .

:dataPoint3 a :dataPoint ;
    :xValue "0.1" ;
    :yValue "Increasing intake of fruit and vegetables" ;
    :belongsTo :Chart .

:dataPoint4 a :dataPoint ;
    :xValue "0.09" ;
    :yValue "Eating meals regularly" ;
    :belongsTo :Chart .

:dataPoint5 a :dataPoint ;
    :xValue "0.07" ;
    :yValue "Limiting fat intake" ;
    :belongsTo :Chart .

:dataPoint6 a :dataPoint ;
    :xValue "0.07" ;
    :yValue "Consuming herbs, herbal teas" ;
    :belongsTo :Chart .

:dataPoint7 a :dataPoint ;
    :xValue "0.06" ;
    :yValue "Limiting meat intake" ;
    :belongsTo :Chart .

:dataPoint8 a :dataPoint ;
    :xValue "0.06" ;
    :yValue "Limiting intake of bread, potatoes, flour products" ;
    :belongsTo :Chart .

:dataPoint9 a :dataPoint ;
    :xValue "0.05" ;
    :yValue "Well-balanced diet, planned by dietician" ;
    :belongsTo :Chart .

:dataPoint10 a :dataPoint ;
    :xValue "0.05" ;
    :yValue "High-protein diet" ;
    :belongsTo :Chart .

:dataPoint11 a :dataPoint ;
    :xValue "0.05" ;
    :yValue "Easily digestable diet" ;
    :belongsTo :Chart .

:dataPoint12 a :dataPoint ;
    :xValue "0.04" ;
    :yValue "Gluten-free diet" ;
    :belongsTo :Chart .

:dataPoint13 a :dataPoint ;
    :xValue "0.03" ;
    :yValue "Particular way of preparing food" ;
    :belongsTo :Chart .

:dataPoint14 a :dataPoint ;
    :xValue "0.03" ;
    :yValue "Generally healthier eating" ;
    :belongsTo :Chart .

:dataPoint15 a :dataPoint ;
    :xValue "0.03" ;
    :yValue "Consuming supplements, microelements" ;
    :belongsTo :Chart .

:dataPoint16 a :dataPoint ;
    :xValue "0.02" ;
    :yValue "Limiting milk intake" ;
    :belongsTo :Chart .
