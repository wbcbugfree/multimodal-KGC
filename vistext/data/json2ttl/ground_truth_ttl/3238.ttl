@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Most common types of dietary changes or restrictions in Poland in 2019" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Share of respondents" .

:YAxis a :Axis ;
    :title "Response" .

:DataPoint1 a :DataPoint ;
    :xValue "0.19" ;
    :yValue "Low-carb diet" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "0.14" ;
    :yValue "Low-calorie diet" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "0.1" ;
    :yValue "Increasing intake of fruit and vegetables" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "0.09" ;
    :yValue "Eating meals regularly" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "0.07" ;
    :yValue "Limiting fat intake" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "0.07" ;
    :yValue "Consuming herbs, herbal teas" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "0.06" ;
    :yValue "Limiting meat intake" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "0.06" ;
    :yValue "Limiting intake of bread, potatoes, flour products" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "0.05" ;
    :yValue "Well-balanced diet, planned by dietician" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "0.05" ;
    :yValue "High-protein diet" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "0.05" ;
    :yValue "Easily digestable diet" ;
    :belongsTo :Chart .

:DataPoint12 a :DataPoint ;
    :xValue "0.04" ;
    :yValue "Gluten-free diet" ;
    :belongsTo :Chart .

:DataPoint13 a :DataPoint ;
    :xValue "0.03" ;
    :yValue "Particular way of preparing food" ;
    :belongsTo :Chart .

:DataPoint14 a :DataPoint ;
    :xValue "0.03" ;
    :yValue "Generally healthier eating" ;
    :belongsTo :Chart .

:DataPoint15 a :DataPoint ;
    :xValue "0.03" ;
    :yValue "Consuming supplements, microelements" ;
    :belongsTo :Chart .

:DataPoint16 a :DataPoint ;
    :xValue "0.02" ;
    :yValue "Limiting milk intake" ;
    :belongsTo :Chart .
