@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Total spending of Barack Obama and Mitt Romney in the 2012 elections as of October 2012 , by major category (in million U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "spending major category" .

:YAxis a :Axis ;
    :title "Obama" .

:dataPoint1 a :dataPoint ;
    :xValue "Advertising" ;
    :yValue "457.6" ;
    :belongsTo :Chart .

:dataPoint2 a :dataPoint ;
    :xValue "Mail" ;
    :yValue "85.5" ;
    :belongsTo :Chart .

:dataPoint3 a :dataPoint ;
    :xValue "Payroll" ;
    :yValue "95.1" ;
    :belongsTo :Chart .

:dataPoint4 a :dataPoint ;
    :xValue "Fundraising" ;
    :yValue "81.8" ;
    :belongsTo :Chart .

:dataPoint5 a :dataPoint ;
    :xValue "Administration" ;
    :yValue "45.8" ;
    :belongsTo :Chart .

:dataPoint6 a :dataPoint ;
    :xValue "Travel" ;
    :yValue "24.1" ;
    :belongsTo :Chart .

:dataPoint7 a :dataPoint ;
    :xValue "Polling" ;
    :yValue "27.8" ;
    :belongsTo :Chart .

:dataPoint8 a :dataPoint ;
    :xValue "Consult." ;
    :yValue "12" ;
    :belongsTo :Chart .

:dataPoint9 a :dataPoint ;
    :xValue "Lists" ;
    :yValue "16.3" ;
    :belongsTo :Chart .

:dataPoint10 a :dataPoint ;
    :xValue "Events" ;
    :yValue "13.9" ;
    :belongsTo :Chart .
