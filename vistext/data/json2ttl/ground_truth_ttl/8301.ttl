@prefix : <http://example.org/> .

:Chart a :AreaChart ;
    :title "Average age at widow (er) hood in the Netherlands from 2008 to 2018 , by gender (in years)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Men" .

:dataPoint1 a :dataPoint ;
    :xValue "Dec 31, 2007" ;
    :yValue "72.3" ;
    :belongsTo :Chart .

