@prefix : <http://example.org/> .

:Chart a :LineChart ;
    :title "Global box office revenue from 2004 to 2019 , by region (in billion U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Asia Pacific" .

:dataPoint1 a :dataPoint ;
    :xValue "Dec 31, 2003" ;
    :yValue "8.5" ;
    :belongsTo :Chart .

