@prefix : <http://example.org/> .

:Chart a :LineChart ;
    :title "Number of new cases of HIV diagnosed in Greece from 2006 to 2019" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Number of new cases diagnosed" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2005" ;
    :yValue "505" ;
    :belongsTo :Chart .

