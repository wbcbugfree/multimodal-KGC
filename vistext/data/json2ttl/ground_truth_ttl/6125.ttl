@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Average (mean) private weekly rent in England from 2008/2009 to 2018/2019 (in GBP)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Excluding London" .

:YAxis a :Axis ;
    :title "Year" .

:dataPoint1 a :dataPoint ;
    :xValue "162" ;
    :yValue "2018/19" ;
    :belongsTo :Chart .

:dataPoint2 a :dataPoint ;
    :xValue "158" ;
    :yValue "2017/18" ;
    :belongsTo :Chart .

:dataPoint3 a :dataPoint ;
    :xValue "158" ;
    :yValue "2016/17" ;
    :belongsTo :Chart .

:dataPoint4 a :dataPoint ;
    :xValue "153" ;
    :yValue "2015/16" ;
    :belongsTo :Chart .

:dataPoint5 a :dataPoint ;
    :xValue "147" ;
    :yValue "2014/15" ;
    :belongsTo :Chart .

:dataPoint6 a :dataPoint ;
    :xValue "145" ;
    :yValue "2013/14" ;
    :belongsTo :Chart .

:dataPoint7 a :dataPoint ;
    :xValue "140" ;
    :yValue "2012/13" ;
    :belongsTo :Chart .

:dataPoint8 a :dataPoint ;
    :xValue "139" ;
