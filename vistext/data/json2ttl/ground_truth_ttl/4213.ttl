@prefix : <http://example.org/> .

:Chart a :LineChart ;
    :title "Namco Bandai 's net income worldwide from FY2006 to FY2019 (in million U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Net income in million U.S. dollars" .

:dataPoint1 a :dataPoint ;
    :xValue "Dec 31, 2005" ;
    :yValue "120.34" ;
    :belongsTo :Chart .

