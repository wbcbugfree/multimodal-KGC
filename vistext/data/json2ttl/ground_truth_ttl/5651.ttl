@prefix : <http://example.org/> .

:Chart a :AreaChart ;
    :title "American Customer Satisfaction Index scores for full-service restaurants in the United States from 2007 to 2020" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "ACSI score" .

:dataPoint1 a :dataPoint ;
    :xValue "Dec 31, 2006" ;
    :yValue "81" ;
    :belongsTo :Chart .

