@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Monthly youth (16 - 24) unemployment rate in the United States from November 2019 to November 2020 (seasonally adjusted)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Unemployment rate" .

:YAxis a :Axis ;
    :title "Month" .

:dataPoint1 a :dataPoint ;
    :xValue "0.115" ;
    :yValue "Nov '20" ;
    :belongsTo :Chart .

:dataPoint2 a :dataPoint ;
    :xValue "0.117" ;
    :yValue "Oct '20" ;
    :belongsTo :Chart .

