@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Leading value retail centres in the United Kingdom (UK) in 2013 , ranked by number of stores" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Leading value retail centres" .

:YAxis a :Axis ;
    :title "Number of stores" .

:dataPoint1 a :dataPoint ;
    :xValue "Blackpool" ;
    :yValue "314" ;
    :belongsTo :Chart .

