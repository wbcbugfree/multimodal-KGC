@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Number of domestic trophies won by Cristiano Ronaldo as of 2020 , by competition" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Competition" .

:YAxis a :Axis ;
    :title "Number of titles" .

:dataPoint1 a :dataPoint ;
    :xValue "Champions League" ;
    :yValue "5" ;
    :belongsTo :Chart .

