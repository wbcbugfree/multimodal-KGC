@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Share of online users in the United States who use selected social media platforms as of 3rd quarter 2020" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Q4 2018" .

:YAxis a :Axis ;
    :title "Platform" .

:dataPoint1 a :dataPoint ;
    :xValue "0.67" ;
    :yValue "YouTube" ;
    :belongsTo :Chart .

:dataPoint2 a :dataPoint ;
    :xValue "0.77" ;
    :yValue "Facebook" ;
    :belongsTo :Chart .

:dataPoint3 a :dataPoint ;
    :xValue "0.46" ;
    :yValue "Instagram" ;
    :belongsTo :Chart .

:dataPoint4 a :dataPoint ;
    :xValue "0.37" ;
    :yValue "Twitter" ;
    :belongsTo :Chart .

:dataPoint5 a :dataPoint ;
    :xValue "0.34" ;
    :yValue "Pinterest" ;
    :belongsTo :Chart .

:dataPoint6 a :dataPoint ;
    :xValue "0.29" ;
    :yValue "LinkedIn" ;
    :belongsTo :Chart .

:dataPoint7 a :dataPoint ;
    :xValue "0.13" ;
    :yValue "Reddit" ;
    :belongsTo :Chart .

:dataPoint8 a :dataPoint ;
    :xValue "0.25" ;
    :yValue "Snapchat" ;
    :belongsTo :Chart .

:dataPoint9 a :dataPoint ;
    :xValue "0.16" ;
    :yValue "WhatsApp" ;
    :belongsTo :Chart .

:dataPoint10 a :dataPoint ;
    :xValue "0.1" ;
    :yValue "Tumblr" ;
    :belongsTo :Chart .

:dataPoint11 a :dataPoint ;
    :xValue "0.02" ;
    :yValue "Periscope" ;
    :belongsTo :Chart .
