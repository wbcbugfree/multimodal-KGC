@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Pandora 's net income / loss in the fiscal years 2007 to 2017 (in million U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Net income / loss in million U.S. dollars" .

:YAxis a :Axis ;
    :title "Month" .

:DataPoint1 a :DataPoint ;
    :xValue "-518.4" ;
    :yValue "Jan to Dec 2017" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "-342.98" ;
    :yValue "Jan to Dec 2016" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "-169.66" ;
    :yValue "Jan to Dec 2015" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "-30.41" ;
    :yValue "Jan to Dec 2014" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "-27.02" ;
    :yValue "Feb to Dec 2013*" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "-38.15" ;
    :yValue "Feb 2012 to Jan 2013" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "-16.11" ;
    :yValue "Feb 2011 to Jan 2012" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "-1.76" ;
    :yValue "Feb 2010 to Jan 2011" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "-16.75" ;
    :yValue "Feb 2009 to Jan 2010" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "-28.23" ;
    :yValue "Feb 2008 to Jan 2009" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "-13.99" ;
    :yValue "Feb 2007 to Jan 2008" ;
    :belongsTo :Chart .

:DataPoint12 a :DataPoint ;
    :xValue "-11.82" ;
    :yValue "Feb 2006 to Jan 2007" ;
    :belongsTo :Chart .
