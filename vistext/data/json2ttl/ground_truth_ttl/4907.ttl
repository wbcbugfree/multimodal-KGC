@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Pandora 's net income / loss in the fiscal years 2007 to 2017 (in million U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Net income / loss in million U.S. dollars" .

:YAxis a :Axis ;
    :title "Month" .

:dataPoint1 a :dataPoint ;
    :xValue "-518.4" ;
    :yValue "Jan to Dec 2017" ;
    :belongsTo :Chart .

:dataPoint2 a :dataPoint ;
    :xValue "-342.98" ;
    :yValue "Jan to Dec 2016" ;
    :belongsTo :Chart .

:dataPoint3 a :dataPoint ;
    :xValue "-169.66" ;
    :yValue "Jan to Dec 2015" ;
    :belongsTo :Chart .

:dataPoint4 a :dataPoint ;
    :xValue "-30.41" ;
    :yValue "Jan to Dec 2014" ;
    :belongsTo :Chart .

:dataPoint5 a :dataPoint ;
    :xValue "-27.02" ;
    :yValue "Feb to Dec 2013*" ;
    :belongsTo :Chart .

:dataPoint6 a :dataPoint ;
    :xValue "-38.15" ;
    :yValue "Feb 2012 to Jan 2013" ;
    :belongsTo :Chart .

:dataPoint7 a :dataPoint ;
    :xValue "-16.11" ;
    :yValue "Feb 2011 to Jan 2012" ;
    :belongsTo :Chart .

:dataPoint8 a :dataPoint ;
    :xValue "-1.76" ;
    :yValue "Feb 2010 to Jan 2011" ;
    :belongsTo :Chart .

:dataPoint9 a :dataPoint ;
    :xValue "-16.75" ;
    :yValue "Feb 2009 to Jan 2010" ;
    :belongsTo :Chart .

:dataPoint10 a :dataPoint ;
    :xValue "-28.23" ;
    :yValue "Feb 2008 to Jan 2009" ;
    :belongsTo :Chart .

:dataPoint11 a :dataPoint ;
    :xValue "-13.99" ;
    :yValue "Feb 2007 to Jan 2008" ;
    :belongsTo :Chart .

:dataPoint12 a :dataPoint ;
    :xValue "-11.82" ;
    :yValue "Feb 2006 to Jan 2007" ;
    :belongsTo :Chart .
