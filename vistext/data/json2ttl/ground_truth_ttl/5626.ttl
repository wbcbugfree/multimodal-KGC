@prefix : <http://example.org/> .

:Chart a :LineChart ;
    :title "Kia 's vehicle sales from FY 2009 to FY 2019 (in 1,000 units)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Sales in thousand units" .

:dataPoint1 a :dataPoint ;
    :xValue "Dec 31, 2008" ;
    :yValue "1651" ;
    :belongsTo :Chart .

:dataPoint2 a :dataPoint ;
    :xValue "Dec 31, 2009" ;
    :yValue "2088" ;
    :belongsTo :Chart .

:dataPoint3 a :dataPoint ;
    :xValue "Dec 31, 2010" ;
    :yValue "2478" ;
    :belongsTo :Chart .

:dataPoint4 a :dataPoint ;
    :xValue "Dec 31, 2011" ;
    :yValue "2709" ;
    :belongsTo :Chart .

:dataPoint5 a :dataPoint ;
    :xValue "Dec 31, 2012" ;
    :yValue "2746" ;
    :belongsTo :Chart .

:dataPoint6 a :dataPoint ;
    :xValue "Dec 31, 2013" ;
    :yValue "2907" ;
    :belongsTo :Chart .

:dataPoint7 a :dataPoint ;
    :xValue "Dec 31, 2014" ;
    :yValue "2915" ;
    :belongsTo :Chart .

:dataPoint8 a :dataPoint ;
    :xValue "Dec 31, 2015" ;
    :yValue "3018" ;
    :belongsTo :Chart .

:dataPoint9 a :dataPoint ;
    :xValue "Dec 31, 2016" ;
    :yValue "2743" ;
    :belongsTo :Chart .

:dataPoint10 a :dataPoint ;
    :xValue "Dec 31, 2017" ;
    :yValue "2815" ;
    :belongsTo :Chart .

:dataPoint11 a :dataPoint ;
    :xValue "Dec 31, 2018" ;
    :yValue "2816" ;
    :belongsTo :Chart .
