    :xValue "DogVacay*" ;
    :yValue "42" ;
    :belongsTo :Chart .

:dataPoint5 a :dataPoint ;
    :xValue "Turo*" ;
    :yValue "39" ;
    :belongsTo :Chart .

:dataPoint6 a :dataPoint ;
    :xValue "Etsy" ;
    :yValue "37" ;
    :belongsTo :Chart .

:dataPoint7 a :dataPoint ;
    :xValue "Post Mates*" ;
    :yValue "34" ;
    :belongsTo :Chart .

:dataPoint8 a :dataPoint ;
    :xValue "Uber" ;
    :yValue "32" ;
    :belongsTo :Chart .

:dataPoint9 a :dataPoint ;
