@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Average spending of adults in the United States on selected sharing companies or services as of January 2016 (in U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "company or service" .

:YAxis a :Axis ;
    :title "Average amunt spent in U.S. dollars" .

:dataPoint1 a :dataPoint ;
    :xValue "AirBnB" ;
    :yValue "114" ;
    :belongsTo :Chart .

:dataPoint2 a :dataPoint ;
    :xValue "Task Rabbit*" ;
    :yValue "83" ;
    :belongsTo :Chart .

