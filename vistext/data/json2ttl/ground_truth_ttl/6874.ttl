@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Breakdown of U.S. online advertising revenue from 2010 to 2016 , by industry" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "2015" .

:YAxis a :Axis ;
    :title "industry" .

:dataPoint1 a :dataPoint ;
    :xValue "0.21" ;
    :yValue "Retail" ;
    :belongsTo :Chart .

:dataPoint2 a :dataPoint ;
    :xValue "0.13" ;
    :yValue "Financial services" ;
    :belongsTo :Chart .

:dataPoint3 a :dataPoint ;
    :xValue "0.12" ;
    :yValue "Auto" ;
    :belongsTo :Chart .

:dataPoint4 a :dataPoint ;
    :xValue "0.09" ;
    :yValue "Telecom" ;
    :belongsTo :Chart .

:dataPoint5 a :dataPoint ;
    :xValue "0.09" ;
    :yValue "Leisure travel" ;
    :belongsTo :Chart .

:dataPoint6 a :dataPoint ;
    :xValue "0.08" ;
    :yValue "Consumer Electronics & Computers" ;
    :belongsTo :Chart .

:dataPoint7 a :dataPoint ;
    :xValue "0.06" ;
    :yValue "Consumer packaged goods" ;
    :belongsTo :Chart .

:dataPoint8 a :dataPoint ;
    :xValue "0.05" ;
    :yValue "Pharma & healthcare" ;
    :belongsTo :Chart .

:dataPoint9 a :dataPoint ;
    :xValue "0.05" ;
    :yValue "Media" ;
    :belongsTo :Chart .

:dataPoint10 a :dataPoint ;
    :xValue "0.04" ;
    :yValue "Entertainment" ;
    :belongsTo :Chart .
