@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Average retail price for bananas in Canada from January 2015 to June 2020 (in Canadian dollars per kilogram)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "2020" .

:YAxis a :Axis ;
    :title "Month" .

:DataPoint1 a :DataPoint ;
    :xValue "1.57" ;
    :yValue "Jun 1.57 May 1.55 Apr 1.55 Mar 1.56 Feb 1.55 Jan" ;
    :belongsTo :Chart .
