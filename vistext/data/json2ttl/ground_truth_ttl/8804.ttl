@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Average retail price for bananas in Canada from January 2015 to June 2020 (in Canadian dollars per kilogram)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "2020" .

:YAxis a :Axis ;
    :title "Month" .

:dataPoint1 a :dataPoint ;
    :xValue "1.57" ;
    :yValue "Jun" ;
    :belongsTo :Chart .

:dataPoint2 a :dataPoint ;
    :xValue "1.57" ;
    :yValue "May" ;
    :belongsTo :Chart .

:dataPoint3 a :dataPoint ;
    :xValue "1.55" ;
    :yValue "Apr" ;
    :belongsTo :Chart .

:dataPoint4 a :dataPoint ;
    :xValue "1.55" ;
    :yValue "Mar" ;
    :belongsTo :Chart .

:dataPoint5 a :dataPoint ;
    :xValue "1.56" ;
    :yValue "Feb" ;
    :belongsTo :Chart .

:dataPoint6 a :dataPoint ;
    :xValue "1.55" ;
    :yValue "Jan" ;
    :belongsTo :Chart .
