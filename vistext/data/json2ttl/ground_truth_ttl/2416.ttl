@prefix : <http://example.org/> .

:Chart a :LineChart ;
    :title "Average price for a basic pedicure in nail salons in the United States from 2008 to 2019 (in U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Average price in U.S. dollars" .

:dataPoint1 a :dataPoint ;
    :xValue "Dec 31, 2007" ;
    :yValue "31.88" ;
    :belongsTo :Chart .

