    :xValue "Dec 31, 2012" ;
    :yValue "1.88" ;
    :belongsTo :Chart .

:dataPoint6 a :dataPoint ;
    :xValue "Dec 31, 2013" ;
    :yValue "1.98" ;
    :belongsTo :Chart .

:dataPoint7 a :dataPoint ;
    :xValue "Dec 31, 2014" ;
    :yValue "2.1" ;
    :belongsTo :Chart .

:dataPoint8 a :dataPoint ;
