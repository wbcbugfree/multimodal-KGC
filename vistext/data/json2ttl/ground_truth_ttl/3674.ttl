@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "The Bahamas : Total population from 2015 to 2025 (in million inhabitants)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Inhabitants in millions" .

:dataPoint1 a :dataPoint ;
    :xValue "2025*" ;
    :yValue "0.41" ;
    :belongsTo :Chart .

:dataPoint2 a :dataPoint ;
    :xValue "2024*" ;
    :yValue "0.4" ;
    :belongsTo :Chart .

:dataPoint3 a :dataPoint ;
    :xValue "2023*" ;
    :yValue "0.4" ;
    :belongsTo :Chart .

:dataPoint4 a :dataPoint ;
    :xValue "2022*" ;
    :yValue "0.39" ;
    :belongsTo :Chart .

:dataPoint5 a :dataPoint ;
    :xValue "2021*" ;
    :yValue "0.39" ;
    :belongsTo :Chart .

:dataPoint6 a :dataPoint ;
    :xValue "2020*" ;
    :yValue "0.39" ;
    :belongsTo :Chart .

:dataPoint7 a :dataPoint ;
    :xValue "2019*" ;
    :yValue "0.38" ;
    :belongsTo :Chart .

:dataPoint8 a :dataPoint ;
    :xValue "2018" ;
    :yValue "0.38" ;
    :belongsTo :Chart .

:dataPoint9 a :dataPoint ;
    :xValue "2017" ;
    :yValue "0.37" ;
    :belongsTo :Chart .

:dataPoint10 a :dataPoint ;
    :xValue "2016" ;
    :yValue "0.37" ;
    :belongsTo :Chart .

:dataPoint11 a :dataPoint ;
    :xValue "2015" ;
    :yValue "0.36" ;
    :belongsTo :Chart .
