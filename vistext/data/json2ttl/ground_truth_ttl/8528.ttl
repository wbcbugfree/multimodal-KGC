@prefix : <http://example.org/> .

:Chart a :LineChart ;
    :title "Annual Flemish education budget in Belgium from 2010 to 2019 , by educational level (in thousand euros)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Part-time arts education" .

:dataPoint1 a :dataPoint ;
    :xValue "Dec 31, 2009" ;
    :yValue "204754" ;
    :belongsTo :Chart .

