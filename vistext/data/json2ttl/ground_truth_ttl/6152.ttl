@prefix : <http://example.org/> .

:Chart a :AreaChart ;
    :title "U.S. electricity production costs from 2000 to 2014 , by source (in cents per kilowatt hour)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Petroleum" .

