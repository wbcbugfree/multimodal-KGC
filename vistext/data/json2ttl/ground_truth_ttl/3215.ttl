@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Leading digital media agencies in the United Kingdom (UK) ranked by income in 2014 (in million GBP)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Agency (parent)" .

:YAxis a :Axis ;
    :title "Income in million GBP" .

