@prefix : <http://example.org/> .

:Chart a :AreaChart ;
    :title "Revenue of International Workplace Group (IWG) worldwide from 2010 to 2019 (in million GBP)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Revenue in million British pounds" .

:dataPoint1 a :dataPoint ;
    :xValue "Dec 31, 2009" ;
    :yValue "1040.4" ;
    :belongsTo :Chart .

