@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Share of households with broadband internet access in Romania from 2006 to 2018" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Share of households" .

:YAxis a :Axis ;
    :title "Response" .

:dataPoint1 a :dataPoint ;
    :xValue "0.79" ;
    :yValue "2018" ;
    :belongsTo :Chart .

:dataPoint2 a :dataPoint ;
    :xValue "0.74" ;
    :yValue "2017" ;
    :belongsTo :Chart .

:dataPoint3 a :dataPoint ;
    :xValue "0.7" ;
    :yValue "2016" ;
    :belongsTo :Chart .

:dataPoint4 a :dataPoint ;
    :xValue "0.65" ;
    :yValue "2015" ;
    :belongsTo :Chart .

:dataPoint5 a :dataPoint ;
    :xValue "0.58" ;
    :yValue "2014*" ;
    :belongsTo :Chart .

