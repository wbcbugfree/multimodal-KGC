@prefix : <http://example.org/> .

:Chart a :AreaChart ;
    :title "Comparable sales growth of Sam 's Club in the United States from fiscal year 2006 to 2020" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Comparable sales growth" .

:dataPoint1 a :dataPoint ;
    :xValue "Dec 31, 2005" ;
    :yValue "0.05" ;
    :belongsTo :Chart .

