@prefix : <http://example.org/> .

:Chart a :AreaChart ;
    :title "Comparable sales growth of Sam 's Club in the United States from fiscal year 2006 to 2020" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Comparable sales growth" .

:DataPoint1 a :DataPoint ;
    :xValue "0.05" ;
    :yValue "Dec 31, 2006" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "0.025" ;
    :yValue "Dec 31, 2007" ;
    :belongsTo :Chart .

