@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Why did you leave / quit your former health club ?" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "Percentage of respondents" .

:dataPoint1 a :dataPoint ;
    :xValue "It was too expensive / I could not afford it" ;
    :yValue "0.4" ;
    :belongsTo :Chart .

:dataPoint2 a :dataPoint ;
    :xValue "I wasn't using my membership / wasn't going" ;
    :yValue "0.3" ;
    :belongsTo :Chart .

:dataPoint3 a :dataPoint ;
    :xValue "I moved / the location was no longer convenient" ;
    :yValue "0.2" ;
    :belongsTo :Chart .

:dataPoint4 a :dataPoint ;
    :xValue "I could exercise somewhere else for free" ;
    :yValue "0.19" ;
    :belongsTo :Chart .

:dataPoint5 a :dataPoint ;
    :xValue "It was too crowded" ;
    :yValue "0.17" ;
    :belongsTo :Chart .

:dataPoint6 a :dataPoint ;
    :xValue "I developed an injury / surgery / other condition" ;
    :yValue "0.11" ;
    :belongsTo :Chart .

:dataPoint7 a :dataPoint ;
    :xValue "I felt out of place" ;
    :yValue "0.09" ;
    :belongsTo :Chart .

:dataPoint8 a :dataPoint ;
    :xValue "I lost my job" ;
    :yValue "0.08" ;
    :belongsTo :Chart .

:dataPoint9 a :dataPoint ;
    :xValue "I did not like to exercise" ;
    :yValue "0.07" ;
    :belongsTo :Chart .

:dataPoint10 a :dataPoint ;
    :xValue "I didn't reach my fitness goals" ;
    :yValue "0.05" ;
    :belongsTo :Chart .

:dataPoint11 a :dataPoint ;
    :xValue "It was too intimidating" ;
    :yValue "0.04" ;
    :belongsTo :Chart .

:dataPoint12 a :dataPoint ;
    :xValue "There was no one there to guide me" ;
    :yValue "0.04" ;
    :belongsTo :Chart .

:dataPoint13 a :dataPoint ;
    :xValue "I didn't know what to do there" ;
    :yValue "0.04" ;
    :belongsTo :Chart .

:dataPoint14 a :dataPoint ;
    :xValue "I wanted to participate in another type of exercise" ;
    :yValue "0.03" ;
    :belongsTo :Chart .

:dataPoint15 a :dataPoint ;
    :xValue "I met my fitness goals" ;
    :yValue "0.02" ;
    :belongsTo :Chart .

:dataPoint16 a :dataPoint ;
    :xValue "Nobody I knew went to my former health club" ;
    :yValue "0.02" ;
    :belongsTo :Chart .

:dataPoint17 a :dataPoint ;
    :xValue "Other" ;
    :yValue "0.01" ;
    :belongsTo :Chart .
