@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Why did you leave / quit your former health club ?" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "Percentage of respondents" .

:DataPoint1 a :DataPoint ;
    :xValue "It was too expensive / I could not afford it" ;
    :yValue "0.4" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "I wasn't using my membership / wasn't going" ;
    :yValue "0.3" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "I moved / the location was no longer convenient" ;
    :yValue "0.2" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "I could exercise somewhere else for free" ;
    :yValue "0.19" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "It was too crowded" ;
    :yValue "0.17" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "I developed an injury / surgery / other condition" ;
    :yValue "0.11" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "I felt out of place" ;
    :yValue "0.09" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "I lost my job" ;
    :yValue "0.08" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "I did not like to exercise" ;
    :yValue "0.07" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "I didn't reach my fitness goals" ;
    :yValue "0.05" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "It was too intimidating" ;
    :yValue "0.04" ;
    :belongsTo :Chart .

:DataPoint12 a :DataPoint ;
    :xValue "There was no one there to guide me" ;
    :yValue "0.04" ;
    :belongsTo :Chart .

:DataPoint13 a :DataPoint ;
    :xValue "I didn't know what to do there" ;
    :yValue "0.04" ;
    :belongsTo :Chart .

:DataPoint14 a :DataPoint ;
    :xValue "I wanted to participate in another type of exercise" ;
    :yValue "0.03" ;
    :belongsTo :Chart .

:DataPoint15 a :DataPoint ;
    :xValue "I met my fitness goals" ;
    :yValue "0.02" ;
    :belongsTo :Chart .

:DataPoint16 a :DataPoint ;
    :xValue "Nobody I knew went to my former health club" ;
    :yValue "0.02" ;
    :belongsTo :Chart .

:DataPoint17 a :DataPoint ;
    :xValue "Other" ;
    :yValue "0.01" ;
    :belongsTo :Chart .
