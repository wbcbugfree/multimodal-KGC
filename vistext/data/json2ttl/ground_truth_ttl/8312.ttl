@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "What activities have you done while boating ?" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Boating activity" .

:YAxis a :Axis ;
    :title "Male" .

:dataPoint1 a :dataPoint ;
    :xValue "Fishing from a boat" ;
    :yValue "0.661" ;
    :belongsTo :Chart .

:dataPoint2 a :dataPoint ;
    :xValue "Cruising" ;
    :yValue "0.573" ;
    :belongsTo :Chart .

:dataPoint3 a :dataPoint ;
    :xValue "Swimming" ;
    :yValue "0.449" ;
    :belongsTo :Chart .

:dataPoint4 a :dataPoint ;
    :xValue "Entertaining" ;
    :yValue "0.398" ;
    :belongsTo :Chart .

:dataPoint5 a :dataPoint ;
    :xValue "Sightseeing" ;
    :yValue "0.325" ;
    :belongsTo :Chart .

:dataPoint6 a :dataPoint ;
    :xValue "Sunbathing" ;
    :yValue "0.31" ;
    :belongsTo :Chart .

:dataPoint7 a :dataPoint ;
    :xValue "Nature observation" ;
    :yValue "0.307" ;
    :belongsTo :Chart .

:dataPoint8 a :dataPoint ;
    :xValue "Quiet water paddling" ;
