    :belongsTo :Chart .

:dataPoint12 a :dataPoint ;
    :xValue "Wakeboarding" ;
    :yValue "0.139" ;
    :belongsTo :Chart .

:dataPoint13 a :dataPoint ;
    :xValue "Kneeboarding" ;
    :yValue "0.088" ;
    :belongsTo :Chart .

:dataPoint14 a :dataPoint ;
    :xValue "Whitewater paddling" ;
    :yValue "0.08" ;
    :belongsTo :Chart .

:dataPoint15 a :dataPoint ;
    :xValue "Racing" ;
    :yValue "0.058" ;
    :belongsTo :Chart .

