@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "What activities have you done while boating ?" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Boating activity" .

:YAxis a :Axis ;
    :title "Male" .

:DataPoint1 a :DataPoint ;
    :xValue "Fishing from a boat" ;
    :yValue "0.661" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Cruising" ;
    :yValue "0.573" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "Swimming" ;
    :yValue "0.449" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "Entertaining" ;
    :yValue "0.398" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "Sightseeing" ;
    :yValue "0.325" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Sunbathing" ;
    :yValue "0.31" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Nature observation" ;
    :yValue "0.307" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Quiet water paddling" ;
    :yValue "0.241" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "Tubing" ;
    :yValue "0.23" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "Water Skiing" ;
    :yValue "0.197" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "Scuba Diving/Snorkeling" ;
    :yValue "0.142" ;
    :belongsTo :Chart .

:DataPoint12 a :DataPoint ;
    :xValue "Wakeboarding" ;
    :yValue "0.139" ;
    :belongsTo :Chart .

:DataPoint13 a :DataPoint ;
    :xValue "Kneeboarding" ;
    :yValue "0.088" ;
    :belongsTo :Chart .

:DataPoint14 a :DataPoint ;
    :xValue "Whitewater paddling" ;
    :yValue "0.08" ;
    :belongsTo :Chart .

:DataPoint15 a :DataPoint ;
    :xValue "Racing" ;
    :yValue "0.058" ;
    :belongsTo :Chart .

:DataPoint16 a :DataPoint ;
    :xValue "Hunting from a boat" ;
    :yValue "0.051" ;
    :belongsTo :Chart .

:DataPoint17 a :DataPoint ;
    :xValue "Other" ;
    :yValue "0.044" ;
