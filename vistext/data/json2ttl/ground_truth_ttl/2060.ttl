@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Percentage of consumers who use a mobile device for product research while shopping in-store worldwide as of January 2019 , by country" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "Share of respondents" .

:dataPoint1 a :dataPoint ;
    :xValue "United Kingdom" ;
    :yValue "0.696" ;
    :belongsTo :Chart .

:dataPoint2 a :dataPoint ;
    :xValue "United States" ;
    :yValue "0.74" ;
    :belongsTo :Chart .

:dataPoint3 a :dataPoint ;
    :xValue "Australia" ;
    :yValue "0.788" ;
    :belongsTo :Chart .

:dataPoint4 a :dataPoint ;
    :xValue "Canada" ;
    :yValue "0.792" ;
    :belongsTo :Chart .

:dataPoint5 a :dataPoint ;
    :xValue "Indonesia" ;
    :yValue "0.888" ;
    :belongsTo :Chart .

:dataPoint6 a :dataPoint ;
    :xValue "Russia" ;
    :yValue "0.892" ;
    :belongsTo :Chart .

:dataPoint7 a :dataPoint ;
    :xValue "Phillippines" ;
    :yValue "0.908" ;
    :belongsTo :Chart .

:dataPoint8 a :dataPoint ;
    :xValue "South Africa" ;
    :yValue "0.908" ;
    :belongsTo :Chart .

:dataPoint9 a :dataPoint ;
    :xValue "Mexico" ;
    :yValue "0.934" ;
    :belongsTo :Chart .

:dataPoint10 a :dataPoint ;
    :xValue "Colombia" ;
    :yValue "0.936" ;
    :belongsTo :Chart .

:dataPoint11 a :dataPoint ;
    :xValue "Turkey" ;
    :yValue "0.976" ;
    :belongsTo :Chart .
