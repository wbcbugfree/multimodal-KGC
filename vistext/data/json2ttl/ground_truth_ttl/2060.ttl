@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Percentage of consumers who use a mobile device for product research while shopping in-store worldwide as of January 2019 , by country" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "Share of respondents" .

:DataPoint1 a :DataPoint ;
    :xValue "United Kingdom" ;
    :yValue "0.696" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "United States" ;
    :yValue "0.74" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "Australia" ;
    :yValue "0.788" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "Canada" ;
    :yValue "0.792" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "Indonesia" ;
    :yValue "0.888" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Russia" ;
    :yValue "0.892" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Phillippines" ;
    :yValue "0.908" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "South Africa" ;
    :yValue "0.908" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "Mexico" ;
    :yValue "0.934" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "Colombia" ;
    :yValue "0.936" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "Turkey" ;
    :yValue "0.976" ;
    :belongsTo :Chart .
