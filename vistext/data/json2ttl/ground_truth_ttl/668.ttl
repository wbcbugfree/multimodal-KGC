@prefix : <http://example.org/> .

:Chart a :AreaChart ;
    :title "Share of children in total population in Indonesia from 2005 to 2019" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "Percentage of total population" .

:dataPoint1 a :dataPoint ;
    :xValue "Dec 31, 2004" ;
    :yValue "0.3" ;
    :belongsTo :Chart .

