@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Indoor exhibition venues worldwide by exhibition space in 2011 (in 1,000 square meters)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Indoor exhibition venues" .

:YAxis a :Axis ;
    :title "Net exhibition space in thousand square meters" .

