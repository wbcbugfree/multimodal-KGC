@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Leading 10 U.S. companies based on medical device revenue in 2019 (in billion U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Revenue in billion U.S. dollars" .

:YAxis a :Axis ;
    :title "companies based on medical device" .

:dataPoint1 a :dataPoint ;
    :xValue "30.55" ;
    :yValue "Medtronic Inc.*" ;
    :belongsTo :Chart .

:dataPoint2 a :dataPoint ;
    :xValue "25.96" ;
    :yValue "Johnson & Johnson Medical Devices & Diagnostics*" ;
    :belongsTo :Chart .

:dataPoint3 a :dataPoint ;
    :xValue "19.94" ;
    :yValue "General Electric Healthcare**" ;
    :belongsTo :Chart .

:dataPoint4 a :dataPoint ;
    :xValue "15.63" ;
    :yValue "Cardinal Health" ;
    :belongsTo :Chart .

:dataPoint5 a :dataPoint ;
    :xValue "14.88" ;
    :yValue "Stryker Corp." ;
    :belongsTo :Chart .

:dataPoint6 a :dataPoint ;
    :xValue "12.99" ;
    :yValue "Becton Dickinson & Co." ;
    :belongsTo :Chart .

:dataPoint7 a :dataPoint ;
    :xValue "12.23" ;
    :yValue "Abbott Laboratories" ;
    :belongsTo :Chart .

:dataPoint8 a :dataPoint ;
    :xValue "11.36" ;
    :yValue "Baxter International Inc." ;
    :belongsTo :Chart .

:dataPoint9 a :dataPoint ;
    :xValue "10.65" ;
    :yValue "Boston Scientific Corp." ;
    :belongsTo :Chart .

:dataPoint10 a :dataPoint ;
    :xValue "7.98" ;
    :yValue "Zimmer Biomet" ;
    :belongsTo :Chart .
