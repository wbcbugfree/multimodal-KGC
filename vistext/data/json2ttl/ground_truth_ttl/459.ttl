@prefix : <http://example.org/> .

:Chart a :AreaChart ;
    :title "Total regular season home attendance of the NFL Philadelphia Eagles franchise from 2006 to 2019" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Home attendance" .

