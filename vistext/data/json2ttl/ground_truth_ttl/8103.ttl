@prefix : <http://example.org/> .

:Chart a :LineChart ;
    :title "Percentage distribution of Hispanic household income in the United States from 2006 to 2018" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Annual household income in U\\.S\\. dollars" .

:YAxis a :Axis ;
    :title "35,000 to 49,999" .

:dataPoint1 a :dataPoint ;
    :xValue "Dec 31, 2005" ;
    :yValue "0.166" ;
    :belongsTo :Chart .

