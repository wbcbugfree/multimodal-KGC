@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Annual net revenue of Jumia Technologies AG from 2017 to 2019 , by segment (in million euros)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "2019" .

:YAxis a :Axis ;
    :title "Jumia Technologies AG marketplace segment" .

:dataPoint1 a :dataPoint ;
    :xValue "81.2" ;
    :yValue "1P sales of goods" ;
    :belongsTo :Chart .

:dataPoint2 a :dataPoint ;
    :xValue "25" ;
    :yValue "Commissions" ;
    :belongsTo :Chart .

:dataPoint3 a :dataPoint ;
    :xValue "26.9" ;
    :yValue "Fulfillment" ;
    :belongsTo :Chart .

:dataPoint4 a :dataPoint ;
    :xValue "6.1" ;
    :yValue "Marketing & Advertising" ;
    :belongsTo :Chart .

:dataPoint5 a :dataPoint ;
    :xValue "20.5" ;
    :yValue "Other services – value-added services" ;
    :belongsTo :Chart .

:dataPoint6 a :dataPoint ;
    :xValue "78.5" ;
    :yValue "Total revenue related to third-party sales" ;
    :belongsTo :Chart .

:dataPoint7 a :dataPoint ;
    :xValue "159.6" ;
    :yValue "Platform revenue (1P + 3P)" ;
    :belongsTo :Chart .

:dataPoint8 a :dataPoint ;
    :xValue "0.8" ;
    :yValue "Other services – non-platform revenue" ;
    :belongsTo :Chart .
