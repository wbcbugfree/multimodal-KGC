@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Turnover from retail sale of food , beverages and tobacco in specialized stores in Greece from 2008 to 2018 (in million euros)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Annual turnover in million euros" .

:dataPoint1 a :dataPoint ;
    :xValue "2018*" ;
    :yValue "2948" ;
    :belongsTo :Chart .

:dataPoint2 a :dataPoint ;
    :xValue "2017*" ;
    :yValue "3020.2" ;
    :belongsTo :Chart .

