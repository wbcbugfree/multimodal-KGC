@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Rate of unemployment in Canada in 2019 , by industry" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "industry" .

:YAxis a :Axis ;
    :title "Unemployment rate" .

:dataPoint1 a :dataPoint ;
    :xValue "Forestry, fishing, mining, quarrying, oil and gas" ;
    :yValue "0.073" ;
    :belongsTo :Chart .

:dataPoint2 a :dataPoint ;
    :xValue "Construction" ;
    :yValue "0.067" ;
    :belongsTo :Chart .

:dataPoint3 a :dataPoint ;
    :xValue "Business, building and other support services" ;
    :yValue "0.061" ;
    :belongsTo :Chart .

:dataPoint4 a :dataPoint ;
    :xValue "Accommodation and food services" ;
    :yValue "0.055" ;
    :belongsTo :Chart .

:dataPoint5 a :dataPoint ;
    :xValue "Information, culture and recreation" ;
    :yValue "0.054" ;
    :belongsTo :Chart .

:dataPoint6 a :dataPoint ;
    :xValue "Agriculture" ;
    :yValue "0.044" ;
    :belongsTo :Chart .

:dataPoint7 a :dataPoint ;
    :xValue "Wholesale and retail trade" ;
    :yValue "0.037" ;
    :belongsTo :Chart .

:dataPoint8 a :dataPoint ;
    :xValue "Educational services" ;
    :yValue "0.037" ;
    :belongsTo :Chart .

:dataPoint9 a :dataPoint ;
    :xValue "Manufacturing" ;
    :yValue "0.036" ;
    :belongsTo :Chart .

:dataPoint10 a :dataPoint ;
    :xValue "Transportation and warehousing" ;
    :yValue "0.032" ;
    :belongsTo :Chart .

:dataPoint11 a :dataPoint ;
    :xValue "Other services (except public administration)" ;
