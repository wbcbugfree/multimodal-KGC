    :belongsTo :Chart .

:dataPoint12 a :dataPoint ;
    :xValue "Professional, scientific and technical services" ;
    :yValue "0.027" ;
    :belongsTo :Chart .

:dataPoint13 a :dataPoint ;
    :xValue "Public administration" ;
    :yValue "0.02" ;
    :belongsTo :Chart .

:dataPoint14 a :dataPoint ;
    :xValue "Utilities" ;
    :yValue "0.017" ;
    :belongsTo :Chart .

:dataPoint15 a :dataPoint ;
    :xValue "Finance, insurance, real estate, rental and leasing" ;
