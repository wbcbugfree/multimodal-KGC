@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Total number of public primary schools in France from 2005 to 2018" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Number of public schools" .

:YAxis a :Axis ;
    :title "Year" .

:dataPoint1 a :dataPoint ;
    :xValue "44902" ;
    :yValue "2018*" ;
    :belongsTo :Chart .

