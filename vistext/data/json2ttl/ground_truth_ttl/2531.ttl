@prefix : <http://example.org/> .

:Chart a :LineChart ;
    :title "Number of Canadian students enrolled in postsecondary institutions in Canada from 2000 to 2018 (in millions)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Number of Canadian students in millions" .

