@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "French men 's favorite ready-to-wear brands in 2017" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "Share of respondents" .

:dataPoint1 a :dataPoint ;
    :xValue "Celio" ;
    :yValue "0.32" ;
    :belongsTo :Chart .

