@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Crude birth rate in each continent and worldwide , from 1950 to 2020" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "North America" .

:YAxis a :Axis ;
    :title "Year" .

:dataPoint1 a :dataPoint ;
    :xValue "11.8" ;
    :yValue "2015-2020" ;
    :belongsTo :Chart .

:dataPoint2 a :dataPoint ;
    :xValue "12.4" ;
    :yValue "2010-2015" ;
    :belongsTo :Chart .

