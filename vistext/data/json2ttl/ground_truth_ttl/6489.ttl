@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Crude birth rate in each continent and worldwide , from 1950 to 2020" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "North America" .

:YAxis a :Axis ;
    :title "Year" .

:DataPoint1 a :DataPoint ;
    :xValue "11.8" ;
    :yValue "2015-2020" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "12.4" ;
    :yValue "2010-2015" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "13.5" ;
    :yValue "2005-2010" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "13.7" ;
    :yValue "2000-2005" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "14" ;
    :yValue "1995-2000" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "15.3" ;
    :yValue "1990-1995" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "15.5" ;
    :yValue "1985-1990" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "15.3" ;
    :yValue "1980-1985" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "14.8" ;
    :yValue "1975-1980" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "15.6" ;
    :yValue "1970-1975" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "17.7" ;
    :yValue "1965-1970" ;
    :belongsTo :Chart .

:DataPoint12 a :DataPoint ;
    :xValue "21.4" ;
    :yValue "1960-1965" ;
    :belongsTo :Chart .

:DataPoint13 a :DataPoint ;
    :xValue "24.1" ;
    :yValue "1955-1960" ;
    :belongsTo :Chart .

:DataPoint14 a :DataPoint ;
    :xValue "24.4" ;
    :yValue "1950-1955" ;
    :belongsTo :Chart .
