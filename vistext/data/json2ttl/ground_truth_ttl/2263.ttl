@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Ranking of the 20 most popular tourist attractions in the world (according to visitor numbers in 2006)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Tourist attraction" .

:YAxis a :Axis ;
    :title "Visitors (in millions)" .

:dataPoint1 a :dataPoint ;
    :xValue "Times Square, New York" ;
    :yValue "35" ;
    :belongsTo :Chart .

