@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Average monthly rainfall deviation in the United Kingdom (UK) from 2015 to 2020 (in millimeters)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Month" .

:YAxis a :Axis ;
    :title "2019*" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 57.4 Nov" ;
    :yValue "-99.9" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Oct 3 Sep 7.8 Aug 88.3 Jul 31.3 June" ;
    :yValue "-4.9" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "May" ;
    :yValue "-19.5" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "Apr" ;
    :yValue "-48.1" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "Mar 59.8 Feb" ;
    :yValue "-4.7" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Jan" ;
    :yValue "-89.3" ;
    :belongsTo :Chart .
