@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Average monthly rainfall deviation in the United Kingdom (UK) from 2015 to 2020 (in millimeters)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Month" .

:YAxis a :Axis ;
    :title "2019*" .

:dataPoint1 a :dataPoint ;
    :xValue "Dec" ;
    :yValue "57.4" ;
    :belongsTo :Chart .

:dataPoint2 a :dataPoint ;
    :xValue "Nov" ;
    :yValue "-99.9" ;
    :belongsTo :Chart .

:dataPoint3 a :dataPoint ;
    :xValue "Oct" ;
    :yValue "3" ;
    :belongsTo :Chart .

:dataPoint4 a :dataPoint ;
    :xValue "Sep" ;
    :yValue "7.8" ;
    :belongsTo :Chart .

:dataPoint5 a :dataPoint ;
    :xValue "Aug" ;
    :yValue "88.3" ;
    :belongsTo :Chart .

:dataPoint6 a :dataPoint ;
    :xValue "Jul" ;
    :yValue "31.3" ;
    :belongsTo :Chart .

:dataPoint7 a :dataPoint ;
    :xValue "June" ;
    :yValue "-4.9" ;
    :belongsTo :Chart .

:dataPoint8 a :dataPoint ;
    :xValue "May" ;
    :yValue "-19.5" ;
    :belongsTo :Chart .

:dataPoint9 a :dataPoint ;
    :xValue "Apr" ;
    :yValue "-48.1" ;
    :belongsTo :Chart .

:dataPoint10 a :dataPoint ;
    :xValue "Mar" ;
    :yValue "59.8" ;
    :belongsTo :Chart .

:dataPoint11 a :dataPoint ;
    :xValue "Feb" ;
    :yValue "-4.7" ;
    :belongsTo :Chart .

:dataPoint12 a :dataPoint ;
    :xValue "Jan" ;
    :yValue "-89.3" ;
    :belongsTo :Chart .
