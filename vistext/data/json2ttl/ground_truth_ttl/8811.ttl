@prefix : <http://example.org/> .

:Chart a :AreaChart ;
    :title "CVS Health 's revenue distribution from 2015 to 2025 , by product group" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Pharmacy services" .

:dataPoint1 a :dataPoint ;
    :xValue "Dec 31, 2014" ;
    :yValue "0.655" ;
    :belongsTo :Chart .

