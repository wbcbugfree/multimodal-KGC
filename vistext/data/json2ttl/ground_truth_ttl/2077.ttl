    :xValue "Orlando, FL" ;
    :yValue "2.4" ;
    :belongsTo :Chart .

:dataPoint6 a :dataPoint ;
    :xValue "Seattle, WA" ;
    :yValue "2.1" ;
    :belongsTo :Chart .

:dataPoint7 a :dataPoint ;
    :xValue "Milwaukee, WI" ;
    :yValue "1.8" ;
    :belongsTo :Chart .

:dataPoint8 a :dataPoint ;
    :xValue "Arlington, VA" ;
