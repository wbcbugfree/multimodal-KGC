@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Cities with the largest number of community gardens per 10,000 residents in the United States in 2019" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "city" .

:YAxis a :Axis ;
    :title "Community gardens per 10,000 residents" .

:dataPoint1 a :dataPoint ;
    :xValue "Portland, OR" ;
    :yValue "3.8" ;
    :belongsTo :Chart .

:dataPoint2 a :dataPoint ;
    :xValue "St. Paul, MN" ;
    :yValue "3.8" ;
    :belongsTo :Chart .

