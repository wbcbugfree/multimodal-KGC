@prefix : <http://example.org/> .

:Chart a :LineChart ;
    :title "Amount a player receives for playing in the NFL Super Bowl 2020 - 2030 (in 1,000 U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Losing team" .

:dataPoint1 a :dataPoint ;
    :xValue "Dec 31, 2019" ;
    :yValue "65" ;
    :belongsTo :Chart .

