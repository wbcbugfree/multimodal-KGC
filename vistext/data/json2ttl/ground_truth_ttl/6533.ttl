@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Channels used to purchase products according to internet users in the United States as of March 2019 , by category" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Physical store" .

:YAxis a :Axis ;
    :title "Response" .

:dataPoint1 a :dataPoint ;
    :xValue "0.34" ;
    :yValue "Books" ;
    :belongsTo :Chart .

:dataPoint2 a :dataPoint ;
    :xValue "0.65" ;
    :yValue "Clothing and apparel" ;
    :belongsTo :Chart .

:dataPoint3 a :dataPoint ;
    :xValue "0.76" ;
    :yValue "Consumer packaged goods" ;
    :belongsTo :Chart .

:dataPoint4 a :dataPoint ;
    :xValue "0.83" ;
    :yValue "Food/grocery" ;
    :belongsTo :Chart .

:dataPoint5 a :dataPoint ;
    :xValue "0.34" ;
    :yValue "Furniture" ;
    :belongsTo :Chart .

:dataPoint6 a :dataPoint ;
    :xValue "0.62" ;
    :yValue "Household goods" ;
    :belongsTo :Chart .

:dataPoint7 a :dataPoint ;
    :xValue "0.25" ;
    :yValue "Luxury goods" ;
    :belongsTo :Chart .

:dataPoint8 a :dataPoint ;
    :xValue "0.51" ;
    :yValue "Office supplies" ;
    :belongsTo :Chart .

:dataPoint9 a :dataPoint ;
    :xValue "0.5" ;
    :yValue "Pet supplies" ;
    :belongsTo :Chart .

:dataPoint10 a :dataPoint ;
    :xValue "0.35" ;
    :yValue "Sporting goods" ;
    :belongsTo :Chart .

:dataPoint11 a :dataPoint ;
    :xValue "0.5" ;
    :yValue "Tools and home improvement" ;
    :belongsTo :Chart .

:dataPoint12 a :dataPoint ;
    :xValue "0.69" ;
    :yValue "Health and beauty" ;
    :belongsTo :Chart .
