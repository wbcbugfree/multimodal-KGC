@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Volume of oilseeds produced in India in financial year 2020 , by type (in 1,000 metric tons)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Volume in thousand metric tons" .

:YAxis a :Axis ;
    :title "type" .

:dataPoint1 a :dataPoint ;
    :xValue "33501" ;
    :yValue "Total from nine oil seeds" ;
    :belongsTo :Chart .

:dataPoint2 a :dataPoint ;
    :xValue "12242" ;
    :yValue "Soyabean" ;
    :belongsTo :Chart .

:dataPoint3 a :dataPoint ;
    :xValue "9347" ;
    :yValue "Groundnut" ;
    :belongsTo :Chart .

:dataPoint4 a :dataPoint ;
    :xValue "8703" ;
    :yValue "Rapeseed and mustard" ;
    :belongsTo :Chart .

:dataPoint5 a :dataPoint ;
    :xValue "2060" ;
    :yValue "Castorseed" ;
    :belongsTo :Chart .

:dataPoint6 a :dataPoint ;
    :xValue "746" ;
    :yValue "Sesamum" ;
    :belongsTo :Chart .

:dataPoint7 a :dataPoint ;
    :xValue "202" ;
    :yValue "Sunflower" ;
    :belongsTo :Chart .

:dataPoint8 a :dataPoint ;
    :xValue "103" ;
    :yValue "Linseed" ;
    :belongsTo :Chart .

:dataPoint9 a :dataPoint ;
    :xValue "72" ;
    :yValue "Nigerseed" ;
    :belongsTo :Chart .

:dataPoint10 a :dataPoint ;
    :xValue "27" ;
    :yValue "Safflower" ;
    :belongsTo :Chart .
