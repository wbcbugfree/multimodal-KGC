@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Largest self-publishing companies in the United States in 2018 , by number of print books published" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Number of published titles" .

:YAxis a :Axis ;
    :title "company" .

:dataPoint1 a :dataPoint ;
    :xValue "1416384" ;
    :yValue "Amazon’s CreateSpace/Independently Published" ;
    :belongsTo :Chart .

:dataPoint2 a :dataPoint ;
    :xValue "37546" ;
    :yValue "Lulu Press, Inc.*" ;
    :belongsTo :Chart .

:dataPoint3 a :dataPoint ;
    :xValue "17682" ;
    :yValue "Blurb, Inc." ;
    :belongsTo :Chart .

:dataPoint4 a :dataPoint ;
    :xValue "5284" ;
    :yValue "Xlibris (Div. of Author Solutions)" ;
    :belongsTo :Chart .

:dataPoint5 a :dataPoint ;
    :xValue "3815" ;
    :yValue "AuthorHouse (Div. of Author Solutions)" ;
    :belongsTo :Chart .

:dataPoint6 a :dataPoint ;
    :xValue "3142" ;
    :yValue "Christian Faith Publishing" ;
    :belongsTo :Chart .

:dataPoint7 a :dataPoint ;
    :xValue "2245" ;
    :yValue "Independent Publisher (Bar Code Graphics)" ;
    :belongsTo :Chart .

:dataPoint8 a :dataPoint ;
    :xValue "2208" ;
    :yValue "WestBow Press (imprint of Author Solutions)" ;
    :belongsTo :Chart .

:dataPoint9 a :dataPoint ;
    :xValue "2087" ;
    :yValue "Page Publishing, Inc." ;
    :belongsTo :Chart .

:dataPoint10 a :dataPoint ;
    :xValue "1603" ;
    :yValue "Salem Author Services [formerly Xulon Press]" ;
    :belongsTo :Chart .
