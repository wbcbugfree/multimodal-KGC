@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Number of passenger cars registered in Spain between 2015 and 2019 , by autonomous community" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
