    :yValue "Phone" ;
    :belongsTo :Chart .

:dataPoint11 a :dataPoint ;
    :xValue "0.08" ;
    :yValue "Door to door*" ;
    :belongsTo :Chart .

:dataPoint12 a :dataPoint ;
    :xValue "0.08" ;
    :yValue "Mobile text" ;
    :belongsTo :Chart .

:dataPoint13 a :dataPoint ;
    :xValue "0.06" ;
    :yValue "Social netowrking site" ;
    :belongsTo :Chart .

:dataPoint14 a :dataPoint ;
    :xValue "0.06" ;
    :yValue "Online ad*" ;
    :belongsTo :Chart .

:dataPoint15 a :dataPoint ;
    :xValue "0.05" ;
    :yValue "Will/planned gift" ;
    :belongsTo :Chart .

:dataPoint16 a :dataPoint ;
