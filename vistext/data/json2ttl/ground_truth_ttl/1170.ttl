@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Donations made to charity in the U.S. from 2011 to 2013 , by channel used" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Share of respondents" .

:YAxis a :Axis ;
    :title "Channel" .

:dataPoint1 a :dataPoint ;
    :xValue "0.5" ;
    :yValue "Checkout donations" ;
    :belongsTo :Chart .

:dataPoint2 a :dataPoint ;
    :xValue "0.4" ;
    :yValue "Purchase of proceeds" ;
    :belongsTo :Chart .

:dataPoint3 a :dataPoint ;
    :xValue "0.39" ;
    :yValue "Online donation" ;
    :belongsTo :Chart .

:dataPoint4 a :dataPoint ;
    :xValue "0.35" ;
    :yValue "Pledge" ;
    :belongsTo :Chart .

:dataPoint5 a :dataPoint ;
    :xValue "0.32" ;
    :yValue "Honor/tribute gift" ;
    :belongsTo :Chart .

:dataPoint6 a :dataPoint ;
    :xValue "0.32" ;
    :yValue "Mailed check/credit card*" ;
    :belongsTo :Chart .

:dataPoint7 a :dataPoint ;
    :xValue "0.25" ;
    :yValue "Street canvassing*" ;
    :belongsTo :Chart .

:dataPoint8 a :dataPoint ;
    :xValue "0.21" ;
