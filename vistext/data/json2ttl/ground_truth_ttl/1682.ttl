@prefix : <http://example.org/> .

:Chart a :AreaChart ;
    :title "Number of public and private secondary schools in France between 1980 and 2018" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Number of establishments" .

