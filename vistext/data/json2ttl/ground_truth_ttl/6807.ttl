@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Food items that Malaysians have been stocking up during the Movement Control Order (MCO) period during the COVID-19 outbreak in 2020" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "MCO Phase 3" .

:dataPoint1 a :dataPoint ;
    :xValue "Eggs" ;
    :yValue "0.83" ;
    :belongsTo :Chart .

:dataPoint2 a :dataPoint ;
    :xValue "Dry food items" ;
    :yValue "0.78" ;
    :belongsTo :Chart .

:dataPoint3 a :dataPoint ;
    :xValue "Fresh food" ;
    :yValue "0.75" ;
    :belongsTo :Chart .

:dataPoint4 a :dataPoint ;
    :xValue "Poultry/meat" ;
    :yValue "0.67" ;
    :belongsTo :Chart .

:dataPoint5 a :dataPoint ;
    :xValue "Frozen food" ;
    :yValue "0.63" ;
    :belongsTo :Chart .

:dataPoint6 a :dataPoint ;
    :xValue "Cooking oil" ;
    :yValue "0.62" ;
    :belongsTo :Chart .

:dataPoint7 a :dataPoint ;
    :xValue "Bread, pastry" ;
    :yValue "0.57" ;
    :belongsTo :Chart .

:dataPoint8 a :dataPoint ;
    :xValue "Beverages" ;
    :yValue "0.54" ;
    :belongsTo :Chart .

:dataPoint9 a :dataPoint ;
    :xValue "Other dairy products" ;
    :yValue "0.35" ;
    :belongsTo :Chart .

:dataPoint10 a :dataPoint ;
    :xValue "Seafood" ;
    :yValue "0.3" ;
    :belongsTo :Chart .

:dataPoint11 a :dataPoint ;
    :xValue "Cheese" ;
    :yValue "0.18" ;
    :belongsTo :Chart .

:dataPoint12 a :dataPoint ;
    :xValue "Alcohol" ;
    :yValue "0.03" ;
    :belongsTo :Chart .
