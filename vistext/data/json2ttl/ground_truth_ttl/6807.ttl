@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Food items that Malaysians have been stocking up during the Movement Control Order (MCO) period during the COVID-19 outbreak in 2020" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "MCO Phase 3" .

:DataPoint1 a :DataPoint ;
    :xValue "Eggs" ;
    :yValue "0.83" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Dry food items" ;
    :yValue "0.78" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "Fresh food" ;
    :yValue "0.75" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "Poultry/meat" ;
    :yValue "0.67" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "Frozen food" ;
    :yValue "0.63" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Cooking oil" ;
    :yValue "0.62" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Bread, pastry" ;
    :yValue "0.57" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Beverages" ;
    :yValue "0.54" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "Other dairy products" ;
    :yValue "0.35" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "Seafood" ;
    :yValue "0.3" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "Cheese" ;
    :yValue "0.18" ;
    :belongsTo :Chart .

:DataPoint12 a :DataPoint ;
    :xValue "Alcohol" ;
    :yValue "0.03" ;
    :belongsTo :Chart .
