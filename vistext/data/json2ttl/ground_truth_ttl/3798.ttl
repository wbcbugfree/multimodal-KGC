@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Average number of civilian deaths per day by car bombs and suicide attacks in Iraq war from 2003 to 2013" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Average number of civilian deaths per day" .

:dataPoint1 a :dataPoint ;
    :xValue "2013*" ;
    :yValue "6.4" ;
    :belongsTo :Chart .

:dataPoint2 a :dataPoint ;
    :xValue "2012" ;
    :yValue "7.3" ;
    :belongsTo :Chart .

:dataPoint3 a :dataPoint ;
    :xValue "2011" ;
    :yValue "6.6" ;
    :belongsTo :Chart .

:dataPoint4 a :dataPoint ;
    :xValue "2010" ;
    :yValue "7.3" ;
    :belongsTo :Chart .

:dataPoint5 a :dataPoint ;
    :xValue "2009" ;
    :yValue "8.4" ;
    :belongsTo :Chart .

:dataPoint6 a :dataPoint ;
    :xValue "2008" ;
    :yValue "10" ;
    :belongsTo :Chart .

:dataPoint7 a :dataPoint ;
    :xValue "2007" ;
    :yValue "22" ;
    :belongsTo :Chart .

:dataPoint8 a :dataPoint ;
    :xValue "2006" ;
    :yValue "16" ;
    :belongsTo :Chart .

:dataPoint9 a :dataPoint ;
    :xValue "2005" ;
    :yValue "10" ;
    :belongsTo :Chart .

:dataPoint10 a :dataPoint ;
    :xValue "2004" ;
    :yValue "5.4" ;
    :belongsTo :Chart .

:dataPoint11 a :dataPoint ;
    :xValue "2003" ;
    :yValue "1.5" ;
    :belongsTo :Chart .
