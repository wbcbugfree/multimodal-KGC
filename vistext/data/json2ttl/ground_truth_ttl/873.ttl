    :xValue "1.26" ;
    :yValue "Belgrade" ;
    :belongsTo :Chart .

:dataPoint6 a :dataPoint ;
    :xValue "1.28" ;
    :yValue "Warsaw" ;
    :belongsTo :Chart .

:dataPoint7 a :dataPoint ;
    :xValue "1.49" ;
    :yValue "Český Krumlov" ;
    :belongsTo :Chart .

:dataPoint8 a :dataPoint ;
    :xValue "1.87" ;
