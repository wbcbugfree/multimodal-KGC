@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Cheapest European city destinations ranked by daily public transport expenses in 2017 (in GBP)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Daily cost in GBP*" .

:YAxis a :Axis ;
    :title "Cheapest European city destinations" .

:dataPoint1 a :dataPoint ;
    :xValue "0.24" ;
    :yValue "Kiev" ;
    :belongsTo :Chart .

