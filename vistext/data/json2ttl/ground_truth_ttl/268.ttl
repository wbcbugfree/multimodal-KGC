@prefix : <http://example.org/> .

:Chart a :AreaChart ;
    :title "Share of female film directors in Hollywood from 2007 to 2019" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "Share of directors" .

