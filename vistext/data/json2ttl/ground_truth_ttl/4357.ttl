@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Internet user penetration in Singapore from 2015 to 2025" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "Share of population" .

:dataPoint1 a :dataPoint ;
    :xValue "2025*" ;
    :yValue "0.838" ;
    :belongsTo :Chart .

:dataPoint2 a :dataPoint ;
    :xValue "2024*" ;
    :yValue "0.8365" ;
    :belongsTo :Chart .

:dataPoint3 a :dataPoint ;
    :xValue "2023*" ;
    :yValue "0.8346" ;
    :belongsTo :Chart .

:dataPoint4 a :dataPoint ;
    :xValue "2022*" ;
    :yValue "0.832" ;
    :belongsTo :Chart .

:dataPoint5 a :dataPoint ;
    :xValue "2021*" ;
    :yValue "0.8286" ;
    :belongsTo :Chart .

:dataPoint6 a :dataPoint ;
    :xValue "2020*" ;
    :yValue "0.8241" ;
    :belongsTo :Chart .

:dataPoint7 a :dataPoint ;
    :xValue "2019" ;
    :yValue "0.8183" ;
    :belongsTo :Chart .

:dataPoint8 a :dataPoint ;
    :xValue "2018" ;
    :yValue "0.8108" ;
    :belongsTo :Chart .

:dataPoint9 a :dataPoint ;
    :xValue "2017" ;
    :yValue "0.8013" ;
    :belongsTo :Chart .

:dataPoint10 a :dataPoint ;
    :xValue "2016" ;
    :yValue "0.7895" ;
    :belongsTo :Chart .

:dataPoint11 a :dataPoint ;
    :xValue "2015" ;
    :yValue "0.775" ;
    :belongsTo :Chart .
