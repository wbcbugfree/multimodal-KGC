@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Number of coronavirus (COVID-19) drugs and vaccines in development worldwide as of January 7 , 2021 , by phase" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Phase" .

:YAxis a :Axis ;
    :title "Number of drugs and vaccines" .

:DataPoint1 a :DataPoint ;
    :xValue "Preclinical" ;
    :yValue "662" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Phase I Clinical" ;
    :yValue "77" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "Phase II Clinical" ;
    :yValue "168" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "Phase III Clinical" ;
    :yValue "77" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "Pre-registration" ;
    :yValue "5" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Registered" ;
    :yValue "2" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Launched" ;
    :yValue "6" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Discontinued" ;
    :yValue "7" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "No development reported" ;
    :yValue "12" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "Suspended" ;
    :yValue "1" ;
    :belongsTo :Chart .
