@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Number of coronavirus (COVID-19) drugs and vaccines in development worldwide as of January 7 , 2021 , by phase" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Phase" .

:YAxis a :Axis ;
    :title "Number of drugs and vaccines" .

:dataPoint1 a :dataPoint ;
    :xValue "Preclinical" ;
    :yValue "662" ;
    :belongsTo :Chart .

:dataPoint2 a :dataPoint ;
    :xValue "Phase I Clinical" ;
    :yValue "77" ;
    :belongsTo :Chart .

:dataPoint3 a :dataPoint ;
    :xValue "Phase II Clinical" ;
    :yValue "168" ;
    :belongsTo :Chart .

:dataPoint4 a :dataPoint ;
    :xValue "Phase III Clinical" ;
    :yValue "77" ;
    :belongsTo :Chart .

:dataPoint5 a :dataPoint ;
    :xValue "Pre-registration" ;
    :yValue "5" ;
    :belongsTo :Chart .

:dataPoint6 a :dataPoint ;
    :xValue "Registered" ;
    :yValue "2" ;
    :belongsTo :Chart .

:dataPoint7 a :dataPoint ;
    :xValue "Launched" ;
    :yValue "6" ;
    :belongsTo :Chart .

:dataPoint8 a :dataPoint ;
    :xValue "Discontinued" ;
    :yValue "7" ;
    :belongsTo :Chart .

:dataPoint9 a :dataPoint ;
    :xValue "No development reported" ;
    :yValue "12" ;
    :belongsTo :Chart .

:dataPoint10 a :dataPoint ;
    :xValue "Suspended" ;
    :yValue "1" ;
    :belongsTo :Chart .
