@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Leading countries for Italian cosmetic industry exports from 2014 to 2019 (in million euros)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Country" .

:YAxis a :Axis ;
    :title "2018" .

:dataPoint1 a :dataPoint ;
    :xValue "Franc" ;
    :yValue "636" ;
    :belongsTo :Chart .

