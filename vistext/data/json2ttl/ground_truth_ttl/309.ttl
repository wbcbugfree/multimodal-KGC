@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Monthly number of long-term unemployed persons in the U.S. from November 2019 to November 2020 (in millions , adjusted)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Number in millions" .

:YAxis a :Axis ;
    :title "Month" .

:dataPoint1 a :dataPoint ;
    :xValue "3.94" ;
    :yValue "Nov '20" ;
    :belongsTo :Chart .

