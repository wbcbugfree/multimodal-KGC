@prefix : <http://example.org/> .

:Chart a :LineChart ;
    :title "Consumption of sparkling wine in Belgium from 2003 to 2013 (in 1,000 hectoliters)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Consumption in thousand hectoliters" .

:dataPoint1 a :dataPoint ;
    :xValue "Dec 31, 2002" ;
    :yValue "156" ;
    :belongsTo :Chart .

:dataPoint2 a :dataPoint ;
    :xValue "Dec 31, 2003" ;
    :yValue "185" ;
    :belongsTo :Chart .

:dataPoint3 a :dataPoint ;
    :xValue "Dec 31, 2004" ;
    :yValue "196" ;
    :belongsTo :Chart .

:dataPoint4 a :dataPoint ;
    :xValue "Dec 31, 2005" ;
    :yValue "215" ;
    :belongsTo :Chart .

:dataPoint5 a :dataPoint ;
    :xValue "Dec 31, 2006" ;
    :yValue "217" ;
    :belongsTo :Chart .

:dataPoint6 a :dataPoint ;
    :xValue "Dec 31, 2007" ;
    :yValue "178" ;
    :belongsTo :Chart .

:dataPoint7 a :dataPoint ;
    :xValue "Dec 31, 2008" ;
    :yValue "283" ;
    :belongsTo :Chart .

:dataPoint8 a :dataPoint ;
    :xValue "Dec 31, 2009" ;
    :yValue "338" ;
    :belongsTo :Chart .

:dataPoint9 a :dataPoint ;
    :xValue "Dec 31, 2010" ;
