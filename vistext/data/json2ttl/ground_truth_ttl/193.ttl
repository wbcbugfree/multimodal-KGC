@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Ten most popular F.C . Internazionale Milano players on Instagram as of May 29 , 2020 (in million followers)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "F\\.C\\. Internazionale Milano player" .

:YAxis a :Axis ;
    :title "Number of followers in millions" .

:DataPoint1 a :DataPoint ;
    :xValue "omelu Lukaku" ;
    :yValue "5.3" ;
    :belongsTo :Chart .

