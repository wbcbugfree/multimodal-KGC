    :xValue "0.4624" ;
    :yValue "2021*" ;
    :belongsTo :Chart .

:dataPoint6 a :dataPoint ;
    :xValue "0.448" ;
    :yValue "2020*" ;
    :belongsTo :Chart .

:dataPoint7 a :dataPoint ;
    :xValue "0.4046" ;
    :yValue "2019*" ;
    :belongsTo :Chart .

:dataPoint8 a :dataPoint ;
    :xValue "0.3772" ;
