@prefix : <http://example.org/> .

:Chart a :AreaChart ;
    :title "Median weekly earnings of African American full-time wage and salary workers in the United States from 1979 to 2019 (in current U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Wage in current U.S. dollars" .

