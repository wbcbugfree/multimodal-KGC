    :xValue "Upstream and Midstream business in Alaska of BP Plc, London" ;
    :yValue "4.56" ;
    :belongsTo :Chart .

:dataPoint6 a :dataPoint ;
    :xValue "Merlin Entertainments Plc, Poole" ;
    :yValue "3.36" ;
    :belongsTo :Chart .

:dataPoint7 a :dataPoint ;
