@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Largest merger and acquisition (M & A) deals announced in Greater London (United Kingdom) in the 2019 , by target company (in billion GBP)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "business" .

:YAxis a :Axis ;
    :title "Deal value in billion GBP" .

:dataPoint1 a :dataPoint ;
    :xValue "Refinitiv UK Holdings Ltd, London" ;
    :yValue "21.8" ;
    :belongsTo :Chart .

:dataPoint2 a :dataPoint ;
    :xValue "Just Eat Plc, London" ;
    :yValue "6.26" ;
    :belongsTo :Chart .

:dataPoint3 a :dataPoint ;
