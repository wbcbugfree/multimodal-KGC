@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Revenue of the LVMH Group worldwide from 2008 to 2019 , by segment (in million euros)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Wines and spirits" .

:dataPoint1 a :dataPoint ;
    :xValue "2019" ;
    :yValue "5576" ;
    :belongsTo :Chart .

