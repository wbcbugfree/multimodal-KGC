@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Generation of renewable energy in the U.S. from 2009 to 2019 , by technology (in terawatt hours)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Hydro" .

:YAxis a :Axis ;
    :title "Year" .

:dataPoint1 a :dataPoint ;
    :xValue "274" ;
    :yValue "2019*" ;
    :belongsTo :Chart .

