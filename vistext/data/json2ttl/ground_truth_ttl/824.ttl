@prefix : <http://example.org/> .

:Chart a :AreaChart ;
    :title "Total revenue of PT Telkom Indonesia Tbk from 2009 to 2019 (in trillion Indonesian rupiah)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Total revenue in trillion Indonesian rupiah" .

:dataPoint1 a :dataPoint ;
    :xValue "Dec 31, 2008" ;
    :yValue "68.22" ;
    :belongsTo :Chart .

