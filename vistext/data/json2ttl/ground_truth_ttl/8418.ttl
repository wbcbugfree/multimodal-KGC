@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Vehicle buyers ' use of information sources worldwide in 2012 , by country" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "China" .

:dataPoint1 a :dataPoint ;
    :xValue "Car dealer (both new and used cars)" ;
    :yValue "0.47" ;
    :belongsTo :Chart .

:dataPoint2 a :dataPoint ;
    :xValue "Vehicle manufacturer websites" ;
    :yValue "0.46" ;
    :belongsTo :Chart .

:dataPoint3 a :dataPoint ;
    :xValue "Search engine" ;
    :yValue "0.51" ;
    :belongsTo :Chart .

:dataPoint4 a :dataPoint ;
    :xValue "Information websites/independent car valuation services" ;
    :yValue "0.44" ;
    :belongsTo :Chart .

:dataPoint5 a :dataPoint ;
    :xValue "Dealer website" ;
    :yValue "0.37" ;
    :belongsTo :Chart .

:dataPoint6 a :dataPoint ;
    :xValue "Family and friends" ;
    :yValue "0.47" ;
    :belongsTo :Chart .

:dataPoint7 a :dataPoint ;
    :xValue "Specialist motoring/automotive press" ;
    :yValue "0.49" ;
    :belongsTo :Chart .

:dataPoint8 a :dataPoint ;
    :xValue "Web forums, blogs or internet discussion groups" ;
    :yValue "0.43" ;
    :belongsTo :Chart .

:dataPoint9 a :dataPoint ;
    :xValue "Print advertising" ;
    :yValue "0.25" ;
    :belongsTo :Chart .

:dataPoint10 a :dataPoint ;
    :xValue "Auto shows" ;
    :yValue "0.44" ;
    :belongsTo :Chart .

:dataPoint11 a :dataPoint ;
    :xValue "TV advertising" ;
    :yValue "0.35" ;
    :belongsTo :Chart .

:dataPoint12 a :dataPoint ;
    :xValue "Independent e-tailer sites" ;
    :yValue "0.24" ;
    :belongsTo :Chart .

:dataPoint13 a :dataPoint ;
    :xValue "Manufacturer or dealer social media page" ;
    :yValue "0.28" ;
    :belongsTo :Chart .

:dataPoint14 a :dataPoint ;
    :xValue "Car dealer (used cars only)" ;
    :yValue "0.15" ;
    :belongsTo :Chart .

:dataPoint15 a :dataPoint ;
    :xValue "Non-specialist motoring/automotive press" ;
    :yValue "0.24" ;
    :belongsTo :Chart .
