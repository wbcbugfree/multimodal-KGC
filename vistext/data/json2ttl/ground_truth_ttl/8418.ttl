@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Vehicle buyers ' use of information sources worldwide in 2012 , by country" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "China" .

:DataPoint1 a :DataPoint ;
    :xValue "Car dealer (both new and used cars)" ;
    :yValue "0.47" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Vehicle manufacturer websites" ;
    :yValue "0.46" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "Search engine" ;
    :yValue "0.51" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "Information websites/independent car valuation ser..." ;
    :yValue "0.44" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "Dealer website" ;
    :yValue "0.37" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Family and friends" ;
    :yValue "0.47" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Specialist motoring/automotive press" ;
    :yValue "0.49" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Web forums, blogs or internet discussion groups" ;
    :yValue "0.43" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "Print advertising" ;
    :yValue "0.25" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "Auto shows" ;
    :yValue "0.44" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "TV advertising" ;
    :yValue "0.35" ;
    :belongsTo :Chart .

:DataPoint12 a :DataPoint ;
    :xValue "Independent e-tailer sites" ;
    :yValue "0.24" ;
    :belongsTo :Chart .

:DataPoint13 a :DataPoint ;
    :xValue "Manufacturer or dealer social media page" ;
    :yValue "0.28" ;
    :belongsTo :Chart .

:DataPoint14 a :DataPoint ;
    :xValue "Car dealer (used cars only)" ;
    :yValue "0.15" ;
    :belongsTo :Chart .

:DataPoint15 a :DataPoint ;
    :xValue "Non-specialist motoring/automotive press" ;
    :yValue "0.24" ;
    :belongsTo :Chart .
