@prefix : <http://example.org/> .

:Chart a :LineChart ;
    :title "Kuwait : Share of economic sectors in the gross domestic product (GDP) from 2010 to 2019" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Industry" .

:dataPoint1 a :dataPoint ;
    :xValue "Dec 31, 2009" ;
    :yValue "0.6607" ;
    :belongsTo :Chart .

