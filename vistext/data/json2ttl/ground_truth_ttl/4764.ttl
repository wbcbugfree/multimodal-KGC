@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Number of family medicine and general practice physicians in Canada as of 2019 , by province" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "province of Canada" .

:YAxis a :Axis ;
    :title "Number of physicians" .

:dataPoint1 a :dataPoint ;
    :xValue "Ontario" ;
    :yValue "14962" ;
    :belongsTo :Chart .

:dataPoint2 a :dataPoint ;
    :xValue "Quebec" ;
    :yValue "10909" ;
    :belongsTo :Chart .

:dataPoint3 a :dataPoint ;
    :xValue "British Columbia" ;
    :yValue "6366" ;
    :belongsTo :Chart .

:dataPoint4 a :dataPoint ;
    :xValue "Alberta" ;
    :yValue "5758" ;
    :belongsTo :Chart .

:dataPoint5 a :dataPoint ;
    :xValue "Manitoba" ;
    :yValue "1519" ;
    :belongsTo :Chart .

:dataPoint6 a :dataPoint ;
    :xValue "Saskatchewan" ;
    :yValue "1395" ;
    :belongsTo :Chart .

:dataPoint7 a :dataPoint ;
    :xValue "Nova Scotia" ;
    :yValue "1292" ;
    :belongsTo :Chart .

:dataPoint8 a :dataPoint ;
    :xValue "New Brunswick" ;
    :yValue "1153" ;
    :belongsTo :Chart .

:dataPoint9 a :dataPoint ;
    :xValue "Newfoundland and Labrador" ;
    :yValue "927" ;
