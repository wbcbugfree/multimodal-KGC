@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Most popular all-time TV shows in the United Kingdom (UK) from August 2019 to August 2020" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Share of respondents with a positive opinion" .

:YAxis a :Axis ;
    :title "Response" .

:dataPoint1 a :dataPoint ;
    :xValue "0.75" ;
    :yValue "Only Fools and Horses" ;
    :belongsTo :Chart .

:dataPoint2 a :dataPoint ;
    :xValue "0.73" ;
    :yValue "Fawlty Towers" ;
    :belongsTo :Chart .

:dataPoint3 a :dataPoint ;
    :xValue "0.72" ;
    :yValue "Planet Earth" ;
    :belongsTo :Chart .

:dataPoint4 a :dataPoint ;
    :xValue "0.72" ;
    :yValue "The Blue Planet" ;
    :belongsTo :Chart .

:dataPoint5 a :dataPoint ;
    :xValue "0.71" ;
    :yValue "Blue Planet II" ;
    :belongsTo :Chart .

:dataPoint6 a :dataPoint ;
    :xValue "0.65" ;
    :yValue "Blackadder" ;
    :belongsTo :Chart .

:dataPoint7 a :dataPoint ;
    :xValue "0.63" ;
    :yValue "David Attenborough's Natural Curiosities" ;
    :belongsTo :Chart .

:dataPoint8 a :dataPoint ;
    :xValue "0.63" ;
    :yValue "Mr. Bean" ;
    :belongsTo :Chart .

:dataPoint9 a :dataPoint ;
    :xValue "0.62" ;
    :yValue "The Flintstones" ;
    :belongsTo :Chart .

:dataPoint10 a :dataPoint ;
    :xValue "0.61" ;
    :yValue "Planet Earth II" ;
    :belongsTo :Chart .
