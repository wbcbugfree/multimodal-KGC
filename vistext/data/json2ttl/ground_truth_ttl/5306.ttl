@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Most popular all-time TV shows in the United Kingdom (UK) from August 2019 to August 2020" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Share of respondents with a positive opinion" .

:YAxis a :Axis ;
    :title "Response" .

:DataPoint1 a :DataPoint ;
    :xValue "0.75" ;
    :yValue "Only Fools and Horses" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "0.73" ;
    :yValue "Fawlty Towers" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "0.72" ;
    :yValue "Planet Earth" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "0.72" ;
    :yValue "The Blue Planet" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "0.71" ;
    :yValue "Blue Planet II" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "0.65" ;
    :yValue "Blackadder" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "0.63" ;
    :yValue "David Attenborough's Natural Curiosities" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "0.63" ;
    :yValue "Mr. Bean" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "0.62" ;
    :yValue "The Flintstones" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "0.61" ;
    :yValue "Planet Earth II" ;
    :belongsTo :Chart .
