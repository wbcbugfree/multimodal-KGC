@prefix : <http://example.org/> .

:Chart a :LineChart ;
    :title "Population of Scotland from 2000 to 2019 (in million people)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Population in million inhabitants" .

