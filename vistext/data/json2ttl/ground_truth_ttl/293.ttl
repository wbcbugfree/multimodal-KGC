@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Most popular domestic travel destinations for United States travelers , according to travel agents in 2016" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "Share of respondents" .

:dataPoint1 a :dataPoint ;
    :xValue "Orlando, FL" ;
    :yValue "0.359" ;
    :belongsTo :Chart .

:dataPoint2 a :dataPoint ;
    :xValue "Maui, HI" ;
    :yValue "0.358" ;
    :belongsTo :Chart .

:dataPoint3 a :dataPoint ;
    :xValue "Cruise - Alaska" ;
    :yValue "0.353" ;
    :belongsTo :Chart .

:dataPoint4 a :dataPoint ;
    :xValue "New York City, NY" ;
    :yValue "0.306" ;
    :belongsTo :Chart .

:dataPoint5 a :dataPoint ;
    :xValue "Las Vegas, NV" ;
    :yValue "0.288" ;
    :belongsTo :Chart .

:dataPoint6 a :dataPoint ;
    :xValue "Honolulu, HI" ;
    :yValue "0.215" ;
    :belongsTo :Chart .

:dataPoint7 a :dataPoint ;
    :xValue "Los Angeles, CA" ;
    :yValue "0.16" ;
    :belongsTo :Chart .

:dataPoint8 a :dataPoint ;
    :xValue "San Francisco, CA" ;
    :yValue "0.151" ;
    :belongsTo :Chart .

:dataPoint9 a :dataPoint ;
    :xValue "Chicago, IL" ;
    :yValue "0.143" ;
    :belongsTo :Chart .

:dataPoint10 a :dataPoint ;
    :xValue "Miami / Miami Beach, FL" ;
    :yValue "0.139" ;
    :belongsTo :Chart .
