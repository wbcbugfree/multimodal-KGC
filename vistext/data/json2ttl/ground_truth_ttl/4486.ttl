@prefix : <http://example.org/> .

:Chart a :AreaChart ;
    :title "Total number of Walmart stores worldwide from 2008 to 2020" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Number of stores" .

:dataPoint1 a :dataPoint ;
    :xValue "Dec 31, 2007" ;
    :yValue "7288" ;
    :belongsTo :Chart .

