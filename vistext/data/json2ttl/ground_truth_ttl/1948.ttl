@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Which payment methods do you offer in your online shop ?" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Share of respondents" .

:YAxis a :Axis ;
    :title "Response" .

:dataPoint1 a :dataPoint ;
    :xValue "0.71" ;
    :yValue "Advance payment by transfer" ;
    :belongsTo :Chart .

:dataPoint2 a :dataPoint ;
    :xValue "0.67" ;
    :yValue "PayPal" ;
    :belongsTo :Chart .

:dataPoint3 a :dataPoint ;
    :xValue "0.47" ;
    :yValue "Credit card" ;
    :belongsTo :Chart .

:dataPoint4 a :dataPoint ;
    :xValue "0.46" ;
    :yValue "Invoice" ;
    :belongsTo :Chart .

:dataPoint5 a :dataPoint ;
    :xValue "0.38" ;
    :yValue "SOFORT Überweisung (instant transfer)" ;
    :belongsTo :Chart .

:dataPoint6 a :dataPoint ;
    :xValue "0.31" ;
    :yValue "Debit" ;
    :belongsTo :Chart .

:dataPoint7 a :dataPoint ;
    :xValue "0.3" ;
    :yValue "Cash on delivery" ;
    :belongsTo :Chart .

:dataPoint8 a :dataPoint ;
    :xValue "0.28" ;
    :yValue "Credit card secured by 3-D Secure" ;
    :belongsTo :Chart .

:dataPoint9 a :dataPoint ;
    :xValue "0.23" ;
    :yValue "Invoice secured by service contractor" ;
    :belongsTo :Chart .

:dataPoint10 a :dataPoint ;
    :xValue "0.13" ;
    :yValue "giropay" ;
    :belongsTo :Chart .

:dataPoint11 a :dataPoint ;
    :xValue "0.1" ;
    :yValue "Debit secured by service contractor" ;
    :belongsTo :Chart .

:dataPoint12 a :dataPoint ;
    :xValue "0.09" ;
    :yValue "Payment by installments through service contractor" ;
    :belongsTo :Chart .

:dataPoint13 a :dataPoint ;
    :xValue "0.09" ;
    :yValue "Other procedures" ;
    :belongsTo :Chart .
