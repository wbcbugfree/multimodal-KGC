@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Genre breakdown of computer game sales in the United States in 2015" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Share of units sold" .

:YAxis a :Axis ;
    :title "Response" .

:dataPoint1 a :dataPoint ;
    :xValue "0.364" ;
    :yValue "Strategy" ;
    :belongsTo :Chart .

