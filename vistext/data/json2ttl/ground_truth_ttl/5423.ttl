@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Genre breakdown of computer game sales in the United States in 2015" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Share of units sold" .

:YAxis a :Axis ;
    :title "Response" .

:DataPoint1 a :DataPoint ;
    :xValue "0.364" ;
    :yValue "Strategy" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "0.258" ;
    :yValue "Casual" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "0.187" ;
    :yValue "Role-playing" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "0.063" ;
    :yValue "Shooter" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "0.059" ;
    :yValue "Adventure" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "0.041" ;
    :yValue "Action" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "0.013" ;
    :yValue "Other games, compilations" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "0.006" ;
    :yValue "Flight" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "0.003" ;
    :yValue "Family entertainment" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "0.003" ;
    :yValue "Racing" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "0.002" ;
    :yValue "Sport games" ;
    :belongsTo :Chart .

:DataPoint12 a :DataPoint ;
    :xValue "0.001" ;
