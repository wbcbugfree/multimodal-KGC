@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Mexico : The largest cities 2014 (in million residents)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Residents in million" .

:YAxis a :Axis ;
    :title "city" .

:dataPoint1 a :dataPoint ;
    :xValue "8.56" ;
    :yValue "Mexico City" ;
    :belongsTo :Chart .

:dataPoint2 a :dataPoint ;
    :xValue "1.74" ;
    :yValue "Ecatepec" ;
    :belongsTo :Chart .

:dataPoint3 a :dataPoint ;
    :xValue "1.5" ;
    :yValue "Guadalajara" ;
    :belongsTo :Chart .

:dataPoint4 a :dataPoint ;
    :xValue "1.5" ;
    :yValue "Puebla" ;
    :belongsTo :Chart .

:dataPoint5 a :dataPoint ;
    :xValue "1.4" ;
    :yValue "Ciudad Juárez" ;
    :belongsTo :Chart .

:dataPoint6 a :dataPoint ;
    :xValue "1.39" ;
    :yValue "Tijuana" ;
    :belongsTo :Chart .

:dataPoint7 a :dataPoint ;
    :xValue "1.28" ;
    :yValue "León" ;
    :belongsTo :Chart .

:dataPoint8 a :dataPoint ;
    :xValue "1.2" ;
    :yValue "Zapopan" ;
    :belongsTo :Chart .

:dataPoint9 a :dataPoint ;
    :xValue "1.17" ;
    :yValue "Monterrey" ;
    :belongsTo :Chart .

:dataPoint10 a :dataPoint ;
    :xValue "1.16" ;
    :yValue "Nezahualcóyotl" ;
    :belongsTo :Chart .
