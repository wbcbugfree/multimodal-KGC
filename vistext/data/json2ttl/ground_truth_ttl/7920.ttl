@prefix : <http://example.org/> .

:Chart a :LineChart ;
    :title "Annual revenue generated by Activision Blizzard from 2007 to 2019 , by region (in million U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Asia Pacific" .

:dataPoint1 a :dataPoint ;
    :xValue "Dec 31, 2006" ;
    :yValue "164" ;
    :belongsTo :Chart .

