@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Percentage of dedicated biotech companies in selected countries in 2014 , by application" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Country" .

:YAxis a :Axis ;
    :title "Health" .

