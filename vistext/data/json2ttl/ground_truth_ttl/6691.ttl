@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Millennials : Which of the following words or phrases describe your generation ?" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Yes, describes my generation" .

:YAxis a :Axis ;
    :title "Response" .

:dataPoint1 a :dataPoint ;
    :xValue "0.59" ;
    :yValue "Self-absorbed" ;
    :belongsTo :Chart .

