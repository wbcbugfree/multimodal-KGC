@prefix : <http://example.org/> .

:Chart a :LineChart ;
    :title "Uganda : Fertility rate from 2008 to 2018" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Number of children born per woman" .

:dataPoint1 a :dataPoint ;
    :xValue "Dec 31, 2007" ;
    :yValue "6.33" ;
    :belongsTo :Chart .

:dataPoint2 a :dataPoint ;
    :xValue "Dec 31, 2008" ;
    :yValue "6.23" ;
    :belongsTo :Chart .

:dataPoint3 a :dataPoint ;
    :xValue "Dec 31, 2009" ;
    :yValue "6.11" ;
    :belongsTo :Chart .

:dataPoint4 a :dataPoint ;
    :xValue "Dec 31, 2010" ;
    :yValue "5.98" ;
    :belongsTo :Chart .

:dataPoint5 a :dataPoint ;
    :xValue "Dec 31, 2011" ;
    :yValue "5.85" ;
    :belongsTo :Chart .

:dataPoint6 a :dataPoint ;
    :xValue "Dec 31, 2012" ;
    :yValue "5.7" ;
    :belongsTo :Chart .

:dataPoint7 a :dataPoint ;
    :xValue "Dec 31, 2013" ;
    :yValue "5.55" ;
    :belongsTo :Chart .

:dataPoint8 a :dataPoint ;
    :xValue "Dec 31, 2014" ;
    :yValue "5.39" ;
    :belongsTo :Chart .

:dataPoint9 a :dataPoint ;
    :xValue "Dec 31, 2015" ;
    :yValue "5.24" ;
    :belongsTo :Chart .

:dataPoint10 a :dataPoint ;
    :xValue "Dec 31, 2016" ;
    :yValue "5.1" ;
    :belongsTo :Chart .

:dataPoint11 a :dataPoint ;
    :xValue "Dec 31, 2017" ;
    :yValue "4.96" ;
    :belongsTo :Chart .
