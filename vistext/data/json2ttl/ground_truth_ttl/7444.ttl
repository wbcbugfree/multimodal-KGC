@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "For each of the following product categories , how many of your purchases have you made online over the last 12 months ?" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "About half of my purchases (41-60%)" .

:YAxis a :Axis ;
    :title "Response" .

:dataPoint1 a :dataPoint ;
    :xValue "0.1" ;
    :yValue "Consumer electronics" ;
    :belongsTo :Chart .

:dataPoint2 a :dataPoint ;
    :xValue "0.11" ;
    :yValue "Household appliances" ;
    :belongsTo :Chart .

:dataPoint3 a :dataPoint ;
    :xValue "0.23" ;
    :yValue "Clothing and footwear" ;
    :belongsTo :Chart .

:dataPoint4 a :dataPoint ;
    :xValue "0.17" ;
    :yValue "Books, music, movies and video games" ;
    :belongsTo :Chart .

:dataPoint5 a :dataPoint ;
    :xValue "0.12" ;
    :yValue "Furniture/homeware" ;
    :belongsTo :Chart .

:dataPoint6 a :dataPoint ;
    :xValue "0.11" ;
    :yValue "Sports/outdoor equipment" ;
    :belongsTo :Chart .

:dataPoint7 a :dataPoint ;
    :xValue "0.12" ;
    :yValue "Jewellery/watches" ;
    :belongsTo :Chart .

:dataPoint8 a :dataPoint ;
    :xValue "0.11" ;
    :yValue "DIY/home improvement" ;
    :belongsTo :Chart .

:dataPoint9 a :dataPoint ;
    :xValue "0.14" ;
    :yValue "Grocery" ;
    :belongsTo :Chart .

:dataPoint10 a :dataPoint ;
    :xValue "0.11" ;
    :yValue "Toys" ;
    :belongsTo :Chart .

:dataPoint11 a :dataPoint ;
    :xValue "0.18" ;
    :yValue "Health and beauty" ;
    :belongsTo :Chart .
