@prefix : <http://example.org/> .

:Chart a :LineChart ;
    :title "Digital share of overall music sales in selected countries from 2004 to 2014" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Germany" .

:dataPoint1 a :dataPoint ;
    :xValue "Dec 31, 2003" ;
    :yValue "0.01" ;
    :belongsTo :Chart .

:dataPoint2 a :dataPoint ;
    :xValue "Dec 31, 2004" ;
    :yValue "0.027" ;
    :belongsTo :Chart .

