@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Sports merchandising market size in North America from 2009 to 2023 (in billion U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Merchandising revenue in billion U.S. dollars" .

:YAxis a :Axis ;
    :title "Year" .

