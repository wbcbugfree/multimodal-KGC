@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Average undergraduate tuition fees for Canadian citizens in Canada from 2006 to 2020 (in Canadian dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Tuition in Canadian dollars" .

:DataPoint1 a :DataPoint ;
    :xValue "2020 / 2021*" ;
    :yValue "6610" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "2019 / 2020" ;
    :yValue "6496" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "2018 / 2019" ;
    :yValue "6822" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "2017 / 2018" ;
    :yValue "6618" ;
    :belongsTo :Chart .

