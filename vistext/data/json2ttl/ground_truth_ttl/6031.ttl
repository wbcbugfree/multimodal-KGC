@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Main worries or concerns about the COVID-19 / coronavirus pandemic in the United States , United Kingdom and Germany 2020 (as of May 31)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Germany" .

:YAxis a :Axis ;
    :title "Response" .

:dataPoint1 a :dataPoint ;
    :xValue "0.63" ;
    :yValue "My family’s health" ;
    :belongsTo :Chart .

:dataPoint2 a :dataPoint ;
    :xValue "0.57" ;
    :yValue "My country’s economic stability" ;
    :belongsTo :Chart .

:dataPoint3 a :dataPoint ;
    :xValue "0.51" ;
    :yValue "My physical health" ;
    :belongsTo :Chart .

:dataPoint4 a :dataPoint ;
    :xValue "0.36" ;
    :yValue "My economic situation" ;
    :belongsTo :Chart .

:dataPoint5 a :dataPoint ;
    :xValue "0.48" ;
    :yValue "My parent's / older friends health" ;
    :belongsTo :Chart .

:dataPoint6 a :dataPoint ;
    :xValue "0.28" ;
    :yValue "My country’s political stability" ;
    :belongsTo :Chart .

:dataPoint7 a :dataPoint ;
    :xValue "0.12" ;
    :yValue "Food shortages" ;
    :belongsTo :Chart .

:dataPoint8 a :dataPoint ;
    :xValue "0.24" ;
    :yValue "My mental health" ;
    :belongsTo :Chart .

:dataPoint9 a :dataPoint ;
    :xValue "0.2" ;
    :yValue "My job security" ;
    :belongsTo :Chart .

:dataPoint10 a :dataPoint ;
    :xValue "0.11" ;
    :yValue "Rioting or looting" ;
    :belongsTo :Chart .

:dataPoint11 a :dataPoint ;
    :xValue "0.03" ;
    :yValue "Other" ;
    :belongsTo :Chart .

:dataPoint12 a :dataPoint ;
    :xValue "0.02" ;
    :yValue "Don’t know" ;
    :belongsTo :Chart .
