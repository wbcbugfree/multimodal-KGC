@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Number of LTE subscriptions worldwide from 2012 to 2024 , by region (in millions)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Latin America" .

:YAxis a :Axis ;
    :title "Year" .

:dataPoint1 a :dataPoint ;
    :xValue "454.1" ;
    :yValue "2024*" ;
    :belongsTo :Chart .

:dataPoint2 a :dataPoint ;
    :xValue "404.66" ;
    :yValue "2023*" ;
    :belongsTo :Chart .

:dataPoint3 a :dataPoint ;
    :xValue "323.49" ;
    :yValue "2022*" ;
    :belongsTo :Chart .

:dataPoint4 a :dataPoint ;
    :xValue "236.12" ;
    :yValue "2021*" ;
    :belongsTo :Chart .

:dataPoint5 a :dataPoint ;
    :xValue "148.46" ;
    :yValue "2020*" ;
    :belongsTo :Chart .

:dataPoint6 a :dataPoint ;
    :xValue "76.98" ;
    :yValue "2019*" ;
    :belongsTo :Chart .

:dataPoint7 a :dataPoint ;
    :xValue "34.53" ;
    :yValue "2018" ;
    :belongsTo :Chart .

:dataPoint8 a :dataPoint ;
    :xValue "12.18" ;
    :yValue "2017" ;
    :belongsTo :Chart .

:dataPoint9 a :dataPoint ;
    :xValue "3.96" ;
    :yValue "2016" ;
    :belongsTo :Chart .
