@prefix : <http://example.org/> .

:Chart a :LineChart ;
    :title "Canada : Distribution of gross domestic product (GDP) across economic sectors from 2007 to 2016" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Agriculture" .

:dataPoint1 a :dataPoint ;
    :xValue "Dec 31, 2006" ;
    :yValue "0.0141" ;
    :belongsTo :Chart .

