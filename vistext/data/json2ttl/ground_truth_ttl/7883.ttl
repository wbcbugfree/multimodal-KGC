@prefix : <http://example.org/> .

:Chart a :LineChart ;
    :title "Number of suspects arrested for terrorism offences in the European Union (EU) from 2010 to 2019 , by affiliation" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Single Issue/ Not specified" .

:dataPoint1 a :dataPoint ;
    :xValue "Dec 31, 2009" ;
    :yValue "48" ;
    :belongsTo :Chart .

