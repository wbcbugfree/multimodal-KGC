@prefix : <http://example.org/> .

:Chart a :LineChart ;
    :title "Cuba : Distribution of gross domestic product (GDP) across economic sectors from 2008 to 2018" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Services" .

:dataPoint1 a :dataPoint ;
    :xValue "Dec 31, 2007" ;
    :yValue "0.7232" ;
    :belongsTo :Chart .

