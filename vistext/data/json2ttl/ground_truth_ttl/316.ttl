@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Convenience store sales of salty snacks in the United States in 2019 , by type (in million U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Industry total sales in million U.S. dollars" .

:YAxis a :Axis ;
    :title "salty snacks" .

:dataPoint1 a :dataPoint ;
    :xValue "1828.7" ;
    :yValue "Potato chips" ;
    :belongsTo :Chart .

:dataPoint2 a :dataPoint ;
    :xValue "1202.7" ;
    :yValue "Tortilla/corn chips" ;
    :belongsTo :Chart .

:dataPoint3 a :dataPoint ;
    :xValue "878.3" ;
    :yValue "Other salty snacks" ;
    :belongsTo :Chart .

:dataPoint4 a :dataPoint ;
    :xValue "822.3" ;
    :yValue "Cheese snacks" ;
    :belongsTo :Chart .

:dataPoint5 a :dataPoint ;
    :xValue "642.7" ;
    :yValue "Snack nuts" ;
    :belongsTo :Chart .

:dataPoint6 a :dataPoint ;
    :xValue "446.3" ;
    :yValue "Crackers" ;
    :belongsTo :Chart .

:dataPoint7 a :dataPoint ;
    :xValue "408.9" ;
    :yValue "Corn snacks" ;
    :belongsTo :Chart .

:dataPoint8 a :dataPoint ;
    :xValue "301.5" ;
    :yValue "Sunflower/pumpkin seeds" ;
    :belongsTo :Chart .

:dataPoint9 a :dataPoint ;
    :xValue "263.1" ;
    :yValue "Pretzels" ;
    :belongsTo :Chart .

:dataPoint10 a :dataPoint ;
    :xValue "243.4" ;
    :yValue "Popcorn (ready-to-eat)" ;
    :belongsTo :Chart .

:dataPoint11 a :dataPoint ;
    :xValue "229.4" ;
    :yValue "Pork rinds" ;
