    :xValue "0.52" ;
    :yValue "Porridge" ;
    :belongsTo :Chart .

:dataPoint6 a :dataPoint ;
    :xValue "0.64" ;
    :yValue "Chocolate paste" ;
    :belongsTo :Chart .

:dataPoint7 a :dataPoint ;
    :xValue "0.62" ;
    :yValue "Souces" ;
    :belongsTo :Chart .

:dataPoint8 a :dataPoint ;
    :xValue "0.46" ;
    :yValue "Sterilized milk" ;
    :belongsTo :Chart .

:dataPoint9 a :dataPoint ;
