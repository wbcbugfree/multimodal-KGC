@prefix : <http://example.org/> .

:Chart a :LineChart ;
    :title "Annual expenditure on beer in the United Kingdom from 2005 to 2019 , based on volume (in million GBP)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Expenditure in million GBP" .

:dataPoint1 a :dataPoint ;
    :xValue "Dec 31, 2004" ;
    :yValue "4050" ;
    :belongsTo :Chart .

