@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Employment rate by age in the United States from 2000 to 2019" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "55 and over" .

:YAxis a :Axis ;
    :title "year" .

