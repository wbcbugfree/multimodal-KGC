@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Number of bars , dance clubs and music venues in selected German cities in 2016 , by type" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "German cities" .

:YAxis a :Axis ;
    :title "Music venues" .

