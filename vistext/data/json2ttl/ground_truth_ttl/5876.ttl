@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Countries with the lowest density of hospital beds worldwide as of 2012 (per 10,000 population)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Hospital beds per 10,000 population" .

:YAxis a :Axis ;
    :title "Country" .

:DataPoint1 a :DataPoint ;
    :xValue "1" ;
    :yValue "Iran" ;
    :belongsTo :Chart .

