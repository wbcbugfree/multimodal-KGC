@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Toronto Blue Jays all-time home run leaders as of October 2020" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Home run leader" .

:YAxis a :Axis ;
    :title "Number of home runs" .

:dataPoint1 a :dataPoint ;
    :xValue "Carlos Delgado" ;
    :yValue "336" ;
    :belongsTo :Chart .

