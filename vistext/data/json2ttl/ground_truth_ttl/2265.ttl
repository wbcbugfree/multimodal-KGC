@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Increase in offline retail sales volume of fast-moving consumer goods due to the coronavirus (COVID-19) pandemic in Russia from April 6 to April 12 , 2020 , by type" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Sales increase" .

:YAxis a :Axis ;
    :title "consumer goods" .

:dataPoint1 a :dataPoint ;
    :xValue "0.55" ;
    :yValue "Wet wipes" ;
    :belongsTo :Chart .

:dataPoint2 a :dataPoint ;
    :xValue "0.22" ;
    :yValue "Vodka" ;
    :belongsTo :Chart .

:dataPoint3 a :dataPoint ;
    :xValue "0.18" ;
    :yValue "Soap" ;
    :belongsTo :Chart .

:dataPoint4 a :dataPoint ;
    :xValue "0.17" ;
    :yValue "Pasteurized milk" ;
    :belongsTo :Chart .

:dataPoint5 a :dataPoint ;
    :xValue "0.01" ;
    :yValue "Pelmeni / dumplings" ;
    :belongsTo :Chart .

:dataPoint6 a :dataPoint ;
    :xValue "-0.04" ;
    :yValue "Sugar" ;
    :belongsTo :Chart .

:dataPoint7 a :dataPoint ;
    :xValue "-0.09" ;
    :yValue "Rice" ;
    :belongsTo :Chart .

:dataPoint8 a :dataPoint ;
    :xValue "-0.11" ;
    :yValue "Buckwheat" ;
    :belongsTo :Chart .

:dataPoint9 a :dataPoint ;
    :xValue "-0.14" ;
    :yValue "Pasta products" ;
    :belongsTo :Chart .

:dataPoint10 a :dataPoint ;
    :xValue "-0.2" ;
    :yValue "Toilet paper" ;
    :belongsTo :Chart .
