@prefix : <http://example.org/> .

:Chart a :LineChart ;
    :title "Production volume of crude oil in Turkey from 2006 to 2018 (in 1,000 barrels per day)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Production volume in 1,000 barrels per day" .

:dataPoint1 a :dataPoint ;
    :xValue "Dec 31, 2005" ;
    :yValue "41.59" ;
    :belongsTo :Chart .

