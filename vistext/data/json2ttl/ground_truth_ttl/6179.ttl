@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Percentage of leave and remain votes in selected major cities in the United Kingdom (UK) in the EU referendum in 2016" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Leave" .

:YAxis a :Axis ;
    :title "city" .

:dataPoint1 a :dataPoint ;
    :xValue "0.256" ;
    :yValue "Edinburgh" ;
    :belongsTo :Chart .

:dataPoint2 a :dataPoint ;
    :xValue "0.334" ;
    :yValue "Glasgow" ;
    :belongsTo :Chart .

:dataPoint3 a :dataPoint ;
    :xValue "0.396" ;
    :yValue "Manchester" ;
    :belongsTo :Chart .

:dataPoint4 a :dataPoint ;
    :xValue "0.4" ;
    :yValue "Cardiff" ;
    :belongsTo :Chart .

:dataPoint5 a :dataPoint ;
    :xValue "0.401" ;
    :yValue "London" ;
    :belongsTo :Chart .

:dataPoint6 a :dataPoint ;
    :xValue "0.418" ;
    :yValue "Liverpool" ;
    :belongsTo :Chart .

:dataPoint7 a :dataPoint ;
    :xValue "0.493" ;
    :yValue "Newcastle" ;
    :belongsTo :Chart .

:dataPoint8 a :dataPoint ;
    :xValue "0.497" ;
    :yValue "Leeds" ;
    :belongsTo :Chart .

:dataPoint9 a :dataPoint ;
    :xValue "0.504" ;
    :yValue "Birmingham" ;
    :belongsTo :Chart .

:dataPoint10 a :dataPoint ;
    :xValue "0.5099" ;
    :yValue "Sheffield" ;
    :belongsTo :Chart .
