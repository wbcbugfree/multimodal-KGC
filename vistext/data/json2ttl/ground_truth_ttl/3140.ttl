@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Top goal scorers for Arsenal F.C . as of July 2020" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Goal scorer" .

:YAxis a :Axis ;
    :title "Goals scored" .

:dataPoint1 a :dataPoint ;
    :xValue "Thierry Henry" ;
    :yValue "228" ;
    :belongsTo :Chart .

