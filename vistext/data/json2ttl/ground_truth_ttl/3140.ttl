    :xValue "Dennis Bergkamp" ;
    :yValue "109" ;
    :belongsTo :Chart .

:dataPoint5 a :dataPoint ;
    :xValue "Theo Walcott" ;
    :yValue "108" ;
    :belongsTo :Chart .

:dataPoint6 a :dataPoint ;
    :xValue "Olivier Giroud" ;
    :yValue "105" ;
    :belongsTo :Chart .

:dataPoint7 a :dataPoint ;
    :xValue "Robert Pirès" ;
