    :yValue "Sep '18" ;
    :belongsTo :Chart .

:dataPoint6 a :dataPoint ;
    :xValue "0.028" ;
    :yValue "Aug '18" ;
    :belongsTo :Chart .

:dataPoint7 a :dataPoint ;
    :xValue "0.027" ;
    :yValue "Jul '18" ;
    :belongsTo :Chart .

:dataPoint8 a :dataPoint ;
    :xValue "0.027" ;
    :yValue "Jun '18" ;
    :belongsTo :Chart .

:dataPoint9 a :dataPoint ;
