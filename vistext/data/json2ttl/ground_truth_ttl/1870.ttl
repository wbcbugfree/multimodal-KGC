@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Monthly inflation rate in Latvia from February 2018 to January 2019 (HICP compared to same month in the previous year)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Growth rate of HICP" .

:YAxis a :Axis ;
    :title "Month" .

:dataPoint1 a :dataPoint ;
    :xValue "0.029" ;
    :yValue "Jan '19*" ;
    :belongsTo :Chart .

:dataPoint2 a :dataPoint ;
    :xValue "0.025" ;
    :yValue "Dec '18" ;
    :belongsTo :Chart .

:dataPoint3 a :dataPoint ;
    :xValue "0.029" ;
    :yValue "Nov '18" ;
    :belongsTo :Chart .

