@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Portugal : Government revenue and spending from 2014 to 2024 (in billion euros)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Spending" .

:YAxis a :Axis ;
    :title "Year" .

:dataPoint1 a :dataPoint ;
    :xValue "104.29" ;
    :yValue "2024*" ;
    :belongsTo :Chart .

