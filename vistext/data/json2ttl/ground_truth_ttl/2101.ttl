@prefix : <http://example.org/> .

:Chart a :LineChart ;
    :title "Number of mobile phone subscribers in Germany from 2004 to 2013 (in million users)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Number of users in million" .

:dataPoint1 a :dataPoint ;
    :xValue "Dec 31, 2003" ;
    :yValue "70" ;
    :belongsTo :Chart .

:dataPoint2 a :dataPoint ;
    :xValue "Dec 31, 2004" ;
    :yValue "78" ;
    :belongsTo :Chart .

:dataPoint3 a :dataPoint ;
    :xValue "Dec 31, 2005" ;
    :yValue "84" ;
    :belongsTo :Chart .

:dataPoint4 a :dataPoint ;
    :xValue "Dec 31, 2006" ;
    :yValue "95" ;
    :belongsTo :Chart .

:dataPoint5 a :dataPoint ;
    :xValue "Dec 31, 2007" ;
    :yValue "104" ;
    :belongsTo :Chart .

:dataPoint6 a :dataPoint ;
    :xValue "Dec 31, 2008" ;
    :yValue "103" ;
    :belongsTo :Chart .

:dataPoint7 a :dataPoint ;
    :xValue "Dec 31, 2009" ;
    :yValue "87" ;
    :belongsTo :Chart .

:dataPoint8 a :dataPoint ;
    :xValue "Dec 31, 2010" ;
    :yValue "89" ;
    :belongsTo :Chart .

:dataPoint9 a :dataPoint ;
    :xValue "Dec 31, 2011" ;
    :yValue "91" ;
    :belongsTo :Chart .

:dataPoint10 a :dataPoint ;
    :xValue "Dec 31, 2012" ;
    :yValue "97" ;
    :belongsTo :Chart .
