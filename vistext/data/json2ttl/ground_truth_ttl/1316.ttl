@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Duck production in Malaysia from 2005 to 2018 (in million heads)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Production in million heads" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2004" ;
    :yValue "8.05" ;
    :belongsTo :Chart .

