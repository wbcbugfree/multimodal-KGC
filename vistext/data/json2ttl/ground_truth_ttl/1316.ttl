@prefix : <http://example.org/> .

:Chart a :AreaChart ;
    :title "Duck production in Malaysia from 2005 to 2018 (in million heads)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Production in million heads" .

:dataPoint1 a :dataPoint ;
    :xValue "Dec 31, 2004" ;
    :yValue "8.05" ;
    :belongsTo :Chart .

