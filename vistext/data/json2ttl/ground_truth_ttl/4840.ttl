@prefix : <http://example.org/> .

:Chart a :LineChart ;
    :title "Unemployment rate for individuals aged 15 to 24 years in Singapore from 2011 to 2020" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Youth unemployment rate" .

:dataPoint1 a :dataPoint ;
    :xValue "Dec 31, 2010" ;
    :yValue "0.0928" ;
    :belongsTo :Chart .

:dataPoint2 a :dataPoint ;
    :xValue "Dec 31, 2011" ;
    :yValue "0.0896" ;
    :belongsTo :Chart .

:dataPoint3 a :dataPoint ;
    :xValue "Dec 31, 2012" ;
    :yValue "0.0936" ;
    :belongsTo :Chart .

:dataPoint4 a :dataPoint ;
    :xValue "Dec 31, 2013" ;
    :yValue "0.0874" ;
    :belongsTo :Chart .

:dataPoint5 a :dataPoint ;
    :xValue "Dec 31, 2014" ;
    :yValue "0.0934" ;
    :belongsTo :Chart .

:dataPoint6 a :dataPoint ;
    :xValue "Dec 31, 2015" ;
    :yValue "0.0912" ;
    :belongsTo :Chart .

:dataPoint7 a :dataPoint ;
    :xValue "Dec 31, 2016" ;
    :yValue "0.0878" ;
    :belongsTo :Chart .

:dataPoint8 a :dataPoint ;
    :xValue "Dec 31, 2017" ;
    :yValue "0.0861" ;
    :belongsTo :Chart .

:dataPoint9 a :dataPoint ;
    :xValue "Dec 31, 2018" ;
    :yValue "0.0843" ;
    :belongsTo :Chart .

:dataPoint10 a :dataPoint ;
    :xValue "Dec 31, 2019" ;
    :yValue "0.0835" ;
    :belongsTo :Chart .
