@prefix : <http://example.org/> .

:Chart a :LineChart ;
    :title "Global corporate profit of Richemont from FY2006 to FY2020 (in million euros)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Profit in million euros" .

:dataPoint1 a :dataPoint ;
    :xValue "Dec 31, 2005" ;
    :yValue "1096" ;
    :belongsTo :Chart .

