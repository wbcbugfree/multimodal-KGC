@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Budget deficit in Central and Eastern European countries as a percentage of GDP in the 1st quarter of 2020" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "Share of deficit in GDP" .

:dataPoint1 a :dataPoint ;
    :xValue "Romania" ;
    :yValue "-0.072" ;
    :belongsTo :Chart .

