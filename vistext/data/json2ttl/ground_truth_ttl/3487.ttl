@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Number of trade union members in manufacturing in the United Kingdom from 1995 to 2018 (in 1,000 members)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Number of members in thousand" .

