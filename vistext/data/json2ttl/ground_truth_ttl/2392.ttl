@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Route length of railways across Uttar Pradesh in India from financial year 2003 to 2019 (in kilometers)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Route length in kilometers" .

:YAxis a :Axis ;
    :title "year" .

