@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Characteristics of a dream woman in China from a male perspective in 2012" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Share of respondents" .

:YAxis a :Axis ;
    :title "Response" .

:dataPoint1 a :dataPoint ;
    :xValue "0.55" ;
    :yValue "Well-read and educated" ;
    :belongsTo :Chart .

:dataPoint2 a :dataPoint ;
    :xValue "0.49" ;
    :yValue "Monogamous" ;
    :belongsTo :Chart .

:dataPoint3 a :dataPoint ;
    :xValue "0.47" ;
    :yValue "Good manners and a good cook/housewife" ;
    :belongsTo :Chart .

:dataPoint4 a :dataPoint ;
    :xValue "0.46" ;
    :yValue "Elegance" ;
    :belongsTo :Chart .

:dataPoint5 a :dataPoint ;
    :xValue "0.38" ;
    :yValue "Sense of responsibility" ;
    :belongsTo :Chart .

:dataPoint6 a :dataPoint ;
    :xValue "0.2" ;
    :yValue "Good looks" ;
    :belongsTo :Chart .

:dataPoint7 a :dataPoint ;
    :xValue "0.11" ;
    :yValue "Sexy body" ;
    :belongsTo :Chart .

:dataPoint8 a :dataPoint ;
    :xValue "0.09" ;
    :yValue "Well off financially" ;
    :belongsTo :Chart .

:dataPoint9 a :dataPoint ;
    :xValue "0.07" ;
    :yValue "Willing to give birth" ;
    :belongsTo :Chart .

:dataPoint10 a :dataPoint ;
    :xValue "0.05" ;
    :yValue "Social status" ;
    :belongsTo :Chart .
