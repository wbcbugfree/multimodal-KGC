@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Distribution of causes of death in Belgium in 2016" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Distribution of deaths" .

:YAxis a :Axis ;
    :title "causes of death" .

:dataPoint1 a :dataPoint ;
    :xValue "0.938" ;
    :yValue "Natural causes" ;
    :belongsTo :Chart .

:dataPoint2 a :dataPoint ;
    :xValue "0.277" ;
    :yValue "Cardiovascular diseases" ;
    :belongsTo :Chart .

:dataPoint3 a :dataPoint ;
    :xValue "0.264" ;
    :yValue "Neoplasms" ;
    :belongsTo :Chart .

:dataPoint4 a :dataPoint ;
    :xValue "0.104" ;
    :yValue "Respiratory system disorders" ;
    :belongsTo :Chart .

:dataPoint5 a :dataPoint ;
    :xValue "0.079" ;
    :yValue "Other natural causes" ;
    :belongsTo :Chart .

:dataPoint6 a :dataPoint ;
    :xValue "0.062" ;
    :yValue "Unnatural causes" ;
    :belongsTo :Chart .

:dataPoint7 a :dataPoint ;
    :xValue "0.051" ;
    :yValue "Nervous system disorders" ;
    :belongsTo :Chart .

:dataPoint8 a :dataPoint ;
    :xValue "0.049" ;
    :yValue "Psychological disorders" ;
    :belongsTo :Chart .

:dataPoint9 a :dataPoint ;
    :xValue "0.045" ;
    :yValue "Digestive system disorders" ;
    :belongsTo :Chart .

:dataPoint10 a :dataPoint ;
    :xValue "0.027" ;
    :yValue "Urogential disorders" ;
    :belongsTo :Chart .

:dataPoint11 a :dataPoint ;
    :xValue "0.024" ;
    :yValue "Endocrine diseases and metabolism disorders" ;
    :belongsTo :Chart .

:dataPoint12 a :dataPoint ;
    :xValue "0.019" ;
    :yValue "Infections and parasitic diseases" ;
    :belongsTo :Chart .
