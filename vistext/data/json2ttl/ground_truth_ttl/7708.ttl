@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "How do you think each of the following US Presidents will go down in history ?" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "U\\.S\\. Presidents in chronological order" .

:YAxis a :Axis ;
    :title "Below average / poor" .

:dataPoint1 a :dataPoint ;
    :xValue "wight D. Eisenhower" ;
    :yValue "0.03" ;
    :belongsTo :Chart .

:dataPoint2 a :dataPoint ;
    :xValue "ohn F. Kennedy" ;
    :yValue "0.03" ;
    :belongsTo :Chart .

:dataPoint3 a :dataPoint ;
    :xValue "yndon B. Johnson" ;
    :yValue "0.22" ;
    :belongsTo :Chart .

:dataPoint4 a :dataPoint ;
    :xValue "ichard Nixon" ;
    :yValue "0.52" ;
    :belongsTo :Chart .

:dataPoint5 a :dataPoint ;
    :xValue "erald Ford" ;
    :yValue "0.2" ;
    :belongsTo :Chart .

:dataPoint6 a :dataPoint ;
    :xValue "immy Carter" ;
    :yValue "0.35" ;
    :belongsTo :Chart .

:dataPoint7 a :dataPoint ;
    :xValue "onald Reagan" ;
    :yValue "0.1" ;
    :belongsTo :Chart .

:dataPoint8 a :dataPoint ;
    :xValue "eorge H.W. Bush" ;
    :yValue "0.22" ;
    :belongsTo :Chart .

:dataPoint9 a :dataPoint ;
    :xValue "ill Clinton" ;
    :yValue "0.15" ;
    :belongsTo :Chart .

:dataPoint10 a :dataPoint ;
    :xValue "eorge W. Bush" ;
    :yValue "0.43" ;
    :belongsTo :Chart .

:dataPoint11 a :dataPoint ;
    :xValue "arack Obama" ;
    :yValue "0.4" ;
    :belongsTo :Chart .
