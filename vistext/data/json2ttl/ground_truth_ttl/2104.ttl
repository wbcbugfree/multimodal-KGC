@prefix : <http://example.org/> .

:Chart a :LineChart ;
    :title "Percentage of teenagers (16 - 19) who are enrolled in school and working in the United States from 1985 to 2019" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "Percentage of young adults" .

