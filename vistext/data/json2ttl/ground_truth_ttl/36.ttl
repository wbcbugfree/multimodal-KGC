@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Number of mobile customers of Vodafone in Germany in the corporate years from 2008/09 to 2019/2020 (in millions)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Mobile customers in millions" .

:dataPoint1 a :dataPoint ;
    :xValue "2019/20" ;
    :yValue "30.05" ;
    :belongsTo :Chart .

:dataPoint2 a :dataPoint ;
    :xValue "2018/19" ;
    :yValue "29.54" ;
    :belongsTo :Chart .

:dataPoint3 a :dataPoint ;
    :xValue "2017/18" ;
    :yValue "30.17" ;
    :belongsTo :Chart .

:dataPoint4 a :dataPoint ;
    :xValue "2016/17" ;
    :yValue "30.72" ;
    :belongsTo :Chart .

:dataPoint5 a :dataPoint ;
    :xValue "2015/16" ;
    :yValue "30.33" ;
    :belongsTo :Chart .

:dataPoint6 a :dataPoint ;
    :xValue "2014/15" ;
    :yValue "30.94" ;
    :belongsTo :Chart .

:dataPoint7 a :dataPoint ;
    :xValue "2013/14" ;
    :yValue "32.31" ;
    :belongsTo :Chart .

:dataPoint8 a :dataPoint ;
    :xValue "2012/13" ;
    :yValue "32.41" ;
    :belongsTo :Chart .

:dataPoint9 a :dataPoint ;
    :xValue "2011/12" ;
    :yValue "36.46" ;
    :belongsTo :Chart .

:dataPoint10 a :dataPoint ;
    :xValue "2010/11" ;
    :yValue "36.71" ;
    :belongsTo :Chart .

:dataPoint11 a :dataPoint ;
    :xValue "2009/10" ;
    :yValue "34.54" ;
    :belongsTo :Chart .

:dataPoint12 a :dataPoint ;
    :xValue "2008/09" ;
    :yValue "35.45" ;
