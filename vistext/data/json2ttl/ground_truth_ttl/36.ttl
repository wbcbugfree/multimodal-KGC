@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Number of mobile customers of Vodafone in Germany in the corporate years from 2008/09 to 2019/2020 (in millions)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Mobile customers in millions" .

:DataPoint1 a :DataPoint ;
    :xValue "2019/20" ;
    :yValue "30.05" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "2018/19" ;
    :yValue "29.54" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "2017/18" ;
    :yValue "30.17" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "2016/17" ;
    :yValue "30.72" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "2015/16" ;
    :yValue "30.33" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "2014/15" ;
    :yValue "30.94" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "2013/14" ;
    :yValue "32.31" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "2012/13" ;
    :yValue "32.41" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "2011/12" ;
    :yValue "36.46" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "2010/11" ;
    :yValue "36.71" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "2009/10" ;
    :yValue "34.54" ;
    :belongsTo :Chart .

:DataPoint12 a :DataPoint ;
    :xValue "2008/09" ;
    :yValue "35.45" ;
    :belongsTo :Chart .
