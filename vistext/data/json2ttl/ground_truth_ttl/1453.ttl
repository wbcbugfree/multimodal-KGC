@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Share of consumers who access music through illegal channels worldwide in 2017 , by country" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Share of respondents" .

:YAxis a :Axis ;
    :title "Response" .

:dataPoint1 a :dataPoint ;
    :xValue "0.23" ;
    :yValue "France" ;
    :belongsTo :Chart .

