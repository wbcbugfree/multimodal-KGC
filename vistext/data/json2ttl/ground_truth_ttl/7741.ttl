@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Monthly export value of frozen , fresh and canned fruit and vegetable juices in Canada from 2015 to 2020 (in million Canadian dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "2015" .

:YAxis a :Axis ;
    :title "Month" .

:dataPoint1 a :dataPoint ;
    :xValue "10.1" ;
    :yValue "Dec" ;
    :belongsTo :Chart .

:dataPoint2 a :dataPoint ;
    :xValue "9.2" ;
    :yValue "Nov" ;
    :belongsTo :Chart .

:dataPoint3 a :dataPoint ;
    :xValue "9.7" ;
    :yValue "Oct" ;
    :belongsTo :Chart .

:dataPoint4 a :dataPoint ;
    :xValue "8.9" ;
    :yValue "Sep" ;
    :belongsTo :Chart .

:dataPoint5 a :dataPoint ;
    :xValue "7.8" ;
    :yValue "Aug" ;
    :belongsTo :Chart .

:dataPoint6 a :dataPoint ;
    :xValue "8.1" ;
    :yValue "Jul" ;
    :belongsTo :Chart .

:dataPoint7 a :dataPoint ;
    :xValue "9.8" ;
    :yValue "Jun" ;
    :belongsTo :Chart .

:dataPoint8 a :dataPoint ;
    :xValue "8.9" ;
    :yValue "May" ;
    :belongsTo :Chart .

:dataPoint9 a :dataPoint ;
    :xValue "9.2" ;
    :yValue "Apr" ;
    :belongsTo :Chart .

:dataPoint10 a :dataPoint ;
    :xValue "9.4" ;
    :yValue "Mar" ;
    :belongsTo :Chart .

:dataPoint11 a :dataPoint ;
    :xValue "7.3" ;
    :yValue "Feb" ;
    :belongsTo :Chart .

:dataPoint12 a :dataPoint ;
    :xValue "8.8" ;
    :yValue "Jan" ;
    :belongsTo :Chart .
