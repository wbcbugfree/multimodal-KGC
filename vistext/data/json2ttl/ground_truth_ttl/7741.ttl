@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Monthly export value of frozen , fresh and canned fruit and vegetable juices in Canada from 2015 to 2020 (in million Canadian dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "2015" .

:YAxis a :Axis ;
    :title "Month" .

:DataPoint1 a :DataPoint ;
    :xValue "10.1" ;
    :yValue "Dec 9.2 Nov 9.7 Oct 8.9 Sep 7.8 Aug 8.1 Jul 9.8 Jun 8.9 May 9.2 Apr 9.4 Mar 7.3 Feb 8.8 Jan" ;
    :belongsTo :Chart .
