@prefix : <http://example.org/> .

:Chart a :AreaChart ;
    :title "Number of internet users worldwide from 2009 to 2020 , by region (in millions)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Africa" .

:dataPoint1 a :dataPoint ;
    :xValue "Dec 31, 2008" ;
    :yValue "86.2" ;
    :belongsTo :Chart .

