@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "What kind (s) of video/computer games do you play ?" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "Share of respondents" .

:dataPoint1 a :dataPoint ;
    :xValue "I don't play video/computer games" ;
    :yValue "0.38" ;
    :belongsTo :Chart .

