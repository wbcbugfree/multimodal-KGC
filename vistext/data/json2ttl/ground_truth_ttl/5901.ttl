@prefix : <http://example.org/> .

:Chart a :AreaChart ;
    :title "Value added of U.S. motor vehicle and parts manufacturing as a percentage of GDP between 2005 and 2017" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Value added as a percentage of GDP" .

:dataPoint1 a :dataPoint ;
    :xValue "Dec 31, 2004" ;
    :yValue "0.01" ;
    :belongsTo :Chart .

