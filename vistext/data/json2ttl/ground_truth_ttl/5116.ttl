@prefix : <http://example.org/> .

:Chart a :AreaChart ;
    :title "American customer satisfaction index scores of Pizza Hut restaurants in the United States from 2000 to 2020" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "ACSI score" .

