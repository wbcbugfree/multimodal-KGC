@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Average daily time spent on mobile web by smartphone users in Asia Pacific in July 2016 , by country (in minutes)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Country" .

:YAxis a :Axis ;
    :title "Average daily usage time in minutes" .

:dataPoint1 a :dataPoint ;
    :xValue "Indonesia" ;
    :yValue "66" ;
    :belongsTo :Chart .

:dataPoint2 a :dataPoint ;
    :xValue "India" ;
    :yValue "62" ;
    :belongsTo :Chart .

:dataPoint3 a :dataPoint ;
    :xValue "Philippines" ;
    :yValue "56" ;
    :belongsTo :Chart .

:dataPoint4 a :dataPoint ;
    :xValue "China" ;
    :yValue "55" ;
    :belongsTo :Chart .

:dataPoint5 a :dataPoint ;
    :xValue "Malaysia" ;
    :yValue "54" ;
    :belongsTo :Chart .

:dataPoint6 a :dataPoint ;
    :xValue "Thailand" ;
    :yValue "50" ;
    :belongsTo :Chart .

:dataPoint7 a :dataPoint ;
    :xValue "South Korea" ;
    :yValue "50" ;
    :belongsTo :Chart .

:dataPoint8 a :dataPoint ;
    :xValue "Vietnam" ;
    :yValue "47" ;
    :belongsTo :Chart .

:dataPoint9 a :dataPoint ;
    :xValue "Singapore" ;
    :yValue "46" ;
    :belongsTo :Chart .

:dataPoint10 a :dataPoint ;
    :xValue "Japan" ;
    :yValue "38" ;
    :belongsTo :Chart .
