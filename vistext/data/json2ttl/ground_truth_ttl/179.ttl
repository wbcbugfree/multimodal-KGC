@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Average daily time spent on mobile web by smartphone users in Asia Pacific in July 2016 , by country (in minutes)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Country" .

:YAxis a :Axis ;
    :title "Average daily usage time in minutes" .

:DataPoint1 a :DataPoint ;
    :xValue "Indonesia" ;
    :yValue "66" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "India" ;
    :yValue "62" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "Philippines" ;
    :yValue "56" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "China" ;
    :yValue "55" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "Malaysia" ;
    :yValue "54" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Thailand" ;
    :yValue "50" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "South Korea" ;
    :yValue "50" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Vietnam" ;
    :yValue "47" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "Singapore" ;
    :yValue "46" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "Japan" ;
    :yValue "38" ;
    :belongsTo :Chart .
