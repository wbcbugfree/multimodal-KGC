@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Rates of skin cancer in the countries with the highest rates of skin cancer worldwide in 2018 (per 100,000 population)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Rate per 100,000 population" .

:YAxis a :Axis ;
    :title "Country" .

