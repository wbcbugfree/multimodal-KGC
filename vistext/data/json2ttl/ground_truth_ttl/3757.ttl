@prefix : <http://example.org/> .

:Chart a :AreaChart ;
    :title "Net income of Wynn Resorts worldwide from 2008 to 2019 (in million U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Net income in million U.S. dollars" .

