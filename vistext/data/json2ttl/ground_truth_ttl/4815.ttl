@prefix : <http://example.org/> .

:Chart a :AreaChart ;
    :title "Migration balance (immigrants minus emigrants) in Belgium from 2010 to 2019" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Migration balance" .

:dataPoint1 a :dataPoint ;
    :xValue "Dec 31, 2009" ;
    :yValue "79446" ;
    :belongsTo :Chart .

