@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Average tuition fee for full-time Canadian undergraduate students in Canada in 2020/21 , by field of study (in Canadian dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Field of study" .

:YAxis a :Axis ;
    :title "Average tuition fee in Canadian dollars" .

