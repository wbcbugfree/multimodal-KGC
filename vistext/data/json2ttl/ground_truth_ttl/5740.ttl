@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Fertility rate in Spain in 2019 , by autonomous community" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "autonomous community of Spain" .

:YAxis a :Axis ;
    :title "Fertility rate" .

:dataPoint1 a :dataPoint ;
    :xValue "Melilla" ;
    :yValue "2.19" ;
    :belongsTo :Chart .

