@prefix : <http://example.org/> .

:Chart a :LineChart ;
    :title "Percentage of people who use a computer every day in the United Kingdom (UK) from 2003 to 2017" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "Percentage of respondents" .

:dataPoint1 a :dataPoint ;
    :xValue "Dec 31, 2002" ;
    :yValue "0.43" ;
    :belongsTo :Chart .

