@prefix : <http://example.org/> .

:Chart a :AreaChart ;
    :title "St. Louis Cardinals average ticket price from 2006 to 2019 (in U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Average ticket price in U.S. dollars" .

:dataPoint1 a :dataPoint ;
    :xValue "Dec 31, 2005" ;
    :yValue "29.78" ;
    :belongsTo :Chart .

