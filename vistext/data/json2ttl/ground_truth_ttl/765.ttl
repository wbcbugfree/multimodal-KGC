@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "South Africa : National debt in relation to gross domestic product (GDP) from 2015 to 2025" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "National debt in relation to GDP" .

:YAxis a :Axis ;
    :title "Year" .

:dataPoint1 a :dataPoint ;
    :xValue "0.8517" ;
    :yValue "2025*" ;
    :belongsTo :Chart .

:dataPoint2 a :dataPoint ;
    :xValue "0.8692" ;
    :yValue "2024*" ;
    :belongsTo :Chart .

:dataPoint3 a :dataPoint ;
    :xValue "0.8728" ;
    :yValue "2023*" ;
    :belongsTo :Chart .

:dataPoint4 a :dataPoint ;
    :xValue "0.8568" ;
    :yValue "2022*" ;
    :belongsTo :Chart .

:dataPoint5 a :dataPoint ;
    :xValue "0.8276" ;
    :yValue "2021*" ;
    :belongsTo :Chart .

:dataPoint6 a :dataPoint ;
    :xValue "0.7882" ;
    :yValue "2020*" ;
    :belongsTo :Chart .

:dataPoint7 a :dataPoint ;
    :xValue "0.6215" ;
    :yValue "2019" ;
    :belongsTo :Chart .

:dataPoint8 a :dataPoint ;
    :xValue "0.5671" ;
    :yValue "2018" ;
    :belongsTo :Chart .

:dataPoint9 a :dataPoint ;
    :xValue "0.5302" ;
    :yValue "2017" ;
    :belongsTo :Chart .

:dataPoint10 a :dataPoint ;
    :xValue "0.5147" ;
    :yValue "2016" ;
    :belongsTo :Chart .

:dataPoint11 a :dataPoint ;
    :xValue "0.4934" ;
    :yValue "2015" ;
    :belongsTo :Chart .
