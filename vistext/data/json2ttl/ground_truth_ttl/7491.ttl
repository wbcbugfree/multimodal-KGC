@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Rate of homicides in Canada in 2019 , by Aboriginal identity and province or territory (per 100,000 population)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "province of Canada" .

:YAxis a :Axis ;
    :title "Aboriginal" .

