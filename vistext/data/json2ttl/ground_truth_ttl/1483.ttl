@prefix : <http://example.org/> .

:Chart a :AreaChart ;
    :title "Number of new cases of HIV diagnosed in Denmark from 2006 to 2019" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Number of new cases diagnosed" .

:dataPoint1 a :dataPoint ;
    :xValue "Dec 31, 2005" ;
    :yValue "245" ;
    :belongsTo :Chart .

