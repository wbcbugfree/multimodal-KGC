@prefix : <http://example.org/> .

:Chart a :LineChart ;
    :title "Direct investment position of the United States in Russia from 2000 to 2019 (in billion U.S. dollars , on a historical-cost basis)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Direct investments in billion U.S. dollars" .

