@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Number of enterprises in the manufacture of leather and related products industry in Denmark from 2008 to 2017" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Number of enterprises" .

:dataPoint1 a :dataPoint ;
    :xValue "2017*" ;
    :yValue "70" ;
    :belongsTo :Chart .

:dataPoint2 a :dataPoint ;
    :xValue "2016" ;
    :yValue "65" ;
    :belongsTo :Chart .

:dataPoint3 a :dataPoint ;
    :xValue "2015" ;
    :yValue "61" ;
    :belongsTo :Chart .

:dataPoint4 a :dataPoint ;
    :xValue "2014" ;
    :yValue "59" ;
    :belongsTo :Chart .

:dataPoint5 a :dataPoint ;
    :xValue "2013" ;
    :yValue "62" ;
    :belongsTo :Chart .

:dataPoint6 a :dataPoint ;
    :xValue "2012" ;
    :yValue "65" ;
    :belongsTo :Chart .

:dataPoint7 a :dataPoint ;
    :xValue "2011" ;
    :yValue "61" ;
    :belongsTo :Chart .

:dataPoint8 a :dataPoint ;
    :xValue "2010" ;
    :yValue "62" ;
    :belongsTo :Chart .

:dataPoint9 a :dataPoint ;
    :xValue "2009" ;
    :yValue "61" ;
    :belongsTo :Chart .

:dataPoint10 a :dataPoint ;
    :xValue "2008" ;
    :yValue "66" ;
    :belongsTo :Chart .
