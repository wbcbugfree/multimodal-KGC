@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Chelsea FC revenue by stream from 2008/09 to 2018/19 (in million euros)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Season" .

:YAxis a :Axis ;
    :title "Matchday" .

:dataPoint1 a :dataPoint ;
    :xValue "2018/19" ;
    :yValue "75.6" ;
    :belongsTo :Chart .

:dataPoint2 a :dataPoint ;
    :xValue "2017/18" ;
    :yValue "83.4" ;
    :belongsTo :Chart .

:dataPoint3 a :dataPoint ;
    :xValue "2016/17" ;
    :yValue "76.2" ;
    :belongsTo :Chart .

:dataPoint4 a :dataPoint ;
    :xValue "2015/16" ;
    :yValue "93.2" ;
    :belongsTo :Chart .

:dataPoint5 a :dataPoint ;
    :xValue "2014/15" ;
    :yValue "93.1" ;
    :belongsTo :Chart .

:dataPoint6 a :dataPoint ;
    :xValue "2013/14" ;
    :yValue "84.9" ;
    :belongsTo :Chart .

:dataPoint7 a :dataPoint ;
    :xValue "2012/13" ;
    :yValue "82.5" ;
    :belongsTo :Chart .

:dataPoint8 a :dataPoint ;
    :xValue "2011/12" ;
    :yValue "96.1" ;
    :belongsTo :Chart .

:dataPoint9 a :dataPoint ;
    :xValue "2010/11" ;
    :yValue "74.7" ;
    :belongsTo :Chart .

:dataPoint10 a :dataPoint ;
    :xValue "2009/10" ;
    :yValue "82.1" ;
    :belongsTo :Chart .

:dataPoint11 a :dataPoint ;
    :xValue "2008/09" ;
    :yValue "87.4" ;
    :belongsTo :Chart .
