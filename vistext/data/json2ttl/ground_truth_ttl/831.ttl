@prefix : <http://example.org/> .

:Chart a :AreaChart ;
    :title "Number of holiday trips taken by Germans from 2005 to 2019" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Number of trips (in millions)" .

:dataPoint1 a :dataPoint ;
    :xValue "Dec 31, 2004" ;
    :yValue "64.1" ;
    :belongsTo :Chart .

