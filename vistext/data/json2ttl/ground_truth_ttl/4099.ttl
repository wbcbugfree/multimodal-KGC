@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Most popular movie genres among adults in the United States as of December 2018" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Share of respondents" .

:YAxis a :Axis ;
    :title "Response" .

:DataPoint1 a :DataPoint ;
    :xValue "0.9" ;
    :yValue "Comedy" ;
    :belongsTo :Chart .

