@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Global automotive market share in 2019 , by brand" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "automobile manufacturer" .

:YAxis a :Axis ;
    :title "Market share" .

:DataPoint1 a :DataPoint ;
    :xValue "Toyota" ;
    :yValue "0.1024" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Volkswagen" ;
    :yValue "0.0759" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "Ford" ;
    :yValue "0.0559" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "Honda" ;
    :yValue "0.0546" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "Nissan" ;
    :yValue "0.0515" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Hyundai" ;
    :yValue "0.0505" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Chevrolet" ;
    :yValue "0.0452" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Kia" ;
    :yValue "0.0335" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "Mercedes" ;
    :yValue "0.0294" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "BMW" ;
    :yValue "0.0262" ;
    :belongsTo :Chart .
