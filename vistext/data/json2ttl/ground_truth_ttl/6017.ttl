@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Global automotive market share in 2019 , by brand" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "automobile manufacturer" .

:YAxis a :Axis ;
    :title "Market share" .

:dataPoint1 a :dataPoint ;
    :xValue "Toyota" ;
    :yValue "0.1024" ;
    :belongsTo :Chart .

:dataPoint2 a :dataPoint ;
    :xValue "Volkswagen" ;
    :yValue "0.0759" ;
    :belongsTo :Chart .

:dataPoint3 a :dataPoint ;
    :xValue "Ford" ;
    :yValue "0.0559" ;
    :belongsTo :Chart .

:dataPoint4 a :dataPoint ;
    :xValue "Honda" ;
    :yValue "0.0546" ;
    :belongsTo :Chart .

:dataPoint5 a :dataPoint ;
    :xValue "Nissan" ;
    :yValue "0.0515" ;
    :belongsTo :Chart .

:dataPoint6 a :dataPoint ;
    :xValue "Hyundai" ;
    :yValue "0.0505" ;
    :belongsTo :Chart .

:dataPoint7 a :dataPoint ;
    :xValue "Chevrolet" ;
    :yValue "0.0452" ;
    :belongsTo :Chart .

:dataPoint8 a :dataPoint ;
    :xValue "Kia" ;
    :yValue "0.0335" ;
    :belongsTo :Chart .

:dataPoint9 a :dataPoint ;
    :xValue "Mercedes" ;
    :yValue "0.0294" ;
    :belongsTo :Chart .

:dataPoint10 a :dataPoint ;
    :xValue "BMW" ;
    :yValue "0.0262" ;
    :belongsTo :Chart .
