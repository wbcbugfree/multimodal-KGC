@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Pet ownership in selected countries in Europe in 2016" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Cat" .

:YAxis a :Axis ;
    :title "Response" .

:dataPoint1 a :dataPoint ;
    :xValue "0.27" ;
    :yValue "United Kingdom" ;
    :belongsTo :Chart .

