    :xValue "Dec 31, 2010" ;
    :yValue "30596" ;
    :belongsTo :Chart .

:dataPoint4 a :dataPoint ;
    :xValue "Dec 31, 2011" ;
    :yValue "31452" ;
    :belongsTo :Chart .

