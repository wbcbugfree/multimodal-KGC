@prefix : <http://example.org/> .

:Chart a :LineChart ;
    :title "Sweden 's contributions to the European budget from 2009 to 2019 (in million SEK)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Contributions in million SEK" .

:dataPoint1 a :dataPoint ;
    :xValue "Dec 31, 2008" ;
    :yValue "19192" ;
    :belongsTo :Chart .

:dataPoint2 a :dataPoint ;
    :xValue "Dec 31, 2009" ;
    :yValue "30407" ;
    :belongsTo :Chart .

