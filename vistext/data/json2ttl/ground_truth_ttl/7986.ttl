@prefix : <http://example.org/> .

:Chart a :LineChart ;
    :title "Public concern about the pollution of rivers , lakes and reservoirs in the United States from 1989 to 2017" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "Not at all" .

:dataPoint1 a :dataPoint ;
    :xValue "Dec 31, 1988" ;
    :yValue "0.03" ;
    :belongsTo :Chart .

