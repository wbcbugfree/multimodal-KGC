    :yValue "2015/16" ;
    :belongsTo :Chart .

:dataPoint6 a :dataPoint ;
    :xValue "142553" ;
    :yValue "2014/15" ;
    :belongsTo :Chart .

:dataPoint7 a :dataPoint ;
