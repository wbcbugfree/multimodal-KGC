@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Houston Astros all-time games played leaders as of October 2020" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Houston Astros all-time games played leaders" .

:YAxis a :Axis ;
    :title "Number of games played" .

