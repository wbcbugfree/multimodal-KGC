@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Degree of internet freedom in Middle East and North Africa according to the Freedom House Index 2019 , by country (index points)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Country" .

:YAxis a :Axis ;
    :title "Index points" .

:dataPoint1 a :dataPoint ;
    :xValue "Tunisia" ;
    :yValue "64" ;
    :belongsTo :Chart .

