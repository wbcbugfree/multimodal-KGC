@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Expenditure of the German Bundesliga from 2008/09 to 2018/19 , by segment (in million euros)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

