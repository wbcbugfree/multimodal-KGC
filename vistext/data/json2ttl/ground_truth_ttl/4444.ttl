@prefix : <http://example.org/> .

:Chart a :LineChart ;
    :title "Number of arrivals in tourist accommodation in Hungary from 2006 to 2017 (in millions)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Number of arrivals in millions" .

:dataPoint1 a :dataPoint ;
    :xValue "Dec 31, 2005" ;
    :yValue "7.2" ;
    :belongsTo :Chart .

:dataPoint2 a :dataPoint ;
    :xValue "Dec 31, 2006" ;
    :yValue "7.5" ;
    :belongsTo :Chart .

:dataPoint3 a :dataPoint ;
    :xValue "Dec 31, 2007" ;
    :yValue "7.7" ;
    :belongsTo :Chart .

:dataPoint4 a :dataPoint ;
    :xValue "Dec 31, 2008" ;
    :yValue "7.2" ;
    :belongsTo :Chart .

