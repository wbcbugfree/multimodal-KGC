    :xValue "220" ;
    :yValue "Antinori" ;
    :belongsTo :Chart .

:dataPoint6 a :dataPoint ;
    :xValue "193" ;
    :yValue "Zonin" ;
    :belongsTo :Chart .

:dataPoint7 a :dataPoint ;
    :xValue "171" ;
    :yValue "Martini" ;
    :belongsTo :Chart .

:dataPoint8 a :dataPoint ;
    :xValue "163" ;
