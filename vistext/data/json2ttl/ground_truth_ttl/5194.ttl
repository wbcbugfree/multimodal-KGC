@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Number of individuals with asthma in Great Britain in 2015 , by region" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "region in UK" .

:YAxis a :Axis ;
    :title "Number of individuals" .

:dataPoint1 a :dataPoint ;
    :xValue "North West" ;
    :yValue "778290" ;
    :belongsTo :Chart .

