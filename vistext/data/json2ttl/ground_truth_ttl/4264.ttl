@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Number of car sharing vehicles in Europe in 2014 , by country" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Country" .

:YAxis a :Axis ;
    :title "Number of vehicles" .

:dataPoint1 a :dataPoint ;
    :xValue "Germany" ;
    :yValue "13950" ;
    :belongsTo :Chart .

