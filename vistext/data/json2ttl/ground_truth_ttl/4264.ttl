@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Number of car sharing vehicles in Europe in 2014 , by country" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Country" .

:YAxis a :Axis ;
    :title "Number of vehicles" .

:DataPoint1 a :DataPoint ;
    :xValue "Germany" ;
    :yValue "13950" ;
    :belongsTo :Chart .

