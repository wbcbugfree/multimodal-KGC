@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Democratic Republic of the Congo : National debt from 2014 to 2024 (in billion U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "National debt in billion U.S. dollars" .

:YAxis a :Axis ;
    :title "Year" .

:dataPoint1 a :dataPoint ;
    :xValue "4.35" ;
    :yValue "2024*" ;
    :belongsTo :Chart .

:dataPoint2 a :dataPoint ;
    :xValue "4.79" ;
    :yValue "2023*" ;
    :belongsTo :Chart .

:dataPoint3 a :dataPoint ;
    :xValue "5.31" ;
    :yValue "2022*" ;
    :belongsTo :Chart .

:dataPoint4 a :dataPoint ;
    :xValue "5.78" ;
    :yValue "2021*" ;
    :belongsTo :Chart .

:dataPoint5 a :dataPoint ;
    :xValue "6.26" ;
    :yValue "2020*" ;
    :belongsTo :Chart .

:dataPoint6 a :dataPoint ;
    :xValue "6.7" ;
    :yValue "2019*" ;
    :belongsTo :Chart .

:dataPoint7 a :dataPoint ;
    :xValue "7.03" ;
    :yValue "2018" ;
    :belongsTo :Chart .

:dataPoint8 a :dataPoint ;
    :xValue "6.37" ;
    :yValue "2017" ;
    :belongsTo :Chart .

:dataPoint9 a :dataPoint ;
    :xValue "4.9" ;
    :yValue "2016" ;
    :belongsTo :Chart .

:dataPoint10 a :dataPoint ;
    :xValue "3.58" ;
    :yValue "2015" ;
    :belongsTo :Chart .

:dataPoint11 a :dataPoint ;
    :xValue "3.35" ;
    :yValue "2014" ;
    :belongsTo :Chart .
