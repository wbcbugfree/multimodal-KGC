@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Have you deliberately purchased any of these products or services online instead of offline because of the COVID-19 / coronavirus pandemic ? (as of May 31 , 2020)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "United Kingdom" .

:dataPoint1 a :dataPoint ;
    :xValue "Restaurant delivery / takeaway" ;
    :yValue "0.19" ;
    :belongsTo :Chart .

:dataPoint2 a :dataPoint ;
    :xValue "Hygiene products (e.g. hand sanitizer, toilet paper)" ;
    :yValue "0.21" ;
    :belongsTo :Chart .

:dataPoint3 a :dataPoint ;
    :xValue "Clothing" ;
    :yValue "0.24" ;
    :belongsTo :Chart .

:dataPoint4 a :dataPoint ;
    :xValue "Household cleaning products" ;
    :yValue "0.17" ;
    :belongsTo :Chart .

:dataPoint5 a :dataPoint ;
    :xValue "Food and drink delivery (e.g. from supermarket)" ;
    :yValue "0.3" ;
    :belongsTo :Chart .

:dataPoint6 a :dataPoint ;
    :xValue "Health products (e.g. medicine)" ;
    :yValue "0.15" ;
    :belongsTo :Chart .

:dataPoint7 a :dataPoint ;
    :xValue "Books" ;
    :yValue "0.16" ;
    :belongsTo :Chart .

:dataPoint8 a :dataPoint ;
    :xValue "Hobby supplies" ;
    :yValue "0.14" ;
    :belongsTo :Chart .

:dataPoint9 a :dataPoint ;
    :xValue "Games" ;
    :yValue "0.13" ;
    :belongsTo :Chart .

:dataPoint10 a :dataPoint ;
    :xValue "Consumer electronics, household appliances, furniture" ;
    :yValue "0.11" ;
    :belongsTo :Chart .

:dataPoint11 a :dataPoint ;
    :xValue "Video" ;
    :yValue "0.07" ;
    :belongsTo :Chart .

:dataPoint12 a :dataPoint ;
    :xValue "Music" ;
    :yValue "0.08" ;
    :belongsTo :Chart .

:dataPoint13 a :dataPoint ;
    :xValue "Magazines & newspapers" ;
    :yValue "0.07" ;
    :belongsTo :Chart .

:dataPoint14 a :dataPoint ;
    :xValue "Financial products and services" ;
    :yValue "0.06" ;
    :belongsTo :Chart .

:dataPoint15 a :dataPoint ;
    :xValue "Other" ;
    :yValue "0.03" ;
    :belongsTo :Chart .

:dataPoint16 a :dataPoint ;
    :xValue "I have not shifted from offline to online purchases for any products or services" ;
    :yValue "0.35" ;
    :belongsTo :Chart .
