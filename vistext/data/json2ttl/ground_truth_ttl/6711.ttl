@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Average retail price for peanut butter in Canada from January 2015 to June 2020 (in Canadian dollars per 500 grams)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Month" .

:YAxis a :Axis ;
    :title "2020" .

:dataPoint1 a :dataPoint ;
    :xValue "Ju" ;
    :yValue "2.74" ;
    :belongsTo :Chart .

:dataPoint2 a :dataPoint ;
    :xValue "Month: Jun Ma" ;
    :yValue "2.98" ;
    :belongsTo :Chart .

:dataPoint3 a :dataPoint ;
    :xValue "Month: May Ap" ;
    :yValue "2.79" ;
    :belongsTo :Chart .

:dataPoint4 a :dataPoint ;
    :xValue "Month: Apr Ma" ;
    :yValue "2.82" ;
    :belongsTo :Chart .

:dataPoint5 a :dataPoint ;
    :xValue "Month: Mar Fe" ;
    :yValue "2.8" ;
    :belongsTo :Chart .

:dataPoint6 a :dataPoint ;
    :xValue "Month: Feb Ja" ;
    :yValue "2.83" ;
    :belongsTo :Chart .
