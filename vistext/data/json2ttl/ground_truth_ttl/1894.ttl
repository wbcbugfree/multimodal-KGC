@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Share of people using the internet to pay bills or shop something in the past year in Singapore in 2017 , by type of population" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Share of respondents" .

:YAxis a :Axis ;
    :title "Response" .

:dataPoint1 a :dataPoint ;
    :xValue "0.72" ;
    :yValue "Richest" ;
    :belongsTo :Chart .

:dataPoint2 a :dataPoint ;
    :xValue "60" ;
    :yValue "(income)" ;
    :belongsTo :Chart .

:dataPoint3 a :dataPoint ;
    :xValue "0.71" ;
    :yValue "In labor" ;
    :belongsTo :Chart .

:dataPoint4 a :dataPoint ;
    :xValue "0.66" ;
    :yValue "Secondary education or less" ;
    :belongsTo :Chart .

:dataPoint5 a :dataPoint ;
    :xValue "0.58" ;
    :yValue "Adults" ;
    :belongsTo :Chart .

:dataPoint6 a :dataPoint ;
    :xValue "25" ;
    :yValue "years and older)" ;
    :belongsTo :Chart .

:dataPoint7 a :dataPoint ;
    :xValue "0.57" ;
    :yValue "Women" ;
    :belongsTo :Chart .

:dataPoint8 a :dataPoint ;
    :xValue "0.57" ;
    :yValue "Total" ;
    :belongsTo :Chart .

:dataPoint9 a :dataPoint ;
    :xValue "0.56" ;
    :yValue "Men" ;
    :belongsTo :Chart .

:dataPoint10 a :dataPoint ;
    :xValue "0.49" ;
    :yValue "Young adults (15-24 years)" ;
    :belongsTo :Chart .

:dataPoint11 a :dataPoint ;
    :xValue "0.33" ;
    :yValue "Poorest" ;
    :belongsTo :Chart .

:dataPoint12 a :dataPoint ;
    :xValue "40" ;
    :yValue "(income)" ;
    :belongsTo :Chart .

:dataPoint13 a :dataPoint ;
    :xValue "0.27" ;
    :yValue "Out of labor" ;
    :belongsTo :Chart .

:dataPoint14 a :dataPoint ;
    :xValue "0.17" ;
    :yValue "Primary education or less" ;
    :belongsTo :Chart .
