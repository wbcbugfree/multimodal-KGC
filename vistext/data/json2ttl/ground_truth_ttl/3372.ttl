@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Share of Baby Boomers who have purchased product subscriptions as a gift in the United States as of February 2017 , by product category" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Share of respondents" .

:YAxis a :Axis ;
    :title "Response" .

:DataPoint1 a :DataPoint ;
    :xValue "0.04" ;
    :yValue "Clothing items" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "0.03" ;
    :yValue "Pet supplies" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "0.03" ;
    :yValue "Food and non-alcoholic drink items" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "0.03" ;
    :yValue "Alcohol" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "0.03" ;
    :yValue "Themed gift boxes" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "0.02" ;
    :yValue "Personal grooming" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "0.01" ;
    :yValue "Household items" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "0.01" ;
    :yValue "Baby items" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "0.01" ;
    :yValue "Office supplies" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "0.01" ;
    :yValue "Personal health" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "0" ;
    :yValue "Medical items" ;
    :belongsTo :Chart .
