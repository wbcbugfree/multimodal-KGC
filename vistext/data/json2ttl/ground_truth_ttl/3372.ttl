@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Share of Baby Boomers who have purchased product subscriptions as a gift in the United States as of February 2017 , by product category" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Share of respondents" .

:YAxis a :Axis ;
    :title "Response" .

:dataPoint1 a :dataPoint ;
    :xValue "0.04" ;
    :yValue "Clothing items" ;
    :belongsTo :Chart .

:dataPoint2 a :dataPoint ;
    :xValue "0.03" ;
    :yValue "Pet supplies" ;
    :belongsTo :Chart .

:dataPoint3 a :dataPoint ;
    :xValue "0.03" ;
    :yValue "Food and non-alcoholic drink items" ;
    :belongsTo :Chart .

:dataPoint4 a :dataPoint ;
    :xValue "0.03" ;
    :yValue "Alcohol" ;
    :belongsTo :Chart .

:dataPoint5 a :dataPoint ;
    :xValue "0.03" ;
    :yValue "Themed gift boxes" ;
    :belongsTo :Chart .

:dataPoint6 a :dataPoint ;
    :xValue "0.02" ;
    :yValue "Personal grooming" ;
    :belongsTo :Chart .

:dataPoint7 a :dataPoint ;
    :xValue "0.01" ;
    :yValue "Household items" ;
    :belongsTo :Chart .

:dataPoint8 a :dataPoint ;
    :xValue "0.01" ;
    :yValue "Baby items" ;
    :belongsTo :Chart .

:dataPoint9 a :dataPoint ;
    :xValue "0.01" ;
    :yValue "Office supplies" ;
    :belongsTo :Chart .

:dataPoint10 a :dataPoint ;
    :xValue "0.01" ;
    :yValue "Personal health" ;
    :belongsTo :Chart .

:dataPoint11 a :dataPoint ;
    :xValue "0" ;
    :yValue "Medical items" ;
    :belongsTo :Chart .
