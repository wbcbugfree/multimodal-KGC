@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Market share of the leading acne treatment brands in the United States in 2019" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Market share" .

:YAxis a :Axis ;
    :title "Brand" .

:dataPoint1 a :dataPoint ;
    :xValue "0.167" ;
    :yValue "Neutrogena" ;
    :belongsTo :Chart .

:dataPoint2 a :dataPoint ;
    :xValue "0.11" ;
    :yValue "Private label" ;
    :belongsTo :Chart .

:dataPoint3 a :dataPoint ;
    :xValue "0.08" ;
    :yValue "Differin" ;
    :belongsTo :Chart .

:dataPoint4 a :dataPoint ;
    :xValue "0.054" ;
    :yValue "Clearasil" ;
    :belongsTo :Chart .

:dataPoint5 a :dataPoint ;
    :xValue "0.053" ;
    :yValue "Neutrogena Rapid Clear" ;
    :belongsTo :Chart .

:dataPoint6 a :dataPoint ;
    :xValue "0.044" ;
    :yValue "St. Ives" ;
    :belongsTo :Chart .

:dataPoint7 a :dataPoint ;
    :xValue "0.038" ;
    :yValue "Aveeno Active Naturals Clear Complexion" ;
    :belongsTo :Chart .

:dataPoint8 a :dataPoint ;
    :xValue "0.037" ;
    :yValue "Bioré" ;
    :belongsTo :Chart .

:dataPoint9 a :dataPoint ;
    :xValue "0.032" ;
    :yValue "Stiefel Panoxyl" ;
    :belongsTo :Chart .

:dataPoint10 a :dataPoint ;
    :xValue "0.025" ;
    :yValue "Neutrogena Acne Stress Control" ;
    :belongsTo :Chart .
