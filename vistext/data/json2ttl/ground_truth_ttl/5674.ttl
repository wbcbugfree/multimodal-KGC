@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Market share of the leading acne treatment brands in the United States in 2019" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Market share" .

:YAxis a :Axis ;
    :title "Brand" .

:DataPoint1 a :DataPoint ;
    :xValue "0.167" ;
    :yValue "Neutrogena" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "0.11" ;
    :yValue "Private label" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "0.08" ;
    :yValue "Differin" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "0.054" ;
    :yValue "Clearasil" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "0.053" ;
    :yValue "Neutrogena Rapid Clear" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "0.044" ;
    :yValue "St. Ives" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "0.038" ;
    :yValue "Aveeno Active Naturals Clear Complexion" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "0.037" ;
    :yValue "Bioré" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "0.032" ;
    :yValue "Stiefel Panoxyl" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "0.025" ;
    :yValue "Neutrogena Acne Stress Control" ;
    :belongsTo :Chart .
