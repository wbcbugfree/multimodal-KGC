@prefix : <http://example.org/> .

:Chart a :LineChart ;
    :title "Number of failed , foiled or completed terrorist attacks in the European Union (EU) from 2010 to 2019 , by affiliation" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Separatist" .

:dataPoint1 a :dataPoint ;
    :xValue "Dec 31, 2009" ;
    :yValue "160" ;
    :belongsTo :Chart .

