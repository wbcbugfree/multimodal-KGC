@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Rwanda : Budget balance between 2015 to 2025 in relation to GDP" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Budget balance in relation to GDP" .

:dataPoint1 a :dataPoint ;
    :xValue "2025*" ;
    :yValue "-0.037" ;
    :belongsTo :Chart .

:dataPoint2 a :dataPoint ;
    :xValue "2024*" ;
    :yValue "-0.0389" ;
    :belongsTo :Chart .

:dataPoint3 a :dataPoint ;
    :xValue "2023*" ;
    :yValue "-0.0351" ;
    :belongsTo :Chart .

:dataPoint4 a :dataPoint ;
    :xValue "2022*" ;
    :yValue "-0.0412" ;
    :belongsTo :Chart .

:dataPoint5 a :dataPoint ;
    :xValue "2021*" ;
    :yValue "-0.0705" ;
    :belongsTo :Chart .

:dataPoint6 a :dataPoint ;
    :xValue "2020*" ;
    :yValue "-0.0772" ;
    :belongsTo :Chart .

:dataPoint7 a :dataPoint ;
    :xValue "2019" ;
    :yValue "-0.0519" ;
    :belongsTo :Chart .

:dataPoint8 a :dataPoint ;
    :xValue "2018" ;
    :yValue "-0.0258" ;
    :belongsTo :Chart .

:dataPoint9 a :dataPoint ;
    :xValue "2017" ;
    :yValue "-0.0252" ;
    :belongsTo :Chart .

:dataPoint10 a :dataPoint ;
    :xValue "2016" ;
    :yValue "-0.0226" ;
    :belongsTo :Chart .

:dataPoint11 a :dataPoint ;
    :xValue "2015" ;
    :yValue "-0.0267" ;
    :belongsTo :Chart .
