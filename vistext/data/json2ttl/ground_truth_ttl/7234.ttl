    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Month: Aug Ju" ;
    :yValue "256.59" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Month: Jul Ju" ;
    :yValue "228.91" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Month: Jun Ma" ;
    :yValue "253.66" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "Month: May Ap" ;
