@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Number of Russian tourist arrivals in Egypt from 2012 to October 2017 , by month (in1,000s)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Month" .

:YAxis a :Axis ;
    :title "2014" .

:dataPoint1 a :dataPoint ;
    :xValue "De" ;
    :yValue "199.5" ;
    :belongsTo :Chart .

