@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Number of Russian tourist arrivals in Egypt from 2012 to October 2017 , by month (in1,000s)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Month" .

:YAxis a :Axis ;
    :title "2014" .

:DataPoint1 a :DataPoint ;
    :xValue "De" ;
    :yValue "199.5" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Month: Dec No" ;
    :yValue "310.23" ;
    :belongsTo :Chart .

