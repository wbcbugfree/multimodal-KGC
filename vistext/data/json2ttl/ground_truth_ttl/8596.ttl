@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Cost to deliver BBC radio services to individual users per user hour in the United Kingdom (UK) from 2015/16 to 2019/20 , by station (in pence)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "2018/19" .

:YAxis a :Axis ;
    :title "BBC radio stations" .

