@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Number of mosques in the United Kingdom (UK) in 2017 , by capacity" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Number of masjids" .

:dataPoint1 a :dataPoint ;
    :xValue "Greater than 4000 people" ;
    :yValue "10" ;
    :belongsTo :Chart .

:dataPoint2 a :dataPoint ;
    :xValue "2001 to 4000 people" ;
    :yValue "51" ;
    :belongsTo :Chart .

:dataPoint3 a :dataPoint ;
    :xValue "1001 to 2000 people" ;
    :yValue "130" ;
    :belongsTo :Chart .

:dataPoint4 a :dataPoint ;
    :xValue "751 to 1000 people" ;
    :yValue "99" ;
    :belongsTo :Chart .

:dataPoint5 a :dataPoint ;
    :xValue "501 to 750 people" ;
    :yValue "145" ;
    :belongsTo :Chart .

:dataPoint6 a :dataPoint ;
    :xValue "401 to 500 people" ;
    :yValue "137" ;
    :belongsTo :Chart .

:dataPoint7 a :dataPoint ;
    :xValue "301 to 400 people" ;
    :yValue "143" ;
    :belongsTo :Chart .

:dataPoint8 a :dataPoint ;
    :xValue "201 to 300 people" ;
    :yValue "279" ;
    :belongsTo :Chart .

:dataPoint9 a :dataPoint ;
    :xValue "101 to 200 people" ;
    :yValue "300" ;
    :belongsTo :Chart .

:dataPoint10 a :dataPoint ;
    :xValue "50 to 100 people" ;
    :yValue "276" ;
    :belongsTo :Chart .

:dataPoint11 a :dataPoint ;
    :xValue "Less than 50 people" ;
    :yValue "51" ;
    :belongsTo :Chart .
