@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Number of car registrations in Europe in 2019 , by segment (in 1,000s)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "New registrations in thousands" .

:YAxis a :Axis ;
    :title "programming language" .

:dataPoint1 a :dataPoint ;
    :xValue "2685.29" ;
    :yValue "Small" ;
    :belongsTo :Chart .

