@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Impact of coronavirus (COVID-19) on monthly retail sales development in the United States 2020 , by retail sector" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "July to August" .

:YAxis a :Axis ;
    :title "retail sector" .

:dataPoint1 a :dataPoint ;
    :xValue "0.002" ;
    :yValue "Motor vehicle & parts dealers" ;
    :belongsTo :Chart .

:dataPoint2 a :dataPoint ;
    :xValue "0.021" ;
    :yValue "Furniture & home furniture stores" ;
    :belongsTo :Chart .

:dataPoint3 a :dataPoint ;
    :xValue "0.008" ;
    :yValue "Electronics & appliance stores" ;
    :belongsTo :Chart .

:dataPoint4 a :dataPoint ;
    :xValue "0.02" ;
    :yValue "Building material & garden equipment & supplies dealers" ;
    :belongsTo :Chart .

:dataPoint5 a :dataPoint ;
    :xValue "-0.012" ;
    :yValue "Food & beverage stores" ;
    :belongsTo :Chart .

:dataPoint6 a :dataPoint ;
    :xValue "0.008" ;
    :yValue "Health & personal care stores" ;
    :belongsTo :Chart .

:dataPoint7 a :dataPoint ;
    :xValue "0.004" ;
    :yValue "Gasoline stations" ;
    :belongsTo :Chart .

:dataPoint8 a :dataPoint ;
    :xValue "0.029" ;
    :yValue "Clothing & clothing accessories stores" ;
    :belongsTo :Chart .

:dataPoint9 a :dataPoint ;
    :xValue "-0.057" ;
    :yValue "Sporting goods, hobby, musical instrument, & book stores" ;
    :belongsTo :Chart .

:dataPoint10 a :dataPoint ;
    :xValue "-0.004" ;
    :yValue "General merchandise stores" ;
    :belongsTo :Chart .

:dataPoint11 a :dataPoint ;
    :xValue "-0.002" ;
    :yValue "Miscellaneous store retailers" ;
    :belongsTo :Chart .

:dataPoint12 a :dataPoint ;
    :xValue "0" ;
    :yValue "Nonstore retailers" ;
    :belongsTo :Chart .

:dataPoint13 a :dataPoint ;
    :xValue "0.006" ;
    :yValue "Total retail" ;
    :belongsTo :Chart .
