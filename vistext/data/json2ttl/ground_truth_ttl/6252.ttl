@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Gross gambling yield (GGY) of the gambling industry in Great Britain (GB) from 2009 to 2019 , by sector (in million GBP)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Lotteries (remote and non-remote)" .

:YAxis a :Axis ;
    :title "Month" .

