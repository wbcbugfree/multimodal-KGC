@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Male tennis players with the most Grand Slam tournament titles won as of October 2020" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Number of Grand Slam victories" .

:YAxis a :Axis ;
    :title "Tennis player" .

:dataPoint1 a :dataPoint ;
    :xValue "20" ;
    :yValue "Roger Federer (SUI)" ;
    :belongsTo :Chart .

