@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Average annual rainfall in the United Kingdom (UK) from 2001 to 2019 (in millimeters)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Rainfall in millimeters" .

:YAxis a :Axis ;
    :title "Year" .

