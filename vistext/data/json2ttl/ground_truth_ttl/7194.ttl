@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Monthly export value of wheat in Canada from 2014 to 2020 (in million Canadian dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Month" .

:YAxis a :Axis ;
    :title "2020" .

:DataPoint1 a :DataPoint ;
    :xValue "Ju" ;
    :yValue "927.5" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Jul Ju" ;
    :yValue "716.4" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "Jun Ma" ;
    :yValue "809.7" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "May Ap" ;
    :yValue "807.1" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "Apr Ma" ;
    :yValue "653.5" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Mar Fe" ;
    :yValue "537.8" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Feb Ja" ;
    :yValue "575.6" ;
    :belongsTo :Chart .
