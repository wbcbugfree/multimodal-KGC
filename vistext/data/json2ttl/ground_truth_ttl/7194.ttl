@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Monthly export value of wheat in Canada from 2014 to 2020 (in million Canadian dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Month" .

:YAxis a :Axis ;
    :title "2020" .

:dataPoint1 a :dataPoint ;
    :xValue "Ju" ;
    :yValue "927.5" ;
    :belongsTo :Chart .

:dataPoint2 a :dataPoint ;
    :xValue "Month: Jul Ju" ;
    :yValue "716.4" ;
    :belongsTo :Chart .

:dataPoint3 a :dataPoint ;
    :xValue "Month: Jun Ma" ;
    :yValue "809.7" ;
    :belongsTo :Chart .

:dataPoint4 a :dataPoint ;
    :xValue "Month: May Ap" ;
    :yValue "807.1" ;
    :belongsTo :Chart .

:dataPoint5 a :dataPoint ;
    :xValue "Month: Apr Ma" ;
    :yValue "653.5" ;
    :belongsTo :Chart .

:dataPoint6 a :dataPoint ;
    :xValue "Month: Mar Fe" ;
    :yValue "537.8" ;
    :belongsTo :Chart .

:dataPoint7 a :dataPoint ;
    :xValue "Month: Feb Ja" ;
    :yValue "575.6" ;
    :belongsTo :Chart .
