@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Gross domestic product of Ontario , Canada in 2019 , by industry (in million chained 2012 Canadian dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Industry" .

:YAxis a :Axis ;
    :title "GDP in million chained 2012 Canadian dollars" .

