@prefix : <http://example.org/> .

:Chart a :AreaChart ;
    :title "Average daily time spent watching TV per individual in the United Kingdom from 2010 to 2019 , by gender (in minutes)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Women" .

:dataPoint1 a :dataPoint ;
    :xValue "Dec 31, 2009" ;
    :yValue "259" ;
    :belongsTo :Chart .

:dataPoint2 a :dataPoint ;
    :xValue "Dec 31, 2010" ;
    :yValue "258" ;
    :belongsTo :Chart .

:dataPoint3 a :dataPoint ;
    :xValue "Dec 31, 2011" ;
    :yValue "255" ;
    :belongsTo :Chart .

:dataPoint4 a :dataPoint ;
    :xValue "Dec 31, 2012" ;
    :yValue "247" ;
    :belongsTo :Chart .

:dataPoint5 a :dataPoint ;
    :xValue "Dec 31, 2013" ;
    :yValue "235" ;
    :belongsTo :Chart .

:dataPoint6 a :dataPoint ;
    :xValue "Dec 31, 2014" ;
    :yValue "232" ;
    :belongsTo :Chart .

:dataPoint7 a :dataPoint ;
    :xValue "Dec 31, 2015" ;
    :yValue "227" ;
    :belongsTo :Chart .

:dataPoint8 a :dataPoint ;
    :xValue "Dec 31, 2016" ;
    :yValue "220" ;
    :belongsTo :Chart .

:dataPoint9 a :dataPoint ;
    :xValue "Dec 31, 2017" ;
    :yValue "207" ;
    :belongsTo :Chart .

:dataPoint10 a :dataPoint ;
    :xValue "Dec 31, 2018" ;
    :yValue "196" ;
    :belongsTo :Chart .
