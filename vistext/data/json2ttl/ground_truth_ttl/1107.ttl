@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Number of fatalities in road traffic accidents in Finland in 2019 , by region" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Number of fatalities" .

:YAxis a :Axis ;
    :title "region of Finland" .

:dataPoint1 a :dataPoint ;
    :xValue "36" ;
    :yValue "Uusimaa" ;
    :belongsTo :Chart .

