@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Distribution of coronavirus (COVID-19) cases in the Netherlands as of December 15 , 2020 , by age group" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "Share of cases" .

