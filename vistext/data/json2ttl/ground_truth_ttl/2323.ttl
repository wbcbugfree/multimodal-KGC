@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Distribution of coronavirus (COVID-19) cases in the Netherlands as of December 15 , 2020 , by age group" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "Share of cases" .

:DataPoint1 a :DataPoint ;
    :xValue "0 - 4 years old" ;
    :yValue "0.002" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "5 - 9 years old" ;
    :yValue "0.007" ;
    :belongsTo :Chart .

