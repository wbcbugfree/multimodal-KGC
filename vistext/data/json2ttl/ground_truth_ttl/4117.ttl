@prefix : <http://example.org/> .

:Chart a :LineChart ;
    :title "Number of births in Italy from 2010 to 2019" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Number of births" .

:dataPoint1 a :dataPoint ;
    :xValue "Dec 31, 2009" ;
    :yValue "549794" ;
    :belongsTo :Chart .

