    :belongsTo :Chart .

:DataPoint14 a :DataPoint ;
    :xValue "Musicals" ;
    :yValue "0.49" ;
    :belongsTo :Chart .

:DataPoint15 a :DataPoint ;
    :xValue "Horror" ;
