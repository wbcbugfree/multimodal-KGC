@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Most popular movie genres among adults in the United States as of December 2018 , by ethnicity" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "Hispanic" .

:DataPoint1 a :DataPoint ;
    :xValue "Comedy" ;
    :yValue "0.85" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Adventure" ;
    :yValue "0.84" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "Action" ;
    :yValue "0.87" ;
    :belongsTo :Chart .

