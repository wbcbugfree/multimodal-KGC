@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Most popular movie genres among adults in the United States as of December 2018 , by ethnicity" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "Hispanic" .

:dataPoint1 a :dataPoint ;
    :xValue "Comedy" ;
    :yValue "0.85" ;
    :belongsTo :Chart .

