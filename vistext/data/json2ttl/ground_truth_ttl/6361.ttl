    :yValue "0.81" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Documentary" ;
    :yValue "0.71" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Romantic comedy" ;
    :yValue "0.66" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
