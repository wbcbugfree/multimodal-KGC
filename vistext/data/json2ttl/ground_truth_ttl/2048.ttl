@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Leading life insurance companies ranked by total gross premium income in Ireland in 2018 (in 1,000 euros)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Gross premium income in thousand euros" .

:YAxis a :Axis ;
    :title "Life Insurance Company" .

