@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Share of households owning pets by type and region in the United Kingdom (UK) from 2016 to 2019" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Cats" .

:YAxis a :Axis ;
    :title "region in the United Kingdom" .

:dataPoint1 a :dataPoint ;
    :xValue "0.15" ;
    :yValue "North East" ;
    :belongsTo :Chart .

:dataPoint2 a :dataPoint ;
    :xValue "0.17" ;
    :yValue "North West" ;
    :belongsTo :Chart .

:dataPoint3 a :dataPoint ;
    :xValue "0.16" ;
    :yValue "Yorks&Humber" ;
    :belongsTo :Chart .

:dataPoint4 a :dataPoint ;
    :xValue "0.19" ;
    :yValue "East Midlands" ;
    :belongsTo :Chart .

:dataPoint5 a :dataPoint ;
    :xValue "0.18" ;
    :yValue "West Midlands" ;
    :belongsTo :Chart .

:dataPoint6 a :dataPoint ;
    :xValue "0.18" ;
    :yValue "East of England" ;
    :belongsTo :Chart .

:dataPoint7 a :dataPoint ;
    :xValue "0.14" ;
    :yValue "London" ;
    :belongsTo :Chart .

:dataPoint8 a :dataPoint ;
    :xValue "0.2" ;
    :yValue "South East" ;
    :belongsTo :Chart .

:dataPoint9 a :dataPoint ;
    :xValue "0.21" ;
    :yValue "South West" ;
    :belongsTo :Chart .

:dataPoint10 a :dataPoint ;
    :xValue "0.18" ;
    :yValue "Wales" ;
    :belongsTo :Chart .

:dataPoint11 a :dataPoint ;
    :xValue "0.14" ;
    :yValue "Scotland" ;
    :belongsTo :Chart .

:dataPoint12 a :dataPoint ;
    :xValue "0.12" ;
    :yValue "Northern Ireland" ;
    :belongsTo :Chart .
