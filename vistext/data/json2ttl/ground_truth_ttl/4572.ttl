@prefix : <http://example.org/> .

:Chart a :LineChart ;
    :title "Revenue of Bombardier from FY 2007 to FY 2018 (in billion U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Revenue in billion U.S. dollars" .

:dataPoint1 a :dataPoint ;
    :xValue "Dec 31, 2006" ;
    :yValue "14.9" ;
    :belongsTo :Chart .

:dataPoint2 a :dataPoint ;
    :xValue "Dec 31, 2007" ;
    :yValue "17.5" ;
    :belongsTo :Chart .

:dataPoint3 a :dataPoint ;
    :xValue "Dec 31, 2008" ;
    :yValue "19.7" ;
    :belongsTo :Chart .

:dataPoint4 a :dataPoint ;
    :xValue "Dec 31, 2009" ;
    :yValue "19.4" ;
    :belongsTo :Chart .

:dataPoint5 a :dataPoint ;
    :xValue "Dec 31, 2010" ;
    :yValue "17.9" ;
    :belongsTo :Chart .

:dataPoint6 a :dataPoint ;
    :xValue "Dec 31, 2011" ;
    :yValue "16.4" ;
    :belongsTo :Chart .

:dataPoint7 a :dataPoint ;
    :xValue "Dec 31, 2012" ;
    :yValue "18.1" ;
    :belongsTo :Chart .

:dataPoint8 a :dataPoint ;
    :xValue "Dec 31, 2013" ;
    :yValue "20.1" ;
    :belongsTo :Chart .

:dataPoint9 a :dataPoint ;
    :xValue "Dec 31, 2014" ;
