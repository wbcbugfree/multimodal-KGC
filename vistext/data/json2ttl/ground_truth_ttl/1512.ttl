@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Top 10 most expensive conditions in U.S. hospitals with an expected payer of Medicare in 2017 (in million U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Conditions" .

:YAxis a :Axis ;
    :title "Costs in million U.S. dollars" .

:dataPoint1 a :dataPoint ;
    :xValue "Septicemia" ;
    :yValue "22795" ;
    :belongsTo :Chart .

:dataPoint2 a :dataPoint ;
    :xValue "Osteoarthritis" ;
    :yValue "11290" ;
    :belongsTo :Chart .

:dataPoint3 a :dataPoint ;
    :xValue "Heart failure" ;
    :yValue "9397" ;
    :belongsTo :Chart .

:dataPoint4 a :dataPoint ;
    :xValue "Acute myocardial infarction" ;
    :yValue "8007" ;
    :belongsTo :Chart .

:dataPoint5 a :dataPoint ;
    :xValue "Spondylopathies/spondyloarthropathy (including infective)" ;
    :yValue "5791" ;
    :belongsTo :Chart .

:dataPoint6 a :dataPoint ;
    :xValue "Respiratory failure" ;
    :yValue "5182" ;
    :belongsTo :Chart .

:dataPoint7 a :dataPoint ;
    :xValue "Coronary atherosclerosis and other heart disease" ;
    :yValue "5066" ;
    :belongsTo :Chart .

:dataPoint8 a :dataPoint ;
    :xValue "Chronic obstructive pulmonary disease and bronchiectasis" ;
    :yValue "4981" ;
    :belongsTo :Chart .

:dataPoint9 a :dataPoint ;
    :xValue "Cardiac dysrhythmias" ;
    :yValue "4764" ;
    :belongsTo :Chart .

:dataPoint10 a :dataPoint ;
    :xValue "Cerebral infarction" ;
    :yValue "4607" ;
    :belongsTo :Chart .
