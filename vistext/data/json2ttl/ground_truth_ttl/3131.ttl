@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "What types of products did you buy online during the coronavirus (COVID-19) pandemic in Romania ?" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Share of respondents" .

:YAxis a :Axis ;
    :title "Response" .

:dataPoint1 a :dataPoint ;
    :xValue "0.81" ;
    :yValue "Household appliances" ;
    :belongsTo :Chart .

:dataPoint2 a :dataPoint ;
    :xValue "0.71" ;
    :yValue "Clothing and accessories" ;
    :belongsTo :Chart .

:dataPoint3 a :dataPoint ;
    :xValue "0.67" ;
    :yValue "Shoes" ;
    :belongsTo :Chart .

:dataPoint4 a :dataPoint ;
    :xValue "0.57" ;
    :yValue "Household maintenance products" ;
    :belongsTo :Chart .

:dataPoint5 a :dataPoint ;
    :xValue "0.5" ;
    :yValue "Cosmetics" ;
    :belongsTo :Chart .

:dataPoint6 a :dataPoint ;
    :xValue "0.48" ;
    :yValue "Books" ;
    :belongsTo :Chart .

:dataPoint7 a :dataPoint ;
    :xValue "0.45" ;
    :yValue "Products for car maitenance" ;
    :belongsTo :Chart .

:dataPoint8 a :dataPoint ;
    :xValue "0.39" ;
    :yValue "Holiday tickets/ accomodation/ flights" ;
    :belongsTo :Chart .

:dataPoint9 a :dataPoint ;
    :xValue "0.37" ;
    :yValue "Furniture" ;
    :belongsTo :Chart .

:dataPoint10 a :dataPoint ;
    :xValue "0.32" ;
    :yValue "Tickets for events/ shows" ;
    :belongsTo :Chart .

:dataPoint11 a :dataPoint ;
    :xValue "0.25" ;
    :yValue "Medicine" ;
    :belongsTo :Chart .
