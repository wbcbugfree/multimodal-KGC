@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Turkey : Development of short-term annual interest rate from 2009 to 2018" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Short-term annual interest rate" .

:dataPoint1 a :dataPoint ;
    :xValue "2018*" ;
    :yValue "0.0833" ;
    :belongsTo :Chart .

:dataPoint2 a :dataPoint ;
    :xValue "2017*" ;
    :yValue "0.0888" ;
    :belongsTo :Chart .

:dataPoint3 a :dataPoint ;
    :xValue "2016" ;
    :yValue "0.1023" ;
    :belongsTo :Chart .

:dataPoint4 a :dataPoint ;
    :xValue "2015" ;
    :yValue "0.1095" ;
    :belongsTo :Chart .

:dataPoint5 a :dataPoint ;
    :xValue "2014" ;
    :yValue "0.1033" ;
    :belongsTo :Chart .

:dataPoint6 a :dataPoint ;
    :xValue "2013" ;
    :yValue "0.0693" ;
    :belongsTo :Chart .

:dataPoint7 a :dataPoint ;
    :xValue "2012" ;
    :yValue "0.0885" ;
    :belongsTo :Chart .

:dataPoint8 a :dataPoint ;
    :xValue "2011" ;
    :yValue "0.0876" ;
    :belongsTo :Chart .

:dataPoint9 a :dataPoint ;
    :xValue "2010" ;
    :yValue "0.0761" ;
    :belongsTo :Chart .

:dataPoint10 a :dataPoint ;
    :xValue "2009" ;
    :yValue "0.1014" ;
    :belongsTo :Chart .
