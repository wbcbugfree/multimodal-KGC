@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Leading fashion brands with the most Facebook fans as of October 2020 (in millions)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "brand" .

:YAxis a :Axis ;
    :title "Number of fans in millions" .

:dataPoint1 a :dataPoint ;
    :xValue "Louis Vuitton" ;
    :yValue "23.8" ;
    :belongsTo :Chart .

:dataPoint2 a :dataPoint ;
    :xValue "Dior" ;
    :yValue "17.27" ;
    :belongsTo :Chart .

:dataPoint3 a :dataPoint ;
    :xValue "Chalany High Heels" ;
    :yValue "14.58" ;
    :belongsTo :Chart .

:dataPoint4 a :dataPoint ;
    :xValue "Pit Bull Jeans" ;
    :yValue "11.99" ;
    :belongsTo :Chart .

:dataPoint5 a :dataPoint ;
    :xValue "Mango" ;
    :yValue "11.51" ;
    :belongsTo :Chart .

:dataPoint6 a :dataPoint ;
    :xValue "Fastrack" ;
    :yValue "8.86" ;
    :belongsTo :Chart .

:dataPoint7 a :dataPoint ;
    :xValue "BOSS" ;
    :yValue "8.46" ;
    :belongsTo :Chart .

:dataPoint8 a :dataPoint ;
    :xValue "ROLEX" ;
    :yValue "7.44" ;
    :belongsTo :Chart .

:dataPoint9 a :dataPoint ;
    :xValue "Prada" ;
    :yValue "6.96" ;
    :belongsTo :Chart .

:dataPoint10 a :dataPoint ;
    :xValue "Amore Mio" ;
    :yValue "6.43" ;
    :belongsTo :Chart .
