@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Number of employees in U.S. and European medical technology companies from 2009 to 2019" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Combined" .

:YAxis a :Axis ;
    :title "Year" .

:dataPoint1 a :dataPoint ;
    :xValue "912300" ;
    :yValue "2019**" ;
    :belongsTo :Chart .

:dataPoint2 a :dataPoint ;
    :xValue "838900" ;
    :yValue "2018**" ;
    :belongsTo :Chart .

:dataPoint3 a :dataPoint ;
    :xValue "809700" ;
    :yValue "2017**" ;
    :belongsTo :Chart .
