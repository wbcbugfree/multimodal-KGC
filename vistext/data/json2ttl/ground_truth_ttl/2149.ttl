@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Leading stock life and health insurance companies in the United States in 2019 , by revenue (in billion U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Revenue in billion U.S. dollars" .

:YAxis a :Axis ;
    :title "company" .

:dataPoint1 a :dataPoint ;
    :xValue "69.62" ;
    :yValue "MetLife" ;
    :belongsTo :Chart .

