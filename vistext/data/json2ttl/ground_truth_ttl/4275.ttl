    :xValue "13.59" ;
    :yValue "Japan" ;
    :belongsTo :Chart .

:dataPoint4 a :dataPoint ;
    :xValue "12.14" ;
    :yValue "Germany" ;
    :belongsTo :Chart .

:dataPoint5 a :dataPoint ;
    :xValue "9.09" ;
    :yValue "Belgium" ;
    :belongsTo :Chart .

:dataPoint6 a :dataPoint ;
    :xValue "8.38" ;
    :yValue "Australia" ;
    :belongsTo :Chart .

:dataPoint7 a :dataPoint ;
    :xValue "7.36" ;
    :yValue "Italy" ;
    :belongsTo :Chart .

:dataPoint8 a :dataPoint ;
    :xValue "5.78" ;
    :yValue "Switzerland" ;
    :belongsTo :Chart .

:dataPoint9 a :dataPoint ;
    :xValue "4.65" ;
