@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Leading ten markets for the export of champagne from France in 2018 (in millions of 75 cl . bottles)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Number of bottles in millions" .

:YAxis a :Axis ;
    :title "Country" .

:dataPoint1 a :dataPoint ;
    :xValue "26.76" ;
    :yValue "United Kingdom" ;
    :belongsTo :Chart .

