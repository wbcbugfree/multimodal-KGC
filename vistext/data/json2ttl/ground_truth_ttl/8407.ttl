@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Market share of the 15 leading insurance companies in Belgium from 2015 to 2019" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
