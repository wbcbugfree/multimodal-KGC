@prefix : <http://example.org/> .

:Chart a :LineChart ;
    :title "Ratio of pupils to teachers in Finland from 2003 to 2012" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Pupils per teacher" .

:dataPoint1 a :dataPoint ;
    :xValue "Dec 31, 2002" ;
    :yValue "14.3" ;
    :belongsTo :Chart .

:dataPoint2 a :dataPoint ;
    :xValue "Dec 31, 2003" ;
    :yValue "14.3" ;
    :belongsTo :Chart .

:dataPoint3 a :dataPoint ;
    :xValue "Dec 31, 2004" ;
    :yValue "14.7" ;
    :belongsTo :Chart .

:dataPoint4 a :dataPoint ;
    :xValue "Dec 31, 2005" ;
    :yValue "13.7" ;
    :belongsTo :Chart .

:dataPoint5 a :dataPoint ;
    :xValue "Dec 31, 2006" ;
    :yValue "13.8" ;
    :belongsTo :Chart .

:dataPoint6 a :dataPoint ;
    :xValue "Dec 31, 2007" ;
    :yValue "13.9" ;
    :belongsTo :Chart .

:dataPoint7 a :dataPoint ;
    :xValue "Dec 31, 2008" ;
    :yValue "13.6" ;
    :belongsTo :Chart .

:dataPoint8 a :dataPoint ;
    :xValue "Dec 31, 2009" ;
    :yValue "13.8" ;
    :belongsTo :Chart .

:dataPoint9 a :dataPoint ;
    :xValue "Dec 31, 2010" ;
    :yValue "13.3" ;
    :belongsTo :Chart .

:dataPoint10 a :dataPoint ;
    :xValue "Dec 31, 2011" ;
    :yValue "13.1" ;
    :belongsTo :Chart .
