@prefix : <http://example.org/> .

:Chart a :LineChart ;
    :title "Percentage of new Hispanic directors on Fortune 500 boards from 2009 to 2019" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "Percentage of Hispanic directors" .

:dataPoint1 a :dataPoint ;
    :xValue "Dec 31, 2008" ;
    :yValue "0.051" ;
    :belongsTo :Chart .

