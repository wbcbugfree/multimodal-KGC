@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Most viewed films at movie theaters in Argentina in 2018 (in million tickets sold)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Most viewed films" .

:YAxis a :Axis ;
    :title "Number of tickets sold in millions" .

:dataPoint1 a :dataPoint ;
    :xValue "Incredibles" ;
    :yValue "2" ;
    :belongsTo :Chart .

:dataPoint2 a :dataPoint ;
    :xValue "Coco" ;
    :yValue "3.2" ;
    :belongsTo :Chart .

:dataPoint3 a :dataPoint ;
    :xValue "Avengers:" ;
    :yValue "Infinity" ;
    :belongsTo :Chart .

:dataPoint4 a :dataPoint ;
    :xValue "War" ;
    :yValue "2.92" ;
    :belongsTo :Chart .

:dataPoint5 a :dataPoint ;
    :xValue "Hotel Transylvania" ;
    :yValue "2.57" ;
    :belongsTo :Chart .

:dataPoint6 a :dataPoint ;
    :xValue "Jurassic World: Fallen Kingdom" ;
    :yValue "2.36" ;
    :belongsTo :Chart .

:dataPoint7 a :dataPoint ;
    :xValue "Bohemian Rapsody" ;
    :yValue "1.45" ;
    :belongsTo :Chart .

:dataPoint8 a :dataPoint ;
    :xValue "El Ángel" ;
    :yValue "1.36" ;
    :belongsTo :Chart .

:dataPoint9 a :dataPoint ;
    :xValue "Jumanji: Welcome to the Jungle" ;
    :yValue "1.34" ;
    :belongsTo :Chart .

:dataPoint10 a :dataPoint ;
    :xValue "The Nun" ;
    :yValue "1.17" ;
    :belongsTo :Chart .

:dataPoint11 a :dataPoint ;
    :xValue "Deadpool" ;
    :yValue "2" ;
    :belongsTo :Chart .
