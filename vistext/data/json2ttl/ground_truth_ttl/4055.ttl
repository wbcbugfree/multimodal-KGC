@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "How influential are the following shopping experiences in leading you to switch brands or companies ?" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Share of respondents" .

:YAxis a :Axis ;
    :title "Response" .

:DataPoint1 a :DataPoint ;
    :xValue "0.23" ;
    :yValue "Difficult return/refund policies" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "0.22" ;
    :yValue "Irresponsive to requests/complaints" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "0.22" ;
    :yValue "Bad services at the store/outlet" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "0.21" ;
    :yValue "Non-competitive pricing" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "0.21" ;
    :yValue "Incorrect billing" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "0.19" ;
    :yValue "Products/services not meeting my needs" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "0.19" ;
    :yValue "Mistake on purchase" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "0.18" ;
    :yValue "Bad online services" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "0.13" ;
    :yValue "Difficult to locate products/services" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "0.09" ;
    :yValue "Non-personalised communications" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "0.08" ;
    :yValue "Bad mobile app" ;
    :belongsTo :Chart .
