@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "How influential are the following shopping experiences in leading you to switch brands or companies ?" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Share of respondents" .

:YAxis a :Axis ;
    :title "Response" .

:dataPoint1 a :dataPoint ;
    :xValue "0.23" ;
    :yValue "Difficult return/refund policies" ;
    :belongsTo :Chart .

:dataPoint2 a :dataPoint ;
    :xValue "0.22" ;
    :yValue "Irresponsive to requests/complaints" ;
    :belongsTo :Chart .

:dataPoint3 a :dataPoint ;
    :xValue "0.22" ;
    :yValue "Bad services at the store/outlet" ;
    :belongsTo :Chart .

:dataPoint4 a :dataPoint ;
    :xValue "0.21" ;
    :yValue "Non-competitive pricing" ;
    :belongsTo :Chart .

:dataPoint5 a :dataPoint ;
    :xValue "0.21" ;
    :yValue "Incorrect billing" ;
    :belongsTo :Chart .

:dataPoint6 a :dataPoint ;
    :xValue "0.19" ;
    :yValue "Products/services not meeting my needs" ;
    :belongsTo :Chart .

:dataPoint7 a :dataPoint ;
    :xValue "0.19" ;
    :yValue "Mistake on purchase" ;
    :belongsTo :Chart .

:dataPoint8 a :dataPoint ;
    :xValue "0.18" ;
    :yValue "Bad online services" ;
    :belongsTo :Chart .

:dataPoint9 a :dataPoint ;
    :xValue "0.13" ;
    :yValue "Difficult to locate products/services" ;
    :belongsTo :Chart .

:dataPoint10 a :dataPoint ;
    :xValue "0.09" ;
    :yValue "Non-personalised communications" ;
    :belongsTo :Chart .

:dataPoint11 a :dataPoint ;
    :xValue "0.08" ;
    :yValue "Bad mobile app" ;
    :belongsTo :Chart .
