@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Average weekly work hours of male vs. female physicians in Canada as of 2019 , by activity" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "activity" .

:YAxis a :Axis ;
    :title "Female" .

:dataPoint1 a :dataPoint ;
    :xValue "Direct patient care without a teaching component" ;
    :yValue "24.03" ;
    :belongsTo :Chart .

:dataPoint2 a :dataPoint ;
    :xValue "Direct patient care with a teaching component" ;
    :yValue "5.57" ;
    :belongsTo :Chart .

:dataPoint3 a :dataPoint ;
    :xValue "Teaching/educating without direct patient care" ;
    :yValue "1.36" ;
    :belongsTo :Chart .

:dataPoint4 a :dataPoint ;
    :xValue "Indirect patient care" ;
    :yValue "8.57" ;
    :belongsTo :Chart .

:dataPoint5 a :dataPoint ;
    :xValue "Health facility committees" ;
    :yValue "0.88" ;
    :belongsTo :Chart .

:dataPoint6 a :dataPoint ;
    :xValue "Administration" ;
    :yValue "2.37" ;
    :belongsTo :Chart .

:dataPoint7 a :dataPoint ;
    :xValue "Research" ;
    :yValue "1.2" ;
    :belongsTo :Chart .

:dataPoint8 a :dataPoint ;
    :xValue "Managing practice" ;
    :yValue "1.33" ;
    :belongsTo :Chart .

:dataPoint9 a :dataPoint ;
    :xValue "CME/CPD" ;
    :yValue "2.38" ;
    :belongsTo :Chart .

:dataPoint10 a :dataPoint ;
    :xValue "Other activities" ;
    :yValue "0.5" ;
    :belongsTo :Chart .

:dataPoint11 a :dataPoint ;
    :xValue "Total hours" ;
    :yValue "48.19" ;
    :belongsTo :Chart .
