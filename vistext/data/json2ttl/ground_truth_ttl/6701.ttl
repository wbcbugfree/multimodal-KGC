@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Number of bankruptcies after the coronavirus outbreak in Sweden from February to November 2020 , by industry" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Wholesale" .

:YAxis a :Axis ;
    :title "Month" .

:dataPoint1 a :dataPoint ;
    :xValue "29" ;
    :yValue "Feb" ;
    :belongsTo :Chart .

:dataPoint2 a :dataPoint ;
    :xValue "41" ;
    :yValue "Mar" ;
    :belongsTo :Chart .

:dataPoint3 a :dataPoint ;
    :xValue "55" ;
    :yValue "Apr" ;
    :belongsTo :Chart .

:dataPoint4 a :dataPoint ;
    :xValue "43" ;
    :yValue "May" ;
    :belongsTo :Chart .

:dataPoint5 a :dataPoint ;
    :xValue "33" ;
    :yValue "Jun" ;
    :belongsTo :Chart .

:dataPoint6 a :dataPoint ;
    :xValue "37" ;
    :yValue "Jul" ;
    :belongsTo :Chart .

:dataPoint7 a :dataPoint ;
    :xValue "24" ;
    :yValue "Aug" ;
    :belongsTo :Chart .

:dataPoint8 a :dataPoint ;
    :xValue "24" ;
    :yValue "Sep" ;
    :belongsTo :Chart .

:dataPoint9 a :dataPoint ;
    :xValue "29" ;
    :yValue "Oct" ;
    :belongsTo :Chart .

:dataPoint10 a :dataPoint ;
    :xValue "37" ;
    :yValue "Nov" ;
    :belongsTo :Chart .
