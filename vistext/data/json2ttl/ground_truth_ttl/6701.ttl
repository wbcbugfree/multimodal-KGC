@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Number of bankruptcies after the coronavirus outbreak in Sweden from February to November 2020 , by industry" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Wholesale" .

:YAxis a :Axis ;
    :title "Month" .

:DataPoint1 a :DataPoint ;
    :xValue "29" ;
    :yValue "Feb 41 Mar 55 Apr 43 May 33 Jun 37 Jul 24 Aug 24 Sep 29 Oct 37 Nov" ;
    :belongsTo :Chart .
