@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Religion affiliation in Chile as of 2018 , by type" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "Share of respondents" .

:dataPoint1 a :dataPoint ;
    :xValue "Catholic" ;
    :yValue "0.552" ;
    :belongsTo :Chart .

:dataPoint2 a :dataPoint ;
    :xValue "Evangelist (unspecified)" ;
    :yValue "0.125" ;
    :belongsTo :Chart .

:dataPoint3 a :dataPoint ;
    :xValue "Mormon" ;
    :yValue "0.014" ;
    :belongsTo :Chart .

:dataPoint4 a :dataPoint ;
    :xValue "Jehova's witness" ;
    :yValue "0.008" ;
    :belongsTo :Chart .

:dataPoint5 a :dataPoint ;
    :xValue "Adventist" ;
    :yValue "0.004" ;
    :belongsTo :Chart .

:dataPoint6 a :dataPoint ;
    :xValue "Afroamerican cults, Umbanda, etc." ;
    :yValue "0.001" ;
    :belongsTo :Chart .

:dataPoint7 a :dataPoint ;
    :xValue "Jewish" ;
    :yValue "0.001" ;
    :belongsTo :Chart .

:dataPoint8 a :dataPoint ;
    :xValue "Protestant" ;
    :yValue "0.001" ;
    :belongsTo :Chart .

:dataPoint9 a :dataPoint ;
    :xValue "Other" ;
    :yValue "0.005" ;
    :belongsTo :Chart .

:dataPoint10 a :dataPoint ;
    :xValue "Believer without formal affiliation to any religion" ;
    :yValue "0.002" ;
    :belongsTo :Chart .

:dataPoint11 a :dataPoint ;
    :xValue "None" ;
    :yValue "0.286" ;
    :belongsTo :Chart .

:dataPoint12 a :dataPoint ;
    :xValue "Atheist" ;
    :yValue "0.004" ;
    :belongsTo :Chart .

:dataPoint13 a :dataPoint ;
    :xValue "No answer" ;
    :yValue "0.009" ;
    :belongsTo :Chart .

:dataPoint14 a :dataPoint ;
    :xValue "Does not know" ;
    :yValue "0.001" ;
    :belongsTo :Chart .
