@prefix : <http://example.org/> .

:Chart a :LineChart ;
    :title "Pemex 's natural gas production from 2008 to 2019 (in million cubic feet per day)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Production in million cubic feet per day" .

:dataPoint1 a :dataPoint ;
    :xValue "Dec 31, 2007" ;
    :yValue "6919" ;
    :belongsTo :Chart .

:dataPoint2 a :dataPoint ;
    :xValue "Dec 31, 2008" ;
    :yValue "7031" ;
    :belongsTo :Chart .

:dataPoint3 a :dataPoint ;
    :xValue "Dec 31, 2009" ;
    :yValue "7020" ;
    :belongsTo :Chart .

:dataPoint4 a :dataPoint ;
    :xValue "Dec 31, 2010" ;
    :yValue "6594" ;
    :belongsTo :Chart .

:dataPoint5 a :dataPoint ;
    :xValue "Dec 31, 2011" ;
    :yValue "6385" ;
    :belongsTo :Chart .

:dataPoint6 a :dataPoint ;
    :xValue "Dec 31, 2012" ;
    :yValue "6370" ;
    :belongsTo :Chart .

:dataPoint7 a :dataPoint ;
    :xValue "Dec 31, 2013" ;
    :yValue "6532" ;
    :belongsTo :Chart .

:dataPoint8 a :dataPoint ;
    :xValue "Dec 31, 2014" ;
    :yValue "6401" ;
    :belongsTo :Chart .

:dataPoint9 a :dataPoint ;
    :xValue "Dec 31, 2015" ;
    :yValue "5793" ;
    :belongsTo :Chart .

:dataPoint10 a :dataPoint ;
    :xValue "Dec 31, 2016" ;
    :yValue "5068" ;
    :belongsTo :Chart .

:dataPoint11 a :dataPoint ;
    :xValue "Dec 31, 2017" ;
    :yValue "4803" ;
    :belongsTo :Chart .

:dataPoint12 a :dataPoint ;
    :xValue "Dec 31, 2018" ;
    :yValue "4816" ;
    :belongsTo :Chart .
