@prefix : <http://example.org/> .

:Chart a :LineChart ;
    :title "Number of participants in hiking in the United States from 2006 to 2018 (in millions)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Number of participants in millions" .

:dataPoint1 a :dataPoint ;
    :xValue "Dec 31, 2005" ;
    :yValue "29.86" ;
    :belongsTo :Chart .

