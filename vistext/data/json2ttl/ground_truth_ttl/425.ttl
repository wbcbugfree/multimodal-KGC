@prefix : <http://example.org/> .

:Chart a :LineChart ;
    :title "Canada : Degree of urbanization from 2009 to 2019" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "Share of urban population" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2008" ;
    :yValue "0.8076" ;
    :belongsTo :Chart .

