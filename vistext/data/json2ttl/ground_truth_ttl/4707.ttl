    :xValue "2015/16" ;
    :yValue "5887.2" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "2014/15" ;
    :yValue "6034.3" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
