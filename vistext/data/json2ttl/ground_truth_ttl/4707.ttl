@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Number of average available hospital beds in Northern Ireland from 2009 to 2020" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Number of average available hospital beds" .

:dataPoint1 a :dataPoint ;
    :xValue "2019/20" ;
    :yValue "5779.8" ;
    :belongsTo :Chart .

:dataPoint2 a :dataPoint ;
    :xValue "2018/19" ;
    :yValue "5830.4" ;
    :belongsTo :Chart .

