@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Number of dentists employed in Norway from 2000 to 2019" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Number of employees" .

