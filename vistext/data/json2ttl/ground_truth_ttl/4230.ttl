@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Value of handicrafts exported from Indian between financial year 2011 and 2020 (in billion Indian rupees)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Export value in billion Indian rupees" .

:YAxis a :Axis ;
    :title "Financial year" .

:dataPoint1 a :dataPoint ;
    :xValue "126.57" ;
    :yValue "FY 2020" ;
    :belongsTo :Chart .

:dataPoint2 a :dataPoint ;
    :xValue "128.35" ;
    :yValue "FY 2019" ;
    :belongsTo :Chart .

:dataPoint3 a :dataPoint ;
    :xValue "117.54" ;
    :yValue "FY 2018" ;
    :belongsTo :Chart .

:dataPoint4 a :dataPoint ;
    :xValue "129.2" ;
    :yValue "FY 2017" ;
    :belongsTo :Chart .

:dataPoint5 a :dataPoint ;
    :xValue "108" ;
    :yValue "FY 2016" ;
    :belongsTo :Chart .

:dataPoint6 a :dataPoint ;
    :xValue "84.26" ;
    :yValue "FY 2015" ;
    :belongsTo :Chart .

:dataPoint7 a :dataPoint ;
    :xValue "91.3" ;
    :yValue "FY 2014" ;
    :belongsTo :Chart .

:dataPoint8 a :dataPoint ;
    :xValue "53.77" ;
    :yValue "FY 2013" ;
    :belongsTo :Chart .

:dataPoint9 a :dataPoint ;
    :xValue "47.61" ;
    :yValue "FY 2012" ;
    :belongsTo :Chart .

:dataPoint10 a :dataPoint ;
    :xValue "34.63" ;
    :yValue "FY 2011" ;
    :belongsTo :Chart .
