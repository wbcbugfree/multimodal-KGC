@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Average number of search terms for online search queries in Canada as of January 2020" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "Share of searches" .

:dataPoint1 a :dataPoint ;
    :xValue "One word" ;
    :yValue "0.191" ;
    :belongsTo :Chart .

:dataPoint2 a :dataPoint ;
    :xValue "Two words" ;
    :yValue "0.4562" ;
    :belongsTo :Chart .

:dataPoint3 a :dataPoint ;
    :xValue "Three words" ;
    :yValue "0.2184" ;
    :belongsTo :Chart .

:dataPoint4 a :dataPoint ;
    :xValue "Four words" ;
    :yValue "0.072" ;
    :belongsTo :Chart .

:dataPoint5 a :dataPoint ;
    :xValue "Five words" ;
    :yValue "0.0318" ;
    :belongsTo :Chart .

:dataPoint6 a :dataPoint ;
    :xValue "Six words" ;
    :yValue "0.0146" ;
    :belongsTo :Chart .

:dataPoint7 a :dataPoint ;
    :xValue "Seven words" ;
    :yValue "0.0073" ;
    :belongsTo :Chart .

:dataPoint8 a :dataPoint ;
    :xValue "Eight words" ;
    :yValue "0.0039" ;
    :belongsTo :Chart .

:dataPoint9 a :dataPoint ;
    :xValue "Nine words" ;
    :yValue "0.0021" ;
    :belongsTo :Chart .

:dataPoint10 a :dataPoint ;
    :xValue "Ten or more words" ;
    :yValue "0.0027" ;
    :belongsTo :Chart .
