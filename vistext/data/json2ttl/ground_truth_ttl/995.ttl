@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Fastest growing food and beverage companies in Canada between 2016 and 2017" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year-over-year sales growth" .

:YAxis a :Axis ;
    :title "business" .

:dataPoint1 a :dataPoint ;
    :xValue "0.451" ;
    :yValue "Cott Corporation" ;
    :belongsTo :Chart .

