@prefix : <http://example.org/> .

:Chart a :AreaChart ;
    :title "Average weekly attendance for the Church of England from 2009 to 2018 (in 1000 attendees)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Number of attendees (in thousands)" .

:dataPoint1 a :dataPoint ;
    :xValue "Dec 31, 2008" ;
    :yValue "1081.9" ;
    :belongsTo :Chart .

:dataPoint2 a :dataPoint ;
    :xValue "Dec 31, 2009" ;
    :yValue "1062.6" ;
    :belongsTo :Chart .

:dataPoint3 a :dataPoint ;
    :xValue "Dec 31, 2010" ;
    :yValue "1050.3" ;
    :belongsTo :Chart .

:dataPoint4 a :dataPoint ;
    :xValue "Dec 31, 2011" ;
    :yValue "1048.7" ;
    :belongsTo :Chart .

:dataPoint5 a :dataPoint ;
    :xValue "Dec 31, 2012" ;
    :yValue "993.6" ;
    :belongsTo :Chart .

:dataPoint6 a :dataPoint ;
    :xValue "Dec 31, 2013" ;
    :yValue "975.3" ;
    :belongsTo :Chart .

:dataPoint7 a :dataPoint ;
    :xValue "Dec 31, 2014" ;
    :yValue "959.9" ;
    :belongsTo :Chart .

:dataPoint8 a :dataPoint ;
    :xValue "Dec 31, 2015" ;
    :yValue "921.7" ;
    :belongsTo :Chart .

:dataPoint9 a :dataPoint ;
    :xValue "Dec 31, 2016" ;
    :yValue "893.9" ;
    :belongsTo :Chart .

:dataPoint10 a :dataPoint ;
    :xValue "Dec 31, 2017" ;
    :yValue "870.9" ;
    :belongsTo :Chart .
