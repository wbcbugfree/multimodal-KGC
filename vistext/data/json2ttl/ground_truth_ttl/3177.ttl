@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Stress symptoms during the past month reported by U.S. teeneagers in 2013" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "Percentage of respondents" .

:dataPoint1 a :dataPoint ;
    :xValue "Feeling irritable or angry" ;
    :yValue "0.4" ;
    :belongsTo :Chart .

:dataPoint2 a :dataPoint ;
    :xValue "Feeling nervous or anxious" ;
    :yValue "0.36" ;
    :belongsTo :Chart .

:dataPoint3 a :dataPoint ;
    :xValue "Fatigue/feeling tired" ;
    :yValue "0.36" ;
    :belongsTo :Chart .

:dataPoint4 a :dataPoint ;
    :xValue "Lying awake at night" ;
    :yValue "0.35" ;
    :belongsTo :Chart .

:dataPoint5 a :dataPoint ;
    :xValue "Headaches" ;
    :yValue "0.32" ;
    :belongsTo :Chart .

:dataPoint6 a :dataPoint ;
    :xValue "Feeling as though I could cry" ;
    :yValue "0.32" ;
    :belongsTo :Chart .

:dataPoint7 a :dataPoint ;
    :xValue "Feeling overwhelmed" ;
    :yValue "0.31" ;
    :belongsTo :Chart .

:dataPoint8 a :dataPoint ;
    :xValue "Feeling depressed or sad" ;
    :yValue "0.3" ;
    :belongsTo :Chart .

:dataPoint9 a :dataPoint ;
    :xValue "Changes in sleeping habits" ;
    :yValue "0.26" ;
    :belongsTo :Chart .

:dataPoint10 a :dataPoint ;
    :xValue "Skipping a meal" ;
    :yValue "0.23" ;
    :belongsTo :Chart .

:dataPoint11 a :dataPoint ;
    :xValue "Upset stomach or indigestion" ;
    :yValue "0.21" ;
    :belongsTo :Chart .
