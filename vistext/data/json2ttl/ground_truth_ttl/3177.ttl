@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Stress symptoms during the past month reported by U.S. teeneagers in 2013" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "Percentage of respondents" .

:DataPoint1 a :DataPoint ;
    :xValue "Feeling irritable or angry" ;
    :yValue "0.4" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Feeling nervous or anxious" ;
    :yValue "0.36" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "Fatigue/feeling tired" ;
    :yValue "0.36" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "Lying awake at night" ;
    :yValue "0.35" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "Headaches" ;
    :yValue "0.32" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Feeling as though I could cry" ;
    :yValue "0.32" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Feeling overwhelmed" ;
    :yValue "0.31" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Feeling depressed or sad" ;
    :yValue "0.3" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "Changes in sleeping habits" ;
    :yValue "0.26" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "Skipping a meal" ;
    :yValue "0.23" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "Upset stomach or indigestion" ;
    :yValue "0.21" ;
    :belongsTo :Chart .
