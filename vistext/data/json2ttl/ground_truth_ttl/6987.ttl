@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "For which reasons are n't you reading more books at the moment ?" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Yes, somewhat" .

:YAxis a :Axis ;
    :title "Response" .

:DataPoint1 a :DataPoint ;
    :xValue "0.25" ;
    :yValue "You do not have time" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "0.34" ;
    :yValue "You prefer to spend more time doing other leisure ..." ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "0.26" ;
    :yValue "You read other things than books (press, blogs, mu..." ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "0.15" ;
    :yValue "You are not interested in reading more books" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "0.2" ;
    :yValue "Books are too expensive" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "0.13" ;
    :yValue "You do not feel the need to read" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "0.13" ;
    :yValue "You have difficulties finding books that you like" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "0.1" ;
    :yValue "You do not really enjoy reading" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "0.11" ;
    :yValue "You have been disappointed by previous readings" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "0.07" ;
    :yValue "The people around you do not read" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "0.05" ;
    :yValue "You do not have easy access to books (you live far..." ;
    :belongsTo :Chart .

:DataPoint12 a :DataPoint ;
    :xValue "0.04" ;
    :yValue "You feel out of place in bookstores or libraries" ;
    :belongsTo :Chart .

:DataPoint13 a :DataPoint ;
    :xValue "0.03" ;
    :yValue "You are afraid of reading. You feel that you will ..." ;
    :belongsTo :Chart .
