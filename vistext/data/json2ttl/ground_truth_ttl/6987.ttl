@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "For which reasons are n't you reading more books at the moment ?" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Yes, somewhat" .

:YAxis a :Axis ;
    :title "Response" .

:dataPoint1 a :dataPoint ;
    :xValue "0.25" ;
    :yValue "You do not have time" ;
    :belongsTo :Chart .

:dataPoint2 a :dataPoint ;
    :xValue "0.34" ;
    :yValue "You prefer to spend more time doing other leisure activities" ;
    :belongsTo :Chart .

:dataPoint3 a :dataPoint ;
    :xValue "0.26" ;
    :yValue "You read other things than books (press, blogs, multimedia content)" ;
    :belongsTo :Chart .

:dataPoint4 a :dataPoint ;
    :xValue "0.15" ;
    :yValue "You are not interested in reading more books" ;
    :belongsTo :Chart .

:dataPoint5 a :dataPoint ;
    :xValue "0.2" ;
    :yValue "Books are too expensive" ;
    :belongsTo :Chart .

:dataPoint6 a :dataPoint ;
    :xValue "0.13" ;
    :yValue "You do not feel the need to read" ;
    :belongsTo :Chart .

:dataPoint7 a :dataPoint ;
    :xValue "0.13" ;
    :yValue "You have difficulties finding books that you like" ;
    :belongsTo :Chart .

:dataPoint8 a :dataPoint ;
    :xValue "0.1" ;
    :yValue "You do not really enjoy reading" ;
    :belongsTo :Chart .

:dataPoint9 a :dataPoint ;
    :xValue "0.11" ;
    :yValue "You have been disappointed by previous readings" ;
    :belongsTo :Chart .

:dataPoint10 a :dataPoint ;
    :xValue "0.07" ;
    :yValue "The people around you do not read" ;
    :belongsTo :Chart .

:dataPoint11 a :dataPoint ;
    :xValue "0.05" ;
    :yValue "You do not have easy access to books (you live far from a library or a bookstore)" ;
    :belongsTo :Chart .

:dataPoint12 a :dataPoint ;
    :xValue "0.04" ;
    :yValue "You feel out of place in bookstores or libraries" ;
    :belongsTo :Chart .

:dataPoint13 a :dataPoint ;
    :xValue "0.03" ;
    :yValue "You are afraid of reading. You feel that you will not succeed." ;
    :belongsTo :Chart .
