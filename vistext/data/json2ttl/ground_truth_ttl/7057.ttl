@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "The real and nominal value of the federal minimum wage in the United States from 1938 to 2013 , expressed in July 2013 U.S. dollars" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Month" .

:YAxis a :Axis ;
    :title "Statutory minimum wage (nominal $)" .

:DataPoint1 a :DataPoint ;
    :xValue "Sep 30, 1938" ;
    :yValue "0.25" ;
    :belongsTo :Chart .

