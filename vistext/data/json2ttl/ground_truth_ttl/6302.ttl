@prefix : <http://example.org/> .

:Chart a :LineChart ;
    :title "Nike 's North American revenue from 2009 to 2020 , by segment (in million U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Apparel" .

:dataPoint1 a :dataPoint ;
    :xValue "Dec 31, 2008" ;
    :yValue "1740" ;
    :belongsTo :Chart .

