@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Largest groups of immigrants to the Netherlands in 2019 , by nationality" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Country" .

:YAxis a :Axis ;
    :title "Number of people" .

:dataPoint1 a :dataPoint ;
    :xValue "Polish" ;
    :yValue "27045" ;
    :belongsTo :Chart .

