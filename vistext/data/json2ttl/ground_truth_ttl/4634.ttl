@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Number of Zara stores in the Middle East and Africa in 2020 , by country" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Number of stores" .

:YAxis a :Axis ;
    :title "Country" .

