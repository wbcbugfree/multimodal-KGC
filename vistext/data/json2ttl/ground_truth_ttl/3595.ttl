@prefix : <http://example.org/> .

:Chart a :AreaChart ;
    :title "New passenger car sales figures in Slovenia from 2005 to 2019 (in units)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Units sold" .

:dataPoint1 a :dataPoint ;
    :xValue "Dec 31, 2004" ;
    :yValue "59324" ;
    :belongsTo :Chart .

