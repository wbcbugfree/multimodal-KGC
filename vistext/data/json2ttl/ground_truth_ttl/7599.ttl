@prefix : <http://example.org/> .

:Chart a :AreaChart ;
    :title "Household consumption of alcopops in the United Kingdom from 2000 to 2012 , by within and outside of home (in milliliter per person per week)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Within the home" .

:dataPoint1 a :dataPoint ;
    :xValue "Jan 31, 2001" ;
    :yValue "18" ;
    :belongsTo :Chart .

:dataPoint2 a :dataPoint ;
    :xValue "Feb 28, 2002" ;
    :yValue "18" ;
    :belongsTo :Chart .

:dataPoint3 a :dataPoint ;
    :xValue "Mar 31, 2003" ;
    :yValue "19" ;
    :belongsTo :Chart .

:dataPoint4 a :dataPoint ;
    :xValue "Apr 30, 2004" ;
    :yValue "14" ;
    :belongsTo :Chart .

:dataPoint5 a :dataPoint ;
    :xValue "May 31, 2005" ;
    :yValue "11" ;
    :belongsTo :Chart .

:dataPoint6 a :dataPoint ;
    :xValue "Dec 31, 2005" ;
    :yValue "12" ;
    :belongsTo :Chart .

:dataPoint7 a :dataPoint ;
    :xValue "Dec 31, 2006" ;
    :yValue "8" ;
    :belongsTo :Chart .

:dataPoint8 a :dataPoint ;
    :xValue "Dec 31, 2007" ;
    :yValue "8" ;
    :belongsTo :Chart .

:dataPoint9 a :dataPoint ;
    :xValue "Dec 31, 2008" ;
    :yValue "7" ;
    :belongsTo :Chart .

:dataPoint10 a :dataPoint ;
    :xValue "Dec 31, 2009" ;
    :yValue "9" ;
    :belongsTo :Chart .

:dataPoint11 a :dataPoint ;
    :xValue "Dec 31, 2010" ;
    :yValue "9" ;
    :belongsTo :Chart .

:dataPoint12 a :dataPoint ;
    :xValue "Dec 31, 2011" ;
    :yValue "8" ;
    :belongsTo :Chart .
