@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Public sector expenditure on housing and community amenities in the United Kingdom (UK) from 2000/01 to 2018/19 (in billion GBP)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

