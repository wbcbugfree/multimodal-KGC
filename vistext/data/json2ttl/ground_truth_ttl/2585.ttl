@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Fields of study with the most international students in the United States in the academic year 2019/20" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Fields of study" .

:YAxis a :Axis ;
    :title "Number of students" .

:dataPoint1 a :dataPoint ;
    :xValue "Engineering" ;
    :yValue "220542" ;
    :belongsTo :Chart .

