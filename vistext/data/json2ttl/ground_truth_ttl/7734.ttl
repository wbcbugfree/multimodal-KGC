@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Migration flow of foreign nationals in Spain from 2010 to 2019" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Inflow" .

:dataPoint1 a :dataPoint ;
    :xValue "2019*" ;
    :yValue "309874" ;
    :belongsTo :Chart .

:dataPoint2 a :dataPoint ;
    :xValue "2018" ;
    :yValue "559309" ;
    :belongsTo :Chart .

:dataPoint3 a :dataPoint ;
    :xValue "2017" ;
    :yValue "454424" ;
    :belongsTo :Chart .

:dataPoint4 a :dataPoint ;
    :xValue "2016" ;
    :yValue "352174" ;
    :belongsTo :Chart .

:dataPoint5 a :dataPoint ;
    :xValue "2015" ;
    :yValue "290005" ;
    :belongsTo :Chart .

:dataPoint6 a :dataPoint ;
    :xValue "2014" ;
    :yValue "264485" ;
    :belongsTo :Chart .

:dataPoint7 a :dataPoint ;
    :xValue "2013" ;
    :yValue "248350" ;
    :belongsTo :Chart .

:dataPoint8 a :dataPoint ;
    :xValue "2012" ;
    :yValue "272489" ;
    :belongsTo :Chart .

:dataPoint9 a :dataPoint ;
    :xValue "2011" ;
