@prefix : <http://example.org/> .

:Chart a :AreaChart ;
    :title "Number of broadband lines operated by BT Group subsidiaries from 2008 to 2017 (in 1,000)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Openreach" .

:dataPoint1 a :dataPoint ;
    :xValue "Dec 31, 2007" ;
    :yValue "4300" ;
    :belongsTo :Chart .

