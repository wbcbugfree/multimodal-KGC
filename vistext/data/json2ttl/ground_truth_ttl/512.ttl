@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Military expenditure as percentage of gross domestic product (GDP) in highest spending countries 2019" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "Percentage of GDP" .

:DataPoint1 a :DataPoint ;
    :xValue "Saudi Arabia*" ;
    :yValue "0.08" ;
    :belongsTo :Chart .

