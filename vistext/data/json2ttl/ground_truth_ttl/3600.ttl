@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Suriname : National debt in relation to gross domestic product (GDP) from 2015 to 2025" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "National debt in relation to GDP" .

:YAxis a :Axis ;
    :title "Year" .

:dataPoint1 a :dataPoint ;
    :xValue "1.2049" ;
    :yValue "2025*" ;
    :belongsTo :Chart .

:dataPoint2 a :dataPoint ;
    :xValue "1.1647" ;
    :yValue "2024*" ;
    :belongsTo :Chart .

:dataPoint3 a :dataPoint ;
    :xValue "1.1216" ;
    :yValue "2023*" ;
    :belongsTo :Chart .

:dataPoint4 a :dataPoint ;
    :xValue "1.1088" ;
    :yValue "2022*" ;
    :belongsTo :Chart .

:dataPoint5 a :dataPoint ;
    :xValue "1.077" ;
    :yValue "2021*" ;
    :belongsTo :Chart .

:dataPoint6 a :dataPoint ;
    :xValue "1.4527" ;
    :yValue "2020*" ;
    :belongsTo :Chart .

:dataPoint7 a :dataPoint ;
    :xValue "0.823" ;
    :yValue "2019*" ;
    :belongsTo :Chart .

:dataPoint8 a :dataPoint ;
    :xValue "0.7556" ;
    :yValue "2018" ;
    :belongsTo :Chart .

:dataPoint9 a :dataPoint ;
    :xValue "0.7799" ;
    :yValue "2017" ;
    :belongsTo :Chart .

:dataPoint10 a :dataPoint ;
    :xValue "0.7694" ;
    :yValue "2016" ;
    :belongsTo :Chart .

:dataPoint11 a :dataPoint ;
    :xValue "0.4433" ;
    :yValue "2015" ;
    :belongsTo :Chart .
