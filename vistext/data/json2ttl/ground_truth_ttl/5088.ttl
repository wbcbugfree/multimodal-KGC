@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Mortality rate due to coronavirus disease (COVID-19) in selected countries in Latin America and the Caribbean as of January 4 , 2021 (per 100,000 inhabitants)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Number of deaths per 100,000 population" .

:YAxis a :Axis ;
    :title "Country" .

:dataPoint1 a :dataPoint ;
    :xValue "118.08" ;
    :yValue "Peru" ;
    :belongsTo :Chart .

