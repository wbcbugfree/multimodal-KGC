@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Number of road traffic fatalities in Greece from 2006 to 2019" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Number of fatalities" .

:dataPoint1 a :dataPoint ;
    :xValue "2019*" ;
    :yValue "696" ;
    :belongsTo :Chart .

:dataPoint2 a :dataPoint ;
    :xValue "2018" ;
    :yValue "700" ;
    :belongsTo :Chart .

:dataPoint3 a :dataPoint ;
    :xValue "2017" ;
    :yValue "731" ;
    :belongsTo :Chart .

:dataPoint4 a :dataPoint ;
    :xValue "2016" ;
    :yValue "824" ;
    :belongsTo :Chart .

