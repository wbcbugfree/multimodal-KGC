@prefix : <http://example.org/> .

:Chart a :AreaChart ;
    :title "Sales value of retail trade in Sweden from 2008 to 2018 (as index at current prices)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Index (2015=100)" .

:dataPoint1 a :dataPoint ;
    :xValue "Dec 31, 2007" ;
    :yValue "82.6" ;
    :belongsTo :Chart .

:dataPoint2 a :dataPoint ;
    :xValue "Dec 31, 2008" ;
    :yValue "84.5" ;
    :belongsTo :Chart .

:dataPoint3 a :dataPoint ;
    :xValue "Dec 31, 2009" ;
    :yValue "87.7" ;
    :belongsTo :Chart .

:dataPoint4 a :dataPoint ;
    :xValue "Dec 31, 2010" ;
    :yValue "88.3" ;
    :belongsTo :Chart .

:dataPoint5 a :dataPoint ;
    :xValue "Dec 31, 2011" ;
    :yValue "90.1" ;
    :belongsTo :Chart .

:dataPoint6 a :dataPoint ;
    :xValue "Dec 31, 2012" ;
    :yValue "91.9" ;
    :belongsTo :Chart .

:dataPoint7 a :dataPoint ;
    :xValue "Dec 31, 2013" ;
    :yValue "94.5" ;
    :belongsTo :Chart .

:dataPoint8 a :dataPoint ;
    :xValue "Dec 31, 2014" ;
    :yValue "100" ;
    :belongsTo :Chart .

:dataPoint9 a :dataPoint ;
    :xValue "Dec 31, 2015" ;
