@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Turkey : National debt from 2015 to 2025 in relation to gross domestic product (GDP)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "National debt in relation to GDP" .

:dataPoint1 a :dataPoint ;
    :xValue "2025*" ;
    :yValue "0.5038" ;
    :belongsTo :Chart .

:dataPoint2 a :dataPoint ;
    :xValue "2024*" ;
    :yValue "0.4933" ;
    :belongsTo :Chart .

:dataPoint3 a :dataPoint ;
    :xValue "2023*" ;
    :yValue "0.4806" ;
    :belongsTo :Chart .

:dataPoint4 a :dataPoint ;
    :xValue "2022*" ;
    :yValue "0.4734" ;
    :belongsTo :Chart .

:dataPoint5 a :dataPoint ;
    :xValue "2021*" ;
    :yValue "0.4552" ;
    :belongsTo :Chart .

:dataPoint6 a :dataPoint ;
    :xValue "2020*" ;
    :yValue "0.4167" ;
    :belongsTo :Chart .

:dataPoint7 a :dataPoint ;
    :xValue "2019" ;
    :yValue "0.3299" ;
    :belongsTo :Chart .

:dataPoint8 a :dataPoint ;
    :xValue "2018" ;
    :yValue "0.3017" ;
    :belongsTo :Chart .

:dataPoint9 a :dataPoint ;
    :xValue "2017" ;
    :yValue "0.2803" ;
    :belongsTo :Chart .

:dataPoint10 a :dataPoint ;
    :xValue "2016" ;
    :yValue "0.28" ;
    :belongsTo :Chart .

:dataPoint11 a :dataPoint ;
    :xValue "2015" ;
    :yValue "0.2736" ;
    :belongsTo :Chart .
