@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Clinical trial costs by selected cost component and clinical phase as of 2014 (in U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Phase 1" .

:YAxis a :Axis ;
    :title "Cost component" .

:dataPoint1 a :dataPoint ;
    :xValue "50331" ;
    :yValue "Data Management Costs" ;
    :belongsTo :Chart .

:dataPoint2 a :dataPoint ;
    :xValue "11962" ;
    :yValue "Cost Per IRB Approvals" ;
    :belongsTo :Chart .

:dataPoint3 a :dataPoint ;
    :xValue "1094" ;
    :yValue "Cost of IRB Amendments" ;
    :belongsTo :Chart .

:dataPoint4 a :dataPoint ;
    :xValue "326437" ;
    :yValue "SDV Costs" ;
    :belongsTo :Chart .

:dataPoint5 a :dataPoint ;
    :xValue "37050" ;
    :yValue "Patient Recruitment Costs" ;
    :belongsTo :Chart .

:dataPoint6 a :dataPoint ;
    :xValue "6145" ;
    :yValue "Patient Retention Costs" ;
    :belongsTo :Chart .

:dataPoint7 a :dataPoint ;
    :xValue "178237" ;
    :yValue "RN/CRA Costs" ;
    :belongsTo :Chart .

:dataPoint8 a :dataPoint ;
    :xValue "109681" ;
    :yValue "Physician Costs" ;
    :belongsTo :Chart .

:dataPoint9 a :dataPoint ;
    :xValue "475667" ;
    :yValue "Clinical Procedure Total" ;
    :belongsTo :Chart .

:dataPoint10 a :dataPoint ;
    :xValue "252163" ;
    :yValue "Central Lab Costs" ;
    :belongsTo :Chart .

:dataPoint11 a :dataPoint ;
    :xValue "51904" ;
    :yValue "Site Recruitment Costs" ;
    :belongsTo :Chart .

:dataPoint12 a :dataPoint ;
    :xValue "193615" ;
    :yValue "Site Retention Costs" ;
    :belongsTo :Chart .

:dataPoint13 a :dataPoint ;
    :xValue "237869" ;
    :yValue "Administrative Staff Costs" ;
    :belongsTo :Chart .

:dataPoint14 a :dataPoint ;
    :xValue "198896" ;
    :yValue "Site Monitoring Costs" ;
    :belongsTo :Chart .
