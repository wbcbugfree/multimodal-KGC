@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "How long do you think the social distancing instructions in the UK will be in place ?" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "Share of respondents" .

:dataPoint1 a :dataPoint ;
    :xValue "Until beginning of June" ;
    :yValue "0.02" ;
    :belongsTo :Chart .

:dataPoint2 a :dataPoint ;
    :xValue "Until mid June" ;
    :yValue "0.03" ;
    :belongsTo :Chart .

:dataPoint3 a :dataPoint ;
    :xValue "Until end of June" ;
    :yValue "0.07" ;
    :belongsTo :Chart .

:dataPoint4 a :dataPoint ;
    :xValue "Until mid July" ;
    :yValue "0.05" ;
    :belongsTo :Chart .

:dataPoint5 a :dataPoint ;
    :xValue "Until end of July" ;
    :yValue "0.11" ;
    :belongsTo :Chart .

:dataPoint6 a :dataPoint ;
    :xValue "Until mid August" ;
    :yValue "0.04" ;
    :belongsTo :Chart .

:dataPoint7 a :dataPoint ;
    :xValue "Until end of August" ;
    :yValue "0.09" ;
    :belongsTo :Chart .

:dataPoint8 a :dataPoint ;
    :xValue "Until mid September" ;
    :yValue "0.05" ;
    :belongsTo :Chart .

:dataPoint9 a :dataPoint ;
    :xValue "Until end of September" ;
    :yValue "0.06" ;
    :belongsTo :Chart .

:dataPoint10 a :dataPoint ;
    :xValue "Until mid October" ;
    :yValue "0.03" ;
    :belongsTo :Chart .

:dataPoint11 a :dataPoint ;
    :xValue "Until end of October" ;
    :yValue "0.05" ;
    :belongsTo :Chart .

:dataPoint12 a :dataPoint ;
    :xValue "Until mid November" ;
    :yValue "0.02" ;
    :belongsTo :Chart .

:dataPoint13 a :dataPoint ;
    :xValue "Until end of November" ;
    :yValue "0.02" ;
    :belongsTo :Chart .

:dataPoint14 a :dataPoint ;
    :xValue "Until mid December" ;
    :yValue "0.01" ;
    :belongsTo :Chart .

:dataPoint15 a :dataPoint ;
    :xValue "Until end of December" ;
    :yValue "0.04" ;
    :belongsTo :Chart .

:dataPoint16 a :dataPoint ;
    :xValue "Until after December 2020" ;
    :yValue "0.32" ;
    :belongsTo :Chart .
