@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "How long do you think the social distancing instructions in the UK will be in place ?" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "Share of respondents" .

:DataPoint1 a :DataPoint ;
    :xValue "Until beginning of June 0.02 Until mid June 0.03 Until end of June 0.07 Until mid July 0.05 Until end of July 0.11 Until mid August 0.04 Until end of August 0.09 Until mid September 0.05 Until end of September 0.06 Until mid October 0.03 Until end of October 0.05 Until mid November 0.02 Until end of November 0.02 Until mid December 0.01 Until end of December 0.04 Until after December 2020" ;
    :yValue "0.32" ;
    :belongsTo :Chart .
