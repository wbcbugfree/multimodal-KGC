@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Earthquakes of magnitude 3.6 and over in Italy between January and May 2020 , by magnitude" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Magnitude" .

:YAxis a :Axis ;
    :title "region of Italy" .

:dataPoint1 a :dataPoint ;
    :xValue "3.8" ;
    :yValue "Albi (Cosenza) - January" ;
    :belongsTo :Chart .

:dataPoint2 a :dataPoint ;
    :xValue "3.6" ;
    :yValue "Carpino (Foggia) - January" ;
    :belongsTo :Chart .

:dataPoint3 a :dataPoint ;
    :xValue "3.8" ;
    :yValue "North-west coast in Calabria (Cosenza) - January" ;
    :belongsTo :Chart .

:dataPoint4 a :dataPoint ;
    :xValue "4.3" ;
    :yValue "Castiglione Cosentino (Cosenza) - February" ;
    :belongsTo :Chart .

:dataPoint5 a :dataPoint ;
    :xValue "3.7" ;
    :yValue "Aeolian Islands (Messina) - February" ;
    :belongsTo :Chart .

:dataPoint6 a :dataPoint ;
    :xValue "3.9" ;
    :yValue "South tyrrhenian sea - March" ;
    :belongsTo :Chart .

:dataPoint7 a :dataPoint ;
    :xValue "3.6" ;
    :yValue "Troina (Enna) - March" ;
    :belongsTo :Chart .

:dataPoint8 a :dataPoint ;
    :xValue "4" ;
    :yValue "Ionian coast (Crotone) - March" ;
    :belongsTo :Chart .

:dataPoint9 a :dataPoint ;
    :xValue "4.4" ;
    :yValue "South tyrrhenian sea - March" ;
    :belongsTo :Chart .

:dataPoint10 a :dataPoint ;
    :xValue "3.9" ;
    :yValue "South-west coast in Calabra (Catanzaro, Vibo Valentina, Reggio di Calabria) - March" ;
    :belongsTo :Chart .

:dataPoint11 a :dataPoint ;
    :xValue "4" ;
    :yValue "Cerignale (Piacenza) - April" ;
    :belongsTo :Chart .

:dataPoint12 a :dataPoint ;
    :xValue "3.7" ;
    :yValue "Poggio Imperiale (Foggia) - April" ;
    :belongsTo :Chart .

:dataPoint13 a :dataPoint ;
    :xValue "3.7" ;
    :yValue "Redavalle (Pavia) - April" ;
