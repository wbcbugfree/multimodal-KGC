@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Total number of magnetic resonance imaging (MRI) units in the United Kingdom (UK) from 2000 to 2014" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Number of scanners" .

:dataPoint1 a :dataPoint ;
    :xValue "2014*" ;
    :yValue "467" ;
    :belongsTo :Chart .

