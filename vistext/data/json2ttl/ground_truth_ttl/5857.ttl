@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Guyana : National debt from 2014 to 2024 (in billion U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "National debt in billion U.S. dollars" .

:YAxis a :Axis ;
    :title "Year" .

:dataPoint1 a :dataPoint ;
    :xValue "2.51" ;
    :yValue "2024*" ;
    :belongsTo :Chart .

:dataPoint2 a :dataPoint ;
    :xValue "2.59" ;
    :yValue "2023*" ;
    :belongsTo :Chart .

:dataPoint3 a :dataPoint ;
    :xValue "2.51" ;
    :yValue "2022*" ;
    :belongsTo :Chart .

:dataPoint4 a :dataPoint ;
    :xValue "2.02" ;
    :yValue "2021*" ;
    :belongsTo :Chart .

:dataPoint5 a :dataPoint ;
    :xValue "1.98" ;
    :yValue "2020*" ;
    :belongsTo :Chart .

:dataPoint6 a :dataPoint ;
    :xValue "2.27" ;
    :yValue "2019*" ;
    :belongsTo :Chart .

:dataPoint7 a :dataPoint ;
    :xValue "2.05" ;
    :yValue "2018" ;
    :belongsTo :Chart .

:dataPoint8 a :dataPoint ;
    :xValue "1.84" ;
    :yValue "2017" ;
    :belongsTo :Chart .

:dataPoint9 a :dataPoint ;
    :xValue "1.76" ;
    :yValue "2016" ;
    :belongsTo :Chart .

:dataPoint10 a :dataPoint ;
    :xValue "1.59" ;
    :yValue "2015" ;
    :belongsTo :Chart .

:dataPoint11 a :dataPoint ;
    :xValue "1.58" ;
    :yValue "2014" ;
    :belongsTo :Chart .
