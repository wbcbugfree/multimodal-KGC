@prefix : <http://example.org/> .

:Chart a :LineChart ;
    :title "Prices of natural gas for industry in Italy from 2008 to 2018 (in euro cents per kilowatt hour)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Annual consumption of 100,000 GJ - 1,000,000 GJ" .

:dataPoint1 a :dataPoint ;
    :xValue "Dec 31, 2007" ;
    :yValue "3.34" ;
    :belongsTo :Chart .

:dataPoint2 a :dataPoint ;
    :xValue "Dec 31, 2008" ;
    :yValue "2.87" ;
    :belongsTo :Chart .

