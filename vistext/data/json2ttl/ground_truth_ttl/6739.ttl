    :xValue "Dec 31, 2011" ;
    :yValue "3.55" ;
    :belongsTo :Chart .

:dataPoint6 a :dataPoint ;
    :xValue "Dec 31, 2012" ;
    :yValue "3.37" ;
    :belongsTo :Chart .

:dataPoint7 a :dataPoint ;
    :xValue "Dec 31, 2013" ;
    :yValue "3.06" ;
    :belongsTo :Chart .

:dataPoint8 a :dataPoint ;
