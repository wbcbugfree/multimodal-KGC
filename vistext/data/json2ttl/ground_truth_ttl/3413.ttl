@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Percentage of households with a dishwasher in the United Kingdom (UK) in 2018 , by gross income group" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Percentage of respondents" .

:YAxis a :Axis ;
    :title "Gross income decile group" .

:dataPoint1 a :dataPoint ;
    :xValue "0.2" ;
    :yValue "Lowest ten percent" ;
    :belongsTo :Chart .

:dataPoint2 a :dataPoint ;
    :xValue "0.25" ;
    :yValue "Second decile group" ;
    :belongsTo :Chart .

:dataPoint3 a :dataPoint ;
    :xValue "0.32" ;
    :yValue "Third decile group" ;
    :belongsTo :Chart .

:dataPoint4 a :dataPoint ;
    :xValue "0.4" ;
    :yValue "Fourth decile group" ;
    :belongsTo :Chart .

:dataPoint5 a :dataPoint ;
    :xValue "0.44" ;
    :yValue "Fifth decile group" ;
    :belongsTo :Chart .

:dataPoint6 a :dataPoint ;
    :xValue "0.51" ;
    :yValue "Sixth decile group" ;
    :belongsTo :Chart .

:dataPoint7 a :dataPoint ;
    :xValue "0.54" ;
    :yValue "Seventh decile group" ;
    :belongsTo :Chart .

:dataPoint8 a :dataPoint ;
    :xValue "0.62" ;
    :yValue "Eighth decile group" ;
    :belongsTo :Chart .

:dataPoint9 a :dataPoint ;
    :xValue "0.75" ;
    :yValue "Ninth decile group" ;
    :belongsTo :Chart .

:dataPoint10 a :dataPoint ;
    :xValue "0.84" ;
    :yValue "Highest ten percent" ;
    :belongsTo :Chart .
