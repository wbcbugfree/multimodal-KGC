@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Percentage of households with a dishwasher in the United Kingdom (UK) in 2018 , by gross income group" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Percentage of respondents" .

:YAxis a :Axis ;
    :title "Gross income decile group" .

:DataPoint1 a :DataPoint ;
    :xValue "0.2" ;
    :yValue "Lowest ten percent" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "0.25" ;
    :yValue "Second decile group" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "0.32" ;
    :yValue "Third decile group" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "0.4" ;
    :yValue "Fourth decile group" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "0.44" ;
    :yValue "Fifth decile group" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "0.51" ;
    :yValue "Sixth decile group" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "0.54" ;
    :yValue "Seventh decile group" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "0.62" ;
    :yValue "Eighth decile group" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "0.75" ;
    :yValue "Ninth decile group" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "0.84" ;
    :yValue "Highest ten percent" ;
    :belongsTo :Chart .
