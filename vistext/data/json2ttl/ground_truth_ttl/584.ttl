    :yValue "75279" ;
    :belongsTo :Chart .

:dataPoint6 a :dataPoint ;
    :xValue "2014/15" ;
    :yValue "75335" ;
    :belongsTo :Chart .

:dataPoint7 a :dataPoint ;
    :xValue "2013/14" ;
    :yValue "75203" ;
    :belongsTo :Chart .

:dataPoint8 a :dataPoint ;
    :xValue "2012/13" ;
    :yValue "75530" ;
    :belongsTo :Chart .

:dataPoint9 a :dataPoint ;
