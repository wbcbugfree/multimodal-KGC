@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Average per game attendance of Manchester United from 2009/10 to 2019/20" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Average attendance" .

:dataPoint1 a :dataPoint ;
    :xValue "2019/20*" ;
    :yValue "57942" ;
    :belongsTo :Chart .

:dataPoint2 a :dataPoint ;
    :xValue "2018/19" ;
    :yValue "74879" ;
    :belongsTo :Chart .

