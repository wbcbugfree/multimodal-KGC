@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Philadelphia 76ers all-time steals leaders from 1949 to 2020" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Philadelphia 76ers all-time steals leaders" .

:YAxis a :Axis ;
    :title "Steals" .

:dataPoint1 a :dataPoint ;
    :xValue "leaders Steals Maurice Cheeks" ;
    :yValue "1942" ;
    :belongsTo :Chart .

:dataPoint2 a :dataPoint ;
    :xValue "Allen Iverson" ;
    :yValue "1644" ;
    :belongsTo :Chart .

:dataPoint3 a :dataPoint ;
    :xValue "Julius Erving" ;
    :yValue "1508" ;
    :belongsTo :Chart .

:dataPoint4 a :dataPoint ;
    :xValue "Andre Iguodala" ;
    :yValue "1076" ;
    :belongsTo :Chart .

:dataPoint5 a :dataPoint ;
    :xValue "Charles Barkley" ;
    :yValue "1007" ;
    :belongsTo :Chart .

:dataPoint6 a :dataPoint ;
    :xValue "Steve Mix" ;
    :yValue "851" ;
    :belongsTo :Chart .

:dataPoint7 a :dataPoint ;
    :xValue "Bobby Jones" ;
    :yValue "727" ;
    :belongsTo :Chart .

:dataPoint8 a :dataPoint ;
    :xValue "Hersey Hawkins" ;
    :yValue "722" ;
    :belongsTo :Chart .

:dataPoint9 a :dataPoint ;
    :xValue "Thaddeus Young" ;
    :yValue "708" ;
    :belongsTo :Chart .

:dataPoint10 a :dataPoint ;
    :xValue "Eric Snow" ;
    :yValue "702" ;
    :belongsTo :Chart .
