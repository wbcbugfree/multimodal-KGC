@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Pharmaceutical imports and exports of major African countries in 2014 (in million U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Country" .

:YAxis a :Axis ;
    :title "Exports" .

