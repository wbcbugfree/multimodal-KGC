@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Contribution of foodservice industry to gross domestic product in Mexico from 2010 to 1st half 2020 (in billion Mexican pesos)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "GDP in billion Mexican pesos" .

:dataPoint1 a :dataPoint ;
    :xValue "2020*" ;
    :yValue "400.93" ;
    :belongsTo :Chart .

:dataPoint2 a :dataPoint ;
    :xValue "2019" ;
    :yValue "1049.98" ;
    :belongsTo :Chart .

:dataPoint3 a :dataPoint ;
    :xValue "2018" ;
    :yValue "989.44" ;
    :belongsTo :Chart .

:dataPoint4 a :dataPoint ;
    :xValue "2017" ;
    :yValue "939.64" ;
    :belongsTo :Chart .

:dataPoint5 a :dataPoint ;
    :xValue "2016" ;
    :yValue "892.27" ;
    :belongsTo :Chart .

:dataPoint6 a :dataPoint ;
    :xValue "2015" ;
    :yValue "839.49" ;
    :belongsTo :Chart .

:dataPoint7 a :dataPoint ;
    :xValue "2014" ;
    :yValue "754.05" ;
    :belongsTo :Chart .

:dataPoint8 a :dataPoint ;
    :xValue "2013" ;
    :yValue "732.1" ;
    :belongsTo :Chart .

:dataPoint9 a :dataPoint ;
    :xValue "2012" ;
    :yValue "715.26" ;
    :belongsTo :Chart .

:dataPoint10 a :dataPoint ;
    :xValue "2011" ;
    :yValue "670.26" ;
    :belongsTo :Chart .

:dataPoint11 a :dataPoint ;
    :xValue "2010" ;
    :yValue "633.14" ;
    :belongsTo :Chart .
