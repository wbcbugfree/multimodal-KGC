@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Contribution of foodservice industry to gross domestic product in Mexico from 2010 to 1st half 2020 (in billion Mexican pesos)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "GDP in billion Mexican pesos" .

:DataPoint1 a :DataPoint ;
    :xValue "2020*" ;
    :yValue "400.93" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "2019" ;
    :yValue "1049.98" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "2018" ;
    :yValue "989.44" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "2017" ;
    :yValue "939.64" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "2016" ;
    :yValue "892.27" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "2015" ;
    :yValue "839.49" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "2014" ;
    :yValue "754.05" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "2013" ;
    :yValue "732.1" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "2012" ;
    :yValue "715.26" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "2011" ;
    :yValue "670.26" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "2010" ;
    :yValue "633.14" ;
    :belongsTo :Chart .
