@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Mexico 's exports of tequila from 1995 to 2019 (in million liters)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Exports in million liters" .

