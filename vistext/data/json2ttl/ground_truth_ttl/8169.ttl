@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Usage of online banking credentials for various online services in Finland in 2016" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "Frequently" .

:dataPoint1 a :dataPoint ;
    :xValue "Paying online purchases from your bank account" ;
    :yValue "0.44" ;
    :belongsTo :Chart .

:dataPoint2 a :dataPoint ;
    :xValue "Credit card payment verification likeVerified by Visa or Mastercard Secure Code" ;
    :yValue "0.25" ;
    :belongsTo :Chart .

:dataPoint3 a :dataPoint ;
    :xValue "Kela, the Finnish Social Insurance Institution" ;
    :yValue "0.22" ;
    :belongsTo :Chart .

:dataPoint4 a :dataPoint ;
    :xValue "Verohallinto (the Finnish Tax office)" ;
    :yValue "0.15" ;
    :belongsTo :Chart .

:dataPoint5 a :dataPoint ;
    :xValue "Insurance company's services" ;
    :yValue "0.15" ;
    :belongsTo :Chart .

:dataPoint6 a :dataPoint ;
    :xValue "Municipal healthcare services" ;
    :yValue "0.1" ;
    :belongsTo :Chart .

:dataPoint7 a :dataPoint ;
    :xValue "Posti (the main Finnish postal service)" ;
    :yValue "0.09" ;
    :belongsTo :Chart .

:dataPoint8 a :dataPoint ;
    :xValue "Other governmental services" ;
    :yValue "0.04" ;
    :belongsTo :Chart .

:dataPoint9 a :dataPoint ;
    :xValue "Trafi (Finnish Transport Safety Agency)" ;
    :yValue "0.03" ;
    :belongsTo :Chart .

:dataPoint10 a :dataPoint ;
    :xValue "Other municipal services" ;
    :yValue "0.03" ;
    :belongsTo :Chart .

:dataPoint11 a :dataPoint ;
    :xValue "Väestörekisterikeskus (the Population Register Centre)" ;
    :yValue "0.02" ;
    :belongsTo :Chart .
