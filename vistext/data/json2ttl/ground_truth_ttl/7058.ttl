@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Leading male Italian golfers as of October 11 , 2020 , by OWRG score" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Leading male Italian golfers" .

:YAxis a :Axis ;
    :title "Events Played" .

:dataPoint1 a :dataPoint ;
    :xValue "Francesco Molinari" ;
    :yValue "40" ;
    :belongsTo :Chart .

