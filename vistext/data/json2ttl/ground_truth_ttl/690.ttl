@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Among the following social media platforms , which ones do you use ?" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "Share of respondents" .

:dataPoint1 a :dataPoint ;
    :xValue "Facebook" ;
    :yValue "0.79" ;
    :belongsTo :Chart .

:dataPoint2 a :dataPoint ;
    :xValue "Instagram" ;
    :yValue "0.26" ;
    :belongsTo :Chart .

:dataPoint3 a :dataPoint ;
    :xValue "Snapchat" ;
    :yValue "0.24" ;
    :belongsTo :Chart .

:dataPoint4 a :dataPoint ;
    :xValue "LinkedIn" ;
    :yValue "0.2" ;
    :belongsTo :Chart .

:dataPoint5 a :dataPoint ;
    :xValue "Pinterest" ;
    :yValue "0.19" ;
    :belongsTo :Chart .

:dataPoint6 a :dataPoint ;
    :xValue "Twitter" ;
    :yValue "0.16" ;
    :belongsTo :Chart .

:dataPoint7 a :dataPoint ;
    :xValue "Tumblr" ;
    :yValue "0.04" ;
    :belongsTo :Chart .

:dataPoint8 a :dataPoint ;
    :xValue "Flickr" ;
    :yValue "0.02" ;
    :belongsTo :Chart .

:dataPoint9 a :dataPoint ;
    :xValue "Xing" ;
    :yValue "0.01" ;
    :belongsTo :Chart .

:dataPoint10 a :dataPoint ;
    :xValue "I don't use any of the mentioned platforms" ;
    :yValue "0.15" ;
    :belongsTo :Chart .
