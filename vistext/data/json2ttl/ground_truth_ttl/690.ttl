@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Among the following social media platforms , which ones do you use ?" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "Share of respondents" .

:DataPoint1 a :DataPoint ;
    :xValue "Facebook" ;
    :yValue "0.79" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Instagram" ;
    :yValue "0.26" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "Snapchat" ;
    :yValue "0.24" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "LinkedIn" ;
    :yValue "0.2" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "Pinterest" ;
    :yValue "0.19" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Twitter" ;
    :yValue "0.16" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Tumblr" ;
    :yValue "0.04" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Flickr" ;
    :yValue "0.02" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "Xing" ;
    :yValue "0.01" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "I don't use any of the mentioned platforms" ;
    :yValue "0.15" ;
    :belongsTo :Chart .
