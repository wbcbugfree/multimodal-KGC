@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Public sector expenditure on water supply in the United Kingdom (UK) from 2009/10 to 2019/20 (in million GBP)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Expenditure in million GBP" .

:YAxis a :Axis ;
    :title "Year" .

:dataPoint1 a :dataPoint ;
    :xValue "798" ;
    :yValue "2019/20" ;
    :belongsTo :Chart .

:dataPoint2 a :dataPoint ;
    :xValue "793" ;
    :yValue "2018/19" ;
    :belongsTo :Chart .

