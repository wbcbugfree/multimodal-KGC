    :xValue "750" ;
    :yValue "2016/17" ;
    :belongsTo :Chart .

:dataPoint5 a :dataPoint ;
    :xValue "584" ;
    :yValue "2015/16" ;
    :belongsTo :Chart .

:dataPoint6 a :dataPoint ;
    :xValue "576" ;
    :yValue "2014/15" ;
    :belongsTo :Chart .

:dataPoint7 a :dataPoint ;
    :xValue "628" ;
    :yValue "2013/14" ;
    :belongsTo :Chart .

:dataPoint8 a :dataPoint ;
    :xValue "770" ;
