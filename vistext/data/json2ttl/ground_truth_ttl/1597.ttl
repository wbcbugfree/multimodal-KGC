@prefix : <http://example.org/> .

:Chart a :LineChart ;
    :title "Forecast of boron market demand for detergents worldwide from 2012 to 2023 (in metric tons)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Demand in metric tons" .

:dataPoint1 a :dataPoint ;
    :xValue "Dec 31, 2011" ;
    :yValue "57600" ;
    :belongsTo :Chart .

