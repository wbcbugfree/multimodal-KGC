@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Forecast of boron market demand for detergents worldwide from 2012 to 2023 (in metric tons)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Demand in metric tons" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2011" ;
    :yValue "57600" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Dec 31, 2012" ;
    :yValue "59040" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "Dec 31, 2013" ;
    :yValue "60575" ;
    :belongsTo :Chart .

