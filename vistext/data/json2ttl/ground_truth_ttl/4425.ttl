@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Number of killed soldiers in U.S. wars since World War I as of October 2020" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "War or armed conflict" .

:YAxis a :Axis ;
    :title "Number of fatalities" .

:dataPoint1 a :dataPoint ;
    :xValue "World War I (1917-1918)" ;
    :yValue "116516" ;
    :belongsTo :Chart .

:dataPoint2 a :dataPoint ;
    :xValue "World War II (1941-1946)" ;
    :yValue "405399" ;
    :belongsTo :Chart .

:dataPoint3 a :dataPoint ;
    :xValue "Korean War (1950-1953)" ;
    :yValue "36574" ;
    :belongsTo :Chart .

:dataPoint4 a :dataPoint ;
    :xValue "Vietnam Conflict (1964-1973)" ;
    :yValue "58220" ;
    :belongsTo :Chart .

:dataPoint5 a :dataPoint ;
    :xValue "Persian Gulf War (1990-1991)" ;
    :yValue "2586" ;
    :belongsTo :Chart .

:dataPoint6 a :dataPoint ;
    :xValue "Operation Enduring Freedom (2001-2014)" ;
    :yValue "2349" ;
    :belongsTo :Chart .

:dataPoint7 a :dataPoint ;
    :xValue "Operation Iraqi Freedom (2003-2010)" ;
    :yValue "4418" ;
    :belongsTo :Chart .

:dataPoint8 a :dataPoint ;
    :xValue "Operation New Dawn (2007-2011)" ;
    :yValue "74" ;
    :belongsTo :Chart .

:dataPoint9 a :dataPoint ;
    :xValue "Operation Inherent Resolve [CJTF-OIR] (2014-present)" ;
    :yValue "99" ;
    :belongsTo :Chart .

:dataPoint10 a :dataPoint ;
    :xValue "Operation Freedom's Sentinel (2014-present)" ;
    :yValue "93" ;
    :belongsTo :Chart .
