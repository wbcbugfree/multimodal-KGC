@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Distribution of iodine demand worldwide in 2016 , by application" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Share of demand" .

:YAxis a :Axis ;
    :title "Response" .

:dataPoint1 a :dataPoint ;
    :xValue "0.22" ;
    :yValue "XR contrast media" ;
    :belongsTo :Chart .

:dataPoint2 a :dataPoint ;
    :xValue "0.13" ;
    :yValue "Pharmaceuticals" ;
    :belongsTo :Chart .

:dataPoint3 a :dataPoint ;
    :xValue "0.12" ;
    :yValue "LCD polarizing film" ;
    :belongsTo :Chart .

:dataPoint4 a :dataPoint ;
    :xValue "0.08" ;
    :yValue "Animal feed" ;
    :belongsTo :Chart .

:dataPoint5 a :dataPoint ;
    :xValue "0.07" ;
    :yValue "Iodophors" ;
    :belongsTo :Chart .

:dataPoint6 a :dataPoint ;
    :xValue "0.07" ;
    :yValue "Fluorochemicals" ;
    :belongsTo :Chart .

:dataPoint7 a :dataPoint ;
    :xValue "0.04" ;
    :yValue "Biocides" ;
    :belongsTo :Chart .

:dataPoint8 a :dataPoint ;
    :xValue "0.04" ;
    :yValue "Nylon" ;
    :belongsTo :Chart .

:dataPoint9 a :dataPoint ;
    :xValue "0.03" ;
    :yValue "Human nutrition" ;
    :belongsTo :Chart .

:dataPoint10 a :dataPoint ;
    :xValue "0.03" ;
    :yValue "PVPI" ;
    :belongsTo :Chart .

:dataPoint11 a :dataPoint ;
    :xValue "0.17" ;
    :yValue "Other" ;
    :belongsTo :Chart .
