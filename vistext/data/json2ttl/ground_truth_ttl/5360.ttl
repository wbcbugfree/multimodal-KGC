@prefix : <http://example.org/> .

:Chart a :AreaChart ;
    :title "Chicago Blackhawks franchise value from 2006 to 2019 (in million U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Franchise value in million U.S. dollars" .

:dataPoint1 a :dataPoint ;
    :xValue "Dec 31, 2005" ;
    :yValue "168" ;
    :belongsTo :Chart .

