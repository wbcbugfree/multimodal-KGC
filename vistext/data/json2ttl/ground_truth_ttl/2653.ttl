@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Total number of employees in the crude petroleum and natural gas extraction sector in Germany from 2008 to 2018" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Number of employees" .

:YAxis a :Axis ;
    :title "Year" .

:dataPoint1 a :dataPoint ;
    :xValue "4925" ;
    :yValue "2018*" ;
    :belongsTo :Chart .

