@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Share of traditional quantitative methods used in the market research industry worldwide in Q3 and Q4 2018" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Share of respondents" .

:YAxis a :Axis ;
    :title "Response" .

:dataPoint1 a :dataPoint ;
    :xValue "0.79" ;
    :yValue "Online surveys" ;
    :belongsTo :Chart .

:dataPoint2 a :dataPoint ;
    :xValue "0.53" ;
    :yValue "Mobile surveys" ;
    :belongsTo :Chart .

:dataPoint3 a :dataPoint ;
    :xValue "0.3" ;
    :yValue "CATI**" ;
    :belongsTo :Chart .

:dataPoint4 a :dataPoint ;
    :xValue "0.23" ;
    :yValue "Face-to-face" ;
    :belongsTo :Chart .

:dataPoint5 a :dataPoint ;
    :xValue "0.17" ;
    :yValue "CAPI***" ;
    :belongsTo :Chart .

:dataPoint6 a :dataPoint ;
    :xValue "0.07" ;
    :yValue "Biometrics/ neuromarketing" ;
    :belongsTo :Chart .

:dataPoint7 a :dataPoint ;
    :xValue "0.07" ;
    :yValue "Mail" ;
    :belongsTo :Chart .

:dataPoint8 a :dataPoint ;
    :xValue "0.06" ;
    :yValue "Automated measures/ People meters" ;
    :belongsTo :Chart .

:dataPoint9 a :dataPoint ;
    :xValue "0.04" ;
    :yValue "Other quantitative techniques" ;
    :belongsTo :Chart .

:dataPoint10 a :dataPoint ;
    :xValue "0.02" ;
    :yValue "IVR****" ;
    :belongsTo :Chart .
