@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Number of book readers in Italy in 2019 , by occupation and number of books read (in 1,000 readers)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "occupation" .

:YAxis a :Axis ;
    :title "From 1 to 3 books" .

:dataPoint1 a :dataPoint ;
    :xValue "Middle management, white collar" ;
    :yValue "2323" ;
    :belongsTo :Chart .

:dataPoint2 a :dataPoint ;
    :xValue "Retired" ;
    :yValue "1345" ;
    :belongsTo :Chart .

:dataPoint3 a :dataPoint ;
    :xValue "Student" ;
    :yValue "1164" ;
    :belongsTo :Chart .

:dataPoint4 a :dataPoint ;
    :xValue "Housewife" ;
    :yValue "976" ;
    :belongsTo :Chart .

:dataPoint5 a :dataPoint ;
    :xValue "Executive, employer, professional" ;
    :yValue "601" ;
    :belongsTo :Chart .

:dataPoint6 a :dataPoint ;
    :xValue "Unemployed person with work experience" ;
    :yValue "645" ;
    :belongsTo :Chart .

:dataPoint7 a :dataPoint ;
    :xValue "Blue collar, apprentice" ;
    :yValue "1206" ;
    :belongsTo :Chart .

:dataPoint8 a :dataPoint ;
    :xValue "Self-employed, family worker" ;
    :yValue "470" ;
    :belongsTo :Chart .

:dataPoint9 a :dataPoint ;
    :xValue "Unemployed person without work experience" ;
    :yValue "128" ;
    :belongsTo :Chart .

:dataPoint10 a :dataPoint ;
    :xValue "Other condition" ;
    :yValue "97" ;
    :belongsTo :Chart .
