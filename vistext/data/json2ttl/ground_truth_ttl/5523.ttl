@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Number of people affected by the world 's major volcanic eruptions from 1900 to 2016" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "volcanic eruption and date" .

:YAxis a :Axis ;
    :title "Number of victims" .

:dataPoint1 a :dataPoint ;
    :xValue "Volcanic eruption in the Philippines (June" ;
    :yValue "9" ;
    :belongsTo :Chart .

:dataPoint2 a :dataPoint ;
    :xValue "Volcano eruption in Ecuador (August" ;
    :yValue "14" ;
    :belongsTo :Chart .

:dataPoint3 a :dataPoint ;
    :xValue "Volcanic eruption in Nicaragua (April" ;
    :yValue "9" ;
    :belongsTo :Chart .

:dataPoint4 a :dataPoint ;
    :xValue "Volcano eruption in Ecuador (August" ;
    :yValue "14" ;
    :belongsTo :Chart .

:dataPoint5 a :dataPoint ;
    :xValue "Volcano eruption in Indonesia (April" ;
    :yValue "5" ;
    :belongsTo :Chart .

:dataPoint6 a :dataPoint ;
    :xValue "Volcano eruption in Indonesia" ;
    :yValue "1969" ;
    :belongsTo :Chart .

:dataPoint7 a :dataPoint ;
    :xValue "Volcanic eruption in Comoros (November" ;
    :yValue "24" ;
    :belongsTo :Chart .

:dataPoint8 a :dataPoint ;
    :xValue "Volcanic eruption in the Philippines (Feb." ;
    :yValue "6" ;
    :belongsTo :Chart .

:dataPoint9 a :dataPoint ;
