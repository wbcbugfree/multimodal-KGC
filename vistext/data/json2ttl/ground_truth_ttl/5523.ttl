@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Number of people affected by the world 's major volcanic eruptions from 1900 to 2016" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "volcanic eruption and date" .

:YAxis a :Axis ;
    :title "Number of victims" .

:DataPoint1 a :DataPoint ;
    :xValue "Volcanic eruption in the Philippines (June" ;
    :yValue "9" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Volcano eruption in Ecuador (August" ;
    :yValue "14" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "Volcanic eruption in Nicaragua (April" ;
    :yValue "9" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "Volcano eruption in Ecuador (August" ;
    :yValue "14" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "Volcano eruption in Indonesia (April" ;
    :yValue "5" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Volcano eruption in Indonesia" ;
    :yValue "1969" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Volcanic eruption in Comoros (November" ;
    :yValue "24" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Volcanic eruption in the Philippines (Feb." ;
    :yValue "6" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
