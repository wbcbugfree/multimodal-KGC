@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Do you use a smartphone for any of the following ?" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "8-12" .

:YAxis a :Axis ;
    :title "Activities" .

:dataPoint1 a :dataPoint ;
    :xValue "0.81" ;
    :yValue "Taking pictures or films" ;
    :belongsTo :Chart .

:dataPoint2 a :dataPoint ;
    :xValue "0.66" ;
    :yValue "Chatting with friends" ;
    :belongsTo :Chart .

:dataPoint3 a :dataPoint ;
    :xValue "0.72" ;
    :yValue "Downloading apps" ;
    :belongsTo :Chart .

:dataPoint4 a :dataPoint ;
    :xValue "0.48" ;
    :yValue "Social networking (e.g. Facebook or Twitter)" ;
    :belongsTo :Chart .

:dataPoint5 a :dataPoint ;
    :xValue "0.77" ;
    :yValue "Playing games" ;
    :belongsTo :Chart .

:dataPoint6 a :dataPoint ;
    :xValue "0.55" ;
    :yValue "Browsing online" ;
    :belongsTo :Chart .

:dataPoint7 a :dataPoint ;
    :xValue "0.44" ;
    :yValue "Watching videos" ;
    :belongsTo :Chart .

:dataPoint8 a :dataPoint ;
    :xValue "0.39" ;
    :yValue "To learn things" ;
    :belongsTo :Chart .

:dataPoint9 a :dataPoint ;
    :xValue "0.29" ;
    :yValue "Video chat (e.g. Skype or FaceTime)" ;
    :belongsTo :Chart .

:dataPoint10 a :dataPoint ;
    :xValue "0.16" ;
    :yValue "Watching TV" ;
    :belongsTo :Chart .

:dataPoint11 a :dataPoint ;
    :xValue "0.03" ;
    :yValue "None of the above" ;
    :belongsTo :Chart .
