@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Refinery gold production in the United States from 2008 to 2019 (in metric tons)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Primary" .

:dataPoint1 a :dataPoint ;
    :xValue "2019*" ;
    :yValue "200" ;
    :belongsTo :Chart .

:dataPoint2 a :dataPoint ;
    :xValue "2018" ;
    :yValue "205" ;
    :belongsTo :Chart .

:dataPoint3 a :dataPoint ;
    :xValue "2017" ;
    :yValue "207" ;
    :belongsTo :Chart .

:dataPoint4 a :dataPoint ;
    :xValue "2016" ;
    :yValue "242" ;
    :belongsTo :Chart .

:dataPoint5 a :dataPoint ;
    :xValue "2015" ;
    :yValue "244" ;
    :belongsTo :Chart .

:dataPoint6 a :dataPoint ;
    :xValue "2014" ;
    :yValue "253" ;
    :belongsTo :Chart .

:dataPoint7 a :dataPoint ;
    :xValue "2013" ;
    :yValue "223" ;
    :belongsTo :Chart .

:dataPoint8 a :dataPoint ;
    :xValue "2012" ;
    :yValue "222" ;
    :belongsTo :Chart .

:dataPoint9 a :dataPoint ;
    :xValue "2011" ;
    :yValue "220" ;
    :belongsTo :Chart .

:dataPoint10 a :dataPoint ;
    :xValue "2010" ;
    :yValue "175" ;
    :belongsTo :Chart .

:dataPoint11 a :dataPoint ;
    :xValue "2009" ;
    :yValue "170" ;
    :belongsTo :Chart .

:dataPoint12 a :dataPoint ;
    :xValue "2008" ;
    :yValue "168" ;
    :belongsTo :Chart .
