@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Bhutan : Urbanization from 2009 to 2019" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "Share of urban population in total population" .

