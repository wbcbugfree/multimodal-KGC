@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Syria : National debt from 2000 to 2010 in relation to gross domestic product (GDP)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "National debt in relation to GDP" .

:dataPoint1 a :dataPoint ;
    :xValue "2010*" ;
    :yValue "0.3002" ;
    :belongsTo :Chart .

:dataPoint2 a :dataPoint ;
    :xValue "2009" ;
    :yValue "0.3121" ;
    :belongsTo :Chart .

:dataPoint3 a :dataPoint ;
    :xValue "2008" ;
    :yValue "0.3732" ;
    :belongsTo :Chart .

:dataPoint4 a :dataPoint ;
    :xValue "2007" ;
    :yValue "0.4267" ;
    :belongsTo :Chart .

:dataPoint5 a :dataPoint ;
    :xValue "2006" ;
    :yValue "0.4498" ;
    :belongsTo :Chart .

:dataPoint6 a :dataPoint ;
    :xValue "2005" ;
    :yValue "0.5071" ;
    :belongsTo :Chart .

:dataPoint7 a :dataPoint ;
    :xValue "2004" ;
    :yValue "1.1305" ;
    :belongsTo :Chart .

:dataPoint8 a :dataPoint ;
    :xValue "2003" ;
    :yValue "1.3337" ;
    :belongsTo :Chart .

:dataPoint9 a :dataPoint ;
    :xValue "2002" ;
    :yValue "1.3243" ;
    :belongsTo :Chart .

:dataPoint10 a :dataPoint ;
