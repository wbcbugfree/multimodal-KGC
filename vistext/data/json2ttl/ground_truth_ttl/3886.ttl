@prefix : <http://example.org/> .

:Chart a :AreaChart ;
    :title "Electricity export volume from the United States between 1999 and 2019 (in gigawatt hours)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Exports in thousand gigawatt hours" .

:dataPoint1 a :dataPoint ;
    :xValue "Dec 31, 1998" ;
    :yValue "14222" ;
    :belongsTo :Chart .

