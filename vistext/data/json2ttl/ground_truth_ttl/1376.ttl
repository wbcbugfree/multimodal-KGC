@prefix : <http://example.org/> .

:Chart a :LineChart ;
    :title "Average premiums for homeowners insurance in the United States from 2001 to 2017 (in U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Average premiums in U.S. dollars" .

:dataPoint1 a :dataPoint ;
    :xValue "Dec 31, 2000" ;
    :yValue "536" ;
    :belongsTo :Chart .

