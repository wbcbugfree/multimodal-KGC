@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Femicide rate in selected countries in Latin America in 2018 (number of femicides per 100,000 women)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Country" .

:YAxis a :Axis ;
    :title "Number of femicides per 100,000 women" .

:dataPoint1 a :dataPoint ;
    :xValue "El Salvador" ;
    :yValue "6.8" ;
    :belongsTo :Chart .

:dataPoint2 a :dataPoint ;
    :xValue "Honduras*" ;
    :yValue "5.1" ;
    :belongsTo :Chart .

