@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Market share of leading mass merchant e-retailers in the United States in 2017" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Market share" .

:YAxis a :Axis ;
    :title "Mass merchant e-retailer" .

:dataPoint1 a :dataPoint ;
    :xValue "0.1622" ;
    :yValue "Amazon.com, Inc." ;
    :belongsTo :Chart .

:dataPoint2 a :dataPoint ;
    :xValue "0.0417" ;
    :yValue "Wal-Mart Stores, Inc." ;
    :belongsTo :Chart .

:dataPoint3 a :dataPoint ;
    :xValue "0.0149" ;
    :yValue "Liberty Interactive Corporation" ;
    :belongsTo :Chart .

:dataPoint4 a :dataPoint ;
    :xValue "0.0108" ;
    :yValue "Target Corporation" ;
    :belongsTo :Chart .

:dataPoint5 a :dataPoint ;
    :xValue "0.0107" ;
    :yValue "Kohl's Corporation" ;
    :belongsTo :Chart .

:dataPoint6 a :dataPoint ;
    :xValue "0.0103" ;
    :yValue "Costco Wholesale Corporation" ;
    :belongsTo :Chart .

:dataPoint7 a :dataPoint ;
    :xValue "0.0052" ;
    :yValue "J.C. Penney Corporation, Inc." ;
    :belongsTo :Chart .

:dataPoint8 a :dataPoint ;
    :xValue "0.005" ;
    :yValue "Sears Holdings Corporation" ;
    :belongsTo :Chart .

:dataPoint9 a :dataPoint ;
    :xValue "0.0035" ;
    :yValue "HSN, Inc." ;
    :belongsTo :Chart .

:dataPoint10 a :dataPoint ;
    :xValue "0.003" ;
    :yValue "Hudson's Bay Company" ;
    :belongsTo :Chart .
