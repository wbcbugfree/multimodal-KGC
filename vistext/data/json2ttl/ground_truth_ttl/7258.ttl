@prefix : <http://example.org/> .

:Chart a :LineChart ;
    :title "Market value of new and used cars sold in the United Kingdom (UK) between 2003 and 2014 (in billion GBP)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "New Car Market" .

:dataPoint1 a :dataPoint ;
    :xValue "Dec 31, 2002" ;
    :yValue "33.5" ;
    :belongsTo :Chart .

:dataPoint2 a :dataPoint ;
    :xValue "Dec 31, 2003" ;
    :yValue "32.4" ;
    :belongsTo :Chart .

