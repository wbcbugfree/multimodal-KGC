@prefix : <http://example.org/> .

:Chart a :AreaChart ;
    :title "Ukraine : Poverty headcount ratio from 2008 to 2018" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "Share of population" .

:dataPoint1 a :dataPoint ;
    :xValue "Dec 31, 2007" ;
    :yValue "0.071" ;
    :belongsTo :Chart .

