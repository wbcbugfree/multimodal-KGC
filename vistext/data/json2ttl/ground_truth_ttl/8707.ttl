@prefix : <http://example.org/> .

:Chart a :LineChart ;
    :title "Number of deaths and injuries due to lightning in the U.S. from 1995 to 2019" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Deaths" .

