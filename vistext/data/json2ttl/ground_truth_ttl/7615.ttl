@prefix : <http://example.org/> .

:Chart a :LineChart ;
    :title "Share of economic sectors in the global gross domestic product (GDP) from 2008 to 2018" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Services" .

:dataPoint1 a :dataPoint ;
    :xValue "Dec 31, 2007" ;
    :yValue "61.97" ;
    :belongsTo :Chart .

