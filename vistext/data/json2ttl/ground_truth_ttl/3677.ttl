@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Most common purchase influences of online shoppers in the United States in 2017" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "Share of respondents" .

:dataPoint1 a :dataPoint ;
    :xValue "Price" ;
    :yValue "0.87" ;
    :belongsTo :Chart .

:dataPoint2 a :dataPoint ;
    :xValue "Shipping cost and speed" ;
    :yValue "0.8" ;
    :belongsTo :Chart .

:dataPoint3 a :dataPoint ;
    :xValue "Discount offers" ;
    :yValue "0.71" ;
    :belongsTo :Chart .

:dataPoint4 a :dataPoint ;
    :xValue "Variety of options in stock" ;
    :yValue "0.71" ;
    :belongsTo :Chart .

:dataPoint5 a :dataPoint ;
    :xValue "Trustworthy reviews" ;
    :yValue "0.68" ;
    :belongsTo :Chart .

:dataPoint6 a :dataPoint ;
    :xValue "Flexible or free returns" ;
    :yValue "0.68" ;
    :belongsTo :Chart .

:dataPoint7 a :dataPoint ;
    :xValue "Brand reputation" ;
    :yValue "0.67" ;
    :belongsTo :Chart .

:dataPoint8 a :dataPoint ;
    :xValue "Simple site navigation" ;
    :yValue "0.64" ;
    :belongsTo :Chart .

:dataPoint9 a :dataPoint ;
    :xValue "Tailored selection of products" ;
    :yValue "0.53" ;
    :belongsTo :Chart .

:dataPoint10 a :dataPoint ;
    :xValue "Mobile-friendly webpage" ;
    :yValue "0.46" ;
    :belongsTo :Chart .

:dataPoint11 a :dataPoint ;
    :xValue "Loyalty/rewards program" ;
    :yValue "0.45" ;
    :belongsTo :Chart .

:dataPoint12 a :dataPoint ;
    :xValue "Friend and family" ;
    :yValue "0.42" ;
    :belongsTo :Chart .

:dataPoint13 a :dataPoint ;
    :xValue "Top searching engine results" ;
    :yValue "0.39" ;
    :belongsTo :Chart .

:dataPoint14 a :dataPoint ;
    :xValue "Social media recommendations" ;
    :yValue "0.23" ;
    :belongsTo :Chart .

:dataPoint15 a :dataPoint ;
    :xValue "Advertisements" ;
    :yValue "0.21" ;
    :belongsTo :Chart .
