@prefix : <http://example.org/> .

:Chart a :AreaChart ;
    :title "Share of households with internet access in Belgium from 2007 to 2018" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "Share of households" .

:dataPoint1 a :dataPoint ;
    :xValue "Dec 31, 2006" ;
    :yValue "0.6" ;
    :belongsTo :Chart .

