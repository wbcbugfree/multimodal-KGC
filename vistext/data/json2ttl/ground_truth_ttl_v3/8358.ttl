@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Refinery gold production in the United States from 2008 to 2019 (in metric tons)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Primary" .

:DataPoint1 a :DataPoint ;
    :xValue "2019.025" ;
    :yValue "200" ;
    :belongsTo :Chart .

