@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Volume of oilseeds produced in India in financial year 2020 , by type (in 1,000 metric tons)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Volume in thousand metric tons" .

:YAxis a :Axis ;
    :title "type" .

:DataPoint1 a :DataPoint ;
    :xValue "33501" ;
    :yValue "Total from nine oil seeds" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "12242" ;
    :yValue "Soyabean" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "9347" ;
    :yValue "Groundnut" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "8703" ;
    :yValue "Rapeseed and mustard" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "2060" ;
    :yValue "Castorseed" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "746" ;
    :yValue "Sesamum" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "202" ;
    :yValue "Sunflower" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "103" ;
    :yValue "Linseed" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "72" ;
    :yValue "Nigerseed" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "27" ;
    :yValue "Safflower" ;
    :belongsTo :Chart .
