@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Number of visitors to destinations which featured in select screen products before and after the film/TV series release (in thousands) as of 2011" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "After release" .

:YAxis a :Axis ;
    :title "Title/location/years" .

:DataPoint1 a :DataPoint ;
    :xValue "1502" ;
    :yValue "Tomb Raider, Angkor, Cambodia (visitors in 1999 and 2011)" ;
    :belongsTo :Chart .

