@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Clinical trial costs by selected cost component and clinical phase as of 2014 (in U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Phase 1" .

:YAxis a :Axis ;
    :title "Cost component" .

:DataPoint1 a :DataPoint ;
    :xValue "50331" ;
    :yValue "Physician Costs" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "11962" ;
    :yValue "SDV Costs" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "1094" ;
    :yValue "RN/CRA Costs" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "326437" ;
    :yValue "Cost Per IRB Approvals" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "37050" ;
    :yValue "Patient Retention Costs" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "6145" ;
    :yValue "Patient Recruitment Costs" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "178237" ;
    :yValue "Cost of IRB Amendments" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "109681" ;
    :yValue "Data Management Costs" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "475667" ;
    :yValue "Site Monitoring Costs" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "252163" ;
    :yValue "Site Recruitment Costs" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "51904" ;
    :yValue "Central Lab Costs" ;
    :belongsTo :Chart .

:DataPoint12 a :DataPoint ;
    :xValue "193615" ;
    :yValue "Administrative Staff Costs" ;
    :belongsTo :Chart .

:DataPoint13 a :DataPoint ;
    :xValue "237869" ;
    :yValue "Site Retention Costs" ;
    :belongsTo :Chart .

:DataPoint14 a :DataPoint ;
    :xValue "198896" ;
    :yValue "Clinical Procedure Total" ;
    :belongsTo :Chart .
