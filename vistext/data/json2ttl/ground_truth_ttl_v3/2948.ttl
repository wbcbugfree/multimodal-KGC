@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Thinking about the people from the UK , from this list , which three , if any , do you think are the best characteristics from the UK as a whole ?" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Share of respondents" .

:YAxis a :Axis ;
    :title "Response" .

:DataPoint1 a :DataPoint ;
    :xValue "0.46" ;
    :yValue "Polite/good manners" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "0.37" ;
    :yValue "Educated and skilled" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "0.31" ;
    :yValue "Friendly" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "0.27" ;
    :yValue "Respect the rule of law" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "0.25" ;
    :yValue "Sense of humour" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "0.21" ;
    :yValue "Tolerant of people from other countries/with different beliefs" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "0.16" ;
    :yValue "Keep themselves to themselves" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "0.15" ;
    :yValue "Innovative and creative" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "0.15" ;
    :yValue "Patriotism" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "0.13" ;
    :yValue "Hard working" ;
    :belongsTo :Chart .
