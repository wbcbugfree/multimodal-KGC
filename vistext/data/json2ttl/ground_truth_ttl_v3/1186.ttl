@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Saudi Arabia : The ten largest cities in 2010 (in million inhabitants)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "big city" .

:YAxis a :Axis ;
    :title "Inhabitants in millions" .

:DataPoint1 a :DataPoint ;
    :xValue "Ar-Riyad" ;
    :yValue "5.19" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Jiddah" ;
    :yValue "3.43" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "Makkah" ;
    :yValue "1.53" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "Al-Madinah" ;
    :yValue "1.1" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "Ad-Dammam" ;
    :yValue "0.9" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Al-Hufuf & Al-Mubarraz" ;
    :yValue "0.66" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "At Ta'if" ;
    :yValue "0.58" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Tabuk" ;
    :yValue "0.51" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "Buraydah" ;
    :yValue "0.47" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "Khamis Mushayt" ;
    :yValue "0.43" ;
    :belongsTo :Chart .
