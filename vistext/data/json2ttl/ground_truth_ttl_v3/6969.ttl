@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Leading countries for Italian cosmetic industry exports from 2014 to 2019 (in million euros)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Country" .

:YAxis a :Axis ;
    :title "2019" .

:DataPoint1 a :DataPoint ;
    :xValue "France" ;
    :yValue "609" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Germany" ;
    :yValue "562" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "United States" ;
    :yValue "513" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "United Kingdom" ;
    :yValue "351" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "Spain" ;
    :yValue "294" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Hong Kong" ;
    :yValue "244" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Netherlands" ;
    :yValue "171" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "United Arab Emirates" ;
    :yValue "139" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "Poland" ;
    :yValue "156" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "Belgium" ;
    :yValue "140" ;
    :belongsTo :Chart .
