    :xValue "Jul" ;
    :yValue "196.34" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Jun" ;
    :yValue "179.22" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "May" ;
    :yValue "186.06" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
