@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Average retail price for roasted coffee in Canada from January 2015 to June 2020 (in Canadian dollars per 300 grams)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Month" .

:YAxis a :Axis ;
    :title "2019" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec" ;
    :yValue "5.01" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Nov" ;
    :yValue "5.02" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "Oct" ;
    :yValue "4.91" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "Sep" ;
    :yValue "4.86" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "Aug" ;
    :yValue "5.02" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Jul" ;
    :yValue "5.1" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Jun" ;
    :yValue "5.38" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "May" ;
    :yValue "5.3" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "Apr" ;
    :yValue "5.35" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "Mar" ;
    :yValue "5.39" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "Feb" ;
    :yValue "5.51" ;
    :belongsTo :Chart .

:DataPoint12 a :DataPoint ;
    :xValue "Jan" ;
    :yValue "5.33" ;
    :belongsTo :Chart .
