    :yValue "6754.9" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Dec 31, 2013" ;
    :yValue "6924.4" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
