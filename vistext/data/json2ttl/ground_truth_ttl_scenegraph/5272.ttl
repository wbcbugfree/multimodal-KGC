@prefix : <http://example.org/> .

:Chart a :AreaChart ;
    :title "Household electricity consumption of Singapore from 2009 to 2018 (in gigawatt hours)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Electricty consumption in gigawatt hours" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2008" ;
    :yValue "6430.8" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Dec 31, 2009" ;
    :yValue "6636" ;
    :belongsTo :Chart .

