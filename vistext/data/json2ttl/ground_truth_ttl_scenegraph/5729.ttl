@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Actions taken in last three years because of security and privacy issues w...ernet according to online users in the United States as of September 2018" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Percentage of respondents" .

:YAxis a :Axis ;
    :title "Response" .

:DataPoint1 a :DataPoint ;
    :xValue "0.44" ;
    :yValue "I am less likely to give personal info on websites" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "0.42" ;
    :yValue "I decided to only visit websites I know and trust" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "0.42" ;
    :yValue "I only use my own computer" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "0.41" ;
    :yValue "I started opening only emails from people I know" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "0.37" ;
    :yValue "I started using different passwords" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "0.36" ;
    :yValue "I have installed antivirus software" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "0.32" ;
    :yValue "I have changed the security settings" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "0.24" ;
    :yValue "I started changing my passwords regularly" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "0.2" ;
    :yValue "I am less likely to bank online" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "0.19" ;
    :yValue "I am less likely to buy goods or services online" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "0.09" ;
    :yValue "None" ;
    :belongsTo :Chart .

:DataPoint12 a :DataPoint ;
    :xValue "0.06" ;
    :yValue "I cancelled an online purchase" ;
    :belongsTo :Chart .

:DataPoint13 a :DataPoint ;
    :xValue "0.04" ;
    :yValue "Don't know" ;
    :belongsTo :Chart .

:DataPoint14 a :DataPoint ;
    :xValue "0.01" ;
    :yValue "Other" ;
    :belongsTo :Chart .
