    :xValue "1918.09" ;
    :yValue "Small SUV & crossover" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "1099.15" ;
    :yValue "Minicar" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "744.82" ;
    :yValue "Compact premium" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "612.88" ;
    :yValue "Premium compact SUV & crossover" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
