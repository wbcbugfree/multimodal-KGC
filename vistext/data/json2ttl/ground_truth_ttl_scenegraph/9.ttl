@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Number of car registrations in Europe in 2019 , by segment (in 1,000s)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "New registrations in thousands" .

:YAxis a :Axis ;
    :title "programming language" .

:DataPoint1 a :DataPoint ;
    :xValue "2678.85" ;
    :yValue "Small" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "2158.59" ;
    :yValue "Compact" ;
    :belongsTo :Chart .

