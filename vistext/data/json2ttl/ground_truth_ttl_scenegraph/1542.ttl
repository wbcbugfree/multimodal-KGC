@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Top 10 U.S. for-profit hospitals based on the number of beds as of 2015" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Hospital (Location)" .

:YAxis a :Axis ;
    :title "Number of beds" .

:DataPoint1 a :DataPoint ;
    :xValue "Methodist Hospital (San Antonio, Texas)" ;
    :yValue "1565" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Edinburg (Texas) Regional Medical Center" ;
    :yValue "818" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "Chippenham Hospital (Richmond, Va.)" ;
    :yValue "795" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "North Shore Medical Center (Miami, Fla.)" ;
    :yValue "773" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "Henrico Doctor's Hospital (Richmond, Va.)" ;
    :yValue "735" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Oklahoma University Medical Center (Oklahoma City)" ;
    :yValue "692" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Medical City Hospital (Dallas)" ;
    :yValue "67" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "TriStar Centennial (Nashville, Tenn.)" ;
    :yValue "659" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "Plantation (Fla.) General Hospital" ;
    :yValue "657" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "Sunrise Hospital & Medical Center (Las Vegas)" ;
    :yValue "643" ;
    :belongsTo :Chart .
