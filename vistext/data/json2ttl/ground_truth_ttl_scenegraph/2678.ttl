@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Revenue of the mechanical engineering industry in Brazil from 2006 to 2017 (in billion U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Revenue in billion U.S. dollars" .

:DataPoint1 a :DataPoint ;
    :xValue "2017" ;
    :yValue "36.96" ;
    :belongsTo :Chart .

