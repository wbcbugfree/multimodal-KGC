@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Monthly export value of fish , crustaceans , shellfish and other fishery products in Canada from 2015 to 2020 (in million Canadian dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Month" .

:YAxis a :Axis ;
    :title "2018" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec" ;
    :yValue "250" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Nov" ;
    :yValue "25" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "Oct" ;
    :yValue "250" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "Sep" ;
    :yValue "250" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "Aug" ;
    :yValue "250" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Jul" ;
    :yValue "250" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Jun" ;
    :yValue "250" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "May" ;
    :yValue "250" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "Apr" ;
    :yValue "25" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "Mar" ;
    :yValue "250" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "Feb" ;
    :yValue "250" ;
    :belongsTo :Chart .

:DataPoint12 a :DataPoint ;
    :xValue "Jan" ;
    :yValue "250" ;
    :belongsTo :Chart .
