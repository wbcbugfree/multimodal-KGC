@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Share of people using the internet to pay bills or shop something in the past year in Singapore in 2017 , by type of population" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Share of respondents" .

:YAxis a :Axis ;
    :title "Response" .

:DataPoint1 a :DataPoint ;
    :xValue "0.72" ;
    :yValue "Richest 60% (income)" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "1" ;
    :yValue "In labor" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "0.66" ;
    :yValue "Secondary education or less" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "0.58" ;
    :yValue "Adults (25 years and older)" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "0.57" ;
    :yValue "Women" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "1" ;
    :yValue "Total" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "0.56" ;
    :yValue "Men" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "0.49" ;
    :yValue "Young adults (15-24 years)" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "0.33" ;
    :yValue "Poorest 40% (income)" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "0.27" ;
    :yValue "Out of labor" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "0.17" ;
    :yValue "Primary education or less" ;
    :belongsTo :Chart .
