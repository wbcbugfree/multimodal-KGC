@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Average (mean) private weekly rent in England from 2008/2009 to 2018/2019 (in GBP)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Excluding London" .

:YAxis a :Axis ;
    :title "Year" .

:DataPoint1 a :DataPoint ;
    :xValue "162" ;
    :yValue "2018/19" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "158" ;
    :yValue "2017/18" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "158" ;
    :yValue "2016/17" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "153" ;
    :yValue "2015/16" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "147" ;
    :yValue "2014/15" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "145" ;
    :yValue "2013/14" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "14" ;
    :yValue "2012/13" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "139" ;
    :yValue "2011/12" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "137" ;
    :yValue "2010/11" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "13" ;
    :yValue "2009/10" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "13" ;
    :yValue "2008/09" ;
    :belongsTo :Chart .
