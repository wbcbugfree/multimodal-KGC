@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Number of bankruptcies after the coronavirus outbreak in Sweden from February to November 2020 , by industry" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Wholesale" .

:YAxis a :Axis ;
    :title "Month" .

:DataPoint1 a :DataPoint ;
    :xValue "29" ;
    :yValue "Feb" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "41" ;
    :yValue "Mar" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "55" ;
    :yValue "Apr" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "43" ;
    :yValue "May" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "33" ;
    :yValue "Jun" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "37" ;
    :yValue "Jul" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "24" ;
    :yValue "Aug" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "24" ;
    :yValue "Sep" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "29" ;
    :yValue "Oct" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "37" ;
    :yValue "Nov" ;
    :belongsTo :Chart .
