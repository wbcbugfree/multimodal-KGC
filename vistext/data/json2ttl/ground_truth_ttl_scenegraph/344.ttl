@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Revenue of the New York Islanders from 2005/06 to 2018/19 (in million U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Revenue in million U.S. dollars" .

:YAxis a :Axis ;
    :title "Year" .

:DataPoint1 a :DataPoint ;
    :xValue "115" ;
    :yValue "2018/19" ;
