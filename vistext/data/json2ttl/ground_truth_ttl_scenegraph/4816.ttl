@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Number of racially motivated hate crimes in England and Wales from April 2019 to March 2020 , by region" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Number of hate crimes*" .

:YAxis a :Axis ;
    :title "region" .

:DataPoint1 a :DataPoint ;
    :xValue "17.6" ;
    :yValue "London" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "5.46" ;
    :yValue "North West" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "10.51" ;
    :yValue "South East" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "9.45" ;
    :yValue "Yorkshire and the Humber" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "8.09" ;
    :yValue "West Midlands" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "6.7" ;
    :yValue "East of England" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "4.85" ;
    :yValue "South West" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "4.8" ;
    :yValue "East Midlands" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "3.06" ;
    :yValue "North East" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "2.62" ;
    :yValue "Wales" ;
    :belongsTo :Chart .
