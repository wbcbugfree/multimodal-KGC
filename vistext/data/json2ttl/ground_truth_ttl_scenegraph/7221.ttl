@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Number of LTE subscriptions worldwide from 2012 to 2024 , by region (in millions)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Latin America" .

:YAxis a :Axis ;
    :title "Year" .

:DataPoint1 a :DataPoint ;
    :xValue "454.1" ;
    :yValue "2024*" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "404.66" ;
    :yValue "2023*" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "323.49" ;
    :yValue "2022*" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "236.12" ;
    :yValue "2021*" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "148.46" ;
    :yValue "2020*" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "76.98" ;
    :yValue "2019*" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "34.53" ;
    :yValue "2018" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "12.18" ;
    :yValue "2017" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "3.96" ;
    :yValue "2016" ;
    :belongsTo :Chart .
