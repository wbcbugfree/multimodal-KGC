@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Number of furniture stores in Canada as of December 2019 , by province" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Number of stores" .

:YAxis a :Axis ;
    :title "province of Canada" .

:DataPoint1 a :DataPoint ;
    :xValue "1272" ;
    :yValue "Ontario" ;
    :belongsTo :Chart .

