@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Syria : National debt from 2000 to 2010 in relation to gross domestic product (GDP)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "National debt in relation to GDP" .

:DataPoint1 a :DataPoint ;
    :xValue "2010" ;
    :yValue "0.301" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "2009" ;
    :yValue "0.3129" ;
    :belongsTo :Chart .

