    :xValue "2007" ;
    :yValue "0.4278" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "2006" ;
    :yValue "0.451" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "2005" ;
    :yValue "0.5085" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "2004" ;
    :yValue "1.1335" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "2003" ;
    :yValue "1.3373" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
