@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Percentage of people with COVID-19 in the United States from January 22 to May 30 , 2020 who were hospitalized , by age" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Percentage of COVID-19 patients" .

:YAxis a :Axis ;
    :title "Response" .

:DataPoint1 a :DataPoint ;
    :xValue "0.041" ;
    :yValue "9 years or younger" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "0.025" ;
    :yValue "10 to 19 years" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "0.037" ;
    :yValue "20 to 29 years" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "0.059" ;
    :yValue "30 to 39 years" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "0.088" ;
    :yValue "40 to 49 years" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "0.134" ;
    :yValue "50 to 59 years" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "0.22" ;
    :yValue "60 to 69 years" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "0.341" ;
    :yValue "70 to 79 years" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "0" ;
    :yValue "80 years and older" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "0.14" ;
    :yValue "Total" ;
    :belongsTo :Chart .
