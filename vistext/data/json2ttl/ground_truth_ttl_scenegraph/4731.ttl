@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Top Google search queries in the United States in 2019 (index value)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Index rating" .

:YAxis a :Axis ;
    :title "Platform" .

