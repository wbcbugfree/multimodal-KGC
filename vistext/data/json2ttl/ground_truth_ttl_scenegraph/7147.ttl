@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Average weekly work hours of male vs. female physicians in Canada as of 2019 , by activity" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "activity" .

:YAxis a :Axis ;
    :title "Female" .

:DataPoint1 a :DataPoint ;
    :xValue "Direct patient care without a teaching component" ;
    :yValue "50" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Direct patient care with a teaching component" ;
    :yValue "50" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "Teaching/educating without direct patient care" ;
    :yValue "50" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "Indirect patient care" ;
    :yValue "50" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "Health facility committees" ;
    :yValue "50" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Administration" ;
    :yValue "50" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Research" ;
    :yValue "50" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Managing practice" ;
    :yValue "50" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "CME/CPD" ;
    :yValue "50" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "Other activities" ;
    :yValue "50" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "Total hours" ;
    :yValue "50" ;
    :belongsTo :Chart .
