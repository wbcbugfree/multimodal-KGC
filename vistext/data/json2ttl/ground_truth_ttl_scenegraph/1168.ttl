@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Installed power capacity across Tamil Nadu in India from financial year 2005 to 2018 (in megawatts)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Financial Year" .

:YAxis a :Axis ;
    :title "Installed power capacity in megawatts" .

:DataPoint1 a :DataPoint ;
    :xValue "FY 2018" ;
    :yValue "30326.63" ;
    :belongsTo :Chart .

