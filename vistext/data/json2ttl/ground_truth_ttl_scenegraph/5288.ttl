@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Annual salaries of selected heads of state and government leaders in 2010 (in U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "government leaders" .

:YAxis a :Axis ;
    :title "Annual salary (in U.S. dollars)" .

:DataPoint1 a :DataPoint ;
    :xValue "Lee Hsien Loong (Singapore)" ;
    :yValue "2181319" ;
    :belongsTo :Chart .

