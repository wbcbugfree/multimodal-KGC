@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Share of households with broadband internet access in Romania from 2006 to 2018" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Share of households" .

:YAxis a :Axis ;
    :title "Response" .

:DataPoint1 a :DataPoint ;
    :xValue "0.79" ;
    :yValue "2018" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "0.74" ;
    :yValue "2017" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "0.7" ;
    :yValue "2016" ;
    :belongsTo :Chart .

