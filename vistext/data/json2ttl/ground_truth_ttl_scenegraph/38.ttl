@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Quantity of roses sold in the U.S. from 2002 to 2018 (in 1,000 stems)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Sales in 1,000 stems" .

:DataPoint1 a :DataPoint ;
    :xValue "2002" ;
    :yValue "157673" ;
    :belongsTo :Chart .

