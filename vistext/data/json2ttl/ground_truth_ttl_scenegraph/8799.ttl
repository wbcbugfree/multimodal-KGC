@prefix : <http://example.org/> .

:Chart a :LineChart ;
    :title "Latin America and the Caribbean : Distribution of employment by economic sector from 2010 to 2020" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Industry" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2009" ;
    :yValue "0.2161" ;
    :belongsTo :Chart .

