@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Monthly number of unemployed persons in the U.S. from November 2019 to November 2020 (in millions , adjusted)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Month" .

:YAxis a :Axis ;
    :title "Number in millions" .

:DataPoint1 a :DataPoint ;
    :xValue "Nov '20" ;
    :yValue "10.72" ;
    :belongsTo :Chart .

