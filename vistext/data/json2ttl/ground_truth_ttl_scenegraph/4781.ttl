@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Consumption of tree nuts worldwide in 2018 , by type (in 1,000 metric tons)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Consumption in thousand metric tons" .

:YAxis a :Axis ;
    :title "type of nut" .

:DataPoint1 a :DataPoint ;
    :xValue "42543" ;
    :yValue "Peanut" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "1187.19" ;
    :yValue "Almond" ;
    :belongsTo :Chart .

