    :xValue "887.64" ;
    :yValue "Walnut" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "791.24" ;
    :yValue "Cashew" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "668.99" ;
    :yValue "Pistachio" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "423.6" ;
    :yValue "Hazelnut" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "125.4" ;
    :yValue "Pecan" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "50.34" ;
    :yValue "Macadamia" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "26.97" ;
    :yValue "Brazil Nut" ;
