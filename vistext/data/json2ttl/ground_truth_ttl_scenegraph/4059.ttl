    :xValue "Greens" ;
    :yValue "0.0765" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "Liberal Democrats" ;
    :yValue "0.0667" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Other parties GB" ;
    :yValue "0.0401" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "SNP" ;
    :yValue "0.024" ;
    :belongsTo :Chart .

