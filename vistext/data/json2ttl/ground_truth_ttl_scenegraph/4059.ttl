@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Results in the European Parliament elections in the United Kingdom (UK) in 2014 , by national party" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "Percentage of votes" .

:DataPoint1 a :DataPoint ;
    :xValue "UKIP" ;
    :yValue "0.2671" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "The Labour Party" ;
    :yValue "0.2468" ;
    :belongsTo :Chart .

