@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Number of road traffic fatalities in Greece from 2006 to 2019" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Number of fatalities" .

:DataPoint1 a :DataPoint ;
    :xValue "2019" ;
    :yValue "695" ;
    :belongsTo :Chart .

