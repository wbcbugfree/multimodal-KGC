@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Largest self-publishing companies in the United States in 2018 , by number of print books published" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Number of published titles" .

:YAxis a :Axis ;
    :title "company" .

:DataPoint1 a :DataPoint ;
    :xValue "1412617" ;
    :yValue "Amazon’s CreateSpace/Independently Published" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "37444" ;
    :yValue "Lulu Press, Inc.*" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "17633" ;
    :yValue "Blurb, Inc." ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "5266" ;
    :yValue "Xlibris (Div. of Author Solutions)" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "3806" ;
    :yValue "AuthorHouse (Div. of Author Solutions)" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "3136" ;
    :yValue "Christian Faith Publishing" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "2242" ;
    :yValue "Independent Publisher (Bar Code Graphics)" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "2202" ;
    :yValue "WestBow Press (imprint of Author Solutions)" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "2082" ;
    :yValue "Page Publishing, Inc." ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "1596" ;
    :yValue "Salem Author Services [formerly Xulon Press]" ;
    :belongsTo :Chart .
