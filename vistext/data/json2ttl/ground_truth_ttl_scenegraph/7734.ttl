@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Migration flow of foreign nationals in Spain from 2010 to 2019" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Inflow" .

:DataPoint1 a :DataPoint ;
    :xValue "2019" ;
    :yValue "309873" ;
    :belongsTo :Chart .

