@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Number of Burger King restaurants in the Asia Pacific region from 2012 to 2013 , by country or region" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Country" .

:YAxis a :Axis ;
    :title "2013" .

:DataPoint1 a :DataPoint ;
    :xValue "Australia" ;
    :yValue "371" ;
    :belongsTo :Chart .

