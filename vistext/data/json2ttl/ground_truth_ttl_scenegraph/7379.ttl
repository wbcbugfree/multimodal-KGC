@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Daily newspaper circulation in Canada in 2016 , by province (in 1,000s)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "province of Canada" .

:YAxis a :Axis ;
    :title "Weekly circulation" .

:DataPoint1 a :DataPoint ;
    :xValue "Ontario" ;
    :yValue "14779" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Quebec" ;
    :yValue "8031" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "British Columbia" ;
    :yValue "3118" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "Alberta" ;
    :yValue "2507" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "Manitoba" ;
    :yValue "1193" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Nova Scotia" ;
    :yValue "652" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "New Brunswick" ;
    :yValue "541" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Saskatchewan" ;
    :yValue "531" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "Newfoundland and Labrador" ;
    :yValue "16" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "Prince Edward Island" ;
    :yValue "11" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "Yukon Territories" ;
    :yValue "7" ;
    :belongsTo :Chart .
