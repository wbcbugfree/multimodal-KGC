@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Amount of money invested in sea port infrastructure in Turkey from 2004 to 2018 (in million euros)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Millions of euros invested" .

