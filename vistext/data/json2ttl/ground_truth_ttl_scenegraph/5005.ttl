@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Number of passenger cars sold in Pakistan from July 2008 to June 2019" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Month" .

:YAxis a :Axis ;
    :title "Number of cars" .

:DataPoint1 a :DataPoint ;
    :xValue "Jul 2018- Jun 2019" ;
    :yValue "207423" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Jul 2017- Jun 2018" ;
    :yValue "216569" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "Jul 2016- Jun 2017" ;
    :yValue "185596" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "Jul 2015- Jun 2016" ;
    :yValue "180964" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "Jul 2014- Jun 2015" ;
    :yValue "150984" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Jul 2013- Jun 2014" ;
    :yValue "117984" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Jul 2012- Jun 2013" ;
    :yValue "118711" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Jul 2011- Jun 2012" ;
    :yValue "157168" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "Jul 2010- Jun 2011" ;
    :yValue "127816" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "Jul 2009- Jun 2010" ;
    :yValue "123833" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "Jul 2008- Jun 2009" ;
    :yValue "82762" ;
