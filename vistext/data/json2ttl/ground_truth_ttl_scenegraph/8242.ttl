@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Distribution of municipal wastewater discharges treatment type in Canada as of 2017 , by province" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Country" .

:YAxis a :Axis ;
    :title "Tertiary treatment" .

:DataPoint1 a :DataPoint ;
    :xValue "Canada" ;
    :yValue "0.8" ;
    :belongsTo :Chart .

