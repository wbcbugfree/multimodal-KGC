@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Total number of magnetic resonance imaging (MRI) units in the United Kingdom (UK) from 2000 to 2014" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Number of scanners" .

:DataPoint1 a :DataPoint ;
    :xValue "2014* x None val" ;
    :yValue "4" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "2013*" ;
    :yValue "4" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "2012*" ;
    :yValue "4" ;
    :belongsTo :Chart .

