    :xValue "2008 *" ;
    :yValue "4" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "2006*" ;
    :yValue "4" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "2005" ;
    :yValue "4" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "2004" ;
    :yValue "4" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "2003 *" ;
    :yValue "4" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "2002 *" ;
    :yValue "4" ;
    :belongsTo :Chart .

:DataPoint12 a :DataPoint ;
