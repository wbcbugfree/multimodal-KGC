@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Monthly sales of girls ' _ , boys ' and infants ' clothing and accessories...s in Canada from January 2015 to April 2019 (in million Canadian dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Month" .

:YAxis a :Axis ;
    :title "2016" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec" ;
    :yValue "266.48" ;
    :belongsTo :Chart .

