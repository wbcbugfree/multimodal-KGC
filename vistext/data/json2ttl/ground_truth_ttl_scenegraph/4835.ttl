@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Turkey : Development of short-term annual interest rate from 2009 to 2018" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Short-term annual interest rate" .

:DataPoint1 a :DataPoint ;
    :xValue "2018" ;
    :yValue "0.0832" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "2017" ;
    :yValue "0.0887" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "2016" ;
    :yValue "0.1022" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "2015" ;
    :yValue "0.1094" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "2014" ;
    :yValue "0.1032" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "2013" ;
    :yValue "0.0692" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "2012" ;
    :yValue "0.0884" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "2011" ;
    :yValue "0.0875" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "201" ;
    :yValue "0.076" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "2009" ;
    :yValue "0.1013" ;
    :belongsTo :Chart .
