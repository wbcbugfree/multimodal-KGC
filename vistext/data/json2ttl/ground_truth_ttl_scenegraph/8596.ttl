@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Cost to deliver BBC radio services to individual users per user hour in the United Kingdom (UK) from 2015/16 to 2019/20 , by station (in pence)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "2018/19" .

:YAxis a :Axis ;
    :title "BBC radio stations" .

:DataPoint1 a :DataPoint ;
    :xValue "6" ;
    :yValue "BBC Radio 3" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "5" ;
    :yValue "BBC Asian Network" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "3" ;
    :yValue "BBC 1Xtra" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "3" ;
    :yValue "BBC Radio 5" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "2" ;
    :yValue "BBC Radio 4" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "1" ;
    :yValue "BBC Radio 4 extra" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "1" ;
    :yValue "BBC 6 Music" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "1" ;
    :yValue "BBC Radio 1" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "1" ;
    :yValue "BBC Radio 5 live sports extra" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "1" ;
