@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Percentage of leave and remain votes in selected major cities in the United Kingdom (UK) in the EU referendum in 2016" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Leave" .

:YAxis a :Axis ;
    :title "city" .

:DataPoint1 a :DataPoint ;
    :xValue "0.256" ;
    :yValue "Edinburgh" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "0.334" ;
    :yValue "Glasgow" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "0.396" ;
    :yValue "Manchester" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "0.4" ;
    :yValue "Cardiff" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "0.401" ;
    :yValue "London" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "0.418" ;
    :yValue "Liverpool" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "0.493" ;
    :yValue "Newcastle" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "0.497" ;
    :yValue "Leeds" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "0.503" ;
    :yValue "Birmingham" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "0.5094" ;
    :yValue "Sheffield" ;
    :belongsTo :Chart .
