@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Turnover from retail sale of food , beverages and tobacco in specialized stores in Croatia from 2008 to 2018 (in million euros)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Annual turnover in million euros" .

:DataPoint1 a :DataPoint ;
    :xValue "2018.025" ;
    :yValue "600" ;
    :belongsTo :Chart .

