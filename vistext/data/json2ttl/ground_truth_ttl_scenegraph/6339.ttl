@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Number of new passenger car registrations of leading car brands in France between 2016 and 2018 , by brand" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "leading car brands" .

:YAxis a :Axis ;
    :title "2018" .

