@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Percentage of preterm births in the United States from 1990 to 2018" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Percentage of all births" .

:YAxis a :Axis ;
    :title "Response" .

:DataPoint1 a :DataPoint ;
    :xValue "0.1" ;
    :yValue "2018" ;
    :belongsTo :Chart .

