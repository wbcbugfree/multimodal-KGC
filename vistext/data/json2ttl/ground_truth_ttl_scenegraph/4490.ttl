@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Leading coffee exporting countries worldwide in 2018 (in million U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Trade value in million U.S. dollars" .

:YAxis a :Axis ;
    :title "Country" .

