@prefix : <http://example.org/> .

:Chart a :BarChart ;
    :title "Number of pupils attending schools in Northern Ireland from 2010/11 to 2019/20" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Secondary" .

:YAxis a :Axis ;
    :title "Year" .

:DataPoint1 a :DataPoint ;
    :xValue "144699" ;
    :yValue "2019/20" ;
    :belongsTo :Chart .

