@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Transport of passengers during the coronavirus (COVID-19) epidemic in Poland from January to October 2020 , by type of transport (in 1,000s)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Month" .

:YAxis a :Axis ;
    :title "Air**" .

:DataPoint1 a :DataPoint ;
    :xValue "October" ;
    :yValue "224" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "September" ;
    :yValue "377" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "August" ;
    :yValue "556" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "July" ;
    :yValue "360" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "June" ;
    :yValue "28" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "May" ;
    :yValue "7" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "April" ;
    :yValue "13" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "March" ;
    :yValue "401" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "February" ;
    :yValue "857" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "January" ;
    :yValue "948" ;
    :belongsTo :Chart .
