@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Total resin production in the United States from 2009 to 2019 (in million pounds)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Production in million pounds" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2008" ;
    :yValue "98696" ;
    :belongsTo :Chart .

