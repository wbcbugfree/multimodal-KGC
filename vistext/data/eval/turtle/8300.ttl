@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Population of Belgium from 2009 to 2020 , by origin" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Foreign nationals" .

