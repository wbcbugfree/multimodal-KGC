@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Number of Vodafone employees worldwide from 2009 to 2020" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Number of employees" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2008" ;
    :yValue "79097" ;
    :belongsTo :Chart .

