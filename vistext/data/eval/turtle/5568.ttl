@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "ATM numbers in selected Western European countries as of June 2019" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Number of ATMs" .

:YAxis a :Axis ;
    :title "Country" .

