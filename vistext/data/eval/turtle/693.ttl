@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Top 20 Formula 1 drivers based on the number of championship points all-time from 1950 to 2021" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Number of championship points" .

:YAxis a :Axis ;
    :title "Formula 1 drivers" .

:DataPoint1 a :DataPoint ;
    :xValue "3778" ;
    :yValue "Hamilton , Lewis" ;
    :belongsTo :Chart .

