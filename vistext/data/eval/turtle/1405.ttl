@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Toronto Blue Jays all-time RBI (runs batted in) leaders as of October 2020" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Number of home runs" .

:YAxis a :Axis ;
    :title "Players" .

:DataPoint1 a :DataPoint ;
    :xValue "1058" ;
    :yValue "Carlos Delgado" ;
    :belongsTo :Chart .

