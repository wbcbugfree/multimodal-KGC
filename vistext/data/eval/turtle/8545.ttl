@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Voter support for Barack Obama and Mitt Romney in the 2012 election from May to October 28" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Three week rolling averages" .

:YAxis a :Axis ;
    :title "Romney" .

:DataPoint1 a :DataPoint ;
    :xValue "Oct 8 - Oct 28" ;
    :yValue "0.47" ;
    :belongsTo :Chart .

