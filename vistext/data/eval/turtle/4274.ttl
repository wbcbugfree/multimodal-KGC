@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Common equity tier 1 capital (CET1) ratio of selected large financial institutions in the United States as of Q2 2020" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Financial institution" .

:YAxis a :Axis ;
    :title "CET1 ratio" .

:DataPoint1 a :DataPoint ;
    :xValue "Morgan Stanley" ;
    :yValue "0.1654" ;
    :belongsTo :Chart .

