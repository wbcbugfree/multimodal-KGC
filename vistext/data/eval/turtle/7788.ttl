@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Carbon dioxide emissions from the manufacture of cement worldwide in 2000 and 2018 , by select country (in million metric tons)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "2018" .

:YAxis a :Axis ;
    :title "Country" .

