@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Number of men 's NCAA college basketball championships by team from 1939 to 2019" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "State" .

:YAxis a :Axis ;
    :title "Number of titles" .

