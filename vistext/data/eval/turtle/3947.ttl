@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Sales value of sausages and similar products of meat , meat offal or blood manufactured in the United Kingdom (UK) from 2008 to 2019 (in 1,000 GBP)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Sales value in thousand GBP" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2007" ;
    :yValue "838212" ;
    :belongsTo :Chart .

