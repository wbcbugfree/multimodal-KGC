@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Olive oil production in selected countries worldwide from 2011/2012 to 2018/2019 in 1,000 metric tons)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Country" .

:YAxis a :Axis ;
    :title "2018/2019" .

:DataPoint1 a :DataPoint ;
    :xValue "EU-27" ;
    :yValue "2240" ;
    :belongsTo :Chart .

