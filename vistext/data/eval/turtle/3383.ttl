@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Pharmaceutical company ranking based on general access to medicine management in developing countries in 2018" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Indicator score from 1 (lowest) to 5 (highest)" .

:YAxis a :Axis ;
    :title "Pharmaceutical company" .

