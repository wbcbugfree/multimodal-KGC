@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Market size for biomarkers in the United States from 2015 to 2024 , by condition (in million U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Oncology" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2014" ;
    :yValue "3600" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Dec 31, 2015" ;
    :yValue "3900" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "Dec 31, 2016" ;
    :yValue "4500" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "Dec 31, 2017" ;
    :yValue "5100" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "Dec 31, 2018" ;
    :yValue "5800" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Dec 31, 2019" ;
    :yValue "6600" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Dec 31, 2020" ;
    :yValue "7500" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Dec 31, 2021" ;
    :yValue "8600" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "Dec 31, 2022" ;
    :yValue "9900" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "Dec 31, 2023" ;
    :yValue "11400" ;
    :belongsTo :Chart .
