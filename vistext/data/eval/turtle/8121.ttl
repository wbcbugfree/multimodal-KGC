@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Online sales growth of fast-moving consumer goods (FMCG) in the view of the coronavirus (COVID-19) in Russia from February 3 to April 12 , 2020 , by product category" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Porridge/cereals" .

:YAxis a :Axis ;
    :title "Month" .

:DataPoint1 a :DataPoint ;
    :xValue "1.28" ;
    :yValue "Apr 6-12" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "1.77" ;
    :yValue "Mar 30-Apr 5" ;
    :belongsTo :Chart .

