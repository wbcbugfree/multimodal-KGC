    :xValue "2.36" ;
    :yValue "Mar 16-22" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "1.51" ;
    :yValue "Mar 9-15" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "1.5" ;
    :yValue "Mar 2-8" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "0.64" ;
    :yValue "Feb 24-Mar 1" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "0.44" ;
