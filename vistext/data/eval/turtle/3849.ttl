@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "U.S. adult support for legalizing marijuana from 1969 to 2019" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "Percentage of respondents" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 1968" ;
    :yValue "0.12" ;
    :belongsTo :Chart .

