@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Average temperature recorded in Italy from 1971 to 1980 and from 2011 to 2018 , by city (in degrees Celsius)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "city of Italy" .

:YAxis a :Axis ;
    :title "1971-1980" .

:DataPoint1 a :DataPoint ;
    :xValue "Palermo" ;
    :yValue "17.7" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Catania" ;
    :yValue "17.6" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "Bari" ;
    :yValue "15.7" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "Naples" ;
    :yValue "15.4" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "Genoa" ;
    :yValue "15.5" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Rome" ;
    :yValue "15.3" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Florence" ;
    :yValue "14.7" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Bologna" ;
    :yValue "13.6" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "Milan" ;
    :yValue "12.7" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "Turin" ;
    :yValue "11.3" ;
    :belongsTo :Chart .
