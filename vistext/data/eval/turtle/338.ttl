@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Number of cosmetics , beauty supplies and perfume stores in Canada as of December 2019 , by region" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "province of Canada" .

:YAxis a :Axis ;
    :title "Number of stores" .

:DataPoint1 a :DataPoint ;
    :xValue "Ontario" ;
    :yValue "816" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Quebec" ;
    :yValue "322" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "British Columbia" ;
    :yValue "296" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "Alberta" ;
    :yValue "248" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "Manitoba" ;
    :yValue "46" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Saskatchewan" ;
    :yValue "33" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Nova Scotia" ;
    :yValue "32" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "New Brunswick" ;
    :yValue "28" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "Newfoundland and Labrador" ;
    :yValue "20" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "Prince Edward Island" ;
    :yValue "9" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "Northwest Territories" ;
    :yValue "1" ;
    :belongsTo :Chart .
