@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Percentage of game developers working on selected game genres worldwide as of March 2019 , by type of employment" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "Employed" .

:DataPoint1 a :DataPoint ;
    :xValue "Action" ;
    :yValue "0.5" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Action Adventure" ;
    :yValue "0.27" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "Adventure" ;
    :yValue "0.17" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "Role playing" ;
    :yValue "0.32" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "Sports" ;
    :yValue "0.14" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Strategy" ;
    :yValue "0.27" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Simulation" ;
    :yValue "0.25" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Serious" ;
    :yValue "0.15" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "Casual" ;
    :yValue "0.3" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "Art" ;
    :yValue "0.07" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "Party" ;
    :yValue "0.07" ;
    :belongsTo :Chart .

:DataPoint12 a :DataPoint ;
    :xValue "Exercise" ;
    :yValue "0.03" ;
    :belongsTo :Chart .
