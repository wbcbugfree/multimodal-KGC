@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Which of the following popular U.S. professional sports do you most associate with positive moral values ?" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "18-34 years" .

:DataPoint1 a :DataPoint ;
    :xValue "Tennis" ;
    :yValue "0.25" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Golf" ;
    :yValue "0.2" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "Baseball" ;
    :yValue "0.26" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "Soccer" ;
    :yValue "0.23" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "Football" ;
    :yValue "0.2" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Mixed Martial Arts" ;
    :yValue "0.18" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Basketball" ;
    :yValue "0.21" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Auto Racing" ;
    :yValue "0.08" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "Hockey" ;
    :yValue "0.08" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "Boxing" ;
    :yValue "0.09" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "Wrestling" ;
    :yValue "0.04" ;
    :belongsTo :Chart .

:DataPoint12 a :DataPoint ;
    :xValue "Other" ;
    :yValue "0.02" ;
    :belongsTo :Chart .

:DataPoint13 a :DataPoint ;
    :xValue "I don't associate any U.S. professional sports with positive moral values" ;
    :yValue "0.2" ;
    :belongsTo :Chart .

:DataPoint14 a :DataPoint ;
    :xValue "Not sure" ;
    :yValue "0.08" ;
    :belongsTo :Chart .
