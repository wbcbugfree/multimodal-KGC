@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Number of high net worth individuals in the biggest metropolitan areas of the United States in 2014" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "State" .

:YAxis a :Axis ;
    :title "Number of HNWI" .

:DataPoint1 a :DataPoint ;
    :xValue "New York" ;
    :yValue "963000" ;
    :belongsTo :Chart .

