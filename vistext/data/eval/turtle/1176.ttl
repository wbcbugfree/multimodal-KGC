@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "12-month percent changes in the Producer Price Index for finished goods in the U.S. from November 2019 to November 2020" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "12-month percent change" .

:YAxis a :Axis ;
    :title "Month" .

:DataPoint1 a :DataPoint ;
    :xValue "-0.013" ;
    :yValue "Nov '20" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "-0.011" ;
    :yValue "Oct '20" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "-0.012" ;
    :yValue "Sep '20" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "-0.015" ;
    :yValue "Aug '20" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "-0.018" ;
    :yValue "Jul '20" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "-0.022" ;
    :yValue "Jun '20" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "-0.028" ;
    :yValue "May '20" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "-0.051" ;
    :yValue "Apr '20" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "-0.009" ;
    :yValue "Mar '20" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "0.012" ;
    :yValue "Feb '20" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "0.025" ;
    :yValue "Jan '20" ;
    :belongsTo :Chart .

:DataPoint12 a :DataPoint ;
    :xValue "0.019" ;
    :yValue "Dec '19" ;
    :belongsTo :Chart .

:DataPoint13 a :DataPoint ;
    :xValue "0.011" ;
    :yValue "Nov '19" ;
    :belongsTo :Chart .
