@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "The 10 most valuable corporate brands in Europe in 2019 (in billion euros)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Brand value in billion euros" .

:YAxis a :Axis ;
    :title "Corporate brand" .

