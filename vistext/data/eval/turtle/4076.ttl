    :xValue "Malaysia Smelting Corporation (Malaysia)" ;
    :yValue "27.2" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "Yunnan Chengfeng (China)" ;
    :yValue "26.8" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "Minsur (Peru)" ;
    :yValue "18" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "EM Vinto (Bolivia)" ;
    :yValue "12.6" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Guangxi China Tin (China)" ;
    :yValue "11.5" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Thaisarco (Thailand)" ;
