@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Leading tin producing companies worldwide in 2017 , based on production output (in 1,000 metric tons)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Tin producing company" .

:YAxis a :Axis ;
    :title "Production output in thousand metric tons" .

:DataPoint1 a :DataPoint ;
    :xValue "Yunnan Tin (China)" ;
    :yValue "74.5" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "PT Timah (Indonesia)" ;
    :yValue "30.2" ;
    :belongsTo :Chart .

