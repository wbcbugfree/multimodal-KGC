@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Public sector net debt (PSNDex) in the United Kingdom (UK) from March 2005 to June 2019 (in billion GBP)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Month" .

:YAxis a :Axis ;
    :title "PSNDex in billion GBP" .

:DataPoint1 a :DataPoint ;
    :xValue "Feb 28, 2005" ;
    :yValue "447" ;
    :belongsTo :Chart .

