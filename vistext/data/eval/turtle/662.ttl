@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Cherry production worldwide from 2000 to 2018 (in million metric tons)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Million metric tons" .

