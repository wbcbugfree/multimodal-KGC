@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Leading retail and consumer merchandise brands on Twitter as of July 2018 , by followers (in millions)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "retail and consumer merchandise brands" .

:YAxis a :Axis ;
    :title "Twitter fans in millions" .

:DataPoint1 a :DataPoint ;
    :xValue "Google Play" ;
    :yValue "6.87" ;
    :belongsTo :Chart .

