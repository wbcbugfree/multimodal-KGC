@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Largest Dominican-American population groups in the United States , by county 2010" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Population number" .

:YAxis a :Axis ;
    :title "county" .

:DataPoint1 a :DataPoint ;
    :xValue "240987" ;
    :yValue "Bronx County, NY" ;
    :belongsTo :Chart .

