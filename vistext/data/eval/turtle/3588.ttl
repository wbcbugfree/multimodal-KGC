@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Number of practicing nurses employed in Germany from 2000 to 2018 (in 1,000s)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Number of employees in thousands" .

:DataPoint1 a :DataPoint ;
    :xValue "2018*" ;
    :yValue "1096" ;
    :belongsTo :Chart .

