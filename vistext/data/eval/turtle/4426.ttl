@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Which of the following issues do you think politicians should talk about most between now and the next general election ?" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "Share of respondents" .

:DataPoint1 a :DataPoint ;
    :xValue "Immigration" ;
    :yValue "0.5" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "NHS" ;
    :yValue "0.48" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "European Union" ;
    :yValue "0.26" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "Economic growth" ;
    :yValue "0.26" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "Living standards" ;
    :yValue "0.25" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Welfare benefits" ;
    :yValue "0.22" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Education" ;
    :yValue "0.14" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Inequality" ;
    :yValue "0.13" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "Tax" ;
    :yValue "0.1" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "Housing" ;
    :yValue "0.09" ;
    :belongsTo :Chart .
