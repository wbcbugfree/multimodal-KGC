@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Geographical distribution of smartwatch companies in 2013 , by country" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Distribution share" .

:YAxis a :Axis ;
    :title "Country" .

:DataPoint1 a :DataPoint ;
    :xValue "0.26" ;
    :yValue "China" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "0.25" ;
    :yValue "United States" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "0.08" ;
    :yValue "Taiwan" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "0.07" ;
    :yValue "Japan" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "0.07" ;
    :yValue "Switzerland" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "0.05" ;
    :yValue "Finland" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "0.05" ;
    :yValue "South Korea" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "0.04" ;
    :yValue "Canada" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "0.03" ;
    :yValue "Germany" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "0.03" ;
    :yValue "Italy" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "0.07" ;
    :yValue "Other" ;
    :belongsTo :Chart .
