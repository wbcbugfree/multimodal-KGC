@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Number of practical driving tests taken and passed in the United Kingdom (UK) from 2007/08 to 2019/20" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Tests passed" .

