@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Number of smartphone users in Germany from January 2009 to 2019 (in millions)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Smartphone users in millions" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2008" ;
    :yValue "6.31" ;
    :belongsTo :Chart .

