@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Average wait times for U.S. physician appointments in select cities as of 2013 , by specialty (in days)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "Orthopedic surgery" .

:DataPoint1 a :DataPoint ;
    :xValue "Atlanta" ;
    :yValue "6" ;
    :belongsTo :Chart .

