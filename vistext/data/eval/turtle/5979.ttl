@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Share of Google in the mobile search engine market across India from April 2019 to May 2020" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Month" .

:YAxis a :Axis ;
    :title "Market share" .

:DataPoint1 a :DataPoint ;
    :xValue "Mar 31, 2019" ;
    :yValue "0.982" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Apr 30, 2019" ;
    :yValue "0.9838" ;
    :belongsTo :Chart .

