@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Most valuable Swiss watch brands worldwide in 2016 (in million CHF)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Brand" .

:YAxis a :Axis ;
    :title "Brand value in million CHF" .

:DataPoint1 a :DataPoint ;
    :xValue "Rolex" ;
    :yValue "7387" ;
    :belongsTo :Chart .

