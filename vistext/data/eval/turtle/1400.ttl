@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Global telecom industry priority investment areas according to industry professionals in 2020" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Share of respondents" .

:YAxis a :Axis ;
    :title "Response" .

:DataPoint1 a :DataPoint ;
    :xValue "0.66" ;
    :yValue "5G" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "0.49" ;
    :yValue "Internet of Things (IoT)" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "0.46" ;
    :yValue "Cloud" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "0.44" ;
    :yValue "Digital transformation" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "0.41" ;
    :yValue "Artificial intelligence/Machine learning" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "0.2" ;
    :yValue "BSS/OSS" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "0.08" ;
    :yValue "Other" ;
    :belongsTo :Chart .
