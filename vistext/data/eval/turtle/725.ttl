@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Global wheat production from 2011/2012 to 2019/2020 (in million metric tons)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Production in million metric tons" .

:DataPoint1 a :DataPoint ;
    :xValue "2019/2020" ;
    :yValue "765.41" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "2018/2019" ;
    :yValue "731.45" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "2017/2018" ;
    :yValue "762.88" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "2016/2017" ;
    :yValue "752" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "2015/2016" ;
    :yValue "735.9" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "2014/2015" ;
    :yValue "728.3" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "2013/2014" ;
    :yValue "717" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "2012/2013" ;
    :yValue "655" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "2011/2012" ;
    :yValue "697" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "2000/2001" ;
    :yValue "582" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "1990/1991" ;
    :yValue "592" ;
    :belongsTo :Chart .
