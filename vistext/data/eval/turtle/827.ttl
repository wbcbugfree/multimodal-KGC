@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Countries with the highest growth of TikTok downloads from the Google Play store in September 2020" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Country" .

:YAxis a :Axis ;
    :title "Growth compared to previous month" .

:DataPoint1 a :DataPoint ;
    :xValue "UAE" ;
    :yValue "0.155" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Argentina" ;
    :yValue "0.147" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "Pakistan" ;
    :yValue "0.128" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "Sri Lanka" ;
    :yValue "0.088" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "Egypt" ;
    :yValue "0.083" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Peru" ;
    :yValue "0.047" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "South Africa" ;
    :yValue "0.029" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Turkey" ;
    :yValue "0" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "Germany" ;
    :yValue "-0.036" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "Ecuador" ;
    :yValue "-0.038" ;
    :belongsTo :Chart .
