@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Market readiness score of selected European countries in terms of mobile health care in 2015" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Country" .

:YAxis a :Axis ;
    :title "Market readiness score" .

:DataPoint1 a :DataPoint ;
    :xValue "Denmark" ;
    :yValue "0.75" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Sweden" ;
    :yValue "0.66" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "Finland" ;
    :yValue "0.66" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "Spain" ;
    :yValue "0.65" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "Netherlands" ;
    :yValue "0.65" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "UK" ;
    :yValue "0.63" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Belgium" ;
    :yValue "0.54" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Italy" ;
    :yValue "0.48" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "France" ;
    :yValue "0.47" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "Portugal" ;
    :yValue "0.46" ;
    :belongsTo :Chart .
