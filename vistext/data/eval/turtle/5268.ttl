@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Leading cinema circuits in the United States and in Canada as of February 2020 , by number of screens" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "cinema chain" .

:YAxis a :Axis ;
    :title "Number of screens" .

:DataPoint1 a :DataPoint ;
    :xValue "AMC Theatres" ;
    :yValue "8043" ;
    :belongsTo :Chart .

