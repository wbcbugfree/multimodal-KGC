@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Leading countries based on natural gas production in 2014 and 2018 (in billion cubic meters)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "2018" .

:YAxis a :Axis ;
    :title "Country" .

:DataPoint1 a :DataPoint ;
    :xValue "863" ;
    :yValue "United States" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "725.5" ;
    :yValue "Russia" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "248.5" ;
    :yValue "Iran" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "181.6" ;
    :yValue "Qatar" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "176" ;
    :yValue "China" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "172.7" ;
    :yValue "Canada" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "131.1" ;
    :yValue "Australia" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "119.2" ;
    :yValue "Norway" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "112.1" ;
    :yValue "Saudi Arabia" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "95.9" ;
    :yValue "Algeria" ;
    :belongsTo :Chart .
