@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "PC and console games revenue worldwide from 2012 to 2022 , by type (in billion U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Full game" .

:DataPoint1 a :DataPoint ;
    :xValue "2022*" ;
    :yValue "11" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "2021*" ;
    :yValue "11" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "2020*" ;
    :yValue "10" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "2019*" ;
    :yValue "9" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "2018*" ;
    :yValue "8" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "2017" ;
    :yValue "8" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "2016" ;
    :yValue "8" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "2015" ;
    :yValue "7" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "2014" ;
    :yValue "6" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "2013" ;
    :yValue "5" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "2012" ;
    :yValue "5" ;
    :belongsTo :Chart .
