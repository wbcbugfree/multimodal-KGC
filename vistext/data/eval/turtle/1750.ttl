@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Average total income per retired household in the United Kingdom in 2017/18 , by decile (in GBP)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Total income in GBP" .

:YAxis a :Axis ;
    :title "Decile" .

:DataPoint1 a :DataPoint ;
    :xValue "53632" ;
    :yValue "Top" ;
    :belongsTo :Chart .

