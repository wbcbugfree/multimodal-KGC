@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Total volume of wine exported from Portugal from 1986 to 2018 (millions of hectoliters)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Volume of exports in millions of hectolitres" .

:DataPoint1 a :DataPoint ;
    :xValue "2018" ;
    :yValue "3" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "2017" ;
    :yValue "3" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "2016" ;
    :yValue "2.8" ;
    :belongsTo :Chart .

