@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Reasons that keep people from leisure travel in the United States from 2011 to 2018" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "Gasoline prices" .

:DataPoint1 a :DataPoint ;
    :xValue "Jun 30, 2011" ;
    :yValue "0.54" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Dec 31, 2011" ;
    :yValue "0.46" ;
    :belongsTo :Chart .

