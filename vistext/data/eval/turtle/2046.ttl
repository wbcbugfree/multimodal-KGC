@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Number of employees in the health and social care industry in Ireland from 2000 to 2018 (in 1,000)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Number of employees in thousands" .

:YAxis a :Axis ;
    :title "Year" .

