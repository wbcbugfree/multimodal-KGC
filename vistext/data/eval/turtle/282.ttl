@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Prescription and illegal drug sales on the dark web from December 2013 to July 2015 (in million U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Dark web sales in million U.S. dollars" .

:YAxis a :Axis ;
    :title "Prescription and illegal drug" .

:DataPoint1 a :DataPoint ;
    :xValue "27" ;
    :yValue "Illegal drugs" ;
    :belongsTo :Chart .

