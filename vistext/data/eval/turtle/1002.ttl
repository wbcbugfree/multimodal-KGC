@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "How much influence , if any , does society have on your future happiness ?" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Share of respondents" .

:YAxis a :Axis ;
    :title "Response" .

:DataPoint1 a :DataPoint ;
    :xValue "0.02" ;
    :yValue "9.975" ;
    :belongsTo :Chart .

