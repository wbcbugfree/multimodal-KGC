    :xValue "Carapelli" ;
    :yValue "0.073" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Dante" ;
    :yValue "0.042" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "De Cecco" ;
    :yValue "0.04" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Farchioni" ;
    :yValue "0.04" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "Sasso" ;
    :yValue "0.035" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "Sagra" ;
    :yValue "0.03" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "Desantis" ;
    :yValue "0.025" ;
    :belongsTo :Chart .

:DataPoint12 a :DataPoint ;
    :xValue "Filippo Berio" ;
