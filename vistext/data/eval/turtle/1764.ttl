@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Market shares of olive oil brands in Italy as of 2015 , by brand" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Olive Oil Brand" .

:YAxis a :Axis ;
    :title "Market share" .

:DataPoint1 a :DataPoint ;
    :xValue "Private label" ;
    :yValue "0.208" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Monini" ;
    :yValue "0.102" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "Bertolli" ;
    :yValue "0.084" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "Olio Carli" ;
    :yValue "0.082" ;
    :belongsTo :Chart .

