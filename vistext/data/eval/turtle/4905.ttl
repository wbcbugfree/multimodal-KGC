@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Number of hospitals in the Netherlands from 2005 to 2018" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Number of hospitals" .

:YAxis a :Axis ;
    :title "Year" .

