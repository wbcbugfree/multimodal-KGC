@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Ranking of YouTube gaming channels in France as of June 2018 , by number of subscribers (in thousands)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Number of subscribers in thousands" .

:YAxis a :Axis ;
    :title "YouTube gaming channel" .

