@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Per capita consumption of non-alcoholic beverages in the European Union (EU) from 2010 to 2019 (in liters per capita)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Liters consumed per capita" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2009" ;
    :yValue "238.2" ;
    :belongsTo :Chart .

