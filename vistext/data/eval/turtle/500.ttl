@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Market share of mobile phone brands in the United Kingdom (UK) in 2015" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Share of respondents" .

:YAxis a :Axis ;
    :title "Response" .

:DataPoint1 a :DataPoint ;
    :xValue "0.31" ;
    :yValue "Samsung" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "0.22" ;
    :yValue "Apple" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "0.21" ;
    :yValue "Nokia" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "0.12" ;
    :yValue "Other" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "0.1" ;
    :yValue "Sony Ericsson" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "0.05" ;
    :yValue "LG" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "0.05" ;
    :yValue "Blackberry" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "0.05" ;
    :yValue "Motorola" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "0.01" ;
    :yValue "BenQ-Siemens" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "0.01" ;
    :yValue "Panasonic" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "0.01" ;
    :yValue "HTC" ;
    :belongsTo :Chart .

:DataPoint12 a :DataPoint ;
    :xValue "0.01" ;
    :yValue "Philips" ;
    :belongsTo :Chart .

:DataPoint13 a :DataPoint ;
    :xValue "0.01" ;
    :yValue "I don't have a mobile phone" ;
    :belongsTo :Chart .
