@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Breakdown of Johnson & Johnson 's revenue worldwide from 2013 to 2021 , by sub-category" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Sub-category" .

:YAxis a :Axis ;
    :title "2015" .

:DataPoint1 a :DataPoint ;
    :xValue "DePuy orthopedics & spine*" ;
    :yValue "0.133" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Surgical devices*" ;
    :yValue "0.137" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "Stents, catheters & other medical devices*" ;
    :yValue "0.102" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "Procrit, Velcade & other**" ;
    :yValue "0.144" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "Remicade & immunology**" ;
    :yValue "0.138" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Central nervous system**" ;
    :yValue "0.0772" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Anti-infectives**" ;
    :yValue "0.0702" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "OTC drugs & nutritionals***" ;
    :yValue "0.0547" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "Women's health, wound & oral care***" ;
    :yValue "0.0634" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "Neutrogena, Aveena & other skin care***" ;
    :yValue "0.0513" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "Baby care***" ;
    :yValue "0.03" ;
    :belongsTo :Chart .
