@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Average (mean) private weekly rent in England from 2008/2009 to 2018/2019 (in GBP)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "England" .

:DataPoint1 a :DataPoint ;
    :xValue "2018/19" ;
    :yValue "200" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "2017/18" ;
    :yValue "193" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "2016/17" ;
    :yValue "192" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "2015/16" ;
    :yValue "184" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "2014/15" ;
    :yValue "179" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "2013/14" ;
    :yValue "176" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "2012/13" ;
    :yValue "163" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "2011/12" ;
    :yValue "164" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "2010/11" ;
    :yValue "160" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "2009/10" ;
    :yValue "156" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "2008/09" ;
    :yValue "153" ;
    :belongsTo :Chart .
