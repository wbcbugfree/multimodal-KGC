@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Percentage of dedicated biotech companies in selected countries in 2014 , by application" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Industrial processing" .

:YAxis a :Axis ;
    :title "Country" .

:DataPoint1 a :DataPoint ;
    :xValue "0.172" ;
    :yValue "New Zealand" ;
    :belongsTo :Chart .

