@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Denso 's research and development expenses from FY 2008 to FY 2020 (in billion Japanese yen)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Expenses in billion Japanese yen" .

