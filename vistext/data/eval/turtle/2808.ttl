@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Coronavirus (COVID-19) death rate in Italy as of December 29 , 2020 , by age group" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Mortality rate" .

:YAxis a :Axis ;
    :title "Year" .

:DataPoint1 a :DataPoint ;
    :xValue "0" ;
    :yValue "0-9 years" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "0" ;
    :yValue "10-19 years" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "0" ;
    :yValue "20-29 years" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "0.001" ;
    :yValue "30-39 years" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "0.002" ;
    :yValue "40-49 years" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "0.006" ;
    :yValue "50-59 years" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "0.03" ;
    :yValue "60-69 years" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "0.102" ;
    :yValue "70-79 years" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "0.195" ;
    :yValue "80-89 years" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "0.243" ;
    :yValue "90 years and older" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "0.035" ;
    :yValue "Total" ;
    :belongsTo :Chart .
