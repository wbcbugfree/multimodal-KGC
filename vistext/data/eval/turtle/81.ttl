    :xValue "35.73" ;
    :yValue "Q3 '14" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "35.98" ;
    :yValue "Q2 '14" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "38.56" ;
    :yValue "Q1 '14" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "39.59" ;
    :yValue "Q4 '13" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
