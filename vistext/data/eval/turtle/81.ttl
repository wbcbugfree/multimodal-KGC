@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Rakuten Ichiba 's sales from 1st quarter 2013 to 2nd quarter 2015 (in billion yen)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Value in billion yen" .

:YAxis a :Axis ;
    :title "Quarter" .

:DataPoint1 a :DataPoint ;
    :xValue "37.97" ;
    :yValue "Q2 '15" ;
    :belongsTo :Chart .

