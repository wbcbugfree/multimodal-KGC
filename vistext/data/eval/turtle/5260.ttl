@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Global consumption volume of cocoa in 2016 , by region (in 1,000 metric tons)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Country" .

:YAxis a :Axis ;
    :title "Consumption in thousand metric tons" .

:DataPoint1 a :DataPoint ;
    :xValue "Europe" ;
    :yValue "1852" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "US" ;
    :yValue "732" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "Rest of Asia" ;
    :yValue "351" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "Rest of America" ;
    :yValue "333" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "Brasil" ;
    :yValue "189" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Japan" ;
    :yValue "176" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Africa" ;
    :yValue "154" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "China" ;
    :yValue "82" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "Australia" ;
    :yValue "76" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "India" ;
    :yValue "46" ;
    :belongsTo :Chart .
