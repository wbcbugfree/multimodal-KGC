@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Total assets of the Italian banking system from 2008 to the first half of 2017 (in billion euros)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Total assets in billion euros" .

:DataPoint1 a :DataPoint ;
    :xValue "2017" ;
    :yValue "3915.101" ;
    :belongsTo :Chart .

