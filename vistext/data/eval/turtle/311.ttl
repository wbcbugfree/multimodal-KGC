@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Share of households receiving benefits in the United Kingdom (UK) in 2018/19 , by region" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Share of households" .

:YAxis a :Axis ;
    :title "Response" .

:DataPoint1 a :DataPoint ;
    :xValue "0.58" ;
    :yValue "Northern Ireland" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "0.58" ;
    :yValue "North East" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "0.57" ;
    :yValue "Wales" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "0.56" ;
    :yValue "West Midlands" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "0.55" ;
    :yValue "North West" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "0.55" ;
    :yValue "Yorkshire and The Humber" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "0.53" ;
    :yValue "East Midlands" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "0.53" ;
    :yValue "South West" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "0.53" ;
    :yValue "Scotland" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "0.51" ;
    :yValue "East of England" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "0.5" ;
    :yValue "South East" ;
    :belongsTo :Chart .

:DataPoint12 a :DataPoint ;
    :xValue "0.37" ;
    :yValue "London" ;
    :belongsTo :Chart .
