@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Number of murder victims in the United States in 2019 , by age" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Age of victim in years" .

:YAxis a :Axis ;
    :title "Number of murder victims" .

