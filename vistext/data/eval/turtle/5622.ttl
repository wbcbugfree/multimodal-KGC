@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Brand value growth worldwide in 2020 , by sector" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "industry" .

:YAxis a :Axis ;
    :title "Year-on-year growth" .

:DataPoint1 a :DataPoint ;
    :xValue "Retail" ;
    :yValue "0.21" ;
    :belongsTo :Chart .

