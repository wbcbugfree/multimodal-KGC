@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "African-American fertility rate in the United States in 2014 , by region (births per 1,000 women)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Number of births per 1,000 women" .

:YAxis a :Axis ;
    :title "region" .

:DataPoint1 a :DataPoint ;
    :xValue "80.3" ;
    :yValue "West North Central" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "69.7" ;
    :yValue "Mountain" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "69.1" ;
    :yValue "East North Central" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "67" ;
    :yValue "West South Central" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "64" ;
    :yValue "U.S." ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "64" ;
    :yValue "East South Central" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "62.3" ;
    :yValue "South Atlantic" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "59" ;
    :yValue "New England" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "58.9" ;
    :yValue "Middle Atlantic" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "57" ;
    :yValue "Pacific" ;
    :belongsTo :Chart .
