    :yValue "6914" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Rony Seikaly" ;
    :yValue "6742" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
