@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Miami Heat all-time points leaders from 1988 to 2020" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Basketball player" .

:YAxis a :Axis ;
    :title "Points scored" .

:DataPoint1 a :DataPoint ;
    :xValue "Dwyane Wade" ;
    :yValue "21556" ;
    :belongsTo :Chart .

