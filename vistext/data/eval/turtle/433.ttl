@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Chicago Cubs all-time RBI (runs batted in) leaders as of October 2020" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Chicago Cubs all-time RBI leaders" .

:YAxis a :Axis ;
    :title "Number of home runs" .

:DataPoint1 a :DataPoint ;
    :xValue "Cap Anson" ;
    :yValue "1880" ;
    :belongsTo :Chart .

