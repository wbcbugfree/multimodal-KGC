@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Super Bowls won by NFL team from 1967 to 2020" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Super Bowl wins" .

:YAxis a :Axis ;
    :title "American football team" .

