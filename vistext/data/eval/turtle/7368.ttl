@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Racial structure of the population in the largest metropolitan areas in the U.S. 2009" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "largest metropolitan areas in the U\\.S\\." .

:YAxis a :Axis ;
    :title "Black or African American alone" .

