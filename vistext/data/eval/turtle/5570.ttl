@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Number of passenger cars produced by General Motors worldwide from 1999 to 2014 (in millions)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Passenger cars produced (in millions)" .

