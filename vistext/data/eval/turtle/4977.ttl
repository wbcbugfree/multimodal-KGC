@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Value per head of sheep and lambs in the U.S. from 2001 to 2018 (in U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Value per head in U.S. dollars" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2000" ;
    :yValue "100" ;
    :belongsTo :Chart .

