@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Turkey : Poverty headcount ratio from 2008 to 2018" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "Share of population" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2007" ;
    :yValue "0.171" ;
    :belongsTo :Chart .

