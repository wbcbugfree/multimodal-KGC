@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Average sales price of new homes sold in the U.S. from 1965 to 2019 (in 1,000 U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Sales price in thousand U.S. dollars" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 1964" ;
    :yValue "21" ;
    :belongsTo :Chart .

