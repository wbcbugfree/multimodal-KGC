@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Number of mobile internet users in the United Kingdom (UK) from third quarter 2013 to second quarter 2016 (in million users)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Quarter" .

:YAxis a :Axis ;
    :title "Users in millions" .

:DataPoint1 a :DataPoint ;
    :xValue "Q2 2016*" ;
    :yValue "42.77" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Q1 2016*" ;
    :yValue "42.03" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "Q4 2015*" ;
    :yValue "41.27" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "Q3 2015*" ;
    :yValue "40.36" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "Q2 2015" ;
    :yValue "39.56" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Q1 2015" ;
    :yValue "38.7" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Q4 2014" ;
    :yValue "37.82" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Q3 2014" ;
    :yValue "36.73" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "Q2 2014" ;
    :yValue "35.78" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "Q1 2014" ;
    :yValue "34.75" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "Q4 2013" ;
