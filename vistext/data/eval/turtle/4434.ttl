@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Cities with the largest number of skateboard parks per 100,000 residents in the United States in 2019" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Skateboard parks per 100,000 residents" .

:YAxis a :Axis ;
    :title "city of the United States" .

