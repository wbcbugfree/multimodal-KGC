@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Number of companies in the IT sector in Germany from 2008 to 2018" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "IT hardware" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2007" ;
    :yValue "3954" ;
    :belongsTo :Chart .

