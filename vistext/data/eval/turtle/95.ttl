@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Lebanon : Total population from 2014 to 2024 (in million inhabitants)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Inhabitants in millions" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2013" ;
    :yValue "5.6" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Dec 31, 2014" ;
    :yValue "5.85" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "Dec 31, 2015" ;
    :yValue "6.01" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "Dec 31, 2016" ;
    :yValue "6.08" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "Dec 31, 2017" ;
    :yValue "6.09" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Dec 31, 2018" ;
    :yValue "6.07" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Dec 31, 2019" ;
    :yValue "6.02" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Dec 31, 2020" ;
    :yValue "5.96" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "Dec 31, 2021" ;
    :yValue "5.88" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "Dec 31, 2022" ;
    :yValue "5.78" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "Dec 31, 2023" ;
    :yValue "5.69" ;
    :belongsTo :Chart .
