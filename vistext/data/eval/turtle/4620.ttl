@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Most popular mobile apps used in South Africa as of February 2020 , by reach" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "Share of respondents" .

:DataPoint1 a :DataPoint ;
    :xValue "WhatsApp" ;
    :yValue "0.58" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Uber" ;
    :yValue "0.5" ;
    :belongsTo :Chart .

