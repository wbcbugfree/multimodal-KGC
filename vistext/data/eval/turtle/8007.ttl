@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Preferred number of TV show episodes to watch in one binge watching session among Generation X and Baby Boomers in the United Kingdom (UK) in December 2016" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "40-59 years" .

:YAxis a :Axis ;
    :title "Response" .

:DataPoint1 a :DataPoint ;
    :xValue "0.03" ;
    :yValue "1 episode" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "0.11" ;
    :yValue "2 episodes" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "0.2" ;
    :yValue "3 episodes" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "0.15" ;
    :yValue "4 episodes" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "0.1" ;
    :yValue "5 episodes" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "0.09" ;
    :yValue "6 episodes" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "0.03" ;
    :yValue "7 episodes" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "0.04" ;
    :yValue "8 episodes" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "0" ;
    :yValue "9 episodes" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "0.02" ;
    :yValue "10 episodes" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "0.06" ;
    :yValue "More than 10 episodes" ;
    :belongsTo :Chart .

:DataPoint12 a :DataPoint ;
    :xValue "0.17" ;
    :yValue "Don't know" ;
    :belongsTo :Chart .
