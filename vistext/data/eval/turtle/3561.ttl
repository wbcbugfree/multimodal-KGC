@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Most instagrammed tourist attractions within Europe as of May 2017 , by number of tags" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Number of tags" .

:YAxis a :Axis ;
    :title "Most instagrammed tourist attractions" .

:DataPoint1 a :DataPoint ;
    :xValue "7253011" ;
    :yValue "Eiffel Tower (Paris)" ;
    :belongsTo :Chart .

