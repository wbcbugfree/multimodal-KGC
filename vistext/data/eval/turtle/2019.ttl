@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Forecast volume of beef and veal produced in the European Union (EU 28) from 2015 to 2028 (in 1,000 tonnes)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Volume in thousand tonnes" .

:DataPoint1 a :DataPoint ;
    :xValue "2028*" ;
    :yValue "6826" ;
    :belongsTo :Chart .

