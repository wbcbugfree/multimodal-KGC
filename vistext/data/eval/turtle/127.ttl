@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Bath fixtures and accessories brands used the most by construction firms in the United States in 2018" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Share of respondents" .

:YAxis a :Axis ;
    :title "Brand" .

:DataPoint1 a :DataPoint ;
    :xValue "0.288" ;
    :yValue "Kohler" ;
    :belongsTo :Chart .

