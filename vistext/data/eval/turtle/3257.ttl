@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Total passenger traffic at Mumbai Port in India from financial year 2008 to 2019 (in 1,000s)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "year" .

:YAxis a :Axis ;
    :title "Passenger traffic in thousands" .

:DataPoint1 a :DataPoint ;
    :xValue "FY 2019" ;
    :yValue "48.9" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "FY 2018" ;
    :yValue "21.5" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "FY 2017" ;
    :yValue "17.4" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "FY 2016" ;
    :yValue "3.2" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "FY 2015" ;
    :yValue "7.9" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "FY 2014" ;
    :yValue "3" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "FY 2013" ;
    :yValue "5.6" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "FY 2012" ;
    :yValue "4.7" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "FY 2011" ;
    :yValue "15.9" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "FY 2010" ;
    :yValue "64.4" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "FY 2009" ;
    :yValue "28.6" ;
    :belongsTo :Chart .

:DataPoint12 a :DataPoint ;
    :xValue "FY 2008" ;
    :yValue "162.4" ;
    :belongsTo :Chart .
