@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "What do you think are the two most important issues facing the Netherlands at the moment ?" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Issue" .

:YAxis a :Axis ;
    :title "Share of respondents" .

:DataPoint1 a :DataPoint ;
    :xValue "The environment, climate and energy issues" ;
    :yValue "0.66" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Health and social security" ;
    :yValue "0.31" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "The education system" ;
    :yValue "0.25" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "Crime" ;
    :yValue "0.15" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "Housing" ;
    :yValue "0.15" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Pensions" ;
    :yValue "0.14" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Immigration" ;
    :yValue "0.13" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Rising prices/inflation/cost of living" ;
    :yValue "0.09" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "Economic situation" ;
    :yValue "0.05" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "Terrorism" ;
    :yValue "0.04" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "Taxation" ;
    :yValue "0.01" ;
    :belongsTo :Chart .

:DataPoint12 a :DataPoint ;
    :xValue "Unemployment" ;
    :yValue "0.01" ;
    :belongsTo :Chart .

:DataPoint13 a :DataPoint ;
    :xValue "Government debt" ;
    :yValue "0" ;
    :belongsTo :Chart .
