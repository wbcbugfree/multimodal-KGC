@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Number of lives lost due to floods and flash floods in the U.S. from 1995 to 2019" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Number of fatalities" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 1994" ;
    :yValue "80" ;
    :belongsTo :Chart .

