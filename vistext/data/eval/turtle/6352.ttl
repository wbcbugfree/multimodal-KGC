@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Total motorcycle sales in the Netherlands in 2016 to 2018 , by brand" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Motorcycle brand" .

:YAxis a :Axis ;
    :title "2017" .

