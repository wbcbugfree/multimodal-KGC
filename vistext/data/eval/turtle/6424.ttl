@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Share of children who participated in dance activities in the last year in England from 2008/09 to 2019/20 , by age" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "11-15 years" .

:YAxis a :Axis ;
    :title "Response" .

:DataPoint1 a :DataPoint ;
    :xValue "0.289" ;
    :yValue "2019/20" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "0.299" ;
    :yValue "2018/19" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "0.3" ;
    :yValue "2017/18" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "0.375" ;
    :yValue "2016/17" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "0.359" ;
    :yValue "2015/16" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "0.36" ;
    :yValue "2014/15" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "0.376" ;
    :yValue "2013/14" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "0.433" ;
    :yValue "2012/13" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "0.452" ;
    :yValue "2011/12" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "0.454" ;
    :yValue "2010/11" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "0.526" ;
    :yValue "2009/10" ;
    :belongsTo :Chart .

:DataPoint12 a :DataPoint ;
    :xValue "0.519" ;
    :yValue "2008/09" ;
    :belongsTo :Chart .
