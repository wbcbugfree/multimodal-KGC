@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Net revenue from institutional client services at Goldman Sachs from 2009 to 2019 (in billion U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Net revenue in billion U.S. dollars" .

:YAxis a :Axis ;
    :title "Year" .

:DataPoint1 a :DataPoint ;
    :xValue "14.78" ;
    :yValue "2019*" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "14.44" ;
    :yValue "2018*" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "12.3" ;
    :yValue "2017*" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "14.47" ;
    :yValue "2016" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "15.15" ;
    :yValue "2015" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "15.2" ;
    :yValue "2014" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "15.72" ;
    :yValue "2013" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "18.12" ;
    :yValue "2012" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "17.28" ;
    :yValue "2011" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "21.8" ;
    :yValue "2010" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "32.72" ;
    :yValue "2009" ;
    :belongsTo :Chart .
