@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Products purchased online by consumers in the United Arab Emirates during 4th quarter 2012 , by gender" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Female" .

:YAxis a :Axis ;
    :title "most popular products purchased online" .

:DataPoint1 a :DataPoint ;
    :xValue "0.35" ;
    :yValue "Airline ticketes" ;
    :belongsTo :Chart .

