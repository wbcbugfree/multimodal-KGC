    :yValue "0.2752" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Dec 31, 2011" ;
    :yValue "0.2663" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
