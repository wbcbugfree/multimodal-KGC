@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Canada : Distribution of gross domestic product (GDP) across economic sectors from 2007 to 2016" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Industry" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2006" ;
    :yValue "0.2908" ;
    :belongsTo :Chart .

