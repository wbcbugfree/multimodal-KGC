@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Miami Heat all-time rebounds leaders from 1988 to 2020" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Player" .

:YAxis a :Axis ;
    :title "Rebounds" .

:DataPoint1 a :DataPoint ;
    :xValue "Udonis Haslem" ;
    :yValue "5754" ;
    :belongsTo :Chart .

