@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Average payroll of Major League Baseball teams from 2002 to 2012 (in million U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "All teams" .

:DataPoint1 a :DataPoint ;
    :xValue "2012*" ;
    :yValue "98.02" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "2011" ;
    :yValue "92.9" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "2010" ;
    :yValue "90.6" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "2009" ;
    :yValue "88.9" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "2008" ;
    :yValue "89.5" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "2007" ;
    :yValue "82.6" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "2006" ;
    :yValue "77.6" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "2005" ;
    :yValue "72.8" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "2004" ;
    :yValue "69" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "2003" ;
    :yValue "70.9" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "2002" ;
    :yValue "67.5" ;
    :belongsTo :Chart .
