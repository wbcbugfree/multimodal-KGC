@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Most popular digital wallets according to consumers in the United States as of December 2016" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Share of respondents" .

:YAxis a :Axis ;
    :title "Response" .

:DataPoint1 a :DataPoint ;
    :xValue "0.76" ;
    :yValue "PayPal" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "0.24" ;
    :yValue "Amazon Payments/Pay with Amazon" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "0.15" ;
    :yValue "VisaCheckout (formerly known as V.me)" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "0.14" ;
    :yValue "Google Wallet" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "0.12" ;
    :yValue "Apple Pay" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "0.09" ;
    :yValue "Android Pay" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "0.09" ;
    :yValue "MasterCard PayPass" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "0.08" ;
    :yValue "Amex Express Checkout" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "0.07" ;
    :yValue "MasterPay" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "0.06" ;
    :yValue "Samsung Pay" ;
    :belongsTo :Chart .
