@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Number of web shops and mail order companies in the Netherlands from 2007 to 2019" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Number of webshops" .

:YAxis a :Axis ;
    :title "Year" .

:DataPoint1 a :DataPoint ;
    :xValue "49415" ;
    :yValue "2020*" ;
    :belongsTo :Chart .

