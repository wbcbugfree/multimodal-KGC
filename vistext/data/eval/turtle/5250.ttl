@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Car hire or rental-related search terms ranked by search volume in the United Kingdom (UK) in January 2016 (in 1,000 searches)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Searches in thousands" .

:YAxis a :Axis ;
    :title "keywords" .

:DataPoint1 a :DataPoint ;
    :xValue "90.5" ;
    :yValue "car hire" ;
    :belongsTo :Chart .

