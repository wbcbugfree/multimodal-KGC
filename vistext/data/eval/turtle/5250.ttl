    :xValue "27.1" ;
    :yValue "car hire uk" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "18.1" ;
    :yValue "cheap car hire" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "12.1" ;
    :yValue "car hire usa" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "12.1" ;
