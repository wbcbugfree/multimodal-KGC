@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Number of single-person households in the Netherlands from 2009 to 2019 , by gender" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Men" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2008" ;
    :yValue "1217701" ;
    :belongsTo :Chart .

