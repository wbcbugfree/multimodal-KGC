@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Half-year value of the statutory interest rate in the Netherlands from January 2013 to July 2020" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Month" .

:YAxis a :Axis ;
    :title "Commercial transaction after 01/12/2002" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2012" ;
    :yValue "0.0775" ;
    :belongsTo :Chart .

