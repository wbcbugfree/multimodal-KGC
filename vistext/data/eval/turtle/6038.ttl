@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Number of students enrolled in postsecondary institutions in Canada in 2017/18 , by gender and field of study" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Field of study" .

:YAxis a :Axis ;
    :title "Men" .

:DataPoint1 a :DataPoint ;
    :xValue "Business, management and public administration" ;
    :yValue "190347" ;
    :belongsTo :Chart .

