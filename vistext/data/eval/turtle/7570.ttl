@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Average retail price for chicken in Canada from January 2015 to June 2020 (in Canadian dollars per kilogram)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Month" .

:YAxis a :Axis ;
    :title "2020" .

:DataPoint1 a :DataPoint ;
    :xValue "Ju" ;
    :yValue "6.87" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Jun Ma" ;
    :yValue "7.05" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "May Ap" ;
    :yValue "7.21" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "Apr Ma" ;
    :yValue "7.6" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "Mar Fe" ;
    :yValue "7.46" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Feb Ja" ;
    :yValue "7.43" ;
    :belongsTo :Chart .
