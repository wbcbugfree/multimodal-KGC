@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Tourism expenditure in the Netherlands from 2010 to 2018 , by category (in million euros)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Expenditure outbound tourism" .

:DataPoint1 a :DataPoint ;
    :xValue "2010" ;
    :yValue "4723" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "2011" ;
    :yValue "5143" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "2012" ;
    :yValue "5475" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "2013" ;
    :yValue "5512" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "2014" ;
    :yValue "5591" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "2015" ;
    :yValue "5770" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "2016" ;
    :yValue "5862" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "2017" ;
    :yValue "6192" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "2018" ;
    :yValue "6456" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "2019*" ;
    :yValue "6619" ;
    :belongsTo :Chart .
