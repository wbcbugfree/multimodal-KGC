@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "The 20 countries with the largest proportion of the global gross domestic product (GDP) based on Purchasing Power Parity (PPP) in 2019" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "Share of global GDP" .

:DataPoint1 a :DataPoint ;
    :xValue "China" ;
    :yValue "0.1925" ;
    :belongsTo :Chart .

