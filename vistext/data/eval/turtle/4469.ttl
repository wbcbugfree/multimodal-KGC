@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "European football clubs with the highest average annual shirt sales from 2009/10 to 2013/14 (in thousands)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Shirt sales (in thousands)" .

:YAxis a :Axis ;
    :title "association football club" .

:DataPoint1 a :DataPoint ;
    :xValue "1580" ;
    :yValue "Real Madrid" ;
    :belongsTo :Chart .

