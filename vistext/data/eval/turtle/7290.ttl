@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Average penetration rate of soft drink brands in Russia in 2012 and 2013" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Brand" .

:YAxis a :Axis ;
    :title "2012" .

:DataPoint1 a :DataPoint ;
    :xValue "Coca-Col" ;
    :yValue "0.39" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Coca-Cola Pepsi-Col" ;
    :yValue "0.25" ;
    :belongsTo :Chart .

