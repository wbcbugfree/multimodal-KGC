@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Average face amount of individual life insurance policies purchased in the United States from 1997 to 2018 (in thousand U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Value in thousand U.S. dollars" .

