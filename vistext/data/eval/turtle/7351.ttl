@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Number of families in the United States in 2019 , by income level and race or origin (in thousands)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "All Races" .

:YAxis a :Axis ;
    :title "Annual family income in U\\.S\\. dollars" .

:DataPoint1 a :DataPoint ;
    :xValue "2798" ;
    :yValue "Under 10,000" ;
    :belongsTo :Chart .

