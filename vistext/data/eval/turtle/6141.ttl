@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Number of deaths from diagnosed ischemic heart disease and acute myocardial infarction in Canada from 2000 to 2013" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Ischemic heart disease" .

:DataPoint1 a :DataPoint ;
    :xValue "2012-2013" ;
    :yValue "112240" ;
    :belongsTo :Chart .

