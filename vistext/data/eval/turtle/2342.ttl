@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Internal consumption of travel and tourism in Antigua and Barbuda from 2010 to 2019 (in million U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Consumption in million U.S. dollars*" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2009" ;
    :yValue "927" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Dec 31, 2010" ;
    :yValue "948" ;
    :belongsTo :Chart .

