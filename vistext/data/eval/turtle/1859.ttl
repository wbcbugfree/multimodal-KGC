@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Number of Nissan Qashqai registered cars in Great Britain from 2006 to 2018" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Number of registered cars" .

