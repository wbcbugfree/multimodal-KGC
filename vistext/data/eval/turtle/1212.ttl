@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Most popular Apple App Store categories in August 2020 , by share of available apps" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "Share of active apps" .

:DataPoint1 a :DataPoint ;
    :xValue "Games" ;
    :yValue "0.2186" ;
    :belongsTo :Chart .

