@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Average hours per day spent on leisure and sports in the U.S. sorted by educational attainment from 2009 to 2019" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Some college or associate degree" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2008" ;
    :yValue "4.95" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Dec 31, 2009" ;
    :yValue "5.02" ;
    :belongsTo :Chart .

