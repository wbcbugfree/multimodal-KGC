@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "The 20 countries with the largest gross domestic product (GDP) per capita in 2019 (in U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Country" .

:YAxis a :Axis ;
    :title "GDP per capita in U.S. dollars" .

:DataPoint1 a :DataPoint ;
