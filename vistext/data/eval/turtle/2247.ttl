@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Total regular season home attendance of the Texas Rangers from 2006 to 2019 (in millions)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Home attendance in millions" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2005" ;
    :yValue "2.39" ;
    :belongsTo :Chart .

