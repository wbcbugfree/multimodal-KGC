@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Canada : Unemployment rate from 2009 to 2021" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Unemployment rate" .

:YAxis a :Axis ;
    :title "Year" .

:DataPoint1 a :DataPoint ;
    :xValue "0.0721" ;
    :yValue "2021*" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "0.0747" ;
    :yValue "2020*" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "0.0567" ;
    :yValue "2019" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "0.0583" ;
    :yValue "2018" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "0.0634" ;
    :yValue "2017" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "0.0699" ;
    :yValue "2016" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "0.069" ;
    :yValue "2015" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "0.0693" ;
    :yValue "2014" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "0.071" ;
    :yValue "2013" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "0.0733" ;
    :yValue "2012" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "0.075" ;
    :yValue "2011" ;
    :belongsTo :Chart .

:DataPoint12 a :DataPoint ;
    :xValue "0.08" ;
    :yValue "2010" ;
    :belongsTo :Chart .

:DataPoint13 a :DataPoint ;
    :xValue "0.0836" ;
    :yValue "2009" ;
    :belongsTo :Chart .
