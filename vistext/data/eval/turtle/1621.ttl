@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Registered number of bike thefts in Belgium from 2008 to 2019" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Number of bike thefts" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2007" ;
    :yValue "37632" ;
    :belongsTo :Chart .

