@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Cumulative number of coronavirus (COVID-19) cases in Europe between January 25 , 2020 and January 3 , 2021" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Week ending" .

:YAxis a :Axis ;
    :title "Overall number of cases" .

