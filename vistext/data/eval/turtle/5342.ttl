@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Total fertility rate in the United Kingdom (UK) from 2000 to 2018" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Total fertility rate (TFR)" .

