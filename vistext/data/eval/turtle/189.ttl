@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Average points per game at the FIFA World Cup from 1930 to 2010 , selected teams" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Country" .

:YAxis a :Axis ;
    :title "Average points per game" .

:DataPoint1 a :DataPoint ;
    :xValue "Brazil" ;
    :yValue "2.23" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Germany" ;
    :yValue "2.01" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "Italy" ;
    :yValue "1.91" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "Argentina" ;
    :yValue "1.77" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "The Netherlands" ;
    :yValue "1.77" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Spain" ;
    :yValue "1.71" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Portugal" ;
    :yValue "1.7" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Denmark" ;
    :yValue "1.62" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "France" ;
    :yValue "1.59" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "The Ivory Coast" ;
    :yValue "1.17" ;
    :belongsTo :Chart .
