@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Most popular YouTube channels as of October 2020 , ranked by number of subscribers (in millions)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "YouTube channel" .

:YAxis a :Axis ;
    :title "Number of subscribers in millions" .

:DataPoint1 a :DataPoint ;
    :xValue "T-Series" ;
    :yValue "156" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "PewDiePie" ;
    :yValue "107" ;
    :belongsTo :Chart .

