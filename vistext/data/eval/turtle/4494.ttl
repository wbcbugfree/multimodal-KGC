    :xValue "SET India" ;
    :yValue "84.7" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "5-Minute Crafts" ;
    :yValue "68.7" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "WWE" ;
    :yValue "67.3" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Kids Diana Show" ;
    :yValue "64.9" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Zee Music Company" ;
    :yValue "62.7" ;
