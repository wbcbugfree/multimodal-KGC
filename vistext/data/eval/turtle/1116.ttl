@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Total healthcare expenditure annual growth rate in the United Kingdom (UK) from 1998 to 2018" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Total healthcare expenditure growth" .

