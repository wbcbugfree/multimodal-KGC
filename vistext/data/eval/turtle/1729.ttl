@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Annual OPEC refinery capacity from 2008 to 2019 (in 1,000 barrels per calendar day)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Capacity in thousand barrels per calendar day" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2007" ;
    :yValue "9106.63" ;
    :belongsTo :Chart .

