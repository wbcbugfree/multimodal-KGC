@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Do you agree that a woman can become pregnant the first time she has sex ?" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Country" .

:YAxis a :Axis ;
    :title "Don't know" .

