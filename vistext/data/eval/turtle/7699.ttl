@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Population of Finland from 2009 to 2019 , by language (in thousands)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Finnish" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2008" ;
    :yValue "4852.2" ;
    :belongsTo :Chart .

