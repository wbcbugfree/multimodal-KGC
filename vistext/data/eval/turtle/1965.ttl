@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Installed power capacity across Jammu and Kashmir in India from financial year 2005 to 2018 (in megawatts)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Installed power capacity in megawatts" .

:DataPoint1 a :DataPoint ;
    :xValue "FY 2018" ;
    :yValue "3389.21" ;
    :belongsTo :Chart .

