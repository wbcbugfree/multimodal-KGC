@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Reasons for businesses not reporting cases of fraud by employees to the police in England and Wales in 2012 and 2013 (as a share of respondents)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Share of respondents" .

:YAxis a :Axis ;
    :title "Response" .

:DataPoint1 a :DataPoint ;
    :xValue "0.53" ;
    :yValue "Private/dealt with ourselves" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "0.16" ;
    :yValue "Trivial/no loss" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "0.07" ;
    :yValue "Police came" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "0.06" ;
    :yValue "Lack of police engagement" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "0.01" ;
    :yValue "Inconvenient to report" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "0" ;
    :yValue "Lack of evidence" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "0" ;
    :yValue "Fear of reprisal" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "0" ;
    :yValue "Reported to other authorities" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "0" ;
    :yValue "Common occurrence" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "0.19" ;
    :yValue "Other" ;
    :belongsTo :Chart .
