@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Caribbean passports with the most visa free access to other countries as of July 2020 (visa free score)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Country" .

:YAxis a :Axis ;
    :title "Visa free score**" .

:DataPoint1 a :DataPoint ;
    :xValue "Barbados" ;
    :yValue "161" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "St. Kitts and Nevis" ;
    :yValue "156" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "Bahamas" ;
    :yValue "155" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "Antigua and Barbuda" ;
    :yValue "151" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "Trinidad and Tobago" ;
    :yValue "150" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "St. Vincent and the Grenadines" ;
    :yValue "148" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "St. Lucia" ;
    :yValue "146" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Grenada" ;
    :yValue "143" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "Dominica" ;
    :yValue "140" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "Belize*" ;
    :yValue "101" ;
    :belongsTo :Chart .
