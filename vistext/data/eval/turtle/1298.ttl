@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "New passenger car sales figures in Romania from 2005 to 2019 (in units)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Units sold" .

