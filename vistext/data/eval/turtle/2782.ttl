@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Volume of blueberries imported from the European Union to Spain in 2018 , by country of origin (in metric tons)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Country" .

:YAxis a :Axis ;
    :title "Imports in metric tons" .

:DataPoint1 a :DataPoint ;
    :xValue "Portugal" ;
    :yValue "522" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Italy" ;
    :yValue "436" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "Netherlands" ;
    :yValue "335" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "Germany" ;
    :yValue "211" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "Poland" ;
    :yValue "55" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "France" ;
    :yValue "25" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "United Kingdom" ;
    :yValue "23" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Belgium" ;
    :yValue "11" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "Sweden" ;
    :yValue "4" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "Denmark" ;
    :yValue "4" ;
    :belongsTo :Chart .
