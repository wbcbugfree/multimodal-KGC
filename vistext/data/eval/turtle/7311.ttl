@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Number of journalists killed worldwide from 2003 to 2019" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Motive confirmed" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2002" ;
    :yValue "42" ;
    :belongsTo :Chart .

