@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Minnesota Twins all-time RBI (runs batted in) leaders as of October 2020" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Minessota Twins Player" .

:YAxis a :Axis ;
    :title "Number of home runs" .

:DataPoint1 a :DataPoint ;
    :xValue "Harmon Killebrew" ;
    :yValue "1540" ;
    :belongsTo :Chart .

