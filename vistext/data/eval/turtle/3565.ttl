@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Number of passenger cars registered in Finland in 2019 , by model" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "automobile model series" .

:YAxis a :Axis ;
    :title "Number of cars" .

