@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Number of new coronavirus (COVID-19) cases confirmed in Estonia in 2020 , by age and gender" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Women" .

