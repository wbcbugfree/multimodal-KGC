@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Number of racist incidents recorded by the police in Wales from April 2009 to March 2020" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Number of incidents*" .

:DataPoint1 a :DataPoint ;
    :xValue "2019/20" ;
    :yValue "2634" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "2018/19" ;
    :yValue "2676" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "2017/18" ;
    :yValue "2298" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "2015/16" ;
    :yValue "2613" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "2014/15" ;
    :yValue "2433" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "2013/14" ;
    :yValue "2277" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "2012/13" ;
    :yValue "2243" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "2011/12" ;
    :yValue "2544" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "2010/11" ;
    :yValue "2785" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "2009/10" ;
    :yValue "2630" ;
    :belongsTo :Chart .
