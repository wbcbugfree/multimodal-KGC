@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Number of pupils attending schools in Northern Ireland from 2010/11 to 2019/20" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Primary" .

:DataPoint1 a :DataPoint ;
    :xValue "2019/20" ;
    :yValue "183711" ;
    :belongsTo :Chart .

