@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Exports of finished motor gasoline from the United States from 2000 to 2019 (in 1,000 barrels)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Imports in thousand barrels" .

