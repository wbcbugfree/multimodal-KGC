@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Jamaica : Share of economic sectors in the gross domestic product (GDP) from 2009 to 2019" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Services" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2008" ;
    :yValue "0.6814" ;
    :belongsTo :Chart .

