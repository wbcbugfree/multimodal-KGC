@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Contribution of travel and tourism to GDP in Canada from 2009 to 2028 (in billion CAD)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Contribution in billion CAD" .

:DataPoint1 a :DataPoint ;
    :xValue "2028**" ;
    :yValue "235.5" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "2018*" ;
    :yValue "145.4" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "2017" ;
    :yValue "138.8" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "2016" ;
    :yValue "127.3" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "2015" ;
    :yValue "122.7" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "2014" ;
    :yValue "121.8" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "2013" ;
    :yValue "117.4" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "2012" ;
    :yValue "113.1" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "2011" ;
    :yValue "108.3" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "2010" ;
    :yValue "102.1" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "2009" ;
    :yValue "74.4" ;
    :belongsTo :Chart .
