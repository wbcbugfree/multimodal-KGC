@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Foreign direct investment (FDI) from Europe in the United States from 2000 to 2019 (in trillion U.S. dollars , on a historical-cost basis)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "FDI in trillion U.S. dollars" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 1999" ;
    :yValue "0.89" ;
    :belongsTo :Chart .

