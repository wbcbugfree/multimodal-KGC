@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Number of employed people in China from 2009 to 2019 (in millions)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Employed people in millions" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2008" ;
    :yValue "758.28" ;
    :belongsTo :Chart .

