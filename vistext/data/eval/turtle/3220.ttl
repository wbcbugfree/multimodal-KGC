@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Total number of Novartis AG 's full-time employees from 2009 to 2019" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Number of employees (full time)" .

:DataPoint1 a :DataPoint ;
    :xValue "2009" ;
    :yValue "99384" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "2010" ;
    :yValue "119418" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "2011" ;
    :yValue "109208" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "2012" ;
    :yValue "112461" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "2013" ;
    :yValue "119362" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "2014" ;
    :yValue "117809" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "2015**" ;
    :yValue "118700" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "2016" ;
    :yValue "118393" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "2017" ;
    :yValue "121597" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "2018" ;
    :yValue "125161" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "2019***" ;
    :yValue "103914" ;
    :belongsTo :Chart .
