@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Economic damage caused by North Atlantic tropical cyclones in the U.S. from 1995 to 2019 (in million U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Damage in million U.S. dollars" .

