@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Number of SMS and MMS sent in Germany from 1999 to 2014 (in millions per day)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "WhatsApp" .

:YAxis a :Axis ;
    :title "Year" .

:DataPoint1 a :DataPoint ;
    :xValue "667" ;
    :yValue "2015*" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "400" ;
    :yValue "2014" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "133" ;
    :yValue "2013" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "20" ;
    :yValue "2012" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "7" ;
    :yValue "2011" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "1" ;
    :yValue "2010" ;
    :belongsTo :Chart .
