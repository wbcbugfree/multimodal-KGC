@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Gold production of Fresnillo plc from 2008 to 2019 (in 1,000 ounces)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Production in thousand ounces" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2007" ;
    :yValue "263.6" ;
    :belongsTo :Chart .

