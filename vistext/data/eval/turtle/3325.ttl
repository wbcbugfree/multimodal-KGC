@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Apparent cement consumption in the U.S. from 2004 to 2019 (in 1,000 metric tons)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Consumption in thousand metric tons" .

:YAxis a :Axis ;
    :title "Year" .

:DataPoint1 a :DataPoint ;
    :xValue "102000" ;
    :yValue "2019*" ;
    :belongsTo :Chart .

