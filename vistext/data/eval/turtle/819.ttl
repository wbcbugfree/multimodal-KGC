@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Leading 10 FMCG brands ranked by consumer reach in the United Kingdom (UK) in 2019 (in million Consumer Reach Points )" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Consumer Reach Points* in millions" .

:YAxis a :Axis ;
    :title "FMCG brand" .

:DataPoint1 a :DataPoint ;
    :xValue "533" ;
    :yValue "Warburtons" ;
    :belongsTo :Chart .

