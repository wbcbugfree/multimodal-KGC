@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Share of defense expenditure on the national GDP by the United Kingdom (UK) and other NATO allies , from 2009 to 2018" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "France" .

:DataPoint1 a :DataPoint ;
    :xValue "2009" ;
    :yValue "2" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "2010" ;
    :yValue "2" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "2011" ;
    :yValue "1.9" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "2012" ;
    :yValue "1.9" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "2013" ;
    :yValue "1.9" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "2014" ;
    :yValue "1.8" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "2015" ;
    :yValue "1.8" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "2016" ;
    :yValue "1.8" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "2017" ;
    :yValue "1.8" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "2018**" ;
    :yValue "1.8" ;
    :belongsTo :Chart .
