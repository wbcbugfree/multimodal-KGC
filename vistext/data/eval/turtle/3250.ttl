@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Number of aircraft landings and take-offs at Gatwick Airport in the United Kingdom (UK) from 2005 to 2019 (in 1,000s)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Aircraft movements in thousands" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2004" ;
    :yValue "252" ;
    :belongsTo :Chart .

