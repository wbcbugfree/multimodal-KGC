@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Public sector expenditure on science and technology in the United Kingdom (UK) from 2000/01 to 2018/19 (in billion GBP)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

