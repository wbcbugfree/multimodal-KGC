@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Percentage of employed women in computing-related occupations in the United States from 2007 to 2019 , by ethnicity" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Asian/Pacific Islander" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2006" ;
    :yValue "0.044" ;
    :belongsTo :Chart .

