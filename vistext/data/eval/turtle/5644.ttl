@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Total consumption of chocolate and cocoa products by households in Spain from 2008 to 2019 (in million kilograms)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Total consumption in million kilograms" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2007" ;
    :yValue "143.6" ;
    :belongsTo :Chart .

