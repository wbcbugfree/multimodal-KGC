@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Manchester United revenue by segment from 2009 to 2020 (in million U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Matchday" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2008" ;
    :yValue "150.57" ;
    :belongsTo :Chart .

