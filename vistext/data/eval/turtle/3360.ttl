@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Unemployment rate in Italy from 2008 to the first quarter of 2020" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Unemployment rate" .

:DataPoint1 a :DataPoint ;
    :xValue "2020*" ;
    :yValue "0.091" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "2019" ;
    :yValue "0.1" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "2018" ;
    :yValue "0.105" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "2017" ;
    :yValue "0.112" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "2016" ;
    :yValue "0.117" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "2015" ;
    :yValue "0.119" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "2014" ;
    :yValue "0.127" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "2013" ;
    :yValue "0.121" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "2012" ;
    :yValue "0.107" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "2011" ;
    :yValue "0.084" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "2010" ;
    :yValue "0.084" ;
    :belongsTo :Chart .

:DataPoint12 a :DataPoint ;
    :xValue "2009" ;
    :yValue "0.078" ;
    :belongsTo :Chart .

:DataPoint13 a :DataPoint ;
    :xValue "2008" ;
    :yValue "0.067" ;
    :belongsTo :Chart .
