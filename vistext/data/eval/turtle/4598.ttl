@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Minnesota Twins all-time home run leaders as of October 2020" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "player" .

:YAxis a :Axis ;
    :title "Number of home runs" .

:DataPoint1 a :DataPoint ;
    :xValue "Harmon Killebrew" ;
    :yValue "559" ;
    :belongsTo :Chart .

