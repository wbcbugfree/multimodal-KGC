@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Price per ton of sugar cane in the U.S. from 2007 to 2016 , by state (in U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Florida" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2006" ;
    :yValue "31.6" ;
    :belongsTo :Chart .

