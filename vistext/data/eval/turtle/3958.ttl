@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Percentage of adults in the U.S. who believed select sources were the cause of their back pain as of February 2017" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "Share of respondents" .

:DataPoint1 a :DataPoint ;
    :xValue "Stress" ;
    :yValue "0.29" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Not enough exercise / weak muscles" ;
    :yValue "0.26" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "Physical work" ;
    :yValue "0.26" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "Overweight" ;
    :yValue "0.25" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "Spinal disc herniation" ;
    :yValue "0.21" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Sitting at a desk at work" ;
    :yValue "0.2" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Accident" ;
    :yValue "0.17" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Other" ;
    :yValue "0.14" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "Genetic predisposition" ;
    :yValue "0.11" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "Too much exercise" ;
    :yValue "0.09" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "Don’t know" ;
    :yValue "0.07" ;
    :belongsTo :Chart .

:DataPoint12 a :DataPoint ;
    :xValue "Psychosomatic illness" ;
    :yValue "0.04" ;
    :belongsTo :Chart .

:DataPoint13 a :DataPoint ;
    :xValue "Prefer not to answer" ;
    :yValue "0.01" ;
    :belongsTo :Chart .
