@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Most expensive recreational vehicles worldwide as of October 2014 (in U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Price in U.S. dollars" .

:YAxis a :Axis ;
    :title "Year" .

:DataPoint1 a :DataPoint ;
    :xValue "3000000" ;
    :yValue "Marchi Mobile EleMMent Palazzo" ;
    :belongsTo :Chart .

