@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Number of Carnival Corporation & plc passengers worldwide from 2007 to 2019 (in millions)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Number of passengers in millions" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2006" ;
    :yValue "7.67" ;
    :belongsTo :Chart .

