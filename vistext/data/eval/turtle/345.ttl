@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Number of divorced people in Canada from 2000 to 2020 (in millions)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Number of people in millions" .

