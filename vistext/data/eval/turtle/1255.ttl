@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Number of jobs in Newfoundland and Labrador , Canada in 2019 , by NAICS category" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "NAICS category" .

:YAxis a :Axis ;
    :title "Number of jobs" .

:DataPoint1 a :DataPoint ;
    :xValue "Health care and social assistance" ;
    :yValue "37875" ;
    :belongsTo :Chart .

