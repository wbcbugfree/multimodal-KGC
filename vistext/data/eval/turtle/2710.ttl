@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Percentage of adults in the U.S. who were prone to select symptoms as of 2017" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "Share of respondents" .

:DataPoint1 a :DataPoint ;
    :xValue "Back pain" ;
    :yValue "0.49" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Concentration difficulties" ;
    :yValue "0.17" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "Depression" ;
    :yValue "0.26" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "Gastrointestinal complaints" ;
    :yValue "0.22" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "Headache" ;
    :yValue "0.44" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Lack of appetite" ;
    :yValue "0.09" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Lightheadedness" ;
    :yValue "0.17" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Poor circulation" ;
    :yValue "0.12" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "Skin rashes" ;
    :yValue "0.13" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "Sleep problems" ;
    :yValue "0.42" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "None of the above" ;
    :yValue "0.19" ;
    :belongsTo :Chart .

:DataPoint12 a :DataPoint ;
    :xValue "Prefer not to answer" ;
    :yValue "0.02" ;
    :belongsTo :Chart .
