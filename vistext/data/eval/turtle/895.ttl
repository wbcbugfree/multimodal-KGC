@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Social media used by females in the United Kingdom (UK) as of 3rd quarter 2020" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "Share of respondents" .

:DataPoint1 a :DataPoint ;
    :xValue "Facebook" ;
    :yValue "0.85" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "WhatsApp" ;
    :yValue "0.81" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "YouTube" ;
    :yValue "0.63" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "Instagram" ;
    :yValue "0.56" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "Twitter" ;
    :yValue "0.37" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Pinterest" ;
    :yValue "0.34" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "LinkedIn" ;
    :yValue "0.28" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Snapchat" ;
    :yValue "0.23" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "TikTok" ;
    :yValue "0.12" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "Reddit" ;
    :yValue "0.07" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "Tumblr" ;
    :yValue "0.07" ;
    :belongsTo :Chart .
