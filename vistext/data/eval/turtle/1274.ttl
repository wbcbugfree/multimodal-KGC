@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Total number of companies in France between 2008 and 2017" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Number of enterprises" .

:DataPoint1 a :DataPoint ;
    :xValue "2017" ;
    :yValue "2783993" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "2016" ;
    :yValue "3058220" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "2015*" ;
    :yValue "2908814" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "2014*" ;
    :yValue "3188138" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "2013" ;
    :yValue "3016704" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "2012" ;
    :yValue "2882419" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "2011" ;
    :yValue "2567431" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "2010" ;
    :yValue "2513679" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "2009" ;
    :yValue "2193030" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "2008" ;
    :yValue "2361827" ;
    :belongsTo :Chart .
