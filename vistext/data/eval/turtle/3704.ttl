@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Total number of buses and coaches registered in France from 2004 to 2019" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Number of vehicles registered" .

