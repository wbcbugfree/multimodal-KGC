@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Ranking of the 20 countries with the highest life expectancy for people born in 2009 (in years)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Life expectancy in years" .

:YAxis a :Axis ;
    :title "Country" .

