@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Leading music television channels in Poland from 2019 to 2020 , by audience share (SHR)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Leading music television channels" .

:YAxis a :Axis ;
    :title "2019" .

:DataPoint1 a :DataPoint ;
    :xValue "Polo T" ;
    :yValue "0.0067" ;
    :belongsTo :Chart .

