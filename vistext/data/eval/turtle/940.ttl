@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Leading financial advisors to German M & A in 2016 , by deal count" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "M&A deal count" .

:YAxis a :Axis ;
    :title "Financial advisory firms" .

:DataPoint1 a :DataPoint ;
    :xValue "42" ;
    :yValue "Rothschild" ;
    :belongsTo :Chart .

