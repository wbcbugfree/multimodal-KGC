@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Average percentage of U.S. population engaged in sports and exercise per day from 2010 to 2019" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "All" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2009" ;
    :yValue "0.185" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Dec 31, 2010" ;
    :yValue "0.186" ;
    :belongsTo :Chart .

