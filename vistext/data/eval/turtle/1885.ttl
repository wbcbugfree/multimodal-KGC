@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Average child support received by custodial parents from their noncustodial counterpart in the United States from 1993 to 2017" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Average support received in U.S. dollars" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 1992" ;
    :yValue "3917" ;
