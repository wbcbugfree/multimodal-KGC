@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Number of Facebook fans/twitter followers of the Brooklyn Nets (NBA) from 2012 to 2020 (in millions)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Month" .

:YAxis a :Axis ;
    :title "Facebook fans" .

:DataPoint1 a :DataPoint ;
    :xValue "Septembre 2020" ;
    :yValue "2.72" ;
    :belongsTo :Chart .

