    :xValue "0.097" ;
    :yValue "Warrior" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "0.09" ;
    :yValue "Mage" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "0.088" ;
    :yValue "Priest" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "0.081" ;
    :yValue "Death Knight" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "0.079" ;
    :yValue "Rogue" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "0.072" ;
    :yValue "Warlock" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "0.066" ;
    :yValue "Shaman" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "0.063" ;
    :yValue "Monk" ;
    :belongsTo :Chart .

:DataPoint12 a :DataPoint ;
    :xValue "0.049" ;
    :yValue "Demon Hunter" ;
    :belongsTo :Chart .
