@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Distribution of World of Warcraft Alliance characters in U.S. and EU realms as of December 2019 , by class" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "EU realms" .

:YAxis a :Axis ;
    :title "World of Warcraft Alliance characters" .

:DataPoint1 a :DataPoint ;
    :xValue "0.108" ;
    :yValue "Hunter" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "0.104" ;
    :yValue "Paladin" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "0.103" ;
    :yValue "Druid" ;
    :belongsTo :Chart .

