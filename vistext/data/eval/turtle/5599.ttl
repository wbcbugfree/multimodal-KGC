@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Average price of single-family homes in the Netherlands in 2nd quarter 2020 , by province (in euros)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Country" .

:YAxis a :Axis ;
    :title "Average price in euros" .

:DataPoint1 a :DataPoint ;
    :xValue "Limburg" ;
    :yValue "271000" ;
    :belongsTo :Chart .

