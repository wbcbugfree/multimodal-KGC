@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Share of e-commerce as a proportion of total turnover of enterprises in Greece from 2009 to 2018" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Share of e-commerce in total turnover" .

:YAxis a :Axis ;
    :title "Response" .

:DataPoint1 a :DataPoint ;
    :xValue "0.04" ;
    :yValue "2018" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "0.04" ;
    :yValue "2017" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "0.06" ;
    :yValue "2016" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "0.02" ;
    :yValue "2015" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "0.02" ;
    :yValue "2014" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "0.02" ;
    :yValue "2013" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "0.04" ;
    :yValue "2011" ;
    :belongsTo :Chart .
