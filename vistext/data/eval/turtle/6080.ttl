@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Gross domestic product (GDP) per capita in Belgium from 2007 to 2017 , by region (in euro purchasing power parity)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Walloon Region" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2006" ;
    :yValue "23491" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Dec 31, 2007" ;
    :yValue "24423" ;
    :belongsTo :Chart .

