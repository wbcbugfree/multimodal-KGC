@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "St. Louis Cardinals all-time home run leaders as of October 2020" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Home run leader" .

:YAxis a :Axis ;
    :title "Number of home runs" .

:DataPoint1 a :DataPoint ;
    :xValue "Stan Musial" ;
    :yValue "475" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Albert Pujols" ;
    :yValue "445" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "Ken Boyer" ;
    :yValue "255" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "Jim Edmonds" ;
    :yValue "241" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "Ray Lankford" ;
    :yValue "228" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Mark McGwire" ;
    :yValue "220" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Rogers Hornsby" ;
    :yValue "193" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Jim Bottomley" ;
    :yValue "181" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "Ted Simmons" ;
    :yValue "172" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "Yadier Molina" ;
    :yValue "160" ;
    :belongsTo :Chart .
