@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Annual averages of beef price spreads in the United States from 2006 to 2019 (in U.S. cents per pound of retail equivalent)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Wholesale to retail" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2005" ;
    :yValue "169" ;
    :belongsTo :Chart .

