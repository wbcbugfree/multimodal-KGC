@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Top 10 U.S. metro areas by plastic surgeon density as of 2016 (per 100,000 residents)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Number of surgeons per 100,000 residents" .

:YAxis a :Axis ;
    :title "city of the United States" .

:DataPoint1 a :DataPoint ;
    :xValue "3.9" ;
    :yValue "Miami, FL" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "3.12" ;
    :yValue "Salt Lake City, UT" ;
    :belongsTo :Chart .

