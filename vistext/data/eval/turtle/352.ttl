@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Number of deaths in Yukon , Canada from 2001 to 2020" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Number of deaths" .

:YAxis a :Axis ;
    :title "Year" .

