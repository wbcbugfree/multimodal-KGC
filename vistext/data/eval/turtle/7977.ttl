@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Distribution of postsecondary enrollment in the United States from 1980 to 2018 , by race" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Hispanic" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 1979" ;
    :yValue "0.04" ;
    :belongsTo :Chart .

