@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Leading retail brands in the United States on social media in 2019 , by user engagement (in million actions)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Leading retail brands" .

:YAxis a :Axis ;
    :title "Number of actions in millions" .

:DataPoint1 a :DataPoint ;
    :xValue "Fashion Nova" ;
    :yValue "315.01" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Victoria's Secret" ;
    :yValue "211.93" ;
    :belongsTo :Chart .

