    :xValue "Forever 21" ;
    :yValue "110.43" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "Victoria Beckham" ;
    :yValue "109.26" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Dior" ;
    :yValue "101.94" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "H&M" ;
    :yValue "100.39" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Foot Locker" ;
    :yValue "93.72" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "Urban Outfitters" ;
