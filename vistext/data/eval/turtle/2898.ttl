@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Total debt securities of the agency- and government sponsored enterprise backed mortgage pools sector in the United States from 2000 to 2018 (in billion U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Debt securities in billion U.S. dollars" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 1999" ;
    :yValue "2493" ;
    :belongsTo :Chart .

