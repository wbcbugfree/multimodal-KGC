@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Principal importing countries of wheat , flour and wheat products from 2014/2015 to 2018/2019 (in 1,000 metric tons)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Country" .

:YAxis a :Axis ;
    :title "2014/2015" .

:DataPoint1 a :DataPoint ;
    :xValue "Egypt" ;
    :yValue "11300" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Indonesia" ;
    :yValue "7478" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "Brazil" ;
    :yValue "5869" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "Philippines" ;
    :yValue "5054" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "Turkey" ;
    :yValue "5960" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Algeria" ;
    :yValue "7257" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Japan" ;
    :yValue "5878" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "European Union" ;
    :yValue "5979" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "Mexico" ;
    :yValue "4471" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "Nigeria" ;
    :yValue "4244" ;
    :belongsTo :Chart .
