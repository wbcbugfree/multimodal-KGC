@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Percentage of paper and paperboard in municipal solid waste generation in the U.S. from 1960 to 2014" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "Percentage of paper and paperboard" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 1959" ;
    :yValue "0.34" ;
    :belongsTo :Chart .

