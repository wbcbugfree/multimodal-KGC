@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Most defining characteristics of complexity in projects in organizations worldwide as of July 2013" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "Share of respondents" .

:DataPoint1 a :DataPoint ;
    :xValue "Multiple stakeholders" ;
    :yValue "0.57" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Ambiguity of project features, resources, phases, etc." ;
    :yValue "0.48" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "Significant political/authority influences" ;
    :yValue "0.35" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "Unknown project features, resources, phases, etc." ;
    :yValue "0.33" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "Dynamic (changing) project governance" ;
    :yValue "0.29" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Significant external influences" ;
    :yValue "0.28" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Use of technology that is new to the organization" ;
    :yValue "0.26" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Use of technology that has not yet been fully developed" ;
    :yValue "0.25" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "Significant internal interpersonal or social influences" ;
    :yValue "0.23" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "Highly regulated environment" ;
    :yValue "0.18" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "Project duration exceeds the cycle of relevant technologies" ;
    :yValue "0.1" ;
    :belongsTo :Chart .
