    :xValue "Dec 31, 2010" ;
    :yValue "0.127" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Dec 31, 2011" ;
    :yValue "0.101" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Dec 31, 2012" ;
    :yValue "0.113" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
