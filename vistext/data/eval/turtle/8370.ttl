@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Percentage change of food and organic food sales in Italy from 2007 to 2020" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Organic food sales" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2006" ;
    :yValue "-0.006" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Dec 31, 2007" ;
    :yValue "0.096" ;
    :belongsTo :Chart .

