@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Size of luxury property that one million dollars could buy in selected cities worldwide in 2019 (in square meters)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Country" .

:YAxis a :Axis ;
    :title "Size in square meters" .

