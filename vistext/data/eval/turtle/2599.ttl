@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Number of deaths in Nunavut , Canada from 2001 to 2020" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Number of deaths" .

