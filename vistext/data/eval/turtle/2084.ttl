@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Refrigerators used the most by construction firms in the United States in 2015" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Share of respondents" .

:YAxis a :Axis ;
    :title "Brand" .

:DataPoint1 a :DataPoint ;
    :xValue "0.35" ;
    :yValue "GE Appliances" ;
    :belongsTo :Chart .

