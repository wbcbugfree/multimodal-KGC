@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Gross minimum wage in Romania from 2007 to 2020 (in Romanian lei)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Gross minimum wage in Romanian lei" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2006" ;
    :yValue "390" ;
    :belongsTo :Chart .

