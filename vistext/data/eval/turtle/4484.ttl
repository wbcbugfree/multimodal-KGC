@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Total number of farmers markets in the United States from 1994 to 2014" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Number of farmers markets" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 1993" ;
    :yValue "1755" ;
    :belongsTo :Chart .

