@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Number of H-1B visas issued in the United States , by countries with the most recipients 2011" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Country" .

:YAxis a :Axis ;
    :title "Number of visas issued" .

:DataPoint1 a :DataPoint ;
    :xValue "India" ;
    :yValue "72438" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "China-mainland" ;
    :yValue "10849" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "U.K." ;
    :yValue "3660" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "South Korea" ;
    :yValue "3501" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "Mexico" ;
    :yValue "2647" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Philippines" ;
    :yValue "2369" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "France" ;
    :yValue "2069" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Japan" ;
    :yValue "2054" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "China-Taiwan" ;
    :yValue "1705" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "Germany" ;
    :yValue "1627" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "Other" ;
    :yValue "26215" ;
    :belongsTo :Chart .
