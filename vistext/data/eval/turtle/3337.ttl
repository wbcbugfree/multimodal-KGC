@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Median amount donated by online donors in the United States in 2015 , by number of donations made (in U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Median amount donated in U.S. dollars" .

:YAxis a :Axis ;
    :title "Number of donations made" .

:DataPoint1 a :DataPoint ;
    :xValue "50" ;
    :yValue "1-4" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "250" ;
    :yValue "5-9" ;
    :belongsTo :Chart .

