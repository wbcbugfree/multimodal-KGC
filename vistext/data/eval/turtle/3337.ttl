    :yValue "20-24" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "1330" ;
    :yValue "25-29" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "773" ;
    :yValue "30-34" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "1438" ;
