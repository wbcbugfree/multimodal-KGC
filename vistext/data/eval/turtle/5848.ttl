@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Number of employees at Intel from 2004 to 2019 (in 1,000s)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Number of employees in thousands" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2003" ;
    :yValue "85" ;
    :belongsTo :Chart .

