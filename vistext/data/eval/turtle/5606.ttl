@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Average prices for copper worldwide from 2014 to 2025 (in nominal U.S. dollars per metric ton)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Price in nominal U.S. dollars per metric ton" .

:DataPoint1 a :DataPoint ;
    :xValue "2025*" ;
    :yValue "6602" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "2024*" ;
    :yValue "6525" ;
    :belongsTo :Chart .

