@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Number of Deloitte employees worldwide from 2010 to 2020 , by region" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Region" .

:YAxis a :Axis ;
    :title "Americas" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2009" ;
    :yValue "72858" ;
    :belongsTo :Chart .

