@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Net revenue of Williams-Sonoma worldwide from 2009 to 2019 , by brand (in million U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Other*" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2008" ;
    :yValue "32" ;
    :belongsTo :Chart .

