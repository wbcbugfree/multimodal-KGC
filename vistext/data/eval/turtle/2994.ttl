@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Number of casinos worldwide in 2011 , by region" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Country" .

:YAxis a :Axis ;
    :title "Number of casinos" .

:DataPoint1 a :DataPoint ;
    :xValue "North America" ;
    :yValue "1623" ;
    :belongsTo :Chart .

