@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Global sponsorship spending by region from 2009 to 2018 (in billion U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Asia Pacific" .

:YAxis a :Axis ;
    :title "Year" .

:DataPoint1 a :DataPoint ;
    :xValue "16.6" ;
    :yValue "2018**" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "15.7" ;
    :yValue "2017" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "14.8" ;
    :yValue "2016" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "14" ;
    :yValue "2015" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "13.3" ;
    :yValue "2014" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "12.6" ;
    :yValue "2013" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "12" ;
    :yValue "2012" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "11.2" ;
    :yValue "2011" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "10.6" ;
    :yValue "2010" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "10" ;
    :yValue "2009" ;
    :belongsTo :Chart .
