@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Value of export of goods from China from 2009 to 2019 (in billion U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Exports in billion U.S. dollars" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2008" ;
    :yValue "1201.61" ;
    :belongsTo :Chart .

