@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "What brands do you typically prefer for treating your cough-cold and flu symptoms ?" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Brand" .

:YAxis a :Axis ;
    :title "Share of respondents" .

:DataPoint1 a :DataPoint ;
    :xValue "Dayquil/Nyquil" ;
    :yValue "0.72" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Mucinex" ;
    :yValue "0.495" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "Tylenol Cold" ;
    :yValue "0.48" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "Robitussin" ;
    :yValue "0.408" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "Emergen-C" ;
    :yValue "0.353" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Sudafed" ;
    :yValue "0.348" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Store brand" ;
    :yValue "0.283" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Alka Seltzer Cold" ;
    :yValue "0.21" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "Delsym" ;
    :yValue "0.165" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "Zicam" ;
    :yValue "0.14" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "Cold-Eeze" ;
    :yValue "0.115" ;
    :belongsTo :Chart .

:DataPoint12 a :DataPoint ;
    :xValue "Dimetapp" ;
    :yValue "0.113" ;
    :belongsTo :Chart .

:DataPoint13 a :DataPoint ;
    :xValue "Hyland's" ;
    :yValue "0.05" ;
    :belongsTo :Chart .

:DataPoint14 a :DataPoint ;
    :xValue "Oscillococcinum" ;
    :yValue "0.048" ;
    :belongsTo :Chart .

:DataPoint15 a :DataPoint ;
    :xValue "Other" ;
    :yValue "0.045" ;
    :belongsTo :Chart .
