@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Police pursuit related road traffic fatalities in England and Wales from 2004/05 to 2018/19" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Fatailities" .

:DataPoint1 a :DataPoint ;
    :xValue "2018/19" ;
    :yValue "30" ;
    :belongsTo :Chart .

