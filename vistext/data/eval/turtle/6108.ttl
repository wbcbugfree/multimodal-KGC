@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Voter turnout rates among 18 to 24 year olds by ethnicity in U.S. presidential elections from 1964 to 2016" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Black" .

