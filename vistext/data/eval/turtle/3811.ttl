@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Number of homicide offences involving a knife or sharp instrument in England and Wales from 2010/11 to 2018/19" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Number of offences" .

:YAxis a :Axis ;
    :title "Year" .

:DataPoint1 a :DataPoint ;
    :xValue "259" ;
    :yValue "2018/19" ;
    :belongsTo :Chart .

