@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Number of general practitioners employed in the United Kingdom (UK) from 2000 to 2019" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Number of employees" .

