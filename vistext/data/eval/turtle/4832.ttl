@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Percentage of people who bought products in e-commerce in Spain in 2020 , by product category" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Share of online shoppers" .

:YAxis a :Axis ;
    :title "Response" .

:DataPoint1 a :DataPoint ;
    :xValue "0.63" ;
    :yValue "Clothing/shoes" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "0.59" ;
    :yValue "Home electronics" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "0.49" ;
    :yValue "Sports and leisure products" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "0.39" ;
    :yValue "Books and audiobooks" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "0.36" ;
    :yValue "Groceries" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "0.34" ;
    :yValue "Cosmetics, skincare and haircare" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "0.29" ;
    :yValue "Toys" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "0.29" ;
    :yValue "Home furnishings" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "0.22" ;
    :yValue "Car accesories" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "0.21" ;
    :yValue "Children´s items" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "0.2" ;
    :yValue "Movies" ;
    :belongsTo :Chart .

:DataPoint12 a :DataPoint ;
    :xValue "0.19" ;
    :yValue "Pharmacy articles" ;
    :belongsTo :Chart .

:DataPoint13 a :DataPoint ;
    :xValue "0.13" ;
    :yValue "CDs" ;
    :belongsTo :Chart .
