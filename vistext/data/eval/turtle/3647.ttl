@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Average monthly costs of buying a home in the United Kingdom (UK) in 2019 , by region (in GBP)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Average monthly savings in GBP" .

:YAxis a :Axis ;
    :title "region of the United Kingdom" .

:DataPoint1 a :DataPoint ;
    :xValue "1378" ;
    :yValue "Greater London" ;
    :belongsTo :Chart .

