@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Revenue of Starwood Hotels & Resorts worldwide from 2005 to 2015 (in billion U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Revenue in billion U.S. dollars" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2004" ;
    :yValue "5.86" ;
    :belongsTo :Chart .

