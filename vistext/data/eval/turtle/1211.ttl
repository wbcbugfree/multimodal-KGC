@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Leading states with the highest number of people living in rural areas in India in 2011 (in millions)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "state of India" .

:YAxis a :Axis ;
    :title "Population in millions" .

