@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Reach of leading social networking sites used by those aged 15 to 25 in the United Kingdom (UK) as of 3rd quarter 2020" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Share of respondents" .

:YAxis a :Axis ;
    :title "Response" .

:DataPoint1 a :DataPoint ;
    :xValue "0.82" ;
    :yValue "YouTube" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "0.8" ;
    :yValue "Facebook" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "0.79" ;
    :yValue "WhatsApp" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "0.76" ;
    :yValue "Instagram" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "0.57" ;
    :yValue "Snapchat" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "0.44" ;
    :yValue "Twitter" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "0.3" ;
    :yValue "LinkedIn" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "0.28" ;
    :yValue "Pinterest" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "0.24" ;
    :yValue "TikTok" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "0.23" ;
    :yValue "Reddit" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "0.1" ;
    :yValue "Tumblr" ;
    :belongsTo :Chart .
