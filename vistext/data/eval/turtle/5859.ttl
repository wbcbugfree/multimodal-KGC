@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Percentage of population using the internet in Brazil from 2000 to 2018" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "Percentage of individuals using internet" .

