@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Milwaukee Brewers franchise value from 2002 to 2020 (in million U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Franchise value in million U.S. dollars" .

