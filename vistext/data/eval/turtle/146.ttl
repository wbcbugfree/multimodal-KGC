@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Most valuable sports teams worldwide in 2020 (in billion U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Sports team" .

:YAxis a :Axis ;
    :title "Brand value in billion U.S. dollars" .

:DataPoint1 a :DataPoint ;
    :xValue "Dallas Cowboys" ;
    :yValue "5.5" ;
    :belongsTo :Chart .

