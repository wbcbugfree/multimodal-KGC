@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Average weight of newborn babies in Iceland from 2009 to 2019 , by gender (in metric grams)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Total" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2008" ;
    :yValue "3608" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Dec 31, 2009" ;
    :yValue "3627" ;
    :belongsTo :Chart .

