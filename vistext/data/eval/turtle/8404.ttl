@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Consumer Price Index of cereal and its products across urban and rural India from July 2019 to July 2020" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Month" .

:YAxis a :Axis ;
    :title "All India" .

:DataPoint1 a :DataPoint ;
    :xValue "Jun 30, 2019" ;
    :yValue "139.3" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Jul 31, 2019" ;
    :yValue "140.1" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "Aug 31, 2019" ;
    :yValue "140.9" ;
    :belongsTo :Chart .

