    :xValue "Oct 31, 2019" ;
    :yValue "142.5" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Nov 30, 2019" ;
    :yValue "143.5" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Dec 31, 2019" ;
    :yValue "144.3" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Jan 31, 2020" ;
    :yValue "144.8" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
