@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Total population of El Salvador from 2008 to 2018 , by gender (in million inhabitants)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Female" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2007" ;
    :yValue "3.22" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Dec 31, 2008" ;
    :yValue "3.24" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "Dec 31, 2009" ;
    :yValue "3.26" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "Dec 31, 2010" ;
    :yValue "3.28" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "Dec 31, 2011" ;
    :yValue "3.29" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Dec 31, 2012" ;
    :yValue "3.31" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Dec 31, 2013" ;
    :yValue "3.33" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Dec 31, 2014" ;
    :yValue "3.35" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "Dec 31, 2015" ;
    :yValue "3.37" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "Dec 31, 2016" ;
    :yValue "3.39" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "Dec 31, 2017" ;
    :yValue "3.41" ;
    :belongsTo :Chart .
