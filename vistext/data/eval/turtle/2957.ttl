@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Sales volume of ice cream manufactured in the United Kingdom (UK) from 2009 to 2019 (in thousand liters)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Sales volume in thousand liters" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2008" ;
    :yValue "431696" ;
    :belongsTo :Chart .

