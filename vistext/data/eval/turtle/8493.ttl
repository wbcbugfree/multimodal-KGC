@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Total circulation of community newspapers in Canada from 2013 to 2019 , by province and territory (in 1,000s)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "province of Canada" .

:YAxis a :Axis ;
    :title "2016" .

:DataPoint1 a :DataPoint ;
