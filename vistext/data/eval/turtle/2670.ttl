@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Houston Rockets all-time assists leaders from 1967 to 2020" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Assists" .

:YAxis a :Axis ;
    :title "leader" .

:DataPoint1 a :DataPoint ;
