@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Index score of investor-owned utilities with the highest U.S. customer satisfaction in 2020" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "investor-owned utility" .

:YAxis a :Axis ;
    :title "Index score" .

:DataPoint1 a :DataPoint ;
    :xValue "Average investor-owned utilities" ;
    :yValue "72" ;
    :belongsTo :Chart .

