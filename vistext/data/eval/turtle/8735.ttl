@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Value of premiums written on the United Kingdom (UK) insurance market from 2009 to 2025 , by major classes of business (in million GBP)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Property" .

:DataPoint1 a :DataPoint ;
    :xValue "2025*" ;
    :yValue "19246" ;
    :belongsTo :Chart .

