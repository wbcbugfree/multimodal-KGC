@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Highest GDP growth rates among the largest U.S. metro areas in 2009" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "City of United States" .

:YAxis a :Axis ;
    :title "GDP growth" .

:DataPoint1 a :DataPoint ;
    :xValue "Baton Rouge, LA" ;
    :yValue "0.008" ;
    :belongsTo :Chart .

