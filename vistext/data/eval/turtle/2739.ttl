@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Machinery and equipment price index in Canada from 2006 to 2016" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Price index" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2005" ;
    :yValue "101.6" ;
    :belongsTo :Chart .

