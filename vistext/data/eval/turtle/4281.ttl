@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Percentage of total IT budgets spent on IT security from FY2005 to FY2017" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Share of total IT budget" .

:YAxis a :Axis ;
    :title "Response" .

:DataPoint1 a :DataPoint ;
    :xValue "0.075" ;
    :yValue "FY2005" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "0.072" ;
    :yValue "FY2006" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "0.075" ;
    :yValue "FY2007" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "0.079" ;
    :yValue "FY2008" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "0.091" ;
    :yValue "FY2009" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "0.086" ;
    :yValue "FY2010" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "0.088" ;
    :yValue "FY2011" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "0.091" ;
    :yValue "FY2012" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "0.099" ;
    :yValue "FY2013" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "0.092" ;
    :yValue "FY2014" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "0.1" ;
    :yValue "FY2015" ;
    :belongsTo :Chart .

:DataPoint12 a :DataPoint ;
    :xValue "0.102" ;
    :yValue "FY2016" ;
    :belongsTo :Chart .

:DataPoint13 a :DataPoint ;
    :xValue "0.106" ;
    :yValue "FY2017" ;
    :belongsTo :Chart .
