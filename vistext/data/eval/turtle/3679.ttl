@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Number of vector-borne disease cases in the U.S. from 2004 to 2018" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Number of cases" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2003" ;
    :yValue "27388" ;
    :belongsTo :Chart .

