@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Number of employees from the leading travel agencies worldwide in 2016" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "travel agencies" .

:YAxis a :Axis ;
    :title "Number of employees" .

