@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Consumer loss through cyber crime worldwide in 2017 , by victim country (in billion U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Annual loss in billion U.S. dollars" .

:YAxis a :Axis ;
    :title "Country" .

