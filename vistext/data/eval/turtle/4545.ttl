@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Total number of cases of child abuse in the U.S. from 1990 to 2010" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Number of child abuse cases" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 1989" ;
    :yValue "690658" ;
    :belongsTo :Chart .

