@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Turnover from retail sale of spare parts and accessories for all types of vehicle and sales of bicycles in the United Kingdom (UK) from 2008 to 2018 (in million GBP)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Turnover in million GBP" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2007" ;
    :yValue "1159" ;
    :belongsTo :Chart .

