@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Crude birth rate in each continent and worldwide , from 1950 to 2020" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Africa" .

:YAxis a :Axis ;
    :title "Year" .

:DataPoint1 a :DataPoint ;
    :xValue "33.6" ;
    :yValue "2015-2020" ;
    :belongsTo :Chart .

