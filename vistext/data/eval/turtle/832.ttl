    :xValue "Catherine Deneuve" ;
    :yValue "0.13" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Audrey Tautou" ;
    :yValue "0.08" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Isabelle Huppert" ;
    :yValue "0.08" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Isabelle Adjani" ;
