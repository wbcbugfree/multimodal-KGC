@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Ranking of the favorite French actresses in France in 2019" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "Share of respondents" .

:DataPoint1 a :DataPoint ;
    :xValue "Sophie Marceau" ;
    :yValue "0.36" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Marion Cortillard" ;
    :yValue "0.24" ;
    :belongsTo :Chart .

