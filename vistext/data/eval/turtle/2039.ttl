@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Most successful music tours in North America in 2020 , based on ticket sales" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Number of tickets sold" .

:YAxis a :Axis ;
    :title "Music tour" .

