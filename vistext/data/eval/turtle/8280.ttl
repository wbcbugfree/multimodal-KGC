@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Sales volume of fleet vans in the United Kingdom (UK) from January to September 2014 and January to September 2015 , by brand" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "2014" .

:YAxis a :Axis ;
    :title "Vehicle brand" .

:DataPoint1 a :DataPoint ;
