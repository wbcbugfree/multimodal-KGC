@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Current budget balance in Scotland as a percentage of United Kingdom (UK) gross domestic product (GDP) from 2008/09 to 2018/19" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "Share of UK GDP" .

:DataPoint1 a :DataPoint ;
    :xValue "2018/2019" ;
    :yValue "-0.057" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "2017/2018" ;
    :yValue "-0.068" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "2016/2017" ;
    :yValue "-0.072" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "2015/2016" ;
    :yValue "-0.086" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "2014/2015" ;
    :yValue "-0.087" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "2013/2014" ;
    :yValue "-0.095" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "2012/2013" ;
    :yValue "-0.108" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "2011/2012" ;
    :yValue "-0.112" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "2010/2011" ;
    :yValue "-0.127" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "2009/2010" ;
    :yValue "-0.127" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "2008/2009" ;
    :yValue "-0.1" ;
    :belongsTo :Chart .
