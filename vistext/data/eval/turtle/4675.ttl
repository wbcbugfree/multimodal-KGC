@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Annual growth of gross domestic product (GDP) of Canada from 2000 to 2018" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Annual gross domestic product growth" .

