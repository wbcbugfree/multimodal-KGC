@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Share of world military expenditure of the 15 states with the highest military expenditure 2019" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Share of global military spending" .

:YAxis a :Axis ;
    :title "Response" .

:DataPoint1 a :DataPoint ;
    :xValue "0.38" ;
    :yValue "USA" ;
    :belongsTo :Chart .

