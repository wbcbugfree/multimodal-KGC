@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Sony 's net income from 2007 to 2019 (in billion Japanese yen/million U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Fiscal years" .

:YAxis a :Axis ;
    :title "Million U.S. dollars" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2006" ;
    :yValue "3694" ;
    :belongsTo :Chart .

