@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Commodity prices : Average price per tonne of barley in the United Kingdom (UK) from 2002 to 2015 (in GBP)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Price per tonne in GBP" .

:YAxis a :Axis ;
    :title "Year" .

