@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Daily engagement rate of selected mobile social media apps among Android users in the United States as of June 2020" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Share of daily active users" .

:YAxis a :Axis ;
    :title "Response" .

:DataPoint1 a :DataPoint ;
    :xValue "0.625" ;
    :yValue "Facebook" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "0.61" ;
    :yValue "Instagram" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "0.554" ;
    :yValue "Snapchat" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "0.532" ;
    :yValue "Facebook Messenger" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "0.474" ;
    :yValue "TikTok" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "0.449" ;
    :yValue "Reddit" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "0.446" ;
    :yValue "Twitter" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "0.436" ;
    :yValue "WhatsApp" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "0.209" ;
    :yValue "Pinterest" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "0.207" ;
    :yValue "Tumblr" ;
    :belongsTo :Chart .
