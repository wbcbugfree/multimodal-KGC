@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Contents adults usually pack into their children 's lunch box in Great Britain in 2017" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Share of respondents" .

:YAxis a :Axis ;
    :title "Response" .

:DataPoint1 a :DataPoint ;
    :xValue "0.93" ;
    :yValue "Sandwiches" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "0.81" ;
    :yValue "Fresh fruit" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "0.59" ;
    :yValue "Yoghurt" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "0.52" ;
    :yValue "Juice" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "0.46" ;
    :yValue "Bottle of water" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "0.45" ;
    :yValue "Crisps" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "0.3" ;
    :yValue "Cheese snack/cheese strings" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "0.26" ;
    :yValue "Cereal bars" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "0.18" ;
    :yValue "Other" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "0.14" ;
    :yValue "Milk" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "0.09" ;
    :yValue "Smoothie" ;
    :belongsTo :Chart .

:DataPoint12 a :DataPoint ;
    :xValue "0.03" ;
    :yValue "Popcorn" ;
    :belongsTo :Chart .
