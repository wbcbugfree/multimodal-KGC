@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Share of electricity demand from coal during COVID-19 lockdown in Europe from March 28 to April 26 2020 , by select country" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Country" .

:YAxis a :Axis ;
    :title "2020" .

:DataPoint1 a :DataPoint ;
    :xValue "United Kingdo" ;
    :yValue "0.01" ;
    :belongsTo :Chart .

