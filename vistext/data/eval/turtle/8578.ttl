@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "If and when did you purchase airline ancillary services ?" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Before leaving for the trip" .

:YAxis a :Axis ;
    :title "Response" .

:DataPoint1 a :DataPoint ;
    :xValue "0.2" ;
    :yValue "Checked bagge" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "0.27" ;
    :yValue "Advance seat selection" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "0.06" ;
    :yValue "In-flight meals/snacks" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "0.03" ;
    :yValue "In-flight movies/entertainment" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "0.09" ;
    :yValue "Additional frequent flyer program miles" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "0.09" ;
    :yValue "Preferred seating/extra legroom" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "0.08" ;
    :yValue "Priority boarding" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "0.03" ;
    :yValue "In-flight wireless Internet access" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "0.03" ;
    :yValue "Airport lounge access" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "0.05" ;
    :yValue "Discounted flight change fee" ;
    :belongsTo :Chart .
