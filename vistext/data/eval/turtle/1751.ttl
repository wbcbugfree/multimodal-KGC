@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Final consumption expenditure (FCE) on alcoholic beverages and tobacco as a share of the gross domestic product (GDP) in Malaysia from 2010 to 2019" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Share of gross domestic product" .

:YAxis a :Axis ;
    :title "Response" .

:DataPoint1 a :DataPoint ;
    :xValue "0.011" ;
    :yValue "2019**" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "0.011" ;
    :yValue "2018*" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "0.011" ;
    :yValue "2017" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "0.011" ;
    :yValue "2016" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "0.011" ;
    :yValue "2015" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "0.01" ;
    :yValue "2014" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "0.01" ;
    :yValue "2013" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "0.009" ;
    :yValue "2012" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "0.009" ;
    :yValue "2011" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "0.01" ;
    :yValue "2010" ;
    :belongsTo :Chart .
