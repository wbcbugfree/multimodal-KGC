@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Percentage of live births delivered by cesarean section worldwide in 2000 and 2015 , by region" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "geographic region" .

:YAxis a :Axis ;
    :title "2015" .

:DataPoint1 a :DataPoint ;
    :xValue "Globa" ;
    :yValue "0.211" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Global West and Central Afric" ;
    :yValue "0.041" ;
    :belongsTo :Chart .

