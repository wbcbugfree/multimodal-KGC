    :xValue "Middle East and North Africa South Asi" ;
    :yValue "0.181" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "South Asia East Asia and Pacifi" ;
    :yValue "0.288" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "East Asia and Pacific Latin America and Caribbea" ;
    :yValue "0.443" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Latin America and Caribbean Eastern Europe and Central Asi" ;
    :yValue "0.273" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "Eastern Europe and Central Asia North Americ" ;
