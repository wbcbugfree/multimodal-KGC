@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Average conversion rate of mobile retail sales via tablet per month in the United Kingdom (UK) from January to December 2013" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Conversion rate" .

:YAxis a :Axis ;
    :title "Month" .

:DataPoint1 a :DataPoint ;
    :xValue "0.023" ;
    :yValue "Dec 13" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "0.013" ;
    :yValue "Nov 13" ;
    :belongsTo :Chart .

