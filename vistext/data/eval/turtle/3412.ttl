    :xValue "0.029" ;
    :yValue "Jul 13" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "0.032" ;
    :yValue "Jun 13" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "0.032" ;
    :yValue "May 13" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
