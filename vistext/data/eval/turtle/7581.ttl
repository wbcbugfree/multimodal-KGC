@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Number of playing weeks of Broadway shows in New York from 2006 to 2019 , by category" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Season" .

:YAxis a :Axis ;
    :title "Specials" .

:DataPoint1 a :DataPoint ;
    :xValue "2018/19" ;
    :yValue "38" ;
    :belongsTo :Chart .

