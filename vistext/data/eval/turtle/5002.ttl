@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "10 Countries in Asia Pacific with the largest number of Christians in 2010 (in millions)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Country" .

:YAxis a :Axis ;
    :title "Estimated Christian population in millions" .

:DataPoint1 a :DataPoint ;
    :xValue "Philippines" ;
    :yValue "86.79" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "China" ;
    :yValue "67.07" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "India" ;
    :yValue "31.85" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "Indonesia" ;
    :yValue "21.16" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "Australia" ;
    :yValue "16.03" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "South Korea" ;
    :yValue "14.1" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Vietnam" ;
    :yValue "7.03" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Papua New Guinea" ;
    :yValue "6.8" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "Kazakhstan" ;
    :yValue "4.19" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "Burma (Myanmar)" ;
    :yValue "3.79" ;
    :belongsTo :Chart .
