@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Number of murders in the United States by relationship of victim to offender in 2019" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Relationship of victim to offender" .

:YAxis a :Axis ;
    :title "Number of murder victims" .

