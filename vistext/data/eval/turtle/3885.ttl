@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Import value of fuel and lubricants to Kenya from May 2019 to May 2020 (in million Kenyan shillings)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Month" .

:YAxis a :Axis ;
    :title "Import value in million Kenyan shillings" .

:DataPoint1 a :DataPoint ;
    :xValue "Apr 30, 2019" ;
    :yValue "35182.14" ;
    :belongsTo :Chart .

