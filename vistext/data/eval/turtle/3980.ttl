@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "U.S. commercial sector energy consumption from 1975 to 2019 (in quadrillion Btu)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Consumption in quadrillion British thermal units" .

