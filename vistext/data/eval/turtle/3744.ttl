@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Ranking of the most followed French musicians on the social network Twitter in the world as of October 9 , 2017 (in millions)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Number of followers in millions" .

:YAxis a :Axis ;
    :title "most followed French musicians" .

:DataPoint1 a :DataPoint ;
    :xValue "21.9" ;
    :yValue "David Guetta" ;
    :belongsTo :Chart .

