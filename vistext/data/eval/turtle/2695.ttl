@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Volume of cargo handled in non-major ports across India from financial year 2010 to 2019 (in million metric tons)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Volume in million metric tons" .

:YAxis a :Axis ;
    :title "Year" .

:DataPoint1 a :DataPoint ;
    :xValue "582.61" ;
    :yValue "FY 2019" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "529.09" ;
    :yValue "FY 2018" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "485.22" ;
    :yValue "FY 2017" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "465.87" ;
    :yValue "FY 2016" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "470.89" ;
    :yValue "FY 2015" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "416.97" ;
    :yValue "FY 2014" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "387.92" ;
    :yValue "FY 2013" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "353.74" ;
    :yValue "FY 2012" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "315.36" ;
    :yValue "FY 2011" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "288.94" ;
    :yValue "FY 2010" ;
    :belongsTo :Chart .
