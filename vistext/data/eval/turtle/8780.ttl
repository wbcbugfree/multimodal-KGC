@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Number of international visitor arrivals in Finland from January to July 2020 , by country of origin" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Country" .

:YAxis a :Axis ;
    :title "April*" .

:DataPoint1 a :DataPoint ;
    :xValue "Russia" ;
    :yValue "113" ;
    :belongsTo :Chart .

