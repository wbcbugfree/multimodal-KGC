@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Volume of consumer book sales in the United Kingdom (UK) from 2003 to 2014 (in million books)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Books in millions" .

:DataPoint1 a :DataPoint ;
    :xValue "2014" ;
    :yValue "180.6" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "2013" ;
    :yValue "184.1" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "2012" ;
    :yValue "205.5" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "2011" ;
    :yValue "206.2" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "2010" ;
    :yValue "229.9" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "2009" ;
    :yValue "235.7" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "2008" ;
    :yValue "218.8" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "2007" ;
    :yValue "232.3" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "2006" ;
    :yValue "220.9" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "2005*" ;
    :yValue "207.8" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "2004" ;
