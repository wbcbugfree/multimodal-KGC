@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Number of white , non-Hispanic families with a single mother in the United States from 1990 to 2019 (in 1,000s)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Number of families in thousands" .

