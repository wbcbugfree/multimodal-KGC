@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Share price index in major developed and emerging economies from November 2019 to November 2020" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Month" .

:YAxis a :Axis ;
    :title "United States" .

