@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Do you think the United States is the No . 1 in the world militarily , or that it is one of several leading military powers ?" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "U.S. is No. 1" .

:DataPoint1 a :DataPoint ;
    :xValue "2020*" ;
    :yValue "0.58" ;
    :belongsTo :Chart .

