@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "The Lord of the Rings : Age of selected characters" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Age in years" .

:YAxis a :Axis ;
    :title "Character" .

:DataPoint1 a :DataPoint ;
    :xValue "589" ;
    :yValue "Gollum" ;
    :belongsTo :Chart .

