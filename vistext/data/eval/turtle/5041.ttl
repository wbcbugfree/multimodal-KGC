@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Infant mortality rate (under one year old) in the United States from 1935 to 2020" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Deaths per 1,000 live births" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 1934" ;
    :yValue "61" ;
    :belongsTo :Chart .

