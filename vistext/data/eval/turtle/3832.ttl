@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "When shopping in retail stores , how do you use your smartphone ?" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Share of respondents" .

:YAxis a :Axis ;
    :title "Response" .

:DataPoint1 a :DataPoint ;
    :xValue "0.36" ;
    :yValue "Compare Prices" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "0.24" ;
    :yValue "Read product details" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "0.21" ;
    :yValue "Scan a QR code" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "0.16" ;
    :yValue "Read reviews and feedback" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "0.14" ;
    :yValue "Seacrch for specific products and alternatives" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "0.14" ;
    :yValue "Search for a different online seller" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "0.1" ;
    :yValue "Contact friends/family to request feedback" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "0.09" ;
    :yValue "Check in-stock status at another store/on the retailer's website" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "0.08" ;
    :yValue "Upload a picture of a product" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "0.07" ;
    :yValue "Place an order to be shipped to you" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "0.4" ;
    :yValue "None of the above" ;
    :belongsTo :Chart .
