    :yValue "1244" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Coop Italia" ;
    :yValue "1118" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Eurospin" ;
    :yValue "1050" ;
