@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Number of stores of the leading ten national and international retailers in Italy in 2018" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "business" .

:YAxis a :Axis ;
    :title "Number of stores" .

:DataPoint1 a :DataPoint ;
    :xValue "Crai" ;
    :yValue "3600" ;
    :belongsTo :Chart .

