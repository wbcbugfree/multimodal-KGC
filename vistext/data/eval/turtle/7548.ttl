@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Have you subscribed to any of the following streaming or online dating services since the lockdown in your country ? (as of May 31 , 2020)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Germany" .

:YAxis a :Axis ;
    :title "Response" .

:DataPoint1 a :DataPoint ;
    :xValue "0.14" ;
    :yValue "Netflix" ;
    :belongsTo :Chart .

