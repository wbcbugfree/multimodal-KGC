@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Percentage of respondents worldwide who felt COVID-19 posed a very high or high level of threat to their country as of March 14 , 2020 , by country" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "February 28 to 29" .

:DataPoint1 a :DataPoint ;
    :xValue "Australia" ;
    :yValue "0.35" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Canada" ;
    :yValue "0.21" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "France" ;
    :yValue "0.49" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "Germany" ;
    :yValue "0.31" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "Italy" ;
    :yValue "0.34" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Japan" ;
    :yValue "0.65" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Russia" ;
    :yValue "0.33" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "United Kingdom" ;
    :yValue "0.26" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "United States" ;
    :yValue "0.37" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "Vietnam*" ;
    :yValue "0.63" ;
    :belongsTo :Chart .
