@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Number of U.S. high schools with athletics programs for girls from 2009/10 to 2018/19 , by sport" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Swimming and Diving" .

:DataPoint1 a :DataPoint ;
    :xValue "2009/10" ;
    :yValue "7171" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "2010/11" ;
    :yValue "7164" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "2011/12" ;
    :yValue "7221" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "2012/13" ;
    :yValue "7249" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "2013/14" ;
    :yValue "7429" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "2014/15" ;
    :yValue "7526" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "2015/16" ;
    :yValue "7559" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "2016/17" ;
    :yValue "7721" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "2017/18" ;
    :yValue "7961" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "2018/19" ;
    :yValue "8007" ;
    :belongsTo :Chart .
