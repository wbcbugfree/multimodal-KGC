@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Lesotho : Urbanization from 2009 to 2019" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Unnamed: 1" .

