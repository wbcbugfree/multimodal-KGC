@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Which should be prioritized - the protection of the environment , even at the risk of limiting the amount of energy supplies , or the development of energy supplies , even if the environment suffers ?" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "Prioritize development of U.S. energy supplies" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2000" ;
    :yValue "0.36" ;
    :belongsTo :Chart .

