@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Number of concerts and festivals promoted by Live Nation from 2008 to 2019" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Number of events" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2007" ;
    :yValue "22167" ;
    :belongsTo :Chart .

