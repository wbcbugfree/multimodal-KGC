@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Leading female Italian athletes in the high jump as of December 2020 , by IAAF score" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Athlete" .

:YAxis a :Axis ;
    :title "IAAF score" .

:DataPoint1 a :DataPoint ;
    :xValue "Alessia Trost" ;
    :yValue "1216" ;
    :belongsTo :Chart .

