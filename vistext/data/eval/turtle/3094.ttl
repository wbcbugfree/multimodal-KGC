@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Average retail price of liquid milk in the United Kingdom (UK) from September 2015 to March 2018 (in pence per liter) , by monthly 52 weeks ending data sets" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Retail price in pence per liter" .

:DataPoint1 a :DataPoint ;
    :xValue "Sep 12, 2015" ;
    :yValue "57" ;
    :belongsTo :Chart .

