@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Total assets of WD-40 Company from 2009 to 2020 (in million U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Total assets in million U.S. dollars" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2008" ;
    :yValue "262.6" ;
    :belongsTo :Chart .

