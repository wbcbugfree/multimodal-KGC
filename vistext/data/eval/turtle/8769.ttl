@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Number of people immigrating to Denmark from 2009 to 2019 , by citizenship" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Foreign citizenship" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2008" ;
    :yValue "46032" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Dec 31, 2009" ;
    :yValue "47670" ;
    :belongsTo :Chart .

