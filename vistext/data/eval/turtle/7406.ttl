@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Number of tanker ships in OPEC countries from 2012 to 2016" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "2015" .

:YAxis a :Axis ;
    :title "Country" .

:DataPoint1 a :DataPoint ;
    :xValue "46" ;
    :yValue "Iran" ;
    :belongsTo :Chart .

