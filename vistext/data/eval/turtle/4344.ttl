    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "233" ;
    :yValue "Chase Utley" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "223" ;
    :yValue "Greg Luzinski" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
