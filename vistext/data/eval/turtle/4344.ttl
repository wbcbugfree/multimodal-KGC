@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Philadelphia Phillies all-time home run leaders as of October 2020" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Number of home runs" .

:YAxis a :Axis ;
    :title "Home run leader" .

:DataPoint1 a :DataPoint ;
    :xValue "548" ;
    :yValue "Mike Schmidt" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "382" ;
    :yValue "Ryan Howard" ;
    :belongsTo :Chart .

