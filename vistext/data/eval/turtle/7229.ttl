@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Major countries in worldwide graphite mine production from 2015 to 2019 (in 1,000 metric tons)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Country" .

:YAxis a :Axis ;
    :title "2016" .

