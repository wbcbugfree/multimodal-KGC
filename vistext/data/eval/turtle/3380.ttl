@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Vodafone 4G coverage of population in selected European countries in 2020" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Coverage share" .

:YAxis a :Axis ;
    :title "Country" .

:DataPoint1 a :DataPoint ;
    :xValue "1" ;
    :yValue "United Kingdom" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "1" ;
    :yValue "Netherlands" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "0.99" ;
    :yValue "Italy" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "0.99" ;
    :yValue "Czechia" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "0.98" ;
    :yValue "Spain" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "0.98" ;
    :yValue "Portugal" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "0.97" ;
    :yValue "Hungary" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "0.96" ;
    :yValue "Ireland" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "0.96" ;
    :yValue "Germany" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "0.96" ;
    :yValue "Greece" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "0.96" ;
    :yValue "Albania" ;
    :belongsTo :Chart .

:DataPoint12 a :DataPoint ;
    :xValue "0.84" ;
    :yValue "Romania" ;
    :belongsTo :Chart .
