@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Do you have a tattoo ? (by occupation)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Share of respondents answering yes" .

:YAxis a :Axis ;
    :title "Response" .

:DataPoint1 a :DataPoint ;
    :xValue "0.22" ;
    :yValue "Agriculture & ranching" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "0.2" ;
    :yValue "Hospitality, tourism & recreation" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "0.16" ;
    :yValue "Arts & media" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "0.14" ;
    :yValue "Retail" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "0.13" ;
    :yValue "Finance & banking" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "0.13" ;
    :yValue "Healthcare & medical technology" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "0.13" ;
    :yValue "Professional services" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "0.12" ;
    :yValue "Education & family services" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "0.09" ;
    :yValue "Manufacturing" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "0.09" ;
    :yValue "Energy & utilities" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "0.09" ;
    :yValue "Engineer, design & construction" ;
    :belongsTo :Chart .

:DataPoint12 a :DataPoint ;
    :xValue "0.09" ;
    :yValue "Information technology" ;
    :belongsTo :Chart .

:DataPoint13 a :DataPoint ;
    :xValue "0.08" ;
    :yValue "Government" ;
    :belongsTo :Chart .
