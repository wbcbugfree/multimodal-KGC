@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Crude rate of birth in Sweden from 1960 to 2016 (per 1,000 population)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Birth rate per thousand population" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 1959" ;
    :yValue "13.7" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Dec 31, 1969" ;
    :yValue "13.7" ;
    :belongsTo :Chart .

