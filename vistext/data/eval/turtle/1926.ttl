@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Number of downloads of leading Android apps in Spain in 2014" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Mobile App" .

:YAxis a :Axis ;
    :title "Number of downloads" .

:DataPoint1 a :DataPoint ;
    :xValue "Tuenti" ;
    :yValue "17500000" ;
    :belongsTo :Chart .

