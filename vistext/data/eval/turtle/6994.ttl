@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Average annual wages in major developed countries from 2008 to 2019 (in U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "France" .

