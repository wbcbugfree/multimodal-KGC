@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Sales volume of roasted coffee manufactured in the United Kingdom (UK) from 2008 to 2019 (in tons)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Sales volume in tonnes" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2007" ;
    :yValue "23313" ;
    :belongsTo :Chart .

