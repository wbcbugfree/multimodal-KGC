@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Real defense spending per capita by the United Kingdom (UK) and other NATO allies , from 2009 to 2018 (in U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "USA" .

:DataPoint1 a :DataPoint ;
    :xValue "2009" ;
    :yValue "2863.2" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "2010" ;
    :yValue "2671.3" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "2011" ;
    :yValue "2671.4" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "2012" ;
    :yValue "2505" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "2013" ;
    :yValue "2334.8" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "2014" ;
    :yValue "2185.1" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "2015" ;
    :yValue "2104.8" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "2016" ;
    :yValue "2115" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "2017" ;
    :yValue "2020.8" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "2018*" ;
    :yValue "2053.6" ;
    :belongsTo :Chart .
