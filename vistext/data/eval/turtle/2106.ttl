@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Share of the population with high blood pressure in the Netherlands from 2007 to 2019" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "Share of the population" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2006" ;
    :yValue "0.12" ;
    :belongsTo :Chart .

