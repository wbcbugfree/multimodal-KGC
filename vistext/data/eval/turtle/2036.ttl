@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Number of tramadol hydrochloride prescriptions in the U.S. from 2004 to 2017 (in millions)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Total prescriptions in millions" .

