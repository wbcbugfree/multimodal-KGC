@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Percent of wives who earn more than their husbands in married couple households in the United States from 1990 to 2012" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Percent of double-income households" .

