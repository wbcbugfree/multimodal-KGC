@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Sales volume of Mahindra cars across India in 2019 , by model" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "automobile model" .

:YAxis a :Axis ;
    :title "Number of vehicles sold" .

:DataPoint1 a :DataPoint ;
    :xValue "Bolero" ;
    :yValue "69656" ;
    :belongsTo :Chart .

