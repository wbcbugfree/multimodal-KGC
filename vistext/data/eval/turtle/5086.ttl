@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Distribution of rare earths production worldwide as of 2019 , by country" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Share of global production" .

:YAxis a :Axis ;
    :title "Response" .

:DataPoint1 a :DataPoint ;
    :xValue "0.6197" ;
    :yValue "China" ;
    :belongsTo :Chart .

