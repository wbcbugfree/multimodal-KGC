@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Which of the following sources of information do you use to keep up with entertainment and celebrity news ?" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "Share of respondents" .

:DataPoint1 a :DataPoint ;
    :xValue "Broadcasters (TV radio or online)" ;
    :yValue "0.46" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "National newspapers (print or online)" ;
    :yValue "0.42" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "Friends, relatives or colleagues" ;
    :yValue "0.25" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "Social media eg Facebook" ;
    :yValue "0.23" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "Magazines (print or online)" ;
    :yValue "0.18" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Local newspapers (print or online)" ;
    :yValue "0.12" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Online specialist sites/blogs" ;
    :yValue "0.1" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Email newsletters/alerts" ;
    :yValue "0.05" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "None of these" ;
    :yValue "0.13" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "Don't know" ;
    :yValue "0.03" ;
    :belongsTo :Chart .
