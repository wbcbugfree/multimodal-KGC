@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Sales price of ice cream per ton manufactured in the United Kingdom (UK) from 2009 to 2019 (in GBP)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Price per litre in British pounds" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2008" ;
    :yValue "1.3" ;
    :belongsTo :Chart .

