@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Which of the following have you ever taken a selfie with ?" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "Share of respondents" .

:DataPoint1 a :DataPoint ;
    :xValue "I have never taken a selfie" ;
    :yValue "0.36" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Family" ;
    :yValue "0.34" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "Friends" ;
    :yValue "0.29" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "Pet(s)" ;
    :yValue "0.19" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "I have never taken a selfie with anything" ;
    :yValue "0.16" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Buildings/landmarks" ;
    :yValue "0.13" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Landscapes" ;
    :yValue "0.13" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Objects" ;
    :yValue "0.1" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "Food" ;
    :yValue "0.1" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "Celebrity" ;
    :yValue "0.02" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "Exotic animal(s) (e.g., tiger, elephant, etc.)" ;
    :yValue "0.01" ;
    :belongsTo :Chart .

:DataPoint12 a :DataPoint ;
    :xValue "Other" ;
    :yValue "0.01" ;
    :belongsTo :Chart .
