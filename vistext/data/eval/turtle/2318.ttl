@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Percentage of U.S. college students that had 5 or more alcoholic drinks (males) or 4 or more (females) in one sitting within the past two weeks as of fall 2019" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Percentage of respondents" .

:YAxis a :Axis ;
    :title "Response" .

:DataPoint1 a :DataPoint ;
    :xValue "0.466" ;
    :yValue "None" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "0.245" ;
    :yValue "1 time" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "0.141" ;
    :yValue "2 times" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "0.063" ;
    :yValue "3 times" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "0.043" ;
    :yValue "4 times" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "0.02" ;
    :yValue "5 times" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "0.009" ;
    :yValue "6 times" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "0.004" ;
    :yValue "7 times" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "0.004" ;
    :yValue "8 times" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "0.001" ;
    :yValue "9 times" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "0.003" ;
    :yValue "10 times or more" ;
    :belongsTo :Chart .
