@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Bristol-Myers Squibb 's revenue from key products as a percentage of total revenue from 2006 to 2019" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Percentage of total revenue" .

:YAxis a :Axis ;
    :title "Response" .

:DataPoint1 a :DataPoint ;
    :xValue "0.91" ;
    :yValue "2019***" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "0.86" ;
    :yValue "2018**" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "0.75" ;
    :yValue "2017**" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "0.68" ;
    :yValue "2016*" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "0.84" ;
    :yValue "2015*" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "0.8" ;
    :yValue "2014" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "0.83" ;
    :yValue "2013" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "0.84" ;
    :yValue "2012" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "0.86" ;
    :yValue "2011" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "0.84" ;
    :yValue "2010" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "0.81" ;
    :yValue "2009" ;
    :belongsTo :Chart .

:DataPoint12 a :DataPoint ;
    :xValue "0.77" ;
    :yValue "2008" ;
    :belongsTo :Chart .

:DataPoint13 a :DataPoint ;
    :xValue "0.71" ;
    :yValue "2007" ;
    :belongsTo :Chart .

:DataPoint14 a :DataPoint ;
    :xValue "0.72" ;
    :yValue "2006" ;
    :belongsTo :Chart .
