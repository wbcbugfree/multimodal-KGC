@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Health expenditure as a share of gross domestic product in Malaysia 2005 to 2016" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Health expenditure as a share of GDP" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2004" ;
    :yValue "0.0293" ;
    :belongsTo :Chart .

