@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Number of fatalities resulting from incidences of terrorism in the European Union (EU) in 2017" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Month" .

:YAxis a :Axis ;
    :title "Number of fatalities" .

:DataPoint1 a :DataPoint ;
    :xValue "May 22, 2017 (Manchester, UK)" ;
    :yValue "22" ;
    :belongsTo :Chart .

