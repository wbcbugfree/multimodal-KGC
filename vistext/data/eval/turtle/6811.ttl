@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Total number of Western and non-Western immigrants in the Netherlands from 2009 to 2019" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Non-Western origin" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2008" ;
    :yValue "52711" ;
    :belongsTo :Chart .

