@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "U.S. merchandise imports that came from NAFTA countries in 2019 , by industry classification (in billion U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Import value in billion U.S. dollars" .

:YAxis a :Axis ;
    :title "industry classification" .

:DataPoint1 a :DataPoint ;
    :xValue "195.6" ;
    :yValue "Transportation equipment" ;
    :belongsTo :Chart .

