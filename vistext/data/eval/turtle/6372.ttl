@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Average cigarette prices in Canada from 2006 to 2014 , by region (in Canadian dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "region of Canada" .

:YAxis a :Axis ;
    :title "Mar 31, 2006" .

:DataPoint1 a :DataPoint ;
    :xValue "British Columbia" ;
    :yValue "79.84" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Alberta" ;
    :yValue "75.78" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "Saskatchewan" ;
    :yValue "84.15" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "Manitoba" ;
    :yValue "84.15" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "Ontario" ;
    :yValue "67.97" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Quebec" ;
    :yValue "63.58" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "New Brunswick" ;
    :yValue "71.67" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Nova Scotia" ;
    :yValue "80.34" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "Prince Edward Island" ;
    :yValue "78.88" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "Newfoundland and Labrador" ;
    :yValue "84.89" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "Yukon Territory" ;
    :yValue "69.79" ;
    :belongsTo :Chart .

:DataPoint12 a :DataPoint ;
    :xValue "Northwest Territories" ;
    :yValue "86.48" ;
    :belongsTo :Chart .

:DataPoint13 a :DataPoint ;
    :xValue "Nunavut" ;
    :yValue "74.92" ;
    :belongsTo :Chart .
