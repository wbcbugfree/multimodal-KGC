@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Leading 10 U.S. states based on hay production in 2018 (in 1,000 tons)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "State" .

:YAxis a :Axis ;
    :title "Production in thousand tons" .

:DataPoint1 a :DataPoint ;
    :xValue "Texas" ;
    :yValue "8374" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Nebraska" ;
    :yValue "6985" ;
    :belongsTo :Chart .

