    :xValue "South Dakota" ;
    :yValue "5788" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "California" ;
    :yValue "5682" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "Montana" ;
    :yValue "5595" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Missouri" ;
    :yValue "5408" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Oklahoma" ;
    :yValue "5121" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Kentucky" ;
    :yValue "5088" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "Idaho" ;
