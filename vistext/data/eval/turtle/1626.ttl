@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Total number of companies on the European insurance market from 2004 to 2013" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Number of companies" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2003" ;
    :yValue "5329" ;
    :belongsTo :Chart .

