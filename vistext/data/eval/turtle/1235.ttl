@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Average sentence for individuals jailed for terrorist offences in the European Union as of 2019 , by EU member state (in years)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Average sentence in years" .

:YAxis a :Axis ;
    :title "Country" .

