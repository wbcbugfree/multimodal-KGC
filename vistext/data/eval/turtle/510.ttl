@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Turnover from retail sale of footwear and leather goods in specialized stores in the European Union from 2008 to 2017 (in million euros)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Annual turnover in million euros" .

:YAxis a :Axis ;
    :title "Year" .

:DataPoint1 a :DataPoint ;
    :xValue "45911.4" ;
    :yValue "2017" ;
    :belongsTo :Chart .

