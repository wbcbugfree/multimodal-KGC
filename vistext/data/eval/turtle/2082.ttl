@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "What do you think are the main reasons why couples do not have more children ?" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Share of respondents" .

:YAxis a :Axis ;
    :title "Response" .

:DataPoint1 a :DataPoint ;
    :xValue "0.65" ;
    :yValue "Not enough money/Cost of raising child" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "0.11" ;
    :yValue "The state of the economy/Jobs" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "0.06" ;
    :yValue "Personal choice/No desire for children" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "0.05" ;
    :yValue "Poor society/Living in difficult times/Difficult environment" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "0.04" ;
    :yValue "Too selfish/Feel children interfere with personal freedom" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "0.03" ;
    :yValue "Single-parent homes/Divorce/Lack of commitment to marriage" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "0.03" ;
    :yValue "Lack of time/Too busy/Too time consuming" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "0.03" ;
    :yValue "Too many women working/Both parents work/Career concerns" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "0.03" ;
    :yValue "Children are hard work/Stressful" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "0.02" ;
    :yValue "Unable to have children/Cannot conceive" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "0.02" ;
    :yValue "Responsibilities involved/Too much responsibility" ;
    :belongsTo :Chart .

:DataPoint12 a :DataPoint ;
    :xValue "0.01" ;
    :yValue "Wife or husband not in good health" ;
    :belongsTo :Chart .

:DataPoint13 a :DataPoint ;
    :xValue "0.01" ;
    :yValue "Parents are older/Waited to have children" ;
    :belongsTo :Chart .

:DataPoint14 a :DataPoint ;
    :xValue "0.01" ;
    :yValue "Cost of education" ;
    :belongsTo :Chart .

:DataPoint15 a :DataPoint ;
    :xValue "0.01" ;
    :yValue "Too many children already/Concerned about overpopulation" ;
    :belongsTo :Chart .

:DataPoint16 a :DataPoint ;
    :xValue "0.01" ;
    :yValue "Uncertainty about the future/Future is bleak" ;
    :belongsTo :Chart .

:DataPoint17 a :DataPoint ;
    :xValue "0.01" ;
    :yValue "Just don’t like children" ;
    :belongsTo :Chart .

:DataPoint18 a :DataPoint ;
    :xValue "0.01" ;
    :yValue "Other" ;
    :belongsTo :Chart .

:DataPoint19 a :DataPoint ;
    :xValue "0.06" ;
    :yValue "No opinion" ;
    :belongsTo :Chart .
