@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Monthly average temperature deviation from the long term mean in the United Kingdom (UK) from January 2015 to February 2020 (in degrees Celsius)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Month" .

:YAxis a :Axis ;
    :title "2020" .

:DataPoint1 a :DataPoint ;
    :xValue "Ja" ;
    :yValue "2.1" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Jan Fe" ;
    :yValue "1.7" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "Feb Ma" ;
    :yValue "0.3" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "Mar Ap" ;
    :yValue "1.9" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "Apr Ma" ;
    :yValue "1.2" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "May Ju" ;
    :yValue "1" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Jun Ju" ;
    :yValue "-0.8" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Jul Au" ;
    :yValue "1" ;
    :belongsTo :Chart .
