@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Total assets of the Bank of China from 2010 to 2019 (in billion yuan)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Total assets in billion yuan" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2009" ;
    :yValue "10459.7" ;
    :belongsTo :Chart .

