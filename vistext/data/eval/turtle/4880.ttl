    :xValue "Dec 31, 2013" ;
    :yValue "15251.4" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Dec 31, 2014" ;
    :yValue "16815.6" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
