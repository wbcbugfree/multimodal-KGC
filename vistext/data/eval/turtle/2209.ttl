@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Player expenses of the Baltimore Orioles from 2001 to 2019 (in million U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Player expenses in million U.S. dollars" .

