@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Total number of passenger cars exported from the United Kingdom (UK) between 2003 and 2019 (in units)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Number of passenger cars exported in units" .

