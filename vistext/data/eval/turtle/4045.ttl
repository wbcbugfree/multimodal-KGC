@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Tissue and fluff demand worldwide from 2018 to 2030 (in million metric tons)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Demand in million metric tons" .

:DataPoint1 a :DataPoint ;
    :xValue "2030*" ;
    :yValue "59" ;
    :belongsTo :Chart .

