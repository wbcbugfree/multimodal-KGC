@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Number of auto thefts per 100,000 vehicles in Brazil from 2007 to 2018" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Auto thefts per 100,000 vehicles" .

:YAxis a :Axis ;
    :title "Year" .

:DataPoint1 a :DataPoint ;
    :xValue "245.3" ;
    :yValue "2018" ;
    :belongsTo :Chart .

