@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Smartphone unit shipments by price category worldwide from 2012 to 2022 (in millions)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Mid-tier smartphone" .

:YAxis a :Axis ;
    :title "Year" .

:DataPoint1 a :DataPoint ;
    :xValue "580" ;
    :yValue "2022*" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "570" ;
    :yValue "2021*" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "580" ;
    :yValue "2020*" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "550" ;
    :yValue "2019*" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "520" ;
    :yValue "2018*" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "480" ;
    :yValue "2017" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "450" ;
    :yValue "2016" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "370" ;
    :yValue "2015" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "310" ;
    :yValue "2014" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "210" ;
    :yValue "2013" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "120" ;
    :yValue "2012" ;
    :belongsTo :Chart .
