@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Modern and contemporary art sales at auction in India from 2006 to 2015 (in million U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Auction sales in million U.S. dollars" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2005" ;
    :yValue "77" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Dec 31, 2006" ;
    :yValue "40" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "Dec 31, 2007" ;
    :yValue "67" ;
    :belongsTo :Chart .

