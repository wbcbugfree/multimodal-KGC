@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "San Diego Padres all-time home run leaders as of October 2020" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Number of home runs" .

:YAxis a :Axis ;
    :title "Home run leader" .

:DataPoint1 a :DataPoint ;
    :xValue "163" ;
    :yValue "Nate Colbert" ;
    :belongsTo :Chart .

