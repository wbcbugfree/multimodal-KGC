@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Rate of most common operating room procedures in United states hospital stays in 2012 (per 100,000 population)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "most common operating room procedures" .

:YAxis a :Axis ;
    :title "Procedures per 100,000 population" .

:DataPoint1 a :DataPoint ;
    :xValue "Arthroplasty knee" ;
    :yValue "223" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Percutaneous coronary angioplasty (PTCA)" ;
    :yValue "170.3" ;
    :belongsTo :Chart .

