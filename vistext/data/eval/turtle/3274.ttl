    :yValue "143.6" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Cholecystectomy and common duct exploration" ;
    :yValue "129.4" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
