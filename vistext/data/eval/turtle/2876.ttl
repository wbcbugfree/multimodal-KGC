@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Unemployment level of Asian Americans in the United States from 2000 to 2019 (in 1,000)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Unemployed in thousands" .

:YAxis a :Axis ;
    :title "Year" .

