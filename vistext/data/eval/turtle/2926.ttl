@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Annual consumption volume of plums in Austria from 2008/09 to 2018/19 (in tonnes)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Consumption volume in tonnes" .

:YAxis a :Axis ;
    :title "Year" .

