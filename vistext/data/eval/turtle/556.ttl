@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Worldwide exports of railway track material from 2007 to 2019 (in million metric tons of crude steel production)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Exports in million metric tons" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2006" ;
    :yValue "3.1" ;
    :belongsTo :Chart .

