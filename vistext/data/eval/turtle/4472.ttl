@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Number of Costco warehouses in 2019 , by country" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Number of warehouses*" .

:YAxis a :Axis ;
    :title "Country" .

:DataPoint1 a :DataPoint ;
    :xValue "543" ;
    :yValue "United States and Puerto Rico" ;
    :belongsTo :Chart .

