@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Italy : Government revenue and spending from 2014 to 2024 (in billion euros)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Revenue" .

:YAxis a :Axis ;
    :title "Year" .

:DataPoint1 a :DataPoint ;
    :xValue "905.86" ;
    :yValue "2024*" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "885.97" ;
    :yValue "2023*" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "869.11" ;
    :yValue "2022*" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "852.72" ;
    :yValue "2021*" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "837.85" ;
    :yValue "2020*" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "827.95" ;
    :yValue "2019*" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "816.11" ;
    :yValue "2018" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "803.61" ;
    :yValue "2017" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "786.02" ;
    :yValue "2016" ;
