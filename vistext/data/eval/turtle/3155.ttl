@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "FIFA World Ranking of the Dutch women 's national football team from 2003 to 2019" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "FIFA World Ranking position*" .

