@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Social isolation index during the coronavirus (COVID-19) pandemic in Brazil in April and October 2020 , by state" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Oct '20" .

:YAxis a :Axis ;
    :title "state of Brazil" .

