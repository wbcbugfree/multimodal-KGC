@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Aquaculture production volume in India from 2001 to 2015 (in 1,000 metric tons)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Production in thousand metric tons" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2000" ;
    :yValue "2120" ;
    :belongsTo :Chart .

