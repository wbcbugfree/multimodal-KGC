@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Number of participants in jet skiing in the United States from 2006 to 2017 (in millions)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Number of participants in millions" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2005" ;
    :yValue "6.92" ;
    :belongsTo :Chart .

