@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Reasons that keep people from leisure travel in the United States from 2011 to 2018" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "Personal finances" .

:DataPoint1 a :DataPoint ;
    :xValue "Jun 30, 2011" ;
    :yValue "0.49" ;
    :belongsTo :Chart .

