@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Yamaha Corporation 's net income worldwide from 2006 to 2019 (in million U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Net income in million U.S. dollars" .

:DataPoint1 a :DataPoint ;
    :xValue "2019*" ;
    :yValue "394.65" ;
    :belongsTo :Chart .

