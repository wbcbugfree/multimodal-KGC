@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Number of heart transplantations in the U.S. from 1975 to 2018" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Number of transplants" .

:DataPoint1 a :DataPoint ;
    :xValue "2018" ;
    :yValue "3408" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "2017*" ;
    :yValue "3244" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "2016*" ;
    :yValue "3191" ;
    :belongsTo :Chart .

