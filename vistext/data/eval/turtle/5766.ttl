    :xValue "2005" ;
    :yValue "2125" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "2000" ;
    :yValue "2199" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "1995" ;
    :yValue "2363" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "1990" ;
    :yValue "2107" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "1985" ;
