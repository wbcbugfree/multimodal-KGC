@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Total number of fishers and fish farmers worldwide from 1995 to 2018 (in 1,000s)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Number in thousands" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 1994" ;
    :yValue "36223" ;
    :belongsTo :Chart .

