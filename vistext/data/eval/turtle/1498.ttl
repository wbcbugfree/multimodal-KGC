    :xValue "0.51" ;
    :yValue "Chad" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "0.52" ;
    :yValue "DR Congo" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "0.52" ;
    :yValue "Madagascar" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
