@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Countries with the lowest percentage of population using improved drinking-water sources worldwide in 2015" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Percentage of population" .

:YAxis a :Axis ;
    :title "Response" .

:DataPoint1 a :DataPoint ;
    :xValue "0.4" ;
    :yValue "Papua New Guinea" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "0.49" ;
    :yValue "Angola" ;
    :belongsTo :Chart .

