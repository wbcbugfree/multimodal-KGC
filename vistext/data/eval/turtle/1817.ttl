@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Foreign direct investment inflows worldwide in 2012 , for geographic regions and BRIC (in billion U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Value in billion U.S. dollars" .

:YAxis a :Axis ;
    :title "Country" .

:DataPoint1 a :DataPoint ;
    :xValue "293.5" ;
    :yValue "Europe" ;
    :belongsTo :Chart .

