    :xValue "106.5" ;
    :yValue "Southwest Asia" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "65.3" ;
    :yValue "Brazil" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "48.5" ;
    :yValue "Australia" ;
    :belongsTo :Chart .

