@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Peat production in Canada in 2019 , by province (in 1,000 metric tons)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "province of Canada" .

:YAxis a :Axis ;
    :title "Production in 1,000 metric tons" .

:DataPoint1 a :DataPoint ;
    :xValue "Nova Scotia" ;
    :yValue "1" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "New Brunswick" ;
    :yValue "377" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "Quebec" ;
    :yValue "383" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "Ontario" ;
    :yValue "0" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "Manitoba" ;
    :yValue "222" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Saskatchewan" ;
    :yValue "32" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Alberta" ;
    :yValue "221" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "British Columbia" ;
    :yValue "0" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "Yukon" ;
    :yValue "0" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "Northwest Territories" ;
    :yValue "0" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "Nunavut" ;
    :yValue "0" ;
    :belongsTo :Chart .
