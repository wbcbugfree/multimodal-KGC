@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Recycling rate of household waste in England from 2000/01 to 2018/19" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Waste recycling rate" .

:YAxis a :Axis ;
    :title "Year" .

:DataPoint1 a :DataPoint ;
    :xValue "0.435" ;
    :yValue "2018/19" ;
    :belongsTo :Chart .

