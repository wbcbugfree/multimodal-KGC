@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Number of employees of Penguin Random House from 2005 to 2019" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Number of employees" .

