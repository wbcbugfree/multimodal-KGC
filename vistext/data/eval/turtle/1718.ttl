@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Leading social networks ranked by usage in the United Kingdom (UK) in January 2018" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "Share of respondents" .

:DataPoint1 a :DataPoint ;
    :xValue "Facebook" ;
    :yValue "0.79" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "WhatsApp" ;
    :yValue "0.58" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "YouTube" ;
    :yValue "0.79" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "Twitter" ;
    :yValue "0.47" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "Google+" ;
    :yValue "0.39" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Instagram" ;
    :yValue "0.41" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Snapchat" ;
    :yValue "0.3" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Pinterest" ;
    :yValue "0.36" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "LinkedIn" ;
    :yValue "0.33" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "Giphy" ;
    :yValue "0.11" ;
    :belongsTo :Chart .
