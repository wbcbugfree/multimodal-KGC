@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Installed wind power capacity in Spain in 2019 , by autonomous community (in megawatts)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "autonomous community of Spain" .

:YAxis a :Axis ;
    :title "Installed power in MW" .

:DataPoint1 a :DataPoint ;
    :xValue "Castile and Leon" ;
    :yValue "6051" ;
    :belongsTo :Chart .

