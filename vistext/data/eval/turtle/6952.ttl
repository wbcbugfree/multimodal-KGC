@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Where do you primarily derive most of your personal values from ? (by selected country)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Religion / faith" .

:YAxis a :Axis ;
    :title "Response" .

:DataPoint1 a :DataPoint ;
    :xValue "0.0624" ;
    :yValue "France" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "0.1122" ;
    :yValue "Germany" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "0.1176" ;
    :yValue "India" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "0.2489" ;
    :yValue "Indonesia" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "0.1206" ;
    :yValue "Israel" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "0.0478" ;
    :yValue "Mexico" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "0.3897" ;
    :yValue "Saudi Arabia" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "0.3695" ;
    :yValue "South Africa" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "0.0948" ;
    :yValue "Turkey" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "0.3032" ;
    :yValue "United States" ;
    :belongsTo :Chart .
