@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Gender distribution of journalists in print news media in the United States as of November 2017 , by news topic" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "news topic" .

:YAxis a :Axis ;
    :title "Female" .

:DataPoint1 a :DataPoint ;
    :xValue "Sports" ;
    :yValue "0.1" ;
    :belongsTo :Chart .

