@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Leading financial advisors to M & A transactions in Greater London (United Kingdom) in 2019 , by aggregate value of deals (in million GBP)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Financial Advisory Company" .

:YAxis a :Axis ;
    :title "Value of deals in million GBP" .

:DataPoint1 a :DataPoint ;
    :xValue "Goldman Sachs" ;
    :yValue "63919" ;
    :belongsTo :Chart .

