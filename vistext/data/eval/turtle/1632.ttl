@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Percentage of seniors aged 65 years and older in developed countries that had experienced depression as of 2017 , by country" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Percentage of older people" .

:YAxis a :Axis ;
    :title "Response" .

:DataPoint1 a :DataPoint ;
    :xValue "0.06" ;
    :yValue "Netherlands" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "0.09" ;
    :yValue "Norway" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "0.1" ;
    :yValue "Germany" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "0.1" ;
    :yValue "New Zealand" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "0.11" ;
    :yValue "Switzerland" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "0.12" ;
    :yValue "Sweden" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "0.12" ;
    :yValue "France" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "0.14" ;
    :yValue "Canada" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "0.14" ;
    :yValue "Australia" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "0.16" ;
    :yValue "United Kingdom" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "0.2" ;
    :yValue "United States" ;
    :belongsTo :Chart .
