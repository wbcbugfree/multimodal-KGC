@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Teams of the Premier League ranked by most expensive season ticket in 2019/20 (in GBP)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "association football club" .

:YAxis a :Axis ;
    :title "Ticket price in GBP" .

