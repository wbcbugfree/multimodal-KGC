@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Operating expenditure per capita of public libraries in the United States from 2002 to 2013 , by category (in U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Staff expenditure" .

