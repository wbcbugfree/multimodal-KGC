@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "What news apps do you use ?" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "Share of respondents" .

:DataPoint1 a :DataPoint ;
    :xValue "CNN" ;
    :yValue "0.44" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Fox News" ;
    :yValue "0.334" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "Yahoo!" ;
    :yValue "0.323" ;
    :belongsTo :Chart .

