@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Value of silver imported into India from financial year 2011 to 2020 (in billion Indian rupees)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Fiscal Year" .

:YAxis a :Axis ;
    :title "Import value in billion Indian rupees" .

:DataPoint1 a :DataPoint ;
    :xValue "FY 2020" ;
    :yValue "191.62" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "FY 2019" ;
    :yValue "261.89" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "FY 2018" ;
    :yValue "207.25" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "FY 2017" ;
    :yValue "123.3" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "FY 2016" ;
    :yValue "244.4" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "FY 2015" ;
    :yValue "276.86" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "FY2014" ;
    :yValue "269.74" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "FY2013" ;
    :yValue "107.97" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "FY 2012" ;
    :yValue "247.04" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "FY 2011" ;
    :yValue "89.53" ;
    :belongsTo :Chart .
