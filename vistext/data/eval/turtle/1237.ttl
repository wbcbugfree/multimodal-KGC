@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Global box office revenue of DC comics movies from 2004 to 2019 (in million U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Amount in million U.S. dollars" .

:YAxis a :Axis ;
    :title "DC comics movie" .

:DataPoint1 a :DataPoint ;
    :xValue "1147.7" ;
    :yValue "Aquaman" ;
    :belongsTo :Chart .

