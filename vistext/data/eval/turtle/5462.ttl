@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Projected annual inflation rate in the United States from 2010 to 2021" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Inflation rate" .

:DataPoint1 a :DataPoint ;
    :xValue "2021*" ;
    :yValue "0.0224" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "2020*" ;
    :yValue "0.0062" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "2019" ;
    :yValue "0.0181" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "2018" ;
    :yValue "0.0244" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "2017" ;
    :yValue "0.0214" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "2016" ;
    :yValue "0.0126" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "2015" ;
    :yValue "0.0012" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "2014" ;
    :yValue "0.0162" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "2013" ;
    :yValue "0.0147" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "2012" ;
    :yValue "0.0207" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "2011" ;
    :yValue "0.0314" ;
    :belongsTo :Chart .

:DataPoint12 a :DataPoint ;
    :xValue "2010" ;
    :yValue "0.0164" ;
    :belongsTo :Chart .
