@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Leading solar power consuming companies in the United States as of 2018 , by installed capacity (in megawatts)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Capacity in megawatts" .

:YAxis a :Axis ;
    :title "Leading solar power consuming companies" .

:DataPoint1 a :DataPoint ;
    :xValue "393.3" ;
    :yValue "Apple" ;
    :belongsTo :Chart .

