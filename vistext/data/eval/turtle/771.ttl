@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Leading mutual life and health insurance companies in the United States in 2019 , by revenue (in billion U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Revenue in billion U.S. dollars" .

:YAxis a :Axis ;
    :title "mutual life and health insurance companies" .

:DataPoint1 a :DataPoint ;
    :xValue "44.12" ;
    :yValue "New York Life Insurance" ;
