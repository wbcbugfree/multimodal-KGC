    :xValue "22.95" ;
    :yValue "2011/12" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "23.18" ;
    :yValue "2010/11" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "24.1" ;
    :yValue "2009/10" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "24.11" ;
