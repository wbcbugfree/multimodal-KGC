@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Average ticket price Memphis Grizzlies games of the NBA from 2006/07 to 2015/16 (in U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Average ticket price in U.S. dollars" .

:YAxis a :Axis ;
    :title "Year" .

:DataPoint1 a :DataPoint ;
    :xValue "31.48" ;
    :yValue "2015/16" ;
    :belongsTo :Chart .

