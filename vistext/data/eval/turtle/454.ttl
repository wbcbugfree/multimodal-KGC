@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Musicians with the most Facebook fans as of June 2020 (in millions)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Musician" .

:YAxis a :Axis ;
    :title "Number of Facebook fans in millions" .

:DataPoint1 a :DataPoint ;
    :xValue "Shakira" ;
    :yValue "100.03" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Eminem" ;
    :yValue "86.52" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "Rihanna" ;
    :yValue "79.01" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "Justin Bieber" ;
    :yValue "76.3" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "Michael Jackson" ;
    :yValue "71.36" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Taylor Swift" ;
    :yValue "71.11" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Bob Marley" ;
    :yValue "69.77" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Katy Perry" ;
    :yValue "66.02" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "Adele" ;
    :yValue "62.3" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "Beyoncé" ;
    :yValue "61.02" ;
    :belongsTo :Chart .
