@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Commercial vehicle sales in selected European countries in 2019 (in units)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Country" .

:YAxis a :Axis ;
    :title "Buses and coaches" .

