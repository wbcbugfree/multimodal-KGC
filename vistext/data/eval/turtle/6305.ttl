@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Projected population in Russia from 2020 to 2036 , by scenario (in 1,000s)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Low expectation" .

