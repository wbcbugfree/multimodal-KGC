@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Most popular beach vacation activities worldwide as of July 2014" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Share of respondents" .

:YAxis a :Axis ;
    :title "Response" .

:DataPoint1 a :DataPoint ;
    :xValue "0.7" ;
    :yValue "Walking" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "0.65" ;
    :yValue "Swimming" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "0.53" ;
    :yValue "Sunbathing" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "0.53" ;
    :yValue "Reading" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "0.48" ;
    :yValue "Napping" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "0.47" ;
    :yValue "People-watching" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "0.45" ;
    :yValue "Listening to music" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "0.39" ;
    :yValue "Drinking alcohol" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "0.3" ;
    :yValue "Getting a massage/spa treatment" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "0.25" ;
    :yValue "Partying" ;
    :belongsTo :Chart .
