@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Percentage of older people who needed help with personal care from other persons in the U.S. from 1997 to 2018" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "Percentage of older people" .

