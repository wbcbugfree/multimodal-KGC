@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Length of the average working week of all employees in the United States in November 2020 , by industry" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Hours of work" .

:YAxis a :Axis ;
    :title "industry" .

:DataPoint1 a :DataPoint ;
    :xValue "44.5" ;
    :yValue "Mining and logging" ;
    :belongsTo :Chart .

