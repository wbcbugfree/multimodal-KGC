@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Cumulative mortality rate of COVID-19 in the United States from June 9 to December 8 , 2020 , by race and ethnicity (per 100,000 population)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Pacific Islander" .

:YAxis a :Axis ;
    :title "Month" .

:DataPoint1 a :DataPoint ;
    :xValue "90.4" ;
    :yValue "Dec 8" ;
    :belongsTo :Chart .

