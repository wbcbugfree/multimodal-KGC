    :xValue "40.1" ;
    :yValue "2013/14" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "40.1" ;
    :yValue "2012/13" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "41.26" ;
    :yValue "2011/12" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "42.76" ;
    :yValue "2010/11" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "47.5" ;
    :yValue "2009/10" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "47.5" ;
    :yValue "2008/09" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
