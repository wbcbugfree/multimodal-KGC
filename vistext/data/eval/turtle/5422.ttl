@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Average ticket price Detroit Pistons games of the NBA from 2006/07 to 2015/16 (in U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Average ticket price in U.S. dollars" .

:YAxis a :Axis ;
    :title "Year" .

:DataPoint1 a :DataPoint ;
    :xValue "31.42" ;
    :yValue "2015/16" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "38.8" ;
    :yValue "2014/15" ;
    :belongsTo :Chart .

