@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Smartphone penetration rate as share of the population in the United States from 2010 to 2021" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "Share of population with a smartphone" .

:DataPoint1 a :DataPoint ;
    :xValue "2021**" ;
    :yValue "0.727" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "2020**" ;
    :yValue "0.722" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "2019**" ;
    :yValue "0.714" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "2018**" ;
    :yValue "0.696" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "2017" ;
    :yValue "0.673" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "2016" ;
    :yValue "0.639" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "2015" ;
    :yValue "0.594" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "2014" ;
    :yValue "0.536" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "2013" ;
    :yValue "0.457" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "2012" ;
    :yValue "0.388" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "2011" ;
    :yValue "0.298" ;
    :belongsTo :Chart .

:DataPoint12 a :DataPoint ;
    :xValue "2010" ;
    :yValue "0.202" ;
    :belongsTo :Chart .
