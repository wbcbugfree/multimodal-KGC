@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Gross monthly salary of Congress members in Latin America in 2018 , by country (in U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Monthly salary in U.S. dollars" .

:YAxis a :Axis ;
    :title "Country" .

