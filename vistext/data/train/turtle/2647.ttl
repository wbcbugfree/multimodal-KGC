    :xValue "Department of the Interior" ;
    :yValue "0.81" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Department of the Treasury" ;
    :yValue "0.8" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Department of Energy" ;
    :yValue "0.69" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Department of Health and Human Services" ;
