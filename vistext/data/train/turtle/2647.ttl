@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Percentage of government employees furloughed after U.S. government shutdown as of October 1 , 2013 , by agency and department" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Government departments and agencies" .

:YAxis a :Axis ;
    :title "Percentage of employees" .

:DataPoint1 a :DataPoint ;
    :xValue "NASA" ;
    :yValue "0.97" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Environmental Protection Agency" ;
    :yValue "0.94" ;
    :belongsTo :Chart .

