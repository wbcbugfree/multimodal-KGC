@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Breakdown of the number of arrests for public and obvious intoxication in France from 2001 to 2017" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Number of arrests" .

