@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Median hourly earnings for full-time employees in the United Kingdom from 2004 to 2020 , by age group (in GBP)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "22 to 29" .

