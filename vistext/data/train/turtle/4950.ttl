@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Leading female tennis players in Italy as of October 2020 , by WTA score" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "WTA score" .

:YAxis a :Axis ;
    :title "tennis player" .

:DataPoint1 a :DataPoint ;
    :xValue "940" ;
    :yValue "Camila Giorgi" ;
    :belongsTo :Chart .

