@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Nitrogen oxide emissions from energy consumption at conventional power and combined heat and power (CHP) plants in the U.S. from 2004 to 2019 (in 1,000 metric tons)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Nitrogen oxide emissions in thousand metric tons" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2003" ;
    :yValue "4143" ;
    :belongsTo :Chart .

