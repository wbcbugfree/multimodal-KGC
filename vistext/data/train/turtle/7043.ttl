@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Share of revenue of the German Bundesliga from 2008/09 to 2018/19 , by segment" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Match revenue" .

:YAxis a :Axis ;
    :title "Year" .

:DataPoint1 a :DataPoint ;
    :xValue "0.1294" ;
    :yValue "2018/19" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "0.1412" ;
    :yValue "2017/18" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "0.1493" ;
    :yValue "2016/17" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "0.1626" ;
    :yValue "2015/16" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "0.1985" ;
    :yValue "2014/15" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "0.1972" ;
    :yValue "2013/14" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "0.216" ;
    :yValue "2012/13" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "0.2118" ;
    :yValue "2011/12" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "0.2117" ;
    :yValue "2010/11" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "0.2143" ;
    :yValue "2009/10" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "0.2119" ;
    :yValue "2008/09" ;
    :belongsTo :Chart .
