@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Number of beds in infectious diseases wards and in isolation hospitals during the coronavirus (COVID-19) outbreak in Poland in 2018 and March 2020 , by region" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "2020" .

:YAxis a :Axis ;
    :title "region of Poland" .

:DataPoint1 a :DataPoint ;
    :xValue "137" ;
    :yValue "Dolnośląskie" ;
    :belongsTo :Chart .

