@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Mortality rate of children under 5 in Africa , from 1970 to 2010 (per 1,000 live births)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Number of deaths per 1,000 live births" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 1969" ;
    :yValue "229" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Dec 31, 1974" ;
    :yValue "204" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "Dec 31, 1979" ;
    :yValue "185" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "Dec 31, 1984" ;
    :yValue "169" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "Dec 31, 1989" ;
    :yValue "160" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Dec 31, 1994" ;
    :yValue "155" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Dec 31, 1999" ;
    :yValue "142" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Dec 31, 2004" ;
    :yValue "127" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "Dec 31, 2008" ;
    :yValue "114" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "Dec 31, 2009" ;
    :yValue "111" ;
    :belongsTo :Chart .
