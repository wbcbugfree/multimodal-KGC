@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Total number of betting shops in the gambling industry in Great Britain from March 31 , 2011 to September 30 , 2019 (in 1,000s)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Time" .

:YAxis a :Axis ;
    :title "Number of shops in thousands" .

:DataPoint1 a :DataPoint ;
    :xValue "Mar 30, 2011" ;
    :yValue "9.07" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Mar 30, 2012" ;
    :yValue "9.13" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "Mar 30, 2013" ;
    :yValue "9.1" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "Mar 30, 2014" ;
    :yValue "9.11" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "Mar 30, 2015" ;
    :yValue "8.99" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Mar 30, 2016" ;
    :yValue "8.91" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Mar 30, 2017" ;
    :yValue "8.8" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Mar 30, 2018" ;
    :yValue "8.56" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "Mar 30, 2019" ;
    :yValue "8.32" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "Sep 29, 2019" ;
    :yValue "7.32" ;
    :belongsTo :Chart .
