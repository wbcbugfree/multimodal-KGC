@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Internet usage frequency in Great Britain from 2006 to 2020" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Did not use the internet in the last three months" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2005" ;
    :yValue "0.4" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Dec 31, 2006" ;
    :yValue "0.33" ;
    :belongsTo :Chart .

