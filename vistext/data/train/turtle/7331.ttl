@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Largest wind turbines worldwide as of September 2018" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Power rating (in megawatts)" .

:YAxis a :Axis ;
    :title "Largest wind turbines" .

:DataPoint1 a :DataPoint ;
    :xValue "9.5" ;
    :yValue "MHI Vestas V164 8MW" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "8" ;
    :yValue "Siemens-Gamesa SG 8.0-167 DD" ;
    :belongsTo :Chart .

