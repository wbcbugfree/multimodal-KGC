@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Total number of deaths by homicides in Spain 2018 , by autonomous community" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Number of deaths" .

:YAxis a :Axis ;
    :title "autonomous community of Spain" .

