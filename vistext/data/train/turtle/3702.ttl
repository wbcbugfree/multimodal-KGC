@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Number of provider contracts of top healthcare management consulting firms in the United States in 2013" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Number of provider contracts" .

:YAxis a :Axis ;
    :title "top healthcare management consulting firms" .

:DataPoint1 a :DataPoint ;
    :xValue "3200" ;
    :yValue "Advisory Board Co. (Washington)" ;
    :belongsTo :Chart .

