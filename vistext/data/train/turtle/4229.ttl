@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Brazil : Degree of urbanization from 2009 to 2019" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "Share of urban inhabitants in total population" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2008" ;
    :yValue "0.8404" ;
    :belongsTo :Chart .

