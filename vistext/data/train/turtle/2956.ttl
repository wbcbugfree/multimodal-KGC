@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Sales volume of apples in Germany from 2006 to 2016 (in 1,000 tonnes)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Sales volume in thousand tonnes" .

:YAxis a :Axis ;
    :title "Year" .

:DataPoint1 a :DataPoint ;
    :xValue "1632.8" ;
    :yValue "2016*" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "1591.1" ;
    :yValue "2015*" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "1544.8" ;
    :yValue "2014*" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "1502.7" ;
    :yValue "2013*" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "1463.2" ;
    :yValue "2012*" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "1426.1" ;
    :yValue "2011" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "1398.1" ;
    :yValue "2010" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "1338.3" ;
    :yValue "2009" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "1397.7" ;
    :yValue "2008" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
