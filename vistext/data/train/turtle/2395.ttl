@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Total U.S. medical costs for type 2 diabetes from 2007 to 2020 (in billion U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Medical costs in billion U.S. dollars" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2006" ;
    :yValue "110" ;
    :belongsTo :Chart .

