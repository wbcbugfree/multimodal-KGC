@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Barrick Gold 's average realized gold price per ounce from 2008 to 2019 (in U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Price in U.S. dollars per ounce" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2007" ;
    :yValue "872" ;
    :belongsTo :Chart .

