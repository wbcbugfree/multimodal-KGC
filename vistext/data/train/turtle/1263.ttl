@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Minnesota Twins all-time games played leaders as of October 2020" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Number of games played" .

:YAxis a :Axis ;
    :title "Player" .

:DataPoint1 a :DataPoint ;
    :xValue "2329" ;
    :yValue "Harmon Killebrew" ;
    :belongsTo :Chart .

