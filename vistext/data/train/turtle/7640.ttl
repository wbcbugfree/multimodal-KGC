@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Total population in Denmark from 2010 to 2020 , by age group (in millions)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "20-39 years" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2009" ;
    :yValue "1.38" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Dec 31, 2010" ;
    :yValue "1.38" ;
    :belongsTo :Chart .

