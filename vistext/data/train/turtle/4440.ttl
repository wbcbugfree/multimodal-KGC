@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Latin American passports with the most visa free access to other countries as of July 2020 (visa free score)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Visa free score*" .

:YAxis a :Axis ;
    :title "Country" .

:DataPoint1 a :DataPoint ;
    :xValue "174" ;
    :yValue "Chile" ;
    :belongsTo :Chart .

