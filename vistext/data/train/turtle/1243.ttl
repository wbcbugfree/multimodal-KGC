@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Value of major cross-border capital investments into European real estate market in the 12 months prior to 1st quarter of 2016 (in billion euros)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Investment in billion euros" .

:YAxis a :Axis ;
    :title "Cross-border capital investments" .

:DataPoint1 a :DataPoint ;
    :xValue "14.5" ;
    :yValue "USA to UK" ;
    :belongsTo :Chart .

