@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Value of India 's medicine and pharmaceutical product imports from financial year 2011 to 2020 (in billion Indian rupees)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Import value in billion Indian rupees" .

:YAxis a :Axis ;
    :title "year" .

:DataPoint1 a :DataPoint ;
    :xValue "234.77" ;
    :yValue "FY 2020*" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "444.29" ;
    :yValue "FY 2019" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "353.3" ;
    :yValue "FY 2018" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "335.2" ;
    :yValue "FY 2017" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "355.7" ;
    :yValue "FY 2016" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "332.11" ;
    :yValue "FY 2015" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "316.61" ;
    :yValue "FY2014" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "297.36" ;
    :yValue "FY 2013" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "248.43" ;
    :yValue "FY 2012" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "191.49" ;
    :yValue "FY 2011" ;
    :belongsTo :Chart .
