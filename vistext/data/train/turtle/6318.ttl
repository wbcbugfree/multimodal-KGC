@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Percentage of primary and secondary pupils with English as an additional language in England from 1997 to 2018" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Secondary" .

