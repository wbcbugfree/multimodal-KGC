@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Number of branches of Deutsche Bank worldwide from 2010 to 2019" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Number of branches" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2009" ;
    :yValue "3083" ;
    :belongsTo :Chart .

