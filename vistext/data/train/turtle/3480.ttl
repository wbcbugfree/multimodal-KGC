@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Percentage of U.S. college students that had received information from their college or university about select health topics as of fall 2018" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "Percentage of respondents" .

:DataPoint1 a :DataPoint ;
    :xValue "Sexual assault/relationship violence" ;
    :yValue "0.856" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Alcohol and other drug use" ;
    :yValue "0.797" ;
    :belongsTo :Chart .

