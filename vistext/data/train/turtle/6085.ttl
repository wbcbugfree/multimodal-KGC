@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Imports and exports of coal mined in the United Kingdom (UK) from 1970 to 2019 (in 1,000 metric tons)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Imports" .

:YAxis a :Axis ;
    :title "Year" .

