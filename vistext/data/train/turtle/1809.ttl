@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Cuba : Total population from 2009 to 2019 (in million inhabitants)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Inhabitants in millions" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2008" ;
    :yValue "11.23" ;
    :belongsTo :Chart .

