@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Number of Vodafone mobile customers in Europe in 2020 , by country (in millions)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Mobile customers in millions" .

:YAxis a :Axis ;
    :title "Country" .

:DataPoint1 a :DataPoint ;
    :xValue "30.1" ;
    :yValue "Germany" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "19.2" ;
    :yValue "Italy" ;
    :belongsTo :Chart .

