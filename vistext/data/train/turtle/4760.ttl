    :xValue "29.5" ;
    :yValue "Other Europe" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "8.9" ;
    :yValue "Romania" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "5.3" ;
    :yValue "Greece" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "4.6" ;
    :yValue "Portugal" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "3.8" ;
    :yValue "Czechia" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "2.8" ;
