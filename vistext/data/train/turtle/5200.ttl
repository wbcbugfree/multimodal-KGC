@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Number of monthly active WhatsApp users worldwide from April 2013 to March 2020 (in millions)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Month" .

:YAxis a :Axis ;
    :title "Number of monthly active users in millions" .

:DataPoint1 a :DataPoint ;
    :xValue "Mar '20" ;
    :yValue "2000" ;
    :belongsTo :Chart .

