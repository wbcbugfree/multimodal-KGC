@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Average annualized cost of cyber attacks on companies in selected countries in 2018 (in million U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Country" .

:YAxis a :Axis ;
    :title "Average cyber crime cost in million US dollars" .

:DataPoint1 a :DataPoint ;
    :xValue "United States" ;
    :yValue "27.37" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Japan" ;
    :yValue "13.57" ;
    :belongsTo :Chart .

