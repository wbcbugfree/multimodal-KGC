    :xValue "Singapore" ;
    :yValue "9.32" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Canada" ;
    :yValue "9.25" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Spain" ;
    :yValue "8.16" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
