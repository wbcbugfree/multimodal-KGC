@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Leading barriers for cross-border shopping in India in 2013" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "Share of respondents" .

:DataPoint1 a :DataPoint ;
    :xValue "High delivery costs" ;
    :yValue "0.582" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Language problems" ;
    :yValue "0.217" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "Customs clearance" ;
    :yValue "0.429" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "Non-transparent costs" ;
    :yValue "0.412" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "Uncertainty with problems" ;
    :yValue "0.297" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "No demand because all products are obtainable locally" ;
    :yValue "0.175" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Long delivery times" ;
    :yValue "0.561" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Unknown product quality" ;
    :yValue "0.33" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "Complicated return process" ;
    :yValue "0.449" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "Concerns regarding data protection" ;
    :yValue "0.227" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "Fear of fraud" ;
    :yValue "0.435" ;
    :belongsTo :Chart .

:DataPoint12 a :DataPoint ;
    :xValue "Uncertain delivery" ;
    :yValue "0.331" ;
    :belongsTo :Chart .

:DataPoint13 a :DataPoint ;
    :xValue "Concern about misuse of payment data" ;
    :yValue "0.326" ;
    :belongsTo :Chart .

:DataPoint14 a :DataPoint ;
    :xValue "Uncertainty regarding warranty terms, payment process, legal situation, etc." ;
    :yValue "0.433" ;
    :belongsTo :Chart .
