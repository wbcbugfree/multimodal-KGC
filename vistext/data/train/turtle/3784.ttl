@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Utilities industry energy inputs in the U.S. from 1997 to 2018 (in billion U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Energy inputs in billion U.S. dollars" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 1996" ;
    :yValue "60.4" ;
    :belongsTo :Chart .

