@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Amount of freight transported by rail in Russia from 2006 to 2019 (in million ton-kilometers)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Transport volume in million ton-kilometers" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2005" ;
    :yValue "1950830" ;
    :belongsTo :Chart .

