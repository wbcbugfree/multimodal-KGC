    :xValue "Dec 31, 2011" ;
    :yValue "58.35" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Dec 31, 2012" ;
    :yValue "62.36" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
