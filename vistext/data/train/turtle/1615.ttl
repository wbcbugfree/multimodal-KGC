@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Puerto Rico : Export of goods and services from 2008 to 2018 (in current billion U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Exports in billion U.S. dollars" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2007" ;
    :yValue "63.95" ;
    :belongsTo :Chart .

