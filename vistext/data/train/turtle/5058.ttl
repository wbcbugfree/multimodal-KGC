@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Average ticket price Sacramento Kings games of the NBA from 2006/07 to 2015/16 (in U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Average ticket price in U.S. dollars" .

:DataPoint1 a :DataPoint ;
    :xValue "2015/16" ;
    :yValue "47.89" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "2014/15" ;
    :yValue "46.32" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "2013/14" ;
    :yValue "43.32" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "2012/13" ;
    :yValue "43.32" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "2011/12" ;
    :yValue "48.17" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "2010/11" ;
    :yValue "51.8" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "2009/10" ;
    :yValue "57.5" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "2008/09" ;
    :yValue "59.8" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "2007/08" ;
    :yValue "59.8" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "2006/07" ;
    :yValue "59.8" ;
    :belongsTo :Chart .
