@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Median hourly earnings for full-time employees in the United Kingdom from 2004 to 2020 , by age group (in GBP)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "40 to 49" .

