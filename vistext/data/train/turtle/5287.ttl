@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Toronto Raptors all-time assists leaders from 1995 to 2020" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Assists" .

:YAxis a :Axis ;
    :title "player name" .

:DataPoint1 a :DataPoint ;
    :xValue "3939" ;
    :yValue "Kyle Lowry" ;
    :belongsTo :Chart .

