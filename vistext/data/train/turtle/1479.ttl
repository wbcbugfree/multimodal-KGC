@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "What do you think are the two most important issues facing the United Kingdom at the moment ?" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "Share of respondents" .

:DataPoint1 a :DataPoint ;
    :xValue "Health and social security" ;
    :yValue "0.34" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Immigration" ;
    :yValue "0.19" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "Rising prices/inflation" ;
    :yValue "0.18" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "Housing" ;
    :yValue "0.16" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "Economic situation" ;
    :yValue "0.12" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Terrorism" ;
    :yValue "0.33" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Unemployment" ;
    :yValue "0.1" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "The education system" ;
    :yValue "0.13" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "Crime" ;
    :yValue "0.1" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "Government debt" ;
    :yValue "0.07" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "The environment, climate and energy issues" ;
    :yValue "0.05" ;
    :belongsTo :Chart .

:DataPoint12 a :DataPoint ;
    :xValue "Pensions" ;
    :yValue "0.07" ;
    :belongsTo :Chart .

:DataPoint13 a :DataPoint ;
    :xValue "Taxation" ;
    :yValue "0.04" ;
    :belongsTo :Chart .
