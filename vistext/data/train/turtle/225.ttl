@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Number of Toyota and Lexus hybrid cars sold in the United Kingdom (UK) in 2018" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Units sold" .

:YAxis a :Axis ;
    :title "Toyota and Lexus  hybrid car" .

:DataPoint1 a :DataPoint ;
    :xValue "17001" ;
    :yValue "Yaris Hybrid" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "11972" ;
    :yValue "Auris Hybrid (incl. TS)" ;
    :belongsTo :Chart .

