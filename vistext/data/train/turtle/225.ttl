    :xValue "6918" ;
    :yValue "RAV4 Hybrid" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "4835" ;
    :yValue "Lexus NX" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "4187" ;
    :yValue "Prius" ;
    :belongsTo :Chart .

