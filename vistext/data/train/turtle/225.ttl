    :yValue "Lexus RX" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "1572" ;
    :yValue "Lexus IS" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
