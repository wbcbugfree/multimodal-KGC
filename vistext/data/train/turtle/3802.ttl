@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Number of fixed telephone lines in France from 2006 to the first quarter of 2017 (in millions)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Number of lines in millions" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2005" ;
    :yValue "34.13" ;
    :belongsTo :Chart .

