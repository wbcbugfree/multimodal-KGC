@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Total number of charter schools in the United States from 2000/01 to 2017/18" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Number of charter schools" .

:DataPoint1 a :DataPoint ;
    :xValue "2017/18" ;
    :yValue "7193" ;
    :belongsTo :Chart .

