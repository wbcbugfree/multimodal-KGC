@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Total number of passengers entering and exiting from Liverpool Street Station (London) between 2004/05 and 2016/17" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Number of passenger entries and exits" .

:YAxis a :Axis ;
    :title "Year" .

:DataPoint1 a :DataPoint ;
    :xValue "67339218" ;
    :yValue "2016/17" ;
    :belongsTo :Chart .

