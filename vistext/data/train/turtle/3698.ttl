@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Worst airports according to eDreams reviews worldwide in 2015" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Score*" .

:YAxis a :Axis ;
    :title "Worst airports" .

:DataPoint1 a :DataPoint ;
    :xValue "3.19" ;
    :yValue "Mohammed V International Airport (CMN), Morocco" ;
    :belongsTo :Chart .

