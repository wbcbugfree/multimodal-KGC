@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Sales volume of chocolate bars manufactured in the United Kingdom (UK) from 2008 to 2019 (in 1,000 kilograms)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Sales volume in thousand kilograms" .

:YAxis a :Axis ;
    :title "Year" .

:DataPoint1 a :DataPoint ;
    :xValue "35121" ;
    :yValue "2019" ;
    :belongsTo :Chart .

