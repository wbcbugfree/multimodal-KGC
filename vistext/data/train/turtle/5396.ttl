@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Tampa Bay Rays all-time home run leaders as of October 2020" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "player name" .

:YAxis a :Axis ;
    :title "Number of home runs" .

:DataPoint1 a :DataPoint ;
    :xValue "Evan Longoria" ;
    :yValue "261" ;
    :belongsTo :Chart .

