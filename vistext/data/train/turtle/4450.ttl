@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Largest emerging markets worldwide in 2019 , by insurance density (in U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Country" .

:YAxis a :Axis ;
    :title "Premiums per capita in U.S. dollars" .

:DataPoint1 a :DataPoint ;
    :xValue "Bahamas" ;
    :yValue "1963" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Slovenia" ;
    :yValue "1336" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "United Arab Emirates" ;
    :yValue "1305" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "Trinidad and Tobago" ;
    :yValue "853" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "South Africa" ;
    :yValue "840" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Chile" ;
    :yValue "747" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Czech Republic" ;
    :yValue "666" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Bahrain" ;
    :yValue "520" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "Malaysia" ;
    :yValue "518" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "Slovakia" ;
    :yValue "478" ;
    :belongsTo :Chart .
