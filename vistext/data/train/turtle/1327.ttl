@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Smartphone penetration rate in top 20 countries worldwide , as of September 2018" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Country" .

:YAxis a :Axis ;
    :title "Penetration rate" .

