@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Annual volume of concentrated milk produced in the Netherlands from 2008 to 2019 (in 1,000 kilograms)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Volume in thousand kilograms" .

:YAxis a :Axis ;
    :title "Year" .

:DataPoint1 a :DataPoint ;
    :xValue "381982" ;
    :yValue "2019*" ;
    :belongsTo :Chart .

