@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Online dating-related websites ranked by natural search voice share in the United Kingdom (UK) in February 2016" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Share of natural search voice**" .

:YAxis a :Axis ;
    :title "Response" .

:DataPoint1 a :DataPoint ;
