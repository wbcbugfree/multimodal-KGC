@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Symbol groups ranked by number of convenience stores in the United Kingdom (UK) in 2014" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "symbol group" .

:YAxis a :Axis ;
    :title "Number of stores" .

:DataPoint1 a :DataPoint ;
    :xValue "Premier" ;
    :yValue "2950" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Best-one" ;
    :yValue "2904" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "Costcutter" ;
    :yValue "2547" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "Spar" ;
    :yValue "2312" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "Londis" ;
    :yValue "2018" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Lifestyle express" ;
    :yValue "1976" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "The Co-operative" ;
    :yValue "1785" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Tesco Express" ;
    :yValue "1463" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "Nisa" ;
    :yValue "1002" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "McColl's" ;
    :yValue "719" ;
    :belongsTo :Chart .
