@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Number of acetaminophen prescriptions in the U.S. from 2004 to 2017 (in millions)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Total prescriptions in millions" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2003" ;
    :yValue "6.28" ;
    :belongsTo :Chart .

