@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Holders of the U.S. government debt as of December 2019" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Share of debt holders" .

:YAxis a :Axis ;
    :title "Response" .

:DataPoint1 a :DataPoint ;
    :xValue "0.3603" ;
    :yValue "Federal Reserve and Government accounts" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "0.2886" ;
    :yValue "Foreign and international" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "0.1163" ;
    :yValue "Other investors" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "0.1011" ;
    :yValue "Mutual funds" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "0.0402" ;
    :yValue "Depository institutions" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "0.0319" ;
    :yValue "Private pension funds" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "0.0286" ;
    :yValue "State and local governments" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "0.0177" ;
    :yValue "State and local government pension funds" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "0.0089" ;
    :yValue "Insurance companies" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "0.0065" ;
    :yValue "U.S. savings bonds" ;
    :belongsTo :Chart .
