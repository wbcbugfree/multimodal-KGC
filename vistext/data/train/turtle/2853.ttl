@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Percentage of underweight adolescent girls in selected countries in 2011" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Percentage of adolescent girls" .

:YAxis a :Axis ;
    :title "Response" .

:DataPoint1 a :DataPoint ;
    :xValue "0.47" ;
    :yValue "India" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "0.35" ;
    :yValue "Bangladesh" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "0.34" ;
    :yValue "Niger" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "0.34" ;
    :yValue "Senegal" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "0.33" ;
    :yValue "Timor-Leste" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "0.33" ;
    :yValue "Ethiopia" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "0.3" ;
    :yValue "Namibia" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "0.28" ;
    :yValue "Madagascar" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "0.28" ;
    :yValue "Cambodia" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "0.26" ;
    :yValue "Nepal" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "0.25" ;
    :yValue "Democratic Republicof the Congo" ;
    :belongsTo :Chart .
