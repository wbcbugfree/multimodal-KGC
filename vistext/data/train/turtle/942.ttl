@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Afghanistan : Youth unemployment rate from 2010 to 2020" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Youth unemployment rate" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2009" ;
    :yValue "0.1806" ;
    :belongsTo :Chart .

