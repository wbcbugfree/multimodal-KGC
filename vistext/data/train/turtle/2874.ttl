@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Value of services exports of the United Kingdom (UK) into the European Union (EU) in 2019 , by type (in billion GBP)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Value of trade in services in billion GBP" .

:YAxis a :Axis ;
    :title "Service Type" .

:DataPoint1 a :DataPoint ;
    :xValue "39.81" ;
    :yValue "Other business services" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "26.21" ;
    :yValue "Financial" ;
    :belongsTo :Chart .

