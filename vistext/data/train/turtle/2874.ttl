    :xValue "18.22" ;
    :yValue "Travel" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "14.47" ;
    :yValue "Transportation" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "10.55" ;
    :yValue "ICT" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "7.04" ;
    :yValue "Insurance and Pension" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "6.43" ;
    :yValue "Intellectual property" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "1.92" ;
    :yValue "Maintenance and repair" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "1.91" ;
    :yValue "Manufacturing" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "1.4" ;
    :yValue "Personal, cultural and recreational" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "1.09" ;
    :yValue "Construction" ;
    :belongsTo :Chart .

:DataPoint12 a :DataPoint ;
    :xValue "0.76" ;
    :yValue "Government" ;
