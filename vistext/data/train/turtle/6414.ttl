@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Global impact of Severe Acute Respiratory Syndrome (SARS) on Real Gross Domestic Product (GDP) in 2004 and 2013 , by country" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Country" .

:YAxis a :Axis ;
    :title "10-year impact" .

:DataPoint1 a :DataPoint ;
    :xValue "Hong Kong" ;
    :yValue "-0.0321" ;
    :belongsTo :Chart .

