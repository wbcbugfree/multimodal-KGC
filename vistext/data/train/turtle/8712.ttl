@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Emerging Markets Bond Index (EMBI) spread in selected Latin American countries in 2020" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

