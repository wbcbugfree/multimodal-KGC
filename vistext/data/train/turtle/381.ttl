@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Annual salary of casino employees in Nevada in the United States from 2000 to 2016 (in U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Average annual salary in U.S. dollars" .

