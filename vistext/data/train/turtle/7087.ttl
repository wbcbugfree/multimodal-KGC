@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "U.S. sales price of aviation fuel (excluding taxes) to end-users from 1990 to 2014 (in current U.S. cents per gallon)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Jet fuel kerosene" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 1989" ;
    :yValue "76.6" ;
    :belongsTo :Chart .

