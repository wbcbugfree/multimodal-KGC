@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Estimated market value of grow lights worldwide from 2013 to 2023 , by technology (in million U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "HID" .

:DataPoint1 a :DataPoint ;
    :xValue "2023*" ;
    :yValue "1433.824" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "2022 *" ;
    :yValue "1263.369" ;
    :belongsTo :Chart .

