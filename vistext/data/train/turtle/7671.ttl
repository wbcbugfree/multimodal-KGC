    :xValue "2019*" ;
    :yValue "982.62" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "2018*" ;
    :yValue "882.353" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "2017*" ;
    :yValue "762.032" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "2016" ;
