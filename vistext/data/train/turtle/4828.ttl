@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Number of new bus and coach registrations in the United Kingdom (UK) in 2020 , by bus manufacturer" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "manufacturer" .

:YAxis a :Axis ;
    :title "Number of new vehicle registrations" .

:DataPoint1 a :DataPoint ;
    :xValue "Ford" ;
    :yValue "480" ;
    :belongsTo :Chart .

