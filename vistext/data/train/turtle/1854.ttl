@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Hasbro operating profit from 2006 to 2019 (in million U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Operating profit (in million U.S. dollars)" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2005" ;
    :yValue "376.36" ;
    :belongsTo :Chart .

