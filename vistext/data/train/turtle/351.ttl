@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Indium production worldwide in 2019 by country (in metric tons)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Country" .

:YAxis a :Axis ;
    :title "Price in U.S. dollars per kilogram" .

:DataPoint1 a :DataPoint ;
    :xValue "China" ;
    :yValue "300" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "South Korea" ;
    :yValue "240" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "Japan" ;
    :yValue "75" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "Canada" ;
    :yValue "60" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "France" ;
    :yValue "50" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Belgium" ;
    :yValue "20" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Peru" ;
    :yValue "10" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Russia" ;
    :yValue "5" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "United States" ;
    :yValue "0" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "World total" ;
    :yValue "760" ;
    :belongsTo :Chart .
