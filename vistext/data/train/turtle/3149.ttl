@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Total electricity consumption in France between 2004 and 2015 , adjusted for climate (in gigawatt hours)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Electricity consumed in gigawatt hours" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2003" ;
    :yValue "419314" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Dec 31, 2004" ;
    :yValue "421861" ;
    :belongsTo :Chart .

