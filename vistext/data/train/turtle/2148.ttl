@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Share of American women who have had anal intercourse in their lifetime , by age group" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Share of respondents" .

:YAxis a :Axis ;
    :title "Age group" .

:DataPoint1 a :DataPoint ;
    :xValue "0.04" ;
    :yValue "14-15" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "0.07" ;
    :yValue "16-17" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "0.2" ;
    :yValue "18-19" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "0.4" ;
    :yValue "20-24" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "0.46" ;
    :yValue "25-29" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "0.4" ;
    :yValue "30-39" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "0.41" ;
    :yValue "40-49" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "0.35" ;
    :yValue "50-59" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "0.3" ;
    :yValue "60-69" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "0.21" ;
    :yValue "70 and older" ;
    :belongsTo :Chart .
