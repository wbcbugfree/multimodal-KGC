    :xValue "Costa Rica" ;
    :yValue "13200" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Malaysia" ;
    :yValue "12500" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Mexico" ;
    :yValue "12500" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "Colombia" ;
