@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Number of Toyota Yaris passenger cars registered for the first time in Great Britain from 2001 to 2019 (in 1,000)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Number of new registrations in thousands" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2000" ;
    :yValue "33.1" ;
    :belongsTo :Chart .

