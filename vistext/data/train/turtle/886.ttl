@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Frontier Airlines ' passenger load factor from 2004 to 2019" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Passenger load factor" .

