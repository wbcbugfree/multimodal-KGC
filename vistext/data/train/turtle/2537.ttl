@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Share of votes in the Norwegian parliamentary election in 2017 , by party" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Share of votes" .

:YAxis a :Axis ;
    :title "Response" .

:DataPoint1 a :DataPoint ;
    :xValue "0.274" ;
    :yValue "Arbeiderpartiet" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "0.25" ;
    :yValue "Høyre" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "0.152" ;
    :yValue "Fremskrittspartiet" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "0.103" ;
    :yValue "Senterpartiet" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "0.06" ;
    :yValue "Sosialistisk Venstreparti" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "0.044" ;
    :yValue "Venstre" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "0.042" ;
    :yValue "Kristelig Folkeparti" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "0.032" ;
    :yValue "Miljøpartiet De Grønne" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "0.024" ;
    :yValue "Rødt" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "0.018" ;
    :yValue "Others*" ;
    :belongsTo :Chart .
