@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Number of Papa John 's restaurants in the United States from 2007 to 2019 , by mode of operation" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Company-owned" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2006" ;
    :yValue "648" ;
    :belongsTo :Chart .

