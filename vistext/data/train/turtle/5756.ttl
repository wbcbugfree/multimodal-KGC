@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Top destinations for United States chemical exports in 2019 , by country (in billion U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Exports in billion U.S. dollars" .

:YAxis a :Axis ;
    :title "Country" .

:DataPoint1 a :DataPoint ;
    :xValue "21.7" ;
    :yValue "Canada" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "21.2" ;
    :yValue "Mexico" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "10.1" ;
    :yValue "China" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "7.4" ;
    :yValue "Brazil" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "6.1" ;
    :yValue "Japan" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "6" ;
    :yValue "South Korea" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "5" ;
    :yValue "Netherlands" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "4.4" ;
    :yValue "India" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "3.2" ;
    :yValue "Singapore" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "3.1" ;
    :yValue "Germany" ;
    :belongsTo :Chart .
