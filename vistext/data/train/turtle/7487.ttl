@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Newspapers ranked by readership average issue reach in the United Kingdom (UK) in 2013 and 2016" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "2015" .

:YAxis a :Axis ;
    :title "Newspapers" .

:DataPoint1 a :DataPoint ;
    :xValue "0.087" ;
    :yValue "The Sun" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "0.068" ;
    :yValue "Daily Mail" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "0.063" ;
    :yValue "Metro" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "0.045" ;
    :yValue "Daily Mirror/Record" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "0.036" ;
    :yValue "Daily Mirror" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "0.034" ;
    :yValue "London Evening Standard" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "0.022" ;
    :yValue "The Daily Telegraph" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "0.02" ;
    :yValue "The Times" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "0.016" ;
    :yValue "The Guardian" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "0.015" ;
    :yValue "Daily Express" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "0.016" ;
    :yValue "Daily Star" ;
    :belongsTo :Chart .

:DataPoint12 a :DataPoint ;
    :xValue "0.01" ;
    :yValue "i" ;
    :belongsTo :Chart .

:DataPoint13 a :DataPoint ;
    :xValue "0.01" ;
    :yValue "Daily Record" ;
    :belongsTo :Chart .

:DataPoint14 a :DataPoint ;
    :xValue "0.005" ;
    :yValue "The Independent" ;
    :belongsTo :Chart .
