@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Club World Cup : number of titles won by club from 2000 to 2019" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Club World Cup titles" .

:YAxis a :Axis ;
    :title "association football club" .

:DataPoint1 a :DataPoint ;
    :xValue "4" ;
    :yValue "Real Madrid (2014, 2016, 2017 & 2018)" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "3" ;
    :yValue "FC Barcelona (2009, 2011 & 2015)" ;
    :belongsTo :Chart .

