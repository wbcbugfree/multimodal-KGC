    :yValue "Liberty Mutual" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "0.042" ;
    :yValue "Chubb**" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
