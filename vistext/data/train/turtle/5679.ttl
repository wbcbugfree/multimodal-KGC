@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Market share of leading worker compensation insurance companies in the United States in 2018 , by direct premiums written" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Market share" .

:YAxis a :Axis ;
    :title "business" .

:DataPoint1 a :DataPoint ;
    :xValue "0.075" ;
    :yValue "Travelers Companies Inc." ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "0.059" ;
    :yValue "Hartford Financial Services" ;
    :belongsTo :Chart .

