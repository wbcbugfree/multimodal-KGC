@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Top Formula 1 manufacturers (designers) based on number of world titles from 1950 to 2021" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Number of world titles" .

:YAxis a :Axis ;
    :title "Top Formula 1 manufacturers" .

:DataPoint1 a :DataPoint ;
    :xValue "16" ;
    :yValue "Ferrari" ;
    :belongsTo :Chart .

