@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Quarterly percent change in nonfarm business sector real hourly compensation in the United States from 2017 to 2020" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Percent change from preceding quarter" .

:YAxis a :Axis ;
    :title "Quarter" .

