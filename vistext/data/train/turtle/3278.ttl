@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Turnover of stores specializing in hardware , paints and glass retail sales in the United Kingdom (UK) from 2008 to 2018 (in million GBP)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Turnover in million GBP" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2007" ;
    :yValue "8875" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Dec 31, 2008" ;
    :yValue "9487" ;
    :belongsTo :Chart .

