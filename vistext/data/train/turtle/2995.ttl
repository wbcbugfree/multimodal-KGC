@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Sales volume of the leading spirits brands in Systembolaget stores in Sweden in 2019 (in 1,000 liters)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Sales volume in thousand liters" .

:YAxis a :Axis ;
    :title "Brand" .

:DataPoint1 a :DataPoint ;
    :xValue "937" ;
    :yValue "Explorer Vodka" ;
    :belongsTo :Chart .

