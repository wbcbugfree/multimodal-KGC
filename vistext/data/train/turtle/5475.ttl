@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Countries with the highest number of naval ships in Latin America in 2019" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Number of ships" .

:YAxis a :Axis ;
    :title "Country" .

