@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Share of people of color in the television news workforce in the United States from 1990 to 2020" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "Share of people of color" .

:DataPoint1 a :DataPoint ;
    :xValue "2020*" ;
    :yValue "0.266" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "2019" ;
    :yValue "0.259" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "2018" ;
    :yValue "0.248" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "2017" ;
    :yValue "0.244" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "2015" ;
    :yValue "0.222" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "2010" ;
    :yValue "0.202" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "2005" ;
    :yValue "0.212" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "2000" ;
    :yValue "0.21" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "1995" ;
    :yValue "0.171" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "1990" ;
    :yValue "0.178" ;
    :belongsTo :Chart .
