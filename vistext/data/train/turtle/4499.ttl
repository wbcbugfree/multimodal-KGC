@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "National Hockey League all-time leaders of regular season points scored as of October 23 , 2020" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Number of points scored" .

:YAxis a :Axis ;
    :title "player" .

