@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Unit shipments of electric/gas cooking appliances in the U.S. from 2007 to 2017 (in 1,000s)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Gas ovens" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2006" ;
    :yValue "55.9" ;
    :belongsTo :Chart .

