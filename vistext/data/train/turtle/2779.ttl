@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Under-five child mortality rate in Vietnam from 2005 to 2018 (per 1,000 live births)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Number of deaths per thousand live births" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2004" ;
    :yValue "25.1" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Dec 31, 2005" ;
    :yValue "24.53" ;
    :belongsTo :Chart .

