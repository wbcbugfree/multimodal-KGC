@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Most popular streaming services worldwide from November 2019 to March 2020 , by number of monthly visits (in millions)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Nov '19" .

:YAxis a :Axis ;
    :title "Platform" .

:DataPoint1 a :DataPoint ;
    :xValue "1017.49" ;
    :yValue "netflix.com" ;
    :belongsTo :Chart .

