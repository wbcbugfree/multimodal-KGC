@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Coal imported in to the United Kingdom (UK) from Colombia from 2002 to 2019 (in 1,000 metric tons)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Import volume in thousand metric tons" .

:DataPoint1 a :DataPoint ;
    :xValue "2019*" ;
    :yValue "1135" ;
    :belongsTo :Chart .

