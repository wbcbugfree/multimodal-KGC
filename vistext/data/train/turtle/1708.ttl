@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Imports for consumption of steel products into the U.S. in 2019 , by value and origin (in million U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Country" .

:YAxis a :Axis ;
    :title "Imports in million U.S. dollars" .

:DataPoint1 a :DataPoint ;
    :xValue "Canada" ;
    :yValue "4486.54" ;
    :belongsTo :Chart .

