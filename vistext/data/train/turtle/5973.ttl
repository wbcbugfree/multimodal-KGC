@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Average number of people per family in Canada in 2018 , by province" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Average number of people" .

:YAxis a :Axis ;
    :title "administrative territorial entity of Canada" .

:DataPoint1 a :DataPoint ;
    :xValue "3.8" ;
    :yValue "Nunavut" ;
    :belongsTo :Chart .

