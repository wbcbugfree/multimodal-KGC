@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Value of loans of FDIC-insured commercial banks secured by real estate in the United States from 2000 to 2019 (in trillion U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Loans in trillion U.S. dollars" .

