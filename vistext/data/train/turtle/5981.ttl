@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Number of motor vehicles produced by Nissan worldwide from 2006 to 2016 (in 1,000s units)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Production in thousand units" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2005" ;
    :yValue "3223.37" ;
    :belongsTo :Chart .

