@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Total attendance at Mountain West Conference college football games from 2003 to 2019 (in millions)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Attendance in millions" .

:DataPoint1 a :DataPoint ;
    :xValue "2019" ;
    :yValue "1.77" ;
    :belongsTo :Chart .

