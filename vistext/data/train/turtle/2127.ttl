@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Earnings per share of BNP Paribas from 2005 to 2019 (in euros)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Earnings per share in euros" .

