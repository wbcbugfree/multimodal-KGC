@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Number of infant deaths in the United Kingdom from 2000 to 2018 (in 1,000s)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Infant mortality rate" .

