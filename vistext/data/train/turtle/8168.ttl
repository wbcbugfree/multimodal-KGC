@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Usage of online banking credentials for various online services in Finland in 2016" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "Rarely" .

:DataPoint1 a :DataPoint ;
    :xValue "Paying online purchases from your bank account" ;
    :yValue "0.44" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Credit card payment verification likeVerified by Visa or Mastercard Secure Code" ;
    :yValue "0.35" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "Kela, the Finnish Social Insurance Institution" ;
    :yValue "0.43" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "Verohallinto (the Finnish Tax office)" ;
    :yValue "0.61" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "Insurance company's services" ;
    :yValue "0.47" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Municipal healthcare services" ;
    :yValue "0.41" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Posti (the main Finnish postal service)" ;
    :yValue "0.37" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Other governmental services" ;
    :yValue "0.4" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "Trafi (Finnish Transport Safety Agency)" ;
    :yValue "0.25" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "Other municipal services" ;
    :yValue "0.28" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "Väestörekisterikeskus (the Population Register Centre)" ;
    :yValue "0.29" ;
    :belongsTo :Chart .
