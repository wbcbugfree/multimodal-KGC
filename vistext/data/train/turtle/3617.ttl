@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Total assets of Dick 's Sporting Goods from 2006 to 2018 (in billion U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Total assets in billion U.S. dollars" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2005" ;
    :yValue "1.52" ;
    :belongsTo :Chart .

