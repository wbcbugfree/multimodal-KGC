@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Pass rates for large goods vehicles (LGV) practical driving tests in the United Kingdom (UK) from 2007 to 2019" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Pass rate" .

:DataPoint1 a :DataPoint ;
    :xValue "2018/19" ;
    :yValue "0.583" ;
    :belongsTo :Chart .

