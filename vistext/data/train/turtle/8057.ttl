@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Monthly number of visitor arrivals in Kenya from January 2019 to August 2020 , by airport" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Month" .

:YAxis a :Axis ;
    :title "MIA" .

