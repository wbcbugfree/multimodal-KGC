@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Average penetration rate of soft drink brands in Turkey from 2012 to 2013" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Brand" .

:YAxis a :Axis ;
    :title "2012" .

:DataPoint1 a :DataPoint ;
    :xValue "Coca-Col" ;
    :yValue "0.8" ;
    :belongsTo :Chart .

