@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Number of seniors in Canada in 2018 , by province and age group" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "province of Canada" .

:YAxis a :Axis ;
    :title "55 to 64 years" .

:DataPoint1 a :DataPoint ;
    :xValue "Ontario" ;
    :yValue "1787820" ;
    :belongsTo :Chart .

