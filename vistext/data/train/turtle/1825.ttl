@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "States with the highest underemployment rates in the U.S. 2016" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Underemployment rate" .

:YAxis a :Axis ;
    :title "State" .

:DataPoint1 a :DataPoint ;
    :xValue "0.175" ;
    :yValue "New Mexico" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "0.168" ;
    :yValue "Mississippi" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "0.162" ;
    :yValue "California" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "0.16" ;
    :yValue "New York" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "0.159" ;
    :yValue "Alaska" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "0.159" ;
    :yValue "Nevada" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "0.157" ;
    :yValue "Louisiana" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "0.155" ;
    :yValue "Florida" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "0.154" ;
    :yValue "West Virginia" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "0.154" ;
    :yValue "New Jersey" ;
    :belongsTo :Chart .
