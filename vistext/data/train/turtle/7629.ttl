@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "U.S. grapefruit imports and domestic exports from 1999 to 2017 (in metric tons)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Imports" .

