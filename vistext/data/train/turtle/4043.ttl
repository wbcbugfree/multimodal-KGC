@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Most engaging social media influencers in Poland in 2018 , by average number of interactions per post (in 1000s)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Average number of interactions per post" .

:YAxis a :Axis ;
    :title "Most engaging social media influencers" .

:DataPoint1 a :DataPoint ;
    :xValue "27.22" ;
    :yValue "Jemerced" ;
    :belongsTo :Chart .

