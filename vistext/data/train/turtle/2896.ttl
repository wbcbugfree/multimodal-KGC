@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Most popular leisure activities among Generation X in the United States as of September 2013" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "Share of respondents" .

:DataPoint1 a :DataPoint ;
    :xValue "Watch TV" ;
    :yValue "0.45" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Reading" ;
    :yValue "0.35" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "Computer/internet" ;
    :yValue "0.19" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "Spending time with family and friends" ;
    :yValue "0.19" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "Watching/going to the movies" ;
    :yValue "0.13" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Exercise/working out" ;
    :yValue "0.12" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Walking/running/jogging" ;
    :yValue "0.11" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Playing video games and computer/internet games" ;
    :yValue "0.1" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "Concerts/listening to/playing music" ;
    :yValue "0.09" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "Shopping" ;
    :yValue "0.07" ;
    :belongsTo :Chart .
