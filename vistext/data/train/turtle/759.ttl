@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Carbon dioxide (CO2) emissions in India from 2001 to 2016 (in metric tons per capita)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "CO2 emissions in metric tons per capita" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2000" ;
    :yValue "1.1" ;
    :belongsTo :Chart .

