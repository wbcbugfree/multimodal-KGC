@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Global revenue and financial results of the Coca-Cola Company from 2009 to 2019 (in million U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Operating income" .

:YAxis a :Axis ;
    :title "Year" .

:DataPoint1 a :DataPoint ;
    :xValue "8231" ;
    :yValue "2009" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "8413" ;
    :yValue "2010*" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "10173" ;
    :yValue "2011" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "10779" ;
    :yValue "2012" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "10228" ;
    :yValue "2013" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "9708" ;
    :yValue "2014" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "8728" ;
    :yValue "2015" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "8626" ;
    :yValue "2016" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "7755" ;
    :yValue "2017" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "9152" ;
    :yValue "2018" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "10086" ;
    :yValue "2019" ;
    :belongsTo :Chart .
