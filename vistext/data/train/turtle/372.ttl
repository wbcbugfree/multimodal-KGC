@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Goat production in Malaysia from 2005 to 2018 (in 1,000 heads)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Production in thousand heads" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2004" ;
    :yValue "287.67" ;
    :belongsTo :Chart .

