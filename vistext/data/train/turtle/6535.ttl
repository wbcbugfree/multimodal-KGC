@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Age structure of the population in the largest metropolitan areas in the U.S. 2009" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "45 to 64 years" .

:YAxis a :Axis ;
    :title "largest metropolitan areas in the US" .

:DataPoint1 a :DataPoint ;
    :xValue "5022623" ;
    :yValue "New York - Northern New Jersey - Long Island, NY-NJ-PA" ;
    :belongsTo :Chart .

