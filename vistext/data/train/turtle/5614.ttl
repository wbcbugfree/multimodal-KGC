@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Sales of the leading hair conditioner/creme rinse brands in the United States in 2018 (in million U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Sales in million U.S. dollars" .

:YAxis a :Axis ;
    :title "Brand" .

:DataPoint1 a :DataPoint ;
    :xValue "133.7" ;
    :yValue "Organix" ;
    :belongsTo :Chart .

