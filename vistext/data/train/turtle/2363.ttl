@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Minimum monthly wage in selected Latin American countries in 2020 (in U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Country" .

:YAxis a :Axis ;
    :title "Monthly minimum wage in U.S. dollars*" .

:DataPoint1 a :DataPoint ;
    :xValue "Uruguay" ;
    :yValue "429.6" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Ecuador" ;
    :yValue "400" ;
    :belongsTo :Chart .

