    :xValue "Bolivia" ;
    :yValue "299.1" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Argentina" ;
    :yValue "282.5" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Peru" ;
    :yValue "278.9" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Colombia" ;
    :yValue "268" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
