@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Number of existing homes sold in the United States from 2005 to 2021 (in million units)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Number of homes sold in million units" .

:YAxis a :Axis ;
    :title "Year" .

:DataPoint1 a :DataPoint ;
    :xValue "5.57" ;
    :yValue "2021*" ;
    :belongsTo :Chart .

