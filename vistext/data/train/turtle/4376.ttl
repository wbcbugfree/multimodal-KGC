@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Digital advertising revenue in India from financial year 2008 to 2020 with a forecast until financial year 2022 (in billion Indian rupees)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Fianncial year" .

:YAxis a :Axis ;
    :title "Revenue in billion Indian rupees" .

:DataPoint1 a :DataPoint ;
    :xValue "FY 2022" ;
    :yValue "292" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "FY 2021" ;
    :yValue "223" ;
    :belongsTo :Chart .

