@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Number of households in the United States from 1970 to 2020 , by size of household (in millions)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Two persons" .

