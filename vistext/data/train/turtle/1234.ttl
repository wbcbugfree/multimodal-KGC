@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Total pharmaceutical employment in EFPIA countries from 1990 to 2019" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Number of employees" .

:YAxis a :Axis ;
    :title "Year" .

:DataPoint1 a :DataPoint ;
    :xValue "500879" ;
    :yValue "1990" ;
    :belongsTo :Chart .

