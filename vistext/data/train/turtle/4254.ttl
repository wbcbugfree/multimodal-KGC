@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Development of the world population from 1950 to 2050 (in billions)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "World population in billions" .

