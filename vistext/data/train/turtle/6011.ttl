@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Average total annual compensation per full-time equivalent employee in the United States from 2000 to 2019 (in U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Total compensation per employee" .

