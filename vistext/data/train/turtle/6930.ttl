@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Capital expenditure revision of selected oil and gas producers worldwide in 2020 as a result of coronavirus impact (in billion U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Initial" .

:YAxis a :Axis ;
    :title "oil and gas producers" .

:DataPoint1 a :DataPoint ;
    :xValue "35" ;
    :yValue "Saudi Aramco" ;
    :belongsTo :Chart .

