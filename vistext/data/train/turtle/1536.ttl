@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Share of Federal Pell Grant recipients in the United States , as percentage of total undergraduate enrollment from 2009/10 to 2019/20" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "Share of Pell Grant recipients" .

:DataPoint1 a :DataPoint ;
    :xValue "2019/20" ;
    :yValue "0.31" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "2018/19" ;
    :yValue "0.31" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "2017/18" ;
    :yValue "0.32" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "2016/17" ;
    :yValue "0.32" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "2015/16" ;
    :yValue "0.34" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "2014/15" ;
    :yValue "0.36" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "2013/14" ;
    :yValue "0.37" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "2012/13" ;
    :yValue "0.37" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "2011/12" ;
    :yValue "0.38" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "2010/11" ;
    :yValue "0.37" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "2009/10" ;
    :yValue "0.33" ;
    :belongsTo :Chart .
