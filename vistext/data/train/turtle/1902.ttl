@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Number of permanent resident refugees in Canada admitted in 2019 , by province or territory" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "province of Canada" .

:YAxis a :Axis ;
    :title "Number of resident refugees" .

:DataPoint1 a :DataPoint ;
    :xValue "Ontario" ;
    :yValue "25545" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Quebec" ;
    :yValue "7250" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "Alberta" ;
    :yValue "6950" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "British Columbia" ;
    :yValue "3710" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "Manitoba" ;
    :yValue "2045" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Saskatchewan" ;
    :yValue "1215" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Nova Scotia" ;
    :yValue "790" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "New Brunswick" ;
    :yValue "510" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "Newfoundland and Labrador" ;
    :yValue "390" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "Prince Edward Island" ;
    :yValue "80" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "Territories*" ;
    :yValue "65" ;
    :belongsTo :Chart .
