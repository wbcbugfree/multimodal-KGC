@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Breakdown of NASA 's budget and how it was distributed from 2010 to 2020 (in million U.S dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Space Exploration" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2009" ;
    :yValue "3777" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Dec 31, 2010" ;
    :yValue "3928" ;
    :belongsTo :Chart .

