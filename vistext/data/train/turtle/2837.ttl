@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Promotional products ownership in the United States as of January 2019" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Share of respondents" .

:YAxis a :Axis ;
    :title "Response" .

:DataPoint1 a :DataPoint ;
    :xValue "0.89" ;
    :yValue "Writing instruments" ;
    :belongsTo :Chart .

