@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Italy : Budget balance from 2015 to 2025 in relation to gross domestic product (GDP)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Budget balance to GDP ratio" .

:YAxis a :Axis ;
    :title "Year" .

:DataPoint1 a :DataPoint ;
    :xValue "-0.0253" ;
    :yValue "2025*" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "-0.0255" ;
    :yValue "2024*" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "-0.0269" ;
    :yValue "2023*" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "-0.0394" ;
    :yValue "2022*" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "-0.0618" ;
    :yValue "2021*" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "-0.1298" ;
    :yValue "2020*" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "-0.0164" ;
    :yValue "2019" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "-0.022" ;
    :yValue "2018" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "-0.0245" ;
    :yValue "2017" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "-0.024" ;
    :yValue "2016" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "-0.0255" ;
    :yValue "2015" ;
    :belongsTo :Chart .
