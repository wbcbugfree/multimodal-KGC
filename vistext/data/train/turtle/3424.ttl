@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Countries with the largest share of female prisoners as of June 2020" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "Percentage of female prisoners" .

:DataPoint1 a :DataPoint ;
    :xValue "Hong Kong (China)" ;
    :yValue "0.201" ;
    :belongsTo :Chart .

