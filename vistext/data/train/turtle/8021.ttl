@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Spain : Government revenue and spending from 2014 to 2024 (in billion euros)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Revenue" .

:DataPoint1 a :DataPoint ;
    :xValue "2024*" ;
    :yValue "571.76" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "2023*" ;
    :yValue "553.49" ;
    :belongsTo :Chart .

