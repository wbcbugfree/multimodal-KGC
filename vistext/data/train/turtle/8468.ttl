@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Overnight accommodation costs in Houston from 2013 to 2017 , by month (in U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "2017" .

:YAxis a :Axis ;
    :title "Month" .

:DataPoint1 a :DataPoint ;
    :xValue "115" ;
    :yValue "Sep" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "116" ;
    :yValue "Aug" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "112" ;
    :yValue "Jul" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "118" ;
    :yValue "Jun" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "132" ;
    :yValue "May" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "125" ;
    :yValue "Apr" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "131" ;
    :yValue "Mar" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "148" ;
    :yValue "Feb" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "122" ;
    :yValue "Jan" ;
    :belongsTo :Chart .
