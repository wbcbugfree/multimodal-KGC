@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Number of domestic enplanements of U.S. commercial air carriers from 2006 to 2020 (in millions)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Mainline air carriers" .

:YAxis a :Axis ;
    :title "Fiscal year" .

:DataPoint1 a :DataPoint ;
    :xValue "690" ;
    :yValue "2020*" ;
    :belongsTo :Chart .

