@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Direct contribution of travel and tourism to employment in Italy from 2014 to 2029 (in 1,000 jobs)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Number of jobs in thousands" .

:YAxis a :Axis ;
    :title "Year" .

:DataPoint1 a :DataPoint ;
    :xValue "1690" ;
    :yValue "2029*" ;
    :belongsTo :Chart .

