@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Dividend of Allianz Group from 2009 to 2019 (in euros)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Dividend per share in euros" .

:DataPoint1 a :DataPoint ;
    :xValue "2019*" ;
    :yValue "9.6" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "2018" ;
    :yValue "9" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "2017" ;
    :yValue "8" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "2016" ;
    :yValue "7.6" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "2015" ;
    :yValue "7.3" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "2014" ;
    :yValue "6.85" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "2013" ;
    :yValue "5.3" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "2012" ;
    :yValue "4.5" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "2011" ;
    :yValue "4.5" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "2010" ;
    :yValue "4.5" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "2009" ;
    :yValue "4.1" ;
    :belongsTo :Chart .
