@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Leading silver consumers worldwide in 2010 , by country (in million ounces)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Silver consumption in million ounces" .

:YAxis a :Axis ;
    :title "Country" .

:DataPoint1 a :DataPoint ;
    :xValue "189.6" ;
    :yValue "United States" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "127.2" ;
    :yValue "China" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "102.1" ;
    :yValue "Japan" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "94.1" ;
    :yValue "India" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "39.6" ;
    :yValue "Germany" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "35.2" ;
    :yValue "Italy" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "30.7" ;
    :yValue "Thailand" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "29.9" ;
    :yValue "South Korea" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "20.7" ;
    :yValue "UK and Ireland" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "17.7" ;
    :yValue "Belgium" ;
