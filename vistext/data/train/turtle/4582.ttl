@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Top 20 of tourist cities in the world in 2015 , according to the number of visitor arrivals per inhabitant" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Country" .

:YAxis a :Axis ;
    :title "Number of visitors per inhabitant" .

:DataPoint1 a :DataPoint ;
    :xValue "Dubai" ;
    :yValue "5.7" ;
    :belongsTo :Chart .

