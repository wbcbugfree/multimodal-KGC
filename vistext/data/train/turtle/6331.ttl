@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Pharmaceutical imports and exports of major Latin American countries in 2019 (in million U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Country" .

:YAxis a :Axis ;
    :title "Imports" .

:DataPoint1 a :DataPoint ;
    :xValue "Mexico" ;
    :yValue "4800.07" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Panama**" ;
    :yValue "1604.2" ;
    :belongsTo :Chart .

