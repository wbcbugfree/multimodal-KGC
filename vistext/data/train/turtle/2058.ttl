    :xValue "0.09" ;
    :yValue "Phishing" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "0.08" ;
    :yValue "Dating" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "0.05" ;
    :yValue "Scams" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "0.03" ;
    :yValue "Finance" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "0.02" ;
    :yValue "Jobs" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "0" ;
