@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Most prevalent spam content categories worldwide in 2019" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Share of content" .

:YAxis a :Axis ;
    :title "Response" .

:DataPoint1 a :DataPoint ;
    :xValue "0.39" ;
    :yValue "Health" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "0.12" ;
    :yValue "Products" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "0.1" ;
    :yValue "Adult" ;
    :belongsTo :Chart .

