@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Regardless of your favorite team , who do you think will win the Super Bowl this year ?" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "Share of respondents" .

:DataPoint1 a :DataPoint ;
    :xValue "New England Patriots" ;
    :yValue "0.23" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Seattle Seahawks" ;
    :yValue "0.15" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "Green Bay Packers" ;
    :yValue "0.13" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "Denver Broncos" ;
    :yValue "0.07" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "Dallas Cowboys" ;
    :yValue "0.07" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Pittsburgh Steelers" ;
    :yValue "0.04" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Indianapolis Colts" ;
    :yValue "0.04" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "New York Giants" ;
    :yValue "0.03" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "Baltimore Ravens" ;
    :yValue "0.03" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "Arizona Cardinals" ;
    :yValue "0.03" ;
    :belongsTo :Chart .
