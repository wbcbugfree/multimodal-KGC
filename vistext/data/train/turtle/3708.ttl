@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Median total family income in Alberta from 2000 to 2018 (in Canadian dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Income in Canadian dollars" .

