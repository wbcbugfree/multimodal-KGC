@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "The 20 richest colleges in the United States in FY 2019 , by endowment funds market value (in billion U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Endowment fund value in billion U.S. dollars" .

:YAxis a :Axis ;
    :title "university" .

:DataPoint1 a :DataPoint ;
    :xValue "39.43" ;
    :yValue "Harvard University, MA" ;
    :belongsTo :Chart .

