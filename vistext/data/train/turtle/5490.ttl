@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Number of cyber security incident reports by federal agencies in the United States from FY 2006 to 2018" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Annual number of reported incidents" .

:DataPoint1 a :DataPoint ;
    :xValue "2006" ;
    :yValue "5503" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "2007" ;
    :yValue "11911" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "2008" ;
    :yValue "16843" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "2009" ;
    :yValue "29999" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "2010" ;
    :yValue "41776" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "2011" ;
    :yValue "42854" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "2012" ;
    :yValue "48562" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "2013" ;
    :yValue "61214" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "2014" ;
    :yValue "67168" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "2015" ;
    :yValue "77183" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "2016*" ;
    :yValue "30899" ;
    :belongsTo :Chart .

:DataPoint12 a :DataPoint ;
    :xValue "2017" ;
