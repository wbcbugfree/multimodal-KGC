@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Homicide by firearm rate per 100,000 population in the United States from 2006 to 2019" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Rate per 100,000 popuplation" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2005" ;
    :yValue "3.42" ;
    :belongsTo :Chart .

