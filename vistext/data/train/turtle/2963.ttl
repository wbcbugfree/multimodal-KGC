@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Average monthly number of calls per mobile subscription in Sweden from 2007 to 2019" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Average number of calls per mobile subscription" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2006" ;
    :yValue "63" ;
    :belongsTo :Chart .

