    :xValue "Dec 31, 2007" ;
    :yValue "65" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "Dec 31, 2008" ;
    :yValue "66" ;
    :belongsTo :Chart .

