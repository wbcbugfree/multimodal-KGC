@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Ranking the 20 countries with the most murders per 100,000 inhabitants in 2017" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Country" .

:YAxis a :Axis ;
    :title "Average number of murders per 100,000 inhabitants" .

:DataPoint1 a :DataPoint ;
    :xValue "El Salvador" ;
    :yValue "61.8" ;
    :belongsTo :Chart .

