@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Top ten PACs advocating for Hillary Clinton 's 2016 U.S. presidential campaign as of August , 2016 (in U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Amount spent in U.S. dollars" .

:YAxis a :Axis ;
    :title "PACs" .

:DataPoint1 a :DataPoint ;
    :xValue "5780293" ;
    :yValue "Priorities USA Action" ;
    :belongsTo :Chart .

