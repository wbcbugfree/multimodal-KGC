@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Average monthly costs of buying a home versus renting an apartment in the United Kingdom (UK) from 2009 to 2019 (in GBP)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Monthly rental payment" .

:YAxis a :Axis ;
    :title "Response" .

:DataPoint1 a :DataPoint ;
    :xValue "747" ;
    :yValue "Dec '19" ;
    :belongsTo :Chart .

