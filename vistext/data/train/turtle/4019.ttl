@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Number of Bentley Mulsanne cars registered in Great Britain from 2004 to 2018" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Number of registered cars" .

