@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Average retail price for peanut butter in Canada from January 2015 to June 2020 (in Canadian dollars per 500 grams)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Month" .

:YAxis a :Axis ;
    :title "2017" .

:DataPoint1 a :DataPoint ;
    :xValue "De" ;
    :yValue "3.25" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Dec No" ;
    :yValue "3.17" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "Nov Oc" ;
    :yValue "3.2" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "Oct Se" ;
    :yValue "3.21" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "Sep Au" ;
    :yValue "3.35" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Aug Ju" ;
    :yValue "3.29" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Jul Ju" ;
    :yValue "3.25" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Jun Ma" ;
    :yValue "3.28" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "May Ap" ;
    :yValue "3.37" ;
