    :xValue "Madrid" ;
    :yValue "725" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Dublin" ;
    :yValue "243" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Brussels" ;
    :yValue "868" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Lisbon" ;
    :yValue "267" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "Warsaw" ;
    :yValue "17" ;
    :belongsTo :Chart .

