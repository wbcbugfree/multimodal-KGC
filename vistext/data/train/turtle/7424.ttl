@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Total value of retail real estate investment in Europe from first to third quarter of 2018 and 2019 , by city (in million euros)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "city" .

:YAxis a :Axis ;
    :title "Q1-Q3 2018" .

:DataPoint1 a :DataPoint ;
    :xValue "Germany (big four)*" ;
    :yValue "2179" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Central Paris" ;
    :yValue "1177" ;
    :belongsTo :Chart .

