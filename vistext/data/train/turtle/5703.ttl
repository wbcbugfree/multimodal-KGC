@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Which social media could teen and young adult users in the United Kingdom (UK) least do without as of 3rd quarter 2019 ?" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "Share of respondents" .

:DataPoint1 a :DataPoint ;
    :xValue "YouTube" ;
    :yValue "0.232" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Facebook" ;
    :yValue "0.242" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "Instagram" ;
    :yValue "0.135" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "LinkedIn" ;
    :yValue "0.041" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "Snapchat" ;
    :yValue "0.147" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "WhatsApp" ;
    :yValue "0.211" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Twitter" ;
    :yValue "0.111" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Pinterest" ;
    :yValue "0.04" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "Tumblr" ;
    :yValue "0.026" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "Reddit" ;
    :yValue "0.044" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "Periscope" ;
    :yValue "0" ;
    :belongsTo :Chart .

:DataPoint12 a :DataPoint ;
    :xValue "Other" ;
    :yValue "0.006" ;
    :belongsTo :Chart .

:DataPoint13 a :DataPoint ;
    :xValue "Don't know" ;
    :yValue "0.091" ;
    :belongsTo :Chart .
