@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Average price of property in Spain to October 2020 , by autonomous community (in euros per square meter)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "autonomous community of Spain" .

:YAxis a :Axis ;
    :title "Price in euros per square meter built" .

:DataPoint1 a :DataPoint ;
    :xValue "Community of Madrid" ;
    :yValue "2630" ;
    :belongsTo :Chart .

