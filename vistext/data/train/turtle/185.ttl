@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Number of wholesale shipments of motorhomes in the United States from 2007 to 2019 (in thousands)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Number of shipments in thousands" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2006" ;
    :yValue "55.4" ;
    :belongsTo :Chart .

