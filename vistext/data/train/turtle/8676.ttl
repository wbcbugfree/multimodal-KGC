@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Total number of lululemon athletica stores worldwide from 2011 to 2020 , by country" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "2015" .

:YAxis a :Axis ;
    :title "Country" .

:DataPoint1 a :DataPoint ;
    :xValue "229" ;
    :yValue "United States" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "48" ;
    :yValue "Canada" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "26" ;
    :yValue "Australia" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "6" ;
    :yValue "United Kingdom" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "5" ;
    :yValue "New Zealand" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "1" ;
    :yValue "Germany" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "2" ;
    :yValue "Singapore" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "1" ;
    :yValue "Puerto Rico" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "2" ;
    :yValue "Hong Kong" ;
    :belongsTo :Chart .
