@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Average ticket price Tampa Bay Lightning (NHL) games from 2005/06 to 2014/15 (in U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Average ticket price in U.S. dollars" .

:YAxis a :Axis ;
    :title "Year" .

:DataPoint1 a :DataPoint ;
    :xValue "44.5" ;
    :yValue "14/15" ;
    :belongsTo :Chart .

