@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Forecast of the gross federal debt of the United States for fiscal years 2019 to 2030 (in billion U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "National debt in billion U.S. dollars" .

:DataPoint1 a :DataPoint ;
    :xValue "2030*" ;
    :yValue "36204" ;
    :belongsTo :Chart .

