@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Population of Spain in 2020 , by autonomous community" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Population" .

:YAxis a :Axis ;
    :title "autonomous community of Spain" .

