@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Number of coronavirus (COVID-19) studies registered worldwide as of December 22 , 2020 , by region" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Number of trials" .

:YAxis a :Axis ;
    :title "Country" .

:DataPoint1 a :DataPoint ;
    :xValue "4266" ;
    :yValue "Worldwide" ;
    :belongsTo :Chart .

