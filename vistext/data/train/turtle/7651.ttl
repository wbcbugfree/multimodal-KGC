@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Which region or country do you believe will witness the most M & A activity in Europe over the next 12 months ?" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "2nd most active" .

:DataPoint1 a :DataPoint ;
    :xValue "Germany" ;
    :yValue "0.2" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Nordic" ;
    :yValue "0.2" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "United Kingdom and Ireland" ;
    :yValue "0.13" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "Austria and Switzerland" ;
    :yValue "0.1" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "Benelux" ;
    :yValue "0.1" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "France" ;
    :yValue "0.08" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "South Eastern Europe" ;
    :yValue "0.05" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "CEE (excluding Russia and Ukraine)" ;
    :yValue "0.07" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "Italy" ;
    :yValue "0.03" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "Iberia" ;
    :yValue "0.01" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "Russia and Ukraine" ;
    :yValue "0.03" ;
    :belongsTo :Chart .
