@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Top goal scorers of Feyenoord Rotterdam as of January 2021 , by player" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "player" .

:YAxis a :Axis ;
    :title "Number of goals" .

:DataPoint1 a :DataPoint ;
    :xValue "Dirk Kuyt" ;
    :yValue "118" ;
    :belongsTo :Chart .

