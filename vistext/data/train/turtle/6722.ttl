@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Are you in favor of the death penalty for a person convicted of murder ?" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "Not in favor" .

