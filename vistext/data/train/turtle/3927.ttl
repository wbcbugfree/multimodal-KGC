@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Share of foreign visitors attending art galleries and museums in the United States from 1999 to 2013" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "Share of foreign visitors" .

