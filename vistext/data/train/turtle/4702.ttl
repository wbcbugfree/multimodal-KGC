@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Revenue of the Calgary Flames from 2005/06 to 2018/19 (in million U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Revenue in million U.S. dollars" .

:DataPoint1 a :DataPoint ;
    :xValue "2018/19" ;
    :yValue "138" ;
    :belongsTo :Chart .

