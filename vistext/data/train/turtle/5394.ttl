@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "PC penetration per capita in the Middle East and Africa from 2005 to 2015 (in percent)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Penetration in percent" .

:YAxis a :Axis ;
    :title "Year" .

:DataPoint1 a :DataPoint ;
    :xValue "0.07" ;
    :yValue "2015*" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "0.05" ;
    :yValue "2014*" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "0.03" ;
    :yValue "2013*" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "0.02" ;
    :yValue "2011*" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "0.02" ;
    :yValue "2012*" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "0.01" ;
    :yValue "2010" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "0.01" ;
    :yValue "2009" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "0.01" ;
    :yValue "2008" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "0.01" ;
    :yValue "2007" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "0.01" ;
    :yValue "2006" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "0.01" ;
    :yValue "2005" ;
    :belongsTo :Chart .
