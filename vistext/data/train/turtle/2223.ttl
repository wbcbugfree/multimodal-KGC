@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Leading direct selling markets in Europe in 2019 (in billion U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Country" .

:YAxis a :Axis ;
    :title "Value of retail sales in billion U.S. dollars" .

:DataPoint1 a :DataPoint ;
    :xValue "Germany" ;
    :yValue "17.45" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "France" ;
    :yValue "5.18" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "United Kingdom" ;
    :yValue "3.21" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "Italy" ;
    :yValue "2.96" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "Russia" ;
    :yValue "2.26" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Poland" ;
    :yValue "1.1" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Spain" ;
    :yValue "0.84" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Turkey" ;
    :yValue "0.48" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "Romania" ;
    :yValue "0.43" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "Ukraine" ;
    :yValue "0.35" ;
    :belongsTo :Chart .
