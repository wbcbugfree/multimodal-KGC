@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Worldwide app category revenue distribution in the Apple App Store in February 2014 , by business model" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "most-grossing app categories business model" .

:YAxis a :Axis ;
    :title "Free apps with in-app purchases" .

:DataPoint1 a :DataPoint ;
    :xValue "Catalogs" ;
    :yValue "0.354" ;
    :belongsTo :Chart .

