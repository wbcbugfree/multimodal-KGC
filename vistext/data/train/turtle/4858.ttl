@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "U.S. premium wineries sales growth from 2002 to 2019" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Sales growth" .

:YAxis a :Axis ;
    :title "Year" .

