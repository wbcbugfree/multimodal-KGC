@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Canada : Employment from 2010 to 2020 (in millions)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Employment in millions" .

:YAxis a :Axis ;
    :title "Year" .

:DataPoint1 a :DataPoint ;
    :xValue "19.16" ;
    :yValue "2020*" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "19.01" ;
    :yValue "2019*" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "18.66" ;
    :yValue "2018" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "18.42" ;
    :yValue "2017" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "18.08" ;
    :yValue "2016" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "17.95" ;
    :yValue "2015" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "17.8" ;
    :yValue "2014" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "17.69" ;
    :yValue "2013" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "17.44" ;
    :yValue "2012" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "17.22" ;
    :yValue "2011" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "16.97" ;
    :yValue "2010" ;
    :belongsTo :Chart .
