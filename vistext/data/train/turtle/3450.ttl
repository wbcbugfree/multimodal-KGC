@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "United States direct investments in the European Union , by industry in 2019 (in billion U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "industry" .

:YAxis a :Axis ;
    :title "Direct investments in billion U.S. dollars" .

:DataPoint1 a :DataPoint ;
    :xValue "Holding companies (non-bank)" ;
    :yValue "1835.31" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Finance (except depository institutions and insurance)" ;
    :yValue "394.28" ;
    :belongsTo :Chart .

