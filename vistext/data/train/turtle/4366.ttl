@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Rio Tinto 's total revenue from 2001 to 2019 (in million U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Revenue in million U.S. dollars" .

