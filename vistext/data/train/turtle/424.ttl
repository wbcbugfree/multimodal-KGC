@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Inflation-adjusted average revenue per available room of U.S. lodgings from 2002 to 2014 (in U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "inflation-adjusted RevPAR (in 2005 U.S. dollars)" .

:YAxis a :Axis ;
    :title "Year" .

:DataPoint1 a :DataPoint ;
    :xValue "71.68" ;
    :yValue "2014**" ;
    :belongsTo :Chart .

