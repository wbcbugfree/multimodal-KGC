@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Year-over-year change in total revenue per available room (TRevPAR) of hotels in Europe due to coronavirus (COVID-19) in March 2020" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year-over-year percentage change" .

:YAxis a :Axis ;
    :title "Country" .

:DataPoint1 a :DataPoint ;
    :xValue "-0.935" ;
    :yValue "Italy" ;
    :belongsTo :Chart .

