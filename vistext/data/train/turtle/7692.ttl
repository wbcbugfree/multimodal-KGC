@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Average hours per day in session of the U.S. Congress from 1981 to 2018" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "House of Representatives" .

:YAxis a :Axis ;
    :title "Year" .

:DataPoint1 a :DataPoint ;
    :xValue "4.1" ;
    :yValue "115th Congress, 2017-18" ;
    :belongsTo :Chart .

