@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Bill and Melinda Gates Foundation disbursements on global health from 1999 to 2013 (in million U.S dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Disbursements in million U.S. dollars" .

