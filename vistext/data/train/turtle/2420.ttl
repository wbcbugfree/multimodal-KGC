@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Average ticket price Los Angeles Kings games (NHL) from 2005/06 to 2014/15 (in U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Average ticket price in U.S. dollars" .

:DataPoint1 a :DataPoint ;
    :xValue "2014/15" ;
    :yValue "66.25" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "2013/14" ;
    :yValue "62.75" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "2012/13" ;
    :yValue "61.36" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "2011/12" ;
    :yValue "51.92" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "2010/11" ;
    :yValue "50.05" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "2009/10" ;
    :yValue "50.05" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "2008/09" ;
    :yValue "47.2" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "2007/08" ;
    :yValue "47.2" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "2006/07" ;
    :yValue "45.98" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "2005/06" ;
    :yValue "45.98" ;
    :belongsTo :Chart .
