@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Average number of employees of the LEGO Group worldwide from 2009 to 2019" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Average number of employees" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2008" ;
    :yValue "7286" ;
    :belongsTo :Chart .

