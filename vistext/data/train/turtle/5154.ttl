@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Major League Soccer team brand values in 2012 (in million U.S dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "name of football club" .

:YAxis a :Axis ;
    :title "Brand value in million U.S. dollars" .

:DataPoint1 a :DataPoint ;
    :xValue "Seattle Sounders FC" ;
    :yValue "58" ;
    :belongsTo :Chart .

