@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "New passenger car sales figures in North Macedonia from 2005 to 2019 (in units)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Units sold" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2004" ;
    :yValue "9300" ;
    :belongsTo :Chart .

