@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Number of doping cases in international sports between 2000 and 2010 , by sport" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Number of doping cases" .

:YAxis a :Axis ;
    :title "type of sport" .

:DataPoint1 a :DataPoint ;
    :xValue "971" ;
    :yValue "Athletics*" ;
    :belongsTo :Chart .

