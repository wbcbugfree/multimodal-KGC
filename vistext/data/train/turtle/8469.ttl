@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Life expectancy at birth for Northwest Territories from 2005 to 2018" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Northwest Territories" .

:YAxis a :Axis ;
    :title "Year" .

:DataPoint1 a :DataPoint ;
    :xValue "77" ;
    :yValue "2016-2018" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "77.1" ;
    :yValue "2015-2017" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "77.2" ;
    :yValue "2014-2016" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "77.6" ;
    :yValue "2013-2015" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "77.6" ;
    :yValue "2012-2014" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "77.8" ;
    :yValue "2011-2013" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "77.9" ;
    :yValue "2010-2012" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "77.5" ;
    :yValue "2009-2011" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "76.7" ;
    :yValue "2008-2010" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "76.6" ;
    :yValue "2007-2009" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "76.4" ;
    :yValue "2006-2008" ;
    :belongsTo :Chart .

:DataPoint12 a :DataPoint ;
    :xValue "77.2" ;
    :yValue "2005-2007" ;
    :belongsTo :Chart .
