@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Number of athletes representing Latin American and Caribbean countries in the 2018 PyeongChang Winter Olympics" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Number of athletes" .

:YAxis a :Axis ;
    :title "Country" .

:DataPoint1 a :DataPoint ;
    :xValue "37" ;
    :yValue "Total" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "1" ;
    :yValue "Puerto Rico" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "1" ;
    :yValue "Ecuador" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "2" ;
    :yValue "Bolivia" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "3" ;
    :yValue "Jamaica" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "4" ;
    :yValue "Mexico" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "4" ;
    :yValue "Colombia" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "6" ;
    :yValue "Argentina" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "7" ;
    :yValue "Chile" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "9" ;
    :yValue "Brazil" ;
    :belongsTo :Chart .
