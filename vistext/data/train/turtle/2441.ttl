@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "LCD panel production capacity of LGD from 2006 to 2017 (in million square meters)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Production capacity in million square meters" .

:YAxis a :Axis ;
    :title "Year" .

:DataPoint1 a :DataPoint ;
    :xValue "51.53" ;
    :yValue "2017*" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "50.5" ;
    :yValue "2016*" ;
    :belongsTo :Chart .

