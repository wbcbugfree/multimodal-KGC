    :xValue "48.8" ;
    :yValue "2012" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "45.31" ;
    :yValue "2011" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "38.14" ;
    :yValue "2010" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
