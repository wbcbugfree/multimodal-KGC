@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Percentage of respondents worldwide who were concerned about the COVID-19 situation in their country as of March 12 , 2020 , by country" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "Quite concerned" .

:DataPoint1 a :DataPoint ;
    :xValue "All" ;
    :yValue "0.25" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Australia" ;
    :yValue "0.27" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "Brazil" ;
    :yValue "0.2" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "China" ;
    :yValue "0.28" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "France" ;
    :yValue "0.29" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Germany" ;
    :yValue "0.28" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Italy" ;
    :yValue "0.28" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Japan" ;
    :yValue "0.3" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "Philippines" ;
    :yValue "0.06" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "Singapore" ;
    :yValue "0.31" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "South Africa" ;
    :yValue "0.15" ;
    :belongsTo :Chart .

:DataPoint12 a :DataPoint ;
    :xValue "Spain" ;
    :yValue "0.28" ;
    :belongsTo :Chart .

:DataPoint13 a :DataPoint ;
    :xValue "United Kingdom" ;
    :yValue "0.23" ;
    :belongsTo :Chart .

:DataPoint14 a :DataPoint ;
    :xValue "United States" ;
    :yValue "0.21" ;
    :belongsTo :Chart .
