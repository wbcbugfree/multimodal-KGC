@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Average usual weekly hours worked at the main job in Canada in 2019 , by industry" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Average usual weekly hours" .

:YAxis a :Axis ;
    :title "Industry" .

:DataPoint1 a :DataPoint ;
    :xValue "45" ;
    :yValue "Forestry, fishing, mining, quarrying, oil and gas" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "43.5" ;
    :yValue "Agriculture" ;
    :belongsTo :Chart .

