@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Sales volume of sparkling wine from fresh grapes manufactured in the United Kingdom (UK) from 2009 to 2019 (in liters of pure alcohol)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Sales volume in liters" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2008" ;
    :yValue "258430" ;
    :belongsTo :Chart .

