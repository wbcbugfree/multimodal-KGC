    :xValue "2022*" ;
    :yValue "840" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "2021*" ;
    :yValue "828" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "2020*" ;
    :yValue "815" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "2019" ;
    :yValue "765" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "2018" ;
    :yValue "789" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "2017" ;
    :yValue "851" ;
