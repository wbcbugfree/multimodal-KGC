@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Average prices for soybean oil worldwide from 2014 to 2025 (in nominal U.S. dollars per mt)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Price in nominal U.S. dollars per metric ton" .

:DataPoint1 a :DataPoint ;
    :xValue "2025*" ;
    :yValue "880" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "2024*" ;
    :yValue "867" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "2023*" ;
    :yValue "853" ;
    :belongsTo :Chart .

