@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Average number of people living in households in China from 1990 to 2019" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Number of persons" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 1989" ;
    :yValue "3.5" ;
    :belongsTo :Chart .

