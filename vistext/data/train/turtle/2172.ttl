@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Total annual U.S. exports of toys , dolls and games to Paraguay from 2005 to 2019 (in million U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Total exports in million U.S. dollars" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2004" ;
    :yValue "19.67" ;
    :belongsTo :Chart .

