    :xValue "April Ma" ;
    :yValue "277571" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "May Jun 478200; Month: June Jul 324100; Month: July Augus" ;
    :yValue "177733" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "August Septembe" ;
    :yValue "303100" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "September Octobe" ;
    :yValue "214071" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "October Novembe" ;
