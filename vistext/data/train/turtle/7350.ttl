@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Monthly average TV viewership per game of Major League Soccer (MLS) in the United States in 2016 and 2017" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Month" .

:YAxis a :Axis ;
    :title "2016" .

:DataPoint1 a :DataPoint ;
    :xValue "Marc" ;
    :yValue "276667" ;
    :belongsTo :Chart .

