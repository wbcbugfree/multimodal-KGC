@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Number of Starbucks stores in Canada from 2005 to 2019" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Company-operated stores" .

:YAxis a :Axis ;
    :title "Year" .

