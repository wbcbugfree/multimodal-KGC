@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Import volume of beef and veal in Canada from 2011 to 2020 (in 1,000 metric tons)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Imports in 1,000 metric tons" .

:YAxis a :Axis ;
    :title "Year" .

:DataPoint1 a :DataPoint ;
    :xValue "210" ;
    :yValue "2020**" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "204" ;
    :yValue "2019" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "236" ;
    :yValue "2018" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "229" ;
    :yValue "2017" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "245" ;
    :yValue "2016" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "269" ;
    :yValue "2015" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "272" ;
    :yValue "2014" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "295" ;
    :yValue "2013" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "301" ;
    :yValue "2012" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "282" ;
    :yValue "2011" ;
    :belongsTo :Chart .
