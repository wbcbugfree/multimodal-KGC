@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Usage of digital devices for financial activities among millennials in Denmark in 2018 , by device and purpose" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Phone call" .

:YAxis a :Axis ;
    :title "Response" .

:DataPoint1 a :DataPoint ;
    :xValue "0.04" ;
    :yValue "Balance" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "0.04" ;
    :yValue "Send/receive money (domestic)" ;
    :belongsTo :Chart .

