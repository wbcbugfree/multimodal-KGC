@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Number of racist incidents recorded by the police in England and Wales from 2009/10 to 2019/20" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Number of incidents*" .

:DataPoint1 a :DataPoint ;
    :xValue "2019/20" ;
    :yValue "76070" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "2018/19" ;
    :yValue "75479" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "2017/18" ;
    :yValue "71251" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "2015/16" ;
    :yValue "58197" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "2014/15" ;
    :yValue "53902" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "2013/14" ;
    :yValue "48828" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "2012/13" ;
    :yValue "47548" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "2011/12" ;
    :yValue "47678" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "2010/11" ;
    :yValue "51585" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "2009/10" ;
    :yValue "55134" ;
    :belongsTo :Chart .
