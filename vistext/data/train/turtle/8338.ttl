@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Usage of digital devices for financial activities among millennials in Denmark in 2018 , by device and purpose" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "In real life" .

:DataPoint1 a :DataPoint ;
    :xValue "Balance" ;
    :yValue "0" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Send/receive money (domestic)" ;
    :yValue "0" ;
    :belongsTo :Chart .

