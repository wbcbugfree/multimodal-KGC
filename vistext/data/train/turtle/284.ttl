@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Metallic mineral production value in Canada in 2019 , by province (in 1,000 Canadian dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "province of Canada" .

:YAxis a :Axis ;
    :title "Production in thousand Canadian dollars" .

:DataPoint1 a :DataPoint ;
    :xValue "Quebec" ;
    :yValue "9008702" ;
    :belongsTo :Chart .

