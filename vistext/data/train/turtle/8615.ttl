@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "U.S. e-commerce value of computers , computer equipment and software wholesale trade from 2007 to 2018 (in million U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Total" .

:YAxis a :Axis ;
    :title "Year" .

:DataPoint1 a :DataPoint ;
    :xValue "272967" ;
    :yValue "2018" ;
    :belongsTo :Chart .

