@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Global sponsorship spending by region from 2009 to 2018 (in billion U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Central / South America" .

:DataPoint1 a :DataPoint ;
    :xValue "2018**" ;
    :yValue "4.6" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "2017" ;
    :yValue "4.5" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "2016" ;
    :yValue "4.4" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "2015" ;
    :yValue "4.3" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "2014" ;
    :yValue "4.2" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "2013" ;
    :yValue "4" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "2012" ;
    :yValue "3.9" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "2011" ;
    :yValue "3.7" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "2010" ;
    :yValue "3.6" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "2009" ;
    :yValue "3.5" ;
    :belongsTo :Chart .
