@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Average organizational cost to a business in the United States after a data breach from 2006 to 2020 (in million U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Cost in million U.S. dollars" .

