@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Number of sexual assaults of British (UK) residents in selected countries from April 2012 to March 2014" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

