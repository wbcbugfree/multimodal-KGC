@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Largest solar photovoltaic power plants worldwide as of June 2019 , by capacity (in megawatts)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Capacity in megawatts" .

:YAxis a :Axis ;
    :title "photovoltaic power station" .

:DataPoint1 a :DataPoint ;
    :xValue "4500" ;
    :yValue "Golmud Desert Solar Park(China)*" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "2200" ;
    :yValue "Bhadla Industrial Solar Park (India)*" ;
    :belongsTo :Chart .

