@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Number of enterprises in the manufacture of plastics products industry in Finland from 2008 to 2017" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Number of enterprises" .

:YAxis a :Axis ;
    :title "Year" .

:DataPoint1 a :DataPoint ;
    :xValue "466" ;
    :yValue "2017**" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "485" ;
    :yValue "2016" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "486" ;
    :yValue "2015" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "500" ;
    :yValue "2014" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "518" ;
    :yValue "2013*" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "532" ;
    :yValue "2012" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "561" ;
    :yValue "2011" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "557" ;
    :yValue "2010" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "580" ;
    :yValue "2009" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "602" ;
    :yValue "2008" ;
    :belongsTo :Chart .
