@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Household consumption expenditure breakdown in the United Kingdom (UK) from 2000 to 2019" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Miscellaneous" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 1999" ;
    :yValue "0.13" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Dec 31, 2004" ;
    :yValue "0.14" ;
    :belongsTo :Chart .

