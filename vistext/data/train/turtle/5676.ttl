@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Number of practicing doctors in Germany between 1991 and 2018 (per 1,000 population)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Doctors per thousand population" .

