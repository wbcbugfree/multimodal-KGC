@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Average annual income in Belgium from 2006 to 2017 , by region (in euros)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "Flemish Region" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2005" ;
    :yValue "14984" ;
    :belongsTo :Chart .

