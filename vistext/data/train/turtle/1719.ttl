@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Number employed in food retailing in the United Kingdom (UK) from 2003 to 2018 (in thousands)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Workforce in thousand persons" .

:YAxis a :Axis ;
    :title "Year" .

