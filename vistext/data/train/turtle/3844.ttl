@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Average turn round time at Deendayal port in India from financial year 1991 to 2019 (in days)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Average turn round time in days" .

:YAxis a :Axis ;
    :title "year" .

:DataPoint1 a :DataPoint ;
    :xValue "4.68" ;
    :yValue "FY 2019" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "4.25" ;
    :yValue "FY 2018" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "4.51" ;
    :yValue "FY 2017" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "4.28" ;
    :yValue "FY 2016" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "4.9" ;
    :yValue "FY 2015" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "5.66" ;
    :yValue "FY 2014" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "6.33" ;
    :yValue "FY 2013" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "6.42" ;
    :yValue "FY 2012" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "5.9" ;
    :yValue "FY 2011" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "5.03" ;
    :yValue "FY 2010" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "7.26" ;
    :yValue "FY 2009" ;
    :belongsTo :Chart .

:DataPoint12 a :DataPoint ;
    :xValue "4.72" ;
    :yValue "FY 2001" ;
    :belongsTo :Chart .

:DataPoint13 a :DataPoint ;
    :xValue "10" ;
    :yValue "FY 1991" ;
    :belongsTo :Chart .
