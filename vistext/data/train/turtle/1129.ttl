@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Leading pure-play big data vendors ' revenue in 2013 (in million U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Revenue in million U.S. dollars" .

:DataPoint1 a :DataPoint ;
    :xValue "Palantir" ;
    :yValue "418" ;
    :belongsTo :Chart .

