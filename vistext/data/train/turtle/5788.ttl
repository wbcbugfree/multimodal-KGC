@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Value of remittance sent from Singapore in 2017 , by country of destination (in million U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Country" .

:YAxis a :Axis ;
    :title "Remittance in million U.S. dollars" .

:DataPoint1 a :DataPoint ;
    :xValue "China" ;
    :yValue "2763" ;
    :belongsTo :Chart .

