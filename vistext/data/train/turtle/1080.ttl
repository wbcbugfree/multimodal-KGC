@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Ten most popular AC Milan players on Instagram as of May 29 , 2020 (in million followers)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Number of followers in millions" .

:YAxis a :Axis ;
    :title "players" .

:DataPoint1 a :DataPoint ;
    :xValue "42.37" ;
    :yValue "Zlatan Ibrahimović" ;
    :belongsTo :Chart .

