@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Leading countries based on Pinterest audience size as of October 2020 (in millions)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Country" .

:YAxis a :Axis ;
    :title "Audience size in millions" .

:DataPoint1 a :DataPoint ;
    :xValue "United States" ;
    :yValue "97.22" ;
    :belongsTo :Chart .

