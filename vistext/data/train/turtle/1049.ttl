@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Territorial CO2 emissions in Canada from fossil fuel and cement production from 1995 to 2019 (in million metric tons)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Emissions in million metric tons" .

