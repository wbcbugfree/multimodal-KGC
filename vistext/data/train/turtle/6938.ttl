@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Median feature film budget in the United Kingdom (UK) from 2008 to 2019 , by production type (in million GBP)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Production category" .

:YAxis a :Axis ;
    :title "Co-productions" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2007" ;
    :yValue "1.4" ;
    :belongsTo :Chart .

