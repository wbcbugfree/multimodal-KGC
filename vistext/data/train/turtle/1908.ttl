@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Department expenditure limit (DEL) of the Ministry of Justice in the United Kingdom from 2004/05 to 2019/20 (in billion British pounds)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "DEL in billion GBP" .

