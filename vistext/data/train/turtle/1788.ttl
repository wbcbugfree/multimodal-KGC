@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Transmission distribution and other losses of the public electricity distribution system in the United Kingdom (UK) from 2000 to 2019 (in terawatt hours)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "in terawatt hours" .

