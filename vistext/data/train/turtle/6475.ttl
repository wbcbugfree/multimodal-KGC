@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Olympic Summer Games 2016 medal tally of the Italian Olympic team , by sport" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Bronze" .

:YAxis a :Axis ;
    :title "type of sport" .

:DataPoint1 a :DataPoint ;
    :xValue "0" ;
    :yValue "Judo" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "0" ;
    :yValue "Fencing" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "1" ;
    :yValue "Diving" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "2" ;
    :yValue "Swimming" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "1" ;
    :yValue "Cycling road" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "0" ;
    :yValue "Shooting" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "2" ;
    :yValue "Rowing" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "0" ;
    :yValue "Beach volley" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "1" ;
    :yValue "Water polo" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "0" ;
    :yValue "Volleyball" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "1" ;
    :yValue "Wrestling" ;
    :belongsTo :Chart .
