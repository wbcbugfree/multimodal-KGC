@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Turnover of the manufacture of machinery and equipment n.e.c . industry in the United Kingdom (UK) from 2008 to 2017 (in million euros)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Annual turnover in million euros" .

:YAxis a :Axis ;
    :title "Year" .

:DataPoint1 a :DataPoint ;
    :xValue "56907.8" ;
    :yValue "2017**" ;
    :belongsTo :Chart .

