@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Largest one-day point gains of the Dow Jones Index from 1987 to June 2020" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Change in index points within one day" .

