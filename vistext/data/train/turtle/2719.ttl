@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Net sales of the largest global home improvement products companies in 2010 (in billion U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Net sales in billion U.S. dollars" .

:YAxis a :Axis ;
    :title "Company name" .

:DataPoint1 a :DataPoint ;
    :xValue "8.41" ;
    :yValue "Stanley Black & Decker" ;
    :belongsTo :Chart .

