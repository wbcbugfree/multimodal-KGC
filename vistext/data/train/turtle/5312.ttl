@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Sector distribution of merger and acquisitions (M & A) transaction volume in the United Kingdom (UK) in 2019" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Volume" .

:YAxis a :Axis ;
    :title "business sector" .

:DataPoint1 a :DataPoint ;
    :xValue "1688" ;
    :yValue "Financial services" ;
    :belongsTo :Chart .

