@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Indoor venue exhibition space available worldwide in 2011 , by country (in million square meters)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Exhibition space in million square meters" .

:YAxis a :Axis ;
    :title "Country" .

