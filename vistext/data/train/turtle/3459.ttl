@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Most common crises in relationships in Poland in 2019" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "Share of respondents" .

:DataPoint1 a :DataPoint ;
    :xValue "Difficult financial situation/unemployment" ;
    :yValue "0.28" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Long-lasting relationship - boredom" ;
    :yValue "0.22" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "Difficulties arising from the first years of the relationship" ;
    :yValue "0.21" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "Long-term separation" ;
    :yValue "0.16" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "Substantial difference in values and expectations" ;
    :yValue "0.16" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Workaholism" ;
    :yValue "0.14" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Children" ;
    :yValue "0.12" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Loss of a child" ;
    :yValue "0.06" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "Traumatic event" ;
    :yValue "0.06" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "Empty nest syndrome" ;
    :yValue "0.05" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "Sickness/death" ;
    :yValue "0.05" ;
    :belongsTo :Chart .

:DataPoint12 a :DataPoint ;
    :xValue "No acceptance of the environment" ;
    :yValue "0.05" ;
    :belongsTo :Chart .

:DataPoint13 a :DataPoint ;
    :xValue "Childlessness" ;
    :yValue "0.04" ;
    :belongsTo :Chart .
