    :xValue "Dec 31, 2012" ;
    :yValue "1710.7" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Dec 31, 2013" ;
    :yValue "1973.28" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Dec 31, 2014" ;
    :yValue "5196.85" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
