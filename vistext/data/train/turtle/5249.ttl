@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Number of hotels and similar accommodation establishments in France from 2007 to 2017" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Number of hotels" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2006" ;
    :yValue "18135" ;
    :belongsTo :Chart .

