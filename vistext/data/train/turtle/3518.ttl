@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Number of health centers and hospitals in selected countries in Latin America in 2015" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Number" .

:YAxis a :Axis ;
    :title "Country" .

:DataPoint1 a :DataPoint ;
    :xValue "8438" ;
    :yValue "Argentina" ;
    :belongsTo :Chart .

