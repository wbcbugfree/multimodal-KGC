@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Volume of total cargo handled across India in financial year 2019 , by major port (in million metric tons)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "port" .

:YAxis a :Axis ;
    :title "Volume in million metric tons" .

:DataPoint1 a :DataPoint ;
    :xValue "Deendayal" ;
    :yValue "115.4" ;
    :belongsTo :Chart .

