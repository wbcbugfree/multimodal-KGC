@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Global number of green building certified projects constructed by Hochtief from 2008 to 2019 , by type of certification" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Australia (Green Star)" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2007" ;
    :yValue "8" ;
    :belongsTo :Chart .

