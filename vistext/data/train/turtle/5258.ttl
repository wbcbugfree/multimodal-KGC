@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Number of deaths in Spain from 2006 to 2018" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Number of deaths" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2005" ;
    :yValue "371478" ;
    :belongsTo :Chart .

