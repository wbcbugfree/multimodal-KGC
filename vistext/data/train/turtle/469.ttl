@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Number of individuals watching TV in Italy from 2007 to 2019 (in 1,000 viewers)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Viewers in thousands" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2005" ;
    :yValue "53466" ;
    :belongsTo :Chart .

