@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Boehringer Ingelheim 's expenditure on research and development as a percentage of revenue from 2004 to 2019" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "Percentage of revenue" .

