@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Cost of electricity produced from coal in the United States between 2000 and 2014 (in cents per kilowatt hour)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Production costs in cents per kilowatt hour" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 1999" ;
    :yValue "2.37" ;
    :belongsTo :Chart .

