@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Tissue consumption growth rate in Asia between 2014 - 2017 , by country or region" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Tissue consumption growth rate" .

:YAxis a :Axis ;
    :title "Country" .

:DataPoint1 a :DataPoint ;
    :xValue "0.084" ;
    :yValue "Turkey" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "0.071" ;
    :yValue "India" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "0.0665" ;
    :yValue "China" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "0.05" ;
    :yValue "Indonesia" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "0.0425" ;
    :yValue "Thailand" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "0.0255" ;
    :yValue "Taiwan" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "0.02" ;
    :yValue "South Korea" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "0.0105" ;
    :yValue "Japan" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "0.063" ;
    :yValue "Other NME" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "0.0525" ;
    :yValue "Other AFE" ;
    :belongsTo :Chart .
