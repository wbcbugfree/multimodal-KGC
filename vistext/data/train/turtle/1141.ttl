@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Share of households with internet access in Sweden from 2007 to 2019" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "Share of households" .

:DataPoint1 a :DataPoint ;
    :xValue "2019" ;
    :yValue "0.96" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "2018" ;
    :yValue "0.92" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "2017" ;
    :yValue "0.95" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "2016*" ;
    :yValue "0.94" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "2015" ;
    :yValue "0.91" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "2014" ;
    :yValue "0.9" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "2013" ;
    :yValue "0.93" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "2012" ;
    :yValue "0.92" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "2011" ;
    :yValue "0.91" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "2010" ;
    :yValue "0.88" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "2009" ;
    :yValue "0.86" ;
    :belongsTo :Chart .

:DataPoint12 a :DataPoint ;
    :xValue "2008" ;
    :yValue "0.84" ;
    :belongsTo :Chart .

:DataPoint13 a :DataPoint ;
    :xValue "2007" ;
    :yValue "0.79" ;
    :belongsTo :Chart .
