@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Costs of a night out for two people in the most expensive United States cities in 2014 (in U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Hotel" .

:YAxis a :Axis ;
    :title "Return taxi trip" .

