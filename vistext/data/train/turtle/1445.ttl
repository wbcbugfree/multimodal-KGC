@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Sales value of beer in Canada in 2015/2016 , by province (in million Canadian dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "province of Canada" .

:YAxis a :Axis ;
    :title "Beer sales in million Canadian dollars" .

:DataPoint1 a :DataPoint ;
    :xValue "Ontario" ;
    :yValue "3249.94" ;
    :belongsTo :Chart .

