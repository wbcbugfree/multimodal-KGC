@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Number of people who were hard of hearing worldwide and in Europe as of 2015 , by country (in millions of people)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Country" .

:YAxis a :Axis ;
    :title "Estimated number of people with hearing loss" .

:DataPoint1 a :DataPoint ;
    :xValue "Global" ;
    :yValue "328" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Europe*" ;
    :yValue "119" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "European Union" ;
    :yValue "51" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "United Kingdom" ;
    :yValue "10" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "France" ;
    :yValue "6" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Spain" ;
    :yValue "3.5" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Netherlands" ;
    :yValue "1.6" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Austria" ;
    :yValue "1.6" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "Sweden" ;
    :yValue "1.4" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "Belgium" ;
    :yValue "1.3" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "Poland" ;
    :yValue "1" ;
    :belongsTo :Chart .

:DataPoint12 a :DataPoint ;
    :xValue "Denmark" ;
    :yValue "0.8" ;
    :belongsTo :Chart .

:DataPoint13 a :DataPoint ;
    :xValue "Ireland" ;
    :yValue "0.8" ;
    :belongsTo :Chart .
