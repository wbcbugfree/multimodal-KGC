@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Natural gas production of OPEC countries from 2012 to 2019 (in million cubic meters)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Country" .

:YAxis a :Axis ;
    :title "2018" .

:DataPoint1 a :DataPoint ;
    :xValue "Ira" ;
    :yValue "248524" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Iran Saudi Arabi" ;
    :yValue "118000" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "Saudi Arabia Algeri" ;
    :yValue "95898" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "Algeria United Arab Emirate" ;
    :yValue "47624" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "United Arab Emirates Nigeri" ;
    :yValue "44251" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Nigeria Venezuel" ;
    :yValue "24785" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Venezuela Kuwai" ;
    :yValue "17738" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Kuwait Liby" ;
    :yValue "13880" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
