@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Large luxury car and SUV sales in the United States in 2019 , by key model (in units)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "2018" .

:YAxis a :Axis ;
    :title "Large luxury car and SUV models" .

:DataPoint1 a :DataPoint ;
    :xValue "36032" ;
    :yValue "Cadillac Escalade" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "21973" ;
    :yValue "Mercedes-Benz GLS-Class" ;
    :belongsTo :Chart .

