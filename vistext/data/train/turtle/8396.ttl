    :xValue "19207" ;
    :yValue "Infiniti QX80" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "19030" ;
    :yValue "Land Rover Range Rover" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "17839" ;
    :yValue "Lincoln Navigator" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "29950" ;
    :yValue "Tesla Model S" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "14978" ;
    :yValue "Mercedes-Benz S-Class" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "8271" ;
    :yValue "BMW 7-Series" ;
