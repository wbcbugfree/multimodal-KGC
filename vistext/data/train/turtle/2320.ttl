@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Share of votes in the Danish Parliament election on June 5 , 2019 , by party" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "Share of total votes" .

:DataPoint1 a :DataPoint ;
    :xValue "Socialdemokratiet" ;
    :yValue "0.259" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Venstre, Danmarks Liberale Parti" ;
    :yValue "0.234" ;
    :belongsTo :Chart .

