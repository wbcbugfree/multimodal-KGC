    :xValue "SF - Socialistisk Folkeparti" ;
    :yValue "0.077" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Enhedslisten - De Rød-Grønne" ;
    :yValue "0.069" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Det Konservative Folkeparti" ;
    :yValue "0.066" ;
    :belongsTo :Chart .

