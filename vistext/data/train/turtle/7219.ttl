@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Liverpool FC revenue by stream from 2008/09 to 2018/19 (in million euros)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Broadcasting" .

:YAxis a :Axis ;
    :title "Season" .

:DataPoint1 a :DataPoint ;
    :xValue "299.3" ;
    :yValue "2018/19" ;
    :belongsTo :Chart .

