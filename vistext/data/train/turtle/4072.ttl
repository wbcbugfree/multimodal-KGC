@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Length of the border the U.S. shares with Canada and Mexico , by state (in statute miles)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "State" .

:YAxis a :Axis ;
    :title "Length in statute miles" .

