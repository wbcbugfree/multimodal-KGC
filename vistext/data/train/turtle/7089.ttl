@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "U.S. online shop and mail-order sales of electronics and appliances from 2003 to 2018 (in million U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "E-commerce" .

