@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Los Angeles Angels all-time home run leaders as of October 2020" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Home run leaders" .

:YAxis a :Axis ;
    :title "Number of home runs" .

:DataPoint1 a :DataPoint ;
    :xValue "Mike Trout" ;
    :yValue "302" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Tim Salmon" ;
    :yValue "299" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "Garret Anderson" ;
    :yValue "272" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "Brian Downing" ;
    :yValue "222" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "Albert Pujols" ;
    :yValue "217" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Troy Glaus" ;
    :yValue "182" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Vladimir Guerrero" ;
    :yValue "173" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Chili Davis" ;
    :yValue "156" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "Bobby Grich" ;
    :yValue "154" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "Don Baylor" ;
    :yValue "141" ;
    :belongsTo :Chart .
