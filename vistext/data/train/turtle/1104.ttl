@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Atlanta Braves all-time RBI (runs batted in) leaders as of October 2020" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "players" .

:YAxis a :Axis ;
    :title "Number of home runs" .

:DataPoint1 a :DataPoint ;
    :xValue "Hank Aaron" ;
    :yValue "2202" ;
    :belongsTo :Chart .

