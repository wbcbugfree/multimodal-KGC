@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Leading 10 countries of reported Fairtrade International sales income in 2012 (in million euros)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Sales income in million euros" .

:YAxis a :Axis ;
    :title "Country" .

:DataPoint1 a :DataPoint ;
    :xValue "186.49" ;
    :yValue "Peru" ;
    :belongsTo :Chart .

