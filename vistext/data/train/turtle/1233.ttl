@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Sales of the leading body anti-aging brands in the United States in 2013 (in million U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Sales in million U.S. dollars" .

:YAxis a :Axis ;
    :title "Brand" .

:DataPoint1 a :DataPoint ;
    :xValue "8.6" ;
    :yValue "Lansinoh" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "8.4" ;
    :yValue "Nivea Body Good-Bye Cellulite" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "3" ;
    :yValue "Private label" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "1.9" ;
    :yValue "Medela Tender Care" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "1.3" ;
    :yValue "L'Oréal RevitaLift" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "0.8" ;
    :yValue "Estee Lauder Perfectionist" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "0.7" ;
    :yValue "Vichy CelluDestock" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "0.6" ;
    :yValue "Estee Lauder" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "0.6" ;
    :yValue "The First Years" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "0.4" ;
    :yValue "Nivea" ;
    :belongsTo :Chart .
