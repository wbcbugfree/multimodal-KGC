@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Degree of internet civility according to online users in selected countries as of June 2016 (index ranking)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Country" .

:YAxis a :Axis ;
    :title "Index ranking" .

:DataPoint1 a :DataPoint ;
    :xValue "United Kingdom" ;
    :yValue "45" ;
    :belongsTo :Chart .

