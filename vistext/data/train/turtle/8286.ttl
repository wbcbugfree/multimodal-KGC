@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Number of serious water pollution incidents in the United Kingdom (UK) from 2001 to 2016 , by category" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Catergory 1" .

