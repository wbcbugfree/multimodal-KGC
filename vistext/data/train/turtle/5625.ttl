@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Religion affiliation in the Dominican Republic as of 2018 , by type" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Share of respondents" .

:YAxis a :Axis ;
    :title "Response" .

:DataPoint1 a :DataPoint ;
    :xValue "0.443" ;
    :yValue "Catholic" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "0.095" ;
    :yValue "Evangelist (unspecified)" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "0.079" ;
    :yValue "Protestant" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "0.034" ;
    :yValue "Pentecostal evangelist" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "0.014" ;
    :yValue "Adventist" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "0.007" ;
    :yValue "Jehova's witness" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "0.003" ;
    :yValue "Mormon" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "0.001" ;
    :yValue "Baptist evangelist" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "0.008" ;
    :yValue "Other" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "0.294" ;
    :yValue "None" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "0.002" ;
    :yValue "Atheist" ;
    :belongsTo :Chart .

:DataPoint12 a :DataPoint ;
    :xValue "0.014" ;
    :yValue "Do not know" ;
    :belongsTo :Chart .

:DataPoint13 a :DataPoint ;
    :xValue "0.006" ;
    :yValue "Do not answer" ;
    :belongsTo :Chart .
