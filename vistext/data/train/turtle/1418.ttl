@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Annual percent change of the real GDP in Michigan from 2000 to 2019" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Percent change compared to preceding period" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 1999" ;
    :yValue "0.021" ;
    :belongsTo :Chart .

