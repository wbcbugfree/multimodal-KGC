@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Leading songs in Canada in 2017 , by number of streams (in millions)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Leading songs in Canada" .

:YAxis a :Axis ;
    :title "Number of streams in millions" .

:DataPoint1 a :DataPoint ;
    :xValue "Shape of You - Ed Sheeran" ;
    :yValue "178.54" ;
    :belongsTo :Chart .

