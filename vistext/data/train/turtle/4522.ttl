@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Average ticket price for San Francisco 49ers home games from 2006 to 2019 (in U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Average ticket price in U.S. dollars" .

:DataPoint1 a :DataPoint ;
    :xValue "2019" ;
    :yValue "116.98" ;
    :belongsTo :Chart .

