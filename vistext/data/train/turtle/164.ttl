@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "United States chemical industry production index from 2001 to 2019" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Production index (2012 = 100)" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2000" ;
    :yValue "80.5" ;
    :belongsTo :Chart .

