@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Percent approval for NDA/BLA filings for new drugs in select disease areas in the U.S. between 2006 and 2015" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Ultimately approved" .

:YAxis a :Axis ;
    :title "disease areas" .

:DataPoint1 a :DataPoint ;
    :xValue "0.89" ;
    :yValue "Oncology" ;
    :belongsTo :Chart .

