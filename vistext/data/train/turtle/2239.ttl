@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Cuba : Gross domestic product (GDP) in current U.S. dollars from 2008 to 2018 (in billion U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Gross domestic product in billion U.S. dollars" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2007" ;
    :yValue "60.81" ;
    :belongsTo :Chart .

