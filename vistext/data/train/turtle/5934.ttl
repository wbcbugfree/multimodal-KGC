@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Total population of Spain between 2010 and 2018 and forecast 2019 to 2025 (in millions)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Inhabitants in millions" .

:DataPoint1 a :DataPoint ;
    :xValue "2025*" ;
    :yValue "47.28" ;
    :belongsTo :Chart .

