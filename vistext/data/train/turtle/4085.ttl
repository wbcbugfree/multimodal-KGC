@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "The 20 countries with the lowest fertility rates in 2017" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Number of children per woman" .

:YAxis a :Axis ;
    :title "Country" .

:DataPoint1 a :DataPoint ;
    :xValue "0.83" ;
    :yValue "Singapore" ;
    :belongsTo :Chart .

