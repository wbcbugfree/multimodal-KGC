@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Number of IPTV subscribers in China from 1st quarter 2012 to 4th quarter 2014 (in millions)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "IPTV subscribers in millions" .

:YAxis a :Axis ;
    :title "Quarter" .

:DataPoint1 a :DataPoint ;
    :xValue "33.6" ;
    :yValue "Q4 '14" ;
    :belongsTo :Chart .

