@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Number of hours of sunshine in France in 2018 , by city" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "city in france" .

:YAxis a :Axis ;
    :title "Hours of sunshine" .

