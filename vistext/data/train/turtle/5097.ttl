@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "UK military and civilian fatalities in the Afghanistan War from October 7 , 2001 to March 15 , 2020" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Number of fatalities" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2000" ;
    :yValue "0" ;
    :belongsTo :Chart .

