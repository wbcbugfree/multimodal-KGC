@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Countries with the highest number of reported cases of cholera in 2013" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Country" .

:YAxis a :Axis ;
    :title "Number of reported cases" .

:DataPoint1 a :DataPoint ;
    :xValue "Haiti" ;
    :yValue "58809" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "DC Congo" ;
    :yValue "29644" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "Sierra Leone" ;
    :yValue "23124" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "Somalia" ;
    :yValue "6864" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "Angola" ;
    :yValue "6655" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Nigeria" ;
    :yValue "6600" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "India" ;
    :yValue "6008" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Dominican Republic" ;
    :yValue "1954" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "Mozambique" ;
    :yValue "1869" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "Congo" ;
    :yValue "1624" ;
    :belongsTo :Chart .
