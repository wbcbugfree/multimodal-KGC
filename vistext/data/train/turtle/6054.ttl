@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Iran : Age structure from 2009 to 2019" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Ages 15-64" .

