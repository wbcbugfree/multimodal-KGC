@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Average hours per day spent on leisure and sports in the U.S. sorted by ethnicity from 2009 to 2019" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "White" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2008" ;
    :yValue "5.17" ;
    :belongsTo :Chart .

