@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "GlaxoSmithKline 's operating profit from 2006 to 2019 , by division (in million British pounds)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Consumer Healthcare" .

:DataPoint1 a :DataPoint ;
    :xValue "2019" ;
    :yValue "1874" ;
    :belongsTo :Chart .

