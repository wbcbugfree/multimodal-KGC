@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Number of permanent resident refugees admitted in Canada from 2008 to 2017 , by origin area" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Asia and Pacific" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2007" ;
    :yValue "6383" ;
    :belongsTo :Chart .

