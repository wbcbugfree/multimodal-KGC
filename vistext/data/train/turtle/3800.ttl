@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Number of individuals under the age of majority in youth detention centers in Italy from 2008 to 2019" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Number of individuals" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2007" ;
    :yValue "468" ;
    :belongsTo :Chart .

