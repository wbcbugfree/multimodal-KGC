@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Italy : Employment from 2010 to 2020 (in millions)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Employment in millions" .

:DataPoint1 a :DataPoint ;
    :xValue "2020*" ;
    :yValue "23.35" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "2019*" ;
    :yValue "23.31" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "2018" ;
    :yValue "23.22" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "2017" ;
    :yValue "23.02" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "2016" ;
    :yValue "22.76" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "2015" ;
    :yValue "22.47" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "2014" ;
    :yValue "22.28" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "2013" ;
    :yValue "22.19" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "2012" ;
    :yValue "22.57" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "2011" ;
    :yValue "22.6" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "2010" ;
    :yValue "22.53" ;
    :belongsTo :Chart .
