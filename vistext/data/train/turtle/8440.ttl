@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "U.S. confidence levels in politics , the press , business , public institutions and other organizations in 2020" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Quite a lot" .

:YAxis a :Axis ;
    :title "Response" .

:DataPoint1 a :DataPoint ;
    :xValue "0.32" ;
    :yValue "The military" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "0.37" ;
    :yValue "Small business" ;
    :belongsTo :Chart .

