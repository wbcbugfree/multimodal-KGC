@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Which , if any , of the following organisations would you be most concerned about holding your personal information ?" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "Share of respondents" .

:DataPoint1 a :DataPoint ;
    :xValue "Search engines and social media networks" ;
    :yValue "0.64" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "A company you have dealt with once / infrequently" ;
    :yValue "0.64" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "Online retailers" ;
    :yValue "0.45" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "Supermarkets and highstreet retailers" ;
    :yValue "0.37" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "Supermarkets" ;
    :yValue "0.29" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Utility companies" ;
    :yValue "0.27" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Government departments" ;
    :yValue "0.27" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Your local council" ;
    :yValue "0.24" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "A company you have regular contact with" ;
    :yValue "0.2" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "The police" ;
    :yValue "0.17" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "Your bank" ;
    :yValue "0.15" ;
    :belongsTo :Chart .

:DataPoint12 a :DataPoint ;
    :xValue "Your employers" ;
    :yValue "0.14" ;
    :belongsTo :Chart .

:DataPoint13 a :DataPoint ;
    :xValue "Your local hospital" ;
    :yValue "0.08" ;
    :belongsTo :Chart .

:DataPoint14 a :DataPoint ;
    :xValue "Your school" ;
    :yValue "0.07" ;
    :belongsTo :Chart .
