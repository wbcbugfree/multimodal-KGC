@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Change of teenage marijuana use in U.S. states with medical marijuana laws according to surveys between 1995 and 2015" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "State (Date medical marijuana was legalized)" .

:YAxis a :Axis ;
    :title "Pre-law current use rates" .

:DataPoint1 a :DataPoint ;
    :xValue "Alaska (1998)" ;
    :yValue "0.29" ;
    :belongsTo :Chart .

