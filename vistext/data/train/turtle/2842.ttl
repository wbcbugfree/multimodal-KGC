@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Worldwide deliveries of BMW MINI cars from FY 2007 to FY 2019 (in units)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Deliveries in units" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2005" ;
    :yValue "188077" ;
    :belongsTo :Chart .

