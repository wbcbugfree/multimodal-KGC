    :yValue "709.07" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Huntington Library, Art Collections and Botanical Gardens, San Marino" ;
    :yValue "414.73" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Boston Symphony Orchestra" ;
    :yValue "387.37" ;
    :belongsTo :Chart .

