@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Cultural institutions in the U.S. ranked by size of endowments in 2011 (in million U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Cultural institution" .

:YAxis a :Axis ;
    :title "Endowment (in million U.S. dollars)" .

:DataPoint1 a :DataPoint ;
    :xValue "Metropolitan Museum of Art, New York" ;
    :yValue "2696.75" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Museum of Fine Arts, Houston" ;
    :yValue "1011.09" ;
    :belongsTo :Chart .

