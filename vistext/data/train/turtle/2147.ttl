@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Rate of new liver cancer diagnoses in the U.S. as of 2017 , by age (per 100,000 population)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Rate per 100,000 population" .

:YAxis a :Axis ;
    :title "Year" .

:DataPoint1 a :DataPoint ;
    :xValue "1.3" ;
    :yValue "Less than 1 year" ;
    :belongsTo :Chart .

