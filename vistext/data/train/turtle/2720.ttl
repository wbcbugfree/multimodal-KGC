@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Countries with the most earthquake fatalities 1900 to 2016" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Number of deaths" .

:YAxis a :Axis ;
    :title "Country" .

:DataPoint1 a :DataPoint ;
    :xValue "876487" ;
    :yValue "China" ;
    :belongsTo :Chart .

