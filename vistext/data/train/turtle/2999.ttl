@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Ecolab 's number of employees from 2009 to 2019" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Number of employees" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2008" ;
    :yValue "25931" ;
    :belongsTo :Chart .

