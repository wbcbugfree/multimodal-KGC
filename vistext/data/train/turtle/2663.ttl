@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Total net ingredient cost (NIC) for insulins for diabetes in England from 2005/06 to 2018/19 (in millions GBP)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Net Ingredient Cost in millions GBP" .

:DataPoint1 a :DataPoint ;
    :xValue "2005/06" ;
    :yValue "220.8" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "2006/07" ;
    :yValue "243.7" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "2007/08" ;
    :yValue "267" ;
    :belongsTo :Chart .

