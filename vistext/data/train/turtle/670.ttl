@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Largest electricity generation facilities in the U.S. in 2017 , by summer capacity (in megawatts)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Summer capacity in megawatts" .

:YAxis a :Axis ;
    :title "Plant (state)" .

:DataPoint1 a :DataPoint ;
    :xValue "7079" ;
    :yValue "Grand Coulee (Washington)" ;
    :belongsTo :Chart .

