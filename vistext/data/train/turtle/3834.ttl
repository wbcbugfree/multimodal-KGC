@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Most widespread sexual practices among individuals aged 18 to 40 years in Italy in 2019" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Share of respondents" .

:YAxis a :Axis ;
    :title "Response" .

:DataPoint1 a :DataPoint ;
    :xValue "0.807" ;
    :yValue "Oral sex" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "0.67" ;
    :yValue "Reciprocal masturbation" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "0.612" ;
    :yValue "Watch porno videos alone" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "0.469" ;
    :yValue "Usage of obscene language during sexual intercourse" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "0.375" ;
    :yValue "Sexting (sending pictures on smarthphones with explicit sexual content)" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "0.331" ;
    :yValue "Anal sex" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "0.252" ;
    :yValue "Watch porno videos with the partner" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
