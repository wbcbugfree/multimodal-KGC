@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Number of daily internet users in Great Britain from 2006 to 2020 (in million users)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Internet users in millions" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2005" ;
    :yValue "16.2" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Dec 31, 2006" ;
    :yValue "20.7" ;
    :belongsTo :Chart .

