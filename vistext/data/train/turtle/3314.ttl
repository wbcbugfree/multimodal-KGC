@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Domestic demand of poly propylene glycol in South Korea from 2006 to 2019 (in metric tons)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Domestic demand in metric tons" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2005" ;
    :yValue "253182" ;
    :belongsTo :Chart .

