@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "New England Patriots all-time leaders number of touchdowns scored from 1960 to 2020" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "player name" .

:YAxis a :Axis ;
    :title "Touchdowns scored" .

