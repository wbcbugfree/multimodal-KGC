@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Major countries receiving subsidies for fossil fuels worldwide in 2016 , by fuel type (in million U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Oil" .

:YAxis a :Axis ;
    :title "Country" .

:DataPoint1 a :DataPoint ;
    :xValue "16074.96" ;
    :yValue "Iran" ;
    :belongsTo :Chart .

