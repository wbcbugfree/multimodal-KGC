@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Pet ownership in selected countries in Europe in 2016" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Bird" .

:YAxis a :Axis ;
    :title "Response" .

:DataPoint1 a :DataPoint ;
    :xValue "0.04" ;
    :yValue "United Kingdom" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "0.2" ;
    :yValue "Turkey" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "0.03" ;
    :yValue "Sweden" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "0.11" ;
    :yValue "Spain" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "0.09" ;
    :yValue "Russia" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "0.07" ;
    :yValue "Poland" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "0.07" ;
    :yValue "Netherlands" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "0.08" ;
    :yValue "Belgium" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "0.08" ;
    :yValue "Czech Republic" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "0.05" ;
    :yValue "France" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "0.06" ;
    :yValue "Germany" ;
    :belongsTo :Chart .

:DataPoint12 a :DataPoint ;
    :xValue "0.08" ;
    :yValue "Italy" ;
    :belongsTo :Chart .
