@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Consumption of ice cream per capita in Canada from 2004 to 2016 (in liters)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Consumption in liters" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2003" ;
    :yValue "9.15" ;
    :belongsTo :Chart .

