@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Number of Facebook fans/twitter followers of Orlando Magic (NBA) from 2012 to 2020 (in millions)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Month" .

:YAxis a :Axis ;
    :title "Facebook fans" .

