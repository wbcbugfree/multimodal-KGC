    :xValue "49.54" ;
    :yValue "2012" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "48.53" ;
    :yValue "2011" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "41.22" ;
    :yValue "2010" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "34.21" ;
    :yValue "2009" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
