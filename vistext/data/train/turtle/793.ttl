@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Number of newlyweds in Sweden from 2009 to 2019" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Number of marriages" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2008" ;
    :yValue "97322" ;
    :belongsTo :Chart .

