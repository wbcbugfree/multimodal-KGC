@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Corn for ethanol production in the United States from 2010 to 2025 (in 1,000 metric tons)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Corn in thousand metric tons" .

