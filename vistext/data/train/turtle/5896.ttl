@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Total rice consumption worldwide from 2008/2009 to 2019/2020 (in 1,000 metric tons)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Consumption in thousand metric tons" .

:YAxis a :Axis ;
    :title "Year" .

:DataPoint1 a :DataPoint ;
    :xValue "493126" ;
    :yValue "2019/2020**" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "486622" ;
    :yValue "2018/2019" ;
    :belongsTo :Chart .

