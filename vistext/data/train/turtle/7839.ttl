@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "In the next three months , are you planning to purchase household appliances ?" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Consumer electronics" .

:YAxis a :Axis ;
    :title "Response" .

