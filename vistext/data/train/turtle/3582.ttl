@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Growth in the number of bicycles sold in the European Union (EU) from 2001 to 2016 , (in year-on-year percentage change)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Year-on-year percentage change in sales volume" .

