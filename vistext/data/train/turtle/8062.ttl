@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Number of Facebook fans/twitter followers of the Jacksonville Jaguars (NFL) from 2012 to 2020 (in millions)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Month" .

:YAxis a :Axis ;
    :title "Twitter followers" .

