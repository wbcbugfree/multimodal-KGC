@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Leading paid game titles on Steam in 2017 , by number of units sold (in 1,000s)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "video game" .

:YAxis a :Axis ;
    :title "Number of units in thousands" .

