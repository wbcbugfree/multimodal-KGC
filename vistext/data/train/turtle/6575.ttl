    :xValue "-0.272" ;
    :yValue "2018" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "0.711" ;
    :yValue "2017" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "-0.414" ;
    :yValue "2016" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "-0.298" ;
    :yValue "2015" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "0.172" ;
    :yValue "2014" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "0.157" ;
    :yValue "2013" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "0.105" ;
    :yValue "2012" ;
    :belongsTo :Chart .

:DataPoint12 a :DataPoint ;
    :xValue "-0.185" ;
