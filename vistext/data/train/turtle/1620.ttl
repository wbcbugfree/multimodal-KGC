@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Overweight and obesity rates among female adults in selected Asian countries as of 2013" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "Percentage of women aged 20 years or older" .

:DataPoint1 a :DataPoint ;
    :xValue "Maldives" ;
    :yValue "0.54" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Malaysia" ;
    :yValue "0.486" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "Thailand" ;
    :yValue "0.397" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "Bhutan" ;
    :yValue "0.382" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "Pakistan" ;
    :yValue "0.384" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Singapore" ;
    :yValue "0.325" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Taiwan" ;
    :yValue "0.309" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Indonesia" ;
    :yValue "0.306" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "China" ;
    :yValue "0.274" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "South Korea" ;
    :yValue "0.272" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "India" ;
    :yValue "0.207" ;
    :belongsTo :Chart .

:DataPoint12 a :DataPoint ;
    :xValue "Japan" ;
    :yValue "0.176" ;
    :belongsTo :Chart .
