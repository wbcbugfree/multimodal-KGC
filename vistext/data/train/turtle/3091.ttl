    :belongsTo :Chart .

:DataPoint13 a :DataPoint ;
    :xValue "Fragrances*" ;
    :yValue "2.2" ;
    :belongsTo :Chart .

:DataPoint14 a :DataPoint ;
    :xValue "Laundry detergents" ;
    :yValue "1.9" ;
    :belongsTo :Chart .

:DataPoint15 a :DataPoint ;
    :xValue "Tobacco" ;
    :yValue "1.7" ;
    :belongsTo :Chart .

