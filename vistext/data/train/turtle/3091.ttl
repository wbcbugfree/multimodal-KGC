@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Average number of brands purchased per consumer goods category in the United Kingdom (UK) in 2012" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Goods Category" .

:YAxis a :Axis ;
    :title "Number of brands" .

:DataPoint1 a :DataPoint ;
    :xValue "Chocolate" ;
    :yValue "5.6" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Carbonated drinks" ;
    :yValue "4" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "Frozen food" ;
    :yValue "3.7" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "Breakfast cereals" ;
    :yValue "3.5" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "Clothes*" ;
    :yValue "3.3" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Make-up*" ;
    :yValue "3.3" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Beer" ;
    :yValue "3.3" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
