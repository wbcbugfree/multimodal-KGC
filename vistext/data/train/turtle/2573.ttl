@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Total employment income through wages , salaries , and commissions in Canada from 2000 to 2018 (in billion Canadian dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Employment income in billion Canadian dollars" .

