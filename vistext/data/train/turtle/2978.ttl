@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Net profit of the China Construction Bank from 2008 to 2019 (in billion yuan)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Net profit in billion yuan" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2007" ;
    :yValue "92.6" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Dec 31, 2008" ;
    :yValue "106.8" ;
    :belongsTo :Chart .

