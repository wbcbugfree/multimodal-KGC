@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Leading retailers on Facebook in the United Kingdom (UK) as of 2015 , by number of followers" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Followers in millions" .

:YAxis a :Axis ;
    :title "retailer" .

:DataPoint1 a :DataPoint ;
    :xValue "5.44" ;
    :yValue "Amazon.co.uk" ;
    :belongsTo :Chart .

