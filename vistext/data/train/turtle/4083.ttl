@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Median household income in New York from 1990 to 2019 (in current U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Household income in current U.S. dollars" .

