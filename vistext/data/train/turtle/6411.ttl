@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Average Consumer Price Index for apparel expenditure in the U.S. from 2009 to 2018 , by segment (CPI-U)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Women's and girls' apparel" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2008" ;
    :yValue "108.09" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Dec 31, 2009" ;
    :yValue "107.08" ;
    :belongsTo :Chart .

