@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Total number of active EOR projects in U.S. crude oil production 1990 to 2010" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Number of active EOR projects" .

