@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Suicide figures for the United Kingdom (UK) from 2000 to 2018" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Number of suicides" .

