@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Percentage of adults who have earned a university degree , by country 2007" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Country" .

:YAxis a :Axis ;
    :title "Percent with a university degree" .

