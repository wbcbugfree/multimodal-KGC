@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Distribution of immigrants in reception centers in Italy as of November 2020 , by region" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "Share of immigrants" .

:DataPoint1 a :DataPoint ;
    :xValue "Lombardy" ;
    :yValue "0.13" ;
    :belongsTo :Chart .

