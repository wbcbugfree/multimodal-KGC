@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "State of NPIAS airports in the United States from 2000 to 2019 , by runway pavement conditions" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Fair condition" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 1999" ;
    :yValue "22" ;
    :belongsTo :Chart .

