@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Number of stores of the H & M Group worldwide from 2006 to 2019" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Number of stores" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2005" ;
    :yValue "1345" ;
    :belongsTo :Chart .

