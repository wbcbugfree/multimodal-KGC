@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Volume of Scotch whisky produced in Scotland from 2000 to 2015 (in 1,000 litres)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Volume in thousand litres" .

