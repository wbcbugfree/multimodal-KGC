@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Average annual household expenditures in Prince Edward Island , Canada in 2017 (in Canadian dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Average expenditure in Canadian dollars" .

:YAxis a :Axis ;
    :title "Household Expenditure" .

:DataPoint1 a :DataPoint ;
    :xValue "13846" ;
    :yValue "Shelter" ;
    :belongsTo :Chart .

