@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "The Coca-Cola Company 's net operating revenues worldwide from 2007 to 2019 (in billion U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Revenues in billion U.S. dollars" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2006" ;
    :yValue "28.86" ;
    :belongsTo :Chart .

