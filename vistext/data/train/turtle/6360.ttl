@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Monthly number of passenger visitors at Sydney Airport compared with the previous year in Australia from February to October 2020 , by passenger type (in 1,000s)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Month" .

:YAxis a :Axis ;
    :title "Domestic" .

:DataPoint1 a :DataPoint ;
    :xValue "Jan 31, 2019" ;
    :yValue "2081" ;
    :belongsTo :Chart .

