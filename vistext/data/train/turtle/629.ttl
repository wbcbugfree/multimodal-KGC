@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Main problems faced by companies due to the coronavirus (COVID-19) outbreak in Chile in 2020" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "Share of respondents" .

:DataPoint1 a :DataPoint ;
    :xValue "Sales decrease" ;
    :yValue "0.58" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Work/business activities halt" ;
    :yValue "0.33" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "Risk of insolvency" ;
    :yValue "0.3" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "Absence of workers" ;
    :yValue "0.12" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "Access to credit / debt payment delays" ;
    :yValue "0.11" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Delay in investment plans" ;
    :yValue "0.09" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Staff reduction" ;
    :yValue "0.08" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Customer communication" ;
    :yValue "0.08" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "Workers' salary reduction" ;
    :yValue "0.03" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "Did not answer" ;
    :yValue "0.11" ;
    :belongsTo :Chart .
