@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "U.S. vehicle sales between September 2019 and 2020 , by vehicle type (in 1,000 units)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Month" .

:YAxis a :Axis ;
    :title "Autos" .

