@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Net sales of Sega Sammy Holdings from fiscal 2010 to 2019 , by region (in billion Japanese yen)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Japan" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2009" ;
    :yValue "322.01" ;
    :belongsTo :Chart .

