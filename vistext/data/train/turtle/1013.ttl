@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Cameroon : Total population from 2015 to 2025 (in million inhabitants)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Inhabitants in millions" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2014" ;
    :yValue "23.11" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Dec 31, 2015" ;
    :yValue "23.69" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "Dec 31, 2016" ;
    :yValue "24.28" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "Dec 31, 2017" ;
    :yValue "24.88" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "Dec 31, 2018" ;
    :yValue "25.51" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Dec 31, 2019" ;
    :yValue "26.14" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Dec 31, 2020" ;
    :yValue "26.8" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Dec 31, 2021" ;
    :yValue "27.47" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "Dec 31, 2022" ;
    :yValue "28.15" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "Dec 31, 2023" ;
    :yValue "28.86" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "Dec 31, 2024" ;
    :yValue "29.58" ;
    :belongsTo :Chart .
