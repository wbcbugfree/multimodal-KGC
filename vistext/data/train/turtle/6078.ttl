@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Number of establishments in the advertising and related services industry in the United States from 2007 to 2017 , by sector" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Other services related to advertising" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2006" ;
    :yValue "8441" ;
    :belongsTo :Chart .

