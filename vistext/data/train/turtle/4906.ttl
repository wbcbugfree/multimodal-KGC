@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Advertising spending in Vietnam from 2004 to 2018 (in million U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Spending in million U.S. dollars" .

:DataPoint1 a :DataPoint ;
    :xValue "2018**" ;
    :yValue "1457.5" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "2017**" ;
    :yValue "1331.4" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "2016**" ;
    :yValue "1216.5" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "2015*" ;
    :yValue "1107.6" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "2014*" ;
    :yValue "1000.8" ;
    :belongsTo :Chart .

