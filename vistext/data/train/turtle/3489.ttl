@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Sleeping preferences of hotel visitors from Russia as of December 2013" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Share of respondents" .

:YAxis a :Axis ;
    :title "Response" .

:DataPoint1 a :DataPoint ;
    :xValue "0.29" ;
    :yValue "Bath salts/oils for a soothing bath" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "0.18" ;
    :yValue "Oils for a relaxing scent in the room" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "0.39" ;
    :yValue "Herbal tea" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "0.15" ;
    :yValue "Ear plugs" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "0.2" ;
    :yValue "Music" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "0.15" ;
    :yValue "Eye mask" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "0.17" ;
    :yValue "Guaranteed wakeup call" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "0.12" ;
    :yValue "Comfortable pajamas" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "0.12" ;
    :yValue "Books" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "0.06" ;
    :yValue "White noise machine" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "0.03" ;
    :yValue "Hot water bottle" ;
    :belongsTo :Chart .

:DataPoint12 a :DataPoint ;
    :xValue "0.04" ;
    :yValue "Pillow spray" ;
    :belongsTo :Chart .

:DataPoint13 a :DataPoint ;
    :xValue "0.28" ;
    :yValue "None of the above" ;
    :belongsTo :Chart .
