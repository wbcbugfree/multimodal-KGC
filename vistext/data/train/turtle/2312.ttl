@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Distribution of Eastman Chemical Company 's revenue in 2019 , by target market" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Percentage of revenue" .

:YAxis a :Axis ;
    :title "Response" .

:DataPoint1 a :DataPoint ;
    :xValue "0.21" ;
    :yValue "Transportation" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "0.15" ;
    :yValue "Consumables" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "0.14" ;
    :yValue "Building & construction" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "0.1" ;
    :yValue "Industrial chemicals & processing" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "0.08" ;
    :yValue "Tobacco" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "0.08" ;
    :yValue "Consumer/medical durables" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "0.07" ;
    :yValue "Personal care/health & wellness" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "0.07" ;
    :yValue "Food, feed, & agriculture" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "0.05" ;
    :yValue "Energy, fuels, and water" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "0.02" ;
    :yValue "Electronics" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "0.03" ;
    :yValue "Other" ;
    :belongsTo :Chart .
