@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Breakdown of confirmed cases of COVID-19 in Singapore as of March 2020 , by mode of transmission" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Month" .

:YAxis a :Axis ;
    :title "Imported cases" .

:DataPoint1 a :DataPoint ;
    :xValue "Mar 23" ;
    :yValue "48" ;
    :belongsTo :Chart .

