@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Proportion of young people reading various media outside of class in the United Kingdom (UK) from 2014 to 2019" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "2015" .

:YAxis a :Axis ;
    :title "media read by young people" .

:DataPoint1 a :DataPoint ;
    :xValue "0.701" ;
    :yValue "Text messages" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "0.459" ;
    :yValue "Instant messages" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "0.555" ;
    :yValue "Websites" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "0.498" ;
    :yValue "Social networking" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "0.455" ;
    :yValue "Emails" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "0.431" ;
    :yValue "Lyrics" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "0.443" ;
    :yValue "Fiction" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "0.322" ;
    :yValue "Non-fiction" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "0.259" ;
    :yValue "Newspapers" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "0.431" ;
    :yValue "Magazines" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "0.223" ;
    :yValue "Blogs" ;
    :belongsTo :Chart .

:DataPoint12 a :DataPoint ;
    :xValue "0.263" ;
    :yValue "Comics" ;
    :belongsTo :Chart .

:DataPoint13 a :DataPoint ;
    :xValue "0.174" ;
    :yValue "Poems" ;
    :belongsTo :Chart .

:DataPoint14 a :DataPoint ;
    :xValue "0.169" ;
    :yValue "EAL materials" ;
    :belongsTo :Chart .

:DataPoint15 a :DataPoint ;
    :xValue "0.171" ;
    :yValue "Manuals" ;
    :belongsTo :Chart .

:DataPoint16 a :DataPoint ;
    :xValue "0.139" ;
    :yValue "eBooks" ;
