@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Distribution of lubricant demand in Africa and Middle East in 2007 and 2014 , by country" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "2014" .

:YAxis a :Axis ;
    :title "Country" .

:DataPoint1 a :DataPoint ;
    :xValue "0.1" ;
    :yValue "Egypt" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "0.09" ;
    :yValue "South Africa" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "0.09" ;
    :yValue "Nigeria" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "0.04" ;
    :yValue "Algeria" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "0.03" ;
    :yValue "Morroco" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "0.19" ;
    :yValue "Other Africa" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "0.18" ;
    :yValue "Iran" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "0.1" ;
    :yValue "Saudi Arabia" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "0.05" ;
    :yValue "Iraq" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "0.03" ;
    :yValue "United Arab Emirates" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "0.02" ;
    :yValue "Syria" ;
    :belongsTo :Chart .

:DataPoint12 a :DataPoint ;
    :xValue "0.08" ;
    :yValue "Other Middle East" ;
    :belongsTo :Chart .
