@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Participation rate in sports activities in Flanders (Belgium) from 2008 to 2018" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "Share of the Flemish citizens" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2007" ;
    :yValue "0.56" ;
    :belongsTo :Chart .

