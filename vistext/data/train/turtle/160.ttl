@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Average bentonite price in the U.S. from 2007 to 2019 (in U.S. dollars per ton)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Prices in U.S. dollars per ton" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2006" ;
    :yValue "52" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Dec 31, 2007" ;
    :yValue "49" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "Dec 31, 2008" ;
    :yValue "57" ;
    :belongsTo :Chart .

