@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Highest paid sports commentators on TV and radio worldwide in 2017 (in million U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Sports commentator" .

:YAxis a :Axis ;
    :title "Net worth in million U.S. dollars" .

:DataPoint1 a :DataPoint ;
    :xValue "Jim Rome" ;
    :yValue "75" ;
    :belongsTo :Chart .

