@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Number of Tesla cars sold in Norway from 2009 to 2019" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Units sold" .

:YAxis a :Axis ;
    :title "Year" .

:DataPoint1 a :DataPoint ;
    :xValue "18798" ;
    :yValue "2019" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "8614" ;
    :yValue "2018" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "8460" ;
    :yValue "2017" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "3638" ;
    :yValue "2016*" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "4039" ;
    :yValue "2015" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "4042" ;
    :yValue "2014" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "1986" ;
    :yValue "2013" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "32" ;
    :yValue "2012" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "28" ;
    :yValue "2011" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "14" ;
    :yValue "2010" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "13" ;
    :yValue "2009" ;
    :belongsTo :Chart .
