@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Alzheimer 's disease mortality rate in the United States from 2000 to 2018 (per 100,000 population)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Deaths per 100,000 population" .

