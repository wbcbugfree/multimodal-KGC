@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Market share of numerical control software licenses worldwide in 2013 , by software provider" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "Share of installed seats" .

:DataPoint1 a :DataPoint ;
    :xValue "Vero Software" ;
    :yValue "0.202" ;
    :belongsTo :Chart .

