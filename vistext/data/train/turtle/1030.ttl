@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Length of national highways across Maharashtra in India from financial year 2003 to 2019 (in kilometers)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Highway length in kilometers" .

:YAxis a :Axis ;
    :title "Year" .

