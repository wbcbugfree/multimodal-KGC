@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Beer , wine , and distilled alcoholic beverage purchases of merchant wholesalers in the United States from 2002 to 2018 (in billion U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Purchases in billion U.S. dollars" .

