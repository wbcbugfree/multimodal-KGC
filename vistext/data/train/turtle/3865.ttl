@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Forecasted inflation rate of the Retail Price Index (RPI) in the United Kingdom from 2014 to 2024" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "RPI inflation" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2013" ;
    :yValue "0.024" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Dec 31, 2014" ;
    :yValue "0.01" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "Dec 31, 2015" ;
    :yValue "0.018" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "Dec 31, 2016" ;
    :yValue "0.036" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "Dec 31, 2017" ;
    :yValue "0.033" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Dec 31, 2018" ;
    :yValue "0.028" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Dec 31, 2019" ;
    :yValue "0.012" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Dec 31, 2020" ;
    :yValue "0.026" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "Dec 31, 2021" ;
    :yValue "0.031" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "Dec 31, 2022" ;
    :yValue "0.03" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "Dec 31, 2023" ;
    :yValue "0.029" ;
    :belongsTo :Chart .
