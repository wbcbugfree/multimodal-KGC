    :xValue "11.25" ;
    :yValue "Seoul" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "10.14" ;
    :yValue "Osaka" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "9.89" ;
    :yValue "Phuket" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "9.44" ;
    :yValue "Pattaya" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "8.26" ;
