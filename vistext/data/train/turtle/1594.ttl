@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Number of international overnight visitors in the Asia Pacific region in 2018 , by city (in millions)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Number of visitors in millions" .

:YAxis a :Axis ;
    :title "Country" .

:DataPoint1 a :DataPoint ;
    :xValue "22.78" ;
    :yValue "Bangkok" ;
    :belongsTo :Chart .

