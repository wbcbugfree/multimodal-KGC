@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Total expenditure on health as a percentage of gross domestic product (GDP) in Denmark from 2000 to 2019" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "Percentage of GDP" .

:DataPoint1 a :DataPoint ;
    :xValue "2019**" ;
    :yValue "0.1" ;
    :belongsTo :Chart .

