@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Minimum player salary in Major League Baseball from 2003 to 2020 (in 1,000 U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Salary in thousand U.S. dollars" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2002" ;
    :yValue "300" ;
    :belongsTo :Chart .

