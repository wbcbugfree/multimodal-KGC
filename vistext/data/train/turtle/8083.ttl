@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Capcom 's annual net sales in the fiscal years 2008 to 2020 , by operating segment (in billion yen)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Arcade operations" .

:YAxis a :Axis ;
    :title "Month" .

:DataPoint1 a :DataPoint ;
    :xValue "12.1" ;
    :yValue "April 1, 2019 to March 31, 2020" ;
    :belongsTo :Chart .

