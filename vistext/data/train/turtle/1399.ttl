@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Number of stores of Dollar General in the United States from 2007 to 2019" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Number of stores" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2006" ;
    :yValue "8194" ;
    :belongsTo :Chart .

