@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Leading B2B media and business information companies worldwide in 2016 , by revenue (in million U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "business" .

:YAxis a :Axis ;
    :title "Revenue in million U.S. dollars" .

:DataPoint1 a :DataPoint ;
    :xValue "RELX Group" ;
    :yValue "2280" ;
    :belongsTo :Chart .

