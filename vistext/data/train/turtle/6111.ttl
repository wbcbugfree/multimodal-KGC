@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "North America : Gross domestic product (GDP) of Canada and the United States from 2009 to 2021 (in billion international dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Canada" .

:YAxis a :Axis ;
    :title "Year" .

