    :xValue "42.8" ;
    :yValue "East Asia*" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "40.5" ;
    :yValue "South East Asia**" ;
    :belongsTo :Chart .

