@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Military spending by world region in 2019 (in billion U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Military spending in billion U.S. dollars" .

:YAxis a :Axis ;
    :title "world region" .

:DataPoint1 a :DataPoint ;
    :xValue "754" ;
    :yValue "North America" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "251" ;
    :yValue "Western Europe" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "88.1" ;
    :yValue "South Asia" ;
    :belongsTo :Chart .

