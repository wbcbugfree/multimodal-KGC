@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Average annual player salary in the Scottish Premier League in 2019/20 , by team (in 1,000 U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "association football club" .

:YAxis a :Axis ;
    :title "Average player salary in thousand U.S. dollars" .

