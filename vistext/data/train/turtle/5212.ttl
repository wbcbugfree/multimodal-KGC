@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Production value of office furniture manufacturers in the United States from 1991 to 2015 (in million U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Production in million U.S. dollars" .

