@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Global group net interest income of the British Barclays Group from 2010 to 2019 (in million GBP)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Net interest income in million GBP" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2009" ;
    :yValue "12523" ;
    :belongsTo :Chart .

