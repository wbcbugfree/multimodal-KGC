@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Mobile phone shipments ' share in North America by vendor from 1Q'15 to 1Q'18" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "quarter" .

:YAxis a :Axis ;
    :title "ZTE" .

:DataPoint1 a :DataPoint ;
    :xValue "1Q '18" ;
    :yValue "0.11" ;
    :belongsTo :Chart .

