@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Net profit margin of the top mining companies worldwide from 2002 to 2019" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Net profit margin" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2001" ;
    :yValue "0.06" ;
    :belongsTo :Chart .

