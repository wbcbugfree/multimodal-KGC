@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Value of the leading food exporters worldwide in 2014 , by country (in billion U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Billion U.S. dollars" .

:YAxis a :Axis ;
    :title "Country" .

:DataPoint1 a :DataPoint ;
    :xValue "576" ;
    :yValue "European Union (28)" ;
    :belongsTo :Chart .

