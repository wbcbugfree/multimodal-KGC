@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Job approval ratings for U.S. presidents from 1953 to 2015 , by political party" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Opposing party" .

:YAxis a :Axis ;
    :title "Response" .

:DataPoint1 a :DataPoint ;
    :xValue "0.14" ;
    :yValue "Barack Obama" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "0.23" ;
    :yValue "George W. Bush" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "0.27" ;
    :yValue "Bill Clinton" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "0.44" ;
    :yValue "George H.W. Bush" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "0.31" ;
    :yValue "Ronald Reagan" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "0.3" ;
    :yValue "Jimmy Carter" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "0.36" ;
    :yValue "Gerald Ford" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "0.34" ;
    :yValue "Richard Nixon" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "0.4" ;
    :yValue "Lyndon Johnson" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "0.49" ;
    :yValue "John F. Kennedy" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "0.49" ;
    :yValue "Dwight D. Eisenhower" ;
    :belongsTo :Chart .
