@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Estimated change in GDP in selected countries due to economic crisis in percent" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "2008" .

:YAxis a :Axis ;
    :title "Country" .

