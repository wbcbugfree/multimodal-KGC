@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Botswana : Ratio of government expenditure to gross domestic product (GDP) from 2015 to 2025" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Ratio of government expenditure to GDP" .

:DataPoint1 a :DataPoint ;
    :xValue "2025*" ;
    :yValue "0.308" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "2024*" ;
    :yValue "0.3174" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "2023*" ;
    :yValue "0.3232" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "2022*" ;
    :yValue "0.3319" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "2021*" ;
    :yValue "0.3569" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "2020*" ;
    :yValue "0.3567" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "2019" ;
    :yValue "0.3327" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "2018" ;
    :yValue "0.3246" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "2017" ;
    :yValue "0.3197" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "2016" ;
    :yValue "0.3254" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "2015" ;
    :yValue "0.3575" ;
    :belongsTo :Chart .
