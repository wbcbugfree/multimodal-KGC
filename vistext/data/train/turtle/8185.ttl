@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Week-on-week change in global flight bookings to Brussels after terrorist attacks in March 2016" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Flight searches" .

:YAxis a :Axis ;
    :title "Month" .

:DataPoint1 a :DataPoint ;
    :xValue "-0.06" ;
    :yValue "March 16" ;
    :belongsTo :Chart .

