@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Total U.S. domestic grain use from 2001 to 2020 (in million metric tons)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Domestic use in million metric tons" .

:DataPoint1 a :DataPoint ;
    :xValue "2020**" ;
    :yValue "360.7" ;
    :belongsTo :Chart .

