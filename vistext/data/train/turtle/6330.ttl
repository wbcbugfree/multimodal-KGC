@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Percentage composition of government tax revenue in the United States from 2010 to 2025" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Other" .

:YAxis a :Axis ;
    :title "year" .

:DataPoint1 a :DataPoint ;
    :xValue "0.038" ;
    :yValue "'25*" ;
    :belongsTo :Chart .

