@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Players with most tackles at the Rugby World Cup for the national rugby union team of France as of November 2019" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Tackles in the World Rugby Cup" .

:YAxis a :Axis ;
    :title "Rubgy Player" .

