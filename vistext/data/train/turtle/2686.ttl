@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Leading specialty kitchen storage solutions in the United States in 2019" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Share of respondents" .

:YAxis a :Axis ;
    :title "Response" .

:DataPoint1 a :DataPoint ;
    :xValue "0.63" ;
    :yValue "Pullout waste or recycling cabinets" ;
    :belongsTo :Chart .

