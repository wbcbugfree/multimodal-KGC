@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Total number of births , deaths and birth excess in the Netherlands from 2008 to 2018" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Deaths" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2007" ;
    :yValue "135136" ;
    :belongsTo :Chart .

