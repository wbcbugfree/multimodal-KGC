@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Percentage of dedicated biotech companies in selected countries in 2014 , by application" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Country" .

:YAxis a :Axis ;
    :title "Natural resources" .

:DataPoint1 a :DataPoint ;
    :xValue "Korea" ;
    :yValue "0" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Portugal" ;
    :yValue "0.025" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "Poland" ;
    :yValue "0.087" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "Belgium" ;
    :yValue "0" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "Germany" ;
    :yValue "0.01" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Estonia" ;
    :yValue "0.04" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Italy" ;
    :yValue "0" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Israel" ;
    :yValue "0.015" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "Austria" ;
    :yValue "0" ;
    :belongsTo :Chart .
