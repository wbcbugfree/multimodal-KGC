    :xValue "3.23" ;
    :yValue "British Airways" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "2.66" ;
    :yValue "Next" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "2.64" ;
    :yValue "Tesco" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "2.57" ;
    :yValue "SportsDirect.com" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "2.37" ;
    :yValue "Cadbury Creme Egg" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
