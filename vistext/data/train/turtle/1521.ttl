@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Most popular brand pages on Facebook in the United Kingdom (UK) as of March 2020 (in million local fans)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Local fans in millions" .

:YAxis a :Axis ;
    :title "Brand page" .

:DataPoint1 a :DataPoint ;
    :xValue "5.73" ;
    :yValue "Amazon UK" ;
    :belongsTo :Chart .

