@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Net revenue of lululemon worldwide from 2010 to 2019 , by channel (in million U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Segment" .

:YAxis a :Axis ;
    :title "Direct to consumer" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2009" ;
    :yValue "57.35" ;
    :belongsTo :Chart .

