@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Growth of international deep sea shipping lane imports and exports in the United Kingdom (UK) in 2013 , by global region" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Exports from UK" .

:YAxis a :Axis ;
    :title "Country" .

:DataPoint1 a :DataPoint ;
    :xValue "0.39" ;
    :yValue "North America" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "0.2" ;
    :yValue "South America" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "0.27" ;
    :yValue "Scandinavia" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "0.32" ;
    :yValue "Western Europe" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "-0.05" ;
    :yValue "Mediterranean" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "0.33" ;
    :yValue "Africa" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "0.42" ;
    :yValue "Eastern Europe" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "0.46" ;
    :yValue "Middle East" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "0.19" ;
    :yValue "Indian subcontinent" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "0.36" ;
    :yValue "Far East" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "0.45" ;
    :yValue "Australia" ;
    :belongsTo :Chart .
