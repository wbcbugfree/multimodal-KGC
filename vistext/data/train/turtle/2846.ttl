@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Annual domestic consumption of sour cream in the United States from 2000 to 2019 (in million pounds)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Consumption in million pounds" .

