@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Average price of jet boats in the U.S. from 2000 to 2013 (in U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Average price in U.S. dollars" .

