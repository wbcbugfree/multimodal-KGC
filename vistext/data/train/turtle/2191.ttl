@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Net migration in Luxembourg from 2008 to 2019" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Surplus of migration" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2007" ;
    :yValue "7700" ;
    :belongsTo :Chart .

