@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Number of undergraduate students enrolled in the United States from 1976 to 2018 , by ethnicity (in 1,000s)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Hispanic" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 1975" ;
    :yValue "352.9" ;
    :belongsTo :Chart .

