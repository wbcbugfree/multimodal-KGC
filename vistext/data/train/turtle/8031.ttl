@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Number of multiple births in Russia from 1960 to 2018 , by count" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Twin birth" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 1959" ;
    :yValue "32126" ;
    :belongsTo :Chart .

