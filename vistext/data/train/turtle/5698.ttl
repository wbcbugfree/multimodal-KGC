@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Biomass energy consumption in the United States from 2006 to 2019 (in trillion British thermal units)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Consumption in trillion Btu" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2005" ;
    :yValue "3262" ;
    :belongsTo :Chart .

