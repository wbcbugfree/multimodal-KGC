@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Total sales value of Christmas markets in Europe in 2014 , by country (in million GBP)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Sales in million GBP" .

:YAxis a :Axis ;
    :title "Country" .

