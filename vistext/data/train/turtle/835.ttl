@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Annual volume of pineapple sold in the United Kingdom (UK) from 2008 to 2018 (in 1,000 tonnes)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Sales volume in thousand tonnes" .

:DataPoint1 a :DataPoint ;
    :xValue "2018*" ;
    :yValue "30.9" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "2017*" ;
    :yValue "32" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "2016*" ;
    :yValue "33.2" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "2015 *" ;
    :yValue "34.4" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "2014 *" ;
    :yValue "35.7" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "2013" ;
    :yValue "37.2" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "2012" ;
    :yValue "38.8" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "2011" ;
    :yValue "40.5" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "2010" ;
    :yValue "41.9" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "2009" ;
    :yValue "42.6" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "2008" ;
    :yValue "43" ;
    :belongsTo :Chart .
