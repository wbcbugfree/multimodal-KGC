@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Monthly sales of luggage at large retailers in Canada from January 2015 to April 2019 (in million Canadian dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Month" .

:YAxis a :Axis ;
    :title "2015" .

