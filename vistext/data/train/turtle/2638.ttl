@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Total square feet of selling space of the Kohl 's Corporation from 2010 to 2019 (in 1,000s)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Total square feet of selling space in thousands" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2009" ;
    :yValue "80139" ;
    :belongsTo :Chart .

