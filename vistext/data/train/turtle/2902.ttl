@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Countries with the highest growth of WhatsApp downloads from the Google Play store as of 3rd quarter 2020" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Country" .

:YAxis a :Axis ;
    :title "Growth compared to previous quarter" .

:DataPoint1 a :DataPoint ;
    :xValue "Japan" ;
    :yValue "1.411" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Vietnam" ;
    :yValue "0.574" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "Singapore" ;
    :yValue "0.35" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "South Korea" ;
    :yValue "0.306" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "Thailand" ;
    :yValue "0.269" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "South Africa" ;
    :yValue "0.115" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Philippines" ;
    :yValue "0.09" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Venezuela" ;
    :yValue "0.054" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "Nigeria" ;
    :yValue "0.031" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "Australia" ;
    :yValue "-0.021" ;
    :belongsTo :Chart .
