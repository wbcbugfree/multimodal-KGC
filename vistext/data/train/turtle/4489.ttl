@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Internet penetration rate in Japan from 2000 to 2018" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "Percentage of individuals using internet" .

