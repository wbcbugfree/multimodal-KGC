@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Average penetration rate of soft drink brand in India in 2012 and 2013" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Brand" .

:YAxis a :Axis ;
    :title "2012" .

:DataPoint1 a :DataPoint ;
    :xValue "Sprit" ;
    :yValue "0.48" ;
    :belongsTo :Chart .

