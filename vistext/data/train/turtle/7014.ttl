@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Length of time respondents think the coronavirus (COVID-19) outbreak will last in their country , worldwide as of March 12 , 2020 , by country" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Up to a year" .

:YAxis a :Axis ;
    :title "1-2 weeks" .

:DataPoint1 a :DataPoint ;
    :xValue "0.074" ;
    :yValue "0.1" ;
    :belongsTo :Chart .

