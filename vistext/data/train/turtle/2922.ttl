@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Trade union density : percentage of employees that were members of a trade union in Italy from 2000 to 2013" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "Percentage of employees" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 1999" ;
    :yValue "0.348" ;
    :belongsTo :Chart .

