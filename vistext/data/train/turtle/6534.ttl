@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Total U.S. beef and veal imports and exports from 2006 to 2019 (in million pounds)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Exports" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2005" ;
    :yValue "1145" ;
    :belongsTo :Chart .

