@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Most registered female baby names in England in 2019" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Number of newly registered names" .

:YAxis a :Axis ;
    :title "female name" .

:DataPoint1 a :DataPoint ;
    :xValue "3866" ;
    :yValue "Olivia" ;
    :belongsTo :Chart .

