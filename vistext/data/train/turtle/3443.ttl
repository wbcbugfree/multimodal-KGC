@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "CBS Corporation 's entertainment segment revenue from 2008 to 2018 (in million U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Revenue in million U.S. dollars" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2007" ;
    :yValue "6879" ;
    :belongsTo :Chart .

