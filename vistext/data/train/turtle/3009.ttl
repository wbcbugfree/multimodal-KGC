@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "United Kingdom 's share of cross-border bank lending in international financial markets from 1992 to 2016" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "UK's share" .

