@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Export value of furniture worldwide from 2003 to 2018 (in billion U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Export value in billion U.S. dollars" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2002" ;
    :yValue "76.1" ;
    :belongsTo :Chart .

