@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Number of tourists in South Africa from 2012 to 2023 (in millions)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Number of tourists in millions" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2011" ;
    :yValue "14.16" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Dec 31, 2012" ;
    :yValue "14.62" ;
    :belongsTo :Chart .

