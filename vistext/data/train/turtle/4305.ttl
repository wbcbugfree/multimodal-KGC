@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Pineapple production in the United States from 2002 to 2018 (in 1,000 metric tons)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Production in thousand metric tonnes" .

