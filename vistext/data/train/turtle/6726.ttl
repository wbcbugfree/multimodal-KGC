@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Box office revenue of the X-Men movie series in North America and worldwide as of 2020 , by movie (in million U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "the X-Men movie series" .

:YAxis a :Axis ;
    :title "Worldwide" .

