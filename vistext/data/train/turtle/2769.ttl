@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Change in U.S. commercial air carriers ' available seat mile (ASM) capacity for Latin American flights from 2011 to 2040" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Annual growth" .

:YAxis a :Axis ;
    :title "Year" .

:DataPoint1 a :DataPoint ;
    :xValue "0.04" ;
    :yValue "2020-2040* **" ;
    :belongsTo :Chart .

