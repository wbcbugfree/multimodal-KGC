@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Share of retail revenue from foreign operations of the world 's 250 leading retailers from 2009 to 2018 , by product sector" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Product sector" .

:YAxis a :Axis ;
    :title "Hardlines and leisure goods" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2008" ;
    :yValue "0.248" ;
    :belongsTo :Chart .

