@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Pharmaceutical sales by top 10 therapeutic areas worldwide in 2009 (in billion U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Therapeutic areas" .

:YAxis a :Axis ;
    :title "Sales in billion U.S. dollars" .

:DataPoint1 a :DataPoint ;
    :xValue "Oncologics" ;
    :yValue "52.37" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Lipid Regulators" ;
    :yValue "35.28" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "Respiratory Agents" ;
    :yValue "33.6" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "Antidiabetics" ;
    :yValue "30.41" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "Anti-ulcerants" ;
    :yValue "29.61" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Antiotensin II Antagonists" ;
    :yValue "25.21" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Antipsychotics" ;
    :yValue "23.25" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Antidepressants" ;
    :yValue "19.42" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "AutoImmune agents" ;
    :yValue "17.96" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "Platelet Aggr. Inhibitors" ;
    :yValue "14.6" ;
    :belongsTo :Chart .
