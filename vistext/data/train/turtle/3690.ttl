@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Did you have trouble to buy food for you or your family in the last 12 months ? (by state , United States , 2012)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "State" .

:YAxis a :Axis ;
    :title "Share of respondents answering yes" .

:DataPoint1 a :DataPoint ;
    :xValue "Mississippi" ;
    :yValue "0.249" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Alabama" ;
    :yValue "0.229" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "Delaware" ;
    :yValue "0.221" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "Georgia" ;
    :yValue "0.216" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "Nevada" ;
    :yValue "0.215" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Arkansas" ;
    :yValue "0.215" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Oklahoma" ;
    :yValue "0.214" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Tennessee" ;
    :yValue "0.213" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "West Virginia" ;
    :yValue "0.209" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "Louisiana" ;
    :yValue "0.207" ;
    :belongsTo :Chart .
