@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Total population of Argentina from 2008 to 2018 , by gender (in million inhabitants)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Male" .

:YAxis a :Axis ;
    :title "Total" .

