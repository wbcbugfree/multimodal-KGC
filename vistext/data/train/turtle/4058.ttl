@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Fashion websites ranked by share of paid search voice in the United Kingdom (UK) in February 2016" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "Share of paid search voice**" .

:DataPoint1 a :DataPoint ;
    :xValue "amazon.co.uk" ;
    :yValue "0.57" ;
    :belongsTo :Chart .

