@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Annual youth unemployment rate in Italy from 2004 to 2020" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Unemployment rate" .

:YAxis a :Axis ;
    :title "Year" .

:DataPoint1 a :DataPoint ;
    :xValue "0.235" ;
    :yValue "2004" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "0.241" ;
    :yValue "2005" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "0.218" ;
    :yValue "2006" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "0.204" ;
    :yValue "2007" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "0.212" ;
    :yValue "2008" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "0.253" ;
    :yValue "2009" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "0.279" ;
    :yValue "2010" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "0.292" ;
    :yValue "2011" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "0.353" ;
    :yValue "2012" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "0.4" ;
    :yValue "2013" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "0.427" ;
    :yValue "2014" ;
    :belongsTo :Chart .

:DataPoint12 a :DataPoint ;
    :xValue "0.403" ;
    :yValue "2015" ;
    :belongsTo :Chart .

:DataPoint13 a :DataPoint ;
    :xValue "0.378" ;
    :yValue "2016" ;
    :belongsTo :Chart .

:DataPoint14 a :DataPoint ;
    :xValue "0.347" ;
    :yValue "2017" ;
    :belongsTo :Chart .

:DataPoint15 a :DataPoint ;
    :xValue "0.322" ;
    :yValue "2018" ;
    :belongsTo :Chart .

:DataPoint16 a :DataPoint ;
    :xValue "0.289" ;
    :yValue "2019" ;
    :belongsTo :Chart .

:DataPoint17 a :DataPoint ;
    :xValue "0.311" ;
    :yValue "2020*" ;
