@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Transaction value of mergers and acquisitions in the U.S. healthcare and life sciences industry from 2009 to 2020 (in billion U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Value of transactions in billion U.S. dollars" .

:YAxis a :Axis ;
    :title "Year" .

:DataPoint1 a :DataPoint ;
    :xValue "21.501" ;
    :yValue "2020" ;
    :belongsTo :Chart .

