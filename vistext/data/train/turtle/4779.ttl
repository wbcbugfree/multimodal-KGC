@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Number of tourist visits from China to the United Kingdom (UK) from 2005 to 2019 (in 1,000s)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Number of visits in thousands" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2004" ;
    :yValue "95" ;
    :belongsTo :Chart .

