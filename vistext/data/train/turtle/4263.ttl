@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "World production of lead from 2006 to 2018 (in 1,000 metric tons)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Production in thousand metric tons" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2005" ;
    :yValue "8108" ;
    :belongsTo :Chart .

