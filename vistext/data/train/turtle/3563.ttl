@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Average amount of most used materials in a smartphone since 2007 (in grams per smartphone)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "common materials used in a smartphone" .

:YAxis a :Axis ;
    :title "Content in grams per smartphone" .

:DataPoint1 a :DataPoint ;
    :xValue "Aluminium (case)" ;
    :yValue "22.18" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Copper (wiring)" ;
    :yValue "15.12" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "Plastics (case)" ;
    :yValue "9.53" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "Cobalt (battery)" ;
    :yValue "5.38" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "Tungsten (vibration)" ;
    :yValue "0.44" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Silver (solder, PCB*)" ;
    :yValue "0.31" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Neodymium (speaker magnet)" ;
    :yValue "0.05" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Gold (PCB)" ;
    :yValue "0.03" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "Indium (display)" ;
    :yValue "0.01" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "Palladium (PCB)" ;
    :yValue "0.01" ;
    :belongsTo :Chart .
