@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Gross weight of the iron ore production worldwide from 2006 to 2019 (in 1,000 metric tons)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Gross weight production in thousand metric tons" .

:YAxis a :Axis ;
    :title "Year" .

:DataPoint1 a :DataPoint ;
    :xValue "2500000" ;
    :yValue "2019**" ;
    :belongsTo :Chart .

