@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Distribution of gross domestic product of British Columbia , Canada in 2019 , by industry" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Share of GDP" .

:YAxis a :Axis ;
    :title "Response" .

:DataPoint1 a :DataPoint ;
    :xValue "0.1763" ;
    :yValue "Real estate and rental and leasing" ;
    :belongsTo :Chart .

