@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Share of Gen C online users in selected countries who create online content as least once per month as of Summer 2013" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Share of Gen C who create content" .

:YAxis a :Axis ;
    :title "Response" .

:DataPoint1 a :DataPoint ;
    :xValue "0.99" ;
    :yValue "Poland" ;
    :belongsTo :Chart .

