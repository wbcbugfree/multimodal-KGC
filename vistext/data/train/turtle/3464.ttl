@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Percentage of employees represented by unions in the United States from 2000 to 2019" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Representation rate" .

:YAxis a :Axis ;
    :title "year" .

:DataPoint1 a :DataPoint ;
    :xValue "0.116" ;
    :yValue "'19" ;
    :belongsTo :Chart .

