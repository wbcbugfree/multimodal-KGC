@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Percentage of spending going on food and non-alcoholic beverages in low income households in the United Kingdom (UK) from 2003 to 2018" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "Share of weekly spending" .

:DataPoint1 a :DataPoint ;
    :xValue "Mar 31, 2003" ;
    :yValue "0.163" ;
    :belongsTo :Chart .

