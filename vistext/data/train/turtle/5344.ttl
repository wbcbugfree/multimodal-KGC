@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Desktop PC penetration in the United Kingdom (UK) from 2009 to 2020" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "Percentage of population" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2008" ;
    :yValue "0.56" ;
    :belongsTo :Chart .

