@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Revenue of Johnson & Johnson 's consumer healthcare segment worldwide from 2012 to 2024 , by product category (in billion U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Other consumer healthcare" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2011" ;
    :yValue "4.22" ;
    :belongsTo :Chart .

