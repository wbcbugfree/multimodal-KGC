@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Year-on-year evolution of the nominal Gross Domestic Product (GDP) in France from 2000 to 2018 (in percent)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Evolution of the GDP" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 1999" ;
    :yValue "0.039" ;
    :belongsTo :Chart .

