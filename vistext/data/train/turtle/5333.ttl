@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Germany : Gross domestic product (GDP) from 2009 to 2019 (in billion euros)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "GDP in billion euros" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2008" ;
    :yValue "2445.73" ;
    :belongsTo :Chart .

