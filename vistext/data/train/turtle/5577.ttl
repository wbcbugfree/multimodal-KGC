@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Total motor claims frequency in the United Kingdom (UK) from 2002 to 2016" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Motor insurance claims ratio" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2001" ;
    :yValue "0.208" ;
    :belongsTo :Chart .

