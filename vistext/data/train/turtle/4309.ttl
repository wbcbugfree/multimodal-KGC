@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Average age of the population in Italy in 2020 , by region" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "region of Italy" .

:YAxis a :Axis ;
    :title "Average age in years" .

