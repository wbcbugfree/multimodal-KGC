@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Renewable energy production and consumption in the United States from 1975 to 2020 (in trillion British thermal units)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Total production*" .

:DataPoint1 a :DataPoint ;
    :xValue "2020**" ;
    :yValue "6002" ;
    :belongsTo :Chart .

