@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Number of passenger cars and commercial vehicles in use worldwide from 2006 to 2015 in (1,000 units)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Passenger cars" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2005" ;
    :yValue "679154" ;
    :belongsTo :Chart .

