@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Freight traffic in China from 1980 to 2018 by transport carrier (in million metric tons)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Air" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 1979" ;
    :yValue "0.09" ;
    :belongsTo :Chart .

