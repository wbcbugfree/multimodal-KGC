@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Revenue of Sonic Corporation in the United States from 2009 to 2018 (in million U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Revenue in million U.S. dollars" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2008" ;
    :yValue "706.28" ;
    :belongsTo :Chart .

