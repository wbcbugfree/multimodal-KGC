@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Leading countries downloading `` Game of Thrones '' TV show illegally as of April 2015 , by number of BitTorrent downloads" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Number of downloads" .

:YAxis a :Axis ;
    :title "Country" .

:DataPoint1 a :DataPoint ;
    :xValue "935990" ;
    :yValue "Brazil" ;
