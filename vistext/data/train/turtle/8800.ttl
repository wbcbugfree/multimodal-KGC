:DataPoint13 a :DataPoint ;
    :xValue "Dec 31, 2016" ;
    :yValue "76" ;
    :belongsTo :Chart .

:DataPoint14 a :DataPoint ;
    :xValue "Dec 31, 2017" ;
    :yValue "77" ;
    :belongsTo :Chart .

:DataPoint15 a :DataPoint ;
    :xValue "Dec 31, 2018" ;
    :yValue "74" ;
