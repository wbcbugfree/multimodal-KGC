    :xValue "Dec 31, 2009" ;
    :yValue "85" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Dec 31, 2010" ;
    :yValue "81" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Dec 31, 2011" ;
    :yValue "82" ;
