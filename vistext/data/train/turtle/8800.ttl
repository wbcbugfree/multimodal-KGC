@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Birth rate in the United States from 2005 to 2019 , by poverty status" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Income below poverty level" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2004" ;
    :yValue "95" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Dec 31, 2005" ;
    :yValue "91" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "Dec 31, 2006" ;
    :yValue "92" ;
    :belongsTo :Chart .

