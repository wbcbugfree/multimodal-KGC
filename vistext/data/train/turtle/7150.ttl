@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Japan : Distribution of gross domestic product (GDP) across economic sectors from 2008 to 2018" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Industry" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2007" ;
    :yValue "0.2901" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Dec 31, 2008" ;
    :yValue "0.2727" ;
    :belongsTo :Chart .

