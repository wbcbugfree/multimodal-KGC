@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Oman : Fertility rate from 2008 to 2018" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Number of children born per woman" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2007" ;
    :yValue "2.87" ;
    :belongsTo :Chart .

