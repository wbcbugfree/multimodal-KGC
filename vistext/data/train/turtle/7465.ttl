    :yValue "10.95" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Dec 31, 2014" ;
    :yValue "19.67" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
