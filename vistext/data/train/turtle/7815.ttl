@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Average number of cash and card transactions per person per day in the Euro Area in 2016 , by country" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Cash" .

:YAxis a :Axis ;
    :title "Response" .

:DataPoint1 a :DataPoint ;
    :xValue "1.7" ;
    :yValue "Italy" ;
    :belongsTo :Chart .

