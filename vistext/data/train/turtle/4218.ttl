@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Number of nurses in registered nursing in Canada in 2019 , by province" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Number of nurses" .

:YAxis a :Axis ;
    :title "province of Canada" .

:DataPoint1 a :DataPoint ;
    :xValue "103877" ;
    :yValue "Ontario" ;
    :belongsTo :Chart .

