@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Leading U.S. passenger airlines by number of full-time equivalent employees in December 2019 (in 1,000s)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Employees in thousands" .

:YAxis a :Axis ;
    :title "Airline" .

:DataPoint1 a :DataPoint ;
    :xValue "101.45" ;
    :yValue "American" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "85.6" ;
    :yValue "United" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "85.12" ;
    :yValue "Delta" ;
    :belongsTo :Chart .

