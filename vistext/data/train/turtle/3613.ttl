    :xValue "60.77" ;
    :yValue "Southwest" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "19.07" ;
    :yValue "JetBlue" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "16.99" ;
    :yValue "Alaska" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "15.6" ;
    :yValue "SkyWest" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "14.69" ;
    :yValue "Envoy" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "8.8" ;
