@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Number of passenger cars sold in the Netherlands from 2010 to 2019" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Number of cars sold" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2009" ;
    :yValue "483168" ;
    :belongsTo :Chart .

