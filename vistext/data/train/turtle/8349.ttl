@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Number of deaths in Belgium from 2006 to 2016 , by cause of death" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Death by natural causes" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2005" ;
    :yValue "93793" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Dec 31, 2006" ;
    :yValue "94978" ;
    :belongsTo :Chart .

