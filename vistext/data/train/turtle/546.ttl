@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Monthly inflation rate in the European Union 28 from January to December 2018 (HICP compared to same month in the previous year)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Month" .

:YAxis a :Axis ;
    :title "Growth rate of HICP" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec '18" ;
    :yValue "0.017" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Nov '18" ;
    :yValue "0.02" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "Oct '18" ;
    :yValue "0.022" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "Sep '18" ;
    :yValue "0.021" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "Aug '18" ;
    :yValue "0.022" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Jul '18" ;
    :yValue "0.022" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Jun '18" ;
    :yValue "0.021" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "May '18" ;
    :yValue "0.02" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "Apr '18" ;
    :yValue "0.015" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "Mar '18" ;
    :yValue "0.015" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "Feb '18" ;
    :yValue "0.014" ;
    :belongsTo :Chart .

:DataPoint12 a :DataPoint ;
    :xValue "Jan '18" ;
    :yValue "0.016" ;
    :belongsTo :Chart .
