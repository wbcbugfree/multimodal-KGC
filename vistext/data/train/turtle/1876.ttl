@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Height of the tallest completed skyscrapers in China , as of November 2019 (in meters)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Chinese Skyscrapper" .

:YAxis a :Axis ;
    :title "Height in meters" .

:DataPoint1 a :DataPoint ;
    :xValue "Shanghai Tower" ;
    :yValue "632" ;
    :belongsTo :Chart .

