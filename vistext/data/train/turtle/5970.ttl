@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Which fast food (quick service) restaurants do you go to , if any ?" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "Share of respondents" .

:DataPoint1 a :DataPoint ;
    :xValue "McDonald's" ;
    :yValue "0.57" ;
    :belongsTo :Chart .

