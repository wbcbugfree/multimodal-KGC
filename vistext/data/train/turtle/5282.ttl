@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Total volume of wine produced in Portugal from 2006 to 2018 (in million hectoliters)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Thousands of hectoliters" .

:YAxis a :Axis ;
    :title "Year" .

:DataPoint1 a :DataPoint ;
    :xValue "6.1" ;
    :yValue "2018**" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "6.7" ;
    :yValue "2017*" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "6" ;
    :yValue "2016" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "7" ;
    :yValue "2015" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "6.2" ;
    :yValue "2014" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "6.2" ;
    :yValue "2013" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "6.3" ;
    :yValue "2012" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "5.6" ;
    :yValue "2011" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "7.13" ;
    :yValue "2010" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "5.87" ;
    :yValue "2009" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "5.69" ;
    :yValue "2008" ;
    :belongsTo :Chart .

:DataPoint12 a :DataPoint ;
    :xValue "6.07" ;
    :yValue "2007" ;
    :belongsTo :Chart .

:DataPoint13 a :DataPoint ;
    :xValue "7.54" ;
    :yValue "2006" ;
    :belongsTo :Chart .
