@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Ranking of most successful film releases of 2020 in Russia as of December 8 , 2020 , by first weekend box office revenue (in million Russian rubles)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Revenue in million Russian rubles" .

:YAxis a :Axis ;
    :title "film" .

:DataPoint1 a :DataPoint ;
    :xValue "610" ;
    :yValue "Ice 2" ;
    :belongsTo :Chart .

