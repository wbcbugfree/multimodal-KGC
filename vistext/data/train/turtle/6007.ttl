    :yValue "80100" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Dec 31, 2014" ;
    :yValue "87900" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
