    :yValue "99400" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Dec 31, 2012" ;
    :yValue "94600" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
