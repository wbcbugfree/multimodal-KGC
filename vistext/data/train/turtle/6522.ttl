@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "IBM 's global revenue from 2010 to 2019 , by business segment (in billion U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "Global Business Services" .

:DataPoint1 a :DataPoint ;
    :xValue "2019" ;
    :yValue "16.63" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "2018*" ;
    :yValue "16.6" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "2017" ;
    :yValue "16.35" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "2016" ;
    :yValue "16.7" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "2015" ;
    :yValue "17.16" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "2014" ;
    :yValue "17.8" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "2013" ;
    :yValue "18.4" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "2012" ;
    :yValue "18.57" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "2011" ;
    :yValue "19.28" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "2010" ;
    :yValue "18.22" ;
    :belongsTo :Chart .
