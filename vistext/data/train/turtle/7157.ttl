@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Percentage of respondents worldwide who were concerned about the COVID-19 situation in their country as of March 12 , 2020 , by country" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "A little concerned" .

:DataPoint1 a :DataPoint ;
    :xValue "All" ;
    :yValue "0.26" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Australia" ;
    :yValue "0.21" ;
    :belongsTo :Chart .

