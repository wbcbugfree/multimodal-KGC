@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Area of corn for grain harvested in Canada from 2008 to 2020 (in million hectares)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Area in million hectares" .

:YAxis a :Axis ;
    :title "Year" .

:DataPoint1 a :DataPoint ;
    :xValue "1.4" ;
    :yValue "2020*" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "1.45" ;
    :yValue "2019" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "1.43" ;
    :yValue "2018" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "1.41" ;
    :yValue "2017" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "1.41" ;
    :yValue "2016" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "1.34" ;
    :yValue "2015" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "1.25" ;
    :yValue "2014" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "1.49" ;
    :yValue "2013" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "1.43" ;
    :yValue "2012" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "1.27" ;
    :yValue "2011" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "1.24" ;
    :yValue "2010" ;
    :belongsTo :Chart .

:DataPoint12 a :DataPoint ;
    :xValue "1.17" ;
    :yValue "2009" ;
    :belongsTo :Chart .

:DataPoint13 a :DataPoint ;
    :xValue "1.17" ;
    :yValue "2008" ;
    :belongsTo :Chart .
