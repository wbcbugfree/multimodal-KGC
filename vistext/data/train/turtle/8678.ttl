@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Patients profile of coronavirus disease (COVID-19) cases in Japan as of December 2020 , by age group" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Number of deaths" .

:YAxis a :Axis ;
    :title "Year" .

:DataPoint1 a :DataPoint ;
    :xValue "1172" ;
    :yValue "80 years and older" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "517" ;
    :yValue "70 to 79 years" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "183" ;
    :yValue "60 to 69 years" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "64" ;
    :yValue "50 to 59 years" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "22" ;
    :yValue "40 to 49 years" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "6" ;
    :yValue "30 to 39 years" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "2" ;
    :yValue "20 to 29 years" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "0" ;
    :yValue "10 to 19 years" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "0" ;
    :yValue "9 years and younger" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "7" ;
    :yValue "Age unknown" ;
    :belongsTo :Chart .
