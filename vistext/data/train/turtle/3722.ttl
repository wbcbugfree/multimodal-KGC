@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Top 20 industries in the U.S. with largest projected payroll employment declines from 2018 to 2028 (in 1,000)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Industry" .

:YAxis a :Axis ;
    :title "Employment change in thousands" .

:DataPoint1 a :DataPoint ;
