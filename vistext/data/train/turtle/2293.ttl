@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Market share of European investment funds in 2018 , by country of domicile" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Country" .

:YAxis a :Axis ;
    :title "Market share" .

:DataPoint1 a :DataPoint ;
    :xValue "Luxembourg" ;
    :yValue "0.27" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Ireland" ;
    :yValue "0.16" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "Germany" ;
    :yValue "0.13" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "France" ;
    :yValue "0.12" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "United Kingdom" ;
    :yValue "0.1" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Netherlands" ;
    :yValue "0.05" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Switzerland" ;
    :yValue "0.04" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Italy" ;
    :yValue "0.02" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "Sweden" ;
    :yValue "0.02" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "Spain" ;
    :yValue "0.02" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "Rest of Europe" ;
    :yValue "0.07" ;
    :belongsTo :Chart .
