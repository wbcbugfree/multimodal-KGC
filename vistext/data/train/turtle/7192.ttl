@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Global revenue of the Unilever Group from 2005 to 2019 , by product segment (in million euros)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Product segment" .

:YAxis a :Axis ;
    :title "Personal care" .

