@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Number of soft drink and ice manufacturing establishments in Canada as of December 2019 , by region" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "province of Canada" .

:YAxis a :Axis ;
    :title "Number of establishments" .

:DataPoint1 a :DataPoint ;
    :xValue "Ontario" ;
    :yValue "53" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "British Columbia" ;
    :yValue "51" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "Quebec" ;
    :yValue "45" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "Alberta" ;
    :yValue "19" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "Manitoba" ;
    :yValue "14" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Nova Scotia" ;
    :yValue "12" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Newfoundland and Labrador" ;
    :yValue "9" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Saskatchewan" ;
    :yValue "9" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "New Brunswick" ;
    :yValue "4" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "Yukon" ;
    :yValue "1" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "Northwest Territories" ;
    :yValue "1" ;
    :belongsTo :Chart .
