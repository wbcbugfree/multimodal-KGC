@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Share of households owning pets by type and region in the United Kingdom (UK) from 2016 to 2019" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "region in the United Kingdom" .

:YAxis a :Axis ;
    :title "Indoor fish" .

:DataPoint1 a :DataPoint ;
    :xValue "North East" ;
    :yValue "0.07" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "North West" ;
    :yValue "0.07" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "Yorks&Humber" ;
    :yValue "0.06" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "East Midlands" ;
    :yValue "0.08" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "West Midlands" ;
    :yValue "0.09" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "East of England" ;
    :yValue "0.07" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "London" ;
    :yValue "0.05" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "South East" ;
    :yValue "0.07" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "South West" ;
    :yValue "0.07" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "Wales" ;
    :yValue "0.08" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "Scotland" ;
    :yValue "0.06" ;
    :belongsTo :Chart .

:DataPoint12 a :DataPoint ;
    :xValue "Northern Ireland" ;
    :yValue "0.07" ;
    :belongsTo :Chart .
