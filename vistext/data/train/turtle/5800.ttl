@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Number of employees in leading steel industries in the European Union in 2019" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Country" .

:YAxis a :Axis ;
    :title "Number of people employed" .

:DataPoint1 a :DataPoint ;
    :xValue "Germany" ;
    :yValue "86000" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Italy" ;
    :yValue "30601" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "Poland" ;
    :yValue "24700" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "Romania" ;
    :yValue "22630" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "France" ;
    :yValue "21900" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Czech Republic" ;
    :yValue "17800" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Spain" ;
    :yValue "17400" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "United Kingdom" ;
    :yValue "17000" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "Sweden" ;
    :yValue "15700" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "Austria" ;
    :yValue "15500" ;
    :belongsTo :Chart .
