@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Countries with the largest amount of exhibition space rented in 2012 (in million net sqm)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Exhibition space in million square meters" .

:YAxis a :Axis ;
    :title "Country" .

:DataPoint1 a :DataPoint ;
    :xValue "41.1" ;
    :yValue "USA" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "13.7" ;
    :yValue "China" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "8.7" ;
    :yValue "Germany" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "5.9" ;
    :yValue "Italy" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "5.7" ;
    :yValue "France" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "3.2" ;
    :yValue "Japan" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "3" ;
    :yValue "Brazil" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "2.9" ;
    :yValue "Russia" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "2.8" ;
