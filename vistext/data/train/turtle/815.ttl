@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Number of confirmed COVID-19 cases per state in Malaysia as of January 6 , 2021" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Number of cases" .

:YAxis a :Axis ;
    :title "state of Malaysia" .

:DataPoint1 a :DataPoint ;
    :xValue "38960" ;
    :yValue "Sabah" ;
    :belongsTo :Chart .

