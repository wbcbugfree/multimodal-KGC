@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Number of annual residential property transactions in London from 2005 to 2014 (in 1,000s)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Number of transactions in thousands" .

:DataPoint1 a :DataPoint ;
    :xValue "2014*" ;
    :yValue "155" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "2013" ;
    :yValue "145" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "2012" ;
    :yValue "124" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "2011" ;
    :yValue "115" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "2010" ;
    :yValue "116" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "2009" ;
    :yValue "95" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "2008" ;
    :yValue "103" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "2007" ;
    :yValue "192" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "2006" ;
    :yValue "197" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "2005" ;
    :yValue "189" ;
    :belongsTo :Chart .
