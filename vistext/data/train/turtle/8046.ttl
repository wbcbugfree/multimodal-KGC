@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Number of Facebook fans/twitter followers of Utah Jazz (NBA) from 2012 to 2020 (in millions)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Month" .

:YAxis a :Axis ;
    :title "Twitter followers" .

:DataPoint1 a :DataPoint ;
    :xValue "Aug 31, 2012" ;
    :yValue "0.1" ;
    :belongsTo :Chart .

