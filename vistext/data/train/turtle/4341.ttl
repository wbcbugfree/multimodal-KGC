@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Number of domestic tourist visits in India from 2000 to 2018 , with an estimate for 2019 (in millions)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Domestic tourist visits in millions" .

:DataPoint1 a :DataPoint ;
    :xValue "2019*" ;
    :yValue "2321.98" ;
    :belongsTo :Chart .

