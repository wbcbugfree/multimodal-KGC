@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Sales of automobiles in India from financial year 2011 to 2020 , by type (in million units)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Passenger vehicles" .

:YAxis a :Axis ;
    :title "year" .

:DataPoint1 a :DataPoint ;
    :xValue "2.77" ;
    :yValue "FY 2020" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "3.4" ;
    :yValue "FY 2019" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "3.3" ;
    :yValue "FY 2018" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "3" ;
    :yValue "FY 2017" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "2.8" ;
    :yValue "FY 2016" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "2.6" ;
    :yValue "FY 2015" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "2.5" ;
    :yValue "FY 2014" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "2.7" ;
    :yValue "FY 2013" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "2.6" ;
    :yValue "FY 2012" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "2.5" ;
    :yValue "FY 2011" ;
    :belongsTo :Chart .
