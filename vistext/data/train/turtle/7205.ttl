@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Federal funds for education and related programs from 1970 to 2018 (in billion U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Other education" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 1969" ;
    :yValue "0.96" ;
    :belongsTo :Chart .

