@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Annual turnover of the manufacture of rubber and plastic products in Poland from 2008 to 2018 (in million euros)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Annual turnover in million euros" .

:DataPoint1 a :DataPoint ;
    :xValue "2018*" ;
    :yValue "23955.8" ;
    :belongsTo :Chart .

