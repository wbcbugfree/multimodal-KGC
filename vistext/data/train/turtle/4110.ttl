@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Spending of international tourists in Italy from 2014 to 2029 (in billion euros)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Spending in billion euros" .

:DataPoint1 a :DataPoint ;
    :xValue "2014" ;
    :yValue "36.3" ;
    :belongsTo :Chart .

