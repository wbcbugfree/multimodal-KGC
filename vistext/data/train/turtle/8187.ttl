@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Motor vehicle production volume worldwide in 2019 , by country (in 1,000 units)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Country" .

:YAxis a :Axis ;
    :title "Commercial vehicles" .

:DataPoint1 a :DataPoint ;
    :xValue "China" ;
    :yValue "4360.47" ;
    :belongsTo :Chart .

