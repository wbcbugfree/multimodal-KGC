@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Leading Overwatch League teams on Twitter worldwide as of February 2018 , by number of followers (in 1,000s)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Number of followers in thousands" .

:YAxis a :Axis ;
    :title "esports team" .

:DataPoint1 a :DataPoint ;
    :xValue "112" ;
    :yValue "San Francisco Shock" ;
    :belongsTo :Chart .

