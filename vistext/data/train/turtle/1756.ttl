@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Number of Barnes & Noble stores from fiscal year 2005 to fiscal year 2019" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Number of stores" .

:DataPoint1 a :DataPoint ;
    :xValue "2019" ;
    :yValue "627" ;
    :belongsTo :Chart .

