@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Leading countries with the most certified Fairtrade International farmers and workers in 2012" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Country" .

:YAxis a :Axis ;
    :title "Number of workers" .

:DataPoint1 a :DataPoint ;
    :xValue "Kenya" ;
    :yValue "265800" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Tanzania" ;
    :yValue "157400" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "India" ;
    :yValue "137600" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "Ethiopia" ;
    :yValue "121900" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "Ghana" ;
    :yValue "95400" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Peru" ;
    :yValue "56700" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Uganda" ;
    :yValue "48000" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Colombia" ;
    :yValue "47400" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "Mexico" ;
    :yValue "35300" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "Ivory Coast" ;
    :yValue "35000" ;
    :belongsTo :Chart .
