@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "System RAM distribution among Steam gaming platform users in October 2020" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Share of users" .

:YAxis a :Axis ;
    :title "System RAM size" .

:DataPoint1 a :DataPoint ;
    :xValue "0.0007" ;
    :yValue "Less than 2 GB" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "0.0036" ;
    :yValue "2 GB" ;
    :belongsTo :Chart .

