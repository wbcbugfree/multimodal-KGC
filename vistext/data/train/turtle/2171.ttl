@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Leading Serie A soccer coaches in Italy as of the season 2019/2020 , by Italian Soccer Championships (scudetto) won" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Leading Serie A soccer coaches in Italy" .

:YAxis a :Axis ;
    :title "Number of championships won" .

:DataPoint1 a :DataPoint ;
    :xValue "Giovanni Trapattoni" ;
    :yValue "7" ;
    :belongsTo :Chart .

