@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Share of population aged 60 and older in China from 1950 to 2100" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "Share of persons aged 60+" .

