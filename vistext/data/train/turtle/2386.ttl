@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Countries with the smallest percentage of infants who had received a Diphtheria-tetanus-pertussis (DTP3) vaccination in 2018" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "Percentage of one-year-olds" .

:DataPoint1 a :DataPoint ;
    :xValue "Equatorial Guinea" ;
    :yValue "0.25" ;
    :belongsTo :Chart .

