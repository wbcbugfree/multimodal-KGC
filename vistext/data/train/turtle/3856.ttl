@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Week-by-week super PAC spending in the 2012 election from December 2011 up to November 2012 (in million U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Week starting date" .

:YAxis a :Axis ;
    :title "Expenditure in million U.S. dollars" .

