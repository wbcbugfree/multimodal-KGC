@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Leading global reinsurers in 2016 , by gross reinsurance premiums written (in billion U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "business" .

:YAxis a :Axis ;
    :title "Net premiums written in million U.S. dollars" .

:DataPoint1 a :DataPoint ;
    :xValue "Swiss Re Ltd." ;
    :yValue "35.62" ;
    :belongsTo :Chart .

