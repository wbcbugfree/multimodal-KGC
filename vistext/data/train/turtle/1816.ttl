@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Percentage of Shiites in the population of selected countries in the Middle East" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "Percentage of Shiites" .

:DataPoint1 a :DataPoint ;
    :xValue "Iran" ;
    :yValue "0.925" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Azerbaijan" ;
    :yValue "0.7" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "Bahrain" ;
    :yValue "0.7" ;
    :belongsTo :Chart .

