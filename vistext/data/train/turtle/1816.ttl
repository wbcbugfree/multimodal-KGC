    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "Qatar" ;
    :yValue "0.1" ;
    :belongsTo :Chart .

:DataPoint12 a :DataPoint ;
    :xValue "United Arab Emirates" ;
