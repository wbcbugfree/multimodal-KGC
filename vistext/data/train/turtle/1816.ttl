    :xValue "Lebanon" ;
    :yValue "0.5" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Yemen" ;
    :yValue "0.375" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Kuwait" ;
    :yValue "0.225" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Syria" ;
    :yValue "0.175" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "Turkey" ;
