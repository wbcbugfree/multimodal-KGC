@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Leading video gaming markets in Africa in 2018 , by revenue (in million U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Country" .

:YAxis a :Axis ;
    :title "Revenue in million U.S. dollars" .

:DataPoint1 a :DataPoint ;
    :xValue "Egypt" ;
    :yValue "293" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "South Africa" ;
    :yValue "216" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "Morocco" ;
    :yValue "129" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "Nigeria" ;
    :yValue "122" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "Algeria" ;
    :yValue "107" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Tunisia" ;
    :yValue "45" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Ethiopia" ;
    :yValue "26" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Ghana" ;
    :yValue "23" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "Kenya" ;
    :yValue "23" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "Angola" ;
    :yValue "22" ;
