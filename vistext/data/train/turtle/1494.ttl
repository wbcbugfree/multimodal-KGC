@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Leading eSports players worldwide in 2019 , by earnings (in million U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Players" .

:YAxis a :Axis ;
    :title "Earnings in million U.S. dollars" .

:DataPoint1 a :DataPoint ;
    :xValue "JerAx (Jesse Vainikka)" ;
    :yValue "3.16" ;
    :belongsTo :Chart .

