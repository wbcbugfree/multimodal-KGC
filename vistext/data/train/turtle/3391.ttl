@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Sales volume of vodka manufactured in the United Kingdom (UK) from 2008 to 2019 (in thousand liters of pure alcohol)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Sales volume in thousand liters" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2007" ;
    :yValue "14392" ;
    :belongsTo :Chart .

