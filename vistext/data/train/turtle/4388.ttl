@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Which , if any , of the following types of tea do you ever drink ?" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Type of tea" .

:YAxis a :Axis ;
    :title "Share of respondents" .

:DataPoint1 a :DataPoint ;
    :xValue "English breakfast" ;
    :yValue "0.52" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Green" ;
    :yValue "0.23" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "Earl Grey" ;
    :yValue "0.22" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "Fruit" ;
    :yValue "0.19" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "Peppermint" ;
    :yValue "0.16" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Herbal" ;
    :yValue "0.15" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Camomile" ;
    :yValue "0.11" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Decaffeinated" ;
    :yValue "0.1" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "Assam" ;
    :yValue "0.09" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "Darjeeling" ;
    :yValue "0.08" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "Chai" ;
    :yValue "0.07" ;
    :belongsTo :Chart .

:DataPoint12 a :DataPoint ;
    :xValue "Other" ;
    :yValue "0.16" ;
    :belongsTo :Chart .

:DataPoint13 a :DataPoint ;
    :xValue "Not applicable - I never drink tea" ;
    :yValue "0.18" ;
    :belongsTo :Chart .
