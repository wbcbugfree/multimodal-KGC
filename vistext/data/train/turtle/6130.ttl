@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Brand value of the leading 10 most valuable Portuguese brands from 2015 to 2019 (in million U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Brand" .

:YAxis a :Axis ;
    :title "2019" .

:DataPoint1 a :DataPoint ;
    :xValue "ED" ;
    :yValue "2769" ;
    :belongsTo :Chart .

