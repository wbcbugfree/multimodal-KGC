@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Share of survey respondents who agree that `` In this country , gambling is conducted fairly and can be trusted '' in the United Kingdom (UK) from 2008 to 2019" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "Share of respondents" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2007" ;
    :yValue "0.488" ;
    :belongsTo :Chart .

