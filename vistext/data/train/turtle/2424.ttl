@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Number of stores of key clothing retailers in Germany in 2013" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "key clothing retailers" .

:YAxis a :Axis ;
    :title "Number of stores" .

:DataPoint1 a :DataPoint ;
    :xValue "KIK" ;
    :yValue "2554" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "C&A" ;
    :yValue "509" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "H&M" ;
    :yValue "418" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "Vögele" ;
    :yValue "281" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "Espirit" ;
    :yValue "163" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Galeria Kaufhof" ;
    :yValue "105" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Karstadt" ;
    :yValue "83" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Zara" ;
    :yValue "72" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "Peek & Cloppenburg" ;
    :yValue "67" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "Cubus" ;
    :yValue "11" ;
