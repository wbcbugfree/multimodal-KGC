    :xValue "Dec 31, 2017" ;
    :yValue "1352.62" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "Dec 31, 2018" ;
    :yValue "1367.6" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Dec 31, 2019" ;
    :yValue "1381.59" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Dec 31, 2020" ;
    :yValue "1395.57" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
