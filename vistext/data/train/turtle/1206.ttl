@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "New York Knicks all-time assists leaders from 1946 to 2020" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Assists" .

:YAxis a :Axis ;
    :title "Players" .

:DataPoint1 a :DataPoint ;
    :xValue "4791" ;
    :yValue "Walt Frazier" ;
    :belongsTo :Chart .

