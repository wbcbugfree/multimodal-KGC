@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Forecast about the development of the world population from 2015 to 2100 (in billions)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "World population in billions" .

