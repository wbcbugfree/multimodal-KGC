@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Share of energy from renewable sources in electricity generation in Austria from 2007 to 2018" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "Share of energy from renewable sources" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2006" ;
    :yValue "0.64" ;
    :belongsTo :Chart .

