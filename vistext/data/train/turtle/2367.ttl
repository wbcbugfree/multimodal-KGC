@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Leading financial advisors to M & A in Russia in the first half of 2019 , by deal count" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "M&A deal count" .

:YAxis a :Axis ;
    :title "Leading financial advisors" .

:DataPoint1 a :DataPoint ;
    :xValue "4" ;
    :yValue "Citi" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "4" ;
    :yValue "Renaissance Capital" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "4" ;
    :yValue "Sberbank" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "3" ;
    :yValue "JPMorgan" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "2" ;
    :yValue "Credit Suisse" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "2" ;
    :yValue "Deloitte" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "2" ;
    :yValue "Bank of America Merrill Lynch" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "1" ;
    :yValue "Guggenheim Partners" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "1" ;
    :yValue "BTIG" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "1" ;
    :yValue "Evercore" ;
    :belongsTo :Chart .
