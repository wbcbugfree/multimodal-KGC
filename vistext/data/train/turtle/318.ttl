@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Annual consumption of fluid cow milk worldwide in 2019 , by country (in 1,000 metric tons)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Country" .

:YAxis a :Axis ;
    :title "Milk consumption in thousand metric tons" .

:DataPoint1 a :DataPoint ;
    :xValue "India" ;
    :yValue "77680" ;
    :belongsTo :Chart .

