@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Fastest growing household products online sales growth during the coronavirus (COVID-19) outbreak in Russia from January to March 2020 , by product" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "household products" .

:YAxis a :Axis ;
    :title "06.01-01.03" .

:DataPoint1 a :DataPoint ;
    :xValue "Bathroom cleaning products" ;
    :yValue "0.69" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Toilet paper" ;
    :yValue "0.29" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "Multipurpose cleaning products" ;
    :yValue "0.66" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "Fabric softeners" ;
    :yValue "0.92" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "Laundry detergents" ;
    :yValue "0.71" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Kitchen paper" ;
    :yValue "0.19" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Floor cleaning products" ;
    :yValue "0.61" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Pipe cleaners" ;
    :yValue "0.76" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "Bleach" ;
    :yValue "0.8" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "Hygiene products" ;
    :yValue "0.5" ;
    :belongsTo :Chart .
