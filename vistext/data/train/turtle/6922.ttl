@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Total population in Latin America and the Caribbean from 2008 to 2018 , by gender (in million inhabitants)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Total" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2007" ;
    :yValue "577.05" ;
    :belongsTo :Chart .

