@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Most popular tax havens of Mossack Fonseca as of April 2016 , by number of companies located in an offshore center" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Number of companies located in an offshore center" .

:YAxis a :Axis ;
    :title "Country" .

:DataPoint1 a :DataPoint ;
