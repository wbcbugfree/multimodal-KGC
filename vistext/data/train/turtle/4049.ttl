@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Leading U.S. states based on value of barley production in 2018 (in 1,000 U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Production value in thousand U.S. dollars" .

:YAxis a :Axis ;
    :title "State" .

:DataPoint1 a :DataPoint ;
    :xValue "264974" ;
    :yValue "Idaho" ;
    :belongsTo :Chart .

