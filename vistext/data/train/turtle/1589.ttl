@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Leading countries based on uranium consumption worldwide in 2018 (in 1,000 metric tons)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Country" .

:YAxis a :Axis ;
    :title "Consumption in thousand metric tons" .

:DataPoint1 a :DataPoint ;
    :xValue "United States" ;
    :yValue "19.16" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "France" ;
    :yValue "8.74" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "China" ;
    :yValue "8.71" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "Russia" ;
    :yValue "5.62" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "South Korea" ;
    :yValue "4.59" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "India" ;
    :yValue "2.33" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Ukraine" ;
    :yValue "1.89" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "United Kingdom" ;
    :yValue "1.8" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "Canada" ;
    :yValue "1.62" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "Germany" ;
    :yValue "1.38" ;
    :belongsTo :Chart .
