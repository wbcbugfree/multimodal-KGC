@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Percentage composition of government tax revenue in the United States from 2010 to 2025" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "year" .

:YAxis a :Axis ;
    :title "Excise taxes" .

:DataPoint1 a :DataPoint ;
    :xValue "'25*" ;
    :yValue "0.019" ;
    :belongsTo :Chart .

