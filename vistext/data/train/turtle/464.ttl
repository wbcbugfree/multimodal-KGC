@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Forecast of population growth in Norway from 2016 to 2027 (in millions)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Number of inhabitants (in millions)" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2015" ;
    :yValue "5.21" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Dec 31, 2016" ;
    :yValue "5.27" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "Dec 31, 2017" ;
    :yValue "5.33" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "Dec 31, 2018" ;
    :yValue "5.38" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "Dec 31, 2019" ;
    :yValue "5.44" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Dec 31, 2020" ;
    :yValue "5.48" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Dec 31, 2021" ;
    :yValue "5.53" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Dec 31, 2022" ;
    :yValue "5.58" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "Dec 31, 2023" ;
    :yValue "5.63" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "Dec 31, 2024" ;
    :yValue "5.68" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "Dec 31, 2025" ;
    :yValue "5.73" ;
    :belongsTo :Chart .

:DataPoint12 a :DataPoint ;
    :xValue "Dec 31, 2026" ;
    :yValue "5.77" ;
    :belongsTo :Chart .
