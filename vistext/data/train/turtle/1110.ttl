@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Average annual price of sea scallops in the U.S. from 2000 to 2018 (in U.S. dollars per pound)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Price in U.S. dollars per pound" .

