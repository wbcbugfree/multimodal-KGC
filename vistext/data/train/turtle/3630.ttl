    :xValue "37651.67" ;
    :yValue "2016" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "43581.24" ;
    :yValue "2015*" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "42546.34" ;
    :yValue "2014" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "39863.04" ;
    :yValue "2013" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "37981.67" ;
    :yValue "2012" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "35406.78" ;
    :yValue "2011" ;
