@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Net sales of Gerdau S.A. from FY 2010 to FY 2019 (in million Brazilian reals)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Net sales in million Brazilian reals" .

:YAxis a :Axis ;
    :title "Year" .

:DataPoint1 a :DataPoint ;
    :xValue "39644.01" ;
    :yValue "2019" ;
    :belongsTo :Chart .

