@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "BRIC countries : Growth rate of the real gross domestic product (GDP) from 2009 to 2021 (compared to the previous year)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Brazil" .

:YAxis a :Axis ;
    :title "Year" .

:DataPoint1 a :DataPoint ;
    :xValue "0.0289" ;
    :yValue "2021*" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "-0.053" ;
    :yValue "2020*" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "0.0113" ;
    :yValue "2019" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "0.0131" ;
    :yValue "2018" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "0.0131" ;
    :yValue "2017" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "-0.0329" ;
    :yValue "2016" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "-0.0355" ;
    :yValue "2015" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "0.0051" ;
    :yValue "2014" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "0.0301" ;
    :yValue "2013" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "0.0193" ;
    :yValue "2012" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "0.0399" ;
    :yValue "2011" ;
    :belongsTo :Chart .

:DataPoint12 a :DataPoint ;
    :xValue "0.0755" ;
    :yValue "2010" ;
    :belongsTo :Chart .

:DataPoint13 a :DataPoint ;
    :xValue "-0.0012" ;
    :yValue "2009" ;
    :belongsTo :Chart .
