@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Arizona Cardinals average regular season home attendance from 2008 to 2019" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Average attendance" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2007" ;
    :yValue "64096" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Dec 31, 2008" ;
    :yValue "63142" ;
    :belongsTo :Chart .

