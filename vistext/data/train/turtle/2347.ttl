@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Share of consumers stocking up on food and hygiene products in Russia in 2020 , by category" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "Share of respondents" .

:DataPoint1 a :DataPoint ;
    :xValue "Cereals" ;
    :yValue "0.87" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Canned food" ;
    :yValue "0.79" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "Masks" ;
    :yValue "0.76" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "Pasta" ;
    :yValue "0.75" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "Wet wipes" ;
    :yValue "0.67" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Anticeptic gels" ;
    :yValue "0.65" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Coffee and tea" ;
    :yValue "0.62" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Soap" ;
    :yValue "0.49" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "Water" ;
    :yValue "0.35" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "Toilet paper" ;
    :yValue "0.31" ;
    :belongsTo :Chart .
