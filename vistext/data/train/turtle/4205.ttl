@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Atlanta Braves all-time home run leaders as of October 2020" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Home run leader" .

:YAxis a :Axis ;
    :title "Number of home runs" .

:DataPoint1 a :DataPoint ;
    :xValue "Hank Aaron" ;
    :yValue "733" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Eddie Mathews" ;
    :yValue "493" ;
    :belongsTo :Chart .

