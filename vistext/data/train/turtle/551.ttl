@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "The Complete University Guide 's top twenty universities in the United Kingdom in 2021 , by overall score" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Complete University Guide score" .

:YAxis a :Axis ;
    :title "higher education institution" .

:DataPoint1 a :DataPoint ;
    :xValue "1" ;
    :yValue "University of Cambridge" ;
    :belongsTo :Chart .

