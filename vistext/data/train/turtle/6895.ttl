@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Voter turnout rates among selected age groups in U.S. midterm elections from 1966 to 2018" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "National average" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 1965" ;
    :yValue "0.554" ;
    :belongsTo :Chart .

