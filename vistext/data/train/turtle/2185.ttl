@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Life expectancy (from birth) in Portugal , from 1915 to 2020" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Life expectancy in years" .

