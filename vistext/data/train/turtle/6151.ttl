@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "U.S. electricity production costs from 2000 to 2014 , by source (in cents per kilowatt hour)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Nuclear" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 1999" ;
    :yValue "2.34" ;
    :belongsTo :Chart .

