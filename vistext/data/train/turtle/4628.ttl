@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Ranking of the most registered female baby names in France in 2018" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "name" .

:YAxis a :Axis ;
    :title "Number of newly registered female names" .

:DataPoint1 a :DataPoint ;
    :xValue "Emma" ;
    :yValue "4369" ;
    :belongsTo :Chart .

