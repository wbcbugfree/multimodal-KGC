@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Average length of refueling outages for nuclear plants in the United States from 1995 to 2019 (in days)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Average number of days" .

