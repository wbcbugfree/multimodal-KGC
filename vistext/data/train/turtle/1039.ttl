@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Active real estate buyers within the past 12 months on the European investment market as of January 2016 , by number of properties" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Real Estate buyers" .

:YAxis a :Axis ;
    :title "Number of properties" .

