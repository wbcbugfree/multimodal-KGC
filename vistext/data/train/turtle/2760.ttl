@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Largest donors of humanitarian aid worldwide in 2019 (in million U.S. dollars) , by country" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Aid (in million U.S. dollars)" .

:YAxis a :Axis ;
    :title "Country" .

:DataPoint1 a :DataPoint ;
    :xValue "6496.3" ;
    :yValue "United States" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "1483.8" ;
    :yValue "Germany" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "1439.3" ;
    :yValue "United Kingdom" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "1168.1" ;
    :yValue "European commission" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "990.8" ;
    :yValue "Saudi Arabia" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "425" ;
    :yValue "United Arab Emirates" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "406.2" ;
    :yValue "Canada" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "398.5" ;
    :yValue "Central Emergency Response Fund" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "351.2" ;
    :yValue "Sweden" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "349.4" ;
    :yValue "EU Commission - EU facility for refugees in Turkey" ;
    :belongsTo :Chart .
