    :xValue "113" ;
    :yValue "France" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "111.3" ;
    :yValue "China" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "102.8" ;
    :yValue "Argentina" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "95.6" ;
    :yValue "Thailand" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "79.2" ;
