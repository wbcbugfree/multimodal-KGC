@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Leading countries based on biofuel production in 2019 (in petajoules)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Production in petajoules" .

:YAxis a :Axis ;
    :title "Country" .

:DataPoint1 a :DataPoint ;
    :xValue "1557.1" ;
    :yValue "United States" ;
    :belongsTo :Chart .

