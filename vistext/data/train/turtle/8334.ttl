@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Anticipated time of booking summer holiday in selected European countries in 2019" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "One month or more in advance" .

:YAxis a :Axis ;
    :title "Response" .

:DataPoint1 a :DataPoint ;
    :xValue "0.82" ;
    :yValue "United Kingdom" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "0.81" ;
    :yValue "Germany" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "0.81" ;
    :yValue "Belgium" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "0.8" ;
    :yValue "Austria" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "0.79" ;
    :yValue "Switzerland" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "0.78" ;
    :yValue "France" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "0.69" ;
    :yValue "Portugal" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "0.69" ;
    :yValue "Spain" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "0.68" ;
    :yValue "Italy" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "0.59" ;
    :yValue "Poland" ;
    :belongsTo :Chart .
