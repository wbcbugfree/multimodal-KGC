@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Number of victims of intentional homicide in Paraguay from 2000 to 2016" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Number of homicides" .

