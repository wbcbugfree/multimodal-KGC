@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Chained consumer price index (C-CPI-U) of all urban consumers in the United States from 2000 to 2019 , at year-end" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "December value" .

:YAxis a :Axis ;
    :title "Chained Consumer Price Index (1999=100)" .

:DataPoint1 a :DataPoint ;
    :xValue "2019*" ;
    :yValue "144.73" ;
    :belongsTo :Chart .

