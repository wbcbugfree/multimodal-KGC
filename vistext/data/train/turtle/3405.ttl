@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Persons employed in home health care services in the U.S. from 2000 to 2019 (in 1,000)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Number of persons in thousands" .

