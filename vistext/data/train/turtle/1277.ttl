@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Number of physiotherapists employed in Germany from 2000 to 2018 (in 1,000s)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Number of employees in thousands" .

:YAxis a :Axis ;
    :title "Year" .

