@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Survival rate of new enterprises in the United Kingdom from 2007 to 2017 , by years survived" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year of enterprise birth" .

:YAxis a :Axis ;
    :title "4 years" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2006" ;
    :yValue "0.52" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Dec 31, 2007" ;
    :yValue "0.489" ;
    :belongsTo :Chart .

