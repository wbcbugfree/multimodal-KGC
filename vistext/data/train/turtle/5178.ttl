@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "General government gross consolidated debt as a percentage of gross domestic product (GDP) in the United Kingdom (UK) from 2000/01 to 2018/19" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Percentage of GDP" .

:YAxis a :Axis ;
    :title "Response" .

:DataPoint1 a :DataPoint ;
    :xValue "0.852" ;
    :yValue "2018/19" ;
    :belongsTo :Chart .

