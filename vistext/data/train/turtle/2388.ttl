@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Travel and tourism sector as percentage of gross domestic product in Saint Kitts and Nevis from 2010 to 2019" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "Percentage of GDP" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2009" ;
    :yValue "0.0873" ;
    :belongsTo :Chart .

