@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Bangladesh : Total population from 2015 to 2025 (in million inhabitants)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Inhabitants in millions" .

:DataPoint1 a :DataPoint ;
    :xValue "2025*" ;
    :yValue "177.21" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "2024*" ;
    :yValue "175.4" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "2023*" ;
    :yValue "173.6" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "2022*" ;
    :yValue "171.82" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "2021*" ;
    :yValue "170.06" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "2020*" ;
    :yValue "168.31" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "2019*" ;
    :yValue "166.59" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "2018*" ;
    :yValue "164.88" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "2017*" ;
    :yValue "163.19" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "2016*" ;
    :yValue "161.51" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "2015*" ;
    :yValue "159.86" ;
    :belongsTo :Chart .
