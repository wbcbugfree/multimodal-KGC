@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Share of people participating in outdoor activities in the United States from 2007 to 2017 , by age group" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "45+ years" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2006" ;
    :yValue "0.39" ;
    :belongsTo :Chart .

