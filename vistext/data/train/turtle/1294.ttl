@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Average income tax paid per household in the United Kingdom in 2018/19 by decile group (in GBP)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Decile group" .

:YAxis a :Axis ;
    :title "Income tax in GBP" .

:DataPoint1 a :DataPoint ;
    :xValue "Top" ;
    :yValue "45911" ;
    :belongsTo :Chart .

