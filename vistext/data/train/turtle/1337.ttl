@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Quantity of tulips sold in the U.S. from 2002 to 2018 (in 1,000 stems)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Quantity in thousand stems" .

:YAxis a :Axis ;
    :title "Year" .

