@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Per capita consumption of orange juice in the United States from 2000/2001 to 2018/2019 (in gallons)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Per capita consumption in gallons" .

