@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Top 10 European biotech companies based on change in market capitalization between 2012 and 2016 (in million U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "company" .

:YAxis a :Axis ;
    :title "Change in million U.S. dollars" .

:DataPoint1 a :DataPoint ;
    :xValue "Shire" ;
    :yValue "32876" ;
    :belongsTo :Chart .

