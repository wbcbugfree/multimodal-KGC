@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Basic earning 's per Sanofi 's shares from 2009 to 2019 (in euros)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Earnings per share in euros" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2008" ;
    :yValue "4.03" ;
    :belongsTo :Chart .

