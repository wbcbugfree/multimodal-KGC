@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Share of wholesale ESPRIT sales worldwide in fiscal year 2018/2019 , by country" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Share of wholesale sales" .

:YAxis a :Axis ;
    :title "Response" .

:DataPoint1 a :DataPoint ;
    :xValue "0.543" ;
    :yValue "Germany" ;
    :belongsTo :Chart .

