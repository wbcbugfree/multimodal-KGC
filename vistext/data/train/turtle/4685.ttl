@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Monthly civilian labor force in the United States from November 2019 to November 2020 (in millions , not seasonally adjusted)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Month" .

:YAxis a :Axis ;
    :title "Civilian labor force in millions" .

:DataPoint1 a :DataPoint ;
    :xValue "Nov '20" ;
    :yValue "160.47" ;
    :belongsTo :Chart .

