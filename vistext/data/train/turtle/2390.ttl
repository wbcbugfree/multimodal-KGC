@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Leading female Italian athletes in women 's marathon and half marathon as of December 2020 , by IAAF score" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "female Italian athletes" .

:YAxis a :Axis ;
    :title "IAAF score" .

:DataPoint1 a :DataPoint ;
    :xValue "Sara Dossena" ;
    :yValue "1218" ;
    :belongsTo :Chart .

