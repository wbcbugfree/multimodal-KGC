@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Which of the following sources , if any , have you looked at specifically for advice on foreign travel during the coronavirus outbreak ?" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Share of respondents" .

:YAxis a :Axis ;
    :title "Response" .

:DataPoint1 a :DataPoint ;
    :xValue "0.31" ;
    :yValue "NHS" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "0.29" ;
    :yValue "News sources/outlets (e.g. BBC)" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "0.23" ;
    :yValue "World Health Organization" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "0.2" ;
    :yValue "Public Health England" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "0.15" ;
    :yValue "Foreign & Commonwealth Office" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "0.11" ;
    :yValue "Medical websites" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "0.11" ;
    :yValue "Airlines (e.g. via their social media/website/app" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "0.11" ;
    :yValue "Health professional(s)" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "0.1" ;
    :yValue "Trending posts on social media" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "0.07" ;
    :yValue "Travel guides/websites (e.g. Lonely Planet)" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "0.06" ;
    :yValue "Travel agents" ;
    :belongsTo :Chart .

:DataPoint12 a :DataPoint ;
    :xValue "0.06" ;
    :yValue "Booking websites (e.g. Booking.com, Expedia)" ;
    :belongsTo :Chart .

:DataPoint13 a :DataPoint ;
    :xValue "0.06" ;
    :yValue "Hotels/resorts (e.g. via their social media/website/app)" ;
    :belongsTo :Chart .

:DataPoint14 a :DataPoint ;
    :xValue "0.05" ;
    :yValue "Social media influencers" ;
    :belongsTo :Chart .

:DataPoint15 a :DataPoint ;
    :xValue "0.02" ;
    :yValue "Other" ;
    :belongsTo :Chart .

:DataPoint16 a :DataPoint ;
    :xValue "0.34" ;
    :yValue "None of the above" ;
    :belongsTo :Chart .
