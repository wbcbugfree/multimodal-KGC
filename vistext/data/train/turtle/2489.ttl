@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Estimated net worth of the wealthiest media entrepreneurs in the United States in 2013 (in billion U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Net worth in billion U.S. dollars" .

:YAxis a :Axis ;
    :title "Entrepreneur (source of wealth)" .

:DataPoint1 a :DataPoint ;
    :xValue "31" ;
    :yValue "Michael Bloomberg(Bloomberg L.P.)" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "13.5" ;
    :yValue "Anne Cox Chambers(Cox Enterprises)" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "13.4" ;
    :yValue "Rupert Murdoch(News Corp.)" ;
    :belongsTo :Chart .

