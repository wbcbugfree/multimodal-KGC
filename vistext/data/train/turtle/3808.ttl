@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Leading sports clothing and shoes retail stores used by French consumers for their sports purchases in France in 2018 , by sports stores" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Percentage of purchases in value" .

:YAxis a :Axis ;
    :title "Response" .

:DataPoint1 a :DataPoint ;
    :xValue "0.29" ;
    :yValue "Décathlon" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "0.2" ;
    :yValue "Intersport" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "0.05" ;
    :yValue "Go Sport" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "0.04" ;
    :yValue "Nike" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "0.03" ;
    :yValue "Sport 2000" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "0.02" ;
    :yValue "Adidas" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "0.01" ;
    :yValue "Amazon" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "0.01" ;
    :yValue "Lidl" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "0.01" ;
    :yValue "Vente-privee.com" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "0.01" ;
    :yValue "Zalando" ;
    :belongsTo :Chart .
