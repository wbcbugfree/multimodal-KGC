@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Distribution of mine production of copper worldwide in 2018 , by country" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "Share of production" .

:DataPoint1 a :DataPoint ;
    :xValue "Chile" ;
    :yValue "0.285" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Peru" ;
    :yValue "0.116" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "China" ;
    :yValue "0.085" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "United States" ;
    :yValue "0.065" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "Australia" ;
    :yValue "0.048" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Zambia" ;
    :yValue "0.047" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "D.R. Congo" ;
    :yValue "0.046" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Indonesia" ;
    :yValue "0.037" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "Canada" ;
    :yValue "0.029" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "Other countries" ;
    :yValue "0.211" ;
    :belongsTo :Chart .
