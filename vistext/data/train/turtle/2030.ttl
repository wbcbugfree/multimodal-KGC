@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Ranking of the least expensive top business schools in the U.S. in 2015 , by tuition costs and fees (in thousand U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Tuition and fees in thousand U.S. dollars" .

:YAxis a :Axis ;
    :title "US University" .

:DataPoint1 a :DataPoint ;
    :xValue "45" ;
    :yValue "Hofstra (Zarb) - Hempstead, NY" ;
    :belongsTo :Chart .

