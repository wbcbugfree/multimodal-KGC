    :yValue "4704.7" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Dec 31, 2013" ;
    :yValue "4772.3" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
