@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Number of employed people in Sweden from 2009 to 2019 (in thousands)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Employed people in millions" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2008" ;
    :yValue "4498.7" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Dec 31, 2009" ;
    :yValue "4523.7" ;
    :belongsTo :Chart .

