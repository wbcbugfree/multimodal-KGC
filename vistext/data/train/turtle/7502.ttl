@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Thinking about once the restrictions are lifted , which of the following are you likely to try and avoid for the time being , because of coronavirus / Covid-19 ? (as of May 31 , 2020)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Germany" .

:YAxis a :Axis ;
    :title "Response" .

:DataPoint1 a :DataPoint ;
    :xValue "0.49" ;
    :yValue "Cinema / theatre" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "0.57" ;
    :yValue "Music festivals" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "0.55" ;
    :yValue "Music concerts" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "0.53" ;
    :yValue "Sports events" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "0.49" ;
    :yValue "Pubs / bars / clubs" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "0.43" ;
    :yValue "Gym / sports centers" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "0.33" ;
    :yValue "Restaurants / café’s" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "0.28" ;
    :yValue "Large retail shops / shopping centers" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "0.32" ;
    :yValue "Museums / galleries" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "0.23" ;
    :yValue "Shopping downtown / highstreet" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "0.22" ;
    :yValue "Hairdressers / beauty salons" ;
    :belongsTo :Chart .

:DataPoint12 a :DataPoint ;
    :xValue "0.42" ;
    :yValue "Holidays" ;
    :belongsTo :Chart .

:DataPoint13 a :DataPoint ;
    :xValue "0.07" ;
    :yValue "Supermarket / grocery shops" ;
    :belongsTo :Chart .

:DataPoint14 a :DataPoint ;
    :xValue "0.03" ;
    :yValue "Other" ;
    :belongsTo :Chart .

:DataPoint15 a :DataPoint ;
    :xValue "0.21" ;
    :yValue "Not planning to do anything less" ;
    :belongsTo :Chart .
