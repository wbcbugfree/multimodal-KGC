    :xValue "Boston (BOS) - San Francisco (SFO)" ;
    :yValue "1011472" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "Boston (BOS) - Los Angeles (LAX)" ;
    :yValue "928078" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Boston (BOS) - Tampa (TPA)" ;
    :yValue "325465" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Los Angeles (LAX) - Philadelphia (PHL)" ;
    :yValue "257174" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Las Vegas (LAS) - Orlando (MCO)" ;
