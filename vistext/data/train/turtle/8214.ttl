@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "The most underserved airline routes in U.S. in 2015 , by type of booking" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "main underserved airline routes" .

:YAxis a :Axis ;
    :title "Non-stop bookings" .

:DataPoint1 a :DataPoint ;
    :xValue "Boston (BOS) - Orlando (MCO)" ;
    :yValue "713189" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Boston (BOS) - Las Vegas (LAS)" ;
    :yValue "285224" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "Orlando (MCO) - Seattle/Tacoma (SEA)" ;
    :yValue "124628" ;
    :belongsTo :Chart .

