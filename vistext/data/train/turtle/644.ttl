@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Estimated year-on-year revenue growth rate of selected major public apparel retailers in the United Kingdom (UK) in the fiscal year 2017 (in million GBP)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Revenue growth rate" .

:YAxis a :Axis ;
    :title "major public apparel retailers" .

:DataPoint1 a :DataPoint ;
    :xValue "0.348" ;
    :yValue "Boohoo.com" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "0.241" ;
    :yValue "ASOS" ;
    :belongsTo :Chart .

