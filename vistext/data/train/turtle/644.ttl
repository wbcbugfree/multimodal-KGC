    :yValue "SuperGroup" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "0.137" ;
    :yValue "JD Sports" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "0.121" ;
    :yValue "Primark UK" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "0.083" ;
    :yValue "Sports Direct" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "0.008" ;
    :yValue "Bonmarche" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "0.006" ;
