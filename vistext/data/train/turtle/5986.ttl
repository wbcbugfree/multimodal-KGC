@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "U.S. whole cattle hide exports by top 10 destination countries in 2017 (in pieces)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Export in number of pieces" .

:YAxis a :Axis ;
    :title "Country" .

