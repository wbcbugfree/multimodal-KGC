@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Rate of sexual assaults by family members in Canada in 2016 , by province (per 100,000 population)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Number of victims per 100,000 population" .

:YAxis a :Axis ;
    :title "Province" .

:DataPoint1 a :DataPoint ;
    :xValue "111" ;
    :yValue "Nunavut" ;
    :belongsTo :Chart .

