@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Which data quality management tools does your company use ?" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Share of respondents" .

:YAxis a :Axis ;
    :title "Response" .

:DataPoint1 a :DataPoint ;
    :xValue "0.567" ;
    :yValue "Big data" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "0.536" ;
    :yValue "Master data management (MDM)" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "0.521" ;
    :yValue "Data cleansing tools (data validation)" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "0.438" ;
    :yValue "Monitoring" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "0.412" ;
    :yValue "Data exception handling" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "0.345" ;
    :yValue "ETL (extract, transform, load)" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "0.325" ;
    :yValue "Data stewardship (management)" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "0.289" ;
    :yValue "Metadata management" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "0.263" ;
    :yValue "Profiling" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "0.253" ;
    :yValue "Matching and consolidation" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "0.247" ;
    :yValue "Internationalization / Localization" ;
    :belongsTo :Chart .

:DataPoint12 a :DataPoint ;
    :xValue "0.242" ;
    :yValue "Verification" ;
    :belongsTo :Chart .

:DataPoint13 a :DataPoint ;
    :xValue "0.242" ;
    :yValue "Matching on name and address data" ;
    :belongsTo :Chart .

:DataPoint14 a :DataPoint ;
    :xValue "0.237" ;
    :yValue "Geo-coding" ;
    :belongsTo :Chart .

:DataPoint15 a :DataPoint ;
    :xValue "0.227" ;
    :yValue "Standardization, normalization" ;
    :belongsTo :Chart .

:DataPoint16 a :DataPoint ;
    :xValue "0.227" ;
    :yValue "Transformation" ;
    :belongsTo :Chart .

:DataPoint17 a :DataPoint ;
    :xValue "0.18" ;
    :yValue "Householding" ;
    :belongsTo :Chart .

:DataPoint18 a :DataPoint ;
    :xValue "0.175" ;
    :yValue "Enrichment" ;
    :belongsTo :Chart .
