@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Penetration rate of leading social networks in France during the third quarter of 2019" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Share of Internet users" .

:YAxis a :Axis ;
    :title "Response" .

:DataPoint1 a :DataPoint ;
    :xValue "0.8" ;
    :yValue "Youtube" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "0.76" ;
    :yValue "Facebook" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "0.47" ;
    :yValue "Instagram" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "0.35" ;
    :yValue "Snapchat" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "0.34" ;
    :yValue "Twitter" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "0.26" ;
    :yValue "Pinterest" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "0.23" ;
    :yValue "LinkedIn" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "0.15" ;
    :yValue "Twitch" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "0.1" ;
    :yValue "TikTok" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "0.1" ;
    :yValue "Reddit" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "0.09" ;
    :yValue "Tumblr" ;
    :belongsTo :Chart .

:DataPoint12 a :DataPoint ;
    :xValue "0.09" ;
    :yValue "Viadeo" ;
    :belongsTo :Chart .
