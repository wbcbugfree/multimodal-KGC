@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Monthly percentage of change in personal consumption expenditure (PCE) in the United States from November 2019 to November 2020" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Monthly percentage of change" .

:YAxis a :Axis ;
    :title "Month" .

:DataPoint1 a :DataPoint ;
    :xValue "-0.004" ;
    :yValue "Nov '20*" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "0.003" ;
    :yValue "Oct '20" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "0.013" ;
    :yValue "Sep '20" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "0.012" ;
    :yValue "Aug '20" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "0.015" ;
    :yValue "Jul '20" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "0.065" ;
    :yValue "Jun '20" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "0.087" ;
    :yValue "May '20" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "-0.127" ;
    :yValue "Apr '20" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "-0.065" ;
    :yValue "Mar '20" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "-0.001" ;
    :yValue "Feb '20" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "0.004" ;
    :yValue "Jan '20" ;
    :belongsTo :Chart .

:DataPoint12 a :DataPoint ;
    :xValue "0" ;
    :yValue "Dec '19" ;
    :belongsTo :Chart .

:DataPoint13 a :DataPoint ;
    :xValue "0.002" ;
    :yValue "Nov '19" ;
    :belongsTo :Chart .
