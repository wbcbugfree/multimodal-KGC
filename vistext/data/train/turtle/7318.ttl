@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Broadcast TV advertising revenue in the United States from 2004 to 2013 , by type (in billion US dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Network TV" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2003" ;
    :yValue "24.9" ;
    :belongsTo :Chart .

