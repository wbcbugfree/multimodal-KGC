@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Number of Coronavirus (COVID-19) tests per 1 million population in Central and Eastern European countries as of November 20 , 2020" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Number of tests per 1 million population" .

:YAxis a :Axis ;
    :title "Country" .

