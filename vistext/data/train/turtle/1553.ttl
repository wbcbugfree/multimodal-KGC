@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "How much did you spend on your last pair of running shoes ?" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "Share of respondents" .

:DataPoint1 a :DataPoint ;
    :xValue "$21-40" ;
    :yValue "0.02" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "$41-60" ;
    :yValue "0.05" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "$61-80" ;
    :yValue "0.12" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "$81-100" ;
    :yValue "0.21" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "$101-120" ;
    :yValue "0.25" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "$121-140" ;
    :yValue "0.18" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "$141-160" ;
    :yValue "0.1" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "$161-180" ;
    :yValue "0.03" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "$181-200" ;
    :yValue "0.02" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "$200+" ;
    :yValue "0.02" ;
    :belongsTo :Chart .
