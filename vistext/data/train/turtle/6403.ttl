@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "National rail revenue from passenger fares in the United Kingdom (UK) from 2000/2001 to 2019/2020 , in nominal and real prices (in million GBP)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "2019/20 real prices*" .

