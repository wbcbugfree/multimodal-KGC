@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Top golf players in the official world ranking as of August 2020 , by average points" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Golf player" .

:YAxis a :Axis ;
    :title "Average points" .

:DataPoint1 a :DataPoint ;
    :xValue "Dustin Johnson (USA)" ;
    :yValue "9.96" ;
    :belongsTo :Chart .

