@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Leading human hair exporting countries worldwide in 2019 (in million U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Export value in million U.S. dollars" .

:YAxis a :Axis ;
    :title "Country" .

:DataPoint1 a :DataPoint ;
    :xValue "30.2" ;
    :yValue "Hong Kong" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "19" ;
    :yValue "India" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "2.4" ;
    :yValue "United Kingdom" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "0.95" ;
    :yValue "United States" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "0.89" ;
    :yValue "Myanmar" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "0.74" ;
    :yValue "Brazil" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "0.5" ;
    :yValue "Thailand" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "0.48" ;
    :yValue "Ukraine" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "0.45" ;
    :yValue "Japan" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "0.39" ;
    :yValue "Italy" ;
    :belongsTo :Chart .
