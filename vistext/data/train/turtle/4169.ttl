@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Total number of deaths in Italy in 2019 , by region" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Number of deaths" .

:YAxis a :Axis ;
    :title "region of Italy" .

