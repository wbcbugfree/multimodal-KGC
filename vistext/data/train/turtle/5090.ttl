@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Most popular global events on Twitter as measured in tweets per second from 2011 to 2012" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "name of global event" .

:YAxis a :Axis ;
    :title "Tweets per second" .

:DataPoint1 a :DataPoint ;
    :xValue "Castle in the Sky on TV (Dec 9, '11)" ;
    :yValue "25088" ;
    :belongsTo :Chart .

