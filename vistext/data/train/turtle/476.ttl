@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Employee engagement score of the British-headquartered Nationwide Building Society from 2011 to 2020" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Employee engagement score" .

:DataPoint1 a :DataPoint ;
    :xValue "2020" ;
    :yValue "0.77" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "2019" ;
    :yValue "0.78" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "2018*" ;
    :yValue "0.77" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "2017" ;
    :yValue "0.78" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "2016" ;
    :yValue "0.8" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "2015" ;
    :yValue "0.79" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "2014" ;
    :yValue "0.77" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "2013" ;
    :yValue "0.68" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "2012" ;
    :yValue "0.69" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "2011" ;
    :yValue "0.64" ;
    :belongsTo :Chart .
