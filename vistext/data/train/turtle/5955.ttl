@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "The world 's largest crude steel producers in 2019 , by production volume (in million metric tons)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Production volume in million metric tons" .

:YAxis a :Axis ;
    :title "Crude steel producer" .

:DataPoint1 a :DataPoint ;
    :xValue "97.31" ;
    :yValue "ArcelorMittal (Luxembourg)" ;
    :belongsTo :Chart .

