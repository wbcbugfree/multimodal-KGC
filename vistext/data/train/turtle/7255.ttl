@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Most effective content types in demand generation during various stages of buyer 's journey according to B2B marketers in North America as of July 2018" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Late stage (evaluation/purchase)" .

:YAxis a :Axis ;
    :title "Response" .

:DataPoint1 a :DataPoint ;
    :xValue "0.06" ;
    :yValue "Blog posts/articles" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "0.4" ;
    :yValue "Case studies" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "0.06" ;
    :yValue "E-books" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "0.32" ;
    :yValue "In-person events" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "0.08" ;
    :yValue "Interactive content" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "0.07" ;
    :yValue "Podcasts" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "0.06" ;
    :yValue "Videos" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "0.17" ;
    :yValue "Webinars" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "0.14" ;
    :yValue "White papers" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "0.27" ;
    :yValue "Other" ;
    :belongsTo :Chart .
