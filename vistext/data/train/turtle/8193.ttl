@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Do you ever play games at home or elsewhere in any of these ways ?" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "Handheld games console" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2008" ;
    :yValue "0.16" ;
    :belongsTo :Chart .

