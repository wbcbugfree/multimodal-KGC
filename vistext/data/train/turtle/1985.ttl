@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Number of Masters Tournament titles from 1934 to 2020 , by player" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Golf player" .

:YAxis a :Axis ;
    :title "Masters won" .

:DataPoint1 a :DataPoint ;
    :xValue "Jack Nicklaus" ;
    :yValue "6" ;
    :belongsTo :Chart .

