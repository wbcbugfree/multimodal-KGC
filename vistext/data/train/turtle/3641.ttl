@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Russia 's uranium mine production from 2004 to 2019 (in metric tons)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Production in metric tons" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2003" ;
    :yValue "3200" ;
    :belongsTo :Chart .

