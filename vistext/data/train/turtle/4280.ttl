@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Market share of leading passenger car brands in Spain in 2019" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Market share" .

:YAxis a :Axis ;
    :title "automobile manufacturer" .

:DataPoint1 a :DataPoint ;
    :xValue "0.0873" ;
    :yValue "Peugeot" ;
    :belongsTo :Chart .

