@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Number of Nike 's non-U.S. retail stores from 2009 to 2020" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "NIKE factory stores" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2008" ;
    :yValue "184" ;
    :belongsTo :Chart .

