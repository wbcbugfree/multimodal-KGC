@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Share of B2B marketers reallocating live events budgets to other channels in light of the coronavirus outbreak in the United States as of March 2020" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "Share of respondents" .

:DataPoint1 a :DataPoint ;
    :xValue "Content creation" ;
    :yValue "0.43" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Webinars/digital events (hosted)" ;
    :yValue "0.4" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "Search advertising (Google, etc)" ;
    :yValue "0.33" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "Social media (paid)" ;
    :yValue "0.27" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "SEO" ;
    :yValue "0.2" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Lead gen indsutry vertical websites" ;
    :yValue "0.17" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Webinars/digital events (sponsored)" ;
    :yValue "0.17" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Social media (organic)" ;
    :yValue "0.15" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "Direct (postal) mail" ;
    :yValue "0.08" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "Outbound e-mail to 3rd party lists" ;
    :yValue "0.08" ;
    :belongsTo :Chart .
