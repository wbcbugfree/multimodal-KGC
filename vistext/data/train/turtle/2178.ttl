@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Best-performing restaurant stocks in the United States in 2014" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year-over-year increase in share price" .

:YAxis a :Axis ;
    :title "best-performing restaurant stock" .

:DataPoint1 a :DataPoint ;
    :xValue "0.6165" ;
    :yValue "BJ's Restaurant Inc." ;
    :belongsTo :Chart .

