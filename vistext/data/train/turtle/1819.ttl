@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Annual revenue generated by CBC/Radio-Canada from 2010 to 2020 (in million Canadian dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Revenue in million Canadian dollars" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2009" ;
    :yValue "566.71" ;
    :belongsTo :Chart .

