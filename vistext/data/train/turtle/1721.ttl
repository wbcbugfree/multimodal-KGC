@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Ranking of the most successful films at cinemas in Sweden in 2019 , by number of admissions" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Number of admissions" .

:YAxis a :Axis ;
    :title "film" .

:DataPoint1 a :DataPoint ;
