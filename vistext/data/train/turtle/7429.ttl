@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Puerto Rico : Age structure from 2009 to 2019" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "15-64 years" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2008" ;
    :yValue "0.6605" ;
    :belongsTo :Chart .

