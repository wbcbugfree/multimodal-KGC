@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Child mortality rate (under five years old) in India from 1880 to 2020" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Deaths per 1,000 live births" .

