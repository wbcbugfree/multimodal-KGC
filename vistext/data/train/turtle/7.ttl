@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Total number of users of payment app Tikkie in the Netherlands from 2016 to 2019 (in millions)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Total number of users in millions" .

:DataPoint1 a :DataPoint ;
    :xValue "Jun 19, 2016" ;
    :yValue "0" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Sep 21, 2016" ;
    :yValue "0.1" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "May 14, 2017" ;
    :yValue "0.5" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "Aug 11, 2017" ;
    :yValue "1.4" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "Aug 21, 2017" ;
    :yValue "1" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Nov 21, 2017" ;
    :yValue "1.3" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Jan 04, 2018" ;
    :yValue "2.5" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Jan 28, 2018" ;
    :yValue "2" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "Jun 24, 2018" ;
    :yValue "3" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "Nov 21, 2018" ;
    :yValue "4" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "Oct 16, 2019" ;
    :yValue "6" ;
    :belongsTo :Chart .

:DataPoint12 a :DataPoint ;
    :xValue "Dec 03, 2019" ;
    :yValue "5" ;
    :belongsTo :Chart .
