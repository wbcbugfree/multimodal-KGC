@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Distribution of leading source countries for foreign tourist arrivals in India in 2019" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Share of FTAs" .

:YAxis a :Axis ;
    :title "Response" .

:DataPoint1 a :DataPoint ;
    :xValue "0.2358" ;
    :yValue "Bangladesh" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "0.1383" ;
    :yValue "United States" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "0.0915" ;
    :yValue "United Kingdom" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "0.0336" ;
    :yValue "Australia" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "0.0322" ;
    :yValue "Canada" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "0.0311" ;
    :yValue "China" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "0.0306" ;
    :yValue "Malaysia" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "0.0303" ;
    :yValue "Sri Lanka" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "0.0242" ;
    :yValue "Germany" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "0.023" ;
    :yValue "Russia" ;
    :belongsTo :Chart .
