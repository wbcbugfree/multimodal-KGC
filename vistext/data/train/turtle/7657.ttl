@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Combined revenue of EY worldwide from 2009 to 2020 , by region (in billion U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Japan" .

:DataPoint1 a :DataPoint ;
    :xValue "2019" ;
    :yValue "1.21" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "2018" ;
    :yValue "1.13" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "2017" ;
    :yValue "1.11" ;
    :belongsTo :Chart .

