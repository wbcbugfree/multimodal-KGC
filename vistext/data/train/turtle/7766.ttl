@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Allotted paid vacation days compared to what is considered fair worldwide as of August 2014 , by country" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Allotted paid vacation days" .

:YAxis a :Axis ;
    :title "Response" .

:DataPoint1 a :DataPoint ;
    :xValue "18" ;
    :yValue "United States" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "19" ;
    :yValue "Japan" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "22" ;
    :yValue "Australia" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "24" ;
    :yValue "Brazil" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "24" ;
    :yValue "United Kingdom" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "24" ;
    :yValue "Spain" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "26" ;
    :yValue "Germany" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "27" ;
    :yValue "Italy" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "29" ;
    :yValue "Russia" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "31" ;
    :yValue "France" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "24" ;
    :yValue "World average" ;
    :belongsTo :Chart .
