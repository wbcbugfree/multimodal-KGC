@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Sales price of mixtures of nuts or dried fruits per kilogram manufactured in the United Kingdom (UK) from 2008 to 2018 (in GBP)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Price per kilogram in British pounds" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2007" ;
    :yValue "3.29" ;
    :belongsTo :Chart .

