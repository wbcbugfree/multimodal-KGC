@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Most commonly detected malicious file extensions worldwide from January to September 2017 , by detection share" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Share of detections" .

:YAxis a :Axis ;
    :title "Response" .

:DataPoint1 a :DataPoint ;
    :xValue "0.38" ;
    :yValue "Office" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "0.37" ;
    :yValue "Archive" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "0.14" ;
    :yValue "PDF" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "0.06" ;
    :yValue "Other extension" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "0.04" ;
    :yValue "Binaries" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "0.01" ;
    :yValue "XML/HTML/JS" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "0" ;
    :yValue "Apple" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "0" ;
    :yValue "Image" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "0" ;
    :yValue "Scripts" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "0" ;
    :yValue "Android" ;
    :belongsTo :Chart .
