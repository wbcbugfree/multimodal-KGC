@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Number of practicing nurses employed in Denmark from 2005 to 2018" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Number of employees" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2004" ;
    :yValue "51946" ;
    :belongsTo :Chart .

