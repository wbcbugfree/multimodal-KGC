@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Taste rating of selected sandwich restaurant chains in the United States as of July 2014" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "restaurant chain" .

:YAxis a :Axis ;
    :title "Taste rating" .

:DataPoint1 a :DataPoint ;
    :xValue "Portillo's Hot Dogs" ;
    :yValue "8.5" ;
    :belongsTo :Chart .

