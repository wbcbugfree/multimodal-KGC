    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Total uploaded video views in billions" .

:YAxis a :Axis ;
    :title "Most popular YouTube channels in South Korea" .

:DataPoint1 a :DataPoint ;
    :xValue "15.81" ;
    :yValue "SMTOWN" ;
