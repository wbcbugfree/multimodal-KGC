@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Share of young people reading magazines outside school in the United Kingdom (UK) in 2015 , by demographic group" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Demographic group" .

:YAxis a :Axis ;
    :title "Share of respondents" .

:DataPoint1 a :DataPoint ;
    :xValue "Boys" ;
    :yValue "0.35" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Girls" ;
    :yValue "0.507" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "KS2" ;
    :yValue "0.457" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "KS3" ;
    :yValue "0.43" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "KS4" ;
    :yValue "0.387" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "KS5" ;
    :yValue "0.46" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "White" ;
    :yValue "0.457" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Mixed" ;
    :yValue "0.419" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "Asian" ;
    :yValue "0.375" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "Black" ;
    :yValue "0.406" ;
    :belongsTo :Chart .
