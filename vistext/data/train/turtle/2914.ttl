@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Installed power capacity across Puducherry in India from financial year 2005 to 2018 (in megawatts)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Installed power capacity in megawatts" .

:DataPoint1 a :DataPoint ;
    :xValue "FY 2018" ;
    :yValue "368.61" ;
    :belongsTo :Chart .

