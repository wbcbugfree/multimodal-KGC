@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Percentage of U.S. women who had any mental illness in the past year from 2008 to 2019" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "Percentage of female respondents" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2007" ;
    :yValue "0.215" ;
    :belongsTo :Chart .

