@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Birth rate in Belgium from 2010 to 2022" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Number of children per woman" .

:DataPoint1 a :DataPoint ;
    :xValue "2022" ;
    :yValue "1.68" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "2021" ;
    :yValue "1.67" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "2020*" ;
    :yValue "1.66" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "2019" ;
    :yValue "1.65" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "2018" ;
    :yValue "1.63" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "2017" ;
    :yValue "1.64" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "2016" ;
    :yValue "1.67" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "2015" ;
    :yValue "1.69" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "2014" ;
    :yValue "1.73" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "2013" ;
    :yValue "1.74" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "2012" ;
    :yValue "1.79" ;
    :belongsTo :Chart .

:DataPoint12 a :DataPoint ;
    :xValue "2011" ;
    :yValue "1.81" ;
    :belongsTo :Chart .

:DataPoint13 a :DataPoint ;
    :xValue "2010" ;
    :yValue "1.84" ;
    :belongsTo :Chart .
