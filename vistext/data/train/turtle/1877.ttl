@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Corporate Social Responsibility (CSR) initiatives undertaken by online communication advertising companies in response to the coronavirus (COVID-19) pandemic in Poland in 2020" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "Share of respondents" .

:DataPoint1 a :DataPoint ;
    :xValue "Support of local businesses" ;
    :yValue "0.24" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Suport of health care workers" ;
    :yValue "0.21" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "Support of families with small children" ;
    :yValue "0.2" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "Money donations for hospitals" ;
    :yValue "0.17" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "Equipment donations for hospitals" ;
    :yValue "0.15" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Support of other groups" ;
    :yValue "0.15" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Support of SMEs" ;
    :yValue "0.11" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Support of seniors" ;
    :yValue "0.1" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "Other" ;
    :yValue "0.11" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "None" ;
    :yValue "0.34" ;
    :belongsTo :Chart .
