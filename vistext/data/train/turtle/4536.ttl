@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Outbound visitor growth in the Middle East from 2011 to 2022" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Year-on-year visitor growth" .

:DataPoint1 a :DataPoint ;
    :xValue "2022**" ;
    :yValue "0.058" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "2021**" ;
    :yValue "0.051" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "2020**" ;
    :yValue "0.046" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "2019**" ;
    :yValue "0.045" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "2018*" ;
    :yValue "0.039" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "2017" ;
    :yValue "0.026" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "2016" ;
    :yValue "-0.063" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "2015" ;
    :yValue "0.01" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "2014" ;
    :yValue "0.087" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "2013" ;
    :yValue "0.085" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "2012" ;
    :yValue "-0.103" ;
    :belongsTo :Chart .

:DataPoint12 a :DataPoint ;
    :xValue "2011" ;
    :yValue "-0.112" ;
    :belongsTo :Chart .
