@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Selected sawtimber stumpage prices in the U.S. from 2002 to 2015 , by species in U.S. dollars per 1,000 board feet)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Western hemlock" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2003" ;
    :yValue "63.2" ;
    :belongsTo :Chart .

