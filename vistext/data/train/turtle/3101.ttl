@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Labor productivity per person employed and hour worked in relation to the average gross domestic product (GDP) of the European Union (28 countries) in Germany from 2005 to 2016" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "GDP per person employed (EU28=100)" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2004" ;
    :yValue "108.5" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Dec 31, 2005" ;
    :yValue "107.9" ;
    :belongsTo :Chart .

