@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Leading video games ranked by sales volume in France in 2019 , by platform (in 1,000 units sold)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "video game" .

:YAxis a :Axis ;
    :title "Units sold in 1,000s" .

:DataPoint1 a :DataPoint ;
    :xValue "FIFA 20 (PS4)" ;
    :yValue "892.81" ;
    :belongsTo :Chart .

