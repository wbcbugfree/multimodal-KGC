@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Countries with the highest rates of prostate cancer worldwide in 2018 (per 100,000 population)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Country" .

:YAxis a :Axis ;
    :title "Rate per 100,000 population" .

