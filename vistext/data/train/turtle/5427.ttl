@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Average age of men at first marriage in Italy in 2018 , by region" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "region of Italy" .

:YAxis a :Axis ;
    :title "Age in years" .

