@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Number of asylum applications in Sweden from 2009 to 2019" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Number of applications" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2008" ;
    :yValue "24194" ;
    :belongsTo :Chart .

