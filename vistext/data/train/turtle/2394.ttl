@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Number of new coronavirus (COVID-19) cases in Europe from January 25 , 2020 to January 3 , 2021 , by date of report" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Week ending" .

:YAxis a :Axis ;
    :title "Number of new cases" .

