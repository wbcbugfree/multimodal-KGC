@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Sales volume of Hyundai cars across India in 2019 , by model (in 1,000s)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Number of vehicles sold in thousands" .

:YAxis a :Axis ;
    :title "automobile model" .

:DataPoint1 a :DataPoint ;
    :xValue "123.2" ;
    :yValue "i20 Elite" ;
    :belongsTo :Chart .

