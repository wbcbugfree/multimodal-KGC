@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Atlanta Braves all-time hits leaders as of October 2020" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Number of hits" .

:YAxis a :Axis ;
    :title "Player" .

:DataPoint1 a :DataPoint ;
    :xValue "3600" ;
    :yValue "Hank Aaron" ;
    :belongsTo :Chart .

