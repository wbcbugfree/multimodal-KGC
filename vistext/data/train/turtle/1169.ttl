@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Annual net revenue generated by Activision Blizzard from 2005 to 2019 (in million U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Net revenue in million U.S. dollars" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2004" ;
    :yValue "780" ;
    :belongsTo :Chart .

