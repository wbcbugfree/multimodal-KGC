@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Population of Polish regions from 2017 to 2019 (in 1,000s)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "2017" .

:YAxis a :Axis ;
    :title "Polish regions" .

:DataPoint1 a :DataPoint ;
    :xValue "2902.5" ;
    :yValue "Dolnośląskie" ;
    :belongsTo :Chart .

