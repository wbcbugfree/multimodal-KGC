@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Number of employees of the fishing , hunting and trapping industry in Canada from 2008 to 2019 (in 1,000s)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Number of employees in thousands" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2007" ;
    :yValue "21.8" ;
    :belongsTo :Chart .

