@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Weatherford International 's revenue from 2007 to 2019 (in million U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Revenue in million U.S. dollars" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2006" ;
    :yValue "7832" ;
    :belongsTo :Chart .

