@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Most common registered first names for females in Poland as of January 2020 (in 1,000s)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "female given name" .

:YAxis a :Axis ;
    :title "Number of registered names in thousands" .

