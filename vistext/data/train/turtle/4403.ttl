@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Leading fashion brands on Twitter as of July 2018 , by followers (in millions)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Fashion brand" .

:YAxis a :Axis ;
    :title "Brand fans in millions" .

:DataPoint1 a :DataPoint ;
    :xValue "Chanel" ;
    :yValue "13.29" ;
    :belongsTo :Chart .

