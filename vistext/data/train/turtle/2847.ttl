@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Electronic components & boards , communication equipment and consumer electronics manufacturing value added in Malaysia from 2010 to 2019 (in billion Malaysian ringgit)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Sales value in billion Malaysian ringgit (RM)" .

:YAxis a :Axis ;
    :title "Year" .

:DataPoint1 a :DataPoint ;
    :xValue "60.08" ;
    :yValue "2019**" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "56.8" ;
    :yValue "2018*" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "55.42" ;
    :yValue "2017" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "50.72" ;
    :yValue "2016" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "46.72" ;
    :yValue "2015" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "44.08" ;
    :yValue "2014" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "37.79" ;
    :yValue "2013" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "34.85" ;
    :yValue "2012" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "33.48" ;
    :yValue "2011" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "34.12" ;
    :yValue "2010" ;
    :belongsTo :Chart .
