    :xValue "935" ;
    :yValue "Iran" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "513" ;
    :yValue "Taiwan" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "452" ;
    :yValue "Turkey" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "424" ;
    :yValue "Canada" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "177" ;
    :yValue "Thailand" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
