@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Number of temporary visa holders completing a doctorate at a U.S. university in 2018 , by country of origin" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Number of doctorate students" .

:YAxis a :Axis ;
    :title "Country" .

:DataPoint1 a :DataPoint ;
    :xValue "6182" ;
    :yValue "China*" ;
    :belongsTo :Chart .

