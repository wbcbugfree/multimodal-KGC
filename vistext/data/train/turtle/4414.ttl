@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Total number of drug deaths in the Netherlands from 2006 to 2018" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Total number of deaths" .

:DataPoint1 a :DataPoint ;
    :xValue "2018" ;
    :yValue "224" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "2017" ;
    :yValue "262" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "2016" ;
    :yValue "235" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "2015" ;
    :yValue "198" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "2014" ;
    :yValue "123" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "2013*" ;
    :yValue "152" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "2012" ;
    :yValue "118" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "2011" ;
    :yValue "103" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "2010" ;
    :yValue "94" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
