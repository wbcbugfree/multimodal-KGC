@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Value of merchandise exports from China 's Greater Bay Area cities in 2018 and 2019 , by city (in billion U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "city of China" .

:YAxis a :Axis ;
    :title "2018" .

:DataPoint1 a :DataPoint ;
    :xValue "Hong Kon" ;
    :yValue "530.44" ;
    :belongsTo :Chart .

