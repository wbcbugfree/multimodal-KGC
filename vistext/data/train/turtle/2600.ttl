    :xValue "Dec 31, 2011" ;
    :yValue "105.66" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Dec 31, 2012" ;
    :yValue "94.66" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
