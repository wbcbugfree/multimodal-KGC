@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Number of fatalities in traffic accidents in Belgium in 2019 , by age and region" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "WalloonRegion" .

:DataPoint1 a :DataPoint ;
    :xValue "0-4" ;
    :yValue "0" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "5-9" ;
    :yValue "3" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "10-14" ;
    :yValue "3" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "15-19" ;
    :yValue "16" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "20-24" ;
    :yValue "37" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "25-29" ;
    :yValue "31" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "30-34" ;
    :yValue "29" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "35-39" ;
    :yValue "20" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "40-44" ;
    :yValue "23" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "45-49" ;
    :yValue "21" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "50-54" ;
    :yValue "23" ;
    :belongsTo :Chart .

:DataPoint12 a :DataPoint ;
    :xValue "55-59" ;
    :yValue "20" ;
    :belongsTo :Chart .

:DataPoint13 a :DataPoint ;
    :xValue "60-64" ;
    :yValue "5" ;
    :belongsTo :Chart .

:DataPoint14 a :DataPoint ;
    :xValue "65-69" ;
    :yValue "15" ;
    :belongsTo :Chart .

:DataPoint15 a :DataPoint ;
    :xValue "70-74" ;
    :yValue "13" ;
    :belongsTo :Chart .

:DataPoint16 a :DataPoint ;
    :xValue "75 and older" ;
    :yValue "29" ;
    :belongsTo :Chart .

:DataPoint17 a :DataPoint ;
    :xValue "Information unavailable" ;
    :yValue "0" ;
    :belongsTo :Chart .
