@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Number of millionaire households in selected European countries as of 2014" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Country" .

:YAxis a :Axis ;
    :title "Number of millionaire households" .

