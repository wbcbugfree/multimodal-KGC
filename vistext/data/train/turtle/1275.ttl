@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Number of immigrants from Asia living in Sweden in 2019 , by countries of birth" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Number of immigrants" .

:YAxis a :Axis ;
    :title "Country" .

