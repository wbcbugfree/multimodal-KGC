@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Public sector net investment (excluding temporary effects of financial interventions) in the United Kingdom (UK) from 2004 to 2018 (in million GBP)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Net investment in million GBP" .

