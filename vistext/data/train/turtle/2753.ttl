@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Gambling gross win per capita for the leading ten gambling markets in 2013 (in U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Country" .

:YAxis a :Axis ;
    :title "Gambling gross win in U.S. dollars" .

:DataPoint1 a :DataPoint ;
    :xValue "Australia" ;
    :yValue "487.17" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Italy" ;
    :yValue "245.21" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "United States" ;
    :yValue "233.28" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "Canada" ;
    :yValue "230.02" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "Britain" ;
    :yValue "195.3" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Spain" ;
    :yValue "166.01" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Japan" ;
    :yValue "154.07" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "France" ;
    :yValue "125.86" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "Germany" ;
    :yValue "115.01" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "China" ;
    :yValue "34.72" ;
    :belongsTo :Chart .
