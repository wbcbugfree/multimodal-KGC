@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Leading silver producing countries worldwide in 2019 (in million ounces)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Country" .

:YAxis a :Axis ;
    :title "Production in million ounces" .

