@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Annual expenditure on veterinary and other pet services in the United Kingdom from 2005 to 2019 , by volume (in million GBP)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Expenditure in million GBP" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2004" ;
    :yValue "2023" ;
    :belongsTo :Chart .

