@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Number of registered passenger cars on the road in Finland in 2018 , by region" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Number of registered passenger cars" .

:YAxis a :Axis ;
    :title "region of Finland" .

