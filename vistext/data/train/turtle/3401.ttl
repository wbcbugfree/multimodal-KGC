@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Mashriq region : Gross domestic product (GDP) in 2018 , by country (in billion international dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Country" .

:YAxis a :Axis ;
    :title "GDP in billion international dollars" .

:DataPoint1 a :DataPoint ;
    :xValue "Saudi Arabia" ;
    :yValue "1862.15" ;
    :belongsTo :Chart .

