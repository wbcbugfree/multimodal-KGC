@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Leading wicket-takers in The Ashes in 2019" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Number of wickets taken" .

:YAxis a :Axis ;
    :title "cricketer" .

:DataPoint1 a :DataPoint ;
    :xValue "29" ;
    :yValue "Pat Cummins (Australia)" ;
    :belongsTo :Chart .

