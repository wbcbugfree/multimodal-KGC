@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Leading ten banks in Italy as of September 2020 , by number of branches" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Number of branches" .

:YAxis a :Axis ;
    :title "bank" .

:DataPoint1 a :DataPoint ;
    :xValue "3285" ;
    :yValue "Intesa Sanpaolo" ;
    :belongsTo :Chart .

