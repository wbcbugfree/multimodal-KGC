    :yValue "Banca Monte dei Paschi di Siena" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "944" ;
    :yValue "BPER Banca" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "729" ;
    :yValue "Banco Nazionale del Lavoro" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "544" ;
