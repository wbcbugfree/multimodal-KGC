@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Bosnia & Herzegovina : Distribution of gross domestic product (GDP) across economic sectors from 2009 to 2019" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Agriculture" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2008" ;
    :yValue "0.0708" ;
    :belongsTo :Chart .

