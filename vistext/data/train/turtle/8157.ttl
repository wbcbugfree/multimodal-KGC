@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Availability of broadband internet (at least 1 Mbit/s) to households in Germany from 2010 to 2018" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "year" .

:YAxis a :Axis ;
    :title "Wireless (UMTS, LTE, WiMAX, WLAN)" .

:DataPoint1 a :DataPoint ;
    :xValue "End 2018" ;
    :yValue "0.989" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Mid 2018" ;
    :yValue "0.985" ;
    :belongsTo :Chart .

