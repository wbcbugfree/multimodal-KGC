@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Share of smokers aged 14 years and older in Italy in 2018 , by region" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Share of smokers" .

:YAxis a :Axis ;
    :title "Response" .

