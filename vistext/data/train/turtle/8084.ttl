@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Capcom 's annual net sales in the fiscal years 2008 to 2020 , by operating segment (in billion yen)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Month" .

:YAxis a :Axis ;
    :title "Amusement equipment" .

:DataPoint1 a :DataPoint ;
    :xValue "April 1, 2019 to March 31, 2020" ;
    :yValue "6.53" ;
    :belongsTo :Chart .

