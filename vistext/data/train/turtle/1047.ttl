@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Average number of daily brand posts on Instagram in 2019 , by vertical" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Number of Instagram posts per day" .

:YAxis a :Axis ;
    :title "brand" .

