@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Global paper production volume from 2008 to 2018 by type (in 1,000 metric tons)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Graphic paper" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2007" ;
    :yValue "151489" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Dec 31, 2008" ;
    :yValue "136385" ;
    :belongsTo :Chart .

