@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Number of sent and received SMS messages in Singapore from 2009 to 2019 (in millions)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Number of SMS mesaages in millions" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2008" ;
    :yValue "23287.2" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Dec 31, 2009" ;
    :yValue "27714.3" ;
    :belongsTo :Chart .

