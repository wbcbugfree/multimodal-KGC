@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Revenue of the InterContinental Hotels Group (IHG) from 2008 to 2019 , by hotel ownership type (in million U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Franchised hotels" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2007" ;
    :yValue "623" ;
    :belongsTo :Chart .

