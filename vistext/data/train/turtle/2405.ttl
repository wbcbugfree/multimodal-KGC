@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Registered cases of drug trafficking in Belgium from 2008 to the first semester of 2019" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Cases of drug trafficking" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2007" ;
    :yValue "7522" ;
    :belongsTo :Chart .

