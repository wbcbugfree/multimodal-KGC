@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Number of passengers carried by air in the European Union (EU-28) from 2008 to 2019 (in millions)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Number of air passengers in millions" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2007" ;
    :yValue "800.08" ;
    :belongsTo :Chart .

