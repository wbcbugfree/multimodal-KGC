@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Atlanta Braves all-time games played leaders as of October 2020" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Atlanta Braves all-time games played leaders" .

:YAxis a :Axis ;
    :title "Number of games played" .

:DataPoint1 a :DataPoint ;
    :xValue "Hank Aaron" ;
    :yValue "3076" ;
    :belongsTo :Chart .

