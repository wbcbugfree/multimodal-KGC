@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Population of the Caribbean Netherlands from 2011 to 2020" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Number of people" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2010" ;
    :yValue "21087" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Dec 31, 2011" ;
    :yValue "22304" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "Dec 31, 2012" ;
    :yValue "23296" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "Dec 31, 2013" ;
    :yValue "24279" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "Dec 31, 2014" ;
    :yValue "24593" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Dec 31, 2015" ;
    :yValue "24548" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Dec 31, 2016" ;
    :yValue "24439" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Dec 31, 2017" ;
    :yValue "25052" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "Dec 31, 2018" ;
    :yValue "25157" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "Dec 31, 2019" ;
    :yValue "25987" ;
    :belongsTo :Chart .
