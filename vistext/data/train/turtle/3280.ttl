@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Total number of employees in the manufacturing industry of chemicals and chemical products in the Netherlands from 2008 to 2018" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Number of employees" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2007" ;
    :yValue "48503" ;
    :belongsTo :Chart .

