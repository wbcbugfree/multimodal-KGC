@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Iceland : Unemployment rate from 2009 to 2021" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Unemployment rate" .

:DataPoint1 a :DataPoint ;
    :xValue "2021*" ;
    :yValue "0.07" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "2020*" ;
    :yValue "0.08" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "2019*" ;
    :yValue "0.0355" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "2018" ;
    :yValue "0.0274" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "2017" ;
    :yValue "0.0283" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "2016" ;
    :yValue "0.0301" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "2015" ;
    :yValue "0.0399" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "2014" ;
    :yValue "0.0496" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "2013" ;
    :yValue "0.0539" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "2012" ;
    :yValue "0.0603" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "2011" ;
    :yValue "0.0705" ;
    :belongsTo :Chart .

:DataPoint12 a :DataPoint ;
    :xValue "2010" ;
    :yValue "0.0756" ;
    :belongsTo :Chart .

:DataPoint13 a :DataPoint ;
    :xValue "2009" ;
    :yValue "0.0723" ;
    :belongsTo :Chart .
