@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Leading movies in China in 2019 , by box office revenue (in million yuan)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "film" .

:YAxis a :Axis ;
    :title "Revenue in million yuan" .

:DataPoint1 a :DataPoint ;
    :xValue "Ne Zha" ;
    :yValue "5003.46" ;
    :belongsTo :Chart .

