@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "U.S. light vehicle imports in 2019 , by source country (in billion U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Import value in billion U.S. dollars" .

:YAxis a :Axis ;
    :title "Country" .

:DataPoint1 a :DataPoint ;
    :xValue "58.36" ;
    :yValue "Mexico" ;
    :belongsTo :Chart .

