@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Number of passenger cars in use in Germany from 2005 to 2015 (in 1,000 units)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Number of passenger cars in thousand units" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2004" ;
    :yValue "46090" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Dec 31, 2005" ;
    :yValue "46570" ;
    :belongsTo :Chart .

