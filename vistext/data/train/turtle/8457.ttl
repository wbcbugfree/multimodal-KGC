@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Mortality rates in the armed forces of the United Kingdom (UK) from 2006 to 2019 , by branch (per 100,000 personnel)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "RAF" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2005" ;
    :yValue "92" ;
    :belongsTo :Chart .

