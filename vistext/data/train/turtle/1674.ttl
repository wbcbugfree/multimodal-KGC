    :xValue "Dec 31, 2011" ;
    :yValue "74.88" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Dec 31, 2012" ;
    :yValue "75.07" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
