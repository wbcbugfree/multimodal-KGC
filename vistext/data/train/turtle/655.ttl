@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Turnover volume index for the retail trade in the European Union (28 countries) from December 2017 to November 2018" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Month" .

:YAxis a :Axis ;
    :title "Index (100 = 2015)*" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 17" ;
    :yValue "106.1" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Jan 18" ;
    :yValue "109.6" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "Feb 18" ;
    :yValue "128" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "Mar 18" ;
    :yValue "98.9" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "Apr 18" ;
    :yValue "94" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "May 18" ;
    :yValue "104" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Jun 18" ;
    :yValue "104.2" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Jul 18" ;
    :yValue "106.9" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "Aug 18" ;
    :yValue "107" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "Sep 18" ;
    :yValue "108.1" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "Oct 18" ;
    :yValue "109" ;
    :belongsTo :Chart .

:DataPoint12 a :DataPoint ;
    :xValue "Nov 18" ;
    :yValue "111.9" ;
    :belongsTo :Chart .
