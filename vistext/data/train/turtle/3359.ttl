@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Hospital admission episodes for dog bites and strikes per 100,000 population in England from March 2014 to February 2015 , by socio-demographic group" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Incidents per 100,000 population" .

:DataPoint1 a :DataPoint ;
    :xValue "1" ;
    :yValue "24.439" ;
    :belongsTo :Chart .

