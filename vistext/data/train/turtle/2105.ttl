@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Volume of almonds imported to Canada from 2010/11 to 2020/21 (in 1,000 metric tons)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Import volume in thousand metric tons" .

:DataPoint1 a :DataPoint ;
    :xValue "2020/21*" ;
    :yValue "35" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "2019/20" ;
    :yValue "29.7" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "2018/19" ;
    :yValue "29.6" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "2017/18" ;
    :yValue "35.6" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "2016/17" ;
    :yValue "35.5" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "2015/16" ;
    :yValue "32.8" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "2014/15" ;
    :yValue "35" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "2013/14" ;
    :yValue "33.7" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "2012/13" ;
    :yValue "31.2" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "2011/12" ;
    :yValue "28.4" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "2010/11" ;
    :yValue "27.6" ;
    :belongsTo :Chart .
