@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Online shopping cart abandonment rate worldwide from 2006 to 2019" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Shopping cart abandonment rate" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2005" ;
    :yValue "0.598" ;
    :belongsTo :Chart .

