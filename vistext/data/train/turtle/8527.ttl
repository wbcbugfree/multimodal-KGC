@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Annual Flemish education budget in Belgium from 2010 to 2019 , by educational level (in thousand euros)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Tertiary education" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2009" ;
    :yValue "1652037" ;
    :belongsTo :Chart .

