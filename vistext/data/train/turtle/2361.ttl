@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Distribution of Vinci 's revenue in FY 2019 , by region" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Country" .

:YAxis a :Axis ;
    :title "Revenue distribution" .

:DataPoint1 a :DataPoint ;
    :xValue "France" ;
    :yValue "0.547" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Other European countries" ;
    :yValue "0.078" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "North America" ;
    :yValue "0.066" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "Germany" ;
    :yValue "0.065" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "UK" ;
    :yValue "0.062" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Asia Pacific and Middel East**" ;
    :yValue "0.054" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Central and Eastern Europe*" ;
    :yValue "0.046" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Africa" ;
    :yValue "0.033" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "Central and South America" ;
    :yValue "0.026" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "Portugal" ;
    :yValue "0.021" ;
    :belongsTo :Chart .
