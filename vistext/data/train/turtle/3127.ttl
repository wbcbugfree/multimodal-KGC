@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Sub-Saharan Africa : Gross domestic product (GDP) in current prices from 2014 to 2024 (in billion U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Gross domestic product in billion U.S. dollars" .

:DataPoint1 a :DataPoint ;
    :xValue "2024*" ;
    :yValue "2460.12" ;
    :belongsTo :Chart .

