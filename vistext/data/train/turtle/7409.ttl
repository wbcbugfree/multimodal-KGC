@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Number of inhabitants in Norway from 2010 to 2020 , by citizenship (in millions)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Norwegian citizenship" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2009" ;
    :yValue "4.52" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Dec 31, 2010" ;
    :yValue "4.55" ;
    :belongsTo :Chart .

