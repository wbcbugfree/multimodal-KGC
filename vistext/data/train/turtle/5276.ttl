@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "American customer satisfaction index scores for Olive Garden restaurants in the United States from 2007 to 2020" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "ACSI score" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2006" ;
    :yValue "80" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Dec 31, 2007" ;
    :yValue "82" ;
    :belongsTo :Chart .

