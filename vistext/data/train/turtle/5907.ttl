@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Estimated aggregate revenue of U.S. newspaper publishers from 2005 to 2018 (in billion U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Estimated revenue in billion U.S. dollars" .

