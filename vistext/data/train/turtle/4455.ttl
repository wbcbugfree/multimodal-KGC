@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Worldwide mobile app revenues in 2014 to 2023 (in billion U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Revenue in billion U.S. dollars" .

:YAxis a :Axis ;
    :title "Year" .

:DataPoint1 a :DataPoint ;
    :xValue "935.2" ;
    :yValue "2023*" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "808.7" ;
    :yValue "2022*" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "693" ;
    :yValue "2021*" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "581.9" ;
    :yValue "2020*" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "461.7" ;
    :yValue "2019*" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "365.2" ;
    :yValue "2018" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "285.3" ;
    :yValue "2017" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "218.2" ;
    :yValue "2016" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "152" ;
    :yValue "2015" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "97.7" ;
    :yValue "2014" ;
    :belongsTo :Chart .
