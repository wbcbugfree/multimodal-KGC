    :xValue "Dec 31, 2011" ;
    :yValue "23253" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Dec 31, 2012" ;
    :yValue "23187" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Dec 31, 2013" ;
    :yValue "22843" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Dec 31, 2014" ;
    :yValue "24501" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
