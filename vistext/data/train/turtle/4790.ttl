@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Houston Astros all-time home run leaders as of October 2020" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Number of home runs" .

:YAxis a :Axis ;
    :title "player" .

:DataPoint1 a :DataPoint ;
    :xValue "449" ;
    :yValue "Jeff Bagwell" ;
    :belongsTo :Chart .

