@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Leading ten items consumers will shop for over Black Friday/Cyber weekend in the United Kingdom (UK) in 2018" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "Share of respondents" .

:DataPoint1 a :DataPoint ;
    :xValue "Clothing, footwear or accessories" ;
    :yValue "0.24" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Personal gadgets (smartphones, tablets, etc.)" ;
    :yValue "0.23" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "Home electronics (TVs, speakers etc.)" ;
    :yValue "0.23" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "DVDs, Computer games and books" ;
    :yValue "0.16" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "Cosmetics and perfume" ;
    :yValue "0.15" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Toys" ;
    :yValue "0.15" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Homewares (crockery, furniture, furnishings etc.)" ;
    :yValue "0.1" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "White goods (refrigerators, washing machines etc.)" ;
    :yValue "0.08" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "Food" ;
    :yValue "0.08" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "Alcohol" ;
    :yValue "0.07" ;
    :belongsTo :Chart .
