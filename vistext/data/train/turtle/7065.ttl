@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Total government expenditure in the Netherlands from 2007 to 2017 , by type of expenditure (in million euros)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Other expenditure" .

:YAxis a :Axis ;
    :title "Year" .

:DataPoint1 a :DataPoint ;
    :xValue "31543" ;
    :yValue "2017*" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "30642" ;
    :yValue "2016*" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "35648" ;
    :yValue "2015" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "36688" ;
    :yValue "2014" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "34368" ;
    :yValue "2013" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "38869" ;
    :yValue "2012" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "39752" ;
    :yValue "2011" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "43326" ;
    :yValue "2010" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "43063" ;
    :yValue "2009" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
