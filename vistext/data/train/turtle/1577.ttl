@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Number of deaths caused by police intervention in the state of Rio de Janeiro , Brazil from 2003 to 2020" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Number of deaths" .

