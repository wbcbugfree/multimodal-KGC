@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Global search engine market share as of January 2020 , by search query size" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "search query size" .

:YAxis a :Axis ;
    :title "Ask" .

:DataPoint1 a :DataPoint ;
    :xValue "Total" ;
    :yValue "0.0004" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "One word" ;
    :yValue "0.0011" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "Two words" ;
    :yValue "0.0005" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "Three words" ;
    :yValue "0.0004" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "Four words" ;
    :yValue "0.0003" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Five words" ;
    :yValue "0.0003" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Six words" ;
    :yValue "0.0003" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Seven words" ;
    :yValue "0.0003" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "Eight words" ;
    :yValue "0.0003" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "Nine words" ;
    :yValue "0.0004" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "Ten or more words" ;
    :yValue "0.0003" ;
    :belongsTo :Chart .
