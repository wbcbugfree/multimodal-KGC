@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Percentage of global population accessing the internet from 2005 to 2019 , by market maturity" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "World" .

:YAxis a :Axis ;
    :title "Year" .

:DataPoint1 a :DataPoint ;
    :xValue "0.536" ;
    :yValue "2019*" ;
    :belongsTo :Chart .

