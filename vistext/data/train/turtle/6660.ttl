@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Number of visitors to national parks and sites in the United States from 2010 to 2019 , by type of park (in millions)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "2014" .

:YAxis a :Axis ;
    :title "national parks and sites" .

:DataPoint1 a :DataPoint ;
    :xValue "68.93" ;
    :yValue "National Park" ;
    :belongsTo :Chart .

