@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Total points scored by the men 's national rugby team in Italy in the Six Nations Championship from 2009 to 2020" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Points scored" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2008" ;
    :yValue "49" ;
    :belongsTo :Chart .

