@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Number and change of coronavirus (COVID-19) cases and deaths among the most impacted countries worldwide as of December 14 , 2020" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Total number of deaths" .

:YAxis a :Axis ;
    :title "Country" .

:DataPoint1 a :DataPoint ;
    :xValue "299177" ;
    :yValue "United States" ;
    :belongsTo :Chart .

