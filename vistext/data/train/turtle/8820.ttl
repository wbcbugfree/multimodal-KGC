@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Digital and print advertising revenue of U.S. newspapers from 2003 to 2014 (in billion U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Print" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2002" ;
    :yValue "44.94" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Dec 31, 2003" ;
    :yValue "46.7" ;
    :belongsTo :Chart .

