@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Number of passenger cars registered in Finland in 2019 , by leading brand" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Brand" .

:YAxis a :Axis ;
    :title "Numbers of cars" .

