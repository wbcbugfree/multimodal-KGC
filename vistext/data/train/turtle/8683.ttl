@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "France : Government revenue and spending from 2014 to 2024 (in billion euros)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Revenue" .

:DataPoint1 a :DataPoint ;
    :xValue "2024*" ;
    :yValue "1430.59" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "2023*" ;
    :yValue "1387.98" ;
    :belongsTo :Chart .

