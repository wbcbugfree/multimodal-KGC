    :xValue "2020*" ;
    :yValue "1287.6" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "2019*" ;
    :yValue "1262.96" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "2018" ;
