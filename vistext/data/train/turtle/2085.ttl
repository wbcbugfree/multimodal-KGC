@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Wi-Fi speed in selected hotels in Las Vegas as of August 2017" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "hotel" .

:YAxis a :Axis ;
    :title "Expected Wi-Fi speed in Mbps*" .

:DataPoint1 a :DataPoint ;
    :xValue "Plaza Hotel & Casino" ;
    :yValue "38.7" ;
    :belongsTo :Chart .

