@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Number of U.S. youth and young adult population from 2000 to 2010 , age group 14 to 24 (in millions)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "U.S. youth population in millions" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 1999" ;
    :yValue "43.45" ;
    :belongsTo :Chart .

