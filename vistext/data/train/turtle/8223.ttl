@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Air cargo traffic worldwide from 2007 to 2019 , by freight type (in billion revenue ton kilometers)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Mail" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2006" ;
    :yValue "5.35" ;
    :belongsTo :Chart .

