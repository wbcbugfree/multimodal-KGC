@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Number of confirmed cases of coronavirus (COVID-19) in Spain as of January 5 , 2021 , by autonomous community" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "autonomous community of Spain" .

:YAxis a :Axis ;
    :title "Number of cases" .

:DataPoint1 a :DataPoint ;
    :xValue "Community of Madrid" ;
    :yValue "408040" ;
    :belongsTo :Chart .

