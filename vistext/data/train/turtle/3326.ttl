@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Unhappiest jobs in the United States 2012 , as rated by workers" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Unhappiest jobs" .

:YAxis a :Axis ;
    :title "Career Bliss rating" .

:DataPoint1 a :DataPoint ;
    :xValue "Marketing Director" ;
    :yValue "3.69" ;
    :belongsTo :Chart .

