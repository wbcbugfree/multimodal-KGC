@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Merchandise sales of Dollar General in the United States from 2009 to 2019 , by product category (in million U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Seasonal" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2008" ;
    :yValue "1711.5" ;
    :belongsTo :Chart .

