@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Gross output of total United States mining industry from 1998 to 2019 (in billion U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Gross output in billion U.S. dollars" .

