@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Average cigarette prices in Canada from 2006 to 2014 , by region (in Canadian dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "region of Canada" .

:YAxis a :Axis ;
    :title "Apr 17, 2009" .

:DataPoint1 a :DataPoint ;
    :xValue "British Columbia" ;
    :yValue "87.4" ;
    :belongsTo :Chart .

