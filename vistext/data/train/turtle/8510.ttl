@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Number of persons covered by life insurance on the domestic market in Italy from 2004 to 2017 , by type of contract (in millions)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Group life insurance" .

