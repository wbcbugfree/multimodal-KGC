@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Average retail price for roasted coffee in Canada from January 2015 to June 2020 (in Canadian dollars per 300 grams)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Month" .

:YAxis a :Axis ;
    :title "2017" .

:DataPoint1 a :DataPoint ;
    :xValue "De" ;
    :yValue "6.31" ;
    :belongsTo :Chart .

