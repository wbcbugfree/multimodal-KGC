@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Share of rural population in Malaysia from 2005 to 2018" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "Share of population" .

