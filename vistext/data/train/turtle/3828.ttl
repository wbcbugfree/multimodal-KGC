@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Where do you plan to buy your fancy dress ?" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "Share of respondents" .

:DataPoint1 a :DataPoint ;
    :xValue "Supermarket chain" ;
    :yValue "0.371" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Amazon" ;
    :yValue "0.2" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "Discount supermarket" ;
    :yValue "0.143" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "Pound shop or discount store" ;
    :yValue "0.143" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "eBay" ;
    :yValue "0.143" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Online fancy dress shop" ;
    :yValue "0.114" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Charity shop" ;
    :yValue "0.105" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Independent fancy dress shop" ;
    :yValue "0.095" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "Clothing store" ;
    :yValue "0.095" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "Department store" ;
    :yValue "0.067" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "Argos or other catalogue retailer" ;
    :yValue "0.067" ;
    :belongsTo :Chart .

:DataPoint12 a :DataPoint ;
    :xValue "Elsewhere online" ;
    :yValue "0.067" ;
    :belongsTo :Chart .

:DataPoint13 a :DataPoint ;
    :xValue "Other" ;
    :yValue "0.057" ;
    :belongsTo :Chart .
