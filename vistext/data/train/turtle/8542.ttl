@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Global box office revenue from 2004 to 2019 , by region (in billion U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Europe, Middle East and Africa" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2003" ;
    :yValue "10.4" ;
    :belongsTo :Chart .

