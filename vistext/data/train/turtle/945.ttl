@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Happy Planet Index ranking of the worst countries for offering happy and sustainable lives to their people in 2016" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Country" .

:YAxis a :Axis ;
    :title "Happy Planet Index score" .

:DataPoint1 a :DataPoint ;
    :xValue "Chad" ;
    :yValue "12.8" ;
    :belongsTo :Chart .

