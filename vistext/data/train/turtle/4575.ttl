@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Reserves of tungsten worldwide in 2019 , by country (in metric tons)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Reserves in metric tons" .

:YAxis a :Axis ;
    :title "Country" .

:DataPoint1 a :DataPoint ;
    :xValue "1900000" ;
    :yValue "China" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "240000" ;
    :yValue "Russia" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "95000" ;
    :yValue "Vietnam" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "54000" ;
    :yValue "Spain" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "44000" ;
    :yValue "United Kingdom" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "29000" ;
    :yValue "North Korea" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "10000" ;
    :yValue "Austria" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "3100" ;
    :yValue "Portugal" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "820000" ;
    :yValue "Other countries" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "3200000" ;
    :yValue "World total**" ;
    :belongsTo :Chart .
