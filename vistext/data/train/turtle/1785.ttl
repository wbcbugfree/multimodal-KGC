@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Installed solar photovoltaic capacity in Spain in 2019 , by autonomous community (in megawatts)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Installed power in MW" .

:YAxis a :Axis ;
    :title "autonomous community of Spain" .

