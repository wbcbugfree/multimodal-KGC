    :xValue "616.44" ;
    :yValue "India" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "304.35" ;
    :yValue "Japan" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "264.49" ;
    :yValue "Indonesia" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "232.77" ;
    :yValue "Turkey" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "212.25" ;
    :yValue "Republic of Korea" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
