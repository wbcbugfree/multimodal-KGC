@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Tobacco production value worldwide in 2016 , by country (in million U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Production value in million U.S. dollars**" .

:YAxis a :Axis ;
    :title "Country" .

:DataPoint1 a :DataPoint ;
    :xValue "3434.02" ;
    :yValue "China, mainland" ;
    :belongsTo :Chart .

