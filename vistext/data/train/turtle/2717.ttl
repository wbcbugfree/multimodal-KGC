@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "How long do you think the lockdown measures in the UK will be in place ?" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Share of respondents" .

:YAxis a :Axis ;
    :title "Response" .

:DataPoint1 a :DataPoint ;
    :xValue "0.05" ;
    :yValue "Until beginning of June" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "0.06" ;
    :yValue "Until mid June" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "0.13" ;
    :yValue "Until end of June" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "0.08" ;
    :yValue "Until mid July" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "0.13" ;
    :yValue "Until end of July" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "0.06" ;
    :yValue "Until mid August" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "0.12" ;
    :yValue "Until end of August" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "0.06" ;
    :yValue "Until mid September" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "0.06" ;
    :yValue "Until end of September" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "0.02" ;
    :yValue "Until mid October" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "0.04" ;
    :yValue "Until end of October" ;
    :belongsTo :Chart .

:DataPoint12 a :DataPoint ;
    :xValue "0.01" ;
    :yValue "Until mid November" ;
    :belongsTo :Chart .

:DataPoint13 a :DataPoint ;
    :xValue "0.01" ;
    :yValue "Until end of November" ;
    :belongsTo :Chart .

:DataPoint14 a :DataPoint ;
    :xValue "0.01" ;
    :yValue "Until mid December" ;
    :belongsTo :Chart .

:DataPoint15 a :DataPoint ;
    :xValue "0.02" ;
    :yValue "Until end of December" ;
    :belongsTo :Chart .

:DataPoint16 a :DataPoint ;
    :xValue "0.14" ;
    :yValue "Until after December 2020" ;
    :belongsTo :Chart .
