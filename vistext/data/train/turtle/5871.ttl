@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Number of homicides in Brazil from 2006 to 2018" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Number of homicides" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2005" ;
    :yValue "49704" ;
    :belongsTo :Chart .

