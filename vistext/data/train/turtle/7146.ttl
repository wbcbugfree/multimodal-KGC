@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Revenues of BT Wholesale from 1st quarter of 2014/15 to 4th quarter of 2017/18 , by type of service (in million GBP)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Mobile" .

:YAxis a :Axis ;
    :title "Quarter" .

