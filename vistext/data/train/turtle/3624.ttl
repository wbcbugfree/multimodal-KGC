@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Most expensive drugs in the U.S. based on annual list price as of 2020" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Drug" .

:YAxis a :Axis ;
    :title "List price per year in U.S. dollars" .

:DataPoint1 a :DataPoint ;
    :xValue "Zolgensma (AveXis)" ;
    :yValue "2125000" ;
    :belongsTo :Chart .

