    :xValue "5.03" ;
    :yValue "gazeta.pl" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "4.72" ;
    :yValue "fakt.pl" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "4.08" ;
    :yValue "interia.pl" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "3.97" ;
    :yValue "rmf24.pl" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "3.86" ;
