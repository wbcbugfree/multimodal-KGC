@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Sacramento Kings all-time points leaders from 1948 to 2020" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Points scored" .

:YAxis a :Axis ;
    :title "Sacramento Kings Player" .

:DataPoint1 a :DataPoint ;
    :xValue "22009" ;
    :yValue "Oscar Robertson" ;
    :belongsTo :Chart .

