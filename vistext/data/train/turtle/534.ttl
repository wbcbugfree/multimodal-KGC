@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Best-rated midsize-ship cruise lines by travelers in the United States as of October 2020" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "midsize-ship cruise lines" .

:YAxis a :Axis ;
    :title "Score*" .

