@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Capacity factor of nuclear power plants in the United States from 1975 to 2019" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Capacity factor" .

:YAxis a :Axis ;
    :title "Year" .

