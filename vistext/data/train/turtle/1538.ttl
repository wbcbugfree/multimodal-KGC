@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Net worth of wealthiest Hollywood and Bollywood actors worldwide as of May 2014 (in million U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Richest Actors" .

:YAxis a :Axis ;
    :title "Net worth in million U.S. dollars" .

:DataPoint1 a :DataPoint ;
    :xValue "Jerry Seinfeld" ;
    :yValue "820" ;
    :belongsTo :Chart .

