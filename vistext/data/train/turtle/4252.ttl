@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Number of people on a zero hours contract in the United Kingdom (UK) from 2000 to 2020 (in 1,000s)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Employees in thousands" .

