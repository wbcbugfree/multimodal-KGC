@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "U.S. states with the lowest cancer incidence rates in 2016 (per 100,000 population)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Cancer incidence per 100,000 population" .

:YAxis a :Axis ;
    :title "State" .

:DataPoint1 a :DataPoint ;
    :xValue "359.4" ;
    :yValue "New Mexico" ;
    :belongsTo :Chart .

