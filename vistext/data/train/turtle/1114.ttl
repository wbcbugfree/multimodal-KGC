@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Number of fatalities due to terrorist attacks worldwide between 2006 and 2019" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Number of deaths" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2005" ;
    :yValue "20487" ;
    :belongsTo :Chart .

