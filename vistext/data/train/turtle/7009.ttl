    :xValue "2" ;
    :yValue "Japan" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "3" ;
    :yValue "North Korea" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "2" ;
    :yValue "Singapore" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
