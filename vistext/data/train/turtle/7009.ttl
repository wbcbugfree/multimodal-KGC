@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "All-time medal table for table tennis in the Olympics as of 2018 , by country" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Bronze" .

:YAxis a :Axis ;
    :title "Country" .

:DataPoint1 a :DataPoint ;
    :xValue "8" ;
    :yValue "China" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "1" ;
    :yValue "Denmark" ;
    :belongsTo :Chart .

