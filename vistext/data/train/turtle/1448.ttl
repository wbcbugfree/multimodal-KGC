@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Average ticket price Philadelphia Flyers games (NHL) from 2005/06 to 2014/15 (in U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Average ticket price in U.S. dollars" .

:DataPoint1 a :DataPoint ;
    :xValue "2014/15" ;
    :yValue "74.65" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "2013/14" ;
    :yValue "71.59" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "2012/13" ;
    :yValue "71.59" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "2011/12" ;
    :yValue "66.89" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "2010/11" ;
    :yValue "60.89" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "2009/10" ;
    :yValue "60.89" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "2008/09" ;
    :yValue "60.25" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "2007/08" ;
    :yValue "60.25" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "2006/07" ;
    :yValue "55.53" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "2005/06" ;
    :yValue "55.66" ;
    :belongsTo :Chart .
