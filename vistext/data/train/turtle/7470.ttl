@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Do you celebrate Easter ?" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Yes" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2008" ;
    :yValue "0.799" ;
    :belongsTo :Chart .

