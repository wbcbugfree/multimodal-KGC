@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Average number of Caterpillar employees worldwide from FY 2006 to FY 2019 (in 1,000s)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Number of employees in thousands" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2005" ;
    :yValue "94.6" ;
    :belongsTo :Chart .

