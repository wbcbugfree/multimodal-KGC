@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "General government budget deficit in Finland from 2005 to 2019 as ratio to GDP (in percent)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Ratio to GDP" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2004" ;
    :yValue "0.027" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Dec 31, 2005" ;
    :yValue "0.04" ;
    :belongsTo :Chart .

