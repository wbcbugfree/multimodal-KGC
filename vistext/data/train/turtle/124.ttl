@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Leading countries in crude oil production in Latin America and the Caribbean in 2019 (in 1,000 barrels per day)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Output in thousand barrels per day" .

:YAxis a :Axis ;
    :title "Country" .

:DataPoint1 a :DataPoint ;
    :xValue "2788" ;
    :yValue "Brazil" ;
    :belongsTo :Chart .

