@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Voter turnout rates among selected age groups in U.S. presidential elections from 1964 to 2016" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "18-24**" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 1963" ;
    :yValue "0.509" ;
    :belongsTo :Chart .

