@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Share of playback of over-the-top (OTT) services in the United States in the 2nd quarter of 2019 and 2020 , by genre" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Q2 2020" .

:YAxis a :Axis ;
    :title "Race" .

:DataPoint1 a :DataPoint ;
    :xValue "0.157" ;
    :yValue "Drama" ;
    :belongsTo :Chart .

