@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Number of persons with migration background in Germany in 2019 , by age (in 1,000)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Number of persons in thousands" .

:YAxis a :Axis ;
    :title "Year" .

