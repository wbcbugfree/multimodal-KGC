@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Sales of U.S. military aircraft from 2004 to 2015 (in billion U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Sales in billion U.S. dollars" .

:DataPoint1 a :DataPoint ;
    :xValue "2015*" ;
    :yValue "54.54" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "2014*" ;
    :yValue "52.57" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "2013" ;
    :yValue "53.15" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "2012" ;
    :yValue "58.56" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "2011" ;
    :yValue "59.92" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "2010" ;
    :yValue "62.05" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "2009" ;
    :yValue "59.46" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "2008" ;
    :yValue "64.01" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "2007" ;
    :yValue "60.41" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "2006" ;
    :yValue "54.34" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "2005" ;
    :yValue "49.42" ;
    :belongsTo :Chart .

:DataPoint12 a :DataPoint ;
    :xValue "2004" ;
    :yValue "45.8" ;
    :belongsTo :Chart .
