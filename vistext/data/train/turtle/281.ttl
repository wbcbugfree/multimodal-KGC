@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Total regular season home attendance of the NFL Miami Dolphins franchise from 2006 to 2019" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Home attendance" .

:DataPoint1 a :DataPoint ;
    :xValue "2019" ;
    :yValue "504540" ;
    :belongsTo :Chart .

