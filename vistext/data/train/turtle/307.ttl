@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Lebanon : National debt in relation to gross domestic product (GDP) from 2014 to 2024" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "National debt in relation to GDP" .

:DataPoint1 a :DataPoint ;
    :xValue "2024*" ;
    :yValue "1.8517" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "2023*" ;
    :yValue "1.7815" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "2022*" ;
    :yValue "1.7197" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "2021*" ;
    :yValue "1.6704" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "2020*" ;
    :yValue "1.6182" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "2019*" ;
    :yValue "1.5513" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "2018*" ;
    :yValue "1.5103" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "2017" ;
    :yValue "1.4896" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "2016" ;
    :yValue "1.4615" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "2015" ;
    :yValue "1.4071" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "2014" ;
    :yValue "1.3782" ;
    :belongsTo :Chart .
