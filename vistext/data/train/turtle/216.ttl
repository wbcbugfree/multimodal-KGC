@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Most popular services for online payments in Russia in 2020" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "Share of respondents" .

:DataPoint1 a :DataPoint ;
    :xValue "Sberbank Online" ;
    :yValue "0.83" ;
    :belongsTo :Chart .

