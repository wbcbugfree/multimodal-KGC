@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Type of retailers which consumers will likely visit to shop for holiday gifts in the United States as of September 2020" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "Share of respondents" .

:DataPoint1 a :DataPoint ;
    :xValue "Internet/online retailers*" ;
    :yValue "0.62" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Mass merchants" ;
    :yValue "0.5" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "Traditional department stores" ;
    :yValue "0.26" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "Supermarkets or grocery stores" ;
    :yValue "0.26" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "Off-price stores" ;
    :yValue "0.24" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Warehouse membership clubs" ;
    :yValue "0.23" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Bookstores" ;
    :yValue "0.23" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Electronics/office supply/computer stores" ;
    :yValue "0.22" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "Specialty beauty stores" ;
    :yValue "0.21" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "Home improvements stores" ;
    :yValue "0.21" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "Pet stores" ;
    :yValue "0.17" ;
    :belongsTo :Chart .

:DataPoint12 a :DataPoint ;
    :xValue "Furniture or home furnishings stores" ;
    :yValue "0.16" ;
    :belongsTo :Chart .

:DataPoint13 a :DataPoint ;
    :xValue "Dollar stores" ;
    :yValue "0.16" ;
    :belongsTo :Chart .

:DataPoint14 a :DataPoint ;
    :xValue "Specialty arts/crafts retailer" ;
    :yValue "0.16" ;
    :belongsTo :Chart .

:DataPoint15 a :DataPoint ;
    :xValue "Outlet stores/centers" ;
    :yValue "0.16" ;
    :belongsTo :Chart .

:DataPoint16 a :DataPoint ;
    :xValue "Specialty clothing stores" ;
    :yValue "0.16" ;
    :belongsTo :Chart .
