@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Global wastewater treatment works and utilities market in 2010 , by region" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Revenue share" .

:YAxis a :Axis ;
    :title "Country" .

:DataPoint1 a :DataPoint ;
    :xValue "0.36" ;
    :yValue "United States" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "0.29" ;
    :yValue "Western Europe" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "0.1" ;
    :yValue "Asia" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "0.08" ;
    :yValue "Japan" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "0.07" ;
    :yValue "Latin America" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "0.02" ;
    :yValue "Eastern Europe" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "0.02" ;
    :yValue "Australia and New Zealand" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "0.02" ;
    :yValue "Africa" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "0.02" ;
    :yValue "Canada" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "0.02" ;
    :yValue "Middle East" ;
    :belongsTo :Chart .
