@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Motivation to participate in outdoor activities among Hispanics in the United States in 2017" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "Share of respondents" .

:DataPoint1 a :DataPoint ;
    :xValue "Get exercise" ;
    :yValue "0.61" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Keep physically fit" ;
    :yValue "0.45" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "Be with family and friends" ;
    :yValue "0.39" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "Observe scenic beauty" ;
    :yValue "0.33" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "Be close to nature" ;
    :yValue "0.32" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Enjoy the sounds and smells of nature" ;
    :yValue "0.31" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Be with people who enjoy the same things I do" ;
    :yValue "0.29" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Get away from the usual demands" ;
    :yValue "0.29" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "Experience excitement and adventure" ;
    :yValue "0.26" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "Because it is cool" ;
    :yValue "0.22" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "Develop my skills and abilities" ;
    :yValue "0.21" ;
    :belongsTo :Chart .

:DataPoint12 a :DataPoint ;
    :xValue "Be with people who share my values" ;
    :yValue "0.19" ;
    :belongsTo :Chart .

:DataPoint13 a :DataPoint ;
    :xValue "Experience solitude" ;
    :yValue "0.18" ;
    :belongsTo :Chart .

:DataPoint14 a :DataPoint ;
    :xValue "Gain a sense of accomplishment" ;
    :yValue "0.18" ;
    :belongsTo :Chart .

:DataPoint15 a :DataPoint ;
    :xValue "Gain a sense of self-confidence" ;
    :yValue "0.16" ;
    :belongsTo :Chart .

:DataPoint16 a :DataPoint ;
    :xValue "Talk to new and varied people" ;
    :yValue "0.15" ;
    :belongsTo :Chart .

:DataPoint17 a :DataPoint ;
    :xValue "Other reason(s)" ;
    :yValue "0.03" ;
    :belongsTo :Chart .
