@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "New York Mets all-time games played leaders as of October 2020" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "New York Mets all-time games played leader" .

:YAxis a :Axis ;
    :title "Number of games played" .

:DataPoint1 a :DataPoint ;
    :xValue "Ed Kranepool" ;
    :yValue "1853" ;
    :belongsTo :Chart .

