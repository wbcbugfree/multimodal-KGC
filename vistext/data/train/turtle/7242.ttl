@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "World carbon dioxide emissions from 2009 to 2019 , by region (in million metric tons of carbon dioxide)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Europe" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2008" ;
    :yValue "4573.5" ;
    :belongsTo :Chart .

