@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Percentage of dedicated biotech companies in selected countries in 2014 , by application" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Country" .

:YAxis a :Axis ;
    :title "Agriculture" .

:DataPoint1 a :DataPoint ;
    :xValue "New Zealand" ;
    :yValue "0.184" ;
    :belongsTo :Chart .

