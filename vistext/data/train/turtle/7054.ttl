@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Have you deliberately purchased any of these products or services online instead of offline because of the COVID-19 / coronavirus pandemic ? (as of May 31 , 2020)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "United States" .

:YAxis a :Axis ;
    :title "Response" .

:DataPoint1 a :DataPoint ;
    :xValue "0.31" ;
    :yValue "Restaurant delivery / takeaway" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "0.27" ;
    :yValue "Hygiene products (e.g. hand sanitizer, toilet paper)" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "0.26" ;
    :yValue "Clothing" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "0.26" ;
    :yValue "Household cleaning products" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "0.24" ;
    :yValue "Food and drink delivery (e.g. from supermarket)" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "0.21" ;
    :yValue "Health products (e.g. medicine)" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "0.15" ;
    :yValue "Books" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "0.15" ;
    :yValue "Hobby supplies" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "0.13" ;
    :yValue "Games" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "0.11" ;
    :yValue "Consumer electronics, household appliances, furniture" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "0.11" ;
    :yValue "Video" ;
    :belongsTo :Chart .

:DataPoint12 a :DataPoint ;
    :xValue "0.1" ;
    :yValue "Music" ;
    :belongsTo :Chart .

:DataPoint13 a :DataPoint ;
    :xValue "0.06" ;
    :yValue "Magazines & newspapers" ;
    :belongsTo :Chart .

:DataPoint14 a :DataPoint ;
    :xValue "0.06" ;
    :yValue "Financial products and services" ;
    :belongsTo :Chart .

:DataPoint15 a :DataPoint ;
    :xValue "0.03" ;
    :yValue "Other" ;
    :belongsTo :Chart .

:DataPoint16 a :DataPoint ;
    :xValue "0.29" ;
    :yValue "I have not shifted from offline to online purchases for any products or services" ;
    :belongsTo :Chart .
