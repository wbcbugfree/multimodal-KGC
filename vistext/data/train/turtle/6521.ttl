@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "IBM 's global revenue from 2010 to 2019 , by business segment (in billion U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Technology Services & Cloud Platforms" .

:YAxis a :Axis ;
    :title "Response" .

:DataPoint1 a :DataPoint ;
    :xValue "34.28" ;
    :yValue "2017" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "35.34" ;
    :yValue "2016" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "35.14" ;
    :yValue "2015" ;
    :belongsTo :Chart .
