@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Net sales of Levi Strauss worldwide from 2008 to 2019 , by region (in million U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Asia" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2007" ;
    :yValue "728.9" ;
    :belongsTo :Chart .

