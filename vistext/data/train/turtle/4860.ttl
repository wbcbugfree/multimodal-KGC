@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Eli Lilly and Company 's expenditure on research and development from 2007 to 2019 (in million U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Expenditure in million U.S. dollars" .

:DataPoint1 a :DataPoint ;
    :xValue "2019*" ;
    :yValue "5595" ;
    :belongsTo :Chart .

