@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "U.S. exports of industrial engines from 2007 to 2018 (in billion U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Export value in billion U.S. dollars" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2006" ;
    :yValue "19.15" ;
    :belongsTo :Chart .

