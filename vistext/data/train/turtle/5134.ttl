@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Average growth rate of gross domestic product (GDP) in the European Union (EU) from 2013 to 2022" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Real annual percentage change" .

:YAxis a :Axis ;
    :title "Year" .

:DataPoint1 a :DataPoint ;
    :xValue "0.03" ;
    :yValue "2022*" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "0.041" ;
    :yValue "2021*" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "-0.074" ;
    :yValue "2020*" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "0.015" ;
    :yValue "2019" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "0.021" ;
    :yValue "2018" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "0.027" ;
    :yValue "2017" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "0.021" ;
    :yValue "2016" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "0.023" ;
    :yValue "2015" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "0.018" ;
    :yValue "2014" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "0.003" ;
    :yValue "2013" ;
    :belongsTo :Chart .
