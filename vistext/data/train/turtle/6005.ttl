@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Share of value added by the agricultural sector to the gross domestic product (GDP) in Brazil from 2010 to 2019" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "Share of GDP" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2009" ;
    :yValue "0.0412" ;
    :belongsTo :Chart .

