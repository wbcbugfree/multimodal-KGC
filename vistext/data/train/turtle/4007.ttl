@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Turnover of the whole organic food sector , including restaurant and other catering facilities , in France between 2010 and 2019 (in million euros)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Turnover in million euros" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2009" ;
    :yValue "3737" ;
    :belongsTo :Chart .

