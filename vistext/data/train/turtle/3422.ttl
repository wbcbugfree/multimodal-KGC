@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Gross domestic expenditure on research and development (GERD) as a percentage of GDP in Finland from 2005 to 2016" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "GERD as percentage of GDP" .

:YAxis a :Axis ;
    :title "Year" .

:DataPoint1 a :DataPoint ;
    :xValue "0.0275" ;
    :yValue "2016" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "0.029" ;
    :yValue "2015" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "0.0317" ;
    :yValue "2014" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "0.033" ;
    :yValue "2013" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "0.0342" ;
    :yValue "2012" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "0.0364" ;
    :yValue "2011" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "0.0373" ;
    :yValue "2010 *" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "0.0375" ;
    :yValue "2009" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "0.0355" ;
    :yValue "2008" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "0.0335" ;
    :yValue "2007" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "0.0334" ;
    :yValue "2006" ;
    :belongsTo :Chart .

:DataPoint12 a :DataPoint ;
    :xValue "0.0333" ;
    :yValue "2005" ;
    :belongsTo :Chart .
