@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "In-store merchandise sales of convenience stores in the United States in 2018 , by product category (in million U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Sales in million U.S. dollars" .

:YAxis a :Axis ;
    :title "product category" .

:DataPoint1 a :DataPoint ;
    :xValue "65365" ;
    :yValue "Cigarettes" ;
    :belongsTo :Chart .

