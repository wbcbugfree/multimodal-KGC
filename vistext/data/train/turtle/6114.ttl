@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Total/average regular season home attendance of the St. Louis Blues from 2005/06 to 2019/20" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Total attendance" .

