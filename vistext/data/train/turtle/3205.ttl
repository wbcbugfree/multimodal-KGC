    :xValue "7810" ;
    :yValue "2016" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "7834" ;
    :yValue "2015" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "8588" ;
    :yValue "2014" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "9315" ;
    :yValue "2013" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "9195" ;
