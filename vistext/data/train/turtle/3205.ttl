@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Revenue of Thomas Cook Group from financial year 2011 to 2019 (in million GBP)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Revenue in million GBP" .

:YAxis a :Axis ;
    :title "Year" .

:DataPoint1 a :DataPoint ;
    :xValue "3019" ;
    :yValue "2020" ;
    :belongsTo :Chart .

