@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Distribution of diamond production worldwide based on value in 2018 , by country" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Share of production value" .

:YAxis a :Axis ;
    :title "Response" .

:DataPoint1 a :DataPoint ;
    :xValue "0.274" ;
    :yValue "Russia" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "0.243" ;
    :yValue "Botswana" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "0.144" ;
    :yValue "Canada" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "0.085" ;
    :yValue "South Africa" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "0.084" ;
    :yValue "Angola" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "0.078" ;
    :yValue "Namibia" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "0.026" ;
    :yValue "Lesotho" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "0.015" ;
    :yValue "Zimbabwe" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "0.013" ;
    :yValue "Australia" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "0.038" ;
    :yValue "Other countries" ;
    :belongsTo :Chart .
