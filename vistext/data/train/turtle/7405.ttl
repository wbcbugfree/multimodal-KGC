@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Number of tanker ships in OPEC countries from 2012 to 2016" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Country" .

:YAxis a :Axis ;
    :title "2014" .

:DataPoint1 a :DataPoint ;
    :xValue "Ira" ;
    :yValue "46" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Iran Angol" ;
    :yValue "27" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "Angola Venezuel" ;
    :yValue "26" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "Venezuela Kuwai" ;
    :yValue "26" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "Kuwait Saudi Arabi" ;
    :yValue "23" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Saudi Arabia United Arab Emirate" ;
    :yValue "19" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "United Arab Emirates Ecuado" ;
    :yValue "20" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Ecuador Liby" ;
    :yValue "5" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "Libya Qata" ;
    :yValue "5" ;
