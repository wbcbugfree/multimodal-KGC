@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "In your opinion , is reunification of two Koreas necessary ?" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "Not necessary" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2006" ;
    :yValue "0.151" ;
    :belongsTo :Chart .

