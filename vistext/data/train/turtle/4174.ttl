@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Ranking of largest geothermal plants worldwide as of March 2020 (in megawatts)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Geothermal plant" .

:YAxis a :Axis ;
    :title "Capacity in megawatts" .

:DataPoint1 a :DataPoint ;
    :xValue "The Geysers (United States)" ;
    :yValue "1517" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Cerro Prieto (Mexico)" ;
    :yValue "820" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "Larderello(Italy)" ;
    :yValue "769" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "Olkaria(Kenya)" ;
    :yValue "727" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "Imperial Valley(United States)" ;
    :yValue "403" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Sarulla(Indonesia)" ;
    :yValue "330" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Tiwi(New Zealand)" ;
    :yValue "330" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Hellisheiði(Iceland)" ;
    :yValue "303" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "Coso(United States)" ;
