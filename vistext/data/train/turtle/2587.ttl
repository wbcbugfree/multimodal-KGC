@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "U.S. states with the highest smoking rates among adults in 2019" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Percentage of adults" .

:YAxis a :Axis ;
    :title "Response" .

:DataPoint1 a :DataPoint ;
    :xValue "0.24" ;
    :yValue "West Virginia" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "0.24" ;
    :yValue "Kentucky" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "0.22" ;
    :yValue "Louisiana" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "0.21" ;
    :yValue "Ohio" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "0.2" ;
    :yValue "Mississippi" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "0.2" ;
    :yValue "Alabama" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "0.2" ;
    :yValue "Arkansas" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "0.2" ;
    :yValue "Tennessee" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "0.2" ;
    :yValue "Missouri" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "0.19" ;
    :yValue "Indiana" ;
    :belongsTo :Chart .
