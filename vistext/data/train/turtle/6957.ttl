@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Revenue of Ipsos worldwide from 2010 to 2019 , by geographic region (in million euros)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Europe, Middle East and Africa" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2009" ;
    :yValue "501.8" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Dec 31, 2010" ;
    :yValue "587.5" ;
    :belongsTo :Chart .

