@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Volume of tuna imported to the United Kingdom (UK) in 2017 , by country of origin (in metric tons)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Volume in metric tons" .

:YAxis a :Axis ;
    :title "Country" .

:DataPoint1 a :DataPoint ;
    :xValue "18040" ;
    :yValue "Seychelles" ;
    :belongsTo :Chart .

