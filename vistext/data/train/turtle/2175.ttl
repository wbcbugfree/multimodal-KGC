@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Triumph Street Triple registered motorcycle numbers in Great Britain from 2007 to 2018" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Number of registered motorcycles" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2006" ;
    :yValue "449" ;
    :belongsTo :Chart .

