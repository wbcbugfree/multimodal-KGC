@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Number of births in Newfoundland and Labrador , Canada from 2001 to 2020" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Number of births" .

:YAxis a :Axis ;
    :title "Year" .

