@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Total population of Rotterdam from 2009 to 2019" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Number of inhabitants" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2008" ;
    :yValue "587134" ;
    :belongsTo :Chart .

