@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Allotted paid vacation days compared to what is considered fair worldwide as of August 2014 , by country" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "Paid vacation days considered fair" .

:DataPoint1 a :DataPoint ;
    :xValue "United States" ;
    :yValue "22" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Japan" ;
    :yValue "28" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "Australia" ;
    :yValue "24" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "Brazil" ;
    :yValue "33" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "United Kingdom" ;
    :yValue "28" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Spain" ;
    :yValue "32" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Germany" ;
    :yValue "30" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Italy" ;
    :yValue "31" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "Russia" ;
    :yValue "33" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "France" ;
    :yValue "31" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "World average" ;
    :yValue "29" ;
    :belongsTo :Chart .
