@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Penetration of leading social networks in Turkey as of 3rd quarter 2019 , by platform" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "Share of population" .

:DataPoint1 a :DataPoint ;
    :xValue "Youtube" ;
    :yValue "0.9" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Instagram" ;
    :yValue "0.83" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "Whatsapp" ;
    :yValue "0.81" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "Facebook" ;
    :yValue "0.76" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "Twitter" ;
    :yValue "0.61" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "FB Messenger" ;
    :yValue "0.53" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Pinterest" ;
    :yValue "0.34" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "LinkedIn" ;
    :yValue "0.32" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "Snapchat" ;
    :yValue "0.29" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "TikTok" ;
    :yValue "0.27" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "Skype" ;
    :yValue "0.27" ;
    :belongsTo :Chart .

:DataPoint12 a :DataPoint ;
    :xValue "Twitch" ;
    :yValue "0.24" ;
    :belongsTo :Chart .

:DataPoint13 a :DataPoint ;
    :xValue "Tumblr" ;
    :yValue "0.2" ;
    :belongsTo :Chart .

:DataPoint14 a :DataPoint ;
    :xValue "Reddit" ;
    :yValue "0.16" ;
    :belongsTo :Chart .

:DataPoint15 a :DataPoint ;
    :xValue "WeChat" ;
    :yValue "0.15" ;
    :belongsTo :Chart .

:DataPoint16 a :DataPoint ;
