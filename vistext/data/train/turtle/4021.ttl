@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Global technology gold demand from 2005 to 2019 (in metric tons)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Demand in metric tons" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2004" ;
    :yValue "440" ;
    :belongsTo :Chart .

