@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Brand of fireplaces used the most by construction firms in the United States in 2018" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Brand" .

:YAxis a :Axis ;
    :title "Share of respondents" .

:DataPoint1 a :DataPoint ;
    :xValue "Heatilator" ;
    :yValue "0.28" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Heat & Glo" ;
    :yValue "0.196" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "Majestic" ;
    :yValue "0.121" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "Vermont Castings" ;
    :yValue "0.075" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "Napoleon" ;
    :yValue "0.065" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Superior Fireplaces" ;
    :yValue "0.065" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "FMI" ;
    :yValue "0.028" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Astria" ;
    :yValue "0.028" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "Regency" ;
    :yValue "0.028" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "Town & Country Fireplaces" ;
    :yValue "0.019" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "Monessen" ;
    :yValue "0.019" ;
    :belongsTo :Chart .

:DataPoint12 a :DataPoint ;
    :xValue "Spark Modern Fires" ;
    :yValue "0.009" ;
    :belongsTo :Chart .

:DataPoint13 a :DataPoint ;
    :xValue "None of these" ;
    :yValue "0.065" ;
    :belongsTo :Chart .
