@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Leading types of holiday in the United Kingdom (UK) in 2019" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "Share of respondents" .

:DataPoint1 a :DataPoint ;
    :xValue "City break" ;
    :yValue "0.46" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Beach holiday" ;
    :yValue "0.41" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "Countryside break" ;
    :yValue "0.23" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "All inclusive holiday" ;
    :yValue "0.18" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "Multi-trip (travel to different places on a single trip)" ;
    :yValue "0.15" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Renting a private home (or home swap, home stay, couch surfing)" ;
    :yValue "0.12" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Lakes & mountains" ;
    :yValue "0.11" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Cruise" ;
    :yValue "0.1" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "Off the beaten track" ;
    :yValue "0.07" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "Camping" ;
    :yValue "0.07" ;
    :belongsTo :Chart .
