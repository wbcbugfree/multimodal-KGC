@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Life and non-life insurance penetration in selected countries worldwide in 2019" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Country" .

:YAxis a :Axis ;
    :title "Insurance penetration" .

:DataPoint1 a :DataPoint ;
    :xValue "Taiwan" ;
    :yValue "0.1997" ;
    :belongsTo :Chart .

