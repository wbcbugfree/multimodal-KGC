@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "U.S. e-commerce value of household appliances and electrical goods wholesale trade from 2007 to 2018 (in million U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Total" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2006" ;
    :yValue "453031" ;
    :belongsTo :Chart .

