@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Annual household consumption expenditure on food and non-alcoholic beverages in Iceland from 2009 to 2019 (in million ISK)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Expenditure in million ISK" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2008" ;
    :yValue "107445" ;
    :belongsTo :Chart .

