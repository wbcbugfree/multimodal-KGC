@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Percentage of coronavirus (COVID-19) deaths compared to population among Asian Americans in select U.S. states as of June 23 , 2020" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "State" .

:YAxis a :Axis ;
    :title "Percentage of population" .

