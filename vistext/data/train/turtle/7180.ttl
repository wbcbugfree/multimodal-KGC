@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Share of private households owning a personal computer in Germany from 2000 to 2020 , by type" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Total" .

