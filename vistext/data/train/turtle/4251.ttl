@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Total number of employees in the Sony Group from fiscal year 2007 to 2019 (in 1,000s)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Number of employees in thousands" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2006" ;
    :yValue "163" ;
    :belongsTo :Chart .

