    :xValue "4750" ;
    :yValue "Indonesia" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "4668" ;
    :yValue "Mexico" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "3131" ;
    :yValue "Germany" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "2566" ;
    :yValue "Vietnam" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
