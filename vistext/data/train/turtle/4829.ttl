@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Countries with the highest employment in the travel and tourism industry worldwide in 2019 (in thousands)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Number of jobs" .

:YAxis a :Axis ;
    :title "Country" .

:DataPoint1 a :DataPoint ;
    :xValue "29089" ;
    :yValue "China" ;
    :belongsTo :Chart .

