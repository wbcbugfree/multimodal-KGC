@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Sales of the leading companies in the flavor and fragrance market worldwide from 2010 to 2017 (in million U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "2010" .

:YAxis a :Axis ;
    :title "Company" .

:DataPoint1 a :DataPoint ;
    :xValue "4074.6" ;
    :yValue "Givaudan" ;
