@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "U.S. limited-service hotel chains by average revenue per available room in 2009 (in U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Average RevPAR (in U.S. dollars)" .

:YAxis a :Axis ;
    :title "hotel chain" .

