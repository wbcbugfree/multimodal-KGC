@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Average percentage of young people (15 - 29 years) not in education , employment , or training (NEET) in Italy in 2019 , by region" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "region of Italy" .

:YAxis a :Axis ;
    :title "Average annual percentage" .

:DataPoint1 a :DataPoint ;
    :xValue "Sicily" ;
    :yValue "0.38" ;
    :belongsTo :Chart .

