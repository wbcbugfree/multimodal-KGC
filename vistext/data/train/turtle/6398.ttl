    :yValue "15225" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "2014/15" ;
    :yValue "15115" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "2015/16" ;
