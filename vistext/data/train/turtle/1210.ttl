@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Number of Sanofi 's outstanding shares from 2009 to 2019 (in millions)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Average number of shares in millions" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2008" ;
    :yValue "1305.9" ;
    :belongsTo :Chart .

