@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Which hot beverage do you drink most often ?" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Share of respondents" .

:YAxis a :Axis ;
    :title "Response" .

:DataPoint1 a :DataPoint ;
    :xValue "0.44" ;
    :yValue "Tea" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "0.21" ;
    :yValue "Instant coffee" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "0.07" ;
    :yValue "Ground coffee" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "0.07" ;
    :yValue "Hot chocolate" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "0.06" ;
    :yValue "Green tea" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "0.05" ;
    :yValue "Premium instant coffee*" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "0.04" ;
    :yValue "Fruit/herbal tea" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "0.04" ;
    :yValue "Coffee from pods" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "0.02" ;
    :yValue "Coffee from a coffee shop" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "0" ;
    :yValue "Vending machine coffee" ;
    :belongsTo :Chart .
