@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Leading countries in production of petroleum and other liquids in Latin America and the Caribbean in 2019 (in 1,000 barrels per day)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Country" .

:YAxis a :Axis ;
    :title "Production in thousand barrels per day" .

:DataPoint1 a :DataPoint ;
    :xValue "Brazil" ;
    :yValue "3674" ;
    :belongsTo :Chart .

