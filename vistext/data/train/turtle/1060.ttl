@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Net internal migration in Italy in 2019 , by region (per 1,000 inhabitants)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Net migration per thousand inhabitants" .

:YAxis a :Axis ;
    :title "region of Italy" .

