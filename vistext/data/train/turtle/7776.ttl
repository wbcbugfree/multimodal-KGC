@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Composition of the U.S. Senate by political party affiliation from 1983 to 2019" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Republican" .

:DataPoint1 a :DataPoint ;
    :xValue "116th Congress, 2019" ;
    :yValue "53" ;
    :belongsTo :Chart .

