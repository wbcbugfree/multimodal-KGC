@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Internal consumption of travel and tourism in Saint Kitts & Nevis from 2010 to 2019 (in million U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Consumption in million U.S. dollars*" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2009" ;
    :yValue "265.8" ;
    :belongsTo :Chart .

