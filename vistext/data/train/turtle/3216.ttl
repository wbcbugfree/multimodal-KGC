@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Consumer electronics-related websites ranked by natural search voice share in the United Kingdom (UK) in March 2016" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Share of natural search voice**" .

:YAxis a :Axis ;
    :title "Response" .

:DataPoint1 a :DataPoint ;
    :xValue "0.65" ;
    :yValue "currys.co.uk" ;
    :belongsTo :Chart .

