@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Revenue of the defense technology supplier General Dynamics from 2005 to 2019 , by product group (in million U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Marine Systems" .

