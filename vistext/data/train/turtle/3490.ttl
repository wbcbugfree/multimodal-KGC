@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Number of specialized stores for the retail sale of watches and jewelry in the United Kingdom (UK) from 2008 to 2018" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Number of enterprises" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2007" ;
    :yValue "4428" ;
    :belongsTo :Chart .

