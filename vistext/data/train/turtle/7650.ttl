@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Which region or country do you believe will witness the most M & A activity in Europe over the next 12 months ?" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Most active" .

:YAxis a :Axis ;
    :title "Response" .

:DataPoint1 a :DataPoint ;
    :xValue "0.49" ;
    :yValue "Germany" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "0.19" ;
    :yValue "Nordic" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "0.15" ;
    :yValue "United Kingdom and Ireland" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "0.06" ;
    :yValue "Austria and Switzerland" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "0.04" ;
    :yValue "Benelux" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "0.03" ;
    :yValue "France" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "0.02" ;
    :yValue "South Eastern Europe" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "0.01" ;
    :yValue "CEE (excluding Russia and Ukraine)" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "0.01" ;
    :yValue "Italy" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "0" ;
    :yValue "Iberia" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "0" ;
    :yValue "Russia and Ukraine" ;
    :belongsTo :Chart .
