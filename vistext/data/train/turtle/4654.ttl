    :yValue "36516" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "merican Revolutionary War (1775-1783)" ;
    :yValue "25000" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "ar of" ;
    :yValue "1812" ;
    :belongsTo :Chart .

