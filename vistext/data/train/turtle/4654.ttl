@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Number of military fatalities in all major wars involving the United States from 1775 to 2021" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "War (and years of U\\.S\\. military involvement)" .

:YAxis a :Axis ;
    :title "Number of fatalities" .

:DataPoint1 a :DataPoint ;
    :xValue "merican Civil War (1861-1865)" ;
    :yValue "620000" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "orld War II (1939-1945)" ;
    :yValue "405399" ;
    :belongsTo :Chart .

