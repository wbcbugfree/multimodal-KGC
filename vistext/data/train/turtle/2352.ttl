@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Projected share of global rare earth supply in 2015 , by element" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "Percentage of total rare earths" .

:DataPoint1 a :DataPoint ;
    :xValue "Lanthanum" ;
    :yValue "0.27" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Cerium" ;
    :yValue "0.4" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "Praseodymium" ;
    :yValue "0.05" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "Neodymium" ;
    :yValue "0.16" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "Samarium" ;
    :yValue "0.02" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Europium" ;
    :yValue "0.004" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Gadolinium" ;
    :yValue "0.02" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Terbium" ;
    :yValue "0.002" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "Dysprosium" ;
    :yValue "0.009" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "Erbium" ;
    :yValue "0.004" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "Yttrium" ;
    :yValue "0.05" ;
    :belongsTo :Chart .
