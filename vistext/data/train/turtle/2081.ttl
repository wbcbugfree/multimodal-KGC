@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "States with the lowest underemployment rates in the U.S. 2016" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Underemployment rate" .

:YAxis a :Axis ;
    :title "State" .

:DataPoint1 a :DataPoint ;
    :xValue "0.089" ;
    :yValue "Minnesota" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "0.092" ;
    :yValue "South Dakota" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "0.099" ;
    :yValue "Nebraska" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "0.103" ;
    :yValue "Kansas" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "0.103" ;
    :yValue "Montana" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "0.104" ;
    :yValue "Utah" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "0.106" ;
    :yValue "New Hampshire" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "0.108" ;
    :yValue "Missouri" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "0.108" ;
    :yValue "North Dakota" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "0.109" ;
    :yValue "Iowa" ;
    :belongsTo :Chart .
