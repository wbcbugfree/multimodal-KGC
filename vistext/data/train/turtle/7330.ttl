    :xValue "GE Haliade 150-6MW" ;
    :yValue "150" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Ming Yang SCD 6.0" ;
    :yValue "140" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Doosan WindS500" ;
