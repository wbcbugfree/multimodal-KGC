@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Largest wind turbines worldwide as of September 2018" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Largest wind turbines" .

:YAxis a :Axis ;
    :title "Rotor diameter (in meters)" .

:DataPoint1 a :DataPoint ;
    :xValue "MHI Vestas V164 8MW" ;
    :yValue "164" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Siemens-Gamesa SG 8.0-167 DD" ;
    :yValue "167" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "Goldwind GW154 6.7MW" ;
    :yValue "154" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "Senvion 6.2M152**" ;
    :yValue "152" ;
    :belongsTo :Chart .

