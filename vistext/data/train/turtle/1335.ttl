@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Total number of passengers carried by Spirit Airlines from 2003 to 2019 (in millions)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Number of passengers in millions" .

