@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Number of students enrolled at universities in Spain from the academic year 2008/2009 to 2019/2020 , by university type" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Public universities" .

:DataPoint1 a :DataPoint ;
    :xValue "2019/20*" ;
    :yValue "1314575" ;
    :belongsTo :Chart .

