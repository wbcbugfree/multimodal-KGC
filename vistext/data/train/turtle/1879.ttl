@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Share of respondents whose company used public cloud applications and services from October 2010 to April 2013" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "Share of respondents" .

:DataPoint1 a :DataPoint ;
    :xValue "Sep 30, 2010" ;
    :yValue "0.14" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Dec 31, 2010" ;
    :yValue "0.17" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "Mar 31, 2011" ;
    :yValue "0.17" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "Jun 30, 2011" ;
    :yValue "0.19" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "Sep 30, 2011" ;
    :yValue "0.22" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Dec 31, 2011" ;
    :yValue "0.22" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Mar 31, 2012" ;
    :yValue "0.29" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Jun 30, 2012" ;
    :yValue "0.32" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "Sep 30, 2012" ;
    :yValue "0.34" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "Dec 31, 2012" ;
    :yValue "0.4" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "Mar 31, 2013" ;
    :yValue "0.4" ;
    :belongsTo :Chart .
