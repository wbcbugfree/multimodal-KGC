@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Portugal : Government revenue and spending from 2014 to 2024 (in billion euros)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Revenue" .

:DataPoint1 a :DataPoint ;
    :xValue "2024*" ;
    :yValue "106.67" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "2023*" ;
    :yValue "103.34" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "2022*" ;
    :yValue "100.07" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "2021*" ;
    :yValue "97.87" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "2020*" ;
    :yValue "93.94" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "2019*" ;
    :yValue "90.86" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "2018" ;
    :yValue "87.71" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "2017" ;
    :yValue "83.11" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "2016" ;
