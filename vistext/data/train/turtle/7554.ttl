    :xValue "94072" ;
    :yValue "25-29" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "88432" ;
    :yValue "30-34" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "73764" ;
    :yValue "35-39" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "50915" ;
    :yValue "40-44" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "38842" ;
    :yValue "45-49" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "31941" ;
    :yValue "50-54" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "23360" ;
    :yValue "55-59" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "11785" ;
