@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Number of arrests for property crimes in the United States in 2019 , by type and age" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Larceny-theft" .

:YAxis a :Axis ;
    :title "Type of crime" .

:DataPoint1 a :DataPoint ;
    :xValue "62200" ;
    :yValue "Under 18" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "121483" ;
    :yValue "18-24" ;
    :belongsTo :Chart .

