@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Annual expenditure on alcoholic beverages in the United Kingdom from 2005 to 2019 , based on volume (in million GBP)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Expenditure in million GBP" .

