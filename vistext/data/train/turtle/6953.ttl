@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Where do you primarily derive most of your personal values from ? (by selected country)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Professional experience" .

:YAxis a :Axis ;
    :title "Response" .

:DataPoint1 a :DataPoint ;
    :xValue "0.074" ;
    :yValue "France" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "0.0328" ;
    :yValue "Germany" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "0.0893" ;
    :yValue "India" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "0.2177" ;
    :yValue "Indonesia" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "0.1897" ;
    :yValue "Israel" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "0.0371" ;
    :yValue "Mexico" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "0.1449" ;
    :yValue "Saudi Arabia" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "0.1098" ;
    :yValue "South Africa" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "0.1994" ;
    :yValue "Turkey" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "0.0934" ;
    :yValue "United States" ;
    :belongsTo :Chart .
