@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Number of Toyota cars sold in Finland from 2010 to 2019" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Number of cars" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2008" ;
    :yValue "14457" ;
    :belongsTo :Chart .

