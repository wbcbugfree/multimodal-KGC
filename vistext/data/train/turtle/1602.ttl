@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Total number of biotechnology firms in selected European countries in 2018" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Number of companies" .

:YAxis a :Axis ;
    :title "Country" .

:DataPoint1 a :DataPoint ;
    :xValue "2083" ;
    :yValue "France" ;
    :belongsTo :Chart .

