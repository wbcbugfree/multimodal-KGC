@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Chicago Cubs all-time home run leaders as of October 2020" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Home run leader" .

:YAxis a :Axis ;
    :title "Number of home runs" .

:DataPoint1 a :DataPoint ;
    :xValue "Sammy Sosa" ;
    :yValue "545" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Ernie Banks" ;
    :yValue "512" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "Billy Williams" ;
    :yValue "392" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "Ron Santo" ;
    :yValue "337" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "Ryne Sandberg" ;
    :yValue "282" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Aramis Ramirez" ;
    :yValue "239" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Gabby Hartnett" ;
    :yValue "231" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Anthony Rizzo" ;
    :yValue "228" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "Bill Nicholson" ;
    :yValue "205" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "Hank Sauer" ;
    :yValue "198" ;
    :belongsTo :Chart .
