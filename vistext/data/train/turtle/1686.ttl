@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Countries with the highest number of new HIV infections worldwide in 2015" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Country" .

:YAxis a :Axis ;
    :title "Number of new HIV infections" .

:DataPoint1 a :DataPoint ;
    :xValue "South Africa" ;
    :yValue "380000" ;
    :belongsTo :Chart .

