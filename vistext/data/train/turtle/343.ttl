@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Distribution of table olive production worldwide in 2018/2019 , by country" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Production share" .

:YAxis a :Axis ;
    :title "Country" .

:DataPoint1 a :DataPoint ;
    :xValue "0.31" ;
    :yValue "EU" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "0.16" ;
    :yValue "Egypt" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "0.15" ;
    :yValue "Turkey" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "0.12" ;
    :yValue "Algeria" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "0.05" ;
    :yValue "Morocco" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "0.04" ;
    :yValue "Syria" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "0.03" ;
    :yValue "Peru" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "0.02" ;
    :yValue "Argentina" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "0.01" ;
    :yValue "United States" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "0.01" ;
    :yValue "Tunisia" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "0.09" ;
    :yValue "Others non-EU" ;
    :belongsTo :Chart .
