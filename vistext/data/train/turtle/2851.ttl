@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Most popular influencers on TikTok from the United States as of July 2020 , by number of likes (in millions)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Number of likes in millions" .

:YAxis a :Axis ;
    :title "TikTok Influencer" .

:DataPoint1 a :DataPoint ;
    :xValue "5200" ;
    :yValue "@charlidamelio" ;
    :belongsTo :Chart .

