@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "How did you hear about the Summer X Games ?" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Share of respondents" .

:YAxis a :Axis ;
    :title "Response" .

:DataPoint1 a :DataPoint ;
    :xValue "0.55" ;
    :yValue "ESPN" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "0.4" ;
    :yValue "Internet" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "0.39" ;
    :yValue "Word of mouth" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "0.33" ;
    :yValue "Local media (TV, radio or print)" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "0.3" ;
    :yValue "Xgames.com or ESPN.com/action" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "0.28" ;
    :yValue "ESPN 2" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "0.21" ;
    :yValue "Social media (Facebook, Twitter, YouTube)" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "0.1" ;
    :yValue "Other national TV" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "0.09" ;
    :yValue "National radio" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "0.09" ;
    :yValue "National print ads" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "0.07" ;
    :yValue "Sponsor promotions" ;
    :belongsTo :Chart .

:DataPoint12 a :DataPoint ;
    :xValue "0.01" ;
    :yValue "Chamber of commerce" ;
    :belongsTo :Chart .

:DataPoint13 a :DataPoint ;
    :xValue "0.06" ;
    :yValue "Can't recall" ;
    :belongsTo :Chart .
