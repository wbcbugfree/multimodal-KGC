@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "10 Countries with the largest number of Protestants in 2010 (in millions)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Protestant population in millions" .

:YAxis a :Axis ;
    :title "Country" .

:DataPoint1 a :DataPoint ;
    :xValue "159.85" ;
    :yValue "United States" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "59.68" ;
    :yValue "Nigeria" ;
    :belongsTo :Chart .

