    :xValue "58.04" ;
    :yValue "China" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "40.5" ;
    :yValue "Brazil" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "36.55" ;
    :yValue "South Africa" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "33.82" ;
    :yValue "United Kingdom" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "31.7" ;
    :yValue "DR Congo" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "28.64" ;
    :yValue "Germany" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "24.16" ;
