@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Number of physicians employed in Iceland from 2000 to 2019" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Number of employees" .

:YAxis a :Axis ;
    :title "Year" .

