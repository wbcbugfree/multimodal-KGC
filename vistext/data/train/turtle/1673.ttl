@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Property insurance gross written premiums in the United Kingdom (UK) from 2004 to 2018 (in million euros)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Gross written premiums in million euros*" .

