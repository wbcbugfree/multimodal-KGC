@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Number of VAT and/or PAYE based enterprises in the United Kingdom (UK) from 2010 to 2020 (in millions)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Number of enterprises in millions" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2009" ;
    :yValue "2.18" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Dec 31, 2010" ;
    :yValue "2.14" ;
    :belongsTo :Chart .

