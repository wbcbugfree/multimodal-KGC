@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Chicago White Sox all-time games played leaders as of October 2020" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Number of games played" .

:YAxis a :Axis ;
    :title "leader" .

:DataPoint1 a :DataPoint ;
    :xValue "2422" ;
    :yValue "Luke Appling" ;
    :belongsTo :Chart .

