@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Bauxite imports and exports worldwide from 2005 to 2019 (in 1,000 metric tons)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Export" .

