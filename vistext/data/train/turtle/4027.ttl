@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Leading countries for mHealth app publication in Europe 2015" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Share of mHealth app publishers" .

:YAxis a :Axis ;
    :title "Response" .

:DataPoint1 a :DataPoint ;
    :xValue "0.55" ;
    :yValue "UK" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "0.41" ;
    :yValue "Germany" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "0.23" ;
    :yValue "Sweden" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "0.23" ;
    :yValue "Netherlands" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "0.18" ;
    :yValue "Denmark" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "0.16" ;
    :yValue "France" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "0.15" ;
    :yValue "Finland" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "0.11" ;
    :yValue "Spain" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "0.06" ;
    :yValue "Ireland" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "0.06" ;
    :yValue "Austria" ;
    :belongsTo :Chart .
