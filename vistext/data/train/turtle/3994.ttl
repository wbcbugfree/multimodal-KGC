@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Number of students enrolled in postsecondary institutions in Canada in 2017/18 , by program type" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Type of program" .

:YAxis a :Axis ;
    :title "Number of students" .

:DataPoint1 a :DataPoint ;
    :xValue "Undergraduate program" ;
    :yValue "1057440" ;
    :belongsTo :Chart .

