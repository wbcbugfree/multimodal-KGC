@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Number of employees of the United States cruise industry from 2007 to 2018 (in thousands)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Number of employees in thousands" .

:YAxis a :Axis ;
    :title "Year" .

:DataPoint1 a :DataPoint ;
    :xValue "246" ;
    :yValue "2018*" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "233.7" ;
    :yValue "2017*" ;
    :belongsTo :Chart .

