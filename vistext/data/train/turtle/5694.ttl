@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Annual volume of bananas sold in the United Kingdom (UK) from 2008 to 2018 (in 1,000 tonnes)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Sales volume in thousand tonnes" .

:DataPoint1 a :DataPoint ;
    :xValue "2018*" ;
    :yValue "819.3" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "2017*" ;
    :yValue "810.4" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "2016*" ;
    :yValue "802.3" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "2015 *" ;
    :yValue "796" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "2014 *" ;
    :yValue "792.8" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "2013" ;
    :yValue "794.4" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "2012" ;
    :yValue "800" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "2011" ;
    :yValue "807.3" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "2010" ;
    :yValue "816.2" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "2009" ;
