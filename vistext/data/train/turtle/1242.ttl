@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Total value of gross mortgage lending in the United Kingdom (UK) from 2007 to the first quarter of 2020 (in billion GBP)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Mortages value in billion GBP" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2006" ;
    :yValue "371.72" ;
    :belongsTo :Chart .

