@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Total sugar stocks worldwide from 2009/2010 to 2020/21 (in million metric tons)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Stocks in million metric tons" .

:DataPoint1 a :DataPoint ;
    :xValue "2020/2021**" ;
    :yValue "43.55" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "2019/2020" ;
    :yValue "44.43" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "2018/2019" ;
    :yValue "53.98" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "2017/2018" ;
    :yValue "52.25" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "2016/2017" ;
    :yValue "42.2" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "2015/2016" ;
    :yValue "44.09" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "2014/2015" ;
    :yValue "48.77" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "2013/2014" ;
    :yValue "44.82" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "2012/2013" ;
    :yValue "42.5" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "2011/2012" ;
    :yValue "35.2" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "2010/2011" ;
    :yValue "29.3" ;
    :belongsTo :Chart .

:DataPoint12 a :DataPoint ;
    :xValue "2009/2010" ;
    :yValue "28.8" ;
    :belongsTo :Chart .
