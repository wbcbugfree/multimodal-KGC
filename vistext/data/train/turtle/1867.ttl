@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Which of the these apocalyptic movies depicts events that could happen in the next 25 years ?" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Share of respondents" .

:YAxis a :Axis ;
    :title "Response" .

:DataPoint1 a :DataPoint ;
    :xValue "0.37" ;
    :yValue "The Day After Tomorrow" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "0.31" ;
    :yValue "Armageddon" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "0.19" ;
    :yValue "Independence Day" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "0.19" ;
    :yValue "The Day the Earth Stood Still" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "0.15" ;
    :yValue "I Am Legend" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "0.1" ;
    :yValue "The Stand" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "0.09" ;
    :yValue "Waterworld" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "0.07" ;
    :yValue "Planet of the Apes" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "0.2" ;
    :yValue "Other" ;
    :belongsTo :Chart .
