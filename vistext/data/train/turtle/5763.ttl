@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Canada : Religious affiliation in 2011" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Share of total population" .

:YAxis a :Axis ;
    :title "Response" .

:DataPoint1 a :DataPoint ;
    :xValue "0.39" ;
    :yValue "Catholic*" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "0.203" ;
    :yValue "Protestants**" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "0.016" ;
    :yValue "Orthodox" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "0.063" ;
    :yValue "Other Christian" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "0.032" ;
    :yValue "Muslim" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "0.015" ;
    :yValue "Hindu" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "0.014" ;
    :yValue "Sikh" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "0.011" ;
    :yValue "Buddhist" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "0.01" ;
    :yValue "Jewish" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "0.006" ;
    :yValue "Other" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "0.239" ;
    :yValue "None" ;
    :belongsTo :Chart .
