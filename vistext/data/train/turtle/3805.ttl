@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Investment in travel and tourism in selected countries in the Caribbean in 2017 (in billion U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Country" .

:YAxis a :Axis ;
    :title "Investment in billion U.S. dollars" .

:DataPoint1 a :DataPoint ;
    :xValue "Bahamas" ;
    :yValue "0.4" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Trinidad and Tobago" ;
    :yValue "0.4" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "Caribbean average" ;
    :yValue "0.3" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "Aruba" ;
    :yValue "0.2" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "Antigua and Barbuda" ;
    :yValue "0.2" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Martinique" ;
    :yValue "0.1" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "St Lucia" ;
    :yValue "0.07" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "St Kitts and Nevis" ;
    :yValue "0.07" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "Bermuda" ;
    :yValue "0.03" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "Grenada" ;
    :yValue "0.03" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "Anguilla" ;
    :yValue "0.01" ;
    :belongsTo :Chart .
