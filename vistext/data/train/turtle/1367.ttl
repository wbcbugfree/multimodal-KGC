    :xValue "Dec 31, 2013" ;
    :yValue "0.0128" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Dec 31, 2014" ;
    :yValue "0.0132" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
