@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Detroit Lions average regular season home attendance from 2008 to 2019" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Average attendance" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2007" ;
    :yValue "54497" ;
    :belongsTo :Chart .

