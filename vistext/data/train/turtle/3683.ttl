@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Percentage of respondents worldwide who felt COVID-19 posed a high level of threat to their job or business as of March 14 , 2020 , by country" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Percentage of respondents" .

:YAxis a :Axis ;
    :title "Response" .

:DataPoint1 a :DataPoint ;
    :xValue "0.35" ;
    :yValue "Australia" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "0.29" ;
    :yValue "Canada" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "0.44" ;
    :yValue "France" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "0.43" ;
    :yValue "Germany" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "0.63" ;
    :yValue "Italy" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "0.34" ;
    :yValue "Japan" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "0.23" ;
    :yValue "Russia" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "0.33" ;
    :yValue "United Kingdom" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "0.37" ;
    :yValue "United States" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "0.64" ;
    :yValue "Vietnam" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "0.44" ;
    :yValue "China" ;
    :belongsTo :Chart .

:DataPoint12 a :DataPoint ;
    :xValue "0.55" ;
    :yValue "India" ;
    :belongsTo :Chart .
