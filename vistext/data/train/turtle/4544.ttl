@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Countries with the highest rate of GDP growth in the world from 2001 to 2010" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Country" .

:YAxis a :Axis ;
    :title "Annual average GDP growth in percent" .

:DataPoint1 a :DataPoint ;
    :xValue "Angola" ;
    :yValue "0.111" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "China" ;
    :yValue "0.105" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "Myanmar" ;
    :yValue "0.103" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "Nigeria" ;
    :yValue "0.089" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "Ethiopia" ;
    :yValue "0.084" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Kazakhstan" ;
    :yValue "0.082" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Chad" ;
    :yValue "0.079" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Mozambique" ;
    :yValue "0.079" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "Cambodia" ;
