@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Production volume of aquacultures in Japan from 2009 to 2018 (in 1,000 metric tons)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Production volume in thousand metric tons" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2008" ;
    :yValue "786.91" ;
    :belongsTo :Chart .

