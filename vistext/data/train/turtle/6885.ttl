@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "U.S. manufacturing shipments e-commerce value from 2003 to 2018 , by sector (in millions U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "2006" .

:YAxis a :Axis ;
    :title "machinery manufacturing" .

:DataPoint1 a :DataPoint ;
    :xValue "153996" ;
    :yValue "Food manufacturing" ;
    :belongsTo :Chart .

