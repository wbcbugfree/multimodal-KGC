@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Annual average household spending for the integrated urban water management in Italy in 2019 , by region (in euros)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Average spending in euros" .

:YAxis a :Axis ;
    :title "region of Italy" .

