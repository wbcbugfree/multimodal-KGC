@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Economic damage caused by tornadoes in the U.S. from 1995 to 2019 (in million U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Damage in million U.S. dollars" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 1994" ;
    :yValue "411" ;
    :belongsTo :Chart .

