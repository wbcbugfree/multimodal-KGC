@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Average monthly wages of musicians , singers and composers in Norway from 1st quarter 2016 to 3rd quarter 2020 (in NOK)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Quarter" .

:YAxis a :Axis ;
    :title "Average monthly wages in NOK" .

:DataPoint1 a :DataPoint ;
    :xValue "Q3 2020" ;
    :yValue "48460" ;
    :belongsTo :Chart .

