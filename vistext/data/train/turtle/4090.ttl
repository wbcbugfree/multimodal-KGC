@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Countries with the highest Facebook audience reach as of October 2020" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Reach" .

:YAxis a :Axis ;
    :title "Country" .

:DataPoint1 a :DataPoint ;
    :xValue "1" ;
    :yValue "Philippines*" ;
    :belongsTo :Chart .

