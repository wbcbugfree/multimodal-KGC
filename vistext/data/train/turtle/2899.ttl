@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Internet user penetration in Nigeria from 2015 to 2025" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "Share of population" .

:DataPoint1 a :DataPoint ;
    :xValue "2025*" ;
    :yValue "0.653" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "2024*" ;
    :yValue "0.625" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "2023*" ;
    :yValue "0.593" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "2022*" ;
    :yValue "0.555" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "2021*" ;
    :yValue "0.512" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "2020" ;
    :yValue "0.466" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "2019" ;
    :yValue "0.418" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "2018" ;
    :yValue "0.369" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "2017" ;
    :yValue "0.322" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "2016" ;
    :yValue "0.277" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "2015" ;
    :yValue "0.237" ;
    :belongsTo :Chart .
