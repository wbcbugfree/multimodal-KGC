@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Reasons for increase in alcohol consumption among Canadians who had drank more due to the COVID-19 lockdown as of April 2 , 2020" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Percentage of respondents" .

:YAxis a :Axis ;
    :title "Response" .

:DataPoint1 a :DataPoint ;
    :xValue "0.51" ;
    :yValue "Lack of regular schedule" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "0.49" ;
    :yValue "Boredom" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "0.44" ;
    :yValue "Stress" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "0.19" ;
    :yValue "Loneliness" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "0.12" ;
    :yValue "I have a lot" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "0.05" ;
    :yValue "No reason" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "0.03" ;
    :yValue "I cook more/with supper" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "0.02" ;
    :yValue "Unsure" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "0.02" ;
    :yValue "Other" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "0.02" ;
    :yValue "Social gatherings (online or at home)" ;
    :belongsTo :Chart .
