@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Number of deaths in Denmark from 2009 to 2019" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Number of deaths" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2008" ;
    :yValue "54872" ;
    :belongsTo :Chart .

