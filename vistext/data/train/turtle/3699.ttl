@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Number of branches of National Central Banks providing euro currency cash services in the eurozone as of December 2019 , by country" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Country" .

:YAxis a :Axis ;
    :title "Number of NCB branches" .

:DataPoint1 a :DataPoint ;
    :xValue "France" ;
    :yValue "43" ;
    :belongsTo :Chart .

