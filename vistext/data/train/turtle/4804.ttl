@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Change in revenue per available room in the United States lodging industry from 2010 to 2021" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Year-on-year change in RevPAR" .

:DataPoint1 a :DataPoint ;
    :xValue "2021*" ;
    :yValue "0.191" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "2020*" ;
    :yValue "-0.473" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "2019" ;
    :yValue "0.008" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "2018" ;
    :yValue "0.029" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "2017" ;
    :yValue "0.029" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "2016" ;
    :yValue "0.031" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "2015" ;
    :yValue "0.061" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "2014" ;
    :yValue "0.082" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "2013" ;
    :yValue "0.052" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "2012" ;
    :yValue "0.067" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "2011" ;
    :yValue "0.081" ;
    :belongsTo :Chart .

:DataPoint12 a :DataPoint ;
    :xValue "2010" ;
    :yValue "0.054" ;
    :belongsTo :Chart .
