@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Most popular funded gaming projects on Kickstarter as of November 2020" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "game" .

:YAxis a :Axis ;
    :title "Raised funding in 1,000 U.S. dollars" .

:DataPoint1 a :DataPoint ;
    :xValue "Frosthaven" ;
    :yValue "12969.61" ;
    :belongsTo :Chart .

