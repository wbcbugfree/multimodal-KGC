@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Best-paid TV actors of 2017/2018 in the United States , by annual income (in million U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Annual income in million U.S. dollars" .

:YAxis a :Axis ;
    :title "actors" .

:DataPoint1 a :DataPoint ;
    :xValue "26.5" ;
    :yValue "Jim Parsons" ;
    :belongsTo :Chart .

