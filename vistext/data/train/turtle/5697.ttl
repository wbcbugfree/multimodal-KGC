@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Novartis AG 's net income from 2007 to 2019 (in billion U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Net income in billion U.S. dollars" .

:YAxis a :Axis ;
    :title "Year" .

:DataPoint1 a :DataPoint ;
    :xValue "11.7" ;
    :yValue "2019*" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "12.6" ;
    :yValue "2018" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "7.7" ;
    :yValue "2017" ;
    :belongsTo :Chart .

