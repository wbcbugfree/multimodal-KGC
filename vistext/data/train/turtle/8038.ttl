@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "How often do you use various hygienic products ?" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "Monthly" .

:DataPoint1 a :DataPoint ;
    :xValue "Shampoo" ;
    :yValue "0.035" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Conditioner" ;
    :yValue "0.075" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "Body soap or wash" ;
    :yValue "0.012" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "Facial soap" ;
    :yValue "0.048" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "Facial toner" ;
    :yValue "0.142" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Facial mask" ;
    :yValue "0.318" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Shaving cream or gel" ;
    :yValue "0.214" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Deodorant or anti-perspirant" ;
    :yValue "0.033" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "Toothpaste" ;
    :yValue "0.004" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "Mouthwash" ;
    :yValue "0.188" ;
    :belongsTo :Chart .
