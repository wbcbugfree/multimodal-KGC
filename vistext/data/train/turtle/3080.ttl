@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Philadelphia 76ers all-time points leaders from 1949 to 2020" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Player" .

:YAxis a :Axis ;
    :title "Points scored" .

:DataPoint1 a :DataPoint ;
    :xValue "Hal Greer" ;
    :yValue "21586" ;
    :belongsTo :Chart .

