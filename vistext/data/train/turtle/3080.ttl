    :yValue "14184" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Billy Cunningham" ;
    :yValue "13626" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
