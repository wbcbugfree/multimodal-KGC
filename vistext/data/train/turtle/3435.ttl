@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Volume of investment in the hotel sector in selected European countries 2018 (in million euros)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Investment in million euros" .

:YAxis a :Axis ;
    :title "Country" .

