@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Market reach of the most popular Apple iOS apps in the United Kingdom as of June 2017" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Penetration rate among iOS users" .

:YAxis a :Axis ;
    :title "Platform" .

