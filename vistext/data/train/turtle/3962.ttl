    :yValue "702126" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "FCBD Edition Ultimate Spider-Man #1 (2002)" ;
    :yValue "631990" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Amazing Spider-Man #1 (2014)" ;
    :yValue "559200" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Secret Wars #1 (2015)" ;
    :yValue "550500" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Amazing Spider-Man #583 (2009)" ;
