@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Best-selling American single-issue comic books of all time in the United States as of July 2019" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "comic book" .

:YAxis a :Axis ;
    :title "Unit sales" .

:DataPoint1 a :DataPoint ;
    :xValue "X-Men #1 (1991)" ;
    :yValue "8186500" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Star Wars #1 (2015)" ;
    :yValue "1073000" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "Fantastic Four #60 (2002)" ;
    :yValue "752699" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
