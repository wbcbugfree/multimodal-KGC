@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Do you consider that there are too many , not enough or just the right number of euro coins with different values ?" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Just the right number" .

:YAxis a :Axis ;
    :title "Response" .

