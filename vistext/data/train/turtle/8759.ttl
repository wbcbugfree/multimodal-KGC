@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Total net electricity generation in the United States from 1990 to 2019 , by fuel (in billion kilowatt hours)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Coal" .

