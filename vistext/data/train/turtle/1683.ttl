@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Number of U.S. adults who received mental health treatment or counseling in the past year from 2002 to 2019 (in millions)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Number of people in millions" .

