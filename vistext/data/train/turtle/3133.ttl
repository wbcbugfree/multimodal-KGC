@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Most common comorbidities observed in coronavirus (COVID-19) deceased patients in Italy as of July 22 , 2020" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Share of deceased COVID-19 patients" .

:YAxis a :Axis ;
    :title "Response" .

:DataPoint1 a :DataPoint ;
    :xValue "0.66" ;
    :yValue "Hypertension" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "0.298" ;
    :yValue "Type 2-Diabetes" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "0.276" ;
    :yValue "Ischemic heart disease" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "0.231" ;
    :yValue "Atrial fibrillation" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "0.202" ;
    :yValue "Chronic renal failure" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "0.191" ;
    :yValue "Dementia" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "0.171" ;
    :yValue "Chronic Obstructive Pulmonary Disease (COPD)" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "0.163" ;
    :yValue "Active cancer in the last" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "5" ;
    :yValue "years" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "0.158" ;
    :yValue "Heart failure" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "0.107" ;
    :yValue "Obesity" ;
    :belongsTo :Chart .

:DataPoint12 a :DataPoint ;
    :xValue "0.106" ;
    :yValue "Stroke" ;
    :belongsTo :Chart .

:DataPoint13 a :DataPoint ;
    :xValue "0.053" ;
    :yValue "Respiratory failure" ;
    :belongsTo :Chart .

:DataPoint14 a :DataPoint ;
    :xValue "0.044" ;
    :yValue "Chronic liver disease" ;
    :belongsTo :Chart .

:DataPoint15 a :DataPoint ;
    :xValue "0.039" ;
    :yValue "Autoimmune diseases" ;
    :belongsTo :Chart .

:DataPoint16 a :DataPoint ;
    :xValue "0.019" ;
