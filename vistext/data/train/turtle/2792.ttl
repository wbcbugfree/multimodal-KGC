@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Share of Gen C online users in selected countries who curate online content as least once per week as of Summer 2013" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "Share of Gen C who curate content" .

:DataPoint1 a :DataPoint ;
    :xValue "Brazil" ;
    :yValue "0.83" ;
    :belongsTo :Chart .

