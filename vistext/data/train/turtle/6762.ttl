@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Latin America & Caribbean : Share of economic sectors in gross domestic product (GDP) from 2009 to 2019" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Agriculture" .

