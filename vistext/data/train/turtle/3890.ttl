@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Average weekly wage earned by manufacturing workers in the United States , by product type 2008 - 2010 (in U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "product type" .

:YAxis a :Axis ;
    :title "Average weekly wage in U.S. dollars" .

:DataPoint1 a :DataPoint ;
    :xValue "Petroleum refining" ;
    :yValue "742" ;
    :belongsTo :Chart .

