@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Number of enterprises in the manufacture of soft drinks , production of mineral waters and other bottled waters industry in Belgium from 2009 to 2018" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Number of enterprises" .

:YAxis a :Axis ;
    :title "Year" .

:DataPoint1 a :DataPoint ;
    :xValue "43" ;
    :yValue "2018*" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "38" ;
    :yValue "2017" ;
    :belongsTo :Chart .

