    :xValue "26" ;
    :yValue "2014" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "23" ;
    :yValue "2013" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "26" ;
    :yValue "2012" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "26" ;
    :yValue "2011" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
