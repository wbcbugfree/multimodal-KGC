@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Number of overnight stays in travel accommodation in Denmark between 2007 and 2018 (in millions)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Number of nights in millions" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2006" ;
    :yValue "28.07" ;
    :belongsTo :Chart .

