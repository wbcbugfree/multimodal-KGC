@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Number of new Opel cars registration in Poland from 2011 to 2020" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Units" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2010" ;
    :yValue "21930" ;
    :belongsTo :Chart .

