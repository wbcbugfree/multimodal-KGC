@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Public concern about the pollution of rivers , lakes and reservoirs in the United States from 1989 to 2017" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "Only a little" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 1988" ;
    :yValue "0.05" ;
    :belongsTo :Chart .

