@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Year-on-year change in German electronics exports in 2014 , by destination" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Country" .

:YAxis a :Axis ;
    :title "Percentage change" .

:DataPoint1 a :DataPoint ;
    :xValue "Poland" ;
    :yValue "0.283" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "China" ;
    :yValue "0.161" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "Netherlands" ;
    :yValue "0.115" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "Great Britain" ;
    :yValue "0.095" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "Czech Republic" ;
    :yValue "0.095" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "U.S." ;
    :yValue "0.045" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "France" ;
    :yValue "0.02" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Italy" ;
    :yValue "0.012" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "Austria" ;
    :yValue "0.011" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "Switzerland" ;
    :yValue "0" ;
    :belongsTo :Chart .
