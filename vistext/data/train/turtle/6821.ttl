@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Generation of selected materials in the U.S. municipal waste stream between 1960 and 2018 (in 1,000 tons)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Other materials*" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 1959" ;
    :yValue "70" ;
    :belongsTo :Chart .

