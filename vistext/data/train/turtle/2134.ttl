@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Number of employees at General Electric in the U.S. from 2007 to 2019 (in 1,000s)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Number of employees in thousands" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2006" ;
    :yValue "141" ;
    :belongsTo :Chart .

