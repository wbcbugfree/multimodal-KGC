@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Femicide rates in Brazil in 2019 , by state (number of femicides per 100,000 women)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Number of femicides per 100,000 women" .

:YAxis a :Axis ;
    :title "States Of Brazil" .

