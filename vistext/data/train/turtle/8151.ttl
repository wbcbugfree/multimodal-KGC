@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Sales of tesa worldwide from 2008 to 2019 , by region (in million euros)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Americas" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2007" ;
    :yValue "89.5" ;
    :belongsTo :Chart .

