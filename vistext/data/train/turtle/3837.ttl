@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Number of terrorism incidents in most impacted countries worldwide in 2019" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Number of incidents" .

:YAxis a :Axis ;
    :title "Country" .

:DataPoint1 a :DataPoint ;
    :xValue "1422" ;
    :yValue "Afghanistan" ;
    :belongsTo :Chart .

