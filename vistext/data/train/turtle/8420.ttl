@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Vehicle buyers ' use of information sources worldwide in 2012 , by country" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "United Kingdom" .

:YAxis a :Axis ;
    :title "Response" .

:DataPoint1 a :DataPoint ;
    :xValue "0.64" ;
    :yValue "Car dealer (both new and used cars)" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "0.55" ;
    :yValue "Vehicle manufacturer websites" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "0.36" ;
    :yValue "Search engine" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "0.43" ;
    :yValue "Information websites/independent car valuation services" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "0.44" ;
    :yValue "Dealer website" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "0.32" ;
    :yValue "Family and friends" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "0.37" ;
    :yValue "Specialist motoring/automotive press" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "0.19" ;
    :yValue "Web forums, blogs or internet discussion groups" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "0.18" ;
    :yValue "Print advertising" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "0.09" ;
    :yValue "Auto shows" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "0.13" ;
    :yValue "TV advertising" ;
    :belongsTo :Chart .

:DataPoint12 a :DataPoint ;
    :xValue "0.13" ;
    :yValue "Independent e-tailer sites" ;
    :belongsTo :Chart .

:DataPoint13 a :DataPoint ;
    :xValue "0.08" ;
    :yValue "Manufacturer or dealer social media page" ;
    :belongsTo :Chart .

:DataPoint14 a :DataPoint ;
    :xValue "0.17" ;
    :yValue "Car dealer (used cars only)" ;
    :belongsTo :Chart .

:DataPoint15 a :DataPoint ;
    :xValue "0.11" ;
    :yValue "Non-specialist motoring/automotive press" ;
    :belongsTo :Chart .
