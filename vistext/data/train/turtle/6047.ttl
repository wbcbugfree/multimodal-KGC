@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Airline insurance costs in worldwide commercial aviation between 2007 and 2018 , by type (in million U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Written premium" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2006" ;
    :yValue "1575" ;
    :belongsTo :Chart .

