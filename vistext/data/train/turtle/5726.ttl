@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Number of inhabitants in Iceland from 2010 to 2020" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Number of inhabitants" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2009" ;
    :yValue "317630" ;
    :belongsTo :Chart .

