@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Social media sites and tools used by U.S. charity and non-profit organizations as of spring 2014" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Share of respondents" .

:YAxis a :Axis ;
    :title "Response" .

:DataPoint1 a :DataPoint ;
    :xValue "97" ;
    :yValue "YouTube" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "92" ;
    :yValue "Facebook" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "86" ;
    :yValue "Twitter" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "72" ;
    :yValue "Pinterest" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "57" ;
    :yValue "Blog" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "57" ;
    :yValue "LinkedIn" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "52" ;
    :yValue "Google+" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "50" ;
    :yValue "Instagram" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "41" ;
    :yValue "Foursquare" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "9" ;
    :yValue "Vine" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "9" ;
    :yValue "Snapchat" ;
    :belongsTo :Chart .

:DataPoint12 a :DataPoint ;
    :xValue "3" ;
    :yValue "Tumblr" ;
    :belongsTo :Chart .
