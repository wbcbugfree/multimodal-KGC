@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Real defense spending per capita by the United Kingdom (UK) and other NATO allies , from 2009 to 2018 (in U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "UK" .

:YAxis a :Axis ;
    :title "Year" .

:DataPoint1 a :DataPoint ;
    :xValue "929.8" ;
    :yValue "2009" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "949.8" ;
    :yValue "2010" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "927.7" ;
    :yValue "2011" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "846.3" ;
    :yValue "2012" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "899.2" ;
    :yValue "2013" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "879.1" ;
    :yValue "2014" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "847.5" ;
    :yValue "2015" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "879.6" ;
    :yValue "2016" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "889.8" ;
    :yValue "2017" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "908.8" ;
    :yValue "2018*" ;
    :belongsTo :Chart .
