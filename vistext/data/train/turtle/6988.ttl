@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Monthly market capitalization of Europe 's largest banks since the Coronavirus from December 2019 to October 2020 (in billion U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "BNP Paribas (France)" .

:YAxis a :Axis ;
    :title "Month" .

:DataPoint1 a :DataPoint ;
    :xValue "43.52" ;
    :yValue "Oct '20" ;
    :belongsTo :Chart .

