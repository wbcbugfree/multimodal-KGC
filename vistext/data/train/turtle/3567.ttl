@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Production of diamonds in Angola from 2004 to 2019 (in million carats)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Production in million carats" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2003" ;
    :yValue "6.1" ;
    :belongsTo :Chart .

