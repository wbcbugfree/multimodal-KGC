@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Average monthly social welfare payment in Sweden from 2009 to 2019 (in SEK)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Average monthly social welfare payment in SEK" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2008" ;
    :yValue "8334" ;
    :belongsTo :Chart .

