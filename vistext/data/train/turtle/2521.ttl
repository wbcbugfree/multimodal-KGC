@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Number of hospitals in Chile as of March 2020 , by region" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Number of hospitals" .

:YAxis a :Axis ;
    :title "region" .

