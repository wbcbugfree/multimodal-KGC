    :xValue "Toray" ;
    :yValue "14557" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "Mitsui" ;
    :yValue "12930" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Shin-Etsu" ;
    :yValue "9816" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Teijin" ;
    :yValue "8200" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "DIC" ;
    :yValue "8114" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "Kaneka" ;
