@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Japan 's largest chemical companies 2009 , by revenue (in million U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Chemical company" .

:YAxis a :Axis ;
    :title "Revenue (in million U.S. dollars)" .

:DataPoint1 a :DataPoint ;
    :xValue "Mitsubishi" ;
    :yValue "26928" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Sumitomo" ;
    :yValue "17355" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "Asahi Kasei" ;
    :yValue "15349" ;
    :belongsTo :Chart .

