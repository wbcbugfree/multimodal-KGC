@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "UK transactions with the European Union from 2008 to 2019 (in billion GBP)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Public sector receipts" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2007" ;
    :yValue "-4.5" ;
    :belongsTo :Chart .

