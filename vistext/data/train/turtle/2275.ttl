@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Load factor of combined heat and power (CHP) schemes in the United Kingdom (UK) from 2000 to 2019 (in percent)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Load factor in percentage" .

