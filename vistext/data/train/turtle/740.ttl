@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Top 20 cities with the highest number of artificial intelligence (AI) companies as of the first half of 2018" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "State" .

:YAxis a :Axis ;
    :title "Number of companies" .

