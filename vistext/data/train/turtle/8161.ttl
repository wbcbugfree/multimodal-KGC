@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Richest people in fashion worldwide in 2012 and 2013 (in billion U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "2013" .

:YAxis a :Axis ;
    :title "Name (Company)" .

