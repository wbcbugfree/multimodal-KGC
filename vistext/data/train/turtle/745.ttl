@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Global sports market : total gate revenues from 2006 to 2015 (in billion U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Gate revenues in billion U.S. dollars" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2005" ;
    :yValue "37.06" ;
    :belongsTo :Chart .

