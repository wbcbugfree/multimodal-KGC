@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Leading European city tourism destinations in 2019 , by number of bednights (in millions)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Number of bednights in millions" .

:YAxis a :Axis ;
    :title "European city destination" .

:DataPoint1 a :DataPoint ;
    :xValue "85.1" ;
    :yValue "London*" ;
    :belongsTo :Chart .

