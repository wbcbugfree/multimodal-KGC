@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Leading egg producing countries worldwide in 2018 (in number of eggs in billions)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Country" .

:YAxis a :Axis ;
    :title "Number of eggs in billions" .

:DataPoint1 a :DataPoint ;
    :xValue "China" ;
    :yValue "458" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "United States of America" ;
    :yValue "109" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "India" ;
    :yValue "95" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "Mexico" ;
    :yValue "57.4" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "Brazil" ;
    :yValue "53" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Russia" ;
    :yValue "44" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Japan" ;
    :yValue "43.8" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Indonesia" ;
    :yValue "38" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "Turkey" ;
    :yValue "19.6" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "Pakistan" ;
    :yValue "18" ;
    :belongsTo :Chart .
