@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Comparison between alternative and traditional finance providers according to small and medium enterprises (SMEs) in the United Kingdom (UK) in 2014 , by factor" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "About the same" .

:YAxis a :Axis ;
    :title "small and medium enterprises (SMEs)" .

:DataPoint1 a :DataPoint ;
    :xValue "0.38" ;
    :yValue "Lending/Investment standards" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "0.38" ;
    :yValue "Keeping information and money safe" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "0.37" ;
    :yValue "Know-how of own industry workings" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "0.32" ;
    :yValue "Moral standards" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "0.36" ;
    :yValue "Cost of capital" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "0.34" ;
    :yValue "Generating social returns on investment" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "0.41" ;
    :yValue "Generating financial returns on investments" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "0.36" ;
    :yValue "Accessibility" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "0.33" ;
    :yValue "Speed" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "0.33" ;
    :yValue "Flexibility" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "0.29" ;
    :yValue "Willingness to take risks" ;
    :belongsTo :Chart .
