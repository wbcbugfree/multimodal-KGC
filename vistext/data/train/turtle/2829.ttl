@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Weekly video news consumption in selected countries worldwide as of February 2016" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Share of respondents" .

:YAxis a :Axis ;
    :title "Response" .

:DataPoint1 a :DataPoint ;
    :xValue "0.33" ;
    :yValue "United States" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "0.32" ;
    :yValue "Canada" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "0.3" ;
    :yValue "Brazil" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "0.29" ;
    :yValue "Turkey" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "0.28" ;
    :yValue "Ireland" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "0.27" ;
    :yValue "Australia" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "0.27" ;
    :yValue "Spain" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "0.26" ;
    :yValue "South Korea" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "0.23" ;
    :yValue "Italy" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "0.22" ;
    :yValue "United Kingdom" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "0.17" ;
    :yValue "Germany" ;
    :belongsTo :Chart .

:DataPoint12 a :DataPoint ;
    :xValue "0.16" ;
    :yValue "Japan" ;
    :belongsTo :Chart .
