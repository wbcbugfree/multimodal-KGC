@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Economic damage caused by mudslides worldwide from 1900 to 2016 (in 1,000 U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Mudslide" .

:YAxis a :Axis ;
    :title "Economic damage in thousand U.S. dollars" .

:DataPoint1 a :DataPoint ;
    :xValue "Peru (January 1983)" ;
    :yValue "988800" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "China (May 1, 1998)" ;
    :yValue "890000" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "China (August 7, 2010)" ;
    :yValue "759000" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "Italy (December 14, 1982)" ;
    :yValue "700000" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "Switzerland (February 21, 1999)" ;
    :yValue "685000" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Italy (July 28, 1987)" ;
    :yValue "625000" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Ecuador (March 28, 1993)" ;
    :yValue "500000" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Guatemala (September 4, 2010)" ;
    :yValue "500000" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "Russia (March 10, 1989)" ;
