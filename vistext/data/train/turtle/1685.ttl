@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Mortgage delinquency rates for prime conventional loans in the United States from 2000 to 2016" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Delinquency rates" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 1999" ;
    :yValue "0.023" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Dec 31, 2004" ;
    :yValue "0.023" ;
    :belongsTo :Chart .

