@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Reasons restaurant employees took a break from the industry in the United States as of October 2013" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "Share of respondents" .

:DataPoint1 a :DataPoint ;
    :xValue "To pursue another job" ;
    :yValue "0.31" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "To attend school" ;
    :yValue "0.15" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "For better pay and benefits" ;
    :yValue "0.14" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "Burned out/needed a break" ;
    :yValue "0.07" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "Had a baby" ;
    :yValue "0.06" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Wanted different hours" ;
    :yValue "0.05" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Moved/relocated" ;
    :yValue "0.04" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Wanted lifestyle change" ;
    :yValue "0.04" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "To enter military service" ;
    :yValue "0.03" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "Family issues" ;
    :yValue "0.03" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "Work-related issue" ;
    :yValue "0.02" ;
    :belongsTo :Chart .

:DataPoint12 a :DataPoint ;
    :xValue "Graduated college" ;
    :yValue "0.02" ;
    :belongsTo :Chart .

:DataPoint13 a :DataPoint ;
    :xValue "Lost job" ;
    :yValue "0.02" ;
    :belongsTo :Chart .

:DataPoint14 a :DataPoint ;
    :xValue "Got married" ;
    :yValue "0.01" ;
    :belongsTo :Chart .

:DataPoint15 a :DataPoint ;
    :xValue "Injury" ;
    :yValue "0.01" ;
    :belongsTo :Chart .
