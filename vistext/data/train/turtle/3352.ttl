@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Which of the following are you planning to implement post-lockdown ?" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Share of respondents" .

:YAxis a :Axis ;
    :title "Response" .

:DataPoint1 a :DataPoint ;
    :xValue "0.78" ;
    :yValue "Increased focus on hygiene initiatives" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "0.72" ;
    :yValue "Increased space/reduced covers" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "0.68" ;
    :yValue "Increased communication on hygiene initiatives" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "0.65" ;
    :yValue "Reduced capacity" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "0.56" ;
    :yValue "Reduced food menu items" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "0.33" ;
    :yValue "Improved delivery service/dishes" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "0.22" ;
    :yValue "Reduced drink menu items" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "0.19" ;
    :yValue "More value options" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "0.19" ;
    :yValue "Sustainability initiatives" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "0.14" ;
    :yValue "Ethical initiatives" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "0.08" ;
    :yValue "Increased transparency of the supply chain" ;
    :belongsTo :Chart .
