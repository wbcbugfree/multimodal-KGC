@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Do you think the following Disney princesses are good or bad role models for girls ?" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Don't know" .

:YAxis a :Axis ;
    :title "Response" .

:DataPoint1 a :DataPoint ;
    :xValue "0.13" ;
    :yValue "Moana" ;
    :belongsTo :Chart .

