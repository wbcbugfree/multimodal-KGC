@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Average hours per day spent on leisure and sports by U.S. population by age from 2010 to 2019" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "45 to 54 years" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2009" ;
    :yValue "4.66" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Dec 31, 2010" ;
    :yValue "4.69" ;
    :belongsTo :Chart .

