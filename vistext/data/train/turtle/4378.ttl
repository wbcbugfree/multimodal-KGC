@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Population of Luxembourg in 2020 , by age" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Number of inhabitants" .

:YAxis a :Axis ;
    :title "Year" .

