@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Leading Cricket Twenty20 World Cup wicket-takers as of September 2020" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Number of wickets taken" .

:YAxis a :Axis ;
    :title "player name" .

:DataPoint1 a :DataPoint ;
    :xValue "39" ;
    :yValue "Shahid Afridi (PAK)" ;
    :belongsTo :Chart .

