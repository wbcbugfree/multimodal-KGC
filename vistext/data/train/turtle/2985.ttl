@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Number of Volvo cars registered in Spain from 2009 to 2019" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Units registered" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2008" ;
    :yValue "5061" ;
    :belongsTo :Chart .

