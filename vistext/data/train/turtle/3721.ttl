@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Contribution to GDP of the U.S. meetings industry by sector in 2009 (in million U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "sector" .

:YAxis a :Axis ;
    :title "Contribution to GDP (in million U.S. dollars)" .

:DataPoint1 a :DataPoint ;
    :xValue "Other Industries" ;
    :yValue "37150" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Accommodations" ;
    :yValue "20910" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "Food and Beverage" ;
    :yValue "13765" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "Transportation" ;
    :yValue "13670" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "Meeting Venues" ;
    :yValue "7791" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "MeetingOrganizers" ;
    :yValue "6311" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Recreation &Entertainment" ;
    :yValue "3472" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Retail" ;
    :yValue "1860" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "Other Tourism Industries" ;
    :yValue "872" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "TravelServices" ;
    :yValue "297" ;
    :belongsTo :Chart .
