@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Prevalence of problem drug use per 1,000 inhabitants in Europe in 2018 , by country" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Country" .

:YAxis a :Axis ;
    :title "Prevalence per 1,000 inhabitants" .

:DataPoint1 a :DataPoint ;
    :xValue "Denmark" ;
    :yValue "14.65" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Finland" ;
    :yValue "10.69" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "Portugal" ;
    :yValue "10.12" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "Latvia" ;
    :yValue "9.37" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "United Kingdom" ;
    :yValue "9.16" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "France" ;
    :yValue "6.86" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Czechia" ;
    :yValue "6.49" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Austria" ;
    :yValue "6.28" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "Bulgaria" ;
    :yValue "3.75" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "Poland" ;
    :yValue "3.73" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "Croatia" ;
    :yValue "3.48" ;
