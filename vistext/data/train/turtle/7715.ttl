@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Number of deaths / injuries directly linked to boating accidents in the U.S. from 2002 to 2019" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "Injuries" .

