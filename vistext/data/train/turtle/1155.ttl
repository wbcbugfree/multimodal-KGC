@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Exports value of cold water shrimp and prawns worldwide in 2019 , by leading country (in million U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Export value in millioin U.S. dollars" .

:YAxis a :Axis ;
    :title "Country" .

:DataPoint1 a :DataPoint ;
    :xValue "28.4" ;
    :yValue "Denmark" ;
    :belongsTo :Chart .

