@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Top 15 occupations with the largest projected employment growth in the United States from 2018 to 2028 (in 1,000)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Top 15 occupations" .

:YAxis a :Axis ;
    :title "Number of new jobs in thousand" .

:DataPoint1 a :DataPoint ;
    :xValue "Personal care aides" ;
    :yValue "881" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Combined food preparation and serving workers, including fast food" ;
    :yValue "640.1" ;
    :belongsTo :Chart .

