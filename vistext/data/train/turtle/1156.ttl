    :xValue "Seattle Seahawks" ;
    :yValue "221.15" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Philadelphia Eagles" ;
    :yValue "220.14" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Denver Broncos" ;
    :yValue "215.59" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Los Angeles Chargers" ;
