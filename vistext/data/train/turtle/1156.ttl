@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Potential ticket revenue loss in the NFL due to the coronavirus (COVID-19) pandemic in the United States in 2020 , by team (in million U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "American football team" .

:YAxis a :Axis ;
    :title "Loss in million U.S. dollars" .

:DataPoint1 a :DataPoint ;
    :xValue "New England Patriots" ;
    :yValue "376.54" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Dallas Cowboys" ;
    :yValue "337.72" ;
    :belongsTo :Chart .

