@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Combined revenue of EY worldwide from 2009 to 2020 , by region (in billion U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Americas" .

:DataPoint1 a :DataPoint ;
    :xValue "2020**" ;
    :yValue "17.19" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "2019" ;
    :yValue "16.75" ;
    :belongsTo :Chart .

