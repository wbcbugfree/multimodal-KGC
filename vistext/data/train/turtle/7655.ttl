    :xValue "2015" ;
    :yValue "12.7" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "2014" ;
    :yValue "11.54" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "2013" ;
    :yValue "10.75" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "2012" ;
