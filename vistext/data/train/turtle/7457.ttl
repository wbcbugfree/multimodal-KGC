@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Travel and tourism sector as percentage of gross domestic product in the Dominican Republic from 2010 to 2019 , by type of contribution" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Total contribution" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2009" ;
    :yValue "0.145" ;
    :belongsTo :Chart .

