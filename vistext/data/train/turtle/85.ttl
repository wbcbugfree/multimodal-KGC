@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Bridgestone 's expenditure on research and development from FY 2009 to FY 2018 (in million Japanese yen)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Expenditure in million Japanese yen" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2008" ;
    :yValue "85766" ;
    :belongsTo :Chart .

