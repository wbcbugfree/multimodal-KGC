@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Total number of passengers entering and exiting from Birmingham New St Station between 2004/05 and 2016/17" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Number of passenger entries and exits" .

:DataPoint1 a :DataPoint ;
    :xValue "2016/17" ;
    :yValue "42366776" ;
    :belongsTo :Chart .

