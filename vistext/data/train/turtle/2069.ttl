@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Number of Christmas markets in Europe in 2014 , by country" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Number of markets" .

:YAxis a :Axis ;
    :title "Country" .

