@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Revenue of Johnson & Johnson 's pharmaceuticals segment worldwide from 2012 to 2024 , by product category (in billion U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Central nervous system" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2011" ;
    :yValue "6.72" ;
    :belongsTo :Chart .

