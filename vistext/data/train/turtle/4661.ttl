@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Ten countries with the largest population in mid 2019 (in millions)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Inhabitants in millions" .

:YAxis a :Axis ;
    :title "Country" .

:DataPoint1 a :DataPoint ;
    :xValue "1398.03" ;
    :yValue "China" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "1391.89" ;
    :yValue "India" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "329.15" ;
    :yValue "USA" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "268.42" ;
    :yValue "Indonesia" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "216.57" ;
    :yValue "Pakistan" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "209.33" ;
    :yValue "Brazil" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "200.96" ;
    :yValue "Nigeria" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "163.67" ;
    :yValue "Bangladesh" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "146.73" ;
    :yValue "Russia" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "126.58" ;
