    :xValue "2026*" ;
    :yValue "0.046" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "2025*" ;
    :yValue "0.045" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "2024*" ;
    :yValue "0.043" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "2023*" ;
