@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Forecast of the unemployment rate in the United States for fiscal years 2019 to 2030" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Unemployment rate" .

:DataPoint1 a :DataPoint ;
    :xValue "2030*" ;
    :yValue "0.045" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "2029*" ;
    :yValue "0.045" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "2028*" ;
    :yValue "0.045" ;
    :belongsTo :Chart .

