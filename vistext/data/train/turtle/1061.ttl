@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Gazprom 's natural and associated gas production in Russia from 2009 to 2019 (in billion cubic meters)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Production in billion cubic meters" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2008" ;
    :yValue "461.52" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Dec 31, 2009" ;
    :yValue "508.59" ;
    :belongsTo :Chart .

