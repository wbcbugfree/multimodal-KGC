@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Consequences of accidental confidential information disclosure according to internet users worldwide as of June 2015" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "Share of respondents" .

:DataPoint1 a :DataPoint ;
    :xValue "Loss of personal reputation" ;
    :yValue "0.25" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Lost friends" ;
    :yValue "0.2" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "Bullying/harassment" ;
    :yValue "0.17" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "Suffered financial losses" ;
    :yValue "0.15" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "Medical issues/worry/anxiety" ;
    :yValue "0.14" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Break up of a relationship/divorce" ;
    :yValue "0.13" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Lost job/job opportunities" ;
    :yValue "0.13" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Affected credit rating/insurance costs" ;
    :yValue "0.12" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "Other" ;
    :yValue "0.03" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "None of these" ;
    :yValue "0.07" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "Not willing to disclose" ;
    :yValue "0.15" ;
    :belongsTo :Chart .
