@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Population distribution in Australia in 2019 , by age" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "Share of population" .

:DataPoint1 a :DataPoint ;
    :xValue "0–4" ;
    :yValue "0.062" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "5–9" ;
    :yValue "0.064" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "10–14" ;
    :yValue "0.061" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "15–19" ;
    :yValue "0.059" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "20–24" ;
    :yValue "0.069" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "25–29" ;
    :yValue "0.075" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "30–34" ;
    :yValue "0.075" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "35–39" ;
    :yValue "0.07" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "40–44" ;
    :yValue "0.063" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "45–49" ;
    :yValue "0.066" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "50–54" ;
    :yValue "0.061" ;
    :belongsTo :Chart .

:DataPoint12 a :DataPoint ;
    :xValue "55–59" ;
    :yValue "0.061" ;
    :belongsTo :Chart .

:DataPoint13 a :DataPoint ;
    :xValue "60–64" ;
    :yValue "0.055" ;
    :belongsTo :Chart .

:DataPoint14 a :DataPoint ;
    :xValue "65–69" ;
    :yValue "0.048" ;
    :belongsTo :Chart .

:DataPoint15 a :DataPoint ;
    :xValue "70–74" ;
    :yValue "0.042" ;
    :belongsTo :Chart .

:DataPoint16 a :DataPoint ;
    :xValue "75–79" ;
    :yValue "0.029" ;
    :belongsTo :Chart .

