@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "U.S. sweet potato production from 2000 to 2018 (in 1,000 cwt)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Production in thousand cwt" .

