@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Countries with the largest number of active military personnel in Latin America and the Caribbean in 2019" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Country" .

:YAxis a :Axis ;
    :title "Number of personnel" .

:DataPoint1 a :DataPoint ;
    :xValue "Brazil" ;
    :yValue "334500" ;
    :belongsTo :Chart .

