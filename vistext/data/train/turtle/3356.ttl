@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Number of InterContinental hotels worldwide from 2008 to 2019" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Number of hotels" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2007" ;
    :yValue "159" ;
    :belongsTo :Chart .

