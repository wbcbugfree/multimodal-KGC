@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Number of coronavirus (COVID-19) cases , recoveries , and deaths among the most impacted countries worldwide as of December 22 , 2020" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Country" .

:YAxis a :Axis ;
    :title "Total infections" .

:DataPoint1 a :DataPoint ;
    :xValue "World" ;
    :yValue "77920539" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "USA" ;
    :yValue "18487519" ;
    :belongsTo :Chart .

