@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Sales volume of the leading national and international beer brands in Italy in 2019 (in 1,000 hectoliters)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Sales volume in thousand hectoliters" .

:YAxis a :Axis ;
    :title "leading national and international beer brands" .

:DataPoint1 a :DataPoint ;
    :xValue "6474" ;
    :yValue "Heineken Italia" ;
    :belongsTo :Chart .

