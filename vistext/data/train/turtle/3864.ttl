@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Most-affected countries and territories of explosive violence worldwide in 2013 , ranked by average civilian casualties per incident" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Country" .

:YAxis a :Axis ;
    :title "Civilian casualties per incident" .

:DataPoint1 a :DataPoint ;
    :xValue "Thailand" ;
    :yValue "3" ;
    :belongsTo :Chart .

