@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Lithuania : Employment from 2010 to 2020 (in millions)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Employment in millions" .

:DataPoint1 a :DataPoint ;
    :xValue "2020*" ;
    :yValue "1.39" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "2019*" ;
    :yValue "1.38" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "2018" ;
    :yValue "1.38" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "2017" ;
    :yValue "1.36" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "2016" ;
    :yValue "1.36" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "2015" ;
    :yValue "1.34" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "2014" ;
    :yValue "1.32" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "2013" ;
    :yValue "1.29" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "2012" ;
    :yValue "1.28" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "2011" ;
    :yValue "1.25" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "2010" ;
    :yValue "1.25" ;
    :belongsTo :Chart .
