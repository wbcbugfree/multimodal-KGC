@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Turnover of the heat pumps energy sector in France from 2006 to 2017 , by segment (in million euros)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Sales and maintenance" .

:YAxis a :Axis ;
    :title "Year" .

:DataPoint1 a :DataPoint ;
    :xValue "363" ;
    :yValue "2017**" ;
    :belongsTo :Chart .

