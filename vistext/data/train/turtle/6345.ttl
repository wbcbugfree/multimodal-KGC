@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Voter turnout rates among black voters , by age , in U.S. presidential elections from 1964 to 2016" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "25-44" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 1963" ;
    :yValue "0.615" ;
    :belongsTo :Chart .

