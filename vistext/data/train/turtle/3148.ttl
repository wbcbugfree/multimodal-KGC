@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Which channels do you currently use to make applicants aware of vacant positions/your company ?" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Share of users" .

:YAxis a :Axis ;
    :title "Response" .

:DataPoint1 a :DataPoint ;
    :xValue "0.92" ;
    :yValue "Job portals" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "0.87" ;
    :yValue "Company career page" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "0.56" ;
    :yValue "Internal employee referrals" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "0.53" ;
    :yValue "Own network" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "0.48" ;
    :yValue "Fairs (e.g. university fairs, job & career fairs)" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "0.46" ;
    :yValue "Social media for direct contact (\"Active Sourcing\")" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "0.45" ;
    :yValue "Print media (newspapers, specialist magazines)" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "0.45" ;
    :yValue "Social media for job postings" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "0.43" ;
    :yValue "Social media for employer branding" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "0.39" ;
    :yValue "Intranet" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "0.34" ;
    :yValue "Personnel consultants/service providers/temporary work" ;
    :belongsTo :Chart .

:DataPoint12 a :DataPoint ;
    :xValue "0.3" ;
    :yValue "CV databases (internal)" ;
    :belongsTo :Chart .

:DataPoint13 a :DataPoint ;
    :xValue "0.3" ;
    :yValue "External employee referrals" ;
    :belongsTo :Chart .

:DataPoint14 a :DataPoint ;
    :xValue "0.21" ;
    :yValue "CV databases (external)" ;
    :belongsTo :Chart .

:DataPoint15 a :DataPoint ;
    :xValue "0.03" ;
    :yValue "Other, not listed" ;
    :belongsTo :Chart .

:DataPoint16 a :DataPoint ;
    :xValue "0.02" ;
    :yValue "We're not recruiting" ;
    :belongsTo :Chart .
