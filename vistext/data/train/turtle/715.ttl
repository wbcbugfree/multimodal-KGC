@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Total outlay forecast of the U.S. military retirement trust fund from 2020 to 2030 (in million U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Outlays in million U.S. dollars" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2019" ;
    :yValue "61850" ;
    :belongsTo :Chart .

