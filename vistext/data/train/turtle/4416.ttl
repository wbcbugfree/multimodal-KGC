@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Average monthly West Texas Intermediate (WTI) crude oil price from November 2019 to November 2020 (in U.S. dollars per barrel)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Price in U.S. dollars per barrel" .

:YAxis a :Axis ;
    :title "Month" .

:DataPoint1 a :DataPoint ;
    :xValue "40.94" ;
    :yValue "Nov 20" ;
    :belongsTo :Chart .

