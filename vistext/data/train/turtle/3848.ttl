@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Average number of employees in Greenland in 2018 , by industry" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "industry" .

:YAxis a :Axis ;
    :title "Average number of employees" .

:DataPoint1 a :DataPoint ;
    :xValue "Public administration and service" ;
    :yValue "11058" ;
    :belongsTo :Chart .

