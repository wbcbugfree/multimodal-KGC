@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Estimated net worth of the ten richest Hungarians in 2019 (in billion forints)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "ten richest Hungarians" .

:YAxis a :Axis ;
    :title "Net worth in billion forints" .

:DataPoint1 a :DataPoint ;
    :xValue "Lőrinc Mészáros" ;
    :yValue "407.7" ;
    :belongsTo :Chart .

