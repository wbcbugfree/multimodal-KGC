@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Monthly import value of animal feed in Canada from 2015 to 2020 (in million Canadian dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Month" .

:YAxis a :Axis ;
    :title "2018" .

:DataPoint1 a :DataPoint ;
    :xValue "De" ;
    :yValue "150.9" ;
    :belongsTo :Chart .

