@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Olive oil production in selected countries worldwide from 2011/2012 to 2018/2019 in 1,000 metric tons)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "2014/2015" .

:YAxis a :Axis ;
    :title "Country" .

:DataPoint1 a :DataPoint ;
    :xValue "1550" ;
    :yValue "EU-27" ;
    :belongsTo :Chart .

