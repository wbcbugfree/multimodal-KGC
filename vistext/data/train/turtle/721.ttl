@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Monthly number of unemployed persons in the United States from November 2019 to November 2020 (in millions , unadjusted)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Month" .

:YAxis a :Axis ;
    :title "Unemployed in millions" .

:DataPoint1 a :DataPoint ;
    :xValue "Nov '20" ;
    :yValue "10.26" ;
    :belongsTo :Chart .

