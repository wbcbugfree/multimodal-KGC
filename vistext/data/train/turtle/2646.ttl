@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Thirty day prevalence of use of any illicit drug for grades 8 , 10 and 12 combined from 1991 to 2019" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "Percentage of respondents" .

