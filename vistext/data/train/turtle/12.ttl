@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Self-isolation index during the coronavirus (COVID-19) outbreak in Russia on January 3 , 2021 , by largest city" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "big city" .

:YAxis a :Axis ;
    :title "Index points" .

:DataPoint1 a :DataPoint ;
    :xValue "Omsk" ;
    :yValue "3.6" ;
    :belongsTo :Chart .

