@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Time spent per person on leading website categories in Italy in October 2020 (in minutes)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "leading website categories" .

:YAxis a :Axis ;
    :title "Time spent online in minutes" .

:DataPoint1 a :DataPoint ;
    :xValue "Member communities" ;
    :yValue "1018" ;
    :belongsTo :Chart .

