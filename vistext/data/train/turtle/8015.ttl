@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Countries with the highest commitment to cyber security based on the Global Cybersecurity Index (GCI) in 2018" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Organizational" .

:YAxis a :Axis ;
    :title "Country" .

:DataPoint1 a :DataPoint ;
    :xValue "0.2" ;
    :yValue "United Kingdom" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "0.2" ;
    :yValue "United States" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "0.2" ;
    :yValue "France" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "0.2" ;
    :yValue "Lithuania" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "0.19" ;
    :yValue "Estonia" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "0.19" ;
    :yValue "Singapore" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "0.2" ;
    :yValue "Spain" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "0.2" ;
    :yValue "Malaysia" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "0.18" ;
    :yValue "Norway" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "0.2" ;
    :yValue "Canada" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "0.2" ;
    :yValue "Australia" ;
    :belongsTo :Chart .
