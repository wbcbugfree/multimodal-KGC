@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Number of participants in basketball in the United States from 2006 to 2018 (in millions)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Number of participants in millions" .

