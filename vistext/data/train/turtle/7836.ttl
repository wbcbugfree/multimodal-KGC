@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Off-course betting turnover in the gambling industry in Great Britain (GB) from 2009 to 2019 , by sector (in billion GBP)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Other" .

:YAxis a :Axis ;
    :title "Month" .

:DataPoint1 a :DataPoint ;
    :xValue "0.47" ;
    :yValue "Oct 18 - Sep 19" ;
    :belongsTo :Chart .

