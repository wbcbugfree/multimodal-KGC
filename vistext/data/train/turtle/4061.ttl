@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Median annual family income in Canada in 2018 , by province (in Canadian dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Median income in Canadian dollars" .

:YAxis a :Axis ;
    :title "Country" .

