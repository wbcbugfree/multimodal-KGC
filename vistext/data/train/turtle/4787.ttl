@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Total U.S. grain production from 2001 to 2016 (in million metric tons)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Production in million metric tons" .

