@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Tourism expenditure in the Netherlands from 2010 to 2018 , by category (in million euros)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Other expenditure" .

:YAxis a :Axis ;
    :title "Year" .

:DataPoint1 a :DataPoint ;
    :xValue "2799" ;
    :yValue "2010" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "2799" ;
    :yValue "2011" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "2795" ;
    :yValue "2012" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "2768" ;
    :yValue "2013" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "2799" ;
    :yValue "2014" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "2864" ;
    :yValue "2015" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "2901" ;
    :yValue "2016" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "2994" ;
    :yValue "2017" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "3051" ;
    :yValue "2018" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "3180" ;
    :yValue "2019*" ;
    :belongsTo :Chart .
