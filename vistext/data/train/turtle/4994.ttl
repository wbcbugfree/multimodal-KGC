@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Total consumption of paper and board in the United States from 2006 to 2018 (in 1,000 tons)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Consumption in thousand tons" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2005" ;
    :yValue "102439" ;
    :belongsTo :Chart .

