@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Adult internet usage penetration in the United States from 2000 to 2019 , by age group" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "65+ years" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 1999" ;
    :yValue "0.14" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Dec 31, 2004" ;
    :yValue "0.28" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "Dec 31, 2008" ;
    :yValue "0.4" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "Dec 31, 2009" ;
    :yValue "0.43" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "Dec 31, 2010" ;
    :yValue "0.46" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Dec 31, 2012" ;
    :yValue "0.56" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Dec 31, 2013" ;
    :yValue "0.57" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Dec 31, 2014" ;
    :yValue "0.63" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "Dec 31, 2015" ;
    :yValue "0.64" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "Dec 31, 2017" ;
    :yValue "0.66" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "Dec 31, 2018" ;
    :yValue "0.73" ;
    :belongsTo :Chart .
