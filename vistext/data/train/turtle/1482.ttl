@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Municipal solid waste discards to landfill in California from 1995 to 2019 (in million tons)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Discards in million tons" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 1994" ;
    :yValue "33.92" ;
    :belongsTo :Chart .

