@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Foreign-born population in Sweden in 2019 , by region of birth" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Number of inhabitants" .

:YAxis a :Axis ;
    :title "Country" .

:DataPoint1 a :DataPoint ;
    :xValue "782386" ;
    :yValue "Asia" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "377900" ;
    :yValue "EU28 except the Nordic countries" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "267240" ;
    :yValue "Europe except EU28 and the Nordic countries" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "231584" ;
    :yValue "The Nordic countries, excluding Sweden" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "231276" ;
    :yValue "Africa" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "74199" ;
    :yValue "South America" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "41775" ;
    :yValue "North America" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "6450" ;
    :yValue "Oceania" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "5381" ;
    :yValue "Former USSR" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "1542" ;
    :yValue "Unknown" ;
    :belongsTo :Chart .
