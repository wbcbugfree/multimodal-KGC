@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Share of desktop search traffic originating from Google in selected countries as of October 2020" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Share of search traffic" .

:YAxis a :Axis ;
    :title "Response" .

:DataPoint1 a :DataPoint ;
    :xValue "0.9258" ;
    :yValue "Brazil" ;
    :belongsTo :Chart .

