@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Number of natural gas and condensate producing wells in the United States from 2005 to 2019" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Number of wells" .

