@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Number of fatalities in traffic accidents in Belgium in 2019 , by age and region" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Brussels-Capital Region" .

:YAxis a :Axis ;
    :title "Year" .

:DataPoint1 a :DataPoint ;
    :xValue "0" ;
    :yValue "0-4" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "0" ;
    :yValue "5-9" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "1" ;
    :yValue "10-14" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "1" ;
    :yValue "15-19" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "3" ;
    :yValue "20-24" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "4" ;
    :yValue "25-29" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "1" ;
    :yValue "30-34" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "0" ;
    :yValue "35-39" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "1" ;
    :yValue "40-44" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "0" ;
    :yValue "45-49" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "3" ;
    :yValue "50-54" ;
    :belongsTo :Chart .

:DataPoint12 a :DataPoint ;
    :xValue "1" ;
    :yValue "55-59" ;
    :belongsTo :Chart .

:DataPoint13 a :DataPoint ;
    :xValue "1" ;
    :yValue "60-64" ;
    :belongsTo :Chart .

:DataPoint14 a :DataPoint ;
    :xValue "1" ;
    :yValue "65-69" ;
    :belongsTo :Chart .

:DataPoint15 a :DataPoint ;
    :xValue "2" ;
    :yValue "70-74" ;
    :belongsTo :Chart .

:DataPoint16 a :DataPoint ;
    :xValue "1" ;
    :yValue "75 and older" ;
    :belongsTo :Chart .

:DataPoint17 a :DataPoint ;
    :xValue "0" ;
    :yValue "Information unavailable" ;
    :belongsTo :Chart .
