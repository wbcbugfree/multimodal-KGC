@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Tier 1 capital ratio at Bank of America from 2009 to 2019" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Tier 1 capital ratio" .

:YAxis a :Axis ;
    :title "Year" .

:DataPoint1 a :DataPoint ;
    :xValue "0.126" ;
    :yValue "2019" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "0.132" ;
    :yValue "2018" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "0.13" ;
    :yValue "2017" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "0.124" ;
    :yValue "2016" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "0.113" ;
    :yValue "2015" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "0.134" ;
    :yValue "2014*" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "0.122" ;
    :yValue "2013" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "0.11" ;
    :yValue "2012" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "0.099" ;
    :yValue "2011" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "0.086" ;
    :yValue "2010" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "0.078" ;
    :yValue "2009" ;
    :belongsTo :Chart .
