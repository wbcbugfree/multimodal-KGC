@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Los Angeles Clippers all-time points leaders from 1970 to 2020" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "human" .

:YAxis a :Axis ;
    :title "Points scored" .

:DataPoint1 a :DataPoint ;
    :xValue "Randy Smith" ;
    :yValue "12735" ;
    :belongsTo :Chart .

