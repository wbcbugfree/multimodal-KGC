@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Mean annual out-of-pocket expense per person for prescribed medicine in the U.S. from 1987 to 2014 , by insurance status" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Public insurance only" .

:YAxis a :Axis ;
    :title "Uninsured all year" .

