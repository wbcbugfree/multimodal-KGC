@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Tobacco control spending versus tobacco-related revenues in the United States from 1998 to 2010 (in million U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Tobacco control spending" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 1997" ;
    :yValue "262.3" ;
    :belongsTo :Chart .

