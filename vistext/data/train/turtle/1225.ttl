@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Online shopping cart abandonment rate in the United States from 1st quarter 2012 to 4th quarter 2015" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Quarter" .

:YAxis a :Axis ;
    :title "Shopping cart abandonment rate" .

