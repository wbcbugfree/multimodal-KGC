@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Leading cotton producing countries worldwide in 2019/2020 (in 1,000 metric tons)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Production in thousand metric tons" .

:YAxis a :Axis ;
    :title "Country" .

:DataPoint1 a :DataPoint ;
    :xValue "6423" ;
    :yValue "India" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "5933" ;
    :yValue "China" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "4336" ;
    :yValue "United States" ;
    :belongsTo :Chart .

