    :xValue "2918" ;
    :yValue "Brazil" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "1350" ;
    :yValue "Pakistan" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "762" ;
    :yValue "Uzbekistan" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "751" ;
    :yValue "Turkey" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "365" ;
    :yValue "Greece" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "342" ;
