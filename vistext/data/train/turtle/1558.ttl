@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Single-game scoring records NCAA men 's Division I college basketball as of 2020" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Points scored" .

:YAxis a :Axis ;
    :title "Basketball player" .

