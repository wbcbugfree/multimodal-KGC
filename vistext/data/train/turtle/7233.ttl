@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Number of Russian tourist arrivals in Egypt from 2012 to October 2017 , by month (in1,000s)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "2012" .

:YAxis a :Axis ;
    :title "Month" .

:DataPoint1 a :DataPoint ;
    :xValue "248.36" ;
    :yValue "Dec" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "320.12" ;
    :yValue "Nov" ;
    :belongsTo :Chart .

