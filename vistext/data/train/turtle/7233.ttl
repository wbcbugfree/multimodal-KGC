    :yValue "Jul" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "145.84" ;
    :yValue "Jun" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "187.82" ;
    :yValue "May" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "238.93" ;
    :yValue "Apr" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
