@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Gross domestic product of Nova Scotia , Canada in 2019 , by industry (in million chained 2012 Canadian dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "industry classification" .

:YAxis a :Axis ;
    :title "GDP in million chained 2012 Canadian dollars" .

:DataPoint1 a :DataPoint ;
    :xValue "Real estate and rental and leasing" ;
    :yValue "6194.8" ;
    :belongsTo :Chart .

