@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Ease of doing business (EODB) ranking of Poland compared to other worldwide locations from 2019 to 2020 , by topic" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Doing Business 2020" .

:YAxis a :Axis ;
    :title "Ease of doing business (EODB) topic" .

:DataPoint1 a :DataPoint ;
    :xValue "40" ;
    :yValue "General doing business rank" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "1" ;
    :yValue "Trading across borders" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "25" ;
    :yValue "Resolving insolvency" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "37" ;
    :yValue "Getting credit" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "39" ;
    :yValue "Dealing with construction permits" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "51" ;
    :yValue "Protecting minority investors" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "55" ;
    :yValue "Enforcing contracts" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "60" ;
    :yValue "Getting electricity" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "77" ;
    :yValue "Paying taxes" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "92" ;
    :yValue "Registering property" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "128" ;
    :yValue "Starting a business" ;
    :belongsTo :Chart .
