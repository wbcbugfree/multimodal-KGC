@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Football players in the Chinese Super League ranked by weekly salary in 2020 (in 1,000 euros)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Football player" .

:YAxis a :Axis ;
    :title "Player salary in thousand euros" .

