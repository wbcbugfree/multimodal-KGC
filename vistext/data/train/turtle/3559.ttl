@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Number of new jobs created in Mexico between January and April 2017 , by state" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Number of jobs" .

:YAxis a :Axis ;
    :title "state of Mexico" .

