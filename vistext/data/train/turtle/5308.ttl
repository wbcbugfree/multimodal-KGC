@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Leading Italian photography accounts on Instagram in Italy as of February 2018 , ranked by number of Instagram followers (in 1,000s)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Number of Instagram followers in thousands" .

:YAxis a :Axis ;
    :title "photographer" .

:DataPoint1 a :DataPoint ;
    :xValue "903.5" ;
    :yValue "Andrea Melchiorre (Andreamelchiorre1)" ;
    :belongsTo :Chart .

