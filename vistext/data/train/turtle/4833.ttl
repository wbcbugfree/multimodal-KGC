@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Annual revenue of Yandex from 2007 to 2019 (in billion Russian rubles)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Revenue in billion Russian rubles" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2006" ;
    :yValue "4.25" ;
    :belongsTo :Chart .

