@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Leading e-retailers worldwide in 2015 , based on retail revenue (in billion U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Company (Country of origin)" .

:YAxis a :Axis ;
    :title "Retail revenue in billion U.S. dollars" .

