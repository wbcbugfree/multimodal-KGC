@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Total/average regular season home attendance of the Arizona Coyotes from 2005/06 to 2019/20" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Total attendance" .

:YAxis a :Axis ;
    :title "Year" .

