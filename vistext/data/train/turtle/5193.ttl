@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Garage door openers used the most by construction firms in the United States in 2018" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Share of respondents" .

:YAxis a :Axis ;
    :title "Brand" .

:DataPoint1 a :DataPoint ;
    :xValue "0.5" ;
    :yValue "Liftmaster" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "0.149" ;
    :yValue "Chamberlain" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "0.096" ;
    :yValue "Overhead Door" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "0.079" ;
    :yValue "Genie" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "0.053" ;
    :yValue "Craftsmen" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "0.035" ;
    :yValue "Wayne-Dalton" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "0.035" ;
    :yValue "Raynor" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "0.009" ;
    :yValue "Linear" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "0.009" ;
    :yValue "Access Master" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "0.009" ;
    :yValue "Marantec" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "0.026" ;
    :yValue "None of these" ;
