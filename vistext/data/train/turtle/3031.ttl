@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Total number of acquired hospitals in U.S. hospital transactions from 2007 to 2017" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Number of acquired hospitals" .

:DataPoint1 a :DataPoint ;
    :xValue "2017" ;
    :yValue "216" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "2016" ;
    :yValue "241" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "2015" ;
    :yValue "267" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "2014" ;
    :yValue "169" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "2013*" ;
    :yValue "292" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "2012" ;
    :yValue "242" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "2011" ;
    :yValue "160" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "2010" ;
    :yValue "125" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "2009" ;
    :yValue "80" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "2008" ;
    :yValue "78" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "2007" ;
    :yValue "149" ;
    :belongsTo :Chart .
