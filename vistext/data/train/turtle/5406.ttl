@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Leading exporting countries of furniture worldwide in 2018 (in million U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Country" .

:YAxis a :Axis ;
    :title "Import value in million U.S. dollars" .

:DataPoint1 a :DataPoint ;
    :xValue "China" ;
    :yValue "63539.6" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Germany" ;
    :yValue "13385.5" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "Poland" ;
    :yValue "13145.8" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "Italy" ;
    :yValue "12051.3" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "Mexico" ;
    :yValue "7993.6" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "United States" ;
    :yValue "7741.1" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Vietnam" ;
    :yValue "7094.4" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Canada" ;
    :yValue "4625.4" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "Czech Republic" ;
    :yValue "4617.5" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "United Kingdom" ;
    :yValue "3030.3" ;
    :belongsTo :Chart .
