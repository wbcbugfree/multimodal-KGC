@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Amount of freight transported by inland waterway in Russia from 2006 to 2019 (in million tonne-kilometres)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Transport volume in million tonne-kilometres" .

:DataPoint1 a :DataPoint ;
    :xValue "2019" ;
    :yValue "65906" ;
    :belongsTo :Chart .

