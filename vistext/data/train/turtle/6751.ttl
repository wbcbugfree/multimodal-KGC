@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Number of Deloitte employees worldwide from 2010 to 2020 , by level" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Level" .

:YAxis a :Axis ;
    :title "Professional staff*" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2009" ;
    :yValue "129219" ;
    :belongsTo :Chart .

