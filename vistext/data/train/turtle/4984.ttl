@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Dividend per share of Daimler AG from FY 2006 to FY 2019 (in euros)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Dividend per share in euros" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2005" ;
    :yValue "1.5" ;
    :belongsTo :Chart .

