@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Johnson & Johnson 's net income from 2005 to 2019 (in million U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Net income in million U.S. dollars" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2004" ;
    :yValue "10060" ;
    :belongsTo :Chart .

