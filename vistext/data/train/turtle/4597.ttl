@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Most viewed YouTube channels worldwide as of October 2020 , by monthly views (in billions)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Monthly views in billions" .

:YAxis a :Axis ;
    :title "YouTube channel" .

:DataPoint1 a :DataPoint ;
    :xValue "3.92" ;
    :yValue "T-Series" ;
    :belongsTo :Chart .

