@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Number of computed tomography (CT) scanners in Germany from 2005 to 2017" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Number of CT scanners" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2004" ;
    :yValue "2434" ;
    :belongsTo :Chart .

