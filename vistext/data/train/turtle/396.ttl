@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Total global aquaculture production value of Atlantic salmon from 2000 to 2010 (in million U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Production value in million U.S. dollars" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 1999" ;
    :yValue "2812.1" ;
    :belongsTo :Chart .

