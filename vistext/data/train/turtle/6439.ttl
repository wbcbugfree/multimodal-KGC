@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Forbes ranking of the best colleges in the United States in 2019 , by tuition cost and average debt" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "best colleges in the United States" .

:YAxis a :Axis ;
    :title "Average debt" .

