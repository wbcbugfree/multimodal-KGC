@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Number of PwC employees worldwide from 2010 to 2020" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Number of employees" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2009" ;
    :yValue "161718" ;
    :belongsTo :Chart .

