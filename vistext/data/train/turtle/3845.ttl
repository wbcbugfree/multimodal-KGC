@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Share of music video streams in the United States in 2018 , by genre" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Genre" .

:YAxis a :Axis ;
    :title "Share of consumption" .

:DataPoint1 a :DataPoint ;
    :xValue "Rap /Hip-Hop" ;
    :yValue "0.228" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Latin" ;
    :yValue "0.218" ;
    :belongsTo :Chart .

