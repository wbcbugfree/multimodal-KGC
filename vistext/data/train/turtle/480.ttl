@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Outbound travel and tourism expenditure in leading countries worldwide in 2019 (in billion U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Internal consumption in billion U.S. dollars" .

:YAxis a :Axis ;
    :title "Country" .

:DataPoint1 a :DataPoint ;
    :xValue "262.1" ;
    :yValue "China" ;
    :belongsTo :Chart .

