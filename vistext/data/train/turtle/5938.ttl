@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Number of small and medium-sized enterprises in the cosmetics manufacturing industry in selected European countries in 2018" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Country" .

:YAxis a :Axis ;
    :title "Number of SMEs" .

:DataPoint1 a :DataPoint ;
    :xValue "France" ;
    :yValue "872" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Italy" ;
    :yValue "828" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "United Kingdom" ;
    :yValue "578" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "Poland" ;
    :yValue "493" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "Spain" ;
    :yValue "476" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Germany" ;
    :yValue "397" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Hungary" ;
    :yValue "228" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Switzerland" ;
    :yValue "225" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "Sweden" ;
    :yValue "197" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "Netherlands" ;
    :yValue "176" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "Other" ;
    :yValue "1350" ;
    :belongsTo :Chart .
