@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Total assets of MGM Resorts worldwide from 2008 to 2019 (in billion U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Total assets in billion U.S. dollars" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2007" ;
    :yValue "23.27" ;
    :belongsTo :Chart .

