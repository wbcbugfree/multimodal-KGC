@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Leading 10 U.S. states based on the number of active specialist physicians as of 2020" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Number of specialist physicians" .

:YAxis a :Axis ;
    :title "State" .

:DataPoint1 a :DataPoint ;
    :xValue "59418" ;
    :yValue "California" ;
    :belongsTo :Chart .

