@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Exports of goods and services as percentage of GDP in Finland in selected years from 2000 to 2019" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Ratio to GDP" .

:DataPoint1 a :DataPoint ;
    :xValue "2019*" ;
    :yValue "0.401" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "2018*" ;
    :yValue "0.385" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "2017*" ;
    :yValue "0.376" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "2016" ;
    :yValue "0.348" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "2015" ;
    :yValue "0.354" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "2014" ;
    :yValue "0.365" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "2013" ;
    :yValue "0.38" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "2012" ;
    :yValue "0.388" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "2011" ;
    :yValue "0.389" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "2010" ;
    :yValue "0.384" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "2005" ;
    :yValue "0.403" ;
    :belongsTo :Chart .

:DataPoint12 a :DataPoint ;
    :xValue "2000" ;
    :yValue "0.42" ;
    :belongsTo :Chart .
