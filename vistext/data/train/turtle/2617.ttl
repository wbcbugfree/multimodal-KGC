@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Nepal : The ten largest cities in 2011 , based on the number of residents (in millions)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Residents in millions" .

:YAxis a :Axis ;
    :title "city" .

:DataPoint1 a :DataPoint ;
    :xValue "1" ;
    :yValue "Kāṭhmāḍaũ (Kathmandu)" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "0.26" ;
    :yValue "Pokharā" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "0.23" ;
    :yValue "Lalitpur" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "0.2" ;
    :yValue "Birāṭnagar" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "0.15" ;
    :yValue "Bharatpur" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "0.14" ;
    :yValue "Bīrguñj" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "0.12" ;
    :yValue "Buṭwal" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "0.12" ;
    :yValue "Dharān" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "0.11" ;
    :yValue "Mahendranagar" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "0.1" ;
    :yValue "Dhangaḍhī" ;
    :belongsTo :Chart .
