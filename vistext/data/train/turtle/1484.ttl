@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Breakdown of 55,924 sample patients infected with novel coronavirus COVID-19 in China as of February 22 , 2020 , by symptom" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Share of patients" .

:YAxis a :Axis ;
    :title "Response" .

:DataPoint1 a :DataPoint ;
    :xValue "0.879" ;
    :yValue "Fever" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "0.677" ;
    :yValue "Dry cough" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "0.381" ;
    :yValue "Fatigue" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "0.334" ;
    :yValue "Sputum production*" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "0.186" ;
    :yValue "Shortness of breath" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "0.148" ;
    :yValue "Muscle pain/joint pain" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "0.139" ;
    :yValue "Sore throat" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "0.136" ;
    :yValue "Headache" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "0.114" ;
    :yValue "Chills" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "0.05" ;
    :yValue "Nausea/vomiting" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "0.048" ;
    :yValue "Nasal congestion" ;
    :belongsTo :Chart .

:DataPoint12 a :DataPoint ;
    :xValue "0.037" ;
    :yValue "Diarrhoea" ;
    :belongsTo :Chart .
