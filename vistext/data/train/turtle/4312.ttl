@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Ethnicity of all non-'white ' usual residents in Northern Ireland on March 27 , 2011" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Share of all usual residents" .

:YAxis a :Axis ;
    :title "Response" .

:DataPoint1 a :DataPoint ;
    :xValue "0.0035" ;
    :yValue "Chinese" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "0.0034" ;
    :yValue "Indian" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "0.0033" ;
    :yValue "Mixed" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "0.0028" ;
    :yValue "Other Asian" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "0.0013" ;
    :yValue "Other" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "0.0013" ;
    :yValue "Black African" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "0.0007" ;
    :yValue "Irish Traveller" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "0.0006" ;
    :yValue "Pakistani" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "0.0005" ;
    :yValue "Black other" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "0.0003" ;
    :yValue "Bangladeshi" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "0.0002" ;
    :yValue "Black Caribbean" ;
    :belongsTo :Chart .
