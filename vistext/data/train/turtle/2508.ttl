@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Barriers preventing programmatic advertising adoption in EU-5 organiztions as of May 2014" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "Share of respondents" .

:DataPoint1 a :DataPoint ;
    :xValue "Skills shortage" ;
    :yValue "0.29" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "No budget available" ;
    :yValue "0.26" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "Lack of 'transparency'" ;
    :yValue "0.13" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "Resistance from clients" ;
    :yValue "0.13" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "Dictated policy" ;
    :yValue "0.12" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Fear of unknown" ;
    :yValue "0.12" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Internal resistance" ;
    :yValue "0.11" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Sceptical of programmatic" ;
    :yValue "0.06" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "Resistance from agencies" ;
    :yValue "0.04" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "Other" ;
    :yValue "0.06" ;
    :belongsTo :Chart .
