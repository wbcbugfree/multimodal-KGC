@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Sales per average store of Limited Brands worldwide from 2010 to 2019 , by brand (in thousand U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Bath & Body Works*" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2009" ;
    :yValue "1468" ;
    :belongsTo :Chart .

