@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Value of state and local construction put in place in the U.S. in 2018 , by leading state (in million U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Construction value in million U.S. dollars" .

:YAxis a :Axis ;
    :title "State" .

:DataPoint1 a :DataPoint ;
    :xValue "37121" ;
    :yValue "California" ;
    :belongsTo :Chart .

