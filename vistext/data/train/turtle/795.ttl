@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Share of football players with a migration background on FIFA World Cups from 1930 to 2018" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "Share of players" .

