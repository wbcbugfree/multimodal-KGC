@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Prevalence of new HIV infections in selected countries worldwide as of 2018 (per 1,000 population)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Country" .

:YAxis a :Axis ;
    :title "HIV infections per 1,000 population" .

:DataPoint1 a :DataPoint ;
    :xValue "Eswatini" ;
    :yValue "8.62" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Lesotho" ;
    :yValue "7.8" ;
    :belongsTo :Chart .

