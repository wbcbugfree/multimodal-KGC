@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Revenue from IT services in Western Europe from 2005 to 2015 (in million U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Revenue in million U.S. dollars" .

:YAxis a :Axis ;
    :title "Year" .

:DataPoint1 a :DataPoint ;
    :xValue "270552" ;
    :yValue "2015*" ;
    :belongsTo :Chart .

