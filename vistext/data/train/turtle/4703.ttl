@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Leading sources of worldwide social media referral traffic in the 2nd half 2017 , by share of visits" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Share of traffic" .

:YAxis a :Axis ;
    :title "Response" .

:DataPoint1 a :DataPoint ;
    :xValue "0.1816" ;
    :yValue "Facebook" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "0.0753" ;
    :yValue "Pinterest" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "0.0074" ;
    :yValue "Twitter" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "0.0073" ;
    :yValue "Instagram" ;
    :belongsTo :Chart .

