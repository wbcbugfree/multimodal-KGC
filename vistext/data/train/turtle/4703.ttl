    :xValue "0.0017" ;
    :yValue "YouTube" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "0.0013" ;
    :yValue "Flipboard" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "0.001" ;
    :yValue "StumbleUpon" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "0.0007" ;
    :yValue "Buzzfeed" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "0.0007" ;
    :yValue "Reddit" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "0.0005" ;
    :yValue "LinkedIn" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "0.0004" ;
    :yValue "Yummly" ;
    :belongsTo :Chart .

