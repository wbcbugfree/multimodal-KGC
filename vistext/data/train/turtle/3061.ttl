    :xValue "0.109" ;
    :yValue "Philippines" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "0.077" ;
    :yValue "Spain" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "0.059" ;
    :yValue "Thailand" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "0.042" ;
    :yValue "Indonesia" ;
    :belongsTo :Chart .

