@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Distribution of top importers of tuna in the United Kingdom (UK) in 2017 , by share of total volume imported" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Share of total volume imported" .

:YAxis a :Axis ;
    :title "Response" .

:DataPoint1 a :DataPoint ;
    :xValue "0.159" ;
    :yValue "Seychelles" ;
    :belongsTo :Chart .

