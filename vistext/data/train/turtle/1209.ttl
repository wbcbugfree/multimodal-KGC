@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Global net sales of the largest consumer goods companies in Asia in 2013 (in million U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Consumer goods companies" .

:YAxis a :Axis ;
    :title "Net sales in million U.S. dollars" .

:DataPoint1 a :DataPoint ;
    :xValue "Samsung Electronics Co., Ltd." ;
    :yValue "210397" ;
    :belongsTo :Chart .

