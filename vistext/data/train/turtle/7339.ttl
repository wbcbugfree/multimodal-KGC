@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Sales of beer in Ontario , Canada from 2008 to 2019 , by product type (in million Canadian dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Imported beer" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2007" ;
    :yValue "490.97" ;
    :belongsTo :Chart .

