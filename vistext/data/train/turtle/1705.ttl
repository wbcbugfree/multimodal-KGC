@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Frontier Airlines ' revenue passenger miles from 2004 to 2019 (in billions)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Revenue passenger miles in billions" .

