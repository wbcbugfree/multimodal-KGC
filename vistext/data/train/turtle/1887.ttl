@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Import volume of grapes in Canada from 2010/11 to 2019/20 (in 1,000 metric tons)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Import volume in 1,000 metric tons" .

:DataPoint1 a :DataPoint ;
    :xValue "2019/20*" ;
    :yValue "188" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "2018/19" ;
    :yValue "180" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "2017/18" ;
    :yValue "180" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "2016/17" ;
    :yValue "176" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "2015/16" ;
    :yValue "170" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "2014/15" ;
    :yValue "175" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "2013/14" ;
    :yValue "180" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "2012/13" ;
    :yValue "176" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "2011/12" ;
    :yValue "173" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "2010/11" ;
    :yValue "189" ;
    :belongsTo :Chart .
