@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Annual sales revenue of John Lewis in the United Kingdom (UK) from 2009 to 2020 (in million GBP)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Revenue in million GBP" .

:YAxis a :Axis ;
    :title "Year" .

:DataPoint1 a :DataPoint ;
    :xValue "3781.6" ;
    :yValue "2020" ;
    :belongsTo :Chart .

