@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Average student loan debt on entry to repayment in the United Kingdom (UK) from 2000 to 2020 , by repayment cohort (in 1,000 GBP) by country" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Northern Ireland" .

