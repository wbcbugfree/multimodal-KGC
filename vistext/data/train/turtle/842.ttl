@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Number of visits to Christmas markets in Europe in 2014 , by country (in millions)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Number of visits in millions" .

:YAxis a :Axis ;
    :title "Country" .

:DataPoint1 a :DataPoint ;
    :xValue "270" ;
    :yValue "Germany" ;
    :belongsTo :Chart .

