@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Retail new passenger car sales in the United States from 1990 to 2019 (in 1,000 units)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Domestic*" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2007" ;
    :yValue "4491" ;
    :belongsTo :Chart .

