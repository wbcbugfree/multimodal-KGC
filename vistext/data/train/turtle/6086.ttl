@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Annual number of data breaches and exposed records in the United States from 2005 to 1st half 2020 (in millions)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Million records exposed" .

:YAxis a :Axis ;
    :title "Year" .

