    :xValue "British Columbia" ;
    :yValue "44500" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Manitoba" ;
    :yValue "35354" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "New Brunswick" ;
    :yValue "19550" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Saskatchewan" ;
    :yValue "16175" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "Nunavut" ;
    :yValue "14200" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "North West Territory" ;
