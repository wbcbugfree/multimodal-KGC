@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Number of snowmobile registrations in Canada in 2018 , by province" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "province of Canada" .

:YAxis a :Axis ;
    :title "Number of registrations" .

:DataPoint1 a :DataPoint ;
    :xValue "Quebec" ;
    :yValue "201732" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Ontario" ;
    :yValue "155000" ;
    :belongsTo :Chart .

