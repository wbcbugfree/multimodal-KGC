@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Number of betting shops in the United Kingdom from 2009 to 2019 , by operator" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "William Hill" .

:DataPoint1 a :DataPoint ;
    :xValue "Feb 28, 2009" ;
    :yValue "2238" ;
