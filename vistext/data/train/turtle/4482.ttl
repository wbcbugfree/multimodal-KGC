@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Leading pharmaceutical companies in Denmark in 2018 , by revenue (in billion DKK)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "pharmaceutical company" .

:YAxis a :Axis ;
    :title "Revenue in billion DKK" .

:DataPoint1 a :DataPoint ;
    :xValue "Novo Nordisk" ;
    :yValue "111.83" ;
    :belongsTo :Chart .

