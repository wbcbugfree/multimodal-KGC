@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Annual volume of cranberries and blueberries sold in the United Kingdom (UK) from 2008 to 2018 (in 1,000 tonnes)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Sales volume in thousand tonnes" .

:YAxis a :Axis ;
    :title "Year" .

:DataPoint1 a :DataPoint ;
    :xValue "24.2" ;
    :yValue "2018*" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "21.2" ;
    :yValue "2017*" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "18.8" ;
    :yValue "2016*" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "16.8" ;
    :yValue "2015 *" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "15.1" ;
    :yValue "2014 *" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "13.8" ;
    :yValue "2013" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "12.6" ;
    :yValue "2012" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "11.5" ;
    :yValue "2011" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "10.2" ;
    :yValue "2010" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "8.4" ;
    :yValue "2009" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "6.6" ;
    :yValue "2008" ;
    :belongsTo :Chart .
