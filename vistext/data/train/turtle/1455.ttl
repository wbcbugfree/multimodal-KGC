@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Revenue of Chuck E. Cheese 's worldwide from 2007 to 2019 (in million U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Revenue in million U.S. dollars" .

