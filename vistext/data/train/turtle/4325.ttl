@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Number of Scottish Premiership titles won from as of 2020 , by club" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "association football club" .

:YAxis a :Axis ;
    :title "Number of titles" .

