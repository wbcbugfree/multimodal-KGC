@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Number of people shot to death by the police in the United States from 2017 to November 2020 , by month" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "2018" .

:YAxis a :Axis ;
    :title "Month" .

:DataPoint1 a :DataPoint ;
    :xValue "99" ;
    :yValue "Jan" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "80" ;
    :yValue "Feb" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "110" ;
    :yValue "Mar" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "98" ;
    :yValue "Apr" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "83" ;
    :yValue "May" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "81" ;
    :yValue "Jun" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "89" ;
    :yValue "Jul" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "74" ;
    :yValue "Aug" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "55" ;
    :yValue "Sep" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "75" ;
    :yValue "Oct" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "77" ;
    :yValue "Nov" ;
    :belongsTo :Chart .

:DataPoint12 a :DataPoint ;
    :xValue "71" ;
    :yValue "Dec" ;
    :belongsTo :Chart .
