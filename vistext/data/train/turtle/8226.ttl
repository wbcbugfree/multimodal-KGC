@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Percentage of U.S. adults likely to change select behaviors in response to coronavirus (COVID-19) as of March 1 , 2020" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Less likely" .

:YAxis a :Axis ;
    :title "Response" .

:DataPoint1 a :DataPoint ;
    :xValue "0.38" ;
    :yValue "Use public transport" ;
    :belongsTo :Chart .

