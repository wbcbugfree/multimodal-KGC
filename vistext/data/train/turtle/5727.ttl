@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Cinema admissions annually in the United Kingdom (UK) from 2007 to 2019 (in million individuals)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Individuals admitted in millions" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2006" ;
    :yValue "162.5" ;
    :belongsTo :Chart .

