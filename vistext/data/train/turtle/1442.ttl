@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Leading mining companies worldwide based on market capitalization in 2020 (in billion U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Market capitalization in billion U.S. dollars" .

:YAxis a :Axis ;
    :title "Mining company" .

:DataPoint1 a :DataPoint ;
    :xValue "92.13" ;
    :yValue "BHP, Australia/UK" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "79.42" ;
    :yValue "Rio Tinto, Australia/UK" ;
    :belongsTo :Chart .

