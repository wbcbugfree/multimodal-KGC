    :yValue "China Shenhua Energy, China" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "25.53" ;
    :yValue "Franco-Nevada, Canada" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "23.36" ;
