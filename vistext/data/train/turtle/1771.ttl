@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Number of respondents that had perceived out-of-home advertising in Spain from February to November 2019 , by format (in 1,000s)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Number of respondents in thousands" .

:YAxis a :Axis ;
    :title "Advertisement Type" .

