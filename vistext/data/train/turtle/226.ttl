@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Cumulated advertising spending in Sweden from January to November 2020 , by media (in million SEK)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "advertising" .

:YAxis a :Axis ;
    :title "Advertising spendings in million SEK" .

:DataPoint1 a :DataPoint ;
    :xValue "Total" ;
    :yValue "11498.74" ;
    :belongsTo :Chart .

