@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Ranking of the preferred French female personalities in France in 2019" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Share of respondents" .

:YAxis a :Axis ;
    :title "Response" .

:DataPoint1 a :DataPoint ;
    :xValue "0.22" ;
    :yValue "Simone Veil" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "0.05" ;
    :yValue "Sophie Marceau" ;
    :belongsTo :Chart .

