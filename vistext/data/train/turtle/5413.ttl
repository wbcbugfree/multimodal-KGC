@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Leading players of the German national football team as of September 2020 , by market value (in million euros)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "player name" .

:YAxis a :Axis ;
    :title "Market value in million euros" .

