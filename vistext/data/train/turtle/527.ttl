@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Number of Facebook user accounts that may have been compromised in the Cambridge Analytica scandal as of April 2018 , by country" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Country" .

:YAxis a :Axis ;
    :title "Number of user accounts" .

:DataPoint1 a :DataPoint ;
    :xValue "United States" ;
    :yValue "70632350" ;
    :belongsTo :Chart .

