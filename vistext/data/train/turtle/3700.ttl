@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Number of Volvo cars sold in Greece from 2008 to 2019" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Units sold" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2007" ;
    :yValue "2173" ;
    :belongsTo :Chart .

