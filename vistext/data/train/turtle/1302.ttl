@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Change in military spending in the 15 countries with the highest military expenditure 2010 to 2019" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Country" .

:YAxis a :Axis ;
    :title "Change in military spending" .

:DataPoint1 a :DataPoint ;
    :xValue "China" ;
    :yValue "0.85" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "India" ;
    :yValue "0.37" ;
    :belongsTo :Chart .

