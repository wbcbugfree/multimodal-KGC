@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Average ticket price Brooklyn Nets games of the NBA from 2006/07 to 2015/16 (in U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Average ticket price in U.S. dollars" .

:YAxis a :Axis ;
    :title "Year" .

:DataPoint1 a :DataPoint ;
    :xValue "66.15" ;
    :yValue "2015/16" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "66.15" ;
    :yValue "2014/15" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "60.5" ;
    :yValue "2013/14" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "55.89" ;
    :yValue "2012/13*" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "37.06" ;
    :yValue "2011/12" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "40.5" ;
    :yValue "2010/11" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "44.51" ;
    :yValue "2009/10" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "54.98" ;
    :yValue "2008/09" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "60.98" ;
