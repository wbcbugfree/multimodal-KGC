@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Leading Android apps in the Google Play Store in Belgium as of September 2020 , by number of downloads (in 1,000s)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Number of downloads in thousands" .

:YAxis a :Axis ;
    :title "app name" .

