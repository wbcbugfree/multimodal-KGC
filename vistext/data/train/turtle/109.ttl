@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Revenue of the Indian gaming industry in the United States from 2006 to 2018 (in billion U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Revenue in billion U.S. dollars" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2005" ;
    :yValue "24.89" ;
    :belongsTo :Chart .

