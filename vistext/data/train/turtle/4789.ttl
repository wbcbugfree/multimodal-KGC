@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Average price per ounce of high quality marijuana as of October 2020 , by select U.S. state (in U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Price in U.S. dollars per ounce" .

:YAxis a :Axis ;
    :title "State" .

