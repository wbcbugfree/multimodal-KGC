@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Route length of railways across India from financial year 2003 to 2019 (in 1,000 kilometers)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Route length in thousand kilometers" .

:YAxis a :Axis ;
    :title "year" .

