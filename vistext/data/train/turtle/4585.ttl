@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Average regular season home attendance of the San Francisco Giants from 2009 to 2019" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Average attendance" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2008" ;
    :yValue "35322" ;
    :belongsTo :Chart .

