@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Total number of employed people in Vietnam from 2008 to 2018 (in millions)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Number of employed people in millions" .

:YAxis a :Axis ;
    :title "Year" .

:DataPoint1 a :DataPoint ;
    :xValue "54.25" ;
    :yValue "2018*" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "53.7" ;
    :yValue "2017" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "53.3" ;
    :yValue "2016" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "52.84" ;
    :yValue "2015" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "52.74" ;
    :yValue "2014" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "52.21" ;
    :yValue "2013" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "51.42" ;
    :yValue "2012" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "50.35" ;
    :yValue "2011" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "49.05" ;
    :yValue "2010" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "47.74" ;
    :yValue "2009" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "46.46" ;
    :yValue "2008" ;
    :belongsTo :Chart .
