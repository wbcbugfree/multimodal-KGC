@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "All time top goal scorers of the national football team of Iceland as of January 2020 , by goals scored" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "player name" .

:YAxis a :Axis ;
    :title "Goals scored" .

:DataPoint1 a :DataPoint ;
    :xValue "Eidur Gudjohnsen" ;
    :yValue "26" ;
    :belongsTo :Chart .

