@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Total number of points scored by Kobe Bryant in the NBA from 1996 to 2016 , by season" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Number of points scored" .

