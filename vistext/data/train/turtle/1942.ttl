@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Estimated revenue of gold tier VR games sold on Steam in 2017 (in 1,000 U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Revenue in thousand U.S. dollars" .

:YAxis a :Axis ;
    :title "Title (release date)" .

:DataPoint1 a :DataPoint ;
    :xValue "2467.79" ;
    :yValue "Virtual Desktop (March 2016)" ;
    :belongsTo :Chart .

