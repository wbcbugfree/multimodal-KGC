@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Annual electricity imports in the United Kingdom (UK) from 2000 to 2019 (in gigawatt hours)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Electricity imports in gigawatt hours" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 1999" ;
    :yValue "14308" ;
    :belongsTo :Chart .

