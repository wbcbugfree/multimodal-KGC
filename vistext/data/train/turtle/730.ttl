@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Number of prescription items dispensed per month per pharmacy in England from 2006/07 to 2018/19" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Number of prescription items per pharmacy" .

:DataPoint1 a :DataPoint ;
    :xValue "2018-19" ;
    :yValue "7268" ;
    :belongsTo :Chart .

