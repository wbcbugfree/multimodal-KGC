@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Total population in Denmark from 2010 to 2020 , by citizenship (in millions)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Danish citizenship" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2009" ;
    :yValue "5.2" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Dec 31, 2010" ;
    :yValue "5.21" ;
    :belongsTo :Chart .

