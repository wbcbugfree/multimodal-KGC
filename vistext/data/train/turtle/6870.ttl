@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Cargo revenue ton miles of U.S. commercial air carriers from 2006 to 2020 (in billions)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Fiscal year" .

:YAxis a :Axis ;
    :title "Domestic" .

:DataPoint1 a :DataPoint ;
    :xValue "2020*" ;
    :yValue "16.51" ;
    :belongsTo :Chart .

