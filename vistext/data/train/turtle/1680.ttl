@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Number of single-woman households in Denmark in 2020 , by age group" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Number of single-women households" .

:YAxis a :Axis ;
    :title "Year" .

:DataPoint1 a :DataPoint ;
    :xValue "3971" ;
    :yValue "Under 20 years" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "81919" ;
    :yValue "20-29 years" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "67568" ;
    :yValue "30-39 years" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "93175" ;
    :yValue "40-49 years" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "102124" ;
    :yValue "50-59 years" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "98651" ;
    :yValue "60-69 years" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "122470" ;
    :yValue "70-79 years" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "91788" ;
    :yValue "80-89 years" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "28471" ;
    :yValue "90-99 years" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "922" ;
    :yValue "100 years and more" ;
    :belongsTo :Chart .
