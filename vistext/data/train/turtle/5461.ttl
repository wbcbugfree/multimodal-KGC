@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Number of registered motor vehicles across Gujarat in India from financial year 2007 to 2017 (in millions)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "financial year" .

:YAxis a :Axis ;
    :title "Number of vehicles in millions" .

:DataPoint1 a :DataPoint ;
    :xValue "FY 2017" ;
    :yValue "22.04" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "FY 2016" ;
    :yValue "20.36" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "FY 2015" ;
    :yValue "18.72" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "FY 2014" ;
    :yValue "17.09" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "FY 2013" ;
    :yValue "15.77" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "FY 2012" ;
    :yValue "14.41" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "FY 2011" ;
    :yValue "12.99" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "FY 2010" ;
    :yValue "11.87" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "FY 2009" ;
    :yValue "11" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "FY 2008" ;
    :yValue "10.29" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "FY 2007" ;
    :yValue "9.5" ;
    :belongsTo :Chart .
