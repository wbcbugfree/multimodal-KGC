@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Change in carbon dioxide emissions in selected countries between 1990 and 2017" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Change in CO2 emissions" .

:YAxis a :Axis ;
    :title "Country" .

:DataPoint1 a :DataPoint ;
    :xValue "3.383" ;
    :yValue "China (including Hong Kong)" ;
    :belongsTo :Chart .

