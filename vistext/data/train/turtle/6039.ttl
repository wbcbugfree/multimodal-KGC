@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Number of students enrolled in postsecondary institutions in Canada in 2017/18 , by gender and field of study" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Women" .

:YAxis a :Axis ;
    :title "Field of study" .

:DataPoint1 a :DataPoint ;
    :xValue "214998" ;
    :yValue "Business, management and public administration" ;
    :belongsTo :Chart .

