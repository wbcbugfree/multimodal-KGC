@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Share of individuals using online services related to travel or travel related accommodation in Great Britain from 2007 to 2017" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "Share of respondents" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2006" ;
    :yValue "0.42" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Dec 31, 2007" ;
    :yValue "0.45" ;
    :belongsTo :Chart .

