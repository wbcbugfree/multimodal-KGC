@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Most watched Coppa Italia football matches in Italy in 2020 , by TV audience (in 1,000s viewers)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Number of TV viewers in thousands" .

:YAxis a :Axis ;
    :title "Match" .

:DataPoint1 a :DataPoint ;
    :xValue "10202" ;
    :yValue "SSC Napoli - Juventus FC(Jun 17, 2020)" ;
    :belongsTo :Chart .

