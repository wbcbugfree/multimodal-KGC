@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Most popular daily activities of female internet users in the United States as of February 2017" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Share of internet users" .

:YAxis a :Axis ;
    :title "Response" .

:DataPoint1 a :DataPoint ;
    :xValue "0.45" ;
    :yValue "Buy a product online" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "0.2" ;
    :yValue "Buy or make a reservation for travel" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "0.55" ;
    :yValue "Check weather reports and forecasts online" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "0.55" ;
    :yValue "Do any banking online" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "0.66" ;
    :yValue "Get news online" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "0.42" ;
    :yValue "Look for news and information about politics" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "0.14" ;
    :yValue "Participate in an online auction" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "0.35" ;
    :yValue "Send instant messages" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "0.82" ;
    :yValue "Send or read e-mail" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "0.7" ;
    :yValue "Use a search engine to find information" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "0.56" ;
    :yValue "Use a social networking site" ;
    :belongsTo :Chart .

:DataPoint12 a :DataPoint ;
    :xValue "0.15" ;
    :yValue "Use classified ads sites like Craigslist" ;
    :belongsTo :Chart .

:DataPoint13 a :DataPoint ;
    :xValue "0.4" ;
    :yValue "Watch a video on a video-sharing site" ;
    :belongsTo :Chart .

:DataPoint14 a :DataPoint ;
    :xValue "0.01" ;
    :yValue "None of the above" ;
    :belongsTo :Chart .

:DataPoint15 a :DataPoint ;
    :xValue "0" ;
    :yValue "I don’t use the Internet" ;
    :belongsTo :Chart .
