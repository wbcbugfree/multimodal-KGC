@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Market capitalization compound annual growth rate of selected U.S. biotech companies between 2012 and 2016" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "selected U\\.S\\. biotech companies" .

:YAxis a :Axis ;
    :title "CAGR" .

:DataPoint1 a :DataPoint ;
    :xValue "Incyte Corporation" ;
    :yValue "0.78" ;
    :belongsTo :Chart .

