@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Most popular apps used by smartphone owners in Spain in 2014 , by app type" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "Share of app users" .

:DataPoint1 a :DataPoint ;
    :xValue "Instant Messaging" ;
    :yValue "0.99" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Social networks" ;
    :yValue "0.924" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "Photos" ;
    :yValue "0.79" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "Email" ;
    :yValue "0.769" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "Games" ;
    :yValue "0.768" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Music" ;
    :yValue "0.767" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Maps" ;
    :yValue "0.739" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Weather" ;
    :yValue "0.673" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "Videos/films" ;
    :yValue "0.445" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "News" ;
    :yValue "0.428" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "Sport" ;
    :yValue "0.357" ;
    :belongsTo :Chart .

:DataPoint12 a :DataPoint ;
    :xValue "Reading" ;
    :yValue "0.242" ;
    :belongsTo :Chart .

:DataPoint13 a :DataPoint ;
    :xValue "Travel" ;
    :yValue "0.157" ;
    :belongsTo :Chart .

:DataPoint14 a :DataPoint ;
    :xValue "Dating" ;
    :yValue "0.121" ;
    :belongsTo :Chart .
