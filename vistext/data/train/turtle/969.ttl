@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Most expensive retail locations worldwide as of June 2019 , by annual rent (in U.S. dollars per square foot)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Retail location" .

:YAxis a :Axis ;
    :title "Annual rent in U.S. dollars per square foot" .

:DataPoint1 a :DataPoint ;
    :xValue "Causeway Bay, main street shops (Hong Kong)" ;
    :yValue "2745" ;
    :belongsTo :Chart .

