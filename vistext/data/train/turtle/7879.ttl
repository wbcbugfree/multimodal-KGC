@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Global underserved international airline routes in 2015 , by type of booking" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "One-stop bookings" .

:YAxis a :Axis ;
    :title "Global underserved* international airline routes" .

:DataPoint1 a :DataPoint ;
    :xValue "279733" ;
    :yValue "Jakarta (CGK) - Jeddah (JED)" ;
    :belongsTo :Chart .

