@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Vine accounts with the most followers worldwide as of January 2017 (in millions)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Vine account" .

:YAxis a :Axis ;
    :title "Number of followers in millions" .

:DataPoint1 a :DataPoint ;
    :xValue "KingBach" ;
    :yValue "16.27" ;
    :belongsTo :Chart .

