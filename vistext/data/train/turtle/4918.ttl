@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Planned annual Halloween expenditure in the United States from 2006 to 2020 (in billion U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Planned expenditure in billion U.S. dollars" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2005" ;
    :yValue "4.96" ;
    :belongsTo :Chart .

