@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "African countries with the largest population as of 2020 (in 1,000 individuals)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Population in thousands" .

:YAxis a :Axis ;
    :title "Country" .

