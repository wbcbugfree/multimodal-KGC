@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Caterpillar 's expenses for research and development from FY 2007 to FY 2019 (in million U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Expenses in million U.S. dollars" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2006" ;
    :yValue "1404" ;
    :belongsTo :Chart .

