@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Leading countries based on number of asylum and refugee status applications from Venezuelan citizens in 2019" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Country" .

:YAxis a :Axis ;
    :title "Asylum seekers" .

:DataPoint1 a :DataPoint ;
    :xValue "Peru" ;
    :yValue "482571" ;
    :belongsTo :Chart .

