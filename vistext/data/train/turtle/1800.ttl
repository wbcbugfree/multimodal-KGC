@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Total pharmaceutical R & D expenditures in Canada from 2004 to 2018 (in billion Canadian dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Expenditure in billion Canadian dollars" .

