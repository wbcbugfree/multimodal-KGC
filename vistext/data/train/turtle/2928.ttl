@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Friendliness towards the LGBT community in Latin America in 2016 , by country (index score)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Country" .

:YAxis a :Axis ;
    :title "Friendliness score on the scale from 1 to 14*" .

:DataPoint1 a :DataPoint ;
    :xValue "Uruguay" ;
    :yValue "1" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Argentina" ;
    :yValue "1" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "Brazil" ;
    :yValue "3" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "Colombia" ;
    :yValue "4" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "Chile" ;
    :yValue "6" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Mexico" ;
    :yValue "6" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Ecuador" ;
    :yValue "8" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Bolivia" ;
    :yValue "9" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "Peru" ;
    :yValue "10" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "El Salvador" ;
    :yValue "10" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "Costa Rica" ;
    :yValue "12" ;
    :belongsTo :Chart .

:DataPoint12 a :DataPoint ;
    :xValue "Nicaraguas" ;
    :yValue "13" ;
    :belongsTo :Chart .

:DataPoint13 a :DataPoint ;
    :xValue "Honduras" ;
    :yValue "14" ;
    :belongsTo :Chart .

:DataPoint14 a :DataPoint ;
    :xValue "Guatemala" ;
    :yValue "14" ;
    :belongsTo :Chart .

:DataPoint15 a :DataPoint ;
    :xValue "Paraguay" ;
    :yValue "14" ;
    :belongsTo :Chart .
