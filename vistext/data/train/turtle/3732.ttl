@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Albania : Ratio of government expenditure to gross domestic product (GDP) from 2015 to 2025" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Ratio of government expenditure to GDP" .

:YAxis a :Axis ;
    :title "Year" .

:DataPoint1 a :DataPoint ;
    :xValue "0.2872" ;
    :yValue "2025*" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "0.2889" ;
    :yValue "2024*" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "0.2909" ;
    :yValue "2023*" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "0.2967" ;
    :yValue "2022*" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "0.3147" ;
    :yValue "2021*" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "0.3289" ;
    :yValue "2020*" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "0.2938" ;
    :yValue "2019*" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "0.2882" ;
    :yValue "2018" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "0.2915" ;
    :yValue "2017" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "0.2914" ;
    :yValue "2016" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "0.3038" ;
    :yValue "2015" ;
    :belongsTo :Chart .
