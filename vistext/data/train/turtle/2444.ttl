@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Top global oil companies by proved oil reserves in 2013 (in million barrels)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Reserves in million barrels" .

:YAxis a :Axis ;
    :title "leading world gas and oil companies" .

:DataPoint1 a :DataPoint ;
    :xValue "30788" ;
    :yValue "OJSC Rosneft Oil Company**" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "13461" ;
    :yValue "OAO LUKOIL*" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "13239" ;
    :yValue "Exxon Mobil Corporation*" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "11079" ;
    :yValue "Petroleos Mexicanos (PEMEX)" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "11040.8" ;
    :yValue "Petroleo Brasileiro, S.A. (Petrobras)*" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "10820" ;
    :yValue "PetroChina Company Limited" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "10070" ;
    :yValue "BP p.l.c.*" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "6621" ;
    :yValue "Royal Dutch Shell plc*" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "6345" ;
    :yValue "Chevron Corporation*" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "5523" ;
    :yValue "ConocoPhillips*" ;
    :belongsTo :Chart .
