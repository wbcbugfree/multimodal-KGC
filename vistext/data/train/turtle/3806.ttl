@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Chicago White Sox all-time wins leaders as of October 2020" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Chicago White Sox all-time wins leaders" .

:YAxis a :Axis ;
    :title "Number of games won" .

:DataPoint1 a :DataPoint ;
    :xValue "Ted Lyons" ;
    :yValue "260" ;
    :belongsTo :Chart .

