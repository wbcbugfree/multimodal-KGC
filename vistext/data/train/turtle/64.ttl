@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Neodymium oxide price worldwide from 2009 to 2025 (in U.S. dollars per metric ton)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Price in U.S. dollars per metric ton" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2008" ;
    :yValue "15427" ;
    :belongsTo :Chart .

