@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Distribution of e-mail antivirus activations as of 1st quarter 2020 , by country" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "Percentage of spam mails worldwide" .

:DataPoint1 a :DataPoint ;
    :xValue "Spain" ;
    :yValue "0.0966" ;
    :belongsTo :Chart .

