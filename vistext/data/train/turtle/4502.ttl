@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Magnesite reserves worldwide as of 2019 , by major countries (in 1,000 metric tons)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Country" .

:YAxis a :Axis ;
    :title "Reserves in thousand metric tons" .

:DataPoint1 a :DataPoint ;
    :xValue "Russia" ;
    :yValue "2300000" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "North Korea" ;
    :yValue "2300000" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "China" ;
    :yValue "1000000" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "Brazil" ;
    :yValue "390000" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "Australia" ;
    :yValue "320000" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Greece" ;
    :yValue "280000" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Turkey" ;
    :yValue "230000" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Slovakia" ;
    :yValue "120000" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "India" ;
    :yValue "82000" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "Austria" ;
    :yValue "50000" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "Spain" ;
    :yValue "35000" ;
    :belongsTo :Chart .

:DataPoint12 a :DataPoint ;
    :xValue "United States" ;
    :yValue "35000" ;
    :belongsTo :Chart .
