@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Net sales of Dick 's Sporting Goods in the United States from 2012 to 2019 , by merchandise category (in million U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Hardlines*" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2007" ;
    :yValue "2217" ;
    :belongsTo :Chart .

