@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Average annual household expenditures in New Brunswick , Canada in 2017 (in Canadian dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Average expenditure in Canadian dollars" .

:YAxis a :Axis ;
    :title "household expenditure" .

:DataPoint1 a :DataPoint ;
    :xValue "12692" ;
    :yValue "Shelter" ;
    :belongsTo :Chart .

