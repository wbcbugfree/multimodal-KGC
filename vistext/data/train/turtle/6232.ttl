@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Monthly average daily temperatures in the United Kingdom (UK) from 2015 to 2020 (in degrees Celsius)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "2020" .

:YAxis a :Axis ;
    :title "Month" .

:DataPoint1 a :DataPoint ;
    :xValue "17.2" ;
    :yValue "Aug" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "15.7" ;
    :yValue "Jul" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "15.1" ;
    :yValue "Jun" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "12.6" ;
    :yValue "May" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "10.3" ;
    :yValue "Apr" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "6.8" ;
    :yValue "Mar" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "6.4" ;
    :yValue "Feb" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "6.7" ;
    :yValue "Jan" ;
    :belongsTo :Chart .
