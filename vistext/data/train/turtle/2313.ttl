@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Leading financial advisors to M & A transactions in the Republic of Ireland in 2019 , by deal volume" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Number of M&A deals" .

:YAxis a :Axis ;
    :title "Leading financial advisors to M&A transactions" .

:DataPoint1 a :DataPoint ;
    :xValue "17" ;
    :yValue "IBI Corporate Finance" ;
    :belongsTo :Chart .

