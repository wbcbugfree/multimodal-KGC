    :yValue "Goldman Sachs" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "7" ;
    :yValue "RSM" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
