@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Number of Red Lobster restaurants in the U.S. and Canada from 2000 to 2013" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Number of restaurants" .

