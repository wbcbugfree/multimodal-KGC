@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Number of employees of EY worldwide 2009 to 2020 , by service line" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Practice support" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2008" ;
    :yValue "29905" ;
    :belongsTo :Chart .

