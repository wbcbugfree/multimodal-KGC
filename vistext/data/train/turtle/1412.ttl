    :xValue "0.249" ;
    :yValue "Russia" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "0.238" ;
    :yValue "Mexico" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "0.212" ;
    :yValue "Worldwide" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "0.211" ;
    :yValue "China" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "0.153" ;
    :yValue "France" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "0.13" ;
    :yValue "Germany" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "0.12" ;
    :yValue "United States" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "0.115" ;
    :yValue "United Kingdom" ;
