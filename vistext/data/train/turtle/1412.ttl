@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Encounter rate trends for the locations with the most computers reporting malware detections as of 2nd quarter 2016" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Encounter and detection rate" .

:YAxis a :Axis ;
    :title "Country" .

:DataPoint1 a :DataPoint ;
    :xValue "0.326" ;
    :yValue "India" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "0.314" ;
    :yValue "Turkey" ;
    :belongsTo :Chart .

