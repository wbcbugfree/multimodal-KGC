@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Annual expenditure on footwear in the United Kingdom (UK) from 2005 to 2019 , based on volume (in million GBP)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Expenditure in million GBP" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2004" ;
    :yValue "4903" ;
    :belongsTo :Chart .

