@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Average weekly working hours in the Netherlands in 2018 , by age" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Per job per week excluding overtime" .

:YAxis a :Axis ;
    :title "Year" .

:DataPoint1 a :DataPoint ;
    :xValue "6.7" ;
    :yValue "Younger than 15 years" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "13.1" ;
    :yValue "15-19 years" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "24" ;
    :yValue "20-24 years" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "31.6" ;
    :yValue "25-29 years" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "32.2" ;
    :yValue "30-34 years" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "31.5" ;
    :yValue "35-39 years" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "31.2" ;
    :yValue "40-44 years" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "31.1" ;
    :yValue "45-49 years" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "30.9" ;
    :yValue "50-54 years" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "30.5" ;
    :yValue "55-59 years" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "29.6" ;
    :yValue "60-64 years" ;
    :belongsTo :Chart .

:DataPoint12 a :DataPoint ;
    :xValue "21.8" ;
    :yValue "65-74 years" ;
    :belongsTo :Chart .

:DataPoint13 a :DataPoint ;
    :xValue "16.2" ;
    :yValue "75 years or older" ;
    :belongsTo :Chart .
