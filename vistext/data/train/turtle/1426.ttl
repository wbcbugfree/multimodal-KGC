@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Estimated revenue of platinum tier VR games sold on Steam in 2017 (in 1,000 U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Revenue in thousand U.S. dollars" .

:YAxis a :Axis ;
    :title "Title (release date)" .

:DataPoint1 a :DataPoint ;
    :xValue "4731.12" ;
    :yValue "Fallout 4 VR (December 2017)" ;
    :belongsTo :Chart .

