@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Consumer price index for non-food in Ethiopia from 2019 to 2020" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Month" .

:YAxis a :Axis ;
    :title "CPI non-food (Dec=2016)" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2018" ;
    :yValue "131.4" ;
    :belongsTo :Chart .

