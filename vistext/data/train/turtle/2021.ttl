@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Consumer price index (CPI) of housing rent in Belgium from May 2019 to June 2020" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Month" .

:YAxis a :Axis ;
    :title "Consumer price index (2013 = 100)" .

:DataPoint1 a :DataPoint ;
    :xValue "Apr 30, 2019" ;
    :yValue "107.15" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "May 31, 2019" ;
    :yValue "107.2" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "Jun 30, 2019" ;
    :yValue "107.26" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "Jul 31, 2019" ;
    :yValue "107.32" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "Aug 31, 2019" ;
    :yValue "107.38" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Sep 30, 2019" ;
    :yValue "107.63" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Oct 31, 2019" ;
    :yValue "107.68" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Nov 30, 2019" ;
    :yValue "107.73" ;
    :belongsTo :Chart .

