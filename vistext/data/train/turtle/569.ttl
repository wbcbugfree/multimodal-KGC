@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Net income of Duke Energy from FY 2008 to FY 2019 (in million U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Net income in million U.S. dollars" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2007" ;
    :yValue "1358" ;
    :belongsTo :Chart .

