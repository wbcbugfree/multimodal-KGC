@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Average daily time spent watching TV per individual in the United Kingdom from 2010 to 2019 , by gender (in minutes)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Men" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2009" ;
    :yValue "224" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Dec 31, 2010" ;
    :yValue "225" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "Dec 31, 2011" ;
    :yValue "226" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "Dec 31, 2012" ;
    :yValue "216" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "Dec 31, 2013" ;
    :yValue "206" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Dec 31, 2014" ;
    :yValue "200" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Dec 31, 2015" ;
    :yValue "196" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Dec 31, 2016" ;
    :yValue "185" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "Dec 31, 2017" ;
    :yValue "177" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "Dec 31, 2018" ;
    :yValue "170" ;
    :belongsTo :Chart .
