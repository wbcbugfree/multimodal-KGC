@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Highest grossing film franchises and series worldwide as of November 2020 (in billion U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Average revenue of series" .

:YAxis a :Axis ;
    :title "Highest grossing film franchises and series" .

