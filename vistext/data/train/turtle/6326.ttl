@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Venezuela : Share of economic sectors in the gross domestic product (GDP) from 2004 to 2014" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Agriculture" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2003" ;
    :yValue "0.0404" ;
    :belongsTo :Chart .

