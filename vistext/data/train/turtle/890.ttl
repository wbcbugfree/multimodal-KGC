@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Total Household Final Consumption Expenditure at current market prices of Scotland in 2018 (in million GBP) , by purpose" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "HFCE in million GBP" .

:YAxis a :Axis ;
    :title "purpose" .

:DataPoint1 a :DataPoint ;
    :xValue "24662" ;
    :yValue "Housing" ;
    :belongsTo :Chart .

