    :yValue "Restaurants and hotels" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "8965" ;
    :yValue "Food and drink" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "5884" ;
    :yValue "Clothing and footwear" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "5574" ;
    :yValue "Household goods and services" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
