@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Revenue of the IAC/InterActiveCorp from 1st quarter 2016 to 3rd quarter 2020 , by segment (in million U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Other" .

:YAxis a :Axis ;
    :title "Quarter" .

:DataPoint1 a :DataPoint ;
    :xValue "66.5" ;
    :yValue "Q1 '16" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "64.3" ;
    :yValue "Q2 '16" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "65.5" ;
    :yValue "Q3 '16" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "87" ;
    :yValue "Q4 '16" ;
    :belongsTo :Chart .
