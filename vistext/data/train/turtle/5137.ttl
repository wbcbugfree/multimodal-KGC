@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Consumer spending on food in the United Kingdom from 2005 to 2019 (in million GBP)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Expenditure in million GBP" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2004" ;
    :yValue "59212" ;
    :belongsTo :Chart .

