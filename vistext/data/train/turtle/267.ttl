@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Central government debt in Sweden from 2010 to 2019 , with a forecast to 2021 (in million SEK)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Debt in million SEK" .

:DataPoint1 a :DataPoint ;
    :xValue "2021*" ;
    :yValue "1556150" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "2020*" ;
    :yValue "1488222" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "2019" ;
    :yValue "1112796" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "2018" ;
    :yValue "1262090" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "2017" ;
    :yValue "1327927" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "2016" ;
    :yValue "1347253" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "2015" ;
    :yValue "1403421" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "2014" ;
    :yValue "1394314" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "2013" ;
    :yValue "1277100" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "2012" ;
    :yValue "1146165" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "2011" ;
