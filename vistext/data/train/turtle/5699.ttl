@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Number of passenger journeys on the Glasgow Underground in the United Kingdom (UK) from 2000/01 to 2019/20 (in millions)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Passenger journeys in millions" .

:DataPoint1 a :DataPoint ;
    :xValue "2019/20" ;
    :yValue "12.7" ;
    :belongsTo :Chart .

