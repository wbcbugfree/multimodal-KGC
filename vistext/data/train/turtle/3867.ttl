@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Amount of money invested in road transport infrastructure in Norway from 2004 to 2017 (in million euros)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Millions of euros invested" .

