@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Revenue , operating profit (EBIT) and net income of Henkel worldwide from 2006 to 2019 (in million euros)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Operating profit (EBIT)" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2005" ;
    :yValue "1298" ;
    :belongsTo :Chart .

