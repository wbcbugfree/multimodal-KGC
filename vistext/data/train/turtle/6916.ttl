@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Operating profit of `` Big five '' European football league clubs from 2009 to 2019 , by league (in million euros)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "France" .

