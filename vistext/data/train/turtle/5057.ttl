@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Deaths by homicide per 100,000 resident population in the U.S. from 1950 to 2017" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Homicide deaths per 100,000 resident population" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 1949" ;
    :yValue "5.1" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Dec 31, 1959" ;
    :yValue "5" ;
    :belongsTo :Chart .

