@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "TV viewership of selected sporting events worldwide from 2009 to 2010 (in millions)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Viewership in millions" .

:YAxis a :Axis ;
    :title "Year" .

:DataPoint1 a :DataPoint ;
    :xValue "121" ;
    :yValue "Super Bowl XLIV (American football) *" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "109" ;
    :yValue "UEFA Champions league final (football)" ;
    :belongsTo :Chart .

