@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Nike 's North American revenue from 2009 to 2020 , by segment (in million U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Footwear" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2008" ;
    :yValue "4694" ;
    :belongsTo :Chart .

