@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Number of employees of AT & T from 2007 to 2019" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Number of employees" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2006" ;
    :yValue "309050" ;
    :belongsTo :Chart .

