@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Producer price index of metal cutting machine tools in the U.S. from 1990 to 2010" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Producer price index" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 1989" ;
    :yValue "129.8" ;
    :belongsTo :Chart .

