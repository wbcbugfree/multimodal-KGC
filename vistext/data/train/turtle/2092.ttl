@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Share of foreigners in Luxembourg from 2009 to 2020" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "Share of foreigners" .

