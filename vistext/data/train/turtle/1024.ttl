@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Share of IT leaders worldwide who expect outsourcing spending increases from 2005 to 2019" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "Share of respondents" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2004" ;
    :yValue "0.45" ;
    :belongsTo :Chart .

