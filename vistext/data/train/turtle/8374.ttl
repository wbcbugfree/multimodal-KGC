@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Number of carloads transported by U.S. class I railroads by commodity from 2004 to 2009 (in 1,000s)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Commodity group" .

:YAxis a :Axis ;
    :title "2009" .

:DataPoint1 a :DataPoint ;
    :xValue "Miscellaneous mixed shipments, primarily intermoda" ;
    :yValue "6897" ;
    :belongsTo :Chart .

