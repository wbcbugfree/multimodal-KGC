@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Total expenditures on policing in Canada in FY 2019 , by province (in 1,000 Canadian dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "province of Canada" .

:YAxis a :Axis ;
    :title "Expenditure in thousand Canadian dollars" .

:DataPoint1 a :DataPoint ;
    :xValue "Ontario*" ;
    :yValue "5874511" ;
    :belongsTo :Chart .

