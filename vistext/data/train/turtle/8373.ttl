@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Number of carloads transported by U.S. class I railroads by commodity from 2004 to 2009 (in 1,000s)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "2007" .

:YAxis a :Axis ;
    :title "Commodity group" .

:DataPoint1 a :DataPoint ;
    :xValue "8465" ;
    :yValue "Miscellaneous mixed shipments, primarily intermodal" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "7480" ;
    :yValue "Coal" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "2588" ;
    :yValue "All other carloads" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "2069" ;
    :yValue "Chemicals" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "1681" ;
    :yValue "Farm products" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "1493" ;
    :yValue "Food and similar products" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "1398" ;
    :yValue "Non-metallic minerals" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "1639" ;
    :yValue "Motor vehicles and equipment" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "726" ;
    :yValue "Waste and scrap material" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "652" ;
    :yValue "Pulp, paper, and allied products" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "662" ;
    :yValue "Metallic ores" ;
    :belongsTo :Chart .

:DataPoint12 a :DataPoint ;
    :xValue "671" ;
    :yValue "Petroleum and coke" ;
    :belongsTo :Chart .

:DataPoint13 a :DataPoint ;
    :xValue "721" ;
    :yValue "Metal and products" ;
    :belongsTo :Chart .

:DataPoint14 a :DataPoint ;
    :xValue "513" ;
    :yValue "Stone, clay, and glass products" ;
    :belongsTo :Chart .

:DataPoint15 a :DataPoint ;
    :xValue "456" ;
    :yValue "Lumber and wood products" ;
    :belongsTo :Chart .

:DataPoint16 a :DataPoint ;
    :xValue "246" ;
    :yValue "Forwarder and shipper association traffic" ;
