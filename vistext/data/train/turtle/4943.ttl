@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Iran : National debt from 2014 to 2024 (in billion U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "National debt in billion U.S. dollars" .

:YAxis a :Axis ;
    :title "Year" .

:DataPoint1 a :DataPoint ;
    :xValue "575.52" ;
    :yValue "2024*" ;
    :belongsTo :Chart .

