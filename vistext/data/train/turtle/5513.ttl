@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Number of registered motor vehicles across Karnataka in India from financial year 2007 to 2017 (in millions)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "financial year" .

:YAxis a :Axis ;
    :title "Number of vehicles in millions" .

:DataPoint1 a :DataPoint ;
    :xValue "FY 2017" ;
    :yValue "17.87" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "FY 2016" ;
    :yValue "16.29" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "FY 2015" ;
    :yValue "14.79" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "FY 2014" ;
    :yValue "13.34" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "FY 2013" ;
    :yValue "12.06" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "FY 2012" ;
    :yValue "10.91" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "FY 2011" ;
    :yValue "9.93" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "FY 2010" ;
    :yValue "9.04" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "FY 2009" ;
    :yValue "6.95" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "FY 2008" ;
    :yValue "6.22" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "FY 2007" ;
    :yValue "5.49" ;
    :belongsTo :Chart .
