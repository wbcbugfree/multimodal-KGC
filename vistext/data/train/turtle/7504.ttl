@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Thinking about once the restrictions are lifted , which of the following are you likely to try and avoid for the time being , because of coronavirus / Covid-19 ? (as of May 31 , 2020)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "United States" .

:DataPoint1 a :DataPoint ;
    :xValue "Cinema / theatre" ;
    :yValue "0.58" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Music festivals" ;
    :yValue "0.58" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "Music concerts" ;
    :yValue "0.57" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "Sports events" ;
    :yValue "0.56" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "Pubs / bars / clubs" ;
    :yValue "0.56" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Gym / sports centers" ;
    :yValue "0.5" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Restaurants / café’s" ;
    :yValue "0.46" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Large retail shops / shopping centers" ;
    :yValue "0.45" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "Museums / galleries" ;
    :yValue "0.44" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "Shopping downtown / highstreet" ;
    :yValue "0.37" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "Hairdressers / beauty salons" ;
    :yValue "0.31" ;
    :belongsTo :Chart .

:DataPoint12 a :DataPoint ;
    :xValue "Holidays" ;
    :yValue "0.2" ;
    :belongsTo :Chart .

:DataPoint13 a :DataPoint ;
    :xValue "Supermarket / grocery shops" ;
    :yValue "0.15" ;
    :belongsTo :Chart .

:DataPoint14 a :DataPoint ;
    :xValue "Other" ;
    :yValue "0.03" ;
    :belongsTo :Chart .

:DataPoint15 a :DataPoint ;
    :xValue "Not planning to do anything less" ;
    :yValue "0.16" ;
