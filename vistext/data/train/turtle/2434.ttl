@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Estimated expenses of U.S. music publishers from 2007 to 2018 (in billion U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Expenses in billion U.S. dollars" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2006" ;
    :yValue "2.68" ;
    :belongsTo :Chart .

