@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Electricity prices for households in Finland from 2010 to 2019 , semi-annually (in euro cents per kilowatt-hour)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Euro cents per kilowatt-hour" .

:DataPoint1 a :DataPoint ;
    :xValue "2019 S1" ;
    :yValue "17.34" ;
    :belongsTo :Chart .

