@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Share of pharmaceutical revenue worldwide in 2017 , by country" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "Percentage of global revenue" .

:DataPoint1 a :DataPoint ;
    :xValue "United States" ;
    :yValue "0.33" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Western Europe-15" ;
    :yValue "0.22" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "China" ;
    :yValue "0.1" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "Japan" ;
    :yValue "0.09" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "Latin America-5" ;
    :yValue "0.07" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Russia" ;
    :yValue "0.04" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Canada" ;
    :yValue "0.02" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "South Korea" ;
    :yValue "0.02" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "India" ;
    :yValue "0.01" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "Indonesia" ;
    :yValue "0.01" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "Australia" ;
    :yValue "0.01" ;
    :belongsTo :Chart .

:DataPoint12 a :DataPoint ;
    :xValue "Saudi Arabia" ;
    :yValue "0.01" ;
    :belongsTo :Chart .

:DataPoint13 a :DataPoint ;
    :xValue "Rest of world" ;
    :yValue "0.06" ;
    :belongsTo :Chart .
