@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Number of foreign residents from leading ten countries in Italy as of January 2019 , by country of origin" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Country" .

:YAxis a :Axis ;
    :title "Number of individuals" .

:DataPoint1 a :DataPoint ;
    :xValue "Romania" ;
    :yValue "1206938" ;
    :belongsTo :Chart .

