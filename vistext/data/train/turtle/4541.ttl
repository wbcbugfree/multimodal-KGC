@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Heads of state and government with the highest annual salaries (2010 or latest update ; in dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Annual salary in dollars" .

:YAxis a :Axis ;
    :title "head of state" .

:DataPoint1 a :DataPoint ;
    :xValue "2183500" ;
    :yValue "Lee Hsien Loong (Singapore)" ;
    :belongsTo :Chart .

