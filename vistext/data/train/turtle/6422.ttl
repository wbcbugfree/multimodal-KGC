@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Winter Olympic Games all-time medal table countries from 1924 to 2018" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Country" .

:YAxis a :Axis ;
    :title "Gold" .

:DataPoint1 a :DataPoint ;
    :xValue "Norway" ;
    :yValue "132" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "United States" ;
    :yValue "105" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "Germany" ;
    :yValue "92" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "Soviet Union" ;
    :yValue "78" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "Canada" ;
    :yValue "73" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Austria" ;
    :yValue "64" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Sweden" ;
    :yValue "57" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Switzerland" ;
    :yValue "56" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "Russia" ;
    :yValue "47" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "The Netherlands" ;
    :yValue "45" ;
    :belongsTo :Chart .
