@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Annual turnover of activities of amusement parks and theme parks in the United Kingdom (UK) from 2008 to 2018 (in million GBP)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Turnover in million GBP" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2007" ;
    :yValue "611" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Dec 31, 2008" ;
    :yValue "733" ;
    :belongsTo :Chart .

