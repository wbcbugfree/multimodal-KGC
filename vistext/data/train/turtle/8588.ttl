@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Number of camping sites in Germany in 2018 and 2019 , by state" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "2019" .

:YAxis a :Axis ;
    :title "state of Germany" .

