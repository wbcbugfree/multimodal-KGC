@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Nike 's revenue in Greater China from 2009 to 2020 , by segment (in million U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Apparel" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2008" ;
    :yValue "700" ;
    :belongsTo :Chart .

