@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Number of of marriages and divorces per 1,000 population in Russia from 2000 to 2019" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Divorces" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 1999" ;
    :yValue "4.3" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Dec 31, 2004" ;
    :yValue "4.2" ;
    :belongsTo :Chart .

