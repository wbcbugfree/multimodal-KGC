@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Amount of money spent by German travellers abroad from 2006 to 2019 (in million euros)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Spending in million euros" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2005" ;
    :yValue "58.9" ;
    :belongsTo :Chart .

