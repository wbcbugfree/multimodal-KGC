@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Which method do you prefer for buying your purchases ?" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Online via PC" .

:YAxis a :Axis ;
    :title "Response" .

:DataPoint1 a :DataPoint ;
    :xValue "0.29" ;
    :yValue "Clothing and footwear" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "0.45" ;
    :yValue "Consumer electronics and computers" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "0.61" ;
    :yValue "Books, music, movies, video games" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "0.21" ;
    :yValue "Grocery" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "0.39" ;
    :yValue "Household appliances" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "0.26" ;
    :yValue "Furniture and homeware" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "0.22" ;
    :yValue "Home improvement" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "0.22" ;
    :yValue "Health and beauty" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "0.21" ;
    :yValue "Jewellery" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "0.25" ;
    :yValue "Sports equipment" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "0.27" ;
    :yValue "Toys" ;
    :belongsTo :Chart .
