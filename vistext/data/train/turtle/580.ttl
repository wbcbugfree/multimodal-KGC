@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "U.S. sweet potato production value from 2000 to 2019 (in 1,000 U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Production value in thousand U.S. dollars" .

