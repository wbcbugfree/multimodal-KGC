@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Percentage of global population accessing the internet from 2005 to 2019 , by market maturity" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "LDCs" .

:DataPoint1 a :DataPoint ;
    :xValue "2019*" ;
    :yValue "0.191" ;
    :belongsTo :Chart .

