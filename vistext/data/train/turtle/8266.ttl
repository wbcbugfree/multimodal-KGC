@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Selected sawtimber stumpage prices in the U.S. from 2002 to 2015 , by species in U.S. dollars per 1,000 board feet)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Oak, white, red ad black" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2003" ;
    :yValue "291.21" ;
    :belongsTo :Chart .

