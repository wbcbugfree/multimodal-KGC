@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Percentage of Canadians who used cannabis in their lifetime as of 2017 , by territory" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Percentage of Canadians" .

:YAxis a :Axis ;
    :title "Response" .

:DataPoint1 a :DataPoint ;
    :xValue "0.558" ;
    :yValue "British Columbia" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "0.521" ;
    :yValue "Nova Scotia" ;
    :belongsTo :Chart .

