    :xValue "0.468" ;
    :yValue "Prince Edward Island" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "0.466" ;
    :yValue "Canada" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "0.449" ;
    :yValue "Ontario" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "0.447" ;
    :yValue "Newfoundland and Laborador" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "0.442" ;
    :yValue "Saskatchewan" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "0.43" ;
    :yValue "Quebec" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "0.424" ;
    :yValue "Manitoba" ;
