@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Leading scorers at the Clausura championship of the Mexican soccer top-level league Liga MX in 2020" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Number of goals scored" .

:YAxis a :Axis ;
    :title "human" .

:DataPoint1 a :DataPoint ;
    :xValue "9" ;
    :yValue "Jonathan Javier Rodrígue(Cruz Azul)" ;
    :belongsTo :Chart .

