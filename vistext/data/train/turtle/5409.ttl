@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Google 's net income from 2001 to 2015 (in million U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Net income (in million U.S. dollars)" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2000" ;
    :yValue "7" ;
    :belongsTo :Chart .

