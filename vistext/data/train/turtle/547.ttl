@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Median annual family income in Canada from 2000 to 2018 (in Canadian dollar)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Median income in Canadian dollars" .

