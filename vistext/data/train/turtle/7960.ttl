@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Number of children enrolled in public and private nursery schools in the United States from 1980 to 2010 (in 1,000)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Public" .

