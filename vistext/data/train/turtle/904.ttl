@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "European Union : Gross domestic product (GDP) in current prices from 2009 to 2019 (in trillion euros)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Gross domestic product in trillion euros" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2008" ;
    :yValue "10.59" ;
    :belongsTo :Chart .

