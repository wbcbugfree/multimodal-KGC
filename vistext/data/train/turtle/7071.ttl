@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Number of PwC employees worldwide from 2010 to 2020 , by position" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Position" .

:YAxis a :Axis ;
    :title "Client service staff" .

