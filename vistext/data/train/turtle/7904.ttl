@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Most popular Google Play app store categories from 1st quarter 2016 to 1st quarter 2020 , by number of downloads (in millions)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Photography" .

:YAxis a :Axis ;
    :title "Quarter" .

:DataPoint1 a :DataPoint ;
    :xValue "729" ;
    :yValue "Q1 '16" ;
    :belongsTo :Chart .

