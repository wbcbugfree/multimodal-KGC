@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Percentage share of new passenger cars in Europe with diesel engines in 2014 and 2018 , by brand" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "2014" .

:YAxis a :Axis ;
    :title "brand of passenger cars with diesel engines" .

:DataPoint1 a :DataPoint ;
    :xValue "0.9" ;
    :yValue "Volvo" ;
    :belongsTo :Chart .

