@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Leading countries in synthetic diamond production worldwide in 2011 (in 1,000 carats)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Production in thousand carats" .

:YAxis a :Axis ;
    :title "Country" .

:DataPoint1 a :DataPoint ;
    :xValue "4000000" ;
    :yValue "China" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "98200" ;
    :yValue "United States**" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "80000" ;
    :yValue "Russia" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "60000" ;
    :yValue "South Africa" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "60000" ;
    :yValue "Ireland" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "34000" ;
    :yValue "Japan" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "25000" ;
    :yValue "Belarus" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "20000" ;
    :yValue "Sweden" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "4000" ;
    :yValue "Ukraine (2008)" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "3000" ;
    :yValue "France" ;
    :belongsTo :Chart .
