@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Percentage of millennials in the U.S. who had been told by a health care provider that they had select health conditions as of 2018" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "Percentage of millennials" .

:DataPoint1 a :DataPoint ;
    :xValue "Depression" ;
    :yValue "0.17" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Overweight" ;
    :yValue "0.12" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "Migraines" ;
    :yValue "0.12" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "An anxiety disorder" ;
    :yValue "0.11" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "High blood pressure" ;
    :yValue "0.09" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Asthma" ;
    :yValue "0.08" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Obesity" ;
    :yValue "0.07" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "High cholesterol" ;
    :yValue "0.07" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "Arthritis" ;
    :yValue "0.05" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "ADD/ADHD" ;
    :yValue "0.05" ;
    :belongsTo :Chart .
