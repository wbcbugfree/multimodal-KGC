@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Consumption of fruit juice and fruit nectar in the European Union from 2007 to 2018 (in millions of liters)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Consumption in millions of liters" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2006" ;
    :yValue "11310" ;
    :belongsTo :Chart .

