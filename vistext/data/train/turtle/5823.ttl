@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Milwaukee Bucks all-time points leaders from 1968 to 2020" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "human" .

:YAxis a :Axis ;
    :title "Points scored" .

