@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Most popular airlines among millennials in the United Kingdom (UK) as of October 2019" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Share of respondents" .

:YAxis a :Axis ;
    :title "Response" .

:DataPoint1 a :DataPoint ;
    :xValue "0.61" ;
    :yValue "British Airways" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "0.52" ;
    :yValue "EasyJet" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "0.5" ;
    :yValue "Emirates" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "0.47" ;
    :yValue "Virgin Atlantic" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "0.44" ;
    :yValue "TUI Airways" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "0.38" ;
    :yValue "Jet2.com" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "0.34" ;
    :yValue "Qatar Airways" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "0.34" ;
    :yValue "Etihad Airways" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "0.31" ;
    :yValue "Qantas" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "0.27" ;
    :yValue "KLM" ;
    :belongsTo :Chart .
