@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Ranking of the ten largest web shops in Sweden in 2018 , by revenue (in 1,000 SEK)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Revenue in thousand SEK" .

:YAxis a :Axis ;
    :title "web shops" .

