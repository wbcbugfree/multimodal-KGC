@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Toronto Raptors all-time games played leaders from 1995 to 2020" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Raptors players" .

:YAxis a :Axis ;
    :title "Games played" .

:DataPoint1 a :DataPoint ;
    :xValue "DeMar DeRozan" ;
    :yValue "675" ;
    :belongsTo :Chart .

