@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Population density in New Jersey from 1960 to 2018" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Number of residents per square mile" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 1959" ;
    :yValue "817.8" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Dec 31, 1969" ;
    :yValue "975.1" ;
    :belongsTo :Chart .

