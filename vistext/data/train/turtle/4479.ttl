@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Unemployment rate in the Netherlands from 2003 to 2019" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "Share of individuals" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2002" ;
    :yValue "0.061" ;
    :belongsTo :Chart .

