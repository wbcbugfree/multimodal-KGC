@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Switzerland : The largest cities in 2015" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "city" .

:YAxis a :Axis ;
    :title "Number of inhabitants" .

:DataPoint1 a :DataPoint ;
    :xValue "Zurich" ;
    :yValue "396955" ;
    :belongsTo :Chart .

