@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Advertising spending in Vietnam from 2004 to 2018 , by medium (in million U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Outdoor/transport" .

:YAxis a :Axis ;
    :title "Year" .

:DataPoint1 a :DataPoint ;
    :xValue "38.5" ;
    :yValue "2018**" ;
    :belongsTo :Chart .

