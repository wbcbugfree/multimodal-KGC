@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Countries with the largest total number of cosmetic procedures in 2019" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Country" .

:YAxis a :Axis ;
    :title "Number of procedures" .

:DataPoint1 a :DataPoint ;
    :xValue "United States" ;
    :yValue "3982749" ;
    :belongsTo :Chart .

