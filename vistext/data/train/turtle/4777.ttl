@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Tesla 's revenue from FY 2008 to FY 2019 (in million U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Fiscal year" .

:YAxis a :Axis ;
    :title "Revenue in million U.S. dollars" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2007" ;
    :yValue "14.74" ;
    :belongsTo :Chart .

