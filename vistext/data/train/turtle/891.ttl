@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Social networks accessed several times per day by internet users in the United States as of January 2018" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "Percentage of respondents" .

:DataPoint1 a :DataPoint ;
    :xValue "Facebook" ;
    :yValue "0.66" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Facebook Messenger" ;
    :yValue "0.38" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "YouTube" ;
    :yValue "0.37" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "Instagram" ;
    :yValue "0.25" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "Google+" ;
    :yValue "0.22" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Twitter" ;
    :yValue "0.2" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Snapchat" ;
    :yValue "0.19" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Pinterest" ;
    :yValue "0.17" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "WhatsApp" ;
    :yValue "0.1" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "LinkedIn" ;
    :yValue "0.09" ;
    :belongsTo :Chart .
