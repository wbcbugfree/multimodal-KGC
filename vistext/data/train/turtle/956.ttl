@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Percentage of income held by the richest 20 % of the population in Latin America in 2018 , by country" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "Share of income held by richest 20%" .

:DataPoint1 a :DataPoint ;
    :xValue "Brazil" ;
    :yValue "0.584" ;
    :belongsTo :Chart .

