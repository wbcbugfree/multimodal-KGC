@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Number of immigrants to Sweden in 2019 , by age group" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Number of immigrants" .

:DataPoint1 a :DataPoint ;
    :xValue "0-4 years" ;
    :yValue "8913" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "5-14 years" ;
    :yValue "15524" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "15-24 years" ;
    :yValue "23498" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "25-34 years" ;
    :yValue "35211" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "35-44 years" ;
    :yValue "19131" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "45-54 years" ;
    :yValue "8209" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "55-64 years" ;
    :yValue "3311" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "65-74 years" ;
    :yValue "1431" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "75-84 years" ;
    :yValue "473" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "85-94 years" ;
    :yValue "99" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "95+ years" ;
    :yValue "5" ;
    :belongsTo :Chart .
