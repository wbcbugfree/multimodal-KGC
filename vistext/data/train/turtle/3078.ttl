@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Cat products purchased by consumers online in the last 12 months in the United States in 2018" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "Share of respondents" .

:DataPoint1 a :DataPoint ;
    :xValue "Dry cat food" ;
    :yValue "0.43" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Cat litter" ;
    :yValue "0.37" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "Wet pet food (canned or pouch)" ;
    :yValue "0.34" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "Pet treats and chews" ;
    :yValue "0.28" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "Flea and tick medications" ;
    :yValue "0.25" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Pet grooming supplies" ;
    :yValue "0.16" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Flea and tick collars" ;
    :yValue "0.1" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Pet vitamins and nutritional supplements" ;
    :yValue "0.09" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "Pet clean-up, odor control and training aids" ;
    :yValue "0.06" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "Pet oral care" ;
    :yValue "0.06" ;
    :belongsTo :Chart .
