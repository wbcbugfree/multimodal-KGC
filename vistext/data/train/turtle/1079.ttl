@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Value of wine imported into Sweden from 2008 to 2018 (in 1,000 SEK)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Import value in thousand SEK" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2007" ;
    :yValue "4476288" ;
    :belongsTo :Chart .

