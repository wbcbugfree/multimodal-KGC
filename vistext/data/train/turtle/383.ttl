@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Leading countries worldwide based on stress experienced in the previous day in 2018" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "Percentage of respondents" .

:DataPoint1 a :DataPoint ;
    :xValue "Greece" ;
    :yValue "0.59" ;
    :belongsTo :Chart .

