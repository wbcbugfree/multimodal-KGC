@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Number of directly managed ESPRIT stores worldwide from 2005 to 2019" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Number of stores" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2004" ;
    :yValue "634" ;
    :belongsTo :Chart .

