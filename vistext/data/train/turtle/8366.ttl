@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Global chemical fiber production from 2000 to 2019 , by fiber type (in 1,000 metric tons)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Cellulose fibers" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 1999" ;
    :yValue "2640" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Dec 31, 2009" ;
    :yValue "4400" ;
    :belongsTo :Chart .

