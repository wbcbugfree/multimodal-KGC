@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "What should be the first two actions that the Romanian Government must take to fight the phenomenon of global warming ?" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "First measure" .

:DataPoint1 a :DataPoint ;
    :xValue "Putting an end to deforestation" ;
    :yValue "0.26" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Traffic restriction/ encouraging alternative means of transport" ;
    :yValue "0.11" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "Measures for recycling" ;
    :yValue "0.06" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "Providing support for purchasing hybrid/ electric cars" ;
    :yValue "0.04" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "Reducing pollution (especially industrial pollution/ Technological upgrade" ;
    :yValue "0.04" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Liability framework for polluters" ;
    :yValue "0.03" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Raising awareness among the population regarding the impact of global warming" ;
    :yValue "0.03" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Ecological measures/ Water filtration" ;
    :yValue "0.02" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "Involving professionals" ;
    :yValue "0.02" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "Ensuring compliance with the existing regulations in the field" ;
    :yValue "0.02" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "Encouraging the use of alternative and renewable energy" ;
    :yValue "0.02" ;
    :belongsTo :Chart .

:DataPoint12 a :DataPoint ;
    :xValue "Prohibiting/ reducing the use of plastic products" ;
    :yValue "0.01" ;
    :belongsTo :Chart .

:DataPoint13 a :DataPoint ;
    :xValue "Making people more responsible" ;
    :yValue "0" ;
    :belongsTo :Chart .

:DataPoint14 a :DataPoint ;
    :xValue "Other actions" ;
    :yValue "0.04" ;
    :belongsTo :Chart .

:DataPoint15 a :DataPoint ;
    :xValue "I do not know" ;
    :yValue "0.3" ;
    :belongsTo :Chart .
