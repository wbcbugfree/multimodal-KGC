@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "The leading law firms in China in 2019 , by gross revenue (in million U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Gross revenue in million U.S. dollars" .

:YAxis a :Axis ;
    :title "law firm" .

:DataPoint1 a :DataPoint ;
    :xValue "2899.6" ;
    :yValue "Dentons" ;
