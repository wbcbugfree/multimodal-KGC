@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "College majors with the highest participation rate of Hispanic students in the U.S. in 2015" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "Share of Hispanic students" .

:DataPoint1 a :DataPoint ;
    :xValue "Business" ;
    :yValue "0.24" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Education" ;
    :yValue "0.11" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "Architecture and engineering" ;
    :yValue "0.1" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "Humanities and liberal arts" ;
    :yValue "0.09" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "Social sciences" ;
    :yValue "0.08" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Psychology and social work" ;
    :yValue "0.07" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Health" ;
    :yValue "0.06" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Computers, statistics, and mathematics" ;
    :yValue "0.05" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "Biology and life sciences" ;
    :yValue "0.04" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "Arts" ;
    :yValue "0.04" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "Communications and journalism" ;
    :yValue "0.04" ;
    :belongsTo :Chart .

:DataPoint12 a :DataPoint ;
    :xValue "Law and public policy" ;
    :yValue "0.03" ;
    :belongsTo :Chart .

:DataPoint13 a :DataPoint ;
    :xValue "Physical sciences" ;
    :yValue "0.02" ;
    :belongsTo :Chart .

:DataPoint14 a :DataPoint ;
    :xValue "Industrial arts, consumer services, and recreation" ;
    :yValue "0.02" ;
    :belongsTo :Chart .

:DataPoint15 a :DataPoint ;
    :xValue "Agriculture and natural resources" ;
    :yValue "0.01" ;
