@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Total historical national rail passenger journeys in the United Kingdom (UK) from 1950 to 2020 (in millions)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Number of journeys in millions" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 1949" ;
    :yValue "1010" ;
    :belongsTo :Chart .

