    :xValue "2014/15" ;
    :yValue "0.2565" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "2013/14" ;
    :yValue "0.2618" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "2012/13" ;
    :yValue "0.2664" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "2011/12" ;
    :yValue "0.2658" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "2010/11" ;
