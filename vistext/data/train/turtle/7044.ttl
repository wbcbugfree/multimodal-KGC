@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Share of revenue of the German Bundesliga from 2008/09 to 2018/19 , by segment" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Advertising" .

:DataPoint1 a :DataPoint ;
    :xValue "2018/19" ;
    :yValue "0.2103" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "2017/18" ;
    :yValue "0.2286" ;
    :belongsTo :Chart .

