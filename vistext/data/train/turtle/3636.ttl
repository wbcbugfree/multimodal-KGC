@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Consumer price index (CPI) of beer annually in the Netherlands from 2009 to 2019" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Consumer price index (2015=100)*" .

:YAxis a :Axis ;
    :title "Year" .

:DataPoint1 a :DataPoint ;
    :xValue "103.4" ;
    :yValue "2019**" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "102.72" ;
    :yValue "2018" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "100.87" ;
    :yValue "2017" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "100.69" ;
    :yValue "2016" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "100" ;
    :yValue "2015" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "101.64" ;
    :yValue "2014" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "99" ;
    :yValue "2013" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "93.12" ;
    :yValue "2012" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "89.74" ;
    :yValue "2011" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "90.16" ;
    :yValue "2010" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "89.29" ;
    :yValue "2009" ;
    :belongsTo :Chart .
