    :yValue "46" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Dec 31, 2004" ;
    :yValue "53" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Dec 31, 2005" ;
    :yValue "76" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Dec 31, 2006" ;
    :yValue "83" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
