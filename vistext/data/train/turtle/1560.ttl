@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Number of tramadol-related deaths reported to NPSAD in the United Kingdom (UK) from 2000 to 2012" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Number of deaths" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 1999" ;
    :yValue "10" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Dec 31, 2000" ;
    :yValue "32" ;
    :belongsTo :Chart .

