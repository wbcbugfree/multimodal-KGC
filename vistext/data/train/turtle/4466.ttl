@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Tour de France number of overall victories by nation from 1903 to 2019" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Country" .

:YAxis a :Axis ;
    :title "Tour de France victories" .

:DataPoint1 a :DataPoint ;
    :xValue "France" ;
    :yValue "36" ;
    :belongsTo :Chart .

