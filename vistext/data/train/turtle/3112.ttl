@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "United Kingdom companies ' net foreign direct investment (FDI) in Europe from 2006 to 2019 (in million GBP)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Investment in million GBP" .

