@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Monthly import value of fruit and vegetable juices and frozen fruit in Canada from 2015 to 2020 (in million Canadian dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "2015" .

:YAxis a :Axis ;
    :title "Month" .

:DataPoint1 a :DataPoint ;
    :xValue "80.8" ;
    :yValue "Dec" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "81.6" ;
    :yValue "Nov" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "80.5" ;
    :yValue "Oct" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "79.6" ;
    :yValue "Sep" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "78.9" ;
    :yValue "Aug" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "79.1" ;
    :yValue "Jul" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "76.5" ;
    :yValue "Jun" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "72.5" ;
    :yValue "May" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "78.2" ;
    :yValue "Apr" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "79.9" ;
    :yValue "Mar" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "78.3" ;
    :yValue "Feb" ;
    :belongsTo :Chart .

:DataPoint12 a :DataPoint ;
    :xValue "73.9" ;
    :yValue "Jan" ;
    :belongsTo :Chart .
