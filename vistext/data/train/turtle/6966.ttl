@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Average square meter price of housing in the largest French cities as of June 1 , 2020 , by type of housing (in euros)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Flats" .

:YAxis a :Axis ;
    :title "commune of France" .

