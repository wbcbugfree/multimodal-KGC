@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Number of farm tractors produced in Pakistan from July 2008 to June 2019" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Number of farm tractors" .

:YAxis a :Axis ;
    :title "Month" .

:DataPoint1 a :DataPoint ;
    :xValue "49902" ;
    :yValue "Jul 2018- Jun 2019" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "71894" ;
    :yValue "Jul 2017- Jun 2018" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "53975" ;
    :yValue "Jul 2016- Jun 2017" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "34914" ;
    :yValue "Jul 2015- Jun 2016" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "48883" ;
    :yValue "Jul 2014- Jun 2015" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "34521" ;
    :yValue "Jul 2013- Jun 2014" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "50859" ;
    :yValue "Jul 2012- Jun 2013" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "48120" ;
    :yValue "Jul 2011- Jun 2012" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "70770" ;
