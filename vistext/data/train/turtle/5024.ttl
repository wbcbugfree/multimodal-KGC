@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Sales value of chocolate bars manufactured in the United Kingdom (UK) from 2008 to 2019 (in 1,000 GBP)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Sales value in thousand British pounds" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2007" ;
    :yValue "473457" ;
    :belongsTo :Chart .

