@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Cleveland Cavaliers all-time points leaders from 1970 to 2020" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "player name" .

:YAxis a :Axis ;
    :title "Points scored" .

:DataPoint1 a :DataPoint ;
    :xValue "LeBron James" ;
    :yValue "23119" ;
    :belongsTo :Chart .

