@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Share of marketers indicating their brand 's presence on selected social media in Canada in 2015" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "Share of respondents" .

:DataPoint1 a :DataPoint ;
    :xValue "Facebook" ;
    :yValue "0.93" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Twitter" ;
    :yValue "0.78" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "YouTube" ;
    :yValue "0.68" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "Instagram" ;
    :yValue "0.6" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "LinkedIn" ;
    :yValue "0.35" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Pinterest" ;
    :yValue "0.26" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Google Plus" ;
    :yValue "0.15" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Tumblr" ;
    :yValue "0.08" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "Vine" ;
    :yValue "0.06" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "Other" ;
    :yValue "0.02" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "Not on social media" ;
    :yValue "0.02" ;
    :belongsTo :Chart .
