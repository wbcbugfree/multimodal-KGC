@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Total investments of institutional investors in investment fund shares or units in the Netherlands from 2006 to 2016 (in million euros)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Total investments in million euros" .

:DataPoint1 a :DataPoint ;
    :xValue "2016*" ;
    :yValue "944132" ;
    :belongsTo :Chart .

