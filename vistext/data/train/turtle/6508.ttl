@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Favorability ratings of selected late-night TV show hosts in the United States as of March 2019" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Somewhat unfavorable" .

:YAxis a :Axis ;
    :title "Response" .

:DataPoint1 a :DataPoint ;
    :xValue "0.08" ;
    :yValue "Jimmy Fallon" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "0.08" ;
    :yValue "Jimmy Kimmel" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "0.09" ;
    :yValue "Stephen Colbert" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "0.06" ;
    :yValue "James Corden" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "0.11" ;
    :yValue "Conan O'Brien" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "0.07" ;
    :yValue "Trevor Noah" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "0.08" ;
    :yValue "Seth Meyers" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "0.08" ;
    :yValue "Bill Maher" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "0.05" ;
    :yValue "John Oliver" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "0.09" ;
    :yValue "Carson Daly" ;
    :belongsTo :Chart .
