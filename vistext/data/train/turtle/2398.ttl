@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Millennial mothers : Do you typically share information about the following kinds of products or services with others ?" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Share of respondents" .

:YAxis a :Axis ;
    :title "Response" .

:DataPoint1 a :DataPoint ;
    :xValue "0.93" ;
    :yValue "Clothing, shoes and other accessories**" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "0.91" ;
    :yValue "Retail stores" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "0.9" ;
    :yValue "Groceries/food and beverages" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
