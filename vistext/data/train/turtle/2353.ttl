@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Consumer price index (CPI) of beer annually in the United Kingdom (UK) from 2003 to 2019" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Consumer price index*" .

