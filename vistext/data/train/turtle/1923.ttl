@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Leading premium retail centers in the United Kingdom (UK) in 2014 , ranked by premium stores as percentage of all stores" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Premium stores as percentage of all stores" .

:YAxis a :Axis ;
    :title "UK Retailer" .

