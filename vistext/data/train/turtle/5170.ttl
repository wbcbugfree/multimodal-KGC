@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Sales of the leading power toothbrush brands in the United States in 2014 (in million U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Sales in million U.S. dollars" .

:YAxis a :Axis ;
    :title "Brand" .

:DataPoint1 a :DataPoint ;
    :xValue "38.6" ;
    :yValue "Sonicare Essence" ;
    :belongsTo :Chart .

