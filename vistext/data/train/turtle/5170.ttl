    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "12.9" ;
    :yValue "Colgate 360 Optic White" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "12.5" ;
    :yValue "Arm & Hammer Spinbrush Kids" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
