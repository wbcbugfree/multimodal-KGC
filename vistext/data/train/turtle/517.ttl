@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "LinkedIn penetration in selected Middle Eastern and North African countries as of June 2012" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Share of population using LinkedIn" .

:YAxis a :Axis ;
    :title "Response" .

:DataPoint1 a :DataPoint ;
    :xValue "0.1278" ;
    :yValue "United Arab Emirates" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "0.0976" ;
    :yValue "Qatar" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "0.0706" ;
    :yValue "Bahrain" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "0.0605" ;
    :yValue "Kuwait" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "0.0435" ;
    :yValue "Lebanon" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "0.0407" ;
    :yValue "Oman" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "0.0286" ;
    :yValue "Jordan" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "0.0247" ;
    :yValue "Saudi Arabia" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "0.0207" ;
    :yValue "Tunisia" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "0.0129" ;
    :yValue "Morocco" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "0.0093" ;
    :yValue "Algeria" ;
    :belongsTo :Chart .

:DataPoint12 a :DataPoint ;
    :xValue "0.0073" ;
    :yValue "Egypt" ;
    :belongsTo :Chart .
