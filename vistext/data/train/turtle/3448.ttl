@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Annual volume of pineapple sold in Germany from 2006 to 2016 (in 1,000 tonnes)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Sales volume in thousand tonnes" .

:YAxis a :Axis ;
    :title "Year" .

:DataPoint1 a :DataPoint ;
    :xValue "141.9" ;
    :yValue "2016*" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "141.1" ;
    :yValue "2015*" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "139.6" ;
    :yValue "2014*" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "138" ;
    :yValue "2013*" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "134.3" ;
    :yValue "2012*" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "132.6" ;
    :yValue "2011" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "137.2" ;
    :yValue "2010" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "149.2" ;
    :yValue "2009" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "139.8" ;
    :yValue "2008" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "127.2" ;
    :yValue "2007" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "115.8" ;
    :yValue "2006" ;
    :belongsTo :Chart .
