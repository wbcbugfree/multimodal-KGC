@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Leading TV websites in the United States in November 2016 , based on market share of visits" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "Percentage of visits" .

:DataPoint1 a :DataPoint ;
    :xValue "CNN.com" ;
    :yValue "0.13" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "ESPN" ;
    :yValue "0.126" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "Fox News" ;
    :yValue "0.09" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "The Weather Channel - US" ;
    :yValue "0.053" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "Politicial News - FOXnews.com" ;
    :yValue "0.033" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Hulu" ;
    :yValue "0.033" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "CBSNews.com" ;
    :yValue "0.029" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "ABCnews.com" ;
    :yValue "0.022" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "Food Network" ;
    :yValue "0.022" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "Bloomberg.com" ;
    :yValue "0.018" ;
    :belongsTo :Chart .
