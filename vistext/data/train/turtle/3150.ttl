    :yValue "464.7" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Dec 31, 2014" ;
    :yValue "465.7" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
