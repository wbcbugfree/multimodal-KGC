@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Total public spending in France from 2010 to 2019 (in billion euros)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Spending in billion euros" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2009" ;
    :yValue "483.4" ;
    :belongsTo :Chart .

