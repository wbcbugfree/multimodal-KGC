@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Which of the following , if any , would persuade you to book a vacation during the coronavirus outbreak ?" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Share of respondents" .

:YAxis a :Axis ;
    :title "Response" .

:DataPoint1 a :DataPoint ;
    :xValue "0.2" ;
    :yValue "A travel insurance policy that covered disruption caused by the virus" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "0.2" ;
    :yValue "Flight discounts" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "0.16" ;
    :yValue "Flexibility" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "0.16" ;
    :yValue "Accommodation discounts" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "0.16" ;
    :yValue "Taking a trip within my own country instead" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "0.08" ;
    :yValue "If the situation in the UK became worse" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "0.14" ;
    :yValue "No change fees" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "0.09" ;
    :yValue "Attraction discounts" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "0.08" ;
    :yValue "Being able to speak to an agent about safest/most effective travel plans" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "0.48" ;
    :yValue "I could not be persuaded to book a vacation during this time" ;
    :belongsTo :Chart .
