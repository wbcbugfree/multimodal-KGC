@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Number of employees of the tire manufacturer Michelin at its French sites as of December 31 , 2016" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "site" .

:YAxis a :Axis ;
    :title "Number of employees" .

:DataPoint1 a :DataPoint ;
    :xValue "Cataroux **" ;
    :yValue "2023" ;
    :belongsTo :Chart .

