    :xValue "Combaude **" ;
    :yValue "785" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Gravanches **" ;
    :yValue "718" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "La Roche-sur-Yon" ;
