    :xValue "2016" ;
    :yValue "-0.019" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "2015" ;
    :yValue "0.007" ;
    :belongsTo :Chart .

:DataPoint12 a :DataPoint ;
    :xValue "2014" ;
    :yValue "0.008" ;
    :belongsTo :Chart .

:DataPoint13 a :DataPoint ;
    :xValue "2013" ;
