@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Change in U.S. commercial air carriers ' revenue passenger miles (RPM) for Atlantic flights from 2011 to 2040" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Annual growth" .

:DataPoint1 a :DataPoint ;
    :xValue "2020-2040* **" ;
    :yValue "0.025" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "2019-2039* **" ;
    :yValue "0.026" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "2018-2038* **" ;
    :yValue "0.029" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "2016-2037*" ;
    :yValue "0.028" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "2015-2036*" ;
    :yValue "0.031" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "2020* **" ;
    :yValue "0.074" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "2019* **" ;
    :yValue "0.08" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "2018*" ;
    :yValue "0.057" ;
    :belongsTo :Chart .

