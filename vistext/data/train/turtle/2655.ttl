@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Production of coke oven coke in the United Kingdom (UK) from 2010 to 2019 (in 1,000 metric tons)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Thousand metric tons of coke oven coke" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2009" ;
    :yValue "3990" ;
    :belongsTo :Chart .

