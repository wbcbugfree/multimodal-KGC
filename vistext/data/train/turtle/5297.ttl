@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Mobile conversion rate of Alibaba 's online shopping properties from 2nd quarter 2012 to 2nd quarter 2016" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Conversion rate" .

:YAxis a :Axis ;
    :title "Quarter" .

