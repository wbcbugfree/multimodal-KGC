@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Which of the following hobbies do you practice ?" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "Share of respondents" .

:DataPoint1 a :DataPoint ;
    :xValue "Reading" ;
    :yValue "0.6" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Sports activity" ;
    :yValue "0.54" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "Cinema" ;
    :yValue "0.54" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "Cooking, baking" ;
    :yValue "0.46" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "DIY, decoration" ;
    :yValue "0.44" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Cultural activity (museum, exhibition ...)" ;
    :yValue "0.35" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Painting, drawing" ;
    :yValue "0.12" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Knitting etc." ;
    :yValue "0.11" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "Customization of clothes" ;
    :yValue "0.08" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "Scrapbooking (creative stationery, photo albums, framing)" ;
    :yValue "0.05" ;
    :belongsTo :Chart .
