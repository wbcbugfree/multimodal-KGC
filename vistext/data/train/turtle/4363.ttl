@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Most matches played in One Day International cricket as of September 2020 , by player" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Cricket player" .

:YAxis a :Axis ;
    :title "Number of matches played" .

:DataPoint1 a :DataPoint ;
    :xValue "SR Tendulkar (INDIA)" ;
    :yValue "463" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "DPMD Jayawardene (Asia/SL)" ;
    :yValue "448" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "ST Jayasuriya (Asia/SL)" ;
    :yValue "445" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "KC Sangakkara (Asia/ICC/SL)" ;
    :yValue "404" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "Shahid Afridi (Asia/ICC/PAK)" ;
    :yValue "398" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Inzamam-ul-Haq (Asia/PAK)" ;
    :yValue "378" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "RT Ponting (AUS/ICC)" ;
    :yValue "375" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Wasim Akram (PAK)" ;
    :yValue "356" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "MS Dhoni (Asia/INDIA)" ;
    :yValue "350" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "M Muralitharan (Asia/ICC/SL)" ;
    :yValue "350" ;
    :belongsTo :Chart .
