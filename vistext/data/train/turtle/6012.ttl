@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Projected value of the world 's largest grocery markets for 2022 , by country (in billion U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Country" .

:YAxis a :Axis ;
    :title "Market value in billion euros" .

:DataPoint1 a :DataPoint ;
    :xValue "United States" ;
    :yValue "1722" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "China" ;
    :yValue "1671" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "India" ;
    :yValue "812" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "Brazil" ;
    :yValue "509" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "Japan" ;
    :yValue "455" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Russia" ;
    :yValue "401" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Indonesia" ;
    :yValue "313" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Germany" ;
    :yValue "295" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "France" ;
    :yValue "279" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "United Kingdom" ;
    :yValue "278" ;
    :belongsTo :Chart .
