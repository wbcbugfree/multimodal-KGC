@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Germany : Main import partners in 2017" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Share in total imports" .

:YAxis a :Axis ;
    :title "Country" .

:DataPoint1 a :DataPoint ;
    :xValue "0.138" ;
    :yValue "Netherlands" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "0.07" ;
    :yValue "China" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "0.066" ;
    :yValue "France" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "0.059" ;
    :yValue "Belgium" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "0.054" ;
    :yValue "Italy" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "0.054" ;
    :yValue "Poland" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "0.048" ;
    :yValue "Czech Republic" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "0.045" ;
    :yValue "United States" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "0.043" ;
    :yValue "Austria" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "0.042" ;
    :yValue "Switzerland" ;
    :belongsTo :Chart .
