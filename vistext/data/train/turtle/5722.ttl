@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Consumer Price Index (CPI) for all items (excluding food and energy) of urban consumers in the U.S. from 1990 to 2019" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Consumer Price Index (100=1982-1984)" .

