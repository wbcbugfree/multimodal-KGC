@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Annual income of highest-paid female music celebrities in from June 2018 to June 2019 (in million U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Income in million U.S. dollars" .

:YAxis a :Axis ;
    :title "music celebrity" .

:DataPoint1 a :DataPoint ;
    :xValue "185" ;
    :yValue "Taylor Swift" ;
    :belongsTo :Chart .

