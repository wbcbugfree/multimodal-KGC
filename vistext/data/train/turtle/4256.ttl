@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Development of the world population since the beginning of the Common Era (in billions)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "World population in billions" .

:YAxis a :Axis ;
    :title "Year" .

:DataPoint1 a :DataPoint ;
    :xValue "6.9" ;
    :yValue "2010*" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "6.12" ;
    :yValue "2000*" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "2.53" ;
    :yValue "1950*" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "1.65" ;
    :yValue "1900" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "1.26" ;
    :yValue "1850" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "0.98" ;
    :yValue "1800" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "0.79" ;
    :yValue "1750" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "0.5" ;
    :yValue "1500" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "0.4" ;
    :yValue "1250" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "0.31" ;
    :yValue "1000" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "0.3" ;
    :yValue "0" ;
    :belongsTo :Chart .
