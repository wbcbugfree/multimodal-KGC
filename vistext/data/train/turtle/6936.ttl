@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Rate of unemployment in Catalonia from 2006 to 2019 , by age group" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "55 years and over" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2005" ;
    :yValue "0.039" ;
    :belongsTo :Chart .

