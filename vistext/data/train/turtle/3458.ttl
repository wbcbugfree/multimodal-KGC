@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Number of directly operated Kering Group stores worldwide in 2019 , by brand" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Number of directly operated stores" .

:YAxis a :Axis ;
    :title "Brand" .

:DataPoint1 a :DataPoint ;
    :xValue "487" ;
    :yValue "Gucci" ;
    :belongsTo :Chart .

