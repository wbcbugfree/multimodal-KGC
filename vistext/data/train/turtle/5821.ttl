@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Leading banks in Italy as of 2018 , by brand value (in million U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Brand value in million U.S. dollars" .

:YAxis a :Axis ;
    :title "bank" .

:DataPoint1 a :DataPoint ;
    :xValue "5127" ;
    :yValue "Intesa Sanpaolo" ;
    :belongsTo :Chart .

