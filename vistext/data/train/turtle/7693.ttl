@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Average hours per day in session of the U.S. Congress from 1981 to 2018" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Senate" .

