@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Death rate from liver cirrhosis in the U.S. from 1910 to 2017 (per 100,000 population)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Deaths per 100,000 population" .

