@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Most popular social networks of female beauty consumers in the United States as of August 2016" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "Percentage of respondents" .

:DataPoint1 a :DataPoint ;
    :xValue "Facebook" ;
    :yValue "0.93" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Pinterest" ;
    :yValue "0.73" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "YouTube" ;
    :yValue "0.63" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "Twitter" ;
    :yValue "0.63" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "Instagram" ;
    :yValue "0.62" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "LinkedIn" ;
    :yValue "0.36" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Snapchat" ;
    :yValue "0.32" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Etsy" ;
    :yValue "0.31" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "Sephora Community" ;
    :yValue "0.25" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "WhatsApp" ;
    :yValue "0.11" ;
    :belongsTo :Chart .
