@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "African countries with the highest Gross Domestic Product (GDP) growth rate in 2019" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "GDP growth rate" .

:YAxis a :Axis ;
    :title "Country" .

