    :xValue "New Brunswick" ;
    :yValue "115" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "Quebec" ;
    :yValue "886" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Ontario" ;
    :yValue "1749" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Manitoba" ;
    :yValue "129" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Saskatchewan" ;
    :yValue "130" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "Alberta" ;
    :yValue "401" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "British Columbia" ;
