    :xValue "Iowa" ;
    :yValue "0.186" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "West Virginia" ;
    :yValue "0.184" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "Michigan" ;
    :yValue "0.181" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Missouri" ;
    :yValue "0.181" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Kentucky" ;
    :yValue "0.18" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Maine" ;
    :yValue "0.18" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "Montana" ;
    :yValue "0.179" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "Arkansas" ;
    :yValue "0.174" ;
    :belongsTo :Chart .
