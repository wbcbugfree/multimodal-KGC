@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "U.S. states with the highest rate of electronic bullying among students in the grades 9 through 12 as of 2019" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "Share of respondents" .

:DataPoint1 a :DataPoint ;
    :xValue "New Hampshire" ;
    :yValue "0.201" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Alaska" ;
    :yValue "0.194" ;
    :belongsTo :Chart .

