@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Average age of ocean cruise passengers in the United Kingdom (UK) from 2005 to 2018" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Age in years" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2004" ;
    :yValue "54" ;
    :belongsTo :Chart .

