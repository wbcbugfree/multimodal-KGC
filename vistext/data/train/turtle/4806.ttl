@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Leading trends in food items on restaurant menus in the United States in 2018" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "Share of respondents" .

:DataPoint1 a :DataPoint ;
    :xValue "New cuts of meat (e.g. shoulder tender, oyster steak, Vegas Strip Steak, Merlot cut)" ;
    :yValue "0.69" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "African flavors" ;
    :yValue "0.69" ;
    :belongsTo :Chart .

