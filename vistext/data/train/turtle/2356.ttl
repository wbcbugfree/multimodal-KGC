@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Distribution of gross payment volume (GPV) of Square Inc. as of December 2019 , by seller industry" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Share of gross payment volume" .

:YAxis a :Axis ;
    :title "Response" .

:DataPoint1 a :DataPoint ;
    :xValue "0.26" ;
    :yValue "Food and drink" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "0.17" ;
    :yValue "Retail" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "0.15" ;
    :yValue "Professional services" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "0.11" ;
    :yValue "Beauty and personal care" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "0.09" ;
    :yValue "Healthcare and fitness" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "0.08" ;
    :yValue "Home and repair" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "0.04" ;
    :yValue "Leisure and entertainment" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "0.04" ;
    :yValue "Casual use" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "0.03" ;
    :yValue "Charities and education" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "0.02" ;
    :yValue "Transportation" ;
    :belongsTo :Chart .
