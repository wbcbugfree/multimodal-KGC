@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Number of accepted first instance asylum applicants in Europe in 2018 , by country" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Number of accepted asylum applicants" .

:YAxis a :Axis ;
    :title "Country" .

:DataPoint1 a :DataPoint ;
    :xValue "75940" ;
    :yValue "Germany" ;
    :belongsTo :Chart .

