@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Pfizer 's revenues in global submarkets from 2010 to 2019 (in million U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "United States" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2009" ;
    :yValue "28855" ;
    :belongsTo :Chart .

