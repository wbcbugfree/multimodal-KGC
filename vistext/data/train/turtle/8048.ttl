@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Leading reasons for doing freelance work in the United States in 2019" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Part-time freelancers" .

:YAxis a :Axis ;
    :title "Response" .

:DataPoint1 a :DataPoint ;
    :xValue "0.73" ;
    :yValue "To have flexibility in my schedule" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "0.66" ;
    :yValue "To be my own boss" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "0.65" ;
    :yValue "To work from the location of my choosing" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "0.64" ;
    :yValue "To be able to choose my own projects" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "0.66" ;
    :yValue "To have a schedule that enables me to pursue my personal passions" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "0.59" ;
    :yValue "To be in control of my own financial future" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "0.62" ;
    :yValue "To have independence from things such as office dynamcs" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "0.75" ;
    :yValue "To earn extra money" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "0.66" ;
    :yValue "To be able to pursue work I am passionate about or find meaningful" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "0.54" ;
    :yValue "To be able to spend more time with family" ;
    :belongsTo :Chart .
