@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Gold production value in the United States from 2007 to 2017 (in million U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Production value in million U.S. dollars" .

:YAxis a :Axis ;
    :title "Year" .

:DataPoint1 a :DataPoint ;
    :xValue "9600" ;
    :yValue "2017" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "9190" ;
    :yValue "2016*" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "8000" ;
    :yValue "2015" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "8570" ;
    :yValue "2014" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "10400" ;
    :yValue "2013" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "12600" ;
    :yValue "2012" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "11800" ;
    :yValue "2011" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "9130" ;
    :yValue "2010" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "7000" ;
    :yValue "2009" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "6550" ;
    :yValue "2008" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "5350" ;
    :yValue "2007" ;
    :belongsTo :Chart .
