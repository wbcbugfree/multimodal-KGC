@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Sponsorship worth of professional tennis players worldwide as of July 2019 (in million U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Sponsorship worth in million U.S. dollars" .

:YAxis a :Axis ;
    :title "player" .

:DataPoint1 a :DataPoint ;
    :xValue "86" ;
    :yValue "Roger Federer" ;
    :belongsTo :Chart .

