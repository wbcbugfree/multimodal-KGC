@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "How would you describe Donald Trump in one word ?" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Share of respondents" .

:YAxis a :Axis ;
    :title "Response" .

:DataPoint1 a :DataPoint ;
    :xValue "0.098" ;
    :yValue "Idiot/Jerk/Stupid/Dumb" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "0.06" ;
    :yValue "Arrogant" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "0.056" ;
    :yValue "Crazy/Nuts" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "0.047" ;
    :yValue "Buffoon/Clown/Comical/Joke" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "0.043" ;
    :yValue "Unfavorable/Disklike him" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "0.041" ;
    :yValue "Egotistical/Narcissist/Selfish" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "0.038" ;
    :yValue "Bombastic/Showoff/Pompous" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "0.031" ;
    :yValue "Outspoken/Frank/Opinionated" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "0.029" ;
    :yValue "Entertaining/Entertainer" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "0.027" ;
    :yValue "Businessman/Successful" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "0.027" ;
    :yValue "Honest/Trustworthy/Truthful" ;
    :belongsTo :Chart .

:DataPoint12 a :DataPoint ;
    :xValue "0.027" ;
    :yValue "Cunning/Untrustworthy/Dishonest" ;
    :belongsTo :Chart .

:DataPoint13 a :DataPoint ;
    :xValue "0.026" ;
    :yValue "Blow hard/Boisterous" ;
    :belongsTo :Chart .

:DataPoint14 a :DataPoint ;
    :xValue "0.026" ;
    :yValue "Favorable/Like him" ;
    :belongsTo :Chart .

:DataPoint15 a :DataPoint ;
    :xValue "0.018" ;
    :yValue "Exhilarating/Exciting/Ballsy" ;
    :belongsTo :Chart .

:DataPoint16 a :DataPoint ;
    :xValue "0.017" ;
