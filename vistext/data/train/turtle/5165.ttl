@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Plywood and veneer production in the United States from 2003 to 2017 (in million cubic feet)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Production in million cubic feet" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2002" ;
    :yValue "1052" ;
    :belongsTo :Chart .

