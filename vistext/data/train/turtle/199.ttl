@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "United Kingdom casino gaming market revenue from 2006 to 2015 (in million U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Revenue in million U.S. dollars" .

:DataPoint1 a :DataPoint ;
    :xValue "2015*" ;
    :yValue "1353" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "2014*" ;
    :yValue "1291" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "2013*" ;
    :yValue "1237" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "2012*" ;
    :yValue "1198" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "2011*" ;
    :yValue "1191" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "2010" ;
    :yValue "1209" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "2009" ;
    :yValue "1202" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "2008" ;
    :yValue "1160" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "2007" ;
    :yValue "1260" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "2006" ;
    :yValue "1245" ;
    :belongsTo :Chart .
