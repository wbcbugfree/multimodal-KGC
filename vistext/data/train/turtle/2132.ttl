@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Cobalt production value in Canada in 2019 , by province (in 1,000 Canadian dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "province of Canada" .

:YAxis a :Axis ;
    :title "Production in thousand Canadian dollars" .

:DataPoint1 a :DataPoint ;
    :xValue "Newfoundland and Labrador" ;
    :yValue "39538" ;
    :belongsTo :Chart .

