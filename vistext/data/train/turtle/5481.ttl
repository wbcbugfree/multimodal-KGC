@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Oldest living Academy Award winners as of July 2020" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Academy Award winners" .

:YAxis a :Axis ;
    :title "Age" .

:DataPoint1 a :DataPoint ;
    :xValue "Walter Mirisch" ;
    :yValue "99" ;
    :belongsTo :Chart .

