    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "Fiera, Sempione, City Life, Portello" ;
    :yValue "5986" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "Navigli" ;
    :yValue "5872" ;
    :belongsTo :Chart .

:DataPoint12 a :DataPoint ;
    :xValue "Cenisio, Sarpi, Isola" ;
    :yValue "5652" ;
