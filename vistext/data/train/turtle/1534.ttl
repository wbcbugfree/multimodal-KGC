@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Number of fatalities caused by natural disasters in the United States from 1900 to 2016 , by disaster type" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Number of fatalities" .

:YAxis a :Axis ;
    :title "Disaster type" .

:DataPoint1 a :DataPoint ;
    :xValue "16134" ;
    :yValue "Tropical cyclone" ;
    :belongsTo :Chart .

