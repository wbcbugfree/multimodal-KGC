@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "What are your good New Year 's resolutions for 2019 ?" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Share of respondents" .

:YAxis a :Axis ;
    :title "Response" .

:DataPoint1 a :DataPoint ;
    :xValue "0.186" ;
    :yValue "Having good health" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "0.144" ;
    :yValue "Having economic stability" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "0.109" ;
    :yValue "Finding more serenity" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "0.095" ;
    :yValue "Realizing my projects" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "0.074" ;
    :yValue "Finding a job" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "0.06" ;
    :yValue "Completing my projects (study, work...)" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "0.055" ;
    :yValue "Improving my lifestyle" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "0.052" ;
    :yValue "Nothing in particular" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "0.045" ;
    :yValue "Improving my fitness/doing sport" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "0.04" ;
    :yValue "Does not know/does not reply" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "0.04" ;
    :yValue "Spending more time with my family" ;
    :belongsTo :Chart .

:DataPoint12 a :DataPoint ;
    :xValue "0.038" ;
    :yValue "Losing weight" ;
    :belongsTo :Chart .

:DataPoint13 a :DataPoint ;
    :xValue "0.036" ;
    :yValue "Eliminating some of my bad habits (smoking, alcohol, gambling etc.)" ;
    :belongsTo :Chart .

:DataPoint14 a :DataPoint ;
    :xValue "0.017" ;
    :yValue "Improving family relationships" ;
    :belongsTo :Chart .

:DataPoint15 a :DataPoint ;
    :xValue "0.009" ;
    :yValue "Others" ;
    :belongsTo :Chart .
