@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Number of internet users worldwide from 2009 to 2020 , by region (in millions)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Middle East" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2008" ;
    :yValue "58.3" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Dec 31, 2009" ;
    :yValue "63.24" ;
    :belongsTo :Chart .

