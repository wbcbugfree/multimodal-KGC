@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "U.S. producer price index of plumbing fixtures and fittings from 1990 to 2018" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Price index" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 1989" ;
    :yValue "144.3" ;
    :belongsTo :Chart .

