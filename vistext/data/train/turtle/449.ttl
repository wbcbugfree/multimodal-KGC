@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Population in Germany as of December 2019 , by federal state (in 1,000s)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Population in thousands" .

:YAxis a :Axis ;
    :title "state of Germany" .

:DataPoint1 a :DataPoint ;
    :xValue "17947" ;
    :yValue "North Rhine-Westphalia" ;
    :belongsTo :Chart .

