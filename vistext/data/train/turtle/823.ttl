@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Sales volume of vinegar manufactured in the United Kingdom (UK) from 2008 to 2019 (in thousand liters)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Sales volume in thousand liters" .

:DataPoint1 a :DataPoint ;
    :xValue "2019" ;
    :yValue "89755" ;
    :belongsTo :Chart .

