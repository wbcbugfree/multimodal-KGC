@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Natural gas production in Italy in 2018 , by region (in standard cubic meters)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Production in standard cubic meters" .

:YAxis a :Axis ;
    :title "region of Italy" .

:DataPoint1 a :DataPoint ;
    :xValue "3380762482" ;
    :yValue "Offshore production" ;
    :belongsTo :Chart .

