    :xValue "-0.037" ;
    :yValue "2016" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "-0.0279" ;
    :yValue "2015" ;
    :belongsTo :Chart .

:DataPoint12 a :DataPoint ;
    :xValue "-0.0089" ;
    :yValue "2014" ;
    :belongsTo :Chart .

:DataPoint13 a :DataPoint ;
    :xValue "-0.0084" ;
    :yValue "2013" ;
    :belongsTo :Chart .

:DataPoint14 a :DataPoint ;
    :xValue "-0.003" ;
    :yValue "2012" ;
    :belongsTo :Chart .
