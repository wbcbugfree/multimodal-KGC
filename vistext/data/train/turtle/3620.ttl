@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Relationships : Which , if any , of the following have you ever done ? (Girls , United States , 2012)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "Share of respondents" .

:DataPoint1 a :DataPoint ;
    :xValue "Had a crush on someone" ;
    :yValue "0.88" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Gone on a date with someone" ;
    :yValue "0.71" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "Had your heart broken" ;
    :yValue "0.6" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "Been in love" ;
    :yValue "0.58" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "Had a serious relationship with someone" ;
    :yValue "0.56" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Casually dated someone" ;
    :yValue "0.51" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Hooked up" ;
    :yValue "0.35" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Had a \"friend with benefits\"" ;
    :yValue "0.24" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "Hooked up with a girl" ;
    :yValue "0.11" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "None of these" ;
    :yValue "0.04" ;
    :belongsTo :Chart .
