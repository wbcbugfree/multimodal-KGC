@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Number of lifetime prevalent cases of anxiety disorders among adults in select countries worldwide in 2018 , by gender (in millions)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Country" .

:YAxis a :Axis ;
    :title "Men" .

:DataPoint1 a :DataPoint ;
    :xValue "United States" ;
    :yValue "30.7" ;
    :belongsTo :Chart .

