@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Average number of cash and card transactions per person per day in the Euro Area in 2016 , by country" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "Cards" .

:DataPoint1 a :DataPoint ;
    :xValue "Italy" ;
    :yValue "0.3" ;
    :belongsTo :Chart .

