@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "U.S. electric capacity resources for the WECC (U.S.) region during the summer peak period between 1998 and 2010 (in megawatts)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Capacity resources in megawatts" .

:YAxis a :Axis ;
    :title "Year" .

:DataPoint1 a :DataPoint ;
    :xValue "158407" ;
    :yValue "2010" ;
    :belongsTo :Chart .

