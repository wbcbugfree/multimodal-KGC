@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Apprehensions by the U.S. border patrol for fiscal year 2019 , sorted by sector" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "city of the United States" .

:YAxis a :Axis ;
    :title "Number of apprehensions" .

:DataPoint1 a :DataPoint ;
    :xValue "Miami (Coastal Border)" ;
    :yValue "1891" ;
    :belongsTo :Chart .

