@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Age distribution of the population in Italy in 2019 , by region" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "region of Italy" .

:YAxis a :Axis ;
    :title "65 years and older" .

:DataPoint1 a :DataPoint ;
    :xValue "Liguria" ;
    :yValue "0.285" ;
    :belongsTo :Chart .

