@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Retail banking customer experience index level for selected Western European countries as of 2016 (in index points)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Customer experience index in index points" .

:YAxis a :Axis ;
    :title "Country" .

:DataPoint1 a :DataPoint ;
    :xValue "80.4" ;
    :yValue "Netherlands" ;
    :belongsTo :Chart .

