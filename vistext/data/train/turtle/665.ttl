@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Leading passenger source countries in the global cruise industry in 2018" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Country" .

:YAxis a :Axis ;
    :title "Global passenger share" .

:DataPoint1 a :DataPoint ;
    :xValue "United States" ;
    :yValue "0.459" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "China" ;
    :yValue "0.083" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "Germany" ;
    :yValue "0.078" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "UK" ;
    :yValue "0.07" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "Australia" ;
    :yValue "0.047" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Canada" ;
    :yValue "0.034" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Italy" ;
    :yValue "0.029" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Spain" ;
    :yValue "0.019" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "France" ;
    :yValue "0.018" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "Brazil" ;
    :yValue "0.018" ;
    :belongsTo :Chart .
