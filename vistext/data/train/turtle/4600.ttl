@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Number of pet and pet supplies stores in Canada as of December 2019 , by region" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Number of stores" .

:YAxis a :Axis ;
    :title "region" .

:DataPoint1 a :DataPoint ;
    :xValue "762" ;
    :yValue "Ontario" ;
    :belongsTo :Chart .

