@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Top 15 occupations with the fastest projected employment growth in the United States from 2018 to 2028" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Occupation" .

:YAxis a :Axis ;
    :title "Employment growth in percent" .

:DataPoint1 a :DataPoint ;
    :xValue "Solar photovoltaic installers" ;
    :yValue "0.633" ;
    :belongsTo :Chart .

