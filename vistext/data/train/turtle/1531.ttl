@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Proportion of the population of England whose main language was not English in 2011 , by region" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Share of population" .

:YAxis a :Axis ;
    :title "Response" .

:DataPoint1 a :DataPoint ;
    :xValue "0.221" ;
    :yValue "London" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "0.072" ;
    :yValue "West Midlands" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "0.062" ;
    :yValue "East Midlands" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "0.059" ;
    :yValue "Yorkshire and the Humber" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "0.058" ;
    :yValue "South East" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "0.055" ;
    :yValue "East" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "0.051" ;
    :yValue "North West" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "0.035" ;
    :yValue "South West" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "0.028" ;
    :yValue "North East" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "0.08" ;
    :yValue "England" ;
    :belongsTo :Chart .
