@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Occupancy rate of Marriott International hotels worldwide from 2010 to 2019 , by region" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "North America" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2009" ;
    :yValue "0.681" ;
    :belongsTo :Chart .

