@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Pork consumption per capita in Malaysia from 2006 to 2019 , with a forecast for 2025 (in kilograms)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Consumption per capita in kilograms" .

:YAxis a :Axis ;
    :title "Year" .

:DataPoint1 a :DataPoint ;
    :xValue "5.21" ;
    :yValue "2025*" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "5.36" ;
    :yValue "2019" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "5.38" ;
    :yValue "2018" ;
    :belongsTo :Chart .

