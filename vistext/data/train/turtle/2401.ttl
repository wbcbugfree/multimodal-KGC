@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Entry doors used the most by construction firms in the United States in 2014" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Brand" .

:YAxis a :Axis ;
    :title "Share of respondents" .

:DataPoint1 a :DataPoint ;
    :xValue "Therma-Tru" ;
    :yValue "0.24" ;
    :belongsTo :Chart .

