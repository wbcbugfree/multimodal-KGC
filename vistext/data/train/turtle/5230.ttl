@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Rental prices of prime logistic properties in selected European cities as of 4th quarter 2019 (in euros per square meter per year)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "city" .

:YAxis a :Axis ;
    :title "Annual cost per square meter in euros" .

:DataPoint1 a :DataPoint ;
    :xValue "Zurich" ;
    :yValue "230" ;
    :belongsTo :Chart .

