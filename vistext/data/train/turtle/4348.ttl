@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Total federal drug control spending in the United States from FY 2012 to FY 2021 (in million U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Total spending in million U.S. dollars" .

:DataPoint1 a :DataPoint ;
    :xValue "2012" ;
    :yValue "24504.1" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "2013" ;
    :yValue "23809.6" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "2014" ;
    :yValue "25733.1" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "2015" ;
    :yValue "25892.9" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "2016" ;
    :yValue "26874" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "2017" ;
    :yValue "28813.3" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "2018" ;
    :yValue "33286.5" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "2019" ;
    :yValue "(Final)" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "36808.3" ;
    :yValue "2020" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "(Enacted)" ;
    :yValue "35601.4" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "2021" ;
    :yValue "(Request)" ;
    :belongsTo :Chart .
