@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Canada 's leading 20 oil fields based on cumulative production until 2018 (in cubic meters)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Cumulative production in cubic meters" .

:YAxis a :Axis ;
    :title "Oil field (province/territory)" .

