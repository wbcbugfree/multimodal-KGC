@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Share of households with access to the internet in the United Kingdom (UK) in 2014 , by gross income groups" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Gross income decile group" .

:YAxis a :Axis ;
    :title "Percentage of respondents" .

:DataPoint1 a :DataPoint ;
    :xValue "Lowest ten percent" ;
    :yValue "0.51" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Second decile group" ;
    :yValue "0.56" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "Third decile group" ;
    :yValue "0.73" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "Fourth decile group" ;
    :yValue "0.83" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "Fifth decile group" ;
    :yValue "0.91" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Sixth decile group" ;
    :yValue "0.94" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Seventh decile group" ;
    :yValue "0.98" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Eighth decile group" ;
    :yValue "0.99" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "Ninth decile group" ;
    :yValue "0.99" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "Highest ten percent" ;
    :yValue "0.99" ;
    :belongsTo :Chart .
