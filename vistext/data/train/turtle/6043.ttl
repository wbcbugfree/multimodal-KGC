@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Amount of U.S. tea imports from selected countries of origin in 2018 (in 1,000 metric tons)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "2016" .

:YAxis a :Axis ;
    :title "Country" .

