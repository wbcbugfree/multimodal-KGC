@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Manufacturer sales of semiconductor light emitting diodes (LEDs) in the United Kingdom (UK) from 2008 to 2019 (in million GBP)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Manufacturer sales in million GBP" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2007" ;
    :yValue "7.49" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Dec 31, 2008" ;
    :yValue "8.99" ;
    :belongsTo :Chart .

