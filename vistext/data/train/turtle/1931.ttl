@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Annual natural gas consumption for energy use in the United Kingdom (UK) from 1970 to 2019 (in million metric tons of oil equivalent)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Consumption in Mtoe*" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 1969" ;
    :yValue "11.3" ;
    :belongsTo :Chart .

