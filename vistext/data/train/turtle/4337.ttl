@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Annual consumption of cheese worldwide in 2019 , by selected country (in 1,000 metric tons)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Country" .

:YAxis a :Axis ;
    :title "Consumption in thousand metric tons" .

:DataPoint1 a :DataPoint ;
    :xValue "EU" ;
    :yValue "9458" ;
    :belongsTo :Chart .

