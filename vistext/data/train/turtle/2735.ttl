@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Child mortality rate (under five years old) in Norway from 1815 to 2020" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Deaths per 1,000 live births" .

