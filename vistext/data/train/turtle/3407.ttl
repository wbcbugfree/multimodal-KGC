    :xValue "55860" ;
    :yValue "Russia" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "28310" ;
    :yValue "Poland" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "18615" ;
    :yValue "Mexico" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "13109" ;
    :yValue "Brazil" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "11683" ;
    :yValue "Germany*" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "2987" ;
    :yValue "Canada" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "2800" ;
    :yValue "United Kingdom" ;
