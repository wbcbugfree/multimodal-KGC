@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Number of exported U.S. sheep & lambskins by top 10 destination countries in 2018" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Number of sheep & lambskins" .

:YAxis a :Axis ;
    :title "Country" .

:DataPoint1 a :DataPoint ;
    :xValue "635279" ;
    :yValue "China" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "116840" ;
    :yValue "Turkey" ;
    :belongsTo :Chart .

