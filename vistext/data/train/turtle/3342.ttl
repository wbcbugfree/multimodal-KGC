@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Life stage of convenience store shoppers in the United Kingdom (UK) in 2015" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Share of respondents" .

:YAxis a :Axis ;
    :title "Response" .

:DataPoint1 a :DataPoint ;
    :xValue "27" ;
    :yValue "Single dweller" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "23" ;
    :yValue "Couples with young children" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "22" ;
    :yValue "Retired greys" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "16" ;
    :yValue "Busy provider" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "16" ;
    :yValue "Child-free couples" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "16" ;
    :yValue "Post-nesters" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "14" ;
    :yValue "Pre-nesters" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "13" ;
    :yValue "At home mums" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "7" ;
    :yValue "Young, free and single" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "5" ;
    :yValue "Other" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "4" ;
    :yValue "Student" ;
    :belongsTo :Chart .
