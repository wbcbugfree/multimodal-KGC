@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Leading active social media platforms in the United Kingdom (UK) in the second and third quarter of 2019 , by reach" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "Share of respondents" .

:DataPoint1 a :DataPoint ;
    :xValue "Youtube" ;
    :yValue "0.78" ;
    :belongsTo :Chart .

