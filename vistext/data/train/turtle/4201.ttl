@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Bechtel 's global revenue from FY 2006 to FY 2019 (in billion U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Revenue in billion U.S. dollars" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2005" ;
    :yValue "20.5" ;
    :belongsTo :Chart .

