@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "European soccer teams/clubs ranked by team value in 2019 (in million U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Team value in million U.S. dollars" .

:YAxis a :Axis ;
    :title "Year" .

