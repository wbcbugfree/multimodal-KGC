@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Boston Red Sox all-time games played leaders as of October 2020" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Number of games played" .

:YAxis a :Axis ;
    :title "player name" .

:DataPoint1 a :DataPoint ;
    :xValue "3308" ;
    :yValue "Carl Yastrzemski" ;
    :belongsTo :Chart .

