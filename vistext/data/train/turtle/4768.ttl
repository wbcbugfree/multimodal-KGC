@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Millennial social media usage in the Netherlands in 2020 , by platform" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "Share of respondents" .

:DataPoint1 a :DataPoint ;
    :xValue "WhatsApp" ;
    :yValue "0.89" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Facebook" ;
    :yValue "0.82" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "YouTube" ;
    :yValue "0.79" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "Instagram" ;
    :yValue "0.57" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "LinkedIn" ;
    :yValue "0.47" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Snapchat" ;
    :yValue "0.35" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Pinterest" ;
    :yValue "0.32" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Twitter" ;
    :yValue "0.26" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "TikTok" ;
    :yValue "0.09" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "Tumblr" ;
    :yValue "0.06" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "WeChat" ;
    :yValue "0.05" ;
    :belongsTo :Chart .

:DataPoint12 a :DataPoint ;
    :xValue "Foursquare" ;
    :yValue "0.04" ;
    :belongsTo :Chart .
