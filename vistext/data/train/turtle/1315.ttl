@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Percentage change on previous year of housing rent in the Netherlands from 1990 to 2019" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Year on year percentage change" .

