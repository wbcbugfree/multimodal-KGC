    :xValue "2014" ;
    :yValue "0.505" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "2013" ;
    :yValue "0.481" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "2012" ;
    :yValue "0.396" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "2011" ;
    :yValue "0.339" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "2010" ;
    :yValue "0.279" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "2009" ;
    :yValue "0.218" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "2008" ;
    :yValue "0.169" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "2007" ;
