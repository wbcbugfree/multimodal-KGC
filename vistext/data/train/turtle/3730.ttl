@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Number of Honda cars sold in Switzerland from 2009 to 2019" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Units sold" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2008" ;
    :yValue "8289" ;
    :belongsTo :Chart .

