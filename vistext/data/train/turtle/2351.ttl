@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Consumption of corn worldwide in 2019/2020 , by country (in million bushels)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Country" .

:YAxis a :Axis ;
    :title "Consumption in million bushels" .

:DataPoint1 a :DataPoint ;
    :xValue "United States" ;
    :yValue "12295" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "China" ;
    :yValue "10984" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "European Union" ;
    :yValue "3248" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "Brazil" ;
    :yValue "2598" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "Mexico" ;
    :yValue "1752" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "India" ;
    :yValue "1142" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Egypt" ;
    :yValue "657" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Japan" ;
    :yValue "634" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "Vietnam" ;
    :yValue "606" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "Argentina" ;
    :yValue "591" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "Total" ;
    :yValue "44690" ;
    :belongsTo :Chart .
