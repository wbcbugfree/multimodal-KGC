@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Do you think the United States is the No . 1 in the world militarily , or that it is one of several leading military powers ?" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "U.S. is one of several" .

:YAxis a :Axis ;
    :title "Response" .

:DataPoint1 a :DataPoint ;
    :xValue "0.41" ;
    :yValue "2020*" ;
    :belongsTo :Chart .

