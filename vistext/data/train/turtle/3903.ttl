@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Number of newly internally displaced persons (IDPs) due to conflict in 2019 , by country (in 1,000s)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Country" .

:YAxis a :Axis ;
    :title "Number of new IDPs in thousands" .

:DataPoint1 a :DataPoint ;
    :xValue "Syria" ;
    :yValue "1800" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Democratic Republic of the Congo" ;
    :yValue "1700" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "Ethiopia" ;
    :yValue "1100" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "Burkina Faso" ;
    :yValue "513" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "Afghanistan" ;
    :yValue "461" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "El Salvador" ;
    :yValue "454" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Yemen" ;
    :yValue "398" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Mali" ;
    :yValue "284" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "South Sudan" ;
    :yValue "259" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "Nigeria" ;
    :yValue "248" ;
    :belongsTo :Chart .
