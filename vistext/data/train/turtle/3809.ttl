@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Share of people saving for old age in Indonesia in 2017 , by type of population" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "Share of respondents" .

:DataPoint1 a :DataPoint ;
    :xValue "Total" ;
    :yValue "0.27" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Men" ;
    :yValue "0.28" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "In labor" ;
    :yValue "0.29" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "Out of labor" ;
    :yValue "0.24" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "Women" ;
    :yValue "0.27" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Young adults (15-24 years)" ;
    :yValue "0.31" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Adults (25 years and older)" ;
    :yValue "0.26" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Primary education or less" ;
    :yValue "0.15" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "Secondary education or more" ;
    :yValue "0.38" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "Poorest 40% (income)" ;
    :yValue "0.19" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "Richest 60% (income)" ;
    :yValue "0.33" ;
    :belongsTo :Chart .

:DataPoint12 a :DataPoint ;
    :xValue "Rural population" ;
    :yValue "0.26" ;
    :belongsTo :Chart .
