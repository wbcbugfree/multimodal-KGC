@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Share of Indonesian population who wore face masks in public places during COVID-19 outbreak from February to September 2020" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "Share of respondents" .

:DataPoint1 a :DataPoint ;
    :xValue "Sep 14" ;
    :yValue "0.86" ;
    :belongsTo :Chart .

