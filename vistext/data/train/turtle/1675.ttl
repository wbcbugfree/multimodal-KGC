@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Types of digital promotions most likely to influence purchase decisions of consumers in the United States as of 2nd quarter 2015" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "Share of respondents" .

:DataPoint1 a :DataPoint ;
    :xValue "Retailer social" ;
    :yValue "0.29" ;
    :belongsTo :Chart .

