@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Number of people who immigrated to Sweden in 2019 , by country of birth" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Number of immigrations" .

:YAxis a :Axis ;
    :title "Country" .

:DataPoint1 a :DataPoint ;
    :xValue "11955" ;
    :yValue "Sweden" ;
    :belongsTo :Chart .

