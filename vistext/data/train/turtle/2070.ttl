@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Number of patients on diabetes register in England from 2008/09 to 2017/18" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Number of patients on diabetes register" .

:YAxis a :Axis ;
    :title "Year" .

:DataPoint1 a :DataPoint ;
    :xValue "3196124" ;
    :yValue "2017/18" ;
    :belongsTo :Chart .

