@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Monthly hotel rates on TripAdvisor in Australia in 2015 (in U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Month" .

:YAxis a :Axis ;
    :title "Average rate in U.S. dollars" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec" ;
    :yValue "144" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Nov" ;
    :yValue "138" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "Oct" ;
    :yValue "139" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "Sep" ;
    :yValue "137" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "Aug" ;
    :yValue "137" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Jul" ;
    :yValue "138" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Jun" ;
    :yValue "133" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "May" ;
    :yValue "131" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "Apr" ;
    :yValue "135" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "Mar" ;
    :yValue "138" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "Feb" ;
    :yValue "139" ;
    :belongsTo :Chart .

:DataPoint12 a :DataPoint ;
    :xValue "Jan" ;
    :yValue "144" ;
    :belongsTo :Chart .
