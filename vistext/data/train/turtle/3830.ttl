@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Chicago Blackhawks player expenses (payroll) from 2005/06 to 2018/19 (in million U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Player expenses in million U.S. dollars" .

:YAxis a :Axis ;
    :title "Year" .

:DataPoint1 a :DataPoint ;
    :xValue "75" ;
    :yValue "2018/19" ;
    :belongsTo :Chart .

