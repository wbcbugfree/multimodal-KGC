@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Share of employees worldwide who believe learning technologies are effective in 2018 , by type of technology" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "Share of respondents" .

:DataPoint1 a :DataPoint ;
    :xValue "On-the job, hands-on or experiental learning" ;
    :yValue "0.9" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Mentoring or coaching" ;
    :yValue "0.83" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "Instructor-led or classroom training" ;
    :yValue "0.78" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "Fomal curriculum or courses*" ;
    :yValue "0.6" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "Videos" ;
    :yValue "0.57" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Online simulations games" ;
    :yValue "0.54" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Virtual instructor-led training**" ;
    :yValue "0.52" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "eLearning courses" ;
    :yValue "0.44" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "Podcast" ;
    :yValue "0.35" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "Augmented reality" ;
    :yValue "0.3" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "Virtual reality" ;
    :yValue "0.29" ;
    :belongsTo :Chart .

:DataPoint12 a :DataPoint ;
    :xValue "Social collaboration or learning application***" ;
    :yValue "0.23" ;
    :belongsTo :Chart .

:DataPoint13 a :DataPoint ;
    :xValue "Mobile device notifications or text messages" ;
    :yValue "0.2" ;
    :belongsTo :Chart .
