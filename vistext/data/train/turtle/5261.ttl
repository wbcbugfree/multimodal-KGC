@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Share of individuals who made purchases online in Great Britain from 2008 to 2020" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "Share of respondents" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2007" ;
    :yValue "0.53" ;
    :belongsTo :Chart .

