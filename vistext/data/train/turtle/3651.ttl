@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "European countries with the highest number of leading banks in 2017" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Total assets in billion euros" .

:YAxis a :Axis ;
    :title "Country" .

:DataPoint1 a :DataPoint ;
    :xValue "7" ;
    :yValue "Germany" ;
    :belongsTo :Chart .

