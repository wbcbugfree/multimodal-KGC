@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Number of fixed broadband subscribers by country in the 1st quarter of 2019 (in millions)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Broadband subscribers in millions" .

:YAxis a :Axis ;
    :title "Country" .

:DataPoint1 a :DataPoint ;
    :xValue "400.5" ;
    :yValue "China" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "112" ;
    :yValue "USA" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "39.5" ;
    :yValue "Japan" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "34.5" ;
    :yValue "Germany" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "32.5" ;
    :yValue "Russia" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "29" ;
    :yValue "France" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "28.5" ;
    :yValue "Brazil" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "27" ;
    :yValue "UK" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "21.5" ;
    :yValue "South Korea" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "19" ;
    :yValue "India" ;
    :belongsTo :Chart .
