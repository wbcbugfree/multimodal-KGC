@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Distribution of gross domestic product of Prince Edward Island , Canada , in 2019 , by industry" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "Share of GDP" .

:DataPoint1 a :DataPoint ;
    :xValue "Real estate and rental and leasing" ;
    :yValue "0.1226" ;
    :belongsTo :Chart .

