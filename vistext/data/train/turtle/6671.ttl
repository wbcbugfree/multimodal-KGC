@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Revenue of the LVMH Group worldwide from 2008 to 2019 , by geographic region (in million euros)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "France" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2007" ;
    :yValue "2646" ;
    :belongsTo :Chart .

