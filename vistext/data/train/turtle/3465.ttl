@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Operating income of Wyndham Worldwide from 2005 to 2017 (in million U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Operating income in million U.S. dollars" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2004" ;
    :yValue "620" ;
    :belongsTo :Chart .

