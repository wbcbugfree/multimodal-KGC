@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Natural gas production of OPEC countries from 2012 to 2019 (in million cubic meters)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Country" .

:YAxis a :Axis ;
    :title "2019" .

:DataPoint1 a :DataPoint ;
    :xValue "Ira" ;
    :yValue "253773" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Iran Saudi Arabi" ;
    :yValue "117000" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "Saudi Arabia Algeri" ;
    :yValue "89583" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "Algeria United Arab Emirate" ;
    :yValue "55097" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "United Arab Emirates Nigeri" ;
    :yValue "47828" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Nigeria Venezuel" ;
    :yValue "20559" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Venezuela Kuwai" ;
    :yValue "13952" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Kuwait Liby" ;
    :yValue "14190" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "Libya Ira" ;
    :yValue "11544" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "Iraq Angol" ;
    :yValue "10546" ;
    :belongsTo :Chart .
