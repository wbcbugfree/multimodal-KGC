@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Roche Group 's net income from 2007 to 2019 (in million Swiss francs)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Net income in million Swiss francs" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2006" ;
    :yValue "11437" ;
    :belongsTo :Chart .

