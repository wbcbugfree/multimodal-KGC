@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Health and fitness club membership in Africa and the Middle East in 2019 , by country (in 1,000s)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Country" .

:YAxis a :Axis ;
    :title "Members of health clubs in thousands" .

:DataPoint1 a :DataPoint ;
    :xValue "South Africa" ;
    :yValue "2263.18" ;
    :belongsTo :Chart .

