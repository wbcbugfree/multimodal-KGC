@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Leading crude oil refining companies worldwide in 2014 , by capacity (in 1,000 barrels per day)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Company (country)" .

:YAxis a :Axis ;
    :title "Refining capacity in thousand barrels per day" .

:DataPoint1 a :DataPoint ;
    :xValue "ExxonMobil (U.S.)" ;
    :yValue "5589" ;
    :belongsTo :Chart .

