@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Consumer spending expectations for the following six months on consumer products due to the coronavirus in the United States as of March 9 , 2020" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "About the same" .

:YAxis a :Axis ;
    :title "consumer products" .

:DataPoint1 a :DataPoint ;
    :xValue "0.67" ;
    :yValue "Fresh and organic goods" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "0.72" ;
    :yValue "Vitamins, minerals, herbs, or supplements" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "0.61" ;
    :yValue "Home furniture and décor" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "0.64" ;
    :yValue "Nonmobile consumer electronics and appliances" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "0.67" ;
    :yValue "Cars/automobiles" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "0.64" ;
    :yValue "Mobile electronics" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "0.63" ;
    :yValue "Toys and games" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "0.63" ;
    :yValue "Luxury/fashion" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "0.59" ;
    :yValue "Tobacco and smoking products" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "0.63" ;
    :yValue "Outerwear/jackets/coats" ;
    :belongsTo :Chart .
