@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Total assets of the Royal Bank of Scotland from 2007 to 2019 (in billion GBP)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Total assets in billion GBP" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2006" ;
    :yValue "1840.8" ;
    :belongsTo :Chart .

