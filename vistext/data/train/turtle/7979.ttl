@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Extent of global maritime trade with bulk goods from 1970 to 2008 (in billion ton-miles)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Other general cargo" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 1969" ;
    :yValue "2118" ;
    :belongsTo :Chart .

