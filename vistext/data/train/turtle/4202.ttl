@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Leading motor vehicle manufacturers worldwide in 2017 , based on production (in 1,000 units)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Production in thousand units" .

:YAxis a :Axis ;
    :title "Manufacturer" .

:DataPoint1 a :DataPoint ;
    :xValue "10466" ;
    :yValue "Toyota" ;
    :belongsTo :Chart .

