@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Share of total U.S. merchandise exports that went to NAFTA countries from 2002 to 2019" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "Share of total export volume" .

