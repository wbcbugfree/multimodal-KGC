@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Annual solar PV capacity installations in the U.S. residential sector from 2005 to 2019 (in megawatts)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Capacity in megawatts" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2004" ;
    :yValue "27" ;
    :belongsTo :Chart .

