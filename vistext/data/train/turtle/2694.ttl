@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Expenditure on defense as share of the GDP in Italy from 2008 to 2020" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Expenditure as share of GDP" .

