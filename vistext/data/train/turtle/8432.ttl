@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Population of Finland in 2019 , by region and language" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "region of Finland" .

:YAxis a :Axis ;
    :title "Foreign languages" .

