@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Total number of marriages in France from 2004 to 2019" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Number of marriages" .

