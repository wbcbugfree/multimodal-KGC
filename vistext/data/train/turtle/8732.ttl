@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Urban and rural population of China from 2009 to 2019 (in million inhabitants)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Urban regions" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2008" ;
    :yValue "645.12" ;
    :belongsTo :Chart .

