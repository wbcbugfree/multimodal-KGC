@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Total number of deceased donor organ transplants in the United Kingdom (UK) from 2009/10 to 2019/20" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Total number of organ transplants" .

:YAxis a :Axis ;
    :title "Year" .

:DataPoint1 a :DataPoint ;
    :xValue "3760" ;
    :yValue "2019/20" ;
    :belongsTo :Chart .

