@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Construction costs of buildings in Alberta , Canada in 2019 , by select building type (in Canadian dollars per square meter)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "building type" .

:YAxis a :Axis ;
    :title "Maximum" .

:DataPoint1 a :DataPoint ;
    :xValue "Health care - residential care" ;
    :yValue "3210" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Health care - ambulatory care" ;
    :yValue "5220" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "High-rise residential - market units**" ;
    :yValue "3190" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "Low- & mid-rise apartments - market units**" ;
    :yValue "2290" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "Townhouses (wood frame) - market units**" ;
    :yValue "1660" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Enclosed mall" ;
    :yValue "3160" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Supermarket" ;
    :yValue "2240" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Office - 5-10 stories" ;
    :yValue "2880" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "Office - 10-20 stories" ;
    :yValue "3010" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "Secondary schools" ;
    :yValue "3030" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "Higher education" ;
    :yValue "3870" ;
    :belongsTo :Chart .

:DataPoint12 a :DataPoint ;
    :xValue "Warehouse" ;
    :yValue "1540" ;
    :belongsTo :Chart .

:DataPoint13 a :DataPoint ;
    :xValue "Hotels - low rise" ;
    :yValue "2520" ;
    :belongsTo :Chart .
