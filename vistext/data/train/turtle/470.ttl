@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Principal rice importing countries worldwide in 2019/2020 (in 1,000 metric tons)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Import in thousand metric tons" .

:YAxis a :Axis ;
    :title "Country" .

:DataPoint1 a :DataPoint ;
    :xValue "2500" ;
    :yValue "Philippines" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "2300" ;
    :yValue "China" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "2300" ;
    :yValue "European Union" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "1350" ;
    :yValue "Saudi Arabia" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "1150" ;
    :yValue "Senegal" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "1100" ;
    :yValue "Iraq" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "1100" ;
    :yValue "Cote d'Ivoire" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "1100" ;
    :yValue "Iran" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "1000" ;
    :yValue "Nigeria" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "1000" ;
    :yValue "South Africa" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "1000" ;
    :yValue "United Arab Emirates" ;
    :belongsTo :Chart .
