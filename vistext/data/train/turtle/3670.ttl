@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Value of alcoholic beverage exports from Sweden from 2009 to 2019 (in 1,000 SEK)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Export value in thousand SEK" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2007" ;
    :yValue "6416730" ;
    :belongsTo :Chart .

