@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Number of mining conflicts in Latin America and the Caribbean as of June 2020 , by country" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Country" .

:YAxis a :Axis ;
    :title "Number of mining conflicts" .

