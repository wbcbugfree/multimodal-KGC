@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Job titles in the hotel industry with minimum wage starting rates in the United States in 2014" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Share of respondents" .

:YAxis a :Axis ;
    :title "Response" .

:DataPoint1 a :DataPoint ;
    :xValue "0.642" ;
    :yValue "Housekeeper" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "0.546" ;
    :yValue "Food server" ;
    :belongsTo :Chart .

