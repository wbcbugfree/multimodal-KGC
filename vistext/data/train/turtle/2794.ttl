    :xValue "0.45" ;
    :yValue "Laundry attendant" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "0.31" ;
    :yValue "Bartender" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "0.24" ;
    :yValue "Dishwasher/steward" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "0.192" ;
    :yValue "Front desk agent" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "0.183" ;
    :yValue "Restaurant host" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "0.157" ;
    :yValue "Bar back" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "0.127" ;
