@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Which of the following social and economic issues concern you the most ?" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "Share of respondents" .

:DataPoint1 a :DataPoint ;
    :xValue "Finding a job" ;
    :yValue "0.63" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Environment" ;
    :yValue "0.37" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "Sanitary system" ;
    :yValue "0.25" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "Security" ;
    :yValue "0.24" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "School system" ;
    :yValue "0.24" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Taxes" ;
    :yValue "0.23" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Recession and financial crisis" ;
    :yValue "0.23" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Immigration" ;
    :yValue "0.21" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "Pensions" ;
    :yValue "0.19" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "Public debt" ;
    :yValue "0.1" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "Right to housing" ;
    :yValue "0.09" ;
    :belongsTo :Chart .

:DataPoint12 a :DataPoint ;
    :xValue "Purchasing power / inflation" ;
    :yValue "0.08" ;
    :belongsTo :Chart .

:DataPoint13 a :DataPoint ;
    :xValue "Nuclear" ;
    :yValue "0.07" ;
    :belongsTo :Chart .

:DataPoint14 a :DataPoint ;
    :xValue "Tax havens" ;
    :yValue "0.03" ;
    :belongsTo :Chart .

:DataPoint15 a :DataPoint ;
    :xValue "Social housing" ;
    :yValue "0.01" ;
    :belongsTo :Chart .

:DataPoint16 a :DataPoint ;
    :xValue "None of these" ;
    :yValue "0.01" ;
    :belongsTo :Chart .
