@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Many people have concerns or fears for their retirement . Which , if any , of the following concerns or fears do you have ?" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Fears and concerns" .

:YAxis a :Axis ;
    :title "Share of respondents" .

:DataPoint1 a :DataPoint ;
    :xValue "Financial hardship" ;
    :yValue "0.57" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Poor health" ;
    :yValue "0.54" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "Not having enough money for good healthcare provision" ;
    :yValue "0.46" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "Not being able to realise hopes and aspirations" ;
    :yValue "0.31" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "Loneliness" ;
    :yValue "0.28" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Loss of memory" ;
    :yValue "0.27" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Having to work for longer than I want to" ;
    :yValue "0.27" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Boredom" ;
    :yValue "0.25" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "Not being able to work" ;
    :yValue "0.24" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "The move from 'active' to 'passive' retirement" ;
    :yValue "0.17" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "Discrimination" ;
    :yValue "0.08" ;
    :belongsTo :Chart .

:DataPoint12 a :DataPoint ;
    :xValue "None of these" ;
    :yValue "0.03" ;
    :belongsTo :Chart .

:DataPoint13 a :DataPoint ;
    :xValue "Don't know" ;
    :yValue "0.02" ;
    :belongsTo :Chart .
