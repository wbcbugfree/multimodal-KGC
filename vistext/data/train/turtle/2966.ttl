@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Production of pistachios worldwide from 2007/2008 to 2019/2020 (in 1,000 metric tons)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Production in thousand metric tons" .

:YAxis a :Axis ;
    :title "Year" .

