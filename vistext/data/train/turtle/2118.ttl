@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Natural gas prices for households in Latvia from 2010 to 2018 , semi-annually (in euro cents per kilowatt-hour)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Euro cents per kilowatt-hour" .

:YAxis a :Axis ;
    :title "Year" .

:DataPoint1 a :DataPoint ;
    :xValue "4.11" ;
    :yValue "2018 S1" ;
    :belongsTo :Chart .

