@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Percentage of Prince Edward Island 's population in low income from 2000 to 2018" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "Percentage of population in low income" .

