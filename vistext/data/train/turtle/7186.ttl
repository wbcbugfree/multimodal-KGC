@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Distribution of Florida Power and Light 's operating revenue from FY 2007 to FY 2019 , by customer class" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Interchange power sales" .

:YAxis a :Axis ;
    :title "Year" .

:DataPoint1 a :DataPoint ;
    :xValue "0.025" ;
    :yValue "2015" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "0.028" ;
    :yValue "2014" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "0.023" ;
    :yValue "2013" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "0.007" ;
    :yValue "2012" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "0.009" ;
    :yValue "2011" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "0.008" ;
    :yValue "2010" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "0.014" ;
    :yValue "2009" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "0.016" ;
    :yValue "2008" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "0.018" ;
    :yValue "2007" ;
    :belongsTo :Chart .
