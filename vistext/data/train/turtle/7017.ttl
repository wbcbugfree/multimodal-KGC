@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Monthly sales of cookies , confectionery and snack foods at large retailers in Canada from January 2015 to April 2019 (in million Canadian dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Month" .

:YAxis a :Axis ;
    :title "2019" .

:DataPoint1 a :DataPoint ;
    :xValue "Ap" ;
    :yValue "582.22" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Apr Ma" ;
    :yValue "523.48" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "Mar Fe" ;
    :yValue "477.3" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "Feb Ja" ;
    :yValue "475" ;
    :belongsTo :Chart .
