@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Active population in Luxembourg from September 2018 to September 2019" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Month" .

:YAxis a :Axis ;
    :title "Active population" .

:DataPoint1 a :DataPoint ;
    :xValue "Sep '19" ;
    :yValue "288273" ;
