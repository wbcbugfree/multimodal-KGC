@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Workforce in the non-residential food catering sector in the United Kingdom (UK) from 2003 to 2019 (in 1,000 persons)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Workforce in thousand persons" .

:YAxis a :Axis ;
    :title "Year" .

