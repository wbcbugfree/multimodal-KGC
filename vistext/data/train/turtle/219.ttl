@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Number of active NFL players by state of birth (as of October 6 , 2011)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "State" .

:YAxis a :Axis ;
    :title "Number of players" .

:DataPoint1 a :DataPoint ;
    :xValue "California" ;
    :yValue "225" ;
    :belongsTo :Chart .

