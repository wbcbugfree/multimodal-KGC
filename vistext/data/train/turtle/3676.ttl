@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Hearing aid brands most often dispensed or prescribed by audiologists in the U.S. as of 2018" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Percentage of audiologists" .

:YAxis a :Axis ;
    :title "Response" .

:DataPoint1 a :DataPoint ;
    :xValue "0.75" ;
    :yValue "Phonak (Sonova)" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "0.7" ;
    :yValue "Oticon (Wm. Demant)" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "0.58" ;
    :yValue "ReSound (GN Group)" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "0.57" ;
    :yValue "Starkey" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "0.44" ;
    :yValue "Widex" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "0.38" ;
    :yValue "Signia" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "0.29" ;
    :yValue "Unitron (Sonova)" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "0.17" ;
    :yValue "Lyric (Sonova)" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "0.07" ;
    :yValue "Sonic (Wm. Demant)" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "0.04" ;
    :yValue "Other" ;
    :belongsTo :Chart .
