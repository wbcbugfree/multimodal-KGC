@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Share of cross screen in the number of digital video ad campaigns in the United States from 3rd quarter 2014 to 1st quarter 2018" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Share of all campaigns" .

:YAxis a :Axis ;
    :title "Response" .

:DataPoint1 a :DataPoint ;
    :xValue "0.98" ;
    :yValue "Q1 2018" ;
    :belongsTo :Chart .

