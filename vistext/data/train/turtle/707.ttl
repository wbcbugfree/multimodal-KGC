@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Net income of Mattel worldwide from 2006 to 2019 (in million U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Net income in million U.S. dollars" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2005" ;
    :yValue "592.93" ;
    :belongsTo :Chart .

