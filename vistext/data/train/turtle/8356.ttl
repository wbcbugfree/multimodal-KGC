    :xValue "0.28" ;
    :yValue "South Africa" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "0.12" ;
    :yValue "Brazil" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "0.31" ;
    :yValue "South Korea" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "0.3" ;
    :yValue "China" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "0.08" ;
    :yValue "Italy" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "0.08" ;
    :yValue "Canada" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "0.22" ;
    :yValue "Germany" ;
    :belongsTo :Chart .

:DataPoint12 a :DataPoint ;
