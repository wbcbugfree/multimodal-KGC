@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Consumer preferred channels of brand communication during the coronavirus pandemic worldwide as of March 2020 , by country" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Texts" .

:YAxis a :Axis ;
    :title "Response" .

:DataPoint1 a :DataPoint ;
    :xValue "0.18" ;
    :yValue "Average" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "0.13" ;
    :yValue "United States" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "0.37" ;
    :yValue "India" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "0.08" ;
    :yValue "Japan" ;
    :belongsTo :Chart .

