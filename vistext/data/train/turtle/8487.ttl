@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Gender distribution of journalists in print news media in the United States as of November 2017 , by news topic" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Male" .

:YAxis a :Axis ;
    :title "news topic" .

:DataPoint1 a :DataPoint ;
    :xValue "0.9" ;
    :yValue "Sports" ;
    :belongsTo :Chart .

