@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Adult home broadband penetration in the United States from 2000 to 2019 , by age group" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Month" .

:YAxis a :Axis ;
    :title "65+ years" .

:DataPoint1 a :DataPoint ;
    :xValue "Oct '01" ;
    :yValue "0.02" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Jun '05" ;
    :yValue "0.07" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "Aug '08" ;
    :yValue "0.34" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "Aug '11" ;
    :yValue "0.3" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "Sep '13" ;
    :yValue "0.41" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Jul '15" ;
    :yValue "0.48" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Nov '16" ;
    :yValue "0.51" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Jan '18" ;
    :yValue "0.5" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "Feb '19" ;
    :yValue "0.59" ;
    :belongsTo :Chart .
