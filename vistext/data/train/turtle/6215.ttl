@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Number of Starbucks stores in China from 2005 to 2019" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "licensed stores" .

:YAxis a :Axis ;
    :title "Year" .

:DataPoint1 a :DataPoint ;
    :xValue "0" ;
    :yValue "2019" ;
    :belongsTo :Chart .

