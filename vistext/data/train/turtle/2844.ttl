@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Citalopram out-of-pocket cost in the U.S. from 2004 to 2017 (in U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Out-of-pocket cost in U.S. dollars" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2003" ;
    :yValue "45.02" ;
    :belongsTo :Chart .

