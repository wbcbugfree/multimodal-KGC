@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Leading tea importing countries worldwide in 2019 (in million U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Trade value in million U.S. dollars" .

:YAxis a :Axis ;
    :title "Country" .

