@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Public sector expenditure on mining , manufacturing and construction in the United Kingdom (UK) from 2009/10 to 2019/20 (in million GBP)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Expenditure in million GBP" .

:DataPoint1 a :DataPoint ;
    :xValue "2019/20" ;
    :yValue "2179" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "2018/19" ;
    :yValue "2870" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "2017/18" ;
    :yValue "2222" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "2016/17" ;
    :yValue "858" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "2015/16" ;
    :yValue "168" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "2014/15" ;
    :yValue "39" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "2013/14" ;
    :yValue "273" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "2012/13" ;
    :yValue "-12" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "2011/12" ;
    :yValue "142" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "2010/11" ;
    :yValue "239" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "2009/10" ;
    :yValue "597" ;
    :belongsTo :Chart .
