@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Value of money market funds under management in the United Kingdom (UK) from October 2018 to October 2019 (in billion GBP)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Month" .

:YAxis a :Axis ;
    :title "Value in billion GBP" .

:DataPoint1 a :DataPoint ;
    :xValue "Oct 19" ;
    :yValue "24.02" ;
    :belongsTo :Chart .

