@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Global chemical fiber production from 2000 to 2019 , by fiber type (in 1,000 metric tons)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Total" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 1999" ;
    :yValue "31040" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Dec 31, 2009" ;
    :yValue "49600" ;
    :belongsTo :Chart .

