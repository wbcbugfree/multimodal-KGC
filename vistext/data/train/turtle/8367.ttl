    :yValue "60300" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Dec 31, 2013" ;
    :yValue "63300" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
