@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Number of Serie A football club supporters in Italy in the season 2019/2020 , by club (in 1,000s)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "football club" .

:YAxis a :Axis ;
    :title "Number of supporters in thousands" .

