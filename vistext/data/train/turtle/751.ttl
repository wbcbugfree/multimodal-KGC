@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Euro (EUR) to Swiss franc (CHF) average annual exchange rate from 1999 to 2019" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Exchange rate" .

