@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Leading financial advisors to M & A in Finland in 2016 , by deal value (in billion U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Deal value in billion U.S. dollar" .

:YAxis a :Axis ;
    :title "Financial Advisory Company" .

:DataPoint1 a :DataPoint ;
    :xValue "9.22" ;
    :yValue "Morgan Stanley" ;
    :belongsTo :Chart .

