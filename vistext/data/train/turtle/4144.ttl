@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Average regular season home attendance of the Chicago Cubs from 2009 to 2019" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Average attendance" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2008" ;
    :yValue "39610" ;
    :belongsTo :Chart .

