@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "The 25 fastest growing counties in the United States in 2018 , by change in population from 2010 to 2019" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "County in the United States" .

:YAxis a :Axis ;
    :title "Change in population" .

