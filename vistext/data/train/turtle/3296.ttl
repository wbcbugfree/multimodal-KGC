@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Dependency rate on energy imports in Italy from 2008 to 2018" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Energy imports dependency rate" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2007" ;
    :yValue "0.828" ;
    :belongsTo :Chart .

