@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Number of jobs in the travel and tourism sector in Cuba from 2010 to 2019 (in 1,000s)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Number of jobs in thousands" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2009" ;
    :yValue "541.7" ;
    :belongsTo :Chart .

