@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Share of internet users using mobile apps in Indonesia as of Q3 2019 , by category" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Share of internet users" .

:YAxis a :Axis ;
    :title "Response" .

:DataPoint1 a :DataPoint ;
    :xValue "0.96" ;
    :yValue "Chat apps (messenger)" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "0.96" ;
    :yValue "Social networking apps" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "0.83" ;
    :yValue "Entertainment or video apps" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "0.75" ;
    :yValue "Map apps" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "0.59" ;
    :yValue "Games (any types)" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "0.56" ;
    :yValue "Music apps" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "0.55" ;
    :yValue "Shopping apps" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "0.33" ;
    :yValue "Banking apps" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "0.2" ;
    :yValue "Heath and fitness apps" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "0.09" ;
    :yValue "Dating and friendship apps" ;
    :belongsTo :Chart .
