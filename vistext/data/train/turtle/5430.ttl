@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Value of dried fruit imported to the United Kingdom (UK) from 2001 to 2019 (in 1,000 GBP)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Import value in thousand GBP" .

