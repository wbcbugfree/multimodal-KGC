@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Share of total global big data revenue by segment in 2014" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Share of revenue" .

:YAxis a :Axis ;
    :title "Response" .

:DataPoint1 a :DataPoint ;
    :xValue "0.3823" ;
    :yValue "Professional Services" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "0.1873" ;
    :yValue "Compute" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "0.1626" ;
    :yValue "Storage" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "0.0758" ;
    :yValue "Apps and Analytics" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "0.0713" ;
    :yValue "SQL" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "0.0484" ;
    :yValue "Cloud Services" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "0.0341" ;
    :yValue "Data Management" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "0.0232" ;
    :yValue "Networking" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "0.0082" ;
    :yValue "NoSQL" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "0.0068" ;
    :yValue "Hadoop" ;
    :belongsTo :Chart .
