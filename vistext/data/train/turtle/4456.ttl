@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Electricity prices for households in Croatia from 2010 to 2019 , semi-annually (in euro cents per kilowatt hour)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Euro cents per kilowatt hour" .

:YAxis a :Axis ;
    :title "Year" .

