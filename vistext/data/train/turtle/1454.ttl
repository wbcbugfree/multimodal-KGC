@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Distribution of known recoverable resources of uranium worldwide in 2017 , by major country" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "Share of resources" .

