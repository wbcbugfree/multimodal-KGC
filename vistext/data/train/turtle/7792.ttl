@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Net income of U.S. and European medical technology companies from 2009 to 2019 (in billion U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "European companies" .

:YAxis a :Axis ;
    :title "Year" .

:DataPoint1 a :DataPoint ;
    :xValue "6.7" ;
    :yValue "2016*" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "5.6" ;
    :yValue "2015*" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "5.3" ;
    :yValue "2014*" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "5" ;
    :yValue "2013*" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "5.6" ;
    :yValue "2012*" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "6.2" ;
    :yValue "2011*" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "5.9" ;
    :yValue "2010*" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "4.3" ;
    :yValue "2009*" ;
    :belongsTo :Chart .
