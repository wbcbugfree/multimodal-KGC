    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "2011*" ;
    :yValue "2.472" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "2010*" ;
