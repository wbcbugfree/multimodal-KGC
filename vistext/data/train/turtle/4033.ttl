@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Private sector debt in the Netherlands as a percentage of GDP from 2006 to 2018" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Debt as percentage of GDP" .

:DataPoint1 a :DataPoint ;
    :xValue "2018*" ;
    :yValue "2.416" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "2017*" ;
    :yValue "2.491" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "2016*" ;
    :yValue "2.593" ;
    :belongsTo :Chart .

