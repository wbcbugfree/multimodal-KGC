@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "What business issues or factors drive your company 's information security spending ?" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Share of respondents" .

:YAxis a :Axis ;
    :title "Response" .

:DataPoint1 a :DataPoint ;
    :xValue "0.4159" ;
    :yValue "Economic conditions" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "0.2924" ;
    :yValue "Change and business transformation" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "0.3026" ;
    :yValue "Business continuity/ disaster recovery" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "0.2453" ;
    :yValue "Outsourcing" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "0.3022" ;
    :yValue "Company reputation" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "0.2955" ;
    :yValue "Regulatory compliance" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "0.2954" ;
    :yValue "Internal policy compliance" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "0.1638" ;
    :yValue "Hactivism" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "0.1279" ;
    :yValue "Intellectual property theft due to nation-state espionage" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "0.1667" ;
    :yValue "Criminal theft of customer or employee information" ;
    :belongsTo :Chart .
