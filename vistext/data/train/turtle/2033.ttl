@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Average net ingredient cost per pharmacy dispensing fee in England from 2006/07 to 2018/19 (in GBP)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Net ingredient cost per fee in GBP" .

:YAxis a :Axis ;
    :title "Year" .

:DataPoint1 a :DataPoint ;
    :xValue "7.45" ;
    :yValue "2018-19" ;
    :belongsTo :Chart .

