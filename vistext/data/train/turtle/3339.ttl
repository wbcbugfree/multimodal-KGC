@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Registered cases of battery and assault in Belgium from 2008 to 2019" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Cases of battery and assault" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2007" ;
    :yValue "76336" ;
    :belongsTo :Chart .

