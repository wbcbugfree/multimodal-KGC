@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Reasons for watching reality TV in the United States as of March 2017" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Share of respondents" .

:YAxis a :Axis ;
    :title "Response" .

:DataPoint1 a :DataPoint ;
    :xValue "0.18" ;
    :yValue "I like the drama" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "0.13" ;
    :yValue "It's mindless" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "0.13" ;
    :yValue "It helps me forget about real issues in my life/in the world" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "0.11" ;
    :yValue "It's good background noise" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "0.11" ;
    :yValue "It helps me stay informed about popular culture" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "0.06" ;
    :yValue "I'm invested" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "0.04" ;
    :yValue "To connect with likeminded viewers" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "0.06" ;
    :yValue "Other" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "0.46" ;
    :yValue "None of these" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "0.05" ;
    :yValue "Don't know" ;
    :belongsTo :Chart .
