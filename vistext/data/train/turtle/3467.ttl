@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Leading ten mobile craft baker shop operators ranked by number of mobile shops in the United Kingdom in 2013" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Number of mobile shops" .

:YAxis a :Axis ;
    :title "Leading ten mobile craft baker shop operators" .

:DataPoint1 a :DataPoint ;
    :xValue "22" ;
    :yValue "Cooplands (Doncaster)" ;
    :belongsTo :Chart .

