@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Population of Finland from 2009 to 2019 , by nationality" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Foreign" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2008" ;
    :yValue "155705" ;
    :belongsTo :Chart .

