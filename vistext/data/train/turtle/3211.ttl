@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Most valuable Italian brands in 2020 , by brand value (in million U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Brand" .

:YAxis a :Axis ;
    :title "Brand value in million U.S. dollars" .

:DataPoint1 a :DataPoint ;
    :xValue "Gucci" ;
    :yValue "15919" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Enel" ;
    :yValue "10654" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "Eni" ;
    :yValue "8414" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "Ferrari" ;
    :yValue "8175" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "Generali" ;
    :yValue "7345" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "TIM" ;
    :yValue "6582" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Poste Italiane Spa" ;
    :yValue "6055" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Intesa Sanpaolo Group" ;
    :yValue "5849" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "Prada" ;
    :yValue "3782" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "Ray-Ban" ;
    :yValue "3754" ;
    :belongsTo :Chart .
