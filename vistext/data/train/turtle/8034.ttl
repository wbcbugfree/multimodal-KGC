@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Maturity of mHealth markets in selected countries in 2012" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "Impact" .

:DataPoint1 a :DataPoint ;
    :xValue "South Africa" ;
    :yValue "6.2" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "India" ;
    :yValue "8.2" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "Brazil" ;
    :yValue "6.2" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "United States" ;
    :yValue "6.5" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "Spain" ;
    :yValue "4.3" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "China" ;
    :yValue "6.9" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Germany" ;
    :yValue "3.8" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "United Kingdom" ;
    :yValue "5.1" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "Turkey" ;
    :yValue "4.4" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "Denmark" ;
    :yValue "2.4" ;
    :belongsTo :Chart .
