@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Professional golfers with the most PGA Championship points in the 2020 season (in millions)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Golf Player" .

:YAxis a :Axis ;
    :title "Points in millions" .

:DataPoint1 a :DataPoint ;
    :xValue "Dustin Johnson" ;
    :yValue "6.99" ;
    :belongsTo :Chart .

