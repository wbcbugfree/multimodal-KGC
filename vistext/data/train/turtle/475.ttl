    :xValue "Vietnam" ;
    :yValue "2565.55" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Thailand" ;
    :yValue "2482.01" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Pakistan" ;
    :yValue "1537.68" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Cambodia" ;
    :yValue "1435.28" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "Bangladesh" ;
