@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Direct contribution of travel and tourism to employment in the Asia Pacific region in 2019 , by country (in 1,000s)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Country" .

:YAxis a :Axis ;
    :title "Number of jobs in thousands" .

:DataPoint1 a :DataPoint ;
    :xValue "China" ;
    :yValue "29088.7" ;
    :belongsTo :Chart .

