@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Most important issues facing women and girls in Mexico as of 2019" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Share of respondents" .

:YAxis a :Axis ;
    :title "Response" .

:DataPoint1 a :DataPoint ;
    :xValue "0.4" ;
    :yValue "Sexual harassment" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "0.37" ;
    :yValue "Sexual violence" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "0.32" ;
    :yValue "Physical violence" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "0.19" ;
    :yValue "Domestic abuse" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "0.19" ;
    :yValue "Equal pay" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "0.18" ;
    :yValue "Workplace discrimination" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "0.16" ;
    :yValue "Gender stereotyping" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "0.15" ;
    :yValue "Sexualization of women and girls in the media" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "0.09" ;
    :yValue "Access to employment" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "0.08" ;
    :yValue "Balancing work and caring responsibilities" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "0.07" ;
    :yValue "Lack of women in leadership roles in business and public life" ;
    :belongsTo :Chart .

:DataPoint12 a :DataPoint ;
    :xValue "0.07" ;
    :yValue "Abuse on social media" ;
    :belongsTo :Chart .

:DataPoint13 a :DataPoint ;
    :xValue "0.06" ;
    :yValue "Support for pregnant women and new mothers" ;
    :belongsTo :Chart .

:DataPoint14 a :DataPoint ;
    :xValue "0.06" ;
    :yValue "The amount of unpaid work that women do (e.g. cooking, cleaning, childcare)" ;
    :belongsTo :Chart .

:DataPoint15 a :DataPoint ;
    :xValue "0.05" ;
    :yValue "Lack of financial/economic independence" ;
    :belongsTo :Chart .
