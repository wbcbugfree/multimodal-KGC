@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Revenue of the digital music industry in Spain between 2014 and 2018 and forecast from 2019 to 2023 (in million euros)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Mobile music" .

:DataPoint1 a :DataPoint ;
    :xValue "2023*" ;
    :yValue "2" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "2022*" ;
    :yValue "3" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "2021*" ;
    :yValue "3" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "2020*" ;
    :yValue "4" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "2019*" ;
    :yValue "4" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "2018" ;
    :yValue "4" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "2017" ;
    :yValue "4" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "2016" ;
    :yValue "3" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "2015" ;
    :yValue "2" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "2014" ;
    :yValue "1" ;
    :belongsTo :Chart .
