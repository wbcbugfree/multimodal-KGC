@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Average cost per click (CPC) on Facebook in selected countries as of 4th quarter 2017 (in U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Country" .

:YAxis a :Axis ;
    :title "CPC in U.S. dollars" .

:DataPoint1 a :DataPoint ;
    :xValue "Czech Republic" ;
    :yValue "2.09" ;
    :belongsTo :Chart .

