@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Favorite soccer team from the English Premier League among fans in the United States as of July 2019" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "Share of respondents" .

