@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Confirmed coronavirus (COVID-19) cases in South Africa as of January 06 , 2021 , by region" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Number of cases" .

:YAxis a :Axis ;
    :title "province of South Africa" .

:DataPoint1 a :DataPoint ;
    :xValue "1149591" ;
    :yValue "Total" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "310201" ;
    :yValue "Gauteng" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "230283" ;
    :yValue "KwaZulu-Natal" ;
    :belongsTo :Chart .

