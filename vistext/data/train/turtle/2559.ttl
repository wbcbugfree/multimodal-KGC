    :xValue "227654" ;
    :yValue "Western Cape" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "175941" ;
    :yValue "Eastern Cape" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "64409" ;
    :yValue "Free State" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "43159" ;
    :yValue "North West" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "40751" ;
    :yValue "Mpumalanga" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
