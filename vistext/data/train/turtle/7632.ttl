@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Impact of the coronavirus (COVID-19) outbreak on the labor market indicators in Romania from October 2019 to September 2020" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Month" .

:YAxis a :Axis ;
    :title "Unemployment" .

:DataPoint1 a :DataPoint ;
    :xValue "Sep '20" ;
    :yValue "0.052" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Aug '20" ;
    :yValue "0.053" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "Jul '20" ;
    :yValue "0.054" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "Jun '20" ;
    :yValue "0.053" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "May '20" ;
    :yValue "0.052" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Apr '20" ;
    :yValue "0.048" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Mar '20" ;
    :yValue "0.046" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Feb '20" ;
    :yValue "0.039" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "Jan '20" ;
    :yValue "0.039" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "Dec '19" ;
    :yValue "0.04" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "Nov '19" ;
    :yValue "0.04" ;
    :belongsTo :Chart .

:DataPoint12 a :DataPoint ;
    :xValue "Oct '19" ;
    :yValue "0.039" ;
    :belongsTo :Chart .
