@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Average price for a full set of acrylics (sculpt or tips) at nail salons in the United States from 2006 to 2019 (in U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Average price in U.S. dollars" .

