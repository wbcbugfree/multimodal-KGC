@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Forecast volume of soybean oil produced in the European Union (EU 27) from 2015 to 2028 (in 1,000 tonnes)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Volume in thousand tonnes" .

:YAxis a :Axis ;
    :title "Year" .

:DataPoint1 a :DataPoint ;
    :xValue "3662" ;
    :yValue "2028*" ;
    :belongsTo :Chart .

