@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Number of deaths in Iraq due to terrorism between 2006 and 2018" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Number of deaths" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2005" ;
    :yValue "13296" ;
    :belongsTo :Chart .

