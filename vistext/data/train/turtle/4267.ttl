@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Total number of live births in the Netherlands from 2008 to 2018" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Number of births" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2007" ;
    :yValue "184634" ;
    :belongsTo :Chart .

