@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Seat capacity in the airline industry in the week of May 06 , 2019 , by region (in millions)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "geographic region" .

:YAxis a :Axis ;
    :title "Number of seats in millions" .

