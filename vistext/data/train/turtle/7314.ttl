@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Marriage rate in Great Britain from 2000 to 2011" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Scotland***" .

:YAxis a :Axis ;
    :title "Year" .

:DataPoint1 a :DataPoint ;
    :xValue "26.6" ;
    :yValue "2008" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "28" ;
    :yValue "2007" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "28.7" ;
    :yValue "2006" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "30.3" ;
    :yValue "2005" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "32.1" ;
    :yValue "2004" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "31.3" ;
    :yValue "2003" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "30.8" ;
    :yValue "2002" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "31" ;
    :yValue "2001" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "31.6" ;
    :yValue "2000" ;
    :belongsTo :Chart .
