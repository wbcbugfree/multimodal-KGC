@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Boston Red Sox all-time home run leaders as of October 2020" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Home run leader" .

:YAxis a :Axis ;
    :title "Number of home runs" .

:DataPoint1 a :DataPoint ;
    :xValue "Ted Williams" ;
    :yValue "521" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "David Ortiz" ;
    :yValue "483" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "Carl Yastrzemski" ;
    :yValue "452" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "Jim Rice" ;
    :yValue "382" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "Dwight Evans" ;
    :yValue "379" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Manny Ramirez" ;
    :yValue "274" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Mo Vaughn" ;
    :yValue "230" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Bobby Doerr" ;
    :yValue "223" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "Jimmie Foxx" ;
    :yValue "222" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "Rico Petrocelli" ;
    :yValue "210" ;
    :belongsTo :Chart .
