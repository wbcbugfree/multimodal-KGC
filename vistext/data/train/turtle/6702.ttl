@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Number of bankruptcies after the coronavirus outbreak in Sweden from February to November 2020 , by industry" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Month" .

:YAxis a :Axis ;
    :title "Transportation" .

:DataPoint1 a :DataPoint ;
    :xValue "Feb" ;
    :yValue "35" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Mar" ;
    :yValue "43" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "Apr" ;
    :yValue "34" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "May" ;
    :yValue "36" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "Jun" ;
    :yValue "30" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Jul" ;
    :yValue "16" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Aug" ;
    :yValue "24" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Sep" ;
    :yValue "26" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "Oct" ;
    :yValue "31" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "Nov" ;
    :yValue "34" ;
    :belongsTo :Chart .
