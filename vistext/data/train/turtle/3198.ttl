@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Number of wage , salary and commission workers in Canada in 2018 , by province" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Number of taxfilers" .

:YAxis a :Axis ;
    :title "province of Canada" .

:DataPoint1 a :DataPoint ;
    :xValue "7129290" ;
    :yValue "Ontario" ;
    :belongsTo :Chart .

