@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Leading television programs by target audience share in the Netherlands in November 2020" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "television program" .

:YAxis a :Axis ;
    :title "Target audience share" .

:DataPoint1 a :DataPoint ;
    :xValue "Journaal Extra (November 3)" ;
    :yValue "0.281" ;
    :belongsTo :Chart .

