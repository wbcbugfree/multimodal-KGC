@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Leading countries based on annual cobalt refinery capacity as of 2017 (in metric tons)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Country" .

:YAxis a :Axis ;
    :title "Annual refinery capacity in metric tons" .

:DataPoint1 a :DataPoint ;
    :xValue "China**" ;
    :yValue "100000" ;
    :belongsTo :Chart .

