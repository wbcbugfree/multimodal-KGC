@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Bayern Munich revenue by stream from 2008/09 to 2018/19 (in million euros)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Season" .

:YAxis a :Axis ;
    :title "Broadcasting" .

:DataPoint1 a :DataPoint ;
    :xValue "2018/19" ;
    :yValue "211.2" ;
    :belongsTo :Chart .

