@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "CAGR of leading online marketplaces worldwide from 2019 to 2021" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Revenue" .

:YAxis a :Axis ;
    :title "leading online marketplaces" .

:DataPoint1 a :DataPoint ;
    :xValue "0.13" ;
    :yValue "Uber (United States)" ;
    :belongsTo :Chart .

