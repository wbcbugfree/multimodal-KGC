@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Average spending per consumer on selected music activities in the United States as of July 2018" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "$20 to $39.99" .

:YAxis a :Axis ;
    :title "Response" .

:DataPoint1 a :DataPoint ;
    :xValue "0.08" ;
    :yValue "Tickets for music concerts/gigs" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "0.1" ;
    :yValue "Tickets for festivals" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "0.26" ;
    :yValue "Music merchandise items" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "0.29" ;
    :yValue "Vinyl albums" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "0.28" ;
    :yValue "Pre-paid music voucher" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "0.24" ;
    :yValue "Music streaming subscription gift cards" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "0.23" ;
    :yValue "CD albums/singles" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "0.21" ;
    :yValue "Music DVDs" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "0.18" ;
    :yValue "MP3/download albums" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "0.05" ;
    :yValue "Vinyl singles" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "0.11" ;
    :yValue "MP3/download singles/tracks" ;
    :belongsTo :Chart .
