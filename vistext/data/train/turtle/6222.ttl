@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Borussia Dortmund brand/team value from 2011 to 2020 (in million U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Enterprise value (KPMG)" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2010" ;
    :yValue "0" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Dec 31, 2011" ;
    :yValue "0" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "Dec 31, 2012" ;
    :yValue "0" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "Dec 31, 2013" ;
    :yValue "0" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "Dec 31, 2014" ;
    :yValue "0" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Dec 31, 2015" ;
    :yValue "905" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Dec 31, 2016" ;
    :yValue "1017" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Dec 31, 2017" ;
    :yValue "1277" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "Dec 31, 2018" ;
    :yValue "1236" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "Dec 31, 2019" ;
    :yValue "1434" ;
    :belongsTo :Chart .
