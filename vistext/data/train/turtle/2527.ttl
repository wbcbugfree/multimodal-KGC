@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Total commercial motor insurance expenses in the United Kingdom (UK) from 2007 to 2018 (in million GBP)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "In million GBP" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2006" ;
    :yValue "2591" ;
    :belongsTo :Chart .

