@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Number of new house sales in the United States from 2000 to 2019 , by financing type (in thousands)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Conventional" .

