@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Volume of wine produced in European wine producing countries in 2018 (in million hectoliters)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Country" .

:YAxis a :Axis ;
    :title "Volume in million hectoliters" .

:DataPoint1 a :DataPoint ;
    :xValue "Italy" ;
    :yValue "48.5" ;
    :belongsTo :Chart .

