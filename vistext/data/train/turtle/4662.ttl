@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Economic damage caused by floods and flash floods in the U.S. from 1995 to 2019 (in million U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Damage in million U.S. dollars" .

