@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Number of employees at Total S.A. from 2008 to 2019" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Number of employees" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2007" ;
    :yValue "96959" ;
    :belongsTo :Chart .

