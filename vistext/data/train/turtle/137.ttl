@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Faurecia 's global OEM automotive parts sales from 2001 to 2019 (in million U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Sales in million U.S. dollars" .

