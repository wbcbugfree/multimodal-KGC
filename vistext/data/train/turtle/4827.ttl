@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Electricity generation through independent power producers in the U.S. from 2005 to 2019 (in million megawatt hours)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Net generation in million megawatt hours" .

