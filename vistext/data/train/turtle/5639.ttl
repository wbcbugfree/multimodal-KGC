@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Sales value of beer in Alberta from 2009/10 to 2018/19 (in million Canadian dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Sales in million Canadian dollars" .

:YAxis a :Axis ;
    :title "Year" .

:DataPoint1 a :DataPoint ;
    :xValue "1028.91" ;
    :yValue "2018/19" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "1061.56" ;
    :yValue "2017/18" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "1061.17" ;
    :yValue "2016/17" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "1127.16" ;
    :yValue "2015/16" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "1103.27" ;
    :yValue "2014/15" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "1055.01" ;
    :yValue "2013/14" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "1002.56" ;
    :yValue "2012/13" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "959.65" ;
    :yValue "2011/12" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "896.57" ;
    :yValue "2010/11" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "946.54" ;
    :yValue "2009/10" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "921.16" ;
    :yValue "2008/09" ;
    :belongsTo :Chart .
