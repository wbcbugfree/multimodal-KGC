@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Value of exports of goods in Sweden from November 2019 to November 2020 (in million SEK)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Value of exports in million SEK" .

:YAxis a :Axis ;
    :title "Month" .

:DataPoint1 a :DataPoint ;
    :xValue "128000" ;
    :yValue "Nov 20" ;
    :belongsTo :Chart .

