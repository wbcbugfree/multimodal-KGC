@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Number of enterprises in the manufacture of soft drinks , production of mineral waters and other bottled waters industry in Croatia from 2008 to 2016" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Number of enterprises" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2007" ;
    :yValue "99" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Dec 31, 2008" ;
    :yValue "99" ;
    :belongsTo :Chart .

