@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Number of people in the U.S. who used marijuana in the past month from 2009 to 2019 (in 1,000)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Number of people in thousands" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2008" ;
    :yValue "16826" ;
    :belongsTo :Chart .

