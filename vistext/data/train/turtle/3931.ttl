@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Ranking of the efficiency of contract enforcement by selected country in 2009" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Ranking position" .

:YAxis a :Axis ;
    :title "Country" .

:DataPoint1 a :DataPoint ;
    :xValue "1" ;
    :yValue "Luxembourg" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "2" ;
    :yValue "Iceland" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "3" ;
    :yValue "Hong Kong" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "4" ;
    :yValue "Norway" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "5" ;
    :yValue "South Korea" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "6" ;
    :yValue "France" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "7" ;
    :yValue "Germany" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "8" ;
    :yValue "USA" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "18" ;
    :yValue "China" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "20" ;
    :yValue "Japan" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "23" ;
    :yValue "Great Britain" ;
    :belongsTo :Chart .
