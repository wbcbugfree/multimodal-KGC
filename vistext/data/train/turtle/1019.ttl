@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Number of recreational visitors to the Gulf Islands National Seashore in the United States from 2008 to 2019 (in millions)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Number of visitors in millions" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2007" ;
    :yValue "2.05" ;
    :belongsTo :Chart .

