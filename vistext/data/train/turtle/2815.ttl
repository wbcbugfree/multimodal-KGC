    :xValue "185.1" ;
    :yValue "United Kingdom" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "427.6" ;
    :yValue "Other European Union" ;
    :belongsTo :Chart .

