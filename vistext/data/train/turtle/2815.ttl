@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Number of outbound trips from Portugal in 2019 , by destination (in 1,000s)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Number of trips in thousands" .

:YAxis a :Axis ;
    :title "Country" .

:DataPoint1 a :DataPoint ;
    :xValue "2345.8" ;
    :yValue "European Union total" ;
    :belongsTo :Chart .

