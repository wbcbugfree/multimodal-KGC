@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Digital services ranked by usage to consume or share digital content in the United Kingdom (UK) as of May 2018" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Share of respondents" .

:YAxis a :Axis ;
    :title "Response" .

:DataPoint1 a :DataPoint ;
    :xValue "0.54" ;
    :yValue "YouTube" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "0.43" ;
    :yValue "NET: Any Amazon service" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "0.38" ;
    :yValue "Amazon / Amazon MP3 / Kindle / Amazon Prime" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "0.38" ;
    :yValue "Netflix" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "0.31" ;
    :yValue "BBC iPlayer" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "0.27" ;
    :yValue "NET: Any Apple service" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "0.27" ;
    :yValue "Spotify" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "0.22" ;
    :yValue "Google (search engine)" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "0.21" ;
    :yValue "Facebook" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "0.18" ;
    :yValue "iTunes / App Store" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "0.14" ;
    :yValue "Email" ;
    :belongsTo :Chart .

:DataPoint12 a :DataPoint ;
    :xValue "0.13" ;
    :yValue "ITV Hub / ITV Player" ;
    :belongsTo :Chart .

:DataPoint13 a :DataPoint ;
    :xValue "0.11" ;
    :yValue "Sky Go" ;
    :belongsTo :Chart .
