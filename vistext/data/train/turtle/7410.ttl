    :belongsTo :Chart .

:DataPoint13 a :DataPoint ;
    :xValue "6.62" ;
    :yValue "1955-1960" ;
    :belongsTo :Chart .

:DataPoint14 a :DataPoint ;
    :xValue "6.57" ;
    :yValue "1950-1955" ;
