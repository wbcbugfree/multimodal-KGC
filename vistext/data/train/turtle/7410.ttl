@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Fertility rate in each continent and worldwide , from 1950 to 2020" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Africa" .

:YAxis a :Axis ;
    :title "Year" .

:DataPoint1 a :DataPoint ;
    :xValue "4.44" ;
    :yValue "2015-2020" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "4.73" ;
    :yValue "2010-2015" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "4.9" ;
    :yValue "2005-2010" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "5.08" ;
    :yValue "2000-2005" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "5.35" ;
    :yValue "1995-2000" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "5.72" ;
    :yValue "1990-1995" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "6.19" ;
    :yValue "1985-1990" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "6.5" ;
    :yValue "1980-1985" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "6.64" ;
    :yValue "1975-1980" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "6.7" ;
    :yValue "1970-1975" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "6.71" ;
