@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "U.S. confidence levels in politics , the press , business , public institutions and other organizations in 2020" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "None" .

:DataPoint1 a :DataPoint ;
    :xValue "The military" ;
    :yValue "0.01" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Small business" ;
    :yValue "0" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "The church or organized religion" ;
    :yValue "0.03" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "The police" ;
    :yValue "0.02" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "The presidency" ;
    :yValue "0.05" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "The medical system" ;
    :yValue "0.01" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "The U.S. Supreme Court" ;
    :yValue "0.01" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Public schools" ;
    :yValue "0.02" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "Banks" ;
    :yValue "0.01" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "Large technology companies" ;
    :yValue "0.03" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "Organized labor" ;
    :yValue "0.01" ;
    :belongsTo :Chart .

:DataPoint12 a :DataPoint ;
    :xValue "Newspapers" ;
    :yValue "0.04" ;
    :belongsTo :Chart .

:DataPoint13 a :DataPoint ;
    :xValue "The criminal justice system" ;
    :yValue "0.03" ;
    :belongsTo :Chart .

:DataPoint14 a :DataPoint ;
    :xValue "Television news" ;
    :yValue "0.06" ;
    :belongsTo :Chart .

:DataPoint15 a :DataPoint ;
    :xValue "Big business" ;
    :yValue "0.03" ;
    :belongsTo :Chart .

:DataPoint16 a :DataPoint ;
    :xValue "Congress" ;
    :yValue "0.04" ;
    :belongsTo :Chart .
