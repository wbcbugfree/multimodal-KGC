@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Annual change in number of United States residents traveling to Mexico from 2002 to 2019" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Year-over-year change" .

:DataPoint1 a :DataPoint ;
    :xValue "2019*" ;
    :yValue "0.093" ;
    :belongsTo :Chart .

