@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "New Zealand : Distribution of employment by economic sector from 2010 to 2020" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Industry" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2009" ;
    :yValue "0.2064" ;
    :belongsTo :Chart .

