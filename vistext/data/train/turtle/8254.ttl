@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Most popular social networks of teenagers in the United States from fall 2012 to fall 2020" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Fall 2017" .

:YAxis a :Axis ;
    :title "Response" .

:DataPoint1 a :DataPoint ;
    :xValue "0.47" ;
    :yValue "Snapchat" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "0.24" ;
    :yValue "Instagram" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "0.07" ;
    :yValue "Twitter" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "0.09" ;
    :yValue "Facebook" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "0.01" ;
    :yValue "Pinterest" ;
    :belongsTo :Chart .
