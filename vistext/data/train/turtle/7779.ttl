@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Distribution of the child population in the U.S. from 2000 to 2019 , by race and Hispanic origin" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Asian" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 1999" ;
    :yValue "0.035" ;
    :belongsTo :Chart .

