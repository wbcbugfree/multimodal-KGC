@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Approval rates of presidents in office in El Salvador from 2002 to 2018" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Approval rate" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2001" ;
    :yValue "0.35" ;
    :belongsTo :Chart .

