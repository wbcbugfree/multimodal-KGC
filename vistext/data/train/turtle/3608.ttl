@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Most-followed Spanish food accounts on Instagram in December 2019" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Number of followers" .

:YAxis a :Axis ;
    :title "Most-followed Spanish food accounts" .

:DataPoint1 a :DataPoint ;
    :xValue "499717" ;
    :yValue "Samantha Vallejo-Nájera (samyspain)" ;
    :belongsTo :Chart .

