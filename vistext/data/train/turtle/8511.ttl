@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Employment rate in major developed countries from Q2 2016 to Q2 2020" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "United States" .

:YAxis a :Axis ;
    :title "Quarter" .

