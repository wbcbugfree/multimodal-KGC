@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Total rate of COVID-19 deaths compared to deaths among long-term care residents in select countries worldwide as of May 2020 (per million population)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Number of LTC deaths per million population" .

:YAxis a :Axis ;
    :title "Country" .

:DataPoint1 a :DataPoint ;
    :xValue "1" ;
    :yValue "Australia" ;
    :belongsTo :Chart .

