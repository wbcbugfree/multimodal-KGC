@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "How do you expect COVID-19 to impact your spending for any of the following ?" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "Decrease" .

:DataPoint1 a :DataPoint ;
    :xValue "Cybersecurity" ;
    :yValue "0.03" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Hybrid or multi-cloud" ;
    :yValue "0.07" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "Automation" ;
    :yValue "0.13" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "Smart analytics" ;
    :yValue "0.11" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "AI" ;
    :yValue "0.15" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "5G" ;
    :yValue "0.1" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Edge computing" ;
    :yValue "0.12" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "IoT" ;
    :yValue "0.16" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "AR/VR" ;
    :yValue "0.22" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "Blockchain" ;
    :yValue "0.24" ;
    :belongsTo :Chart .
