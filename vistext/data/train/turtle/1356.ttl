@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Number of house fires caused by burning Christmas trees in the United States from 2000 to 2015" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Number of fires" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 1999" ;
    :yValue "380" ;
    :belongsTo :Chart .

