@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Most common names among female babies born in Italy in 2018" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Common female names" .

:YAxis a :Axis ;
    :title "Number of female babies" .

:DataPoint1 a :DataPoint ;
    :xValue "Sofia" ;
    :yValue "6400" ;
    :belongsTo :Chart .

