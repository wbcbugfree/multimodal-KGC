@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Estimated production volume of spices across India in financial year 2020 , by state (in 1,000 metric tons)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "state of India" .

:YAxis a :Axis ;
    :title "Production in thousand metric tons" .

:DataPoint1 a :DataPoint ;
    :xValue "Madhya Pradesh" ;
    :yValue "3010.17" ;
    :belongsTo :Chart .

