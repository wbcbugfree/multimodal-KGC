@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "China 's cotton mill use from 1990 to 2017 (in 1,000 bales)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Mill use in thousand 480-pound bales" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 1989" ;
    :yValue "20000" ;
    :belongsTo :Chart .

