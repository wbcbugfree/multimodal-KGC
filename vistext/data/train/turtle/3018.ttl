    :yValue "55.79" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Dec 31, 2012" ;
    :yValue "56.2" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
