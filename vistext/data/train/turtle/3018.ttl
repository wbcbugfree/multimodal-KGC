@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "South Sudan : Life expectancy at birth from 2008 to 2018" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Life expectancy at birth in years" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2007" ;
    :yValue "53.6" ;
    :belongsTo :Chart .

