@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Percentage of people who identify with a political party in Great Britain (GB) from 1997 to 2012 , by party" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Liberal Democrat" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 1996" ;
    :yValue "0.1" ;
    :belongsTo :Chart .

