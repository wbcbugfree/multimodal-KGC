@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Number of families in the United States by number of children under 18 living in the household from 2000 to 2020 (in 1,000s)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "No children" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 1999" ;
    :yValue "37420" ;
    :belongsTo :Chart .

