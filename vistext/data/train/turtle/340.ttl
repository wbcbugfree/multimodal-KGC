@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Market share of leading health insurance companies in the United States in 2019 , by direct premiums written" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Market share" .

:YAxis a :Axis ;
    :title "Health insurance company" .

:DataPoint1 a :DataPoint ;
    :xValue "0.141" ;
    :yValue "UnitedHealth Group Inc." ;
    :belongsTo :Chart .

