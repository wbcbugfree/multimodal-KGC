@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Leading markets based on Tinder iOS revenue in 3rd quarter 2020 (in million U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Country" .

:YAxis a :Axis ;
    :title "Revenue in million U.S. dollars" .

:DataPoint1 a :DataPoint ;
    :xValue "United States" ;
    :yValue "11.07" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Germany" ;
    :yValue "4.2" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "Brazil" ;
    :yValue "3.45" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "Netherlands" ;
    :yValue "2.26" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "United Kingdom" ;
    :yValue "2.01" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Canada" ;
    :yValue "1.95" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Australia" ;
    :yValue "1.21" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Switzerland" ;
    :yValue "1.09" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "France" ;
    :yValue "1.06" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "UAE" ;
    :yValue "1.05" ;
    :belongsTo :Chart .
