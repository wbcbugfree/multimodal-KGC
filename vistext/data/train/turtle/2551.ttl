@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Leading brands for best customer experience online , ranked by consumers in the United Kingdom (UK) in 2014" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "Share of respondents" .

:DataPoint1 a :DataPoint ;
    :xValue "Amazon (.co.uk)" ;
    :yValue "0.759" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Ebay" ;
    :yValue "0.426" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "Argos" ;
    :yValue "0.385" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "Tesco" ;
    :yValue "0.317" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "Marks & Spencer" ;
    :yValue "0.232" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "John Lewis" ;
    :yValue "0.216" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Asda" ;
    :yValue "0.198" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Next" ;
    :yValue "0.163" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "Sainsbury's" ;
    :yValue "0.139" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "Boots" ;
    :yValue "0.138" ;
    :belongsTo :Chart .
