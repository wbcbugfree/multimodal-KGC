@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Expenditure on research and development (R & D) of Syngenta AG worldwide from 2009 to 2019 (in million U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Expenditure in million U.S. dollars" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2008" ;
    :yValue "952" ;
    :belongsTo :Chart .

