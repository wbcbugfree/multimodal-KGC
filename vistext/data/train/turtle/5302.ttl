@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Total number of employees of the Richemont Group worldwide from FY2011 to FY2020" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Number of employees" .

:YAxis a :Axis ;
    :title "Year" .

:DataPoint1 a :DataPoint ;
    :xValue "35657" ;
    :yValue "2020" ;
    :belongsTo :Chart .

