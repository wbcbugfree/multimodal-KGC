    :yValue "2016" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "28324" ;
    :yValue "2015" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "26786" ;
    :yValue "2014*" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "27666" ;
