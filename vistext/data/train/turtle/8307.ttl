@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Forecast of population growth in Iceland from 2020 to 2030 , by age group" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "80 years and older" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2020" ;
    :yValue "12804" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Dec 31, 2021" ;
    :yValue "13020" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "Dec 31, 2022" ;
    :yValue "13422" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "Dec 31, 2023" ;
    :yValue "13885" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "Dec 31, 2024" ;
    :yValue "14413" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Dec 31, 2025" ;
    :yValue "15074" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Dec 31, 2026" ;
    :yValue "15708" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Dec 31, 2027" ;
    :yValue "16448" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "Dec 31, 2028" ;
    :yValue "17274" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "Dec 31, 2029" ;
    :yValue "18084" ;
    :belongsTo :Chart .
