@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Most popular types of camping trip in North America in 2015" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Share of respondents" .

:YAxis a :Axis ;
    :title "Response" .

:DataPoint1 a :DataPoint ;
    :xValue "0.54" ;
    :yValue "Weekend getaways" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "0.51" ;
    :yValue "A family vacation" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "0.37" ;
    :yValue "Recreation*" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "0.27" ;
    :yValue "Visiting friends or relatives" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "0.14" ;
    :yValue "Back country" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "0.14" ;
    :yValue "A reunion or group event" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "0.1" ;
    :yValue "Shopping" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "0.1" ;
    :yValue "Traveling cross-country" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "0.07" ;
    :yValue "Church/city group camp" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "0.07" ;
    :yValue "Casino/gambling" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "0.06" ;
    :yValue "Summer camps**" ;
    :belongsTo :Chart .

:DataPoint12 a :DataPoint ;
    :xValue "0.07" ;
    :yValue "Sporting events" ;
    :belongsTo :Chart .

:DataPoint13 a :DataPoint ;
    :xValue "0.06" ;
    :yValue "Bike events" ;
    :belongsTo :Chart .

:DataPoint14 a :DataPoint ;
    :xValue "0.05" ;
    :yValue "Boy scouts" ;
    :belongsTo :Chart .

:DataPoint15 a :DataPoint ;
    :xValue "0.05" ;
    :yValue "Child-related events***" ;
    :belongsTo :Chart .

:DataPoint16 a :DataPoint ;
