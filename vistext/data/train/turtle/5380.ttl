@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Households savings rate in France from 2010 to 2017" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Savings rate" .

:DataPoint1 a :DataPoint ;
    :xValue "2019" ;
    :yValue "0.147" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "2018" ;
    :yValue "0.139" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "2017" ;
    :yValue "0.14" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "2016" ;
    :yValue "0.14" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "2015" ;
    :yValue "0.145" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "2014*" ;
    :yValue "0.144" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "2013*" ;
    :yValue "0.143" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "2012" ;
    :yValue "0.151" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "2011" ;
    :yValue "0.156" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "2010" ;
    :yValue "0.158" ;
    :belongsTo :Chart .
