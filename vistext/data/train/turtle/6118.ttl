@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Global smartwatch unit shipments by vendor from the 2Q ' 14 to 1Q ' 20 (in millions)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Apple" .

:YAxis a :Axis ;
    :title "quarter" .

