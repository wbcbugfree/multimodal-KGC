@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Distribution of electricity generation in the United States from 2007 to 2019 , by fuel type" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Natural gas" .

:DataPoint1 a :DataPoint ;
    :xValue "2019*" ;
    :yValue "0.38" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "2018" ;
    :yValue "0.35" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "2017" ;
    :yValue "0.32" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "2016" ;
    :yValue "0.34" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "2015" ;
    :yValue "0.33" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "2014" ;
    :yValue "0.28" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "2013" ;
    :yValue "0.28" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "2012" ;
    :yValue "0.31" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "2011" ;
    :yValue "0.25" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "2010" ;
    :yValue "0.24" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "2009" ;
    :yValue "0.24" ;
    :belongsTo :Chart .

:DataPoint12 a :DataPoint ;
    :xValue "2008" ;
    :yValue "0.22" ;
    :belongsTo :Chart .

:DataPoint13 a :DataPoint ;
    :xValue "2007" ;
    :yValue "0.22" ;
    :belongsTo :Chart .
