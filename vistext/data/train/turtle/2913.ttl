@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Gross nuclear electricity generation across India from financial year 2010 to 2020 (in billion kilowatt hours)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Electricity generation in billion kilowatt hours" .

:YAxis a :Axis ;
    :title "Year" .

:DataPoint1 a :DataPoint ;
    :xValue "46.38" ;
    :yValue "FY 2020" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "37.7" ;
    :yValue "FY 2019" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "38.35" ;
    :yValue "FY 2018" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "37.7" ;
    :yValue "FY 2017" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "37.4" ;
    :yValue "FY 2016" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "36.1" ;
    :yValue "FY 2015" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "34.2" ;
    :yValue "FY 2014" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "32.9" ;
    :yValue "FY 2013" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "32.3" ;
    :yValue "FY 2012" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "26.3" ;
    :yValue "FY 2011" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "18.6" ;
    :yValue "FY 2010" ;
    :belongsTo :Chart .
