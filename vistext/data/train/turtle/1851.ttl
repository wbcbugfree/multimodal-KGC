@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Percentage of methamphetamine purity in the U.S. from 2012 to 2018" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "Percentage of purity" .

