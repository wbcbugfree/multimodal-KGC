@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Percentage of weekly household expenditure going on games , toys and hobbies in the United Kingdom (UK) in 2019 , by disposable income decile group" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Share of spending" .

:YAxis a :Axis ;
    :title "Response" .

:DataPoint1 a :DataPoint ;
    :xValue "0.003" ;
    :yValue "Lowest ten per cent" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "0.006" ;
    :yValue "Second decile group" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "0.004" ;
    :yValue "Third decile group" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "0.005" ;
    :yValue "Fourth decile group" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "0.006" ;
    :yValue "Fifth decile group" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "0.005" ;
    :yValue "Sixth decile group" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "0.008" ;
    :yValue "Seventh decile group" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "0.005" ;
    :yValue "Eighth decile group" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "0.004" ;
    :yValue "Ninth decile group" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "0.004" ;
    :yValue "Highest ten per cent" ;
    :belongsTo :Chart .
