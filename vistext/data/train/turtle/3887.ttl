@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Number of elliptical motion trainer users in the United States from 2007 to 2017 (in millions)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Number of users in millions" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2006" ;
    :yValue "23.59" ;
    :belongsTo :Chart .

