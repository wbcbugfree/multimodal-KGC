@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Average price of diesel fuel in France between January 2013 and December 2018 (in euros per liter)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "2016" .

:YAxis a :Axis ;
    :title "Month" .

:DataPoint1 a :DataPoint ;
    :xValue "1.18" ;
    :yValue "Dec" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "1.24" ;
    :yValue "Nov" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "1.25" ;
    :yValue "Oct" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "1.19" ;
    :yValue "Sep" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "1.16" ;
    :yValue "Aug" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "1.21" ;
    :yValue "Jul" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "1.21" ;
    :yValue "Jun" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "1.07" ;
    :yValue "May" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "1.28" ;
    :yValue "Apr" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "1.13" ;
    :yValue "Mar" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "1.08" ;
    :yValue "Feb" ;
    :belongsTo :Chart .

:DataPoint12 a :DataPoint ;
    :xValue "1.1" ;
    :yValue "Jan" ;
    :belongsTo :Chart .
