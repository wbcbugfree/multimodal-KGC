@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Market share of the most used browser versions in Germany in October 2020" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "Share of page views" .

:DataPoint1 a :DataPoint ;
    :xValue "Chrome 86.0" ;
    :yValue "0.2" ;
    :belongsTo :Chart .

