@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Women 's singles US Open tennis tournaments won from 1968 to 2020" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Number of US Open titles" .

:YAxis a :Axis ;
    :title "female professional tennis players" .

:DataPoint1 a :DataPoint ;
    :xValue "6" ;
    :yValue "Serena Williams" ;
    :belongsTo :Chart .

