@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Life expectancy at birth for Newfoundland and Labrador from 2005 to 2018" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Newfoundland and Labrador" .

:DataPoint1 a :DataPoint ;
    :xValue "2016-2018" ;
    :yValue "79.8" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "2015-2017" ;
    :yValue "79.6" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "2014-2016" ;
    :yValue "79.4" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "2013-2015" ;
    :yValue "79.3" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "2012-2014" ;
    :yValue "79.4" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "2011-2013" ;
    :yValue "79.6" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "2010-2012" ;
    :yValue "79.6" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "2009-2011" ;
    :yValue "79.6" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "2008-2010" ;
    :yValue "79.3" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "2007-2009" ;
    :yValue "79" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "2006-2008" ;
    :yValue "78.5" ;
    :belongsTo :Chart .

:DataPoint12 a :DataPoint ;
    :xValue "2005-2007" ;
    :yValue "78.2" ;
    :belongsTo :Chart .
