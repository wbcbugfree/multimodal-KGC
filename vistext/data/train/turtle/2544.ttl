@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Latin American ATP tennis players with the highest prize money earnings from January to November 2020 (in million U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "player" .

:YAxis a :Axis ;
    :title "Prize money earned in million U.S. dollars" .

:DataPoint1 a :DataPoint ;
    :xValue "Diego Schwartzman (Argentina)" ;
    :yValue "1.42" ;
    :belongsTo :Chart .

