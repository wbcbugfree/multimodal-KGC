@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Distribution of new installed onshore wind capacity worldwide in 2019 , by country" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "Share of global new installed capacity" .

:DataPoint1 a :DataPoint ;
    :xValue "China" ;
    :yValue "0.44" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "United States" ;
    :yValue "0.17" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "India" ;
    :yValue "0.04" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "Spain" ;
    :yValue "0.04" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "Sweden" ;
    :yValue "0.03" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "France" ;
    :yValue "0.02" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Germany" ;
    :yValue "0.02" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Argentina" ;
    :yValue "0.02" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "Australia" ;
    :yValue "0.02" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "Mexico" ;
    :yValue "0.02" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "Rest of world" ;
    :yValue "0.18" ;
    :belongsTo :Chart .
