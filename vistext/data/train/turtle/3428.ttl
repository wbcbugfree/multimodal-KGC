@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Number of domestic camping and caravanning holiday trips taken in England from 2008 to 2019 (in millions)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Number of trips in millions" .

:YAxis a :Axis ;
    :title "Year" .

:DataPoint1 a :DataPoint ;
    :xValue "9.26" ;
    :yValue "2019" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "10.53" ;
    :yValue "2018" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "10.65" ;
    :yValue "2017" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "10.21" ;
    :yValue "2016*" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "10.12" ;
    :yValue "2015" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "9.51" ;
    :yValue "2014" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "10.69" ;
    :yValue "2013" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "10.53" ;
    :yValue "2012" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "11.61" ;
    :yValue "2011" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "10.98" ;
    :yValue "2010" ;
