@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Reasons for participating in cultural activities in United States as of April 2014" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Share of respondents" .

:YAxis a :Axis ;
    :title "Response" .

:DataPoint1 a :DataPoint ;
    :xValue "0.93" ;
    :yValue "Entertainment and enjoyment" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "0.83" ;
    :yValue "Time with friends/family" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "0.79" ;
    :yValue "Expand my perspective" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "0.77" ;
    :yValue "Interest in subject" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "0.76" ;
    :yValue "Learn about other cultures" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "0.73" ;
    :yValue "Introduction to new things" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "0.67" ;
    :yValue "Support my community" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "0.66" ;
    :yValue "Escape stress" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "0.52" ;
    :yValue "Celebrate my heritage" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "0.23" ;
    :yValue "Be \"in the know\"" ;
    :belongsTo :Chart .
