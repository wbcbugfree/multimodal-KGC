@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Turnover from retail sale of food , beverages and tobacco in specialized stores in Austria from 2008 to 2018 (in million euros)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Annual turnover in million euros" .

:YAxis a :Axis ;
    :title "Year" .

:DataPoint1 a :DataPoint ;
    :xValue "4213.7" ;
    :yValue "2018*" ;
    :belongsTo :Chart .

