@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Net new cash flow to mutual funds in the United States from 2000 to 2019 , by fund type (in billion U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Equity, bond, and hybrid funds" .

:YAxis a :Axis ;
    :title "Year" .

