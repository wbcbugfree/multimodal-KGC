@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Global microprocessor market share from 1st quarter 2009 to 3rd quarter 2011 , by vendor" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Others" .

:YAxis a :Axis ;
    :title "Quarter" .

:DataPoint1 a :DataPoint ;
    :xValue "0.061" ;
    :yValue "Q3 2011" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "0.07" ;
    :yValue "Q2 2011" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "0.073" ;
    :yValue "Q1 2011" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "0.076" ;
    :yValue "Q4 2010" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "0.077" ;
    :yValue "Q3 2010" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "0.081" ;
    :yValue "Q2 2010" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "0.08" ;
    :yValue "Q1 2010" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "0.068" ;
    :yValue "Q4 2009" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "0.079" ;
    :yValue "Q3 2009" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "0.078" ;
    :yValue "Q2 2009" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "0.081" ;
    :yValue "Q1 2009" ;
    :belongsTo :Chart .
