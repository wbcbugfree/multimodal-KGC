@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Professional and administrative staff to lawyer ratio of law firms worldwide between 2005 and 2016" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Ratio" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2004" ;
    :yValue "1.07" ;
    :belongsTo :Chart .

