@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Largest cities in Russia as of January 1 , 2020 , by population (in 1,000s)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Population in thousands" .

:YAxis a :Axis ;
    :title "City in Russia" .

:DataPoint1 a :DataPoint ;
    :xValue "12678.08" ;
    :yValue "Moscow" ;
    :belongsTo :Chart .

