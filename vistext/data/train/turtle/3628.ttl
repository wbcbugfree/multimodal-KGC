@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Countries with the worst hotel Wi-Fi quality worldwide as of January 2015" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "Share of hotels with adequate Wi-Fi quality" .

:DataPoint1 a :DataPoint ;
    :xValue "Cambodia" ;
    :yValue "0.207" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Greece" ;
    :yValue "0.208" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "Indonesia" ;
    :yValue "0.217" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "Philippines" ;
    :yValue "0.233" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "Portugal" ;
    :yValue "0.258" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Dominican Republic" ;
    :yValue "0.28" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "France" ;
    :yValue "0.296" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Spain" ;
    :yValue "0.321" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "Turkey" ;
