@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Percentage of households with three or more cats in the United Kingdom (UK) in 2013 , by region" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Percentage of households" .

:YAxis a :Axis ;
    :title "Response" .

:DataPoint1 a :DataPoint ;
    :xValue "0.23" ;
    :yValue "Wales" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "0.22" ;
    :yValue "Yorkshire and the Humber" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "0.21" ;
    :yValue "Northeast" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "0.17" ;
    :yValue "West Midlands" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "0.12" ;
    :yValue "Southwest" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "0.08" ;
    :yValue "East of England" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "0.09" ;
    :yValue "London" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "0.08" ;
    :yValue "Scotland" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "0.07" ;
    :yValue "Northwest" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "0.06" ;
    :yValue "East Midlands" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "0.06" ;
    :yValue "Southeast" ;
    :belongsTo :Chart .
