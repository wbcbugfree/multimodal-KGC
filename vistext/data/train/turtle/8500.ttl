@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Preferences for buying a car in the United Kingdom (UK) in 2015 , by type of car and region" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "New car" .

:DataPoint1 a :DataPoint ;
    :xValue "London" ;
    :yValue "0.19" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "South East" ;
    :yValue "0.1" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "South West" ;
    :yValue "0.15" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "Wales" ;
    :yValue "0.28" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "East Anglia" ;
    :yValue "0.14" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "East Midlands" ;
    :yValue "0.13" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "West Midlands" ;
    :yValue "0.1" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Yorks/Humb" ;
    :yValue "0.1" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "North West" ;
    :yValue "0.2" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "North" ;
    :yValue "0.21" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "Scotland" ;
    :yValue "0.19" ;
    :belongsTo :Chart .
