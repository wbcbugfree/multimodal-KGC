@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Sugar production in the United States from 2009/2010 to 2019/2020 (in million metric tons)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Production in million metric tons" .

:YAxis a :Axis ;
    :title "Year" .

:DataPoint1 a :DataPoint ;
    :xValue "7.28" ;
    :yValue "2019/2020" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "8.16" ;
    :yValue "2018/2019" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "8.43" ;
    :yValue "2017/2018" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "8.14" ;
    :yValue "2016/2017" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "8.16" ;
    :yValue "2015/2016" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "7.85" ;
    :yValue "2014/2015" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "7.7" ;
    :yValue "2013/2014" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "8.1" ;
    :yValue "2012/2013" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "7.7" ;
    :yValue "2011/2012" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "7.1" ;
    :yValue "2010/2011" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "7.2" ;
    :yValue "2009/2010" ;
    :belongsTo :Chart .
