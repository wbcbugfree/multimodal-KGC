@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Monthly market capitalization of Europe 's largest banks since the Coronavirus from December 2019 to October 2020 (in billion U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Month" .

:YAxis a :Axis ;
    :title "Lloyds Banking Group (UK)" .

:DataPoint1 a :DataPoint ;
    :xValue "Oct '20" ;
    :yValue "24.96" ;
    :belongsTo :Chart .

