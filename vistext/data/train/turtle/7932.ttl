@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Price of a single journey in zones 1 - 4 on the London Underground from 2004 to 2016 , paying by cash and oyster card (in GBP)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Oyster card" .

:DataPoint1 a :DataPoint ;
    :xValue "2016" ;
    :yValue "3.9" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "2015" ;
    :yValue "3.9" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "2014" ;
    :yValue "3.8" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "2013" ;
    :yValue "3.8" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "2012*" ;
    :yValue "3.6" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "2011" ;
    :yValue "3.4" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "2010" ;
    :yValue "3.1" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "2009" ;
    :yValue "2.8" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "2008" ;
    :yValue "2.5" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "2007" ;
    :yValue "2.5" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "2006" ;
    :yValue "2.5" ;
    :belongsTo :Chart .

:DataPoint12 a :DataPoint ;
    :xValue "2005" ;
    :yValue "2.5" ;
    :belongsTo :Chart .

:DataPoint13 a :DataPoint ;
    :xValue "2004" ;
    :yValue "2.8" ;
    :belongsTo :Chart .
