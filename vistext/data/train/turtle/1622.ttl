@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Average number of daily comments on brand posts on Facebook as of July 2018 , by vertical" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "industry" .

:YAxis a :Axis ;
    :title "Number of Facebook brand post comments per day" .

:DataPoint1 a :DataPoint ;
    :xValue "Telecom" ;
    :yValue "37.2" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Retail" ;
    :yValue "21.5" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "Airlines" ;
    :yValue "19.7" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "Financial Services" ;
    :yValue "4.6" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "Automotive" ;
    :yValue "4.3" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Consumer Technology" ;
    :yValue "2.6" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Consumer Goods" ;
    :yValue "2" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Television" ;
    :yValue "1.8" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "Hotels" ;
    :yValue "1.6" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "Alcohol" ;
    :yValue "1.5" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "Pharma/Health" ;
    :yValue "1" ;
    :belongsTo :Chart .

:DataPoint12 a :DataPoint ;
    :xValue "Energy" ;
    :yValue "0.9" ;
    :belongsTo :Chart .

:DataPoint13 a :DataPoint ;
    :xValue "Fashion" ;
    :yValue "0.1" ;
    :belongsTo :Chart .
