@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Women 's singles Australian Open tennis tournaments won from 1968 to 2020" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Number of Australian Open titles" .

:YAxis a :Axis ;
    :title "player name" .

:DataPoint1 a :DataPoint ;
    :xValue "7" ;
    :yValue "Serena Williams" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "4" ;
    :yValue "Steffi Graf" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "4" ;
    :yValue "Margaret Court" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "4" ;
    :yValue "Monica Seles" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "4" ;
    :yValue "Evonne Goolagong Cawley" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "3" ;
    :yValue "Martina Hingis" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "3" ;
    :yValue "Martina Navratilova" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "2" ;
    :yValue "Chris Evert" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "2" ;
    :yValue "Hana Mandlikova" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "2" ;
