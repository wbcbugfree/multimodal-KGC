@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Expenditure on chocolate per capita in selected countries in Europe in 2015 (in US dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Country" .

:YAxis a :Axis ;
    :title "Spending in US dollars" .

:DataPoint1 a :DataPoint ;
    :xValue "Switzerland" ;
    :yValue "236.7" ;
    :belongsTo :Chart .

