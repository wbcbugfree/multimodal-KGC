@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "External debt as percentage of gross domestic product in Venezuela from 2000 to 2016" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Foreign debt as share of GDP" .

