@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "U.S. spending on the Iraq war (in billion U.S. dollars) and the number U.S. soldier fatalities from 2003 to 2012" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "U.S. soldier fatalities" .

:DataPoint1 a :DataPoint ;
    :xValue "2012**" ;
    :yValue "1" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "2011" ;
    :yValue "54" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "2010" ;
    :yValue "60" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "2009" ;
    :yValue "149" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "2008" ;
    :yValue "314" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "2007" ;
    :yValue "904" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "2006" ;
    :yValue "823" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "2005" ;
    :yValue "846" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "2004" ;
    :yValue "849" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "2003" ;
    :yValue "486" ;
    :belongsTo :Chart .
