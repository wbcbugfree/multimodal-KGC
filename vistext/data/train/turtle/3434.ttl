@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Retail price index of potato in India from January to December 2019" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Month" .

:YAxis a :Axis ;
    :title "Retail price index" .

:DataPoint1 a :DataPoint ;
    :xValue "December" ;
    :yValue "360.81" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "November" ;
    :yValue "312.72" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "October" ;
    :yValue "286.5" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "September" ;
    :yValue "267.68" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "August" ;
    :yValue "261.65" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "July" ;
    :yValue "263.32" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "June" ;
    :yValue "253.06" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "May" ;
    :yValue "237.03" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "April" ;
    :yValue "219.45" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "March" ;
    :yValue "202.16" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "February" ;
    :yValue "198.27" ;
    :belongsTo :Chart .

:DataPoint12 a :DataPoint ;
    :xValue "January" ;
    :yValue "217.58" ;
    :belongsTo :Chart .
