@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "E-commerce as percentage of total manufacturing shipments in the United States from 2000 to 2018" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "Share of e-commerce in total sales" .

