@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Leading 10 fastest growing retailers of baked products in the United Kingdom 2013 , ranked by year-on-year increase in outlets" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Country" .

:YAxis a :Axis ;
    :title "Year-on-year increase in number of outlets" .

:DataPoint1 a :DataPoint ;
    :xValue "Costa" ;
    :yValue "200" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Greggs" ;
    :yValue "100" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "Subway" ;
    :yValue "59" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "Caffè Nero" ;
    :yValue "50" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "Starbucks" ;
    :yValue "25" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Coopland & Son" ;
    :yValue "20" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Pret A Manger" ;
    :yValue "18" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "RT Stuart" ;
    :yValue "16" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "SSP" ;
    :yValue "15" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "Coffee Republic" ;
    :yValue "11" ;
    :belongsTo :Chart .
