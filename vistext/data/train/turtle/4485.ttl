@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Leading universities in Sweden in 2020 , by number of registered students" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "university" .

:YAxis a :Axis ;
    :title "Number of students" .

