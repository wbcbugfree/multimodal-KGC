@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Value of U.S. local and state government commercial construction put in place from 2008 to 2019 (in million U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Parking" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2007" ;
    :yValue "1252" ;
    :belongsTo :Chart .

