@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Pinterest 's average quarterly revenue per user from 1st quarter 2016 to 3rd quarter 2020 , by region (in U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Quarter" .

:YAxis a :Axis ;
    :title "International" .

