@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Fibre broadband availability as share of households by country in 2016 , by technology" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Country" .

:YAxis a :Axis ;
    :title "VDSL & full-fibre" .

:DataPoint1 a :DataPoint ;
    :xValue "Netherlands" ;
    :yValue "0.01" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "South Korea" ;
    :yValue "0.95" ;
    :belongsTo :Chart .
