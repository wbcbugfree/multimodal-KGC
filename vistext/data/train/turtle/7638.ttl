    :xValue "Germany" ;
    :yValue "0.44" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "France" ;
    :yValue "0.45" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Ireland" ;
    :yValue "0.25" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Nordic region" ;
    :yValue "0.44" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "Benelux" ;
    :yValue "0.48" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "Italy" ;
    :yValue "0.17" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "Central & Eastern Europe" ;
