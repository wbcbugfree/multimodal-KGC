@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Countries in the Asia Pacific region ranked by the number of mobile subscribers in 2015 (in millions)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Unique mobile subscribers in millions" .

:YAxis a :Axis ;
    :title "Country" .

