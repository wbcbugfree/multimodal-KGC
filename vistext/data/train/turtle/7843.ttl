@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Value of merchandise exports from China 's Greater Bay Area cities in 2018 and 2019 , by city (in billion U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "city of China" .

:YAxis a :Axis ;
    :title "2019" .

:DataPoint1 a :DataPoint ;
    :xValue "Hong Kon" ;
    :yValue "509.02" ;
    :belongsTo :Chart .

