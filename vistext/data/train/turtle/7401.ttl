@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "South Korea : Age structure between 2009 and 2019" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "65 and above" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2008" ;
    :yValue "0.1029" ;
    :belongsTo :Chart .

