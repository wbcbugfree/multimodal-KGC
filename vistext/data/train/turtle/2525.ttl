@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Share of renewable energy of primary energy consumed in Nigeria between 1990 and 2017" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "Share of renewable energy" .

