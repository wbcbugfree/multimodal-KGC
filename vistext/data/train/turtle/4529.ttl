@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Most in-demand professions in Spain in 2019 , by category" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Share of jobs offered" .

:YAxis a :Axis ;
    :title "Response" .

:DataPoint1 a :DataPoint ;
    :xValue "0.0274" ;
    :yValue "Sales representative" ;
    :belongsTo :Chart .

