@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Consumer preferred channels of brand communication during the coronavirus pandemic worldwide as of March 2020 , by country" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "TV, radio or newspapers" .

:YAxis a :Axis ;
    :title "Response" .

:DataPoint1 a :DataPoint ;
    :xValue "0.45" ;
    :yValue "Average" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "0.37" ;
    :yValue "United States" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "0.66" ;
    :yValue "India" ;
    :belongsTo :Chart .

