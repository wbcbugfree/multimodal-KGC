    :xValue "0.54" ;
    :yValue "South Africa" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "0.53" ;
    :yValue "Brazil" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "0.49" ;
    :yValue "South Korea" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "0.46" ;
    :yValue "China" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "0.43" ;
    :yValue "Italy" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "0.39" ;
    :yValue "Canada" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "0.39" ;
    :yValue "Germany" ;
    :belongsTo :Chart .

:DataPoint12 a :DataPoint ;
    :xValue "0.34" ;
    :yValue "France" ;
    :belongsTo :Chart .

:DataPoint13 a :DataPoint ;
    :xValue "0.28" ;
    :yValue "United Kingdom" ;
    :belongsTo :Chart .
