@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Walmart 's net sales worldwide from fiscal year 2008 to 2020 , by division (in billion U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Walmart U.S." .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2007" ;
    :yValue "238.92" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Dec 31, 2008" ;
    :yValue "256.97" ;
    :belongsTo :Chart .

