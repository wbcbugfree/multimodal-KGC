@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Ratio between CEO and average worker pay in 2018 , by country" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Ratio between CEO and worker pay" .

:YAxis a :Axis ;
    :title "Country" .

:DataPoint1 a :DataPoint ;
    :xValue "265" ;
    :yValue "United States" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "229" ;
    :yValue "India" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "201" ;
    :yValue "United Kingdom" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "180" ;
    :yValue "South Africa" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "171" ;
    :yValue "Netherlands" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "152" ;
    :yValue "Switzerland" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "149" ;
    :yValue "Canada" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "143" ;
    :yValue "Spain" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "136" ;
    :yValue "Germany" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "127" ;
    :yValue "China" ;
    :belongsTo :Chart .
