@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Number of enterprises in the processing and preserving of meat and production of meat products industry in Poland from 2008 to 2018" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Number of enterprises" .

:YAxis a :Axis ;
    :title "Year" .

