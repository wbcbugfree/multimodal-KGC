@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Coronavirus (COVID-19) test numbers across India as of December 7 , 2020 , by state (tests per million)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
