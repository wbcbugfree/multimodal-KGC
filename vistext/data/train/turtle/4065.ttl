@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Revenue per employee of major IT services vendors worldwide (in U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Revenue per employee in U.S. dollars" .

:YAxis a :Axis ;
    :title "IT service vendor" .

