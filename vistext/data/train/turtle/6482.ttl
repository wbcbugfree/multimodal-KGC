@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "What do you see as the most important issue facing Britain today ?" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "EU/Brexit" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2007" ;
    :yValue "0.01" ;
    :belongsTo :Chart .

