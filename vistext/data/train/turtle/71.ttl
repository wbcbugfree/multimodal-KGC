    :belongsTo :Chart .

:DataPoint14 a :DataPoint ;
    :xValue "2002" ;
    :yValue "0.16" ;
    :belongsTo :Chart .

:DataPoint15 a :DataPoint ;
    :xValue "2001" ;
    :yValue "0.14" ;
    :belongsTo :Chart .

:DataPoint16 a :DataPoint ;
    :xValue "2000" ;
    :yValue "0.13" ;
