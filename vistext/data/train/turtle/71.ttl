@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "PC penetration per capita in Western Europe from 2000 to 2015 (in percent)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Penetration in percent" .

:DataPoint1 a :DataPoint ;
    :xValue "2015*" ;
    :yValue "0.5" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "2014*" ;
    :yValue "0.47" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "2013*" ;
    :yValue "0.45" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "2012*" ;
    :yValue "0.42" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "2011*" ;
    :yValue "0.39" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "2010" ;
    :yValue "0.36" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "2009" ;
    :yValue "0.33" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "2008" ;
    :yValue "0.29" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "2007" ;
