@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Production area of pineapples worldwide from 2002 to 2018 (in 1,000 hectares)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Area in thousand hectares" .

