    :yValue "1204.8" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Dec 31, 2012" ;
    :yValue "1232.1" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
