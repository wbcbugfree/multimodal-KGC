@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Major butter producing countries worldwide in 2019 (in 1,000 metric tons)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Butter production in thousand metric tons" .

:YAxis a :Axis ;
    :title "Country" .

:DataPoint1 a :DataPoint ;
    :xValue "5850" ;
    :yValue "India" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "2425" ;
    :yValue "EU-27" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "861" ;
    :yValue "United States" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "530" ;
    :yValue "New Zealand" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "254" ;
    :yValue "Russia" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "231" ;
    :yValue "Mexico" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "112" ;
    :yValue "Canada" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "110" ;
    :yValue "Belarus" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "103" ;
    :yValue "Ukraine" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "102" ;
    :yValue "China" ;
    :belongsTo :Chart .
