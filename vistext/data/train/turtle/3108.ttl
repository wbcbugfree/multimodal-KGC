@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Percentage of students to obtain a graduate degree in the United States in 2013 , by major group" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Share of U.S. students with a graduate degree" .

:YAxis a :Axis ;
    :title "Response" .

:DataPoint1 a :DataPoint ;
    :xValue "0.577" ;
    :yValue "Biology and life sciences" ;
    :belongsTo :Chart .

