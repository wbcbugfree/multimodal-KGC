@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Ukraine : The ten largest cities in 2016 , based on the number of inhabitants (in millions)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "city" .

:YAxis a :Axis ;
    :title "Residents in millions" .

:DataPoint1 a :DataPoint ;
    :xValue "Kyïv (Kiev)" ;
    :yValue "2.91" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Charkiv" ;
    :yValue "1.45" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "Odėsa" ;
    :yValue "1.01" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "Dnipropėtrovs'k" ;
    :yValue "0.98" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "Donėc'k" ;
    :yValue "0.93" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Zaporižžija" ;
    :yValue "0.76" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "L'viv" ;
    :yValue "0.73" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Kryvyj Rih" ;
    :yValue "0.64" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "Mykolaïv" ;
    :yValue "0.49" ;
