@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Commodity prices : average pig prices per metric ton of deadweight in the United Kingdom (UK) from 2009 to 2019 (in GBP per metric ton)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Pound price per metric ton of deadweight pig" .

:YAxis a :Axis ;
    :title "Year" .

:DataPoint1 a :DataPoint ;
    :xValue "1518.2" ;
    :yValue "2019" ;
    :belongsTo :Chart .

