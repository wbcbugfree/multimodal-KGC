@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Consumer spending on food and non-alcoholic drinks in the United Kingdom from 2005 to 2019 (in million GBP)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Expenditure in million GBP" .

