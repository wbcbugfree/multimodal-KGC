@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Distribution of zinc mine production worldwide in 2018 , by country" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Share of production" .

:YAxis a :Axis ;
    :title "Response" .

:DataPoint1 a :DataPoint ;
    :xValue "0.338" ;
    :yValue "China" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "0.116" ;
    :yValue "Peru" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "0.058" ;
    :yValue "India" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "0.067" ;
    :yValue "United States" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "0.087" ;
    :yValue "Australia" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "0.054" ;
    :yValue "Mexico" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "0.043" ;
    :yValue "Bolivia" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "0.027" ;
    :yValue "Kazakhstan" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "0.022" ;
    :yValue "Canada" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "0.186" ;
    :yValue "Other countries" ;
    :belongsTo :Chart .
