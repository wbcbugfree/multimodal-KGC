@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Number of paid employees in electric power generation in the U.S. in 2019 , by technology" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Number of employees" .

:YAxis a :Axis ;
    :title "technology" .

