@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Leading beauty and cosmetics brands on Twitter as of July 2018 , by followers (in 1,000s)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Brand fans in 1,000s" .

:YAxis a :Axis ;
    :title "company" .

:DataPoint1 a :DataPoint ;
    :xValue "1493.01" ;
    :yValue "MACcosmetics" ;
