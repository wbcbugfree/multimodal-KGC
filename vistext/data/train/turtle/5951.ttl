@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Top 10 cities with the largest number of violent crimes per 100,000 residents in the U.S. in 2019" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Crimes per 100,000 residents" .

:YAxis a :Axis ;
    :title "city of the United States" .

:DataPoint1 a :DataPoint ;
    :xValue "1965.33" ;
    :yValue "Detroit" ;
    :belongsTo :Chart .

