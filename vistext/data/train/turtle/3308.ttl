@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Death rate of colon and rectum cancer in the United States from 1999 to 2017 (per 100,000 population)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Deaths per 100,000 population" .

