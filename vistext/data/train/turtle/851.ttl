@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Ten most popular consumer electronics brands in the United Kingdom (UK) as of January 2020" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Share of respondents with a positive opinion" .

:YAxis a :Axis ;
    :title "Response" .

:DataPoint1 a :DataPoint ;
    :xValue "0.8" ;
    :yValue "Sony" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "0.78" ;
    :yValue "Samsung" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "0.7" ;
    :yValue "Panasonic" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "0.66" ;
    :yValue "Canon" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "0.64" ;
    :yValue "HP" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "0.6" ;
    :yValue "Apple" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "0.6" ;
    :yValue "Currys" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "0.6" ;
    :yValue "Apple iPad" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "0.58" ;
    :yValue "LG" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "0.57" ;
    :yValue "Nintendo" ;
    :belongsTo :Chart .
