    :yValue "Ellesmere Port" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "1850" ;
    :yValue "Eisenach" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "1450" ;
    :yValue "Aspern" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "1340" ;
    :yValue "Luton" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
