@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Number of employees at Opel/Vauxhall in selected European cities in 2018" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Number of employees" .

:YAxis a :Axis ;
    :title "city" .

:DataPoint1 a :DataPoint ;
    :xValue "14180" ;
    :yValue "Rüsselsheim (plant)" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "5120" ;
    :yValue "Zaragoza" ;
    :belongsTo :Chart .

