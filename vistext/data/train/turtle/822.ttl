@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Average cost to attend university per year in the United States from the academic year 2000/01 to 2017/18 (in U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Average cost to attend university" .

:YAxis a :Axis ;
    :title "Year" .

