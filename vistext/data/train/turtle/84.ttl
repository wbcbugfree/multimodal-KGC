@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Countries with the highest number of plastic surgeons in 2019" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Country" .

:YAxis a :Axis ;
    :title "Number of surgeons" .

