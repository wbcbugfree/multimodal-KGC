@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Share of voluntary work in the sports sector in the last year in England from 2005/06 to 2018/19" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "Share of respondents" .

:DataPoint1 a :DataPoint ;
    :xValue "2018/19" ;
    :yValue "0.207" ;
    :belongsTo :Chart .

