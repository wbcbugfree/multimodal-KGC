@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Top 15 Jobs in the U.S. with the highest divorce rate based on 2000 U.S. Census data" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

