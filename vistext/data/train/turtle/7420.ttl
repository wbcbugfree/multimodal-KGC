@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Projected energy consumption worldwide from 1990 to 2040 , by energy source (in million metric tons of oil equivalent)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Hydroelectricity" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 1989" ;
    :yValue "487.5" ;
    :belongsTo :Chart .

