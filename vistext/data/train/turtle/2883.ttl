@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Leading rum brands worldwide in 2019 , based on sales volume (in million 9 liter cases)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Rum brand" .

:YAxis a :Axis ;
    :title "Million 9 liter cases" .

:DataPoint1 a :DataPoint ;
    :xValue "Tanduay" ;
    :yValue "20.5" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Bacardi" ;
    :yValue "17.8" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "Captain Morgan" ;
    :yValue "11.9" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "McDowell's No. 1 Celebration" ;
    :yValue "10.8" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "Havana Club" ;
    :yValue "4.6" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Barceló" ;
    :yValue "2.1" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Old Port" ;
    :yValue "1.8" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Bozkov" ;
    :yValue "1.6" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "Appleton Jamaica" ;
    :yValue "1.1" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "Negrita" ;
    :yValue "1" ;
    :belongsTo :Chart .
