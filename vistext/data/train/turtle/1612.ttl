@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Number of foreign life insurers operating in the United States in 2018 , by country of origin" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Number of companies" .

:YAxis a :Axis ;
    :title "Country" .

:DataPoint1 a :DataPoint ;
    :xValue "27" ;
    :yValue "Canada" ;
    :belongsTo :Chart .

