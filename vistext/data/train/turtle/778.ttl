@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Number of crime offences recorded in Scotland from 2002/03 to 2019/20 (in 1,000s)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Recorded crimes in thousands" .

:DataPoint1 a :DataPoint ;
    :xValue "2002/03" ;
    :yValue "418.28" ;
    :belongsTo :Chart .

