@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Consumer Price Index of pan , tobacco , and intoxicants across urban and rural India from March 2019 to March 2020 , by month" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Month" .

:YAxis a :Axis ;
    :title "Urban" .

:DataPoint1 a :DataPoint ;
    :xValue "Feb 28, 2019" ;
    :yValue "165.3" ;
    :belongsTo :Chart .

