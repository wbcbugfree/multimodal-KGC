@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Leading offshore financial centers worldwide as of June 2014" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Country" .

:YAxis a :Axis ;
    :title "Global Financial Centres Index score" .

:DataPoint1 a :DataPoint ;
    :xValue "British Virgin Islands" ;
    :yValue "639" ;
    :belongsTo :Chart .

