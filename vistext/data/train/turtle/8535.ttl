@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Monthly export value of farm and fishing products in Canada from 2015 to 2020 (in billion Canadian dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "2018" .

:YAxis a :Axis ;
    :title "Month" .

:DataPoint1 a :DataPoint ;
    :xValue "2.93" ;
    :yValue "Dec" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "2.83" ;
    :yValue "Nov" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "3" ;
    :yValue "Oct" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "2.82" ;
    :yValue "Sep" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "2.88" ;
    :yValue "Aug" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "2.93" ;
    :yValue "Jul" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "2.97" ;
    :yValue "Jun" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "2.91" ;
    :yValue "May" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "2.85" ;
    :yValue "Apr" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "2.84" ;
    :yValue "Mar" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "2.51" ;
    :yValue "Feb" ;
    :belongsTo :Chart .

:DataPoint12 a :DataPoint ;
    :xValue "2.81" ;
    :yValue "Jan" ;
    :belongsTo :Chart .
