@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Top 10 countries based on new type 1 diabetes cases among children and adolescents in 2019 (per 100,000 children)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Country" .

:YAxis a :Axis ;
    :title "New cases per 100,000 children" .

:DataPoint1 a :DataPoint ;
    :xValue "Finland" ;
    :yValue "62.3" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Sweden" ;
    :yValue "43.2" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "Kuwait" ;
    :yValue "41.7" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "Norway" ;
    :yValue "33.6" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "Saudi Arabia" ;
    :yValue "31.4" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Canada" ;
    :yValue "29.9" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "United Kingdom" ;
    :yValue "29.4" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Qatar" ;
    :yValue "28.4" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "Ireland" ;
    :yValue "27.5" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "Denmark" ;
    :yValue "27" ;
    :belongsTo :Chart .
