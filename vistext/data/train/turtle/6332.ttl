@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Global net revenue of Amazon.com as of 3rd quarter 2020 , by product group (in million U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
