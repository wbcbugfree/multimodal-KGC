@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Global biologics drug discovery market worldwide by phase from 2016 to 2025 (in million U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Lead Identification" .

:DataPoint1 a :DataPoint ;
    :xValue "2025" ;
    :yValue "4089.6" ;
    :belongsTo :Chart .

