@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Total population of Den Bosch from 2009 to 2019" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Number of inhabitants" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2008" ;
    :yValue "137775" ;
    :belongsTo :Chart .

