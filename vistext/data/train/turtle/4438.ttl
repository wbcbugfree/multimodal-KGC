@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Estimated revenue of the U.S. broadcasting industry from 2005 to 2018 (in billion U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Estimated revenue in billion U.S. dollars" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2004" ;
    :yValue "89.56" ;
    :belongsTo :Chart .

