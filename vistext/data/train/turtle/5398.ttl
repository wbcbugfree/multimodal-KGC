@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Value of the leading merchandise exporters worldwide in 2019 , by exporting nation (in billion U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Export value in billion U.S. dollars" .

:YAxis a :Axis ;
    :title "Exporting nation" .

:DataPoint1 a :DataPoint ;
    :xValue "2499" ;
    :yValue "China" ;
    :belongsTo :Chart .

