@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Number of heterosexual marriages in Spain from 2006 to 2019" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Number of marriages" .

:YAxis a :Axis ;
    :title "Year" .

:DataPoint1 a :DataPoint ;
    :xValue "160470" ;
    :yValue "2019*" ;
    :belongsTo :Chart .

