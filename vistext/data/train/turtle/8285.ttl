@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Grant rate of parole from federal prisons in Canada from FY 2006 to FY 2019" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Full parole" .

:YAxis a :Axis ;
    :title "Year" .

:DataPoint1 a :DataPoint ;
    :xValue "0.382" ;
    :yValue "2018-2019" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "0.375" ;
    :yValue "2017-2018" ;
    :belongsTo :Chart .

