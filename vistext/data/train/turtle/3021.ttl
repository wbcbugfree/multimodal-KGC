@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Distribution of countries of origin for immigrants in Germany in 2019" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Share of countries" .

:YAxis a :Axis ;
    :title "Response" .

:DataPoint1 a :DataPoint ;
    :xValue "0.148" ;
    :yValue "Romania" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "0.084" ;
    :yValue "Poland" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "0.053" ;
    :yValue "Bulgaria" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "0.04" ;
    :yValue "Italy" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "0.033" ;
    :yValue "Turkey" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "0.027" ;
    :yValue "Croatia" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "0.023" ;
    :yValue "India" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "0.022" ;
    :yValue "Hungary" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "0.019" ;
    :yValue "USA" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "0.019" ;
    :yValue "Serbia" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "0.431" ;
    :yValue "Other countries of origin" ;
    :belongsTo :Chart .
