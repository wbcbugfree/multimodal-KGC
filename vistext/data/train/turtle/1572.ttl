@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Which social media could male users in the United Kingdom (UK) least do without as of 3rd quarter 2019" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "Share of respondents" .

:DataPoint1 a :DataPoint ;
    :xValue "Facebook" ;
    :yValue "0.255" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "WhatsApp" ;
    :yValue "0.236" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "YouTube" ;
    :yValue "0.188" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "Don't know" ;
    :yValue "0.171" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "Twitter" ;
    :yValue "0.121" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Instagram" ;
    :yValue "0.071" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "LinkedIn" ;
    :yValue "0.05" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Reddit" ;
    :yValue "0.029" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "Pinterest" ;
    :yValue "0.022" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "Snapchat" ;
    :yValue "0.015" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "Other" ;
    :yValue "0.009" ;
    :belongsTo :Chart .

:DataPoint12 a :DataPoint ;
    :xValue "Tumblr" ;
    :yValue "0.007" ;
    :belongsTo :Chart .

:DataPoint13 a :DataPoint ;
    :xValue "Periscope" ;
    :yValue "0" ;
    :belongsTo :Chart .
