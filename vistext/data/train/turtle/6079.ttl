@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Gross domestic product (GDP) per capita in Belgium from 2007 to 2017 , by region (in euro purchasing power parity)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Flemish Region" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2006" ;
    :yValue "32583" ;
    :belongsTo :Chart .

