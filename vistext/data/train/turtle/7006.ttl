@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Revenue of the LVMH Group worldwide from 2008 to 2019 , by segment (in million euros)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Selective retailing**" .

:YAxis a :Axis ;
    :title "Year" .

