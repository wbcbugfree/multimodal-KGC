@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Share of the average photovoltaic plant load factor (PLF) France in 2019 , by region" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "region of France" .

:YAxis a :Axis ;
    :title "Average load factor" .

:DataPoint1 a :DataPoint ;
    :xValue "Provence-Alpes-Côte d'Azur" ;
    :yValue "0.169" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Corsica" ;
    :yValue "0.165" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "Nouvelle-Aquitaine" ;
    :yValue "0.156" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "Occitany" ;
    :yValue "0.152" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "Bourgogne Franche-Comté" ;
    :yValue "0.141" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Auvergne-Rhône-Alpes" ;
    :yValue "0.139" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Centre-Val de Loire" ;
    :yValue "0.138" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Pays de la Loire" ;
    :yValue "0.129" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "Grand-Est" ;
    :yValue "0.127" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "Brittany" ;
    :yValue "0.12" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "Normandy" ;
    :yValue "0.118" ;
    :belongsTo :Chart .

:DataPoint12 a :DataPoint ;
    :xValue "Hauts-de-France" ;
    :yValue "0.109" ;
    :belongsTo :Chart .

:DataPoint13 a :DataPoint ;
    :xValue "Ile-de-France" ;
    :yValue "0.098" ;
