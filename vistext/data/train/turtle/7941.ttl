@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Revenue of KPMG worldwide from 2010 to 2019 , by function (in billion U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Function" .

:YAxis a :Axis ;
    :title "Tax" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2009" ;
    :yValue "4.15" ;
    :belongsTo :Chart .

