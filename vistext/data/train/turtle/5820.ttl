@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Value of average premiums for renters insurance in the United States from 2001 to 2017 (in U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Value in U.S. dollars" .

