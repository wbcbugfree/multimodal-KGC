@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Gross domestic product of Quebec , Canada in 2019 , by industry (in million chained 2012 Canadian dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "GDP in million chained 2012 Canadian dollars" .

:YAxis a :Axis ;
    :title "industry classification" .

