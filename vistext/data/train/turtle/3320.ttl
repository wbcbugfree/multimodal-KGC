@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Number of positron emission tomography (PET) scan examinations in Germany from 2005 to 2017" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Number of PET scan examinations" .

