@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Population size per local bank branch among the eurozone countries from 2014 to 2016" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
