@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Recommended retail price of a typical pack of 20 cigarettes in the United Kingdom (UK) from 2005 to 2017 (in GBP)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Recommended retail price in GBP" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2004" ;
    :yValue "4.82" ;
    :belongsTo :Chart .

