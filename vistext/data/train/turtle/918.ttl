@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Most important issues facing women and girls in Brazil as of 2019" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "Share of respondents" .

:DataPoint1 a :DataPoint ;
    :xValue "Sexual violence" ;
    :yValue "0.39" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Physical violence" ;
    :yValue "0.34" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "Sexual harassment" ;
    :yValue "0.28" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "Domestic abuse" ;
    :yValue "0.19" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "Equal pay" ;
    :yValue "0.17" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Sexualization of women and girls in the media" ;
    :yValue "0.13" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Access to employment" ;
    :yValue "0.1" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Lack of financial/economic independence" ;
    :yValue "0.08" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "Lack of women in leadership roles in business and public life" ;
    :yValue "0.08" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "The amount of unpaid work that women do (e.g. cooking, cleaning, childcare)" ;
    :yValue "0.07" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "Gender stereotyping" ;
    :yValue "0.07" ;
    :belongsTo :Chart .

:DataPoint12 a :DataPoint ;
    :xValue "Abuse on Social Media" ;
    :yValue "0.07" ;
    :belongsTo :Chart .

:DataPoint13 a :DataPoint ;
    :xValue "Workplace discrimination" ;
    :yValue "0.06" ;
    :belongsTo :Chart .

:DataPoint14 a :DataPoint ;
    :xValue "Balancing work and caring responsibilities" ;
    :yValue "0.05" ;
    :belongsTo :Chart .

:DataPoint15 a :DataPoint ;
    :xValue "Support for pregnant women and new mothers" ;
    :yValue "0.02" ;
    :belongsTo :Chart .
