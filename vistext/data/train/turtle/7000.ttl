@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Monthly sales of toys , games and hobby supplies at large retailers in Canada from 2014 to 2019 (in million Canadian dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "2018" .

:YAxis a :Axis ;
    :title "Month" .

:DataPoint1 a :DataPoint ;
    :xValue "650.35" ;
    :yValue "Dec" ;
    :belongsTo :Chart .

