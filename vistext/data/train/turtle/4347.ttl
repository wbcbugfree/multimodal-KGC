@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Which three of the following countries do you find most attractive as a country whose people can be trusted ?" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "Share of respondents" .

:DataPoint1 a :DataPoint ;
    :xValue "Canada" ;
    :yValue "0.42" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "UK" ;
    :yValue "0.39" ;
    :belongsTo :Chart .

