@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Average ticket price Buffalo Sabres (NHL) games from 2005/06 to 2014/15 (in U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Average ticket price in U.S. dollars" .

:DataPoint1 a :DataPoint ;
    :xValue "14/15" ;
    :yValue "49.72" ;
    :belongsTo :Chart .

