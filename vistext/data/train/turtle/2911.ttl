@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Representative retail prices of high-end mass market personal care and cosmetic products in China in 2015 , by category (in U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Price in U.S. dollars" .

:YAxis a :Axis ;
    :title "Category" .

:DataPoint1 a :DataPoint ;
    :xValue "28" ;
    :yValue "Perfume" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "27" ;
    :yValue "Eyeshadow" ;
    :belongsTo :Chart .

