    :xValue "25" ;
    :yValue "Sunscreen" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "22" ;
    :yValue "Mascara" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "21" ;
    :yValue "Shampoo/Conditioner" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "20" ;
    :yValue "Skin cream" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "19" ;
    :yValue "Lipstick" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "9" ;
