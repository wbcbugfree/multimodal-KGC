@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Most popular retail brands in the United Kingdom (UK) as of January 2020" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Share of respondents with a positive opinion" .

:YAxis a :Axis ;
    :title "Response" .

:DataPoint1 a :DataPoint ;
    :xValue "0.81" ;
    :yValue "Lego" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "0.75" ;
    :yValue "Argos" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "0.71" ;
    :yValue "Waterstones" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "0.62" ;
    :yValue "B&M" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "0.62" ;
    :yValue "The Co-operative Group" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "0.61" ;
    :yValue "Poundland" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "0.61" ;
    :yValue "Specsavers" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "0.6" ;
    :yValue "The Lego Store" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "0.6" ;
    :yValue "HMV" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "0.59" ;
    :yValue "Home Bargains" ;
    :belongsTo :Chart .
