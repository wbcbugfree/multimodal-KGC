@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Online gaming related keywords ranked by search volume in the United Kingdom (UK) in March 2016 (in 1,000 searches)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Searches in thousands" .

:YAxis a :Axis ;
    :title "Online gaming related keywords" .

