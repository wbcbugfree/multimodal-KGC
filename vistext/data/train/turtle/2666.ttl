@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Annual value of venture capital investments in the Spanish market from 2007 to 2016 (in 1,000 euros)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "VC investments in thousand euros" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2006" ;
    :yValue "256777" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Dec 31, 2007" ;
    :yValue "415277" ;
    :belongsTo :Chart .

