@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Rate of infant mortality in Canada in 2012 , by province or territory" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Country" .

:YAxis a :Axis ;
    :title "Mortality rate" .

:DataPoint1 a :DataPoint ;
    :xValue "Nunavut" ;
    :yValue "21.4" ;
    :belongsTo :Chart .

