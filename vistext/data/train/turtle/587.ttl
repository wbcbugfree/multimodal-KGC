@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Who is you favorite Star Wars character ?" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Share of respondents" .

:YAxis a :Axis ;
    :title "Response" .

:DataPoint1 a :DataPoint ;
    :xValue "0.13" ;
    :yValue "Yoda" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "0.13" ;
    :yValue "Princess Leia" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "0.12" ;
    :yValue "Han Solo" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "0.11" ;
    :yValue "Luke Skywalker" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "0.11" ;
    :yValue "R2-D2" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "0.1" ;
    :yValue "Chewbacca" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "0.07" ;
    :yValue "Obi Wan Kenobi" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "0.06" ;
    :yValue "Darth Vader" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "0.02" ;
