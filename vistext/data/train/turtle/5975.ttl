@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Atlanta Braves all-time wins leaders as of October 2020" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "human" .

:YAxis a :Axis ;
    :title "Number of games won" .

