@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Major U.S. cities with the highest average wind speeds (in MPH) , data through 2011" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "city of the United States" .

:YAxis a :Axis ;
    :title "Average wind speed (MPH)" .

:DataPoint1 a :DataPoint ;
    :xValue "Boston, Massachusetts" ;
    :yValue "12.3" ;
    :belongsTo :Chart .

