@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Most popular domestic summer city destinations for travelers in the United States in 2015" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Share of respondents" .

:YAxis a :Axis ;
    :title "Response" .

:DataPoint1 a :DataPoint ;
    :xValue "0.17" ;
    :yValue "Orlando" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "0.13" ;
    :yValue "Las Vegas" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "0.04" ;
    :yValue "San Francisco" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "0.03" ;
    :yValue "New York City" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "0.03" ;
    :yValue "Miami" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "0.02" ;
    :yValue "Los Angeles" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "0.02" ;
    :yValue "Anaheim" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "0.02" ;
    :yValue "San Diego" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "0.02" ;
    :yValue "New Orleans" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "0.02" ;
    :yValue "Washington DC" ;
    :belongsTo :Chart .
