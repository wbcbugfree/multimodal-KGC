@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Operating expenditure per capita of public libraries in the United States from 2002 to 2013 , by category (in U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Collections expenditure" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2001" ;
    :yValue "5.15" ;
    :belongsTo :Chart .

