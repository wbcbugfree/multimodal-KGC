@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Average annual price of gas oil per metric ton for the manufacturing industry in Great Britain from 2010 to 2019 (in GBP)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Average" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2009" ;
    :yValue "593.6" ;
    :belongsTo :Chart .

