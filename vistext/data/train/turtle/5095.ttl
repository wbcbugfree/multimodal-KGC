@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Average number of employees in retail trade enterprises (except of motor vehicles and motorcycles) in the United Kingdom (UK) from 2008 to 2018 (in 1,000s)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Number of employees in thousands" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2007" ;
    :yValue "3106" ;
    :belongsTo :Chart .

