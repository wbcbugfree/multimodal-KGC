@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Percentage of internet users who watch online video content on any device as of January 2018 , by country" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "Share of internet users" .

