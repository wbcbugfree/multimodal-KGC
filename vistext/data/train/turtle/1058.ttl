@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Number of people injured due to acts of terrorism worldwide from 2007 to 2019" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Number of injured people" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2006" ;
    :yValue "44103" ;
    :belongsTo :Chart .

