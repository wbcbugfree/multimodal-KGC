@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Defense spending in the United Kingdom from 2005/06 to 2018/19 (in billion GBP)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Expenditure in billion GBP" .

:DataPoint1 a :DataPoint ;
    :xValue "2018/19" ;
    :yValue "38.03" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "2017/18" ;
    :yValue "36.6" ;
    :belongsTo :Chart .

