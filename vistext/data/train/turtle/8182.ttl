@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Number of user data requests issued to Facebook from federal and government agencies in Canada as of 1st half 2020" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Percentage of requests where some data produced" .

:YAxis a :Axis ;
    :title "half a year" .

:DataPoint1 a :DataPoint ;
    :xValue "44" ;
    :yValue "H1 '13" ;
    :belongsTo :Chart .

