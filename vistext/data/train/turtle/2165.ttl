@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Household consumption expenditure on clothing in Poland from 2008 to 2019 (in million zloty)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Final consumption expenditure in million zloty" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2007" ;
    :yValue "24366" ;
    :belongsTo :Chart .

