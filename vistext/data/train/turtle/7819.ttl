@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Sawn hardwood balance in Europe from 2009 to 2019 (in 1,000 cubic meters)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Apparent consumption" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2008" ;
    :yValue "12535" ;
    :belongsTo :Chart .

