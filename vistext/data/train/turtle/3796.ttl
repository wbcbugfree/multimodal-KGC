@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Number of enterprises in the manufacture of electric domestic appliances industry in Bulgaria from 2008 to 2017" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Number of enterprises" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2007" ;
    :yValue "42" ;
    :belongsTo :Chart .

