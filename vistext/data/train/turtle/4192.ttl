@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Number of terrorist attacks in the European Union (EU) in 2019 , by member state" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Country" .

:YAxis a :Axis ;
    :title "Number of terrorist attacks" .

:DataPoint1 a :DataPoint ;
    :xValue "United Kingdom" ;
    :yValue "64" ;
    :belongsTo :Chart .

