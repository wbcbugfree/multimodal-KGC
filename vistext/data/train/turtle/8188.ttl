@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Percentage of employees and those self-employed working more than 45 hours per week in the United Kingdom (UK) from 2000 to 2019" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Self-employed" .

