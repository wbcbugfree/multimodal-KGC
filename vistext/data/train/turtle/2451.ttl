@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Average annual household expenditures in Alberta , Canada in 2017 (in Canadian dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "household expenditure type" .

:YAxis a :Axis ;
    :title "Average expenditure in Canadian dollars" .

:DataPoint1 a :DataPoint ;
    :xValue "Shelter" ;
    :yValue "21068" ;
    :belongsTo :Chart .

