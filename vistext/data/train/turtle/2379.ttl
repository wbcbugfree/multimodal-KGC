@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Gross value added (GVA) of retail trade , except of motor vehicles and motorcycles , in the United Kingdom (UK) from 2008 to 2018 (in million GBP)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Gross value added in million GBP" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2007" ;
    :yValue "65123" ;
    :belongsTo :Chart .

