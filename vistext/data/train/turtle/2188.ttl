@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Online poker related keywords ranked by search volume in the United Kingdom (UK) in March 2016 (in 1,000 searches)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "keywords" .

:YAxis a :Axis ;
    :title "Searches in thousands" .

:DataPoint1 a :DataPoint ;
    :xValue "poker" ;
    :yValue "60.5" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "poker hands" ;
    :yValue "33.1" ;
    :belongsTo :Chart .

