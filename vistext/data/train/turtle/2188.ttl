    :xValue "how to play poker" ;
    :yValue "9.9" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "poker rules" ;
    :yValue "8.1" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "free poker" ;
    :yValue "5.4" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "online poker" ;
    :yValue "5.4" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "texas holdem" ;
