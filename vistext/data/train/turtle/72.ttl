@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Number of ESPRIT Shop-in-Stores worldwide in 2019 , by country" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Country" .

:YAxis a :Axis ;
    :title "Number of Shop-in-Stores" .

:DataPoint1 a :DataPoint ;
    :xValue "Germany" ;
    :yValue "1887" ;
    :belongsTo :Chart .

