@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "The most spoken languages worldwide in 2019 (by speakers in millions)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Native speaker in millions" .

:YAxis a :Axis ;
    :title "language" .

:DataPoint1 a :DataPoint ;
    :xValue "1268" ;
    :yValue "English" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "1120" ;
    :yValue "Chinese (Mandarin)" ;
    :belongsTo :Chart .

