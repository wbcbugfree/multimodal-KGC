@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Enterprise-value-to-EBITDA (EV/EBITDA) of leading online marketplaces worldwide from 2020 to 2022" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Factor" .

:YAxis a :Axis ;
    :title "2022*" .

:DataPoint1 a :DataPoint ;
    :xValue "Uber (United States)" ;
    :yValue "56.3" ;
    :belongsTo :Chart .

