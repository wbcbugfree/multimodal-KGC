    :xValue "Dec 31, 2009" ;
    :yValue "1.39" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "Dec 31, 2010" ;
    :yValue "1.39" ;
    :belongsTo :Chart .

