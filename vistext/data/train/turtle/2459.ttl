@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Most popular websites worldwide based on the number of unique visitors via organic search visits in May 2020 (in millions)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Monthly visits in millions" .

:YAxis a :Axis ;
    :title "website" .

:DataPoint1 a :DataPoint ;
    :xValue "5345.57" ;
    :yValue "youtube.com" ;
    :belongsTo :Chart .

