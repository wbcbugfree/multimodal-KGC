@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Number of families living below the poverty line in the U.S. from 1990 to 2019 (in 1,000s)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Number of poor families in thousands" .

