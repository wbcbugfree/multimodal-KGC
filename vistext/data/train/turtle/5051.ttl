@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Most stolen motorcycle makes in the United States in 2019" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "motorcycle make" .

:YAxis a :Axis ;
    :title "Number of thefts" .

