    :xValue "667" ;
    :yValue "Alvin Davis" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "633" ;
    :yValue "Ichiro Suzuki" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "612" ;
    :yValue "Raul Ibanez" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "595" ;
    :yValue "Alex Rodriguez" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
