@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Seattle Mariners all-time RBI (runs batted in) leaders as of October 2020" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Number of home runs" .

:YAxis a :Axis ;
    :title "RBI Leader" .

:DataPoint1 a :DataPoint ;
    :xValue "1261" ;
    :yValue "Edgar Martinez" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "1216" ;
    :yValue "Ken Griffey Jr." ;
    :belongsTo :Chart .

