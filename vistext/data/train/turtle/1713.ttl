@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "What would you like to do when the coronavirus (COVID-19) pandemic will be over ?" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "Share of respondents" .

:DataPoint1 a :DataPoint ;
    :xValue "Meeting with friends" ;
    :yValue "0.31" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Visiting relatives" ;
    :yValue "0.23" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "Eating out" ;
    :yValue "0.1" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "Going to the gym" ;
    :yValue "0.07" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "Taking a short trip" ;
    :yValue "0.052" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Shopping" ;
    :yValue "0.049" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Holidays in Italy" ;
    :yValue "0.049" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Holidays abroad" ;
    :yValue "0.038" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "Going to concerts/cinema/theatre/exhibition" ;
    :yValue "0.038" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "Voluntary work" ;
    :yValue "0.02" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "Going to a sport event" ;
    :yValue "0.01" ;
    :belongsTo :Chart .

:DataPoint12 a :DataPoint ;
    :xValue "Other" ;
    :yValue "0.03" ;
    :belongsTo :Chart .
