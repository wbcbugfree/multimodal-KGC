@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Number of live births in Russia from 2000 to 2019 (in 1,000s)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Number of live births in thousands" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 1999" ;
    :yValue "1266.8" ;
    :belongsTo :Chart .

