@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Electronic Arts ' net income/loss in the fiscal years 2005 to 2020 (in million U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Net income/loss in million U.S. dollars" .

