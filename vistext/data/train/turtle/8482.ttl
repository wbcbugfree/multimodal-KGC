@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Monthly rate of change in foreign exchange earnings from tourism in India from 2015 to 2016 , with estimates until 2019" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Month" .

:YAxis a :Axis ;
    :title "2016" .

:DataPoint1 a :DataPoint ;
    :xValue "De" ;
    :yValue "0.147" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Dec No" ;
    :yValue "0.104" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "Nov Oc" ;
    :yValue "0.118" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "Oct Se" ;
    :yValue "0.109" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "Sep Au" ;
    :yValue "0.07" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Aug Ju" ;
    :yValue "0.128" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Jul Ju" ;
    :yValue "0.059" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Jun Ma" ;
    :yValue "0.029" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "May Ap" ;
    :yValue "0.073" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "Apr Ma" ;
    :yValue "0.087" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "Mar Fe" ;
    :yValue "0.066" ;
    :belongsTo :Chart .

:DataPoint12 a :DataPoint ;
    :xValue "Feb Ja" ;
    :yValue "0.045" ;
