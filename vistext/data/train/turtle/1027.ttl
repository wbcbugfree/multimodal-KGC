@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "African countries with the highest Gross Domestic Product (GDP) per capita in 2019 (in U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Country" .

:YAxis a :Axis ;
    :title "GDP per capita in U.S. dollars" .

:DataPoint1 a :DataPoint ;
