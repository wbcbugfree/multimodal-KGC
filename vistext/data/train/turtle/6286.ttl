@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Major countries in bismuth mine production from 2015 to 2019 (in metric tons)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "2016" .

:YAxis a :Axis ;
    :title "Country" .

:DataPoint1 a :DataPoint ;
    :xValue "7400" ;
    :yValue "China" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "700" ;
    :yValue "Mexico" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "3" ;
    :yValue "Canada" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "40" ;
    :yValue "Russia**" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "2000" ;
    :yValue "Vietnam**" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "10" ;
    :yValue "Bolivia**" ;
    :belongsTo :Chart .
