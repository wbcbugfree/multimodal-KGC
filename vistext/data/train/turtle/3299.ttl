@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Total amount of investments of private equity companies in Austria from 2007 to 2016 (in million euros)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Total investment in million euros" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2006" ;
    :yValue "443.81" ;
    :belongsTo :Chart .

