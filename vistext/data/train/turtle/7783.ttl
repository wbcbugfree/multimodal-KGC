@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Share of companies in the United States with racially and ethnically diverse of CEOs from 2004 to 2018" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "African American" .

