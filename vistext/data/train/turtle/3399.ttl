@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Chicago White Sox all-time hits leaders as of October 2020" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Number of hits" .

:YAxis a :Axis ;
    :title "Chicago White Sox all-time hits leaders" .

:DataPoint1 a :DataPoint ;
