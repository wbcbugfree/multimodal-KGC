@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Worldwide revenue from hardware maintenance and support services between 2005 and 2015 (in million U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Revenue in million U.S. dollars" .

:YAxis a :Axis ;
    :title "Year" .

:DataPoint1 a :DataPoint ;
    :xValue "98985" ;
    :yValue "2015*" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "96022" ;
    :yValue "2014*" ;
    :belongsTo :Chart .

