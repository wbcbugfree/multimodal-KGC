    :xValue "87502" ;
    :yValue "2011*" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "85838" ;
    :yValue "2010" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "84892" ;
    :yValue "2009" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "91106" ;
    :yValue "2008" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "86138" ;
    :yValue "2007" ;
    :belongsTo :Chart .

