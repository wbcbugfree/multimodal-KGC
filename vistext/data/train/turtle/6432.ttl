@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Population in China from 1990 to 2019 , by age group (in millions)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "0-14 years" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 1989" ;
    :yValue "316.59" ;
    :belongsTo :Chart .

