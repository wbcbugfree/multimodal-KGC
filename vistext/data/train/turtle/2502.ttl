@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "U.S. states with the highest number of HIV diagnoses in 2018" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Number of diagnoses" .

:YAxis a :Axis ;
    :title "State" .

:DataPoint1 a :DataPoint ;
    :xValue "4683" ;
    :yValue "Florida" ;
    :belongsTo :Chart .

