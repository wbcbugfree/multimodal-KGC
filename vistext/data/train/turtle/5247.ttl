@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Texas Rangers all-time home run leaders as of October 2020" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "player name" .

:YAxis a :Axis ;
    :title "Number of home runs" .

:DataPoint1 a :DataPoint ;
    :xValue "Juan Gonzalez" ;
    :yValue "372" ;
    :belongsTo :Chart .

