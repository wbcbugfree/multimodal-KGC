@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Natural gas production in the Netherlands from 2006 to 2019 (in billion cubic meters)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Production in billion cubic meters" .

