@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "New York Giants operating income from 2001 to 2019 (in million U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Operating income in million U.S. dollars" .

