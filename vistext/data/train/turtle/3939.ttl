@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Combined desktop and mobile visits to Walmart.com from May 2019 to September 2020 (in millions)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Number of visits in millions" .

:DataPoint1 a :DataPoint ;
    :xValue "Apr 30, 2019" ;
    :yValue "332" ;
    :belongsTo :Chart .

