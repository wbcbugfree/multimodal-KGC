@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Counterfeit euro banknotes withdrawn from circulation globally from the 2nd half of 2014 to the 2nd half of 2019 , by location of counterfeit" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "half a year" .

:YAxis a :Axis ;
    :title "Euro area" .

:DataPoint1 a :DataPoint ;
    :xValue "H2 2019" ;
    :yValue "0.964" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "H1 2019" ;
    :yValue "0.972" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "H2 2018" ;
    :yValue "0.967" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "H1 2018" ;
    :yValue "0.888" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "H2 2017" ;
    :yValue "0.978" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "H1 2017" ;
    :yValue "0.967" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "H2 2016" ;
    :yValue "0.936" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "H1 2016" ;
    :yValue "0.976" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "H2 2015" ;
    :yValue "0.98" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "H1 2015" ;
    :yValue "0.979" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "H2 2014" ;
    :yValue "0.975" ;
