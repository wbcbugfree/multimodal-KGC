@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Manchester United distribution of broadcasting revenue from 2010 to 2020" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Medial rights Premier League matches" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2009" ;
    :yValue "0.513" ;
    :belongsTo :Chart .

