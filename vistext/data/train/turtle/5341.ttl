@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Countries by number of registered ice hockey players in 2018/19" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Number of players" .

:YAxis a :Axis ;
    :title "Country" .

