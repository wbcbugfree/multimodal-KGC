    :yValue "2.73" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Mar 2-8" ;
    :yValue "2.09" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
