@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Online sales growth of fast-moving consumer goods (FMCG) in the view of the coronavirus (COVID-19) in Russia from February 3 to April 12 , 2020 , by product category" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Month" .

:YAxis a :Axis ;
    :title "Pasta" .

:DataPoint1 a :DataPoint ;
    :xValue "Apr 6-12" ;
    :yValue "1.4" ;
    :belongsTo :Chart .

