@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Favorability ratings of NATO , by country in 2012" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "Very/somewhat unfavorable" .

:DataPoint1 a :DataPoint ;
    :xValue "Poland" ;
    :yValue "0.19" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "France" ;
    :yValue "0.31" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "Germany" ;
    :yValue "0.3" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "Britain" ;
    :yValue "0.17" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "Italy" ;
    :yValue "0.25" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "United States" ;
    :yValue "0.22" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Czech Republic" ;
    :yValue "0.37" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Spain" ;
    :yValue "0.46" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "Russia" ;
    :yValue "0.52" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "Greece" ;
    :yValue "0.72" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "Turkey" ;
    :yValue "0.59" ;
    :belongsTo :Chart .
