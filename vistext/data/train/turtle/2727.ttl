@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Number of children in the United States from 1950 to 2050 (in millions)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Number of Children (in millions)" .

:YAxis a :Axis ;
    :title "Year" .

:DataPoint1 a :DataPoint ;
    :xValue "78.2" ;
    :yValue "2050*" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "77.1" ;
    :yValue "2040*" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "75.7" ;
    :yValue "2030*" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "74" ;
    :yValue "2020 *" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "73" ;
    :yValue "2019" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "73.3" ;
    :yValue "2018" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "74.1" ;
    :yValue "2010" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "72.4" ;
    :yValue "2000" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "64.2" ;
    :yValue "1990" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "63.7" ;
    :yValue "1980" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "69.8" ;
    :yValue "1970" ;
    :belongsTo :Chart .

:DataPoint12 a :DataPoint ;
    :xValue "64.5" ;
    :yValue "1960" ;
    :belongsTo :Chart .

:DataPoint13 a :DataPoint ;
    :xValue "47.3" ;
    :yValue "1950" ;
    :belongsTo :Chart .
