@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Number of suicides in Brazil from 2006 to 2017 (in 1,000s)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Number of suicides in thousands" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2005" ;
    :yValue "8.64" ;
    :belongsTo :Chart .

