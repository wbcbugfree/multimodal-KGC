@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Number of stores and companies accepting Bitcoin in Italy as of November 2019 , by region" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Number of stores and companies" .

:YAxis a :Axis ;
    :title "region" .

