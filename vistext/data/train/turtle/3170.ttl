@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Leading exporting countries of woven cotton fabrics worldwide in 2018 (in million U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Trade value in billion U.S. dollars" .

:YAxis a :Axis ;
    :title "Country" .

:DataPoint1 a :DataPoint ;
    :xValue "13799.8" ;
    :yValue "China" ;
    :belongsTo :Chart .

