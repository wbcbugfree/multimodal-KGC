@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Cincinnati Reds all-time RBI (runs batted in) leaders as of October 2020" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "player name" .

:YAxis a :Axis ;
    :title "Number of home runs" .

:DataPoint1 a :DataPoint ;
    :xValue "Johnny Bench" ;
    :yValue "1376" ;
    :belongsTo :Chart .

