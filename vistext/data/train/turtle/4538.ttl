@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Distribution of the leading causes of death in Africa in 2016" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Distribution of causes of death" .

:YAxis a :Axis ;
    :title "syndrome" .

:DataPoint1 a :DataPoint ;
    :xValue "0.104" ;
    :yValue "Lower respiratory infections" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "0.081" ;
    :yValue "HIV/AIDS" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "0.074" ;
    :yValue "Diarrhoeal diseases" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "0.058" ;
    :yValue "Ischaemic heart disease" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "0.046" ;
    :yValue "Malaria" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "0.046" ;
    :yValue "Tuberculosis" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "0.042" ;
