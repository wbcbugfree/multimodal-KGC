    :yValue "Maternal conditions" ;
    :belongsTo :Chart .

:DataPoint13 a :DataPoint ;
    :xValue "0.021" ;
    :yValue "Congenital anomalies" ;
    :belongsTo :Chart .

:DataPoint14 a :DataPoint ;
    :xValue "0.021" ;
    :yValue "Meningitis" ;
    :belongsTo :Chart .

:DataPoint15 a :DataPoint ;
    :xValue "0.02" ;
    :yValue "Cirrhosis of the liver" ;
    :belongsTo :Chart .

:DataPoint16 a :DataPoint ;
    :xValue "0.02" ;
