@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Distribution of countries with largest stock markets worldwide as of January 2020 , by share of total world equity market value" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Market share of total world equity market value" .

:YAxis a :Axis ;
    :title "Country" .

:DataPoint1 a :DataPoint ;
    :xValue "0.545" ;
    :yValue "U.S." ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "0.077" ;
    :yValue "Japan" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "0.051" ;
    :yValue "UK" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "0.04" ;
    :yValue "China" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "0.032" ;
    :yValue "France" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "0.027" ;
    :yValue "Switzerland" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "0.027" ;
    :yValue "Canada" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "0.026" ;
    :yValue "Germany" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "0.022" ;
    :yValue "Australia" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "0.063" ;
    :yValue "Smaller yearbook" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "0.089" ;
    :yValue "Not in yearbook" ;
    :belongsTo :Chart .
