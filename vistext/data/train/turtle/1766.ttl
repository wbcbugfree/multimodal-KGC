@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Footwear production in the United States from 1985 to 2008 (in 1,000s of pairs)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "In thousands of pairs" .

:DataPoint1 a :DataPoint ;
    :xValue "2008*" ;
    :yValue "29103" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "2007" ;
    :yValue "30660" ;
    :belongsTo :Chart .

