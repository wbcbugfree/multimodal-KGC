    :xValue "2004" ;
    :yValue "36698" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "2003" ;
    :yValue "39810" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "2002" ;
    :yValue "61400" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "2001" ;
    :yValue "79718" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
