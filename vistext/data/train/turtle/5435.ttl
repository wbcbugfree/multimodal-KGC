@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "NCAA March Madness basketball tournament TV ratings in 2014 , selected games" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "group name and match" .

:YAxis a :Axis ;
    :title "TV ratings" .

:DataPoint1 a :DataPoint ;
    :xValue "Championship Game - Kentucky vs. Connecticut (Apr. 7)" ;
    :yValue "12.4" ;
    :belongsTo :Chart .

