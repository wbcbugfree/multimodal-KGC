@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Cumulative number of coronavirus-positive (COVID-19) patients confirmed on Diamond Princess cruise ship docked in Japan as of April 16 , 2020" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Number of deaths" .

:YAxis a :Axis ;
    :title "Month" .

:DataPoint1 a :DataPoint ;
    :xValue "13" ;
    :yValue "April 16" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "12" ;
    :yValue "April 11" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "11" ;
    :yValue "April 1" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "10" ;
    :yValue "March 23" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "7" ;
    :yValue "March 18" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "7" ;
    :yValue "March 15" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "7" ;
    :yValue "March 11" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "6" ;
    :yValue "March 6" ;
    :belongsTo :Chart .
