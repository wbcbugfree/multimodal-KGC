@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Length of time respondents think the coronavirus (COVID-19) outbreak will last in their country , worldwide as of March 12 , 2020 , by country" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Longer than a year" .

:YAxis a :Axis ;
    :title "4-5 months" .

:DataPoint1 a :DataPoint ;
    :xValue "0.053" ;
    :yValue "0.11" ;
    :belongsTo :Chart .

