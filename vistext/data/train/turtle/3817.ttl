@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "E-Government Development Index (EGDI) in Russia from 2003 to 2018" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Index score" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2002" ;
    :yValue "0.44" ;
    :belongsTo :Chart .

