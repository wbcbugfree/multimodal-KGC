@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Number of arrivals in tourist accommodation in Lithuania from 2006 to 2018 (in millions)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Number of arrivals in millions" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2005" ;
    :yValue "1.34" ;
    :belongsTo :Chart .

