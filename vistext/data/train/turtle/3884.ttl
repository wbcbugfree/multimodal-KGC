@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Epidemiological surveillance budget in Mexico from 2009 to 2020 (in million Mexican pesos)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Budget in million Mexican pesos" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2008" ;
    :yValue "2159" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Dec 31, 2009" ;
    :yValue "2002" ;
    :belongsTo :Chart .

