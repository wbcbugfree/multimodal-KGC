@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Number of bankruptcies after the coronavirus outbreak in Sweden from February to November 2020 , by industry" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Retail" .

:YAxis a :Axis ;
    :title "Month" .

:DataPoint1 a :DataPoint ;
    :xValue "54" ;
    :yValue "Feb" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "58" ;
    :yValue "Mar" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "88" ;
    :yValue "Apr" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "81" ;
    :yValue "May" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "52" ;
    :yValue "Jun" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "47" ;
    :yValue "Jul" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "33" ;
    :yValue "Aug" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "43" ;
    :yValue "Sep" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "57" ;
    :yValue "Oct" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "52" ;
    :yValue "Nov" ;
    :belongsTo :Chart .
