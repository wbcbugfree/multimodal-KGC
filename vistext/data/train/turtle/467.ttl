@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Number of registered LINE app users in selected countries as of October 2014 (in millions)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Country" .

:YAxis a :Axis ;
    :title "Total registered users in millions" .

:DataPoint1 a :DataPoint ;
    :xValue "Japan" ;
    :yValue "54" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Thailand" ;
    :yValue "33" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "Indonesia" ;
    :yValue "30" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "Spain" ;
    :yValue "18" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "India" ;
    :yValue "18" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Taiwan" ;
    :yValue "17" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Mexico" ;
    :yValue "15" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Korea" ;
    :yValue "14" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "Columbia" ;
    :yValue "11" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "Malaysia" ;
    :yValue "10" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "United States" ;
    :yValue "10" ;
    :belongsTo :Chart .
