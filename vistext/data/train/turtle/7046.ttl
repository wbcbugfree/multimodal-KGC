    :yValue "25-29" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "481.2" ;
    :yValue "30-34" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "316.1" ;
    :yValue "35-39" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "200.5" ;
