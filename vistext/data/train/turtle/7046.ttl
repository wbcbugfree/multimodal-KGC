@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Rates of reported cases of gonorrhea in the United States in 2018 , by age and gender (per 100,000 population)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Men" .

:YAxis a :Axis ;
    :title "Age in years" .

:DataPoint1 a :DataPoint ;
    :xValue "4.8" ;
    :yValue "10-14" ;
    :belongsTo :Chart .

