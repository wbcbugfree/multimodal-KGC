@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Ranking of eSports players in Finland in 2018 , by earnings (in thousand U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Finland Esport Player" .

:YAxis a :Axis ;
    :title "Earnings in thousand U.S. dollars" .

:DataPoint1 a :DataPoint ;
    :xValue "JerAx (Jesse Vainikka)" ;
    :yValue "2290.63" ;
    :belongsTo :Chart .

