@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Consumer price index (CPI) of electricity and other fuels in South Africa from March 2019 to March 2020" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Month" .

:YAxis a :Axis ;
    :title "Consumer price index (Dec 2016 = 100)" .

:DataPoint1 a :DataPoint ;
    :xValue "Feb 28, 2019" ;
    :yValue "109.9" ;
    :belongsTo :Chart .

