@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Number of hotel rooms in France in 2019 , by region" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Number of hotel rooms" .

:YAxis a :Axis ;
    :title "region of France" .

:DataPoint1 a :DataPoint ;
    :xValue "156880" ;
    :yValue "Île-de-France" ;
    :belongsTo :Chart .

