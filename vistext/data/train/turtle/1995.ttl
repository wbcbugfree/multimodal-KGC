@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Change in military spending between 2010 and 2019 , by world region" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Change in military spending" .

:YAxis a :Axis ;
    :title "geographic region" .

:DataPoint1 a :DataPoint ;
    :xValue "0.67" ;
    :yValue "North Africa" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "0.63" ;
    :yValue "Central Asia*" ;
    :belongsTo :Chart .

