@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Highest all-time transfer fees of Dutch football players as of September 2019 (in million euros)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Transfer fee in million euros" .

:YAxis a :Axis ;
    :title "Player" .

:DataPoint1 a :DataPoint ;
    :xValue "85.5" ;
    :yValue "Matthijs de Ligt (19/20)" ;
    :belongsTo :Chart .

