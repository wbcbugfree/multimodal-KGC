@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "U.S. spending on the Iraq war (in billion U.S. dollars) and the number U.S. soldier fatalities from 2003 to 2012" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Expenditure in billion U.S. dollars*" .

:YAxis a :Axis ;
    :title "Year" .

:DataPoint1 a :DataPoint ;
    :xValue "10.1" ;
    :yValue "2012**" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "47.4" ;
    :yValue "2011" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "65.1" ;
    :yValue "2010" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "95.5" ;
    :yValue "2009" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "142.1" ;
    :yValue "2008" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "131.2" ;
    :yValue "2007" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "101.6" ;
    :yValue "2006" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "85.5" ;
    :yValue "2005" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "75.9" ;
    :yValue "2004" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "53" ;
    :yValue "2003" ;
    :belongsTo :Chart .
