@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Mall revenue of Las Vegas Sands worldwide from 2009 to 2019 , by property (in million U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Shoppes at Four Seasons (Macao)" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2008" ;
    :yValue "36.57" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Dec 31, 2009" ;
    :yValue "41.68" ;
    :belongsTo :Chart .

