    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "1362" ;
    :yValue "Diseases of the genitourinary system" ;
    :belongsTo :Chart .

:DataPoint12 a :DataPoint ;
    :xValue "949" ;
    :yValue "Poisoning with medicine and narcotics" ;
    :belongsTo :Chart .

:DataPoint13 a :DataPoint ;
    :xValue "456" ;
    :yValue "Diseases of the musculoskeletal system and connective tissue" ;
    :belongsTo :Chart .

:DataPoint14 a :DataPoint ;
    :xValue "261" ;
    :yValue "Congenital malformations, deformations and chromosomal abnormalities" ;
    :belongsTo :Chart .

:DataPoint15 a :DataPoint ;
    :xValue "302" ;
