@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Number of deaths in Sweden in 2019 , by cause of death" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Number of deaths" .

:YAxis a :Axis ;
    :title "Cause of death" .

:DataPoint1 a :DataPoint ;
    :xValue "28195" ;
    :yValue "Diseases of the circulatory system" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "23453" ;
    :yValue "Neoplasms" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "6154" ;
    :yValue "Diseases of the respiratory system" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "6510" ;
    :yValue "Mental and behavioural disorders" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "5685" ;
    :yValue "Diseases of the nervous system" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "4884" ;
    :yValue "External causes of morbidity and mortality (injuries and poisonings)" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "2931" ;
    :yValue "Diseases of the digestive system" ;
    :belongsTo :Chart .

