@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Death rate in Italy in 2019 , by region (per 1,000 inhabitants)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "region of Italy" .

:YAxis a :Axis ;
    :title "Death rate per thousand inhabitants" .

:DataPoint1 a :DataPoint ;
    :xValue "Liguria" ;
    :yValue "13.8" ;
    :belongsTo :Chart .

