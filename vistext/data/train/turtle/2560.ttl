@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Share of artificial intelligence (AI) research institutions with publications by country as of 2017" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "Share of total number" .

:DataPoint1 a :DataPoint ;
    :xValue "United States" ;
    :yValue "0.43" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Canada" ;
    :yValue "0.08" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "India" ;
    :yValue "0.06" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "China" ;
    :yValue "0.05" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "United Kingdom" ;
    :yValue "0.05" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Brazil" ;
    :yValue "0.04" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Germany" ;
    :yValue "0.03" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Australia" ;
    :yValue "0.03" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "Israel" ;
    :yValue "0.02" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "New Zealand" ;
    :yValue "0.02" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "Others" ;
    :yValue "0.19" ;
    :belongsTo :Chart .
