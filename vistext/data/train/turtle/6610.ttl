@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Rate of coronavirus (COVID-19) tests performed in selected countries between April 1st and November 25 , 2020 (per 100,000 population)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "July 26, 2020" .

:YAxis a :Axis ;
    :title "Country" .

:DataPoint1 a :DataPoint ;
    :xValue "16168.2" ;
    :yValue "United Kingdom" ;
    :belongsTo :Chart .

