@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Average prices for coconut oil worldwide from 2014 to 2025 (in nominal U.S. dollars per mt)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Price in nominal U.S. dollars per metric ton" .

:YAxis a :Axis ;
    :title "Year" .

:DataPoint1 a :DataPoint ;
    :xValue "964" ;
    :yValue "2025*" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "957" ;
    :yValue "2024*" ;
    :belongsTo :Chart .

