@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Number of practicing pharmacists employed in the United Kingdom (UK) from 2002 to 2019" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Number of employees" .

