@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Average monthly income in Belgium from 2007 to 2017 (in euros)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Average monthly income in euros" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2006" ;
    :yValue "2837" ;
    :belongsTo :Chart .

