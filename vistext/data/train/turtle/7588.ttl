@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Monthly job hires and separations in the United States from October 2019 to October 2020 (in millions)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Month" .

:YAxis a :Axis ;
    :title "Hires" .

:DataPoint1 a :DataPoint ;
    :xValue "Oct '20*" ;
    :yValue "5.81" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Sep '20" ;
    :yValue "5.89" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "Aug '20" ;
    :yValue "5.95" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "Jul '20" ;
    :yValue "5.9" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "Jun '20" ;
    :yValue "6.97" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "May '20" ;
    :yValue "7.2" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Apr '20" ;
    :yValue "4.41" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Mar '20" ;
    :yValue "5.11" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "Feb '20" ;
    :yValue "5.86" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "Jan '20" ;
    :yValue "5.93" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "Dec '19" ;
    :yValue "5.93" ;
    :belongsTo :Chart .

:DataPoint12 a :DataPoint ;
    :xValue "Nov '19" ;
    :yValue "5.83" ;
    :belongsTo :Chart .

:DataPoint13 a :DataPoint ;
    :xValue "Oct '19" ;
    :yValue "5.78" ;
    :belongsTo :Chart .
