@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Average in-store merchandise sales of convenience stores in the United States in 2015 , by category (in U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Average sales in U.S. dollars" .

:YAxis a :Axis ;
    :title "category" .

