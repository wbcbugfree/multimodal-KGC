@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Distribution of gross domestic product (GDP) across economic sectors worldwide from 2008 to 2018" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Agriculture" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2007" ;
    :yValue "0.0374" ;
    :belongsTo :Chart .

