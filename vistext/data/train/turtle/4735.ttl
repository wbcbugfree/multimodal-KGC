@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Export volume of broiler meat worldwide in 2020 , by leading country (in 1,000 metric tons)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Export volume in thousand metric tons" .

:YAxis a :Axis ;
    :title "Country" .

:DataPoint1 a :DataPoint ;
    :xValue "3875" ;
    :yValue "Brazil" ;
    :belongsTo :Chart .

