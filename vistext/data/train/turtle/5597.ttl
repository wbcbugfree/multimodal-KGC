@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Most popular payment methods for everyday transactions according to internet users worldwide as of June 2018" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "Share of respondents" .

:DataPoint1 a :DataPoint ;
    :xValue "In-store" ;
    :yValue "0.41" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Other online" ;
    :yValue "0.14" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "Buy buttons" ;
    :yValue "0.09" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "Other mobile transfers" ;
    :yValue "0.08" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "P2P transfer" ;
    :yValue "0.07" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Mobile messenger apps" ;
    :yValue "0.07" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "QR codes" ;
    :yValue "0.05" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Other in-app payments" ;
    :yValue "0.04" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "Smart home device" ;
    :yValue "0.02" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "Wearables / contactless" ;
    :yValue "0.02" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "Other" ;
    :yValue "0.02" ;
    :belongsTo :Chart .
