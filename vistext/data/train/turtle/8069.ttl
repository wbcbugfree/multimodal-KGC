@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Number of travel goods sold in the United States from 2003 to 2019 , by category (in million units)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Luggage" .

