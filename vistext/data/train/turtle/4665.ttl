@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Leading hard coal producing countries worldwide in 2018 (in million metric tons)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Country" .

:YAxis a :Axis ;
    :title "Production in million metric tons" .

:DataPoint1 a :DataPoint ;
    :xValue "China" ;
    :yValue "3530" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "India" ;
    :yValue "730.3" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "United States" ;
    :yValue "634.2" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "Indonesia" ;
    :yValue "497.8" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "Australia" ;
    :yValue "452.8" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Russia" ;
    :yValue "352.6" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "South Africa" ;
    :yValue "253.3" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Kazakhstan" ;
    :yValue "111.9" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "Colombia" ;
    :yValue "84.3" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "Poland" ;
    :yValue "63.6" ;
    :belongsTo :Chart .
