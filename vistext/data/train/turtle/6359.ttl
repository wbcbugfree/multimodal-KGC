@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "U.S. lemon imports and domestic exports from 1999 to 2017 (in metric tons)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Domestic exports" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 1998" ;
    :yValue "106249" ;
    :belongsTo :Chart .

