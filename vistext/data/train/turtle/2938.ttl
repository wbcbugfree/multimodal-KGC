    :xValue "Oregon" ;
    :yValue "666403" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Illinois" ;
    :yValue "401350" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Ohio" ;
