@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Top 10 U.S. states based on production of principal vegetables for processing in 2016 (in tons)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "State" .

:YAxis a :Axis ;
    :title "Production in tons" .

:DataPoint1 a :DataPoint ;
    :xValue "California" ;
    :yValue "13571200" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Washington" ;
    :yValue "1500790" ;
    :belongsTo :Chart .

