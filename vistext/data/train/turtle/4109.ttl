@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Forecast office properties vacancy rate in London (UK) from 2006 to 2019" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Office vacancy rate" .

:DataPoint1 a :DataPoint ;
    :xValue "2019*" ;
    :yValue "0.044" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "2018*" ;
    :yValue "0.046" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "2017*" ;
    :yValue "0.046" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "2016*" ;
    :yValue "0.053" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "2015*" ;
    :yValue "0.054" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "2014*" ;
    :yValue "0.061" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "2013" ;
    :yValue "0.07" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "2012" ;
    :yValue "0.072" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "2011" ;
    :yValue "0.073" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "2010" ;
    :yValue "0.081" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "2009" ;
    :yValue "0.102" ;
    :belongsTo :Chart .

:DataPoint12 a :DataPoint ;
    :xValue "2008" ;
    :yValue "0.082" ;
    :belongsTo :Chart .

:DataPoint13 a :DataPoint ;
    :xValue "2007" ;
    :yValue "0.062" ;
    :belongsTo :Chart .

:DataPoint14 a :DataPoint ;
    :xValue "2006" ;
    :yValue "0.065" ;
    :belongsTo :Chart .
