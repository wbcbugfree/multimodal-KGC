@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Population of the world 's continents from 1950 to 2020 (in millions)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Europe" .

