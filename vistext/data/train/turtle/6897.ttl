@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Voter turnout rates among selected age groups in U.S. midterm elections from 1966 to 2018" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "65+" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 1965" ;
    :yValue "0.561" ;
    :belongsTo :Chart .

