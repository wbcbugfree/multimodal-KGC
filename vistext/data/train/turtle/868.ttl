@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Enrollment in public elementary and secondary schools in Canada in 2018/19 , by grade" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "educational year" .

:YAxis a :Axis ;
    :title "Number of students" .

:DataPoint1 a :DataPoint ;
    :xValue "Junior Kindergarten" ;
    :yValue "156282" ;
    :belongsTo :Chart .

