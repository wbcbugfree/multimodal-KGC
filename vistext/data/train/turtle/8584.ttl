@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Synthetic resins , rubbers , and fibers import and export value from Canada from 2009 to 2019 (in million Canadian dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Synthetic resins and rubbers (exports)" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2008" ;
    :yValue "4782" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Dec 31, 2009" ;
    :yValue "5540" ;
    :belongsTo :Chart .

