@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Forecast of population growth in Iceland from 2020 to 2030" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Number of inhabitants" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2019" ;
    :yValue "363786" ;
    :belongsTo :Chart .

