@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Average travel expenditure of Germans per person and per trip from 2000 to 2019 (in euros)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Expenditure per person and per trip in euros" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 1999" ;
    :yValue "792" ;
    :belongsTo :Chart .

