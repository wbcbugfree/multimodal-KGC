@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Most read newspapers in Italy in 2nd quarter of 2019 , by readership (in 1,000s)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Number of readers in thousands" .

:YAxis a :Axis ;
    :title "daily newspaper" .

:DataPoint1 a :DataPoint ;
    :xValue "3318" ;
    :yValue "Gazzetta dello Sport" ;
    :belongsTo :Chart .

