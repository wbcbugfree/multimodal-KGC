@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Estimated Gross Domestic Product of small businesses and large businesses in the United States in 2010 , by industry (in million U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "industry" .

:YAxis a :Axis ;
    :title "Small business GDP" .

:DataPoint1 a :DataPoint ;
    :xValue "Mining & Manufacturing" ;
    :yValue "534845" ;
    :belongsTo :Chart .

