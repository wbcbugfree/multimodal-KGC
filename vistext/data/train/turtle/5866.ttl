@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Leading producers of fresh vegetables worldwide in 2018 (in million metric tons)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Production in million metric tons" .

:YAxis a :Axis ;
    :title "Country" .

:DataPoint1 a :DataPoint ;
    :xValue "548.99" ;
    :yValue "China, mainland" ;
    :belongsTo :Chart .

