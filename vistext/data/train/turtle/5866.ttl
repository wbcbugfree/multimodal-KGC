    :xValue "128.24" ;
    :yValue "India" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "31.74" ;
    :yValue "United States of America" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "24.14" ;
    :yValue "Turkey" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "16.39" ;
    :yValue "Nigeria" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "16.32" ;
    :yValue "Viet Nam" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "16.17" ;
    :yValue "Mexico" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "15.57" ;
    :yValue "Egypt" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "15.07" ;
