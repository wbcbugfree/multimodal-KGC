@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Number of coronavirus (COVID-19) cases in Sweden in 2020 , by country of infection (as of March 26 , 2020)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Country" .

:YAxis a :Axis ;
    :title "Number of cases" .

