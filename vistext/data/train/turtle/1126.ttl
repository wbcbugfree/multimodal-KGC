@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Brand value of the leading personal care brands worldwide in 2020 (in million U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Brand value in Million U.S. dollars" .

:YAxis a :Axis ;
    :title "Brand (Company)" .

:DataPoint1 a :DataPoint ;
    :xValue "29468" ;
    :yValue "L'Oréal Paris" ;
    :belongsTo :Chart .

