@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Average length of holiday trips taken by German travelers from 1997 to 2019 (in days)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Length of travel in days" .

