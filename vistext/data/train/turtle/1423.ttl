@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "In your opinion , which is the country with the worst tourists ?" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Share of respondents" .

:YAxis a :Axis ;
    :title "Response" .

:DataPoint1 a :DataPoint ;
    :xValue "0.2" ;
    :yValue "United States" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "0.15" ;
    :yValue "China" ;
    :belongsTo :Chart .

