@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Number of companies declared bankrupt in Spain from 2005 to 2019" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Number of companies" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2004" ;
    :yValue "927" ;
    :belongsTo :Chart .

