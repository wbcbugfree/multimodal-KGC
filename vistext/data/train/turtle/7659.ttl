@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Revenue of Sotheby 's worldwide from 2009 to 2017 , by country (in million U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "China*" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2008" ;
    :yValue "50.06" ;
    :belongsTo :Chart .

