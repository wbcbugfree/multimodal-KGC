@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Countries with the lowest literacy rates worldwide as of 2012" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Percentage of population aged 15 and over" .

:YAxis a :Axis ;
    :title "Response" .

:DataPoint1 a :DataPoint ;
    :xValue "0.29" ;
    :yValue "Burkina Faso" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "0.33" ;
    :yValue "Mali" ;
    :belongsTo :Chart .

