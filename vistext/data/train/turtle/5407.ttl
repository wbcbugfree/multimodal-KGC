@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Percentage of youth population (up to 14 years old) in Italy from 2009 to 2020" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "Share of young population" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2008" ;
    :yValue "0.141" ;
    :belongsTo :Chart .

