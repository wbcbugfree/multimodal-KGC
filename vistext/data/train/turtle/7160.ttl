    :xValue "0.13" ;
    :yValue "Germany" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "0.25" ;
    :yValue "Italy" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "0.2" ;
    :yValue "Japan" ;
    :belongsTo :Chart .

