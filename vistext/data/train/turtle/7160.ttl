@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Percentage of respondents worldwide who were concerned about the COVID-19 situation in their country as of March 12 , 2020 , by country" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Extremely concerned" .

:YAxis a :Axis ;
    :title "Response" .

:DataPoint1 a :DataPoint ;
    :xValue "0.19" ;
    :yValue "All" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "0.23" ;
    :yValue "Australia" ;
    :belongsTo :Chart .

