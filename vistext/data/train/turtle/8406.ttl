@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "St. Kitts and Nevis : Share of economic sectors in gross domestic product (GDP) from 2009 to 2019" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Industry" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2008" ;
    :yValue "0.2345" ;
    :belongsTo :Chart .

