@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Top grossing iPhone mobile gaming apps in the United States as of October 2020 , ranked by daily revenue (in U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Daily revenue in U.S. dollars" .

:YAxis a :Axis ;
    :title "Mobile game" .

:DataPoint1 a :DataPoint ;
    :xValue "2511808" ;
    :yValue "Roblox" ;
    :belongsTo :Chart .

