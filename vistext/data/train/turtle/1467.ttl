@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Percentage of refugee status claims accepted by the Immigration and Refugee Board of Canada from 2000 to 2014" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Percent of claims accepted" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 1999" ;
    :yValue "0.48" ;
    :belongsTo :Chart .

