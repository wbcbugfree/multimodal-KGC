@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Number of Distance Selling/Mail Order pharmacies in England from 2008/09 to 2018/19" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Number of pharmacies" .

:DataPoint1 a :DataPoint ;
    :xValue "2018-19" ;
    :yValue "349" ;
    :belongsTo :Chart .

