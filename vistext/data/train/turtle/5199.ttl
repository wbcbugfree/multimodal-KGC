@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Average annual household expenditures in Ontario , Canada in 2017 (in Canadian dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Average expenditure in Canadian dollars" .

:YAxis a :Axis ;
    :title "type of expenditure" .

:DataPoint1 a :DataPoint ;
    :xValue "20806" ;
    :yValue "Shelter" ;
    :belongsTo :Chart .

