@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Number of reported criminal offences in Denmark from 2009 to 2019" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Number of reported criminal offences" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2008" ;
    :yValue "562406" ;
    :belongsTo :Chart .

