@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Share of population using mobile broadband in Eastern Europe as of February 2014" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "Share of population" .

