@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Number of enterprises providing residential care activities for the elderly and disabled in the United Kingdom (UK) from 2019 to 2020 , by turnover size band" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Turnover in GBP" .

:YAxis a :Axis ;
    :title "2020" .

:DataPoint1 a :DataPoint ;
    :xValue "£0 - £49,99" ;
    :yValue "65" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "£0 - £49,999 £50,000 - £99,99" ;
    :yValue "240" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "£50,000 - £99,999 £100,000 - £249,99" ;
    :yValue "280" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "£100,000 - £249,999 £250,000 - £499,99" ;
    :yValue "300" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "£250,000 - £499,999 £500,000 - £999,99" ;
    :yValue "450" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "£500,000 - £999,999 £1 million - £1.999 millio" ;
    :yValue "950" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "£1 million - £1.999 million £2 million - £4.999 millio" ;
    :yValue "865" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "£2 million - £4.999 million £5 million - £9.999 millio" ;
    :yValue "195" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "£5 million - £9.999 million £10 million - £49.999 millio" ;
    :yValue "115" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "£10 million - £49.999 million £50 million" ;
    :yValue "20" ;
    :belongsTo :Chart .
