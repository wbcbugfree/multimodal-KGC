    :yValue "Pfizer" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "9.4" ;
    :yValue "Bristol-Myers Squibb" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "7.6" ;
    :yValue "GlaxoSmithKline" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
