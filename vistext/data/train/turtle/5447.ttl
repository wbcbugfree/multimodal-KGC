@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Global top 10 pharmaceutical companies based on projected R & D spending in 2026 (in billion U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "R&D spending in billion U.S. dollars" .

:YAxis a :Axis ;
    :title "business" .

:DataPoint1 a :DataPoint ;
    :xValue "12.9" ;
    :yValue "Roche" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "11" ;
    :yValue "Merck & Co" ;
    :belongsTo :Chart .

