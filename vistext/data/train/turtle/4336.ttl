@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Number of users of leading social networking sites in the Asia Pacific region as of March 2013 , by country or region (in millions)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Country and social network" .

:YAxis a :Axis ;
    :title "Number of registered users (in millions)" .

:DataPoint1 a :DataPoint ;
    :xValue "China (QZone)" ;
    :yValue "598" ;
    :belongsTo :Chart .

