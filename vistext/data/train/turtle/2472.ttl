@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Net profit of the Agricultural Bank of China from 2008 to 2019 (in billion yuan)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Profit in billion yuan" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2006" ;
    :yValue "43.8" ;
    :belongsTo :Chart .

