@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "The 20 countries with the highest fertility rates in 2017" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Country" .

:YAxis a :Axis ;
    :title "Number of children per woman" .

:DataPoint1 a :DataPoint ;
    :xValue "Niger" ;
    :yValue "6.49" ;
    :belongsTo :Chart .

