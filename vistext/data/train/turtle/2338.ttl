@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Number of motor vehicle thefts in Canada in 2019 , by province or territory" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Number of motor vehicle thefts" .

:YAxis a :Axis ;
    :title "province or territory" .

:DataPoint1 a :DataPoint ;
    :xValue "23992" ;
    :yValue "Ontario" ;
    :belongsTo :Chart .

