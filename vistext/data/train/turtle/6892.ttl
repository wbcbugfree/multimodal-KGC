@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Crime rate per 1,000 population in the United Kingdom from 2002/03 to 2019/20 , by country" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

