    :yValue "664" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Dec 31, 2010" ;
    :yValue "633" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Dec 31, 2011" ;
    :yValue "631" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Dec 31, 2012" ;
    :yValue "647" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
