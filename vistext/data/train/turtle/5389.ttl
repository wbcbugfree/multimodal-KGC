@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Average issue readership of FourFourTwo magazine in the United Kingdom (UK) from 2006 to 2016 (in 1,000 readers)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "AIR in thousands*" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2005" ;
    :yValue "554" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Dec 31, 2006" ;
    :yValue "619" ;
    :belongsTo :Chart .

