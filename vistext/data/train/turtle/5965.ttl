@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Percentage of U.S. population with dental benefits from 2006 to 2016" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "Percentage of population" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2005" ;
    :yValue "0.57" ;
    :belongsTo :Chart .

