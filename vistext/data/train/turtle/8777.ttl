    :yValue "Jul" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "820.02" ;
    :yValue "Jun" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "894.61" ;
