@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Number of tourist arrivals in Egypt from 2012 to 2018 , by month (in1,000s)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "2015" .

:YAxis a :Axis ;
    :title "Month" .

:DataPoint1 a :DataPoint ;
    :xValue "440.05" ;
    :yValue "Dec" ;
    :belongsTo :Chart .

