@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Expenditure of the German Bundesliga from 2008/09 to 2018/19 , by segment (in million euros)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Payroll costs for match operations" .

:YAxis a :Axis ;
    :title "Year" .

