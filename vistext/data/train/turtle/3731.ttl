@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Total number of employees working in insurance companies in France from 2004 to 2018" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Number of employees" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2003" ;
    :yValue "138000" ;
    :belongsTo :Chart .

