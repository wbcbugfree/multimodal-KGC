@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Total charitable donations in Canada in 2018 , by province (in 1,000 Canadian dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "province of Canada" .

:YAxis a :Axis ;
    :title "Total donations in 1,000 Canadian dollars" .

:DataPoint1 a :DataPoint ;
    :xValue "Ontario" ;
    :yValue "4330225" ;
    :belongsTo :Chart .

