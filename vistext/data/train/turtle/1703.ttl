@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Share of individuals using the internet in Italy from 2006 to 2019" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "Share of individuals" .

