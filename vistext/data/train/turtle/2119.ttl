    :xValue "0.0066" ;
    :yValue "2008**" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "0.0058" ;
    :yValue "2007 *" ;
    :belongsTo :Chart .

:DataPoint12 a :DataPoint ;
    :xValue "0.0056" ;
    :yValue "2006 *" ;
    :belongsTo :Chart .

:DataPoint13 a :DataPoint ;
    :xValue "0.0058" ;
    :yValue "2005" ;
    :belongsTo :Chart .

:DataPoint14 a :DataPoint ;
    :xValue "0.0053" ;
    :yValue "2004 *" ;
    :belongsTo :Chart .

:DataPoint15 a :DataPoint ;
    :xValue "0.0055" ;
    :yValue "2003" ;
