    :xValue "0.0083" ;
    :yValue "2014" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "0.0081" ;
    :yValue "2013" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "0.007" ;
    :yValue "2012" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "0.0067" ;
    :yValue "2011" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "0.006" ;
    :yValue "2010 *" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "0.0063" ;
    :yValue "2009 *" ;
    :belongsTo :Chart .

