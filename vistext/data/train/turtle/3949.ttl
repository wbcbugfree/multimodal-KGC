@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Annual turnover of the repair of motor vehicles and motorcycles industry in France from 2008 to 2017 (in million euros)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Annual turnover in million euros" .

