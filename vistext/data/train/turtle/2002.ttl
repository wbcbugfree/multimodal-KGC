@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Population aged 15 years and over in South Korea in 2019 , by province (in millions)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Population in millions" .

:YAxis a :Axis ;
    :title "province of South Korea" .

