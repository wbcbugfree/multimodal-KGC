@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Albania : Budget balance between 2009 to 2025 in relation to GDP" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Budget balance in relation to GDP" .

:DataPoint1 a :DataPoint ;
    :xValue "2025*" ;
    :yValue "-0.0193" ;
    :belongsTo :Chart .

