@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Statutory health insurances spending for medical treatment in Germany from 2000 to 2019 (in billion euros)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Spending in billion euros" .

