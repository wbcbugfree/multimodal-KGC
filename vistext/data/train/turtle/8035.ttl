@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Number of people shot to death by the police in the United States from 2017 to November 2020 , by month" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "2017" .

:YAxis a :Axis ;
    :title "Month" .

:DataPoint1 a :DataPoint ;
    :xValue "92" ;
    :yValue "Jan" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "100" ;
    :yValue "Feb" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "76" ;
    :yValue "Mar" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "67" ;
    :yValue "Apr" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "74" ;
    :yValue "May" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "84" ;
    :yValue "Jun" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "94" ;
    :yValue "Jul" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "82" ;
    :yValue "Aug" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "70" ;
    :yValue "Sep" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "85" ;
    :yValue "Oct" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "84" ;
    :yValue "Nov" ;
    :belongsTo :Chart .

:DataPoint12 a :DataPoint ;
    :xValue "78" ;
    :yValue "Dec" ;
    :belongsTo :Chart .
