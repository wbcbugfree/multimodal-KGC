    :xValue "Dec 31, 1989" ;
    :yValue "12.7" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Dec 31, 1999" ;
    :yValue "25.5" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Dec 31, 2008" ;
    :yValue "45.4" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Dec 31, 2013" ;
