@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "U.S. health investment in selected years between 1960 and 2017 , by section (in billion U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Research*" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 1959" ;
    :yValue "7" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Dec 31, 1969" ;
    :yValue "2" ;
    :belongsTo :Chart .

