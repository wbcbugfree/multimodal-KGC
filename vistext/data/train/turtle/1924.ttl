@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "For your most recent solo trip , what was your inspiration or motivation for traveling ?" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "Share of respondents" .

:DataPoint1 a :DataPoint ;
    :xValue "To go somewhere I wanted to go" ;
    :yValue "0.45" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "A trip just for me/to treat myself" ;
    :yValue "0.35" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "Time for personal reflection" ;
    :yValue "0.18" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "To pursue a hobby or interest" ;
    :yValue "0.17" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "To learn something new" ;
    :yValue "0.12" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "To do something on my bucket list" ;
    :yValue "0.1" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "To explore a passion" ;
    :yValue "0.08" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "To meet new people" ;
    :yValue "0.07" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "A spiritual opportunity" ;
    :yValue "0.05" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "To make new friends" ;
    :yValue "0.03" ;
    :belongsTo :Chart .
