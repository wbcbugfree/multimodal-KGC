@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Top ten origin countries of Temporary Foreign Worker Program permit holders in Canada in 2019" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Country" .

:YAxis a :Axis ;
    :title "Number of permit holders" .

:DataPoint1 a :DataPoint ;
    :xValue "Mexico" ;
    :yValue "30960" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "India" ;
    :yValue "12015" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "Guatemala" ;
    :yValue "11935" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "Jamaica" ;
    :yValue "10325" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "Philippines" ;
    :yValue "10100" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Korea, Republic of" ;
    :yValue "2565" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "United States of America" ;
    :yValue "1635" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "China, People's Republic of" ;
    :yValue "1340" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "France" ;
    :yValue "1150" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "United Kingdom and Overseas Territories" ;
    :yValue "930" ;
    :belongsTo :Chart .
