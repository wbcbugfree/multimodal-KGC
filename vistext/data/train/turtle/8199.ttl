@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Products and services people spend more than usual on due to the COVID-19 / coronavirus pandemic in the United States , United Kingdom and Germany 2020 (as of May 31)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "United Kingdom" .

:YAxis a :Axis ;
    :title "Response" .

:DataPoint1 a :DataPoint ;
    :xValue "0.36" ;
    :yValue "Health and hygiene (e.g. medicine, hand sanitizer)" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "0.3" ;
    :yValue "Household cleaning products" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "0.32" ;
    :yValue "Food and drinks (e.g. shopping, takeaways, delivery)" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "0.21" ;
    :yValue "Home entertainment (e.g. video, games, books)" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "0.16" ;
    :yValue "Hobbies" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "0.25" ;
    :yValue "Housing, energy, maintenance (e.g. electricity, waste disposal, DIY)" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "0.07" ;
    :yValue "Consumer electronics, household appliances, furniture" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "0.05" ;
    :yValue "Clothing" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "0.05" ;
    :yValue "Investments" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "0.01" ;
    :yValue "Going out (e.g. restaurants, cinemas, pubs / bars)" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "0.02" ;
    :yValue "Insurance" ;
    :belongsTo :Chart .

:DataPoint12 a :DataPoint ;
    :xValue "0.03" ;
    :yValue "Childcare" ;
    :belongsTo :Chart .

:DataPoint13 a :DataPoint ;
    :xValue "0.02" ;
    :yValue "Services (e.g. hairdresser)" ;
    :belongsTo :Chart .

:DataPoint14 a :DataPoint ;
    :xValue "0.01" ;
    :yValue "Travel (e.g. public transport, vacations)" ;
    :belongsTo :Chart .
