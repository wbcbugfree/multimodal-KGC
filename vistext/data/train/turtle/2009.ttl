@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Forecast of the life expectancy at birth in the Netherlands from 2015 to 2060 (in years)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Life expectancy in years" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2014" ;
    :yValue "81.82" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Dec 31, 2019" ;
    :yValue "82.49" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "Dec 31, 2024" ;
    :yValue "83.23" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "Dec 31, 2029" ;
    :yValue "83.98" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "Dec 31, 2034" ;
    :yValue "84.77" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Dec 31, 2039" ;
    :yValue "85.58" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Dec 31, 2044" ;
    :yValue "86.35" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Dec 31, 2049" ;
    :yValue "87.09" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "Dec 31, 2054" ;
    :yValue "87.79" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "Dec 31, 2059" ;
    :yValue "88.46" ;
    :belongsTo :Chart .
