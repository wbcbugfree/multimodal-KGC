@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Advertising and promotion expenditure of the LVMH Group worldwide from 2008 to 2019 (in million euros)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Ad spend in million euros" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2007" ;
    :yValue "2031" ;
    :belongsTo :Chart .

