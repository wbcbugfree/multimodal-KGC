@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Percentage of women in corporate boards worldwide in 2013" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Proportion of women" .

:YAxis a :Axis ;
    :title "Country" .

:DataPoint1 a :DataPoint ;
    :xValue "0.34" ;
    :yValue "Norway" ;
    :belongsTo :Chart .

