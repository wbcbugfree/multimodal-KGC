@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Share of people with public health insurance in the United States from 1997 to June 2019" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "Share of population" .

:DataPoint1 a :DataPoint ;
    :xValue "2019*" ;
    :yValue "0.374" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "2018" ;
    :yValue "0.367" ;
    :belongsTo :Chart .

