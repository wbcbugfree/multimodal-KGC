@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Switching preference of smartphone brands across India as of April 2020" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Share of respondents" .

:YAxis a :Axis ;
    :title "Response" .

:DataPoint1 a :DataPoint ;
    :xValue "0.237" ;
    :yValue "Samsung" ;
    :belongsTo :Chart .

