@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Net sales of Samsonite in Europe from 2010 to 2019 , by country (in million U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Belgium" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2009" ;
    :yValue "51" ;
    :belongsTo :Chart .

