@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "U.S. imports of corn from 2001 to 2019 (in million bushels)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Imports in million bushels" .

:DataPoint1 a :DataPoint ;
    :xValue "2019**" ;
    :yValue "28" ;
    :belongsTo :Chart .

