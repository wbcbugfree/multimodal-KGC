@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "PC penetration per capita in Eastern Europe from 2000 to 2015 (in percent)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Penetration in percent" .

:DataPoint1 a :DataPoint ;
    :xValue "2015*" ;
    :yValue "0.23" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "2014*" ;
    :yValue "0.21" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "2013*" ;
    :yValue "0.19" ;
    :belongsTo :Chart .

