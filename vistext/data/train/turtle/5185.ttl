@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Leading internet billionaires as of March 2020 , by net worth (in billion U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Net worth in billion U.S. dollars" .

:YAxis a :Axis ;
    :title "Internet billionaire" .

:DataPoint1 a :DataPoint ;
    :xValue "113" ;
    :yValue "Jeff Bezos, Amazon" ;
    :belongsTo :Chart .

