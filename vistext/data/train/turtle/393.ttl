@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Toyota 's research and development (R & D) expenses from FY 2007 to FY 2020 (in billion Japanese yen)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Financial year" .

:YAxis a :Axis ;
    :title "R&D spending in billion Japanese yen" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2006" ;
    :yValue "890.78" ;
    :belongsTo :Chart .

