@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Number of U.S. presidents born in each state , from those elected between 1789 and 2021" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "State" .

:YAxis a :Axis ;
    :title "Number of presidents" .

:DataPoint1 a :DataPoint ;
    :xValue "Virginia" ;
    :yValue "8" ;
    :belongsTo :Chart .

