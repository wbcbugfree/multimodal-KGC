@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Quarterly Household Final Consumption Expenditure (HFCE) at current prices in Australia in Q4 2019 , by type (in million Australian dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Unnamed: 2" .

:YAxis a :Axis ;
    :title "household consumption type" .

:DataPoint1 a :DataPoint ;
    :xValue "5" ;
    :yValue "Rent and other dwelling services" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "13" ;
    :yValue "Recreation and culture" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "1" ;
    :yValue "Food" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "16" ;
    :yValue "Insurance and other financial services" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "15" ;
    :yValue "Hotels, cafes and restaurants" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "8" ;
    :yValue "Health" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "17" ;
    :yValue "Other goods and services" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "10" ;
    :yValue "Operation of vehicles" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "14" ;
    :yValue "Education services" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "7" ;
    :yValue "Furnishings and household equipment" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "4" ;
    :yValue "Clothing and footwear" ;
    :belongsTo :Chart .

:DataPoint12 a :DataPoint ;
    :xValue "11" ;
    :yValue "Transport services" ;
    :belongsTo :Chart .

:DataPoint13 a :DataPoint ;
    :xValue "6" ;
    :yValue "Electricity, gas and other fuel" ;
    :belongsTo :Chart .

:DataPoint14 a :DataPoint ;
    :xValue "9" ;
    :yValue "Purchase of vehicles" ;
    :belongsTo :Chart .

:DataPoint15 a :DataPoint ;
    :xValue "3" ;
    :yValue "Alcoholic beverages" ;
    :belongsTo :Chart .

:DataPoint16 a :DataPoint ;
    :xValue "2" ;
    :yValue "Cigarettes and tobacco" ;
    :belongsTo :Chart .

:DataPoint17 a :DataPoint ;
    :xValue "12" ;
    :yValue "Communication" ;
    :belongsTo :Chart .

:DataPoint18 a :DataPoint ;
