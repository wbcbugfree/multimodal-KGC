@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Leading financial centers globally as of March 2020" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "State" .

:YAxis a :Axis ;
    :title "Points on the Global Financial Centres Index" .

