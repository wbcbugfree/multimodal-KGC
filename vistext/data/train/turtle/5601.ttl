@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Revenue of Vodafone Germany from the financial year 2008/09 to 2019/20 (in billion euros)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Revenue in billion euros" .

:YAxis a :Axis ;
    :title "financial years" .

:DataPoint1 a :DataPoint ;
    :xValue "10.7" ;
    :yValue "2019/20" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "10.31" ;
    :yValue "2018/19" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "10.26" ;
    :yValue "2017/18" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "10.01" ;
    :yValue "2016/17**" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "10.63" ;
    :yValue "2015/16" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "10.68" ;
    :yValue "2014/15" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "9.82" ;
    :yValue "2013/14*" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "9.64" ;
    :yValue "2012/13" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "9.55" ;
    :yValue "2011/12" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "9.29" ;
    :yValue "2010/11" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "9.04" ;
    :yValue "2009/10" ;
    :belongsTo :Chart .

:DataPoint12 a :DataPoint ;
    :xValue "9.41" ;
    :yValue "2008/09" ;
    :belongsTo :Chart .
