@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Average age of cars on the road in the United Kingdom (UK) between 2000 and 2016" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Average age" .

:YAxis a :Axis ;
    :title "Year" .

:DataPoint1 a :DataPoint ;
    :xValue "7.7" ;
    :yValue "2016*" ;
    :belongsTo :Chart .

