@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "The Bahamas : Share of economic sectors in the gross domestic product (GDP) from 2008 to 2018" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Services" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2007" ;
    :yValue "0.8117" ;
    :belongsTo :Chart .

