@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Number of wildfires in South America from January to August 2020 , by country or territory" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Number of wildfires" .

:YAxis a :Axis ;
    :title "Country" .

:DataPoint1 a :DataPoint ;
    :xValue "74119" ;
    :yValue "Brazil" ;
    :belongsTo :Chart .

