@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Number of households in the United States from 1970 to 2020 , by size of household (in millions)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Six persons" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 1969" ;
    :yValue "3.5" ;
    :belongsTo :Chart .

