@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Black and slave population of the United States from 1790 to 1880" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Total" .

