@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Pineapple production worldwide from 2002 to 2018 (in million metric tons)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Production in million metric tons" .

