@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Consumption of nonsteroidal anti-inflammatory and antirheumatic products per 1,000 inhabitants per day in Spain from 2004 to 2018" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Defined daily dosage per thousand inhabitants" .

:DataPoint1 a :DataPoint ;
    :xValue "2018*" ;
    :yValue "42.4" ;
    :belongsTo :Chart .

