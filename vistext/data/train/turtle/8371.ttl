@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Projected annual growth of revenue ton miles (RTM) of U.S. commercial air carriers from 2011 to 2040" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Domestic" .

:DataPoint1 a :DataPoint ;
    :xValue "2020-2040**" ;
    :yValue "0.019" ;
    :belongsTo :Chart .

