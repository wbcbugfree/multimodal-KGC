@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Largest advertising markets worldwide in 2019 (in million U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Country" .

:YAxis a :Axis ;
    :title "Advertising revenue in million U.S. dollars" .

:DataPoint1 a :DataPoint ;
    :xValue "China" ;
    :yValue "4841" ;
    :belongsTo :Chart .

