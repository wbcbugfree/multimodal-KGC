    :xValue "Philippines" ;
    :yValue "953" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Canada" ;
    :yValue "605" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Australia" ;
    :yValue "519" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
