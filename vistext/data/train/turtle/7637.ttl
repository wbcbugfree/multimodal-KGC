    :xValue "0.45" ;
    :yValue "France" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "0.58" ;
    :yValue "Ireland" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "0.38" ;
    :yValue "Nordic region" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "0.48" ;
