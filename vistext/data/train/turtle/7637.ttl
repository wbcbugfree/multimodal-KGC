@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Availability of debt for refinancing or new investment on the real estate market across Europe as of 2016 , by region and country" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Moderately greater" .

:YAxis a :Axis ;
    :title "Response" .

:DataPoint1 a :DataPoint ;
    :xValue "0.57" ;
    :yValue "Portugal" ;
    :belongsTo :Chart .

