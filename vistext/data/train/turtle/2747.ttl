@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Retail sales volume of fresh fish and seafood in the United Kingdom (UK) from 2008 to 2017 (in 1,000 tonnes)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Sales volume in thousand tonnes" .

:YAxis a :Axis ;
    :title "Year" .

:DataPoint1 a :DataPoint ;
    :xValue "870.1" ;
    :yValue "2017*" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "855.1" ;
    :yValue "2016*" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "841.2" ;
    :yValue "2015*" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "828.3" ;
    :yValue "2014*" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "816.4" ;
    :yValue "2013*" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "805.4" ;
    :yValue "2012" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "795.3" ;
    :yValue "2011" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "787.1" ;
    :yValue "2010" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "780.5" ;
    :yValue "2009" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "776.4" ;
    :yValue "2008" ;
    :belongsTo :Chart .
