@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "U.S. commercial aircraft fleet growth trend from 2013 to 2040 , by type" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Cargo" .

:DataPoint1 a :DataPoint ;
    :xValue "2020-2040*" ;
    :yValue "0.029" ;
    :belongsTo :Chart .

