@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Number of employees at Grand Canyon National Park as of January 2018 , by type" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "type" .

:YAxis a :Axis ;
    :title "Number of employees" .

:DataPoint1 a :DataPoint ;
    :xValue "Visitor and Resource Protection" ;
    :yValue "125" ;
    :belongsTo :Chart .

