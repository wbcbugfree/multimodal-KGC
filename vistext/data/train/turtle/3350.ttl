    :xValue "Science and Resource Management" ;
    :yValue "40" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "Interpretation" ;
    :yValue "39" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "Administration" ;
    :yValue "20" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Fire and Aviation Management" ;
    :yValue "16" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Superintendent's Office" ;
    :yValue "12" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Comercial Services" ;
    :yValue "10" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "Planning and Compliance" ;
    :yValue "10" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "Project Management Team" ;
    :yValue "2" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "Total" ;
    :yValue "382" ;
