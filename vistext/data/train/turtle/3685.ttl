@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "U.S. average passenger revenue per passenger-mile in rail traffic from 1990 to 2018 (in current U.S. dollar cents)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Average revenue in U.S. dollar cents" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 1989" ;
    :yValue "14.1" ;
    :belongsTo :Chart .

