@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "United Kingdom (UK) : exports of goods and services to the European Union from 1999 to 2019 (in billion GBP)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Export value in billion GBP" .

