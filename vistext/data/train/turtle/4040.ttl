@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Share of employees worldwide who feel a sense of purpose from their organization in 2020 , by country" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "Share of respondents" .

