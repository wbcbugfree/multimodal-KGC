@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Population of Belgium from 2009 to 2020 , by age" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "0-17 years" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2008" ;
    :yValue "2205612" ;
    :belongsTo :Chart .

