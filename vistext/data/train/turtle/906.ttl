@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Pharmaceutical revenue as percentage of health expenditure in major African countries in 2014" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Revenue as percentage of health expenditure" .

:YAxis a :Axis ;
    :title "Country" .

:DataPoint1 a :DataPoint ;
    :xValue "0.466" ;
    :yValue "Malawi" ;
    :belongsTo :Chart .

