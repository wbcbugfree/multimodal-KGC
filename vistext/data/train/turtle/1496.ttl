@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Aramark 's net income from 2008 to 2020 (in million U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Net income in million U.S. dollars" .

:YAxis a :Axis ;
    :title "Year" .

:DataPoint1 a :DataPoint ;
    :xValue "-461.5" ;
    :yValue "2020" ;
    :belongsTo :Chart .

