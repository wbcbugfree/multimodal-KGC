@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Most popular department and home stores in the United Kingdom (UK) as of January 2020" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Share of respondents with a positive opinion" .

:YAxis a :Axis ;
    :title "Response" .

:DataPoint1 a :DataPoint ;
    :xValue "0.75" ;
    :yValue "Marks & Spencer" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "0.69" ;
    :yValue "Wilko" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "0.71" ;
    :yValue "IKEA" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "0.7" ;
    :yValue "John Lewis" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "0.7" ;
    :yValue "B&Q" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "0.57" ;
    :yValue "Wickes" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "0.57" ;
    :yValue "Debenhams" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "0.61" ;
    :yValue "Screwfix" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "0.57" ;
    :yValue "Dunelm" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "0.55" ;
    :yValue "Homebase" ;
    :belongsTo :Chart .
