@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Number of individuals identifying as Muslim in Finland from 2009 to 2019" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Number of people" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2008" ;
    :yValue "8230" ;
    :belongsTo :Chart .

