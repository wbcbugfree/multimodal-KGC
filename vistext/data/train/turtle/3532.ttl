@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Number of researchers in the research & development sector per million inhabitants in China from 2009 to 2018" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Number per million inhabitants" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2008" ;
    :yValue "846.56" ;
    :belongsTo :Chart .

