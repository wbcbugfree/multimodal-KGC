@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Most popular online dating-related search terms ranked by search volume in the United Kingdom (UK) in February 2016 (in 1,000 searches)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Searches in thousands" .

:YAxis a :Axis ;
    :title "search term" .

