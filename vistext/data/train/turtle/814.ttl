@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Leading 20 museums in Europe in 2019 , based on attendance (in 1,000s)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Attendance in thousands" .

:YAxis a :Axis ;
    :title "art museum" .

:DataPoint1 a :DataPoint ;
    :xValue "9600" ;
    :yValue "Louvre, Paris" ;
    :belongsTo :Chart .

