@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Media advertising revenue in Iceland from 2008 to 2018 (in million ISK)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Advertising revenue in million ISK" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2007" ;
    :yValue "11237" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Dec 31, 2008" ;
    :yValue "8449" ;
    :belongsTo :Chart .

