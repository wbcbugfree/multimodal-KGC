@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Denso 's worldwide number of employees from FY 2008 to FY 2020 (in 1,000s)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Number of employees in thousands" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2007" ;
    :yValue "118.85" ;
    :belongsTo :Chart .

