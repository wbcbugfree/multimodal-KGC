@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Share of people with an outstanding housing loan in Singapore in 2017 , by type of population" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Share of respondents" .

:YAxis a :Axis ;
    :title "Response" .

:DataPoint1 a :DataPoint ;
    :xValue "0.27" ;
    :yValue "In labor" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "0.25" ;
    :yValue "Richest 60% (income)" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "0.23" ;
    :yValue "Adults (25 years and older)" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "0.23" ;
    :yValue "Secondary education or more" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "0.21" ;
    :yValue "Women" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "0.2" ;
    :yValue "Total" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "0.2" ;
    :yValue "Men" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "0.14" ;
    :yValue "Poorest 40% (income)" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "0.1" ;
    :yValue "Primary education or less" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "0.07" ;
    :yValue "Out of labor" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "0.05" ;
    :yValue "Young adults (15-24 years)" ;
    :belongsTo :Chart .
