@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Usage penetration of mobile internet in France from 2010 to 2020 , by age group" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "60-74 years" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2009" ;
    :yValue "0.071" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Dec 31, 2010" ;
    :yValue "0.109" ;
    :belongsTo :Chart .

