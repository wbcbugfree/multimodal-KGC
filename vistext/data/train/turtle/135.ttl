@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Leading countries in new installed wind power capacity in 2019 (in megawatts)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Country" .

:YAxis a :Axis ;
    :title "New installed capacity in megawatts" .

:DataPoint1 a :DataPoint ;
    :xValue "China" ;
    :yValue "26155" ;
    :belongsTo :Chart .

