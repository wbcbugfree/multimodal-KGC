@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Student to teacher ratio in upper secondary schools in Sweden from 2010 to 2020" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Number of pupils per teacher" .

:YAxis a :Axis ;
    :title "Year" .

:DataPoint1 a :DataPoint ;
    :xValue "12.1" ;
    :yValue "2019/20" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "11.9" ;
    :yValue "2018/19" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "11.7" ;
    :yValue "2017/18" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "11.9" ;
    :yValue "2016/17" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "11.9" ;
    :yValue "2015/16" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "11.9" ;
    :yValue "2014/15" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "12.1" ;
    :yValue "2013/14" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "12.1" ;
    :yValue "2012/13" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "12.3" ;
    :yValue "2011/12" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "12.3" ;
    :yValue "2010/11" ;
    :belongsTo :Chart .
