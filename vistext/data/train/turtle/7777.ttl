@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Distribution of the child population in the U.S. from 2000 to 2019 , by race and Hispanic origin" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Hispanic" .

