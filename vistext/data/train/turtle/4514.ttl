@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Most used libraries , frameworks , and tools among developers , worldwide , as of early 2020" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "Share of respondents" .

:DataPoint1 a :DataPoint ;
    :xValue "Node.js" ;
    :yValue "0.514" ;
    :belongsTo :Chart .

