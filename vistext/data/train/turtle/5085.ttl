@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Natural gas production in the United States from 1998 to 2019 (in billion cubic meters)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Production in billion cubic meters" .

