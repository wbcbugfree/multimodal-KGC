@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Generation X : General health and wellness practices 2012" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "Share of respondents" .

:DataPoint1 a :DataPoint ;
    :xValue "Exercise/sport" ;
    :yValue "0.58" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Special dietary habits" ;
    :yValue "0.26" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "Brain health exercises" ;
    :yValue "0.2" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "Herbal remedies" ;
    :yValue "0.13" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "Meditation/yoga" ;
    :yValue "0.09" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Prayer/religion" ;
    :yValue "0.01" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Vitamins/supplements" ;
    :yValue "0.01" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Medications/medicines" ;
    :yValue "0.01" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "Other" ;
    :yValue "0.01" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "Nothing" ;
    :yValue "0.25" ;
    :belongsTo :Chart .
