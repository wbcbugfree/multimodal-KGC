@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Number of opioid overdose deaths in Canada in 2019 , by province" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Number of deaths" .

:YAxis a :Axis ;
    :title "province in Canada" .

:DataPoint1 a :DataPoint ;
    :xValue "995" ;
    :yValue "British Columbia" ;
    :belongsTo :Chart .

