@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Top U.S. states based on home birth rate in 2018" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "Percentage of all births that were home births" .

:DataPoint1 a :DataPoint ;
    :xValue "Montana" ;
    :yValue "0.024" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Wisconsin" ;
    :yValue "0.023" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "Utah" ;
    :yValue "0.022" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "Idaho" ;
    :yValue "0.022" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "Washington" ;
    :yValue "0.021" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Vermont" ;
    :yValue "0.02" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Oregon" ;
    :yValue "0.02" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Alaska" ;
    :yValue "0.019" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "Maine" ;
    :yValue "0.019" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "Pennsylvania" ;
    :yValue "0.019" ;
    :belongsTo :Chart .
