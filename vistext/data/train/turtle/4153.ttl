@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Number of coronavirus (COVID-19) cases in Norway in 2020 , by county (as of November 26 , 2020)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Number of cases" .

:YAxis a :Axis ;
    :title "county of Norway" .

:DataPoint1 a :DataPoint ;
    :xValue "10434" ;
    :yValue "Oslo" ;
    :belongsTo :Chart .

