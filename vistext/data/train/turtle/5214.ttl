@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "All time top goal scorers of the national football team of Germany as of January 2020 , by goals scored" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Goals scored" .

:YAxis a :Axis ;
    :title "player name" .

:DataPoint1 a :DataPoint ;
    :xValue "71" ;
    :yValue "Miroslav Klose" ;
    :belongsTo :Chart .

