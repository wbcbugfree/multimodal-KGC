@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Distrubution of the NAND market in 2013 , by application" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Applications" .

:YAxis a :Axis ;
    :title "Market share" .

:DataPoint1 a :DataPoint ;
    :xValue "Smartphone" ;
    :yValue "0.26" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "SSD" ;
    :yValue "0.13" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "Tablet PC" ;
    :yValue "0.12" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "HHP" ;
    :yValue "0.12" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "USB" ;
    :yValue "0.11" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Smartcard" ;
    :yValue "0.08" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "DSC" ;
    :yValue "0.06" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "MP3" ;
    :yValue "0.06" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "Enhanced Phone" ;
    :yValue "0.03" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "Other" ;
    :yValue "0.03" ;
    :belongsTo :Chart .
