@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "B2C e-commerce as percentage of GDP in South Korea from 2009 to 2018" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "Percentage of gross domestic product" .

:DataPoint1 a :DataPoint ;
    :xValue "2018*" ;
    :yValue "0.03" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "2017*" ;
    :yValue "0.0286" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "2016*" ;
    :yValue "0.0274" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "2015*" ;
    :yValue "0.0253" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "2014*" ;
    :yValue "0.0234" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "2013" ;
    :yValue "0.0223" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "2012" ;
    :yValue "0.0216" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "2011" ;
    :yValue "0.0199" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "2010" ;
    :yValue "0.0185" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "2009" ;
    :yValue "0.017" ;
    :belongsTo :Chart .
