@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Value of India 's chemical imports in financial year 2019 , by type (in billion Indian rupees)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "type" .

:YAxis a :Axis ;
    :title "Import value in billion Indian rupees" .

:DataPoint1 a :DataPoint ;
    :xValue "Organic chemicals" ;
    :yValue "996.72" ;
    :belongsTo :Chart .

