@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Average daily radio listenership in Italy in the first semester 2018 , by radio channel (in 1,000 listeners)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Number of listeners in thousands" .

:YAxis a :Axis ;
    :title "radio station" .

