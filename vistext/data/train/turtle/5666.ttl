@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Revenue of the Tampa Bay Lightnings from 2005/06 to 2018/19 (in million U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Revenue in million U.S. dollars" .

:YAxis a :Axis ;
    :title "Year" .

:DataPoint1 a :DataPoint ;
    :xValue "140" ;
    :yValue "2018/19" ;
    :belongsTo :Chart .

