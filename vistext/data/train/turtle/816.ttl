@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Share of Alphabet 's and Google 's revenue generated in the United Kingdom (UK) from 2007 to 2016" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "Share of revenue" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2006" ;
    :yValue "0.15" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Dec 31, 2007" ;
    :yValue "0.14" ;
    :belongsTo :Chart .

