@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "BRIC countries : Inflation rate from 2009 to 2021 (compared to the previous year)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Brazil" .

:YAxis a :Axis ;
    :title "Year" .

:DataPoint1 a :DataPoint ;
    :xValue "0.0331" ;
    :yValue "2021*" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "0.0356" ;
    :yValue "2020*" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "0.0373" ;
    :yValue "2019" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "0.0367" ;
    :yValue "2018" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "0.0345" ;
    :yValue "2017" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "0.0874" ;
    :yValue "2016" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "0.0903" ;
    :yValue "2015" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "0.0633" ;
    :yValue "2014" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "0.062" ;
    :yValue "2013" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "0.054" ;
    :yValue "2012" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "0.0664" ;
    :yValue "2011" ;
    :belongsTo :Chart .

:DataPoint12 a :DataPoint ;
    :xValue "0.0504" ;
    :yValue "2010" ;
    :belongsTo :Chart .

:DataPoint13 a :DataPoint ;
    :xValue "0.0489" ;
    :yValue "2009" ;
    :belongsTo :Chart .
