@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Major countries in worldwide cement production from 2015 to 2019 (in million metric tons)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Country" .

:YAxis a :Axis ;
    :title "2018" .

:DataPoint1 a :DataPoint ;
    :xValue "Chin" ;
    :yValue "2200" ;
    :belongsTo :Chart .

