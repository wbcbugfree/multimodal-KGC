    :xValue "United States Egyp" ;
    :yValue "81.2" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Egypt Indonesi" ;
    :yValue "75.2" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Indonesia Ira" ;
