@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Who would you consider your travel icon or role model ?" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Share of respondents" .

:YAxis a :Axis ;
    :title "Response" .

:DataPoint1 a :DataPoint ;
    :xValue "0.17" ;
    :yValue "Rick Steves" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "0.15" ;
    :yValue "Anthony Bourdain" ;
    :belongsTo :Chart .

