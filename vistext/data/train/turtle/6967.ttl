@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Leading countries for Italian cosmetic industry exports from 2014 to 2019 (in million euros)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "2014" .

:YAxis a :Axis ;
    :title "Country" .

:DataPoint1 a :DataPoint ;
    :xValue "390" ;
    :yValue "France" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "393" ;
    :yValue "Germany" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "249" ;
    :yValue "United States" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "268" ;
    :yValue "United Kingdom" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "214" ;
    :yValue "Spain" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "112" ;
    :yValue "Hong Kong" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "117" ;
    :yValue "Netherlands" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "117" ;
    :yValue "United Arab Emirates" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "107" ;
    :yValue "Poland" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "139" ;
    :yValue "Russia" ;
    :belongsTo :Chart .
