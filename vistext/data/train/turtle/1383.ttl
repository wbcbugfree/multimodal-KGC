@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Tree cover loss worldwide in 2018 , by select country (in 1,000 hectares)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Tree cover loss in thousand hectares" .

:YAxis a :Axis ;
    :title "Country" .

:DataPoint1 a :DataPoint ;
    :xValue "5562.81" ;
    :yValue "Russia" ;
    :belongsTo :Chart .

