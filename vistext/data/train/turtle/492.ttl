@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Which , if any , of the following does your child use the smartphone for ?" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Share of respondents" .

:YAxis a :Axis ;
    :title "Response" .

:DataPoint1 a :DataPoint ;
    :xValue "0.79" ;
    :yValue "Taking pictures or films" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "0.73" ;
    :yValue "Chatting with friends" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "0.72" ;
    :yValue "Playing games" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "0.71" ;
    :yValue "Downloading apps" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "0.61" ;
    :yValue "Social networking (e.g. Facebook or Twitter)" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "0.51" ;
    :yValue "Browsing online" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "0.37" ;
    :yValue "Watching videos" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "0.29" ;
    :yValue "Video chat (e.g. Skype or FaceTime)" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "0.21" ;
    :yValue "Education/learning" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "0.1" ;
    :yValue "Watching TV" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "0.02" ;
    :yValue "None of the above" ;
    :belongsTo :Chart .

:DataPoint12 a :DataPoint ;
    :xValue "0.01" ;
    :yValue "Don't know" ;
    :belongsTo :Chart .
