@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Number of think tanks in the Caribbean in 2018 , by country or territory" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Country" .

:YAxis a :Axis ;
    :title "Number of think tanks" .

:DataPoint1 a :DataPoint ;
    :xValue "Dominican Republic" ;
    :yValue "40" ;
    :belongsTo :Chart .

