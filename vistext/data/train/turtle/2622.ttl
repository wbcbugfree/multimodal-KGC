@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Most wanted platform among developers , worldwide , as of early 2020" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "Share of respondents" .

:DataPoint1 a :DataPoint ;
    :xValue "Docker" ;
    :yValue "0.245" ;
    :belongsTo :Chart .

