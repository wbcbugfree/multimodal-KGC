@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Average annual expenditure on delivery services per consumer unit in the United States from 2007 to 2019 (in U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Average annual expenditure in U.S. dollars" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2006" ;
    :yValue "2.88" ;
    :belongsTo :Chart .

