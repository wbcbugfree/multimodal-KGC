@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Total direct life insurance premium in the United Kingdom (UK) from 2004 to 2018 (in billion euros)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Direct premium income in billion euros*" .

