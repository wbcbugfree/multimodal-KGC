@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Leading music genres according to consumers in the United States as of May 2018" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "Share of respondents" .

:DataPoint1 a :DataPoint ;
    :xValue "Rock" ;
    :yValue "0.568" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Pop" ;
    :yValue "0.561" ;
    :belongsTo :Chart .

