@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Average hourly wage in the Netherlands in 2018 , by age (in euros)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Hourly wage in euros" .

:YAxis a :Axis ;
    :title "Year" .

:DataPoint1 a :DataPoint ;
    :xValue "4.24" ;
    :yValue "Younger than 15 years" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "6.51" ;
    :yValue "15-20 years" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "12.55" ;
    :yValue "20-25 years" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "17.21" ;
    :yValue "25-30 years" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "20.95" ;
    :yValue "30-35 years" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "24.05" ;
    :yValue "35-40 years" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "26.02" ;
    :yValue "40-45 years" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "26.91" ;
    :yValue "45-50 years" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "27.13" ;
    :yValue "50-55 years" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "27.18" ;
    :yValue "55-60 years" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "26.76" ;
    :yValue "60-65 years" ;
    :belongsTo :Chart .

:DataPoint12 a :DataPoint ;
    :xValue "24.36" ;
    :yValue "65-75 years" ;
    :belongsTo :Chart .

:DataPoint13 a :DataPoint ;
    :xValue "18.52" ;
    :yValue "Older than 75 years" ;
    :belongsTo :Chart .
