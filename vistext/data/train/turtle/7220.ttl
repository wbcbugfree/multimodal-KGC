@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Liverpool FC revenue by stream from 2008/09 to 2018/19 (in million euros)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Commercial" .

:YAxis a :Axis ;
    :title "Season" .

:DataPoint1 a :DataPoint ;
    :xValue "210.9" ;
    :yValue "2018/19" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "170.8" ;
    :yValue "2017/18" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "161.6" ;
    :yValue "2016/17" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "159.8" ;
    :yValue "2015/16" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "153" ;
    :yValue "2014/15" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "124.1" ;
    :yValue "2013/14" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "114" ;
    :yValue "2012/13" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "99.1" ;
    :yValue "2011/12" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "85.7" ;
