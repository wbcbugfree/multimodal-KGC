@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Percentage of new installed solar PV capacity worldwide in 2019 , by country" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Percentage of newly installed capacity" .

:YAxis a :Axis ;
    :title "Response" .

:DataPoint1 a :DataPoint ;
    :xValue "0.26" ;
    :yValue "China" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "0.09" ;
    :yValue "India" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "0.12" ;
    :yValue "US" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "0.06" ;
    :yValue "Japan" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "0.04" ;
    :yValue "Vietnam" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "0.04" ;
    :yValue "Spain" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "0.03" ;
    :yValue "Germany" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "0.03" ;
    :yValue "Australia" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "0.03" ;
    :yValue "Ukraine" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "0.03" ;
    :yValue "South Korea" ;
