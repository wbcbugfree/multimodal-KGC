    :xValue "Sibanye Gold (South Africa)" ;
    :yValue "6.21" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "Impala Platinum Holdings (South Africa)" ;
    :yValue "6.1" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "Northam Platinum (South Africa)" ;
    :yValue "3.6" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Exxaro Resources (South Africa)" ;
    :yValue "2.89" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Harmony Gold Mining Company (South Africa)" ;
    :yValue "2.87" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "African Rainbow Minerals (South Africa)" ;
