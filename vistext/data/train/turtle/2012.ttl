@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Leading mining companies in Africa based on market capitalization in 2020 (in billion U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Company (headquarters)" .

:YAxis a :Axis ;
    :title "Market capitalization in billion U.S. dollars" .

:DataPoint1 a :DataPoint ;
    :xValue "AngloGold Ashanti (South Africa)" ;
    :yValue "12.28" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Gold Fields (South Africa)" ;
    :yValue "8.4" ;
    :belongsTo :Chart .

