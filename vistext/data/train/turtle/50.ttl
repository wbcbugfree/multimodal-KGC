@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Number of hospital beds in Spain from 2010 to 2020" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Number of hospital beds" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2009" ;
    :yValue "161022" ;
    :belongsTo :Chart .

