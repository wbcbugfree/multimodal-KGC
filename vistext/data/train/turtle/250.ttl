@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Total number of retail prescriptions filled annually in the United States from 2013 to 2025 (in billions)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Number of prescriptions filled in billions" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2012" ;
    :yValue "4.24" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Dec 31, 2013" ;
    :yValue "4.33" ;
    :belongsTo :Chart .

