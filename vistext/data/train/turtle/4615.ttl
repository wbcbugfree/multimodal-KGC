@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Worldwide forecast of pharmaceutical sector growth between 2017 and 2030 , by country" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Country" .

:YAxis a :Axis ;
    :title "Growth in percentage" .

