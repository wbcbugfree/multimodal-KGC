@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Number of abortions performed per 1,000 women in Spain from 2007 to 2018" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Number of abortions per 1,000 women" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2006" ;
    :yValue "11.49" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Dec 31, 2007" ;
    :yValue "11.78" ;
    :belongsTo :Chart .

