@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Use of social networks among travel companies in the United States as of the first quarter of 2014" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Currently use" .

:YAxis a :Axis ;
    :title "Response" .

:DataPoint1 a :DataPoint ;
    :xValue "0.84" ;
    :yValue "Facebook" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "0.66" ;
    :yValue "Twitter" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "0.56" ;
    :yValue "YouTube" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "0.48" ;
    :yValue "Google+" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "0.5" ;
    :yValue "LinkedIn" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "0.35" ;
    :yValue "Instagram" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "0.37" ;
    :yValue "Pinterest" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "0.17" ;
    :yValue "Foursquare" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "0.14" ;
    :yValue "WhatsApp" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "0.06" ;
    :yValue "Vine" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "0.09" ;
    :yValue "Tumblr" ;
    :belongsTo :Chart .
