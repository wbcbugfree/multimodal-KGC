@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Annual household disposable income in Belgium from 2000 to 2010 , by region (in euros)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Walloon Region" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 1999" ;
    :yValue "30326" ;
    :belongsTo :Chart .

