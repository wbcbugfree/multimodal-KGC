@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Radio stations ranked by weekly reach in the United Kingdom (UK) as of 1st quarter 2020 (in 1,000 listeners)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "radio station" .

:YAxis a :Axis ;
    :title "Listeners reached in thousands*" .

