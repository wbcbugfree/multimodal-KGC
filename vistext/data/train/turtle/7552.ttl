@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Number of overnight stays of domestic and international tourists during the COVID-19 outbreak in Finland in 2020 , compared to 2019 (in 1,000s)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Month" .

:YAxis a :Axis ;
    :title "Domestic tourists" .

:DataPoint1 a :DataPoint ;
    :xValue "Feb 28, 2019" ;
    :yValue "1297" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Mar 31, 2019" ;
    :yValue "1222" ;
    :belongsTo :Chart .

