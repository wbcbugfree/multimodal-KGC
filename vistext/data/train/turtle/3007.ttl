@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Enhanced annuities sold as a proportion of all annuities in the United Kingdom (UK) from 2003 to 2012" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "Percentage of enhanced annuities sold" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2002" ;
    :yValue "0.02" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Dec 31, 2003" ;
    :yValue "0.03" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "Dec 31, 2004" ;
    :yValue "0.05" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "Dec 31, 2005" ;
    :yValue "0.06" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "Dec 31, 2006" ;
    :yValue "0.07" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Dec 31, 2007" ;
    :yValue "0.07" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Dec 31, 2008" ;
    :yValue "0.09" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Dec 31, 2009" ;
    :yValue "0.14" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "Dec 31, 2010" ;
    :yValue "0.19" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "Dec 31, 2011" ;
    :yValue "0.24" ;
    :belongsTo :Chart .
