@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Consumption of broiler meat per capita in Canada from 1980 to 2018 (in kilograms)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Consumption per person in kilograms" .

:YAxis a :Axis ;
    :title "Year" .

:DataPoint1 a :DataPoint ;
    :xValue "33.4" ;
    :yValue "2018***" ;
    :belongsTo :Chart .

