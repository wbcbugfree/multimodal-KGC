@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Number of sentenced prisoners in the United States under state jurisdiction in 2018 , by offense" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Number of prisoners" .

:YAxis a :Axis ;
    :title "Offense" .

:DataPoint1 a :DataPoint ;
    :xValue "177700" ;
    :yValue "Murder *" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "162700" ;
    :yValue "Rape/sexual assault" ;
    :belongsTo :Chart .

