@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Pornstars per million inhabitants in selected Central and Eastern European countries in 2019" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Rate per million people" .

:YAxis a :Axis ;
    :title "Country" .

