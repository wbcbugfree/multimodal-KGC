@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Number of two and three wheelers sold in Pakistan from July 2008 to June 2019" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Number of cars" .

:YAxis a :Axis ;
    :title "Month" .

:DataPoint1 a :DataPoint ;
    :xValue "1781959" ;
    :yValue "Jul 2018- Jun 2019" ;
    :belongsTo :Chart .

