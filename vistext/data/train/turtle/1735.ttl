@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Population of Luxembourg in 2020 , by canton" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "canton of Luxembourg" .

:YAxis a :Axis ;
    :title "Population" .

:DataPoint1 a :DataPoint ;
    :xValue "Grand Duchy of Luxembourg" ;
    :yValue "626108" ;
    :belongsTo :Chart .

