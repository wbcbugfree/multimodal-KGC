@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Age distribution of medical marijuana patients registered in Oregon as of April 2020" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Age in years" .

:YAxis a :Axis ;
    :title "Percentage of patients" .

:DataPoint1 a :DataPoint ;
    :xValue "0-10" ;
    :yValue "0.003" ;
    :belongsTo :Chart .

