    :yValue "663.6" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "easyJet" ;
    :yValue "608.8" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "US Airways" ;
    :yValue "540.59" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Air Canada" ;
    :yValue "534.14" ;
