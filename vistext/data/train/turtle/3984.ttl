@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Ancillary revenue from additional services for selected airlines in 2009 (in million euros)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Country" .

:YAxis a :Axis ;
    :title "Additional airline income (in million euros)" .

:DataPoint1 a :DataPoint ;
    :xValue "United" ;
    :yValue "1527.31" ;
    :belongsTo :Chart .

