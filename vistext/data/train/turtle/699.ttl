@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "FedEx Corporation 's revenue from FY 2009 to FY 2020 (in billion U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Revenue in billion U.S. dollars" .

:DataPoint1 a :DataPoint ;
    :xValue "2020" ;
    :yValue "69.22" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "2019" ;
    :yValue "69.69" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "2018" ;
    :yValue "65.45" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "2017" ;
    :yValue "60.32" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "2016" ;
    :yValue "50.37" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "2015" ;
    :yValue "47.45" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "2014" ;
    :yValue "45.57" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "2013*" ;
    :yValue "44.29" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "2012*" ;
    :yValue "42.68" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "2011*" ;
    :yValue "39.3" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "2010" ;
    :yValue "34.73" ;
    :belongsTo :Chart .

:DataPoint12 a :DataPoint ;
    :xValue "2009*" ;
    :yValue "35.5" ;
    :belongsTo :Chart .
