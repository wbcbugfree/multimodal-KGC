@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Average annual salaries in the armed forces of the United Kingdom in 2018/19 , by rank (in British pounds)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Salary in GBP" .

:YAxis a :Axis ;
    :title "military rank" .

