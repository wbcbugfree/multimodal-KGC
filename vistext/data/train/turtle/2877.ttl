@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Total number of inboard boats - cruisers sold in the U.S. from 2000 to 2013" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Cruisers sold" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 1999" ;
    :yValue "10300" ;
    :belongsTo :Chart .

