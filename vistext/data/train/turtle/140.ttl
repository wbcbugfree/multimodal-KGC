@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Average daily rate at the most popular destinations for spring break in the United States as of January 2015 (in U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Average daily hotel room rate in U.S. dollars" .

:YAxis a :Axis ;
    :title "city of the United States" .

:DataPoint1 a :DataPoint ;
    :xValue "213" ;
    :yValue "Miami, FL" ;
    :belongsTo :Chart .

