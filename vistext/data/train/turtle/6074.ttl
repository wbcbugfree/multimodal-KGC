@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Number of establishments in the advertising and related services industry in the United States from 2007 to 2017 , by sector" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Outdoor advertising" .

