@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Revenue from retail sales of natural or artificial plants and flowers in the United Kingdom (UK) from 2008 to 2018 (in million GBP)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Revenue in million GBP" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2007" ;
    :yValue "4192" ;
    :belongsTo :Chart .

