    :xValue "0.268" ;
    :yValue "Nissan Tiida" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "0.273" ;
    :yValue "Mazda 3" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "0.276" ;
    :yValue "Honda Odissey" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "0.276" ;
    :yValue "Mitsubishi Lancer" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "0.279" ;
    :yValue "Hyundai Grand i10" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "0.282" ;
    :yValue "Toyota Yaris" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "0.285" ;
