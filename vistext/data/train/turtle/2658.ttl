@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Car models with lowest depreciation rate in Mexico in 2016 and 2017" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Depreciation rate" .

:YAxis a :Axis ;
    :title "Car models" .

:DataPoint1 a :DataPoint ;
    :xValue "0.258" ;
    :yValue "Suzuki S-Cross" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "0.261" ;
    :yValue "Ford Fiesta" ;
    :belongsTo :Chart .

