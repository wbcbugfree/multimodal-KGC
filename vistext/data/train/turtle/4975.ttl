@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Most popular ads worldwide shared online in October 2016 (in 1,000s)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Number of shares in thousands" .

:YAxis a :Axis ;
    :title "ad" .

:DataPoint1 a :DataPoint ;
    :xValue "1017.53" ;
    :yValue "Shell – Best Day Of My Life #makethefuture" ;
    :belongsTo :Chart .

