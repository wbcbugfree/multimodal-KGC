@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Cotton imports into the United States from 1990 to 2018 (in 1,000 bales)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Imports in thousand 480-pound bales" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 1989" ;
    :yValue "4" ;
    :belongsTo :Chart .

