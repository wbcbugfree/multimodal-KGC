@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "The richest self-made women billionaires in the United States in 2017 (in billion U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "self-made women billionaires" .

:YAxis a :Axis ;
    :title "Net worth in billion U.S.dollars" .

:DataPoint1 a :DataPoint ;
    :xValue "Marian Ilitch" ;
    :yValue "5.1" ;
    :belongsTo :Chart .

