@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Percentage of weekly household expenditure going on sports admissions and subscriptions in the United Kingdom (UK) in 2018 , by disposable income decile group" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Disposable income decile group*" .

:YAxis a :Axis ;
    :title "Percentage of spending" .

:DataPoint1 a :DataPoint ;
    :xValue "Lowest ten percent" ;
    :yValue "0.005" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Second decile group" ;
    :yValue "0.006" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "Third decile group" ;
    :yValue "0.007" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "Fourth decile group" ;
    :yValue "0.007" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "Fifth decile group" ;
    :yValue "0.009" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Sixth decile group" ;
    :yValue "0.011" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Seventh decile group" ;
    :yValue "0.017" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Eighth decile group" ;
    :yValue "0.013" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "Ninth decile group" ;
    :yValue "0.014" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "Highest ten percent" ;
    :yValue "0.019" ;
    :belongsTo :Chart .
