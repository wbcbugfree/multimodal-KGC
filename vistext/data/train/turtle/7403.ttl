@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "American customer satisfaction index scores for internet travel companies in the United States from 2002 to 2019" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Orbitz (Expedia)" .

