@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Average wholesale price of home grown gooseberries in the United Kingdom (UK) between June 2014 and September 2019 (in GBP per kilogram)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Price in GBP per kilogram" .

:YAxis a :Axis ;
    :title "Month" .

