@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Homeowner vacancy rates in the United States from 1990 to 2019" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Homeowner vacancy rate" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 1989" ;
    :yValue "0.017" ;
    :belongsTo :Chart .

