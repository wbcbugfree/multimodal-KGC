@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Highest paid athletes by earnings from salary and endorsements worldwide in 2019/20 (in million U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Highest paid athletes" .

:YAxis a :Axis ;
    :title "Endorsements" .

:DataPoint1 a :DataPoint ;
    :xValue "Roger Federer (tennis)" ;
    :yValue "100" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Cristiano Ronaldo (soccer)" ;
    :yValue "45" ;
    :belongsTo :Chart .

