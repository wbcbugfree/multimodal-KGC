@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Number of general practitioners employed in Spain from 2005 to 2018" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Number of employees" .

