@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Average Chinese domestic prices for selected rare earth oxides as of January 2021 (in renminbi per metric ton)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Rare earth oxide" .

:YAxis a :Axis ;
    :title "Price in renminbi per metric ton" .

:DataPoint1 a :DataPoint ;
    :xValue "Neodymium oxide" ;
    :yValue "512000" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Praesodymium oxide" ;
    :yValue "365000" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "Gadoliniumm oxide" ;
    :yValue "178000" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "Erbium oxide" ;
    :yValue "167000" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "Yttrium oxide" ;
    :yValue "20500" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Samarium oxide" ;
    :yValue "11500" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Cerium oxide" ;
    :yValue "10000" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Lanthanum oxide" ;
    :yValue "9750" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "Terbium oxide" ;
    :yValue "7350" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "Dysprosium oxide" ;
    :yValue "1950" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "Europium oxide" ;
    :yValue "210" ;
    :belongsTo :Chart .
