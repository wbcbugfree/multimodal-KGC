@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "McKesson Corporation 's total assets from 2007 to 2020 (in million U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Total assets in million U.S. dollars" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2006" ;
    :yValue "23943" ;
    :belongsTo :Chart .

