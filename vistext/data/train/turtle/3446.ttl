@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Number of confirmed coronavirus (COVID-19) cases in Hungary as of January 7 , 2021 , by county" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Number of confirmed cases" .

:YAxis a :Axis ;
    :title "county of Hungary" .

