@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Number of worldwide kidnappings due to terrorism from 2007 to 2019" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Number of kidnappings" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2006" ;
    :yValue "4980" ;
    :belongsTo :Chart .

