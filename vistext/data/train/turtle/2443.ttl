@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Percentage of United States farmland operated by full land owners from 1925 to 2012" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Share operated by full owners" .

:DataPoint1 a :DataPoint ;
    :xValue "1925" ;
    :yValue "0.454" ;
    :belongsTo :Chart .

