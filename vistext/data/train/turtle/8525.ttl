@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Total immigration , total emigration and the migration balance in the Netherlands in 2019 , by age" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Migration balance" .

:YAxis a :Axis ;
    :title "Year" .

:DataPoint1 a :DataPoint ;
    :xValue "10057" ;
    :yValue "Younger than 10 years" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "22234" ;
    :yValue "10-20 years" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "35942" ;
    :yValue "20-30 years" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "24114" ;
    :yValue "30-40 years" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "11604" ;
    :yValue "40-50 years" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "3510" ;
    :yValue "50-60 years" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "-156" ;
    :yValue "60-70 years" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "469" ;
    :yValue "70-80 years" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "241" ;
    :yValue "80-90 years" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "20" ;
    :yValue "90 years and older" ;
    :belongsTo :Chart .
