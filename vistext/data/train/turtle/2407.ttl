@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Cleveland Indians all-time RBI (runs batted in) leaders as of October 2020" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "leaders" .

:YAxis a :Axis ;
    :title "Number of home runs" .

:DataPoint1 a :DataPoint ;
    :xValue "Earl Averill" ;
    :yValue "1084" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Jim Thome" ;
    :yValue "937" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "Nap Lajoie" ;
    :yValue "919" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "Hal Trosky" ;
    :yValue "911" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "Tris Speaker" ;
    :yValue "886" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Joe Sewell" ;
    :yValue "868" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Ken Keltner" ;
    :yValue "850" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Manny Ramirez" ;
    :yValue "804" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "Larry Doby" ;
    :yValue "776" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "Albert Belle" ;
    :yValue "751" ;
    :belongsTo :Chart .
