@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Z Holdings Corporation 's net income from fiscal year 2002 to 2019 (in billion Japanese yen)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Net income in billion Japanese yen" .

