@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Number of passengers boarded by the major Canadian air carriers from 1990 to 2019 (in 1,000s)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Number of passengers boarded in thousands" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 1989" ;
    :yValue "21236" ;
    :belongsTo :Chart .

