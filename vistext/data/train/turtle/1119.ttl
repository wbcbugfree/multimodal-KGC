@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Global electrosurgical devices market share by company in 2016" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Market share" .

:YAxis a :Axis ;
    :title "business" .

