@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Box office revenue of the highest grossing movies in North America in 2019 (in million U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Box office gross in million U.S. dollars" .

:YAxis a :Axis ;
    :title "film" .

