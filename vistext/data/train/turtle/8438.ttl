@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Monthly spot prices of diesel fuel in the United States from October 2019 to October 2020 , by type (in U.S. dollars per gallon)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Month" .

:YAxis a :Axis ;
    :title "Los Angeles, CA" .

:DataPoint1 a :DataPoint ;
    :xValue "Oct 20" ;
    :yValue "1.21" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Sep 20" ;
    :yValue "1.16" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "Aug 20" ;
    :yValue "1.29" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "Jul 20" ;
    :yValue "1.26" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "Jun 20" ;
    :yValue "1.18" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "May 20" ;
    :yValue "0.91" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Apr 20" ;
    :yValue "0.82" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Mar 20" ;
    :yValue "1.27" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "Feb 20" ;
    :yValue "1.75" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "Jan 20" ;
    :yValue "1.91" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "Dec 19" ;
    :yValue "1.96" ;
    :belongsTo :Chart .

:DataPoint12 a :DataPoint ;
    :xValue "Nov 19" ;
    :yValue "2.11" ;
    :belongsTo :Chart .

:DataPoint13 a :DataPoint ;
    :xValue "Oct 19" ;
    :yValue "2.07" ;
    :belongsTo :Chart .
