@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Number of gift , novelty and souvenir stores in Canada as of December 2019 , by region" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "province of Canada" .

:YAxis a :Axis ;
    :title "Number of stores" .

:DataPoint1 a :DataPoint ;
    :xValue "Ontario" ;
    :yValue "851" ;
    :belongsTo :Chart .

