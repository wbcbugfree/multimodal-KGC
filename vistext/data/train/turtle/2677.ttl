@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Cities with the largest number of public swimming pools per 100,000 residents in the United States in 2019" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "city of the United States" .

:YAxis a :Axis ;
    :title "Pools per 100,000 residents" .

:DataPoint1 a :DataPoint ;
    :xValue "Cleveland, OH" ;
    :yValue "10.8" ;
    :belongsTo :Chart .

