@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Number of femicides in Argentina from January 2019 to May 2020" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Month" .

:YAxis a :Axis ;
    :title "2020" .

:DataPoint1 a :DataPoint ;
    :xValue "Jun" ;
    :yValue "21" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "June Ma" ;
    :yValue "21" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "May Apri" ;
    :yValue "30" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "April Marc" ;
    :yValue "28" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "March Februar" ;
    :yValue "28" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "February Januar" ;
    :yValue "34" ;
    :belongsTo :Chart .
