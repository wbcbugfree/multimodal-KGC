@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Value of new private sector warehouse construction in the U.S. from 2002 to 2019 (in million U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Value of new construction in million U.S. dollars" .

