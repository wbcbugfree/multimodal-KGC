@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Average annual gross pay of full-time employees in the hospitality and tourism sector in the United Kingdom (UK) from 2011 to 2012 , by sector (in 1,000 GBP)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "2011" .

:YAxis a :Axis ;
    :title "hospitality and tourism sector" .

:DataPoint1 a :DataPoint ;
    :xValue "37025" ;
    :yValue "Hotel and accommodation managers and proprietors" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "30923" ;
    :yValue "Conference and exhibition managers and organisers" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "23623" ;
    :yValue "Leisure and travel service occupations n.e.c." ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "24210" ;
    :yValue "Restaurant and catering establishment managers and proprietors" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "25017" ;
    :yValue "Publicans and managers of licensed premises" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "21517" ;
    :yValue "Catering and bar managers" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "19813" ;
    :yValue "Chefs" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "16446" ;
    :yValue "Housekeepers and related occupations" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "16585" ;
    :yValue "Cooks" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "15181" ;
    :yValue "Other elementary services occupations n.e.c." ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "14555" ;
    :yValue "Leisure and theme park attendants" ;
    :belongsTo :Chart .

:DataPoint12 a :DataPoint ;
    :xValue "12777" ;
    :yValue "Kitchen and catering assistants" ;
    :belongsTo :Chart .

:DataPoint13 a :DataPoint ;
    :xValue "12722" ;
    :yValue "Bar staff" ;
    :belongsTo :Chart .

:DataPoint14 a :DataPoint ;
    :xValue "12664" ;
    :yValue "Waiters and waitresses" ;
    :belongsTo :Chart .

:DataPoint15 a :DataPoint ;
    :xValue "20218" ;
    :yValue "Hospitality and tourism average*" ;
    :belongsTo :Chart .
