@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Share of American men who masturbated alone during last year in 2009 , by age group" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Share of respondents" .

:YAxis a :Axis ;
    :title "Age group" .

:DataPoint1 a :DataPoint ;
    :xValue "0.62" ;
    :yValue "14-15" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "0.75" ;
    :yValue "16-17" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "0.81" ;
    :yValue "18-19" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "0.83" ;
    :yValue "20-24" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "0.84" ;
    :yValue "25-29" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "0.8" ;
    :yValue "30-39" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "0.76" ;
    :yValue "40-49" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "0.72" ;
    :yValue "50-59" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "0.61" ;
    :yValue "60-69" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "0.46" ;
    :yValue "70 and older" ;
    :belongsTo :Chart .
