@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Coronavirus (COVID-19) confirmed cases , recoveries , and deaths in Kazakhstan as of December 17 , 2020 , by region" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "region of Kazakhstan" .

:YAxis a :Axis ;
    :title "Recoveries" .

:DataPoint1 a :DataPoint ;
    :xValue "East Kazakhstan Region" ;
    :yValue "13443" ;
    :belongsTo :Chart .

