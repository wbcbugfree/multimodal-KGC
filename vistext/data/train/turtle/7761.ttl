@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Percentage of people with COVID-19 in the United States from January 22 to May 30 , 2020 with and without underlying conditons who were hospitalized , by age" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Patients without underlying conditons" .

:YAxis a :Axis ;
    :title "Year" .

:DataPoint1 a :DataPoint ;
    :xValue "0.037" ;
    :yValue "9 years or younger" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "0.023" ;
    :yValue "10 to 19 years" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "0.027" ;
    :yValue "20 to 29 years" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "0.044" ;
    :yValue "30 to 39 years" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "0.064" ;
    :yValue "40 to 49 years" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "0.096" ;
    :yValue "50 to 59 years" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "0.154" ;
    :yValue "60 to 69 years" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "0.279" ;
    :yValue "70 to 79 years" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "0.301" ;
    :yValue "80 years and older" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "0.076" ;
    :yValue "Total" ;
    :belongsTo :Chart .
