    :yValue "88" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Dec 31, 2012" ;
    :yValue "92.6" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
