@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Consumer price index (CPI) of transport annually in the United Kingdom (UK) from 2008 to 2019" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Consumer price index*" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2007" ;
    :yValue "63" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Dec 31, 2008" ;
    :yValue "67.6" ;
    :belongsTo :Chart .

