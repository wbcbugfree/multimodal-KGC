@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Trade union density : percentage of employees that were members of a trade union in Norway from 2000 to 2013" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "Percentage of employees" .

