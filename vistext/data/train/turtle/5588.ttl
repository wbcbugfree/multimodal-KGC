@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Total contribution of travel and tourism to the GDP in Southeast Asia from 2010 to 2019 (in billion U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "GDP contribution in billion U.S. dollars" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2009" ;
    :yValue "197.3" ;
    :belongsTo :Chart .

