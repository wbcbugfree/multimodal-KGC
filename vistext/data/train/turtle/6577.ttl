@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Growth of advertising spending in the Middle East and North Africa (MENA) from 2010 to 2022 , by medium" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Radio" .

:YAxis a :Axis ;
    :title "Year" .

:DataPoint1 a :DataPoint ;
    :xValue "-0.057" ;
    :yValue "2022*" ;
    :belongsTo :Chart .

