@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Coronavirus (COVID-19) infection rate in Germany in 2020 , by federal state (per 100,000 inhabitants)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Infection rate per 100,000 people" .

:YAxis a :Axis ;
    :title "state of Germany" .

:DataPoint1 a :DataPoint ;
    :xValue "2749" ;
    :yValue "Saxony" ;
    :belongsTo :Chart .

