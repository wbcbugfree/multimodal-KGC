@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Total United States industrial roundwood consumption from 2006 to 2017 (in million cubic feet)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Consumption in million cubic feet" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2005" ;
    :yValue "18464" ;
    :belongsTo :Chart .

