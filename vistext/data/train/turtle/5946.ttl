    :yValue "1317.3" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Financial managers and directors" ;
    :yValue "1227.5" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Medical practitioners" ;
