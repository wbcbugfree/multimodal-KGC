@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Median full time gross weekly pay of the highest paid occupations in the United Kingdom (UK) as of April 2020 (in British pounds)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "business" .

:YAxis a :Axis ;
    :title "Median full time gross weekly pay in GBP" .

:DataPoint1 a :DataPoint ;
    :xValue "Chief executives and senior officials" ;
    :yValue "1538.7" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Marketing and sales directors" ;
    :yValue "1437.4" ;
    :belongsTo :Chart .

