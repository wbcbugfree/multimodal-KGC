@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "States with the highest femicide rate in Mexico in 2019 (number of femicides per 100,000 women)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "States with the highest femicide rate in Mexico" .

:YAxis a :Axis ;
    :title "Femicide rate" .

:DataPoint1 a :DataPoint ;
    :xValue "Morelos" ;
    :yValue "3.74" ;
    :belongsTo :Chart .

