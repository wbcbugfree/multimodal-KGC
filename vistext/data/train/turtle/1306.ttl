@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Infant mortality rate (under one year old) in Mexico from 1955 to 2020" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Deaths per 1,000 live births" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 1954" ;
    :yValue "121" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Dec 31, 1959" ;
    :yValue "101" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "Dec 31, 1964" ;
    :yValue "88" ;
    :belongsTo :Chart .

