    :xValue "Dec 31, 1974" ;
    :yValue "69" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Dec 31, 1979" ;
    :yValue "57" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Dec 31, 1984" ;
