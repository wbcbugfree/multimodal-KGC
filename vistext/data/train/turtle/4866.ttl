@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Number of passenger cars produced by BMW worldwide from 1999 to 2014 (in millions)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Passenger cars produced (in millions)" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 1998" ;
    :yValue "1.12" ;
    :belongsTo :Chart .

