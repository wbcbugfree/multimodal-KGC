@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Total number of lululemon athletica stores worldwide from 2011 to 2020 , by country" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "2013" .

:YAxis a :Axis ;
    :title "Country" .

:DataPoint1 a :DataPoint ;
    :xValue "168" ;
    :yValue "United States" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "45" ;
    :yValue "Canada" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "25" ;
    :yValue "Australia" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "4" ;
    :yValue "New Zealand" ;
    :belongsTo :Chart .
