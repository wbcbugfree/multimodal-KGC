@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Final energy consumption for space cooling in buildings worldwide in 1990 and 2016 , by region (in terawatt hours)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Country" .

:YAxis a :Axis ;
    :title "2016" .

