@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Average price of used cars in Italy as of 2017 , by region (in euros)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Average price in euros" .

:YAxis a :Axis ;
    :title "region of Italy" .

