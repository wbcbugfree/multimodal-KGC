@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Turnover of enterprises for the manufacture of cocoa , chocolate and sugar confectionary in the United Kingdom (UK) from 2008 to 2019 (in million GBP)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Turnover in million British pounds" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2007" ;
    :yValue "5074" ;
    :belongsTo :Chart .

