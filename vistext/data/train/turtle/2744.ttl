@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Sea freight tonnage departing from Grimsby and Immingham port in the United Kingdom (UK) from 2000 to 2019 (in 1,000 metric tons)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Sea freight in thousand metric tons" .

