@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Prison population and capacity in Italy in 2020 , by region" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Current population" .

:YAxis a :Axis ;
    :title "region of Italy" .

