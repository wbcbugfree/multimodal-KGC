@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Net investment of insurance companies , pension funds and trusts in the United Kingdom (UK) from 2007 to 2018 , by asset type (in billion GBP)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Overseas securities" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2006" ;
    :yValue "44.2" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Dec 31, 2007" ;
    :yValue "15.3" ;
    :belongsTo :Chart .

