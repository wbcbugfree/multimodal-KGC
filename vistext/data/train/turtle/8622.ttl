    :xValue "Dec 31, 2010" ;
    :yValue "13.3" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Dec 31, 2011" ;
    :yValue "46.5" ;
    :belongsTo :Chart .

