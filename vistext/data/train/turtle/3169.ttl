@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Leading YouTube video producers from the Netherlands based on the number of subscribers as of April 2018 (in 1,000s)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "YouTube video producer" .

:YAxis a :Axis ;
    :title "Number of subscribers in thousands" .

