    :yValue "8.8" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "OPEC OECD Europ" ;
    :yValue "14.3" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "OECD Europe Indi" ;
    :yValue "4.7" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "India Latin Americ" ;
    :yValue "5.9" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Latin America Middle East & Afric" ;
