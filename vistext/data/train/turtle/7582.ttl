@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Long-term oil demand outlook worldwide in 2018 and 2040 , by region (in million barrels per day)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Country" .

:YAxis a :Axis ;
    :title "2018" .

:DataPoint1 a :DataPoint ;
    :xValue "OECD Americ" ;
    :yValue "25.5" ;
    :belongsTo :Chart .

