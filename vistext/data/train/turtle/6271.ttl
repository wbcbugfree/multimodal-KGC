@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Origin countries of imported crude oil and natural gas liquids to the United Kingdom (UK) in 2019 (in 1,000 metric tons)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Natural gas" .

:YAxis a :Axis ;
    :title "Country" .

:DataPoint1 a :DataPoint ;
    :xValue "1697" ;
    :yValue "Norway" ;
    :belongsTo :Chart .
