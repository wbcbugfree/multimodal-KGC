@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Number of deaths in Sweden from 2010 to 2020" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Number of deaths" .

:YAxis a :Axis ;
    :title "Year" .

:DataPoint1 a :DataPoint ;
    :xValue "91773" ;
    :yValue "2020" ;
    :belongsTo :Chart .

