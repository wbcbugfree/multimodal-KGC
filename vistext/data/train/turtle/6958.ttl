@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Revenue of Ipsos worldwide from 2010 to 2019 , by geographic region (in million euros)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Americas" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2009" ;
    :yValue "511.3" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Dec 31, 2010" ;
    :yValue "575.7" ;
    :belongsTo :Chart .

