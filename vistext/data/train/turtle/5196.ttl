@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Thinking about the effects of technology on relationships with friends and family , please indicate to what extent do you agree or disagree with each of the following statements ?" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Share of respondents*" .

:YAxis a :Axis ;
    :title "Response" .

:DataPoint1 a :DataPoint ;
    :xValue "0.74" ;
    :yValue "Technology makes getting in touch with family members easier" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "0.59" ;
    :yValue "Technology devices make one feel more connected" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "0.58" ;
    :yValue "Communication technology enables constant dialogue wth family and friends" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "0.45" ;
    :yValue "Social networks are a great way to feel close to family and friends" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "0.45" ;
    :yValue "Technology has little impact on one's frequency of communication with friends or family" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "0.45" ;
    :yValue "Technology makes it easier to arrange meetings with family members" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "0.43" ;
    :yValue "Mobile technology enhances interactions with immediate family" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "0.43" ;
    :yValue "Internet encourages contact with family or friends" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "0.42" ;
    :yValue "Uncomfortable with finding out about life of family members via social network" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "0.36" ;
    :yValue "Technology has led to less face-to-face interactions among families" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "0.32" ;
    :yValue "Uncomfortable knowing family members can monitor one's activity on social media" ;
    :belongsTo :Chart .

:DataPoint12 a :DataPoint ;
    :xValue "0.29" ;
    :yValue "Uncomfortable with family members being able to get in touch at any time" ;
    :belongsTo :Chart .

:DataPoint13 a :DataPoint ;
    :xValue "0.2" ;
    :yValue "Social media helps understanding family members better" ;
    :belongsTo :Chart .

:DataPoint14 a :DataPoint ;
    :xValue "0.18" ;
    :yValue "Playing online games with family members helps connect with them" ;
    :belongsTo :Chart .
