@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Distribution of Florida Power and Light 's operating revenue from FY 2007 to FY 2019 , by customer class" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Other*" .

:YAxis a :Axis ;
    :title "Year" .

:DataPoint1 a :DataPoint ;
    :xValue "0.07" ;
    :yValue "2019" ;
    :belongsTo :Chart .

