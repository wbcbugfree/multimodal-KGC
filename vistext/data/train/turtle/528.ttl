@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "New York Mets all-time RBI (runs batted in) leaders as of October 2020" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Number of home runs" .

:YAxis a :Axis ;
    :title "all-time RBI leaders" .

:DataPoint1 a :DataPoint ;
    :xValue "970" ;
    :yValue "David Wright" ;
    :belongsTo :Chart .

