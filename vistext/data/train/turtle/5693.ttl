@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Most popular video streaming services in the United States as of July 2018 , by mobile only users (in millions)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Platform" .

:YAxis a :Axis ;
    :title "Number of users in millions" .

:DataPoint1 a :DataPoint ;
    :xValue "YouTube" ;
    :yValue "69" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Netflix" ;
    :yValue "38.4" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "Amazon Prime Video*" ;
    :yValue "20.7" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "Hulu" ;
    :yValue "19.3" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "Redbox" ;
    :yValue "13.1" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Vimeo" ;
    :yValue "12" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "dailymotion" ;
    :yValue "9.9" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Ora.TV" ;
    :yValue "9.8" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "Twitch" ;
    :yValue "5.8" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "Spectrum TV" ;
    :yValue "4.7" ;
    :belongsTo :Chart .
