@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Waste Management Inc. 's operating revenue from FY 2007 to FY 2019 (in million U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Operating revenue in million U.S. dollars" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2006" ;
    :yValue "13310" ;
    :belongsTo :Chart .

