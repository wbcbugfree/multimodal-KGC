@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Noble Energy 's revenue from 2007 to 2019 (in million U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Revenue in million U.S. dollars" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2006" ;
    :yValue "3272" ;
    :belongsTo :Chart .

