@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Share of mobile internet traffic in selected countries in 2016 , by device" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Country" .

:YAxis a :Axis ;
    :title "Combined mobile" .

:DataPoint1 a :DataPoint ;
    :xValue "Japan" ;
    :yValue "0.53" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "United Kingdom" ;
    :yValue "0.5" ;
    :belongsTo :Chart .

