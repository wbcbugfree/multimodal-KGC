    :xValue "South Korea" ;
    :yValue "0.46" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "United States" ;
    :yValue "0.45" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "New Zealand" ;
    :yValue "0.45" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
