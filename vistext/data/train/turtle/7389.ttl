@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Usage of selected social media apps during the planning of everyday activities according to users in the United States as of October 2015" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "Twitter" .

