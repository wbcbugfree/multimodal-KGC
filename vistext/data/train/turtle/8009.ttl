@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Population aged between 15 and 29 years in China from 2000 to 2050 , by age group (in millions)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "15-19 years" .

:DataPoint1 a :DataPoint ;
    :xValue "2050*" ;
    :yValue "68.26" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "2045*" ;
    :yValue "70.6" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "2040*" ;
    :yValue "75.86" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "2035*" ;
    :yValue "83.38" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "2030*" ;
    :yValue "86.31" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "2025*" ;
    :yValue "83.96" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "2020*" ;
    :yValue "82.34" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "2015" ;
    :yValue "87.68" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "2010" ;
    :yValue "99.12" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "2005" ;
    :yValue "130.92" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "2000" ;
    :yValue "102.8" ;
    :belongsTo :Chart .
