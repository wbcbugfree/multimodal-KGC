@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Why did you get separated and/or divorced ?" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Share of respondents" .

:YAxis a :Axis ;
    :title "Response" .

:DataPoint1 a :DataPoint ;
    :xValue "0.215" ;
    :yValue "Betrayal/Infidelity" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "0.175" ;
    :yValue "Because love is over" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "0.13" ;
    :yValue "Violent and aggressive attitude" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "0.13" ;
    :yValue "Did not get along anymore" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "0.085" ;
    :yValue "Physical distance" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "0.085" ;
    :yValue "Doesn't know/doesn't reply" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "0.045" ;
    :yValue "Family intrusions" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "0.045" ;
    :yValue "Lack of sexual desire/poor sex" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "0.045" ;
    :yValue "Incompatible characters" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "0.045" ;
    :yValue "Different views on the upbringing of children" ;
    :belongsTo :Chart .
