@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Number of establishments in the music industry in the United States from 2007 to 2017 , by sector" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Record production and distribution (overall)" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2006" ;
    :yValue "811" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Dec 31, 2007" ;
    :yValue "819" ;
    :belongsTo :Chart .

