@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Share of discretionary mandate and investment fund assets under management in Europe in the end of 2015 , by country" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Country" .

:YAxis a :Axis ;
    :title "Discretionary mandates" .

:DataPoint1 a :DataPoint ;
    :xValue "Portugal" ;
    :yValue "0.76" ;
    :belongsTo :Chart .

