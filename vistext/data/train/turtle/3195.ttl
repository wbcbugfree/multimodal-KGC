@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Top 10 U.S. states based on production value of principal fresh and processing market vegetables in 2019 (in 1,000 U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "State" .

:YAxis a :Axis ;
    :title "Production value in thousand U.S. dollars" .

:DataPoint1 a :DataPoint ;
    :xValue "California" ;
    :yValue "7864286" ;
    :belongsTo :Chart .

