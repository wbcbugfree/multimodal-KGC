@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Average issue readership of the Yorkshire Post in the United Kingdom (UK) from 2003 to 2016 (in 1,000 readers)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "AIR in thousands*" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2002" ;
    :yValue "196" ;
    :belongsTo :Chart .

