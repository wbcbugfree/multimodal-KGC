@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "What preventive measures do you take due to the coronavirus (COVID-19) outbreak ?" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Share of respondents" .

:YAxis a :Axis ;
    :title "Response" .

:DataPoint1 a :DataPoint ;
    :xValue "0.05" ;
    :yValue "Practicing good hygiene" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "0.03" ;
    :yValue "Take medicines and ointments" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "0.03" ;
    :yValue "Strengthening immune system with folk remedies" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "0.03" ;
    :yValue "Use masks" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "0.03" ;
    :yValue "Reduce contacts, go to public places less often" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "0.02" ;
    :yValue "Take vitamins" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "0.01" ;
    :yValue "Drink alcohol" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "0.01" ;
    :yValue "Do sports, physical activity, outdoor activity" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "0.01" ;
    :yValue "Get flu shots" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "0.01" ;
    :yValue "Consume fresh fruit and vegetables" ;
    :belongsTo :Chart .
