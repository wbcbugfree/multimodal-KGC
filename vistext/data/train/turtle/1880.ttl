@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Number of half-marathon finishers in the United States from 2004 to 2016 (in 1,000s)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Number of finishers in thousands" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2003" ;
    :yValue "612" ;
    :belongsTo :Chart .

