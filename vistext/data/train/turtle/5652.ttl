@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Crude oil imports from Iran between January and June 2011 , by key destination country (in 1,000 barrels per day)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Country" .

:YAxis a :Axis ;
    :title "Oil imports in thousand barrels per day" .

:DataPoint1 a :DataPoint ;
    :xValue "China" ;
    :yValue "543" ;
    :belongsTo :Chart .

