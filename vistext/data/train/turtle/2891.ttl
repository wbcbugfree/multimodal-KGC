@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Number of Inditex stores in European countries with more than 100 establishments of the Spanish textile group in 2019 , by country" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Country" .

:YAxis a :Axis ;
    :title "Number of stores" .

:DataPoint1 a :DataPoint ;
    :xValue "Spain" ;
    :yValue "1590" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Russian Federation" ;
    :yValue "549" ;
    :belongsTo :Chart .

