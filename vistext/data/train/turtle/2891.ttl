    :xValue "France" ;
    :yValue "288" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Poland" ;
    :yValue "244" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Turkey" ;
    :yValue "226" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Greece" ;
    :yValue "164" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "Germany" ;
    :yValue "130" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "Romania" ;
