@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Market cap of leading online marketplaces worldwide as of September 2020 (in million U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Market cap in million U.S. dollars" .

:YAxis a :Axis ;
    :title "business" .

:DataPoint1 a :DataPoint ;
    :xValue "63936" ;
    :yValue "Uber (United States)" ;
    :belongsTo :Chart .

