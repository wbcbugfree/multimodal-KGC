@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "How worried are you about the possibility of future terrorist attacks in the U.S. ?" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "Great deal" .

:DataPoint1 a :DataPoint ;
    :xValue "Mar 03, 2006" ;
    :yValue "0.4" ;
    :belongsTo :Chart .

