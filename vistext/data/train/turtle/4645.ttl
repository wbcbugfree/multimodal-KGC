@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Top 15 most frequently visited websites in Sweden as of March 2017" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "website" .

:YAxis a :Axis ;
    :title "Weekly reach" .

:DataPoint1 a :DataPoint ;
    :xValue "google.se" ;
    :yValue "0.895" ;
    :belongsTo :Chart .

