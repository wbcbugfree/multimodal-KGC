@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Average annual price of heavy fuel oil per metric ton for the manufacturing industry in Great Britain from 2010 to 2019 (in GBP)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Small consumer**" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2009" ;
    :yValue "506.9" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Dec 31, 2010" ;
    :yValue "625.6" ;
    :belongsTo :Chart .

