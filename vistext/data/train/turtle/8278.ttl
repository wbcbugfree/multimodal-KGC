@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Which method do you prefer for buying your purchases ?" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Online via mobile or smartphone" .

:YAxis a :Axis ;
    :title "Response" .

:DataPoint1 a :DataPoint ;
    :xValue "0.02" ;
    :yValue "Clothing and footwear" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "0.01" ;
    :yValue "Consumer electronics and computers" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "0.03" ;
    :yValue "Books, music, movies, video games" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "0.02" ;
    :yValue "Grocery" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "0.01" ;
    :yValue "Household appliances" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "0.01" ;
    :yValue "Furniture and homeware" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "0.02" ;
    :yValue "Home improvement" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "0.03" ;
    :yValue "Health and beauty" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "0.02" ;
    :yValue "Jewellery" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "0.02" ;
    :yValue "Sports equipment" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "0.02" ;
    :yValue "Toys" ;
    :belongsTo :Chart .
