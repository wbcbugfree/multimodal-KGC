@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "NHL players with the highest salaries in 2011/12 (in million U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Salary (in million U.S. dollars)" .

:YAxis a :Axis ;
    :title "Players" .

:DataPoint1 a :DataPoint ;
    :xValue "12" ;
    :yValue "Brad Richards (New York Rangers)" ;
    :belongsTo :Chart .

