@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Global CIOs and IT executives ' economic recovery expectations for COVID-19 , by industry" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "I'm not sure" .

:DataPoint1 a :DataPoint ;
    :xValue "Financials/Insurance" ;
    :yValue "0.16" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "IT/TelCo" ;
    :yValue "0.12" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "Services/Consulting" ;
    :yValue "0.1" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "Retail/Consumer" ;
    :yValue "0.07" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "Indus/Mat/Manu" ;
    :yValue "0.08" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Health/Pharma" ;
    :yValue "0.13" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Education" ;
    :yValue "0.14" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Energy/Utilities" ;
    :yValue "0.08" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "Other (Airlines/Transportation)" ;
    :yValue "0.05" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "All Respondents" ;
    :yValue "0.11" ;
    :belongsTo :Chart .
