@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Total neodymium oxide demand worldwide excluding China from 2009 to 2025 (in metric tons)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Demand in metric tons" .

