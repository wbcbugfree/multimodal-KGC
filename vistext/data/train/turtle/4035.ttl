@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Total production of pulses in India from financial year 2002 to 2019 , with an estimate for 2020 (in million metric tons)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Production in million metric tons" .

:YAxis a :Axis ;
    :title "year" .

:DataPoint1 a :DataPoint ;
    :xValue "23.01" ;
    :yValue "FY 2020" ;
    :belongsTo :Chart .

