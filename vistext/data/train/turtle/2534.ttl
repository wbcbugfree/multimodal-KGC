@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Generation of non-hydro renewable energy in the U.S. from 2007 to 2019 (in terawatt hours)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Generation in terawatt hours" .

:DataPoint1 a :DataPoint ;
    :xValue "2019*" ;
    :yValue "486" ;
    :belongsTo :Chart .

