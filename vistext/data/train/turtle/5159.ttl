@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Average attendance per game at the Argentinian soccer championship Superliga during 2018/2019 season , by team" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Number of spectators" .

:YAxis a :Axis ;
    :title "name of football club" .

