@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Volume of wine imports to India in 2018 , by country of origin (in 1,000 liters)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Volume in thousand liters" .

:YAxis a :Axis ;
    :title "Country" .

