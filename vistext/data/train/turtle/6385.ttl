@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Number of TUI AG employees worldwide from 2011 to 2020 , by geographical region" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Spain" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2010" ;
    :yValue "9392" ;
    :belongsTo :Chart .

