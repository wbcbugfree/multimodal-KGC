@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Number of employees of KPMG worldwide from 2010 to 2019 , by region" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Region" .

:YAxis a :Axis ;
    :title "Asia Pacific" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2009" ;
    :yValue "31039" ;
    :belongsTo :Chart .

