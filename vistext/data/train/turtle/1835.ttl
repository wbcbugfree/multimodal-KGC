    :xValue "Dec 31, 2024" ;
    :yValue "604924" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "Dec 31, 2029" ;
    :yValue "612486" ;
    :belongsTo :Chart .

