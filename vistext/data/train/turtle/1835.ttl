@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Forecast of the number of single-parent households in the Netherlands from 2019 to 2060" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Number of households" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2018" ;
    :yValue "580436" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Dec 31, 2019" ;
    :yValue "586996" ;
    :belongsTo :Chart .

