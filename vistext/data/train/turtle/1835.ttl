    :xValue "Dec 31, 2034" ;
    :yValue "622213" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Dec 31, 2039" ;
    :yValue "637755" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Dec 31, 2044" ;
    :yValue "652587" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Dec 31, 2049" ;
    :yValue "660373" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
