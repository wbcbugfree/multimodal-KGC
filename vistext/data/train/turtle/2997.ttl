@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Boston Celtics all-time assists leaders from 1946 to 2020" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Player" .

:YAxis a :Axis ;
    :title "Assists" .

:DataPoint1 a :DataPoint ;
    :xValue "Bob Cousy" ;
    :yValue "6945" ;
    :belongsTo :Chart .

