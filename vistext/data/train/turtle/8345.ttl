@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Share of discretionary mandate and investment fund assets under management in Europe in the end of 2015 , by country" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Investment funds" .

:YAxis a :Axis ;
    :title "Country" .

:DataPoint1 a :DataPoint ;
    :xValue "0.24" ;
    :yValue "Portugal" ;
    :belongsTo :Chart .

