@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Number of registered motor vehicles across Haryana in India from financial year 2007 to 2017 (in millions)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Number of vehicles in millions" .

:YAxis a :Axis ;
    :title "year" .

:DataPoint1 a :DataPoint ;
    :xValue "9.37" ;
    :yValue "FY 2017" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "8.63" ;
    :yValue "FY 2016" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "7.93" ;
    :yValue "FY 2015" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "7.24" ;
    :yValue "FY 2014" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "6.6" ;
    :yValue "FY 2013" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "5.98" ;
    :yValue "FY 2012" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "5.38" ;
    :yValue "FY 2011" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "4.79" ;
    :yValue "FY 2010" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "4.43" ;
    :yValue "FY 2009" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "3.97" ;
    :yValue "FY 2008" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "3.53" ;
    :yValue "FY 2007" ;
    :belongsTo :Chart .
