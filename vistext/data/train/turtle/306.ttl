@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Leading PC and console video games sales value in France in 2018 (in million euros)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Title (Platform)" .

:YAxis a :Axis ;
    :title "Sales in million euros" .

:DataPoint1 a :DataPoint ;
    :xValue "FIFA 19 (PS4)" ;
    :yValue "54.2" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Red Dead Redemption 2 (PS4)" ;
    :yValue "36.4" ;
    :belongsTo :Chart .

