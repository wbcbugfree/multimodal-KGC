    :xValue "Mario Kart 8 Deluxe (Switch)" ;
    :yValue "27.7" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "Call of Duty: Black Ops 4 (PS4)" ;
    :yValue "27.2" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "Super Mario Party (Switch)" ;
    :yValue "19.3" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Super Smash Bros. Ultimate (Switch)" ;
    :yValue "18" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Spider-Man (PS4)" ;
