@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "App categories that mobile users in the United States spend the most time on as of 3rd quarter 2019" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Share of respondents" .

:YAxis a :Axis ;
    :title "Response" .

:DataPoint1 a :DataPoint ;
    :xValue "0.49" ;
    :yValue "Social media / chat" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "0.36" ;
    :yValue "Mail" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "0.42" ;
    :yValue "Browsers" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "0.17" ;
    :yValue "News" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "0.25" ;
    :yValue "Music / radio" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "0.14" ;
    :yValue "Finance / bank" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "0.26" ;
    :yValue "Games" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "0.15" ;
    :yValue "Weather" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "0.11" ;
    :yValue "TV / Series / Movies" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "0.15" ;
    :yValue "Shopping" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "0.04" ;
    :yValue "Travel" ;
    :belongsTo :Chart .

:DataPoint12 a :DataPoint ;
    :xValue "0.08" ;
    :yValue "Other" ;
    :belongsTo :Chart .
