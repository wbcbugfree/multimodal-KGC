@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Percentage of people who died from COVID-19 in the United States from January 22 to May 30 , 2020 , by presence of underlying health condition and age" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Patients with an underlying health condition" .

:DataPoint1 a :DataPoint ;
    :xValue "9 years and younger" ;
    :yValue "0.006" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "10 to 19 years" ;
    :yValue "0.008" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "20 to 29 years" ;
    :yValue "0.014" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "30 to 39 years" ;
    :yValue "0.028" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "40 to 49 years" ;
    :yValue "0.045" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "50 to 59 years" ;
    :yValue "0.078" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "60 to 69 years" ;
    :yValue "0.167" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "70 to 79 years" ;
    :yValue "0.317" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "80 years and older" ;
    :yValue "0.497" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "Total" ;
    :yValue "0.195" ;
    :belongsTo :Chart .
