    :xValue "Hong Kong, China" ;
    :yValue "0.036" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Republic of Korea" ;
    :yValue "0.032" ;
    :belongsTo :Chart .

