@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Share of the leading merchandise importers worldwide in 2019 , by importing nation" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Importing nation" .

:YAxis a :Axis ;
    :title "Import share" .

:DataPoint1 a :DataPoint ;
    :xValue "United States" ;
    :yValue "0.162" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Extra-EU (28)" ;
    :yValue "0.136" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "China" ;
    :yValue "0.131" ;
    :belongsTo :Chart .

