@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Number of doping cases in international sports from 2000 to 2010" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Number of cases" .

:DataPoint1 a :DataPoint ;
    :xValue "2010" ;
    :yValue "202" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "2009" ;
    :yValue "223" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "2008" ;
    :yValue "244" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "2007" ;
    :yValue "217" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "2006" ;
    :yValue "214" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "2005*" ;
    :yValue "430" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "2004" ;
    :yValue "158" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "2003" ;
    :yValue "139" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "2002" ;
    :yValue "53" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "2001" ;
