@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Number of motorcycles and cars registered in Great Britain between 2000 and 2019 (in 1,000 units)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Motorcycles" .

