@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Average penetration rate of sportswear brands in Turkey in 2012 and 2013" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "2012" .

:YAxis a :Axis ;
    :title "Brand" .

