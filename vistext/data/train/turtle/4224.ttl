@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Professional golfers with the most money earned on the PGA tour in the 2020 season (in million U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Golf player" .

:YAxis a :Axis ;
    :title "Money earned in million U.S. dollars" .

:DataPoint1 a :DataPoint ;
    :xValue "Dustin Johnson" ;
    :yValue "3.11" ;
    :belongsTo :Chart .

