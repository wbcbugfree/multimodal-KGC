    :yValue "1.89" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Xander Schauffele" ;
    :yValue "1.83" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
