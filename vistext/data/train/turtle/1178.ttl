@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Simple average house price for bungalow dwellings in the United Kingdom (UK) from 2000 to 2019 (in GBP)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Simple average house price in GBP" .

