@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Total sugar production from sugar beet in the United Kingdom (UK) from 2003 to 2016 (in tonnes)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Sugar production in tonnes" .

:DataPoint1 a :DataPoint ;
    :xValue "2015/16" ;
    :yValue "977780" ;
    :belongsTo :Chart .

