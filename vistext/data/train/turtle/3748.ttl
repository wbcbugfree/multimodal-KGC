@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Installed power capacity across Haryana in India from financial year 2005 to 2018 (in megawatts)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Installed power capacity in megawatts" .

:YAxis a :Axis ;
    :title "year" .

:DataPoint1 a :DataPoint ;
    :xValue "11260.32" ;
    :yValue "FY 2018" ;
    :belongsTo :Chart .

