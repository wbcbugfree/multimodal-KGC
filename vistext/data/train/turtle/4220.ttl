@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Electricity prices for households in France from 2010 to 2018 , semi-annually (in euro cents per kilowatt-hour)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Euro cents per kilowatt-hour" .

:YAxis a :Axis ;
    :title "Year" .

:DataPoint1 a :DataPoint ;
    :xValue "17.99" ;
    :yValue "2010 H2" ;
    :belongsTo :Chart .

