@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "France : Degree of urbanization from 2009 to 2019" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Proportion of urban population within the whole" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2008" ;
    :yValue "0.7812" ;
    :belongsTo :Chart .

