@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Volume of private equity investments in Europe in 2016 , by industry (in 1,000 euros)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "industry" .

:YAxis a :Axis ;
    :title "Investments in 1,000 euros" .

:DataPoint1 a :DataPoint ;
    :xValue "Consumer goods & services" ;
    :yValue "14271131" ;
    :belongsTo :Chart .

