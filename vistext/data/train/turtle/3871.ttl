@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Sales value of protein concentrates manufactured in the United Kingdom (UK) from 2008 to 2019 (in 1,000 GBP)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Sales value in thousand British pounds" .

:DataPoint1 a :DataPoint ;
    :xValue "2019" ;
    :yValue "462280" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "2018" ;
    :yValue "438513" ;
    :belongsTo :Chart .

