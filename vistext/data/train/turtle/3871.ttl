    :xValue "2016" ;
    :yValue "339157" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "2015**" ;
    :yValue "353749" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "2014" ;
    :yValue "471816" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "2013" ;
