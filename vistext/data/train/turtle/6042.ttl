@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Amount of U.S. tea imports from selected countries of origin in 2018 (in 1,000 metric tons)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Country" .

:YAxis a :Axis ;
    :title "2012" .

:DataPoint1 a :DataPoint ;
    :xValue "Argentini" ;
    :yValue "50205" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Argentinia Canad" ;
    :yValue "55723" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "Canada Chin" ;
    :yValue "29527" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "China Indi" ;
    :yValue "13906" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "India Vietna" ;
    :yValue "8164" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Vietnam Sri Lank" ;
    :yValue "4151" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Sri Lanka Malaw" ;
    :yValue "3729" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Malawi Germany*" ;
    :yValue "7160" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "Germany** Indonesi" ;
