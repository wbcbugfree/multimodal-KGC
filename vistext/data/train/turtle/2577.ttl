@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Average tuition fee for full-time international undergraduate students in Canada in 2020/21 , by field of study (in Canadian dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Field of study" .

:YAxis a :Axis ;
    :title "Average tuition fee in Canadian dollars" .

