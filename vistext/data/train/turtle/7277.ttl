@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Overall weekly hours of work for all employees in the United Kingdom (UK) from 2000 to 2019 , by gender (in million hours)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Women" .

