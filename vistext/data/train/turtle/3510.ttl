@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Ecuador : Budget balance between 2015 to 2025 in relation to GDP" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Budget balance in relation to GDP" .

:DataPoint1 a :DataPoint ;
    :xValue "2025*" ;
    :yValue "0.0226" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "2024*" ;
    :yValue "0.0241" ;
    :belongsTo :Chart .

