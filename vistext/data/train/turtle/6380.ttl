@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Share of family households with own children under 18 years in the United States from 1970 to 2020 , by type of family" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Single mother*" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 1969" ;
    :yValue "0.52" ;
    :belongsTo :Chart .

