@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Outlook of the direct and total contribution of travel and tourism to GDP from 2020 to 2029 (in billion U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Total contribution" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2019" ;
    :yValue "10001.1" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Dec 31, 2020" ;
    :yValue "10740.5" ;
    :belongsTo :Chart .

