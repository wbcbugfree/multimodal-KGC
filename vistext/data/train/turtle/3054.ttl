@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Number of sporting and athletic goods manufacturing establishments in Canada as of December 2019 , by region" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Number of establishments" .

:YAxis a :Axis ;
    :title "province of Canada" .

:DataPoint1 a :DataPoint ;
    :xValue "101" ;
    :yValue "Ontario" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "77" ;
    :yValue "Quebec" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "44" ;
    :yValue "British Columbia" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "16" ;
    :yValue "Alberta" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "5" ;
    :yValue "Nova Scotia" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "5" ;
    :yValue "Manitoba" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "3" ;
    :yValue "Saskatchewan" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "3" ;
    :yValue "New Brunswick" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "1" ;
    :yValue "Prince Edward Island" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "1" ;
    :yValue "Newfoundland and Labrador" ;
    :belongsTo :Chart .
