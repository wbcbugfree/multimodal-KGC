    :belongsTo :Chart .

:DataPoint13 a :DataPoint ;
    :xValue "Dec 31, 2016" ;
    :yValue "1.65" ;
    :belongsTo :Chart .

:DataPoint14 a :DataPoint ;
    :xValue "Dec 31, 2017" ;
    :yValue "1.65" ;
    :belongsTo :Chart .
