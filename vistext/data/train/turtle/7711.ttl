@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Prices of rare earth oxides worldwide from 2009 to 2013" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "rare earth oxides" .

:YAxis a :Axis ;
    :title "2011" .

:DataPoint1 a :DataPoint ;
    :xValue "Lanthanum oxide (US$/metric ton" ;
    :yValue "98757" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Lanthanum oxide (US$/metric ton) Cerium oxide (US$/metric ton" ;
    :yValue "98217" ;
    :belongsTo :Chart .

