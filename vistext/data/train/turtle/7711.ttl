    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "Holmium oxide (US$/kilogram) Erbium oxide (US$/kilogram" ;
    :yValue "236" ;
    :belongsTo :Chart .

:DataPoint12 a :DataPoint ;
    :xValue "Erbium oxide (US$/kilogram) Ytterbium oxide (US$/kilogram" ;
