@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Number of confirmed coronavirus (COVID-19) cases in Canada as of January 5 , 2021 , by province or territory" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "province of Canada" .

:YAxis a :Axis ;
    :title "Number of confirmed cases" .

:DataPoint1 a :DataPoint ;
    :xValue "Canada (total)" ;
    :yValue "618646" ;
    :belongsTo :Chart .

