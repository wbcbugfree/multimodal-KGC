@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Percentage of internet users in selected countries who have ever experienced any cyber crime as of December 2019" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "Share of respondents" .

:DataPoint1 a :DataPoint ;
    :xValue "India" ;
    :yValue "0.8" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "United States" ;
    :yValue "0.61" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "France" ;
    :yValue "0.6" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "New Zealand" ;
    :yValue "0.59" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "Australia" ;
    :yValue "0.57" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Global" ;
    :yValue "0.56" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "United Kingdom" ;
    :yValue "0.55" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Italy" ;
    :yValue "0.53" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "Netherlands" ;
    :yValue "0.51" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "Germany" ;
    :yValue "0.47" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "Japan" ;
    :yValue "0.42" ;
    :belongsTo :Chart .
