@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Eni S.p.A. 's number of employees from 2008 to 2019" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Number of employees" .

:YAxis a :Axis ;
    :title "Year" .

:DataPoint1 a :DataPoint ;
    :xValue "32053" ;
    :yValue "2019" ;
    :belongsTo :Chart .

