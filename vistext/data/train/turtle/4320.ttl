@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Most popular mobile messenger applications used in Poland in 2019" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Share of respondents" .

:YAxis a :Axis ;
    :title "Response" .

:DataPoint1 a :DataPoint ;
    :xValue "0.864" ;
    :yValue "Messenger" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "0.439" ;
    :yValue "WhatsApp" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "0.23" ;
    :yValue "Skype" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "0.193" ;
    :yValue "Twitter" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "0.08" ;
    :yValue "Gadu-Gadu" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "0.079" ;
    :yValue "iMessage (Apple)" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "0.076" ;
    :yValue "Viber" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "0.034" ;
    :yValue "Google Talk" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "0.029" ;
    :yValue "LinkedIN" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "0.014" ;
    :yValue "BlackBerry Messanger" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "0.021" ;
    :yValue "Other" ;
    :belongsTo :Chart .
