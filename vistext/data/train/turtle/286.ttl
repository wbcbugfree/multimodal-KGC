@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Average length of videos from top publishers on Instagram as of June 2017 (in seconds)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Video duration in seconds" .

:YAxis a :Axis ;
    :title "top publishers on Instagram" .

:DataPoint1 a :DataPoint ;
    :xValue "60" ;
    :yValue "BuzzFeed News" ;
    :belongsTo :Chart .

