@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "U.S. tobacco farming gross output from 1998 to 2011 (in million U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Gross output in million U.S. dollars" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 1997" ;
    :yValue "2714" ;
    :belongsTo :Chart .

