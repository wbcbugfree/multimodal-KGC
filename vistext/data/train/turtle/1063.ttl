@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Total number of magnet schools in the United States from 2000/01 to 2017/18" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Number of magnet schools" .

:YAxis a :Axis ;
    :title "Year" .

:DataPoint1 a :DataPoint ;
    :xValue "3421" ;
    :yValue "2017/18" ;
    :belongsTo :Chart .

