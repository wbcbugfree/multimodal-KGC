@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Number of new movies released in the United States from 2003 to 2013" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Number of releases" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2002" ;
    :yValue "528" ;
    :belongsTo :Chart .

