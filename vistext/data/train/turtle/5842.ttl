@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Total sports gate revenues in North America from 2006 to 2023 (in billion U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Gate revenues in billion U.S. dollars" .

:YAxis a :Axis ;
    :title "Year" .

