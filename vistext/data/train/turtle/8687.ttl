@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Visitor exports in selected countries worldwide from 2016 to 2017 (in billion U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "2016" .

:YAxis a :Axis ;
    :title "Country" .

:DataPoint1 a :DataPoint ;
    :xValue "212.3" ;
    :yValue "United States" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "65.7" ;
    :yValue "Spain" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "46.7" ;
    :yValue "Germany" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "46.8" ;
    :yValue "France" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "41.6" ;
    :yValue "Italy" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "37" ;
    :yValue "United Kingdom" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "32.4" ;
    :yValue "Japan" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "20.3" ;
    :yValue "Australia" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "16.7" ;
    :yValue "Greece" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "15" ;
    :yValue "Canada" ;
    :belongsTo :Chart .
