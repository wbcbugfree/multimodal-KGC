@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Annual number of hospital beds in the United Kingdom (UK) from 2000 to 2019" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Number of beds" .

