@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Leading rum brands worldwide in 2013 , based on sales volume growth (in 1,000 9-liter cases)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Volume sales growth in thousand 9-liter cases" .

:YAxis a :Axis ;
    :title "Country" .

:DataPoint1 a :DataPoint ;
    :xValue "1790" ;
    :yValue "Hercules" ;
    :belongsTo :Chart .

