@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Value of cotton imported into India from financial year 2011 to 2020 (in billion Indian rupees)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Fiscal year" .

:YAxis a :Axis ;
    :title "Import value in billion Indian rupees" .

:DataPoint1 a :DataPoint ;
    :xValue "FY 2020" ;
    :yValue "93.71" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "FY 2019" ;
    :yValue "43.83" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "FY 2018" ;
    :yValue "63.07" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "FY 2017" ;
    :yValue "63.4" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "FY 2016" ;
    :yValue "25.7" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "FY 2015" ;
    :yValue "31.02" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "FY 2014" ;
    :yValue "23.76" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "FY 2013" ;
    :yValue "24.67" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "FY 2012" ;
    :yValue "10.59" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "FY 2011" ;
    :yValue "6.22" ;
    :belongsTo :Chart .
