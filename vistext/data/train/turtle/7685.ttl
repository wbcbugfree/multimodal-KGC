@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Sales of La-Z-Boy worldwide from 2010 to 2020 , by segment (in million U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Segment" .

:YAxis a :Axis ;
    :title "Casegoods" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2009" ;
    :yValue "146.71" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Dec 31, 2010" ;
    :yValue "152.53" ;
    :belongsTo :Chart .

