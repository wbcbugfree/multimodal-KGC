@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "United Kingdom : Life expectancy at birth from 2008 to 2018" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Live expectancy at birth in years" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2007" ;
    :yValue "79.6" ;
    :belongsTo :Chart .

