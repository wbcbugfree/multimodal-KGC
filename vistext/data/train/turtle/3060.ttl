@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Total population of Greece from 2007 to 2016" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Total population" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2006" ;
    :yValue "11036008" ;
    :belongsTo :Chart .

