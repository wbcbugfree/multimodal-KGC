@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Sierra Club 's ranking of the greenest universities in the United States for 2020" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "US University" .

:YAxis a :Axis ;
    :title "Total score" .

