@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Which , if any , of the following Disney princess movies have you ever watched ?" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Share of respondents" .

:YAxis a :Axis ;
    :title "Response" .

:DataPoint1 a :DataPoint ;
    :xValue "0.74" ;
    :yValue "Snow White and the Seven Dwarves" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "0.61" ;
    :yValue "Aladdin" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "0.6" ;
    :yValue "Sleeping Beauty" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "0.6" ;
    :yValue "Cinderella (1950 animated version)" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "0.51" ;
    :yValue "Frozen" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "0.51" ;
    :yValue "Beauty and the Beast (1991 animated version)" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "0.43" ;
    :yValue "The Little Mermaid" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "0.38" ;
    :yValue "Pocahontas" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "0.33" ;
    :yValue "Tangled" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "0.33" ;
    :yValue "Brave" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "0.29" ;
    :yValue "Mulan" ;
    :belongsTo :Chart .

:DataPoint12 a :DataPoint ;
    :xValue "0.23" ;
    :yValue "Moana" ;
    :belongsTo :Chart .

:DataPoint13 a :DataPoint ;
    :xValue "0.21" ;
    :yValue "The Princess and the Frog" ;
    :belongsTo :Chart .
