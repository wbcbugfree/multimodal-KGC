@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Leading countries with the most certified Fairtrade International workers in 2012" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Country" .

:YAxis a :Axis ;
    :title "Number of workers" .

:DataPoint1 a :DataPoint ;
    :xValue "India" ;
    :yValue "71600" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Kenya" ;
    :yValue "36200" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "Sri Lanka" ;
    :yValue "22800" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "Ethiopia" ;
    :yValue "13300" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "South Africa" ;
    :yValue "8200" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Pakistan" ;
    :yValue "5000" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Ghana" ;
    :yValue "4400" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Tanzania" ;
    :yValue "4400" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "Malawi" ;
    :yValue "4100" ;
