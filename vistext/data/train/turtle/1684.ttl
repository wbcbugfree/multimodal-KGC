@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Infant mortality rate (under one year old) in Japan from 1920 to 2020" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Deaths per 1,000 live births" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 1919" ;
    :yValue "166" ;
    :belongsTo :Chart .

