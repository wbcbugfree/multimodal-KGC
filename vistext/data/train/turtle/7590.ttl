@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Average retail price for prime rib roast in Canada from January 2015 to April 2020 (in Canadian dollars per kilogram)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Month" .

:YAxis a :Axis ;
    :title "2017" .

:DataPoint1 a :DataPoint ;
