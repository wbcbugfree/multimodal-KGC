@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Population in Sweden from 2009 to 2019 , by origin (in millions)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Swedish origin" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2008" ;
    :yValue "7.61" ;
    :belongsTo :Chart .

