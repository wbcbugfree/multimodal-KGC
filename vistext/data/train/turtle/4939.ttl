@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Average cost of a standard double room in a hotel in Paris between January 2016 and August 2017 (in euros)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Average cost in euros" .

:YAxis a :Axis ;
    :title "Month" .

