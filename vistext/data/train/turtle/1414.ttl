@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Major League Baseball average ticket price from 2006 to 2020 (in U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Ticket price in U.S. dollars" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2005" ;
    :yValue "22.21" ;
    :belongsTo :Chart .

