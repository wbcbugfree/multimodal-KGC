@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "State and local property tax revenue in the United States from 1977 to 2018 (in billion U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Revenue in billion U.S. dollars" .

