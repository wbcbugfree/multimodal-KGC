@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Which factor is most important to your organization when it selects the location of contact centers ?" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "Share of respondents" .

:DataPoint1 a :DataPoint ;
    :xValue "Labor availability" ;
    :yValue "0.7" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Labor cost" ;
    :yValue "0.47" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "Customer demands/perceptions" ;
    :yValue "0.42" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "Labor quality/specialty" ;
    :yValue "0.35" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "Political, social or natural disaster risks" ;
    :yValue "0.31" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Language skills" ;
    :yValue "0.25" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Proximity to headquarters, functions, customer" ;
    :yValue "0.13" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Regulatory requirements" ;
    :yValue "0.1" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "Tax impacts/advantages" ;
    :yValue "0.1" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "Labor sustainability (retention)" ;
    :yValue "0.09" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "Time zone considerations" ;
    :yValue "0.07" ;
    :belongsTo :Chart .
