@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Outsourced or off-shored IT functions worldwide , as of 2017" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Share of respondents" .

:YAxis a :Axis ;
    :title "Response" .

:DataPoint1 a :DataPoint ;
    :xValue "0.64" ;
    :yValue "Software application development" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "0.51" ;
    :yValue "Software application maintenance" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "0.4" ;
    :yValue "Data centers" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "0.32" ;
    :yValue "IT infrastructure" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "0.32" ;
    :yValue "Service desk / help desk" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "0.29" ;
    :yValue "Networks" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "0.29" ;
    :yValue "Systems integration" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "0.12" ;
    :yValue "HR BPO" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "0.12" ;
    :yValue "IT department" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "0.12" ;
    :yValue "IT BPO" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "0.06" ;
    :yValue "KPO" ;
    :belongsTo :Chart .
