@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Employment in the agricultural sector in Brazil from 2010 to 2020 , as share of total employment" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "Share of total employment" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2009" ;
    :yValue "0.1265" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Dec 31, 2010" ;
    :yValue "0.1199" ;
    :belongsTo :Chart .

