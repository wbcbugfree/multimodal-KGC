@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Commercial vehicle sales in Canada from 2005 to 2019 (in 1,000 units)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Commercial vehicle sales in thousand units" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2004" ;
    :yValue "782.71" ;
    :belongsTo :Chart .

