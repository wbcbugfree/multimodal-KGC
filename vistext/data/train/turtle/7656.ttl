@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Combined revenue of EY worldwide from 2009 to 2020 , by region (in billion U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Asia Pacific" .

:YAxis a :Axis ;
    :title "Year" .

:DataPoint1 a :DataPoint ;
    :xValue "5.84" ;
    :yValue "2020**" ;
    :belongsTo :Chart .

