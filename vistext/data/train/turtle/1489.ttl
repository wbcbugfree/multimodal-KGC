@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Gross domestic product of Nunavut , Canada in 2019 , by industry (in million chained 2012 Canadian dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "industry classification" .

:YAxis a :Axis ;
    :title "GDP in million chained 2012 Canadian dollars" .

:DataPoint1 a :DataPoint ;
    :xValue "Mining, quarrying, and oil and gas extraction" ;
    :yValue "876.1" ;
    :belongsTo :Chart .

