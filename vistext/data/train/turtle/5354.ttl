@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Population of the Faroe Islands in 2020 , by island" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Number of inhabitants" .

:YAxis a :Axis ;
    :title "island" .

