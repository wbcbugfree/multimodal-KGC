@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Share of population aged 65 years and older in Finland in 2019 , by region" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Share of inhabitants" .

:YAxis a :Axis ;
    :title "Response" .

:DataPoint1 a :DataPoint ;
    :xValue "0.176" ;
    :yValue "Uusimaa" ;
    :belongsTo :Chart .

