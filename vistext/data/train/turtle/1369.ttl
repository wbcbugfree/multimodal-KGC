@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Distribution of essential oils imported to Europe in 2017 , by supplier country" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "Share of export volume" .

:DataPoint1 a :DataPoint ;
    :xValue "Brazil" ;
    :yValue "0.17" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Netherlands" ;
    :yValue "0.14" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "USA" ;
    :yValue "0.08" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "China" ;
    :yValue "0.07" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "Germany" ;
    :yValue "0.06" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "France" ;
    :yValue "0.06" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "India" ;
    :yValue "0.06" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "United Kingdom" ;
    :yValue "0.04" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "Italy" ;
    :yValue "0.04" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "Other Europe" ;
    :yValue "0.12" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "Other non-EU" ;
    :yValue "0.17" ;
    :belongsTo :Chart .
