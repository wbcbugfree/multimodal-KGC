@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Number of nail technicians in the United States from 2006 to 2018" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Number of nail technicians" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2005" ;
    :yValue "361427" ;
    :belongsTo :Chart .

