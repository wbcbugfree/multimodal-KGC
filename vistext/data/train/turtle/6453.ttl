@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Percentage of respondents worldwide scared of contracting coronavirus (COVID-19) as of March 1 , 2020 , by country" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Don't know" .

:YAxis a :Axis ;
    :title "Response" .

:DataPoint1 a :DataPoint ;
    :xValue "0.05" ;
    :yValue "United Kingdom" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "0.06" ;
    :yValue "United States" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "0.03" ;
    :yValue "China" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "0.02" ;
    :yValue "Hong Kong" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "0.04" ;
    :yValue "Indonesia" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "0.05" ;
    :yValue "Malaysia" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "0.04" ;
    :yValue "Philippines" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "0.03" ;
    :yValue "Singapore" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "0.03" ;
    :yValue "Taiwan" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "0.02" ;
    :yValue "Thailand" ;
    :belongsTo :Chart .
