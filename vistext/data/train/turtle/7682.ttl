@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Percentage of Canadians who were personally very concerned about contracting coronavirus (COVID-19) from February to September 2020 , by age" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Month" .

:YAxis a :Axis ;
    :title "55 years and older" .

:DataPoint1 a :DataPoint ;
    :xValue "February 4 to 5" ;
    :yValue "0.08" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "March 5 to 6" ;
    :yValue "0.08" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "March 13 to 15" ;
    :yValue "0.19" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "March 20 to 23" ;
    :yValue "0.31" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "April 1 to 3" ;
    :yValue "0.34" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "April 15 to 17" ;
    :yValue "0.21" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "May 4 to 6" ;
    :yValue "0.27" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "June 8 to 10" ;
    :yValue "0.14" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "July 10 to 11" ;
    :yValue "0.27" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "September 23 to 25" ;
    :yValue "0.35" ;
    :belongsTo :Chart .
