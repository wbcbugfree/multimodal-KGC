@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Annual consumption volume of beetroots in Austria from 2008/09 to 2017/18 (in tonnes)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Consumption volume in tonnes" .

:YAxis a :Axis ;
    :title "Year" .

:DataPoint1 a :DataPoint ;
    :xValue "10243" ;
    :yValue "2017/18" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "11303" ;
    :yValue "2016/17" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "7788" ;
    :yValue "2015/16" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "10572" ;
    :yValue "2014/15" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "9642" ;
    :yValue "2013/14" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "11470" ;
    :yValue "2012/13" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "13928" ;
    :yValue "2011/12" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "12061" ;
    :yValue "2010/11" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "13732" ;
    :yValue "2009/10" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "11165" ;
    :yValue "2008/09" ;
    :belongsTo :Chart .
