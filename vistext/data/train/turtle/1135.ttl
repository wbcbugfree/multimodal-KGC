@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Number of hospitals in Estonia from 2000 to 2018" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Number of hospitals" .

