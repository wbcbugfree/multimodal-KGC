@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Revenue of top healthcare management consulting firms in the United States in 2013 (in million U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "healthcare management consulting firm" .

:YAxis a :Axis ;
    :title "Total revenue in million U.S. dollars" .

:DataPoint1 a :DataPoint ;
