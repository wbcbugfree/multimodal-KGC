:DataPoint10 a :DataPoint ;
    :xValue "Dec 31, 2016" ;
    :yValue "103.1" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "Dec 31, 2017" ;
    :yValue "104" ;
