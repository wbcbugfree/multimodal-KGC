@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Leading mobile game publishers in the United States as of October 2016 , by number of daily downloads (in 1,000s)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "video game developer" .

:YAxis a :Axis ;
    :title "Number of downloads in thousands" .

