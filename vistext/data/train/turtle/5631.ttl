@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Data loss prevention controls and activities of organizations in the United States in 2017" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "Share of respondents" .

:DataPoint1 a :DataPoint ;
    :xValue "Training and awareness programs" ;
    :yValue "0.6" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Expanded use of encryption" ;
    :yValue "0.55" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "Endpoint security solutions" ;
    :yValue "0.49" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "Identity and access management solutions" ;
    :yValue "0.44" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "Additional manual procedures and controls" ;
    :yValue "0.39" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Data loss prevention (DLP) solutions" ;
    :yValue "0.36" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Security intelligence solutions" ;
    :yValue "0.35" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Other system control practices" ;
    :yValue "0.26" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "Security certification or audit" ;
    :yValue "0.19" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "Strenghtening of perimeter controls" ;
    :yValue "0.16" ;
    :belongsTo :Chart .
