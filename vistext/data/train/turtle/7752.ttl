@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Leading high street fashion labels ranked by Instagram user engagement as of May 2016" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Instagram likes" .

:YAxis a :Axis ;
    :title "Leading high street fashion labels" .

:DataPoint1 a :DataPoint ;
    :xValue "12511530" ;
    :yValue "Forever 21" ;
    :belongsTo :Chart .

