@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Most watched MLB World Series games of all time in the United States as of November 2016 (in millions)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Number of viewers in millions" .

:YAxis a :Axis ;
    :title "Year and teams (game number) (network)" .

:DataPoint1 a :DataPoint ;
    :xValue "54.86" ;
    :yValue "1980 - Phillies vs. Royals (Game 6) (NBC)" ;
    :belongsTo :Chart .

