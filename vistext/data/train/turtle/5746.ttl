@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Percentage of new African-American directors on Fortune 500 boards from 2009 to 2019" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "Percentage of African-American directors" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2008" ;
    :yValue "0.053" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Dec 31, 2009" ;
    :yValue "0.032" ;
    :belongsTo :Chart .

