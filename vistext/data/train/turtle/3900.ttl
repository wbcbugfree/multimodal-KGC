@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Area of wheat harvested in Canada from 2008 to 2020 (in million hectares)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Area in million hectares" .

:YAxis a :Axis ;
    :title "Year" .

:DataPoint1 a :DataPoint ;
    :xValue "9.88" ;
    :yValue "2020**" ;
    :belongsTo :Chart .

