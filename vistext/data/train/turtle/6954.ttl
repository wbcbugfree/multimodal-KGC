@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Where do you primarily derive most of your personal values from ? (by selected country)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Education / family" .

:YAxis a :Axis ;
    :title "Response" .

:DataPoint1 a :DataPoint ;
    :xValue "0.8047" ;
    :yValue "France" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "0.8134" ;
    :yValue "Germany" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "0.7589" ;
    :yValue "India" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "0.4441" ;
    :yValue "Indonesia" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "0.6116" ;
    :yValue "Israel" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "0.8597" ;
    :yValue "Mexico" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "0.3763" ;
    :yValue "Saudi Arabia" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "0.4918" ;
    :yValue "South Africa" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "0.5137" ;
    :yValue "Turkey" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "0.5694" ;
    :yValue "United States" ;
    :belongsTo :Chart .
