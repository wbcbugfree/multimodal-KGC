@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Utah Jazz all-time points leaders from 1974 to 2020" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Points scored" .

:YAxis a :Axis ;
    :title "Jazz Player" .

:DataPoint1 a :DataPoint ;
    :xValue "36374" ;
    :yValue "Karl Malone" ;
    :belongsTo :Chart .

