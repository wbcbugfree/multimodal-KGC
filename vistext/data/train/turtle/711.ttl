@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Do you use a tablet for any of the following ?" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Share of respondents" .

:YAxis a :Axis ;
    :title "Response" .

:DataPoint1 a :DataPoint ;
    :xValue "0.87" ;
    :yValue "Playing games" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "0.78" ;
    :yValue "Watching videos" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "0.76" ;
    :yValue "Browsing online" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "0.75" ;
    :yValue "To learn things" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "0.74" ;
    :yValue "Downloading apps" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "0.53" ;
    :yValue "Social networking (e.g. Facebook or Twitter)" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "0.52" ;
    :yValue "Taking pictures or films" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "0.48" ;
    :yValue "Chating with friends" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "0.48" ;
    :yValue "Video chat (e.g. Skype or FaceTime)" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "0.47" ;
    :yValue "Watching TV" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "0.01" ;
    :yValue "None of the above" ;
    :belongsTo :Chart .
