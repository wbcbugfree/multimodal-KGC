@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Share of people with a university degree in Italy in 2019 , by age-group" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Share of individuals" .

:YAxis a :Axis ;
    :title "Response" .

:DataPoint1 a :DataPoint ;
    :xValue "0.1" ;
    :yValue "20-24 years" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "0.278" ;
    :yValue "25-29 years" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "0.276" ;
    :yValue "30-34 years" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "0.264" ;
    :yValue "35-39 years" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "0.216" ;
    :yValue "40-44 years" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "0.184" ;
    :yValue "45-49 years" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "0.147" ;
    :yValue "50-54 years" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "0.127" ;
    :yValue "55-59 years" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "0.13" ;
    :yValue "60-64 years" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "0.081" ;
    :yValue "65 years and over" ;
    :belongsTo :Chart .
