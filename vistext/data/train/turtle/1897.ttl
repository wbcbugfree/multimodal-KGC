@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Research and development expenses of Church & Dwight worldwide from 2009 to 2019 (in million U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "R&D expenses in million U.S. dollars" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2008" ;
    :yValue "55.1" ;
    :belongsTo :Chart .

