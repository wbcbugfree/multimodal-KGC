@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Most frequent immigrants ' nationalities declared upon arrival in Italy between January and December 2020" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Country" .

:YAxis a :Axis ;
    :title "Number of individuals" .

:DataPoint1 a :DataPoint ;
    :xValue "Tunisia" ;
    :yValue "12542" ;
    :belongsTo :Chart .

