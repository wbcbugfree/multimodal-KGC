    :xValue "Pakistan" ;
    :yValue "1358" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Egypt" ;
    :yValue "1206" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Sudan" ;
    :yValue "1099" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Morocco" ;
    :yValue "996" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "Afghanistan" ;
