@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Historical passenger kilometers on the London (UK) Underground between 1950 and 2020 (in billion kilometers)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Kilometers in billion" .

:DataPoint1 a :DataPoint ;
    :xValue "2020" ;
    :yValue "11.8" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "2019" ;
    :yValue "12.1" ;
    :belongsTo :Chart .

