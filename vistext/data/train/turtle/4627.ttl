@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Circulation of selected large daily newspapers in Finland in 2019" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Number of copies" .

:YAxis a :Axis ;
    :title "newspaper" .

:DataPoint1 a :DataPoint ;
    :xValue "339437" ;
    :yValue "Helsingin Sanomat" ;
    :belongsTo :Chart .

