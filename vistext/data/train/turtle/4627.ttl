    :xValue "38713" ;
    :yValue "Etelä-Suomen Sanomat" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "37226" ;
    :yValue "Ilkka" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
