@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Average price of home heating oil in the Canadian city of Montreal from 1990 to 2011 (in Canadian cents per litre)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Price in Canadian cents per litre" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 1989" ;
    :yValue "36.4" ;
    :belongsTo :Chart .

