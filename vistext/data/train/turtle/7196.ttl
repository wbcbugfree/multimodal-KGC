@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Tourism expenditure in the Netherlands from 2010 to 2018 , by category (in million euros)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Expenditure domestic tourism" .

:YAxis a :Axis ;
    :title "Year" .

:DataPoint1 a :DataPoint ;
    :xValue "37094" ;
    :yValue "2010" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "38726" ;
    :yValue "2011" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "39183" ;
    :yValue "2012" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "38772" ;
    :yValue "2013" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "39930" ;
    :yValue "2014" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "40921" ;
    :yValue "2015" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "41512" ;
    :yValue "2016" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "42961" ;
    :yValue "2017" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "44717" ;
    :yValue "2018" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "46618" ;
    :yValue "2019*" ;
    :belongsTo :Chart .
