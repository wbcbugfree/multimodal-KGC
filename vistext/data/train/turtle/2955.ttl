@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Number of illegal border-crossings to the European Union (EU) over the Western African route (Canary Islands) from 2009 to 2019" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Number of illegal border-crossings" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2008" ;
    :yValue "2244" ;
    :belongsTo :Chart .

