@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Share of households with internet access in Norway from 2007 to 2019" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "Share of households" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2006" ;
    :yValue "0.78" ;
    :belongsTo :Chart .

