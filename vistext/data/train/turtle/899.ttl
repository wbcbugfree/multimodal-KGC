@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Iran 's crude oil exports between January and September 2011 , by destination country (in 1,000 barrels per day)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Country" .

:YAxis a :Axis ;
    :title "Exports in thousand barrels per day" .

:DataPoint1 a :DataPoint ;
    :xValue "China" ;
    :yValue "550" ;
    :belongsTo :Chart .

