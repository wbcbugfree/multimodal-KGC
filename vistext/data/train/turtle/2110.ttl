@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Most-followed creators on TikTok worldwide as of May 2020" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "TikTok content creator" .

:YAxis a :Axis ;
    :title "Number of followers in millions" .

:DataPoint1 a :DataPoint ;
    :xValue "Charli d’Amelio" ;
    :yValue "59.2" ;
    :belongsTo :Chart .

