@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Net sales of Dick 's Sporting Goods in the United States from 2012 to 2019 , by merchandise category (in million U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Footwear" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2007" ;
    :yValue "659" ;
    :belongsTo :Chart .

