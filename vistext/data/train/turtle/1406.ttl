@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Luxury goods duty free shopping locations for millionaires in China as of 2015" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Share of millionaires" .

:YAxis a :Axis ;
    :title "Response" .

:DataPoint1 a :DataPoint ;
    :xValue "0.3" ;
    :yValue "Mainland China" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "0.13" ;
    :yValue "Russia" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "0.04" ;
    :yValue "USA" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "0.03" ;
    :yValue "Japan" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "0.03" ;
    :yValue "Indonesia" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "0.03" ;
    :yValue "Taiwan" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "0.02" ;
    :yValue "Thailand" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "0.02" ;
    :yValue "Saudi Arabia" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "0.02" ;
    :yValue "Hong Kong" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "0.02" ;
    :yValue "Kuwait" ;
    :belongsTo :Chart .
