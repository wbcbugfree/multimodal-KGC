@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "United Kingdom (UK) companies ' net foreign direct investment (FDI) worldwide from 2006 to 2018 (in million GBP)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Investment in million GBP" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2005" ;
    :yValue "46887" ;
    :belongsTo :Chart .

