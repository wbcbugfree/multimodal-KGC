@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Most used social media platforms in Ghana as of the third quarter of 2019" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "Share of internet users" .

:DataPoint1 a :DataPoint ;
    :xValue "WhatsApp" ;
    :yValue "0.82" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Facebook" ;
    :yValue "0.71" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "YouTube" ;
    :yValue "0.62" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "Instagram" ;
    :yValue "0.61" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "FB Messenger" ;
    :yValue "0.51" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Twitter" ;
    :yValue "0.37" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Snapchat" ;
    :yValue "0.37" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Pinterest" ;
    :yValue "0.14" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "Tiktok" ;
    :yValue "0.14" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "LinkedIn" ;
    :yValue "0.12" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "Skype" ;
    :yValue "0.09" ;
    :belongsTo :Chart .

:DataPoint12 a :DataPoint ;
    :xValue "WeChat" ;
    :yValue "0.08" ;
    :belongsTo :Chart .

:DataPoint13 a :DataPoint ;
    :xValue "Line" ;
    :yValue "0.06" ;
    :belongsTo :Chart .

:DataPoint14 a :DataPoint ;
    :xValue "Viber" ;
    :yValue "0.05" ;
    :belongsTo :Chart .

:DataPoint15 a :DataPoint ;
    :xValue "Tumblr" ;
    :yValue "0.05" ;
    :belongsTo :Chart .

:DataPoint16 a :DataPoint ;
    :xValue "Reddit" ;
    :yValue "0.04" ;
