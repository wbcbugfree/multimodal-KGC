@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Share of population accessing social networks via mobile devices in European countries in 2012 , by age group" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Country" .

:YAxis a :Axis ;
    :title "16-74 age group" .

:DataPoint1 a :DataPoint ;
    :xValue "Sweden" ;
    :yValue "0.4" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "United Kingdom" ;
    :yValue "0.36" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "Denmark" ;
    :yValue "0.31" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "Netherlands" ;
    :yValue "0.29" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "Luxembourg" ;
    :yValue "0.29" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "EU" ;
    :yValue "0.16" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Hungary" ;
    :yValue "0.07" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Italy" ;
    :yValue "0.07" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "Czech Republic" ;
    :yValue "0.04" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "Bulgaria" ;
    :yValue "0.04" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "Romania" ;
    :yValue "0.03" ;
    :belongsTo :Chart .
