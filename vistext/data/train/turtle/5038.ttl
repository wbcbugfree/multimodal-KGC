@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Percentage of e-commerce in total U.S. retail sales in 4th quarter from 2010 to 2019" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Estimated share of e-commerce in total sales" .

:YAxis a :Axis ;
    :title "Quarter" .

:DataPoint1 a :DataPoint ;
    :xValue "0.115" ;
    :yValue "Q4 '19*" ;
    :belongsTo :Chart .

