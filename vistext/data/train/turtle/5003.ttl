@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Most popular car brands among U.S. physicians as of 2012" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Percentage of respondents" .

:YAxis a :Axis ;
    :title "Response" .

:DataPoint1 a :DataPoint ;
    :xValue "16.8" ;
    :yValue "Toyota" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "14.9" ;
    :yValue "Honda" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "7.9" ;
    :yValue "Lexus" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "7.1" ;
    :yValue "BMW" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "5.3" ;
    :yValue "Mercedes-Benz" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "5.2" ;
    :yValue "Ford" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "4.3" ;
    :yValue "Nissan" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "4.1" ;
    :yValue "Chevrolet" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "3.6" ;
    :yValue "Subaru" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "3.1" ;
    :yValue "Audi" ;
    :belongsTo :Chart .
