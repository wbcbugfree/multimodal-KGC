@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Average number of persons employed at Vodafone in Germany from financial year 2007/08 to 2019/20 (in 1,000)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Employees in thousands" .

:YAxis a :Axis ;
    :title "Business years" .

:DataPoint1 a :DataPoint ;
    :xValue "15.2" ;
    :yValue "2019/20" ;
    :belongsTo :Chart .

