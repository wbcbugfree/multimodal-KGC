@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Percentage of employed women in computing-related occupations in the United States from 2007 to 2019 , by ethnicity" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Latina/Hispanic" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2006" ;
    :yValue "0.012" ;
    :belongsTo :Chart .

