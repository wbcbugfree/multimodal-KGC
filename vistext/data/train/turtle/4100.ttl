@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Health & fitness club industry revenue in the Middle East & North Africa in 2019 , by country (in million U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Industry revenue in million U.S. dollars" .

:YAxis a :Axis ;
    :title "Country" .

:DataPoint1 a :DataPoint ;
    :xValue "959" ;
    :yValue "Saudi Arabia" ;
    :belongsTo :Chart .

