@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Share of adults in the United States who have used selected sharing companies or services as of January 2016" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Share of respondents" .

:YAxis a :Axis ;
    :title "Response" .

:DataPoint1 a :DataPoint ;
    :xValue "0.48" ;
    :yValue "None of these" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "0.25" ;
    :yValue "Uber" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "0.2" ;
    :yValue "Etsy" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "0.06" ;
    :yValue "AirBnB" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "0.06" ;
    :yValue "Lyft" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "0.03" ;
    :yValue "Post Mates" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "0.02" ;
    :yValue "Instacart" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "0.02" ;
    :yValue "Task Rabbit" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "0.01" ;
    :yValue "Shyp" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "0.01" ;
    :yValue "DogVacay" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "0.01" ;
    :yValue "Turo" ;
    :belongsTo :Chart .
