@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Value of the leading 10 textile importers worldwide in 2019 , by country (in billion U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Import value in billion U.S. dollars" .

:YAxis a :Axis ;
    :title "Country" .

:DataPoint1 a :DataPoint ;
    :xValue "67" ;
    :yValue "European Union (28)" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "31" ;
    :yValue "United States" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "16" ;
    :yValue "Viet Nam**" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "16" ;
    :yValue "China*" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "10" ;
    :yValue "Bangladesh**" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "9" ;
    :yValue "Japan" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "7" ;
    :yValue "United Kingdom" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "7" ;
    :yValue "Indonesia" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "6" ;
    :yValue "Hong Kong, China" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "6" ;
    :yValue "Mexico* ***" ;
    :belongsTo :Chart .
