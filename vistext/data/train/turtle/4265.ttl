@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "India : Life expectancy of women at birth from 2008 to 2018 (in years)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Life expectancy at birth in years" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2007" ;
    :yValue "66.74" ;
    :belongsTo :Chart .

