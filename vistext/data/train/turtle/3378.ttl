@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Number of population considered vulnerable due to lack of access to health services in Mexico in 2018 , by state (in 1,000s)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "state of Mexico" .

:YAxis a :Axis ;
    :title "Population in thousands" .

