@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Boston Celtics all-time rebounds leaders from 1946 to 2020" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "rebounds leaders" .

:YAxis a :Axis ;
    :title "Rebounds" .

