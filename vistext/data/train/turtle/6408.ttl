@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Volume of olive oil consumed per capita in Spain in 2019 , by autonomous community and type (in liters)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Virgin olive oil" .

:YAxis a :Axis ;
    :title "autonomous community of Spain" .

:DataPoint1 a :DataPoint ;
    :xValue "0.91" ;
    :yValue "Cantabria" ;
    :belongsTo :Chart .

