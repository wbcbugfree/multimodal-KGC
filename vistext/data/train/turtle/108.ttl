@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Most popular influencers on TikTok from the United States as of July 2020 , by number of followers (in millions)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Number of followers in millions" .

:YAxis a :Axis ;
    :title "Wikimedia list article" .

:DataPoint1 a :DataPoint ;
    :xValue "72.5" ;
    :yValue "@charlidamelio" ;
