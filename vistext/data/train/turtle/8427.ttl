@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Which of the following popular U.S. professional sports do you most associate with negative moral values ?" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "55-64 years" .

:DataPoint1 a :DataPoint ;
    :xValue "Football" ;
    :yValue "0.59" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Basketball" ;
    :yValue "0.31" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "Boxing" ;
    :yValue "0.27" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "Wrestling" ;
    :yValue "0.2" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "Baseball" ;
    :yValue "0.15" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Hockey" ;
    :yValue "0.14" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Mixed Martial Arts" ;
    :yValue "0.13" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Auto Racing" ;
    :yValue "0.07" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "Golf" ;
    :yValue "0.03" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "Soccer" ;
    :yValue "0.02" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "Tennis" ;
    :yValue "0.01" ;
    :belongsTo :Chart .

:DataPoint12 a :DataPoint ;
    :xValue "I don't associate any U.S. professional sports with negative moral values" ;
    :yValue "0.13" ;
    :belongsTo :Chart .

:DataPoint13 a :DataPoint ;
    :xValue "Not sure" ;
    :yValue "0.1" ;
    :belongsTo :Chart .
