@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Online bingo related keywords ranked by search volume in the United Kingdom (UK) in March 2016 (in 1,000 searches)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Online bingo related keywords" .

:YAxis a :Axis ;
    :title "Searches in thousands" .

:DataPoint1 a :DataPoint ;
    :xValue "bingo" ;
    :yValue "110" ;
    :belongsTo :Chart .

