@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Total annual U.S. exports of toys , dolls and games to Canada from 2005 to 2019 (in million U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Total exports in million U.S. dollars" .

