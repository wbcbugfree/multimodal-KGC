@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Health spending distribution of private insurance and out-of-pocket payments in the United States in 2018" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Private insurance" .

:YAxis a :Axis ;
    :title "private insurance and out-of-pocket payments" .

:DataPoint1 a :DataPoint ;
    :xValue "0.39" ;
    :yValue "Hospital care" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "0.25" ;
    :yValue "Physician and clinical services" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "0.11" ;
    :yValue "Prescription drugs" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "0.13" ;
    :yValue "Net cost of health insurance*" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "0.05" ;
    :yValue "Dental services" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "0.03" ;
    :yValue "Other professional services" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "0.01" ;
    :yValue "Nursing care facilities" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "0.01" ;
    :yValue "Other health care**" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "0.01" ;
    :yValue "Other medical products***" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "0.01" ;
    :yValue "Home health services" ;
    :belongsTo :Chart .
