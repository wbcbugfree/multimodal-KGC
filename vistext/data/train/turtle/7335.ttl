@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Distribution of households in the United States from 1970 to 2020 , by household size" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Five persons" .

