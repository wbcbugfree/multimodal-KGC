@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Walmart 's net sales worldwide from fiscal year 2006 to 2020 (in billion U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Fiscal year" .

:YAxis a :Axis ;
    :title "Net sales in billion U.S. dollars" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2005" ;
    :yValue "308.95" ;
    :belongsTo :Chart .

