@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Unemployment rate of high school graduates and dropouts not enrolled in school in the United States from 2000 to 2019" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Graduates" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 1999" ;
    :yValue "0.095" ;
    :belongsTo :Chart .

