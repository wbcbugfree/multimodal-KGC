@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Most visited direct-to-consumer (D2C) brands in the United States as of October 2019 , by average unique monthly visitors (in millions)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Unique monthly visitors in millions" .

:YAxis a :Axis ;
    :title "Pet Supply Retailer" .

:DataPoint1 a :DataPoint ;
    :xValue "14.3" ;
    :yValue "Chewy" ;
    :belongsTo :Chart .

