@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Charlotte Hornets all-time assists leaders from 1988 to 2020" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Assists" .

:YAxis a :Axis ;
    :title "leader" .

:DataPoint1 a :DataPoint ;
    :xValue "5557" ;
    :yValue "Muggsy Bogues" ;
    :belongsTo :Chart .

