@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Gross domestic product (GDP) in current prices in Spain from 2008 to 2019 (in billion euros)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "GDP in billion euros" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2007" ;
    :yValue "1109.5" ;
    :belongsTo :Chart .

