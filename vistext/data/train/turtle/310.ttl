@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Which three , if any , of the following do you think people in the UK have most right to be proud of ?" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Share of respondents" .

:YAxis a :Axis ;
    :title "Response" .

:DataPoint1 a :DataPoint ;
    :xValue "0.39" ;
    :yValue "The Royal Family" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "0.36" ;
    :yValue "UK universities" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "0.31" ;
    :yValue "Arts and culture" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "0.3" ;
    :yValue "The history of the UK" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "0.23" ;
    :yValue "The UK’s standing in the world" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "0.19" ;
    :yValue "UK sports teams and events" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "0.16" ;
    :yValue "The UK’s system of democracy" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "0.15" ;
    :yValue "UK public health system (the NHS)" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "0.13" ;
    :yValue "UK business" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "0.11" ;
    :yValue "Having a free press/media" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "0.09" ;
    :yValue "Army/ armedforces" ;
    :belongsTo :Chart .
