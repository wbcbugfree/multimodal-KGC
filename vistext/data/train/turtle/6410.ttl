@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Average Consumer Price Index for apparel expenditure in the U.S. from 2009 to 2018 , by segment (CPI-U)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Men's and boys' apparel" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2008" ;
    :yValue "113.63" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Dec 31, 2009" ;
    :yValue "111.91" ;
    :belongsTo :Chart .

