@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Number of enterprises in the manufacture of domestic appliances industry in the Czech Republic from 2008 to 2017" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Number of enterprises" .

:DataPoint1 a :DataPoint ;
    :xValue "2017" ;
    :yValue "612" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "2016" ;
    :yValue "605" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "2015" ;
    :yValue "592" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "2014" ;
    :yValue "597" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "2013" ;
    :yValue "609" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "2012" ;
    :yValue "627" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "2011" ;
    :yValue "643" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "2010" ;
    :yValue "626" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "2009" ;
    :yValue "534" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "2008*" ;
    :yValue "521" ;
    :belongsTo :Chart .
