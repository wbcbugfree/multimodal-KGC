@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Total annual player salaries in the sports industry in 2019/20 , by league (in billion U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Total player salaries in billion U.S. dollars" .

:YAxis a :Axis ;
    :title "professional sports league" .

:DataPoint1 a :DataPoint ;
    :xValue "5.52" ;
    :yValue "NFL" ;
    :belongsTo :Chart .

