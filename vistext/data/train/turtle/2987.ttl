@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Turnover of workwear manufacturers in Norway from 2008 to 2018 (in million NOK)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Turnover in million NOK" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2007" ;
    :yValue "543" ;
    :belongsTo :Chart .

