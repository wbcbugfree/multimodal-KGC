@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Price per ton of sugar cane in the U.S. from 2007 to 2016 , by state (in U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Texas" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2006" ;
    :yValue "23.4" ;
    :belongsTo :Chart .

