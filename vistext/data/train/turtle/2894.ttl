@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Detroit Pistons all-time rebounds leaders from 1948 to 2020" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Rebounds" .

:YAxis a :Axis ;
    :title "Player" .

:DataPoint1 a :DataPoint ;
    :xValue "9430" ;
    :yValue "Bill Laimbeer" ;
    :belongsTo :Chart .

