@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Share of the leading direct selling markets worldwide as of 2019" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Country" .

:YAxis a :Axis ;
    :title "Market share" .

:DataPoint1 a :DataPoint ;
    :xValue "United States" ;
    :yValue "0.2" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "China" ;
    :yValue "0.13" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "Korea" ;
    :yValue "0.1" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "Germany" ;
    :yValue "0.1" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "Japan" ;
    :yValue "0.09" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Brazil" ;
    :yValue "0.05" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "France" ;
    :yValue "0.03" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Mexico" ;
    :yValue "0.03" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "Malaysia" ;
    :yValue "0.03" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "Taiwan" ;
    :yValue "0.02" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "Other" ;
    :yValue "0.22" ;
    :belongsTo :Chart .
