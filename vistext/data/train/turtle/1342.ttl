@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Number of trucks sold in Pakistan from July 2008 to June 2019" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Number of trucks" .

:YAxis a :Axis ;
    :title "Month" .

:DataPoint1 a :DataPoint ;
    :xValue "5828" ;
    :yValue "Jul 2018- Jun 2019" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "9331" ;
    :yValue "Jul 2017- Jun 2018" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "5550" ;
    :yValue "Jul 2016- Jun 2017" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "4111" ;
    :yValue "Jul 2015- Jun 2016" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "2663" ;
    :yValue "Jul 2014- Jun 2015" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "1948" ;
    :yValue "Jul 2013- Jun 2014" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "2394" ;
    :yValue "Jul 2012- Jun 2013" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "2942" ;
    :yValue "Jul 2011- Jun 2012" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "3620" ;
    :yValue "Jul 2010- Jun 2011" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "3136" ;
    :yValue "Jul 2009- Jun 2010" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "3136" ;
    :yValue "Jul 2008- Jun 2009" ;
    :belongsTo :Chart .
