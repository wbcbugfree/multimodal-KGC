@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Financial assets of money market mutual funds in the United States from 2000 to 2018 (in billion U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Assets in billion U.S. dollars" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 1999" ;
    :yValue "1845" ;
    :belongsTo :Chart .

