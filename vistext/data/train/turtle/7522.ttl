@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Sales of passenger cars in selected countries worldwide from 2005 to 2019 (in million units)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "China" .

