@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Adoption of government endorsed COVID-19 contact tracing apps in selected countries as of July 2020" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Share of smartphone using population" .

:YAxis a :Axis ;
    :title "Response" .

:DataPoint1 a :DataPoint ;
    :xValue "0.216" ;
    :yValue "Australia" ;
    :belongsTo :Chart .

