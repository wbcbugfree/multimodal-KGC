@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Number of participants in Tai Chi in the United States from 2008 to 2018 (in millions)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Number of participants in millions" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2007" ;
    :yValue "3.42" ;
    :belongsTo :Chart .

