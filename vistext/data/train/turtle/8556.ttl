@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Fastest growing convenience food products online sales during the coronavirus (COVID-19) outbreak in Russia from January to March 2020 , by product" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "02.03-08.03" .

:YAxis a :Axis ;
    :title "food products" .

:DataPoint1 a :DataPoint ;
    :xValue "2.49" ;
    :yValue "Energy drinks" ;
    :belongsTo :Chart .

