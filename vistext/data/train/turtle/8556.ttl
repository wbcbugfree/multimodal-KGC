    :xValue "1.5" ;
    :yValue "Instant soups" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "1.51" ;
    :yValue "Porridge" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "0.38" ;
    :yValue "Chocolate paste" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "1.32" ;
    :yValue "Souces" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "0.79" ;
    :yValue "Sterilized milk" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "0.99" ;
