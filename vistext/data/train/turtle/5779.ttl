@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Countries with the highest growth of WhatsApp downloads from the Apple App Store as of 3rd quarter 2020" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Growth compared to previous quarter" .

:YAxis a :Axis ;
    :title "Country" .

:DataPoint1 a :DataPoint ;
    :xValue "1.625" ;
    :yValue "Egypt" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "1.573" ;
    :yValue "India" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "1.499" ;
    :yValue "Kenya" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "1.299" ;
    :yValue "Portugal" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "1.29" ;
    :yValue "Brazil" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "1.232" ;
    :yValue "Peru" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "1.177" ;
    :yValue "South Africa" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "1.14" ;
    :yValue "Sri Lanka" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "1.082" ;
    :yValue "Singapore" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "1.075" ;
    :yValue "Ecuador" ;
    :belongsTo :Chart .
