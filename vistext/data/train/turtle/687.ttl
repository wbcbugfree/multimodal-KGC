@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Number of employees in the financial services sector in the United Kingdom (UK) from 2001 to 2019 (in millions)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Number of employees in millions" .

