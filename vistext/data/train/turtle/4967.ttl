@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Leading ten national and international DIY retailers in Italy as of June 2020 , by number of stores" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Number of stores" .

:YAxis a :Axis ;
    :title "DIY retailers" .

:DataPoint1 a :DataPoint ;
    :xValue "107" ;
    :yValue "Brico io" ;
    :belongsTo :Chart .

