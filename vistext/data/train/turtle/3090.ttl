@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Share of Americans who believe in the following theories and myths" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Share of respondents" .

:YAxis a :Axis ;
    :title "Response" .

:DataPoint1 a :DataPoint ;
    :xValue "0.74" ;
    :yValue "God" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "0.72" ;
    :yValue "Miracles" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "0.68" ;
    :yValue "Heaven" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "0.68" ;
    :yValue "Jesus is God or the Son of God" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "0.68" ;
    :yValue "Angels" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "0.65" ;
    :yValue "The resurrection of Jesus Christ" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "0.64" ;
    :yValue "Survival of the soul after death" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "0.58" ;
    :yValue "The Devil" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "0.58" ;
    :yValue "Hell" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "0.57" ;
    :yValue "The Virgin birth (Jesus born of Mary)" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "0.47" ;
    :yValue "Darwin’s theory of evolution" ;
    :belongsTo :Chart .

:DataPoint12 a :DataPoint ;
    :xValue "0.42" ;
    :yValue "Ghosts" ;
    :belongsTo :Chart .

:DataPoint13 a :DataPoint ;
    :xValue "0.36" ;
    :yValue "Creationism" ;
    :belongsTo :Chart .

:DataPoint14 a :DataPoint ;
    :xValue "0.36" ;
    :yValue "UFOs" ;
    :belongsTo :Chart .

:DataPoint15 a :DataPoint ;
    :xValue "0.29" ;
    :yValue "Astrology" ;
    :belongsTo :Chart .

:DataPoint16 a :DataPoint ;
    :xValue "0.26" ;
    :yValue "Witches" ;
    :belongsTo :Chart .

:DataPoint17 a :DataPoint ;
    :xValue "0.24" ;
    :yValue "Reincarnation – that you were once another person" ;
