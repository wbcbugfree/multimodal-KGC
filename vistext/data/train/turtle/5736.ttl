@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Most valuable brands worldwide in 2014 , by brand value (in billion U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Brand value in billion U.S. dollars" .

:YAxis a :Axis ;
    :title "brand name" .

:DataPoint1 a :DataPoint ;
    :xValue "118.86" ;
    :yValue "Apple" ;
    :belongsTo :Chart .

