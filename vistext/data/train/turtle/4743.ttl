@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Percentage of population using the internet in India from 2000 to 2017" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "Share of individuals using internet" .

