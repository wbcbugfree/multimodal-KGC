@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Migration figures of Spanish people leaving or returning to Spain from 2010 to 2019" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Inflow" .

:YAxis a :Axis ;
    :title "Year" .

:DataPoint1 a :DataPoint ;
    :xValue "30418" ;
    :yValue "2010" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "35442" ;
    :yValue "2011" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "31565" ;
    :yValue "2012" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "32422" ;
    :yValue "2013" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "40968" ;
    :yValue "2014" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "52109" ;
    :yValue "2015" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "62573" ;
    :yValue "2016" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "78182" ;
    :yValue "2017" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "83686" ;
    :yValue "2018" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "38751" ;
    :yValue "2019*" ;
    :belongsTo :Chart .
