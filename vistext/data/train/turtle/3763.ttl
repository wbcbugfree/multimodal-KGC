@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Annual turnover of the wholesale and retail trade including the repair of motor vehicles and motorcycles industry in Spain from 2008 to 2017 (in million euros)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Annual turnover in million euros" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2007" ;
    :yValue "735326.3" ;
    :belongsTo :Chart .

