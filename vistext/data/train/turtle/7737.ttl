@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Distribution of in-house and outsourcing services expenditure in the global pharmaceutical market from 2014 to 2023" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Outsourcing" .

:YAxis a :Axis ;
    :title "Year" .

:DataPoint1 a :DataPoint ;
    :xValue "0.337" ;
    :yValue "2014" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "0.348" ;
    :yValue "2015" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "0.363" ;
    :yValue "2016" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "0.365" ;
    :yValue "2017" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "0.377" ;
    :yValue "2018" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "0.395" ;
    :yValue "2019*" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "0.417" ;
    :yValue "2020*" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "0.442" ;
    :yValue "2021*" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "0.468" ;
    :yValue "2022*" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "0.493" ;
    :yValue "2023*" ;
    :belongsTo :Chart .
