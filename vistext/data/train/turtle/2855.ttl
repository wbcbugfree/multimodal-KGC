@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Deutz AG 's sales from FY 2007 to FY 2019 (in units)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Sales in units" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2006" ;
    :yValue "285861" ;
    :belongsTo :Chart .

