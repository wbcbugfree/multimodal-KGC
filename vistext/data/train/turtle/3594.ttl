@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "The most populated municipalities in Luxembourg in 2020" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Inhabitants" .

:YAxis a :Axis ;
    :title "Country" .

:DataPoint1 a :DataPoint ;
    :xValue "122.3" ;
    :yValue "Luxembourg" ;
    :belongsTo :Chart .

