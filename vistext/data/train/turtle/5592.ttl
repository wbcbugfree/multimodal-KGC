@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Import volume of leather products and substitutes in Italy between January and October 2019 , by import country (in tons)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Import volume in tons" .

:YAxis a :Axis ;
    :title "Country" .

