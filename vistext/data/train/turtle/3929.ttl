@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Total number of stores of Luxottica worldwide in 2019 , by brand" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Number of stores" .

:YAxis a :Axis ;
    :title "brand" .

