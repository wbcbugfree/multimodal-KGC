@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Annual residential property transactions value in London from 2005 to 2014 (in million GBP)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Transaction value in million GBP" .

:DataPoint1 a :DataPoint ;
    :xValue "2014*" ;
    :yValue "79373" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "2013" ;
    :yValue "68288" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "2012" ;
    :yValue "55984" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "2011" ;
    :yValue "53949" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "2010" ;
    :yValue "51479" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "2009" ;
    :yValue "36220" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "2008" ;
    :yValue "40404" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "2007" ;
    :yValue "72301" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "2006" ;
    :yValue "65078" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "2005" ;
    :yValue "48608" ;
    :belongsTo :Chart .
