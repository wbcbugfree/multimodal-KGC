@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Bosch 's profit after tax from FY 2004 to FY 2019 (in million euros)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Profit after tax in million euros" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2003" ;
    :yValue "1870" ;
    :belongsTo :Chart .

