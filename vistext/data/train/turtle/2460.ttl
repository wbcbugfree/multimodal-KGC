    :xValue "Tate & Lyle" ;
    :yValue "2204" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Primark" ;
    :yValue "2056" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "John Lewis" ;
