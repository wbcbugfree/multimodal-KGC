@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Most valuable food brands in the United Kingdom (UK) in 2015 (in million U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "food brand" .

:YAxis a :Axis ;
    :title "Brand value in million U.S. dollars" .

:DataPoint1 a :DataPoint ;
    :xValue "Tesco" ;
    :yValue "11052" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Sainsbury's" ;
    :yValue "6694" ;
    :belongsTo :Chart .

