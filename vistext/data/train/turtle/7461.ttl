@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Distribution of individuals who made online purchases in Luxembourg from 2009 to 2019" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "More than a year ago" .

:YAxis a :Axis ;
    :title "Within the first trimester of the reference year" .

:DataPoint1 a :DataPoint ;
    :xValue "0.05" ;
    :yValue "0.653" ;
    :belongsTo :Chart .

