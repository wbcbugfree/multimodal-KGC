@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Production of raw cotton in India from financial year 2007 to 2019 , with an estimate for 2020 (in million bales)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Production in million bales" .

:YAxis a :Axis ;
    :title "financial year" .

:DataPoint1 a :DataPoint ;
    :xValue "32.3" ;
    :yValue "FY 2020" ;
    :belongsTo :Chart .

