@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Sales volume of Toyota cars across India in 2019 , by model" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Number of vehicles sold" .

:YAxis a :Axis ;
    :title "model" .

:DataPoint1 a :DataPoint ;
    :xValue "61743" ;
    :yValue "Innova Crysta" ;
    :belongsTo :Chart .

