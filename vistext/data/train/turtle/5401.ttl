@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Global industry sectors most targeted by cyber espionage in 2019" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Incident count" .

:YAxis a :Axis ;
    :title "industry sector" .

:DataPoint1 a :DataPoint ;
    :xValue "75" ;
    :yValue "Manufacturing" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "40" ;
    :yValue "Professional" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "26" ;
    :yValue "Public" ;
    :belongsTo :Chart .

