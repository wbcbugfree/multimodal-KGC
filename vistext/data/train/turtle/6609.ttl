@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Rate of coronavirus (COVID-19) tests performed in selected countries between April 1st and November 25 , 2020 (per 100,000 population)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Country" .

:YAxis a :Axis ;
    :title "June 11, 2020" .

:DataPoint1 a :DataPoint ;
    :xValue "United Kingdom" ;
    :yValue "9193.1" ;
    :belongsTo :Chart .

