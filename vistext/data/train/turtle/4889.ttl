@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Wheat consumption worldwide in 2018/2019 , by country (in 1,000 metric tons)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Country" .

:YAxis a :Axis ;
    :title "Consumption in thousand metric tons" .

:DataPoint1 a :DataPoint ;
    :xValue "China" ;
    :yValue "125000" ;
    :belongsTo :Chart .

