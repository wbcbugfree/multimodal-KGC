@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Non-financial corporate debt as a proportion of GDP in Malaysia from 2008 to 2017" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Debt as a proportion of GDP" .

:DataPoint1 a :DataPoint ;
    :xValue "2017*" ;
    :yValue "1.054" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "2016" ;
    :yValue "1.095" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "2015" ;
    :yValue "1.067" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "2014" ;
    :yValue "0.986" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "2013" ;
    :yValue "0.995" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "2012" ;
    :yValue "0.951" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "2011" ;
    :yValue "0.927" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "2010" ;
    :yValue "0.943" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "2009" ;
    :yValue "0.834" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "2008" ;
    :yValue "0.92" ;
    :belongsTo :Chart .
