@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Leading investment firms ranked by value of global and UK assets under management in the United Kingdom (UK) in 2019 (in billion GBP)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "UK assets" .

:YAxis a :Axis ;
    :title "Leading investment firms" .

:DataPoint1 a :DataPoint ;
    :xValue "1289" ;
    :yValue "BlackRock" ;
    :belongsTo :Chart .

