@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Soccer player transfers by highest all-time transfer fee worldwide as of October 2020 (in million euros)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Soccer player" .

:YAxis a :Axis ;
    :title "Transfer fee in million euros" .

:DataPoint1 a :DataPoint ;
    :xValue "Neymar (17/18)" ;
    :yValue "222" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Philippe Coutinho (17/18)" ;
    :yValue "145" ;
    :belongsTo :Chart .

