@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Which vacation destinations are popular with travelers 30 years old and younger ?" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Share of respondents" .

:YAxis a :Axis ;
    :title "Response" .

:DataPoint1 a :DataPoint ;
    :xValue "0.609" ;
    :yValue "Caribbean" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "0.52" ;
    :yValue "Mexico" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "0.35" ;
    :yValue "Hawaii" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "0.338" ;
    :yValue "Europe" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "0.192" ;
    :yValue "Continental U.S." ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "0.149" ;
    :yValue "Central America" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "0.117" ;
    :yValue "Australia/New Zealand" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "0.083" ;
    :yValue "Alaska" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "0.075" ;
    :yValue "Africa" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "0.075" ;
    :yValue "Asia" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "0.075" ;
    :yValue "South America" ;
    :belongsTo :Chart .
