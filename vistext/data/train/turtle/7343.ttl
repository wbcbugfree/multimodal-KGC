@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "The world 's leading container ship operators as of October 12 , 2020 , based on number of owned and chartered ships" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Owned" .

:YAxis a :Axis ;
    :title "Container ship operator" .

:DataPoint1 a :DataPoint ;
    :xValue "308" ;
    :yValue "APM-Maersk" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "139" ;
    :yValue "Mediterranean Shg Co" ;
    :belongsTo :Chart .

