    :xValue "116" ;
    :yValue "CMA CGM Group" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "173" ;
    :yValue "COSCO Group" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "112" ;
    :yValue "Hapag-Lloyd" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "71" ;
    :yValue "ONE (Ocean Network Express)" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "106" ;
    :yValue "Evergreen Line" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "34" ;
