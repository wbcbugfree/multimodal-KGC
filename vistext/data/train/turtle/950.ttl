@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Consumer price index (CPI) of coffee , tea and cocoa in the United Kingdom (UK) from 2003 to 2019" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Consumer price index*" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2002" ;
    :yValue "70.2" ;
    :belongsTo :Chart .

