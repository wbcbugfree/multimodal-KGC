@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Distribution of land use in Luxembourg from 2008 to 2019 , by type" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Agricultural and wooded area" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2007" ;
    :yValue "0.86" ;
    :belongsTo :Chart .

