@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Roche 's expenditure on research and development from 2007 to 2019 (in million Swiss francs)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Expenditure in million Swiss francs" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2006" ;
    :yValue "8385" ;
    :belongsTo :Chart .

