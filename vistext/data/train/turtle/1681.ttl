@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Most affordable cities for backpacking in Europe in 2020 , by daily price index (in U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "capital" .

:YAxis a :Axis ;
    :title "Daily price in U.S. dollars" .

:DataPoint1 a :DataPoint ;
    :xValue "Bucharest, Romania" ;
    :yValue "27.13" ;
    :belongsTo :Chart .

