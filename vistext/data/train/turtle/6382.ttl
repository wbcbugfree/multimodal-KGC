@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Number of fatalities among Western coalition soldiers involved in the execution of Operation Enduring Freedom from 2001 to 2020" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "Other" .

