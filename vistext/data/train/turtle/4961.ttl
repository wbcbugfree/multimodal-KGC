@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Revenue of Choice Hotels worldwide from 2008 to 2019 (in million U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Revenue in million U.S. dollars" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2007" ;
    :yValue "641.7" ;
    :belongsTo :Chart .

