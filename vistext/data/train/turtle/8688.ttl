@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Copper consumption of the United States from 2006 to 2019 (in 1,000 metric tons)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Apparent, unmanufactured**" .

:YAxis a :Axis ;
    :title "Reported, refined" .

