@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Reasons for internet users in the United States to shop on Amazon as of January 2020" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "Share of respondents" .

:DataPoint1 a :DataPoint ;
    :xValue "Fast, free shipping" ;
    :yValue "0.798" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Broad selection - they sell everything I need" ;
    :yValue "0.689" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "I am a Prime member" ;
    :yValue "0.657" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "Best pricing" ;
    :yValue "0.492" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "Easy returns process" ;
    :yValue "0.437" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Best digital shopping experience" ;
    :yValue "0.42" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Product reviews and recommendations" ;
    :yValue "0.405" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Unique items I can't find elsewhere (handcrafted, vintage, custom)" ;
    :yValue "0.223" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "Proactive communication during delivery" ;
    :yValue "0.178" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "Other" ;
    :yValue "0.024" ;
    :belongsTo :Chart .
