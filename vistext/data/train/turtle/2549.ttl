@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Fashion-related websites ranked by natural search voice share in the United Kingdom (UK) in February 2016" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "Share of natural search voice**" .

