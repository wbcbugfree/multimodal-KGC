@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Average monthly rainfall deviation in the United Kingdom (UK) from 2015 to 2020 (in millimeters)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Month" .

:YAxis a :Axis ;
    :title "2018" .

:DataPoint1 a :DataPoint ;
    :xValue "De" ;
    :yValue "-26.2" ;
    :belongsTo :Chart .

