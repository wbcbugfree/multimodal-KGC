@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Activities involved in due to coronavirus (COVID-19) lockdown across India in April 2020" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Share of respondents" .

:YAxis a :Axis ;
    :title "Response" .

:DataPoint1 a :DataPoint ;
    :xValue "0.59" ;
    :yValue "Household chores" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "0.48" ;
    :yValue "Movies/shows on OTT platforms" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "0.47" ;
    :yValue "Exercised at home" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "0.46" ;
    :yValue "Video calls to family/friends" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "0.33" ;
    :yValue "Picked up old hobbies" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "0.28" ;
    :yValue "More content creation on social media" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "0.28" ;
    :yValue "Board games" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "0.25" ;
    :yValue "Online games/video games" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "0.25" ;
    :yValue "Online courses (competitive exams/new skills)" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "0.18" ;
    :yValue "Social media challenges" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "0.15" ;
    :yValue "Hoarded more food supplies" ;
    :belongsTo :Chart .
