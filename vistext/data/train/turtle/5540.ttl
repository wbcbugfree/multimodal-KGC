@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Urban population in Singapore from 2005 to 2020 (in 1,000s)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Urban population in thousands" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2004" ;
    :yValue "4491" ;
    :belongsTo :Chart .

