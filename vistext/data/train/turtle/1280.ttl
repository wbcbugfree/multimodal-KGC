@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Natural population increase in Russian from 1990 to 2019 (in 1,000s)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Natural increase in thousands" .

