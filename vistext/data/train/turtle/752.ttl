@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Percentage of adults with severe headache or migraine in the U.S. between 1997 and 2016" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "Percentage of adults" .

