@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Spain : Government revenue and spending from 2014 to 2024 (in billion euros)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Spending" .

:DataPoint1 a :DataPoint ;
    :xValue "2024*" ;
    :yValue "599.51" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "2023*" ;
    :yValue "580.11" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "2022*" ;
    :yValue "561.98" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "2021*" ;
    :yValue "544.03" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "2020*" ;
    :yValue "527.6" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "2019*" ;
    :yValue "514.19" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "2018" ;
    :yValue "499.52" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "2017" ;
    :yValue "478.13" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "2016" ;
