@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Net revenue of Polo Ralph Lauren from FY2007 to FY2019 , by region (in million U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Region" .

:YAxis a :Axis ;
    :title "North America" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2006" ;
    :yValue "3452.2" ;
    :belongsTo :Chart .

