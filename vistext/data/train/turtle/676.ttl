@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Apple 's net income in the company 's fiscal years from 2005 to 2020 (in billion U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Fiscal years" .

:YAxis a :Axis ;
    :title "Net income in billion U.S. dollars" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2004" ;
    :yValue "1.33" ;
    :belongsTo :Chart .

