@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Most common registered male first names for children born in Poland in 2019" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "male first name" .

:YAxis a :Axis ;
    :title "Number of registered names" .

