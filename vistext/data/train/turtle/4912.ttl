@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Youth unemployment rate in Italy in 2019 , by region" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Unemployment rate" .

:YAxis a :Axis ;
    :title "region of Italy" .

