@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Number of Deutz AG employees from FY 2007 to FY 2019" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Number of employees" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2006" ;
    :yValue "4617" ;
    :belongsTo :Chart .

