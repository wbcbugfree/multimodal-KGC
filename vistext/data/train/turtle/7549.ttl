@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Have you subscribed to any of the following streaming or online dating services since the lockdown in your country ? (as of May 31 , 2020)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "United Kingdom" .

:DataPoint1 a :DataPoint ;
    :xValue "Netflix" ;
    :yValue "0.18" ;
    :belongsTo :Chart .

