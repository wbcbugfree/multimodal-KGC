@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Acetic acid production in the United States from 1990 to 2019 (in 1,000 metric tons)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Production in thousand metric tons" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 1989" ;
    :yValue "1662" ;
    :belongsTo :Chart .

