@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Percentage of population using the internet in Dominica from 2000 to 2017" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "Share of population" .

