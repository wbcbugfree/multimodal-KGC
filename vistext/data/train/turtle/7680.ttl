@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Penetration rate of side airbags in all cars in the United States from 2004 to 2015 , by origin" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Domestic Car" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2003" ;
    :yValue "0.28" ;
    :belongsTo :Chart .

