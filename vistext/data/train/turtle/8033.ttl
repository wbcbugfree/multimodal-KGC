@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Maturity of mHealth markets in selected countries in 2012" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Technology" .

:YAxis a :Axis ;
    :title "Response" .

:DataPoint1 a :DataPoint ;
    :xValue "6.5" ;
    :yValue "South Africa" ;
    :belongsTo :Chart .

