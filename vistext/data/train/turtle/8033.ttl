    :xValue "3.4" ;
    :yValue "India" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "4.7" ;
    :yValue "Brazil" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "7.6" ;
    :yValue "United States" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "5.1" ;
    :yValue "Spain" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "4.1" ;
    :yValue "China" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "6.6" ;
    :yValue "Germany" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "6.3" ;
    :yValue "United Kingdom" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "5.1" ;
    :yValue "Turkey" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "8.1" ;
    :yValue "Denmark" ;
