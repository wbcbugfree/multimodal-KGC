@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Share of people in Great Britain who think that court sentences are not harsh enough in 2019 , by politics and age group" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "Share of respondents" .

:DataPoint1 a :DataPoint ;
    :xValue "Leave voters" ;
    :yValue "0.88" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Conservative voters" ;
    :yValue "0.87" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "65 years or older" ;
    :yValue "0.8" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "50-64 years old" ;
    :yValue "0.78" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "Overall" ;
    :yValue "0.7" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "25-49 years old" ;
    :yValue "0.66" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Liberal Democrat voters" ;
    :yValue "0.62" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Labour voters" ;
    :yValue "0.58" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "Remain voters" ;
    :yValue "0.56" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "18-24 years old" ;
    :yValue "0.46" ;
    :belongsTo :Chart .
