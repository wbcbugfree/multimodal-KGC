@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Total number of canoes sold in the U.S. from 2000 to 2013" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Canoes sold" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 1999" ;
    :yValue "111800" ;
    :belongsTo :Chart .

