@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Annual beauty-related content views on YouTube from 2009 to 2018 (in billions)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Annual beauty content views in billions" .

:DataPoint1 a :DataPoint ;
    :xValue "2018*" ;
    :yValue "169" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "2017" ;
    :yValue "104" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "2016" ;
    :yValue "59" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "2015" ;
    :yValue "37" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "2014" ;
    :yValue "25" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "2013" ;
    :yValue "16" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "2012" ;
    :yValue "11" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "2011" ;
    :yValue "7" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "2010" ;
    :yValue "5" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "2009" ;
    :yValue "3" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "2008" ;
    :yValue "2" ;
    :belongsTo :Chart .

:DataPoint12 a :DataPoint ;
    :xValue "2007" ;
    :yValue "0.87" ;
