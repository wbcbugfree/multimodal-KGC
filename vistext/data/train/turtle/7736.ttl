@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Total new building permits issued in the Netherlands from 2006 to 2016 , by type of property" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Commercial property" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2005" ;
    :yValue "5296" ;
    :belongsTo :Chart .

