@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Ten most popular A.S. Roma players on Instagram as of May 29 , 2020 (in 1,000 followers)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Number of followers in thousands" .

:YAxis a :Axis ;
    :title "players" .

:DataPoint1 a :DataPoint ;
    :xValue "1450" ;
    :yValue "Edin Dzeko" ;
    :belongsTo :Chart .

