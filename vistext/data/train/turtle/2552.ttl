@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "All time top goal scorers of the national football team of the Netherlands as of 23rd January 2020 , by goals scored" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Goal scorer" .

:YAxis a :Axis ;
    :title "Goals scored" .

:DataPoint1 a :DataPoint ;
    :xValue "Robin van Persie" ;
    :yValue "50" ;
    :belongsTo :Chart .

