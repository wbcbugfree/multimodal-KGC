@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Infant mortality rate (under one year old) in Sweden from 1800 to 2020" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Deaths per 1,000 live births" .

