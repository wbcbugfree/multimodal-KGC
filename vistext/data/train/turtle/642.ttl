@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Countries with the most earthquakes from 1900 to 2016" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Number of earthquakes" .

:YAxis a :Axis ;
    :title "Country" .

:DataPoint1 a :DataPoint ;
    :xValue "157" ;
    :yValue "China" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "113" ;
    :yValue "Indonesia" ;
    :belongsTo :Chart .

