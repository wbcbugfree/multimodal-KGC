@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Vietnam : Ratio of government expenditure to gross domestic product (GDP) from 2014 to 2024" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Ratio of government expenditure to GDP" .

:DataPoint1 a :DataPoint ;
    :xValue "2024*" ;
    :yValue "0.2655" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "2023*" ;
    :yValue "0.2675" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "2022*" ;
    :yValue "0.2686" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "2021*" ;
    :yValue "0.2712" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "2020*" ;
    :yValue "0.2756" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "2019*" ;
    :yValue "0.2777" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "2018*" ;
    :yValue "0.2884" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "2017" ;
    :yValue "0.2922" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "2016" ;
    :yValue "0.2784" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "2015" ;
    :yValue "0.302" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "2014" ;
    :yValue "0.2853" ;
    :belongsTo :Chart .
