@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Consumer expenditure on live entertainment in the United States from 1999 to 2013 (in billion U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Expenditure in billion U.S. dollars" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 1998" ;
    :yValue "9.5" ;
    :belongsTo :Chart .

