@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Number of foreigners in Luxembourg in 2020 , by nationality (in 1,000s)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Country" .

:YAxis a :Axis ;
    :title "Number of foreigners in thousands" .

:DataPoint1 a :DataPoint ;
    :xValue "Total foreigners" ;
    :yValue "296.5" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Portugal" ;
    :yValue "95.1" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "France" ;
    :yValue "47.8" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "Italy" ;
    :yValue "23" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "Belgium" ;
    :yValue "19.8" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Germany" ;
    :yValue "12.8" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Britain" ;
    :yValue "5.3" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Netherlands" ;
    :yValue "4.2" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "Other EU**" ;
    :yValue "39.9" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "Other" ;
    :yValue "48.6" ;
    :belongsTo :Chart .
