@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Revenue of the electric power industry in the United States from 1970 to 2019 (in billion U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Revenue in billion U.S. dollars" .

