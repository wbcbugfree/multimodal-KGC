@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Gender wage gap for the 20 most common occupations for men in the U.S. in 2019 , by median weekly earnings (in U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Men's earnings" .

:YAxis a :Axis ;
    :title "Occupation" .

:DataPoint1 a :DataPoint ;
    :xValue "2509" ;
    :yValue "Chief executives" ;
    :belongsTo :Chart .

