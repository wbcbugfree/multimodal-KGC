@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Total U.S. grain supply from 2001 to 2020 (in million metric tons)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Total supply in million metric tons" .

