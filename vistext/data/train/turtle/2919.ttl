@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Do you ever play games at home or elsewhere via PC , laptop or notebook ?" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "Share of respondents" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2006" ;
    :yValue "0.17" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Dec 31, 2008" ;
    :yValue "0.14" ;
    :belongsTo :Chart .

