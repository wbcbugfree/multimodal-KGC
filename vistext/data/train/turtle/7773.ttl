@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Number of lifetime prevalent cases of anxiety disorders among adults in select countries worldwide in 2018 , by gender (in millions)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Women" .

:YAxis a :Axis ;
    :title "Country" .

