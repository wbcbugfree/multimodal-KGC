@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Number of tax filers in Canada in 2018 , by province" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "province of Canada" .

:YAxis a :Axis ;
    :title "Number of taxfilers" .

:DataPoint1 a :DataPoint ;
    :xValue "Ontario" ;
    :yValue "10437530" ;
    :belongsTo :Chart .

