@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Most popular online subscription box retailers in the United States as of April 2018 , by number of visitors" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Retailers" .

:YAxis a :Axis ;
    :title "Monthly visitors" .

:DataPoint1 a :DataPoint ;
    :xValue "Blue Apron" ;
    :yValue "935599" ;
    :belongsTo :Chart .

