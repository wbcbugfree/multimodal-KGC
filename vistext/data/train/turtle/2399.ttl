    :xValue "559" ;
    :yValue "Democratic Republic of the Congo" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "555" ;
    :yValue "Yemen" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "517" ;
    :yValue "Syria" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "300" ;
    :yValue "Pakistan" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
