@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Number of deaths in the countries most impacted by terrorism in 2019" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Number of people killed" .

:YAxis a :Axis ;
    :title "Country" .

:DataPoint1 a :DataPoint ;
    :xValue "5725" ;
    :yValue "Afghanistan" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "1245" ;
    :yValue "Nigeria" ;
    :belongsTo :Chart .

