@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Top 10 U.S. states based on number of Medicare beneficiaries in 2018" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Number of Medicare beneficiaries" .

:YAxis a :Axis ;
    :title "State" .

:DataPoint1 a :DataPoint ;
    :xValue "6124095" ;
    :yValue "California" ;
    :belongsTo :Chart .

