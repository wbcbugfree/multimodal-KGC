@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Percentage of Americans voting for the Democratic candidate in presidential elections from 1972 to 2012 , by generation" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Generation aged 18-29" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 1971" ;
    :yValue "0.46" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Dec 31, 1975" ;
    :yValue "0.51" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "Dec 31, 1979" ;
    :yValue "0.44" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "Dec 31, 1983" ;
    :yValue "0.4" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "Dec 31, 1987" ;
    :yValue "0.47" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Dec 31, 1991" ;
    :yValue "0.43" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Dec 31, 1995" ;
    :yValue "0.53" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Dec 31, 1999" ;
    :yValue "0.48" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "Dec 31, 2003" ;
    :yValue "0.54" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "Dec 31, 2007" ;
    :yValue "0.66" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "Dec 31, 2011" ;
    :yValue "0.6" ;
    :belongsTo :Chart .
