@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Monthly sales of bedding , linens and bathroom accessories at large retailers in Canada from 2014 to 2016 (in million Canadian dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "2014" .

:YAxis a :Axis ;
    :title "Month" .

:DataPoint1 a :DataPoint ;
    :xValue "178.12" ;
    :yValue "Dec" ;
    :belongsTo :Chart .

