@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Fastest mobile games to reach 10 million downloads worldwide as of December 2016 (in days)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Days needed to reach 10 million downloads" .

:YAxis a :Axis ;
    :title "mobile game" .

:DataPoint1 a :DataPoint ;
    :xValue "1" ;
    :yValue "Super Mario Run" ;
    :belongsTo :Chart .

