@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Planned total expenditure on Mother 's Day in the United States from 2007 to 2020 (in billion U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Expenditure in billion U.S. dollars" .

