@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Industries impacted by cyber attacks worldwide as of September 2017" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Share of respondents" .

:YAxis a :Axis ;
    :title "Response" .

:DataPoint1 a :DataPoint ;
    :xValue "0.26" ;
    :yValue "Energy" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "0.25" ;
    :yValue "Healthcare" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "0.25" ;
    :yValue "Retail and wholesale" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "0.22" ;
    :yValue "Manufacturing" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "0.19" ;
    :yValue "Infrastructure" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "0.17" ;
    :yValue "Financial institutions" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "0.15" ;
    :yValue "Automotive" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "0.15" ;
    :yValue "Professional services" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "0.14" ;
    :yValue "Power and utilities" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "0.14" ;
    :yValue "Marine" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "0.13" ;
    :yValue "Communications, media and technology" ;
    :belongsTo :Chart .

:DataPoint12 a :DataPoint ;
    :xValue "0.09" ;
    :yValue "Aviation and aerospace" ;
    :belongsTo :Chart .
