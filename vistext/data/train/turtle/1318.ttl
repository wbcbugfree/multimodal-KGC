@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Most individual points scored in a single March Madness game as of March 2020" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Points scored" .

:YAxis a :Axis ;
    :title "March Madness Game" .

:DataPoint1 a :DataPoint ;
    :xValue "61" ;
    :yValue "Austin Carr (Notre Dame vs. Ohio, 1970)" ;
    :belongsTo :Chart .

