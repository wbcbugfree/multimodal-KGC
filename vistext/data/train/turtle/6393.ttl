@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Average monthly precipitation in Germany from November 2019 to November 2020 (in liters per square meter)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Month" .

:YAxis a :Axis ;
    :title "Long-term average" .

:DataPoint1 a :DataPoint ;
    :xValue "Nov 20" ;
    :yValue "66" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Oct 20" ;
    :yValue "56" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "Sep 20" ;
    :yValue "61" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "Aug 20" ;
    :yValue "77" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "Jul 20" ;
    :yValue "78" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Jun 20" ;
    :yValue "85" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "May 20" ;
    :yValue "71" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Apr 20" ;
    :yValue "58" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "Mar 20" ;
    :yValue "57" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "Feb 20" ;
    :yValue "49" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "Jan 20" ;
    :yValue "61" ;
    :belongsTo :Chart .

:DataPoint12 a :DataPoint ;
    :xValue "Dec 19" ;
    :yValue "70" ;
    :belongsTo :Chart .

:DataPoint13 a :DataPoint ;
    :xValue "Nov 19" ;
    :yValue "66" ;
    :belongsTo :Chart .
