@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Brand value of most valuable utilities brands worldwide in 2020 (in million U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Brand value in million U.S. dollars" .

:YAxis a :Axis ;
    :title "utilities brand" .

:DataPoint1 a :DataPoint ;
    :xValue "56965" ;
    :yValue "State Grid(China)" ;
    :belongsTo :Chart .

