@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Impact of the coronavirus (COVID-19) outbreak on the main macroeconomic indicators in Romania from October 2019 to September 2020" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Jan '20" .

:YAxis a :Axis ;
    :title "main macroeconomic indicators" .

:DataPoint1 a :DataPoint ;
    :xValue "-0.021" ;
    :yValue "Industrial production***" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "0.103" ;
    :yValue "Non-farming private sector*" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "0.107" ;
    :yValue "Services*" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "0.07" ;
    :yValue "Import**" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "0.138" ;
    :yValue "Services rendered mainly to enterprises**" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "0.046" ;
    :yValue "Export**" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "0.131" ;
    :yValue "Wholesale trade**" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "0.112" ;
    :yValue "Retail trade***" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "0.037" ;
    :yValue "Trade and repair of motor vehicles***" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "0.13" ;
    :yValue "Households' consumption*" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "0.174" ;
    :yValue "Services provided to the population***" ;
    :belongsTo :Chart .

:DataPoint12 a :DataPoint ;
    :xValue "0.498" ;
    :yValue "Construction works***" ;
    :belongsTo :Chart .
