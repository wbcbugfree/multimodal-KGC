@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "International brokerage fees in 2011 , by region" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Country" .

:YAxis a :Axis ;
    :title "Brokerage fees in euros" .

:DataPoint1 a :DataPoint ;
    :xValue "Austria" ;
    :yValue "7600" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Germany*" ;
    :yValue "6968" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "Spain" ;
    :yValue "6000" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "U.S.*" ;
    :yValue "5900" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "Sweden" ;
    :yValue "5000" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "France" ;
    :yValue "5000" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Italy*" ;
    :yValue "4200" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Portugal*" ;
    :yValue "4000" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "United Kingdom*" ;
    :yValue "2550" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "Ireland" ;
    :yValue "2500" ;
    :belongsTo :Chart .
