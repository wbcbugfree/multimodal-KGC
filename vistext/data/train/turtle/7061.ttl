@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Net revenue of lululemon worldwide from 2010 to 2019 , by channel (in million U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Segment" .

:YAxis a :Axis ;
    :title "Other" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2009" ;
    :yValue "63.97" ;
    :belongsTo :Chart .

