@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Superstitions held by Americans in 2014 , by religious affiliation" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Catholic" .

:YAxis a :Axis ;
    :title "Response" .

:DataPoint1 a :DataPoint ;
    :xValue "0.4" ;
    :yValue "Finding and picking up a penny is good luck" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "0.31" ;
    :yValue "It’s bad luck for the groom to see the bridebefore the wedding" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "0.26" ;
    :yValue "Seven is a lucky number" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "0.27" ;
    :yValue "Knocking on wood prevents bad luck" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "0.26" ;
    :yValue "It’s unlucky to walk under a ladder" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "0.18" ;
    :yValue "Opening an umbrella indoors is bad luck" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "0.18" ;
    :yValue "Friday the 13th is an unlucky day" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "0.21" ;
    :yValue "Breaking a mirror brings seven years bad luck" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "0.18" ;
    :yValue "Throwing spilled salt over the left shoulderprevents bad luck" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "0.17" ;
    :yValue "A black cat crossing your path is bad luck" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "0.15" ;
    :yValue "13 is an unlucky number" ;
    :belongsTo :Chart .

:DataPoint12 a :DataPoint ;
    :xValue "0.08" ;
    :yValue "Stepping on a crack is bad luck" ;
    :belongsTo :Chart .
