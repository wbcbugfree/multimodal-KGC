@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Leading artists worldwide in 2019 , by auction revenue (in million U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "leading artists worldwide" .

:YAxis a :Axis ;
    :title "Auction sales in million U.S. dollars" .

