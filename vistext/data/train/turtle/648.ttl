@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Office properties vacancy rate in Frankfurt from 2006 to 2019" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Office vacancy rate" .

:YAxis a :Axis ;
    :title "Year" .

:DataPoint1 a :DataPoint ;
    :xValue "0.1" ;
    :yValue "2019*" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "0.103" ;
    :yValue "2018*" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "0.107" ;
    :yValue "2017*" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "0.113" ;
    :yValue "2016*" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "0.108" ;
    :yValue "2015*" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "0.114" ;
    :yValue "2014*" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "0.114" ;
    :yValue "2013" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "0.121" ;
    :yValue "2012" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "0.135" ;
    :yValue "2011" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "0.144" ;
    :yValue "2010" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "0.143" ;
    :yValue "2009" ;
    :belongsTo :Chart .

:DataPoint12 a :DataPoint ;
    :xValue "0.137" ;
    :yValue "2008" ;
    :belongsTo :Chart .

:DataPoint13 a :DataPoint ;
    :xValue "0.142" ;
    :yValue "2007" ;
    :belongsTo :Chart .

:DataPoint14 a :DataPoint ;
    :xValue "0.167" ;
    :yValue "2006" ;
    :belongsTo :Chart .
