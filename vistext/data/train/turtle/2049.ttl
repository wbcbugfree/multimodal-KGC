@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Value of household debt in the Asia Pacific region in 2014 , by country or region (in billion U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Value in U.S. billion dollars" .

:YAxis a :Axis ;
    :title "Country" .

