@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Countries expected to spend the most on travel worldwide in 2015 (in U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Country" .

:YAxis a :Axis ;
    :title "Average travel spend in U.S. dollars" .

:DataPoint1 a :DataPoint ;
    :xValue "Switzerland" ;
    :yValue "12100" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Australia" ;
    :yValue "11700" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "New Zealand" ;
    :yValue "9500" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "United States" ;
    :yValue "8700" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "United Kingdom" ;
    :yValue "8400" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Germany" ;
    :yValue "7600" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Canada" ;
    :yValue "6900" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Austria" ;
    :yValue "6800" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "Ireland" ;
    :yValue "6300" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "China" ;
    :yValue "5900" ;
    :belongsTo :Chart .
