@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Most popular Google Play app store categories from 1st quarter 2016 to 1st quarter 2020 , by number of downloads (in millions)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Quarter" .

:YAxis a :Axis ;
    :title "Communication" .

