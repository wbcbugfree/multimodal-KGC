@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Interactive kiosk market revenue in the United States from 2014 to 2025 , by component (in billion U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Software" .

:DataPoint1 a :DataPoint ;
    :xValue "2025*" ;
    :yValue "3.86" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "2024*" ;
    :yValue "3.49" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "2023*" ;
    :yValue "3.21" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "2022*" ;
    :yValue "3.03" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "2021*" ;
    :yValue "2.7" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "2020*" ;
    :yValue "2.45" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "2019*" ;
    :yValue "2.27" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "2018" ;
    :yValue "2.13" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "2017" ;
    :yValue "1.95" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "2016" ;
    :yValue "1.77" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "2015" ;
    :yValue "1.59" ;
    :belongsTo :Chart .

:DataPoint12 a :DataPoint ;
    :xValue "2014" ;
    :yValue "1.5" ;
    :belongsTo :Chart .
