@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Joe Gibbs Racing team (NASCAR) revenue from 2006 to 2017 (in million U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Revenue in million U.S. dollars" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2005" ;
    :yValue "110" ;
    :belongsTo :Chart .

