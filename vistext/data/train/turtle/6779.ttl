@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Number of employees of KPMG worldwide from 2010 to 2019 , by region" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Region" .

:YAxis a :Axis ;
    :title "Americas" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2009" ;
    :yValue "36059" ;
    :belongsTo :Chart .

