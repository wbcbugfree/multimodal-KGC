@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Export value of chemicals from England from 2011 to Q2 2020 (in million GBP)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Export value in million GBP" .

:YAxis a :Axis ;
    :title "Year" .

:DataPoint1 a :DataPoint ;
    :xValue "18382" ;
    :yValue "2020*" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "39112" ;
    :yValue "2019" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "37854" ;
    :yValue "2018" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "37795" ;
    :yValue "2017" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "36590" ;
    :yValue "2016" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "37432" ;
    :yValue "2015" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "35679" ;
    :yValue "2014" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "35324" ;
    :yValue "2013" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "38117" ;
    :yValue "2012" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "40467" ;
    :yValue "2011" ;
    :belongsTo :Chart .
