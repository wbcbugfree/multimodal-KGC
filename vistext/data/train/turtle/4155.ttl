@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Most popular brands on Facebook in Hong Kong as of September 2020 , ranked by number of fans" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Number of fans on Facebook" .

:YAxis a :Axis ;
    :title "Brand" .

:DataPoint1 a :DataPoint ;
    :xValue "1391753" ;
    :yValue "Blackview" ;
    :belongsTo :Chart .

