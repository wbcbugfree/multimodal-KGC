    :xValue "640307" ;
    :yValue "Kids Logic" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "617924" ;
    :yValue "Flyagain.la" ;
    :belongsTo :Chart .

