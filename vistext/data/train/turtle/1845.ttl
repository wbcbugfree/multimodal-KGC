@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Number of domestic overnight holiday trips in Great Britain from 2010 to 2019 (in millions)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Number of trips in millions" .

:DataPoint1 a :DataPoint ;
    :xValue "2019" ;
    :yValue "60.45" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "2018" ;
    :yValue "57.89" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "2017" ;
    :yValue "59.15" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "2016" ;
    :yValue "55.88" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "2015*" ;
    :yValue "55.96" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "2014" ;
    :yValue "52.9" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "2013" ;
    :yValue "56.97" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "2012" ;
    :yValue "57.7" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "2011" ;
    :yValue "58.44" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "2010" ;
    :yValue "54.74" ;
    :belongsTo :Chart .
