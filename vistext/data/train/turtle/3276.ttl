@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Gross domestic expenditure on research and development (GERD) as a percentage of GDP in Czechia from 2000 to 2018" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "GERD as percentage of GDP" .

