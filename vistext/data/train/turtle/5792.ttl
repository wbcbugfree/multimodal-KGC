@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Preferred online shopping websites of upper-income teens in the United States in fall 2019" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "Share of respondents" .

:DataPoint1 a :DataPoint ;
    :xValue "Amazon" ;
    :yValue "0.52" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Nike" ;
    :yValue "0.04" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "American Eagle" ;
    :yValue "0.03" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "Urban Outfitters" ;
    :yValue "0.02" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "eBay" ;
    :yValue "0.02" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "PacSun" ;
    :yValue "0.02" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "lululemon" ;
    :yValue "0.02" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Fashion Nova" ;
    :yValue "0.02" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "Zumiez" ;
    :yValue "0.01" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "Adidas" ;
    :yValue "0.01" ;
    :belongsTo :Chart .
