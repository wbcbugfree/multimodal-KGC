@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Share of family refusals to consent to organ donation in Europe from 2015 to 2017 , by country" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "2015" .

:YAxis a :Axis ;
    :title "Country" .

