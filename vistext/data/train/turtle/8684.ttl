    :xValue "2020*" ;
    :yValue "1348.15" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "2019*" ;
    :yValue "1341.39" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "2018" ;
    :yValue "1318.64" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "2017" ;
