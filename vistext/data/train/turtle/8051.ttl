    :xValue "Dec 31, 2011" ;
    :yValue "53.16" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Dec 31, 2012" ;
    :yValue "53.55" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
