@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Number of passenger cars produced by Mazda worldwide from 1999 to 2014 (in millions)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Production in million units" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 1998" ;
    :yValue "0.82" ;
    :belongsTo :Chart .

