@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Motorcycle theft recovery rates in the United States in 2019 , by make" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Rate of theft recoveries" .

:YAxis a :Axis ;
    :title "make" .

