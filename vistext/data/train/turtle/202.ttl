@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Leading beauty and fashion brands ranked by Instagram user engagement as of May 2017 (in million interactions)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Number of combined likes and comments" .

:YAxis a :Axis ;
    :title "beauty and fashion brand" .

:DataPoint1 a :DataPoint ;
    :xValue "134.37" ;
    :yValue "hypebeast" ;
    :belongsTo :Chart .

