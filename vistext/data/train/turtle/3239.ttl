@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Investment in clean energy globally in 2019 , by select country (in billion U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Country" .

:YAxis a :Axis ;
    :title "Investment in billion U.S. dollars" .

:DataPoint1 a :DataPoint ;
    :xValue "China" ;
    :yValue "83.4" ;
    :belongsTo :Chart .

