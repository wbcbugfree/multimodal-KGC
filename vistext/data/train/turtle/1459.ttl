@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Most popular top-level domains worldwide as of October 2020" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Share of global TLD" .

:YAxis a :Axis ;
    :title "Response" .

:DataPoint1 a :DataPoint ;
    :xValue "0.516" ;
    :yValue ".com" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "0.063" ;
    :yValue ".ru" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "0.045" ;
    :yValue ".org" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "0.034" ;
    :yValue ".net" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "0.016" ;
    :yValue ".in" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "0.016" ;
    :yValue ".ir" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "0.015" ;
    :yValue ".au" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "0.015" ;
    :yValue ".uk" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "0.014" ;
    :yValue ".de" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "0.013" ;
    :yValue ".br" ;
    :belongsTo :Chart .
