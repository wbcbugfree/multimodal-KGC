@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Distribution of take-up of logistics space in the United Kingdom (UK) in the first and second halves of 2014 , by sector" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "First half 2014" .

:YAxis a :Axis ;
    :title "Race" .

:DataPoint1 a :DataPoint ;
    :xValue "0.25" ;
    :yValue "3PL / distribution" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "0.08" ;
    :yValue "Other manufacturing" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "0.07" ;
    :yValue "Motor industry" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "0.02" ;
    :yValue "Food industry" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "0.08" ;
    :yValue "Postal Services" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "0.15" ;
    :yValue "Retail - Food" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "0.3" ;
    :yValue "Retail - Other" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "0.05" ;
    :yValue "Other" ;
    :belongsTo :Chart .
