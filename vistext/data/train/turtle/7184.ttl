@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Consumption of natural gas in the United States from 2005 to 2019 , by sector (in billion cubic feet)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Commercial*" .

