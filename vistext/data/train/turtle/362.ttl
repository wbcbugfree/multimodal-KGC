@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Number of new books and editions published in the United States in the category 'poetry/drama ' from 2002 to 2013" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Number of new books / editions" .

:DataPoint1 a :DataPoint ;
    :xValue "2013.025" ;
    :yValue "10000" ;
    :belongsTo :Chart .

