@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Number of college and university students from China in the United States from academic year 2008/09 to 2018/19" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Number of students" .

:DataPoint1 a :DataPoint ;
    :xValue "2018/19" ;
    :yValue "369548" ;
    :belongsTo :Chart .

