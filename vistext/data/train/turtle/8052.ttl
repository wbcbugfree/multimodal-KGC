@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Total population of Grenada from 2008 to 2018 , by gender (in 1,000 inhabitants)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Total" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2007" ;
    :yValue "105.46" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Dec 31, 2008" ;
    :yValue "105.79" ;
    :belongsTo :Chart .

