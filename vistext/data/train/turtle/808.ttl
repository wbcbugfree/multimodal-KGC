@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Denver Nuggets all-time points leaders from 1976 to 2020" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Points scored" .

:YAxis a :Axis ;
    :title "all-time points leaders" .

:DataPoint1 a :DataPoint ;
    :xValue "21645" ;
    :yValue "Alex English" ;
    :belongsTo :Chart .

