@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Total assets of BMW Group from FY 2008 to FY 2019 (in million euros)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Total assets in million euros" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2007" ;
    :yValue "101086" ;
    :belongsTo :Chart .

