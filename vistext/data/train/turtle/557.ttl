@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Selected global media and sporting events with the most Facebook interactions as of May 2017 (in million interactions)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Number of Facebook interactions in millions" .

:YAxis a :Axis ;
    :title "Year" .

:DataPoint1 a :DataPoint ;
    :xValue "3000" ;
    :yValue "2014 FIFA World Cup (Jun 12-Jul13)" ;
    :belongsTo :Chart .

