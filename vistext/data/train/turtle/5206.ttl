@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Average disposable income per household in the United Kingdom (UK) in 2018/19 , by decile group (in GBP)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Decile group" .

:YAxis a :Axis ;
    :title "Disposable income in GBP" .

:DataPoint1 a :DataPoint ;
    :xValue "Top" ;
    :yValue "115329" ;
    :belongsTo :Chart .

