@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Miami Marlins all-time home run leaders as of October 2020" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Miami Marlins all-time home run leaders" .

:YAxis a :Axis ;
    :title "Number of home runs" .

:DataPoint1 a :DataPoint ;
    :xValue "Giancarlo Stanton" ;
    :yValue "267" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Dan Uggla" ;
    :yValue "154" ;
    :belongsTo :Chart .

