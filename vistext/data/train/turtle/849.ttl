    :xValue "Miguel Cabrera" ;
    :yValue "138" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Derrek Lee" ;
    :yValue "129" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Gary Sheffield" ;
    :yValue "122" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Jeff Conine" ;
    :yValue "120" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
