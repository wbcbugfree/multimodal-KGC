@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Leading countries based on share of Facebook users worldwide as of January 2018" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "Share of global monthly active Facebook users" .

:DataPoint1 a :DataPoint ;
    :xValue "India" ;
    :yValue "0.12" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "United States" ;
    :yValue "0.11" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "Brazil" ;
    :yValue "0.06" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "Indonesia" ;
    :yValue "0.06" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "Mexico" ;
    :yValue "0.04" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Philippines" ;
    :yValue "0.03" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Vietnam" ;
    :yValue "0.03" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Thailand" ;
    :yValue "0.02" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "Turkey" ;
    :yValue "0.02" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "United Kingdom" ;
    :yValue "0.02" ;
    :belongsTo :Chart .
