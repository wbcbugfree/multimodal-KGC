@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Mine production of nickel in Indonesia from 2006 to 2019 (in 1,000 metric tons)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Production in thousand metric tons" .

:DataPoint1 a :DataPoint ;
    :xValue "2019*" ;
    :yValue "800" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "2018" ;
    :yValue "606" ;
    :belongsTo :Chart .

