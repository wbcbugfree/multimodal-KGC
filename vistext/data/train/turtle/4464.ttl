@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Number of new coronavirus (COVID-19) cases confirmed in Czechia in 2020 , by region" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "region of the Czech Republic" .

:YAxis a :Axis ;
    :title "Number of people" .

:DataPoint1 a :DataPoint ;
    :xValue "Hlavní město Praha" ;
    :yValue "2309" ;
    :belongsTo :Chart .

