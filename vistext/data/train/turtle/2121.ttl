@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "American customer satisfaction index scores of McDonald 's restaurants in the United States from 2000 to 2020" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "ACSI score" .

