@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Total shorn wool production value in the U.S. from 1999 to 2018 (in 1,000 U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Production value in thousand U.S. dollars" .

