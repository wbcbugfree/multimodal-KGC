@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Federal drug control spending on treatment and prevention in the United States from 2008 to 2021 (in million U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Prevention" .

:DataPoint1 a :DataPoint ;
    :xValue "2008" ;
    :yValue "1844.407" ;
    :belongsTo :Chart .

