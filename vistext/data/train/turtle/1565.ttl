    :xValue "2000" ;
    :yValue "Fredrik Jensen" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "1200" ;
    :yValue "Glen Kamara" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
