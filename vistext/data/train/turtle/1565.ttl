@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Leading players of the national football team of Finland as of July 2020 , by market value (in 1,000 euros)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Market value in thousand euros" .

:YAxis a :Axis ;
    :title "Football Player" .

:DataPoint1 a :DataPoint ;
    :xValue "8000" ;
    :yValue "Teemu Pukki" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "8000" ;
    :yValue "Lukas Hradecky" ;
    :belongsTo :Chart .

