@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Tequila production in Mexico from 1995 to 2019 (in million liters)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Production in million liters" .

