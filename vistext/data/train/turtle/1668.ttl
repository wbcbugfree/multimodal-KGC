@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Most visited paid attractions in Yorkshire and Humberside in England in 2019" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Number of visits" .

:YAxis a :Axis ;
    :title "Attraction Name" .

:DataPoint1 a :DataPoint ;
    :xValue "841934" ;
    :yValue "Yorkshire Wildlife Park" ;
    :belongsTo :Chart .

