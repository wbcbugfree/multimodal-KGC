@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Most popular fake election stories in the United States in 2016 , by Facebook engagement (in thousands)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Number of Facebook engagements in thousands" .

:YAxis a :Axis ;
    :title "fake election story" .

:DataPoint1 a :DataPoint ;
    :xValue "2200" ;
    :yValue "Obama signs a nationwide order banning The Pledge of Allegiance in Schools" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "1700" ;
    :yValue "Obama cut $2.6 billion from programs for veterans to support Syrian refugees in the US" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "961.3" ;
    :yValue "Pope Francis endorses Trump for President" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "817.9" ;
    :yValue "Ireland is officially accepting Trump refugees from America" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "789.5" ;
    :yValue "Hillary Clinton sold weapons to ISIS and it was confirmed by WikiLeaks" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "507.2" ;
    :yValue "Hillary Clinton suggested Trump should run for President" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "481.1" ;
    :yValue "Trump won the popular vote" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "352.6" ;
    :yValue "Mike Pence said Michelle Obama is the most vulgar First Lady ever" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "301" ;
    :yValue "Donald Trump mistook famous drag queen RuPaul for a woman and groped him at a party in 1995" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "268.6" ;
    :yValue "The Clinton Foundation paid Khizr Khan's law firm $375,000" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "90.3" ;
    :yValue "Sarah Palin banned Muslims from \"entering\" her daughter" ;
    :belongsTo :Chart .
