@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "U.S. natural gas consumption between 2005 and 2019 , by sector (in billion cubic feet)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Industrial" .

:DataPoint1 a :DataPoint ;
    :xValue "2019***" ;
    :yValue "10245" ;
    :belongsTo :Chart .

