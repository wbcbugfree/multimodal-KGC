@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Share of family households with own children under 18 years in the United States from 1970 to 2020 , by type of family" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Single father*" .

