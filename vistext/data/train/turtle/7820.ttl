@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Percentage of public and private health expenditure in selected countries in 2012" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Country" .

:YAxis a :Axis ;
    :title "Public" .

:DataPoint1 a :DataPoint ;
    :xValue "United Kingdom" ;
    :yValue "0.84" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Japan" ;
    :yValue "0.821" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "France" ;
    :yValue "0.774" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "Turkey" ;
    :yValue "0.768" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "Germany" ;
    :yValue "0.767" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Spain" ;
    :yValue "0.717" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "China" ;
    :yValue "0.56" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Russia" ;
    :yValue "0.511" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "Brazil" ;
    :yValue "0.475" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "India" ;
    :yValue "0.305" ;
    :belongsTo :Chart .
