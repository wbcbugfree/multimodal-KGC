@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Free cash flow for shareholder-owned electric utilities in the United States from 2002 to 2019 (in billion U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Free cash flow in billion U.S. dollars" .

