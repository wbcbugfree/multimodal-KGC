    :yValue "410.82" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Dec 31, 2012" ;
    :yValue "429.81" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
