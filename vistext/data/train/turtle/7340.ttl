@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Sales of beer in Ontario , Canada from 2008 to 2019 , by product type (in million Canadian dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Domestic beer" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2007" ;
    :yValue "311.03" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Dec 31, 2008" ;
    :yValue "322.48" ;
    :belongsTo :Chart .

