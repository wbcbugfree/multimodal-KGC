@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Italy : Budget balance from 2014 to 2024 (in billion euros)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Budget balance in billion euros" .

:DataPoint1 a :DataPoint ;
    :xValue "2024*" ;
    :yValue "-51.31" ;
    :belongsTo :Chart .

