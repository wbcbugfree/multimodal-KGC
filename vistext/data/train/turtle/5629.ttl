@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Houston Rockets all-time points leaders from 1967 to 2020" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Points scored" .

:YAxis a :Axis ;
    :title "player name" .

:DataPoint1 a :DataPoint ;
    :xValue "26511" ;
    :yValue "Hakeem Olajuwon" ;
    :belongsTo :Chart .

