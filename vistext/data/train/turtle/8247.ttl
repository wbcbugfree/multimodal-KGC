@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Most popular social networks of teenagers in the United States from fall 2012 to fall 2020" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Spring 2013" .

:YAxis a :Axis ;
    :title "Response" .

:DataPoint1 a :DataPoint ;
    :xValue "0.17" ;
    :yValue "Instagram" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "0.3" ;
    :yValue "Twitter" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "0.33" ;
    :yValue "Facebook" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "0.04" ;
    :yValue "Other" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "0.02" ;
    :yValue "Pinterest" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "0.04" ;
    :yValue "Tumblr" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "0.05" ;
    :yValue "Google+" ;
    :belongsTo :Chart .
