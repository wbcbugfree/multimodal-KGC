@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Monthly unemployment rate in Sweden from July 2019 to November 2020" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Month" .

:YAxis a :Axis ;
    :title "Unemployment rate" .

:DataPoint1 a :DataPoint ;
    :xValue "Jun 30, 2019" ;
    :yValue "0.068" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Jul 31, 2019" ;
    :yValue "0.069" ;
    :belongsTo :Chart .

