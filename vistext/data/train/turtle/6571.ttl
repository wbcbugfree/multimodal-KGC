    :xValue "New Brunswick" ;
    :yValue "0.021" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "Newfoundland and Labrador" ;
    :yValue "0.001" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Northwest Territories" ;
    :yValue "0.018" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Nova Scotia" ;
    :yValue "0.012" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Ontario" ;
    :yValue "0.016" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "Quebec" ;
    :yValue "0.015" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "Saskatchewan" ;
    :yValue "0.018" ;
