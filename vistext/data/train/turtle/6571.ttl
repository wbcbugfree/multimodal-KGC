@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Preliminary share of total votes for each party in the Canadian federal election held on October 21 , 2019 (as of October 22 , 2019) , by province" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "province of Canada" .

:YAxis a :Axis ;
    :title "People's Party" .

:DataPoint1 a :DataPoint ;
    :xValue "Alberta" ;
    :yValue "0.022" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "British Columbia" ;
    :yValue "0.017" ;
    :belongsTo :Chart .

