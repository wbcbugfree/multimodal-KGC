@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Single population in Canada in 2020 , by province" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Province" .

:YAxis a :Axis ;
    :title "Number of people" .

:DataPoint1 a :DataPoint ;
    :xValue "Ontario" ;
    :yValue "6630309" ;
    :belongsTo :Chart .

