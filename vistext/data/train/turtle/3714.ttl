@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Utilization of ride-hailing apps by adults in the United States as of September 2018" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Share of respondents" .

:YAxis a :Axis ;
    :title "Response" .

:DataPoint1 a :DataPoint ;
    :xValue "0.64" ;
    :yValue "When I am on vacation" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "0.64" ;
    :yValue "On a trip less than 30 minutes" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "0.61" ;
    :yValue "When it is late at night" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "0.6" ;
    :yValue "When I am going to the airport" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "0.58" ;
    :yValue "When I am in a large cirty" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "0.57" ;
    :yValue "When I am in a rush" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "0.55" ;
    :yValue "When I am on a business trip" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "0.55" ;
    :yValue "Traveling in or to a rural area" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "0.55" ;
    :yValue "During peak traffic" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "0.5" ;
    :yValue "During inclement weather" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "0.49" ;
    :yValue "When I am at the airport" ;
    :belongsTo :Chart .

:DataPoint12 a :DataPoint ;
    :xValue "0.34" ;
    :yValue "During surge pricing periods" ;
    :belongsTo :Chart .
