@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Revenue of the mechanical engineering industry in India from 2006 to 2015 (in billion U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Revenue in billion U.S. dollars" .

:DataPoint1 a :DataPoint ;
    :xValue "2015**" ;
    :yValue "40.18" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "2014**" ;
    :yValue "37.82" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "2013**" ;
    :yValue "34.27" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "2012**" ;
    :yValue "41.37" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "2011" ;
    :yValue "46.09" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "2010" ;
    :yValue "43.73" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "2009" ;
    :yValue "29.55" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "2008" ;
    :yValue "30.73" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "2007" ;
    :yValue "28.37" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "2006" ;
    :yValue "21.27" ;
    :belongsTo :Chart .
