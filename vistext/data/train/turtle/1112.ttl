@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Number of papers published in the field of artificial intelligence (AI) worldwide from 1997 to 2017 , by country" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

