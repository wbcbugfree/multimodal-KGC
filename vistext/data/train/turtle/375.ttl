@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Value of aquaculture production in China from 2008 to 2017 (in million U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Production value in million U.S. dollars" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2006" ;
    :yValue "46343" ;
    :belongsTo :Chart .

