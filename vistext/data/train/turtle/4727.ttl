    :xValue "54" ;
    :yValue "Pranks" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "43.3" ;
    :yValue "Fitness/sports" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "28.6" ;
    :yValue "Home reno/DIY" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "21.8" ;
    :yValue "Beauty/skincare" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "17.5" ;
    :yValue "Fashion" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "12.9" ;
