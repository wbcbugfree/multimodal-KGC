@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Most popular content categories on TikTok worldwide as of June 2020 , by number of hashtag views (in billions)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Hashtag views in billions" .

:YAxis a :Axis ;
    :title "content category" .

:DataPoint1 a :DataPoint ;
    :xValue "443.3" ;
    :yValue "Entertainment" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "150.3" ;
    :yValue "Dance" ;
    :belongsTo :Chart .

