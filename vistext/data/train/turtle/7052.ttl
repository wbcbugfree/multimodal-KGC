@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Percentage of households in the U.S. from 1990 to 2020 , by type" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "One person households" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 1989" ;
    :yValue "0.292" ;
    :belongsTo :Chart .

