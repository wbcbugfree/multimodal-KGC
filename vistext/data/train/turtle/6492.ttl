@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Is there more crime in the U.S. than there was a year ago , or less ?" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Same" .

