@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Contemporary artworks with the highest auction price worldwide between July 2018 and June 2019 (in million U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Contemporary artworks" .

:YAxis a :Axis ;
    :title "Top hammer price in million U.S. dollars" .

:DataPoint1 a :DataPoint ;
    :xValue "Jeff KoonsRabbit" ;
    :yValue "91.08" ;
    :belongsTo :Chart .

