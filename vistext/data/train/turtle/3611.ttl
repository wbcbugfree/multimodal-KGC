@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Electricity generation by U.S. electric utilities from 1998 to 2015 (in million megawatt hours)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Net generation in million megawatt hours" .

