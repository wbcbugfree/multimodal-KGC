@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Migration flow of Sweden from 2009 to 2019" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Immigration" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2008" ;
    :yValue "102280" ;
    :belongsTo :Chart .

