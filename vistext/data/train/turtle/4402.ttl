@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Number of people self-employed in the United Kingdom in 3rd quarter 2020 , by industry (in 1,000s)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Number of self-employed (in 1,000s)" .

:YAxis a :Axis ;
    :title "industry" .

:DataPoint1 a :DataPoint ;
    :xValue "811" ;
    :yValue "Construction" ;
    :belongsTo :Chart .

