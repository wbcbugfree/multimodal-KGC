@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Amount of freight transported by road in Russia from 2006 to 2019 (in million tonne-kilometres)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Transport volume in million tonne-kilometres" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2005" ;
    :yValue "198766" ;
    :belongsTo :Chart .

