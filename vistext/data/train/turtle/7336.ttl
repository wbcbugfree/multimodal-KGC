@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Distribution of households in the United States from 1970 to 2020 , by household size" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Seven persons or more" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 1969" ;
    :yValue "0.05" ;
    :belongsTo :Chart .

