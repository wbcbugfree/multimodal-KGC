@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Counterfeit euro banknotes withdrawn from circulation globally from the 2nd half of 2014 to the 2nd half of 2019 , by location of counterfeit" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "half a year" .

:YAxis a :Axis ;
    :title "EU member states outside of euro area" .

:DataPoint1 a :DataPoint ;
    :xValue "H2 2019" ;
    :yValue "0.03" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "H1 2019" ;
    :yValue "0.021" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "H2 2018" ;
    :yValue "0.022" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "H1 2018" ;
    :yValue "0.103" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "H2 2017" ;
    :yValue "0.017" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "H1 2017" ;
    :yValue "0.023" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "H2 2016" ;
    :yValue "0.054" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "H1 2016" ;
    :yValue "0.017" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "H2 2015" ;
    :yValue "0.013" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "H1 2015" ;
    :yValue "0.016" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "H2 2014" ;
    :yValue "0.02" ;
    :belongsTo :Chart .
