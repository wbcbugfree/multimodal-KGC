@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Retail price premium of organic milk compared to conventional milk in 2018 , by selected country" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Country" .

:YAxis a :Axis ;
    :title "Price index level*" .

:DataPoint1 a :DataPoint ;
    :xValue "USA" ;
    :yValue "1.53" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Australia" ;
    :yValue "1.44" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "France" ;
    :yValue "1.43" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "New Zealand" ;
    :yValue "1.42" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "Austria" ;
    :yValue "1.41" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Denmark" ;
    :yValue "1.25" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Sweden" ;
    :yValue "1.22" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Germany" ;
    :yValue "1.16" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "United Kingdom" ;
    :yValue "1.12" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "Netherlands" ;
    :yValue "1.09" ;
    :belongsTo :Chart .
