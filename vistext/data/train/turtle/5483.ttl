    :yValue "0.0518" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue ".wang" ;
    :yValue "0.0411" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue ".club" ;
    :yValue "0.0389" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
