@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Leading new generic top level domains (gTLD) as of October 2020 , by market share" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "domain name" .

:YAxis a :Axis ;
    :title "Market share of domains" .

:DataPoint1 a :DataPoint ;
    :xValue ".icu" ;
    :yValue "0.1787" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue ".xyz" ;
    :yValue "0.0983" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue ".top" ;
    :yValue "0.0874" ;
    :belongsTo :Chart .

