@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Capital expenditure of the United States chemical industry from 2004 to 2019 (in million U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Capital expenditure in million U.S. dollars" .

:YAxis a :Axis ;
    :title "Year" .

:DataPoint1 a :DataPoint ;
    :xValue "35100" ;
    :yValue "2019*" ;
    :belongsTo :Chart .

