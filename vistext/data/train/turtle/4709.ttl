@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "If you could only listen to one genre of music for the rest of your life , what would it be ?" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "Share of respondents" .

:DataPoint1 a :DataPoint ;
    :xValue "Pop" ;
    :yValue "0.184" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Country" ;
    :yValue "0.153" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "Other" ;
    :yValue "0.136" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "Rock" ;
    :yValue "0.131" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "Christian" ;
    :yValue "0.09" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Folk / Singer-Songwriter" ;
    :yValue "0.077" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Hip Hop / Rap" ;
    :yValue "0.073" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Blues / R&B" ;
    :yValue "0.046" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "Classical" ;
    :yValue "0.039" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "Easy listening" ;
    :yValue "0.034" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "Jazz" ;
    :yValue "0.024" ;
    :belongsTo :Chart .

:DataPoint12 a :DataPoint ;
    :xValue "Electronic" ;
    :yValue "0.007" ;
    :belongsTo :Chart .

:DataPoint13 a :DataPoint ;
    :xValue "Ska" ;
    :yValue "0.002" ;
    :belongsTo :Chart .

:DataPoint14 a :DataPoint ;
    :xValue "Worldbeat" ;
    :yValue "0.002" ;
    :belongsTo :Chart .

:DataPoint15 a :DataPoint ;
    :xValue "Latin American" ;
    :yValue "0.002" ;
    :belongsTo :Chart .
