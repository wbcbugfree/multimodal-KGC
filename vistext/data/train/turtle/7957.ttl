@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Number of paid subscribers registered to the Match Group from 1st quarter 2016 to 3rd quarter 2020 , by region (in 1,000s)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "North America" .

:YAxis a :Axis ;
    :title "Quarter" .

