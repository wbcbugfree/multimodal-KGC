@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Digital and print advertising revenue of U.S. newspapers from 2003 to 2014 (in billion U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Digital" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2002" ;
    :yValue "1.22" ;
    :belongsTo :Chart .

