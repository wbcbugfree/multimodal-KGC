@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Confirmed cases of Lyme disease in the U.S. from 2007 to 2018" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Number of confirmed cases" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2006" ;
    :yValue "27444" ;
    :belongsTo :Chart .

