@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Gang-related homicides in Canada in 2018 , by region" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Number of victims" .

:YAxis a :Axis ;
    :title "province of Canada" .

:DataPoint1 a :DataPoint ;
    :xValue "51" ;
    :yValue "Ontario" ;
    :belongsTo :Chart .

