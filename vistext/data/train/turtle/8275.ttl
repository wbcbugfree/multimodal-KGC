@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Public concern about the extinction of plant and animal species in the United States from 2000 to 2012" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "Great deal" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 1999" ;
    :yValue "0.45" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Dec 31, 2000" ;
    :yValue "0.43" ;
    :belongsTo :Chart .

