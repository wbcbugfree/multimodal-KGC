@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Number of people displaced due to disasters worldwide in 2019 , by event (in 1,000)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Disaster" .

:YAxis a :Axis ;
    :title "Number of displaced persons in thousands" .

:DataPoint1 a :DataPoint ;
    :xValue "Southwest monsoon (India)" ;
    :yValue "2623" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Severe cyclonic storm Bulbul (India, Bangladesh)" ;
    :yValue "2107" ;
    :belongsTo :Chart .

