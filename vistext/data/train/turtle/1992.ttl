@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "U.S. petroleum imports from OPEC countries from 2000 to 2019 (in 1,000 barrels per day)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Imports in thousand barrels per day" .

