@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Number of slot machines and other mobile gaming devices in casinos in Nevada from 1965 to 2018 (in thousands)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Number of slots in thousands" .

