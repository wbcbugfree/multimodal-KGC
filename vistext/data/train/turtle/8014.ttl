@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Countries with the highest commitment to cyber security based on the Global Cybersecurity Index (GCI) in 2018" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Country" .

:YAxis a :Axis ;
    :title "Legal" .

:DataPoint1 a :DataPoint ;
    :xValue "United Kingdom" ;
    :yValue "0.2" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "United States" ;
    :yValue "0.2" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "France" ;
    :yValue "0.2" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "Lithuania" ;
    :yValue "0.2" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "Estonia" ;
    :yValue "0.2" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Singapore" ;
    :yValue "0.2" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Spain" ;
    :yValue "0.2" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Malaysia" ;
    :yValue "0.18" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "Norway" ;
    :yValue "0.19" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "Canada" ;
    :yValue "0.2" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "Australia" ;
    :yValue "0.2" ;
    :belongsTo :Chart .
