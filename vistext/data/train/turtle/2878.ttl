@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Earthquakes that affected the most people in the United States from 1900 to 2016" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Date, Location" .

:YAxis a :Axis ;
    :title "Number of people affected" .

:DataPoint1 a :DataPoint ;
    :xValue "January 17, 1994 - Los Angeles, California" ;
    :yValue "27000" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "September 3, 2000 - Near Younville, California" ;
    :yValue "25174" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "October 18, 1989 - San Francisco, California" ;
    :yValue "3757" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "October 15, 2006 - Hawaii Islands" ;
    :yValue "3529" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "August 24, 2014 - San Francisco, California" ;
    :yValue "3250" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "September 21, 1993 - Klamath Falls, Oregon" ;
    :yValue "3000" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "October 1, 1987 - Los Angeles-Whittier, California" ;
    :yValue "2200" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "February 20, 2008 - Nevada" ;
    :yValue "2103" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "May 2, 1983 - Coalinga area, California" ;
    :yValue "1545" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "February 9, 1971 - San Fernando, California" ;
    :yValue "1000" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "January 10, 2010 - Arcata, Beyview, Cutten, California" ;
    :yValue "630" ;
    :belongsTo :Chart .
