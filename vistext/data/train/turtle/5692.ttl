@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Number of deaths related to coronavirus (COVID-19) in Spain as of January 5 , 2021 , by autonomous community" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "autonomous community of Spain" .

:YAxis a :Axis ;
    :title "Number of deaths" .

:DataPoint1 a :DataPoint ;
    :xValue "Community of Madrid" ;
    :yValue "11888" ;
    :belongsTo :Chart .

