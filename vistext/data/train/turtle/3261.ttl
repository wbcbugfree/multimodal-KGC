@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Effects of the `` Family 500 plus '' program in Poland in 2019" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Share of respondents" .

:YAxis a :Axis ;
    :title "Response" .

:DataPoint1 a :DataPoint ;
    :xValue "0.41" ;
    :yValue "Children can develop interest in additional activities" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "0.23" ;
    :yValue "We don't lack money for food, bills, clothes" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "0.19" ;
    :yValue "We can save money, which was impossible earlier" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "0.18" ;
    :yValue "We can afford more expensive products-we buy better products" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "0.16" ;
    :yValue "We can afford a holiday, which was impossible eariler" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "0.12" ;
    :yValue "We improved our living conditions (renovation, change of accommodation)" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "0.1" ;
    :yValue "We can afford medicines, private healthcare, rehabilitation" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "0.03" ;
    :yValue "We could pay off a loan earlier" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "0.03" ;
    :yValue "The problems with paying installments ended" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "0.03" ;
    :yValue "We could pay off debts to our family or friends" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "0.02" ;
    :yValue "There was a possibility for parent/s to quit working" ;
    :belongsTo :Chart .

:DataPoint12 a :DataPoint ;
    :xValue "0.03" ;
    :yValue "Other" ;
    :belongsTo :Chart .

:DataPoint13 a :DataPoint ;
    :xValue "0.28" ;
    :yValue "I didn't notice any changes in the functioning of my household" ;
    :belongsTo :Chart .
