@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Hospital occupancy rate in the U.S. from 1975 to 2017" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Hospital occupancy rate" .

:YAxis a :Axis ;
    :title "Year" .

:DataPoint1 a :DataPoint ;
    :xValue "0.659" ;
    :yValue "2017*" ;
    :belongsTo :Chart .

