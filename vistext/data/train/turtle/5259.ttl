@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Largest Salvadoran-American population groups in the United States , by county 2010" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "county of Texas" .

:YAxis a :Axis ;
    :title "Population number" .

:DataPoint1 a :DataPoint ;
    :xValue "Los Angeles County, CA" ;
    :yValue "358825" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Harris County, TX" ;
    :yValue "123049" ;
    :belongsTo :Chart .

