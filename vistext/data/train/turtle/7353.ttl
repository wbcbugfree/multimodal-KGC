@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Advertising spending in Vietnam from 2004 to 2018 , by medium (in million U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Newspapers" .

:DataPoint1 a :DataPoint ;
    :xValue "2018**" ;
    :yValue "52" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "2017**" ;
    :yValue "52" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "2016**" ;
    :yValue "52" ;
    :belongsTo :Chart .

