    :xValue "Dec 31, 2024" ;
    :yValue "105558" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Dec 31, 2025" ;
    :yValue "102694" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Dec 31, 2026" ;
    :yValue "100063" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Dec 31, 2027" ;
    :yValue "97389" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
