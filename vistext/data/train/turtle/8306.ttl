@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Forecast of population growth in Iceland from 2020 to 2030 , by age group" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "20-39 years" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2020" ;
    :yValue "109714" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Dec 31, 2021" ;
    :yValue "110981" ;
    :belongsTo :Chart .

