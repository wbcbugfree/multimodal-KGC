@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Consumption of coal in the United States from 1990 to 2019 , by sector (in trillion British thermal units)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Electric power sector" .

