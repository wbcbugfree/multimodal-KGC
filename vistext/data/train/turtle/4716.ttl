@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Global employee numbers of the United Kingdom (UK) banks as of 2014" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "bank" .

:YAxis a :Axis ;
    :title "Number of employees worldwide" .

:DataPoint1 a :DataPoint ;
    :xValue "Barclays Bank Plc (headquarters: London)" ;
    :yValue "140300" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "The Royal Bank of Scotland Group (hq: Edinburgh)" ;
    :yValue "106100" ;
    :belongsTo :Chart .

