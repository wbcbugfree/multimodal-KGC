@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Consumer Price Index of cereal and its products across urban and rural India from July 2019 to July 2020" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Month" .

:YAxis a :Axis ;
    :title "Urban" .

:DataPoint1 a :DataPoint ;
    :xValue "Jun 30, 2019" ;
    :yValue "141.4" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Jul 31, 2019" ;
    :yValue "142.1" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "Aug 31, 2019" ;
    :yValue "142.7" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "Sep 30, 2019" ;
    :yValue "143.5" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "Oct 31, 2019" ;
    :yValue "144.1" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Nov 30, 2019" ;
    :yValue "144.9" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Dec 31, 2019" ;
    :yValue "145.6" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Jan 31, 2020" ;
    :yValue "146.2" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
