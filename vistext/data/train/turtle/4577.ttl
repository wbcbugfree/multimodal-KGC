    :yValue "VF Corp" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "0.013" ;
    :yValue "Tumi Holdings Inc" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
