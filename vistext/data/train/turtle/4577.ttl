@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Market share of the global luggage market in 2015 , by company" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Market share" .

:YAxis a :Axis ;
    :title "Company" .

:DataPoint1 a :DataPoint ;
    :xValue "0.173" ;
    :yValue "Samsonite International SA" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "0.05" ;
    :yValue "LVMH Moët Hennessy Louis Vuitton SA" ;
    :belongsTo :Chart .

