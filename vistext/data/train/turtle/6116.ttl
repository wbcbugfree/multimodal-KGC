@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Number of refugees worldwide from 2001 to 2019 , by type (in millions)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Internally displaced persons*" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2000" ;
    :yValue "25" ;
    :belongsTo :Chart .

