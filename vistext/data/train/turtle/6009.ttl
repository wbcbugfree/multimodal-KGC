@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Exports of beef and veal from Brazil in 2019 , by destination (in million U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Exports in thousand U.S. dollars" .

:YAxis a :Axis ;
    :title "Country" .

