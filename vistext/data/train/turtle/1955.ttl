@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Number of coronavirus (COVID-19) deaths in Sweden in 2020 , by age groups (as of December 16 , 2020)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Number of cases" .

:YAxis a :Axis ;
    :title "Year" .

:DataPoint1 a :DataPoint ;
    :xValue "4" ;
    :yValue "9 years and younger" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "1" ;
    :yValue "10-19 years" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "10" ;
    :yValue "20-29 years" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "22" ;
    :yValue "30-39 years" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "58" ;
    :yValue "40-49 years" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "185" ;
    :yValue "50-59 years" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "494" ;
    :yValue "60-69 years" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "1654" ;
    :yValue "70-79 years" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "3315" ;
    :yValue "80-90 years" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "2150" ;
    :yValue "90 years and older" ;
    :belongsTo :Chart .
