@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Length of paved roads in Singapore from 2009 to 2019 (in lane-kilometers)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Length of paved roads in lane-kilometers" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2008" ;
    :yValue "8848" ;
    :belongsTo :Chart .

