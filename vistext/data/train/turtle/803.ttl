@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "CVS Health 's total assets from 2005 to 2019 (in million U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Total assets in million U.S. dollars" .

