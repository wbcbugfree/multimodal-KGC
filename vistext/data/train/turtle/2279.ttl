@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Total arable land in Malaysia in from 2005 to 2016 (in 1,000 hectares)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Total arable land in thousand hectares" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2004" ;
    :yValue "949.4" ;
    :belongsTo :Chart .

