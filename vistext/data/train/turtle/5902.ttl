@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Leading pets ranked by estimated population size in the United Kingdom (UK) in 2018/19 (in millions)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Population size in millions" .

:YAxis a :Axis ;
    :title "organisms known by a particular common name" .

:DataPoint1 a :DataPoint ;
    :xValue "9" ;
    :yValue "Dogs" ;
    :belongsTo :Chart .

