@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Number of armed conflicts worldwide from 2006 to 2016 , by conflict type" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Territory" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2005" ;
    :yValue "16" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Dec 31, 2006" ;
    :yValue "19" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "Dec 31, 2007" ;
    :yValue "21" ;
    :belongsTo :Chart .

