@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Number of ships in the world 's leading container ship operators ' order books as of October 12 , 2020" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Number of orderbook ships" .

:YAxis a :Axis ;
    :title "Container ship operator" .

:DataPoint1 a :DataPoint ;
    :xValue "66" ;
    :yValue "Evergreen Line" ;
    :belongsTo :Chart .

