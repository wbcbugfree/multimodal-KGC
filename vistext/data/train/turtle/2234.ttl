    :xValue "Dec 31, 2010" ;
    :yValue "2.33" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Dec 31, 2011" ;
    :yValue "2.58" ;
    :belongsTo :Chart .

