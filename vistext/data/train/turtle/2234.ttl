@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Number of financial institutions robbed per 100 institutions in Brazil from 2007 to 2018" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Number of robberies per 100 institutions" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2006" ;
    :yValue "1.1" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Dec 31, 2007" ;
    :yValue "1.55" ;
    :belongsTo :Chart .

