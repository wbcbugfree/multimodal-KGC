@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Internet penetration rate in India from 2007 to 2020" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Internet penetration rate" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2006" ;
    :yValue "0.04" ;
    :belongsTo :Chart .

