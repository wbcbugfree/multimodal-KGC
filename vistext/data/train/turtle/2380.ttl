@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Net written marine , aviation and transport (MAT) premiums of the general business insurance market in the United Kingdom (UK) from 2007 to 2018 (in million GBP)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Amount in million GBP" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2006" ;
    :yValue "639" ;
    :belongsTo :Chart .

