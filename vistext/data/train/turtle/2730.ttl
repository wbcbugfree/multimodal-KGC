@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Number of robberies in Canada in 2019 , by province or territory" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Number of robberies" .

:YAxis a :Axis ;
    :title "province of Canada" .

:DataPoint1 a :DataPoint ;
    :xValue "8936" ;
    :yValue "Ontario" ;
    :belongsTo :Chart .

