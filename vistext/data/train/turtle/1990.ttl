@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Percentage of working age population (15 - 64 years of age) in Italy from 2009 to 2020" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "Share of working age population" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2008" ;
    :yValue "0.658" ;
    :belongsTo :Chart .

