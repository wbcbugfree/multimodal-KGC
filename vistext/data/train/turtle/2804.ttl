@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Expenditure on innovation in the car industry in Germany from 2008 to 2020 (in billion euros)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Expenditure on innovation in billion euros" .

:DataPoint1 a :DataPoint ;
    :xValue "2020*" ;
    :yValue "53.81" ;
    :belongsTo :Chart .

