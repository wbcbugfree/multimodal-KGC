@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Arizona Diamondbacks average ticket price from 2006 to 2019 (in U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Average ticket price in U.S. dollars" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2005" ;
    :yValue "19.68" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Dec 31, 2006" ;
    :yValue "13.79" ;
    :belongsTo :Chart .

