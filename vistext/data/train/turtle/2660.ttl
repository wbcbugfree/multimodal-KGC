@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Cities with the highest operating spending per resident on parks and recreation in the United States in 2016 (in U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "city of the United States" .

:YAxis a :Axis ;
    :title "Operating spending per resident U.S. dollars" .

:DataPoint1 a :DataPoint ;
    :xValue "Irvine" ;
    :yValue "215" ;
