@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Consumption rate of alcoholic beverages in Italy between 2010 and 2019 , by frequency" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "1/2 glass per day" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2009" ;
    :yValue "0.209" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Dec 31, 2010" ;
    :yValue "0.206" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "Dec 31, 2011" ;
    :yValue "0.19" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "Dec 31, 2012" ;
    :yValue "0.181" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "Dec 31, 2013" ;
    :yValue "0.173" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Dec 31, 2014" ;
    :yValue "0.177" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Dec 31, 2015" ;
    :yValue "0.17" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Dec 31, 2016" ;
    :yValue "0.168" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "Dec 31, 2017" ;
    :yValue "0.162" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "Dec 31, 2018" ;
    :yValue "0.156" ;
    :belongsTo :Chart .
