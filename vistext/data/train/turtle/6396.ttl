@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Number of U.S. high schools with athletics programs for girls from 2009/10 to 2018/19 , by sport" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Basketball" .

:DataPoint1 a :DataPoint ;
