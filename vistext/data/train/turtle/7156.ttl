    :xValue "France" ;
    :yValue "0.03" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Germany" ;
    :yValue "0.05" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Italy" ;
    :yValue "0.02" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Japan" ;
    :yValue "0.04" ;
    :belongsTo :Chart .

