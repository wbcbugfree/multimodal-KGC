    :belongsTo :Chart .

:DataPoint13 a :DataPoint ;
    :xValue "United Kingdom" ;
    :yValue "0.04" ;
    :belongsTo :Chart .

:DataPoint14 a :DataPoint ;
    :xValue "United States" ;
    :yValue "0.04" ;
    :belongsTo :Chart .
