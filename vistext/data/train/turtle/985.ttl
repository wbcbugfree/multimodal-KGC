@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Forecast volume of milk produced in the European Union (EU 27) from 2015 to 2028 (in thousand metric tons)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Volume in million metric tons" .

:DataPoint1 a :DataPoint ;
    :xValue "2028*" ;
    :yValue "159384" ;
    :belongsTo :Chart .

