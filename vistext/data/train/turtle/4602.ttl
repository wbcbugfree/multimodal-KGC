    :xValue "2020*" ;
    :yValue "270.63" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "2019*" ;
    :yValue "273.8" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "2018*" ;
    :yValue "280.14" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "2017" ;
