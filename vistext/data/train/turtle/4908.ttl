@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Number of employees of Allianz Group from 2005 to 2019 (in 1,000s)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Number of employees in thousands" .

