@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Highest car crime rate cities in Great Britain (UK) in 2011 and 2012 (in offences per 10,000 registered vehicles)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Offences per 10,000 registered vehicles" .

:YAxis a :Axis ;
    :title "city" .

:DataPoint1 a :DataPoint ;
    :xValue "505" ;
    :yValue "Manchester" ;
    :belongsTo :Chart .

