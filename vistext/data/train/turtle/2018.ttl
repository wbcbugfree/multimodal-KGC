@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Volume of broiler meat produced in Canada from 1990 to 2018 (in thousand metric tons)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Volume in thousand metric tons" .

:YAxis a :Axis ;
    :title "Year" .

:DataPoint1 a :DataPoint ;
    :xValue "1240" ;
    :yValue "2018***" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "1200" ;
    :yValue "2017**" ;
    :belongsTo :Chart .

