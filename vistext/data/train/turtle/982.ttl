@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Which , if any , of the following makes you most happy ? (Please select up to three)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "Share of respondents" .

:DataPoint1 a :DataPoint ;
    :xValue "Spending time with friends" ;
    :yValue "0.59" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Spending time with family" ;
    :yValue "0.57" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "Doing well at school or university" ;
    :yValue "0.47" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "Having hobbies that I enjoy" ;
    :yValue "0.28" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "Being able to support myself" ;
    :yValue "0.19" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Enjoying my job" ;
    :yValue "0.19" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Having enough money to buy new things" ;
    :yValue "0.18" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Living a healthy, active life" ;
    :yValue "0.18" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "Doing work to help people (e.g. volunteering)" ;
    :yValue "0.11" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "Shopping" ;
    :yValue "0.04" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "Other" ;
    :yValue "0.04" ;
    :belongsTo :Chart .
