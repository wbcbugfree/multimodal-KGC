@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Attendance at most popular Iberoamerican movie productions in selected Latin American countries in 2018 (in 1,000s)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Number of viewers in thousands" .

:YAxis a :Axis ;
    :title "Country: Movie title" .

