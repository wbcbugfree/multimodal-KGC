@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Boston Red Sox all-time RBI (runs batted in) leaders as of October 2020" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Number of home runs" .

:YAxis a :Axis ;
    :title "Boston Red Sox all-time RBI leaders" .

:DataPoint1 a :DataPoint ;
    :xValue "1844" ;
    :yValue "Carl Yastrzemski" ;
    :belongsTo :Chart .

