@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "12-month average number of U.S. low-cost airline full-time equivalent employees from 2007 to 2019 (in 1,000s)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Full-time employees in thousands" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2006" ;
    :yValue "71.4" ;
    :belongsTo :Chart .

