@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Distribution of total cargo handled across India in financial year 2019 , by major port" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Share of total cargo handled" .

:YAxis a :Axis ;
    :title "Response" .

:DataPoint1 a :DataPoint ;
    :xValue "0.1651" ;
    :yValue "Deendayal" ;
    :belongsTo :Chart .

