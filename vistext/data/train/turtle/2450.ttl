@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Gross domestic product (GDP) growth rate in Finland from 2005 to 2019 (compared to the previous year)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "GDP growth rate" .

:YAxis a :Axis ;
    :title "Year" .

:DataPoint1 a :DataPoint ;
    :xValue "0.011" ;
    :yValue "2019*" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "0.015" ;
    :yValue "2018*" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "0.033" ;
    :yValue "2017*" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "0.028" ;
    :yValue "2016" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "0.005" ;
    :yValue "2015" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "-0.004" ;
    :yValue "2014" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "-0.009" ;
    :yValue "2013" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "-0.014" ;
    :yValue "2012" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "0.025" ;
    :yValue "2011" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "0.032" ;
    :yValue "2010" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "-0.081" ;
    :yValue "2009" ;
    :belongsTo :Chart .

:DataPoint12 a :DataPoint ;
    :xValue "0.008" ;
    :yValue "2008" ;
    :belongsTo :Chart .

:DataPoint13 a :DataPoint ;
    :xValue "0.053" ;
    :yValue "2007" ;
    :belongsTo :Chart .

:DataPoint14 a :DataPoint ;
    :xValue "0.04" ;
    :yValue "2006" ;
    :belongsTo :Chart .

:DataPoint15 a :DataPoint ;
    :xValue "0.028" ;
    :yValue "2005" ;
    :belongsTo :Chart .
