@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Percentage composition of government tax revenue in the United States from 2010 to 2025" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "year" .

:YAxis a :Axis ;
    :title "Social insurance and retirement receipts" .

:DataPoint1 a :DataPoint ;
    :xValue "'25*" ;
    :yValue "0.343" ;
    :belongsTo :Chart .

