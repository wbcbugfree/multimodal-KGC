@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Reasons for listening to AM/FM radio in the U.S. and Canada as of 2016" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "Share of respondents" .

:DataPoint1 a :DataPoint ;
    :xValue "I want to hear my favorite songs/artists" ;
    :yValue "0.641" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "I like particular DJs, shows, or hosts" ;
    :yValue "0.578" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "I like to work with the radio on" ;
    :yValue "0.549" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "I'm just in the habit of listening" ;
    :yValue "0.505" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "I want to be informed about what's going on in the news" ;
    :yValue "0.41" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "I want to get in a better mood" ;
    :yValue "0.399" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "I want to know what's going on here in town" ;
    :yValue "0.363" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "I want to be informed if there's an emergency of some kind" ;
    :yValue "0.331" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "I want to escape from the pressures of everyday life" ;
    :yValue "0.329" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "I want to discover new music/new artists" ;
    :yValue "0.328" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "I enjoy listening to talk shows" ;
    :yValue "0.322" ;
    :belongsTo :Chart .

:DataPoint12 a :DataPoint ;
    :xValue "Weather information" ;
    :yValue "0.285" ;
    :belongsTo :Chart .

:DataPoint13 a :DataPoint ;
    :xValue "I like being surprised by the music that's coming up next" ;
    :yValue "0.28" ;
    :belongsTo :Chart .

:DataPoint14 a :DataPoint ;
    :xValue "Traffic information" ;
    :yValue "0.246" ;
    :belongsTo :Chart .

:DataPoint15 a :DataPoint ;
    :xValue "I like it when stations get involved with charitable and community events" ;
    :yValue "0.195" ;
    :belongsTo :Chart .

:DataPoint16 a :DataPoint ;
    :xValue "I'm interested in sports programming" ;
    :yValue "0.178" ;
    :belongsTo :Chart .

:DataPoint17 a :DataPoint ;
    :xValue "I want to win a prize" ;
    :yValue "0.13" ;
    :belongsTo :Chart .
