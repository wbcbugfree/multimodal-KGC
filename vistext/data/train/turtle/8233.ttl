@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "U.S. e-commerce value of drugs and druggists ' sundries wholesale trade from 2006 to 2018 (in million U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "E-commerce" .

