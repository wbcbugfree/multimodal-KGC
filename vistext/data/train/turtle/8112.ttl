@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Canada : Age distribution from 2009 to 2019" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "0-14 years" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2008" ;
    :yValue "0.1668" ;
    :belongsTo :Chart .

