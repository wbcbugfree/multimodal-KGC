@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Leading coffee importing countries worldwide in 2018 (in million U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Country" .

:YAxis a :Axis ;
    :title "Trade value in million U.S. dollars" .

:DataPoint1 a :DataPoint ;
    :xValue "United States" ;
    :yValue "5719.42" ;
    :belongsTo :Chart .

