@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Refinery and blender net production of naphtha for petrochemical feedstock use in the United States from 1995 to 2019 (in 1,000 barrels per day)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Production in thousand barrels per day" .

