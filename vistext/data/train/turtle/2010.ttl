    :xValue "122463" ;
    :yValue "Patriots for Trump" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "76300" ;
    :yValue "Our Voice Matters" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "58000" ;
    :yValue "Future In America" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
