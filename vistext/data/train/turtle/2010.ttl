@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Top ten PACs advocating for Donald Trump 's 2016 U.S. presidential campaign as of August , 2016 (in U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Amount spent in U.S. dollars" .

:YAxis a :Axis ;
    :title "political action committee" .

:DataPoint1 a :DataPoint ;
    :xValue "7832971" ;
    :yValue "Great America PAC" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "2750641" ;
    :yValue "Rebuilding America Now" ;
    :belongsTo :Chart .

