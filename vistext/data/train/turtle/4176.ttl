@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Selected shipping accidents worldwide from 2000 to 2014 , sorted by number of fatalities" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Number of victims" .

:YAxis a :Axis ;
    :title "Shipping accident" .

:DataPoint1 a :DataPoint ;
    :xValue "2967" ;
    :yValue "Spice Islander I (Sep 2011)" ;
