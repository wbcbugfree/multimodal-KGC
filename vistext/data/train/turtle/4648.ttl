@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Revenue generated by Becton , Dickinson , and Company from 2011 to 2020 (in billion U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Annual revenue in billion U.S. dollars" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2010" ;
    :yValue "7.58" ;
    :belongsTo :Chart .

