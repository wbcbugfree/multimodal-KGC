@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Distribution of JAKKS Pacific net sales to major customers from 2008 to 2019" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Other" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2007" ;
    :yValue "0.435" ;
    :belongsTo :Chart .

