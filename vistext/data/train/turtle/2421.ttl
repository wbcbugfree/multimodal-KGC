@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Ranking of the best business schools in the United States in 2015 , showing return on investment" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "business schools" .

:YAxis a :Axis ;
    :title "Total 5-year MBA gain in U.S. dollars" .

