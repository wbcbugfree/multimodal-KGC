@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Voter turnout rates among selected age groups in U.S. presidential elections from 1964 to 2016" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "45-64" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 1963" ;
    :yValue "0.759" ;
    :belongsTo :Chart .

