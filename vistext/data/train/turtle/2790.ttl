@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Number of population in group quarters in the United States from 2000 to 2019 (in millions)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Population in millions" .

