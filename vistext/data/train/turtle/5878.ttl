@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Household electricity consumption per capita in Vietnam from 2000 to 2016 (in kilowatt hours)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Consumption in kilowatt hours per capita" .

