@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Population of Iceland from 2010 to 2020 , by age group" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "20-39 years" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2009" ;
    :yValue "91262" ;
    :belongsTo :Chart .

