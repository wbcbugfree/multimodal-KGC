@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Major countries of destination for U.S. honey exports in 2018 (in metric tons)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Country" .

:YAxis a :Axis ;
    :title "Exports in metric tons" .

:DataPoint1 a :DataPoint ;
    :xValue "Phillippines" ;
    :yValue "812" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Canada" ;
    :yValue "739" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "Japan" ;
    :yValue "538" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "Vietnam" ;
    :yValue "511" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "South Korea" ;
    :yValue "507" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "United Arab Emiratrs" ;
    :yValue "157" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Kuwait" ;
    :yValue "150" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "China" ;
    :yValue "120" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "Australia*" ;
    :yValue "102" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "The Bahamas" ;
    :yValue "90" ;
    :belongsTo :Chart .
