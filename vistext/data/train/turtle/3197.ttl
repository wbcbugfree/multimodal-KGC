@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Number of enterprises in the manufacture of cocoa , chocolate and sugar confectionery industry in Romania from 2008 to 2017" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Number of enterprises" .

:DataPoint1 a :DataPoint ;
    :xValue "2017" ;
    :yValue "218" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "2016" ;
    :yValue "201" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "2015" ;
    :yValue "200" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "2014" ;
    :yValue "220" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "2013" ;
    :yValue "216" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "2012" ;
    :yValue "219" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "2011" ;
    :yValue "220" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "2010" ;
    :yValue "243" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "2009*" ;
    :yValue "259" ;
