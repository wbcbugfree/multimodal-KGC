@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Broadcast TV advertising revenue in the United States from 2004 to 2013 , by type (in billion US dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Syndication" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2003" ;
    :yValue "3.93" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Dec 31, 2004" ;
    :yValue "4.22" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "Dec 31, 2005" ;
    :yValue "4.23" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "Dec 31, 2006" ;
    :yValue "4.17" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "Dec 31, 2007" ;
    :yValue "4.44" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Dec 31, 2008" ;
    :yValue "4.23" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Dec 31, 2009" ;
    :yValue "4.11" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Dec 31, 2010" ;
    :yValue "4.75" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "Dec 31, 2011" ;
    :yValue "5.13" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "Dec 31, 2012" ;
    :yValue "5.16" ;
    :belongsTo :Chart .
