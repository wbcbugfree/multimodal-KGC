@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Share of parents who have paid or would pay for tutoring for their child in selected countries in 2015" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Country" .

:YAxis a :Axis ;
    :title "Have not paid, but would consider paying" .

:DataPoint1 a :DataPoint ;
    :xValue "China" ;
    :yValue "0.19" ;
    :belongsTo :Chart .

