@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Impact of the Influenza Pandemic of 1918 on hourly wages in select industries in the United States from 1900 to 1928 (in U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Planing mills" .

