@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Most centuries scored in One Day International cricket as of September 2020 , by player" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "player name" .

:YAxis a :Axis ;
    :title "Number of centuries scored" .

:DataPoint1 a :DataPoint ;
    :xValue "SR Tendulkar (INDIA)" ;
    :yValue "49" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "V Kohli (INDIA)" ;
    :yValue "43" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "RT Ponting (AUS/ICC)" ;
    :yValue "30" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "RG Sharma (INDIA)" ;
    :yValue "29" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "ST Jayasuriya (Asia/SL)" ;
    :yValue "28" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "HM Amla (SA)" ;
    :yValue "27" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "AB de Villiers (Afr/SA)" ;
    :yValue "25" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "CH Gayle (ICC/WI)" ;
    :yValue "25" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "KC Sangakkara (Asia/ICC/SL)" ;
    :yValue "25" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "SC Ganguly (Asia/INDIA)" ;
    :yValue "22" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "TM Dilshan (SL)" ;
    :yValue "22" ;
    :belongsTo :Chart .
