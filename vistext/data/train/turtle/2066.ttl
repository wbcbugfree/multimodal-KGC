@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Value of agricultural chemical shipments in the United States from 2004 to 2019 (in million U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Value in million U.S. dollars" .

