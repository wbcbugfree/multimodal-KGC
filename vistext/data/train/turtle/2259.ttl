@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Mozambique : Total population from 2015 to 2025 (in million inhabitants)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Inhabitants in millions" .

:YAxis a :Axis ;
    :title "Year" .

:DataPoint1 a :DataPoint ;
    :xValue "36.46" ;
    :yValue "2025*" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "35.53" ;
    :yValue "2024*" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "34.62" ;
    :yValue "2023*" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "33.72" ;
    :yValue "2022*" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "32.85" ;
    :yValue "2021*" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "31.99" ;
    :yValue "2020*" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "31.16" ;
    :yValue "2019*" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "30.34" ;
    :yValue "2018*" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "29.54" ;
    :yValue "2017*" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "28.75" ;
    :yValue "2016*" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "27.98" ;
    :yValue "2015" ;
    :belongsTo :Chart .
