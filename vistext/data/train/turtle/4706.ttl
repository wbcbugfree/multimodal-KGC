@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Individuals with the most Academy Award nominations without a win as of 2020" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "artist" .

:YAxis a :Axis ;
    :title "Number of Academy Awards nominations" .

