    :belongsTo :Chart .

:DataPoint12 a :DataPoint ;
    :xValue "1089" ;
    :yValue "Diseases of the musculoskeletal system and connective tissue" ;
    :belongsTo :Chart .

:DataPoint13 a :DataPoint ;
    :xValue "564" ;
    :yValue "Blood/bloodforming organs and immune mechanism diseases" ;
    :belongsTo :Chart .

:DataPoint14 a :DataPoint ;
    :xValue "503" ;
    :yValue "Congenital anomalies" ;
    :belongsTo :Chart .

:DataPoint15 a :DataPoint ;
