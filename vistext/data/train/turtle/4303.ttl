@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Causes of death in the Netherlands in 2019" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Number of deaths" .

:YAxis a :Axis ;
    :title "Cause of death" .

:DataPoint1 a :DataPoint ;
    :xValue "46864" ;
    :yValue "Neoplasms" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "37433" ;
    :yValue "Diseases of the circulatory system" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "12607" ;
    :yValue "Diseases of the respiratory system" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "12725" ;
    :yValue "Mental and behavioural disorders" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "8775" ;
    :yValue "Diseases of the nervous system" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "8671" ;
    :yValue "External causes of injury and poisoning" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "7126" ;
    :yValue "Symptoms, signs and ill-defined conditions" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "4681" ;
    :yValue "Diseases of the digestive system" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
