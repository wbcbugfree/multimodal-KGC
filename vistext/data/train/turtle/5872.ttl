@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Health expenditure as a share of gross domestic product in Singapore 2007 to 2017" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Health expenditure as a share of GDP" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2006" ;
    :yValue "0.0285" ;
    :belongsTo :Chart .

