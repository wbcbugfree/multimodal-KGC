@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Number of airplanes in aviation companies in Germany from 2007 to 2019 , by take-off weight" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "5.7 to 14 tons" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2006" ;
    :yValue "200" ;
    :belongsTo :Chart .

