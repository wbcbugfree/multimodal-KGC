@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Revenue of the Walt Disney Company from 2010 to 2020 , by region (in million U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Americas*" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2009" ;
    :yValue "0" ;
    :belongsTo :Chart .

