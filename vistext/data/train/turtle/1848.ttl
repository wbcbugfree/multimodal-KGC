@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Annual number of doctors licensed to practice in Czechia from 2000 to 2013 (per 1,000 people)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Number of doctors per 1,000 people" .

:YAxis a :Axis ;
    :title "Year" .

:DataPoint1 a :DataPoint ;
    :xValue "3.69" ;
    :yValue "2013" ;
    :belongsTo :Chart .

