@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Number of domestic enplanements of U.S. commercial air carriers from 2006 to 2020 (in millions)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Fiscal year" .

:YAxis a :Axis ;
    :title "Regional air carriers" .

:DataPoint1 a :DataPoint ;
    :xValue "2020*" ;
    :yValue "168" ;
    :belongsTo :Chart .

