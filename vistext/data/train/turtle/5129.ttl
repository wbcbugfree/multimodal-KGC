@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Annual solar module production globally from 2000 to 2018 (in megawatts)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Production in megawatts" .

