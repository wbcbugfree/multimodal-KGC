@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Food and beverage TV ad compliance with marketing and advertising to children policy in selected countries worldwide in 2015" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Share of compliant ads" .

:YAxis a :Axis ;
    :title "Response" .

:DataPoint1 a :DataPoint ;
    :xValue "0.901" ;
    :yValue "Colombia" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "0.912" ;
    :yValue "Malaysia" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "0.938" ;
    :yValue "Thailand" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "0.958" ;
    :yValue "Indonesia" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "0.958" ;
    :yValue "South Africa" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "0.97" ;
    :yValue "Brazil" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "0.97" ;
    :yValue "Total" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "0.981" ;
    :yValue "Russia" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "0.997" ;
    :yValue "China (Shanghai)" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "0.998" ;
    :yValue "Saudi Arabia" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "0.999" ;
    :yValue "UAE" ;
