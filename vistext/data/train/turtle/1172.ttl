@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Dependency rate on energy imports in the European Union (EU-28) from 2009 to 2018" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Energy imports dependency rate" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2007" ;
    :yValue "0.5465" ;
    :belongsTo :Chart .

