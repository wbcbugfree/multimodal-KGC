@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Retail value of bakery products market forecast in the European Union (EU) in 2015 and 2019 , by country (in million US dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "2015" .

:YAxis a :Axis ;
    :title "Country" .

:DataPoint1 a :DataPoint ;
    :xValue "23718" ;
    :yValue "France" ;
    :belongsTo :Chart .

