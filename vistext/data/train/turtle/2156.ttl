@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Distribution of foreign direct investment (FDI) projects in Scotland from 2016 , by sector" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Share of FDI projects" .

:YAxis a :Axis ;
    :title "Response" .

:DataPoint1 a :DataPoint ;
    :xValue "0.14" ;
    :yValue "Business services" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "0.11" ;
    :yValue "Construction" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "0.11" ;
    :yValue "Software" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "0.09" ;
    :yValue "Machinery and Equipment" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "0.06" ;
    :yValue "Scientific research" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "0.05" ;
    :yValue "Food" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "0.04" ;
    :yValue "Pharmaceuticals" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "0.04" ;
    :yValue "Retail" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "0.04" ;
    :yValue "Utility sector" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "0.32" ;
    :yValue "Other" ;
    :belongsTo :Chart .
