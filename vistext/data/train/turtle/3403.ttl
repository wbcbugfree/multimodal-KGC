@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Pajamas and other nightwear exported by the United States to the rest of the world from 2005 to 2018 (in million U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Export value in million U.S. dollars" .

