@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Number of chickens worldwide in 2018 , by country (in million animals)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Number of chickens in millions" .

:YAxis a :Axis ;
    :title "Country" .

:DataPoint1 a :DataPoint ;
    :xValue "5274.48" ;
    :yValue "China, mainland" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "2384.15" ;
    :yValue "Indonesia" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "1973.38" ;
    :yValue "United States of America" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "1468.35" ;
    :yValue "Brazil" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "1071.61" ;
    :yValue "Iran (Islamic Republic of)" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "801.09" ;
    :yValue "India" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "568.37" ;
    :yValue "Mexico" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "524.14" ;
    :yValue "Pakistan" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "507.05" ;
    :yValue "Russia" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "353.56" ;
    :yValue "Turkey" ;
    :belongsTo :Chart .
