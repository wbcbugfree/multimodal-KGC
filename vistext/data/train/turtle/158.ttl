@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Average annual snowfall in Canada from1971 to 2000 , by city (in centimeters)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "city of Canada" .

:YAxis a :Axis ;
    :title "Snowfall (in centimeters)" .

