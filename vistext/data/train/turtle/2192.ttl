@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Comparable sales growth of Walmart U.S. in the United States from fiscal year 2006 to 2020" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Comparable sales growth" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2005" ;
    :yValue "0.03" ;
    :belongsTo :Chart .

