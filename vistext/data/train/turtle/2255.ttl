@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Number of enterprises in the manufacture of glass and glass products industry in Sweden from 2008 to 2017" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Number of enterprises" .

:YAxis a :Axis ;
    :title "Year" .

:DataPoint1 a :DataPoint ;
    :xValue "321" ;
    :yValue "2017*" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "329" ;
    :yValue "2016" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "335" ;
    :yValue "2015" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "336" ;
    :yValue "2014" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "344" ;
    :yValue "2013" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "373" ;
    :yValue "2012" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "381" ;
    :yValue "2011" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "373" ;
    :yValue "2010" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
