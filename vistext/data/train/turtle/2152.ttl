@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Number of Thanksgiving holiday travelers in the United States from 2005 to 2020 (in millions)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Number of travelers in millions" .

