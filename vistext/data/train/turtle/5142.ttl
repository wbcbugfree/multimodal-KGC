@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Leading iPhone apps in the Apple App Store worldwide in September 2020 , by revenue (in million U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Revenue in million U.S. dollars" .

:YAxis a :Axis ;
    :title "name of the app" .

:DataPoint1 a :DataPoint ;
    :xValue "33.86" ;
    :yValue "Tinder" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "28.92" ;
    :yValue "Monster Strike" ;
    :belongsTo :Chart .

