    :xValue "19.22" ;
    :yValue "Dragon Quest Walk" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "19.13" ;
    :yValue "Jedi Survival (PUBG)" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "17.02" ;
