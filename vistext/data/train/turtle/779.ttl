@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Volume of wine (excluding juice and musts) produced in Romania from 2010 to 2020 (in million hectoliters)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Volume in million hectoliters" .

:DataPoint1 a :DataPoint ;
    :xValue "2020*" ;
    :yValue "3.6" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "2019" ;
    :yValue "4.9" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "2018" ;
    :yValue "5.1" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "2017" ;
    :yValue "4.3" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "2016" ;
    :yValue "3.3" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "2015" ;
    :yValue "3.6" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "2014" ;
    :yValue "3.7" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "2013" ;
    :yValue "5.1" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "2012" ;
    :yValue "3.3" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "2011" ;
    :yValue "4.1" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "2010" ;
    :yValue "3.3" ;
    :belongsTo :Chart .
