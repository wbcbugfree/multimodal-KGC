@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Most popular mobile music and video apps in the United States as of September 2019 , by monthly users (in millions)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Monthly users in millions" .

:YAxis a :Axis ;
    :title "App" .

:DataPoint1 a :DataPoint ;
    :xValue "163.76" ;
    :yValue "YouTube (main)" ;
    :belongsTo :Chart .

