@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Number of passengers uplifted by British Airways plc from 2008 to 2019 (in millions)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Number of passengers uplifted in millions" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2007" ;
    :yValue "31.62" ;
    :belongsTo :Chart .

