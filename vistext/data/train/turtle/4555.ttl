@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Share of female police officers for selected countries in 2012" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "Percentage of total police officers" .

:DataPoint1 a :DataPoint ;
    :xValue "Sweden" ;
    :yValue "0.29" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "United Kingdom **" ;
    :yValue "0.27" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "Ireland" ;
    :yValue "0.25" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "Norway" ;
    :yValue "0.24" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "Netherlands" ;
    :yValue "0.22" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Canada" ;
    :yValue "0.2" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Germany" ;
    :yValue "0.19" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Finland" ;
    :yValue "0.15" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "Austria" ;
    :yValue "0.13" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "Denmark" ;
    :yValue "0.13" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "United States" ;
    :yValue "0.12" ;
    :belongsTo :Chart .

:DataPoint12 a :DataPoint ;
    :xValue "Japan" ;
    :yValue "0.07" ;
    :belongsTo :Chart .
