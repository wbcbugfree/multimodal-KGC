@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Per capita consumption of chewing gum in selected countries worldwide from 2009 to 2012" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Country" .

:YAxis a :Axis ;
    :title "Index value" .

:DataPoint1 a :DataPoint ;
    :xValue "United States" ;
    :yValue "152" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Austria" ;
    :yValue "114" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "Belgium" ;
    :yValue "112" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "Germany" ;
    :yValue "100" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "France" ;
    :yValue "96" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Great Britain" ;
    :yValue "89" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Spain" ;
    :yValue "85" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Russia" ;
    :yValue "84" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "Poland" ;
    :yValue "70" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "China" ;
    :yValue "31" ;
