@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Brand value of the leading 10 most valuable Portuguese brands from 2015 to 2019 (in million U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "2017" .

:YAxis a :Axis ;
    :title "Brand" .

:DataPoint1 a :DataPoint ;
    :xValue "2683" ;
    :yValue "EDP" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "1595" ;
    :yValue "Galp Energia" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "754" ;
    :yValue "Pingo Doce" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "600" ;
    :yValue "Caixa Geral de Depositos" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "347" ;
    :yValue "Continente" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "321" ;
    :yValue "Millennium bcp" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "387" ;
    :yValue "Nos" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "406" ;
    :yValue "Meo" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "419" ;
    :yValue "TAP" ;
    :belongsTo :Chart .
