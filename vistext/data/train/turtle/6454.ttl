@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Distribution of gross domestic product (GDP) across economic sectors in the United States from 2000 to 2017" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Agriculture" .

