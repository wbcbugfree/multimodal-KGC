@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Most popular Pinterest categories in the United States as of February 2017" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Share of respondents" .

:YAxis a :Axis ;
    :title "Response" .

:DataPoint1 a :DataPoint ;
    :xValue "0.48" ;
    :yValue "Art, Art Supplies & Hobbies" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "0.47" ;
    :yValue "Flowers, Food, Drinks & Gifts" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "0.45" ;
    :yValue "Home, Garden & Pool/Spa" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "0.45" ;
    :yValue "Health & Beauty" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "0.37" ;
    :yValue "Clothing & Apparel" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "0.34" ;
    :yValue "Entertainment (Books, Music, etc.)" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "0.23" ;
    :yValue "Jewelry, Handbags & Accessories" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "0.16" ;
    :yValue "Sporting Goods" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "0.13" ;
    :yValue "Footwear" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "0.07" ;
    :yValue "Baby Gear" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "0.11" ;
    :yValue "Other" ;
    :belongsTo :Chart .

:DataPoint12 a :DataPoint ;
    :xValue "0.03" ;
    :yValue "None of the above" ;
    :belongsTo :Chart .
