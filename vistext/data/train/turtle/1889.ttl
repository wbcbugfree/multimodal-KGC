@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Forecast of increase of immigrants in Denmark from 2019 to 2029" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Number of immigrants" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2018" ;
    :yValue "636566" ;
    :belongsTo :Chart .

