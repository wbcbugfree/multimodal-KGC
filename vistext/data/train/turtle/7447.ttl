@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Countries with the highest number of surgical and nonsurgical cosmetic procedures in 2018" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Nonsurgical" .

:YAxis a :Axis ;
    :title "Country" .

:DataPoint1 a :DataPoint ;
    :xValue "2869485" ;
    :yValue "United States" ;
    :belongsTo :Chart .

