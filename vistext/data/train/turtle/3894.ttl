@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Vietnam : Total population from 2014 to 2024 (in million inhabitants)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Inhabitants in millions" .

:DataPoint1 a :DataPoint ;
    :xValue "2024*" ;
    :yValue "99.92" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "2023*" ;
    :yValue "99.08" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "2022*" ;
    :yValue "98.21" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "2021*" ;
    :yValue "97.31" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "2020*" ;
    :yValue "96.41" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "2019*" ;
    :yValue "95.49" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "2018*" ;
    :yValue "94.58" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "2017*" ;
    :yValue "93.64" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "2016" ;
    :yValue "92.69" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "2015" ;
    :yValue "91.71" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "2014" ;
    :yValue "90.73" ;
    :belongsTo :Chart .
