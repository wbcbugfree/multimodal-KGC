@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Brand value of the most valuable retail brands in the United Kingdom (UK) as of 2013 (in million U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Brand" .

:YAxis a :Axis ;
    :title "Value in million U.S. dollars" .

:DataPoint1 a :DataPoint ;
    :xValue "Tesco" ;
    :yValue "10810" ;
    :belongsTo :Chart .

