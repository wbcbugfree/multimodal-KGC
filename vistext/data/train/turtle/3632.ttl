@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Annual turnover of the waste collection industry in Italy from 2008 to 2018 (in million euros)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Annual turnover in million euros" .

:YAxis a :Axis ;
    :title "Year" .

:DataPoint1 a :DataPoint ;
    :xValue "10436.3" ;
    :yValue "2018" ;
    :belongsTo :Chart .

