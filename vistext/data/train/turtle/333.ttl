@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Total amount of investment of private equity companies in Sweden from 2007 to 2016 (in million euros)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Total investment in million euros" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2006" ;
    :yValue "3099.11" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Dec 31, 2007" ;
    :yValue "3352.74" ;
    :belongsTo :Chart .

