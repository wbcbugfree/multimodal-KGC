@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Distribution of furniture consumption in the European Union (28 countries) from 2003 to 2012 , by EU and extra-EU production" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "EU production" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2002" ;
    :yValue "0.92" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Dec 31, 2003" ;
    :yValue "0.91" ;
    :belongsTo :Chart .

