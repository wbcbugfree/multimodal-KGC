@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Highest grossing actors worldwide in 2018 , by global box office results (in million U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "actors" .

:YAxis a :Axis ;
    :title "Annual box office grosses in million U.S. dollars" .

