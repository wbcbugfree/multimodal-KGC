@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Pittsburgh Pirates all-time RBI (runs batted in) leaders as of October 2020" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Number of home runs" .

:YAxis a :Axis ;
    :title "Pittsburgh Pirates Player" .

:DataPoint1 a :DataPoint ;
    :xValue "1540" ;
    :yValue "Willie Stargell" ;
    :belongsTo :Chart .

