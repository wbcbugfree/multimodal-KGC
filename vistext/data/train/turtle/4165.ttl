@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Most affordable cities for Airbnb accommodation worldwide as of December 2014 (in U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "city" .

:YAxis a :Axis ;
    :title "Average price per night in U.S. dollars" .

:DataPoint1 a :DataPoint ;
    :xValue "Tirana, Albania" ;
    :yValue "30" ;
    :belongsTo :Chart .

