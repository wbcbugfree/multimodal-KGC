@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Leading female cyclists in Italy as of November 2020 , by UCI score" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "UCI score" .

:YAxis a :Axis ;
    :title "Cyclist" .

