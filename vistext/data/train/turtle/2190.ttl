@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Value of mortgage loans in the Asia Pacific region in 2014 , by country or region (in billion U.S dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Country" .

:YAxis a :Axis ;
    :title "Value in U.S. billion dollars" .

:DataPoint1 a :DataPoint ;
    :xValue "China" ;
    :yValue "1919" ;
    :belongsTo :Chart .

