@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Leading chemical drugs dispensed in England in 2019 , by items (in millions)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Chemical drug" .

:YAxis a :Axis ;
    :title "Number of items dispensed in millions" .

:DataPoint1 a :DataPoint ;
    :xValue "Atorvastatin" ;
    :yValue "45.8" ;
    :belongsTo :Chart .

