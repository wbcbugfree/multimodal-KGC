@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Film studio ranking by number of `` Best Picture '' Academy Awards as of 2020" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Number of awards" .

