@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "United Kingdom (UK) total EU trade in goods from 2000 to 2019 , by trade value (in billion GBP)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Trade balance" .

