@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Coffee consumption in Canada from 2010 to 2021 (in million 60-kilogram bags)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Consumption in million 60-kilogram bags" .

:DataPoint1 a :DataPoint ;
    :xValue "2020/21*" ;
    :yValue "4.85" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "2019/20" ;
    :yValue "4.83" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "2018/19" ;
    :yValue "4.89" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "2017/18" ;
    :yValue "4.75" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "2016/17" ;
    :yValue "4.55" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "2015/16" ;
    :yValue "4.55" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "2014/15" ;
    :yValue "4.5" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "2013/14" ;
    :yValue "4.61" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "2012/13" ;
    :yValue "4.23" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "2011/12" ;
    :yValue "4.17" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "2010/11" ;
    :yValue "4.25" ;
    :belongsTo :Chart .
