@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Number of live births in Denmark from 2009 to 2019" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Number of births" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2008" ;
    :yValue "62818" ;
    :belongsTo :Chart .

