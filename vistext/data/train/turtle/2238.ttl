@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Worldwide refinery production of cobalt from 2008 to 2017 (in metric tons)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Production in metric tons" .

:DataPoint1 a :DataPoint ;
    :xValue "2017" ;
    :yValue "117000" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "2016" ;
    :yValue "96600" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "2015" ;
    :yValue "99800" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "2014*" ;
    :yValue "92600" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "2013" ;
    :yValue "86700" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "2012" ;
    :yValue "78100" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "2011" ;
    :yValue "82400" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "2010" ;
    :yValue "79500" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "2009" ;
    :yValue "62100" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "2008" ;
    :yValue "57600" ;
    :belongsTo :Chart .
