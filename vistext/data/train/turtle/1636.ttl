@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Leading wicket-takers in Twenty20 International cricket as of August 2020" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Number of wickets taken" .

:YAxis a :Axis ;
    :title "Wicket-taker" .

:DataPoint1 a :DataPoint ;
    :xValue "107" ;
    :yValue "SL Malinga (SL)" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "98" ;
    :yValue "Shahid Afridi (ICC/PAK)" ;
    :belongsTo :Chart .

