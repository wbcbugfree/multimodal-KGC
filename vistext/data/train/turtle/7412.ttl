@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Fertility rate in each continent and worldwide , from 1950 to 2020" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "North America" .

:YAxis a :Axis ;
    :title "Year" .

:DataPoint1 a :DataPoint ;
    :xValue "1.75" ;
    :yValue "2015-2020" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "1.85" ;
    :yValue "2010-2015" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "2.01" ;
    :yValue "2005-2010" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "1.99" ;
    :yValue "2000-2005" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "1.95" ;
    :yValue "1995-2000" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "2" ;
    :yValue "1990-1995" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "1.88" ;
    :yValue "1985-1990" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "1.79" ;
    :yValue "1980-1985" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "1.77" ;
    :yValue "1975-1980" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "2.02" ;
    :yValue "1970-1975" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "2.55" ;
    :yValue "1965-1970" ;
    :belongsTo :Chart .

:DataPoint12 a :DataPoint ;
    :xValue "3.28" ;
    :yValue "1960-1965" ;
    :belongsTo :Chart .

:DataPoint13 a :DataPoint ;
    :xValue "3.61" ;
    :yValue "1955-1960" ;
    :belongsTo :Chart .

:DataPoint14 a :DataPoint ;
    :xValue "3.34" ;
    :yValue "1950-1955" ;
    :belongsTo :Chart .
