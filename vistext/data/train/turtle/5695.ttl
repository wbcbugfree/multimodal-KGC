@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Monthly chained Consumer Price Index (C-CPI-U) of all urban consumers in the United States from November 2019 to November 2020" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Month" .

:YAxis a :Axis ;
    :title "Chained consumer Price Index (1999=100)" .

:DataPoint1 a :DataPoint ;
    :xValue "Nov '20" ;
    :yValue "145.82" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Oct '20" ;
    :yValue "145.93" ;
    :belongsTo :Chart .

