@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Cotton mill use in the United States from 1990 to 2018 (in 1,000 bales)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Mill use in thousand 480-pound bales" .

