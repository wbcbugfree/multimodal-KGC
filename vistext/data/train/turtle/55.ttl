@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Leading countries with the most mobile broadband subscriptions per 100 inhabitants in 2017" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Country" .

:YAxis a :Axis ;
    :title "Subscriptions per 100 inhabitants" .

