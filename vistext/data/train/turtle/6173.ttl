@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Number of Wyndham Hotels & Resorts Inc. hotel rooms worldwide from 2009 to 2019 , by region" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Europe/Middle East/Africa" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2008" ;
    :yValue "37000" ;
    :belongsTo :Chart .

