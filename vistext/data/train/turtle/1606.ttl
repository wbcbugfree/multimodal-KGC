@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Number of immigrants who arrived in the United States from 1820 to 1870 , by nationality" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Nationality" .

:YAxis a :Axis ;
    :title "Number of Immigrants" .

:DataPoint1 a :DataPoint ;
    :xValue "Irish" ;
    :yValue "2700493" ;
    :belongsTo :Chart .

