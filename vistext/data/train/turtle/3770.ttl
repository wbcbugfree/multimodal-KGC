@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Intended percentage increase in jobs to take advantage of digital technology in the next two years in the United Kingdom (UK) from 2015 to 2017 , by region" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Percentage increase of new jobs" .

:YAxis a :Axis ;
    :title "region of England" .

:DataPoint1 a :DataPoint ;
    :xValue "0.04" ;
    :yValue "London" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "0.039" ;
    :yValue "Northern Island" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "0.039" ;
    :yValue "South West" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "0.039" ;
    :yValue "South East" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "0.036" ;
    :yValue "North East" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "0.036" ;
    :yValue "East" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "0.036" ;
    :yValue "West Midlands" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "0.036" ;
    :yValue "Scotland" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "0.034" ;
    :yValue "Yorkshire and Humber" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "0.034" ;
    :yValue "East Midlands" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "0.034" ;
    :yValue "North West" ;
    :belongsTo :Chart .

:DataPoint12 a :DataPoint ;
    :xValue "0.033" ;
    :yValue "Wales" ;
    :belongsTo :Chart .
