@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Cumulative transmission rate of coronavirus (COVID-19) in Spain as of January 5 , 2021 , by autonomous community (every 100,000 people)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "autonomous community of Spain" .

:YAxis a :Axis ;
    :title "Infections every 100,000 people" .

:DataPoint1 a :DataPoint ;
    :xValue "Navarre" ;
    :yValue "6599" ;
    :belongsTo :Chart .

