@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Retail sales of unpackaged or artisanal bread in Canada from 2013 to 2022 , by type (in million U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Flat" .

:YAxis a :Axis ;
    :title "Year" .

:DataPoint1 a :DataPoint ;
    :xValue "71.6" ;
    :yValue "2022*" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "68.8" ;
    :yValue "2021*" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "66" ;
    :yValue "2020*" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "63.2" ;
    :yValue "2019*" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "60.4" ;
    :yValue "2018*" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "57.6" ;
    :yValue "2017" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "55.6" ;
    :yValue "2016" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "53.5" ;
    :yValue "2015" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "51.6" ;
    :yValue "2014" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "50.3" ;
    :yValue "2013" ;
    :belongsTo :Chart .
