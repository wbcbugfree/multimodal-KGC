@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Number of members of the International Association of Theatrical Stage Employees in the United States from 2000 to 2013 (in thousands)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Number of members in thousands" .

