@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "U.S. war costs in Iraq and Afghanistan from 2003 to 2015 (in billion U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Iraq" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2002" ;
    :yValue "53" ;
    :belongsTo :Chart .

