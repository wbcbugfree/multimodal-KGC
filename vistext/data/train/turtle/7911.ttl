@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Syria : Share of economic sectors in the gross domestic product (GDP) from 1997 to 2007" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Industry" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 1996" ;
    :yValue "0.3091" ;
    :belongsTo :Chart .

