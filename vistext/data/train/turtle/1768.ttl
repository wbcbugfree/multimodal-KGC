@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Number of recreational visitors to the Lake Mead National Recreation Area in the United States from 2008 to 2019 (in millions)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Number of visitors in millions" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2007" ;
    :yValue "7.6" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Dec 31, 2008" ;
    :yValue "7.67" ;
    :belongsTo :Chart .

