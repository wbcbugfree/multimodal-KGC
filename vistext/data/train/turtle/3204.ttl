@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Average number of daily brand posts on Twitter in 2019 , by vertical" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Number of brand tweets per day" .

:YAxis a :Axis ;
    :title "Vertical" .

:DataPoint1 a :DataPoint ;
    :xValue "9.54" ;
    :yValue "Media" ;
    :belongsTo :Chart .

