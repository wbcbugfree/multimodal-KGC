@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Most played PC games on gaming platform Raptr in November 2015 , by share of playing time" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "Share of playing time" .

