@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Population of Finland in 2019 , by region" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "region of Finland" .

:YAxis a :Axis ;
    :title "Number of inhabitants" .

