@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Number of threatened wildlife and plant species in the United States as of 2020" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "type" .

:YAxis a :Axis ;
    :title "Number of threatened wildlife and plant species" .

:DataPoint1 a :DataPoint ;
    :xValue "Flowering Plants" ;
    :yValue "166" ;
    :belongsTo :Chart .

