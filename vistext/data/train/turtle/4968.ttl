@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Distribution of worldwide social media users in 2020 , by region" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "Share of social media users" .

:DataPoint1 a :DataPoint ;
    :xValue "Eastern Asia" ;
    :yValue "0.296" ;
    :belongsTo :Chart .

