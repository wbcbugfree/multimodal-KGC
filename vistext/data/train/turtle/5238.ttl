@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Number of light vehicles produced from January 2019 to April 2020 in Mexico (in 1,000s)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Production volume in thousand units" .

:YAxis a :Axis ;
    :title "Month" .

