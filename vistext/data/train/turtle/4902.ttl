@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Share of disposable income spent on food consumed at home in 2013 , by selected countries" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Expenditure share" .

:YAxis a :Axis ;
    :title "Country" .

:DataPoint1 a :DataPoint ;
    :xValue "0.567" ;
    :yValue "Nigeria" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "0.481" ;
    :yValue "Pakistan" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "0.296" ;
    :yValue "India" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "0.251" ;
    :yValue "Mexico" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "0.12" ;
    :yValue "Germany" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "0.118" ;
    :yValue "Netherlands" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "0.095" ;
    :yValue "Canada" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "0.093" ;
    :yValue "United Kingdom" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "0.089" ;
    :yValue "Switzerland" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "0.067" ;
    :yValue "United States" ;
    :belongsTo :Chart .
