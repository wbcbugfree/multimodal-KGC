@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Quantity of all cheese produced in the United States in February 2016 , by type (in million pounds)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Production in million pounds" .

:YAxis a :Axis ;
    :title "type" .

:DataPoint1 a :DataPoint ;
    :xValue "341" ;
    :yValue "Mozzarella" ;
    :belongsTo :Chart .

