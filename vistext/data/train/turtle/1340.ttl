@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Universities in the United States ranked by number of Fortune 500 CEO alumni in 2020" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "University" .

:YAxis a :Axis ;
    :title "Number of Fortune 500 CEO alumni" .

:DataPoint1 a :DataPoint ;
    :xValue "Harvard University" ;
    :yValue "25" ;
    :belongsTo :Chart .

