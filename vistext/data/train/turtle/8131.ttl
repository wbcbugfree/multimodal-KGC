@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Number of mobile/cellular subscriptions for mobile PC , routers & tablets worldwide from 2011 to 2025 , by region (in millions)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Latin America" .

:DataPoint1 a :DataPoint ;
    :xValue "2025*" ;
    :yValue "45" ;
    :belongsTo :Chart .

