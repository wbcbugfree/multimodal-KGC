@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Beauty-related websites ranked by natural search voice share in the United Kingdom (UK) in February 2016" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "Share of natural search voice**" .

:DataPoint1 a :DataPoint ;
    :xValue "boots.com" ;
    :yValue "50" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "amazon.co.uk" ;
    :yValue "35" ;
    :belongsTo :Chart .

