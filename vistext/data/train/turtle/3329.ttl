    :xValue "superdrug.com" ;
    :yValue "29" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "debenhams.com" ;
    :yValue "24" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "fragnancedirect.co.uk" ;
    :yValue "17" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "ebay.co.uk" ;
    :yValue "15" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "youtube.com" ;
    :yValue "14" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "johnlewis.com" ;
    :yValue "14" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "houseoffraser.co.uk" ;
