@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Population projections for the United States from 2015 to 2060 (in millions)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Number of residents in millions" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2014" ;
    :yValue "321.37" ;
    :belongsTo :Chart .

