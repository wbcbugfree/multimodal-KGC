@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Most popular words in Academy Awards acceptance speeches for best acting categories between 1988 and 2013" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Actress in a Supporting Role" .

:YAxis a :Axis ;
    :title "Word" .

:DataPoint1 a :DataPoint ;
    :xValue "144" ;
    :yValue "Thank you/Thanks" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "23" ;
    :yValue "Academy" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "12" ;
    :yValue "God" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "6" ;
    :yValue "Mom/Mother" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "7" ;
    :yValue "Dad/Father" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "2" ;
    :yValue "Parent(s)" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "19" ;
    :yValue "Family(ies)" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "13" ;
    :yValue "Friend(s)" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "10" ;
    :yValue "Cast" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "8" ;
    :yValue "Crew" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "8" ;
    :yValue "Husband" ;
    :belongsTo :Chart .

:DataPoint12 a :DataPoint ;
    :xValue "1" ;
    :yValue "Wife" ;
    :belongsTo :Chart .
