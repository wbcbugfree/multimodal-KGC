@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Online share of retail expenditure in the United Kingdom (UK) from 2000 to 2013" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Share of sales" .

:YAxis a :Axis ;
    :title "Response" .

:DataPoint1 a :DataPoint ;
    :xValue "0.117" ;
    :yValue "2013*" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "0.105" ;
    :yValue "2012*" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "0.093" ;
    :yValue "2011" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "0.081" ;
    :yValue "2010" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "0.07" ;
    :yValue "2009" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "0.06" ;
    :yValue "2008" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "0.049" ;
    :yValue "2007" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "0.038" ;
    :yValue "2006" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "0.03" ;
    :yValue "2005" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "0.023" ;
    :yValue "2004" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "0.019" ;
    :yValue "2003" ;
    :belongsTo :Chart .

:DataPoint12 a :DataPoint ;
    :xValue "0.016" ;
    :yValue "2002" ;
    :belongsTo :Chart .

:DataPoint13 a :DataPoint ;
    :xValue "0.014" ;
    :yValue "2001" ;
    :belongsTo :Chart .

:DataPoint14 a :DataPoint ;
    :xValue "0.008" ;
    :yValue "2000" ;
    :belongsTo :Chart .
