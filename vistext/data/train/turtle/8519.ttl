@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Total and pedestrian fatalities in U.S. traffic crashes from 2001 to 2017" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Pedestrian" .

