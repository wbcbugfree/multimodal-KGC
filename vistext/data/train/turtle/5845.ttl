@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Percentage of married-couple families in the U.S. who live below the poverty level from 1990 to 2019" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "Percentage of poor married-couple families" .

