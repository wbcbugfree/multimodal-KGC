@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Number of German tourist arrivals in Egypt from 2012 to 2017 , by month (in1,000s)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Month" .

:YAxis a :Axis ;
    :title "2013" .

:DataPoint1 a :DataPoint ;
    :xValue "De" ;
    :yValue "58.74" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Dec No" ;
    :yValue "66.11" ;
    :belongsTo :Chart .

