    :yValue "17.48" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "Sept Au" ;
    :yValue "51.95" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Aug Ju" ;
    :yValue "74.15" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Jul Ju" ;
    :yValue "82.66" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Jun Ma" ;
    :yValue "87.83" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "May Ap" ;
