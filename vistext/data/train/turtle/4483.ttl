@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Share of internet users who have used licensed audio streaming services worldwide as of 2017 , by country" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "Share of respondents" .

:DataPoint1 a :DataPoint ;
    :xValue "Mexico" ;
    :yValue "0.75" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Sweden" ;
    :yValue "0.66" ;
    :belongsTo :Chart .

