@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "United States uranium mine production from 2003 to 2019 (in metric tons)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Production in metric tons" .

