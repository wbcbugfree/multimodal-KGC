@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Manchester United revenue from jersey sponsorship from 2009/10 to 2020/21 (in million GBP)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Kit sponsorship in million GBP" .

:DataPoint1 a :DataPoint ;
    :xValue "2020/21 (Chevrolet)*" ;
    :yValue "64" ;
    :belongsTo :Chart .

