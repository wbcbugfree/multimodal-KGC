    :xValue "2014" ;
    :yValue "62754" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "2013" ;
    :yValue "63243" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "2010" ;
    :yValue "68344" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "2009" ;
    :yValue "62704" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "2008" ;
