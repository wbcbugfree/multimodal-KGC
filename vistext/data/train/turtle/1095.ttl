@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Countries most affected by banking trojans and PoS/ATM malware in 2017" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Victimization rate" .

:YAxis a :Axis ;
    :title "Country" .

:DataPoint1 a :DataPoint ;
    :xValue "0.0444" ;
    :yValue "Germany" ;
    :belongsTo :Chart .

