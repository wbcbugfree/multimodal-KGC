@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Total number of all banknotes in circulation in the United Kingdom (UK) from 2004 to 2020 (in millions of notes)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Number of notes in millions" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2003" ;
    :yValue "1895" ;
    :belongsTo :Chart .

