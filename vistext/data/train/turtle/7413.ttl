@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Decrease in the level of nitrogen dioxide registered during the coronavirus crisis in selected Spanish cities between 10 - 14 March and 15 - 20 March 2020" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "city of spanish" .

:YAxis a :Axis ;
    :title "NO2 levels10-14 March" .

:DataPoint1 a :DataPoint ;
    :xValue "Barcelona" ;
    :yValue "256" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Madrid" ;
    :yValue "208" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "Valencia" ;
    :yValue "114" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "Castellón" ;
    :yValue "94" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "Zaragoza" ;
    :yValue "89" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Bilbao" ;
    :yValue "85" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Alicante" ;
    :yValue "79" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Málaga" ;
    :yValue "69" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "Gijón" ;
    :yValue "68" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "Sevilla" ;
    :yValue "53" ;
    :belongsTo :Chart .
