@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Ease of doing business (EODB) ranking of Russia in 2019 , by business activity" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "business activity" .

:YAxis a :Axis ;
    :title "EODB ranking from 1 to 190*" .

:DataPoint1 a :DataPoint ;
    :xValue "Trading across borders" ;
    :yValue "99" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Protecting minority investors" ;
    :yValue "72" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "Paying taxes" ;
    :yValue "58" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "Resolving insolvency" ;
    :yValue "57" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "Starting a business" ;
    :yValue "40" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "DB rank" ;
    :yValue "28" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Dealing with construction permits" ;
    :yValue "26" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Getting credit" ;
    :yValue "25" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "Enforcing contracts" ;
    :yValue "21" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "Registering property" ;
    :yValue "12" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "Getting electricity" ;
    :yValue "7" ;
    :belongsTo :Chart .
