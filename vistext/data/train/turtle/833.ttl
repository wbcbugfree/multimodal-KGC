@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Leading mining countries worldwide in 2016 , based on mineral production value (in billion U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Country" .

:YAxis a :Axis ;
    :title "Production value in billion U.S. dollars" .

:DataPoint1 a :DataPoint ;
    :xValue "China" ;
    :yValue "626.3" ;
    :belongsTo :Chart .

