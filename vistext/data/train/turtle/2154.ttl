@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Change in wine export volume worldwide from 2014 to 2015 , by country" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Country" .

:YAxis a :Axis ;
    :title "Change in export volume" .

:DataPoint1 a :DataPoint ;
    :xValue "New Zealand" ;
    :yValue "0.115" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Chile" ;
    :yValue "0.086" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "Spain" ;
    :yValue "0.075" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "Australia" ;
    :yValue "0.063" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "United States" ;
    :yValue "0.035" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Argentina" ;
    :yValue "0.019" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Portugal" ;
    :yValue "-0.012" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Italy" ;
    :yValue "-0.02" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "France" ;
    :yValue "-0.021" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "Germany" ;
    :yValue "-0.159" ;
    :belongsTo :Chart .
