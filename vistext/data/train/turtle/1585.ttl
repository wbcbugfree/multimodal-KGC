    :yValue "1356150" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Dec 31, 2011" ;
    :yValue "490170" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
