@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Which of the following popular U.S. professional sports do you most associate with positive moral values ?" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Male" .

:YAxis a :Axis ;
    :title "Response" .

:DataPoint1 a :DataPoint ;
    :xValue "0.26" ;
    :yValue "Tennis" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "0.28" ;
    :yValue "Golf" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "0.25" ;
    :yValue "Baseball" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "0.14" ;
    :yValue "Soccer" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "0.14" ;
    :yValue "Football" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "0.11" ;
    :yValue "Mixed Martial Arts" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "0.13" ;
    :yValue "Basketball" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "0.1" ;
    :yValue "Auto Racing" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "0.08" ;
    :yValue "Hockey" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "0.05" ;
    :yValue "Boxing" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "0.03" ;
    :yValue "Wrestling" ;
    :belongsTo :Chart .

:DataPoint12 a :DataPoint ;
    :xValue "0.01" ;
    :yValue "Other" ;
    :belongsTo :Chart .

:DataPoint13 a :DataPoint ;
    :xValue "0.29" ;
    :yValue "I don't associate any U.S. professional sports with positive moral values" ;
    :belongsTo :Chart .

:DataPoint14 a :DataPoint ;
    :xValue "0.06" ;
    :yValue "Not sure" ;
    :belongsTo :Chart .
