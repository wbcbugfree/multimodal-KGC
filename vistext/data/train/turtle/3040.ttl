    :xValue "742" ;
    :yValue "The Russian Orthodox Church" ;
    :belongsTo :Chart .

:DataPoint12 a :DataPoint ;
    :xValue "628" ;
    :yValue "The Seventh Day Adventist Church" ;
    :belongsTo :Chart .

:DataPoint13 a :DataPoint ;
    :xValue "623" ;
    :yValue "The Icelandic Muslim Association" ;
    :belongsTo :Chart .

:DataPoint14 a :DataPoint ;
    :xValue "608" ;
    :yValue "Jehova Witnesses" ;
    :belongsTo :Chart .

:DataPoint15 a :DataPoint ;
