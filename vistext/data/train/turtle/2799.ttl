@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Annual turnover of museum activities in the United Kingdom (UK) from 2008 to 2018 (in million GBP)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Turnover in million GBP" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2007" ;
    :yValue "380" ;
    :belongsTo :Chart .

