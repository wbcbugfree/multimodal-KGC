@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Revenue of Wyndham Worldwide from 2005 to 2017 (in billion U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Revenue in billion U.S. dollars" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2004" ;
    :yValue "3.47" ;
    :belongsTo :Chart .

