@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Number of Nike 's retail stores in the United States from 2009 to 2020" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "NIKE factory stores" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2008" ;
    :yValue "140" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Dec 31, 2009" ;
    :yValue "145" ;
    :belongsTo :Chart .

