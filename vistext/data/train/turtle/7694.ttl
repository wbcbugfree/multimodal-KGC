@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "K-12 public school enrollment numbers in the United States from 2000 to 2017 , by ethnicity (in 1,000s)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "White" .

:YAxis a :Axis ;
    :title "Year" .

