@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Value of soft drink sales through convenience channels in the United Kingdom in 2018 , by sub-category (in million GBP)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Value of sales in million GBP" .

:YAxis a :Axis ;
    :title "Soft Drink Sub-category" .

:DataPoint1 a :DataPoint ;
    :xValue "577" ;
    :yValue "Cola" ;
    :belongsTo :Chart .

