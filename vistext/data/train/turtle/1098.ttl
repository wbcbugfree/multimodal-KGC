@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Annual volume of strawberries sold in France from 2008 to 2018 (in 1,000 tons)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Sales volume in thousand tons" .

:YAxis a :Axis ;
    :title "Year" .

:DataPoint1 a :DataPoint ;
    :xValue "78.6" ;
    :yValue "2018*" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "77.4" ;
    :yValue "2017*" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "75.1" ;
    :yValue "2016*" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "73.6" ;
    :yValue "2015 *" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "74.3" ;
    :yValue "2014 *" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "74.7" ;
    :yValue "2013" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "72.6" ;
    :yValue "2012" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "71.3" ;
    :yValue "2011" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "70.6" ;
    :yValue "2010" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "69.9" ;
    :yValue "2009" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "66.5" ;
    :yValue "2008" ;
    :belongsTo :Chart .
