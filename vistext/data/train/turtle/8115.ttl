@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Most important supplier support services to travel agents in the United States as of July 2015 , by agency size" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Home-based agents with $250,000 plus revenue" .

:YAxis a :Axis ;
    :title "Response" .

:DataPoint1 a :DataPoint ;
    :xValue "0.65" ;
    :yValue "Familiarization trips" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "0.56" ;
    :yValue "Educational programs" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "0.46" ;
    :yValue "Email updates on special offers" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "0.49" ;
    :yValue "Overrides / incentives" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "0.39" ;
    :yValue "Agent portion of websites" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "0.3" ;
    :yValue "Consumer referrals" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "0.19" ;
    :yValue "Co-op marketing efforts" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "0.14" ;
    :yValue "Co-op advertising" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "0.13" ;
    :yValue "Trade publication offers" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "0.12" ;
    :yValue "Mail updates on special offers" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "0.08" ;
    :yValue "Social media co-op" ;
    :belongsTo :Chart .
