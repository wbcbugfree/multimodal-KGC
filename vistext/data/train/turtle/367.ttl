@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Average consumer price for DIN A4 paper in selected European countries in 2014 (in euros per 500 sheets)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Consumer price in euros per 500 sheets" .

:YAxis a :Axis ;
    :title "Country" .

:DataPoint1 a :DataPoint ;
    :xValue "6.53" ;
    :yValue "Norway" ;
    :belongsTo :Chart .

