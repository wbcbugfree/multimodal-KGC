@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Average pre-berthing time at Mumbai Port in India from financial year 1991 to 2019 (in days)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Average pre-berthing time in days" .

:YAxis a :Axis ;
    :title "year" .

:DataPoint1 a :DataPoint ;
    :xValue "1.07" ;
    :yValue "FY 2019" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "0.96" ;
    :yValue "FY 2018" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "0.46" ;
    :yValue "FY 2017" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "1.27" ;
    :yValue "FY 2016" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "1.69" ;
    :yValue "FY 2015" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "1.18" ;
    :yValue "FY 2014" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "1.62" ;
    :yValue "FY 2013" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "1.37" ;
    :yValue "FY 2012" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "1.23" ;
    :yValue "FY 2011" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "1.06" ;
    :yValue "FY 2010" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "1.26" ;
    :yValue "FY 2001" ;
    :belongsTo :Chart .

:DataPoint12 a :DataPoint ;
    :xValue "3.4" ;
    :yValue "FY 1991" ;
    :belongsTo :Chart .
