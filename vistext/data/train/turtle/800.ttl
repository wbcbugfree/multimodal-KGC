@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Forecast volume of high fructose corn syrup consumed in the European Union (EU 27) from 2016 to 2029 (in 1,000 tonnes)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Volume in thousand tonnes" .

:YAxis a :Axis ;
    :title "Year" .

:DataPoint1 a :DataPoint ;
    :xValue "940" ;
    :yValue "2029*" ;
    :belongsTo :Chart .

