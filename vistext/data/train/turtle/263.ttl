@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Ratio of investment funds assets under management in Europe to the country 's GDP at the end of 2018 , by country" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Ratio of asset value to GDP value" .

:YAxis a :Axis ;
    :title "Country" .

:DataPoint1 a :DataPoint ;
    :xValue "1.84" ;
    :yValue "Switzerland" ;
    :belongsTo :Chart .

