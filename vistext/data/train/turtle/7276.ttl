@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Brunswick 's net sales worldwide from 2008 to 2019 , by business segment (in million U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Boat" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2007" ;
    :yValue "1719.5" ;
    :belongsTo :Chart .

