@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Sales of the leading shaving cream brands in the United States in 2019 (in million U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Brand" .

:YAxis a :Axis ;
    :title "Sales in million U.S. dollars" .

:DataPoint1 a :DataPoint ;
    :xValue "Edge" ;
    :yValue "77.6" ;
    :belongsTo :Chart .

