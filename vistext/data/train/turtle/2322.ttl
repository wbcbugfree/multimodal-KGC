@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Number of turkeys raised in the United States in 2018 , by leading state (in 1,000 heads)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Number in thousand heads" .

:YAxis a :Axis ;
    :title "State" .

:DataPoint1 a :DataPoint ;
    :xValue "42000" ;
    :yValue "Minnesota" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "32500" ;
    :yValue "North Carolina" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "31500" ;
    :yValue "Arkansas" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "20000" ;
    :yValue "Indiana" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "19000" ;
    :yValue "Missouri" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "16800" ;
    :yValue "Virginia" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "11900" ;
    :yValue "Iowa" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "11000" ;
    :yValue "California" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "7000" ;
    :yValue "Pennsylvania" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "6700" ;
    :yValue "Ohio" ;
    :belongsTo :Chart .
