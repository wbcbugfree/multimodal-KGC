@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Number of Ebola cases from the West African outbreak as of March 30 , 2016" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Confirmed" .

:YAxis a :Axis ;
    :title "Country" .

:DataPoint1 a :DataPoint ;
    :xValue "3354" ;
    :yValue "Guinea" ;
    :belongsTo :Chart .

