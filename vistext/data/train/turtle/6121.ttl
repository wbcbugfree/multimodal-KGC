@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Total median income of seniors in Canada from 2000 to 2018 , by age group" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "55 to 64 years" .

