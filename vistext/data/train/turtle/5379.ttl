@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Average price of wool paid to producers in Canada in 2018 , by region (in Canadian dollars per kilogram)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Average price per kilogram in Canadian dollars" .

:YAxis a :Axis ;
    :title "province of Canada" .

:DataPoint1 a :DataPoint ;
    :xValue "1.92" ;
    :yValue "Alberta" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "1.24" ;
    :yValue "British Columbia" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "1.12" ;
    :yValue "Saskatchewan" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "1.01" ;
    :yValue "Newfoundland and Labrador" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "1" ;
    :yValue "Prince Edward Island" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "0.99" ;
    :yValue "New Brunswick" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "0.9" ;
    :yValue "Nova Scotia" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "0.9" ;
    :yValue "Ontario" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "0.85" ;
    :yValue "Manitoba" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "0.57" ;
    :yValue "Quebec" ;
    :belongsTo :Chart .
