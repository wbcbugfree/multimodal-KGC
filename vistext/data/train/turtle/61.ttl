@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Social welfare expenditure in Sweden from 2009 to 2019 (in million SEK)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Social welfare expenditure in million SEK" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2008" ;
    :yValue "11059" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Dec 31, 2009" ;
    :yValue "11594" ;
    :belongsTo :Chart .

