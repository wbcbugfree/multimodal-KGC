@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Prevalence of asthma among Canadians from 2011 to 2012 , by province" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "Percentage of people with asthma" .

:DataPoint1 a :DataPoint ;
    :xValue "Canada" ;
    :yValue "0.108" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "British Columbia" ;
    :yValue "0.092" ;
    :belongsTo :Chart .

