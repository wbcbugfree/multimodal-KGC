    :xValue "Manitoba" ;
    :yValue "0.108" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Ontario" ;
    :yValue "0.121" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Qubec" ;
    :yValue "0.102" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "New Brunswick" ;
    :yValue "0.091" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
