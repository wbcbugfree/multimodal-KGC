@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Age distribution of the population in Italy from 2002 to 2020" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "65 years and older" .

:YAxis a :Axis ;
    :title "Year" .

:DataPoint1 a :DataPoint ;
    :xValue "0.231" ;
    :yValue "2020*" ;
    :belongsTo :Chart .

