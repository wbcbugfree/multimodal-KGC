@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Number of Marriott International hotel rooms worldwide from 2009 to 2019" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Number of hotel rooms" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2008" ;
    :yValue "595461" ;
    :belongsTo :Chart .

