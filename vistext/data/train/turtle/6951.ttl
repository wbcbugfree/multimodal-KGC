@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Sales share of the leading sauces , dressings and condiments brands in the United States from 2007 to 2012" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "2009" .

:YAxis a :Axis ;
    :title "leading sauces, dressings and condiments brands" .

:DataPoint1 a :DataPoint ;
    :xValue "0.066" ;
    :yValue "McCormick" ;
    :belongsTo :Chart .

