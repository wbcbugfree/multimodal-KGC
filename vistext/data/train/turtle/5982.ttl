@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Car and van single occupancy rate in England between 2002 and 2018" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "Share of single occupancy" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2001" ;
    :yValue "0.61" ;
    :belongsTo :Chart .

