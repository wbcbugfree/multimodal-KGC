@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Leading women 's Twenty20 International cricket run-scorers worldwide as of September 2020" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "player" .

:YAxis a :Axis ;
    :title "Number of runs scored" .

