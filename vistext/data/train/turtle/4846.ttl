@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Average attendance at home matches in Spain 's La Liga in the 2019/2020 season , by team" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "association football club" .

:YAxis a :Axis ;
    :title "Average number of spectators" .

