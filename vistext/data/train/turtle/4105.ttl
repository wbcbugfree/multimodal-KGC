@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Fatalities in U.S. railroad accidents from 2005 to 2019" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Number of fatalities" .

:YAxis a :Axis ;
    :title "Year" .

:DataPoint1 a :DataPoint ;
    :xValue "937" ;
    :yValue "2019*" ;
    :belongsTo :Chart .

