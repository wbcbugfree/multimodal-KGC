@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Most popular online dating app or websites according to online users in the United States as of January 2018 , by age group" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "45 - 54 years" .

:DataPoint1 a :DataPoint ;
    :xValue "Tinder" ;
    :yValue "0.01" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "PlentyofFish" ;
    :yValue "0.04" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "Match.com" ;
    :yValue "0.07" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "OkCupid" ;
    :yValue "0.02" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "EHarmony" ;
    :yValue "0.03" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Coffee Meets Bagel" ;
    :yValue "0.01" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Bumble" ;
    :yValue "0.01" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Grindr" ;
    :yValue "0" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "A religious based dating app*" ;
    :yValue "0.04" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "Hinge Down" ;
    :yValue "0.01" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "Happn" ;
    :yValue "0" ;
    :belongsTo :Chart .

:DataPoint12 a :DataPoint ;
    :xValue "None" ;
    :yValue "0.75" ;
    :belongsTo :Chart .
