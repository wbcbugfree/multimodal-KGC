@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Countries with the highest employment in the travel and tourism industry worldwide in 2013 (in millions)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Country" .

:YAxis a :Axis ;
    :title "Number of jobs in millions" .

