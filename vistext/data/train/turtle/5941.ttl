@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Number of recent immigrants to British Columbia from 2001 to 2020" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Number of immigrants" .

