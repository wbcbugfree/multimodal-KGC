@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Distribution of paper imports worldwide in 2019 by country" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "Share of imports" .

:DataPoint1 a :DataPoint ;
    :xValue "United States" ;
    :yValue "0.103" ;
    :belongsTo :Chart .

