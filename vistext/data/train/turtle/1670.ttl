@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Share of world Christian population by selected countries in 2010" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Share of Christians" .

:YAxis a :Axis ;
    :title "Response" .

:DataPoint1 a :DataPoint ;
    :xValue "0.113" ;
    :yValue "United States" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "0.08" ;
    :yValue "Brazil" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "0.049" ;
    :yValue "Mexico" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "0.048" ;
    :yValue "Russia" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "0.04" ;
    :yValue "Phlippines" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "0.037" ;
    :yValue "Nigeria" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "0.031" ;
    :yValue "China" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "0.029" ;
    :yValue "DR Congo" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "0.027" ;
    :yValue "Germany" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "0.024" ;
    :yValue "Ethiopia" ;
    :belongsTo :Chart .
