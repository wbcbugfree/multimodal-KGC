@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Number of marriages in Belgium from 2007 to 2018" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Number of marriages" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2006" ;
    :yValue "45561" ;
    :belongsTo :Chart .

