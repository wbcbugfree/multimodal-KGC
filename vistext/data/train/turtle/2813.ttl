@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Leading Twenty20 International cricket run-scorers worldwide as of September 2020" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Cricket player" .

:YAxis a :Axis ;
    :title "Number of runs scored" .

:DataPoint1 a :DataPoint ;
    :xValue "V Kohli (INDIA)" ;
    :yValue "2794" ;
    :belongsTo :Chart .

