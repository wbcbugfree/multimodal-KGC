@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Approximate number of foreign fighters in Iraq and Syria , by country of origin , as of December 2015" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Country" .

:YAxis a :Axis ;
    :title "Number of foreign fighters" .

:DataPoint1 a :DataPoint ;
    :xValue "Tunisia" ;
    :yValue "6000" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Saudi Arabia" ;
    :yValue "2500" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "Russia" ;
    :yValue "2400" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "Turkey" ;
    :yValue "2100" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "Jordan" ;
    :yValue "2000" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "France" ;
    :yValue "1700" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Morocco" ;
    :yValue "1200" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Lebanon" ;
    :yValue "900" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "Germany" ;
    :yValue "760" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "United Kingdom" ;
    :yValue "760" ;
    :belongsTo :Chart .
