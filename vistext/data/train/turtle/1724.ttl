@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Memphis Grizzlies all-time points leaders from 1995 to 2020" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Memphis Grizzly Player" .

:YAxis a :Axis ;
    :title "Points scored" .

:DataPoint1 a :DataPoint ;
    :xValue "Mike Conley" ;
    :yValue "11733" ;
    :belongsTo :Chart .

