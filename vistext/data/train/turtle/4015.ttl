@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Value of emergency cash subsidy for every low-income families due to the coronavirus COVID-19 in the Philippines in 2020 , by region (in Philippine pesos)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Cash subsidy in Philippine pesos" .

:YAxis a :Axis ;
    :title "Region of Philippines" .

:DataPoint1 a :DataPoint ;
    :xValue "8000" ;
    :yValue "NCR" ;
    :belongsTo :Chart .

