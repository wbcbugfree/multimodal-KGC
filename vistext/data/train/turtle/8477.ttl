@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "National minimum wage in the United Kingdom (UK) from 1999 to 2020 , by wage category (in GBP per hour)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "25 and over" .

