@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Share of people worldwide who strongly or somewhat expect things to return to normal from COVID-19 by June , as of April 4 , 2020" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "March 12-14" .

:DataPoint1 a :DataPoint ;
    :xValue "Australia" ;
    :yValue "0.51" ;
    :belongsTo :Chart .

