@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Usage of digital devices for financial activities among millennials in Denmark in 2018 , by device and purpose" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "Computer" .

:DataPoint1 a :DataPoint ;
    :xValue "Balance" ;
    :yValue "0.28" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Send/receive money (domestic)" ;
    :yValue "0.35" ;
    :belongsTo :Chart .

