@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Average turnaround time across major ports in India from financial year 1991 to 2019 (in days)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "military budget" .

:YAxis a :Axis ;
    :title "Average turnaround time in days" .

:DataPoint1 a :DataPoint ;
    :xValue "FY 2019" ;
    :yValue "2.73" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "FY 2018" ;
    :yValue "2.91" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "FY 2017" ;
    :yValue "3.48" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "FY 2016" ;
    :yValue "3.51" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "FY 2015" ;
    :yValue "3.89" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "FY 2014" ;
    :yValue "3.84" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "FY 2013" ;
    :yValue "4.29" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "FY 2012" ;
    :yValue "4.56" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "FY 2011" ;
    :yValue "5.29" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "FY 2010" ;
    :yValue "4.63" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "FY 2009" ;
    :yValue "4.2" ;
    :belongsTo :Chart .

:DataPoint12 a :DataPoint ;
    :xValue "FY 2001" ;
    :yValue "4.24" ;
    :belongsTo :Chart .

:DataPoint13 a :DataPoint ;
    :xValue "FY 1991" ;
    :yValue "8.1" ;
    :belongsTo :Chart .
