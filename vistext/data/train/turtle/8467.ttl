@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Overnight accommodation costs in Houston from 2013 to 2017 , by month (in U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Month" .

:YAxis a :Axis ;
    :title "2016" .

:DataPoint1 a :DataPoint ;
    :xValue "De" ;
    :yValue "104" ;
    :belongsTo :Chart .

