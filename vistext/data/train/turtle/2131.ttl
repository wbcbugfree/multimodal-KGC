@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Number of glasses sold by Fielmann from 2005 to 2019 (in million pairs)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Sales volume in million pairs" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2004" ;
    :yValue "5.66" ;
    :belongsTo :Chart .

