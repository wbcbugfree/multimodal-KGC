@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Average annual percent change in total return of treasury bills of the United States from 2001 to 2018" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Percent change" .

