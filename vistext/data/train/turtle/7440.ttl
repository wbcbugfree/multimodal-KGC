@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Female athletes with the highest income from prize money and endorsements in 2020 (in million U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Endorsements" .

:YAxis a :Axis ;
    :title "Female athletes with the highest income" .

:DataPoint1 a :DataPoint ;
    :xValue "34" ;
    :yValue "Naomi Osaka (tennis)" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "32" ;
    :yValue "Serena Williams (tennis)" ;
    :belongsTo :Chart .

