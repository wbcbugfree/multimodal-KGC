    :yValue "0.4217" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Dec 31, 2014" ;
    :yValue "0.5844" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
