@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Kuwait : Share of economic sectors in the gross domestic product (GDP) from 2010 to 2019" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Services" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2009" ;
    :yValue "0.4704" ;
    :belongsTo :Chart .

