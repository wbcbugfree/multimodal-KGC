@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Share of households with internet access in Iceland from 2005 to 2018" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Share of households" .

:YAxis a :Axis ;
    :title "Response" .

:DataPoint1 a :DataPoint ;
    :xValue "0.99" ;
    :yValue "2018" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "0.98" ;
    :yValue "2017" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "0.96" ;
    :yValue "2014" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "0.96" ;
    :yValue "2013" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "0.95" ;
    :yValue "2012" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "0.93" ;
    :yValue "2011" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "0.92" ;
    :yValue "2010" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "0.9" ;
    :yValue "2009" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "0.88" ;
    :yValue "2008" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "0.84" ;
    :yValue "2007" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "0.83" ;
    :yValue "2006" ;
    :belongsTo :Chart .

:DataPoint12 a :DataPoint ;
    :xValue "0.84" ;
    :yValue "2005" ;
    :belongsTo :Chart .
