@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Share of the urban population in Myanmar from 2009 to 2018" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "Share of population" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2008" ;
    :yValue "0.287" ;
    :belongsTo :Chart .

