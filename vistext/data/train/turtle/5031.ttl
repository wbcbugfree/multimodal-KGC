@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Denso 's global revenue from FY 2008 to FY 2020 (in billion Japanese yen)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Revenue in billion Japanese yen" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2007" ;
    :yValue "4025.08" ;
    :belongsTo :Chart .

