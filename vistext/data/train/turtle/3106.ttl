@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "U.S. producer price index of softwood lumber made from purchased lumber from 2005 to 2018" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Price index" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2004" ;
    :yValue "111.2" ;
    :belongsTo :Chart .

