    :xValue "Dec 31, 2012" ;
    :yValue "121.2" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Dec 31, 2013" ;
    :yValue "126.4" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
