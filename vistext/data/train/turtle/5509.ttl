@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Coronavirus impact on online traffic of selected industries worldwide as of October 2020" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "industry" .

:YAxis a :Axis ;
    :title "Change in traffic" .

:DataPoint1 a :DataPoint ;
    :xValue "Supermarket" ;
    :yValue "0.348" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Retail tech" ;
    :yValue "0.07" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "Sports equipment" ;
    :yValue "0.236" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "Media" ;
    :yValue "-0.132" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "Cosmetics" ;
    :yValue "0.037" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Bank / insurance" ;
    :yValue "0.018" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Home furnishings / DIY" ;
    :yValue "-0.031" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Fashion" ;
    :yValue "-0.103" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "Telecom" ;
    :yValue "0.023" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "Jewelry & watch" ;
    :yValue "-0.082" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "Luxury" ;
    :yValue "-0.032" ;
    :belongsTo :Chart .

:DataPoint12 a :DataPoint ;
    :xValue "Tourism" ;
    :yValue "-0.437" ;
    :belongsTo :Chart .
