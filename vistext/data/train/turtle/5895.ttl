@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "U.S. Amtrak/Intercity passenger-miles from 2007 to 2019 (in millions)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "U.S. passenger-miles in millions" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2006" ;
    :yValue "5784" ;
    :belongsTo :Chart .

