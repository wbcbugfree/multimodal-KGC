@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Average retail price of fresh / frozen pork meat in the United Kingdom (UK) from 2005 to 2015 (in GBP per kilogram)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Average price per kilogram (in GBP)" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2004" ;
    :yValue "4.19" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Dec 31, 2005" ;
    :yValue "4.24" ;
    :belongsTo :Chart .

