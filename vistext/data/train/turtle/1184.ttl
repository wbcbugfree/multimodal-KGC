@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Average cost of coal for the electric power industry in the U.S. from 2005 to 2019 (in U.S. dollars per ton)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Average cost in U.S. dollars per ton" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2004" ;
    :yValue "31.2" ;
    :belongsTo :Chart .

