@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Domestic tourism expenditure in Italy from 2014 to 2029 (in billion euros)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Domestic spending in billion euros" .

:YAxis a :Axis ;
    :title "Year" .

:DataPoint1 a :DataPoint ;
    :xValue "189.2" ;
    :yValue "2029*" ;
    :belongsTo :Chart .

