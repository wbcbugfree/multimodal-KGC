@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Average penetration rate of sportswear brands in Turkey in 2012 and 2013" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Brand" .

:YAxis a :Axis ;
    :title "2013" .

:DataPoint1 a :DataPoint ;
    :xValue "Adida" ;
    :yValue "0.48" ;
    :belongsTo :Chart .

