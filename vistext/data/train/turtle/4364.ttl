@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Total employment in the United States mining industry from 1998 to 2019 (in 1,000)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Number of employees in thousands" .

