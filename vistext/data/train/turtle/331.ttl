@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "U.S. grapefruit production from 1999/2000 to 2018/2019 (in 1,000 boxes)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Production in thousand boxes" .

