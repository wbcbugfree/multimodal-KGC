@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Golden State Warriors all-time games played leaders from 1946 to 2020" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Games played" .

:YAxis a :Axis ;
    :title "Golden State Warriors Player" .

:DataPoint1 a :DataPoint ;
    :xValue "807" ;
    :yValue "Chris Mullin" ;
    :belongsTo :Chart .

