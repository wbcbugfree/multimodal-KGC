@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "ATM numbers in selected Central , Eastern and Southern European countries as of June 2019" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Country" .

:YAxis a :Axis ;
    :title "ATM numbers" .

:DataPoint1 a :DataPoint ;
    :xValue "Poland" ;
    :yValue "22885" ;
    :belongsTo :Chart .

