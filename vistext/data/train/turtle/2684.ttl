@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Gross value added (GVA) of food retailing in the United Kingdom (UK) from 2003 to 2018 (in million GBP)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "GVA in million GBP" .

