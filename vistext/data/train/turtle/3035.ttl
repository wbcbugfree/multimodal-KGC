@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "School board expenditures in Canada in 2017 , by province (in million Canadian dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Expenditure in million Canadian dollars" .

:YAxis a :Axis ;
    :title "province of Canada" .

:DataPoint1 a :DataPoint ;
    :xValue "8295.71" ;
    :yValue "Alberta" ;
    :belongsTo :Chart .

