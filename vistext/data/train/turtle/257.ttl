@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Arizona Diamondbacks all-time home run leaders as of October 2020" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Arizona Diamondbacks all-time home run leader" .

:YAxis a :Axis ;
    :title "Number of home runs" .

:DataPoint1 a :DataPoint ;
    :xValue "Luis Gonzalez" ;
    :yValue "224" ;
    :belongsTo :Chart .

