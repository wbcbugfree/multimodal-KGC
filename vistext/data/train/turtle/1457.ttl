@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Number of ornamental fish in the European Union in 2019 , by country (in 1000s)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Country" .

:YAxis a :Axis ;
    :title "Number of ornamental fish in thousands" .

:DataPoint1 a :DataPoint ;
    :xValue "France" ;
    :yValue "2600" ;
    :belongsTo :Chart .

