@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Real defense spending per capita by the United Kingdom (UK) and other NATO allies , from 2009 to 2018 (in U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "France" .

:YAxis a :Axis ;
    :title "Year" .

:DataPoint1 a :DataPoint ;
    :xValue "797.4" ;
    :yValue "2009" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "786.2" ;
    :yValue "2010" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "759.3" ;
    :yValue "2011" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "759.8" ;
    :yValue "2012" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "755.9" ;
    :yValue "2013" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "742.8" ;
    :yValue "2014" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "732.3" ;
    :yValue "2015" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "742.9" ;
    :yValue "2016" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "753" ;
    :yValue "2017" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "779.1" ;
    :yValue "2018*" ;
    :belongsTo :Chart .
