@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "U.S. cumulative installed wind power capacity from 2000 to 2018 (in megawatts)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Cumulative installed capacity in megawatts" .

