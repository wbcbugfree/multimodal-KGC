@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Primary energy consumption in the United States from 1975 to 2019 , by sector (in quadrillion British thermal units)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Transportation" .

