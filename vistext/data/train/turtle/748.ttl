@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Registered cases of human trafficking in Belgium from 2008 to 2019" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Cases of human trafficking" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2007" ;
    :yValue "369" ;
    :belongsTo :Chart .

