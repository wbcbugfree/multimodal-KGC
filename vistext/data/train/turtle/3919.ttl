@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Main export partners for Romania in 2019 , by export value (in million euros)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Exports in million euros" .

:YAxis a :Axis ;
    :title "Country" .

:DataPoint1 a :DataPoint ;
    :xValue "15.7" ;
    :yValue "Germany" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "7.83" ;
    :yValue "Italy" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "4.83" ;
    :yValue "France" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "3.38" ;
    :yValue "Hungary" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "2.62" ;
    :yValue "United Kingdom" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "2.47" ;
    :yValue "Poland" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "2.44" ;
    :yValue "Bulgaria" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "2.22" ;
    :yValue "Turkey" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "2.2" ;
    :yValue "Czech Republic" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "2.14" ;
    :yValue "Netherlands" ;
    :belongsTo :Chart .
