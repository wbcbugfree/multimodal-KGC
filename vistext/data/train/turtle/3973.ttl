@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Total revenue generated from internal travel and tourism consumption in leading countries worldwide in 2019 (in billion U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Country" .

:YAxis a :Axis ;
    :title "Internal consumption in billion U.S. dollars" .

:DataPoint1 a :DataPoint ;
    :xValue "United States" ;
    :yValue "1105" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "China" ;
    :yValue "955.6" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "Germany" ;
    :yValue "382.6" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "Japan" ;
    :yValue "261" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "India" ;
    :yValue "253.1" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "United Kingdom" ;
    :yValue "246" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Italy" ;
    :yValue "215.5" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "France" ;
    :yValue "211.7" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "Mexico" ;
    :yValue "167.2" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "Spain" ;
    :yValue "156" ;
    :belongsTo :Chart .
