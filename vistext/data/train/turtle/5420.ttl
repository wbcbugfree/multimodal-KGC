@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "McDermott International 's revenue from 2009 to 2019 (in million U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Revenue in million U.S. dollars" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2008" ;
    :yValue "3281.8" ;
    :belongsTo :Chart .

