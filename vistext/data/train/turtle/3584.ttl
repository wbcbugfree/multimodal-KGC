@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Leading eSports players worldwide as of October 2020 , by overall earnings (in million U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Earnings in million U.S. dollars" .

:YAxis a :Axis ;
    :title "eSports player" .

:DataPoint1 a :DataPoint ;
    :xValue "6.94" ;
    :yValue "N0tail (Johan Sundstein)" ;
