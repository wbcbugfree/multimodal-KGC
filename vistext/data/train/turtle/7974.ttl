@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Once the Brexit negotiations are complete and the terms of Britain 's exit from the EU have been agreed , do you think there should or should not be a referendum to accept or reject them ?" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "Should not" .

:DataPoint1 a :DataPoint ;
    :xValue "Mar 04, 2006" ;
    :yValue "0.43" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Jul 04, 2006" ;
    :yValue "0.47" ;
    :belongsTo :Chart .

