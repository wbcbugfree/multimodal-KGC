@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Advertising revenue of Google network websites from 2001 to 2019 (in billion U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Revenue in billion U.S. dollars" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2000" ;
    :yValue "0" ;
    :belongsTo :Chart .

