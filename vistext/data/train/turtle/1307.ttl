@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Net written motor premiums of the general business insurance market in the United Kingdom (UK) from 2007 to 2018 (in million GBP)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Net written premiums in million GBP" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2006" ;
    :yValue "10634" ;
    :belongsTo :Chart .

