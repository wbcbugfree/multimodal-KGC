@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Most common names among male babies born in Italy in 2018" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "male given name" .

:YAxis a :Axis ;
    :title "Number of male babies" .

