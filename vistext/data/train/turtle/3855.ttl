@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Total super PAC spending against candidates in the 2012 election , by state (in 1,000 U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Spending in thousand U.S. dollars" .

:YAxis a :Axis ;
    :title "State" .

