@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "United States : What do you think are the most important issues facing working women in this country today ?" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Share of respondents" .

:YAxis a :Axis ;
    :title "Response" .

:DataPoint1 a :DataPoint ;
    :xValue "0.39" ;
    :yValue "Equal pay/fair pay" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "0.2" ;
    :yValue "Equal opportunity for promotion, advancement/no gender discrimination" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "0.08" ;
    :yValue "Jobs/unemployment/availability of jobs" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "0.08" ;
    :yValue "Sexual harassment/better treatment, more respect in workplace" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "0.07" ;
    :yValue "Access to childcare/ better childcare" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "0.06" ;
    :yValue "Balancing work and home life" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "0.05" ;
    :yValue "Healthcare" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "0.03" ;
    :yValue "Maternity leave/family leave/ time off for family matters" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "0.02" ;
    :yValue "Abortion/access to contraception" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "0.02" ;
    :yValue "The economy (non-specific)" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "0.01" ;
    :yValue "Education/access to education" ;
    :belongsTo :Chart .

:DataPoint12 a :DataPoint ;
    :xValue "0.01" ;
    :yValue "Equal benefits" ;
    :belongsTo :Chart .

:DataPoint13 a :DataPoint ;
    :xValue "0.05" ;
    :yValue "Other" ;
    :belongsTo :Chart .

:DataPoint14 a :DataPoint ;
    :xValue "0.16" ;
    :yValue "No opinion" ;
    :belongsTo :Chart .
