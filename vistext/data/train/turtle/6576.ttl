@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Growth of advertising spending in the Middle East and North Africa (MENA) from 2010 to 2022 , by medium" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Television" .

:YAxis a :Axis ;
    :title "Year" .

:DataPoint1 a :DataPoint ;
    :xValue "-0.05" ;
    :yValue "2022*" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "0.024" ;
    :yValue "2021*" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "-0.212" ;
    :yValue "2020*" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "-0.117" ;
    :yValue "2019" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "-0.218" ;
    :yValue "2018" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "-0.085" ;
    :yValue "2017" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "-0.324" ;
    :yValue "2016" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "-0.14" ;
    :yValue "2015" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "0.213" ;
    :yValue "2014" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "0.26" ;
    :yValue "2013" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "0.239" ;
    :yValue "2012" ;
    :belongsTo :Chart .

:DataPoint12 a :DataPoint ;
    :xValue "-0.14" ;
    :yValue "2011" ;
    :belongsTo :Chart .

:DataPoint13 a :DataPoint ;
    :xValue "0.111" ;
    :yValue "2010" ;
    :belongsTo :Chart .
