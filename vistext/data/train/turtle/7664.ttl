@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Median total income of senior couple families in Canada from 2000 to 2018 , by age group (in Canadian dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "65 years and over" .

