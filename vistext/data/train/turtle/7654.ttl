@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Furniture and home furnishing sales of merchant wholesalers in the United States from 2002 to 2018 (in billion U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Manufacturers' sales branches and offices" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2001" ;
    :yValue "17.94" ;
    :belongsTo :Chart .

