@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Brand value of the leading 10 most valuable British brands in 2019 (in billion GBP)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Brand value in billion GBP" .

:YAxis a :Axis ;
    :title "Brand" .

:DataPoint1 a :DataPoint ;
    :xValue "32.8" ;
    :yValue "Shell" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "18.03" ;
    :yValue "EY" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "17.61" ;
    :yValue "BP" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "16.56" ;
    :yValue "Vodafone" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "15.68" ;
    :yValue "HSBC" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "9" ;
    :yValue "Barclays" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "8.8" ;
    :yValue "Tesco" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "8.08" ;
    :yValue "Sky" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "7.03" ;
    :yValue "Land Rover" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "6.45" ;
    :yValue "BT" ;
    :belongsTo :Chart .
