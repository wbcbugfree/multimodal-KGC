@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Leading brands in the United States on social media in 2019 , based on user engagement on owned video content (in million actions)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Leading brands on social media" .

:YAxis a :Axis ;
    :title "Number of total actions in millions" .

:DataPoint1 a :DataPoint ;
