@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Sales volume of sugar confectionery manufactured in the United Kingdom (UK) from 2008 to 2019 (in 1,000 kilograms)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Sales volume in thousand kilograms" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2007" ;
    :yValue "10807" ;
    :belongsTo :Chart .

