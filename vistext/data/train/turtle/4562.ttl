@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Ranking of the most popular blogs in Norway as of October 2020 , by number of visitors in the past day" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Number of visitors in the past day" .

:YAxis a :Axis ;
    :title "blog" .

