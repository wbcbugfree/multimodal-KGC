@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Number of mobile-only visitors to leading online retail properties in the United States in September 2018 (in millions)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "leading online retail properties" .

:YAxis a :Axis ;
    :title "Number of mobile-only visitors in millions" .

:DataPoint1 a :DataPoint ;
    :xValue "Amazon" ;
    :yValue "63" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Walmart" ;
    :yValue "54" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "eBay" ;
    :yValue "43" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "Target" ;
    :yValue "32" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "Groupon" ;
    :yValue "30" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Etsy" ;
    :yValue "20" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "The Home Depot" ;
    :yValue "20" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Kohl's" ;
    :yValue "18" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "Best Buy" ;
    :yValue "17" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "Coupons.com" ;
    :yValue "13" ;
    :belongsTo :Chart .
