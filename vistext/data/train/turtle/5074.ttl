@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Motorcycle fleet size in Mexico from 2010 to 2019 (in 1,000 units)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Number of motorcycles in thousand units" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2009" ;
    :yValue "1154.15" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Dec 31, 2010" ;
    :yValue "1313.12" ;
    :belongsTo :Chart .

