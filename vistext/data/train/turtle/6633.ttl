@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Namibia : Share of economic sectors in the gross domestic product (GDP) from 2009 to 2019" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Industry" .

