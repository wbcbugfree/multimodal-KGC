@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Per capita consumption of peas , nuts and similar products in Norway in selected years from 1979 to 2019 (in kilograms)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Per capita consumption in kilograms" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 1978" ;
    :yValue "7.1" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Dec 31, 1988" ;
    :yValue "8.5" ;
    :belongsTo :Chart .

