@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Impact of single currency euro on the difficulty and cost of travel within the eurozone from 2010 to 2019 , by aspects of travel" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "Has made travelling easier and less costly" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2009" ;
    :yValue "0.48" ;
    :belongsTo :Chart .

