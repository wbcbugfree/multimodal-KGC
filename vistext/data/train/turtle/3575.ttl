@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Amount of cash deposited into the European Stability Mechanism (ESM) by European countries" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Cash amount (in billion euros)" .

:YAxis a :Axis ;
    :title "Country" .

:DataPoint1 a :DataPoint ;
    :xValue "21.7" ;
    :yValue "Germany" ;
    :belongsTo :Chart .

