@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Most popular Sesame Street character among adults in the United States as of October 2019" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Share of respondents" .

:YAxis a :Axis ;
    :title "Response" .

:DataPoint1 a :DataPoint ;
    :xValue "0.16" ;
    :yValue "Cookie Monster" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "0.13" ;
    :yValue "Elmo" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "0.11" ;
    :yValue "Big Bird" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "0.09" ;
    :yValue "Oscar the Grouch" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "0.05" ;
    :yValue "Grover" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "0.04" ;
    :yValue "Count von Count" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "0.04" ;
    :yValue "Mr. Snuffleupagus" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "0.04" ;
    :yValue "Ernie" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "0.03" ;
    :yValue "Bert" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "0.01" ;
    :yValue "Abby" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "0.01" ;
    :yValue "Other" ;
    :belongsTo :Chart .
