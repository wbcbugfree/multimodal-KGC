@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Revenue of Marks & Spencer worldwide from 2010 to 2020 (in million GBP)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Revenue in million GBP" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2009" ;
    :yValue "9536.6" ;
    :belongsTo :Chart .

