@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Forecast volume of rice imported to the European Union (EU 27) from 2015 to 2029 (in 1,000 tonnes)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Volume in thousand tonnes" .

:DataPoint1 a :DataPoint ;
    :xValue "2029*" ;
    :yValue "1648" ;
    :belongsTo :Chart .

