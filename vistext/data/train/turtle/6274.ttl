@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Mean earnings in the United States from 2005 to 2019 , by highest educational degree earned" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Level of Education" .

:YAxis a :Axis ;
    :title "Associate Degree" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2004" ;
    :yValue "37990" ;
    :belongsTo :Chart .

