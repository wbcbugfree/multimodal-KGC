@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Monthly sales of stationery , office supplies , cards , gift wrap and party supplies at large retailers in Canada from 2014 to 2016 (in million Canadian dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "2016" .

:YAxis a :Axis ;
    :title "Month" .

:DataPoint1 a :DataPoint ;
    :xValue "98.68" ;
    :yValue "Dec" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "68.75" ;
    :yValue "Nov" ;
    :belongsTo :Chart .

