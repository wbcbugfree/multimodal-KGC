@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "What types of toys will you purchase this year ?" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Share of respondents" .

:YAxis a :Axis ;
    :title "Response" .

:DataPoint1 a :DataPoint ;
    :xValue "0.45" ;
    :yValue "Children's books" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "0.36" ;
    :yValue "Games for consoles" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "0.3" ;
    :yValue "Board games" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "0.29" ;
    :yValue "Dolls" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "0.28" ;
    :yValue "Arts and crafts" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "0.21" ;
    :yValue "Building blocks and bricks" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "0.21" ;
    :yValue "Sports equipment" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "0.2" ;
    :yValue "Handheld electronic games" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "0.12" ;
    :yValue "Game consoles" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "0.26" ;
    :yValue "Something else" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "0.21" ;
    :yValue "Not sure" ;
    :belongsTo :Chart .
