@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Number of high net worth individuals in the United Kingdom (UK) and Europe from 2009 to 2019 (in 1,000s)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "United Kingdom" .

:DataPoint1 a :DataPoint ;
    :xValue "2019" ;
    :yValue "591" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "2018" ;
    :yValue "556" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "2017*" ;
    :yValue "575" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "2016" ;
    :yValue "568.3" ;
    :belongsTo :Chart .

