    :xValue "1814" ;
    :yValue "Texas" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "1363" ;
    :yValue "Michigan" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "1191" ;
    :yValue "Washington" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "1170" ;
