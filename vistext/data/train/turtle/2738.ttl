@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "U.S. states with the largest stock of honey in 2019 (in 1,000 pounds)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Stocks in thousand pounds" .

:YAxis a :Axis ;
    :title "State" .

:DataPoint1 a :DataPoint ;
    :xValue "7582" ;
    :yValue "South Dakota" ;
    :belongsTo :Chart .

