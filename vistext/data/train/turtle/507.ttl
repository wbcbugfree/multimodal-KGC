@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Total number of adult correctional population in the United States in from 2005 to 2018" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Number of people" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2004" ;
    :yValue "7.06" ;
    :belongsTo :Chart .

