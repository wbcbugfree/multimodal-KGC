@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Gross domestic product of Yukon , Canada in 2019 , by industry (in million chained 2012 Canadian dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "industry" .

:YAxis a :Axis ;
    :title "GDP in million chained 2012 Canadian dollars" .

