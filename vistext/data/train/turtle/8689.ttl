@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Major countries in worldwide cement production from 2015 to 2019 (in million metric tons)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "2016" .

:YAxis a :Axis ;
    :title "Country" .

:DataPoint1 a :DataPoint ;
    :xValue "2410" ;
    :yValue "China" ;
    :belongsTo :Chart .

