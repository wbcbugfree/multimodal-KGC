@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Number of social network users in selected countries in 2020 and 2025 (in millions)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Country" .

:YAxis a :Axis ;
    :title "2025*" .

