@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Number of licensed taxis in London , and England (excluding London) and Wales between 1999 and 2019 (in 1,000)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "England/Wales" .

:YAxis a :Axis ;
    :title "Year" .

:DataPoint1 a :DataPoint ;
    :xValue "55.4" ;
    :yValue "2019" ;
    :belongsTo :Chart .

