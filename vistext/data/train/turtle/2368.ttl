@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Overall investments value in companies in Greece between 2005 and 2015 , by country (in billion U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Investment value in billion U.S. dollars" .

:YAxis a :Axis ;
    :title "Country" .

:DataPoint1 a :DataPoint ;
    :xValue "8.7" ;
    :yValue "Germany" ;
    :belongsTo :Chart .

