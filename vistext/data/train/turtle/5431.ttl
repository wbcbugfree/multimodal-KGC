@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Share of children in total population in Malaysia from 2005 to 2019" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "Percentage of total population" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2004" ;
    :yValue "0.3" ;
    :belongsTo :Chart .

