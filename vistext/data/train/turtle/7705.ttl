@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Total area of sugar beet plantings and harvestings in the U.S. from 2000 to 2019 (in 1,000 acres)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Harvested" .

