@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Number of Asian families with a single mother in the U.S. from 2002 to 2019 (in 1,000s)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Families in thousands" .

