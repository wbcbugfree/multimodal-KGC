@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Direct and total contribution of travel and tourism to GDP from 2006 to 2019 (in billion U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Total contribution" .

