@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Ebola cases and deaths related to outbreaks in West African countries as of March 30 , 2016" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Country" .

:YAxis a :Axis ;
    :title "Deaths" .

:DataPoint1 a :DataPoint ;
    :xValue "Guinea" ;
    :yValue "2543" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Liberia" ;
    :yValue "4809" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "Sierra Leone" ;
    :yValue "3956" ;
    :belongsTo :Chart .

