    :xValue "Spain" ;
    :yValue "0" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "United States" ;
    :yValue "1" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Mali" ;
    :yValue "6" ;
