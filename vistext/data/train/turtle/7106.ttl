@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Number of bars , dance clubs and music venues in selected German cities in 2016 , by type" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Piano bars" .

:YAxis a :Axis ;
    :title "German cities" .

:DataPoint1 a :DataPoint ;
    :xValue "2" ;
    :yValue "Cologne" ;
    :belongsTo :Chart .

