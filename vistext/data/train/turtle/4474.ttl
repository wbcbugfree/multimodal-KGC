@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "U.S. honey imports in 2018 , by country of origin (in metric tons)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Country" .

:YAxis a :Axis ;
    :title "Imports in metric tons" .

:DataPoint1 a :DataPoint ;
    :xValue "India" ;
    :yValue "44298" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Vietnam" ;
    :yValue "39193" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "Argentina" ;
    :yValue "36219" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "Brazil" ;
    :yValue "23604" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "Canada" ;
    :yValue "15244" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "China" ;
    :yValue "13436" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Ukraine" ;
    :yValue "8324" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Thailand" ;
    :yValue "4676" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "Mexico" ;
    :yValue "3315" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "Turkey" ;
    :yValue "2314" ;
    :belongsTo :Chart .
