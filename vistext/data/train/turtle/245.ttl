@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Taiwan : Employment from 2010 to 2020 (in millions)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Employment in millions" .

:YAxis a :Axis ;
    :title "Year" .

:DataPoint1 a :DataPoint ;
    :xValue "11.54" ;
    :yValue "2020*" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "11.49" ;
    :yValue "2019*" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "11.43" ;
    :yValue "2018" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "11.35" ;
    :yValue "2017" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "11.27" ;
    :yValue "2016" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "11.2" ;
    :yValue "2015" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "11.08" ;
    :yValue "2014" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "10.97" ;
    :yValue "2013" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "10.86" ;
    :yValue "2012" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "10.71" ;
    :yValue "2011" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "10.49" ;
    :yValue "2010" ;
    :belongsTo :Chart .
