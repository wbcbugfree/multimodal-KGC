@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Number of user data requests issued to Google from federal agencies and governments during 2nd half 2019 , by country" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Amount of user data requests" .

:YAxis a :Axis ;
    :title "Country" .

