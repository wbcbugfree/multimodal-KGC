@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Share of energy from renewable sources in gross final energy consumption in Germany from 2006 to 2016" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "Share of gross final consumption" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2005" ;
    :yValue "0.077" ;
    :belongsTo :Chart .

