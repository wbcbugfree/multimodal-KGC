@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Number of deaths due to the world 's major volcanic eruptions from 1900 to 2016" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Volcanic eruption" .

:YAxis a :Axis ;
    :title "Death toll" .

:DataPoint1 a :DataPoint ;
    :xValue "Volcanic eruption on Martinique, (May 8, 1902)" ;
    :yValue "30000" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Volcanic eruption in Colombia, (November 13, 1985)" ;
    :yValue "21800" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "Volcanic eruption in Guatemala (October 24, 1902)" ;
    :yValue "6000" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "Volcano eruption in Indonesia (1909)" ;
    :yValue "5500" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "Volcano eruption in Indonesia (May 1919)" ;
    :yValue "5000" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Volcanic eruption in Guatemala (1929)" ;
    :yValue "5000" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Volcanic eruption in Papua New Guinea (January 15, 1951)" ;
    :yValue "3000" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Volcanic eruption in Cameroon (August 24, 1986)" ;
    :yValue "1746" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "Volcano eruption in Indonesia (January 3, 1963)" ;
    :yValue "1584" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "Volcanic eruption on St. Vincentund the Grenadines (May 7, 1902)" ;
    :yValue "1565" ;
    :belongsTo :Chart .
