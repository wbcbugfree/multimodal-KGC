@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Consumer preferred channels of brand communication during the coronavirus pandemic worldwide as of March 2020 , by country" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Instagram" .

:YAxis a :Axis ;
    :title "Response" .

:DataPoint1 a :DataPoint ;
    :xValue "0.21" ;
    :yValue "Average" ;
    :belongsTo :Chart .

