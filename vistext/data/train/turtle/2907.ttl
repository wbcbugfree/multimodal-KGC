@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Annual consumption volume of tomatoes in Austria from 2008/09 to 2017/18 (in tonnes)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Consumption volume in tonnes" .

:YAxis a :Axis ;
    :title "Year" .

:DataPoint1 a :DataPoint ;
    :xValue "255625" ;
    :yValue "2017/18" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "255966" ;
    :yValue "2016/17" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "251331" ;
    :yValue "2015/16" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "240751" ;
    :yValue "2014/15" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "252283" ;
    :yValue "2013/14" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "237288" ;
    :yValue "2012/13" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "234171" ;
    :yValue "2011/12" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "228716" ;
    :yValue "2010/11" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "212540" ;
    :yValue "2009/10" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "211364" ;
    :yValue "2008/09" ;
    :belongsTo :Chart .
