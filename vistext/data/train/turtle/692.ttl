@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Medicaid spending history and forecast in the United States from 2018 to 2029 (as a percentage of the GDP)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Percentage of GDP" .

:YAxis a :Axis ;
    :title "Response" .

:DataPoint1 a :DataPoint ;
    :xValue "0.023" ;
    :yValue "'29" ;
    :belongsTo :Chart .

