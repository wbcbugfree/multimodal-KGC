@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Total revenues of MetLife from 2008 to 2019 (in billion U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Revenues in billion U.S. dollars" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2007" ;
    :yValue "50.56" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Dec 31, 2008" ;
    :yValue "40.64" ;
    :belongsTo :Chart .

