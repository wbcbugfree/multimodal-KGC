@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Net revenue generated by World Wrestling Entertainment worldwide from 2013 to 2017 , by region (in million U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Rest of the world" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2008" ;
    :yValue "127.1" ;
    :belongsTo :Chart .

