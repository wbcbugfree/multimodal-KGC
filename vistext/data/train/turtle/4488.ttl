@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "San Francisco Giants all-time home run leaders as of October 2020" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Number of home runs" .

:YAxis a :Axis ;
    :title "player" .

:DataPoint1 a :DataPoint ;
    :xValue "646" ;
    :yValue "Willie Mays" ;
    :belongsTo :Chart .

