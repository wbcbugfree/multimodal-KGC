@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Revenue of Reliance Petrochemicals from financial year 2010 to 2020 (in billion Indian rupees)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Revenue in billion Indian rupees" .

:YAxis a :Axis ;
    :title "Year" .

:DataPoint1 a :DataPoint ;
    :xValue "1452.64" ;
    :yValue "FY 2020" ;
    :belongsTo :Chart .

