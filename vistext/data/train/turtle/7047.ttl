@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Rates of reported cases of gonorrhea in the United States in 2018 , by age and gender (per 100,000 population)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Age in years" .

:YAxis a :Axis ;
    :title "Women" .

:DataPoint1 a :DataPoint ;
    :xValue "10-14" ;
    :yValue "21.3" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "15-19" ;
    :yValue "548.1" ;
    :belongsTo :Chart .

