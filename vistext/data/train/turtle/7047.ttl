    :xValue "20-24" ;
    :yValue "702.6" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "25-29" ;
    :yValue "427.2" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "30-34" ;
    :yValue "248.3" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "35-39" ;
    :yValue "139.1" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "40-44" ;
    :yValue "74.3" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "45-54" ;
    :yValue "28.6" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "55-64" ;
    :yValue "7.7" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "above 65" ;
    :yValue "1" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "Total" ;
    :yValue "145.8" ;
    :belongsTo :Chart .
