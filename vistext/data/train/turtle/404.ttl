@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Countries with the highest density of nursing and midwifery personnel worldwide in the period 2009 - 2018 (per 10,000 population)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Personnel per 10,000 population" .

:YAxis a :Axis ;
    :title "Country" .

:DataPoint1 a :DataPoint ;
    :xValue "202.6" ;
    :yValue "Monaco" ;
    :belongsTo :Chart .

