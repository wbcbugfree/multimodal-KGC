@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Average price of games consoles and video games in Germany from 2005 to 2019 (in euros)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Consoles" .

:DataPoint1 a :DataPoint ;
    :xValue "2019" ;
    :yValue "265" ;
    :belongsTo :Chart .

