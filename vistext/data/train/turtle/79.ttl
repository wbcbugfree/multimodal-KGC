@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Favorite takeaway cuisine among consumers in the United Kingdom (UK) in 2017" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "Share of respondents" .

:DataPoint1 a :DataPoint ;
    :xValue "Chinese" ;
    :yValue "0.35" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Indian" ;
    :yValue "0.24" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "Pizza" ;
    :yValue "0.13" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "Fish and Chips" ;
    :yValue "0.07" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "English" ;
    :yValue "0.04" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Italian" ;
    :yValue "0.04" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Kebabs/Burgers" ;
    :yValue "0.03" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Thai" ;
    :yValue "0.02" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "Mexican" ;
    :yValue "0.01" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "Turkish" ;
    :yValue "0.01" ;
    :belongsTo :Chart .
