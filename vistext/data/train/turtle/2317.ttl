@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Number of foreigners in the Italian province of Rome in 2018 , by country of origin" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Country" .

:YAxis a :Axis ;
    :title "Number of foreigners" .

