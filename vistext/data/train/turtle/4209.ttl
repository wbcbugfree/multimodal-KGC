@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Sri Lanka : Urbanization from 2009 to 2019" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "Share of urban population in total population" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2008" ;
    :yValue "0.1824" ;
    :belongsTo :Chart .

