@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Android operating system share worldwide by OS version from 2013 to 2020" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Ice Cream Sandwich 4.0.3 - 4.0.4" .

:YAxis a :Axis ;
    :title "Android platform version" .

:DataPoint1 a :DataPoint ;
    :xValue "0.002" ;
    :yValue "1H '20" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "0.003" ;
    :yValue "1H '19" ;
    :belongsTo :Chart .

