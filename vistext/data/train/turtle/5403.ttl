@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "LafargeHolcim 's net sales from FY 2007 to FY 2019 (in billion Swiss francs)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Revenue in billion Swiss francs" .

:DataPoint1 a :DataPoint ;
    :xValue "2019" ;
    :yValue "26.72" ;
    :belongsTo :Chart .

