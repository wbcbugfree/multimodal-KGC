@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Real interest rates in Indonesia from 2007 to 2019" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Real interest rates" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2006" ;
    :yValue "0.0234" ;
    :belongsTo :Chart .

