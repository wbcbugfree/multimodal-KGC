@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Number of Mensa members in selected countries 2010" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Country" .

:YAxis a :Axis ;
    :title "Number of members" .

:DataPoint1 a :DataPoint ;
    :xValue "United States" ;
    :yValue "50000" ;
    :belongsTo :Chart .

