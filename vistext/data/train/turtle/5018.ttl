@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Cities in the United Kingdom (UK) with the greatest numbers of high-rise buildings in 2016" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "city" .

:YAxis a :Axis ;
    :title "Number of highrise buildings" .

:DataPoint1 a :DataPoint ;
    :xValue "London" ;
    :yValue "604" ;
    :belongsTo :Chart .

