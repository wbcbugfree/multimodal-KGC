@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Which sites or services have you used in the past three months to stream/access , or share music tracks or albums through the internet ?" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Share of respondents" .

:YAxis a :Axis ;
    :title "Response" .

:DataPoint1 a :DataPoint ;
    :xValue "0.62" ;
    :yValue "YouTube" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "0.36" ;
    :yValue "Spotify" ;
    :belongsTo :Chart .

