@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Per capita personal income in New England from 2000 to 2019 (in current U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "years" .

:YAxis a :Axis ;
    :title "Income in U.S. dollars" .

