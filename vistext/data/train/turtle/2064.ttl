@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Number of immigrants in reception centers in Italy as of November 2020 , by region" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Number of immigrants" .

:YAxis a :Axis ;
    :title "region of Italy" .

