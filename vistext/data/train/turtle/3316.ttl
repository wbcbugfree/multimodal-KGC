    :xValue "17" ;
    :yValue "Arizona" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "14.9" ;
    :yValue "New York" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "14.2" ;
    :yValue "Florida" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "9.7" ;
    :yValue "Massachusetts" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "6.1" ;
