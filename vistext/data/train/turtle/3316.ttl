@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Newly installed capacity of energy storage in the United States in 2018 , by select state (in megawatts)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Capacity in megawatts" .

:YAxis a :Axis ;
    :title "State" .

:DataPoint1 a :DataPoint ;
    :xValue "146.9" ;
    :yValue "California" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "36.8" ;
    :yValue "Hawaii" ;
    :belongsTo :Chart .

