@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Average monthly data volume per mobile internet subscription in Germany from 2009 to 2020 (in megabytes)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Data volume in megabytes per month" .

:YAxis a :Axis ;
    :title "Year" .

:DataPoint1 a :DataPoint ;
    :xValue "3000" ;
    :yValue "2020" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "2059.995" ;
    :yValue "2019" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "1600.005" ;
    :yValue "2018" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "870" ;
    :yValue "2017" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "591" ;
    :yValue "2016" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "403.995" ;
    :yValue "2015" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "289.005" ;
    :yValue "2014" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "195" ;
    :yValue "2013" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "114" ;
    :yValue "2012" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "76.005" ;
    :yValue "2011" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "52.005" ;
    :yValue "2010" ;
    :belongsTo :Chart .

:DataPoint12 a :DataPoint ;
    :xValue "27" ;
    :yValue "2009" ;
    :belongsTo :Chart .
