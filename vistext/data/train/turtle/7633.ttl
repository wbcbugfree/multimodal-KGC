@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Impact of the coronavirus (COVID-19) outbreak on the labor market indicators in Romania from October 2019 to September 2020" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Number of employees" .

:YAxis a :Axis ;
    :title "Month" .

:DataPoint1 a :DataPoint ;
    :xValue "-0.013" ;
    :yValue "Sep '20" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "-0.015" ;
    :yValue "Aug '20" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "-0.018" ;
    :yValue "Jul '20" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "-0.017" ;
    :yValue "Jun '20" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "-0.017" ;
    :yValue "May '20" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "-0.014" ;
    :yValue "Apr '20" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "0" ;
    :yValue "Mar '20" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "0.005" ;
    :yValue "Feb '20" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "0.006" ;
    :yValue "Jan '20" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "0.009" ;
    :yValue "Dec '19" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "0.008" ;
    :yValue "Nov '19" ;
    :belongsTo :Chart .

:DataPoint12 a :DataPoint ;
    :xValue "0.009" ;
    :yValue "Oct '19" ;
    :belongsTo :Chart .
