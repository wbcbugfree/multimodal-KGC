@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Share of Dollar General 's merchandise sales in the United States from 2009 to 2019 , by product category" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Seasonal" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2008" ;
    :yValue "0.145" ;
    :belongsTo :Chart .

