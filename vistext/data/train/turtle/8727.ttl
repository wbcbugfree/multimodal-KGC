@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Cumulative number of coronavirus (COVID-19) cases , active cases , recoveries , and deaths in Russia as of December 26 , 2020 , by date of report" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Active cases" .

