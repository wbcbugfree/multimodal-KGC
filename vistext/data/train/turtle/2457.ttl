@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Leading chain restaurants in systemwide sales growth in the United States in 2013" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "chain restaurants" .

:YAxis a :Axis ;
    :title "Year-over-year sales growth" .

:DataPoint1 a :DataPoint ;
    :xValue "Jersey Mike's Subs" ;
    :yValue "0.212" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Yard House" ;
    :yValue "0.201" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "Wingstop" ;
    :yValue "0.198" ;
    :belongsTo :Chart .

