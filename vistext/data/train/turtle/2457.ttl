    :xValue "Chipotle Mexican Grill" ;
    :yValue "0.173" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "Casey's General Stores" ;
    :yValue "0.161" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Jimmy John’s Gourmet Sandwiches" ;
    :yValue "0.161" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Noodles & Company" ;
    :yValue "0.151" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Firehouse Subs" ;
