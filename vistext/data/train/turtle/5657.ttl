@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Leading national soccer team players in Brazil as of November 2020 , by market value (in million U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Market value in million U.S. dollars" .

:YAxis a :Axis ;
    :title "player name and position" .

:DataPoint1 a :DataPoint ;
    :xValue "140.8" ;
    :yValue "Neymar (LW)" ;
    :belongsTo :Chart .

