    :xValue "135" ;
    :yValue "Sun holidays" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "110" ;
    :yValue "Weekend breaks" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "110" ;
    :yValue "Last minute holdiays" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "90.5" ;
    :yValue "Holiday" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
