@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Total regular season home attendance of the NFL Green Bay Packers franchise from 2006 to 2019" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Home attendance" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2005" ;
    :yValue "565744" ;
    :belongsTo :Chart .

