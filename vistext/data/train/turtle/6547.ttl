@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Number of available apps in the Apple App Store from 2008 to 2020" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Apps" .

