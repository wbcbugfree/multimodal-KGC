@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Favourite activities of German holidaymakers while on holiday in Germany in 2019" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "Share of respondents" .

:DataPoint1 a :DataPoint ;
    :xValue "Visting cultural/ historical attractions" ;
    :yValue "0.58" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Being amongst nature" ;
    :yValue "0.56" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "Walking around" ;
    :yValue "0.36" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "Enjoying typical dishes and drinks" ;
    :yValue "0.35" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "Spending time with family/ partner/ friends" ;
    :yValue "0.35" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Attending events" ;
    :yValue "0.3" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Hiking" ;
    :yValue "0.28" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Activities in/ on/ by the water" ;
    :yValue "0.18" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "Shopping" ;
    :yValue "0.17" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "Visting 'experience' facilities" ;
    :yValue "0.16" ;
    :belongsTo :Chart .
