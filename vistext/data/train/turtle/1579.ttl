@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Leading exporting countries of office supplies worldwide in 2018 (in million U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Export value in million U.S. dollars" .

:YAxis a :Axis ;
    :title "Country" .

:DataPoint1 a :DataPoint ;
    :xValue "3942.1" ;
    :yValue "China" ;
    :belongsTo :Chart .

