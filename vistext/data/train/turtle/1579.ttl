    :xValue "970.9" ;
    :yValue "France" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "856.6" ;
    :yValue "United Kingdom" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "671.9" ;
    :yValue "United States" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "473.3" ;
    :yValue "Mexico" ;
