@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Number of state and federal prisoners in private facilities in the United States from 2000 to 2018 , by prison location" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Out-of-state private prisons" .

