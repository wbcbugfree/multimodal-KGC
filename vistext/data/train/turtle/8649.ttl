@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Leading footwear retailers , ranked by market share in the United Kingdom (UK) in 2007 and 2012" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Leading footwear retailers" .

:YAxis a :Axis ;
    :title "2012*" .

