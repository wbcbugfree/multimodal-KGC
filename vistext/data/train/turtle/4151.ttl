@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Toyota 's total assets from FY 2009 to FY 2020 (in million yen)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Total assets in million yen" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2008" ;
    :yValue "29062037" ;
    :belongsTo :Chart .

