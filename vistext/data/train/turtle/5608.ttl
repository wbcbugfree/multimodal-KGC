@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Total assets of the Industrial and Commercial Bank of China from 2008 to 2019 (in billion yuan)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Total assets in billion yuan" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2007" ;
    :yValue "9757.1" ;
    :belongsTo :Chart .

