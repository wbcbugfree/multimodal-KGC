    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Attitudes towards reading" .

:YAxis a :Axis ;
    :title "2016" .

:DataPoint1 a :DataPoint ;
    :xValue "The more I read, the better I becom" ;
    :yValue "0.82" ;
    :belongsTo :Chart .

