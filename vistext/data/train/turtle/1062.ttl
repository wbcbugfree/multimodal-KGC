@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Number of employees of the forestry and logging industry in Canada in 2019 , by region (in 1,000s)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Number of employees in thousands" .

:YAxis a :Axis ;
    :title "province of Canada" .

:DataPoint1 a :DataPoint ;
    :xValue "0.2" ;
    :yValue "Prince Edward Island" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "0.7" ;
    :yValue "Manitoba" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "0.7" ;
    :yValue "Saskatchewan" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "0.9" ;
    :yValue "Newfoundland and Labrador" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "2" ;
    :yValue "Nova Scotia" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "3.6" ;
    :yValue "Alberta" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "3.6" ;
    :yValue "New Brunswick" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "5" ;
    :yValue "Ontario" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "14.3" ;
    :yValue "Quebec" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "16.1" ;
    :yValue "British Columbia" ;
    :belongsTo :Chart .
