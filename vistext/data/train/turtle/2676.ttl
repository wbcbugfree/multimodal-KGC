@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Value added of U.S. machinery manufacturing between 2008 and 2018 (in billion U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Value added in billion U.S. dollars" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2007" ;
    :yValue "131.6" ;
    :belongsTo :Chart .

