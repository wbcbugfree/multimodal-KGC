@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Big data revenue worldwide from 2016 to 2027 , by major segment (in billion U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Software" .

:DataPoint1 a :DataPoint ;
    :xValue "2027*" ;
    :yValue "46" ;
    :belongsTo :Chart .

