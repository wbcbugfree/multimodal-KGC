@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Enterprise-value-to-EBITDA (EV/EBITDA) of leading online travel companies worldwide from 2019 to 2021" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "2021*" .

:YAxis a :Axis ;
    :title "Factor" .

:DataPoint1 a :DataPoint ;
    :xValue "8.4" ;
    :yValue "Despegar.com (Argentina)" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "7.5" ;
    :yValue "Holidaycheck (Germany)" ;
    :belongsTo :Chart .

