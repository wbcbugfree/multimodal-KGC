@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Average consumer spending on Super Bowl Sunday in the United States from 2011 to 2020 (in U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Planned spending in U.S. dollars" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2010" ;
    :yValue "71.51" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Dec 31, 2011" ;
    :yValue "76.37" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "Dec 31, 2012" ;
    :yValue "82.3" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "Dec 31, 2013" ;
    :yValue "79.12" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "Dec 31, 2014" ;
    :yValue "89.05" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Dec 31, 2015" ;
    :yValue "82.19" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Dec 31, 2016" ;
    :yValue "75" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Dec 31, 2017" ;
    :yValue "81" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "Dec 31, 2018" ;
    :yValue "81" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "Dec 31, 2019" ;
    :yValue "88.65" ;
    :belongsTo :Chart .
