@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Ten most popular FC Internazionale players on Facebook as of October 2020 (in 1,000 likes)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Player" .

:YAxis a :Axis ;
    :title "Number of Facebook page likes in thousands" .

:DataPoint1 a :DataPoint ;
    :xValue "Alexis Sánchez" ;
    :yValue "4900" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Romelu Lukaku" ;
    :yValue "2900" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "Ashley Young" ;
    :yValue "2480" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "Radja Nainggolan" ;
    :yValue "592.8" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "Kwadwo Asamoah" ;
    :yValue "556.2" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Matteo Darmian" ;
    :yValue "314.7" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Stefan De Vrij" ;
    :yValue "244.3" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Danilo D'Ambrosio" ;
    :yValue "198.7" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "Ivan Perisic" ;
    :yValue "165.9" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "Andrea Ranocchia" ;
    :yValue "94" ;
    :belongsTo :Chart .
