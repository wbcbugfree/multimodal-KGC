@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Distribution of the leading natural rubber exporting countries in 2019" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Share of global exports" .

:YAxis a :Axis ;
    :title "Response" .

:DataPoint1 a :DataPoint ;
    :xValue "0.315" ;
    :yValue "Thailand" ;
    :belongsTo :Chart .

