@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "U.S. states with the highest average price for wheat in 2018 (in U.S. dollars per bushel)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "State" .

:YAxis a :Axis ;
    :title "Price per bushel in U.S. dollars" .

:DataPoint1 a :DataPoint ;
    :xValue "Arizona" ;
    :yValue "7.01" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "California" ;
    :yValue "6.39" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "Utah" ;
    :yValue "6" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "Oregon" ;
    :yValue "5.8" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "Pennsylvania" ;
    :yValue "5.3" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Minnesota" ;
    :yValue "5.25" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Montana" ;
    :yValue "5.24" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "South Dakota" ;
    :yValue "5.24" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "North Dakota" ;
    :yValue "5.09" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "Ohio" ;
    :yValue "5.08" ;
    :belongsTo :Chart .
