@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Total number of air traffic passengers traveling to or from the United States from 2006 to 2020 (in million passengers)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Millions of passengers" .

:DataPoint1 a :DataPoint ;
    :xValue "2020*" ;
    :yValue "259" ;
    :belongsTo :Chart .

