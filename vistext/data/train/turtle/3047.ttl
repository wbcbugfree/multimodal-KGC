@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "U.S. imports of edible fishery products from 1940 to 2018 (in metric tons)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Imports in metric tons" .

