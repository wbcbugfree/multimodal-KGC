@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Value of tea and coffee exported from India from financial year 2011 to 2020 (in billion Indian rupees)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "year" .

:YAxis a :Axis ;
    :title "Tea" .

:DataPoint1 a :DataPoint ;
    :xValue "FY 2020" ;
    :yValue "58.51" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "FY 2019" ;
    :yValue "58.28" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "FY 2018" ;
    :yValue "53.96" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "FY 2017" ;
    :yValue "49.1" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "FY 2016" ;
    :yValue "47.2" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "FY 2015" ;
    :yValue "41.71" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "FY 2014" ;
    :yValue "48.73" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "FY 2013" ;
    :yValue "47.19" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "FY 2012" ;
    :yValue "40.79" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "FY 2011" ;
    :yValue "33.54" ;
    :belongsTo :Chart .
