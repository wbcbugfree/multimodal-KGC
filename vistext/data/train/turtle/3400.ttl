@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Proved crude oil reserves in Venezuela from 2009 to 2019 (in billion barrels)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Oil reserves in billion barrels" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2008" ;
    :yValue "99.38" ;
    :belongsTo :Chart .

