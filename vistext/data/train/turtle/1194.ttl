@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Number of WhatsApp downloads from the Apple App Store worldwide in 3rd quarter 2020 , by country (in millions)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Country" .

:YAxis a :Axis ;
    :title "Number of downloads in millions" .

:DataPoint1 a :DataPoint ;
    :xValue "United States" ;
    :yValue "3.1" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "United Kingdom" ;
    :yValue "2.45" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "Indonesia" ;
    :yValue "2.29" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "Brazil" ;
    :yValue "1.97" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "Russia" ;
    :yValue "1.86" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Mexico" ;
    :yValue "1.59" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Germany" ;
    :yValue "1.57" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "India" ;
    :yValue "1.47" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "Turkey" ;
    :yValue "1.29" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "France" ;
    :yValue "1.13" ;
    :belongsTo :Chart .
