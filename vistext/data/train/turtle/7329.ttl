@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Fastest growing household products online sales growth during the coronavirus (COVID-19) outbreak in Russia from January to March 2020 , by product" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "09.03-15.03" .

:YAxis a :Axis ;
    :title "household products" .

:DataPoint1 a :DataPoint ;
    :xValue "1.97" ;
    :yValue "Bathroom cleaning products" ;
    :belongsTo :Chart .

