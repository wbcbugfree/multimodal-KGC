    :yValue "Laundry detergents" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "1.37" ;
    :yValue "Kitchen paper" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "1.36" ;
    :yValue "Floor cleaning products" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
