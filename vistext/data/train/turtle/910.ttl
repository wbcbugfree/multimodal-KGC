@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Ranking of the highest-paid CEOs in the United States as of 2019 (in million U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Compensation in million U.S. dollars" .

:YAxis a :Axis ;
    :title "highest-paid CEOs" .

:DataPoint1 a :DataPoint ;
    :xValue "58.53" ;
    :yValue "Lisa T. Su (AMD)" ;
    :belongsTo :Chart .

