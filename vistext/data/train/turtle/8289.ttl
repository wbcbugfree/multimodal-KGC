@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "In your view , should immigration be kept at its present level , increased or decreased ?" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "Increased" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2005" ;
    :yValue "0.17" ;
    :belongsTo :Chart .

