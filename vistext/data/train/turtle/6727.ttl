@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Regional unemployment rate in Italy in 2019 , by gender" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Women" .

:YAxis a :Axis ;
    :title "region of Italy" .

