@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Greece : Distribution of the workforce across economic sectors from 2010 to 2020" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Services" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2009" ;
    :yValue "0.6802" ;
    :belongsTo :Chart .

