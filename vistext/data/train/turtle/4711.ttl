@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Value of the leading leather goods importers worldwide in 2013 (in million U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Import value in million U.S. dollars" .

:YAxis a :Axis ;
    :title "Country" .

:DataPoint1 a :DataPoint ;
    :xValue "13419" ;
    :yValue "United States" ;
    :belongsTo :Chart .

