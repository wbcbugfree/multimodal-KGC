@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "U.S. petroleum imports from the Persian Gulf as a share of total imports between 2000 and 2019" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Imports from the Persian Gulf" .

