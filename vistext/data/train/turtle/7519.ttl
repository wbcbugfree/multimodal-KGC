@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Quarterly revenue of the information technology security market from 2016 to 2019 , by deployment type (in billion U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Security as a service" .

:YAxis a :Axis ;
    :title "Quarter" .

:DataPoint1 a :DataPoint ;
    :xValue "1.4" ;
    :yValue "Q1 '19" ;
    :belongsTo :Chart .

