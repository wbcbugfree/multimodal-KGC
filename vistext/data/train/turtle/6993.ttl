@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Share of children who visited a museum in England from 2008/09 to 2019/20 , by age" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "11-15 years" .

:DataPoint1 a :DataPoint ;
    :xValue "2019/20" ;
    :yValue "0.556" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "2018/19" ;
    :yValue "0.601" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "2017/18" ;
    :yValue "0.574" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "2016/17" ;
    :yValue "0.637" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "2015/16" ;
    :yValue "0.587" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "2014/15" ;
    :yValue "0.604" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "2013/14" ;
    :yValue "0.604" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "2012/13" ;
    :yValue "0.576" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "2011/12" ;
    :yValue "0.609" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "2010/11" ;
    :yValue "0.607" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "2009/10" ;
    :yValue "0.668" ;
    :belongsTo :Chart .

:DataPoint12 a :DataPoint ;
    :xValue "2008/09" ;
    :yValue "0.594" ;
    :belongsTo :Chart .
