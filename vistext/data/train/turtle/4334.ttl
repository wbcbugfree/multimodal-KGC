@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Monthly unemployment rate of men in the United States from November 2019 to November 2020 (seasonally adjusted)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Month" .

:YAxis a :Axis ;
    :title "Unemployment rate" .

:DataPoint1 a :DataPoint ;
    :xValue "Nov '20" ;
    :yValue "0.069" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Oct '20" ;
    :yValue "0.07" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "Sep '20" ;
    :yValue "0.077" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "Aug '20" ;
    :yValue "0.083" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "Jul '20" ;
    :yValue "0.098" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Jun '20" ;
    :yValue "0.106" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "May '20" ;
    :yValue "0.122" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Apr '20" ;
    :yValue "0.135" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "Mar '20" ;
    :yValue "0.044" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "Feb '20" ;
    :yValue "0.036" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "Jan '20" ;
    :yValue "0.036" ;
    :belongsTo :Chart .

:DataPoint12 a :DataPoint ;
    :xValue "Dec '19" ;
    :yValue "0.035" ;
    :belongsTo :Chart .

:DataPoint13 a :DataPoint ;
    :xValue "Nov '19" ;
    :yValue "0.035" ;
    :belongsTo :Chart .
