@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Philadelphia Phillies all-time hits leaders as of October 2020" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Philadelphia Phillies all-time hits leaders" .

:YAxis a :Axis ;
    :title "Number of hits" .

:DataPoint1 a :DataPoint ;
