@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Gross domestic expenditure on research and development (GERD) as a percentage of GDP in Denmark from 2001 to 2017" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "GERD as percentage of GDP" .

:YAxis a :Axis ;
    :title "Year" .

:DataPoint1 a :DataPoint ;
    :xValue "0.0306" ;
    :yValue "2017*" ;
    :belongsTo :Chart .

