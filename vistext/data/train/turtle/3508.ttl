@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Number of complaints to the Financial Ombudsman regarding the United Kingdom (UK) leading banks as of the second half of 2019" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Number of complaints" .

:YAxis a :Axis ;
    :title "United Kingdom (UK) leading banks" .

:DataPoint1 a :DataPoint ;
    :xValue "10813" ;
    :yValue "Lloyds Bank Plc (headquarters: London)" ;
    :belongsTo :Chart .

