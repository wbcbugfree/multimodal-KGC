@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "External debt as percentage of gross domestic product in Haiti from 2000 to 2018" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Foreign debt as share of GDP" .

