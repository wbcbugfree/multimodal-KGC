@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Expected growth of the real Gross Domestic Product (GDP) caused by the coronavirus (COVID-19) outbreak in Poland in 2020 , by major banks ' scenarios" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "bank" .

:YAxis a :Axis ;
    :title "Growth in GDP" .

:DataPoint1 a :DataPoint ;
    :xValue "Government consensus for 2020" ;
    :yValue "0.037" ;
    :belongsTo :Chart .

