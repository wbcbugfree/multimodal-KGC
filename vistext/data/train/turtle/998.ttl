@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Monthly percentage of change in disposable personal income (DPI) in the United States from November 2019 to November 2020" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Month" .

:YAxis a :Axis ;
    :title "Monthly percentage of change" .

:DataPoint1 a :DataPoint ;
    :xValue "Nov '20*" ;
    :yValue "-0.012" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Oct '20" ;
    :yValue "-0.007" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "Sep '20" ;
    :yValue "0.008" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "Aug '20" ;
    :yValue "-0.031" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "Jul '20" ;
    :yValue "0.008" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Jun '20" ;
    :yValue "-0.014" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "May '20" ;
    :yValue "-0.048" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Apr '20" ;
    :yValue "0.148" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "Mar '20" ;
    :yValue "-0.017" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "Feb '20" ;
    :yValue "0.007" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "Jan '20" ;
    :yValue "0.009" ;
    :belongsTo :Chart .

:DataPoint12 a :DataPoint ;
    :xValue "Dec '19" ;
    :yValue "0" ;
    :belongsTo :Chart .

:DataPoint13 a :DataPoint ;
    :xValue "Nov '19" ;
    :yValue "0.005" ;
    :belongsTo :Chart .
