@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Number of Muslims in Spain in 2019 , by nationality" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Number of Muslims" .

:YAxis a :Axis ;
    :title "Country" .

