@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Fibre broadband availability as share of households by country in 2016 , by technology" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Full-fibre-only" .

:YAxis a :Axis ;
    :title "Country" .

