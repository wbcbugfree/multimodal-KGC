@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "High-technology exports from the United States from 1990 to 2018 , as a percentage of total manufactured exports" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "Percentage of high-tech exports" .

