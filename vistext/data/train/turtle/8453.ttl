@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Rate of employment in Belgium from 2008 to 2019 , by age" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "25-49 years" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2007" ;
    :yValue "0.823" ;
    :belongsTo :Chart .

