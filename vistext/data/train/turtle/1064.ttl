@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Operating revenue of Air Wisconsin Airlines from 2004 to 2017 (in million U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Revenue in million U.S. dollars" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2003" ;
    :yValue "672.08" ;
    :belongsTo :Chart .

