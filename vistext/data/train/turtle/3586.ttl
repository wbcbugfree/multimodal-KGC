@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Number of graduates from public schools in Canada from 2002 to 2019 (in 1,000s)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Number of students in thousands" .

