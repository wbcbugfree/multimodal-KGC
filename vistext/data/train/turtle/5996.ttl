@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Most expensive cities to drink a cold beer worldwide as of June 2016 , based on beer price index (in U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Beer price in U.S. dollars" .

:YAxis a :Axis ;
    :title "Country" .

:DataPoint1 a :DataPoint ;
    :xValue "9.51" ;
    :yValue "Lausanne" ;
    :belongsTo :Chart .

