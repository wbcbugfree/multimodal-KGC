@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Share of adults in the United States who trust selected institutions to keep their personal information secure as of January 2017" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Not at all trustworthy" .

:YAxis a :Axis ;
    :title "Response" .

:DataPoint1 a :DataPoint ;
    :xValue "0.01" ;
    :yValue "Your current employer" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "0.02" ;
    :yValue "Doctors" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "0.05" ;
    :yValue "Bankers" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "0.08" ;
    :yValue "Health insurance companies" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "0.07" ;
    :yValue "Credit card companies" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "0.1" ;
    :yValue "IRS" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "0.06" ;
    :yValue "Other insurance companies" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "0.09" ;
    :yValue "State government" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "0.12" ;
    :yValue "Federal government" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "0.07" ;
    :yValue "Major physical retailers" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "0.08" ;
    :yValue "E-commerce sites" ;
    :belongsTo :Chart .

:DataPoint12 a :DataPoint ;
    :xValue "0.15" ;
    :yValue "Restaurants and bars" ;
    :belongsTo :Chart .

:DataPoint13 a :DataPoint ;
    :xValue "0.25" ;
    :yValue "Social networks" ;
    :belongsTo :Chart .

:DataPoint14 a :DataPoint ;
    :xValue "0.37" ;
    :yValue "Online dating sites" ;
    :belongsTo :Chart .
