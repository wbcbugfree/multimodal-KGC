@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "France : The largest cities in 2013 (in million residents)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Residents in million" .

:YAxis a :Axis ;
    :title "city" .

:DataPoint1 a :DataPoint ;
    :xValue "2.23" ;
    :yValue "Paris" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "0.86" ;
    :yValue "Marseilles" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "0.5" ;
    :yValue "Lyon" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "0.46" ;
    :yValue "Toulouse" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "0.34" ;
    :yValue "Nice" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "0.29" ;
    :yValue "Nantes" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "0.28" ;
    :yValue "Strasbourg" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "0.27" ;
    :yValue "Montpellier" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "0.24" ;
    :yValue "Bordeaux" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "0.23" ;
    :yValue "Lille" ;
    :belongsTo :Chart .
