@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Monthly number of scooters and other mopeds sold in the United Kingdom from January through October 2020" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Scooter" .

:YAxis a :Axis ;
    :title "Month" .

:DataPoint1 a :DataPoint ;
    :xValue "661" ;
    :yValue "Oct '20" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "785" ;
    :yValue "Sep '20" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "507" ;
    :yValue "Aug '20" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "634" ;
    :yValue "Jul '20" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "546" ;
    :yValue "Jun '20" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "261" ;
    :yValue "May '20" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "92" ;
    :yValue "Apr '20" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "354" ;
    :yValue "Mar '20" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "233" ;
    :yValue "Feb '20" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "301" ;
    :yValue "Jan '20" ;
    :belongsTo :Chart .
