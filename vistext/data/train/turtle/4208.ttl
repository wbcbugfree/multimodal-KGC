@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Total revenue of Virgin Media from 2008 to 2019 (in million GBP)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Revenue in million GBP" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2007" ;
    :yValue "3655" ;
    :belongsTo :Chart .

