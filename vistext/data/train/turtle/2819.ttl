@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Distribution of most frequent origins of immigrants declared upon arrival in Italy in 2020" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Share of individuals" .

:YAxis a :Axis ;
    :title "Response" .

:DataPoint1 a :DataPoint ;
    :xValue "0.38" ;
    :yValue "Tunisia" ;
    :belongsTo :Chart .

