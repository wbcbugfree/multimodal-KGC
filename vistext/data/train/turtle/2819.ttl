    :xValue "0.04" ;
    :yValue "Egypt" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "0.03" ;
    :yValue "Sudan" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "0.03" ;
    :yValue "Afghanistan" ;
    :belongsTo :Chart .

