@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Leading wicket-takers in women 's Twenty20 International cricket as of September 2020" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Wicket-taker" .

:YAxis a :Axis ;
    :title "Number of wickets taken" .

