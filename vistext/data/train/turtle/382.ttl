@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Number of monthly active Instagram users from January 2013 to June 2018 (in millions)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Number of users in millions" .

:YAxis a :Axis ;
    :title "Month" .

:DataPoint1 a :DataPoint ;
    :xValue "1000" ;
    :yValue "Jun '18" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "800" ;
    :yValue "Sep '17" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "700" ;
    :yValue "Apr '17" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "600" ;
    :yValue "Dec '16" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "500" ;
    :yValue "Jun '16" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "400" ;
    :yValue "Sep '15" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "300" ;
    :yValue "Dec '14" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "200" ;
    :yValue "Mar '14" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "150" ;
    :yValue "Sep '13" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "130" ;
    :yValue "Jun '13" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "100" ;
    :yValue "Feb '13" ;
    :belongsTo :Chart .

:DataPoint12 a :DataPoint ;
    :xValue "90" ;
    :yValue "Jan '13" ;
    :belongsTo :Chart .
