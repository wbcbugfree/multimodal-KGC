@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "House price index for existing houses in Spain from 2008 to 2019" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Housing price index" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2007" ;
    :yValue "156.46" ;
    :belongsTo :Chart .

