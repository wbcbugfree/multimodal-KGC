@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Percentage of respondents worldwide who felt COVID-19 posed a very high or high level of threat to their country as of March 14 , 2020 , by country" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "March 12 to 14" .

:DataPoint1 a :DataPoint ;
    :xValue "Australia" ;
    :yValue "0.46" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Canada" ;
    :yValue "0.32" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "France" ;
    :yValue "0.65" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "Germany" ;
    :yValue "0.53" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "Italy" ;
    :yValue "0.84" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Japan" ;
    :yValue "0.63" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Russia" ;
    :yValue "0.36" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "United Kingdom" ;
    :yValue "0.45" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "United States" ;
    :yValue "0.5" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "Vietnam*" ;
    :yValue "0.72" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "China**" ;
    :yValue "0.71" ;
    :belongsTo :Chart .

:DataPoint12 a :DataPoint ;
    :xValue "India**" ;
    :yValue "0.6" ;
    :belongsTo :Chart .
