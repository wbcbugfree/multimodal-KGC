@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Gross domestic product (GDP) in Italy in 2018 , by region (in million euros)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "region of Italy" .

:YAxis a :Axis ;
    :title "GDP in million euros in current prices" .

