@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Consumption volume of cement in India from financial year 2009 to 2018 with an estimate for financial year 2019 (in million metric tons)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Consumption in million metric tons" .

:YAxis a :Axis ;
    :title "Financial year" .

:DataPoint1 a :DataPoint ;
    :xValue "328" ;
    :yValue "FY 2019" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "269" ;
    :yValue "FY 2018" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "272" ;
    :yValue "FY 2017" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "269" ;
    :yValue "FY 2016" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "256" ;
    :yValue "FY 2015" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "245" ;
    :yValue "FY 2014" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "239" ;
    :yValue "FY 2013" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "221" ;
    :yValue "FY 2012" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "166" ;
    :yValue "FY 2011" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
