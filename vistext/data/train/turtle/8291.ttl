@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "How likely do you think you would be to use or continue using each of the following methods of weight management in the next year ?" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Very likely" .

:YAxis a :Axis ;
    :title "Response" .

:DataPoint1 a :DataPoint ;
    :xValue "0.37" ;
    :yValue "Being more active throughout the day" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "0.36" ;
    :yValue "Spend more time exercising" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "0.33" ;
    :yValue "Eating smaller portions of what you eat now" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "0.32" ;
    :yValue "Limiting specific types of food or food types" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "0.26" ;
    :yValue "Eating snacks less frequently" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "0.28" ;
    :yValue "Eating smaller, more frequent meals or snacks" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "0.27" ;
    :yValue "Tracking and increasing the amount of time you are physically active" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "0.27" ;
    :yValue "Limit the number of calories in the food you eat" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "0.22" ;
    :yValue "Eating more slowly and attentively" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "0.31" ;
    :yValue "Eating out less often" ;
    :belongsTo :Chart .
