@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Production value of oranges in the U.S. from 1999/2000 to 2018/2019 (in 1,000 U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Value in thousand U.S. dollars" .

:YAxis a :Axis ;
    :title "Year" .

