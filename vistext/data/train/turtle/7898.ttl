@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Average annual salaries for college faculty members in private institutions in the U.S. from 2005 to 2019 (in 1,000 U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Professor" .

