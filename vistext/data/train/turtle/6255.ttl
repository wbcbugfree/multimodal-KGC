@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Number of participants in U.S. high school softball (fast pitch) from 2009/10 to 2018/19" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Girls" .

:DataPoint1 a :DataPoint ;
    :xValue "2018/19" ;
    :yValue "362038" ;
    :belongsTo :Chart .

