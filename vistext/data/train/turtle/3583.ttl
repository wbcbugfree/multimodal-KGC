@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "If you think of your (last) journey , how would you (most likely) have reached your destination , if you had n't used a long-distance bus service ?" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "Share of respondents" .

:DataPoint1 a :DataPoint ;
    :xValue "Train (Deutsche Bahn)" ;
    :yValue "0.361" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Own car" ;
    :yValue "0.329" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "Plane" ;
    :yValue "0.114" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "Car pooling" ;
    :yValue "0.089" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "Taxi" ;
    :yValue "0.038" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Rental car" ;
    :yValue "0.025" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Hitchhiking" ;
    :yValue "0.019" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Car sharing" ;
    :yValue "0.013" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "Other" ;
    :yValue "0.006" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "Don't know" ;
    :yValue "0.006" ;
    :belongsTo :Chart .
