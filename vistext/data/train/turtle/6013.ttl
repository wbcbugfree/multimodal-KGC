@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Share of delayed flights of WOW air in selected months from January 2018 to January 2019" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "Share of delayed flights" .

:DataPoint1 a :DataPoint ;
    :xValue "Jan 19" ;
    :yValue "0.2191" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Dec 18" ;
    :yValue "0.376" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "Nov 18" ;
    :yValue "0.252" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "Oct 18" ;
    :yValue "0.2479" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "Sep 18" ;
    :yValue "0.2124" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Aug 18" ;
    :yValue "0.2991" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Jul 18" ;
    :yValue "0.3709" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Jun 18" ;
    :yValue "0.4406" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "Mar 18" ;
    :yValue "0.2931" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "Feb 18" ;
    :yValue "0.4783" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "Jan 18" ;
    :yValue "0.465" ;
    :belongsTo :Chart .
