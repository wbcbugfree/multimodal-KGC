@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Minimum number of people injured from U.S. drone strikes carried out under CIA command in Pakistan from 2004 to April 2020" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Number of people injured from drone strikes" .

:YAxis a :Axis ;
    :title "Year" .

:DataPoint1 a :DataPoint ;
    :xValue "0" ;
    :yValue "2020*" ;
    :belongsTo :Chart .

