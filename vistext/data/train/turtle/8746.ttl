@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Change in the percentage of expenditure for logistics of the GDP of China from 1994 to 2004" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Administrative costs" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 1993" ;
    :yValue "0.032" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Dec 31, 1994" ;
    :yValue "0.034" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "Dec 31, 1995" ;
    :yValue "0.033" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "Dec 31, 1996" ;
    :yValue "0.035" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "Dec 31, 1997" ;
    :yValue "0.035" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Dec 31, 1998" ;
    :yValue "0.036" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Dec 31, 1999" ;
    :yValue "0.036" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Dec 31, 2000" ;
    :yValue "0.035" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "Dec 31, 2001" ;
    :yValue "0.034" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "Dec 31, 2002" ;
