@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Monthly unemployment rate in the United States from November 2019 to November 2020 (seasonally-adjusted)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Unemployment rate" .

:YAxis a :Axis ;
    :title "Month" .

:DataPoint1 a :DataPoint ;
    :xValue "0.067" ;
    :yValue "Nov '20" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "0.069" ;
    :yValue "Oct '20" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "0.079" ;
    :yValue "Sep '20" ;
    :belongsTo :Chart .

