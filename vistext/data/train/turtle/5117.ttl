    :belongsTo :Chart .

:DataPoint12 a :DataPoint ;
    :xValue "0.035" ;
    :yValue "Dec '19" ;
    :belongsTo :Chart .

:DataPoint13 a :DataPoint ;
    :xValue "0.035" ;
    :yValue "Nov '19" ;
    :belongsTo :Chart .

:DataPoint14 a :DataPoint ;
    :xValue "0.036" ;
    :yValue "Oct '19" ;
