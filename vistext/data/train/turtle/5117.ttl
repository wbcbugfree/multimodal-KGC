    :yValue "Jul '20" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "0.111" ;
    :yValue "Jun '20" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "0.133" ;
    :yValue "May '20" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "0.147" ;
