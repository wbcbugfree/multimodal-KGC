@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Number of Starbucks stores in China from 2005 to 2019" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "company-operated stores" .

:DataPoint1 a :DataPoint ;
    :xValue "2019" ;
    :yValue "4123" ;
    :belongsTo :Chart .

