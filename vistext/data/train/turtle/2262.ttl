@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Deposit interest rates in Singapore from 2007 to 2020" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Deposit interest rates" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2006" ;
    :yValue "0.0053" ;
    :belongsTo :Chart .

