@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Monthly export value of fish , crustaceans , shellfish and other fishery products in Canada from 2015 to 2020 (in million Canadian dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "2016" .

:YAxis a :Axis ;
    :title "Month" .

:DataPoint1 a :DataPoint ;
    :xValue "251.7" ;
    :yValue "Dec" ;
    :belongsTo :Chart .

