@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Comparing the way the UK government has handled the Coronavirus pandemic with the way other countries have handled it , would you say the UK government has handled things better or worse than these other countries did ?" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "A little worse" .

:YAxis a :Axis ;
    :title "Response" .

:DataPoint1 a :DataPoint ;
    :xValue "0.18" ;
    :yValue "China" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "0.17" ;
    :yValue "Italy" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "0.21" ;
    :yValue "Germany" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "0.2" ;
    :yValue "France" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "0.19" ;
    :yValue "Spain" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "0.07" ;
    :yValue "United States" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "0.17" ;
    :yValue "South Korea" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "0.16" ;
    :yValue "Japan" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "0.21" ;
    :yValue "Australia" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "0.19" ;
    :yValue "Sweden" ;
    :belongsTo :Chart .
