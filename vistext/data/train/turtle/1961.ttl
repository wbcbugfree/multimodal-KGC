@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Average pre-berthing time across major ports in India from financial year 1991 to 2019 (in days)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Average pre-berthing time in days" .

:DataPoint1 a :DataPoint ;
    :xValue "FY 2019" ;
    :yValue "1.1" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "FY 2018" ;
    :yValue "1.39" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "FY 2017" ;
    :yValue "1.27" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "FY 2016" ;
    :yValue "1.31" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "FY 2015" ;
    :yValue "1.61" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "FY 2014" ;
    :yValue "1.48" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "FY 2013" ;
    :yValue "1.79" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "FY 2012" ;
    :yValue "2.05" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "FY 2011" ;
    :yValue "2.32" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "FY 2010" ;
    :yValue "2.16" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "FY 2001" ;
    :yValue "1.19" ;
    :belongsTo :Chart .

:DataPoint12 a :DataPoint ;
    :xValue "FY 1991" ;
    :yValue "2.16" ;
    :belongsTo :Chart .
