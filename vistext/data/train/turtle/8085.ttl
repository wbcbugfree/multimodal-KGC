@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Number of households in Germany from 2000 to 2019 , by size (in 1,000)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "One person" .

