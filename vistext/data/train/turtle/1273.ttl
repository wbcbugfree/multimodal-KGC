@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Among these 20 most often favored French actors , which ones are your favorites ?" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "Share of respondents" .

