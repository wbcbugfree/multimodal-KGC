@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Monthly number of deaths in Italy in from January 2019 to August 2020" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Month" .

:YAxis a :Axis ;
    :title "2019" .

:DataPoint1 a :DataPoint ;
    :xValue "Januar" ;
    :yValue "65675" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "January Februar" ;
    :yValue "59290" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "February Marc" ;
    :yValue "57752" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "March Apri" ;
    :yValue "51344" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "April Ma" ;
    :yValue "50491" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "May Jun 50963; Month: June Jul 50964; Month: July Augus" ;
    :yValue "48771" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "August Septembe" ;
    :yValue "45834" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "September Octobe" ;
    :yValue "49705" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "October Novembe" ;
    :yValue "50201" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "November Decembe" ;
    :yValue "53442" ;
    :belongsTo :Chart .
