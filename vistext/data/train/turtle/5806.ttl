@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Gross domestic product (GDP) of the Faroe Islands from 2010 to 2020 (in million DKK)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "GDP in million DKK" .

:YAxis a :Axis ;
    :title "Year" .

:DataPoint1 a :DataPoint ;
    :xValue "22481" ;
    :yValue "2020*" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "21005" ;
    :yValue "2019*" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "19259" ;
    :yValue "2018*" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "18708" ;
    :yValue "2017" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "18103" ;
    :yValue "2016" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "16942" ;
    :yValue "2015" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "16000" ;
    :yValue "2014" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "14754" ;
    :yValue "2013" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "13707" ;
    :yValue "2012" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "13372" ;
    :yValue "2011" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "13050" ;
    :yValue "2010" ;
    :belongsTo :Chart .
