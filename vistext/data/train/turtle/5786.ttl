@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Number of arrivals in tourist accommodation in the Netherlands from 2006 to 2019 (in millions)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Number of arrivals in millions" .

:DataPoint1 a :DataPoint ;
    :xValue "2019" ;
    :yValue "45.9" ;
    :belongsTo :Chart .

