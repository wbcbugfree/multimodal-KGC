@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Leading Italian influencers on Instagram in Italy as of 2019 , ranked by number of Instagram followers (in 1,000s)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Italian influencer" .

:YAxis a :Axis ;
    :title "Number of Instagram followers in thousands" .

:DataPoint1 a :DataPoint ;
    :xValue "Chiara Ferragni" ;
    :yValue "12524" ;
    :belongsTo :Chart .

