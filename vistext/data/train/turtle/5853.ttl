@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Leading most valuable brands in the United States in 2020 (in billion U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Brand value in billion U.S. dollars" .

:YAxis a :Axis ;
    :title "Platform" .

:DataPoint1 a :DataPoint ;
    :xValue "334.65" ;
    :yValue "Amazon" ;
    :belongsTo :Chart .

