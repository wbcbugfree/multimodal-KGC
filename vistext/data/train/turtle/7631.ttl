@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Most purchased brands during COVID-19 outbreak in Singapore as of March 2020 , by type of customer" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "COVID-19 Relaxers" .

:YAxis a :Axis ;
    :title "Response" .

:DataPoint1 a :DataPoint ;
    :xValue "0.49" ;
    :yValue "McDonald's" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "0.3" ;
    :yValue "KFC" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "0.25" ;
    :yValue "Dettol" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "0.24" ;
    :yValue "QOO10" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "0.15" ;
    :yValue "Shopee" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "0.13" ;
    :yValue "Ninja Van" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "0.09" ;
    :yValue "L'Oreal" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "0.07" ;
    :yValue "Nissin" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "0.03" ;
    :yValue "MeWATCH" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "0.01" ;
    :yValue "Enfagrow" ;
    :belongsTo :Chart .
