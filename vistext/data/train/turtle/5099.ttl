@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Price of selected acquisitions by Microsoft as of July 2017 (in million U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Price in million U.S. dollars" .

:YAxis a :Axis ;
    :title "name and year of acquired company" .

:DataPoint1 a :DataPoint ;
    :xValue "26200" ;
    :yValue "LinkedIn (2016)" ;
    :belongsTo :Chart .

