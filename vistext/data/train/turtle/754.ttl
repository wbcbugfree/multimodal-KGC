@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Annual number of computed tomography (CT) scanners in the United Kingdom (UK) from 2000 to 2014" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Number of scanners" .

:YAxis a :Axis ;
    :title "Year" .

:DataPoint1 a :DataPoint ;
    :xValue "611" ;
    :yValue "2014*" ;
    :belongsTo :Chart .

