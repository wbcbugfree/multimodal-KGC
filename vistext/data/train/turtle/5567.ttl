@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Blackberry/RIM 's revenue from fiscal year 2004 to 2020 (in million U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Revenue in million U.S. dollars" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2003" ;
    :yValue "595" ;
    :belongsTo :Chart .

