@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Total operating revenue of the major airlines in the United Kingdom (UK) in 2014/2015 (in 1,000 GBP)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Revenue in thousand British pounds" .

:YAxis a :Axis ;
    :title "airline" .

:DataPoint1 a :DataPoint ;
