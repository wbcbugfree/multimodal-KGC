@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Number of deaths resulting from famine per100,000 people worldwide from 1900 to 2010" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Deaths per 100,000 people" .

:YAxis a :Axis ;
    :title "Year" .

:DataPoint1 a :DataPoint ;
    :xValue "3" ;
    :yValue "2000s" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "64" ;
    :yValue "1990s" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "29" ;
    :yValue "1980s" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "95" ;
    :yValue "1970s" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "500" ;
    :yValue "1960s" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "578" ;
    :yValue "1950s" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "409" ;
    :yValue "1940s" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "343" ;
    :yValue "1930s" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "814" ;
    :yValue "1920s" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "9" ;
    :yValue "1910s" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "3" ;
    :yValue "1900s" ;
    :belongsTo :Chart .
