@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Turkey : Age structure from 2009 to 2019 (in years)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "15-64 years" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2008" ;
    :yValue "65.68" ;
    :belongsTo :Chart .

