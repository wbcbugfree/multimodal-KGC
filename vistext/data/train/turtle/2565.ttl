@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Major countries of destination for U.S. fluid milk and cream exports in 2013 (in liters)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Exports in metric tons" .

:YAxis a :Axis ;
    :title "Country" .

:DataPoint1 a :DataPoint ;
    :xValue "32347609" ;
    :yValue "Canada" ;
    :belongsTo :Chart .

