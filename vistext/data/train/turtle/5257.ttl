@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Ukraine : national debt from 2010 to 2024 in relation to gross domestic product (GDP)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "National debt as percent of GDP" .

:DataPoint1 a :DataPoint ;
    :xValue "2024*" ;
    :yValue "0.4465" ;
    :belongsTo :Chart .

