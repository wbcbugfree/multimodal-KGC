@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Total operating expenses United Kingdom (UK) airlines in 2014/15 (in 1,000 GBP)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "airline" .

:YAxis a :Axis ;
    :title "Operating expenses in thousand GBP" .

:DataPoint1 a :DataPoint ;
    :xValue "British Airways Plc" ;
    :yValue "9947182" ;
    :belongsTo :Chart .

