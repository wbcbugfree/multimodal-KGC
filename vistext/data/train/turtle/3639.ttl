    :xValue "70-74 years" ;
    :yValue "834" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "65-69 years" ;
    :yValue "1582" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "60-64 years" ;
    :yValue "2739" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "55-59 years" ;
    :yValue "4077" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "50-54 years" ;
    :yValue "5887" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
