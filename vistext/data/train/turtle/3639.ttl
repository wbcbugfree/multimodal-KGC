@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Number of newlyweds in Sweden in 2019 , by age group" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Number of people" .

:DataPoint1 a :DataPoint ;
    :xValue "85 years and older" ;
    :yValue "38" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "80-84 years" ;
    :yValue "109" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "75-79 years" ;
    :yValue "352" ;
    :belongsTo :Chart .

