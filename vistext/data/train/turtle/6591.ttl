@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Number of employees in the gambling industry in the United Kingdom from 2009 to 2019 , by sector" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "year" .

:YAxis a :Axis ;
    :title "Lotteries (ELM)" .

:DataPoint1 a :DataPoint ;
    :xValue "Mar 30, 2010" ;
    :yValue "678" ;
    :belongsTo :Chart .

