@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Share of households with internet access in Cyprus from 2007 to 2018" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "Share of households" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2006" ;
    :yValue "0.39" ;
    :belongsTo :Chart .

