@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Share of Americans who have a gun in their home or on their property from 1994 to 2015" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "Share of Americans with a gun" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 1993" ;
    :yValue "0.54" ;
    :belongsTo :Chart .

