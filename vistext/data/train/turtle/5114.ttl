@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Number of immigrants in Germany in 2019 , by country of origin" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Number of immigrants" .

:YAxis a :Axis ;
    :title "Country" .

:DataPoint1 a :DataPoint ;
    :xValue "230096" ;
    :yValue "Romania" ;
    :belongsTo :Chart .

