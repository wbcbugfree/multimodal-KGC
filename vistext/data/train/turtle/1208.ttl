    :yValue "16" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Hyundai Mobis Phoebus" ;
    :yValue "15" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
