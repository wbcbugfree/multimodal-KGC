@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Number of registered players in the Korean Basketball League (KBL) in South Korea for the 20/21 season , by team" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "basketball team" .

:YAxis a :Axis ;
    :title "Number of registered players" .

:DataPoint1 a :DataPoint ;
    :xValue "Seoul SK Knights" ;
    :yValue "18" ;
    :belongsTo :Chart .

