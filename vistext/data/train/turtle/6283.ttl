@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Netherlands : Government revenue and spending from 2014 to 2024 (in billion euros)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Revenue" .

:YAxis a :Axis ;
    :title "Year" .

:DataPoint1 a :DataPoint ;
    :xValue "411.34" ;
    :yValue "2024*" ;
    :belongsTo :Chart .

