@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Value of used clothing exported from the United Kingdom (UK) in 2019 , by key market destinations (in thousand U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Export value in thousand U.S dollars" .

:YAxis a :Axis ;
    :title "Country" .

