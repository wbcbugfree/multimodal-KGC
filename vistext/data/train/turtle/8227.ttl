@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Percentage of U.S. adults likely to change select behaviors in response to coronavirus (COVID-19) as of March 1 , 2020" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "Neither more nor less likely" .

:DataPoint1 a :DataPoint ;
    :xValue "Use public transport" ;
    :yValue "0.42" ;
    :belongsTo :Chart .

