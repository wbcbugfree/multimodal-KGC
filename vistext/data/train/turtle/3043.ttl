@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Top 10 U.S. states based on production value of oats in 2018 (in 1,000 U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Production value in thousand U.S. dollars" .

:YAxis a :Axis ;
    :title "State" .

:DataPoint1 a :DataPoint ;
    :xValue "20664" ;
    :yValue "North Dakota" ;
    :belongsTo :Chart .

