@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Value of edible grocery sales for Aldi in the United Kingdom (UK) from 2010 forecast to 2020 (in million US dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Sales in million US dollars" .

:YAxis a :Axis ;
    :title "Year" .

:DataPoint1 a :DataPoint ;
    :xValue "12636.82" ;
    :yValue "2020**" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "11973.74" ;
    :yValue "2019**" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "11241.92" ;
    :yValue "2018**" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "10249.41" ;
    :yValue "2017**" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "9222.13" ;
    :yValue "2016**" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "8076.71" ;
    :yValue "2015*" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "7307.41" ;
    :yValue "2014" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "5373.41" ;
    :yValue "2013" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "4017.08" ;
    :yValue "2012" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "2785.51" ;
    :yValue "2011" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "2059.8" ;
    :yValue "2010" ;
    :belongsTo :Chart .
