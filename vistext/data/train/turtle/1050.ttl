@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Number of doctors per 10,000 inhabitants in Singapore from 1960 to 2019" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Number of doctors per 10,000 population" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 1959" ;
    :yValue "4" ;
    :belongsTo :Chart .

