@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Number of internet users worldwide from 2009 to 2020 , by region (in millions)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Europe" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2008" ;
    :yValue "425.8" ;
    :belongsTo :Chart .

