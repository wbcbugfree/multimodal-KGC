@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Leading smartphone activities of global travelers while on vacation as of August 2014" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "Share of respondents" .

:DataPoint1 a :DataPoint ;
    :xValue "Checking work emails" ;
    :yValue "0.68" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Navigation/maps" ;
    :yValue "0.67" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "Texting" ;
    :yValue "0.64" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "Taking vacation photos" ;
    :yValue "0.51" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "Making calls" ;
    :yValue "0.42" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Snapping pictures of meals" ;
    :yValue "0.35" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Updating Facebook/Twitter" ;
    :yValue "0.32" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Skype-ing friends/family" ;
    :yValue "0.32" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "Playing games" ;
    :yValue "0.27" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "Taking selfies" ;
    :yValue "0.25" ;
    :belongsTo :Chart .
