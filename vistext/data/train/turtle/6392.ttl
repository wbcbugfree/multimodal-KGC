@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Imports of anthracite coal to the United Kingdom (UK) between 2008 and 2018 , by country (in 1,000 metric tons)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "China" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2007" ;
    :yValue "51" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Dec 31, 2008" ;
    :yValue "14" ;
    :belongsTo :Chart .

