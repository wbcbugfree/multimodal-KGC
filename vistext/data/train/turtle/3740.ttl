@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Annual number of doctors licensed to practice in Denmark from 2001 to 2015 (per 1,000 people)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Number of doctors" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2000" ;
    :yValue "2.93" ;
    :belongsTo :Chart .

