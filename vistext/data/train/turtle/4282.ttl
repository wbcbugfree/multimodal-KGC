@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Yearly number of passenger cars produced in the United Kingdom (UK) between 2003 and 2019" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Car production volume in units" .

