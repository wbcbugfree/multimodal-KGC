@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Which of the following types of news is most important to you ?" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "Share of respondents" .

:DataPoint1 a :DataPoint ;
    :xValue "News about the country" ;
    :yValue "0.57" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Local news about my town or city" ;
    :yValue "0.52" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "News about country's politics" ;
    :yValue "0.47" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "International news" ;
    :yValue "0.46" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "News about the economy" ;
    :yValue "0.41" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "News about my region" ;
    :yValue "0.28" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Health news" ;
    :yValue "0.28" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Science and technology" ;
    :yValue "0.28" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "Sports news" ;
    :yValue "0.21" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "Business and financial news" ;
    :yValue "0.19" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "Fun/weird news" ;
    :yValue "0.17" ;
    :belongsTo :Chart .

:DataPoint12 a :DataPoint ;
    :xValue "Education news" ;
    :yValue "0.15" ;
    :belongsTo :Chart .

:DataPoint13 a :DataPoint ;
    :xValue "Entertainment and celebrity news" ;
    :yValue "0.13" ;
    :belongsTo :Chart .

:DataPoint14 a :DataPoint ;
    :xValue "Arts and culture news" ;
    :yValue "0.1" ;
    :belongsTo :Chart .
