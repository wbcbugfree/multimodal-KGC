@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Sales of the luxury goods industry in selected countries in 2015 (in billion euros)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Country" .

:YAxis a :Axis ;
    :title "Sales in billion euros" .

:DataPoint1 a :DataPoint ;
    :xValue "United States" ;
    :yValue "78.6" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Japan" ;
    :yValue "20.1" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "China" ;
    :yValue "17.9" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "Italy" ;
    :yValue "17.3" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "France" ;
    :yValue "17.1" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "United Kingdom" ;
    :yValue "15.6" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Germany" ;
    :yValue "11.9" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "South Korea" ;
    :yValue "10.8" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "Middle East" ;
    :yValue "8.1" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "Hong Kong" ;
    :yValue "6.8" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "Russia" ;
    :yValue "3.2" ;
    :belongsTo :Chart .
