@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Number of passenger cars produced by Toyota in Japan from July 2014 to July 2015 (in 1,000s)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Month" .

:YAxis a :Axis ;
    :title "Passenger cars in thousands" .

:DataPoint1 a :DataPoint ;
    :xValue "Jun 30, 2014" ;
    :yValue "275.6" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Jul 31, 2014" ;
    :yValue "187.1" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "Aug 31, 2014" ;
    :yValue "262.9" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "Nov 30, 2014" ;
    :yValue "208.5" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "Dec 31, 2014" ;
    :yValue "222.84" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Jan 31, 2015" ;
    :yValue "244.37" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Feb 28, 2015" ;
    :yValue "260.22" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Mar 31, 2015" ;
    :yValue "216.19" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "Apr 30, 2015" ;
    :yValue "188.64" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "May 31, 2015" ;
    :yValue "253.4" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "Jun 30, 2015" ;
    :yValue "264.78" ;
    :belongsTo :Chart .
