@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Leading sixteen cities with the largest industrial added value in Italy in 2008" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Industry added value" .

:YAxis a :Axis ;
    :title "city" .

:DataPoint1 a :DataPoint ;
    :xValue "0.46" ;
    :yValue "Lecco" ;
    :belongsTo :Chart .

