@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Single most important problem for small businesses in the United States in November 2020" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "Share of respondents" .

:DataPoint1 a :DataPoint ;
    :xValue "Quality of labor" ;
    :yValue "0.24" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Taxes" ;
    :yValue "0.2" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "Government regulations & red tape" ;
    :yValue "0.14" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "Poor sales" ;
    :yValue "0.13" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "Competition from large businesses" ;
    :yValue "0.09" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Cost/availability of insurance" ;
    :yValue "0.07" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Cost of labor" ;
    :yValue "0.06" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Other" ;
    :yValue "0.04" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "Inflation" ;
    :yValue "0.02" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "Finance & interest rates" ;
    :yValue "0.01" ;
    :belongsTo :Chart .
