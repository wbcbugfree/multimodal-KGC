@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Value of the largest bank merger and acquisition (M & A) deals in Europe between 2011 and 2017 (in billion U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Deal value in billion U.S. dollars" .

:YAxis a :Axis ;
    :title "banks" .

