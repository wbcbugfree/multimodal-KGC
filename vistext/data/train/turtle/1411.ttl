@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Largest occupations by number of employees in May 2009" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Number of employees" .

:YAxis a :Axis ;
    :title "profession" .

:DataPoint1 a :DataPoint ;
    :xValue "4209500" ;
    :yValue "Retail salespersons" ;
    :belongsTo :Chart .

