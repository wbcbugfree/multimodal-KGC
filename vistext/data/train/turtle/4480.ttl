@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Brand value of the most valuable Indonesian brands in 2020 (in million U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "public company" .

:YAxis a :Axis ;
    :title "Brand value in million U.S. dollars" .

:DataPoint1 a :DataPoint ;
    :xValue "TELKOM Indonesia" ;
    :yValue "4762" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "BRI" ;
    :yValue "3531" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "Sampoerna" ;
    :yValue "3252" ;
    :belongsTo :Chart .

