    :yValue "2708" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Pertamina" ;
    :yValue "2599" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Gudang Garam" ;
    :yValue "2480" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "BNI" ;
