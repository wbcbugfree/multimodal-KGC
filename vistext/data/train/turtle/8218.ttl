@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Distribution of digital video advertising impressions in the Asia Pacific region from 1st quarter 2014 to 3rd quarter 2014 , by industry" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Q3 2014" .

:YAxis a :Axis ;
    :title "Race" .

:DataPoint1 a :DataPoint ;
    :xValue "0.34" ;
    :yValue "CPG/FMCG" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "0.22" ;
    :yValue "Retail" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "0.11" ;
    :yValue "Non-alcoholic beverages" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "0.06" ;
    :yValue "Auto" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "0.05" ;
    :yValue "Pharmeceuticals" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "0.05" ;
    :yValue "Entertainment" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "0.04" ;
    :yValue "Financial services" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "0.04" ;
    :yValue "Telecom" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "0.02" ;
    :yValue "E-commerce" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "0.02" ;
    :yValue "Health care" ;
    :belongsTo :Chart .
