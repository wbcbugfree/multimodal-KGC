@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Number of smartphone users worldwide from 2016 to 2021 (in billions)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Smartphone users in billions" .

:YAxis a :Axis ;
    :title "Year" .

:DataPoint1 a :DataPoint ;
    :xValue "3.8" ;
    :yValue "2021*" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "3.5" ;
    :yValue "2020*" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "3.2" ;
    :yValue "2019" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "2.9" ;
    :yValue "2018" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "2.7" ;
    :yValue "2017" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "2.5" ;
    :yValue "2016" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "1.86" ;
    :yValue "2015" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "1.57" ;
    :yValue "2014" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "1.31" ;
    :yValue "2013" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "1.06" ;
    :yValue "2012" ;
    :belongsTo :Chart .
