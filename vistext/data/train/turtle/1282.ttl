@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Total annual U.S. imports of toys , dolls and games from Japan from 2005 to 2019 (in million U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Total imports (in million U.S. dollars)" .

