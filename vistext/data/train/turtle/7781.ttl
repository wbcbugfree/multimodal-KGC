@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "How many hours in a typical week would you say you use the internet ?" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "At home" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2004" ;
    :yValue "6.6" ;
    :belongsTo :Chart .

