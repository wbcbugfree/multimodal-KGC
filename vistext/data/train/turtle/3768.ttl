@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Number of bakery product manufacturing establishments in Canada as of December 2019 , by region" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "region of Canada" .

:YAxis a :Axis ;
    :title "Number of establishments" .

:DataPoint1 a :DataPoint ;
    :xValue "Ontario" ;
    :yValue "853" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Quebec" ;
    :yValue "474" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "British Columbia" ;
    :yValue "360" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "Alberta" ;
    :yValue "192" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "Manitoba" ;
    :yValue "66" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Nova Scotia" ;
    :yValue "48" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "New Brunswick" ;
    :yValue "43" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Saskatchewan" ;
    :yValue "41" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "Newfoundland and Labrador" ;
    :yValue "15" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "Prince Edward Island" ;
    :yValue "8" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "Yukon" ;
    :yValue "3" ;
    :belongsTo :Chart .
