@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Major countries in bismuth mine production from 2015 to 2019 (in metric tons)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "2017" .

:YAxis a :Axis ;
    :title "Country" .

:DataPoint1 a :DataPoint ;
    :xValue "13500" ;
    :yValue "China" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "2000" ;
    :yValue "Laos" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "525" ;
    :yValue "Japan" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "513" ;
    :yValue "Mexico" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "270" ;
    :yValue "Kazakhstan" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "50" ;
    :yValue "Bulgaria" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "25" ;
    :yValue "Canada" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "4" ;
    :yValue "Russia**" ;
    :belongsTo :Chart .
