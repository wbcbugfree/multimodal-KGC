@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Value of wine exported from India in 2018 , by region (in 1,000 U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Value in thousand U.S. dollars" .

:YAxis a :Axis ;
    :title "Country" .

