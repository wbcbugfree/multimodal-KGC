@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Winnipeg Jets franchise value from 2006 to 2019 (in million U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Franchise value in million U.S. dollars" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2005" ;
    :yValue "128" ;
    :belongsTo :Chart .

