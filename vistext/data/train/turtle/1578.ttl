@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Number of fire-related fatalities in Great Britain from 2000/01 to 2019/20" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Number of fatalities" .

