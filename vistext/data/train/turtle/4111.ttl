@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Leading pets ranked by household ownership in the United Kingdom (UK) in 2019/20" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Share of households" .

:YAxis a :Axis ;
    :title "Response" .

:DataPoint1 a :DataPoint ;
    :xValue "0.41" ;
    :yValue "Any pet" ;
    :belongsTo :Chart .

