@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Annual social spending as a share of gross domestic product (GDP) in France from 2006 to 2018" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "Share of GDP" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2005" ;
    :yValue "0.2827" ;
    :belongsTo :Chart .

