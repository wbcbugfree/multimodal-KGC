@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Share of pregnant women smoking at time of delivery in England from 2006 to 2019" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "Percentage of pregnant women" .

:DataPoint1 a :DataPoint ;
    :xValue "2018/19" ;
    :yValue "0.106" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "2017/18" ;
    :yValue "0.108" ;
    :belongsTo :Chart .

