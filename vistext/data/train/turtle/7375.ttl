@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Foreign population in Norway from 2010 to 2020 , by immigration category" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Foreign born with one parent born in Norway" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2009" ;
    :yValue "30766" ;
    :belongsTo :Chart .

