@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Clinker capacity in selected countries from 2016 to 2019 (in million metric tons)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "2016" .

:YAxis a :Axis ;
    :title "Country" .

:DataPoint1 a :DataPoint ;
    :xValue "2000" ;
    :yValue "China" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "620" ;
    :yValue "Other countries (rounded)" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "280" ;
    :yValue "India" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "109" ;
    :yValue "United States**" ;
    :belongsTo :Chart .

