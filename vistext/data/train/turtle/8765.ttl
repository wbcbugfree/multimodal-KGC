    :xValue "90" ;
    :yValue "Vietnam" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "79" ;
    :yValue "Iran" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "80" ;
    :yValue "Russia" ;
    :belongsTo :Chart .

