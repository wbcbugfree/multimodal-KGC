@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Fixed broadband user penetration in Germany from 2003 to 2013" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "User penetration" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2002" ;
    :yValue "0.053" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Dec 31, 2003" ;
    :yValue "0.084" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "Dec 31, 2004" ;
    :yValue "0.129" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "Dec 31, 2005" ;
    :yValue "0.179" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "Dec 31, 2006" ;
    :yValue "0.236" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Dec 31, 2007" ;
    :yValue "0.272" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Dec 31, 2008" ;
    :yValue "0.299" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Dec 31, 2009" ;
    :yValue "0.314" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "Dec 31, 2010" ;
    :yValue "0.328" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "Dec 31, 2011" ;
    :yValue "0.337" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "Dec 31, 2012" ;
    :yValue "0.346" ;
