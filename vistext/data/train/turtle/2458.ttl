@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Number of employees of the Royal Bank of Scotland group from 2005 to 2019 (in 1,000s)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Number of employees in thousands" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2004" ;
    :yValue "137" ;
    :belongsTo :Chart .

