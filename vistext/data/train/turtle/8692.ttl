@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Average retail price for pork chops in Canada from January 2015 to May 2020 (in Canadian dollars per kilogram)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Month" .

:YAxis a :Axis ;
    :title "2016" .

