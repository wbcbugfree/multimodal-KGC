@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Population in Denmark from 2010 to 2020 , by ancestry (in millions)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Immigrants" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2009" ;
    :yValue "0.41" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Dec 31, 2010" ;
    :yValue "0.43" ;
    :belongsTo :Chart .

