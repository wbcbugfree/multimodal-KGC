@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "What do you think of Emmanuel Macron ?" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Month" .

:YAxis a :Axis ;
    :title "Very bad opinion" .

