@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Share of households with a computer at home in developing countries from 2005 to 2019" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "Percentage of households" .

:DataPoint1 a :DataPoint ;
    :xValue "2019**" ;
    :yValue "0.385" ;
    :belongsTo :Chart .

