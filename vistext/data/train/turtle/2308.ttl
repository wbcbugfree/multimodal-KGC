@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Soybean oil for biodiesel production in the U.S. from 2010 to 2025 (in 1,000 metric tons)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Soybean oil in thousand metric tons" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2009" ;
    :yValue "941" ;
    :belongsTo :Chart .

