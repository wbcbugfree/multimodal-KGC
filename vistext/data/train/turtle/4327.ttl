@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Taiwan : Unemployment rate from 2009 to 2021" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Unemployment rate" .

:YAxis a :Axis ;
    :title "Year" .

:DataPoint1 a :DataPoint ;
    :xValue "0.04" ;
    :yValue "2021*" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "0.044" ;
    :yValue "2020*" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "0.038" ;
    :yValue "2019*" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "0.0371" ;
    :yValue "2018" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "0.0376" ;
    :yValue "2017" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "0.0392" ;
    :yValue "2016" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "0.0378" ;
    :yValue "2015" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "0.0396" ;
    :yValue "2014" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "0.0418" ;
    :yValue "2013" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "0.0424" ;
    :yValue "2012" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "0.0439" ;
    :yValue "2011" ;
    :belongsTo :Chart .

:DataPoint12 a :DataPoint ;
    :xValue "0.0521" ;
    :yValue "2010" ;
    :belongsTo :Chart .

:DataPoint13 a :DataPoint ;
    :xValue "0.0585" ;
    :yValue "2009" ;
    :belongsTo :Chart .
