@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Distribution of leading causes of neonatal deaths and deaths among children aged 1 to 59 months worldwide in 2018" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Neonatal deaths (47%)" .

:YAxis a :Axis ;
    :title "Race" .

:DataPoint1 a :DataPoint ;
    :xValue "0.03" ;
    :yValue "Pneumonia" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "0.16" ;
    :yValue "Preterm birth complications" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "0.11" ;
    :yValue "Intrapartum-related events" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "0.07" ;
    :yValue "Sepsis or menigitis" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "0.05" ;
    :yValue "Congential" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "0.03" ;
    :yValue "Other" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "0.003" ;
    :yValue "Diarrhoea" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "0.01" ;
    :yValue "Tetanus" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "0.01" ;
    :yValue "Injury" ;
    :belongsTo :Chart .
