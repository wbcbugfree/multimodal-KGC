@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Number of building permits issued in the Netherlands from 2006 to 2016 , by type of housing" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Rental property" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2005" ;
    :yValue "23917" ;
    :belongsTo :Chart .

