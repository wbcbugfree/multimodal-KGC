@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Property stolen and recovered in the United States in 2019 , by type and value (in million U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Type of property" .

:YAxis a :Axis ;
    :title "Stolen" .

:DataPoint1 a :DataPoint ;
    :xValue "Currency, notes, etc." ;
    :yValue "1423.56" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Jewelry and precious metals" ;
    :yValue "1057.76" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "Clothing and furs" ;
    :yValue "383.19" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "Locally stolen motor vehicles" ;
    :yValue "5752.24" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "Office equipment" ;
    :yValue "420.42" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Televisions, radios, stereos, etc." ;
    :yValue "323.39" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Firearms" ;
    :yValue "116.16" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Household goods" ;
    :yValue "186.26" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "Consumable goods" ;
    :yValue "160.37" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "Livestock" ;
    :yValue "14.35" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "Miscellaneous" ;
    :yValue "3502.1" ;
    :belongsTo :Chart .
