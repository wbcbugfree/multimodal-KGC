@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Countries worldwide with the most outbound travel trips (in millions)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Number of trips (in millions)" .

:YAxis a :Axis ;
    :title "Country" .

:DataPoint1 a :DataPoint ;
    :xValue "72.6" ;
    :yValue "Germany" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "64" ;
    :yValue "USA" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "54.9" ;
    :yValue "Great Britain" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "31.7" ;
    :yValue "France" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "27.3" ;
    :yValue "Canada" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "23.5" ;
    :yValue "The Netherlands" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "22.4" ;
    :yValue "Italy" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "21.7" ;
    :yValue "Russia" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "19.6" ;
    :yValue "Japan" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "16.1" ;
    :yValue "China" ;
    :belongsTo :Chart .
