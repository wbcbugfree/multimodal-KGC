@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Indian states with the highest tax revenue from motor vehicles in financial year 2016 (in billion Indian rupees)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Tax revenue in billion Indian rupees" .

:YAxis a :Axis ;
    :title "state of India" .

:DataPoint1 a :DataPoint ;
    :xValue "832.71" ;
    :yValue "Chhattisgarh" ;
    :belongsTo :Chart .

