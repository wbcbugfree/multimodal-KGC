@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Average daily rate of Marriott International hotels worldwide from 2010 to 2019 , by region (in U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Overall worldwide" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2009" ;
    :yValue "150.46" ;
    :belongsTo :Chart .

