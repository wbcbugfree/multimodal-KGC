@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Reserves of chromium worldwide from 2010 to 2019 (in 1,000 metric tons)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Reserves in thousand metric tons" .

:YAxis a :Axis ;
    :title "Year" .

:DataPoint1 a :DataPoint ;
    :xValue "570000" ;
    :yValue "2019***" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "560000" ;
    :yValue "2018" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "510000" ;
    :yValue "2017" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "500000" ;
    :yValue "2016" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "480000" ;
    :yValue "2015 **" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "480000" ;
    :yValue "2014 **" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "480000" ;
    :yValue "2013 **" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "460000" ;
    :yValue "2012 **" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "480000" ;
    :yValue "2011 **" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "350000" ;
    :yValue "2010 **" ;
    :belongsTo :Chart .
