@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Attendance at Cineplex cinemas from 2010 to 2019 (in millions)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Attendance in millions" .

:DataPoint1 a :DataPoint ;
    :xValue "2019" ;
    :yValue "66.36" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "2018" ;
    :yValue "69.27" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "2017" ;
    :yValue "70.4" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "2016" ;
    :yValue "74.6" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "2015" ;
    :yValue "77" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "2014" ;
    :yValue "73.6" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "2013" ;
    :yValue "72.7" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "2012" ;
    :yValue "71.2" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "2011" ;
    :yValue "66.1" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "2010*" ;
    :yValue "67" ;
    :belongsTo :Chart .
