@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Number of completed qualifications and degrees at universities in Finland for the academic year 2019 , by gender" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Women" .

:YAxis a :Axis ;
    :title "university" .

