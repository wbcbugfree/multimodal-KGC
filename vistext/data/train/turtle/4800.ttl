@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Economic damage caused by earthquakes 1900 - 2016 , by country (in billion U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Damage (in billion U.S. dollars)" .

:YAxis a :Axis ;
    :title "Country" .

:DataPoint1 a :DataPoint ;
    :xValue "359.66" ;
    :yValue "Japan" ;
    :belongsTo :Chart .

