@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Number of deaths from drowning in the United States in 2018 , by month" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Month" .

:YAxis a :Axis ;
    :title "Number of deaths" .

:DataPoint1 a :DataPoint ;
    :xValue "January" ;
    :yValue "177" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "February" ;
    :yValue "162" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "March" ;
    :yValue "212" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "April" ;
    :yValue "247" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "May" ;
    :yValue "390" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "June" ;
    :yValue "543" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "July" ;
    :yValue "667" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "August" ;
    :yValue "463" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "September" ;
    :yValue "305" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "October" ;
    :yValue "241" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "Novermeber" ;
    :yValue "154" ;
    :belongsTo :Chart .

:DataPoint12 a :DataPoint ;
    :xValue "December" ;
    :yValue "149" ;
    :belongsTo :Chart .
