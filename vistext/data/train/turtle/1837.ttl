@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Trust in third-party delivery options according to internet users in the United States as of March 2019" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "Share of respondents" .

:DataPoint1 a :DataPoint ;
    :xValue "Books" ;
    :yValue "0.43" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Clothes and apparel" ;
    :yValue "0.4" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "Consumer packaged goods" ;
    :yValue "0.31" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "Office supplies" ;
    :yValue "0.3" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "Pet supplies" ;
    :yValue "0.27" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Food/groceries" ;
    :yValue "0.27" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Household goods" ;
    :yValue "0.26" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Health and beauty" ;
    :yValue "0.24" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "Consumer electronics" ;
    :yValue "0.23" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "Sporting goods" ;
    :yValue "0.2" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "Furniture" ;
    :yValue "0.2" ;
    :belongsTo :Chart .

:DataPoint12 a :DataPoint ;
    :xValue "Tools and home improvement" ;
