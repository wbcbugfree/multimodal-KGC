@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Average price of coffee in independent coffee shops in selected European cities in 2016" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Average price in euros" .

:YAxis a :Axis ;
    :title "city" .

