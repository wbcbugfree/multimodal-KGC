@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Average age of U.S. urban transit bus vehicles from 1990 to 2012 (in years)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Small transit bus" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 1989" ;
    :yValue "3.9" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Dec 31, 1994" ;
    :yValue "4" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "Dec 31, 1999" ;
    :yValue "4.1" ;
    :belongsTo :Chart .

