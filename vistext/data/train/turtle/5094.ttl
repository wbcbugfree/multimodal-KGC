@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Leading countries of destination for U.S. rice exports (milled basis) in 2018 (in metric tons)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Exports in metric tons" .

:YAxis a :Axis ;
    :title "Country" .

:DataPoint1 a :DataPoint ;
