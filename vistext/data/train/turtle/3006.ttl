@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Number of Dollarama stores in Canada as of January 2020 , by province" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "province of Canada" .

:YAxis a :Axis ;
    :title "Number of stores" .

:DataPoint1 a :DataPoint ;
    :xValue "Ontario" ;
    :yValue "519" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Québec" ;
    :yValue "361" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "Alberta" ;
    :yValue "119" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "British Columbia" ;
    :yValue "108" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "Nova Scotia" ;
    :yValue "39" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "New Brunswick" ;
    :yValue "40" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Manitoba" ;
    :yValue "39" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Saskatchewan" ;
    :yValue "38" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "Newfoundland and Labrador" ;
    :yValue "23" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "Prince Edward Island" ;
    :yValue "5" ;
    :belongsTo :Chart .
