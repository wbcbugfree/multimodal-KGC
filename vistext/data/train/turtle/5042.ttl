@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Club teams with the most players at the 2018 FIFA World Cup in Russia" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Number of players" .

:YAxis a :Axis ;
    :title "association football club" .

:DataPoint1 a :DataPoint ;
    :xValue "16" ;
    :yValue "Manchester City" ;
    :belongsTo :Chart .

