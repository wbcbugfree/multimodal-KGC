@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Size of the untaxed `` shadow '' economy in selected countries 2010 , as a share of GDP" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Percentage of GDP" .

:YAxis a :Axis ;
    :title "Response" .

:DataPoint1 a :DataPoint ;
    :xValue "0.44" ;
    :yValue "Russia" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "0.39" ;
    :yValue "Brazil" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "0.36" ;
    :yValue "Pakistan" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "0.35" ;
    :yValue "Egypt" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "0.31" ;
    :yValue "Turkey" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "0.28" ;
    :yValue "Greece" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "0.27" ;
    :yValue "Italy" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "0.22" ;
    :yValue "India" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "0.16" ;
    :yValue "Canada" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "0.13" ;
    :yValue "China" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "0.09" ;
    :yValue "U.S." ;
    :belongsTo :Chart .
