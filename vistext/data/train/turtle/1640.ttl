@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Number of people employed in the coal mining industry in the United Kingdom (UK) from 1920 to 2019 (in 1,000s)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Employees in thousands" .

