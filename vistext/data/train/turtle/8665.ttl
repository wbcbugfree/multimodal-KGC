    :xValue "2" ;
    :yValue "USA" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "3" ;
    :yValue "Finland" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "1" ;
    :yValue "Great Britain" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "1" ;
    :yValue "Slovakia" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
