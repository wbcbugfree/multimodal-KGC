@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Medal count of the men 's ice hockey world championship from 1920 to 2019" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Gold" .

:YAxis a :Axis ;
    :title "Country" .

:DataPoint1 a :DataPoint ;
    :xValue "27" ;
    :yValue "Russia*" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "26" ;
    :yValue "Canada" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "12" ;
    :yValue "Czech Republic*" ;
    :belongsTo :Chart .

