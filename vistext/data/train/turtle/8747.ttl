@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Change in the percentage of expenditure for logistics of the GDP of China from 1994 to 2004" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Total logistics costs" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 1993" ;
    :yValue "0.221" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Dec 31, 1994" ;
    :yValue "0.22" ;
    :belongsTo :Chart .

