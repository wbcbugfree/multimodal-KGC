@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Average cost for tuition and other fees at universities in the United States from 2000/01 to 2017/18 (in U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Average cost for tuition and fees" .

:DataPoint1 a :DataPoint ;
    :xValue "2017/18" ;
    :yValue "14042" ;
    :belongsTo :Chart .

