@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Number of plumbing and HVAC contractor establishments in Canada in 2019 , by province" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Number of establishments" .

:YAxis a :Axis ;
    :title "province of Canada" .

