@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Number of community pharmacies owned by independent contractors in England from 2006/07 to 2018/19" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Number of pharmacies" .

:YAxis a :Axis ;
    :title "Year" .

