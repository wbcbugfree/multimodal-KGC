@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Total circulation of community newspapers in Canada from 2013 to 2019 , by province and territory (in 1,000s)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "2013" .

:YAxis a :Axis ;
    :title "province of Canada" .

:DataPoint1 a :DataPoint ;
    :xValue "7805.49" ;
    :yValue "Ontario" ;
    :belongsTo :Chart .

