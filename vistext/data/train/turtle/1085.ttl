@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Natural gas prices for households in Greece from 2012 to 2017 , semi-annually (in euro cents per kilowatt-hour)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Euro cents per kilowatt-hour" .

:YAxis a :Axis ;
    :title "Year" .

:DataPoint1 a :DataPoint ;
    :xValue "5.6" ;
    :yValue "2017 S1*" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "6.52" ;
    :yValue "2016 S2" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "5.64" ;
    :yValue "2016 S1" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "7.5" ;
    :yValue "2015 S2" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "6.81" ;
    :yValue "2015 S1" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "7.98" ;
    :yValue "2014 S2" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "7.23" ;
    :yValue "2014 S1" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "8.88" ;
    :yValue "2013 S2" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "7.72" ;
    :yValue "2013 S1" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "10.17" ;
    :yValue "2012 S2" ;
    :belongsTo :Chart .
