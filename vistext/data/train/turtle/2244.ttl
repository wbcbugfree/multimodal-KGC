@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Ranking of the most registered male baby names in France in 2018" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Number of newly registered male names" .

:YAxis a :Axis ;
    :title "the most registered male baby names" .

