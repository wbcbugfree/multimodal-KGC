@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Rate of homicides in Canada in 2019 , by Aboriginal identity and province or territory (per 100,000 population)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "province of Canada" .

:YAxis a :Axis ;
    :title "Non-Aboriginal" .

:DataPoint1 a :DataPoint ;
    :xValue "Nunavut" ;
    :yValue "0" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Saskatchewan" ;
    :yValue "1.34" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "Manitoba" ;
    :yValue "1.96" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "Alberta" ;
    :yValue "1.6" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "Yukon" ;
    :yValue "0" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Northwest Territories" ;
    :yValue "0" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Ontario" ;
    :yValue "1.51" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "British Columbia" ;
    :yValue "1.56" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "Newfoundland and Labrador" ;
    :yValue "0.63" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "Quebec" ;
    :yValue "0.81" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "Nova Scotia" ;
    :yValue "0.34" ;
    :belongsTo :Chart .

:DataPoint12 a :DataPoint ;
    :xValue "New Brunswick" ;
    :yValue "1.92" ;
    :belongsTo :Chart .

:DataPoint13 a :DataPoint ;
    :xValue "Prince Edward Island" ;
    :yValue "1.34" ;
    :belongsTo :Chart .
