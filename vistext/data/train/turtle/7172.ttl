@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Number of billionaires worldwide from 2001 to 2012 , by region" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Asia-Pacific" .

:YAxis a :Axis ;
    :title "year" .

