@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Prevalence of raised blood pressure in selected countries worldwide in 2014 , by gender" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Country" .

:YAxis a :Axis ;
    :title "Female" .

:DataPoint1 a :DataPoint ;
    :xValue "Australia" ;
    :yValue "0.124" ;
    :belongsTo :Chart .

