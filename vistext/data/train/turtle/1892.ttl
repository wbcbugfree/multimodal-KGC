@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Leading countries based on number of Twitter users as of October 2020 (in millions)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Country" .

:YAxis a :Axis ;
    :title "Audience in millions" .

:DataPoint1 a :DataPoint ;
    :xValue "United States" ;
    :yValue "68.7" ;
    :belongsTo :Chart .

