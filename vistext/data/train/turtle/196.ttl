@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "External debt as percentage of gross domestic product in Latin America in 2018 , by country" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Country" .

:YAxis a :Axis ;
    :title "Foreign debt as share of GDP" .

:DataPoint1 a :DataPoint ;
    :xValue "Argentina" ;
    :yValue "0.418" ;
    :belongsTo :Chart .

