@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Most popular activities for United States leisure travelers to participate in abroad in 2016" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Share of leisure travelers" .

:YAxis a :Axis ;
    :title "Response" .

:DataPoint1 a :DataPoint ;
    :xValue "0.827" ;
    :yValue "Sightseeing" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "0.763" ;
    :yValue "Shopping" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "0.463" ;
    :yValue "Small towns/countryside" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "0.4" ;
    :yValue "Experience fine dining" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "0.411" ;
    :yValue "Historical locations" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "0.399" ;
    :yValue "Guided tours" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "0.338" ;
    :yValue "Art galleries/museums" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "0.336" ;
    :yValue "Cultural/ethnic heritage sites" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "0.312" ;
    :yValue "National parks/monuments" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "0.247" ;
    :yValue "Nightclubbing" ;
    :belongsTo :Chart .
