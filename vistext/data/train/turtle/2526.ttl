@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Major aquaculture producers of Atlantic salmon in 2010 (in 1,000 metric tons)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Amount in thousand metric tons" .

:YAxis a :Axis ;
    :title "Country" .

:DataPoint1 a :DataPoint ;
    :xValue "927.9" ;
    :yValue "Norway" ;
    :belongsTo :Chart .

