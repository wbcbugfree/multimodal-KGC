    :xValue "45.4" ;
    :yValue "Faroe Islands" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "31.8" ;
    :yValue "Australia" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "19.5" ;
    :yValue "United States" ;
    :belongsTo :Chart .

