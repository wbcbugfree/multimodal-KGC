@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Share of female primary education teachers in Malaysia from 2009 to 2018" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "Share of female teachers" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2008" ;
    :yValue "0.69" ;
    :belongsTo :Chart .

