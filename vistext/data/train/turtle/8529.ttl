@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Volume of freight on board reported by airports in Poland from 2017 to 2019 (in 1,000 kg)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "2017" .

:YAxis a :Axis ;
    :title "airports in Poland" .

:DataPoint1 a :DataPoint ;
    :xValue "84389.44" ;
    :yValue "Warsaw Chopin Airport" ;
