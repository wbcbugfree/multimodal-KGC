@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Share of consumers who access e-books or audiobooks through illegal channels worldwide in 2017 , by country" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "Share of respondents" .

:DataPoint1 a :DataPoint ;
    :xValue "Spain" ;
    :yValue "0.21" ;
    :belongsTo :Chart .

