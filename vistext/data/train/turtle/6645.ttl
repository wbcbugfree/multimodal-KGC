@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Total number of Sears Holdings stores worldwide from 2009 - 2018 , by brand" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Hometown Dealers" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2008" ;
    :yValue "960" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Dec 31, 2009" ;
    :yValue "990" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "Dec 31, 2010" ;
    :yValue "1040" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "Dec 31, 2011" ;
    :yValue "1020" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "Dec 31, 2012" ;
    :yValue "1040" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Dec 31, 2013" ;
    :yValue "1020" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Dec 31, 2014" ;
    :yValue "950" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Dec 31, 2015" ;
    :yValue "1010" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "Dec 31, 2016" ;
    :yValue "740" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "Dec 31, 2017" ;
    :yValue "620" ;
    :belongsTo :Chart .
