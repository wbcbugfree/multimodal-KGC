@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Price index of industrial chemicals in Canada from 2005 to 2016" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Price index (2010=100)" .

:DataPoint1 a :DataPoint ;
    :xValue "2016**" ;
    :yValue "101.5" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "2015*" ;
    :yValue "104.5" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "2014*" ;
    :yValue "118.8" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "2013" ;
    :yValue "113.3" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "2012" ;
    :yValue "111.3" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "2011" ;
    :yValue "111.3" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "2010" ;
    :yValue "100" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "2009" ;
    :yValue "92.2" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "2008" ;
    :yValue "103.4" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "2007" ;
    :yValue "96.6" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "2006" ;
    :yValue "93.4" ;
    :belongsTo :Chart .

:DataPoint12 a :DataPoint ;
    :xValue "2005" ;
    :yValue "90.7" ;
    :belongsTo :Chart .
