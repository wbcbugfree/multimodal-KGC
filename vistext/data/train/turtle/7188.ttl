@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Number of hospital-acquired infections (HAI) of coronavirus disease (COVID-19) in Japan as of April 20 , 2020 , by prefecture" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Number of facilities" .

:YAxis a :Axis ;
    :title "prefecture of Japan" .

:DataPoint1 a :DataPoint ;
    :xValue "8" ;
    :yValue "Tokyo" ;
    :belongsTo :Chart .

