@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Leading countries based on number of asylum and refugee status applications from Venezuelan citizens in 2019" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Refugees" .

:YAxis a :Axis ;
    :title "Country" .

:DataPoint1 a :DataPoint ;
    :xValue "1230" ;
    :yValue "Peru" ;
    :belongsTo :Chart .

