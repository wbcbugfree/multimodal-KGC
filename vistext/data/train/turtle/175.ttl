@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Number of Merck & Co. 's common shares outstanding from 2009 to 2019 (in millions)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Number of shares in millions" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2008" ;
    :yValue "2268" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Dec 31, 2009" ;
    :yValue "3095" ;
    :belongsTo :Chart .

