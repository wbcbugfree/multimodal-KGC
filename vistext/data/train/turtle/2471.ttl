@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Major countries of destination for U.S. fresh fruit exports in 2018 (in 1,000 metric tons)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Country" .

:YAxis a :Axis ;
    :title "Exports in thousand metric tons" .

:DataPoint1 a :DataPoint ;
    :xValue "Mexico" ;
    :yValue "462.73" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Canada" ;
    :yValue "350.82" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "India" ;
    :yValue "154.07" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "Taiwan" ;
    :yValue "81.33" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "Hong Kong" ;
    :yValue "58.55" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Vietnam" ;
    :yValue "53.03" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "South Korea" ;
    :yValue "41.96" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Indonesia" ;
    :yValue "35.06" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "China" ;
    :yValue "31.95" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "Dominican Republic" ;
    :yValue "24.99" ;
    :belongsTo :Chart .
