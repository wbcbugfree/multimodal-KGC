@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Leading B2B marketing technology companies worldwide in 2016 , by revenue (in million U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Revenue in million U.S. dollars" .

:YAxis a :Axis ;
    :title "Platform" .

:DataPoint1 a :DataPoint ;
    :xValue "699" ;
    :yValue "Dun & Bradstreet" ;
    :belongsTo :Chart .

