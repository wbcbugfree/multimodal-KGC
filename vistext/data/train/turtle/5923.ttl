    :yValue "Equifax" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "186" ;
    :yValue "Teikoku Databank" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "186" ;
