    :xValue "8730" ;
    :yValue "Illinois" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "7724" ;
    :yValue "Pennsylvania" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "6991" ;
    :yValue "New Jersey" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "6143" ;
    :yValue "Ohio" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
