@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Share of consumers who convinced others to stop using a brand due to its inappropriate response to the coronavirus pandemic worldwide as of March 2020 , by country" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "Share of respondents" .

:DataPoint1 a :DataPoint ;
    :xValue "China" ;
    :yValue "0.76" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "India" ;
    :yValue "0.6" ;
    :belongsTo :Chart .

