    :xValue "South Africa" ;
    :yValue "0.27" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "United States" ;
    :yValue "0.27" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Italy" ;
    :yValue "0.25" ;
    :belongsTo :Chart .

