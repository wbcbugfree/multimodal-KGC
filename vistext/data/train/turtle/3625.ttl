@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Distribution of cyber stalking victims in 2013 , by how harassment began" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Share of respondents" .

:YAxis a :Axis ;
    :title "Response" .

:DataPoint1 a :DataPoint ;
    :xValue "0.3" ;
    :yValue "E-mail" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "0.3" ;
    :yValue "Facebook" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "0.14" ;
    :yValue "Web site" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "0.08" ;
    :yValue "Texting" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "0.04" ;
    :yValue "Message board (including Yahoo Groups, newsgroups)" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "0.03" ;
    :yValue "Dating site" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "0.03" ;
    :yValue "Twitter" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "0.02" ;
    :yValue "Myspace" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "0.02" ;
    :yValue "Instant messaging" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "0.02" ;
    :yValue "Blogs" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "0.01" ;
    :yValue "Impersonation" ;
    :belongsTo :Chart .

:DataPoint12 a :DataPoint ;
    :xValue "0.01" ;
    :yValue "Youtube" ;
    :belongsTo :Chart .
