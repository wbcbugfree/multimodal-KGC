@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Per capita Apple App Store spending in selected countries from 2012 to 2017 (in U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Country" .

:YAxis a :Axis ;
    :title "Per capita spending in U.S. dollars" .

:DataPoint1 a :DataPoint ;
    :xValue "Japan" ;
    :yValue "214" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Australia" ;
    :yValue "114" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "United States" ;
    :yValue "92" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "Switzerland" ;
    :yValue "91" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "Denmark" ;
    :yValue "88" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Norway" ;
    :yValue "87" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Signapore" ;
    :yValue "85" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Canada" ;
    :yValue "68" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "Luxembourg" ;
    :yValue "67" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "Great Britain" ;
    :yValue "65" ;
    :belongsTo :Chart .
