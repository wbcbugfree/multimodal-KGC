@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Net revenue from investment banking at Goldman Sachs from 2009 to 2019 (in billion U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Net revenue in billion U.S. dollars" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2008" ;
    :yValue "4.98" ;
    :belongsTo :Chart .

