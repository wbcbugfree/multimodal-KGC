@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Annual turnover of the manufacture of rubber and plastic products in the Czech Republic from 2008 to 2018 (in million euros)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Annual turnover in million euros" .

:YAxis a :Axis ;
    :title "Year" .

