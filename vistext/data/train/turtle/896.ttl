@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Reach of leading social networking sites used by 15 to 25-year-olds in Germany as of 3rd quarter 2020" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "Share of respondents" .

:DataPoint1 a :DataPoint ;
    :xValue "WhatsApp" ;
    :yValue "0.94" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "YouTube" ;
    :yValue "0.89" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "Facebook" ;
    :yValue "0.69" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "Instagram" ;
    :yValue "0.68" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "Snapchat" ;
    :yValue "0.4" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Pinterest" ;
    :yValue "0.29" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Twitter" ;
    :yValue "0.29" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Reddit" ;
    :yValue "0.19" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "TikTok" ;
    :yValue "0.16" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "LinkedIn" ;
    :yValue "0.11" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "Xing" ;
    :yValue "0.08" ;
    :belongsTo :Chart .

:DataPoint12 a :DataPoint ;
    :xValue "Tumblr" ;
    :yValue "0.07" ;
    :belongsTo :Chart .
