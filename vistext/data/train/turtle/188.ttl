@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Sales of power transistors worldwide from 2008 to 2024 (in billion U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Sales in billion U.S. dollars" .

:DataPoint1 a :DataPoint ;
    :xValue "2008" ;
    :yValue "10" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "2009" ;
    :yValue "8.4" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "2010" ;
    :yValue "12" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "2011" ;
    :yValue "13.5" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "2012" ;
    :yValue "12.4" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "2013" ;
    :yValue "11.6" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "2014" ;
    :yValue "13.2" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "2015" ;
    :yValue "12.3" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "2016" ;
    :yValue "12.9" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "2017*" ;
    :yValue "13.6" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "2018" ;
    :yValue "16.3" ;
    :belongsTo :Chart .

:DataPoint12 a :DataPoint ;
    :xValue "2019" ;
    :yValue "17.1" ;
    :belongsTo :Chart .

:DataPoint13 a :DataPoint ;
    :xValue "2020*" ;
    :yValue "15.9" ;
    :belongsTo :Chart .

:DataPoint14 a :DataPoint ;
    :xValue "2021*" ;
    :yValue "16.9" ;
    :belongsTo :Chart .

:DataPoint15 a :DataPoint ;
    :xValue "2022*" ;
    :yValue "17.7" ;
    :belongsTo :Chart .

:DataPoint16 a :DataPoint ;
    :xValue "2024*" ;
    :yValue "18.6" ;
    :belongsTo :Chart .
