@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Annual consumption of packaged water in Italy from 2010 to 2019 (in million liters)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Consumption in million liters" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2009" ;
    :yValue "10909.2" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Dec 31, 2010" ;
    :yValue "10925.6" ;
    :belongsTo :Chart .

