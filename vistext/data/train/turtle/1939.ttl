@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Personal consumption expenditures on arts and culture in the United States from 1999 to 2012 (as percentage of total)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Arts and culture spending as percentage of total" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 1998" ;
    :yValue "0.0188" ;
    :belongsTo :Chart .

