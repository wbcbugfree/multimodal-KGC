@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "The cities and municipalities with the highest population in Belgium in 2019" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Number of residents" .

:YAxis a :Axis ;
    :title "city" .

:DataPoint1 a :DataPoint ;
    :xValue "525935" ;
    :yValue "Antwerpen" ;
    :belongsTo :Chart .

