@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Canada 's total imports of cereals from 2000/01 to 2018/19 (in million metric tons)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Imports in million metric tons" .

