@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Which of the following desserts do you prefer ?" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Share of respondents" .

:YAxis a :Axis ;
    :title "Response" .

:DataPoint1 a :DataPoint ;
    :xValue "0.26" ;
    :yValue "Chocolate mousse" ;
    :belongsTo :Chart .

