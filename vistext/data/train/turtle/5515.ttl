@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Number of visitor arrivals in Helsinki , Finland in 2019 , by country of origin" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Number of visitors" .

:YAxis a :Axis ;
    :title "Country" .

