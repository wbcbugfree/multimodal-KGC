@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Average age at death in the Netherlands from 1950 to 2018 , by gender" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Women" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 1949" ;
    :yValue "63.2" ;
    :belongsTo :Chart .

