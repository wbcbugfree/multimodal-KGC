@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Sheep and goat meat production in the Netherlands from 2010 to 2019 (in metric tons)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Production in metric tons" .

:YAxis a :Axis ;
    :title "Year" .

:DataPoint1 a :DataPoint ;
    :xValue "18000" ;
    :yValue "2019*" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "20000" ;
    :yValue "2018" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "17000" ;
    :yValue "2017" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "18000" ;
    :yValue "2016" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "18000" ;
    :yValue "2015" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "18000" ;
    :yValue "2014" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "16000" ;
    :yValue "2013" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "15000" ;
    :yValue "2012" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "15000" ;
    :yValue "2011" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "17000" ;
    :yValue "2010" ;
    :belongsTo :Chart .
