@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Distribution of ransomware detections worldwide from January to June 2017 , by country" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Share of infections" .

:YAxis a :Axis ;
    :title "Response" .

:DataPoint1 a :DataPoint ;
    :xValue "0.29" ;
    :yValue "United States" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "0.09" ;
    :yValue "Japan" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "0.08" ;
    :yValue "Italy" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "0.04" ;
    :yValue "India" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "0.04" ;
    :yValue "Germany" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "0.03" ;
    :yValue "Netherlands" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "0.03" ;
    :yValue "United Kingdom" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "0.03" ;
    :yValue "Australia" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "0.03" ;
    :yValue "Russia" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "0.03" ;
    :yValue "Canada" ;
    :belongsTo :Chart .
