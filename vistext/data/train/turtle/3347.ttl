@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Funding raised by United Kingdom based company Oxford Nanopore Technologies Limited as of March 2018 (in million GBP)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Funding raised in million GBP" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2005" ;
    :yValue "7.75" ;
    :belongsTo :Chart .

