@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Total U.S. grain imports from 2001 to 2016 (in million metric tons)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Imports in million metric tons" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2000" ;
    :yValue "5.8" ;
    :belongsTo :Chart .

