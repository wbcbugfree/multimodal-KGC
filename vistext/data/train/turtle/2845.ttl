@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Effectiveness of recruitment channels worldwide in 2018 , by effectiveness score" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Recruitment Channel" .

:YAxis a :Axis ;
    :title "Effectiveness score" .

:DataPoint1 a :DataPoint ;
    :xValue "Hiring manager" ;
    :yValue "19.35" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Internal mobility" ;
    :yValue "15.42" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "Custom campaign" ;
    :yValue "8.39" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "Entered by recruiter" ;
    :yValue "6.61" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "Social media shares" ;
    :yValue "5.65" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Referral" ;
    :yValue "4.66" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Federated search" ;
    :yValue "4.36" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Resume search" ;
    :yValue "3.82" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "Notifications" ;
    :yValue "3.64" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "Agency" ;
    :yValue "2.79" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "Email campaign" ;
    :yValue "2.29" ;
    :belongsTo :Chart .

:DataPoint12 a :DataPoint ;
    :xValue "Career site" ;
    :yValue "0.83" ;
    :belongsTo :Chart .

:DataPoint13 a :DataPoint ;
    :xValue "Job boards" ;
    :yValue "0.39" ;
    :belongsTo :Chart .
