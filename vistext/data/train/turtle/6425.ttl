@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Leading countries based on natural gas production in 2014 and 2018 (in billion cubic meters)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "2014" .

:YAxis a :Axis ;
    :title "Country" .

:DataPoint1 a :DataPoint ;
    :xValue "729.1" ;
    :yValue "United States" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "610.1" ;
    :yValue "Russia" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "172.6" ;
    :yValue "Iran" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "160" ;
    :yValue "Qatar" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "132.8" ;
    :yValue "China" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "161.3" ;
    :yValue "Canada" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "55.3" ;
    :yValue "Australia" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "108.8" ;
    :yValue "Norway" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "108.2" ;
    :yValue "Saudi Arabia" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "79.7" ;
    :yValue "Algeria" ;
    :belongsTo :Chart .
