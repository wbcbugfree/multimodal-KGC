@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Distribution of installed utility-scale and behind-the-meter energy storage capacity worldwide from 2015 to 2024" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Utility-scale" .

:YAxis a :Axis ;
    :title "Year" .

:DataPoint1 a :DataPoint ;
    :xValue "0.34" ;
    :yValue "2024*" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "0.37" ;
    :yValue "2023*" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "0.42" ;
    :yValue "2022*" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "0.47" ;
    :yValue "2021*" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "0.57" ;
    :yValue "2020*" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "0.66" ;
    :yValue "2019*" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "0.73" ;
    :yValue "2018*" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "0.84" ;
    :yValue "2017*" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "0.84" ;
    :yValue "2016" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "0.84" ;
    :yValue "2015" ;
    :belongsTo :Chart .
