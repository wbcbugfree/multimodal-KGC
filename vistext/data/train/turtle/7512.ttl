@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Export value of chewing gum from the United Kingdom from 2004 to 2018 , by EU and non-EU trade (in GBP)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Non EU" .

