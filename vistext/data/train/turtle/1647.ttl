@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Leading financial advisors to M & A in Benelux countries in 2016 , by deal value (in billion U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Financial Advisory Company" .

:YAxis a :Axis ;
    :title "Deal value in billion U.S. dollar" .

:DataPoint1 a :DataPoint ;
    :xValue "Goldman Sachs" ;
    :yValue "68.94" ;
    :belongsTo :Chart .

