@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Warehouse automation market share worldwide in 2017 , by company" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Market share" .

:YAxis a :Axis ;
    :title "business" .

