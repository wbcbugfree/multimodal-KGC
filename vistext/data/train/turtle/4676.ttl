@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Annual growth of the average new house price in Spain between June 2007 and June 2020 (in euros per square meter built)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Price in euros per square meter built" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2006" ;
    :yValue "2874" ;
    :belongsTo :Chart .

