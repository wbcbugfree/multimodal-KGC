@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Number of retail chains in Germany in 2020 , by sector" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "sector" .

:YAxis a :Axis ;
    :title "Number of retail chains" .

