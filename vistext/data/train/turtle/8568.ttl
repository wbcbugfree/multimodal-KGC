@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Total population of Antigua and Barbuda from 2008 to 2018 , by gender (in 1,000 inhabitants)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Total" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2007" ;
    :yValue "85.4" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Dec 31, 2008" ;
    :yValue "86.75" ;
    :belongsTo :Chart .

