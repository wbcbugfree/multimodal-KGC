@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Total number of confirmed coronavirus (COVID-19) cases in the Eastern Mediterranean region as of November 3 , 2020 , by country" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Number of cases" .

:YAxis a :Axis ;
    :title "Country" .

