@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Resident population of the United States by race from 2000 to 2019 (in millions)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Black or African American" .

