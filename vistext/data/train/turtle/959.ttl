@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Market share of the leading physician-dispensed topical brands in the United States in 2012" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Topical brand" .

:YAxis a :Axis ;
    :title "Market share" .

:DataPoint1 a :DataPoint ;
    :xValue "Other" ;
    :yValue "0.369" ;
    :belongsTo :Chart .

