@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Percentage of office-based physicians with EMR/EHR systems in the United States from 2001 to 2017" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Any EMR/EHR system" .

