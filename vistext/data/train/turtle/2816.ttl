@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Number of motorcycle drivers fatalities in Spanish urban roads from 2005 to 2018" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Number of deaths*" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2004" ;
    :yValue "109" ;
    :belongsTo :Chart .

