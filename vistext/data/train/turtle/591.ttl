@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Most popular online shopping categories of netizens in Indonesia as of August 2013" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Share of netizens ever bought product" .

:YAxis a :Axis ;
    :title "Response" .

:DataPoint1 a :DataPoint ;
    :xValue "0.671" ;
    :yValue "Apparel" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "0.202" ;
    :yValue "Shoes" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "0.2" ;
    :yValue "Bags" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "0.076" ;
    :yValue "Watches" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "0.051" ;
    :yValue "Airline tickets" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "0.051" ;
    :yValue "Handphones" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "0.03" ;
    :yValue "Car accessories" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "0.028" ;
    :yValue "Handphone accessories" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "0.023" ;
    :yValue "Cosmetics" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "0.018" ;
    :yValue "Books" ;
    :belongsTo :Chart .
