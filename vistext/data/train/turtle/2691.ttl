@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Leading eSports professional players on Facebook worldwide as of January 2016 , by number of fans (in 1,000s)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Player" .

:YAxis a :Axis ;
    :title "Number of Facebook likes in thousands" .

:DataPoint1 a :DataPoint ;
    :xValue "Lee Sang-hyeok (Faker)" ;
    :yValue "806" ;
    :belongsTo :Chart .

