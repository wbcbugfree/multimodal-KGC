@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Price for refined tin from 2014 to 2030 (in U.S. dollars per metric ton)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Price in U.S. dollars per metric ton" .

:YAxis a :Axis ;
    :title "Year" .

:DataPoint1 a :DataPoint ;
    :xValue "23000" ;
    :yValue "2030*" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "18735" ;
    :yValue "2025*" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "17259" ;
    :yValue "2023*" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "16566" ;
    :yValue "2022*" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "15900" ;
    :yValue "2021*" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "15700" ;
    :yValue "2020*" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "18661" ;
    :yValue "2019" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "20145" ;
    :yValue "2018" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "20061" ;
    :yValue "2017" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "17934" ;
    :yValue "2016" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "16067" ;
    :yValue "2015" ;
    :belongsTo :Chart .

:DataPoint12 a :DataPoint ;
    :xValue "21899" ;
    :yValue "2014" ;
    :belongsTo :Chart .
