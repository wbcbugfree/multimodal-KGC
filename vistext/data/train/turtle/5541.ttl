@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "College majors with the highest unemployment rates in the U.S. between 2009 and 2012" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Share of unemployed U.S. students" .

:YAxis a :Axis ;
    :title "Response" .

:DataPoint1 a :DataPoint ;
    :xValue "0.123" ;
    :yValue "International Business" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "0.121" ;
    :yValue "Computer and Information Systems" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "0.113" ;
    :yValue "Miscellaneous Computer" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "0.109" ;
    :yValue "Anthropology and Archeology" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "0.109" ;
    :yValue "Political Science and Government" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "0.103" ;
    :yValue "Architecture" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "0.103" ;
    :yValue "Philosophy and Religious Studies" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "0.102" ;
    :yValue "Fine Arts" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "0.099" ;
    :yValue "Commercial Art and Graphic Design" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "0.098" ;
    :yValue "Economics" ;
    :belongsTo :Chart .
