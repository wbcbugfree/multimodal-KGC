    :xValue "Dec 31, 2014" ;
    :yValue "2.76" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Dec 31, 2015" ;
    :yValue "2.87" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Dec 31, 2016" ;
    :yValue "2.88" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
