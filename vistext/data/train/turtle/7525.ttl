@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Minor League Baseball attendance by league in the U.S. from 2011 to 2012 (in millions)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "2011" .

:YAxis a :Axis ;
    :title "Minor League Baseball" .

:DataPoint1 a :DataPoint ;
    :xValue "6.93" ;
    :yValue "Pacific Coast League" ;
    :belongsTo :Chart .

