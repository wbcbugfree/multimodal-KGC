@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Average age of PCs in the Middle East and Africa from 2006 to 2015 (in years)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Average age in years" .

:DataPoint1 a :DataPoint ;
    :xValue "2015*" ;
    :yValue "6" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "2014*" ;
    :yValue "5.8" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "2013*" ;
    :yValue "5.6" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "2012*" ;
    :yValue "5.5" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "2011*" ;
    :yValue "5.7" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "2010" ;
    :yValue "6.2" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "2009" ;
    :yValue "5.6" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "2008" ;
    :yValue "5.4" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "2007" ;
    :yValue "5.1" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "2006" ;
    :yValue "5" ;
    :belongsTo :Chart .
