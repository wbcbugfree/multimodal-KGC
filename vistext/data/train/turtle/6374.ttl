@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Average cigarette prices in Canada from 2006 to 2014 , by region (in Canadian dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "region of Canada" .

:YAxis a :Axis ;
    :title "Apr 1, 2014" .

:DataPoint1 a :DataPoint ;
    :xValue "British Columbia" ;
    :yValue "104.96" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Alberta" ;
    :yValue "92.94" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "Saskatchewan" ;
    :yValue "110.22" ;
    :belongsTo :Chart .

