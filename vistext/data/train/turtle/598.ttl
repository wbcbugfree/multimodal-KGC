@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Breakdown of China 's crude oil imports in 2014 , by source country" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "Share of imports" .

:DataPoint1 a :DataPoint ;
    :xValue "Saudi Arabia" ;
    :yValue "0.16" ;
    :belongsTo :Chart .

