@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Major countries of destination for U.S. soybean exports in 2018 (in million metric tons)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Country" .

:YAxis a :Axis ;
    :title "Exports in million metric tons" .

:DataPoint1 a :DataPoint ;
    :xValue "China" ;
    :yValue "8.34" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Mexico" ;
    :yValue "4.57" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "Netherlands" ;
    :yValue "3.78" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "Egypt" ;
    :yValue "3.19" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "Indonesia" ;
    :yValue "2.64" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Japan" ;
    :yValue "2.34" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Taiwan" ;
    :yValue "2.19" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Argentina" ;
    :yValue "2.05" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "Pakistan" ;
    :yValue "1.93" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "Spain" ;
    :yValue "1.81" ;
    :belongsTo :Chart .
