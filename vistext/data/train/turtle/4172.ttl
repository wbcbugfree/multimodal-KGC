@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Average annual first-team player salary in the Scottish Premiership in Scotland in 2019/2020 , by football club (in 1,000 GBP)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Average salary in thousand GBP" .

:YAxis a :Axis ;
    :title "association football club" .

