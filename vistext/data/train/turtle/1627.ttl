@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "LCD panel production capacity of AUO from 2006 to 2017 (in million square meters)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Production capacity in million square meters" .

:DataPoint1 a :DataPoint ;
    :xValue "2017*" ;
    :yValue "32.92" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "2016*" ;
    :yValue "32.83" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "2015*" ;
    :yValue "30.83" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "2014" ;
    :yValue "30.37" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "2013" ;
    :yValue "30.16" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "2012" ;
    :yValue "29.2" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "2011" ;
    :yValue "28.23" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "2010" ;
    :yValue "26.34" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "2009" ;
    :yValue "21.99" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "2008" ;
    :yValue "18.49" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "2007" ;
