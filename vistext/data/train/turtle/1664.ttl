@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Cities with the largest number of pickleball courts per 20,000 residents in the United States in 2019" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "City and State in US" .

:YAxis a :Axis ;
    :title "Pickleball courts per 20,000 residents" .

:DataPoint1 a :DataPoint ;
    :xValue "Seattle, WA" ;
    :yValue "2.7" ;
    :belongsTo :Chart .

