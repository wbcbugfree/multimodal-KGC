@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "U.S. electric capacity resources for the SERC region during the summer peak period between 1998 and 2010 (in megawatts)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Capacity resources in megawatts" .

