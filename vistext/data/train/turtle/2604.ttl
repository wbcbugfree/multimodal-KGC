@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Installed power capacity across Uttarakhand in India from financial year 2005 to 2018 (in megawatts)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Installed power capacity in megawatts" .

:YAxis a :Axis ;
    :title "year" .

:DataPoint1 a :DataPoint ;
    :xValue "3399.14" ;
    :yValue "FY 2018" ;
    :belongsTo :Chart .

