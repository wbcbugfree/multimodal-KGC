@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Chicago Blackhawks operating income from 2005/06 to 2018/19 (in million U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Operating income in million U.S. dollars" .

:YAxis a :Axis ;
    :title "Year" .

:DataPoint1 a :DataPoint ;
    :xValue "69" ;
    :yValue "2018/19" ;
    :belongsTo :Chart .

