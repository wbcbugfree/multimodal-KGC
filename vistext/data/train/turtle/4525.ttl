@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Which are the most important problems for you in Switzerland ?" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Share of respondents" .

:YAxis a :Axis ;
    :title "Response" .

:DataPoint1 a :DataPoint ;
    :xValue "0.47" ;
    :yValue "Retirement and old-age provision" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "0.41" ;
    :yValue "Health/ insurance companies" ;
    :belongsTo :Chart .

