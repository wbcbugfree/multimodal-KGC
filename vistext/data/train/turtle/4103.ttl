@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Urban population in Malaysia from 2005 to 2018 (in 1,000s)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Urban population in thousands" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2004" ;
    :yValue "17087.6" ;
    :belongsTo :Chart .

