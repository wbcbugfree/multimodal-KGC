@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Market value of global agrochemicals from 2006 to 2019 by type (in million U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Crop protection" .

:YAxis a :Axis ;
    :title "Year" .

:DataPoint1 a :DataPoint ;
    :xValue "59827" ;
    :yValue "2019" ;
    :belongsTo :Chart .

