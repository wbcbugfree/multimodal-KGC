    :xValue "44015" ;
    :yValue "2011*" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "38315" ;
    :yValue "2010*" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "37860" ;
    :yValue "2009*" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "40475" ;
    :yValue "2008*" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
