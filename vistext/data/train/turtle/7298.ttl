@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Number of homicides in Brazil from 2006 to 2018 , by gender (in 1,000s)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Men" .

:YAxis a :Axis ;
    :title "Year" .

:DataPoint1 a :DataPoint ;
    :xValue "53.44" ;
    :yValue "2018*" ;
    :belongsTo :Chart .

