@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Number of individual firearms licenses held in Canada in 2018 , by province or territory" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "administrative territorial entity of Canada" .

:YAxis a :Axis ;
    :title "Number of firearms licenses" .

:DataPoint1 a :DataPoint ;
    :xValue "Ontario" ;
    :yValue "616489" ;
    :belongsTo :Chart .

