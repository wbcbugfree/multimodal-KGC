@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Merger and acquisitions (M & A) transaction volume in the United Kingdom (UK) in 2018 and 2019 , by city or region" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "city or region of United Kingdom" .

:YAxis a :Axis ;
    :title "2018" .

:DataPoint1 a :DataPoint ;
    :xValue "Londo" ;
    :yValue "3105" ;
    :belongsTo :Chart .

