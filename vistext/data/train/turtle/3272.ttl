@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Percentage of weekly household expenditure going on take away meals eaten at home in the United Kingdom (UK) in 2019 , by disposable income decile group" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Percentage of spending" .

:YAxis a :Axis ;
    :title "Disposable income decile group*" .

:DataPoint1 a :DataPoint ;
    :xValue "0.009" ;
    :yValue "Lowest ten percent" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "0.009" ;
    :yValue "Second decile group" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "0.01" ;
    :yValue "Third decile group" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "0.009" ;
    :yValue "Fourth decile group" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "0.009" ;
    :yValue "Fifth decile group" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "0.009" ;
    :yValue "Sixth decile group" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "0.009" ;
    :yValue "Seventh decile group" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "0.01" ;
    :yValue "Eighth decile group" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "0.01" ;
    :yValue "Ninth decile group" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "0.008" ;
    :yValue "Highest ten percent" ;
    :belongsTo :Chart .
