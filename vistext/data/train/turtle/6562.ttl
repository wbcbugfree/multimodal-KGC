:DataPoint10 a :DataPoint ;
    :xValue "Cloud MOM Services Cloud Database services (dbPaas" ;
    :yValue "0.02" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "Cloud Database services (dbPaas) Cloud Horizontal Portal Services (Portal PaaS" ;
