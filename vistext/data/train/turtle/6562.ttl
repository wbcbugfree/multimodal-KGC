@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Platform as a Service (PaaS) market share in 2011 and 2016 , by type of service" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "different Platform as a Service (PaaS) systems" .

:YAxis a :Axis ;
    :title "2011" .

:DataPoint1 a :DataPoint ;
    :xValue "Cloud Application platform services (aPaaS" ;
    :yValue "0.35" ;
    :belongsTo :Chart .

