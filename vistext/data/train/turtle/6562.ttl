    :yValue "0.11" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "Cloud Integration services (iPaaS) Cloud Application Security Service" ;
    :yValue "0.11" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Cloud Application Security Services Cloud MFT Service" ;
    :yValue "0.08" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Cloud MFT Services Cloud Application Services Governanc" ;
    :yValue "0.04" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Cloud Application Services Governance Cloud Business Analytics Services (baPaaS" ;
    :yValue "0.03" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "Cloud Business Analytics Services (baPaaS) Cloud MOM Service" ;
    :yValue "0.02" ;
