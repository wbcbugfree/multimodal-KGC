@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Number of tourist arrivals from the United Kingdom (UK) in Lanzarote in 2014 , by region of origin" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "region of England" .

:YAxis a :Axis ;
    :title "Number of arrivals" .

:DataPoint1 a :DataPoint ;
    :xValue "North-West" ;
    :yValue "147634" ;
    :belongsTo :Chart .

