@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Exports value of fresh or chilled mushrooms worldwide in 2019 , by leading country (in million U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Country" .

:YAxis a :Axis ;
    :title "Export value in millioin U.S. dollars" .

:DataPoint1 a :DataPoint ;
    :xValue "Poland" ;
    :yValue "401.55" ;
    :belongsTo :Chart .

