@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Pharmaceutical company ranking based on product donations in developing countries in 2018" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Pharmaceutical company" .

:YAxis a :Axis ;
    :title "Indicator score from 1 (lowest) to 5 (highest)" .

:DataPoint1 a :DataPoint ;
    :xValue "Sanofi" ;
    :yValue "5" ;
    :belongsTo :Chart .

