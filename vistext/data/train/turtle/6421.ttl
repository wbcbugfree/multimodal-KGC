@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Reinsurance losses of Munich Re from natural disasters from 2008 to 2019 (in million euros)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Major losses (net)" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2007" ;
    :yValue "1507" ;
    :belongsTo :Chart .

