@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Preferred number of TV show episodes to watch in one binge watching session among Millennials in the United Kingdom (UK) in December 2016" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "25-39 years" .

:DataPoint1 a :DataPoint ;
    :xValue "1 episode" ;
    :yValue "0.02" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "2 episodes" ;
    :yValue "0.06" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "3 episodes" ;
    :yValue "0.18" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "4 episodes" ;
    :yValue "0.16" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "5 episodes" ;
    :yValue "0.14" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "6 episodes" ;
    :yValue "0.08" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "7 episodes" ;
    :yValue "0.02" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "8 episodes" ;
    :yValue "0.05" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "9 episodes" ;
    :yValue "0.01" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "10 episodes" ;
    :yValue "0.03" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "More than 10 episodes" ;
    :yValue "0.1" ;
    :belongsTo :Chart .

:DataPoint12 a :DataPoint ;
    :xValue "Don't know" ;
    :yValue "0.15" ;
    :belongsTo :Chart .
