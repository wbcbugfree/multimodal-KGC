@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "E-Government Development Index (EGDI) in selected Latin American countries in 2018 (index rating)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Index score" .

:YAxis a :Axis ;
    :title "Country" .

:DataPoint1 a :DataPoint ;
    :xValue "0.79" ;
    :yValue "Uruguay" ;
    :belongsTo :Chart .

