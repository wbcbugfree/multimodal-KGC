    :xValue "Orange County, FL" ;
    :yValue "149457" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "Cook County, IL" ;
    :yValue "133882" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "Philadelphia County, PA" ;
    :yValue "121643" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "NY County, NY" ;
    :yValue "107774" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Queens County, NY" ;
    :yValue "102881" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Hartford County, CT" ;
    :yValue "95964" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "Miami-Dade County, FL" ;
