@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Largest Puerto Rican-American population groups in the United States , by county 2010" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Counties Of US" .

:YAxis a :Axis ;
    :title "Population number" .

:DataPoint1 a :DataPoint ;
    :xValue "Bronx County, NY" ;
    :yValue "298921" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Kings County, NY" ;
    :yValue "176528" ;
    :belongsTo :Chart .

