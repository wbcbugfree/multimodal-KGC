@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Total sales floor space of Fast Retailing worldwide from fiscal year 2010 to 2019 (in square-meters)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Sales floor space in n square-meters" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2008" ;
    :yValue "740489" ;
    :belongsTo :Chart .

