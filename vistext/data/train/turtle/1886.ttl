@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Import volume of candles to the European Union (EU 28) from 2009 to 2018 (in tons)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Imports in tons" .

