    :xValue "100" ;
    :yValue "875 North Michigan Avenue(Chicago)" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "98" ;
    :yValue "Trump International Hotel & Tower(Chicago)" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "96" ;
    :yValue "432 Park Avenue(New York City)" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "83" ;
    :yValue "Aon Center(Chicago)" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
