@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Ranking of skyscrapers in the U.S. as of 2019 , by number of floors" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Number of floors" .

:YAxis a :Axis ;
    :title "Building (city)" .

:DataPoint1 a :DataPoint ;
    :xValue "108" ;
    :yValue "Willis Tower(Chicago)" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "104" ;
    :yValue "One World Trade Center(New York City)" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "102" ;
    :yValue "Empire State Building(New York City)" ;
    :belongsTo :Chart .

