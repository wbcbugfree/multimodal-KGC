@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Global foreign direct investment (FDI) position of the United Kingdom (UK) from 2004 to 2018 (in billion GBP)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Foreign direct investment in billion GBP" .

