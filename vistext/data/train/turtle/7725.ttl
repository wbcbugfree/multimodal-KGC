@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Public concern about the pollution of drinking water in the United States from 1990 to 2017" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "Not at all" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 1989" ;
    :yValue "0.04" ;
    :belongsTo :Chart .

