@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Change in rental costs due to the coronavirus (COVID-19) in Poland between March and April 2020 , by major cities" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "March 2020/March 2019" .

:YAxis a :Axis ;
    :title "major city of Poland" .

:DataPoint1 a :DataPoint ;
    :xValue "0.17" ;
    :yValue "Białystok" ;
    :belongsTo :Chart .

