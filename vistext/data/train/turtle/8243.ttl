    :xValue "New Brunswick" ;
    :yValue "0.119" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Quebec" ;
    :yValue "0.027" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Ontario" ;
    :yValue "0.01" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Manitoba" ;
    :yValue "0.045" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "Saskatchewan" ;
    :yValue "0.001" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "Alberta" ;
    :yValue "0.012" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "British Columbia" ;
