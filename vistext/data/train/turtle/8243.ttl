@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Distribution of municipal wastewater discharges treatment type in Canada as of 2017 , by province" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Country" .

:YAxis a :Axis ;
    :title "No treatment (including CSOs)*" .

:DataPoint1 a :DataPoint ;
    :xValue "Canada" ;
    :yValue "0.044" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Newfoundland and Labrador" ;
    :yValue "0.366" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "Prince Edward Island" ;
    :yValue "0" ;
    :belongsTo :Chart .

