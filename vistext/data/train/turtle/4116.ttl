@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Germany : national debt from 2010 to 2022 in relation to gross domestic product (GDP)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "National debt as percent of GDP" .

:DataPoint1 a :DataPoint ;
    :xValue "2024" ;
    :yValue "0.437" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "2023*" ;
    :yValue "0.4602" ;
    :belongsTo :Chart .

