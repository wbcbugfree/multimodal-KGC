@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Public sector expenditure on unemployment benefits in the United Kingdom (UK) from 2009/10 to 2019/20 (in billion GBP)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Expenditure in billion GBP" .

:YAxis a :Axis ;
    :title "Year" .

:DataPoint1 a :DataPoint ;
    :xValue "1.19" ;
    :yValue "2019/20" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "1.68" ;
    :yValue "2018/19" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "2.02" ;
    :yValue "2017/18" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "2.23" ;
    :yValue "2016/17" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "2.7" ;
    :yValue "2015/16" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "3.47" ;
    :yValue "2014/15" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "4.95" ;
    :yValue "2013/14" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "5.94" ;
    :yValue "2012/13" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "5.63" ;
    :yValue "2011/12" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "5.23" ;
    :yValue "2010/11" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "5.53" ;
    :yValue "2009/10" ;
    :belongsTo :Chart .
