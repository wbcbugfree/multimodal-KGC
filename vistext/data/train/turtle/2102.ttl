@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Number of ship losses worldwide in 2019 , by vessel type" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Number of losses" .

:YAxis a :Axis ;
    :title "vessel type" .

:DataPoint1 a :DataPoint ;
    :xValue "15" ;
    :yValue "Cargo ships" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "9" ;
    :yValue "Fishery vessels" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "4" ;
    :yValue "Others" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "3" ;
    :yValue "Ro-ro ships" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "3" ;
    :yValue "Tug boats" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "3" ;
    :yValue "Passenger ships" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "1" ;
    :yValue "Unknown" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "1" ;
    :yValue "Barges" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "1" ;
    :yValue "Container ships" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "1" ;
    :yValue "Bulk carriers" ;
    :belongsTo :Chart .
