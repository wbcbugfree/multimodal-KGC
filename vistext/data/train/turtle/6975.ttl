@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Average monthly earnings in Finland from 2009 to 2019 , by sector" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Central government" .

:DataPoint1 a :DataPoint ;
    :xValue "2019*" ;
    :yValue "3989" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "2018" ;
    :yValue "3905" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "2017" ;
    :yValue "3850" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "2016" ;
    :yValue "3830" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "2015" ;
    :yValue "3791" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "2014" ;
    :yValue "3740" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "2013" ;
    :yValue "3663" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "2012" ;
    :yValue "3579" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "2011" ;
    :yValue "3445" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "2010" ;
    :yValue "3337" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "2009" ;
    :yValue "3231" ;
    :belongsTo :Chart .
