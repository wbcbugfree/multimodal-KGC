@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Number of arriving and departing local passengers in the leading French airports in 2016" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Number of local passengers" .

:YAxis a :Axis ;
    :title "airport" .

