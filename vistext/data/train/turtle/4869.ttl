@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Countries with most content available on Netflix worldwide as of April 2019" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Number of movies and TV shows combined" .

:YAxis a :Axis ;
    :title "Country" .

:DataPoint1 a :DataPoint ;
    :xValue "5932" ;
    :yValue "United States" ;
    :belongsTo :Chart .

