    :xValue "São Paulo" ;
    :yValue "1250" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "Palmeiras" ;
    :yValue "1330" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "Santos" ;
    :yValue "891" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Grêmio" ;
    :yValue "626" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Vasco" ;
    :yValue "517" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Atlético Minas Gerais" ;
    :yValue "247" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
