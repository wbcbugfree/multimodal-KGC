@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Most popular Brazilian soccer clubs as of June 2020 , by number of social media followers (in 1,000s)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Soccer clubs" .

:YAxis a :Axis ;
    :title "YouTube" .

:DataPoint1 a :DataPoint ;
    :xValue "Flamengo" ;
    :yValue "3380" ;
    :belongsTo :Chart .

