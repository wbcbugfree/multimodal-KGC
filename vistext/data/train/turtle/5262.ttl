@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Number of nuclear power plants in the United States from 1957 to 2019" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Number of operable generating units" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 1956" ;
    :yValue "1" ;
    :belongsTo :Chart .

