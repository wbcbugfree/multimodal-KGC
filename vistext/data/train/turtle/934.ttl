@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "The 10 countries with the largest number of Christians worldwide in 2010 (in millions)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Country" .

:YAxis a :Axis ;
    :title "Number of Christians in millions" .

:DataPoint1 a :DataPoint ;
    :xValue "United States" ;
    :yValue "246.78" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Brazil" ;
    :yValue "175.77" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "Mexico" ;
    :yValue "107.78" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "Russia" ;
    :yValue "105.22" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "Phlippines" ;
    :yValue "86.79" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Nigeria" ;
    :yValue "80.51" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "China" ;
    :yValue "67.07" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "DR Congo" ;
    :yValue "63.15" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "Germany" ;
    :yValue "58.24" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "Ethiopia" ;
    :yValue "52.58" ;
    :belongsTo :Chart .
