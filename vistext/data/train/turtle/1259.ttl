@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Estimated expenses of the U.S. motion picture and video industries from 2007 to 2018 (in million U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Expenses in million U.S. dollars" .

