@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Which group do you think is the greatest boy band of all time ?" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "Share of respondents" .

:DataPoint1 a :DataPoint ;
    :xValue "Jackson 5" ;
    :yValue "0.21" ;
    :belongsTo :Chart .

