@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Number of runners-up at World Cup tournaments by country 1930 to 2014" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Number of runners-up" .

:YAxis a :Axis ;
    :title "Country" .

:DataPoint1 a :DataPoint ;
    :xValue "4" ;
    :yValue "Germany" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "3" ;
    :yValue "Netherlands, the" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "3" ;
    :yValue "Argentina" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "2" ;
    :yValue "Czech Republic" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "2" ;
    :yValue "Brazil" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "2" ;
    :yValue "Czechoslovakia" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "2" ;
    :yValue "Italy" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "2" ;
    :yValue "Hungary" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "1" ;
    :yValue "France" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "1" ;
    :yValue "Sweden" ;
    :belongsTo :Chart .
