@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Poverty rate of Asian families in the United States from 2002 to 2019" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "Percentage of poor Asian families" .

