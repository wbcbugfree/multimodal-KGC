@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Distribution of most urgent health problems facing the U.S. perceived by Americans in 2016" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "Percentage of respondents" .

:DataPoint1 a :DataPoint ;
    :xValue "Cost" ;
    :yValue "0.27" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Access" ;
    :yValue "0.2" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "Cancer" ;
    :yValue "0.12" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "Obesity" ;
    :yValue "0.08" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "Diabetes" ;
    :yValue "0.03" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Drug/ alcohol abuse" ;
    :yValue "0.03" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Mental illness" ;
    :yValue "0.03" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Flu/viruses" ;
    :yValue "0.02" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "Heart disease" ;
    :yValue "0.02" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "Finding cures for diseases" ;
    :yValue "0.01" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "Government intereference*" ;
    :yValue "0.01" ;
    :belongsTo :Chart .

:DataPoint12 a :DataPoint ;
    :xValue "AIDS*" ;
    :yValue "0.01" ;
    :belongsTo :Chart .

:DataPoint13 a :DataPoint ;
    :xValue "Bioterrorism" ;
    :yValue "0" ;
    :belongsTo :Chart .

:DataPoint14 a :DataPoint ;
    :xValue "Other" ;
    :yValue "0.08" ;
    :belongsTo :Chart .

:DataPoint15 a :DataPoint ;
    :xValue "No opinion" ;
    :yValue "0.11" ;
    :belongsTo :Chart .
