@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Average hours per day spent on leisure and sports in the U.S. sorted by educational attainment from 2009 to 2019" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Less than a high school diploma" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2008" ;
    :yValue "6.53" ;
    :belongsTo :Chart .

