@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Number of merger and acquisition transactions in Europe from March 2014 to June 2015" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Number of deals" .

:YAxis a :Axis ;
    :title "Month" .

