@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Japan : Budget balance from 2015 to 2025 in relation to gross domestic product (GDP)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Budget balance to GDP ratio" .

:YAxis a :Axis ;
    :title "Year" .

:DataPoint1 a :DataPoint ;
    :xValue "-0.0274" ;
    :yValue "2025*" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "-0.0265" ;
    :yValue "2024*" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "-0.0277" ;
    :yValue "2023*" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "-0.032" ;
    :yValue "2022*" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "-0.0642" ;
    :yValue "2021*" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "-0.1415" ;
    :yValue "2020*" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "-0.033" ;
    :yValue "2019*" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "-0.025" ;
    :yValue "2018" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "-0.0312" ;
    :yValue "2017" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "-0.037" ;
    :yValue "2016" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "-0.0381" ;
    :yValue "2015" ;
    :belongsTo :Chart .
