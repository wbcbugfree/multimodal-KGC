@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Price for U.S. coffee from Hawaii and Puerto Rico between 2000/2001 and 2018/2019 (in U.S. dollars per pound)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Hawaii" .

:YAxis a :Axis ;
    :title "Year" .

:DataPoint1 a :DataPoint ;
    :xValue "2.65" ;
    :yValue "2000/2001" ;
    :belongsTo :Chart .

