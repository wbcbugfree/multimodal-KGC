@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Brand of ceramic tiles used the most by construction firms in the United States in 2018" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Brand" .

:YAxis a :Axis ;
    :title "Share of respondents" .

:DataPoint1 a :DataPoint ;
    :xValue "Dal-Tile" ;
    :yValue "0.44" ;
    :belongsTo :Chart .

