    :xValue "Dec 31, 1969" ;
    :yValue "94" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Dec 31, 1974" ;
    :yValue "72" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Dec 31, 1979" ;
    :yValue "55" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Dec 31, 1984" ;
    :yValue "45" ;
    :belongsTo :Chart .

