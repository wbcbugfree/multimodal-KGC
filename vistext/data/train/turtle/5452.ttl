@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Number of Snapchat users in selected Latin American countries as of February 2020 (in millions)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Country" .

:YAxis a :Axis ;
    :title "Number of users in millions" .

:DataPoint1 a :DataPoint ;
    :xValue "Mexico" ;
    :yValue "14.8" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Brazil" ;
    :yValue "13.95" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "Colombia" ;
    :yValue "4.5" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "Argentina" ;
    :yValue "3.25" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "Dominican Republic" ;
    :yValue "1.95" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Peru" ;
    :yValue "1.75" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Ecuador" ;
    :yValue "1.75" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Uruguay" ;
    :yValue "1.55" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "Chile" ;
    :yValue "1.55" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "Puerto Rico**" ;
    :yValue "0.8" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "Costa Rica" ;
    :yValue "0.59" ;
    :belongsTo :Chart .
