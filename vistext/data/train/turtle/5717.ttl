@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "What is the version or translation of the Bible you read most often ?" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "Share of respondents" .

:DataPoint1 a :DataPoint ;
    :xValue "King James Version" ;
    :yValue "0.31" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "New International Version" ;
    :yValue "0.13" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "English Standard Version" ;
    :yValue "0.09" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "New King James Version" ;
    :yValue "0.07" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "Amplified" ;
    :yValue "0.07" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Christian Community" ;
    :yValue "0.04" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "New American Standard" ;
    :yValue "0.03" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "New Living Translation" ;
    :yValue "0.02" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "Revised Standard" ;
    :yValue "0.02" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "Contemporary English Version" ;
    :yValue "0.02" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "New American Bible" ;
    :yValue "0.02" ;
    :belongsTo :Chart .

:DataPoint12 a :DataPoint ;
    :xValue "All others (1% or less combined)" ;
    :yValue "0.09" ;
    :belongsTo :Chart .

:DataPoint13 a :DataPoint ;
    :xValue "Not sure" ;
    :yValue "0.08" ;
    :belongsTo :Chart .
