@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Distribution of digital video ad impressions in the United States from 2nd quarter 2014 to 1st quarter 2018 , by ad length" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Quarter" .

:YAxis a :Axis ;
    :title "Other" .

:DataPoint1 a :DataPoint ;
    :xValue "Q1 2018" ;
    :yValue "0.02" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Q4 2017" ;
    :yValue "0.06" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "Q3 2017" ;
    :yValue "0.04" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "Q2 2017" ;
    :yValue "0.1" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "Q1 2017" ;
    :yValue "0.08" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Q4 2016" ;
    :yValue "0.09" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Q3 2016" ;
    :yValue "0.04" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Q2 2016" ;
    :yValue "0.04" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "Q1 2016" ;
    :yValue "0.04" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "Q4 2015" ;
    :yValue "0.04" ;
    :belongsTo :Chart .
