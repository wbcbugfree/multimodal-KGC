@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Military expenditure as percentage of Gross Domestic Product (GDP) in Colombia from 2007 to 2019" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "Share of GDP" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2006" ;
    :yValue "0.033" ;
    :belongsTo :Chart .

