@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Laos : Ratio of government expenditure to gross domestic product (GDP) from 2015 to 2025" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Ratio of government expenditure to GDP" .

:DataPoint1 a :DataPoint ;
    :xValue "2025*" ;
    :yValue "0.1946" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "2024*" ;
    :yValue "0.1954" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "2023*" ;
    :yValue "0.1984" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "2022*" ;
    :yValue "0.1973" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "2021*" ;
    :yValue "0.1951" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "2020*" ;
    :yValue "0.1826" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "2019*" ;
    :yValue "0.2038" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "2018" ;
    :yValue "0.2091" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "2017" ;
    :yValue "0.2156" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "2016" ;
    :yValue "0.2109" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "2015" ;
    :yValue "0.2578" ;
    :belongsTo :Chart .
