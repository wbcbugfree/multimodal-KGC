@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Total number of shopping centers in Canada from 2001 to 2012" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Number of shopping centers" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2000" ;
    :yValue "2145" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Dec 31, 2001" ;
    :yValue "2176" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "Dec 31, 2002" ;
    :yValue "2220" ;
    :belongsTo :Chart .

