@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Market share held by the leading internet browsers in Europe from 2009 to 2019" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Safari" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2008" ;
    :yValue "0.029" ;
    :belongsTo :Chart .

