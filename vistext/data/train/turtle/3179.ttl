@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Most common items on takeaway or delivery kids ' menus in the United States between May 2013 and May 2014" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Share of kids' menus item is featured on" .

:YAxis a :Axis ;
    :title "Response" .

:DataPoint1 a :DataPoint ;
    :xValue "0.39" ;
    :yValue "Chicken fingers/tenders/strips" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "0.34" ;
    :yValue "Burgers" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "0.28" ;
    :yValue "Pizza" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "0.27" ;
    :yValue "Grilled cheese" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "0.21" ;
    :yValue "Spaghetti" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "0.17" ;
    :yValue "Chicken nuggets" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "0.16" ;
    :yValue "Mac and cheese" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "0.15" ;
    :yValue "Quesadillas" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "0.13" ;
    :yValue "Hot dogs" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "0.12" ;
    :yValue "French fries" ;
    :belongsTo :Chart .
