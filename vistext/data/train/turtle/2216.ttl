@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Annual number of registered crimes in Belgium from 2009 to the 1st semester of 2019" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Number of registered crimes" .

:YAxis a :Axis ;
    :title "Year" .

:DataPoint1 a :DataPoint ;
    :xValue "426927" ;
    :yValue "2019*" ;
    :belongsTo :Chart .

