@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Number of foreign born population in Australia as of 2019 , by country of birth" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Number of people" .

:YAxis a :Axis ;
    :title "Country" .

:DataPoint1 a :DataPoint ;
    :xValue "986460" ;
    :yValue "England" ;
    :belongsTo :Chart .

