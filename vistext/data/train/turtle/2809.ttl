@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Leading airports in the Nordic countries in 2017 , by number of passengers (in millions)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Number of passengers in millions" .

:YAxis a :Axis ;
    :title "international airport" .

