@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Vaccination coverage in China from 1990 to 2019 , by vaccine" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "DTP4" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 1989" ;
    :yValue "0" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Dec 31, 1999" ;
    :yValue "0" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "Dec 31, 2004" ;
    :yValue "0" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "Dec 31, 2009" ;
    :yValue "0" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "Dec 31, 2012" ;
    :yValue "0" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Dec 31, 2013" ;
    :yValue "0.99" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Dec 31, 2014" ;
    :yValue "0.99" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Dec 31, 2015" ;
    :yValue "0.99" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "Dec 31, 2016" ;
    :yValue "0.99" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "Dec 31, 2017" ;
    :yValue "0" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "Dec 31, 2018" ;
    :yValue "0" ;
    :belongsTo :Chart .
