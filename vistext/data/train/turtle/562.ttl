@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Average total regular season home attendance in the NHL from 2008/09 to 2019/20" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Average total attendance" .

:YAxis a :Axis ;
    :title "Year" .

:DataPoint1 a :DataPoint ;
    :xValue "540120" ;
    :yValue "2019/20" ;
    :belongsTo :Chart .

