@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Percentage of leave and remain votes in selected major cities in the United Kingdom (UK) in the EU referendum in 2016" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Remain" .

:YAxis a :Axis ;
    :title "city" .

:DataPoint1 a :DataPoint ;
    :xValue "0.744" ;
    :yValue "Edinburgh" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "0.666" ;
    :yValue "Glasgow" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "0.604" ;
    :yValue "Manchester" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "0.6" ;
    :yValue "Cardiff" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "0.599" ;
    :yValue "London" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "0.582" ;
    :yValue "Liverpool" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "0.507" ;
    :yValue "Newcastle" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "0.503" ;
    :yValue "Leeds" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "0.496" ;
    :yValue "Birmingham" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "0.4901" ;
    :yValue "Sheffield" ;
    :belongsTo :Chart .
