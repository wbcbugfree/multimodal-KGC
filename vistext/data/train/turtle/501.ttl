@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Annual turnover of Amazon UK Services Ltd. in the United Kingdom (UK) from 2009 to 2018 (in 1,000 GBP)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Turnover in thousand GBP" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2008" ;
    :yValue "110127" ;
    :belongsTo :Chart .

