@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "ATP tennis players by career prize money earnings as of August 2020 (in million U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Tennis player" .

:YAxis a :Axis ;
    :title "Prize money earned in million U.S. dollars" .

:DataPoint1 a :DataPoint ;
    :xValue "Novak Djokovic" ;
    :yValue "143.63" ;
    :belongsTo :Chart .

