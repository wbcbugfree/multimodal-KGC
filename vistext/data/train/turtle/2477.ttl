@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Most registered male baby names in England in 2019" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "male baby names" .

:YAxis a :Axis ;
    :title "Number of newly registered names" .

:DataPoint1 a :DataPoint ;
    :xValue "Oliver" ;
    :yValue "4663" ;
    :belongsTo :Chart .

