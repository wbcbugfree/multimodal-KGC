@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Number of LTE subscriptions worldwide from 2012 to 2024 , by region (in millions)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Asia Pacific" .

:DataPoint1 a :DataPoint ;
    :xValue "2024*" ;
    :yValue "3480.08" ;
    :belongsTo :Chart .

