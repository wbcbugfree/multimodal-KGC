@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Biogen 's revenue from 2007 to 2019 (in million U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Amount in million U.S. dollars" .

