@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "In your opinion , is reunification of two Koreas necessary ?" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "Neutral" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2006" ;
    :yValue "0.211" ;
    :belongsTo :Chart .

