@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Total United States industrial roundwood imports and exports from 2006 to 2017 (in million cubic feet)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Imports" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2005" ;
    :yValue "5312" ;
    :belongsTo :Chart .

