@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Number of Facebook fans/twitter followers of the Houston Texans (NFL) from 2012 to 2020 (in millions)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Month" .

:YAxis a :Axis ;
    :title "Facebook fans" .

:DataPoint1 a :DataPoint ;
    :xValue "Jul 31, 2012" ;
    :yValue "0.66" ;
    :belongsTo :Chart .

