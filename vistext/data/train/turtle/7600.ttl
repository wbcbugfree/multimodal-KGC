@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Number of biotechnology companies in Germany from 2006 to 2018" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Other biotechnologically active companies" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2005" ;
    :yValue "56" ;
    :belongsTo :Chart .

