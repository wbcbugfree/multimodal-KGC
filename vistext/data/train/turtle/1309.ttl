@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Top 20 super PAC donors in support of U.S. presidential candidates , as of 8 February 2016 (in U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Donors" .

:YAxis a :Axis ;
    :title "Amount donated in U.S. dollars" .

