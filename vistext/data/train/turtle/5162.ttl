@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Leading luxury brands with the most followers on Facebook as of May 2019 (in millions)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "brand name" .

:YAxis a :Axis ;
    :title "Followers in millions" .

:DataPoint1 a :DataPoint ;
    :xValue "Louis Vuitton" ;
    :yValue "23.28" ;
    :belongsTo :Chart .

