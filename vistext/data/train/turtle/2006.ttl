@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Proportion of leisure time during an average day in OECD countries in 2009" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Country" .

:YAxis a :Axis ;
    :title "Proportion of free time per day" .

:DataPoint1 a :DataPoint ;
    :xValue "Belgium" ;
    :yValue "0.277" ;
    :belongsTo :Chart .

