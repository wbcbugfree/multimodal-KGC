@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "CVS Health 's share of retail prescriptions filled in the United States from 2012 to 2025" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "Share of retail prescriptions filled" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2011" ;
    :yValue "0.1725" ;
    :belongsTo :Chart .

