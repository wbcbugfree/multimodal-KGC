@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Indian states with the highest number of cattle in 2019 (in millions)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "state of India" .

:YAxis a :Axis ;
    :title "Cattle in millions" .

:DataPoint1 a :DataPoint ;
    :xValue "West Bengal" ;
    :yValue "19" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Uttar Pradesh" ;
    :yValue "18.8" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "Madhya Pradesh" ;
    :yValue "18.7" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "Bihar" ;
    :yValue "15.3" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "Maharashtra" ;
    :yValue "13.9" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Rajasthan" ;
    :yValue "13.9" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Jharkhand" ;
    :yValue "11.2" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Assam" ;
    :yValue "10.9" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "Chhattisgarh" ;
    :yValue "10" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "Odisha" ;
    :yValue "9.9" ;
    :belongsTo :Chart .
