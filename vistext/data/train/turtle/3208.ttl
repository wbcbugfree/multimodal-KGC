@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "In your opinion , which three of the following are the more peculiar to men ?" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "Share of respondents" .

:DataPoint1 a :DataPoint ;
    :xValue "Industriousness" ;
    :yValue "0.69" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Responsibility" ;
    :yValue "0.44" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "Care" ;
    :yValue "0.41" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "Loyalty" ;
    :yValue "0.31" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "Diligence" ;
    :yValue "0.26" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Logic" ;
    :yValue "0.25" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Laziness" ;
    :yValue "0.13" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Creative mind" ;
    :yValue "0.11" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "Frivolity" ;
    :yValue "0.09" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "Untidiness" ;
    :yValue "0.09" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "Tidiness" ;
    :yValue "0.08" ;
    :belongsTo :Chart .

:DataPoint12 a :DataPoint ;
    :xValue "Ignorant in connections" ;
    :yValue "0.08" ;
    :belongsTo :Chart .

:DataPoint13 a :DataPoint ;
    :xValue "Beauty" ;
    :yValue "0.05" ;
    :belongsTo :Chart .
