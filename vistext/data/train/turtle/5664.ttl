@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Share of respondents worldwide who agree that the media has exaggerated the extent of the coronavirus (COVID-19) outbreak as of March 14 , 2020 , by country" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Percentage of respondents who agree" .

:YAxis a :Axis ;
    :title "Response" .

:DataPoint1 a :DataPoint ;
    :xValue "0.58" ;
    :yValue "Australia" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "0.48" ;
    :yValue "Canada" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "0.43" ;
    :yValue "France" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "0.42" ;
    :yValue "Germany" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "0.29" ;
    :yValue "Italy" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "0.43" ;
    :yValue "Japan" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "0.55" ;
    :yValue "Russia" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "0.5" ;
    :yValue "United Kingdom" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "0.55" ;
    :yValue "United States" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "0.43" ;
    :yValue "Vietnam" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "0.29" ;
    :yValue "China" ;
    :belongsTo :Chart .

:DataPoint12 a :DataPoint ;
    :xValue "0.73" ;
    :yValue "India" ;
    :belongsTo :Chart .
