@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Number of confirmed cases of novel coronavirus (COVID-19) in Mexico as of December 22 , 2020 , by state" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "state of Mexico" .

:YAxis a :Axis ;
    :title "Number of cases" .

