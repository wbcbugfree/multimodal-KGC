@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Area of land burned by forest fires in Canada from 2000 to 2019 (in hectares)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Area burned in hectares" .

