@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "United States : Employee engagement 2002 to 2012" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "Engaged" .

