@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Ireland : National debt from 2014 to 2024 (in billion U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "National debt in billion U.S. dollars" .

:DataPoint1 a :DataPoint ;
    :xValue "2024*" ;
    :yValue "224.31" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "2023*" ;
    :yValue "228.22" ;
    :belongsTo :Chart .

