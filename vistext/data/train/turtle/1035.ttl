@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Detroit Pistons all-time points leaders from 1948 to 2020" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Points scored" .

:YAxis a :Axis ;
    :title "leaders" .

