@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Retail volume of bakery products market forecast in the European Union (EU) in 2015 and 2019 , by country (in 1,000 tonnes)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Country" .

:YAxis a :Axis ;
    :title "2019" .

