@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Occupations with the highest differences in mean hourly wage between metropolitan and nonmetropolitan areas in May 2009 (in U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Mean hourly wage, nonmetropolitan areas" .

:YAxis a :Axis ;
    :title "occupation" .

:DataPoint1 a :DataPoint ;
    :xValue "13.81" ;
    :yValue "Actors" ;
    :belongsTo :Chart .

