@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Annual number of deaths as a result of suicide and self-inflicted injuries in Spain from 2006 to 2018" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Number of deaths" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2005" ;
    :yValue "3246" ;
    :belongsTo :Chart .

