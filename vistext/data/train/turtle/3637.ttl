@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Value of total non-performing loans in Europe as of June 2016 , by country (in billion euros)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Non-performing loan value in billion euros" .

:YAxis a :Axis ;
    :title "Country" .

