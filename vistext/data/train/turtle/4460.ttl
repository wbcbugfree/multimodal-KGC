@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Number of gaming tables in casinos in Macao from 2009 to 2019" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Number of gaming tables" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2008" ;
    :yValue "4770" ;
    :belongsTo :Chart .

