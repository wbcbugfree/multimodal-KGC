@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Leading players of the national football team of Denmark as of 2020 , by market value (in million euros)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Market value in million euros" .

:YAxis a :Axis ;
    :title "players of the national football team of Denmark" .

:DataPoint1 a :DataPoint ;
    :xValue "68" ;
    :yValue "Christian Eriksen" ;
    :belongsTo :Chart .

