@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Number of toiletries , cosmetics and sundries merchant wholesalers in Canada as of December 2019 , by region" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "province of Canada" .

:YAxis a :Axis ;
    :title "Number of establishments" .

:DataPoint1 a :DataPoint ;
    :xValue "Ontario" ;
    :yValue "408" ;
    :belongsTo :Chart .

