    :yValue "20" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Manitoba" ;
    :yValue "18" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "New Brunswick" ;
    :yValue "18" ;
