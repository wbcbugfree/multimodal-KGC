@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Cerium oxide price worldwide from 2009 to 2025 (in U.S. dollars per metric ton)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Price in U.S. dollars per metric ton" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2008" ;
    :yValue "3437" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Dec 31, 2010" ;
    :yValue "98217" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "Dec 31, 2015" ;
    :yValue "1565" ;
    :belongsTo :Chart .

