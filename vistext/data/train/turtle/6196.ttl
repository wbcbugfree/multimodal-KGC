@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Tanzania : Share of economic sectors in the gross domestic product (GDP) from 2007 to 2017" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Industry" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2006" ;
    :yValue "0.232" ;
    :belongsTo :Chart .

