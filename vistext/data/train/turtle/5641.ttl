@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Number of Nobel Laureates in economics by nationality 1969 to 2020" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Number of Nobel Prizes awarded for economics" .

:YAxis a :Axis ;
    :title "Country" .

