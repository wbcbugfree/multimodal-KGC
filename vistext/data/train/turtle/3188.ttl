@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Most popular types of brands female social media users in the United States interact digitally with as of February 2016" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Share of respondents" .

:YAxis a :Axis ;
    :title "Response" .

:DataPoint1 a :DataPoint ;
    :xValue "0.9" ;
    :yValue "Beauty" ;
    :belongsTo :Chart .

