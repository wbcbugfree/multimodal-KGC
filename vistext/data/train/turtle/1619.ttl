@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Monthly average earnings per hour of all employees in the United States in November 2020 , by industry" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Hourly earnings in U.S. dollars" .

:YAxis a :Axis ;
    :title "Industry Type" .

