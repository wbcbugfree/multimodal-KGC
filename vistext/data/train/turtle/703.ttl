@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "All time top goal scorers of the national football team of Portugal as of November 2020 , by goals scored" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Goals scored" .

:YAxis a :Axis ;
    :title "Football player" .

:DataPoint1 a :DataPoint ;
    :xValue "101" ;
    :yValue "Cristiano Ronaldo" ;
    :belongsTo :Chart .

