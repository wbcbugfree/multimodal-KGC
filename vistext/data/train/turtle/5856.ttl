@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Weekend box office revenue of the leading movies in Germany in January 2020 (in 1,000 U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Revenue in thousand U.S. dollars" .

:YAxis a :Axis ;
    :title "Year" .

