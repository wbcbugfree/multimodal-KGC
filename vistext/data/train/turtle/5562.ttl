@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Number of married people in Canada in 2020 , by province or territory" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Province" .

:YAxis a :Axis ;
    :title "Number of people" .

:DataPoint1 a :DataPoint ;
    :xValue "Ontario" ;
    :yValue "5959850" ;
    :belongsTo :Chart .

