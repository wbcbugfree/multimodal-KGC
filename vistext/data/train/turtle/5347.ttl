@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Number of registered ice hockey players in Finland from 2010/11 to 2019/20" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Number of players" .

:YAxis a :Axis ;
    :title "Year" .

:DataPoint1 a :DataPoint ;
    :xValue "71063" ;
    :yValue "2019/20" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "64641" ;
    :yValue "2018/19" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "73374" ;
    :yValue "2017/18" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "76387" ;
    :yValue "2016/17" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "74150" ;
    :yValue "2015/16" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "75871" ;
    :yValue "2014/15" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "73682" ;
    :yValue "2013/14" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "66636" ;
    :yValue "2012/13" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "56626" ;
    :yValue "2011/12" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
