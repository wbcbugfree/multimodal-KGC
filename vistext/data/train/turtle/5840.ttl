@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Biggest challenges for nonprofits in the United States and Canada in 2019" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Share of respondents" .

:YAxis a :Axis ;
    :title "Response" .

:DataPoint1 a :DataPoint ;
    :xValue "0.18" ;
    :yValue "Small staff, transitions in staff" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "0.11" ;
    :yValue "Donor cultivation, acquisition, retention, communications" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "0.1" ;
    :yValue "Economy, national mood" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "0.1" ;
    :yValue "Tax law impact still to come" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "0.09" ;
    :yValue "Organization issues (board, CEO/leadership, fundraising, budget)" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "0.08" ;
    :yValue "Local issues, including number of nonprofits competing for dollars" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "0.08" ;
    :yValue "Mission/purpose/programs" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "0.06" ;
    :yValue "Ending or starting a campaign" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "0.06" ;
    :yValue "\"Culture of philanthropy\" including CRM, communications plan, strategic plan, etc." ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "0.05" ;
    :yValue "Shifting demographics" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "0.05" ;
    :yValue "Institutional donors, including government funding" ;
    :belongsTo :Chart .

:DataPoint12 a :DataPoint ;
    :xValue "0.02" ;
    :yValue "Event fundraising" ;
    :belongsTo :Chart .

:DataPoint13 a :DataPoint ;
    :xValue "0.01" ;
    :yValue "Affected by disasters" ;
    :belongsTo :Chart .
