@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Prices of most affordable one-way tickets of Aeroflot for domestic flights in Russia from end of March to June 2020 , by destination (in Russian rubles)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "destination of most affordable one-way tickets" .

:YAxis a :Axis ;
    :title "June 2020" .

:DataPoint1 a :DataPoint ;
    :xValue "Moscow - Krasnodar" ;
    :yValue "3000" ;
    :belongsTo :Chart .

