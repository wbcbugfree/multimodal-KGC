@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "IBM 's global revenue from 2010 to 2019 , by business segment (in billion U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Systems" .

:YAxis a :Axis ;
    :title "Response" .

:DataPoint1 a :DataPoint ;
    :xValue "7.6" ;
    :yValue "2019" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "8.03" ;
    :yValue "2018*" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "8.19" ;
    :yValue "2017" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "7.71" ;
    :yValue "2016" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "9.55" ;
    :yValue "2015" ;
    :belongsTo :Chart .
