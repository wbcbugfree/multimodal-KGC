@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Gross domestic expenditure on research and development (GERD) as a percentage of GDP in Poland from 2000 to 2018" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "GERD as percentage of GDP" .

:DataPoint1 a :DataPoint ;
    :xValue "2018*" ;
    :yValue "0.0121" ;
    :belongsTo :Chart .

