@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Net income of Abercrombie & Fitch Co. worldwide from 2006 to 2019 (in million U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Net income in million U.S. dollars" .

:YAxis a :Axis ;
    :title "Year" .

:DataPoint1 a :DataPoint ;
    :xValue "44.96" ;
    :yValue "2019" ;
