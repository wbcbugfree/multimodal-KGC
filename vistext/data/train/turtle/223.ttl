    :xValue "127" ;
    :yValue "Lionel Messi" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "110" ;
    :yValue "Ed Sheeran" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "109" ;
    :yValue "Cristiano Ronaldo" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "105" ;
    :yValue "Neymar" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "100" ;
    :yValue "The Eagles" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "95" ;
