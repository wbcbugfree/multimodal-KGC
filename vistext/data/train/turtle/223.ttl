@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Annual incomes of highest-paid film , TV , music and sports celebrities in 2019 (in million U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Income in million U.S. dollars" .

:YAxis a :Axis ;
    :title "Celebrity" .

:DataPoint1 a :DataPoint ;
    :xValue "185" ;
    :yValue "Taylor Swift" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "170" ;
    :yValue "Kylie Jenner" ;
    :belongsTo :Chart .

