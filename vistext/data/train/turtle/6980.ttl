@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Principal importing countries of wheat , flour and wheat products from 2014/2015 to 2018/2019 (in 1,000 metric tons)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "2018/2019" .

:YAxis a :Axis ;
    :title "Country" .

:DataPoint1 a :DataPoint ;
    :xValue "12347" ;
    :yValue "Egypt" ;
    :belongsTo :Chart .

