@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Costa Rica : National debt from 2015 to 2025 in relation to gross domestic product (GDP)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "National debt in relation to GDP" .

:DataPoint1 a :DataPoint ;
    :xValue "2025*" ;
    :yValue "0.7416" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "2024*" ;
    :yValue "0.7631" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "2023*" ;
    :yValue "0.7717" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "2022*" ;
    :yValue "0.7676" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "2021*" ;
    :yValue "0.7476" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "2020*" ;
    :yValue "0.7005" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "2019" ;
    :yValue "0.5838" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "2018" ;
    :yValue "0.5308" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "2017" ;
    :yValue "0.4834" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "2016" ;
    :yValue "0.4492" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "2015" ;
    :yValue "0.4087" ;
    :belongsTo :Chart .
