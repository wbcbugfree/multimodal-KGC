@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Number of stores of key food and grocery retailers in Germany in 2013 , by store count" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Number of stores" .

:YAxis a :Axis ;
    :title "retailer" .

:DataPoint1 a :DataPoint ;
    :xValue "4190" ;
    :yValue "Aldi" ;
    :belongsTo :Chart .

