@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Cash price of a single journey in zones 1 - 4 on the London Underground from 2000 to 2016 (in GBP)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Ticket price in British pounds" .

:DataPoint1 a :DataPoint ;
    :xValue "2016" ;
    :yValue "5.9" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "2015" ;
    :yValue "5.8" ;
    :belongsTo :Chart .

