@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "U.S. states most affected by industrial air pollution in 2010 , based on emissions (in million pounds)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "State" .

:YAxis a :Axis ;
    :title "Industrial air pollution in million pounds" .

