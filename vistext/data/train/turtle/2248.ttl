@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Commercial red meat production in the United States from 2008 to 2019 (in million pounds)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Production in million pounds" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2007" ;
    :yValue "50225" ;
    :belongsTo :Chart .

