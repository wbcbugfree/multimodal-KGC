@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Number of enterprises in the manufacture of soft drinks , production of mineral waters and other bottled waters industry in Bulgaria from 2008 to 2018" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Number of enterprises" .

