@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Top 10 surgical cosmetic procedures worldwide in 2019" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Top 10 surgical cosmetic procedures" .

:YAxis a :Axis ;
    :title "Number of procedures" .

:DataPoint1 a :DataPoint ;
    :xValue "Breast augmentation" ;
    :yValue "1795551" ;
    :belongsTo :Chart .

