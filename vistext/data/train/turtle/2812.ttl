@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Annual crop yield of soybean in Uruguay from 2016 to 2026 (in metric tons/hectare)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Crop yield in metric tons/hectare" .

:DataPoint1 a :DataPoint ;
    :xValue "2026" ;
    :yValue "3.03" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "2025" ;
    :yValue "2.98" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "2024" ;
    :yValue "2.94" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "2023" ;
    :yValue "2.9" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "2022" ;
    :yValue "2.86" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "2021" ;
    :yValue "2.82" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "2020" ;
    :yValue "2.78" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "2019" ;
    :yValue "2.74" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "2018" ;
    :yValue "2.7" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "2017*" ;
    :yValue "2.67" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "2016" ;
    :yValue "2.61" ;
    :belongsTo :Chart .
