@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Percentage of seniors aged 65 years and older that had a select number of chronic conditions as of 2017 , by country" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "3 or more" .

:YAxis a :Axis ;
    :title "Country" .

:DataPoint1 a :DataPoint ;
    :xValue "0.19" ;
    :yValue "New Zealand" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "0.2" ;
    :yValue "Netherlands" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "0.2" ;
    :yValue "Norway" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "0.24" ;
    :yValue "Switzerland" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "0.24" ;
    :yValue "France" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "0.27" ;
    :yValue "Australia" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "0.29" ;
    :yValue "Germany" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "0.3" ;
    :yValue "Sweden" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "0.3" ;
    :yValue "United Kingdom" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "0.33" ;
    :yValue "Canada" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "0.44" ;
    :yValue "United States" ;
    :belongsTo :Chart .
