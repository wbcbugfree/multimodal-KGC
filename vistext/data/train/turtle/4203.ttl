@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Most popular YouTube beauty and style channels as of October 2020 , ranked by number of subscribers (in millions)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "YouTube channel" .

:YAxis a :Axis ;
    :title "Number of subscribers in millions" .

:DataPoint1 a :DataPoint ;
