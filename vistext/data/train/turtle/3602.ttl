@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Healthy life expectancy at birth in Italy in 2018 , by region" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Number of years" .

:YAxis a :Axis ;
    :title "region of Italy" .

