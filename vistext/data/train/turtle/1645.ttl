@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Total contribution as a share of GDP of the tourism industry in Italy from 2014 to 2029" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "Share of GDP" .

:DataPoint1 a :DataPoint ;
    :xValue "2029*" ;
    :yValue "0.143" ;
    :belongsTo :Chart .

