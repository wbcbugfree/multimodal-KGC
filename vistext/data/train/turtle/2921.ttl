@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Number of employees of toy manufacturer Ravensburger worldwide from 2004 to 2018 (in 1,000s)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Number of employees in thousands" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2003" ;
    :yValue "1448" ;
    :belongsTo :Chart .

