    :belongsTo :Chart .

:DataPoint14 a :DataPoint ;
    :xValue "2017/18" ;
    :yValue "432.4" ;
    :belongsTo :Chart .

:DataPoint15 a :DataPoint ;
    :xValue "2018/19*" ;
    :yValue "435.7" ;
    :belongsTo :Chart .
