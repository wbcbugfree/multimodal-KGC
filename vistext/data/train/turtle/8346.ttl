@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Incidence rate of coronary heart disease in Scotland from 2004/05 to 2018/19 , by gender (per 100,000 population)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Men" .

:DataPoint1 a :DataPoint ;
    :xValue "2004/05" ;
    :yValue "540" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "2005/06" ;
    :yValue "526.4" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "2006/07" ;
    :yValue "496.1" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "2007/08" ;
    :yValue "499" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "2008/09" ;
    :yValue "478.5" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "2009/10" ;
    :yValue "461.5" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "2010/11" ;
    :yValue "467.6" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "2011/12" ;
    :yValue "454" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "2012/13" ;
    :yValue "458.8" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "2013/14" ;
    :yValue "438.2" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "2014/15" ;
    :yValue "435.8" ;
    :belongsTo :Chart .

:DataPoint12 a :DataPoint ;
    :xValue "2015/16" ;
