@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Amount of funds raised by Games Done Quick charity events from 2014 to 2020 (in million U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "charity event" .

:YAxis a :Axis ;
    :title "Money raised in million U.S. dollars" .

:DataPoint1 a :DataPoint ;
    :xValue "Awesome Games Done Quick (Prevent Cancer Foundation, January 2014)" ;
    :yValue "1.01" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Summer Games Done Quick (Doctors Without Borders, June 2014)" ;
    :yValue "0.71" ;
    :belongsTo :Chart .

