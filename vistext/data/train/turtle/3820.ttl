@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Shares of overnight travel from other countries to the U.S. in 2000" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Country" .

:YAxis a :Axis ;
    :title "Shares in overnight travel" .

:DataPoint1 a :DataPoint ;
    :xValue "Canada" ;
    :yValue "0.287" ;
    :belongsTo :Chart .

