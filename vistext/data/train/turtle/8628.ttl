@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Amount a player receives for playing in the NFL Super Bowl 2020 - 2030 (in 1,000 U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Winning team" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2019" ;
    :yValue "130" ;
    :belongsTo :Chart .

