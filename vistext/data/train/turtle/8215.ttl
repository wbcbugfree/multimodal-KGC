@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "The most underserved airline routes in U.S. in 2015 , by type of booking" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "One-stop bookings" .

:YAxis a :Axis ;
    :title "main underserved airline routes" .

:DataPoint1 a :DataPoint ;
    :xValue "209558" ;
    :yValue "Boston (BOS) - Orlando (MCO)" ;
    :belongsTo :Chart .

