@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Inflation rate in China from 2008 to 2018 with forecasts until 2025" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year-on-year change" .

:YAxis a :Axis ;
    :title "Year" .

:DataPoint1 a :DataPoint ;
    :xValue "0.026" ;
    :yValue "2025*" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "0.026" ;
    :yValue "2024*" ;
    :belongsTo :Chart .

