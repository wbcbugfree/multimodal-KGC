@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Share of total music album consumption in the United States in 2018 , by genre" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Share of consumption" .

:YAxis a :Axis ;
    :title "Genre" .

:DataPoint1 a :DataPoint ;
    :xValue "0.217" ;
    :yValue "Hip-Hop/Rap" ;
    :belongsTo :Chart .

