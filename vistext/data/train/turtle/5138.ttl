@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Registered unemployment rate during the coronavirus (COVID-19) epidemic in Poland from January to October 2020" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Unemployment rate" .

:YAxis a :Axis ;
    :title "Month" .

:DataPoint1 a :DataPoint ;
    :xValue "0.061" ;
    :yValue "October" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "0.061" ;
    :yValue "September" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "0.061" ;
    :yValue "August" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "0.061" ;
    :yValue "July" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "0.061" ;
    :yValue "June" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "0.06" ;
    :yValue "May" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "0.058" ;
    :yValue "April" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "0.054" ;
    :yValue "March" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "0.055" ;
    :yValue "February" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "0.055" ;
    :yValue "January" ;
    :belongsTo :Chart .
