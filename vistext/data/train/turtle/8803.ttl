@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Average retail price for bananas in Canada from January 2015 to June 2020 (in Canadian dollars per kilogram)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "2015" .

:YAxis a :Axis ;
    :title "Month" .

:DataPoint1 a :DataPoint ;
    :xValue "1.67" ;
    :yValue "Dec" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "1.68" ;
    :yValue "Nov" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "1.69" ;
    :yValue "Oct" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "1.7" ;
    :yValue "Sep" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "1.72" ;
    :yValue "Aug" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "1.71" ;
    :yValue "Jul" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "1.72" ;
    :yValue "Jun" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "1.71" ;
    :yValue "May" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "1.73" ;
    :yValue "Apr" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "1.73" ;
    :yValue "Mar" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "1.67" ;
    :yValue "Feb" ;
    :belongsTo :Chart .

:DataPoint12 a :DataPoint ;
    :xValue "1.66" ;
    :yValue "Jan" ;
    :belongsTo :Chart .
