@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Oil production in the Middle East in 2018 , by country (in 1,000 barrels per day)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Country" .

:YAxis a :Axis ;
    :title "Oil production in thousand barrels per day" .

:DataPoint1 a :DataPoint ;
    :xValue "Saudi Arabia" ;
    :yValue "12287" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Iran" ;
    :yValue "4715" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "Iraq" ;
    :yValue "4614" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "United Arab Emirates" ;
    :yValue "3942" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "Kuwait" ;
    :yValue "3049" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Qatar" ;
    :yValue "1879" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Oman" ;
    :yValue "978" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Other" ;
    :yValue "207" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "Yemen" ;
    :yValue "68" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "Syria" ;
    :yValue "24" ;
    :belongsTo :Chart .
