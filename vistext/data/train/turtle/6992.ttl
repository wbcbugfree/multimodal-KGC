@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Share of children who visited a museum in England from 2008/09 to 2019/20 , by age" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "5-10 years" .

:YAxis a :Axis ;
    :title "Response" .

:DataPoint1 a :DataPoint ;
    :xValue "0.608" ;
    :yValue "2019/20" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "0.625" ;
    :yValue "2018/19" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "0.586" ;
    :yValue "2017/18" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "0.63" ;
    :yValue "2016/17" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "0.629" ;
    :yValue "2015/16" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "0.636" ;
    :yValue "2014/15" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "0.628" ;
    :yValue "2013/14" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "0.632" ;
    :yValue "2012/13" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "0.609" ;
    :yValue "2011/12" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "0.676" ;
    :yValue "2010/11" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "0.703" ;
    :yValue "2009/10" ;
    :belongsTo :Chart .

:DataPoint12 a :DataPoint ;
    :xValue "0.66" ;
    :yValue "2008/09" ;
    :belongsTo :Chart .
