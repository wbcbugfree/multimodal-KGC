@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Total number of pharmaceutical companies with active R & D pipelines worldwide from 2001 to 2020" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Number of companies" .

:YAxis a :Axis ;
    :title "Year" .

