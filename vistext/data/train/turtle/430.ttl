    :xValue "153.9" ;
    :yValue "Spain" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "151.4" ;
    :yValue "China" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "136.7" ;
    :yValue "Japan" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "134.7" ;
    :yValue "Australia" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "126.8" ;
    :yValue "USA: White" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "100" ;
