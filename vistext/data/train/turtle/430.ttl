@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Cancer mortality rate among men in selected countries worldwide between 2003 and 2007 (per 100,000 population)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Mortality rate per 100,000 population" .

:YAxis a :Axis ;
    :title "Country" .

:DataPoint1 a :DataPoint ;
    :xValue "202.6" ;
    :yValue "Slovakia" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "174.7" ;
    :yValue "USA: Black" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "154.2" ;
    :yValue "Denmark" ;
    :belongsTo :Chart .

