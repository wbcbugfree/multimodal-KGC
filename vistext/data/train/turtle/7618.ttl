@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Volume of crude oil exported through the Druzhba pipeline from Russia in 2018 , by country of destination (in 1,000 barrels per day)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Month" .

:YAxis a :Axis ;
    :title "Hungary" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec'18" ;
    :yValue "0.09" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Nov'18" ;
    :yValue "0.08" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "Oct'18" ;
    :yValue "0.09" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "Sep'18" ;
    :yValue "0.09" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "Aug'18" ;
    :yValue "0.09" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Jul'18" ;
    :yValue "0.09" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Jun'18" ;
    :yValue "0.1" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "May'18" ;
    :yValue "0.07" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "Apr'18" ;
    :yValue "0.05" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "Mar'18" ;
    :yValue "0.09" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "Feb'18" ;
    :yValue "0.08" ;
    :belongsTo :Chart .

:DataPoint12 a :DataPoint ;
    :xValue "Jan'18" ;
    :yValue "0.07" ;
    :belongsTo :Chart .
