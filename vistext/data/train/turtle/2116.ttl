@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Largest contributors to pay TV growth in Asia from 2011 to 2020" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Share of cumulative subscriptions" .

:YAxis a :Axis ;
    :title "Response" .

:DataPoint1 a :DataPoint ;
    :xValue "0.688" ;
    :yValue "India" ;
