@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Military expenditure in Norway from 2009 to 2019 (in million NOK)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Expenditure in million NOK" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2008" ;
    :yValue "38960" ;
    :belongsTo :Chart .

