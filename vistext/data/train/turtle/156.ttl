@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Leading privately owned retailing companies in the United States in 2019 , by revenue (in billion U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "business" .

:YAxis a :Axis ;
    :title "Revenue in billion U.S. dollars" .

