@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Share of households with internet access in Romania from 2007 to 2018" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "Share of households" .

:DataPoint1 a :DataPoint ;
    :xValue "2018" ;
    :yValue "0.81" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "2017" ;
    :yValue "0.76" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "2016" ;
    :yValue "0.72" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "2015" ;
    :yValue "0.68" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "2014*" ;
    :yValue "0.61" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "2013" ;
    :yValue "0.58" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "2012" ;
    :yValue "0.54" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "2011" ;
    :yValue "0.47" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "2010" ;
    :yValue "0.42" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "2009" ;
    :yValue "0.38" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "2008" ;
    :yValue "0.3" ;
    :belongsTo :Chart .

:DataPoint12 a :DataPoint ;
    :xValue "2007" ;
    :yValue "0.22" ;
    :belongsTo :Chart .
