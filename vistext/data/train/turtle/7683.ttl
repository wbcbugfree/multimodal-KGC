@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Global production and exports of tea from 2004 to 2018 (in million metric tons)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "World production" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2003" ;
    :yValue "3.15" ;
    :belongsTo :Chart .

