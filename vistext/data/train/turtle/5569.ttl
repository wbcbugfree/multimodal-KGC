@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Major countries of destination for U.S. exports of corn in 2018 (in million metric tons)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Exports in million metric tons" .

:YAxis a :Axis ;
    :title "Country" .

:DataPoint1 a :DataPoint ;
    :xValue "16.72" ;
    :yValue "Mexico" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "15.25" ;
    :yValue "Japan" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "7.27" ;
    :yValue "South Korea" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "5.51" ;
    :yValue "Colombia" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "3.21" ;
    :yValue "Taiwan" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "3.07" ;
    :yValue "Peru" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "1.97" ;
    :yValue "Canada" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "1.86" ;
    :yValue "Egypt" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "1.72" ;
    :yValue "Saudi Arabia" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "1.17" ;
    :yValue "Spain" ;
    :belongsTo :Chart .
