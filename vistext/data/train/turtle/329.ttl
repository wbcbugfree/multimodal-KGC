@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Number of employees of La-Z-Boy worldwide from 2008 to 2020" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Number of employees" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2007" ;
    :yValue "10060" ;
    :belongsTo :Chart .

