@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Monthly import value of furniture and fixtures in Canada from January 2014 to March 2020 (in million Canadian dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "2019" .

:YAxis a :Axis ;
    :title "Month" .

:DataPoint1 a :DataPoint ;
    :xValue "717.7" ;
    :yValue "Dec" ;
    :belongsTo :Chart .

