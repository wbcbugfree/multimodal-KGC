@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Share of children who visited a museum in the last year in England from 2008/09 to 2019/20" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "Share of respondents" .

:DataPoint1 a :DataPoint ;
    :xValue "2019/20" ;
    :yValue "0.586" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "2018/19" ;
    :yValue "0.616" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "2017/18" ;
    :yValue "0.581" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "2016/17" ;
    :yValue "0.633" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "2015/16" ;
    :yValue "0.611" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "2014/15" ;
    :yValue "0.622" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "2013/14" ;
    :yValue "0.618" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "2012/13" ;
    :yValue "0.606" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "2011/12" ;
    :yValue "0.609" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "2010/11" ;
    :yValue "0.647" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "2009/10" ;
    :yValue "0.688" ;
    :belongsTo :Chart .

:DataPoint12 a :DataPoint ;
    :xValue "2008/09" ;
    :yValue "0.632" ;
    :belongsTo :Chart .
