@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Minnesota Vikings average regular season home attendance from 2008 to 2019" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Average attendance" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2007" ;
    :yValue "63267" ;
    :belongsTo :Chart .

