@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Net sales of Hugo Boss worldwide from 2009 to 2019 , by region (in million euros)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Americas" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2008" ;
    :yValue "312.2" ;
    :belongsTo :Chart .

