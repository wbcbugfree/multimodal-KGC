@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Corruption perception index in the ASEAN region in 2019 , by country" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Country" .

:YAxis a :Axis ;
    :title "Index score" .

:DataPoint1 a :DataPoint ;
    :xValue "Singapore" ;
    :yValue "85" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Malaysia" ;
    :yValue "53" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "Indonesia" ;
    :yValue "40" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "Timor-Leste" ;
    :yValue "38" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "Vietnam" ;
    :yValue "37" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Thailand" ;
    :yValue "36" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Philippines" ;
    :yValue "34" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Myanmar" ;
    :yValue "29" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "Laos" ;
    :yValue "29" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "Cambodia" ;
    :yValue "20" ;
    :belongsTo :Chart .
