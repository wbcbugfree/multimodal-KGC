@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "What do you consider the most important social issue ?" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Share of respondents" .

:YAxis a :Axis ;
    :title "Response" .

:DataPoint1 a :DataPoint ;
    :xValue "0.44" ;
    :yValue "Healthcare" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "0.33" ;
    :yValue "School and education" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "0.31" ;
    :yValue "Crime/Law enforcement" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "0.25" ;
    :yValue "Immigration" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "0.19" ;
    :yValue "Integration" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "0.15" ;
    :yValue "Environment" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "0.14" ;
    :yValue "Elderly care" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "0.13" ;
    :yValue "Swedish economy" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "0.1" ;
    :yValue "Unemployment" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "0.1" ;
    :yValue "Social differences" ;
    :belongsTo :Chart .
