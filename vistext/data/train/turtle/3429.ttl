@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Registered cases of vandalism in Belgium from 2008 to 2019" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Cases of vandalism" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2007" ;
    :yValue "112158" ;
    :belongsTo :Chart .

