@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Top 10 specialty therapy drugs in the U.S. by per-member-per-year (PMPY) spending in 2016 (in U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Therapy Drug Type" .

:YAxis a :Axis ;
    :title "PMPY spending in U.S. dollars" .

:DataPoint1 a :DataPoint ;
    :xValue "Humira Pen (adalimumab)" ;
    :yValue "45.11" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Enbrel (etanercept)" ;
    :yValue "26.82" ;
    :belongsTo :Chart .

