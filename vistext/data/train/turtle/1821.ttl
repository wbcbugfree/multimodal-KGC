    :yValue "9.86" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Revlimid (lenalidomide)" ;
    :yValue "9.78" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
