@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Share of train journeys arriving on time in the United Kingdom (UK) from 2006/2007 to 2019/2020 , by type of journey" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "All operators" .

:DataPoint1 a :DataPoint ;
    :xValue "2019/20" ;
    :yValue "0.862" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "2018/19" ;
    :yValue "0.863" ;
    :belongsTo :Chart .

