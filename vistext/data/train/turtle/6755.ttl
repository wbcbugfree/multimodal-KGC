    :yValue "15.6" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "Booking.com (United States)" ;
    :yValue "15" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Webjet (Australia)" ;
    :yValue "12.1" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Trivago (Germany)" ;
    :yValue "10.8" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Travelzoo (United States)" ;
