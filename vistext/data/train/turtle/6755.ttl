@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Enterprise-value-to-EBITDA (EV/EBITDA) of leading online travel companies worldwide from 2019 to 2021" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Factor" .

:YAxis a :Axis ;
    :title "2019" .

:DataPoint1 a :DataPoint ;
    :xValue "Despegar.com (Argentina)" ;
    :yValue "29.3" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Holidaycheck (Germany)" ;
    :yValue "28.6" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "Trip.com (China)" ;
    :yValue "22.2" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
