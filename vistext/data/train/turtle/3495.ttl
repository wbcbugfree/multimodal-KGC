@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Synthetic crude oil production in Canada from 1998 to 2018 (in 1,000 cubic meters)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Production in thousand cubic meters" .

