@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Leading 20 countries based on mortality rate attributed to unintentional poisoning in 2016 (per 100,000 population)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Mortality rate per 100,000 population" .

:YAxis a :Axis ;
    :title "Country" .

:DataPoint1 a :DataPoint ;
    :xValue "5.2" ;
    :yValue "Burundi" ;
    :belongsTo :Chart .

