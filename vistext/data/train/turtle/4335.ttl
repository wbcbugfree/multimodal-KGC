@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Total population in Thailand from 2015 to 2025 (in million inhabitants)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Inhabitants in millions" .

:DataPoint1 a :DataPoint ;
    :xValue "2025*" ;
    :yValue "70.33" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "2024*" ;
    :yValue "70.27" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "2023*" ;
    :yValue "70.18" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "2022*" ;
    :yValue "70.08" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "2021*" ;
    :yValue "69.95" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "2020*" ;
    :yValue "69.8" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "2019*" ;
    :yValue "69.63" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "2018" ;
    :yValue "69.43" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "2017" ;
    :yValue "69.21" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "2016" ;
    :yValue "68.97" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "2015" ;
    :yValue "68.72" ;
    :belongsTo :Chart .
