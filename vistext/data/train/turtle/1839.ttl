@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Number of visitors to the Crowdcube website between 2011 and 2012" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Number of visitors" .

:YAxis a :Axis ;
    :title "Country" .

:DataPoint1 a :DataPoint ;
    :xValue "130184" ;
    :yValue "United Kingdom" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "11476" ;
    :yValue "United States" ;
    :belongsTo :Chart .

