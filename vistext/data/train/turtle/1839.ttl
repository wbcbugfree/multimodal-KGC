    :xValue "3539" ;
    :yValue "Spain" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "2043" ;
    :yValue "India" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "2043" ;
    :yValue "Australia" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "2036" ;
    :yValue "France" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "1638" ;
    :yValue "Netherlands" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "1526" ;
    :yValue "Italy" ;
