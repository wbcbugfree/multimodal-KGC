@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Nuclear share of electricity generation in Japan from 2010 to 2019" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "Share of electricity generation" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2008" ;
    :yValue "0.289" ;
    :belongsTo :Chart .

