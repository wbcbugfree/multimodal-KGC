@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Value of Indian trade with ASEAN countries in FY 2019 , by country (in million U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Country" .

:YAxis a :Axis ;
    :title "Trade value in million U.S. dollars" .

:DataPoint1 a :DataPoint ;
    :xValue "Singapore" ;
    :yValue "27850.23" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Indonesia" ;
    :yValue "21127.02" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "Malaysia" ;
    :yValue "17223.71" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "Vietnam" ;
    :yValue "13699.64" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "Thailand" ;
    :yValue "11875.36" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Philippines" ;
    :yValue "2324.74" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Myanmar" ;
    :yValue "1726.69" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Brunei" ;
    :yValue "647.3" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "Cambodia" ;
    :yValue "238.6" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "Laos" ;
    :yValue "40.41" ;
    :belongsTo :Chart .
