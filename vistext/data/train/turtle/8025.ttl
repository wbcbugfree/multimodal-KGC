@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Average house prices in rural and urban areas in the United Kingdom (UK) in 2013 , by region (in GBP)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "region of the United Kingdom" .

:YAxis a :Axis ;
    :title "Rural" .

:DataPoint1 a :DataPoint ;
    :xValue "South East" ;
    :yValue "318185" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "East of England" ;
    :yValue "235876" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "South West" ;
    :yValue "232630" ;
    :belongsTo :Chart .

