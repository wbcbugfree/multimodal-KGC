    :xValue "West Mindlands" ;
    :yValue "231876" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Scotland" ;
    :yValue "160374" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "East Midlands" ;
    :yValue "179692" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "North West" ;
    :yValue "200997" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "Wales" ;
