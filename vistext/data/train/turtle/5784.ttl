@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Top ten horse racing meeting attendances in Britain in 2012" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "horse racing venue" .

:YAxis a :Axis ;
    :title "Number of attendees" .

:DataPoint1 a :DataPoint ;
    :xValue "Royal Ascot" ;
    :yValue "280268" ;
    :belongsTo :Chart .

