@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Number of Magnetic Resonance Imaging (MRI) scanners in Slovenia from 2006 to 2019" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Number of scanners" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2005" ;
    :yValue "11" ;
    :belongsTo :Chart .

