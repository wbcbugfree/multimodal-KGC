@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Who do you think is the most successful overseas player in the Chinese Super League (CSL) at present ?" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "Share of respondents" .

:DataPoint1 a :DataPoint ;
    :xValue "Mariqui" ;
    :yValue "0.27" ;
    :belongsTo :Chart .

