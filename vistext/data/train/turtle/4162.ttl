@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "The world 's leading container ship operators as of October 12 , 2020 , based on TEU capacity" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Total TEUs" .

:YAxis a :Axis ;
    :title "Container ship operator" .

