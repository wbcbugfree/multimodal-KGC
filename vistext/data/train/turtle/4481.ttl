@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Natural gas prices for households in Germany from 2010 to 2018 , semi-annually (in euro cents per kilowatt-hour)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Euro cents per kilowatt-hour" .

:DataPoint1 a :DataPoint ;
    :xValue "2018 S1" ;
    :yValue "6.08" ;
    :belongsTo :Chart .

