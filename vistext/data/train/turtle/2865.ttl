@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Angola : Budget balance between 2009 to 2025 in relation to GDP" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Budget balance in relation to GDP" .

:YAxis a :Axis ;
    :title "Year" .

:DataPoint1 a :DataPoint ;
    :xValue "0.0188" ;
    :yValue "2025*" ;
    :belongsTo :Chart .

