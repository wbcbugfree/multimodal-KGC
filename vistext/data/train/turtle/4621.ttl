@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Total demand for electricity in the United Kingdom (UK) from 2000 to 2019 (in gigawatt hours)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Demand in gigawatt hours" .

:YAxis a :Axis ;
    :title "Year" .

