@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Leading 20 U.S. brands in 2020 , by brand value (in million U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Brand" .

:YAxis a :Axis ;
    :title "Brand value in million U.S. dollars" .

