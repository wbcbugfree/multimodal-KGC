@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Which social networks do you regularly use ?" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "Share of respondents" .

:DataPoint1 a :DataPoint ;
    :xValue "Facebook" ;
    :yValue "0.44" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Instagram" ;
    :yValue "0.18" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "Odnoklassniki" ;
    :yValue "0.13" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "Vkontakte" ;
    :yValue "0.1" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "Twitter" ;
    :yValue "0.05" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "LinkedIn" ;
    :yValue "0.02" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Telegram" ;
    :yValue "0.02" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Other" ;
    :yValue "0.01" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "Do not use any" ;
    :yValue "0.13" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "Do not use the internet" ;
    :yValue "0.31" ;
    :belongsTo :Chart .
