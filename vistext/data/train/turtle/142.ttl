@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Most common reasons for U.S. citizens to support the death penalty in 2014" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "Share of respondents" .

:DataPoint1 a :DataPoint ;
    :xValue "An eye for an eye/ they took a life/ fits the crime" ;
    :yValue "0.35" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Save taxpayers money/ cost associated with prison" ;
    :yValue "0.14" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "They deserve it" ;
    :yValue "0.14" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "They will repeat crime/ keep them from repeating it" ;
    :yValue "0.07" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "Deterrent for potential crimes/ set an example" ;
    :yValue "0.06" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Depends on the type of crime they commit" ;
    :yValue "0.05" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Fair punishment" ;
    :yValue "0.04" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Serve justice" ;
    :yValue "0.04" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "If there's no doubt the person committed the crime" ;
    :yValue "0.03" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "Support/ believe in death penalty" ;
    :yValue "0.03" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "Don't believe they can be rehabiliateted" ;
    :yValue "0.03" ;
    :belongsTo :Chart .

:DataPoint12 a :DataPoint ;
    :xValue "Biblical reasons" ;
    :yValue "0.03" ;
    :belongsTo :Chart .

:DataPoint13 a :DataPoint ;
    :xValue "Life sentences don't always mean life in prison" ;
    :yValue "0.02" ;
    :belongsTo :Chart .

:DataPoint14 a :DataPoint ;
    :xValue "Relieves prison overcrowding" ;
    :yValue "0.02" ;
    :belongsTo :Chart .

:DataPoint15 a :DataPoint ;
    :xValue "Would help/ benefit families of victims" ;
    :yValue "0.01" ;
    :belongsTo :Chart .

:DataPoint16 a :DataPoint ;
    :xValue "Other" ;
    :yValue "0.01" ;
    :belongsTo :Chart .

:DataPoint17 a :DataPoint ;
    :xValue "No opinion" ;
    :yValue "0.04" ;
    :belongsTo :Chart .
