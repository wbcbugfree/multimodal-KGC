@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Total net electricity generation in the United States from 1950 to 2019 (in billion kilowatt hours)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Net generation in billion kilowatt hours" .

