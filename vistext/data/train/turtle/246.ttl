@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "U.S. wheat supply projection from 2010/2011 to 2027/2028 (in million bushels)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Production in million bushels" .

