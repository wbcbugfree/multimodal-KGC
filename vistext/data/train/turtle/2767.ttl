    :xValue "0.081" ;
    :yValue "Industry" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "0.072" ;
    :yValue "Hotels and restaurants" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "0.059" ;
    :yValue "Building and construction" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "0.052" ;
    :yValue "Transport" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "0.045" ;
    :yValue "Education" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "0.029" ;
    :yValue "Knowledge services" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "0.024" ;
    :yValue "Public administration, military and police" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "0.024" ;
    :yValue "Information and communication" ;
    :belongsTo :Chart .

:DataPoint12 a :DataPoint ;
    :xValue "0.019" ;
    :yValue "Culture and leisure" ;
    :belongsTo :Chart .

:DataPoint13 a :DataPoint ;
    :xValue "0.015" ;
    :yValue "Other services" ;
    :belongsTo :Chart .

:DataPoint14 a :DataPoint ;
    :xValue "0.014" ;
    :yValue "Other" ;
    :belongsTo :Chart .

:DataPoint15 a :DataPoint ;
    :xValue "0.007" ;
    :yValue "Real estate and rental" ;
    :belongsTo :Chart .

:DataPoint16 a :DataPoint ;
    :xValue "0.007" ;
