@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Share of unemployed individuals after the coronavirus outbreak in Denmark in 2020 , by sector" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Share of unemployed people" .

:YAxis a :Axis ;
    :title "Response" .

:DataPoint1 a :DataPoint ;
    :xValue "0.103" ;
    :yValue "Travel agencies, cleaning and related services" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "0.091" ;
    :yValue "Trade" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "0.082" ;
    :yValue "Health care and social authorities" ;
    :belongsTo :Chart .

