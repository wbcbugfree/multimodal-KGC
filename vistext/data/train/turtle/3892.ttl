@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Air Products and Chemicals ' net income from 2010 to 2020 (in million U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Net income in million U.S. dollars" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2009" ;
    :yValue "1029" ;
    :belongsTo :Chart .

