@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Most popular contemporary TV personalities in the United Kingdom (UK) from August 2019 to August 2020" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "Share of respondents with a positive opinion" .

:DataPoint1 a :DataPoint ;
    :xValue "David Attenborough" ;
    :yValue "0.79" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Martin Lewis" ;
    :yValue "0.71" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "Trevor McDonald" ;
    :yValue "0.71" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "Stephen Fry" ;
    :yValue "0.68" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "Paul O'Grady" ;
    :yValue "0.66" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Barbara Windsor" ;
    :yValue "0.65" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Richard Hammond" ;
    :yValue "0.62" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Mary Berry" ;
    :yValue "0.61" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "Graham Norton" ;
    :yValue "0.61" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "Richard Osman" ;
    :yValue "0.59" ;
    :belongsTo :Chart .
