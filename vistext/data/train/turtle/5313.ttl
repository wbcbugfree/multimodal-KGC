@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "U.S. domestic demand for gasoline from 1990 to 2018 (in billion gallons)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Demand in billion gallons" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 1989" ;
    :yValue "113.61" ;
    :belongsTo :Chart .

