@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Number of individuals covered by a private health insurance in the United Kingdom (UK) from 2002 to 2011 (in 1,000)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Number of individuals in thousands" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2001" ;
    :yValue "7301" ;
    :belongsTo :Chart .

