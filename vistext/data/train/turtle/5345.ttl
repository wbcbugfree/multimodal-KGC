@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Number of confirmed cases of the novel coronavirus (COVID-19) in Chile as of January 5 , 2021 , by region" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Number of cases" .

:YAxis a :Axis ;
    :title "region of Chile" .

