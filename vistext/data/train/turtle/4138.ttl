@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Share of individuals reading or downloading online news , newspapers or magazines in Great Britain from 2007 to 2020" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "Share of respondents" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2006" ;
    :yValue "0.2" ;
    :belongsTo :Chart .

