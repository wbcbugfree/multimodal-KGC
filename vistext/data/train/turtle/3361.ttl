@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Most collectible living artists at auction worldwide from 2011 to 2016 , by value of sales (in million U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Most collectible living artists" .

:YAxis a :Axis ;
    :title "Value of works sold in million U.S. dollars" .

