@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Cost of an angioplasty in selected countries as of 2019 (in U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Country" .

:YAxis a :Axis ;
    :title "Cost in U.S. dollars" .

:DataPoint1 a :DataPoint ;
    :xValue "United States" ;
    :yValue "28200" ;
    :belongsTo :Chart .

