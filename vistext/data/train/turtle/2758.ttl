@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Leading cooking channels on YouTube in Spain as of March 2017 , by number of views" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Cooking Channel" .

:YAxis a :Axis ;
    :title "Number of uploaded video views" .

:DataPoint1 a :DataPoint ;
    :xValue "Cocina para todos" ;
    :yValue "109651018" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Cosas de Loli" ;
    :yValue "59623806" ;
    :belongsTo :Chart .

