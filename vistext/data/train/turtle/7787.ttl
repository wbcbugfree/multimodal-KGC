@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Global health expenditure distribution in 2018 and a forecast for 2028 , by share of country" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "2018" .

:YAxis a :Axis ;
    :title "Country" .

:DataPoint1 a :DataPoint ;
    :xValue "0.41" ;
    :yValue "United States" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "0.09" ;
    :yValue "China" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "0.07" ;
    :yValue "Japan" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "0.05" ;
    :yValue "Germany" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "0.04" ;
    :yValue "France" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "0.03" ;
    :yValue "United Kingdom" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "0.03" ;
    :yValue "Brazil" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "0.02" ;
    :yValue "Italy" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "0.02" ;
    :yValue "Canada" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "0.02" ;
    :yValue "Australia" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "0.22" ;
    :yValue "Rest of the world" ;
    :belongsTo :Chart .
