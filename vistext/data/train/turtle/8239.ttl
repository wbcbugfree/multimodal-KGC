    :yValue "Cardiovascular Surgery Devices" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "27.7" ;
    :yValue "Electrophysiology Devices" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "18.6" ;
    :yValue "External Defibrillators" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "14.2" ;
    :yValue "Prosthetic Heart Valves" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "5.6" ;
