@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Cardiovascular devices market value in South Korea in 2007 , 2014 and 2021 , by category (in million U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "2014" .

:YAxis a :Axis ;
    :title "category" .

:DataPoint1 a :DataPoint ;
    :xValue "257.9" ;
    :yValue "Interventional Cardiology" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "61.9" ;
    :yValue "Peripheral Vascular Devices" ;
    :belongsTo :Chart .

