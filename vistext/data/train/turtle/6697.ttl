    :yValue "662.82" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Dec 31, 2012" ;
    :yValue "728.94" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
