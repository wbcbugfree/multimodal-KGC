@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Share of adult population taking part in free time activities in England in 2017/18 , by type" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "Share of respondents" .

:DataPoint1 a :DataPoint ;
    :xValue "Watching TV" ;
    :yValue "0.915" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Spending time with friends/family" ;
    :yValue "0.901" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "Listening to music" ;
    :yValue "0.815" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "Eating out at restaurants" ;
    :yValue "0.772" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "Browsing the internet" ;
    :yValue "0.765" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Shopping" ;
    :yValue "0.765" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Days out or visits to places" ;
    :yValue "0.721" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Reading" ;
    :yValue "0.691" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "Going to pubs/bars/clubs" ;
    :yValue "0.527" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "Gardening" ;
    :yValue "0.506" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "DIY" ;
    :yValue "0.434" ;
    :belongsTo :Chart .

:DataPoint12 a :DataPoint ;
    :xValue "Playing computer games" ;
    :yValue "0.273" ;
    :belongsTo :Chart .
