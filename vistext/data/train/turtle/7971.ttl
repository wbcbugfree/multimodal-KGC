@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Number of youth participants in lacrosse in the United States from 2006 to 2018 , by gender" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Youth girls" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2005" ;
    :yValue "81609" ;
    :belongsTo :Chart .

