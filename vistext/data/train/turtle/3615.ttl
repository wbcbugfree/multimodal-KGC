@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Countries with the highest number of deaths by terrorism in 2019 , by percentage of total deaths" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "Percentage of terrorism deaths" .

:DataPoint1 a :DataPoint ;
    :xValue "Afghanistan" ;
    :yValue "0.41" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Rest of the World" ;
    :yValue "0.2" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "Nigeria" ;
    :yValue "0.09" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "Iraq" ;
    :yValue "0.04" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "Somalia" ;
    :yValue "0.04" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Syria" ;
    :yValue "0.04" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Burkina Faso" ;
    :yValue "0.04" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Mali" ;
    :yValue "0.04" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "Democratic Republic of the Congo" ;
    :yValue "0.04" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "Yemen" ;
    :yValue "0.04" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "Mozambique" ;
    :yValue "0.02" ;
    :belongsTo :Chart .
