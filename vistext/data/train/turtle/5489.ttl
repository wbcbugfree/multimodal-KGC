@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Worldwide number of Airbus aircraft deliveries from 2002 to 2019 (in units)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Number of aircraft deliveries" .

