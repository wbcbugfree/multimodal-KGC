@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Which of the following types of beer do you like ?" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "Share of respondents" .

:DataPoint1 a :DataPoint ;
    :xValue "Bitter" ;
    :yValue "0.26" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Pilsner" ;
    :yValue "0.23" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "India Pale Ale (IPA)" ;
    :yValue "0.22" ;
    :belongsTo :Chart .

