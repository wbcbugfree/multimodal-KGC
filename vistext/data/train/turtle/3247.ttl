    :belongsTo :Chart .

:DataPoint13 a :DataPoint ;
    :xValue "Dunkel" ;
    :yValue "0.03" ;
    :belongsTo :Chart .

:DataPoint14 a :DataPoint ;
    :xValue "Bock" ;
    :yValue "0.03" ;
    :belongsTo :Chart .

:DataPoint15 a :DataPoint ;
    :xValue "Marzen" ;
    :yValue "0.01" ;
    :belongsTo :Chart .

:DataPoint16 a :DataPoint ;
