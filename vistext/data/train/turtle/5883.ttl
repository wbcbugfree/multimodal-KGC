@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "B2C e-commerce sales as share of retail trade in selected European countries in 2012" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "Share of retail trade" .

:DataPoint1 a :DataPoint ;
    :xValue "United Kingdom" ;
    :yValue "0.132" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Germany" ;
    :yValue "0.1" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "Switzerland" ;
    :yValue "0.099" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "Denmark" ;
    :yValue "0.091" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "Norway" ;
    :yValue "0.091" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "France" ;
    :yValue "0.087" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Sweden" ;
    :yValue "0.08" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Benelux" ;
    :yValue "0.057" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "Spain" ;
    :yValue "0.041" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "Poland" ;
    :yValue "0.031" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "Italy" ;
    :yValue "0.016" ;
    :belongsTo :Chart .
