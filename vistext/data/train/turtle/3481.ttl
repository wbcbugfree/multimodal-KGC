@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Voter turnout in U.S. midterm elections from 1902 to 2018" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Percent of eligible voters" .

