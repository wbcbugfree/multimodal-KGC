@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "BRIC countries : Inflation rate from 2009 to 2021 (compared to the previous year)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Russia" .

:DataPoint1 a :DataPoint ;
    :xValue "2021*" ;
    :yValue "0.035" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "2020*" ;
    :yValue "-0.0547" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "2019" ;
    :yValue "0.0134" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "2018" ;
    :yValue "0.0254" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "2017" ;
    :yValue "0.0179" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "2016" ;
    :yValue "0.0029" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "2015" ;
    :yValue "-0.0196" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "2014" ;
    :yValue "0.007" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "2013" ;
    :yValue "0.018" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "2012" ;
    :yValue "0.037" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "2011" ;
    :yValue "0.0507" ;
    :belongsTo :Chart .

:DataPoint12 a :DataPoint ;
    :xValue "2010" ;
    :yValue "0.045" ;
    :belongsTo :Chart .

:DataPoint13 a :DataPoint ;
    :xValue "2009" ;
    :yValue "-0.0782" ;
    :belongsTo :Chart .
