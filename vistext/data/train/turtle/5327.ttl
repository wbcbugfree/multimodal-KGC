@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Number of employees at Deloitte worldwide from 2006 to 2020 (in 1,000s)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Number of employees in thousands" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2005" ;
    :yValue "135" ;
    :belongsTo :Chart .

