@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Share of successful project outcomes in last 12 months for IT leaders worldwide in 2016 , by project type" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "Share of respondents" .

:DataPoint1 a :DataPoint ;
    :xValue "Infrastructure roll-out" ;
    :yValue "0.7" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Moving systems to cloud" ;
    :yValue "0.66" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "New website/CMS" ;
    :yValue "0.65" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "New mobile apps" ;
    :yValue "0.57" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "Collaboration systems" ;
    :yValue "0.56" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Digital marketing systems" ;
    :yValue "0.48" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "CRM roll-out" ;
    :yValue "0.47" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "New finance systems" ;
    :yValue "0.47" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "ERP roll-out" ;
    :yValue "0.44" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "Big data implementation" ;
    :yValue "0.43" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "Offshoring IT functions" ;
    :yValue "0.42" ;
    :belongsTo :Chart .
