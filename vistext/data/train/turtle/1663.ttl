@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Ranking of most popular flowers in France in 2017" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "Share of respondents" .

:DataPoint1 a :DataPoint ;
    :xValue "Rose" ;
    :yValue "0.45" ;
    :belongsTo :Chart .

