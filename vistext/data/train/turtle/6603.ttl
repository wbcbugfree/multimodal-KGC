@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Direct and total contribution of travel and tourism to GDP from 2006 to 2019 (in billion U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Direct contribution" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2005" ;
    :yValue "1629.02" ;
    :belongsTo :Chart .

