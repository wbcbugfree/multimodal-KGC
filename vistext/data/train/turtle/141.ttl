@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Most common baby names of boys in Norway in 2019" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "baby names" .

:YAxis a :Axis ;
    :title "Number of individuals" .

:DataPoint1 a :DataPoint ;
    :xValue "Jakob/Jacob" ;
    :yValue "423" ;
    :belongsTo :Chart .

