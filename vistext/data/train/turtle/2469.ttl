@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Electricity prices for household consumers in Greece from 2010 to 2017 , semi-annually (in euro cents per kilowatt-hour)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Euro cents per kilowatt-hour" .

:YAxis a :Axis ;
    :title "Year" .

:DataPoint1 a :DataPoint ;
    :xValue "19.36" ;
    :yValue "2017 S1" ;
    :belongsTo :Chart .

