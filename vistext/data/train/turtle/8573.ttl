@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Immigration , emigration , and migration balance in the Netherlands from 2009 to 2019" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "Migration balance" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2008" ;
    :yValue "34481" ;
    :belongsTo :Chart .

