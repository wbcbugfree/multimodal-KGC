@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Prevalence of chronic obstructive pulmonary disease (COPD) in Canada from 2011 to 2012 , by age" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Percentage of people living with COPD" .

:YAxis a :Axis ;
    :title "Response" .

:DataPoint1 a :DataPoint ;
    :xValue "0.009" ;
    :yValue "35-39 years" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "0.025" ;
    :yValue "40-44 years" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "0.047" ;
    :yValue "45-49 years" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "0.071" ;
    :yValue "50-54 years" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "0.091" ;
    :yValue "55-59 years" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "0.115" ;
    :yValue "60-64 years" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "0.149" ;
    :yValue "65-69 years" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "0.184" ;
    :yValue "70-74 years" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "0.218" ;
    :yValue "75-79 years" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "0.247" ;
    :yValue "80-84 years" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "0.26" ;
    :yValue "85 years and older" ;
    :belongsTo :Chart .
