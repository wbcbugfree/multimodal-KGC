@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Retail revenue compound annual growth rate (CAGR) of the world 's fastest growing retailers from FY 2013 to 2018" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "FY 2013-2018 retail revenue CAGR" .

:YAxis a :Axis ;
    :title "business" .

:DataPoint1 a :DataPoint ;
    :xValue "0.558" ;
    :yValue "Reliance Industries Limited/Reliance Retail" ;
    :belongsTo :Chart .

