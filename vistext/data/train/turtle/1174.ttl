@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Number of people emigrating from Iceland in 2019 , by destination country" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Number of emigrants" .

:YAxis a :Axis ;
    :title "Country" .

