@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Prevalence of disability in the United Kingdom (UK) in 2018/19 , by impairment type" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Share of individuals" .

:YAxis a :Axis ;
    :title "Response" .

:DataPoint1 a :DataPoint ;
    :xValue "0.48" ;
    :yValue "Mobility" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "0.36" ;
    :yValue "Stamina/breathing/fatigue" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "0.27" ;
    :yValue "Mental health" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "0.26" ;
    :yValue "Dexterity" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "0.16" ;
    :yValue "Memory" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "0.14" ;
    :yValue "Learning" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "0.13" ;
    :yValue "Hearing" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "0.12" ;
    :yValue "Vision" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "0.09" ;
    :yValue "Social/behavioural" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "0.18" ;
    :yValue "Other" ;
    :belongsTo :Chart .
