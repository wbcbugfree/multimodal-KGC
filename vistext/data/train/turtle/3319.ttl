@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Total protection rate of asylum seekers from the main countries of origin in Germany in 2018" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Country" .

:YAxis a :Axis ;
    :title "Total protection rate" .

:DataPoint1 a :DataPoint ;
    :xValue "Syria" ;
    :yValue "0.819" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Iraq" ;
    :yValue "0.323" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "Iran" ;
    :yValue "0.238" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "Nigeria" ;
    :yValue "0.139" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "Turkey" ;
    :yValue "0.414" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Afghanistan" ;
    :yValue "0.375" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Eritrea" ;
    :yValue "0.702" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Somalia" ;
    :yValue "0.413" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "Undetermined" ;
    :yValue "0.409" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "Russia" ;
    :yValue "0.11" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "Top 10 total" ;
    :yValue "0.478" ;
    :belongsTo :Chart .

:DataPoint12 a :DataPoint ;
    :xValue "All countries of origin total" ;
    :yValue "0.35" ;
    :belongsTo :Chart .
