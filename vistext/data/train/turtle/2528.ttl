@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Number of prescription items of varenicline (Champix) to quit smoking in England from 2006/07 to 2019/20 (in 1,000)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Number of prescriptions" .

:DataPoint1 a :DataPoint ;
    :xValue "2006/07" ;
    :yValue "22" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "2007/08" ;
    :yValue "612" ;
    :belongsTo :Chart .

