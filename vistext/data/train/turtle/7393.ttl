@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Median age of the world population from 1990 to 2015 and a forecast until 2100 , by fertility variant" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "High fertility" .

