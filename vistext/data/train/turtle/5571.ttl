@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Luxury destinations with the largest growth in travel worldwide as of August 2016" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Country" .

:YAxis a :Axis ;
    :title "Year-over-year travel growth" .

:DataPoint1 a :DataPoint ;
    :xValue "Kenya" ;
    :yValue "0.59" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Iceland" ;
    :yValue "0.56" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "Saint Martin" ;
    :yValue "0.39" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "China" ;
    :yValue "0.35" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "Ecuador" ;
    :yValue "0.34" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Japan" ;
    :yValue "0.32" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "South Africa" ;
    :yValue "0.28" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Tanzania" ;
    :yValue "0.27" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "Croatia" ;
    :yValue "0.25" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "Jamaica" ;
    :yValue "0.23" ;
    :belongsTo :Chart .
