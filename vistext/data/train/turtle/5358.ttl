@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Pharma companies involved in COVID-19 R & D with largest market capitalization change until May 27 , 2020 (in billion U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "business" .

:YAxis a :Axis ;
    :title "Change in billion U.S. dollars" .

:DataPoint1 a :DataPoint ;
