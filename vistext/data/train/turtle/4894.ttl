@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Urban population in Indonesia from 2005 to 2020 (in 1,000s)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Urban population in thousands" .

