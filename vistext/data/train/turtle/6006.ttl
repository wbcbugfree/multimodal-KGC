@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "U.S. wheat yield per harvested acre from 2010/2011 to 2027/2028 (in bushels)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Yield per harvested acre in bushels" .

