@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Sports betting related keywords ranked by searches in the United Kingdom (UK) in March 2016 (in 1,000 searches)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Searches in thousands" .

:YAxis a :Axis ;
    :title "keyword" .

:DataPoint1 a :DataPoint ;
    :xValue "60.5" ;
    :yValue "bet" ;
    :belongsTo :Chart .

