@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Number of recipients of the Federal Pell Grant Award in the United States from 1980/81 to 2019/20" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Number of recipients in millions" .

:DataPoint1 a :DataPoint ;
    :xValue "2019-20" ;
    :yValue "6.7" ;
    :belongsTo :Chart .

