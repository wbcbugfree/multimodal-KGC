@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Honda CBR1000RR registered motorcycle numbers in Great Britain from 2004 to 2018" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Number of registered motorcycles" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2003" ;
    :yValue "1637" ;
    :belongsTo :Chart .

