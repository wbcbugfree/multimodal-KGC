@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Population aged 15 years and above in Thailand from 2006 to 2017 (in millions)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Population above age 15 in millions" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2005" ;
    :yValue "50.47" ;
    :belongsTo :Chart .

