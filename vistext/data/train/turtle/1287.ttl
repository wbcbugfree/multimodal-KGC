    :xValue "146.3" ;
    :yValue "Russia" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "141.3" ;
    :yValue "Brazil" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "126.8" ;
    :yValue "South Korea" ;
    :belongsTo :Chart .

