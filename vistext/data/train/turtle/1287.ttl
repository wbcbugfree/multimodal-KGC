@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Leading countries based on petroleum consumption in 2018 (in million metric tons)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Consumption in million metric tons" .

:YAxis a :Axis ;
    :title "Country" .

:DataPoint1 a :DataPoint ;
    :xValue "1015.7" ;
    :yValue "United States" ;
    :belongsTo :Chart .

