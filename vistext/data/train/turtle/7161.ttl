@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "United Kingdom (UK) HMRC corporation tax (onshore and offshore) receipts from fiscal year 2000/01 to fiscal year 2018/19 (in million GBP)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Total" .

