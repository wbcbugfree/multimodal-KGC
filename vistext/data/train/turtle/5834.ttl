@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Reach of selected social networks in the United States as of February 2017" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "Share of respondents" .

:DataPoint1 a :DataPoint ;
    :xValue "Facebook" ;
    :yValue "0.78" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "YouTube" ;
    :yValue "0.48" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "Twitter" ;
    :yValue "0.34" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "Instagram" ;
    :yValue "0.29" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "Pinterest" ;
    :yValue "0.27" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Google+" ;
    :yValue "0.2" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "LinkedIn" ;
    :yValue "0.19" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Snapchat" ;
    :yValue "0.18" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "Tumblr" ;
    :yValue "0.08" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "Reddit" ;
    :yValue "0.06" ;
    :belongsTo :Chart .
