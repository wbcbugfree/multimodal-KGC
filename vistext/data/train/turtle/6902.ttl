@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "How comfortable would you be with a person with a visible tattoo working in the following occupations ?" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Not comfortable" .

:YAxis a :Axis ;
    :title "Response" .

:DataPoint1 a :DataPoint ;
    :xValue "0.14" ;
    :yValue "Athlete" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "0.19" ;
    :yValue "IT technician" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "0.22" ;
    :yValue "Chef" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "0.3" ;
    :yValue "Police officer" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "0.32" ;
    :yValue "Real estate broker/agent" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "0.33" ;
    :yValue "Camp counselor" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "0.36" ;
    :yValue "Banker" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "0.38" ;
    :yValue "Doctor" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "0.41" ;
    :yValue "Primary school teacher" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "0.41" ;
    :yValue "Judge" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "0.42" ;
    :yValue "Presidential candidate" ;
    :belongsTo :Chart .
