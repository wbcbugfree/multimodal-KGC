@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Why did n't you tell anyone about the bullying ?" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Share of respondents" .

:YAxis a :Axis ;
    :title "Response" .

:DataPoint1 a :DataPoint ;
    :xValue "0.38" ;
    :yValue "I'll be called a snitch" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "0.38" ;
    :yValue "I'm scared of it getting worse" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "0.34" ;
    :yValue "I'm embarrassed" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "0.32" ;
    :yValue "I didn't think it was serious enough" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "0.31" ;
    :yValue "I don't want to feel like a victim" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "0.3" ;
    :yValue "It didn't affect me enough" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "0.27" ;
    :yValue "It won't be taken seriously" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "0.26" ;
    :yValue "I can deal with it myself" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "0.24" ;
    :yValue "I reported it in the past and nothing happened" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "0.24" ;
    :yValue "I have done in the past and nothing happened" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "0.17" ;
    :yValue "My teachers don't care" ;
    :belongsTo :Chart .
