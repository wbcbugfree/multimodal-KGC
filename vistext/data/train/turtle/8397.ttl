@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Large luxury car and SUV sales in the United States in 2019 , by key model (in units)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Large luxury car and SUV models" .

:YAxis a :Axis ;
    :title "2019" .

:DataPoint1 a :DataPoint ;
    :xValue "Cadillac Escalad" ;
    :yValue "35424" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Cadillac Escalade Mercedes-Benz GLS-Clas" ;
    :yValue "22615" ;
    :belongsTo :Chart .

