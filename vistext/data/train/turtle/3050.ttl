@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "The 20 countries with the greatest decrease of the gross domestic product (GDP) in 2019 (compared to the previous year)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Percent change" .

:YAxis a :Axis ;
    :title "Country" .

:DataPoint1 a :DataPoint ;
    :xValue "-0.35" ;
    :yValue "Venezuela" ;
    :belongsTo :Chart .

