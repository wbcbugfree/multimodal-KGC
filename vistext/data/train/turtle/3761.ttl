@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Most successful movies at the box office in the United Kingdom (UK) as of November 2020 (in 1,000 GBP)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Most successful movies" .

:YAxis a :Axis ;
    :title "Revenue in thousand GBP" .

