@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Number of nominations per motion picture distributor for the 2020 Golden Globe Awards" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Number of nominations" .

:YAxis a :Axis ;
    :title "film distributor" .

:DataPoint1 a :DataPoint ;
    :xValue "17" ;
    :yValue "Netflix" ;
    :belongsTo :Chart .

