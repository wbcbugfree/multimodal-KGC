@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Age distribution of the population in Italy from 2002 to 2020" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "15-64 years" .

:DataPoint1 a :DataPoint ;
    :xValue "2020*" ;
    :yValue "0.639" ;
    :belongsTo :Chart .

