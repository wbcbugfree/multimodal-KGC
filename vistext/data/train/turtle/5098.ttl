@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Most-followed drag queens from RuPaul 's drag race on Instagram worldwide as of June 2020" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Number of followers in millions" .

:YAxis a :Axis ;
    :title "Name (Competitive season)" .

:DataPoint1 a :DataPoint ;
    :xValue "2.2" ;
    :yValue "Bianca Del Rio (S6)" ;
    :belongsTo :Chart .

