@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Fundraising and spending in U.S. presidential elections from 1976 to 2016 (in million U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Total spending by presidential candidates" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 1975" ;
    :yValue "66.9" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Dec 31, 1979" ;
    :yValue "92.3" ;
    :belongsTo :Chart .

