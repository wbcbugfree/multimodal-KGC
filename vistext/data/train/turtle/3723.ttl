@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Assets of section 529 savings plan in the United States from 2001 to 2019 (in billion U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Assets in billion U.S. dollars" .

