@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Residents aged 65 years and older as share of the resident population in Singapore from 1970 to 2019" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "Share of resident population" .

