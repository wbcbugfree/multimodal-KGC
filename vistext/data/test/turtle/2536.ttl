@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Annual number of doctors licensed to practice in Austria from 2000 to 2017 (per 1,000 people)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Number of doctors per 1,000 people" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 1999" ;
    :yValue "3.85" ;
    :belongsTo :Chart .

