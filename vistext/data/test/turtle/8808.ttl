@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Belgium : Distribution of gross domestic product (GDP) across economic sectors from 2009 to 2019" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Services" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2008" ;
    :yValue "0.6809" ;
    :belongsTo :Chart .

