@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Annual volume of carbon dioxide (CO2) emissions from incineration of waste sector in Taiwan from 2006 to 2017 (in 1,000 metric tons)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Emission volume in thousand metric tons" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2005" ;
    :yValue "470" ;
    :belongsTo :Chart .

