@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Percentage of people who use a computer every day in the United Kingdom (UK) from 2003 to 2017" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "Percentage of respondents" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2002" ;
    :yValue "0.43" ;
    :belongsTo :Chart .

