@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Pet ownership in selected countries in Europe in 2016" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Cat" .

:YAxis a :Axis ;
    :title "Response" .

:DataPoint1 a :DataPoint ;
    :xValue "0.27" ;
    :yValue "United Kingdom" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "0.15" ;
    :yValue "Turkey" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "0.28" ;
    :yValue "Sweden" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "0.23" ;
    :yValue "Spain" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "0.57" ;
    :yValue "Russia" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "0.32" ;
    :yValue "Poland" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "0.26" ;
    :yValue "Netherlands" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "0.33" ;
    :yValue "Belgium" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "0.26" ;
    :yValue "Czech Republic" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "0.41" ;
    :yValue "France" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "0.29" ;
    :yValue "Germany" ;
    :belongsTo :Chart .

:DataPoint12 a :DataPoint ;
    :xValue "0.34" ;
    :yValue "Italy" ;
    :belongsTo :Chart .
