@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Most common purchase influences of online shoppers in the United States in 2017" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "Share of respondents" .

:DataPoint1 a :DataPoint ;
    :xValue "Price" ;
    :yValue "0.87" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Shipping cost and speed" ;
    :yValue "0.8" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "Discount offers" ;
    :yValue "0.71" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "Variety of options in stock" ;
    :yValue "0.71" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "Trustworthy reviews" ;
    :yValue "0.68" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Flexible or free returns" ;
    :yValue "0.68" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Brand reputation" ;
    :yValue "0.67" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Simple site navigation" ;
    :yValue "0.64" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "Tailored selection of products" ;
    :yValue "0.53" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "Mobile-friendly webpage" ;
    :yValue "0.46" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "Loyalty/rewards program" ;
    :yValue "0.45" ;
    :belongsTo :Chart .

:DataPoint12 a :DataPoint ;
    :xValue "Friend and family" ;
    :yValue "0.42" ;
    :belongsTo :Chart .

:DataPoint13 a :DataPoint ;
    :xValue "Top searching engine results" ;
    :yValue "0.39" ;
    :belongsTo :Chart .

:DataPoint14 a :DataPoint ;
    :xValue "Social media recommendations" ;
    :yValue "0.23" ;
    :belongsTo :Chart .

:DataPoint15 a :DataPoint ;
    :xValue "Advertisements" ;
    :yValue "0.21" ;
    :belongsTo :Chart .
