@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Total cost of violence to the U.S. economy in 2010 , by static and dynamic indicators (in million U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Economic effect in million U.S. dollars" .

:YAxis a :Axis ;
    :title "Static and dynamic indicators" .

:DataPoint1 a :DataPoint ;
    :xValue "178427.1" ;
    :yValue "Assault, lost productivity (dynamic)" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "71009.66" ;
    :yValue "Incarceration, lost work (dynamic)" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "56394.99" ;
    :yValue "Police, wages (static)" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "48555.81" ;
    :yValue "Homicide, lost productivity (dynamic)" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "41684.1" ;
    :yValue "Incarceration, government costs (static)" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "37976.99" ;
    :yValue "Assault, medical costs (static)" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "20498.53" ;
    :yValue "Rape, lost productivity (dynamic)" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "5702.21" ;
    :yValue "Legal and judicial, government costs (static)" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "489.95" ;
    :yValue "Robbery, property damage (static)" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "91.62" ;
    :yValue "Homicide, medical costs (static)" ;
    :belongsTo :Chart .
