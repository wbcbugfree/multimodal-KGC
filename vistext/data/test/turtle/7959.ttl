@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Total U.S. cotton plantings and harvestings from 2000 to 2019 (in 1,000 acres)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Planted" .

