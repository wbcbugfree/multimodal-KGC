@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Number of Army national guard members by ethnic group in the United States from 1995 to 2010 (in 1,000s)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Black members" .

