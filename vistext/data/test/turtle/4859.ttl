@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Most popular Facebook games as of May 2019 , based on number of daily active users (in millions)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Facebook game" .

:YAxis a :Axis ;
    :title "Number of daily active users in millions" .

:DataPoint1 a :DataPoint ;
    :xValue "8 Ball Pool" ;
    :yValue "10" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Candy Crush Saga" ;
    :yValue "10" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "Texas HoldEm Poker" ;
    :yValue "1" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "Farm Heroes Saga" ;
    :yValue "1" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "Subway Surfers" ;
    :yValue "1" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Clash of Clans" ;
    :yValue "1" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Dragon City" ;
    :yValue "1" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Hay Day" ;
    :yValue "1" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "Trivia Crack" ;
    :yValue "1" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "Word with Friends" ;
    :yValue "1" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "FarmVille 2" ;
    :yValue "1" ;
