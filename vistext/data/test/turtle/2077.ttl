@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Cities with the largest number of community gardens per 10,000 residents in the United States in 2019" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "city" .

:YAxis a :Axis ;
    :title "Community gardens per 10,000 residents" .

:DataPoint1 a :DataPoint ;
    :xValue "Portland, OR" ;
    :yValue "3.8" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "St. Paul, MN" ;
    :yValue "3.8" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "Washington, DC" ;
    :yValue "3.2" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "Madison, WI" ;
    :yValue "3.2" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "Orlando, FL" ;
    :yValue "2.4" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Seattle, WA" ;
    :yValue "2.1" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Milwaukee, WI" ;
    :yValue "1.8" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Arlington, VA" ;
    :yValue "1.7" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "Long Beach, CA" ;
