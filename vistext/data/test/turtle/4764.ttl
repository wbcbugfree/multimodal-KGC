@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Number of family medicine and general practice physicians in Canada as of 2019 , by province" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "province of Canada" .

:YAxis a :Axis ;
    :title "Number of physicians" .

:DataPoint1 a :DataPoint ;
    :xValue "Ontario" ;
    :yValue "14962" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Quebec" ;
    :yValue "10909" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "British Columbia" ;
    :yValue "6366" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "Alberta" ;
    :yValue "5758" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "Manitoba" ;
    :yValue "1519" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Saskatchewan" ;
    :yValue "1395" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Nova Scotia" ;
    :yValue "1292" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "New Brunswick" ;
    :yValue "1153" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "Newfoundland and Labrador" ;
    :yValue "927" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "Prince Edward Island" ;
    :yValue "174" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "Territories" ;
    :yValue "129" ;
