@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Portugal : Government revenue and spending from 2014 to 2024 (in billion euros)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Spending" .

:YAxis a :Axis ;
    :title "Year" .

:DataPoint1 a :DataPoint ;
    :xValue "104.29" ;
    :yValue "2024*" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "101.61" ;
    :yValue "2023*" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "98.74" ;
    :yValue "2022*" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "96.11" ;
    :yValue "2021*" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "93.69" ;
    :yValue "2020*" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "91.39" ;
    :yValue "2019*" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "88.63" ;
    :yValue "2018" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "88.88" ;
    :yValue "2017" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "83.56" ;
    :yValue "2016" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "86.49" ;
    :yValue "2015" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "89.52" ;
    :yValue "2014" ;
    :belongsTo :Chart .
