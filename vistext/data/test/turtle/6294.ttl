@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "What is your religious preference : Protestant , Roman Catholic , Jewish , another religion , or no religion ?" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "Undesignated" .

