    :xValue "Jordan" ;
    :yValue "47" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Bahrain" ;
    :yValue "29" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "United Arab Emirates" ;
    :yValue "28" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Egypt" ;
    :yValue "26" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "Saudi Arabia" ;
    :yValue "25" ;
