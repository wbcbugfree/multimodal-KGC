    :xValue "201" ;
    :yValue "Cantineriunite/CIV" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "209" ;
    :yValue "Antinori" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "183" ;
    :yValue "Zonin" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "160" ;
    :yValue "Martini" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "175" ;
    :yValue "Mezzacorona" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
