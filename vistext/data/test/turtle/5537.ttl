@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Share of retail bank customers with positive banking experience in selected European countries as of 2016" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "Share of customers with positive experience" .

:DataPoint1 a :DataPoint ;
    :xValue "Netherlands" ;
    :yValue "0.706" ;
    :belongsTo :Chart .

