    :xValue "3764" ;
    :yValue "2013" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "3842" ;
    :yValue "2012" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "3750" ;
    :yValue "2011" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "3754" ;
    :yValue "2010" ;
    :belongsTo :Chart .

