@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Total number of employees in the crude petroleum and natural gas extraction sector in Germany from 2008 to 2018" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Number of employees" .

:YAxis a :Axis ;
    :title "Year" .

:DataPoint1 a :DataPoint ;
    :xValue "4925" ;
    :yValue "2018*" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "3526" ;
    :yValue "2017" ;
    :belongsTo :Chart .

