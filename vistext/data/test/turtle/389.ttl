@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Leading 10 U.S. companies based on medical device revenue in 2019 (in billion U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Revenue in billion U.S. dollars" .

:YAxis a :Axis ;
    :title "companies based on medical device" .

:DataPoint1 a :DataPoint ;
    :xValue "30.55" ;
    :yValue "Medtronic Inc.*" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "25.96" ;
    :yValue "Johnson & Johnson Medical Devices & Diagnostics*" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "19.94" ;
    :yValue "General Electric Healthcare**" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "15.63" ;
    :yValue "Cardinal Health" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "14.88" ;
    :yValue "Stryker Corp." ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "12.99" ;
    :yValue "Becton Dickinson & Co." ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "12.23" ;
    :yValue "Abbott Laboratories" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "11.36" ;
    :yValue "Baxter International Inc." ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "10.65" ;
    :yValue "Boston Scientific Corp." ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "7.98" ;
    :yValue "Zimmer Biomet" ;
    :belongsTo :Chart .
