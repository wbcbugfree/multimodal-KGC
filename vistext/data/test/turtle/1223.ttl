@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Fifteen largest Italian populations living abroad in 2018 , by country of residence" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Country" .

:YAxis a :Axis ;
    :title "Number of individuals" .

:DataPoint1 a :DataPoint ;
    :xValue "Argentina" ;
    :yValue "977417" ;
    :belongsTo :Chart .

