@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Number of enterprises in the manufacture of plastics products industry in Spain from 2008 to 2017" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Number of enterprises" .

:YAxis a :Axis ;
    :title "Year" .

:DataPoint1 a :DataPoint ;
    :xValue "3610" ;
    :yValue "2017*" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "3635" ;
    :yValue "2016" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "3716" ;
    :yValue "2015" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "3559" ;
    :yValue "2014" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "3647" ;
    :yValue "2013" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "3981" ;
    :yValue "2012" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "4144" ;
    :yValue "2011" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "4292" ;
    :yValue "2010" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "4305" ;
    :yValue "2009" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
