@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Top ten media markets for the 2016 presidential general election in the United States , as of August 18 , 2016 , by ad airings" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "media market" .

:YAxis a :Axis ;
    :title "Number of ads aired" .

:DataPoint1 a :DataPoint ;
    :xValue "Tampa , FL" ;
    :yValue "6553" ;
    :belongsTo :Chart .

