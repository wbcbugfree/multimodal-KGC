    :belongsTo :Chart .

:DataPoint14 a :DataPoint ;
    :xValue "0.019" ;
    :yValue "Business activities" ;
    :belongsTo :Chart .

:DataPoint15 a :DataPoint ;
    :xValue "0.012" ;
