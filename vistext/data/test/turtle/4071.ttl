    :xValue "0.073" ;
    :yValue "Mining and quarrying" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "0.056" ;
    :yValue "Transportation and storage" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "0.042" ;
    :yValue "Financial and insurance activities" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "0.04" ;
    :yValue "Information and communication" ;
    :belongsTo :Chart .

