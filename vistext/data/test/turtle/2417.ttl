@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "To what extent are you interested in the following sports ?" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Share of respondents" .

:YAxis a :Axis ;
    :title "Response" .

:DataPoint1 a :DataPoint ;
    :xValue "0.59" ;
    :yValue "Soccer" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "0.55" ;
    :yValue "Hockey" ;
    :belongsTo :Chart .

