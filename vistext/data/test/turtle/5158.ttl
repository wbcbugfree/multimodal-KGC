    :xValue "Dec 31, 2005" ;
    :yValue "1768" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Dec 31, 2006" ;
    :yValue "1861" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
