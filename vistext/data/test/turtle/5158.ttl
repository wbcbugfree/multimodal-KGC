@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Total car fleet of the rental car industry in the United States from 2002 to 2012 (in 1,000 cars in service)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Cars in service in thousands" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2001" ;
    :yValue "1643" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Dec 31, 2002" ;
    :yValue "1617" ;
    :belongsTo :Chart .

