@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Employment in the hospitality and tourism workforce in the United Kingdom (UK) in 2014 , by sector" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "sector" .

:YAxis a :Axis ;
    :title "Workforce number" .

:DataPoint1 a :DataPoint ;
    :xValue "Restaurants" ;
    :yValue "803638" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Hospitality services" ;
    :yValue "375054" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "Pubs, bars and nightclubs" ;
    :yValue "340215" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "Visitor attractions" ;
    :yValue "295727" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "Hotels" ;
    :yValue "281311" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Food and service management" ;
    :yValue "196804" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Holiday parks and other short-stay accommodation" ;
    :yValue "81024" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Museum and cultural attractions" ;
    :yValue "63437" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "Tourist services" ;
    :yValue "32764" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "Organisation of conventions and trade shows" ;
    :yValue "31218" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "Camp sites and other accommodation" ;
    :yValue "29011" ;
    :belongsTo :Chart .
