@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "What types of products did you buy online during the coronavirus (COVID-19) pandemic in Romania ?" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Share of respondents" .

:YAxis a :Axis ;
    :title "Response" .

:DataPoint1 a :DataPoint ;
    :xValue "0.81" ;
    :yValue "Household appliances" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "0.71" ;
    :yValue "Clothing and accessories" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "0.67" ;
    :yValue "Shoes" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "0.57" ;
    :yValue "Household maintenance products" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "0.5" ;
    :yValue "Cosmetics" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "0.48" ;
    :yValue "Books" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "0.45" ;
    :yValue "Products for car maitenance" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "0.39" ;
    :yValue "Holiday tickets/ accomodation/ flights" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "0.37" ;
    :yValue "Furniture" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "0.32" ;
    :yValue "Tickets for events/ shows" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "0.25" ;
    :yValue "Medicine" ;
    :belongsTo :Chart .
