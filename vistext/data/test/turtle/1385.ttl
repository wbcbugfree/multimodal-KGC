@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Number of domestic trophies won by Cristiano Ronaldo as of 2020 , by competition" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Competition" .

:YAxis a :Axis ;
    :title "Number of titles" .

:DataPoint1 a :DataPoint ;
    :xValue "Champions League" ;
    :yValue "5" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "FIFA Club World Cup" ;
    :yValue "4" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "Premier League" ;
    :yValue "3" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "UEFA Super Cup" ;
    :yValue "3" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "La Liga" ;
    :yValue "2" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Copa del Rey" ;
    :yValue "2" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "English League Cup" ;
    :yValue "2" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Spanish Super Cup" ;
    :yValue "2" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "English Community Shield" ;
    :yValue "2" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "Serie A" ;
    :yValue "2" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "Italian Super Cup" ;
    :yValue "1" ;
    :belongsTo :Chart .

:DataPoint12 a :DataPoint ;
    :xValue "FA Cup" ;
    :yValue "1" ;
    :belongsTo :Chart .

:DataPoint13 a :DataPoint ;
    :xValue "Portuguese Super Cup" ;
    :yValue "1" ;
    :belongsTo :Chart .
