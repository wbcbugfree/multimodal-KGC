@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Main import partners of Sweden in 2019 , by import value (in million SEK)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Country" .

:YAxis a :Axis ;
    :title "Import value million SEK" .

