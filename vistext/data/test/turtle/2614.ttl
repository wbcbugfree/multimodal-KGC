@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Most popular accommodation choices of luxury travel clients according to travel agents in the United States as of August 2014" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "Share of respondents" .

:DataPoint1 a :DataPoint ;
    :xValue "Cruise ship (luxury)" ;
    :yValue "0.435" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "5-star hotels/resorts" ;
    :yValue "0.431" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "Boutique hotels" ;
    :yValue "0.405" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "4-star hotels/resorts" ;
    :yValue "0.237" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "5-star hotels/resorts – suites" ;
    :yValue "0.215" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "5-star + (plus) hotels/resorts" ;
    :yValue "0.191" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "4-star hotels/resorts – suites" ;
    :yValue "0.19" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Cruise ship (not luxury) in a suite" ;
    :yValue "0.184" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "5-star + (plus) hotels/resorts – suites" ;
    :yValue "0.16" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "Villa" ;
    :yValue "0.102" ;
    :belongsTo :Chart .
