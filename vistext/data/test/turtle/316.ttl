@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Convenience store sales of salty snacks in the United States in 2019 , by type (in million U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Industry total sales in million U.S. dollars" .

:YAxis a :Axis ;
    :title "salty snacks" .

:DataPoint1 a :DataPoint ;
    :xValue "1828.7" ;
    :yValue "Potato chips" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "1202.7" ;
    :yValue "Tortilla/corn chips" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "878.3" ;
    :yValue "Other salty snacks" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "822.3" ;
    :yValue "Cheese snacks" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "642.7" ;
    :yValue "Snack nuts" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "446.3" ;
    :yValue "Crackers" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "408.9" ;
    :yValue "Corn snacks" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "301.5" ;
    :yValue "Sunflower/pumpkin seeds" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "263.1" ;
    :yValue "Pretzels" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "243.4" ;
    :yValue "Popcorn (ready-to-eat)" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "229.4" ;
    :yValue "Pork rinds" ;
    :belongsTo :Chart .
