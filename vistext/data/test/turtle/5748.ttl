@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Number of road traffic fatalities in Bulgaria from 2006 to 2019" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Number of fatalities" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2005" ;
    :yValue "1043" ;
    :belongsTo :Chart .

