@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "For each of the following product categories , how many of your purchases have you made online over the last 12 months ?" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "About half of my purchases (41-60%)" .

:YAxis a :Axis ;
    :title "Response" .

:DataPoint1 a :DataPoint ;
    :xValue "0.1" ;
    :yValue "Consumer electronics" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "0.11" ;
    :yValue "Household appliances" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "0.23" ;
    :yValue "Clothing and footwear" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "0.17" ;
    :yValue "Books, music, movies and video games" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "0.12" ;
    :yValue "Furniture/homeware" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "0.11" ;
    :yValue "Sports/outdoor equipment" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "0.12" ;
    :yValue "Jewellery/watches" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "0.11" ;
    :yValue "DIY/home improvement" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "0.14" ;
    :yValue "Grocery" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "0.11" ;
    :yValue "Toys" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "0.18" ;
    :yValue "Health and beauty" ;
    :belongsTo :Chart .
