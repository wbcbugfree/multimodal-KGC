@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Sales-to-assets ratio of top 20 pharmaceutical companies worldwide in 2019" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Sales to assets ratio" .

:YAxis a :Axis ;
    :title "business" .

:DataPoint1 a :DataPoint ;
    :xValue "1" ;
    :yValue "Novo Nordisk" ;
    :belongsTo :Chart .

