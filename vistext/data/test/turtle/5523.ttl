@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Number of people affected by the world 's major volcanic eruptions from 1900 to 2016" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "volcanic eruption and date" .

:YAxis a :Axis ;
    :title "Number of victims" .

:DataPoint1 a :DataPoint ;
    :xValue "Volcanic eruption in the Philippines (June 9, 1991)" ;
    :yValue "1036065" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Volcano eruption in Ecuador (August 14, 2015)" ;
    :yValue "800000" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "Volcanic eruption in Nicaragua (April 9, 1992)" ;
    :yValue "300075" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "Volcano eruption in Ecuador (August 14, 2006)" ;
    :yValue "300013" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "Volcano eruption in Indonesia (April 5, 1982)" ;
    :yValue "300000" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Volcano eruption in Indonesia (1969)" ;
    :yValue "250000" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Volcanic eruption in Comoros (November 24, 2005)" ;
    :yValue "245000" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Volcanic eruption in the Philippines (Feb. 6, 1993)" ;
    :yValue "165009" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "Volcanic eruption in Papua New Guinea (September 19, 1994)" ;
    :yValue "152002" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "Volcanic eruption in Indonesia (October 24, 2002)" ;
    :yValue "137140" ;
    :belongsTo :Chart .
