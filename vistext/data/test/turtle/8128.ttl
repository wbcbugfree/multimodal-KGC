@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Number of EOR projects in the U.S. crude oil production by extraction method 1990 to 2010" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Gas injection" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 1989" ;
    :yValue "91" ;
    :belongsTo :Chart .

