@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "CVS Health 's revenue distribution from 2015 to 2025 , by product group" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Pharmacy services" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2014" ;
    :yValue "0.655" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Dec 31, 2015" ;
    :yValue "0.676" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "Dec 31, 2016" ;
    :yValue "0.707" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "Dec 31, 2017" ;
    :yValue "0.692" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "Dec 31, 2018" ;
    :yValue "0.666" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Dec 31, 2019" ;
    :yValue "0.654" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Dec 31, 2020" ;
    :yValue "0.641" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Dec 31, 2021" ;
    :yValue "0.633" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "Dec 31, 2022" ;
    :yValue "0.624" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "Dec 31, 2023" ;
    :yValue "0.615" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "Dec 31, 2024" ;
