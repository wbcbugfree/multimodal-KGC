@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Number of cyclists fatalities due to road accidents in Delhi , India from 2004 to 2018" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Number of victims" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2003" ;
    :yValue "180" ;
    :belongsTo :Chart .

