@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Operating profit of the Roche Group from 2007 to 2019 (in million Swiss francs)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Operating profit in million Swiss francs" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2006" ;
    :yValue "15841" ;
    :belongsTo :Chart .

