@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Share of traditional quantitative methods used in the market research industry worldwide in Q3 and Q4 2018" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Share of respondents" .

:YAxis a :Axis ;
    :title "Response" .

:DataPoint1 a :DataPoint ;
    :xValue "0.05" ;
    :yValue "Automated measures/ People met...." ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "0.06" ;
    :yValue "Biometrics/ neuromarketing" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "0.16" ;
    :yValue "CAPI***" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "0.29" ;
    :yValue "CATI**" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "0.22" ;
    :yValue "Face-to-face" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "0.01" ;
    :yValue "IVR****" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "0.06" ;
    :yValue "Mail" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "0.52" ;
    :yValue "Mobile surveys" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "0.78" ;
    :yValue "Online surveys" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "0.03" ;
    :yValue "Other quantitative techniques" ;
    :belongsTo :Chart .
