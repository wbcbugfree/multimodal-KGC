@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Mexico : The largest cities 2014 (in million residents)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Residents in million" .

:YAxis a :Axis ;
    :title "city" .

:DataPoint1 a :DataPoint ;
    :xValue "1.4" ;
    :yValue "Ciudad Juárez" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "1.7" ;
    :yValue "Ecatepec" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "1.5" ;
    :yValue "Guadalajara" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "1.3" ;
    :yValue "León" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "8.5" ;
    :yValue "Mexico City" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "1.1" ;
    :yValue "Monterrey" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "1.1" ;
    :yValue "Nezahualcóyotl" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "1.5" ;
    :yValue "Puebla" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "1.3" ;
    :yValue "Tijuana" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "1.2" ;
    :yValue "Zapopan" ;
    :belongsTo :Chart .
