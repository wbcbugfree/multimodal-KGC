@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Total number of employees in the crude petroleum and natural gas extraction sector in Germany from 2008 to 2018" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Number of employees" .

:YAxis a :Axis ;
    :title "Year" .

:DataPoint1 a :DataPoint ;
    :xValue "3484" ;
    :yValue "2008" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "3634" ;
    :yValue "2009" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "3689" ;
    :yValue "2010" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "3698" ;
    :yValue "2011" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "3757" ;
    :yValue "2012" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "3692" ;
    :yValue "2013" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "3901" ;
    :yValue "2014" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "3848" ;
    :yValue "2015" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "3624" ;
    :yValue "2016" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "3481" ;
    :yValue "2017" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "4833" ;
    :yValue "2018*" ;
    :belongsTo :Chart .
