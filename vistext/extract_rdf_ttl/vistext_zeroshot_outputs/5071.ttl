@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Average gross income per household in the United Kingdom (UK) in 2018/19 , by decile group (in GBP)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Average gross income per household income in GBP" .

:YAxis a :Axis ;
    :title "Decile group" .

:DataPoint1 a :DataPoint ;
    :xValue "22800" ;
    :yValue "2nd" ;
    :belongsTo :Chart .

