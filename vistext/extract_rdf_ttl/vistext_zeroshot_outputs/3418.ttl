@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Annual total electricity supply in the United Kingdom (UK) from 2000 to 2018 (in gigawatt hours)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Supply in gigawatt hours" .

