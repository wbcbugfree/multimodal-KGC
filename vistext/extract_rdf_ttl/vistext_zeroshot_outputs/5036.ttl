@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Number of deaths caused by coronavirus (COVID-19) in Romania from May 2020 to January 2021 , by day of report" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Number of deaths" .

:DataPoint1 a :DataPoint ;
    :xValue "May 1, 2020" ;
    :yValue "16" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "May 15, 2020" ;
    :yValue "10" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "June 1, 2020" ;
    :yValue "12" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "June 15, 2020" ;
    :yValue "18" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "July 1, 2020" ;
    :yValue "22" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "July 15, 2020" ;
    :yValue "40" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "August 1, 2020" ;
    :yValue "45" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "August 15, 2020" ;
    :yValue "55" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "September 1, 2020" ;
    :yValue "60" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "September 15, 2020" ;
    :yValue "42" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "October 1, 2020" ;
    :yValue "50" ;
    :belongsTo :Chart .

:DataPoint12 a :DataPoint ;
    :xValue "October 15, 2020" ;
    :yValue "95" ;
    :belongsTo :Chart .

:DataPoint13 a :DataPoint ;
    :xValue "November 1, 2020" ;
    :yValue "105" ;
    :belongsTo :Chart .

:DataPoint14 a :DataPoint ;
    :xValue "November 15, 2020" ;
    :yValue "205" ;
    :belongsTo :Chart .

:DataPoint15 a :DataPoint ;
    :xValue "December 1, 2020" ;
    :yValue "195" ;
    :belongsTo :Chart .

:DataPoint16 a :DataPoint ;
    :xValue "December 10, 2020" ;
    :yValue "215" ;
    :belongsTo :Chart .

:DataPoint17 a :DataPoint ;
