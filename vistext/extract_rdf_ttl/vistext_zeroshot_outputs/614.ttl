@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Market share in terms of total loans of the Italian global banking group UniCredit Bank in Europe as of November 2017 , by country" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Country" .

:YAxis a :Axis ;
    :title "Loans market share" .

:DataPoint1 a :DataPoint ;
    :xValue "Austria" ;
    :yValue "0.14" ;
    :belongsTo :Chart .

