@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Percentage of leave and remain votes in selected major cities in the United Kingdom (UK) in the EU referendum in 2016" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Leave" .

:YAxis a :Axis ;
    :title "city" .

:DataPoint1 a :DataPoint ;
    :xValue "0.5" ;
    :yValue "Birmingham" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "0.4" ;
    :yValue "Cardiff" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "0.26" ;
    :yValue "Edinburgh" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "0.33" ;
    :yValue "Glasgow" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "0.5" ;
    :yValue "Leeds" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "0.42" ;
    :yValue "Liverpool" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "0.4" ;
    :yValue "London" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "0.39" ;
    :yValue "Manchester" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "0.49" ;
    :yValue "Newcastle" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "0.51" ;
    :yValue "Sheffield" ;
    :belongsTo :Chart .
