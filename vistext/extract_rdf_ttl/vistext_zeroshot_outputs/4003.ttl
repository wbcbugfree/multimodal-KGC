@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "French men 's favorite ready-to-wear brands in 2017" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "Share of respondents" .

:DataPoint1 a :DataPoint ;
    :xValue "Armand Thierry" ;
    :yValue "0.16" ;
    :belongsTo :Chart .

