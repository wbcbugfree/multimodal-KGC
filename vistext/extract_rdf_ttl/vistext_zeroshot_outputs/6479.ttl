@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Breakdown of Johnson & Johnson 's revenue worldwide from 2013 to 2021 , by sub-category" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Sub-category" .

:YAxis a :Axis ;
    :title "2019" .

:dataPoint1 a :dataPoint ;
    :xValue "Anti-infectives**" ;
    :yValue "0.06" ;
    :belongsTo :Chart .

:dataPoint2 a :dataPoint ;
    :xValue "Baby care***" ;
    :yValue "0.031" ;
    :belongsTo :Chart .

:dataPoint3 a :dataPoint ;
    :xValue "Central nervous system**" ;
    :yValue "0.06" ;
    :belongsTo :Chart .

:dataPoint4 a :dataPoint ;
    :xValue "DePuy orthopedics & spine*" ;
    :yValue "0.163" ;
    :belongsTo :Chart .

:dataPoint5 a :dataPoint ;
    :xValue "Neutrogena, Aveena & other skin ..." ;
    :yValue "0.055" ;
    :belongsTo :Chart .

:dataPoint6 a :dataPoint ;
    :xValue "OTC drugs & nutritionals***" ;
    :yValue "0.058" ;
    :belongsTo :Chart .

:dataPoint7 a :dataPoint ;
    :xValue "Procrit, Velcade & other**" ;
    :yValue "0.121" ;
    :belongsTo :Chart .

:dataPoint8 a :dataPoint ;
    :xValue "Remicade & immunology**" ;
    :yValue "0.11" ;
    :belongsTo :Chart .

:dataPoint9 a :dataPoint ;
    :xValue "Stents, catheters & other medical ..." ;
    :yValue "0.115" ;
    :belongsTo :Chart .

:dataPoint10 a :dataPoint ;
    :xValue "Surgical devices*" ;
    :yValue "0.156" ;
    :belongsTo :Chart .

:dataPoint11 a :dataPoint ;
    :xValue "Women's health, wound & oral car..." ;
    :yValue "0.068" ;
    :belongsTo :Chart .
