@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Amount a player receives for playing in the NFL Super Bowl 2020 - 2030 (in 1,000 U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Losing team" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2019" ;
    :yValue "75" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Dec 31, 2020" ;
    :yValue "83" ;
    :belongsTo :Chart .

