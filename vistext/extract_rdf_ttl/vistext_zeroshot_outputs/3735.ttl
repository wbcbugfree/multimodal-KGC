@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Liechtenstein : Gross domestic product (GDP) in current prices from 2007 to 2017 (in billion U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Gross domestic product in billion U.S. dollars" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2006" ;
    :yValue "4.62" ;
    :belongsTo :Chart .

