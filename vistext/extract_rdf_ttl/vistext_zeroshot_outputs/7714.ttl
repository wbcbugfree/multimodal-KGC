@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Distribution of U.S. biotech and non-biotech corn acreage from 2006 to 2019 , by type" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Non-biotech" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2005" ;
    :yValue "0.39" ;
    :belongsTo :Chart .

