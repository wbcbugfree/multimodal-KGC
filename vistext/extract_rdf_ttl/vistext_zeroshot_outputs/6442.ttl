@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Distribution of the workforce across economic sectors in China from 2009 to 2019" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Industry" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2008" ;
    :yValue "0.278" ;
    :belongsTo :Chart .

