@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Largest companies in Gotland county , Sweden as of December 2020 , by turnover (in thousand SEK)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Turnover in thousand SEK" .

:YAxis a :Axis ;
    :title "Largest companies in Gotland county" .

