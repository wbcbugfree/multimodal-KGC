    :xValue "0.104" ;
    :yValue "2008" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "0.101" ;
    :yValue "2009" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "0.1" ;
    :yValue "2010" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "0.098" ;
