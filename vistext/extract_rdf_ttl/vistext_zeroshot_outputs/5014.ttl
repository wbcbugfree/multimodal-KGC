@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Percentage of preterm births in the United States from 1990 to 2018" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Percentage of all births" .

:YAxis a :Axis ;
    :title "Response" .

:DataPoint1 a :DataPoint ;
    :xValue "0.106" ;
    :yValue "1990*" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "0.116" ;
    :yValue "2000*" ;
    :belongsTo :Chart .

