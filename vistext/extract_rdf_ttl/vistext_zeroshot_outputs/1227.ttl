@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Swaziland : National debt from 2014 to 2024 (in billion U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "National debt in billion U.S. dollars" .

:DataPoint1 a :DataPoint ;
    :xValue "2014" ;
    :yValue "0.47" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "2015" ;
    :yValue "0.65" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "2016" ;
    :yValue "0.99" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "2017" ;
    :yValue "1.12" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "2018" ;
    :yValue "1.53" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "2019" ;
    :yValue "1.89" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "2020*" ;
    :yValue "2.08" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "2021*" ;
    :yValue "2.35" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "2022*" ;
    :yValue "2.76" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "2023*" ;
    :yValue "3.23" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "2024*" ;
    :yValue "3.78" ;
    :belongsTo :Chart .
