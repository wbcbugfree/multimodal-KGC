@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Share of households with broadband internet access in Italy from 2005 to 2018" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "Share of households" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2004" ;
    :yValue "0.13" ;
    :belongsTo :Chart .

