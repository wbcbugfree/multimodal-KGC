@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Most popular tourist attractions worldwide on Instagram as of September 2018 , by number of posts (in millions)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Number of hashtagged posts in millions" .

:YAxis a :Axis ;
    :title "tourist attraction" .

:DataPoint1 a :DataPoint ;
    :xValue "1.1" ;
    :yValue "Angor Wat, Cambodia" ;
    :belongsTo :Chart .

