@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Most viewed YouTube video categories of male Millennial users in the United States as of April 2016" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "Share of views" .

:dataPoint1 a :dataPoint ;
    :xValue "Comedy" ;
    :yValue "0.02" ;
    :belongsTo :Chart .

:dataPoint2 a :dataPoint ;
    :xValue "Education and reference" ;
    :yValue "0.02" ;
    :belongsTo :Chart .

:dataPoint3 a :dataPoint ;
    :xValue "Gaming" ;
    :yValue "0.51" ;
    :belongsTo :Chart .

:dataPoint4 a :dataPoint ;
    :xValue "Health and fitness" ;
    :yValue "0.03" ;
    :belongsTo :Chart .

:dataPoint5 a :dataPoint ;
    :xValue "Hobbies" ;
    :yValue "0.03" ;
    :belongsTo :Chart .

:dataPoint6 a :dataPoint ;
    :xValue "Movies and TV" ;
    :yValue "0.12" ;
    :belongsTo :Chart .

:dataPoint7 a :dataPoint ;
    :xValue "Music" ;
    :yValue "0.15" ;
    :belongsTo :Chart .

:dataPoint8 a :dataPoint ;
    :xValue "Other" ;
    :yValue "0.02" ;
    :belongsTo :Chart .

:dataPoint9 a :dataPoint ;
    :xValue "Shopping" ;
    :yValue "0.01" ;
    :belongsTo :Chart .

:dataPoint10 a :dataPoint ;
    :xValue "Sports" ;
    :yValue "0.05" ;
    :belongsTo :Chart .

:dataPoint11 a :dataPoint ;
    :xValue "Technology" ;
    :yValue "0.04" ;
    :belongsTo :Chart .
