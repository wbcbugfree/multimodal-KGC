@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Number of road traffic fatalities in Greece from 2006 to 2019" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Number of fatalities" .

:DataPoint1 a :DataPoint ;
    :xValue "2006" ;
    :yValue "1657" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "2007" ;
    :yValue "1612" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "2008" ;
    :yValue "1553" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "2009" ;
    :yValue "1456" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "2010" ;
    :yValue "1258" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "2011" ;
    :yValue "1141" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "2012" ;
    :yValue "988" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "2013" ;
    :yValue "879" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "2014" ;
    :yValue "795" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "2015" ;
    :yValue "793" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "2016" ;
    :yValue "824" ;
    :belongsTo :Chart .

:DataPoint12 a :DataPoint ;
    :xValue "2017" ;
    :yValue "731" ;
    :belongsTo :Chart .

:DataPoint13 a :DataPoint ;
    :xValue "2018" ;
    :yValue "700" ;
    :belongsTo :Chart .

:DataPoint14 a :DataPoint ;
    :xValue "2019*" ;
    :yValue "695" ;
    :belongsTo :Chart .
