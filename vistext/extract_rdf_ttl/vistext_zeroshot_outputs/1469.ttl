@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Number of NAFTA visas issued by the U.S. Department of State from 2006 to 2018" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Number of visas issued" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2005" ;
    :yValue "78000" ;
    :belongsTo :Chart .

