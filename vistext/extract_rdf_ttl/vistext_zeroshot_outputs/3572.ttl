@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Per capita personal income in Utah from 2000 to 2019 (in current U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Income in U.S. dollars" .

:YAxis a :Axis ;
    :title "year" .

:DataPoint1 a :DataPoint ;
    :xValue "24000" ;
    :yValue "'00" ;
    :belongsTo :Chart .

