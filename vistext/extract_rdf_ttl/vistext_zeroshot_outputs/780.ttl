@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Sales price of bakers ' yeast per ton manufactured in the United Kingdom (UK) from 2008 to 2017 (in GBP)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Price per ton in British pounds" .

:DataPoint1 a :DataPoint ;
    :xValue "2008" ;
    :yValue "525" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "2009" ;
    :yValue "575" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "2011" ;
    :yValue "585" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "2012" ;
    :yValue "535" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "2013" ;
    :yValue "680" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "2014" ;
    :yValue "540" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "2017" ;
    :yValue "555" ;
    :belongsTo :Chart .
