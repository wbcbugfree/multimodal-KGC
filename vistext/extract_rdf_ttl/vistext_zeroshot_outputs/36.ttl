@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Number of mobile customers of Vodafone in Germany in the corporate years from 2008/09 to 2019/2020 (in millions)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Mobile customers in millions" .

:DataPoint1 a :DataPoint ;
    :xValue "2008/09" ;
    :yValue "35.5" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "2009/10" ;
    :yValue "34.6" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "2010/11" ;
    :yValue "36.8" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "2011/12" ;
    :yValue "36.5" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "2012/13" ;
    :yValue "32.5" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "2013/14" ;
    :yValue "32.4" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "2014/15" ;
    :yValue "31" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "2015/16" ;
    :yValue "30.4" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "2016/17" ;
    :yValue "30.8" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "2017/18" ;
    :yValue "30.3" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "2018/19" ;
    :yValue "29.6" ;
    :belongsTo :Chart .

:DataPoint12 a :DataPoint ;
    :xValue "2019/20" ;
    :yValue "30.1" ;
    :belongsTo :Chart .
