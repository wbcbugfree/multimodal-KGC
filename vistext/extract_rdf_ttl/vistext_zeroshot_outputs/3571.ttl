@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "U.S. production of breaded shrimp from 2000 to 2018 (in metric tons)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Production of breaded shrimp in metric tons" .

