@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Number of confirmed cases and deaths of coronavirus (COVID-19) in Chile from March 4 to December 3 , 2020" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Deaths" .

:DataPoint1 a :DataPoint ;
    :xValue "March 4, 2020" ;
    :yValue "0" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "April 2020" ;
    :yValue "20" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "May 2020" ;
    :yValue "250" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "June 2020" ;
    :yValue "1100" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "July 2020" ;
    :yValue "5800" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "August 2020" ;
    :yValue "9500" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "September 2020" ;
    :yValue "11300" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "October 2020" ;
    :yValue "12800" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "November 2020" ;
    :yValue "14200" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "December 3, 2020" ;
    :yValue "15500" ;
    :belongsTo :Chart .
