@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Consumer spending expectations for the following six months on consumer products due to the coronavirus in the United States as of March 9 , 2020" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "consumer products" .

:YAxis a :Axis ;
    :title "Somewhat less" .

:DataPoint1 a :DataPoint ;
    :xValue "Cars/automobiles" ;
    :yValue "0.05" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Fresh and organic goods" ;
    :yValue "0.06" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "Home furniture and décor" ;
    :yValue "0.13" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "Luxury/fashion" ;
    :yValue "0.13" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "Mobile electronics" ;
    :yValue "0.12" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Nonmobile consumer electronics a..." ;
    :yValue "0.12" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Outerwear/jackets/coats" ;
    :yValue "0.18" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Tobacco and smoking products" ;
    :yValue "0.17" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "Toys and games" ;
    :yValue "0.12" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "Vitamins, minerals, herbs, or supp..." ;
    :yValue "0.08" ;
    :belongsTo :Chart .
