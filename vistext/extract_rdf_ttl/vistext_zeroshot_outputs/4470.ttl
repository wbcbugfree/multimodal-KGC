@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Total number of public primary schools in France from 2005 to 2018" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Number of public schools" .

:YAxis a :Axis ;
    :title "Year" .

:DataPoint1 a :DataPoint ;
    :xValue "50600" ;
    :yValue "2005" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "49800" ;
    :yValue "2007" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "49400" ;
    :yValue "2008" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "48900" ;
    :yValue "2009" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "48400" ;
    :yValue "2010" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "48000" ;
    :yValue "2011" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "47700" ;
    :yValue "2012" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "47300" ;
    :yValue "2013" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "47000" ;
    :yValue "2014" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "46500" ;
    :yValue "2015" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "45900" ;
    :yValue "2016" ;
    :belongsTo :Chart .

:DataPoint12 a :DataPoint ;
    :xValue "45400" ;
    :yValue "2017" ;
    :belongsTo :Chart .

:DataPoint13 a :DataPoint ;
    :xValue "44900" ;
    :yValue "2018*" ;
    :belongsTo :Chart .
