@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Share of economic sectors in the global gross domestic product (GDP) from 2008 to 2018" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Services" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2007" ;
    :yValue "62.18" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Dec 31, 2008" ;
    :yValue "64.08" ;
    :belongsTo :Chart .

