@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Most popular leisure activities among men in the United States as of September 2013" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Share of respondents" .

:YAxis a :Axis ;
    :title "Response" .

:DataPoint1 a :DataPoint ;
    :xValue "0.2" ;
    :yValue "Computer/internet" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "0.1" ;
    :yValue "Concerts/listening to/playing music" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "0.1" ;
    :yValue "Exercise/working out" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "0.07" ;
    :yValue "Golf" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "0.13" ;
    :yValue "Playing video games and compute...." ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "0.24" ;
    :yValue "Reading" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "0.13" ;
    :yValue "Spending time with families and f...." ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "0.07" ;
    :yValue "Walking/running/jogging" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "0.43" ;
    :yValue "Watch TV" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "0.11" ;
    :yValue "Watching/going to the movies" ;
    :belongsTo :Chart .
