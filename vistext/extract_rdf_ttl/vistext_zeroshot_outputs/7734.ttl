@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Migration flow of foreign nationals in Spain from 2010 to 2019" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Inflow" .

:DataPoint1 a :DataPoint ;
    :xValue "2010" ;
    :yValue "315000" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "2011" ;
    :yValue "325000" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "2012" ;
    :yValue "250000" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "2013" ;
    :yValue "225000" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "2014" ;
    :yValue "245000" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "2015" ;
    :yValue "265000" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "2016" ;
    :yValue "340000" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "2017" ;
    :yValue "435000" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "2018" ;
    :yValue "560000" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "2019*" ;
    :yValue "290000" ;
    :belongsTo :Chart .
