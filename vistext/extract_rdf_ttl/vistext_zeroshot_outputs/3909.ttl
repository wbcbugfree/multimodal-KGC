@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Los Angeles Rams all-time passing leaders from 1937 to 2020 (in yards)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
