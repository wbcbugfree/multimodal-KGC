@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Characteristics of a dream woman in China from a male perspective in 2012" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Share of respondents" .

:YAxis a :Axis ;
    :title "Response" .

:DataPoint1 a :DataPoint ;
    :xValue "0.46" ;
    :yValue "Elegance" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "0.2" ;
    :yValue "Good looks" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "0.47" ;
    :yValue "Good manners and a good cook/h..." ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "0.49" ;
    :yValue "Monogamous" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "0.38" ;
    :yValue "Sense of responsibility" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "0.11" ;
    :yValue "Sexy body" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "0.05" ;
    :yValue "Social status" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "0.09" ;
    :yValue "Well off financially" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "0.55" ;
    :yValue "Well-read and educated" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "0.07" ;
    :yValue "Willing to give birth" ;
    :belongsTo :Chart .
