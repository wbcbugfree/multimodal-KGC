@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Market capitalization of the largest U.S. internet companies as of June 2020 (in billion U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Value of market cap in billion U.S. dollars" .

:YAxis a :Axis ;
    :title "Platform" .

:DataPoint1 a :DataPoint ;
    :xValue "979.7" ;
    :yValue "Alphabet" ;
    :belongsTo :Chart .

