    :yValue "18638" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Dec 31, 2014" ;
    :yValue "20223" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
