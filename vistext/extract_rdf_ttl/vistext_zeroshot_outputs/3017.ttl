    :yValue "18241" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Dec 31, 2012" ;
    :yValue "17543" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
