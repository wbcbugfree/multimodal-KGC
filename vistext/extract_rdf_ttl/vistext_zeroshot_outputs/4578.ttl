@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Share of old age population (65 years and older) in the total U.S. population from 1950 to 2050" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Percentage of total population" .

:YAxis a :Axis ;
    :title "Response" .

:DataPoint1 a :DataPoint ;
    :xValue "0.081" ;
    :yValue "1950" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "0.092" ;
    :yValue "1960" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "0.099" ;
    :yValue "1970" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "0.113" ;
    :yValue "1980" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "0.126" ;
    :yValue "1990" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "0.124" ;
    :yValue "2000" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "0.131" ;
    :yValue "2010" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "0.16" ;
    :yValue "2018" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "0.165" ;
    :yValue "2019" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "0.169" ;
    :yValue "2020*" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "0.206" ;
    :yValue "2030*" ;
    :belongsTo :Chart .

:DataPoint12 a :DataPoint ;
    :xValue "0.217" ;
    :yValue "2040*" ;
    :belongsTo :Chart .

:DataPoint13 a :DataPoint ;
    :xValue "0.221" ;
    :yValue "2050*" ;
    :belongsTo :Chart .
