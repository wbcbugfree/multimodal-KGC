@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Number of internet users in Brazil from 2015 to 2025 (in millions)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Number of internet users in millions" .

:YAxis a :Axis ;
    :title "Year" .

:DataPoint1 a :DataPoint ;
    :xValue "110.12" ;
    :yValue "2015" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "117.29" ;
    :yValue "2016" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "123.63" ;
    :yValue "2017" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "128.84" ;
    :yValue "2018" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "135.25" ;
    :yValue "2019" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "140.23" ;
    :yValue "2020*" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "144.18" ;
    :yValue "2021*" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "148.16" ;
    :yValue "2022*" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "151.72" ;
    :yValue "2023*" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "154.51" ;
    :yValue "2024*" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "157.19" ;
    :yValue "2025*" ;
    :belongsTo :Chart .
