@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Number of mobile cellular subscriptions in Chad from 2000 to 2016 (in millions)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Number of subscriptions in millions" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 1999" ;
    :yValue "0.01" ;
    :belongsTo :Chart .

