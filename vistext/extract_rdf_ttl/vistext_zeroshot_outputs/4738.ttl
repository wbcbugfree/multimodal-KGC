@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Average viewers of League of Legends on Twitch worldwide from January 2018 to December 2020 (in 1,000s)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Month" .

:YAxis a :Axis ;
    :title "Number of viewers in thousands" .

