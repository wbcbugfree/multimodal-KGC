@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Fields of study with the most international students in the United States in the academic year 2019/20" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Fields of study" .

:YAxis a :Axis ;
    :title "Number of students" .

:DataPoint1 a :DataPoint ;
    :xValue "Agriculture" ;
    :yValue "13000" ;
    :belongsTo :Chart .

