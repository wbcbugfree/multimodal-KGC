@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Number of confirmed cases and deaths of coronavirus (COVID-19) in Mexico from January 14 to December 14 , 2020" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Deaths" .

:DataPoint1 a :DataPoint ;
    :xValue "January" ;
    :yValue "0" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "February" ;
    :yValue "0" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "March" ;
    :yValue "30" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "April" ;
    :yValue "1850" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "May" ;
    :yValue "9900" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "June" ;
    :yValue "27700" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "July" ;
    :yValue "46600" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "August" ;
    :yValue "64400" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "September" ;
    :yValue "77600" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "October" ;
    :yValue "91500" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "November" ;
    :yValue "105900" ;
    :belongsTo :Chart .

:DataPoint12 a :DataPoint ;
    :xValue "December" ;
    :yValue "114300" ;
    :belongsTo :Chart .
