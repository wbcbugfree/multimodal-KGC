@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Number of members of FC Bayern Munich from 2005/06 to 2017/18 (in 1,000s)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Number of members in thousands" .

:YAxis a :Axis ;
    :title "Year" .

