@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Leading global Fintech corporations in 2016 , by revenue from financial services (in billion U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Leading global Fintech corporations" .

:YAxis a :Axis ;
    :title "Revenue from financial services" .

:DataPoint1 a :DataPoint ;
    :xValue "Accenture" ;
    :yValue "7.9" ;
    :belongsTo :Chart .

