@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Turkey : Development of short-term annual interest rate from 2009 to 2018" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Short-term annual interest rate" .

:DataPoint1 a :DataPoint ;
    :xValue "2009" ;
    :yValue "0.101" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "2010" ;
    :yValue "0.076" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "2011" ;
    :yValue "0.087" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "2012" ;
    :yValue "0.088" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "2013" ;
    :yValue "0.069" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "2014" ;
    :yValue "0.103" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "2015" ;
    :yValue "0.11" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "2016" ;
    :yValue "0.102" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "2017*" ;
    :yValue "0.089" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "2018*" ;
    :yValue "0.083" ;
    :belongsTo :Chart .
