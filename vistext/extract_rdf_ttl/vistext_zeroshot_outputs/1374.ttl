@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Public television viewership in the United States from 1999 to 2013" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Household cume*" .

