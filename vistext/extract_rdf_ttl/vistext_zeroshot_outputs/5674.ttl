@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Market share of the leading acne treatment brands in the United States in 2019" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Market share" .

:YAxis a :Axis ;
    :title "Brand" .

:DataPoint1 a :DataPoint ;
    :xValue "0.034" ;
    :yValue "Aveeno Active Naturals Clear Com..." ;
    :belongsTo :Chart .

