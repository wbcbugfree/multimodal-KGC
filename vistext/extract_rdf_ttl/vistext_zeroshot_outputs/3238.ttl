@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Most common types of dietary changes or restrictions in Poland in 2019" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Share of respondents" .

:YAxis a :Axis ;
    :title "Response" .

:DataPoint1 a :DataPoint ;
    :xValue "0.066" ;
    :yValue "Consuming herbs, herbal teas" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "0.026" ;
    :yValue "Consuming supplements, microel..." ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "0.048" ;
    :yValue "Easily digestable diet" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "0.088" ;
    :yValue "Eating meals regularly" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "0.026" ;
    :yValue "Generally healthier eating" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "0.038" ;
    :yValue "Gluten-free diet" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "0.048" ;
    :yValue "High-protein diet" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "0.1" ;
    :yValue "Increasing intake of fruit and vege..." ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "0.066" ;
    :yValue "Limiting fat intake" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "0.058" ;
    :yValue "Limiting intake of bread, potatoes..." ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "0.058" ;
    :yValue "Limiting meat intake" ;
    :belongsTo :Chart .

:DataPoint12 a :DataPoint ;
    :xValue "0.016" ;
    :yValue "Limiting milk intake" ;
    :belongsTo :Chart .

:DataPoint13 a :DataPoint ;
    :xValue "0.138" ;
    :yValue "Low-calorie diet" ;
    :belongsTo :Chart .

:DataPoint14 a :DataPoint ;
    :xValue "0.188" ;
    :yValue "Low-carb diet" ;
    :belongsTo :Chart .

:DataPoint15 a :DataPoint ;
    :xValue "0.026" ;
    :yValue "Particular way of preparing food" ;
    :belongsTo :Chart .

:DataPoint16 a :DataPoint ;
    :xValue "0.048" ;
    :yValue "Well-balanced diet, planned by die..." ;
