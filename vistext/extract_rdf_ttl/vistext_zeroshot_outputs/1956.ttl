@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Peppermint oil production value in the U.S. from 2000 to 2018 (in 1,000 U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Production value in thousand U.S. dollars" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 1999" ;
    :yValue "74900" ;
    :belongsTo :Chart .

