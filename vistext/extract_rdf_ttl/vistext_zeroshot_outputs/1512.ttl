@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Top 10 most expensive conditions in U.S. hospitals with an expected payer of Medicare in 2017 (in million U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Conditions" .

:YAxis a :Axis ;
    :title "Costs in million U.S. dollars" .

:DataPoint1 a :DataPoint ;
    :xValue "Acute myocardial infarction" ;
    :yValue "7600" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Cardiac dysrhythmias" ;
    :yValue "4500" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "Cerebral infarction" ;
    :yValue "4300" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "Chronic obstructive pulmonary dis..." ;
    :yValue "4700" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "Coronary atherosclerosis and othe..." ;
    :yValue "4800" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Heart failure" ;
    :yValue "8900" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Osteoarthritis" ;
    :yValue "10800" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Respiratory failure; insufficiency; ..." ;
