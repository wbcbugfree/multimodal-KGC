@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Share of respondents who had set up their own social network profile in the United Kingdom (UK) from 2007 to 2019" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "Share of respondents" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2006" ;
    :yValue "0.22" ;
    :belongsTo :Chart .

