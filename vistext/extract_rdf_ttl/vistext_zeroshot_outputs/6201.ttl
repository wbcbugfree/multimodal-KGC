@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Employment rate by age in the United States from 2000 to 2019" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "55 and over" .

:YAxis a :Axis ;
    :title "year" .

:DataPoint1 a :DataPoint ;
    :xValue "0.315" ;
    :yValue "'00" ;
    :belongsTo :Chart .

