@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Number of people affected by the world 's major volcanic eruptions from 1900 to 2016" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "volcanic eruption and date" .

:YAxis a :Axis ;
    :title "Number of victims" .

:DataPoint1 a :DataPoint ;
    :xValue "Volcanic eruption in Comoros..." ;
    :yValue "245000" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Volcanic eruption in Indonesi..." ;
    :yValue "140000" ;
    :belongsTo :Chart .

