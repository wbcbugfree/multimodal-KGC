@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Distribution of iodine demand worldwide in 2016 , by application" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Share of demand" .

:YAxis a :Axis ;
    :title "Response" .

:DataPoint1 a :DataPoint ;
    :xValue "0.08" ;
    :yValue "Animal feed" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "0.04" ;
    :yValue "Biocides" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "0.07" ;
    :yValue "Fluorochemicals" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "0.03" ;
    :yValue "Human nutrition" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "0.07" ;
    :yValue "Iodophors" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "0.12" ;
    :yValue "LCD polarizing film" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "0.04" ;
    :yValue "Nylon" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "0.17" ;
    :yValue "Other" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "0.03" ;
    :yValue "PVPI" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "0.13" ;
    :yValue "Pharmaceuticals" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "0.22" ;
    :yValue "XR contrast media" ;
    :belongsTo :Chart .
