@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Contribution to gross domestic product of Indonesia in 2019 , by industry" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Share of gross domestic product" .

:YAxis a :Axis ;
    :title "Response" .

:DataPoint1 a :DataPoint ;
    :xValue "0.025" ;
    :yValue "Accommodation and food service ..." ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "0.127" ;
    :yValue "Agriculture, forestry and fishing" ;
    :belongsTo :Chart .

