@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Number of fires and acres burned due to wildfires in the United States in 2019 , by state" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Number of acres burned" .

:YAxis a :Axis ;
    :title "State" .

