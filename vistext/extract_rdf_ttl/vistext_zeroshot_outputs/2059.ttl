@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Number of Toyota Hilux registered light goods vehicles in Great Britain between 2000 and 2018" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Number of registered vehicles" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 1998" ;
    :yValue "24000" ;
    :belongsTo :Chart .

