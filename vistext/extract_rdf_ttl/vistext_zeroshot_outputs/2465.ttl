@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Amount of money invested in road transport infrastructure in Denmark from 2004 to 2018 (in million euros)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Millions of euros invested" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2003" ;
    :yValue "920" ;
    :belongsTo :Chart .

