@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "The real and nominal value of the federal\nminimum wage in the United States from 1938\nto 2013 , expressed in July 2013 U.S. dollars" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Month" .

:YAxis a :Axis ;
    :title "Statutory minimum wage (nominal $)" .

