@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Number of cumulative cases of coronavirus (COVID-19) worldwide from January 22 , 2020 to January 5 , 2021 , by day" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Number of cumulative cases" .

:DataPoint1 a :DataPoint ;
    :xValue "January 22 , 2020" ;
    :yValue "555" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "February 1 , 2020" ;
    :yValue "11950" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "March 1 , 2020" ;
    :yValue "88414" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "April 1 , 2020" ;
    :yValue "932605" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "May 1 , 2020" ;
    :yValue "3257597" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "June 1 , 2020" ;
    :yValue "6189560" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "July 1 , 2020" ;
    :yValue "10488122" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "August 1 , 2020" ;
    :yValue "17591977" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "September 1 , 2020" ;
    :yValue "25484767" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "October 1 , 2020" ;
    :yValue "34023231" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "November 1 , 2020" ;
    :yValue "46156540" ;
    :belongsTo :Chart .

:DataPoint12 a :DataPoint ;
    :xValue "December 1 , 2020" ;
    :yValue "63489115" ;
    :belongsTo :Chart .

:DataPoint13 a :DataPoint ;
    :xValue "January 1 , 2021" ;
    :yValue "83832334" ;
    :belongsTo :Chart .

:DataPoint14 a :DataPoint ;
    :xValue "January 5 , 2021" ;
    :yValue "86407450" ;
    :belongsTo :Chart .
