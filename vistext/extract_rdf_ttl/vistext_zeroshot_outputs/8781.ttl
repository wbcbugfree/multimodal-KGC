@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Number of international visitor arrivals in Finland from January to July 2020 , by country of origin" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Country" .

:YAxis a :Axis ;
    :title "March*" .

:DataPoint1 a :DataPoint ;
    :xValue "China" ;
    :yValue "1159" ;
    :belongsTo :Chart .

