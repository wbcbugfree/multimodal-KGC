@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Total value of international U.S. exports of goods and services from 2000 to 2019 (in trillion U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Export value in trillion U.S. dollars" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 1999" ;
    :yValue "1.08" ;
    :belongsTo :Chart .

