@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Public sector expenditure on water supply in the United Kingdom (UK) from 2009/10 to 2019/20 (in million GBP)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Expenditure in million GBP" .

:YAxis a :Axis ;
    :title "Year" .

:DataPoint1 a :DataPoint ;
    :xValue "1039" ;
    :yValue "2009/10" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "729" ;
    :yValue "2010/11" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "785" ;
    :yValue "2011/12" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "765" ;
    :yValue "2012/13" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "624" ;
    :yValue "2013/14" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "571" ;
    :yValue "2014/15" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "581" ;
    :yValue "2015/16" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "743" ;
    :yValue "2016/17" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "787" ;
    :yValue "2017/18" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "790" ;
    :yValue "2018/19" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "796" ;
    :yValue "2019/20" ;
    :belongsTo :Chart .
