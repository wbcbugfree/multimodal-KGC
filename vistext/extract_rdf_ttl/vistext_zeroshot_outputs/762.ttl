@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Pear production in the United States from 2000 to 2019 (in tons)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Production in tons" .

