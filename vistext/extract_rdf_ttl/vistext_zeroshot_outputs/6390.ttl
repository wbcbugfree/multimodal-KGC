@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Total number of suicides in Finland from 2007 to 2018 , by age\n40-64 years" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2006" ;
    :yValue "526" ;
    :belongsTo :Chart .

