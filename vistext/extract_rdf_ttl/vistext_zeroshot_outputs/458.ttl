@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Top ten countries of birth for foreign-born people in Canada in 2016" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Number of people residing in Canada" .

:YAxis a :Axis ;
    :title "Country" .

:DataPoint1 a :DataPoint ;
    :xValue "650000" ;
    :yValue "China" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "210000" ;
    :yValue "Hong Kong" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "670000" ;
    :yValue "India" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "150000" ;
    :yValue "Iran" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "235000" ;
    :yValue "Italy" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "200000" ;
    :yValue "Pakistan" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "590000" ;
    :yValue "Philippines" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "500000" ;
    :yValue "United Kingdom" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "250000" ;
    :yValue "United States" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "165000" ;
    :yValue "Viet Nam" ;
    :belongsTo :Chart .
