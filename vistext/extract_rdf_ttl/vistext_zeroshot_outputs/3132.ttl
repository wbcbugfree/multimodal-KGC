@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Export volume of cut flowers from Kenya between January 2019 and October 2020 (in 1,000 metric tons)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Month" .

:YAxis a :Axis ;
    :title "Export volume in thousand metric tons" .

