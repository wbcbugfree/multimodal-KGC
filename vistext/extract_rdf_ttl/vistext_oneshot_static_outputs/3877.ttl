@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Rate of prevalent cases of end-stage renal disease (ESRD) in the U.S. from 1980 to 2016 (per million population)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Number of cases per million population" .

