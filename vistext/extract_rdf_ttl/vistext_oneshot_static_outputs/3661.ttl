@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Number of days lost through sickness absence in the United Kingdom (UK) from 2003 to 2013 (in millions)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Days lost in millions" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2002" ;
    :yValue "178" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Dec 31, 2003" ;
    :yValue "168" ;
    :belongsTo :Chart .

