@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Kenya : Urbanization from 2009 to 2019 Share of urban population in total population" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
