@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Number of social network users worldwide in 2020 , by region (in millions)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Number of active social media users in millions" .

:YAxis a :Axis ;
    :title "geographic region" .

