@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Population of the Memphis metro area in the United States from 2010 to 2019" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Number of residents" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2009" ;
    :yValue "1316513" ;
    :belongsTo :Chart .

