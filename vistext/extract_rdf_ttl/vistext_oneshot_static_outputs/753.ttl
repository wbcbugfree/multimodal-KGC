@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Total amount of investment of private equity companies in France from 2007 to 2016 (in million euros)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Total investment in million euros" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2006" ;
    :yValue "14400" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Dec 31, 2007" ;
    :yValue "11900" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "Dec 31, 2008" ;
    :yValue "4200" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "Dec 31, 2009" ;
    :yValue "7600" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "Dec 31, 2010" ;
    :yValue "11000" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Dec 31, 2011" ;
    :yValue "6900" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Dec 31, 2012" ;
    :yValue "8900" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Dec 31, 2013" ;
    :yValue "12300" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "Dec 31, 2014" ;
    :yValue "14400" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "Dec 31, 2015" ;
    :yValue "14900" ;
    :belongsTo :Chart .
