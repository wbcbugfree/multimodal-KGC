@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Average power plant operating expenses for major investor-owned electric utilities in the U.S. from 1998 to 2019 (in mills per kilowatt hour)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Hydroelectric*" .

