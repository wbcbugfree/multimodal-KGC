@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Total number of tribal casinos in the U.S. from 2005 to 2019" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Number of tribal casinos" .

