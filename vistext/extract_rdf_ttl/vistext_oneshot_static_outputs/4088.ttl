@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Cut-off point for private wealth value of the richest one percent of selected European countries population as of 2014 (in euros)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Wealth value in euros" .

:YAxis a :Axis ;
    :title "Country" .

