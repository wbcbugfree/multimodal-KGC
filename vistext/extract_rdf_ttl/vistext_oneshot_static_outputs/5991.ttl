@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Number of sexual violence cases reported to the authorities in Italy in 2018 , by region" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Number of reported cases" .

:YAxis a :Axis ;
    :title "region of Italy" .

