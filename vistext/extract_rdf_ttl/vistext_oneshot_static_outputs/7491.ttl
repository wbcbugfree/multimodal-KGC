@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Rate of homicides in Canada in 2019 , by Aboriginal identity and province or territory (per 100,000 population)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "province of Canada" .

:YAxis a :Axis ;
    :title "Aboriginal" .

:DataPoint1 a :DataPoint ;
    :xValue "Alberta" ;
    :yValue "11.8" ;
    :belongsTo :Chart .

