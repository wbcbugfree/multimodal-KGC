@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Cancer incidence rates among men in selected countries worldwide between 2003 and 2007 (per 100,000 population)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Incidence rate per 100,000 population" .

:YAxis a :Axis ;
    :title "Country" .

:DataPoint1 a :DataPoint ;
    :xValue "376.5" ;
    :yValue "Australia" ;
    :belongsTo :Chart .

