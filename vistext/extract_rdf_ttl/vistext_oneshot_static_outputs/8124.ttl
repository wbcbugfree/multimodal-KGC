@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Most popular products purchased in online stores during the coronavirus (COVID-19) epidemic in Poland as a monthly change in the number of BLIK transactions between February and April 2020 , by e-commerce category April to February 2020" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "e-commerce category" .

:YAxis a :Axis .

