@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Monthly sales of cookies , confectionery and snack foods at large retailers in Canada from January 2015 to April 2019 (in million Canadian dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "2016" .

:YAxis a :Axis ;
    :title "Month" .

:DataPoint1 a :DataPoint ;
    :xValue "397" ;
    :yValue "Apr" ;
    :belongsTo :Chart .

