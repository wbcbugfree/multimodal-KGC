@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Number of pupils attending schools in Northern Ireland from 2010/11 to 2019/20" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Secondary" .

:YAxis a :Axis ;
    :title "Year" .

:DataPoint1 a :DataPoint ;
    :xValue "147151" ;
    :yValue "2010/11" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "146145" ;
    :yValue "2011/12" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "145103" ;
    :yValue "2012/13" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "143313" ;
    :yValue "2013/14" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "141407" ;
    :yValue "2014/15" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "140303" ;
    :yValue "2015/16" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "139680" ;
    :yValue "2016/17" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "139598" ;
    :yValue "2017/18" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "141424" ;
    :yValue "2018/19" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "144320" ;
    :yValue "2019/20" ;
    :belongsTo :Chart .
