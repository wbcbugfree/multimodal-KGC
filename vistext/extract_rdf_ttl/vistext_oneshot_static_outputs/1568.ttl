@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Gross domestic expenditure on research and development (GERD) as a percentage of GDP in Portugal from 2000 to 2017" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "GERD as percentage of GDP" .

:YAxis a :Axis ;
    :title "Year" .

:DataPoint1 a :DataPoint ;
    :xValue "0.0071" ;
    :yValue "2000*" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "0.0075" ;
    :yValue "2001" ;
    :belongsTo :Chart .

