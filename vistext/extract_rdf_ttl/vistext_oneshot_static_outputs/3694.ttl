    :xValue "Huddersfield" ;
    :yValue "275" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Newport" ;
    :yValue "214" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Romford" ;
    :yValue "233" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Southport" ;
    :yValue "228" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "Sunderland" ;
