@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Leading value retail centres in the United Kingdom (UK) in 2013 , ranked by number of stores" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Leading value retail centres" .

:YAxis a :Axis ;
    :title "Number of stores" .

:DataPoint1 a :DataPoint ;
    :xValue "Blackpool" ;
    :yValue "319" ;
    :belongsTo :Chart .

