@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Total number of public primary schools in France from 2005 to 2018" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Number of public schools" .

:YAxis a :Axis ;
    :title "Year" .

:DataPoint1 a :DataPoint ;
    :xValue "50560" ;
    :yValue "2005" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "49825" ;
    :yValue "2007" ;
    :belongsTo :Chart .

