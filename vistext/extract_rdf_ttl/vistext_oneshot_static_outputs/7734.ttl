@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Migration flow of foreign nationals in Spain from 2010 to 2019" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Inflow" .

:DataPoint1 a :DataPoint ;
    :xValue "2010" ;
    :yValue "310931" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "2011" ;
    :yValue "317061" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "2012" ;
    :yValue "239173" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "2013" ;
    :yValue "214082" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "2014" ;
    :yValue "232012" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "2015" ;
    :yValue "265160" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "2016" ;
    :yValue "331313" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "2017" ;
    :yValue "416211" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "2018" ;
    :yValue "531987" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "2019*" ;
    :yValue "289332" ;
    :belongsTo :Chart .
