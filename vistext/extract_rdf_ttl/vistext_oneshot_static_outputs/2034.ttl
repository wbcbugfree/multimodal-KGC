@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Number of students graduated from postsecondary institutions in Canada in 2017 , by province" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Province" .

:YAxis a :Axis ;
    :title "Number of students" .

:DataPoint1 a :DataPoint ;
    :xValue "Alberta" ;
    :yValue "55248" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "British Columbia" ;
    :yValue "82815" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "Manitoba" ;
    :yValue "20445" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "New Brunswick" ;
    :yValue "12684" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "Newfoundland and Labrador" ;
    :yValue "9822" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Nova Scotia" ;
    :yValue "23232" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Ontario" ;
    :yValue "237036" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Prince Edward Island" ;
    :yValue "3246" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "Quebec" ;
    :yValue "176916" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "Saskatchewan" ;
    :yValue "18312" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "Territories" ;
    :yValue "1479" ;
    :belongsTo :Chart .
