@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "U.S. natural gas consumption between 2005 and 2019 , by sector (in billion cubic feet)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Transportation" .

:YAxis a :Axis ;
    :title "Year" .

:DataPoint1 a :DataPoint ;
    :xValue "601" ;
    :yValue "2005" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "699" ;
    :yValue "2010" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "715" ;
    :yValue "2011" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "760" ;
    :yValue "2012" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "861" ;
    :yValue "2013" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "733" ;
    :yValue "2014" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "715" ;
    :yValue "2015" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "726" ;
    :yValue "2016" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "772" ;
    :yValue "2017" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "914" ;
    :yValue "2018" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "944" ;
    :yValue "2019***" ;
    :belongsTo :Chart .
