@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Leading medical device exporting countries worldwide in 2015 (in million U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Country" .

:YAxis a :Axis ;
    :title "Exports in million U.S. dollars" .

