@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Monthly number of long-term unemployed persons in the U.S. from November 2019 to November 2020 (in millions , adjusted)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Number in millions" .

:YAxis a :Axis ;
    :title "Month" .

:DataPoint1 a :DataPoint ;
    :xValue "0.94" ;
    :yValue "Apr '20" ;
    :belongsTo :Chart .

