@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Highest paid athletes by earnings from salary and endorsements worldwide in 2019/20 (in million U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Highest paid athletes" .

:YAxis a :Axis ;
    :title "Salary/Winnings" .

:DataPoint1 a :DataPoint ;
    :xValue "Carson Wentz (football)" ;
    :yValue "55.1" ;
    :belongsTo :Chart .

