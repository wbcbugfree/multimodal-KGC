@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Position of the Paraguayan national men 's soccer team in the FIFA World Ranking from 2009 to 2020" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "FIFA ranking position" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2008" ;
    :yValue "29" ;
    :belongsTo :Chart .

