@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Distribution of population in Italy in 2019 , by age group" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "Share of population" .

:DataPoint1 a :DataPoint ;
    :xValue "0 to 2 years" ;
    :yValue "0.022" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "12 to 17 years" ;
    :yValue "0.052" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "18 to 24 years" ;
    :yValue "0.065" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "25 to 34 years" ;
    :yValue "0.104" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "3 to 5 years" ;
    :yValue "0.024" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "35 to 44 years" ;
    :yValue "0.127" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "45 to 54 years" ;
    :yValue "0.158" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "55 to 64 years" ;
    :yValue "0.138" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "6 to 11 years" ;
    :yValue "0.048" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "65 to 74 years" ;
    :yValue "0.108" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "75 years and more" ;
    :yValue "0.113" ;
    :belongsTo :Chart .
