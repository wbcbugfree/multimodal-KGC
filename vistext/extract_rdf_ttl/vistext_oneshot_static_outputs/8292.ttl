@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "How likely do you think you would be to use or continue using each of the following methods of weight management in the next year ?" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Somewhat likely" .

:YAxis a :Axis ;
    :title "Response" .

:DataPoint1 a :DataPoint ;
    :xValue "0.41" ;
    :yValue "Being more active throughout the ..." ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "0.39" ;
    :yValue "Eating more slowly and attentively" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "0.3" ;
    :yValue "Eating out less often" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "0.38" ;
    :yValue "Eating smaller portions of what yo..." ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "0.37" ;
    :yValue "Eating smaller, more frequent me..." ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "0.39" ;
    :yValue "Eating snacks less frequently" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "0.36" ;
    :yValue "Limit the number of calories in th..." ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "0.38" ;
    :yValue "Limiting specific types of food or f..." ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "0.36" ;
    :yValue "Spend more time exercising" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "0.4" ;
    :yValue "Tracking and increasing the amou..." ;
    :belongsTo :Chart .
