@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Life expectancy (from birth) in New Zealand , from 1870 to 2020" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Life expectancy in years" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 1869" ;
    :yValue "34.5" ;
    :belongsTo :Chart .

