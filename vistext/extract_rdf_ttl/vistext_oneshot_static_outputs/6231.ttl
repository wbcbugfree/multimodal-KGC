@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Total U.S. red meat imports and exports from 2001 to 2018 (in million pounds)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Exports" .

