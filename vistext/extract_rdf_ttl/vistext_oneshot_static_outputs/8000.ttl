@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Value of U.S. imports and exports of goods from 2000 to 2011 (in trillion U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Exports" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 1998" ;
    :yValue "0.78" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Dec 31, 1999" ;
    :yValue "0.74" ;
    :belongsTo :Chart .

