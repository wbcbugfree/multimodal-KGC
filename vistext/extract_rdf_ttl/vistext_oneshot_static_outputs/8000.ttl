    :yValue "0.83" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Dec 31, 2003" ;
    :yValue "0.93" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Dec 31, 2004" ;
    :yValue "1.05" ;
    :belongsTo :Chart .

