@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Zinc production value in Canada in 2019 , by province (in 1,000 Canadian dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Production in 1,000 Canadian dollars" .

:YAxis a :Axis ;
    :title "province of Canada" .

:DataPoint1 a :DataPoint ;
    :xValue "28491" ;
    :yValue "British Columbia" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "384105" ;
    :yValue "Manitoba" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "151327" ;
    :yValue "New Brunswick" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "231108" ;
    :yValue "Ontario" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "248349" ;
    :yValue "Quebec" ;
    :belongsTo :Chart .
