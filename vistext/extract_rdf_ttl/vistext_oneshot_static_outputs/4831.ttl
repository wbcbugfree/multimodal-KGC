@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Monthly youth (16 - 24) unemployment rate in the United States from November 2019 to November 2020 (seasonally adjusted)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Unemployment rate" .

:YAxis a :Axis ;
    :title "Month" .

:DataPoint1 a :DataPoint ;
    :xValue "0.274" ;
    :yValue "Apr '20" ;
    :belongsTo :Chart .

