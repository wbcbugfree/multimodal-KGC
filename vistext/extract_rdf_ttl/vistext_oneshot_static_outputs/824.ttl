@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Total revenue of PT Telkom Indonesia Tbk from 2009 to 2019 (in trillion Indonesian rupiah)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Total revenue in trillion Indonesian rupiah" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2008" ;
    :yValue "68.4" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Dec 31, 2009" ;
    :yValue "68.7" ;
    :belongsTo :Chart .

