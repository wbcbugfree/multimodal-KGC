    :yValue "26000" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Dec 31, 2012" ;
    :yValue "31100" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Dec 31, 2013" ;
    :yValue "27300" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
