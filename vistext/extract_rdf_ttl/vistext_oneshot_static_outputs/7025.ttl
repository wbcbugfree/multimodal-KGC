@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Waste generated by pharmaceutical company Roche from 2007 to 2019 (in metric tons)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Chemical waste" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2006" ;
    :yValue "38200" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Dec 31, 2007" ;
    :yValue "31500" ;
    :belongsTo :Chart .

