@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Annual amount of cement imported into Great Britain from 2001 to 2018 , by importer (in 1,000 metric tons)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "by manufacturers" .

:YAxis a :Axis ;
    :title "Year" .

