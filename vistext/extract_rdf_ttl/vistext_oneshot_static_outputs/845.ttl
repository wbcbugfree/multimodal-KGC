@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Leading countries in primary energy consumption worldwide in 2019 (in exajoules)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Country" .

:YAxis a :Axis ;
    :title "Consumption in exajoules" .

