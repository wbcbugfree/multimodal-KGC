    :yValue "2011/12" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "126.3" ;
    :yValue "2012/13" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "163" ;
    :yValue "2013/14" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "179.6" ;
    :yValue "2014/15" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "205.1" ;
    :yValue "2015/16" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
