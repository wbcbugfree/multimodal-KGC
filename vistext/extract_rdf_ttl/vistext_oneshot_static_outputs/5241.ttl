@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Most successful music tours worldwide in 2020 , based on gross revenue (in million U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Gross revenue in million U.S. dollars" .

:YAxis a :Axis ;
    :title "Music tour" .

