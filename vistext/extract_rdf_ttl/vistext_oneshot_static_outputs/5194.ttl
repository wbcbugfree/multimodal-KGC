@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Number of individuals with asthma in Great Britain in 2015 , by region" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "region in UK" .

:YAxis a :Axis ;
    :title "Number of individuals" .

:DataPoint1 a :DataPoint ;
    :xValue "East Midlands" ;
    :yValue "390000" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "East of England" ;
    :yValue "565000" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "London" ;
    :yValue "585000" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "North East" ;
    :yValue "295000" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "North West" ;
    :yValue "785000" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Scotland" ;
    :yValue "555000" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "South East" ;
    :yValue "715000" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "South West" ;
    :yValue "535000" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "Wales" ;
    :yValue "345000" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "West Midlands" ;
    :yValue "460000" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "Yorkshire and the Humber" ;
    :yValue "540000" ;
    :belongsTo :Chart .
