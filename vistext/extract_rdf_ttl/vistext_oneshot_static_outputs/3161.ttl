@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Number of enterprises in the manufacture of plastics products industry in Spain from 2008 to 2017" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Number of enterprises" .

:YAxis a :Axis ;
    :title "Year" .

:DataPoint1 a :DataPoint ;
    :xValue "4388" ;
    :yValue "2008" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "4281" ;
    :yValue "2009" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "4270" ;
    :yValue "2010" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "4122" ;
    :yValue "2011" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "3959" ;
    :yValue "2012" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "3630" ;
    :yValue "2013" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "3544" ;
    :yValue "2014" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "3694" ;
    :yValue "2015" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "3617" ;
    :yValue "2016" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "3595" ;
    :yValue "2017*" ;
    :belongsTo :Chart .
