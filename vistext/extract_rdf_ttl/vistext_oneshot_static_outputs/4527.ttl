@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Median hourly earnings for full-time employees in the United Kingdom from 1997 to 2020 (in GBP)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Hourly pay in GBP" .

