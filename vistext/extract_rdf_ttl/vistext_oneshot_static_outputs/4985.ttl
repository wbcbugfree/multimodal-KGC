@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Value of fertilizers imported into India from financial year 2011 to 2020 (in billion Indian rupees)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Import value in billion Indian rupees" .

:YAxis a :Axis ;
    :title "year" .

:DataPoint1 a :DataPoint ;
    :xValue "314.5" ;
    :yValue "FY 2011" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "533.2" ;
    :yValue "FY 2012" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "476.1" ;
    :yValue "FY 2013" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "381.8" ;
    :yValue "FY 2014" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "452.6" ;
    :yValue "FY 2015" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "524.2" ;
    :yValue "FY 2016" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "337.2" ;
    :yValue "FY 2017" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "346.7" ;
    :yValue "FY 2018" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "520.5" ;
    :yValue "FY 2019" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "527.3" ;
    :yValue "FY 2020" ;
    :belongsTo :Chart .
