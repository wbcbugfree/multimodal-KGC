@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Delta Air Lines Inc. 's available seat miles from FY 2008 to FY 2019 (in millions)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Available seat miles (in millions)" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2007" ;
    :yValue "168926" ;
    :belongsTo :Chart .

