@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Number of arrivals in tourist accommodation in Hungary from 2006 to 2017 (in millions)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Number of arrivals in millions" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2005" ;
    :yValue "7.2" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Dec 31, 2006" ;
    :yValue "7.5" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "Dec 31, 2007" ;
    :yValue "7.7" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "Dec 31, 2008" ;
    :yValue "7.2" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "Dec 31, 2009" ;
    :yValue "7.3" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Dec 31, 2010" ;
    :yValue "7.6" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Dec 31, 2011" ;
    :yValue "8.8" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Dec 31, 2012" ;
    :yValue "9.3" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "Dec 31, 2013" ;
    :yValue "10.1" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "Dec 31, 2014" ;
    :yValue "10.9" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "Dec 31, 2015" ;
    :yValue "11.6" ;
    :belongsTo :Chart .

:DataPoint12 a :DataPoint ;
    :xValue "Dec 31, 2016" ;
    :yValue "12.5" ;
    :belongsTo :Chart .
