@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Revenue of the Walt Disney Company from 1st quarter 2018 to 4th quarter 2020 , by segment (in million U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Studio entertainment" .

:YAxis a :Axis ;
    :title "Quarter" .

:DataPoint1 a :DataPoint ;
    :xValue "2501" ;
    :yValue "Q1 2018" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "1823" ;
    :yValue "Q1 2019" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "3764" ;
    :yValue "Q1 2020" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "2451" ;
    :yValue "Q2 2018" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "2134" ;
    :yValue "Q2 2019*" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "2539" ;
    :yValue "Q2 2020" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "2873" ;
    :yValue "Q3 2018" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "3838" ;
    :yValue "Q3 2019" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "1736" ;
    :yValue "Q3 2020" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "3293" ;
    :yValue "Q4 2019" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "1602" ;
    :yValue "Q4 2020" ;
    :belongsTo :Chart .
