@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Clinical trial costs by selected cost component and clinical phase as of 2014 (in U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Phase 1" .

:YAxis a :Axis ;
    :title "Cost component" .

:DataPoint1 a :DataPoint ;
    :xValue "237500" ;
    :yValue "Administrative Staff Costs" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "252500" ;
    :yValue "Central Lab Costs" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "474500" ;
    :yValue "Clinical Procedure Total" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "10500" ;
    :yValue "Cost Per IRB Approvals" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "2500" ;
    :yValue "Cost of IRB Amendments" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "48500" ;
    :yValue "Data Management Costs" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "36000" ;
    :yValue "Patient Recruitment Costs" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "6500" ;
    :yValue "Patient Retention Costs" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "108000" ;
    :yValue "Physician Costs" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "178000" ;
    :yValue "RN/CRA Costs" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "325000" ;
    :yValue "SDV Costs" ;
    :belongsTo :Chart .

:DataPoint12 a :DataPoint ;
    :xValue "200000" ;
    :yValue "Site Monitoring Costs" ;
    :belongsTo :Chart .

:DataPoint13 a :DataPoint ;
    :xValue "50000" ;
    :yValue "Site Recruitment Costs" ;
    :belongsTo :Chart .

:DataPoint14 a :DataPoint ;
    :xValue "194000" ;
    :yValue "Site Retention Costs" ;
    :belongsTo :Chart .
