@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Market share of the leading contact lens retailers on JD.com in China as of July 2017 , by brand" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Market share" .

:YAxis a :Axis ;
    :title "leading contact lens retailers" .

:DataPoint1 a :DataPoint ;
    :xValue "0.02" ;
    :yValue "Alcon" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "0.43" ;
    :yValue "Bausch & Lomb" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "0.02" ;
    :yValue "CooperVision" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "0.06" ;
    :yValue "Horien" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "0.25" ;
    :yValue "Hydron" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "0.01" ;
    :yValue "Jie Da" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "0.14" ;
    :yValue "Johnson" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "0.01" ;
    :yValue "NEO" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "0.006" ;
    :yValue "Seed" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "0.01" ;
    :yValue "Wei Kang" ;
    :belongsTo :Chart .
