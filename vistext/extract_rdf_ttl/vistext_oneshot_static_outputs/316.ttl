@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Convenience store sales of salty snacks in the United States in 2019 , by type (in million U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Industry total sales in million U.S. dollars" .

:YAxis a :Axis ;
    :title "salty snacks" .

:DataPoint1 a :DataPoint ;
    :xValue "811" ;
    :yValue "Cheese snacks" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "398" ;
    :yValue "Corn snacks" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "439" ;
    :yValue "Crackers" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "871" ;
    :yValue "Other salty snacks" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "240" ;
    :yValue "Popcorn (ready-to-eat)" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "219" ;
    :yValue "Pork rinds" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "1823" ;
    :yValue "Potato chips" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "255" ;
    :yValue "Pretzels" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "631" ;
    :yValue "Snack nuts" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "293" ;
    :yValue "Sunflower/pumpkin seeds" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "1205" ;
    :yValue "Tortilla/corn chips" ;
    :belongsTo :Chart .
