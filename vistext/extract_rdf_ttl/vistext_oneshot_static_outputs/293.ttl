@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Most popular domestic travel destinations for United States travelers , according to travel agents in 2016" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "Share of respondents" .

:DataPoint1 a :DataPoint ;
    :xValue "Chicago, IL" ;
    :yValue "0.14" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Cruise - Alaska" ;
    :yValue "0.35" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "Honolulu, HI" ;
    :yValue "0.22" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "Las Vegas, NV" ;
    :yValue "0.29" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "Los Angeles, CA" ;
    :yValue "0.16" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Maui, HI" ;
    :yValue "0.36" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Miami / Miami Beach, FL" ;
    :yValue "0.14" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "New York City, NY" ;
    :yValue "0.31" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "Orlando, FL" ;
    :yValue "0.36" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "San Francisco, CA" ;
    :yValue "0.15" ;
    :belongsTo :Chart .
