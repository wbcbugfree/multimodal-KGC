@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Cumulative solar photovoltaic capacity globally as of 2019 , by select country (in gigawatts)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Cumulative capacity in gigawatts" .

:YAxis a :Axis ;
    :title "Country" .

:DataPoint1 a :DataPoint ;
    :xValue "14.6" ;
    :yValue "Australia" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "204.7" ;
    :yValue "China" ;
    :belongsTo :Chart .

