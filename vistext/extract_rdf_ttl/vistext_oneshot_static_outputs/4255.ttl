    :xValue "42.8" ;
    :yValue "India" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "20.9" ;
    :yValue "Italy" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "63.2" ;
    :yValue "Japan" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "11.2" ;
    :yValue "Republic of Korea" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "9.2" ;
    :yValue "Spain" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
