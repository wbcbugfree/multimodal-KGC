@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Millennials : Which of the following words or phrases describe your generation ?" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Yes, describes my generation" .

:YAxis a :Axis ;
    :title "Response" .

:DataPoint1 a :DataPoint ;
    :xValue "0.29" ;
    :yValue "Compassionate" ;
    :belongsTo :Chart .

