    :xValue "11390" ;
    :yValue "2013/14" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "11475" ;
    :yValue "2014/15" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "11647" ;
    :yValue "2015/16" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "11757" ;
    :yValue "2016/17" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
