@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Number of Toyota cars sold in France from 2009 to 2018" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Units sold" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2008" ;
    :yValue "88319" ;
    :belongsTo :Chart .

