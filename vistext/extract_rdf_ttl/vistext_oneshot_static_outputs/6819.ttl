@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Generation of selected materials in the U.S. municipal waste stream between 1960 and 2018 (in 1,000 tons)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Textiles" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 1959" ;
    :yValue "1760" ;
    :belongsTo :Chart .

