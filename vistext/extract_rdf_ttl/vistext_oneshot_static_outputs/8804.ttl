@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Average retail price for bananas in Canada from January 2015 to June 2020 (in Canadian dollars per kilogram)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "2020" .

:YAxis a :Axis ;
    :title "Month" .

:DataPoint1 a :DataPoint ;
    :xValue "1.54" ;
    :yValue "Apr" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "1.55" ;
    :yValue "Feb" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "1.54" ;
    :yValue "Jan" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "1.56" ;
    :yValue "Jun" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "1.54" ;
    :yValue "Mar" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "1.56" ;
    :yValue "May" ;
    :belongsTo :Chart .
