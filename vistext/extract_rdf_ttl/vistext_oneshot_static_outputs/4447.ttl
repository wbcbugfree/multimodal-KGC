@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Child mortality rate (under five years old) in the United States , from 1800 to 2020" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Deaths per 1,000 live births" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 1799" ;
    :yValue "463" ;
    :belongsTo :Chart .

