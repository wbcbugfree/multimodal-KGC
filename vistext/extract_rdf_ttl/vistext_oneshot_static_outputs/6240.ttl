@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Total U.S. domestic use of corn from 2001 to 2019 (in million bushels)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Feed and residual" .

