@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Leading Italian fashion companies in 2018 , by turnover (in 1,000 euros)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Turnover in thousand euros" .

:YAxis a :Axis ;
    :title "fashion company" .

:DataPoint1 a :DataPoint ;
    :xValue "840,000" ;
    :yValue "Benetton Group*" ;
    :belongsTo :Chart .

