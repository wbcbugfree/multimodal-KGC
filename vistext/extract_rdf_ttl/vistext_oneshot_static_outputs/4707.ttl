@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Number of average available hospital beds in Northern Ireland from 2009 to 2020" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Number of average available hospital beds" .

:DataPoint1 a :DataPoint ;
    :xValue "2009/10" ;
    :yValue "6943" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "2010/11" ;
    :yValue "6418" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "2011/12" ;
    :yValue "6155" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "2012/13" ;
    :yValue "6003" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "2013/14" ;
    :yValue "5861" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "2014/15" ;
    :yValue "5761" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "2015/16" ;
    :yValue "5627" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "2016/17" ;
    :yValue "5644" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "2017/18" ;
    :yValue "5624" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "2018/19" ;
    :yValue "5571" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "2019/20" ;
    :yValue "5519" ;
    :belongsTo :Chart .
