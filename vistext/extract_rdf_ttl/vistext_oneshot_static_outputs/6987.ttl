:DataPoint12 a :DataPoint ;
    :xValue "0.34" ;
    :yValue "You prefer to spend more time d..." ;
    :belongsTo :Chart .

:DataPoint13 a :DataPoint ;
    :xValue "0.26" ;
    :yValue "You read other things than book..." ;
