@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "For which reasons are n't you reading more books at the moment ?" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Yes, somewhat" .

:YAxis a :Axis ;
    :title "Response" .

:DataPoint1 a :DataPoint ;
    :xValue "0.2" ;
    :yValue "Books are too expensive" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "0.07" ;
    :yValue "The people around you do not r..." ;
    :belongsTo :Chart .

