@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Refinery gold production in the United States from 2008 to 2019 (in metric tons)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis .

:DataPoint1 a :DataPoint ;
    :xValue "2008" ;
    :yValue "169" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "2009" ;
    :yValue "170" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "2010" ;
    :yValue "176" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "2011" ;
    :yValue "220" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "2012" ;
    :yValue "222" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "2013" ;
    :yValue "224" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "2014" ;
    :yValue "253" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "2015" ;
    :yValue "245" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "2016" ;
    :yValue "242" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "2017" ;
    :yValue "208" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "2018" ;
    :yValue "205" ;
    :belongsTo :Chart .

:DataPoint12 a :DataPoint ;
    :xValue "2019*" ;
    :yValue "201" ;
    :belongsTo :Chart .
