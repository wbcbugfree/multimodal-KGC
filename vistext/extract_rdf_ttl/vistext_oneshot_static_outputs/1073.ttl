@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "What keeps you from joining a health club now ?" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Percentage of respondents" .

:YAxis a :Axis ;
    :title "Response" .

:DataPoint1 a :DataPoint ;
    :xValue "0.03" ;
    :yValue "I am not sure there is someone th..." ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "0.08" ;
    :yValue "I am too out of shape to even thin..." ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "0.18" ;
    :yValue "I do not exercise" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "0.09" ;
    :yValue "I don't know what I would do there" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "0.27" ;
    :yValue "I exercise somewhere else for free" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "0.09" ;
    :yValue "I have an injury / surgery / other c..." ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "0.03" ;
    :yValue "I might hurt myself" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "0.13" ;
    :yValue "I participate in another type of ex..." ;
