    :belongsTo :Chart .

:DataPoint12 a :DataPoint ;
    :xValue "0.09" ;
    :yValue "Nobody I know goes to a health club" ;
    :belongsTo :Chart .

:DataPoint13 a :DataPoint ;
    :xValue "0.12" ;
    :yValue "There is no health club located clo..." ;
    :belongsTo :Chart .

:DataPoint14 a :DataPoint ;
    :xValue "0.54" ;
    :yValue "Too expensive / cannot afford it" ;
