:DataPoint9 a :DataPoint ;
    :xValue "0.17" ;
    :yValue "I would feel out of place" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "0.1" ;
    :yValue "It's too crowded" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "0.18" ;
