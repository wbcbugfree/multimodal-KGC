@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Total opium poppy field area destroyed in Thailand from 1995 to 2013 (in hectares)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Area in hectares" .

