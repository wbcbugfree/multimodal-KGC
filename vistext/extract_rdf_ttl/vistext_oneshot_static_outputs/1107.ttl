@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Number of fatalities in road traffic accidents in Finland in 2019 , by region" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Number of fatalities" .

:YAxis a :Axis ;
    :title "region of Finland" .

:DataPoint1 a :DataPoint ;
    :xValue "15" ;
    :yValue "Central Finland" ;
    :belongsTo :Chart .

