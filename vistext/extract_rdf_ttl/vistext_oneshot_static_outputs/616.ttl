@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Oil production in Russia from 1998 to 2019 (in million metric tons)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Oil production in million metric tons" .

