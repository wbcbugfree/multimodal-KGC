@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Number of movie tickets sold in the United States and Canada from 2001 to 2018 (in millions)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Number of tickets sold in millions" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2000" ;
    :yValue "1490" ;
    :belongsTo :Chart .

