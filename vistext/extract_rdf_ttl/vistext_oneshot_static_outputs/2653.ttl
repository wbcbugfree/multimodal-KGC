@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Total number of employees in the crude petroleum and natural gas extraction sector in Germany from 2008 to 2018" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Number of employees" .

:YAxis a :Axis ;
    :title "Year" .

:DataPoint1 a :DataPoint ;
    :xValue "3482" ;
    :yValue "2008" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "3626" ;
    :yValue "2009" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "3677" ;
    :yValue "2010" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "3677" ;
    :yValue "2011" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "3759" ;
    :yValue "2012" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "3687" ;
    :yValue "2013" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "3893" ;
    :yValue "2014" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "3831" ;
    :yValue "2015" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "3615" ;
    :yValue "2016" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "3461" ;
    :yValue "2017" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "4858" ;
    :yValue "2018*" ;
    :belongsTo :Chart .
