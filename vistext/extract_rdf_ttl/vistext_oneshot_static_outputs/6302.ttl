@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Nike 's North American revenue from 2009 to 2020 , by segment (in million U.S. dollars) Apparel" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis .

