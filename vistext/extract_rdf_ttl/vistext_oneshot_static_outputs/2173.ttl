@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Leading 10 U.S. states based on number of laying hens in 2019 (in 1,000 heads)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "State" .

:YAxis a :Axis ;
    :title "Number in thousand heads" .

:DataPoint1 a :DataPoint ;
    :xValue "Arkansas" ;
    :yValue "14942" ;
    :belongsTo :Chart .

