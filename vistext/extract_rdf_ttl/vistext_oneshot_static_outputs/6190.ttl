@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Number of confirmed cases and deaths of coronavirus (COVID-19) in Mexico from January 14 to December 14 , 2020" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Deaths" .

:DataPoint1 a :DataPoint ;
    :xValue "January 14, 2020" ;
    :yValue "0" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "February 2020" ;
    :yValue "0" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "March 2020" ;
    :yValue "30" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "April 2020" ;
    :yValue "1800" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "May 2020" ;
    :yValue "9900" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "June 2020" ;
    :yValue "27800" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "July 2020" ;
    :yValue "46500" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "August 2020" ;
    :yValue "64500" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "September 2020" ;
    :yValue "77500" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "October 2020" ;
    :yValue "91500" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "November 2020" ;
    :yValue "106000" ;
    :belongsTo :Chart .

:DataPoint12 a :DataPoint ;
    :xValue "December 14, 2020" ;
    :yValue "114300" ;
    :belongsTo :Chart .
