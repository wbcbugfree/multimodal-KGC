@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "U.S. imports of household and kitchen appliances from 2002 to 2019 (in billion U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Imports value in billion U.S. dollars" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2001" ;
    :yValue "10.5" ;
    :belongsTo :Chart .

