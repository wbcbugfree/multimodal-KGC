@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Digital share of overall music sales in selected countries from 2004 to 2014" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Germany" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2003" ;
    :yValue "0.023" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Dec 31, 2004" ;
    :yValue "0.034" ;
    :belongsTo :Chart .

