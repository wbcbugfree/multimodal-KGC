@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Average spending of adults in the United States on selected sharing companies or services as of January 2016 (in U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "company or service" .

:YAxis a :Axis ;
    :title "Average amunt spent in U.S. dollars" .

:DataPoint1 a :DataPoint ;
    :xValue "AirBnB" ;
    :yValue "114" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "DogVacay*" ;
    :yValue "42" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "Etsy" ;
    :yValue "37" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "Instacart*" ;
    :yValue "65" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "Lyft" ;
    :yValue "24" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Post Mates*" ;
    :yValue "34" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Shyp*" ;
    :yValue "12" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Task Rabbit*" ;
    :yValue "83" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "Turo*" ;
    :yValue "39" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "Uber" ;
    :yValue "32" ;
    :belongsTo :Chart .
