@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Number of firearms registered to individuals and businesses in Canada in 2018 , by province or territory" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "province of Canada" .

:YAxis a :Axis ;
    :title "Number of firearms registrations" .

:DataPoint1 a :DataPoint ;
    :xValue "Alberta" ;
    :yValue "219376" ;
    :belongsTo :Chart .

