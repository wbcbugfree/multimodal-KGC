@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Migration flow in Belgium from 2010 to 2019" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Emigration" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2009" ;
    :yValue "46252" ;
    :belongsTo :Chart .

