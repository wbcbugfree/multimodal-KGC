@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Household consumption of alcopops in the United Kingdom from 2000 to 2012 , by within and outside of home (in milliliter per person per week)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Within the home" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 1999" ;
    :yValue "18" ;
    :belongsTo :Chart .

