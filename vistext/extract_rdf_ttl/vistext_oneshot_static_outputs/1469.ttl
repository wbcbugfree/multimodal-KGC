@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Number of NAFTA visas issued by the U.S. Department of State from 2006 to 2018" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Number of visas issued" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2005" ;
    :yValue "75000" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Dec 31, 2006" ;
    :yValue "90000" ;
    :belongsTo :Chart .

