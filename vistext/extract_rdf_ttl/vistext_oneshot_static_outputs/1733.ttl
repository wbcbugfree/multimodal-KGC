@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Honduras : Total population from 2015 to 2025 (in million inhabitants)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Inhabitants in millions" .

:DataPoint1 a :DataPoint ;
    :xValue "2015" ;
    :yValue "9.11" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "2016" ;
    :yValue "9.27" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "2017" ;
    :yValue "9.43" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "2018" ;
    :yValue "9.59" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "2019" ;
    :yValue "9.75" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "2020*" ;
    :yValue "9.9" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "2021*" ;
    :yValue "10.11" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "2022*" ;
    :yValue "10.3" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "2023*" ;
    :yValue "10.49" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "2024*" ;
    :yValue "10.68" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "2025*" ;
    :yValue "10.87" ;
    :belongsTo :Chart .
