@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Dallas Mavericks all-time points leaders from 1980 to 2020" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Players" .

:YAxis a :Axis ;
    :title "Points scored" .

