@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Non-English main home languages ranked by number of speakers in Welsh schools in 2020" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "geographic region" .

:YAxis a :Axis ;
    :title "Number of speakers" .

:DataPoint1 a :DataPoint ;
    :xValue "Arabic" ;
    :yValue "3500" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Bengali" ;
    :yValue "3030" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "Chinese" ;
    :yValue "1480" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "Panjabi" ;
    :yValue "1250" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "Polish" ;
    :yValue "5000" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Portuguese" ;
    :yValue "860" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Romanian" ;
    :yValue "1100" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Somali" ;
    :yValue "860" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "Tagalog/Filipino" ;
    :yValue "840" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "Urdu" ;
    :yValue "1520" ;
    :belongsTo :Chart .
