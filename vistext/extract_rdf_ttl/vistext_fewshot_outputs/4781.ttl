@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Consumption of tree nuts worldwide in 2018 , by type (in 1,000 metric tons)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Consumption in thousand metric tons" .

:YAxis a :Axis ;
    :title "type of nut" .

:DataPoint1 a :DataPoint ;
    :xValue "1300" ;
    :yValue "Almond" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "26" ;
    :yValue "Brazil Nut" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "820" ;
    :yValue "Cashew" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "492" ;
    :yValue "Hazelnut" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "55" ;
    :yValue "Macadamia" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "44677" ;
    :yValue "Peanut" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "111" ;
    :yValue "Pecan" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "19" ;
    :yValue "Pine Nut" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "782" ;
    :yValue "Pistachio" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "871" ;
    :yValue "Walnut" ;
    :belongsTo :Chart .
