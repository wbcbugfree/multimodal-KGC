@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Number of Royal Canadian Mounted Police officers in Canada in 2019 , by level of policing and province Contract policing *" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "level of policing and province" .

:YAxis a :Axis .

:DataPoint1 a :DataPoint ;
    :xValue "Alberta" ;
    :yValue "2891" ;
