@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Suriname : National debt in relation to gross domestic product (GDP) from 2015 to 2025" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "National debt in relation to GDP" .

:YAxis a :Axis ;
    :title "Year" .

:DataPoint1 a :DataPoint ;
    :xValue "0.43" ;
    :yValue "2015" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "0.77" ;
    :yValue "2016" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "0.78" ;
    :yValue "2017" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "0.75" ;
    :yValue "2018" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "0.82" ;
    :yValue "2019*" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "1.44" ;
    :yValue "2020*" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "1.07" ;
    :yValue "2021*" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "1.11" ;
    :yValue "2022*" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "1.12" ;
    :yValue "2023*" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "1.16" ;
    :yValue "2024*" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "1.2" ;
    :yValue "2025*" ;
    :belongsTo :Chart .
