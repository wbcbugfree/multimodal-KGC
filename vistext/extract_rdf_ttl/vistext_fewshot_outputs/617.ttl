@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Operating costs for buses in Great Britain excluding London from 2004/05 to 2018/19 (in million GBP)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Costs in million British pounds***" .

:YAxis a :Axis ;
    :title "Year" .

