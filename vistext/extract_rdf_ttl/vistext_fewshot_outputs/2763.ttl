@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Percentage of homicides by firearm in the United States from 2006 to 2019" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "Percentage of homicides" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2005" ;
    :yValue "0.681" ;
    :belongsTo :Chart .

