@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Value of handicrafts exported from Indian between financial year 2011 and 2020 (in billion Indian rupees)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Export value in billion Indian rupees" .

:YAxis a :Axis ;
    :title "Financial year" .

:DataPoint1 a :DataPoint ;
    :xValue "34.34" ;
    :yValue "FY 2011" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "47.28" ;
    :yValue "FY 2012" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "53.1" ;
    :yValue "FY 2013" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "91.24" ;
    :yValue "FY 2014" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "83.18" ;
    :yValue "FY 2015" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "107.33" ;
    :yValue "FY 2016" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "128.09" ;
    :yValue "FY 2017" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "116.48" ;
    :yValue "FY 2018" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "127.3" ;
    :yValue "FY 2019" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "125.84" ;
    :yValue "FY 2020" ;
    :belongsTo :Chart .
