@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Carbon dioxide emissions in 2008 and 2018 , by select country (in million metric tons)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "2018" .

:YAxis a :Axis ;
    :title "Country" .

:DataPoint1 a :DataPoint ;
    :xValue "170.6" ;
    :yValue "Argentina" ;
    :belongsTo :Chart .

