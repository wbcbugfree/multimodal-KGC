@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Number of operational nuclear reactors worldwide from 1954 to 2019" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Number of nuclear power plants" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 1953" ;
    :yValue "2" ;
    :belongsTo :Chart .

