@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Number of deaths caused by coronavirus (COVID-19) in Romania as of January 8 , 2021" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Number of deaths" .

:DataPoint1 a :DataPoint ;
    :xValue "May" ;
    :yValue "771" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "June" ;
    :yValue "1265" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "July" ;
    :yValue "1712" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "August" ;
    :yValue "2432" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "September" ;
    :yValue "3864" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "October" ;
    :yValue "5121" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "November" ;
    :yValue "7540" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "December" ;
    :yValue "12660" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "2021" ;
    :yValue "16506" ;
    :belongsTo :Chart .
