@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Gross revenue of Bajaj Electricals Limited between financial year 2010 and 2020 (in billion Indian rupees)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Revenue in billion Indian rupees" .

:DataPoint1 a :DataPoint ;
    :xValue "FY 2010" ;
    :yValue "22.6" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "FY 2011" ;
    :yValue "27.8" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "FY 2012" ;
    :yValue "31.4" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "FY 2013" ;
    :yValue "34.1" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "FY 2014" ;
    :yValue "40.8" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "FY 2015" ;
    :yValue "43.1" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "FY 2016" ;
    :yValue "46.9" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "FY 2017" ;
    :yValue "43.6" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "FY 2018" ;
    :yValue "47.9" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "FY 2019" ;
    :yValue "67.6" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "FY 2020" ;
    :yValue "50.6" ;
    :belongsTo :Chart .
