@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Stock price of Unilever at Euronext Amsterdam from August 2019 to January 2021 (in euros)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Month" .

:YAxis a :Axis ;
    :title "Stock price in euros" .

