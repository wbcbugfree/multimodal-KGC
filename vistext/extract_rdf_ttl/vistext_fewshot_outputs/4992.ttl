@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Top 10 movies in Malaysia in 2019 , by box office revenue (in million U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Box office revenue in million U.S. dollars" .

:YAxis a :Axis ;
    :title "film" .

:DataPoint1 a :DataPoint ;
    :xValue "6.09" ;
    :yValue "Aladdin" ;
    :belongsTo :Chart .

