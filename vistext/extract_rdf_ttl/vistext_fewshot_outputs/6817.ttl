@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Life expectancy at birth in the Netherlands from 1950 to 2018 , by gender" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 1949" ;
    :yValue "72.7" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Dec 31, 1959" ;
    :yValue "75.3" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "Dec 31, 1969" ;
    :yValue "76.5" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "Dec 31, 1979" ;
    :yValue "79.2" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "Dec 31, 1989" ;
    :yValue "80.1" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Dec 31, 1999" ;
    :yValue "80.6" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Dec 31, 2009" ;
    :yValue "82.7" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Dec 31, 2017" ;
    :yValue "83.3" ;
    :belongsTo :Chart .
