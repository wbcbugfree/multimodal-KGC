@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Turnover from retail sale of food , beverages and tobacco in specialized stores in Greece from 2008 to 2018 (in million euros)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Annual turnover in million euros" .

:DataPoint1 a :DataPoint ;
    :xValue "2008" ;
    :yValue "7226" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "2009" ;
    :yValue "6653" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "2010" ;
    :yValue "6296" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "2011" ;
    :yValue "5824" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "2012" ;
    :yValue "5217" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "2013" ;
    :yValue "4744" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "2014*" ;
    :yValue "3201" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "2015*" ;
    :yValue "3130" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "2016*" ;
    :yValue "3033" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "2017*" ;
