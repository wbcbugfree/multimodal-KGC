@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Distribution of causes of death in Belgium in 2016" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Distribution of deaths" .

:YAxis a :Axis ;
    :title "causes of death" .

:DataPoint1 a :DataPoint ;
    :xValue "0.278" ;
    :yValue "Cardiovascular diseases" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "0.046" ;
    :yValue "Digestive system disorders" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "0.024" ;
    :yValue "Endocrine diseases and metabolis..." ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "0.022" ;
    :yValue "Infections and parasitic diseases" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "0.938" ;
    :yValue "Natural causes" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "0.265" ;
    :yValue "Neoplasms" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "0.053" ;
    :yValue "Nervous system disorders" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "0.082" ;
    :yValue "Other natural causes" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "0.05" ;
    :yValue "Psychological disorders" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "0.106" ;
    :yValue "Respiratory system disorders" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "0.064" ;
    :yValue "Unnatural causes" ;
    :belongsTo :Chart .

:DataPoint12 a :DataPoint ;
    :xValue "0.031" ;
    :yValue "Urogential disorders" ;
    :belongsTo :Chart .
