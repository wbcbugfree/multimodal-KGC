@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Number of people immigrating to Iceland in 2019 , by country of origin" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Number of immigrants" .

:YAxis a :Axis ;
    :title "Country" .

