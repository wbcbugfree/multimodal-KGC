@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Average premiums for homeowners insurance in the United States from 2001 to 2017 (in U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Average premiums in U.S. dollars" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2000" ;
    :yValue "538" ;
    :belongsTo :Chart .

