@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Average annual rainfall in the United Kingdom (UK) from 2001 to 2019 (in millimeters)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Rainfall in millimeters" .

:YAxis a :Axis ;
    :title "Year" .

:DataPoint1 a :DataPoint ;
    :xValue "1140" ;
    :yValue "2001" ;
    :belongsTo :Chart .

