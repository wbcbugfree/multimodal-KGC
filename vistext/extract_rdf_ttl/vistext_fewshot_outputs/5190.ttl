@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Trends in global export volume of trade in goods from 1950 to 2019 (in billion U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Export volume in billion U.S. dollars" .

