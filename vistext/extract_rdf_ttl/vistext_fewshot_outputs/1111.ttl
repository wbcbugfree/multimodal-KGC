@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Player expenses of the Chicago White Sox from 2001 to 2019 (in million U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Player expenses in million U.S. dollars" .

