@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Total number of magnetic resonance imaging (MRI) units in the United Kingdom (UK) from 2000 to 2014" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Number of scanners" .

:DataPoint1 a :DataPoint ;
    :xValue "2000*" ;
    :yValue "334" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "2001 *" ;
    :yValue "367" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "2002 *" ;
    :yValue "299" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "2003 *" ;
    :yValue "275" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "2004" ;
    :yValue "301" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "2005" ;
    :yValue "328" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "2006*" ;
    :yValue "345" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "2008 *" ;
    :yValue "342" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "2010 *" ;
    :yValue "411" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "2011*" ;
    :yValue "442" ;
