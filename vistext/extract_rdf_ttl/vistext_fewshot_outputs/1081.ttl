@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Share of voice on sportsbooks among leading websites in the United States from July to September 2019" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "Share of voice" .

:DataPoint1 a :DataPoint ;
