@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Lifetime luxury tax payments of Major League Baseball clubs 1997 - 2012 (in million U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "baseball team" .

:YAxis a :Axis ;
    :title "Luxury tax payments in million U.S. dollars" .

:DataPoint1 a :DataPoint ;
    :xValue "Atlanta Braves" ;
    :yValue "2.6" ;
    :belongsTo :Chart .

