    :xValue "668370" ;
    :yValue "India" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "154425" ;
    :yValue "Iran" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "236635" ;
    :yValue "Italy" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "202255" ;
    :yValue "Pakistan" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "588190" ;
    :yValue "Philippines" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "496375" ;
    :yValue "United Kingdom" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "253715" ;
