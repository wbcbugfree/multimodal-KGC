@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Top ten countries of birth for foreign-born people in Canada in 2016" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Number of people residing in Canada" .

:YAxis a :Axis ;
    :title "Country" .

:DataPoint1 a :DataPoint ;
    :xValue "649260" ;
    :yValue "China" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "208935" ;
    :yValue "Hong Kong" ;
    :belongsTo :Chart .

