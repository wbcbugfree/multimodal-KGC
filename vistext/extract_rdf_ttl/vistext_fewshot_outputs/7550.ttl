@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Share of population that walk or bicycle to meaningful destinations in selected countries in 2012" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "All of the time" .

:YAxis a :Axis ;
    :title "country" .

:DataPoint1 a :DataPoint ;
    :xValue "0.37" ;
    :yValue "Argentineans" ;
    :belongsTo :Chart .

