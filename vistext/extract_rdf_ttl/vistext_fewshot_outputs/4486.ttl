@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Total number of Walmart stores worldwide from 2008 to 2020" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Number of stores" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2007" ;
    :yValue "7267" ;
    :belongsTo :Chart .

