@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Clinical trial costs by selected cost component and clinical phase as of 2014 (in U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Phase 1" .

:YAxis a :Axis ;
    :title "Cost component" .

:DataPoint1 a :DataPoint ;
    :xValue "237837" ;
    :yValue "Administrative Staff Costs" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "252243" ;
    :yValue "Central Lab Costs" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "476100" ;
    :yValue "Clinical Procedure Total" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "10595" ;
    :yValue "Cost Per IRB Approvals" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "2602" ;
    :yValue "Cost of IRB Amendments" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "49277" ;
    :yValue "Data Management Costs" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "36551" ;
    :yValue "Patient Recruitment Costs" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "7339" ;
    :yValue "Patient Retention Costs" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "109848" ;
    :yValue "Physician Costs" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "178491" ;
    :yValue "RN/CRA Costs" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "325859" ;
    :yValue "SDV Costs" ;
    :belongsTo :Chart .

:DataPoint12 a :DataPoint ;
    :xValue "201103" ;
    :yValue "Site Monitoring Costs" ;
    :belongsTo :Chart .

:DataPoint13 a :DataPoint ;
    :xValue "52589" ;
    :yValue "Site Recruitment Costs" ;
    :belongsTo :Chart .

:DataPoint14 a :DataPoint ;
    :xValue "194783" ;
    :yValue "Site Retention Costs" ;
    :belongsTo :Chart .
