@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Population density of Malaysia from 2000 to 2018 (in people per square kilometer)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Population density in people per square kilometer" .

