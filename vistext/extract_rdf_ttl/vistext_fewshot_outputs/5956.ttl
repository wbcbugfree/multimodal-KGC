@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Apache Corporation 's revenue from 2007 to 2019 (in million U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Revenue in million U.S. dollars" .

:DataPoint1 a :DataPoint ;
    :xValue "2007" ;
    :yValue "10050" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "2008" ;
    :yValue "12400" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "2009" ;
    :yValue "8623" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "2010" ;
    :yValue "11751" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "2011*" ;
    :yValue "14635" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "2012" ;
    :yValue "14976" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "2013" ;
    :yValue "14821" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "2014" ;
    :yValue "12810" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "2015" ;
    :yValue "6575" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "2016" ;
    :yValue "5367" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "2017" ;
    :yValue "5888" ;
    :belongsTo :Chart .

:DataPoint12 a :DataPoint ;
    :xValue "2018" ;
    :yValue "7364" ;
    :belongsTo :Chart .

:DataPoint13 a :DataPoint ;
    :xValue "2019" ;
    :yValue "6384" ;
    :belongsTo :Chart .
