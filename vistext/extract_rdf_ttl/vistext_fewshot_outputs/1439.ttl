@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Apparent steel consumption per capita in Mexico from 2003 to 2018 (in kilograms of finished steel products)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Per capita use in kilograms" .

:DataPoint1 a :DataPoint ;
    :xValue "2003" ;
    :yValue "144.5" ;
    :belongsTo :Chart .

