    :xValue "8.1" ;
    :yValue "Jul" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "9.77" ;
    :yValue "Jun" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "9.38" ;
    :yValue "Mar" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
