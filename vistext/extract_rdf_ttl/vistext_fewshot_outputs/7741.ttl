@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Monthly export value of frozen , fresh and canned fruit and vegetable juices in Canada from 2015 to 2020 (in million Canadian dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "2015" .

:YAxis a :Axis ;
    :title "Month" .

:DataPoint1 a :DataPoint ;
    :xValue "9.17" ;
    :yValue "Apr" ;
    :belongsTo :Chart .

