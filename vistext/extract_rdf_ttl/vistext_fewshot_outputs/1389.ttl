@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Latin American and Caribbean countries with the largest number of international tourist arrivals in 2018 (in millions)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Country" .

:YAxis a :Axis ;
    :title "Number of arrivals in millions" .

:DataPoint1 a :DataPoint ;
    :xValue "Argentina" ;
    :yValue "6.94" ;
    :belongsTo :Chart .

