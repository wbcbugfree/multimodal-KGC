@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Countries with the highest stillbirth rates in 2009 (per 1,000 births)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Country" .

:YAxis a :Axis ;
    :title "Rate per 1,000 births" .

:DataPoint1 a :DataPoint ;
    :xValue "Afghanistan" ;
    :yValue "29" ;
    :belongsTo :Chart .

