@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Average annual expenditure on cleansing and toilet tissue , paper towels and napkins per consumer unit in the United States from 2007 to 2019 (in U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Average annual expenditure in U.S. dollars" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2006" ;
    :yValue "99.03" ;
    :belongsTo :Chart .

