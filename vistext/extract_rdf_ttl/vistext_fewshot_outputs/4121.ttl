@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Monthly civilian labor force in the United States from November 2019 to November 2020 (in millions , seasonally adjusted)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Civilian labor force in millions" .

:YAxis a :Axis ;
    :title "Month" .

:DataPoint1 a :DataPoint ;
    :xValue "155.84" ;
    :yValue "Apr '20" ;
    :belongsTo :Chart .

