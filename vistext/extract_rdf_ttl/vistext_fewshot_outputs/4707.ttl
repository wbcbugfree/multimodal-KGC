@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Number of average available hospital beds in Northern Ireland from 2009 to 2020" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Number of average available hospital beds" .

:DataPoint1 a :DataPoint ;
    :xValue "2009/10" ;
    :yValue "7114" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "2010/11" ;
    :yValue "6560" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "2011/12" ;
    :yValue "6245" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "2012/13" ;
    :yValue "6089" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "2013/14" ;
    :yValue "5938" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "2014/15" ;
    :yValue "5837" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "2015/16" ;
    :yValue "5703" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "2016/17" ;
    :yValue "5731" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "2017/18" ;
    :yValue "5716" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "2018/19" ;
    :yValue "5649" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "2019/20" ;
    :yValue "5589" ;
    :belongsTo :Chart .
