    :xValue "Dec 31, 2005" ;
    :yValue "149.2" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "Dec 31, 2006" ;
    :yValue "153.2" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Dec 31, 2007" ;
    :yValue "144.2" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Dec 31, 2008" ;
    :yValue "133.9" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
