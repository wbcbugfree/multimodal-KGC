@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Number of Facebook fans/twitter followers of the Brooklyn Nets (NBA) from 2012 to 2020 (in millions)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Twitter followers" .

:YAxis a :Axis ;
    :title "Month" .

