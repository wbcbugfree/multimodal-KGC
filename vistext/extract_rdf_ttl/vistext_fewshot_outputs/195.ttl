@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Turkey : Share in the global gross domestic product (GDP) , adjusted for purchasing power parity , from 2015 to 2025" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Share in global GDP adjusted for PPP" .

:YAxis a :Axis ;
    :title "Year" .

:DataPoint1 a :DataPoint ;
    :xValue "0.0175" ;
    :yValue "2015" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "0.0178" ;
    :yValue "2016" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "0.0182" ;
    :yValue "2017" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "0.0181" ;
    :yValue "2018" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "0.0177" ;
    :yValue "2019" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "0.0176" ;
    :yValue "2020*" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "0.0176" ;
    :yValue "2021*" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "0.0176" ;
    :yValue "2022*" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "0.0175" ;
    :yValue "2023*" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "0.0174" ;
    :yValue "2024*" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "0.0173" ;
    :yValue "2025*" ;
    :belongsTo :Chart .
