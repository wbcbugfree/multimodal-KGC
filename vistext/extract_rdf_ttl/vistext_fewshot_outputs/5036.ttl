@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Number of deaths caused by coronavirus (COVID-19) in Romania from May 2020 to January 2021 , by day of report" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Number of deaths" .

