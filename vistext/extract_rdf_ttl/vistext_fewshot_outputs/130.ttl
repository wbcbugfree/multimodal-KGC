@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Two-wheeler sales in Manaus , Brazil from 2008 to 2018 (in million units)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Unit sales in millions" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2006" ;
    :yValue "1.91" ;
    :belongsTo :Chart .

