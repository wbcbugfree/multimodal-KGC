@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Value of Premier League TV broadcasting deals in Asia in the time period from 2013 to 2016 (in million U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Country" .

:YAxis a :Axis ;
    :title "TV deal value in million U.S. dollars" .

:DataPoint1 a :DataPoint ;
    :xValue "Burma" ;
    :yValue "40.3" ;
    :belongsTo :Chart .

