    :xValue "2010" ;
    :yValue "3957" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "2011" ;
    :yValue "4038" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "2012" ;
    :yValue "4225" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "2013" ;
