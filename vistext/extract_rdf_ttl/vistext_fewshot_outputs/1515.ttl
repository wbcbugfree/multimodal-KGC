@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Average expenditure per person per week on food and drink in the United Kingdom (UK) from 2006 to 2018/2019 (in pence)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Average expenditure in British pence sterling" .

:DataPoint1 a :DataPoint ;
    :xValue "2006" ;
    :yValue "3573" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "2007" ;
    :yValue "3647" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "2008" ;
    :yValue "3737" ;
    :belongsTo :Chart .

