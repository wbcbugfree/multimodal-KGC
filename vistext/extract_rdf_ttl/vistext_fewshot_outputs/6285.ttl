@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Distribution of employment in the private sector , by firm size in the United States 2000 to 2019" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Firms with 250 and more employees" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 1999" ;
    :yValue "0.522" ;
    :belongsTo :Chart .

