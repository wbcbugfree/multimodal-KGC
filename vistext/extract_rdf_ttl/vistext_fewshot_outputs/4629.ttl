@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Average ticket price for Chicago Bears home games from 2006 to 2019 (in U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Average ticket price (in U.S. dollars)" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2005" ;
    :yValue "78.7" ;
    :belongsTo :Chart .

