@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Monthly ARPU through post-paid mobile subscribers in the United Kingdom (UK) from 2007 to 2020 (in GBP)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Average monthly ARPU in GBP" .

:YAxis a :Axis ;
    :title "Year" .

:DataPoint1 a :DataPoint ;
    :xValue "34.3" ;
    :yValue "2007" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "32" ;
    :yValue "2008" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "29.1" ;
    :yValue "2009" ;
    :belongsTo :Chart .

