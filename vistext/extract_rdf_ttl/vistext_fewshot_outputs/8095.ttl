@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Generation of renewable energy in the U.S. from 2009 to 2019 , by technology (in terawatt hours)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Hydro" .

:YAxis a :Axis ;
    :title "Year" .

:DataPoint1 a :DataPoint ;
    :xValue "272" ;
    :yValue "2009" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "258" ;
    :yValue "2010" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "318" ;
    :yValue "2011" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "275" ;
    :yValue "2012" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "267" ;
    :yValue "2013" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "257" ;
    :yValue "2014" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "246" ;
    :yValue "2015" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "265" ;
    :yValue "2016" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "298" ;
    :yValue "2017" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "291" ;
    :yValue "2018" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "272" ;
    :yValue "2019*" ;
    :belongsTo :Chart .
