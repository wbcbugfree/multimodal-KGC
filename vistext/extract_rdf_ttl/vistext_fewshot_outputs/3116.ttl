@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Volume of waste for landfills collected by local authorities in England from 2000/01 to 2018/19 (in million metric tons)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Million metric tons" .

:YAxis a :Axis ;
    :title "Year" .

:DataPoint1 a :DataPoint ;
    :xValue "21.9" ;
    :yValue "2000/01" ;
    :belongsTo :Chart .

