@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Number of aircraft arrivals at Changi Airport in Singapore from 2010 to 2019" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Number of aircraft arrivals" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2009" ;
    :yValue "131638" ;
    :belongsTo :Chart .

