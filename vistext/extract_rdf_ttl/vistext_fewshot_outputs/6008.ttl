@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Democratic Republic of the Congo : National debt from 2014 to 2024 (in billion U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "National debt in billion U.S. dollars" .

:YAxis a :Axis ;
    :title "Year" .

:DataPoint1 a :DataPoint ;
    :xValue "3.31" ;
    :yValue "2014" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "3.55" ;
    :yValue "2015" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "4.87" ;
    :yValue "2016" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "6.32" ;
    :yValue "2017" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "7.01" ;
    :yValue "2018" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "6.68" ;
    :yValue "2019*" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "6.23" ;
    :yValue "2020*" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "5.76" ;
    :yValue "2021*" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "5.28" ;
    :yValue "2022*" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "4.78" ;
    :yValue "2023*" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "4.33" ;
    :yValue "2024*" ;
    :belongsTo :Chart .
