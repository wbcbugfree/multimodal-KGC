@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Number of confirmed cases and deaths of coronavirus (COVID-19) in Mexico from January 14 to December 14 , 2020" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Deaths" .

:DataPoint1 a :DataPoint ;
    :xValue "Jan 14, 2020" ;
    :yValue "0" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Feb 14, 2020" ;
    :yValue "0" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "Mar 14, 2020" ;
    :yValue "0" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "Apr 14, 2020" ;
    :yValue "449" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "May 14, 2020" ;
    :yValue "4477" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Jun 14, 2020" ;
    :yValue "17141" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Jul 14, 2020" ;
    :yValue "36327" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Aug 14, 2020" ;
    :yValue "55908" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "Sep 14, 2020" ;
    :yValue "71049" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "Oct 14, 2020" ;
    :yValue "84845" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "Nov 14, 2020" ;
    :yValue "98259" ;
    :belongsTo :Chart .

:DataPoint12 a :DataPoint ;
    :xValue "Dec 14, 2020" ;
    :yValue "114298" ;
    :belongsTo :Chart .
