@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Number of overnight stays in travel accommodation in Croatia between 2007 and 2019 (in millions)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Number of nights in millions" .

:DataPoint1 a :DataPoint ;
    :xValue "2007" ;
    :yValue "38.5" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "2008" ;
    :yValue "38.7" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "2009" ;
    :yValue "37.6" ;
    :belongsTo :Chart .

