    :xValue "2010" ;
    :yValue "37.1" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "2011" ;
    :yValue "39.4" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "2012 *" ;
    :yValue "62.3" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "2013" ;
    :yValue "64.8" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "2014" ;
    :yValue "66.4" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "2015" ;
    :yValue "71.6" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
