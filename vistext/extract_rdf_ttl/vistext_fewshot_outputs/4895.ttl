@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Femicide rate in selected countries in Latin America in 2018 (number of femicides per 100,000 women)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Country" .

:YAxis a :Axis ;
    :title "Number of femicides per 100,000 women" .

:DataPoint1 a :DataPoint ;
    :xValue "Argentina" ;
    :yValue "1.1" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Bolivia" ;
    :yValue "2.3" ;
    :belongsTo :Chart .

