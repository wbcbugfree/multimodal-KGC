    :xValue "Hungary" ;
    :yValue "-0.033" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Latvia" ;
    :yValue "-0.02" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Lithuania" ;
    :yValue "-0.016" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Poland" ;
    :yValue "-0.041" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "Romania" ;
    :yValue "-0.072" ;
