@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Budget deficit in Central and Eastern European countries as a percentage of GDP in the 1st quarter of 2020" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "Share of deficit in GDP" .

:DataPoint1 a :DataPoint ;
    :xValue "Bulgaria" ;
    :yValue "-0.003" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Czechia" ;
    :yValue "-0.019" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "EU-27 average" ;
    :yValue "-0.023" ;
    :belongsTo :Chart .

