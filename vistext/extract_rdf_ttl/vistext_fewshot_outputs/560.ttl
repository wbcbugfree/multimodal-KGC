:DataPoint10 a :DataPoint ;
    :xValue "Slovakia" ;
    :yValue "-0.035" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "Slovenia" ;
    :yValue "-0.044" ;
    :belongsTo :Chart .
