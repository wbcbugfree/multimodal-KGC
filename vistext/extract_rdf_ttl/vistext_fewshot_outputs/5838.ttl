@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Auction price of tea per kilogram in Kenya from January 2019 to September 2020 (in U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Month" .

:YAxis a :Axis ;
    :title "Auction price of tea in U.S. dollars" .

