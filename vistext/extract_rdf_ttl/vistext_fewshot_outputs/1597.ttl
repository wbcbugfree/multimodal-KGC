@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Forecast of boron market demand for detergents worldwide from 2012 to 2023 (in metric tons)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Demand in metric tons" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2011" ;
    :yValue "52000" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Dec 31, 2012" ;
    :yValue "53900" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "Dec 31, 2013" ;
    :yValue "55900" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "Dec 31, 2014" ;
    :yValue "57900" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "Dec 31, 2015" ;
    :yValue "60000" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Dec 31, 2016" ;
    :yValue "62200" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Dec 31, 2017" ;
    :yValue "64500" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Dec 31, 2018" ;
    :yValue "66900" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "Dec 31, 2019" ;
    :yValue "69400" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "Dec 31, 2020" ;
    :yValue "72000" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "Dec 31, 2021" ;
    :yValue "74700" ;
    :belongsTo :Chart .

:DataPoint12 a :DataPoint ;
    :xValue "Dec 31, 2022" ;
    :yValue "77500" ;
    :belongsTo :Chart .
