@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Number of cumulative cases of coronavirus (COVID-19) worldwide from January 22 , 2020 to January 5 , 2021 , by day" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Number of cumulative cases" .

:DataPoint1 a :DataPoint ;
    :xValue "January 22, 2020" ;
    :yValue "555" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "February 1, 2020" ;
    :yValue "12000" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "March 1, 2020" ;
    :yValue "88400" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "April 1, 2020" ;
    :yValue "935000" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "May 1, 2020" ;
    :yValue "3340000" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "June 1, 2020" ;
    :yValue "6270000" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "July 1, 2020" ;
    :yValue "10670000" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "August 1, 2020" ;
    :yValue "17790000" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "September 1, 2020" ;
    :yValue "25690000" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "October 1, 2020" ;
    :yValue "34260000" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "November 1, 2020" ;
    :yValue "46390000" ;
    :belongsTo :Chart .

:DataPoint12 a :DataPoint ;
    :xValue "December 1, 2020" ;
    :yValue "63780000" ;
    :belongsTo :Chart .

:DataPoint13 a :DataPoint ;
    :xValue "January 1, 2021" ;
    :yValue "83960000" ;
    :belongsTo :Chart .

:DataPoint14 a :DataPoint ;
    :xValue "January 5, 2021" ;
    :yValue "86410000" ;
    :belongsTo :Chart .
