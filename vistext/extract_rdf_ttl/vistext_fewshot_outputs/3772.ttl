@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "What kind (s) of video/computer games do you play ?" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "Share of respondents" .

:DataPoint1 a :DataPoint ;
    :xValue "3rd person adventure" ;
    :yValue "0.18" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "3rd person shooter/action" ;
    :yValue "0.14" ;
    :belongsTo :Chart .

