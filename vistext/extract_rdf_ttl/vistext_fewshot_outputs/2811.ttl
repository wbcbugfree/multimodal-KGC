@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Contribution of foodservice industry to gross domestic product in Mexico from 2010 to 1st half 2020 (in billion Mexican pesos)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "GDP in billion Mexican pesos" .

:DataPoint1 a :DataPoint ;
    :xValue "2010" ;
    :yValue "638.2" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "2011" ;
    :yValue "675.2" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "2012" ;
    :yValue "718.5" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "2013" ;
    :yValue "737.4" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "2014" ;
    :yValue "757.8" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "2015" ;
    :yValue "844.6" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "2016" ;
    :yValue "896.2" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "2017" ;
    :yValue "943.4" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "2018" ;
    :yValue "987.8" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "2019" ;
    :yValue "1046.1" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "2020*" ;
    :yValue "402.7" ;
    :belongsTo :Chart .
