@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Child mortality rate (under five years old) in China from 1850 to 2020" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Deaths per 1,000 live births" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 1849" ;
    :yValue "418" ;
    :belongsTo :Chart .

