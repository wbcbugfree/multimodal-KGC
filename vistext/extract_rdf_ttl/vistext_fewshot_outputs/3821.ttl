@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Grapefruit production in the United States from 2000 to 201 (in 1,000 tons)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Production in thousand tons" .

