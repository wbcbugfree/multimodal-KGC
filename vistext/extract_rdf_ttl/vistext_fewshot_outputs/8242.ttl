@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Distribution of municipal wastewater discharges treatment type in Canada as of 2017 , by province Tertiary treatment" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Country" .

:YAxis a :Axis .

:DataPoint1 a :DataPoint ;
    :xValue "Alberta" ;
    :yValue "0.8" ;
    :belongsTo :Chart .

