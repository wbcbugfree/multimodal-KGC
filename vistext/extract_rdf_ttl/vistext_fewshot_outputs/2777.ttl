@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Income distribution inequality based on Gini coefficient in Latin America as of 2017 , by country" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Gini coefficient" .

:YAxis a :Axis ;
    :title "Country" .

:DataPoint1 a :DataPoint ;
    :xValue "40.3" ;
    :yValue "Argentina" ;
    :belongsTo :Chart .

