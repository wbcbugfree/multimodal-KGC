@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Uganda : Total population from 2015 to 2025 (in million inhabitants)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Inhabitants in millions" .

:DataPoint1 a :DataPoint ;
    :xValue "2015" ;
    :yValue "35.09" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "2016" ;
    :yValue "36.31" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "2017*" ;
    :yValue "37.58" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "2018*" ;
    :yValue "38.89" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "2019*" ;
    :yValue "40.24" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "2020*" ;
    :yValue "41.65" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "2021*" ;
    :yValue "43.1" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "2022*" ;
    :yValue "44.6" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "2023*" ;
    :yValue "46.16" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "2024*" ;
    :yValue "47.78" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "2025*" ;
    :yValue "49.46" ;
    :belongsTo :Chart .
