@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Number of furniture stores in Canada as of December 2019 , by province" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Number of stores" .

:YAxis a :Axis ;
    :title "province of Canada" .

:DataPoint1 a :DataPoint ;
    :xValue "349" ;
    :yValue "Alberta" ;
    :belongsTo :Chart .

