@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Namibia : Budget balance between 2015 to 2025 in relation to GDP" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Budget balance in relation to GDP" .

:DataPoint1 a :DataPoint ;
    :xValue "2015" ;
    :yValue "-0.081" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "2016" ;
    :yValue "-0.091" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "2017" ;
    :yValue "-0.049" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "2018" ;
    :yValue "-0.053" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "2019" ;
    :yValue "-0.059" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "2020*" ;
    :yValue "-0.095" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "2021*" ;
    :yValue "-0.084" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "2022*" ;
    :yValue "-0.091" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "2023*" ;
    :yValue "-0.073" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "2024*" ;
    :yValue "-0.067" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "2025*" ;
    :yValue "-0.066" ;
    :belongsTo :Chart .
