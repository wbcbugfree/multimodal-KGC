@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Turnover from retail sale of food , beverages and tobacco in specialized stores in Croatia from 2008 to 2018 (in million euros)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Annual turnover in million euros" .

:DataPoint1 a :DataPoint ;
    :xValue "2008" ;
    :yValue "571" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "2009" ;
    :yValue "310" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "2010" ;
    :yValue "264" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "2011" ;
    :yValue "290" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "2012" ;
    :yValue "674" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "2013" ;
    :yValue "652" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "2014" ;
    :yValue "634" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "2015" ;
    :yValue "649" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "2016" ;
    :yValue "614" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "2017" ;
    :yValue "554" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "2018*" ;
    :yValue "539" ;
    :belongsTo :Chart .
