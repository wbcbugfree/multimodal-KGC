@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Mexico 's IPC stock exchange index from January 2 to October 15 , 2020 (in Mexican pesos)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "IPC in Mexican pesos" .

:DataPoint1 a :DataPoint ;
    :xValue "Jan 2, 2020" ;
    :yValue "44400" ;
    :belongsTo :Chart .

