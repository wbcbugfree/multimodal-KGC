@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Number of Rossmann stores outside of Germany from 2008 to 2019 , by country" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Turkey" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2007" ;
    :yValue "4.5" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Dec 31, 2008" ;
    :yValue "5.8" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "Dec 31, 2009" ;
    :yValue "8.2" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "Dec 31, 2010" ;
    :yValue "12.3" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "Dec 31, 2011" ;
    :yValue "16.8" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Dec 31, 2012" ;
    :yValue "27.2" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Dec 31, 2013" ;
    :yValue "31.1" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Dec 31, 2014" ;
    :yValue "49.5" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "Dec 31, 2015" ;
    :yValue "66.7" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "Dec 31, 2016" ;
    :yValue "94.2" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "Dec 31, 2017" ;
    :yValue "112.1" ;
    :belongsTo :Chart .

:DataPoint12 a :DataPoint ;
    :xValue "Dec 31, 2018" ;
    :yValue "119.8" ;
    :belongsTo :Chart .
