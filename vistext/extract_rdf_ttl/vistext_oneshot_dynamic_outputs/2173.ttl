@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Leading 10 U.S. states based on number of laying hens in 2019 (in 1,000 heads)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "State" .

:YAxis a :Axis ;
    :title "Number in thousand heads" .

:DataPoint1 a :DataPoint ;
    :xValue "Arkansas" ;
    :yValue "14900" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "California" ;
    :yValue "13800" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "Georgia" ;
    :yValue "20000" ;
    :belongsTo :Chart .

