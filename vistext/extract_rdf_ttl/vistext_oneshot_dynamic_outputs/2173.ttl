    :xValue "Indiana" ;
    :yValue "34700" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "Iowa" ;
    :yValue "58300" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Michigan" ;
    :yValue "15400" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "North Carolina" ;
    :yValue "15100" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Ohio" ;
    :yValue "36400" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "Pennsylvania" ;
    :yValue "30200" ;
