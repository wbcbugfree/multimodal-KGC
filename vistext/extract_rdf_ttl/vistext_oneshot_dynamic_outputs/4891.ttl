@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Leading fashion brands with the most Facebook fans as of October 2020 (in millions)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "brand" .

:YAxis a :Axis ;
    :title "Number of fans in millions" .

:DataPoint1 a :DataPoint ;
    :xValue "Amore Mio" ;
    :yValue "6.45" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "BOSS" ;
    :yValue "8.48" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "Chalany High Heels" ;
    :yValue "14.61" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "Dior" ;
    :yValue "17.29" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "Fastrack" ;
    :yValue "8.89" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Louis Vuitton" ;
    :yValue "24.0" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Mango" ;
    :yValue "11.53" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Pit Bull Jeans" ;
    :yValue "12.04" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "Prada" ;
    :yValue "6.96" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "ROLEX" ;
    :yValue "7.48" ;
    :belongsTo :Chart .
