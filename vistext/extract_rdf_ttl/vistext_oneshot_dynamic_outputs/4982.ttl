@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Cities with the most acres of parkland per 1,000 residents in the United States in 2019" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "city of the United States" .

:YAxis a :Axis ;
    :title "Acres of parkland per 1,000 residents" .

