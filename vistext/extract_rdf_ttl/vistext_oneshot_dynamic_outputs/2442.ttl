@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Bahrain : Budget balance between 2015 to 2025 in relation to GDP" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Budget balance in relation to GDP" .

:YAxis a :Axis ;
    :title "Year" .

:DataPoint1 a :DataPoint ;
    :xValue "-0.199" ;
    :yValue "2015" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "-0.188" ;
    :yValue "2016" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "-0.142" ;
    :yValue "2017" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "-0.12" ;
    :yValue "2018" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "-0.106" ;
    :yValue "2019" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "-0.131" ;
    :yValue "2020*" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "-0.092" ;
    :yValue "2021*" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "-0.084" ;
    :yValue "2022*" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "-0.081" ;
    :yValue "2023*" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "-0.079" ;
    :yValue "2024*" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "-0.077" ;
    :yValue "2025*" ;
    :belongsTo :Chart .
