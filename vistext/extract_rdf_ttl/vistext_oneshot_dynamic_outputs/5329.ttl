@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Number of recent immigrants to Nova Scotia , Canada from 2001 to 2020" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Number of immigrants" .

:DataPoint1 a :DataPoint ;
    :xValue "2000-2001" ;
    :yValue "1754" ;
    :belongsTo :Chart .

