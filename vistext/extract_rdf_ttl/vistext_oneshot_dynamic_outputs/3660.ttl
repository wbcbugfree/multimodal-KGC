@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Spending on chilled quiches and flans in the United Kingdom from December 2007 to December 2019 (in million GBP)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "day" .

:YAxis a :Axis ;
    :title "Spend in million GBP" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2006" ;
    :yValue "145.5" ;
    :belongsTo :Chart .

