@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Reaction of the Warsaw Stock Exchange to coronavirus (COVID-19) in Poland as of March 2020 , by indices" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
