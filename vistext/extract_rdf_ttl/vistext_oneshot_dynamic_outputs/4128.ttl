@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Earnings per share of common stock of the Walt Disney Company in the fiscal years 2006 to 2020 (in U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Earnings per share in U.S. dollars" .

