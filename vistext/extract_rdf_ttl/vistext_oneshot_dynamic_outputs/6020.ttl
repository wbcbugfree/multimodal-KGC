@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Number of households in Denmark from 2010 to 2020 , by type of household" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Other couples" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2009" ;
    :yValue "305441" ;
    :belongsTo :Chart .

