    :xValue "303" ;
    :yValue "Caviro" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "177" ;
    :yValue "Cavit" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "364" ;
    :yValue "GIV" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "170" ;
    :yValue "Martini" ;
