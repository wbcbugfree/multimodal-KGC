@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Most purchased brands during COVID-19 outbreak in Singapore as of March 2020 , by type of customer" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "COVID-19 Worriers" .

:DataPoint1 a :DataPoint ;
    :xValue "Dettol" ;
    :yValue "0.32" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Enfagrow" ;
    :yValue "0.04" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "KFC" ;
    :yValue "0.36" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "L'Oreal" ;
    :yValue "0.13" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "McDonald's" ;
    :yValue "0.56" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "MEWATCH" ;
    :yValue "0.06" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Ninja Van" ;
    :yValue "0.17" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Nissin" ;
    :yValue "0.12" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "QOO10" ;
    :yValue "0.31" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "Shopee" ;
    :yValue "0.19" ;
    :belongsTo :Chart .
