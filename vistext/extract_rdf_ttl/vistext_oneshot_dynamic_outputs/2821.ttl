@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Total regular season home attendance of the NFL New York Jets franchise from 2006 to 2019" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Home attendance" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2005" ;
    :yValue "618751" ;
    :belongsTo :Chart .

