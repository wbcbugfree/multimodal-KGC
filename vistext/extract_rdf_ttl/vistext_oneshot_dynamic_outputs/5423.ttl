@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Genre breakdown of computer game sales in the United States in 2015" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Share of units sold" .

:YAxis a :Axis ;
    :title "Response" .

:DataPoint1 a :DataPoint ;
    :xValue "0.03" ;
    :yValue "Action" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "0.05" ;
    :yValue "Adventure" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "0" ;
    :yValue "Arcade" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "0.26" ;
    :yValue "Casual" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "0" ;
    :yValue "Children's entertainment" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "0" ;
    :yValue "Family entertainment" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "0.01" ;
    :yValue "Other games, compilations" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "0.02" ;
    :yValue "Flight" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "0" ;
    :yValue "Racing" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "0.19" ;
    :yValue "Role-playing" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "0.055" ;
    :yValue "Shooter" ;
    :belongsTo :Chart .

:DataPoint12 a :DataPoint ;
    :xValue "0" ;
    :yValue "Sport games" ;
    :belongsTo :Chart .

:DataPoint13 a :DataPoint ;
    :xValue "0.37" ;
    :yValue "Strategy" ;
    :belongsTo :Chart .
