@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Estimated aggregate revenue of the U.S. advertising , public relations , and related service industry from 2004 to 2018 (in billion U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Estimated revenue in billion U.S. dollars" .

