@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Leading 10 U.S. companies based on medical device revenue in 2019 (in billion U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Revenue in billion U.S. dollars" .

:YAxis a :Axis ;
    :title "companies based on medical device" .

:DataPoint1 a :DataPoint ;
    :xValue "12.24" ;
    :yValue "Abbott Laboratories" ;
    :belongsTo :Chart .

