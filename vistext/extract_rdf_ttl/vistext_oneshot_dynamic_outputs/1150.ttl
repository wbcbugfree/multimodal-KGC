@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Number of coronavirus (COVID-19) recoveries in Romania as of January 8 , 2021 (in 1,000s)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Number of people in thousands" .

:DataPoint1 a :DataPoint ;
    :xValue "May" ;
    :yValue "15" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "June" ;
    :yValue "20" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "July" ;
    :yValue "25" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "August" ;
    :yValue "35" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "September" ;
    :yValue "45" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "October" ;
    :yValue "110" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "November" ;
    :yValue "180" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "December" ;
    :yValue "450" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "2021" ;
    :yValue "600" ;
    :belongsTo :Chart .
