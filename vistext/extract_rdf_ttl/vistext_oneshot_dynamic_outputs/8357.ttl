@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Consumer preferred channels of brand communication during the coronavirus pandemic worldwide as of March 2020 , by country" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "Streaming videos" .

:DataPoint1 a :DataPoint ;
    :xValue "Average" ;
    :yValue "0.17" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Brazil" ;
    :yValue "0.22" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "Canada" ;
    :yValue "0.09" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "China" ;
    :yValue "0.45" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "France" ;
    :yValue "0.05" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Germany" ;
    :yValue "0.06" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "India" ;
    :yValue "0.47" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Italy" ;
    :yValue "0.12" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "Japan" ;
    :yValue "0.06" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "South Africa" ;
    :yValue "0.19" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "South Korea" ;
    :yValue "0.14" ;
    :belongsTo :Chart .

:DataPoint12 a :DataPoint ;
    :xValue "United Kingdom" ;
    :yValue "0.07" ;
    :belongsTo :Chart .

:DataPoint13 a :DataPoint ;
    :xValue "United States" ;
    :yValue "0.11" ;
    :belongsTo :Chart .
