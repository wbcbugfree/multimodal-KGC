@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Main worries or concerns about the COVID-19 / coronavirus pandemic in the United States , United Kingdom and Germany 2020 (as of May 31)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Germany" .

:YAxis a :Axis ;
    :title "Response" .

:DataPoint1 a :DataPoint ;
    :xValue "0.02" ;
    :yValue "Don't know" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "0.12" ;
    :yValue "Food shortages" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "0.57" ;
    :yValue "My country’s economic stabi..." ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "0.28" ;
    :yValue "My country’s political stability" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "0.36" ;
    :yValue "My economic situation" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "0.63" ;
    :yValue "My family’s health" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "0.2" ;
    :yValue "My job security" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "0.24" ;
    :yValue "My mental health" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "0.48" ;
    :yValue "My parent's / older friends h..." ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "0.51" ;
    :yValue "My physical health" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "0.03" ;
    :yValue "Other" ;
    :belongsTo :Chart .

:DataPoint12 a :DataPoint ;
    :xValue "0.11" ;
    :yValue "Rioting or looting" ;
    :belongsTo :Chart .
