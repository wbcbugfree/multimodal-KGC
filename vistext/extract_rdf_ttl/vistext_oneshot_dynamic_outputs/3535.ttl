@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "U.S. exports of photo , service industry machinery from 2003 to 2019 (in billion U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Exports in billion U.S. dollars" .

