@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Market share of the 15 leading insurance companies in Belgium from 2015 to 2019" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "2015" .

:YAxis a :Axis ;
    :title "leading insurance companies" .

