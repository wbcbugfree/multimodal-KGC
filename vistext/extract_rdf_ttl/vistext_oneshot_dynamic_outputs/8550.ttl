    :xValue "556" ;
    :yValue "C. Riunite/CIV/GIV" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "198" ;
    :yValue "Caviro" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "299" ;
    :yValue "Cavit" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "164" ;
    :yValue "GIV" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "358" ;
    :yValue "Martini" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "155" ;
    :yValue "Mezzacorona" ;
