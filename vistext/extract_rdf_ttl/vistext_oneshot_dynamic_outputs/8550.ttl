@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Leading ten Italian wineries in Italy from 2014 to 2018 , by turnover (in million euros)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "2015" .

:YAxis a :Axis .

:DataPoint1 a :DataPoint ;
    :xValue "185" ;
    :yValue "Antinori" ;
    :belongsTo :Chart .

