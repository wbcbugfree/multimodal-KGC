@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Career earnings of golf player Tiger Woods from 1996 to 2016 (in million U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Off course" .

