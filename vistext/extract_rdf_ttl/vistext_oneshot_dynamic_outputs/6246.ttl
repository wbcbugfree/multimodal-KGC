@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Mobility in selected cities between March 3 , 2020 and December 7 , 2020 , compared with movement prior to the coronavirus outbreak" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "Milan" .

