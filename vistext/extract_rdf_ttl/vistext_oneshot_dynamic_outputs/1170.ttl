@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Donations made to charity in the U.S. from 2011 to 2013 , by channel used" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Share of respondents" .

:YAxis a :Axis ;
    :title "Channel" .

:DataPoint1 a :DataPoint ;
    :xValue "0.5" ;
    :yValue "Checkout donations" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "0.08" ;
    :yValue "Door to door*" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "0.15" ;
    :yValue "Email*" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "0.32" ;
    :yValue "Honor/tribute gift" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "0.32" ;
    :yValue "Mailed check/credit card*" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "0.08" ;
    :yValue "Mobile text" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "0.06" ;
    :yValue "Online ad*" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "0.39" ;
    :yValue "Online donation" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "0.11" ;
    :yValue "Phone" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "0.35" ;
    :yValue "Pledge" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "0.4" ;
    :yValue "Purchase of proceeds" ;
    :belongsTo :Chart .

:DataPoint12 a :DataPoint ;
    :xValue "0.05" ;
    :yValue "Radio/TV*" ;
    :belongsTo :Chart .

:DataPoint13 a :DataPoint ;
    :xValue "0.06" ;
    :yValue "Social netowrking site" ;
    :belongsTo :Chart .

:DataPoint14 a :DataPoint ;
    :xValue "0.02" ;
    :yValue "Stocks, bonds, property" ;
    :belongsTo :Chart .

:DataPoint15 a :DataPoint ;
    :xValue "0.25" ;
    :yValue "Street canvassing*" ;
    :belongsTo :Chart .

:DataPoint16 a :DataPoint ;
    :xValue "0.21" ;
    :yValue "Third Party Vendor*" ;
    :belongsTo :Chart .

:DataPoint17 a :DataPoint ;
    :xValue "0.05" ;
    :yValue "Will/planned gift" ;
    :belongsTo :Chart .
