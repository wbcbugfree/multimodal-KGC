@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Factor weighted gender pay gap in selected countries in Latin America and the Caribbean in 2016" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Gender pay gap" .

:YAxis a :Axis ;
    :title "Country" .

:DataPoint1 a :DataPoint ;
    :xValue "0.13" ;
    :yValue "Argentina" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "0.26" ;
    :yValue "Brazil" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "0.24" ;
    :yValue "Chile" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "0.125" ;
    :yValue "Costa Rica" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "0.12" ;
    :yValue "Ecuador" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "0.16" ;
    :yValue "El Salvador" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "0.155" ;
    :yValue "Mexico" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "0.11" ;
    :yValue "Panama" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "0.17" ;
    :yValue "Paraguay" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "0.16" ;
    :yValue "Peru" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "0.175" ;
    :yValue "Uruguay" ;
    :belongsTo :Chart .
