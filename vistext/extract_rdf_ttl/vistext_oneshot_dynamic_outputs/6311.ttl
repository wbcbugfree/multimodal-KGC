@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Asus quarterly sales share worldwide from 2016 to 2020 , by product type" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "quarter" .

:YAxis a :Axis ;
    :title "Component" .

:DataPoint1 a :DataPoint ;
    :xValue "1Q '16" ;
    :yValue "0.13" ;
    :belongsTo :Chart .

