@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Top ten team market value trends of the Premier League in the United Kingdom (UK) from 2011 to 2020 (in million GBP)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Month" .

:YAxis a :Axis ;
    :title "Liverpool FC" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2010" ;
    :yValue "261.2" ;
    :belongsTo :Chart .

