@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Kenya : Total population from 2015 to 2025 (in million inhabitants)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Inhabitants in millions" .

:YAxis a :Axis ;
    :title "Year" .

:DataPoint1 a :DataPoint ;
    :xValue "42.5" ;
    :yValue "2015" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "43.7" ;
    :yValue "2016" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "44.9" ;
    :yValue "2017" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "46.1" ;
    :yValue "2018" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "47.3" ;
    :yValue "2019" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "48.5" ;
    :yValue "2020*" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "49.7" ;
    :yValue "2021*" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "50.9" ;
    :yValue "2022*" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "52.1" ;
    :yValue "2023*" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "53.3" ;
    :yValue "2024*" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "54.5" ;
    :yValue "2025*" ;
    :belongsTo :Chart .
