    :xValue "238" ;
    :yValue "Dota 2" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "467" ;
    :yValue "Fortnite" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "271" ;
    :yValue "Grand Theft Auto V" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "124" ;
    :yValue "Hearthstone" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "374" ;
    :yValue "Just Chatting" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "512" ;
    :yValue "League of Legends" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "131" ;
