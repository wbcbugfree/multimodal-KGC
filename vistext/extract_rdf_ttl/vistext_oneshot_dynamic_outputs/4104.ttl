@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Leading gaming content on Twitch worldwide from January 1 , 2019 to June 30 , 2019 , by hours watched (in millions)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Number of hours watched" .

:YAxis a :Axis ;
    :title "gaming content" .

:DataPoint1 a :DataPoint ;
    :xValue "183" ;
    :yValue "Apex Legends" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "179" ;
    :yValue "Counter-Strike: Global Offensive" ;
    :belongsTo :Chart .

