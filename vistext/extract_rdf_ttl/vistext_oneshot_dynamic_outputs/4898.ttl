@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "User share of most popular social media among young people in Finland in 2019 , by platform" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Share of respondents" .

:YAxis a :Axis ;
    :title "Response" .

:DataPoint1 a :DataPoint ;
    :xValue "0.22" ;
    :yValue "Discord" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "0.57" ;
    :yValue "Facebook" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "0.31" ;
    :yValue "Facebook Messenger" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "0.79" ;
    :yValue "Instagram" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "0.23" ;
    :yValue "Pinterest" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "0.74" ;
    :yValue "Snapchat" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "0.72" ;
    :yValue "Spotify" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "0.23" ;
    :yValue "Steam" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "0.89" ;
    :yValue "WhatsApp" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "0.88" ;
    :yValue "YouTube" ;
    :belongsTo :Chart .
