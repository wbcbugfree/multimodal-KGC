@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Pharmaceutical imports and exports of major African countries in 2014 (in million U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Country" .

:YAxis a :Axis ;
    :title "Exports" .

:DataPoint1 a :DataPoint ;
    :xValue "Algeria" ;
    :yValue "2.5" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Cote d'Ivoire" ;
    :yValue "5.4" ;
    :belongsTo :Chart .

