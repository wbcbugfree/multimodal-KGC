    :xValue "Egypt" ;
    :yValue "301.2" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "Ethiopia" ;
    :yValue "2.7" ;
    :belongsTo :Chart .

