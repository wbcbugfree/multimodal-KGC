    :xValue "Ghana" ;
    :yValue "1.5" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Kenya" ;
    :yValue "87.5" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Morocco" ;
    :yValue "123.6" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Nigeria" ;
    :yValue "7.8" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
