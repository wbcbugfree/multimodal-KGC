@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Monthly number of unemployed persons in the U.S. from November 2019 to November 2020 (in millions , adjusted)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Month" .

:YAxis a :Axis ;
    :title "Number in millions" .

:DataPoint1 a :DataPoint ;
    :xValue "Apr '20" ;
    :yValue "23.08" ;
    :belongsTo :Chart .

