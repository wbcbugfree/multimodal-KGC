@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Switzerland : Number of employed persons from 2010 to 2020 (in millions)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Employed persons in millions" .

:DataPoint1 a :DataPoint ;
    :xValue "2010" ;
    :yValue "4.57" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "2011" ;
    :yValue "4.66" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "2012" ;
    :yValue "4.67" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "2013" ;
    :yValue "4.74" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "2014" ;
    :yValue "4.83" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "2015" ;
    :yValue "4.91" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "2016" ;
    :yValue "4.96" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "2017" ;
    :yValue "5.02" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "2018" ;
    :yValue "5.07" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "2019*" ;
    :yValue "4.98" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "2020*" ;
    :yValue "5.03" ;
    :belongsTo :Chart .
