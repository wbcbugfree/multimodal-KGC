@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Total number of magnetic resonance imaging (MRI) units in the United Kingdom (UK) from 2000 to 2014" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Number of scanners" .

:DataPoint1 a :DataPoint ;
    :xValue "2000*" ;
    :yValue "331" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "2001 *" ;
    :yValue "370" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "2002 *" ;
    :yValue "295" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "2003 *" ;
    :yValue "271" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "2004" ;
    :yValue "300" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "2005" ;
    :yValue "326" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "2006*" ;
    :yValue "341" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "2008 *" ;
    :yValue "338" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "2010 *" ;
    :yValue "412" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "2011*" ;
    :yValue "444" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "2012*" ;
    :yValue "462" ;
    :belongsTo :Chart .

:DataPoint12 a :DataPoint ;
    :xValue "2013*" ;
    :yValue "468" ;
    :belongsTo :Chart .

:DataPoint13 a :DataPoint ;
    :xValue "2014*" ;
    :yValue "474" ;
    :belongsTo :Chart .
