@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Average expenditure per person per week on food and drink in the United Kingdom (UK) from 2006 to 2018/2019 (in pence)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Average expenditure in British pence sterling" .

:DataPoint1 a :DataPoint ;
    :xValue "2006" ;
    :yValue "3591" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "2007" ;
    :yValue "3656" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "2008" ;
    :yValue "3727" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "2009" ;
    :yValue "3838" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "2010" ;
    :yValue "3939" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "2011" ;
    :yValue "4016" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "2012" ;
    :yValue "4165" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "2013" ;
    :yValue "4287" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "2014" ;
    :yValue "4257" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "2015" ;
    :yValue "4337" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "2015/2016" ;
    :yValue "4316" ;
    :belongsTo :Chart .

:DataPoint12 a :DataPoint ;
    :xValue "2016/2017" ;
    :yValue "4503" ;
    :belongsTo :Chart .

:DataPoint13 a :DataPoint ;
    :xValue "2017/2018" ;
    :yValue "4627" ;
    :belongsTo :Chart .

:DataPoint14 a :DataPoint ;
    :xValue "2018/2019" ;
    :yValue "4771" ;
    :belongsTo :Chart .
