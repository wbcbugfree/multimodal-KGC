@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Real Gross Domestic Product (GDP) of the federal state of North Carolina from 2000 to 2019 (in billion U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Real GDP in billion U.S. dollars" .

