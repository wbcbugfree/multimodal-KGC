@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Internet user penetration in Singapore from 2015 to 2025" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "Share of population" .

:DataPoint1 a :DataPoint ;
    :xValue "2015" ;
    :yValue "0.78" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "2016" ;
    :yValue "0.79" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "2017" ;
    :yValue "0.8" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "2018" ;
    :yValue "0.81" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "2019" ;
    :yValue "0.82" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "2020*" ;
    :yValue "0.825" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "2021*" ;
    :yValue "0.83" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "2022*" ;
    :yValue "0.833" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "2023*" ;
    :yValue "0.835" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "2024*" ;
    :yValue "0.838" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "2025*" ;
    :yValue "0.84" ;
    :belongsTo :Chart .
