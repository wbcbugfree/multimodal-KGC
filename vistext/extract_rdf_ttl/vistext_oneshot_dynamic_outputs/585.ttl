@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Global corporate profit of Richemont from FY2006 to FY2020 (in million euros)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Profit in million euros" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2005" ;
    :yValue "1104" ;
    :belongsTo :Chart .

