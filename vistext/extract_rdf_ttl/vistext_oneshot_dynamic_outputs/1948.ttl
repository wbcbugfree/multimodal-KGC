@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Which payment methods do you offer in your online shop ?" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Share of respondents" .

:YAxis a :Axis ;
    :title "Response" .

