@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Number of betting shops in the United Kingdom from 2009 to 2019 , by operator" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "Gala Coral Group" .

