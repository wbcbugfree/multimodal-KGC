@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Number of enterprises in the manufacture of plastics products industry in Spain from 2008 to 2017" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Number of enterprises" .

:YAxis a :Axis ;
    :title "Year" .

:DataPoint1 a :DataPoint ;
    :xValue "4390" ;
    :yValue "2008" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "4284" ;
    :yValue "2009" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "4272" ;
    :yValue "2010" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "4118" ;
    :yValue "2011" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "3963" ;
    :yValue "2012" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "3632" ;
    :yValue "2013" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "3543" ;
    :yValue "2014" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "3688" ;
    :yValue "2015" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "3609" ;
    :yValue "2016" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "3589" ;
    :yValue "2017*" ;
    :belongsTo :Chart .
