@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Distribution of the population in France as of January 1 , 2019 , by age group" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Distribution of the population" .

:YAxis a :Axis ;
    :title "Year" .

:DataPoint1 a :DataPoint ;
    :xValue "0.065" ;
    :yValue "15 to 19 years old" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "0.059" ;
    :yValue "20 to 24 years old" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "0.058" ;
    :yValue "25 to 29 years old" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "0.064" ;
    :yValue "30 to 34 years old" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "0.066" ;
    :yValue "35 to 39 years old" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "0.064" ;
    :yValue "40 to 44 years old" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "0.07" ;
    :yValue "45 to 49 years old" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "0.069" ;
    :yValue "50 to 54 years old" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "0.068" ;
    :yValue "55 to 59 years old" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "0.064" ;
    :yValue "60 to 64 years old" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "0.061" ;
    :yValue "65 to 69 years old" ;
    :belongsTo :Chart .

:DataPoint12 a :DataPoint ;
    :xValue "0.055" ;
    :yValue "70 to 74 years old" ;
    :belongsTo :Chart .

:DataPoint13 a :DataPoint ;
    :xValue "0.1" ;
    :yValue "75 years and older" ;
    :belongsTo :Chart .

:DataPoint14 a :DataPoint ;
    :xValue "0.18" ;
    :yValue "Younger than 15 years old" ;
    :belongsTo :Chart .
