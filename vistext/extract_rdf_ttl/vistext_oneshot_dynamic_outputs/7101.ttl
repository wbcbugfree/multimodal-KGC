@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Income of Polo Ralph Lauren worldwide from 2007 to 2016 , by business segment (in million U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Wholesale" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2006" ;
    :yValue "479.9" ;
    :belongsTo :Chart .

