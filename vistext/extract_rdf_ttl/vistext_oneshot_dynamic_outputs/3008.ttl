@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Public sector expenditure on water supply in the United Kingdom (UK) from 2009/10 to 2019/20 (in million GBP)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Expenditure in million GBP" .

:YAxis a :Axis ;
    :title "Year" .

:DataPoint1 a :DataPoint ;
    :xValue "1042" ;
    :yValue "2009/10" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "727" ;
    :yValue "2010/11" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "780" ;
    :yValue "2011/12" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "764" ;
    :yValue "2012/13" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "622" ;
    :yValue "2013/14" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "570" ;
    :yValue "2014/15" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "579" ;
    :yValue "2015/16" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "742" ;
    :yValue "2016/17" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "783" ;
    :yValue "2017/18" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "789" ;
    :yValue "2018/19" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "797" ;
    :yValue "2019/20" ;
    :belongsTo :Chart .
