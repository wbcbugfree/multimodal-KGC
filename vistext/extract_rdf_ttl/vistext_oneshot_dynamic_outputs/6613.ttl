@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Latvia : Distribution of employment by economic sector from 2010 to 2020 Agriculture" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2009" ;
    :yValue "0.086" ;
    :belongsTo :Chart .

