@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Top goal scorers for Arsenal F.C . as of July 2020" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Goal scorer" .

:YAxis a :Axis ;
    :title "Goals scored" .

:DataPoint1 a :DataPoint ;
    :xValue "Alexis Sánchez" ;
    :yValue "80" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Dennis Bergkamp" ;
    :yValue "110" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "Freddie Ljungberg" ;
    :yValue "72" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "Ian Wright" ;
    :yValue "150" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "Olivier Giroud" ;
    :yValue "105" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Pierre-Emerick Aubameyang" ;
    :yValue "70" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Robert Pirès" ;
    :yValue "85" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Robin van Persie" ;
    :yValue "132" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "Theo Walcott" ;
    :yValue "108" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "Thierry Henry" ;
    :yValue "228" ;
    :belongsTo :Chart .
