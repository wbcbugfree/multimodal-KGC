    :xValue "597000" ;
    :yValue "Friends First Life" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "4113000" ;
    :yValue "Irish Life" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "5000" ;
    :yValue "London General Life" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "2160000" ;
    :yValue "New Ireland" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
