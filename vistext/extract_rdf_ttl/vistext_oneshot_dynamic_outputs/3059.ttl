@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Largest cities in Nigeria in 2020 (in 1,000 individuals)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "city" .

:YAxis a :Axis ;
    :title "Number of inhabitants in thousands" .

:DataPoint1 a :DataPoint ;
    :xValue "Aba" ;
    :yValue "940" ;
    :belongsTo :Chart .

