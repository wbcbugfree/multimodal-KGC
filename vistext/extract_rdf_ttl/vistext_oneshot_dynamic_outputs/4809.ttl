@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Rate of unemployment in Canada in 2019 , by industry" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "industry" .

:YAxis a :Axis ;
    :title "Unemployment rate" .

