@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Apache Corporation 's revenue from 2007 to 2019 (in million U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Revenue in million U.S. dollars" .

:DataPoint1 a :DataPoint ;
    :xValue "2007" ;
    :yValue "10000" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "2008" ;
    :yValue "12370" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "2009" ;
    :yValue "8660" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "2010" ;
    :yValue "11770" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "2011*" ;
    :yValue "14650" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "2012" ;
    :yValue "15000" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "2013" ;
    :yValue "14830" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "2014" ;
    :yValue "12810" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "2015" ;
    :yValue "6580" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "2016" ;
    :yValue "5350" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "2017" ;
    :yValue "5890" ;
    :belongsTo :Chart .

:DataPoint12 a :DataPoint ;
    :xValue "2018" ;
    :yValue "7370" ;
    :belongsTo :Chart .

:DataPoint13 a :DataPoint ;
    :xValue "2019" ;
    :yValue "6350" ;
    :belongsTo :Chart .
