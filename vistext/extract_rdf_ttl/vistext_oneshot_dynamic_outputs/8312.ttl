@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "What activities have you done while boating ?" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Boating activity" .

:YAxis a :Axis ;
    :title "Male" .

:DataPoint1 a :DataPoint ;
    :xValue "Cruising" ;
    :yValue "0.57" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Entertaining" ;
    :yValue "0.4" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "Fishing from a boat" ;
    :yValue "0.66" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "Hunting from a boat" ;
    :yValue "0.05" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "Kneeboarding" ;
    :yValue "0.09" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Nature observation" ;
    :yValue "0.31" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Other" ;
    :yValue "0.04" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Quiet water paddling" ;
    :yValue "0.24" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "Racing" ;
    :yValue "0.06" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "Scuba Diving/Snorkeling" ;
    :yValue "0.14" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "Sightseeing" ;
    :yValue "0.33" ;
    :belongsTo :Chart .

:DataPoint12 a :DataPoint ;
    :xValue "Sunbathing" ;
    :yValue "0.31" ;
    :belongsTo :Chart .

:DataPoint13 a :DataPoint ;
    :xValue "Swimming" ;
    :yValue "0.45" ;
    :belongsTo :Chart .

:DataPoint14 a :DataPoint ;
    :xValue "Tubing" ;
    :yValue "0.23" ;
    :belongsTo :Chart .

:DataPoint15 a :DataPoint ;
    :xValue "Wakeboarding" ;
    :yValue "0.14" ;
    :belongsTo :Chart .

:DataPoint16 a :DataPoint ;
    :xValue "Water Skiing" ;
    :yValue "0.2" ;
    :belongsTo :Chart .

:DataPoint17 a :DataPoint ;
    :xValue "Whitewater paddling" ;
    :yValue "0.08" ;
    :belongsTo :Chart .
