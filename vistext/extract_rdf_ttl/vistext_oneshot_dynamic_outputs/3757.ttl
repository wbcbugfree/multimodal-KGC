@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Net income of Wynn Resorts worldwide from 2008 to 2019 (in million U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Net income in million U.S. dollars" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2007" ;
    :yValue "210.1" ;
    :belongsTo :Chart .

