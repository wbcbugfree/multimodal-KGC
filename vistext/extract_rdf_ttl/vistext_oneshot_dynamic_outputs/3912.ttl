@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Annual volume of carbon dioxide (CO2) emissions from transport sector 's energy consumption in Taiwan from 2006 to 2017 (in million metric tons)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Emission volume in million metric tons" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2005" ;
    :yValue "36.81" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Dec 31, 2006" ;
    :yValue "35.48" ;
    :belongsTo :Chart .

