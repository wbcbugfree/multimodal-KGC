@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Market value of new and used cars sold in the United Kingdom (UK) between 2003 and 2014 (in billion GBP)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "New Car Market" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2002" ;
    :yValue "33.6" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Dec 31, 2003" ;
    :yValue "32.5" ;
    :belongsTo :Chart .

