@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Number of confirmed cases and deaths of coronavirus (COVID-19) in Mexico from January 14 to December 14 , 2020" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Deaths" .

:DataPoint1 a :DataPoint ;
    :xValue "January 14, 2020" ;
    :yValue "0" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "February 14, 2020" ;
    :yValue "0" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "March 14, 2020" ;
    :yValue "0" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "April 14, 2020" ;
    :yValue "400" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "May 14, 2020" ;
    :yValue "4500" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "June 14, 2020" ;
    :yValue "17100" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "July 14, 2020" ;
    :yValue "36300" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "August 14, 2020" ;
    :yValue "55900" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "September 14, 2020" ;
    :yValue "71000" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "October 14, 2020" ;
    :yValue "84300" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "November 14, 2020" ;
    :yValue "98300" ;
    :belongsTo :Chart .

:DataPoint12 a :DataPoint ;
    :xValue "December 14, 2020" ;
    :yValue "114300" ;
    :belongsTo :Chart .
