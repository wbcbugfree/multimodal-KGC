@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Employment rate in Sweden from 2009 to 2019 , by gender" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Men" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2008" ;
    :yValue "0.672" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Dec 31, 2009" ;
    :yValue "0.675" ;
    :belongsTo :Chart .

