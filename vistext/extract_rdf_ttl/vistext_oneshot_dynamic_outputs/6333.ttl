@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Big data revenue worldwide from 2016 to 2027 , by major segment (in billion U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Hardware" .

:YAxis a :Axis ;
    :title "Year" .

:DataPoint1 a :DataPoint ;
    :xValue "9" ;
    :yValue "2016" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "10" ;
    :yValue "2017" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "12" ;
    :yValue "2018*" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "14" ;
    :yValue "2019*" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "15" ;
    :yValue "2020*" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "16" ;
    :yValue "2021*" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "18" ;
    :yValue "2022*" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "19" ;
    :yValue "2023*" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "20" ;
    :yValue "2024*" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "22" ;
    :yValue "2025*" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "23" ;
    :yValue "2026*" ;
    :belongsTo :Chart .

:DataPoint12 a :DataPoint ;
    :xValue "24" ;
    :yValue "2027*" ;
    :belongsTo :Chart .
