@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Chelsea FC revenue by stream from 2008/09 to 2018/19 (in million euros)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Season" .

:YAxis a :Axis ;
    :title "Matchday" .

:DataPoint1 a :DataPoint ;
    :xValue "2008/09" ;
    :yValue "87" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "2009/10" ;
    :yValue "81" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "2010/11" ;
    :yValue "74" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "2011/12" ;
    :yValue "96" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "2012/13" ;
    :yValue "82" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "2013/14" ;
    :yValue "84" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "2014/15" ;
    :yValue "92" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "2015/16" ;
    :yValue "93" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "2016/17" ;
    :yValue "76" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "2017/18" ;
    :yValue "83" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "2018/19" ;
    :yValue "75" ;
    :belongsTo :Chart .
