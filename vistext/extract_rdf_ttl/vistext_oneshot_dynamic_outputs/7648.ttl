    :xValue "New Brunswick" ;
    :yValue "711" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "Newfoundland and Labrador" ;
    :yValue "443" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Northwest Territories" ;
    :yValue "185" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Nova Scotia" ;
    :yValue "867" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Nunavut" ;
    :yValue "134" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "Prince Edward Island" ;
    :yValue "104" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "Saskatchewan" ;
