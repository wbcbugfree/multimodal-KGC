@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Number of Royal Canadian Mounted Police officers in Canada in 2019 , by level of policing and province" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "level of policing and province" .

:YAxis a :Axis ;
    :title "Contract policing *" .

:DataPoint1 a :DataPoint ;
    :xValue "Alberta" ;
    :yValue "2891" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "British Columbia" ;
    :yValue "5971" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "Manitoba" ;
    :yValue "934" ;
    :belongsTo :Chart .

