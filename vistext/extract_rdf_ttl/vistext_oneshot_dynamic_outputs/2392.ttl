@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Route length of railways across Uttar Pradesh\nin India from financial year 2003 to 2019\n(in kilometers)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Route length in kilometers" .

:YAxis a :Axis ;
    :title "year" .

:DataPoint1 a :DataPoint ;
    :xValue "8785.4" ;
    :yValue "FY 2003" ;
    :belongsTo :Chart .

