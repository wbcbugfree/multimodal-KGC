@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Religion affiliation in Chile as of 2018 , by type" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "Share of respondents" .

:DataPoint1 a :DataPoint ;
    :xValue "Adventist" ;
    :yValue "0.005" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "Afroamerican cults, Umbanda, etc." ;
    :yValue "0.001" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "Atheist" ;
    :yValue "0.005" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "Believer without formal affiliation..." ;
    :yValue "0.003" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "Catholic" ;
    :yValue "0.552" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "Does not know" ;
    :yValue "0.001" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "Evangelist (unspecified)" ;
    :yValue "0.126" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "Jehova's witness" ;
    :yValue "0.009" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "Jewish" ;
    :yValue "0.001" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "Mormon" ;
    :yValue "0.015" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "No answer" ;
    :yValue "0.01" ;
    :belongsTo :Chart .

:DataPoint12 a :DataPoint ;
    :xValue "None" ;
    :yValue "0.287" ;
    :belongsTo :Chart .

:DataPoint13 a :DataPoint ;
    :xValue "Other" ;
    :yValue "0.006" ;
    :belongsTo :Chart .

:DataPoint14 a :DataPoint ;
    :xValue "Protestant" ;
    :yValue "0.001" ;
    :belongsTo :Chart .
