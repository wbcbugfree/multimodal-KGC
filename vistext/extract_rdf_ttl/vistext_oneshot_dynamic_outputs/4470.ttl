@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Total number of public primary schools in France from 2005 to 2018" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Number of public schools" .

:YAxis a :Axis ;
    :title "Year" .

:DataPoint1 a :DataPoint ;
    :xValue "50650" ;
    :yValue "2005" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "49780" ;
    :yValue "2007" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "49310" ;
    :yValue "2008" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "48830" ;
    :yValue "2009" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "48360" ;
    :yValue "2010" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "47940" ;
    :yValue "2011" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "47570" ;
    :yValue "2012" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "47220" ;
    :yValue "2013" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "46830" ;
    :yValue "2014" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "46320" ;
    :yValue "2015" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "45760" ;
    :yValue "2016" ;
    :belongsTo :Chart .

:DataPoint12 a :DataPoint ;
    :xValue "45270" ;
    :yValue "2017" ;
    :belongsTo :Chart .

:DataPoint13 a :DataPoint ;
    :xValue "44800" ;
    :yValue "2018*" ;
    :belongsTo :Chart .
