@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Most commonly encountered types of malware used in industrial cyber attacks worldwide in 2019" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Share of encounters" .

:YAxis a :Axis ;
    :title "Response" .

:DataPoint1 a :DataPoint ;
    :xValue "0.078" ;
    :yValue "Bot" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "0.071" ;
    :yValue "Coin miner" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "0.248" ;
    :yValue "Downloader" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "0.064" ;
    :yValue "Keylogger" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "0.075" ;
    :yValue "Password utility" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "0.035" ;
    :yValue "Phishing" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "0.047" ;
    :yValue "Privilege escalation" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "0.154" ;
    :yValue "Remote access trojan" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "0.042" ;
    :yValue "Reverse shell" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "0.05" ;
    :yValue "Web shell" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "0.035" ;
    :yValue "Worm" ;
    :belongsTo :Chart .
