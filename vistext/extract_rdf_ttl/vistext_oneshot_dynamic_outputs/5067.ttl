@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "UK internet penetration : percentage of population using the internet in the United Kingdom from 2000 to 2017" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Response" .

:YAxis a :Axis ;
    :title "Percentage of individuals using internet" .

