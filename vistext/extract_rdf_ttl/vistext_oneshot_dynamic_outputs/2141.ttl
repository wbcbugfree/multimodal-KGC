@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "B2C e-commerce as percentage of GDP in Japan from 2009 to 2018" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Percentage of gross domestic product" .

:YAxis a :Axis ;
    :title "Response" .

:DataPoint1 a :DataPoint ;
    :xValue "0.0063" ;
    :yValue "2009" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "0.007" ;
    :yValue "2010" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "0.0079" ;
    :yValue "2011" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "0.0085" ;
    :yValue "2012" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "0.01" ;
    :yValue "2013" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "0.0104" ;
    :yValue "2014*" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "0.0122" ;
    :yValue "2015*" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "0.0144" ;
    :yValue "2016*" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "0.0158" ;
    :yValue "2017*" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "0.0171" ;
    :yValue "2018*" ;
    :belongsTo :Chart .
