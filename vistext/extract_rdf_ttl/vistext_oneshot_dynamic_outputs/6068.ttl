@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Total value of U.S. international trade from 2000 to 2019 (in billion U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Imports" .

