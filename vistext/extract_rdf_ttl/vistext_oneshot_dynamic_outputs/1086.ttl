@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Uganda : Total population from 2015 to 2025 (in million inhabitants)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Inhabitants in millions" .

:DataPoint1 a :DataPoint ;
    :xValue "2015" ;
    :yValue "35.09" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "2016" ;
    :yValue "36.33" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "2017*" ;
    :yValue "37.61" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "2018*" ;
    :yValue "38.91" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "2019*" ;
    :yValue "40.25" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "2020*" ;
    :yValue "41.62" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "2021*" ;
    :yValue "43.02" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "2022*" ;
    :yValue "44.44" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "2023*" ;
    :yValue "45.89" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "2024*" ;
    :yValue "47.37" ;
    :belongsTo :Chart .

:DataPoint11 a :DataPoint ;
    :xValue "2025*" ;
    :yValue "48.88" ;
    :belongsTo :Chart .
