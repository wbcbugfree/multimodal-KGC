@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Denomination of counterfeit euro banknotes withdrawn from circulation in Europe from the 1st half of 2015 to the 2nd half of 2019" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Hundred euro" .

:YAxis a :Axis ;
    :title "half a year" .

:DataPoint1 a :DataPoint ;
    :xValue "0.085" ;
    :yValue "H1 2015" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "0.11" ;
    :yValue "H1 2016" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "0.09" ;
    :yValue "H1 2017" ;
    :belongsTo :Chart .

:DataPoint4 a :DataPoint ;
    :xValue "0.109" ;
    :yValue "H1 2018" ;
    :belongsTo :Chart .

:DataPoint5 a :DataPoint ;
    :xValue "0.104" ;
    :yValue "H1 2019" ;
    :belongsTo :Chart .

:DataPoint6 a :DataPoint ;
    :xValue "0.101" ;
    :yValue "H2 2015" ;
    :belongsTo :Chart .

:DataPoint7 a :DataPoint ;
    :xValue "0.097" ;
    :yValue "H2 2016" ;
    :belongsTo :Chart .

:DataPoint8 a :DataPoint ;
    :xValue "0.065" ;
    :yValue "H2 2017" ;
    :belongsTo :Chart .

:DataPoint9 a :DataPoint ;
    :xValue "0.09" ;
    :yValue "H2 2018" ;
    :belongsTo :Chart .

:DataPoint10 a :DataPoint ;
    :xValue "0.096" ;
    :yValue "H2 2019" ;
    :belongsTo :Chart .
