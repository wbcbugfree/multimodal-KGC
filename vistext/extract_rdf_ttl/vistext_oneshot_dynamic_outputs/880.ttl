@prefix : <http://example.org/vistext#> .

:Chart a :AreaChart ;
    :title "Average retail price paid for fresh / frozen poultry meat in the United Kingdom (UK) from 2005 to 2015 (in GBP per kilogram)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Average price per kilogram (in GBP)" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2004" ;
    :yValue "3.38" ;
    :belongsTo :Chart .

