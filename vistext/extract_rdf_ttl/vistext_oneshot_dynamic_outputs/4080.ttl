@prefix : <http://example.org/vistext#> .

:Chart a :LineChart ;
    :title "Aggregated gross revenues of PwC 2006 to 2020 (in billion U.S. dollars)" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Year" .

:YAxis a :Axis ;
    :title "Revenue in billion U.S. dollars" .

:DataPoint1 a :DataPoint ;
    :xValue "Dec 31, 2005" ;
    :yValue "22.3" ;
    :belongsTo :Chart .

