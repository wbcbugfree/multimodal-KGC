@prefix : <http://example.org/vistext#> .

:Chart a :BarChart ;
    :title "Number of employees in U.S. and European medical technology companies from 2009 to 2019" ;
    :xAxis :XAxis ;
    :yAxis :YAxis .

:XAxis a :Axis ;
    :title "Combined" .

:YAxis a :Axis ;
    :title "Year" .

:DataPoint1 a :DataPoint ;
    :xValue "811000" ;
    :yValue "2017**" ;
    :belongsTo :Chart .

:DataPoint2 a :DataPoint ;
    :xValue "844000" ;
    :yValue "2018**" ;
    :belongsTo :Chart .

:DataPoint3 a :DataPoint ;
    :xValue "912000" ;
    :yValue "2019**" ;
    :belongsTo :Chart .
